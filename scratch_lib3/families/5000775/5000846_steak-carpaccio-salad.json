  "instructions": [
    {
      "id": 1,
      "primary_message": "Whisk together capers, mustard, lemon juice, and olive oil in a medium bowl. Season to taste with salt and pepper. Add arugula and red onion and toss to coat. Transfer to a serving dish, arrange steak and Parmesan shavings on top, and drizzle with any dressing remaining in the bowl. Sprinkle steak with a little salt and pepper. Serve with lemon wedges.",
      "secondary_message": null
