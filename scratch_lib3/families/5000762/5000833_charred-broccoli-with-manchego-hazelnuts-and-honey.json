  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the broiler to high and place a rimmed aluminum half-sheet pan 15 cm below it.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cut broccoli head in half lengthwise, then cut each half into individual florets, each with a long spear of stem attached. In a large mixing bowl, toss broccoli with olive oil and salt, rubbing it well with your hands to coat evenly and thoroughly.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Arrange broccoli on preheated sheet tray, then broil until nicely charred in spots, about 5 minutes. (Keep a close eye on it, as different broilers have different power levels.)",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer broiled broccoli to a serving plate and season with black pepper. Sprinkle lemon juice all over, followed by honey and hazelnuts. Using a Microplane grater, grate Manchego cheese generously all over. Serve immediately.",
      "secondary_message": null
    }
  ],
