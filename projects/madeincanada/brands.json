---
layout: null
hide_from_index: true
---
{
  "vocab": {{ site.data.madeincanada | jsonify }},
  "brands": [{% for b in site.brands %}
    {
      "id": {{ b.slug | jsonify }},
      "title": {{ b.title | jsonify }},
      "website": {{ b.website | jsonify }},
      "locations": {{ b.locations | jsonify }},
      "items": {{ b.items | jsonify }},
      "audience": {{ b.audience | jsonify }},
      "style": {{ b.style | jsonify }},
      "business": {{ b.business | jsonify }},
      "made_in_canada": {{ b.made_in_canada | jsonify }},
      "status": {{ b.status | jsonify }},
      "acquired_by": {{ b.acquired_by | jsonify }},
      "acquired_by_website": {{ b.acquired_by_website | jsonify }},
      "part_of": {{ b.part_of | jsonify }},
      "part_of_website": {{ b.part_of_website | jsonify }},
      "ownership": {{ b.ownership | jsonify }},
      "last_checked": {{ b.last_checked | date: "%Y-%m-%d" | jsonify }},
      "description": {{ b.content | markdownify | strip | jsonify }}
    }{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
}
