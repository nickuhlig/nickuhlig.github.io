  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in a Dutch oven over medium-high heat. Season chicken with salt and pepper. When oil is shimmering, brown chicken on all sides, about 8 minutes total. Transfer chicken to the bowl of a slow cooker.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Reduce the heat to medium. Add onion and jalapeño to the same pan and cook, stirring often and scraping up browned bits from the bottom of the pan until they start to soften, about 6 minutes. Add garlic and continue cooking until fragrant, about 1 minute more. Add chile powder, cumin, and cocoa powder and cook until fragrant, about 30 seconds. Add beer, raise heat to medium-high and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to the slow cooker along with the bay leaves, thyme, chipotle pepper, tomatoes, tomato paste, vinegar, green chiles, and chicken stock. Season with salt and pepper. Cook on low setting or until chicken is cooked through and fall-apart tender, at least 4 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Discard bay leaves and thyme sprigs. Shred chicken using two forks. Taste and adjust seasonings, if needed.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Ladle soup into bowls and garnish with avocado, onion, cilantro, cheddar and a sprinkle of tortilla chips. Pass limes and hot sauce at the table.",
      "secondary_message": null
    }
  ],
