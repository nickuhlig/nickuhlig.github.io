  "instructions": [
    {
      "id": 166124,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 166125,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 166126,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a cutting board. Cut chicken into bite sized cubes. ",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 166127,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet and season with spices. Stir-fry until golden brown and cooked through, 4-5 minutes. Remove from heat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp chili powder\n4 tsp cumin\n2 tsp garlic powder\n1 tsp salt"
    },
    {
      "id": 166128,
      "primary_message": "Meanwhile, warm tortillas in another skillet, oven, or microwave (optional), 15-30 seconds. ",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 166129,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 166130,
      "primary_message": "Coat a large sheet pan with a thin layer of oil to prevent sticking.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 166131,
      "primary_message": "Fill tortillas with chicken and cheese. Roll tightly and place seam-side down on the sheet pan. Place in the oven and bake until golden and crispy, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 166132,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n1 small bunch cilantro\n2 limes"
    },
    {
      "id": 166133,
      "primary_message": "Place corn in a colander and run under cold water to thaw. Pat dry with paper towels and transfer to a large bowl.",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 166134,
      "primary_message": "Using a clean cutting board, halve tomatoes. Peel and small dice onion. Shave cilantro leaves off the stems; discard stems and mince leaves. Add everything to the bowl with the corn.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 166135,
      "primary_message": "Juice one lime into the bowl with the corn, season with salt, and toss to combine the salad.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 166136,
      "primary_message": "Juice the other lime into a medium bowl, add yogurt, and whisk to combine the crema.",
      "secondary_message": "⅔ cup plain Greek yogurt"
    },
    {
      "id": 166137,
      "primary_message": "To serve, divide taquitos between plates, top with pico de gallo salad, and drizzle with yogurt crema. Enjoy! ",
      "secondary_message": null
    }
  ],
