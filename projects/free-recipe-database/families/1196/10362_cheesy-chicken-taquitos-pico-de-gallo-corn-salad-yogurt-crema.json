  "instructions": [
    {
      "id": 166138,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 166139,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 166140,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a cutting board. Cut chicken into bite sized cubes. ",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 166141,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the skillet and season with spices. Stir-fry until golden brown and cooked through, 5-6 minutes. Remove from heat. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp chili powder\n2 tbsp cumin\n1 tbsp garlic powder\n2 tsp salt"
    },
    {
      "id": 166142,
      "primary_message": "Meanwhile, warm tortillas in another skillet, oven, or microwave (optional), 15-30 seconds. ",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 166143,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 166144,
      "primary_message": "Coat a large sheet pan or two medium sheet pans with a thin layer of oil to prevent sticking.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 166145,
      "primary_message": "Fill tortillas with chicken and cheese. Roll tightly and place seam-side down on the sheet pan. Place in the oven and bake until golden and crispy, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 166146,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n1 small bunch cilantro\n3 limes"
    },
    {
      "id": 166147,
      "primary_message": "Place corn in a colander and run under cold water to thaw. Pat dry with paper towels and transfer to a large bowl.",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 166148,
      "primary_message": "Using a clean cutting board, halve tomatoes. Peel and small dice onions. Shave cilantro leaves off the stems; discard stems and mince leaves. Add everything to the bowl with the corn.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 166149,
      "primary_message": "Juice half of the limes into the bowl with the corn, season with salt, and toss to combine the salad.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 166150,
      "primary_message": "Juice the remaining limes into a small bowl, add yogurt, and whisk to combine the crema.",
      "secondary_message": "1 cup plain Greek yogurt"
    },
    {
      "id": 166151,
      "primary_message": "To serve, divide taquitos between plates, top with pico de gallo salad, and drizzle with yogurt crema. Enjoy! ",
      "secondary_message": null
    }
  ],
