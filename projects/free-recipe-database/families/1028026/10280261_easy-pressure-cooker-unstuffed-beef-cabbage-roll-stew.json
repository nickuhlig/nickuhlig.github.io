  "instructions": [
    {
      "primary_message": "Set a 6-quart electric pressure cooker to sauté on HIGH.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pressure cooker heats up, peel, halve, and medium dice onion.\n\n",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the pressure cooker insert is hot, add oil and swirl to coat the bottom. Add onion, beef, garlic, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n680 g lean ground beef\n1 tbsp minced garlic\n2 tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "primary_message": "Add tomato juice, broth, rice, lemon juice, sugar, and Worcestershire to the pressure cooker, then stir to combine. Add cabbage and shredded carrots (do not stir). Lock lid and set to pressure cook on HIGH for 10 minutes. When the stew is done, drape a clean towel over the vent, then manually release pressure. Allow to cool and thicken slightly, about 5 minutes.",
      "secondary_message": "3 cups tomato juice\n2 cups beef broth\n½ cup jasmine rice\n¼ cup lemon juice\n¼ cup brown sugar\n1 tbsp Worcestershire sauce\n1 (397 g) bag shredded cabbage (coleslaw mix)\n1 (283 g) bag shredded carrots"
    },
    {
      "primary_message": "To serve, divide stew between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
