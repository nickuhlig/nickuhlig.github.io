  "instructions": [
    {
      "id": 169850,
      "primary_message": "In a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes. Uncover couscous and fluff with a fork.",
      "secondary_message": "355 ml chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 169851,
      "primary_message": "Meanwhile, preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 169852,
      "primary_message": "Pat the fish dry with paper towels and place on a plate. Season with salt and pepper on both sides. ",
      "secondary_message": "⅓ kg tilapia fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 169853,
      "primary_message": "Sprinkle flour over both sides of each fillet and press gently to adhere.",
      "secondary_message": "1 tbsp all-purpose flour"
    },
    {
      "id": 169854,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fish to the skillet and cook until opaque and cooked through, about 3 minutes per side. Remove to a plate and cover with foil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 169855,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 medium carrot\n1 medium zucchini squash\n½ small bunch cilantro\n½ lemon"
    },
    {
      "id": 169856,
      "primary_message": "Seed and slice bell pepper into thin strips. Peel, halve, and thinly slice onion. Peel and thinly slice garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 169857,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 169858,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add the bell pepper, onion, and garlic; cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 169859,
      "primary_message": "Meanwhile, peel and thinly slice carrot. Trim and thinly slice zucchini. Add both to the skillet along with the spices. Cook, stirring constantly, until fragrant, about 1 minute. ",
      "secondary_message": "½ tsp paprika\n½ tsp cumin\n½ tsp salt\n¼ tsp chili powder\n¼ tsp turmeric\n⅛ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 169860,
      "primary_message": "Stir in the tomatoes, broth, tomato paste, and sugar. Increase temperature to high and bring to a boil; then reduce heat to medium and let simmer, stirring occasionally, until slightly thickened, 2-3 minutes.",
      "secondary_message": "½ (398 ml) can diced tomatoes\n118 ml (½ cup) chicken or vegetable broth\n2 tbsp tomato paste\n½ tsp brown sugar"
    },
    {
      "id": 169861,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add half of the cilantro to the skillet (reserve the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 169862,
      "primary_message": "Place fish fillets in the skillet over the vegetables, spooning a thin layer of sauce over the top to cover. Cover with a lid and let simmer until veggies are soft and fish is warmed through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 169863,
      "primary_message": "Cut the lemon into wedges.",
      "secondary_message": null
    },
    {
      "id": 169864,
      "primary_message": "To serve, divide couscous and vegetable-fish sauté between plates or bowls. Garnish with cilantro and lemon wedges. Enjoy!",
      "secondary_message": null
    }
  ],
