  "instructions": [
    {
      "id": 25044,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth. Add soy sauce, sesame oil, and red pepper; whisk together. Set aside.",
      "secondary_message": "2 tbsp cold water\r\n1 tsp cornstarch\r\n2 tbsp soy sauce\r\n1 tsp toasted sesame oil\r\n⅛ tsp crushed red pepper"
    },
    {
      "id": 25045,
      "primary_message": "Wash the fresh produce. Snap (or cut) off woody ends from the asparagus, then cut on an angle into 2 inch pieces; transfer to a large bowl. Seed and cut the bell pepper into 2 inch strips; add to the bowl with asparagus. Trim green onion ends and chop on an angle; transfer to a small bowl.",
      "secondary_message": "1 small bunch asparagus\r\n1 red bell pepper \r\n½ small bunch green onions (scallions)"
    },
    {
      "id": 25046,
      "primary_message": "Peel and mince or grate the ginger. Peel and mince the garlic. Transfer both to a small bowl.",
      "secondary_message": "1 (1 inch) piece ginger root\r\n2 cloves garlic"
    },
    {
      "id": 25047,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 25048,
      "primary_message": "Slice the steak into thin strips.",
      "secondary_message": "¾ lb striploin (New York strip) steak\r\n"
    },
    {
      "id": 25049,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the steak strips and cook until browned, 1-2 minutes per side. Transfer to a plate.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 25050,
      "primary_message": "Once steak has been transferred, add more oil to the skillet. Add the asparagus, bell pepper, ginger, and garlic. Cook, stirring frequently, until vegetables are crisp-tender and lightly browned, 2-3 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 25051,
      "primary_message": "Return beef to the skillet and add green onions and sauce. Cook until sauce is slightly thickened, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25052,
      "primary_message": "To serve, place stir fry in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
