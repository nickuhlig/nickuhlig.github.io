  "instructions": [
    {
      "id": 66545,
      "primary_message": "In a small bowl, make a slurry by whisking water with arrowroot until smooth. Add coconut aminos, sesame oil, and red pepper; whisk together. Set aside.",
      "secondary_message": "6 tbsp cold water\n3 tsp arrowroot starch/powder\n6 tbsp coconut aminos\n3 tsp toasted sesame oil\n⅜ tsp crushed red pepper"
    },
    {
      "id": 66544,
      "primary_message": "Wash the fresh produce. Snap (or cut) off woody ends from the asparagus, then cut on an angle into 2 inch pieces; transfer to a large bowl. Seed and cut the bell peppers into 2 inch strips; add to the bowl with asparagus. Trim green onion ends and chop on an angle; transfer to a small bowl.",
      "secondary_message": "3 small bunches asparagus\n3 red bell peppers\n1 ½ small bunch green onions (scallions)"
    },
    {
      "id": 66543,
      "primary_message": "Peel and mince or grate the ginger. Peel and mince the garlic. Transfer both to a small bowl.",
      "secondary_message": "3 (1 inch) pieces ginger root\n6 cloves garlic"
    },
    {
      "id": 66542,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 66541,
      "primary_message": "Slice the steak into thin strips.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 66540,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the steak strips and cook until browned, 1-2 minutes per side. Transfer to a plate.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 66539,
      "primary_message": "Once steak has been transferred, add more oil to the skillet. Add the asparagus, bell pepper, ginger, and garlic. Cook, stirring frequently, until vegetables are crisp-tender and lightly browned, 2-3 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 66538,
      "primary_message": "Return beef to the skillet and add green onions and sauce. Cook until sauce is slightly thickened, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 66537,
      "primary_message": "To serve, place stir fry in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
