  "instructions": [
    {
      "id": 427304,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 427305,
      "primary_message": "Wash, dry, and trim each squash, then halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheets.",
      "secondary_message": "3 medium spaghetti squash\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 427306,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes. ",
      "secondary_message": null
    },
    {
      "id": 427307,
      "primary_message": "Meanwhile, place Alfredo sauce, spinach, and spices in a large pot. Bring to a simmer over medium-high heat, stirring occasionally.",
      "secondary_message": "1 ½ (16 oz) jars Alfredo sauce\n1 ½ (16oz) bags frozen chopped spinach\n1 ½ tsp Italian seasoning\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 427308,
      "primary_message": "While the sauce comes to a simmer, drain and roughly chop artichoke hearts. Add to the pot with the sauce.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 427309,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 427310,
      "primary_message": "Once the sauce is simmering, add Parmesan and half of the basil to the pot, then stir to combine. Remove from heat and cover to keep warm. (Reserve remaining basil for serving.)",
      "secondary_message": "¾ cup Parmesan cheese, shredded"
    },
    {
      "id": 427311,
      "primary_message": "When the squash is done, remove from the oven and allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 427312,
      "primary_message": "To serve, divide spaghetti squash between plates or bowls; top with spinach-artichoke sauce, additional Parmesan, and reserved basil. Enjoy!",
      "secondary_message": "¾ cup Parmesan cheese, shredded"
    }
  ],
