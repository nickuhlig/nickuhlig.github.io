  "instructions": [
    {
      "id": 522829,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb sweet potato\n1 small bunch Italian (flat-leaf) parsley\n1 bunch kale"
    },
    {
      "id": 522830,
      "primary_message": "Peel and coarsely grate sweet potatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 522831,
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl with the sweet potato and set aside.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 522832,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 522833,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 522834,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic to the skillet and cook, stirring constantly, until fragrant, 15-30 seconds.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 522835,
      "primary_message": "Add sweet potato and onion to the skillet. Cover and cook, stirring occasionally, until tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 522836,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 522837,
      "primary_message": "Once the veggies are tender, add half of the parsley, tomatoes, tomato sauce, water, and spices to the skillet. Stir to combine the stew and bring to a simmer. Once simmering, cook until slightly thickened, 5-6 minutes. (Reserve remaining parsley for serving.)",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n2 (8 oz) cans tomato sauce\n½ cup water\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper\n½ tsp smoked paprika\n½ tsp cayenne pepper"
    },
    {
      "id": 522838,
      "primary_message": "While the stew is simmering, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 522839,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 522840,
      "primary_message": "When the stew has thickened slightly, add kale to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 522841,
      "primary_message": "Using a stirring spoon, make a well in the stew for each egg; crack an egg into each well and season with salt and pepper. Cover and cook until the egg whites are firm but yolks are still soft, about 5 minutes. Remove from heat.",
      "secondary_message": "8 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522842,
      "primary_message": "Meanwhile, arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 522843,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 522844,
      "primary_message": "To serve, divide eggs, stew, and toast between plates. Top with Parmesan and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
