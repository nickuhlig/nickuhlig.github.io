  "instructions": [
    {
      "id": 522941,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potato\n1 small bunch Italian (flat-leaf) parsley\n1 ½ bunches kale"
    },
    {
      "id": 522942,
      "primary_message": "Peel and coarsely grate sweet potatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 522943,
      "primary_message": "Peel, halve, and medium dice onions. Add to the bowl with the sweet potato and set aside.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 522944,
      "primary_message": "Preheat two large skillets over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 522945,
      "primary_message": "While the skillets heat up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 522946,
      "primary_message": "Once the skillets are hot, divide oil between them and swirl to coat the bottoms. Divide garlic between the skillets and cook, stirring constantly, until fragrant, 15-30 seconds.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 522947,
      "primary_message": "Divide sweet potato and onion between the skillets. Cover and cook, stirring occasionally, until tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 522948,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 522949,
      "primary_message": "Once the veggies are tender, divide half of the parsley, tomatoes, tomato sauce, water, and spices between the skillets. Stir to combine the stew and bring to a simmer. Once simmering, cook until slightly thickened, 5-6 minutes. (Reserve remaining parsley for serving.)",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n3 (213 ml) cans tomato sauce\n¾ cup water\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp smoked paprika\n¾ tsp cayenne pepper"
    },
    {
      "id": 522950,
      "primary_message": "While the stew is simmering, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 522951,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 522952,
      "primary_message": "When the stew has thickened slightly, add kale to the skillets in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 522953,
      "primary_message": "Using a stirring spoon, make a well in the stew for each egg; crack an egg into each well and season with salt and pepper. Cover and cook until the egg whites are firm but yolks are still soft, about 5 minutes. Remove from heat.",
      "secondary_message": "12 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 522954,
      "primary_message": "Meanwhile, divide bread between two baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 522955,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 522956,
      "primary_message": "To serve, divide eggs, stew, and toast between plates. Top with Parmesan and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
