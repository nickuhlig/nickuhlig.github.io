  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in medium saucepan over medium heat until shimmering. Add the onion and cook until lightly browned, about 7 to 8 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in the tomato sauce, beer, molasses, mustard, vinegar, brown sugar and Worcestershire sauce. Bring to a boil, then reduce to simmer and cook until sauce is reduced to a medium-thin thickness, about 30 to 45 minutes, stirring occasionally. Season with salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer the sauce to a blender and puree until smooth. Allow the sauce to cool, then store in an airtight container in the refrigerator for up to two weeks.",
      "secondary_message": null
    }
  ],
