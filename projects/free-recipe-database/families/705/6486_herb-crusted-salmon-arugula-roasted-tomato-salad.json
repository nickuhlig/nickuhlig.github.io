  "instructions": [
    {
      "id": 234545,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 lemons\n3 (5 oz) pkgs baby arugula\n1 ½ pints grape tomatoes\n¾ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 234546,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 234547,
      "primary_message": "Line two baking sheets with parchment paper. Using the back of a spoon, rub salmon filets with Dijon mustard and place on the first baking sheet.",
      "secondary_message": "2 ¼ lb salmon fillet\n1 tbsp Dijon mustard"
    },
    {
      "id": 234548,
      "primary_message": "Place grape tomatoes on the second baking sheet. Drizzle tomatoes with oil and season with salt and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 234549,
      "primary_message": "Grate the zest from the lemons into a medium bowl. Shave the parsley leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 234550,
      "primary_message": "Add parsley almond meal, salt, and pepper to the lemon zest and stir to combine.",
      "secondary_message": "⅓ cup almond meal/flour\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 234551,
      "primary_message": "Top salmon with herb mixture and press so that the crumb adheres to the salmon. Place in the oven to bake for 8-10 minutes or until the salmon is nearly opaque.",
      "secondary_message": null
    },
    {
      "id": 234552,
      "primary_message": "While salmon cooks, make the dressing. Juice the lemons into a large bowl; add olive oil, maple syrup, Dijon, salt and pepper, whisk to combine. Add arugula to the bowl and toss to coat.",
      "secondary_message": "⅓ cup extra virgin olive oil\n⅓ cup pure maple syrup\n3 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 234553,
      "primary_message": "To serve, put salad on plates and top with roasted tomatoes and salmon filet. Enjoy!",
      "secondary_message": null
    }
  ],
