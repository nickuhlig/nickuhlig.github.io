  "instructions": [
    {
      "id": 234536,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 lemons\n2 (5 oz) pkgs baby arugula\n1 pint grape tomatoes\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 234537,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 234538,
      "primary_message": "Line a baking sheet with parchment paper. Using the back of a spoon, rub salmon filets with Dijon mustard and place in the middle of the pan. ",
      "secondary_message": "1 ½ lb salmon fillet\n2 tsp Dijon mustard"
    },
    {
      "id": 234539,
      "primary_message": "Place grape tomatoes on either side of the salmon filets. Drizzle tomatoes with oil and season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 234540,
      "primary_message": "Grate the zest from the lemons into a small bowl. Shave the parsley leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 234541,
      "primary_message": "Add parsley almond meal, salt, and pepper to the lemon zest and stir to combine.",
      "secondary_message": "¼ cup almond meal/flour\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 234542,
      "primary_message": "Top salmon with herb mixture and press so that the crumb adheres to the salmon. Place in the oven to bake for 8-10 minutes or until the salmon is nearly opaque.",
      "secondary_message": null
    },
    {
      "id": 234543,
      "primary_message": "While salmon cooks, make the dressing. Juice the lemons into a medium bowl; add olive oil, maple syrup, Dijon, salt and pepper, whisk to combine. Add arugula to the bowl and toss to coat.",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup pure maple syrup\n2 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 234544,
      "primary_message": "To serve, put salad on plates and top with roasted tomatoes and salmon filet. Enjoy!",
      "secondary_message": null
    }
  ],
