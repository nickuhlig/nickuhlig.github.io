  "instructions": [
    {
      "id": 1,
      "primary_message": "In 3-quart saucepan, melt 3 tablespoons of ghee on medium heat. Add asafoetida, coriander, fenugreek seed, and paprika. Stir and cook for thirty seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Increase heat to medium high and add onions with pinch of salt. Stir to coat and let cook until golden brown, about 7 minutes. Stir often to keep spice mix from burning. Add tomatoes, scrape browned bits off bottom of pan, and cover. Keep at a simmer for 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat large wok or cast iron skillet until lightly smoking. Add 1 tablespoon ghee, then fry paneer until browned on several sides. To reduce sticking, let paneer fry for at least 30 seconds before trying to stir. Set aside on paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Let pan come back to high temperature. If it's looking dry, add last tablespoon of ghee, then peppers. Stir frequently and cook just until they blister and begin to tenderize. Return paneer to pan and pour gravy on top. Add fengureek leaves, stir to combine and cook for one minute. Squeeze on lime juice and add any additional salt to taste. Serve immediately.",
      "secondary_message": null
    }
  ],
