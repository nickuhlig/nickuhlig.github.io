  "instructions": [
    {
      "id": 256060,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ (5 oz) pkg baby spinach\n1 (1 inch) piece ginger root\n1 lime\n1 mango\n½ English cucumber\n½ small bunch cilantro"
    },
    {
      "id": 256061,
      "primary_message": "Roughly chop spinach and transfer to a medium bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 256062,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 256063,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 256064,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add garlic and ginger; cook, stirring constantly, until golden, about 1 minute.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 256065,
      "primary_message": "Add spices to the pan and continue to cook, stirring constantly, until fragrant, 1 minute more.",
      "secondary_message": "2 tsp curry powder\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 256066,
      "primary_message": "Add coconut milk, then bring to a boil over medium-high heat.",
      "secondary_message": "½ (13.5 fl oz) can coconut milk"
    },
    {
      "id": 256067,
      "primary_message": "While the coconut milk is heating up, pat cod dry with paper towels and cut into 1-inch pieces.",
      "secondary_message": "¾ lb cod fillet"
    },
    {
      "id": 256068,
      "primary_message": "Once the coconut milk is boiling, reduce heat to medium-low, add cod, and simmer, undisturbed, until the fish is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 256069,
      "primary_message": "Meanwhile, using a clean cutting board, zest and juice lime into another medium bowl; add oil, sugar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp brown sugar\n¼ tsp salt\n⅛ tsp crushed red pepper\n1 pinch black pepper"
    },
    {
      "id": 256070,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides. Medium dice and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 256071,
      "primary_message": "Trim cucumber, halve lengthwise, and thinly slice crosswise into half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256072,
      "primary_message": "Peel, halve, and thinly slice shallot; add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 256073,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for the curry) and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 256074,
      "primary_message": "When the curry is done, add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 256075,
      "primary_message": "To serve, divide the fish curry between bowls and sprinkle with reserved cilantro. Enjoy with mango-cucumber salad on the side. ",
      "secondary_message": null
    }
  ],
