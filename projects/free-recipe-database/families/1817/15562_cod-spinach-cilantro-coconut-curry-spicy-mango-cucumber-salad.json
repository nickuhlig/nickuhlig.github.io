  "instructions": [
    {
      "id": 256092,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach\n3 (1 inch) pieces ginger root\n3 limes\n3 mangoes\n1 ½ English cucumbers\n1 small bunch cilantro"
    },
    {
      "id": 256093,
      "primary_message": "Roughly chop spinach and transfer to a medium bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 256094,
      "primary_message": "Peel and mince garlic and ginger.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 256095,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 256096,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic and ginger; cook, stirring constantly, until golden, 1-2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 256097,
      "primary_message": "Add spices to the pot and continue to cook, stirring constantly, until fragrant, 1-2 minutes more.",
      "secondary_message": "2 tbsp curry powder\n1 ½ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 256098,
      "primary_message": "Add coconut milk, then bring to a boil over medium-high heat.",
      "secondary_message": "1 ½ (13.5 fl oz) cans coconut milk"
    },
    {
      "id": 256099,
      "primary_message": "While the coconut milk is heating up, pat cod dry with paper towels and cut into 1-inch pieces.",
      "secondary_message": "2 ¼ lb cod fillet"
    },
    {
      "id": 256100,
      "primary_message": "Once the coconut milk is boiling, reduce heat to medium-low, add cod, and simmer, undisturbed, until the fish is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 256101,
      "primary_message": "Meanwhile, using a clean cutting board, zest and juice limes into another medium bowl; add oil, sugar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp brown sugar\n¾ tsp salt\n½ tsp crushed red pepper\n3 pinch black pepper"
    },
    {
      "id": 256102,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides. Medium dice and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 256103,
      "primary_message": "Trim cucumbers, halve lengthwise, and thinly slice crosswise into half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256104,
      "primary_message": "Peel, halve, and thinly slice shallots; add to the bowl.",
      "secondary_message": "1 ½ shallots"
    },
    {
      "id": 256105,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for the curry) and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 256106,
      "primary_message": "When the curry is done, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 256107,
      "primary_message": "To serve, divide the fish curry between bowls and sprinkle with reserved cilantro. Enjoy with mango-cucumber salad on the side. ",
      "secondary_message": null
    }
  ],
