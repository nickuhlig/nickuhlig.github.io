  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Toast the coriander seeds. Toast the allspice berries. Toast the cloves. Toast the whole star anise. Slightly crush and toast the cardamom pods. Toast the black peppercorns. Grate the ginger.",
      "secondary_message": "1 tsp coriander seeds\n1 tsp allspice berries\n8 cloves\n1 whole star anise\n6 cardamom pods\n½ tsp black peppercorns\n2 tbsp ginger root"
    },
    {
      "id": 1,
      "primary_message": "In a medium saucepan, bring cream and milk to a simmer. Toast whole spices and stir into dairy along with cinnamon and ginger. Bring dairy to a boil, then remove from heat and cover to steep for 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "After 45 minutes, return dairy to a boil, then remove from heat and stir in tea leaves. Cover and let steep for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour dairy through a fine mesh strainer into a measuring cup or bowl, pressing on tea leaves with a spoon to extract all liquid. In a clean medium saucepan, whisk together egg yolks and sugar until pale in color and slightly thickened. Slowly add strained dairy, whisking constantly.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat mixture on medium heat, stirring frequently, until a custard forms on the back of a spoon and a swiped finger leaves a clean line. Stir in salt to taste, then strain custard into an airtight container and chill overnight.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "The next day, churn ice cream according to manufacturer's instructions. Transfer to an airtight container and chill in freezer for at least 4 hours before serving.",
      "secondary_message": null
    }
  ],
