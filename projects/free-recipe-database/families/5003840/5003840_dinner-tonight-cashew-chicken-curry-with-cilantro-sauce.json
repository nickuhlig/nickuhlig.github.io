  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop and thinly slice the 1/2 of the red onion. Chop the cilantro. Slice the boneless skinless chicken breasts into 1-inch by 3-inch strips.",
      "secondary_message": "1 red onion\n¼ cup cilantro\n2 boneless skinless chicken breasts"
    },
    {
      "id": 1,
      "primary_message": "Add the cashews, chopped red onion, and cilantro to a blender. Pour in 1/2 cup of water. Blend into it is a smooth puree.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour the oil into a skillet set over medium-high heat. Toss in the sliced red onion and cook for 5 minutes, stirring often until lightly browned. Dump in the pureed cashew mixture, reduce heat to medium, and cook until the mixture has thickened. Most of the water should evaporate and it will turn a darker green.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Toss in the chicken and cook for 4 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour in another 1/2 cup of water. Scrap up any brown bites on the bottom of the skillet. Add the salt, garam masala, and cayenne. Bring mixture to a boil, then reduce heat to medium-low, cover, and simmer for 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Remove the cover, crank the heat to medium-high and cook, stirring occasionally, until the the sauce has thickened, about 5 minutes.",
      "secondary_message": null
    }
  ],
