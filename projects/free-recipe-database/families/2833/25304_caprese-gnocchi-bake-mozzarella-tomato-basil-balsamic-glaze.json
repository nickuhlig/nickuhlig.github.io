  "instructions": [
    {
      "id": 406450,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 406451,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 orange bell pepper\n2 small pkgs grape tomatoes\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 406452,
      "primary_message": "Trim, seed, and medium dice bell pepper. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 406453,
      "primary_message": "Peel and thinly slice garlic. Add to the baking sheets with the bell pepper along with tomatoes and gnocchi. Drizzle with oil and season with spices; stir to combine and spread out in an even layer.",
      "secondary_message": "4 cloves garlic\n2 (454 g) pkgs potato gnocchi\n¼ cup extra virgin olive oil\n1 tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 406454,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until gnocchi is golden brown and tomatoes begin to burst, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 406455,
      "primary_message": "While the gnocchi is baking, place vinegar and sugar in a small saucepan; bring to a boil over medium-high heat. Once boiling, reduce heat to medium-low and simmer until reduced by half, 5-7 minutes. Remove from heat and set aside.",
      "secondary_message": "½ cup balsamic vinegar\n1 tbsp brown sugar"
    },
    {
      "id": 406456,
      "primary_message": "Meanwhile, chop or tear mozzarella into bite-sized pieces.",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 406457,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 406458,
      "primary_message": "When the gnocchi is done, remove from the oven. Add arugula and half of the basil to the baking sheets. Stir to combine and spread out in an even layer, then top with mozzarella. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 406459,
      "primary_message": "Return baking sheets to the oven and continue to bake until arugula is wilted and cheese is melted, 2-3 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 406460,
      "primary_message": "To serve, divide the gnocchi bake between plates or bowls. Drizzle with balsamic glaze and sprinkle with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
