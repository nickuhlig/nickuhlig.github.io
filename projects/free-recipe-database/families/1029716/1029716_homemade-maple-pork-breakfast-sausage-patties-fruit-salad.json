  "instructions": [
    {
      "primary_message": "Place pork, maple syrup, and spices in a medium bowl. Using your hands, mix well to combine. Form the pork mixture into twelve ½-inch thick patties and place on a plate.",
      "secondary_message": "1 lb lean ground pork\npure maple syrup\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add sausage patties and pan-fry until golden and cooked through, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ (16 oz) pkg strawberries\n1 banana\n1 (6 oz) pkg blueberries"
    },
    {
      "primary_message": "Trim and thinly slice strawberries. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel banana and cut in half lengthwise; slice crosswise into ½-inch pieces. Add to the bowl with the strawberries, along with blueberries, and stir to combine the fruit salad.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide sausage patties and fruit salad between plates. Drizzle sausages with additional maple syrup (if desired) and enjoy!",
      "secondary_message": "pure maple syrup"
    }
  ],
