  "instructions": [
    {
      "id": 275947,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small bunch fresh dill\n6 sticks celery\n3 Gala apples\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 275948,
      "primary_message": "Juice lemons into a large bowl; add oil, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 275949,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 275950,
      "primary_message": "Peel, halve, and thinly slice shallots into half-moons; add to the bowl, toss to combine, and set aside.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 275951,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 275952,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "6 pork chops, bone-in\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp sage, dried"
    },
    {
      "id": 275953,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 275954,
      "primary_message": "Meanwhile, trim and slice celery crosswise into ½-inch pieces; add to the bowl with the dressing and shallot.",
      "secondary_message": null
    },
    {
      "id": 275955,
      "primary_message": "Quarter, core, and medium dice apples; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 275956,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 275957,
      "primary_message": "To serve, divide pork chops and salad between plates; top salad with pumpkin seeds and enjoy!",
      "secondary_message": "½ cup pumpkin seeds"
    }
  ],
