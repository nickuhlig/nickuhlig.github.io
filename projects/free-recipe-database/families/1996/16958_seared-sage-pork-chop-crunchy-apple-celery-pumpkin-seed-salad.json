  "instructions": [
    {
      "id": 276024,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lemon\n½ small bunch fresh dill\n2 sticks celery\n½ Gala apple\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 276025,
      "primary_message": "Juice lemon into a medium bowl; add oil, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 276026,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 276027,
      "primary_message": "Peel, halve, and thinly slice shallot into half-moons; add to the bowl, toss to combine, and set aside.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 276028,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 276029,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 pork chops, bone-in\n½ tsp salt\n¼ tsp black pepper\n¼ tsp sage, dried"
    },
    {
      "id": 276030,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 276031,
      "primary_message": "Meanwhile, trim and slice celery crosswise into ½-inch pieces; add to the bowl with the dressing and shallot.",
      "secondary_message": null
    },
    {
      "id": 276032,
      "primary_message": "Quarter, core, and medium dice apple; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 276033,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 276034,
      "primary_message": "To serve, divide pork chops and salad between plates; top salad with pumpkin seeds and enjoy!",
      "secondary_message": "⅛ cup pumpkin seeds"
    }
  ],
