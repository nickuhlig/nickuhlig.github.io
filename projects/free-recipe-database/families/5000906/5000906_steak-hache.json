  "instructions": [
    {
      "id": 1,
      "primary_message": "Season patties generously with salt and pepper. In a large cast iron or stainless-steel skillet, heat oil over medium-high heat until shimmering. Add patties and cook, flipping every minute or two, until an instant-read thermometer registers 125°F for medium-rare or 135°F for medium. Transfer to a plate and allow to rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer patties to serving plates and serve with salad and/or fries, along with the sauce of your choice.",
      "secondary_message": null
    }
