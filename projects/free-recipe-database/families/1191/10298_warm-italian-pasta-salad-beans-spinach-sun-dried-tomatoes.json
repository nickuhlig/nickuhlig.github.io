  "instructions": [
    {
      "id": 164818,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g penne pasta"
    },
    {
      "id": 164819,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 164820,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 164821,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 164822,
      "primary_message": "Add onion and garlic; cook, stirring occasionally, until softened, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 164823,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms and add them to the skillet. Cook, stirring occasionally, until mushrooms are tender, 5 minutes more. ",
      "secondary_message": "0.23 kg cremini mushrooms"
    },
    {
      "id": 164824,
      "primary_message": "Wash and juice lemon into a large bowl. Add oil, vinegar, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "1 lemon\n¼ cup extra virgin olive oil\n2 tbsp white wine vinegar\n1 tsp pure maple syrup\n1 tsp salt\n1 tsp Italian seasoning\n⅛ tsp black pepper"
    },
    {
      "id": 164825,
      "primary_message": "Wash and dry spinach (skip if it came pre-washed). Add to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. (If the skillet becomes too crowded transfer cooked veggies to the bowl with the dressing.) Remove from the heat.",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 164826,
      "primary_message": "Thinly slice sun-dried tomatoes and add to the bowl with the dressing.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 164827,
      "primary_message": "Drain and rinse the beans in a colander.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 164828,
      "primary_message": "Once the pasta is done, drain in the colander with the beans.",
      "secondary_message": null
    },
    {
      "id": 164829,
      "primary_message": "Add pasta-bean mixture and cooked veggies to the bowl with the dressing; toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 164830,
      "primary_message": "To serve, divide pasta between bowls or plates. Enjoy!",
      "secondary_message": null
    }
  ],
