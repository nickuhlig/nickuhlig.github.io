  "instructions": [
    {
      "id": 164766,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n142 g penne pasta"
    },
    {
      "id": 164767,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 164768,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 164769,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 164770,
      "primary_message": "Add onion and garlic; cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 164771,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms and add them to the skillet. Cook, stirring occasionally, until mushrooms are tender, 4 minutes more. ",
      "secondary_message": "0.11 kg cremini mushrooms"
    },
    {
      "id": 164772,
      "primary_message": "Wash and juice lemon into a medium bowl. Add oil, vinegar, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "½ lemon\n2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n½ tsp pure maple syrup\n½ tsp salt\n½ tsp Italian seasoning\n1 pinch black pepper"
    },
    {
      "id": 164773,
      "primary_message": "Wash and dry spinach (skip if it came pre-washed). Add to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from the heat.",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 164774,
      "primary_message": "Thinly slice sun-dried tomatoes and add to the bowl with the dressing.",
      "secondary_message": "6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 164775,
      "primary_message": "Drain tuna and add to the bowl.",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 164776,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 164777,
      "primary_message": "Once the pasta is done, drain in a colander. Add pasta, cooked veggies, and half the Parmesan to the bowl; toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 164778,
      "primary_message": "To serve, divide pasta between bowls or plates and top with remaining Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
