  "instructions": [
    {
      "id": 164675,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz penne pasta"
    },
    {
      "id": 164676,
      "primary_message": "Meanwhile, peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 164677,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 164678,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 164679,
      "primary_message": "Add onion and garlic; cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 164680,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms and add them to the skillet. Cook, stirring occasionally, until mushrooms are tender, 6 minutes more. ",
      "secondary_message": "¾ lb cremini mushrooms"
    },
    {
      "id": 164681,
      "primary_message": "Wash and juice lemons into a large bowl. Add oil, vinegar, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "1 ½ lemons\n⅓ cup extra virgin olive oil\n3 tbsp white wine vinegar\n1 ½ tsp pure maple syrup\n1 ½ tsp salt\n1 ½ tsp Italian seasoning\n3 pinch black pepper"
    },
    {
      "id": 164682,
      "primary_message": "Wash and dry spinach (skip if it came pre-washed). Add to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. (If the skillet becomes too crowded transfer cooked veggies to the bowl with the dressing.) Remove from the heat.",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 164683,
      "primary_message": "Thinly slice sun-dried tomatoes and add to the bowl with the dressing.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 164684,
      "primary_message": "Drain and rinse the beans in a colander.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 164685,
      "primary_message": "Once the pasta is done, drain in the colander with the beans.",
      "secondary_message": null
    },
    {
      "id": 164686,
      "primary_message": "Add pasta-bean mixture and cooked veggies to the bowl with the dressing; toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 164687,
      "primary_message": "To serve, divide pasta between bowls or plates. Enjoy!",
      "secondary_message": null
    }
  ],
