  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 orange\n½ lemon\n½ small pkg fresh sage"
    },
    {
      "primary_message": "FOR THE CITRUS SAGE SYRUP: Juice half of the orange into a small saucepan. (Reserve remaining orange for later use.) ",
      "secondary_message": null
    },
    {
      "primary_message": "Juice lemon into the saucepan with the orange juice. ",
      "secondary_message": null
    },
    {
      "primary_message": "Pick sage leaves off the stems; discard stems and set aside one sage leaf for garnish. Roughly chop remaining sage and add to the pan with the citrus juice.",
      "secondary_message": null
    },
    {
      "primary_message": "Add sugar and water to the pan; stir to combine and bring to a boil. Reduce heat to medium and simmer, stirring occasionally, until sugar is just dissolved. Remove from heat and let cool completely before straining and using. (NOTE: this recipe makes about 3/4 cup citrus sage syrup. Transfer leftover syrup to a small jar and refrigerate for up to one month.)",
      "secondary_message": "½ cup granulated sugar"
    },
    {
      "primary_message": "FOR THE COCKTAIL: Juice remaining half orange into a mixing glass.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add 3/4 fl oz (1 1/2 tbsp) citrus sage syrup, 2 fl oz (1/4 cup) bourbon, salt, and ice cubes to the glass, then stir until glass is cold, 30-45 seconds. ",
      "secondary_message": "2 fl oz bourbon\n1 pinch salt\n⅔ cup ice cube"
    },
    {
      "primary_message": "Strain cocktail into a martini glass or glass of choice. Rub reserved sage leaf between your fingers to release its oils, then drop into the glass. Enjoy!",
      "secondary_message": null
    }
  ],
