  "instructions": [
    {
      "id": 1,
      "primary_message": "For the falernum: Combine cloves, lime zest, and ginger with rum for 24 to 48 hours. Strain through cheesecloth; combine with simple syrup and almond extract.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the cocktail: Fill a cocktail shaker with ice. Add homemade falernum, lime, grapefruit, Aperol, and rum. Shake well. Strain into an ice-filled Collins glass and top with ginger beer.",
      "secondary_message": null
    }
