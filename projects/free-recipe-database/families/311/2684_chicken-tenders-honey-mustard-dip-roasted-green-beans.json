  "instructions": [
    {
      "id": 25994,
      "primary_message": "Preheat the oven to 220°C (425°F) and position rack in the centre. Line a baking sheet with parchment paper.",
      "secondary_message": ""
    },
    {
      "id": 25995,
      "primary_message": "Whisk the eggs in a medium bowl.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 25996,
      "primary_message": "In a different medium bowl, mix together the almond meal, shredded coconut, garlic powder, paprika, salt, and pepper.",
      "secondary_message": "1 cup almond meal/flour\r\n½ cup shredded unsweetened coconut\r\n1 tsp garlic powder\r\n1 tsp paprika\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25997,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 25998,
      "primary_message": "Cut the chicken into strips.",
      "secondary_message": "0.454 kg chicken breasts, boneless skinless\r\n"
    },
    {
      "id": 25999,
      "primary_message": "Dip the chicken strips into the egg, then transfer to the dry mixture and turn to coat. Shake off excess and place on the baking sheet. Drizzle with olive oil.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n"
    },
    {
      "id": 26000,
      "primary_message": "Place in the oven and bake until the crust is golden brown and the chicken is cooked through, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 26001,
      "primary_message": "Wash the green beans and trim ends. Add to the boiling water and cook until bright green, 3-4 minutes. Drain in a colander and rinse under cold water to prevent further cooking. Set aside to drain further.",
      "secondary_message": "0.908 kg green beans\r\n"
    },
    {
      "id": 26002,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "6 cloves garlic\r\n"
    },
    {
      "id": 26003,
      "primary_message": "In small bowl, prepare the dip by whisking together ⅓ of the minced garlic (save the rest for the green beans), mayonnaise, Dijon, honey, salt, and pepper.",
      "secondary_message": "½ cup avocado oil mayonnaise\n3 tbsp Dijon mustard\n2 tbsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 26004,
      "primary_message": "Wipe the saucepan dry and return to the stove over medium heat. Add oil and swirl to coat bottom. Add the remaining minced garlic and cook until fragrant, 15-30 seconds.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n"
    },
    {
      "id": 26005,
      "primary_message": "Add the green beans and season with salt and pepper; toss to combine.",
      "secondary_message": "½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 26006,
      "primary_message": "Place the chicken tenders on a plate, arrange the green beans on the side, and serve with the honey mustard dip. Enjoy!",
      "secondary_message": ""
    }
  ],
