  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely slice the fresh baby button mushrooms. Thinly slice the garlic.",
      "secondary_message": "149 g fresh baby button mushrooms\n2 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Place dried porcinis in a bowl and cover with boiling water. Cover with plastic wrap, and let soak for 30 minutes. Drain the mushrooms well, reserving all soaking liquid, and roughly chop porcinis.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat broiler on high. In a large bowl, toss porcinis, button mushrooms, thyme, garlic, olive oil, and salt and pepper. Transfer to an oven-proof straight-sided 30-cm sautée pan and broil 8 cm below the heat source, tossing every few minutes, until the mushrooms are golden brown, about 15 minutes total.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, bring a large pot of salted water to a rolling boil. When the mushrooms are broiled, pour in the reserved mushroom liquid and the crème fraîche and scrape up any bits of mushroom from the bottom of the pan. Keep warm over low heat. Boil the fresh tagliatelle until al dente (about 2 minutes, or according to package instructions). Drain pasta, reserving 2 cups of cooking liquid. Toss the tagliatelle with the mushroom sauce, adding pasta water as needed to moisten. Season to taste with more salt and pepper and serve immediately, topped with parsley and Parmigiano-Reggiano.",
      "secondary_message": null
    }
  ],
