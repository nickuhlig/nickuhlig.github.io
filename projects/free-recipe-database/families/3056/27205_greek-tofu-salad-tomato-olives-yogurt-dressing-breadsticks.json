  "instructions": [
    {
      "id": 438318,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 438319,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 438320,
      "primary_message": "Drizzle oil over flatbread, season with spices, and cut into 1½-inch wide strips; transfer to another baking sheet. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 flatbread or naan\n¼ tsp garlic powder\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 438321,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 438322,
      "primary_message": "While the skillet heats up, medium dice tofu. ",
      "secondary_message": null
    },
    {
      "id": 438323,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and spices; cook, turning occasionally, until golden brown and crispy, 8-10 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 438324,
      "primary_message": "While the tofu is cooking, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch fresh dill\n½ lemon\n½ English cucumber\n½ small pkg grape tomatoes\n1 head romaine lettuce"
    },
    {
      "id": 438325,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 438326,
      "primary_message": "Juice lemon into the bowl with the dill.",
      "secondary_message": null
    },
    {
      "id": 438327,
      "primary_message": "Peel and mince shallot. Add to the bowl along with yogurt, water, salt, and pepper; stir to combine the dressing. ",
      "secondary_message": "½ shallot\n¼ cup plain Greek yogurt\n1 tbsp water\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 438328,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 438329,
      "primary_message": "Halve grape tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 438330,
      "primary_message": "Roughly chop olives and add to the bowl. ",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 438331,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 438332,
      "primary_message": "Divide salad between plates or bowls and top with tofu. Serve with breadsticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
