  "instructions": [
    {
      "id": 438213,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 438214,
      "primary_message": "Drizzle oil over flatbread, season with spices, and cut into 1½-inch wide strips; transfer to a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 flatbreads or naan\n¾ tsp garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 438215,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 438216,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate. Season with spices on the top-side.",
      "secondary_message": "2 ¼ lb salmon fillet\n1 ½ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 438217,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon, skin-side down, and cook until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 438218,
      "primary_message": "While the salmon is cooking, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n1 ½ lemons\n1 ½ English cucumbers\n1 ½ pints grape tomatoes\n3 heads romaine lettuce"
    },
    {
      "id": 438219,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 438220,
      "primary_message": "Juice lemons into the bowl with the dill.",
      "secondary_message": null
    },
    {
      "id": 438221,
      "primary_message": "Peel and mince shallots. Add to the bowl along with yogurt, water, salt, and pepper; stir to combine the dressing. ",
      "secondary_message": "2 shallots\n¾ cup plain Greek yogurt\n3 tbsp water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 438222,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 438223,
      "primary_message": "Halve grape tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 438224,
      "primary_message": "Roughly chop olives and add to the bowl. ",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 438225,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 438226,
      "primary_message": "Using a fork or your hands, flake the salmon into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 438227,
      "primary_message": "Divide salad between plates or bowls and top with salmon. Serve with breadsticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
