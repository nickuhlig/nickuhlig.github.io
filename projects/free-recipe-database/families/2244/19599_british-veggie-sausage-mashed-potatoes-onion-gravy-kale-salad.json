  "instructions": [
    {
      "id": 326214,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n1 bunch kale\n1 small pkg grape tomatoes"
    },
    {
      "id": 326215,
      "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 326216,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 326217,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion into thin half-moons. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 326218,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion and cook, stirring constantly, until softened, about 2 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 326219,
      "primary_message": "Sprinkle flour over onion and continue to cook, stirring constantly, until lightly golden, about 1 minute.",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 326220,
      "primary_message": "Stir in broth and spices, then bring gravy to a simmer. Once simmering, add sausages to the skillet, reduce heat to low, and cover with a lid; cook, turning sausages occasionally, until gravy has thickened and sausages are warmed through, 5-7 minutes more. Remove from heat. ",
      "secondary_message": "473 ml chicken or vegetable broth\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper\n4 pre-cooked vegan sausage"
    },
    {
      "id": 326221,
      "primary_message": "When the potatoes are done, drain in a colander and return to the pot. Add oil, salt, and pepper; using a potato masher, mash until smooth. Cover to keep warm. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 326222,
      "primary_message": "Place vinegar, oil, Dijon, and salt in medium bowl; whisk to combine the dressing. ",
      "secondary_message": "4 tsp white wine vinegar\n2 tsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt"
    },
    {
      "id": 326223,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage the dressing into the kale.",
      "secondary_message": null
    },
    {
      "id": 326224,
      "primary_message": "Halve tomatoes, add to the bowl with the kale, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 326225,
      "primary_message": "Divide mashed potatoes between plates, then top with sausages and gravy. Serve with salad on the side and enjoy! ",
      "secondary_message": null
    }
  ],
