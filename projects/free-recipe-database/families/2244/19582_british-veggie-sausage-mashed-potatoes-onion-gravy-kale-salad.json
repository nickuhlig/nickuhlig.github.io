  "instructions": [
    {
      "id": 325998,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium yellow potatoes\n1 ½ bunches kale\n1 ½ pints grape tomatoes"
    },
    {
      "id": 325999,
      "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 326000,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 326001,
      "primary_message": "While the skillet heats up, peel, halve, and slice onions into thin half-moons. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 326002,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion and cook, stirring constantly, until softened, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 326003,
      "primary_message": "Sprinkle flour over onion and continue to cook, stirring constantly, until lightly golden, about 1 minute.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 326004,
      "primary_message": "Stir in broth and spices, then bring gravy to a simmer. Once simmering, add sausages to the skillet, reduce heat to low, and cover with a lid; cook, turning sausages occasionally, until gravy has thickened and sausages are warmed through, 7-8 minutes more. Remove from heat. ",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper\n6 pre-cooked vegan sausage"
    },
    {
      "id": 326005,
      "primary_message": "When the potatoes are done, drain in a colander and return to the pot. Add oil, salt, and pepper; using a potato masher, mash until smooth. Cover to keep warm. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 326006,
      "primary_message": "Place vinegar, oil, Dijon, and salt in large bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp white wine vinegar\n1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt"
    },
    {
      "id": 326007,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage the dressing into the kale.",
      "secondary_message": null
    },
    {
      "id": 326008,
      "primary_message": "Halve tomatoes, add to the bowl with the kale, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 326009,
      "primary_message": "Divide mashed potatoes between plates, then top with sausages and gravy. Serve with salad on the side and enjoy! ",
      "secondary_message": null
    }
  ],
