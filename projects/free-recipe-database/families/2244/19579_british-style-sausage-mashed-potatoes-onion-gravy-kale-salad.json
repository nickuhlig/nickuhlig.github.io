  "instructions": [
    {
      "id": 325961,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium yellow potatoes\n1 ½ bunches kale\n1 ½ pints grape tomatoes"
    },
    {
      "id": 325962,
      "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 325963,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325964,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add sausages and cook, turning occasionally, until golden, about 5 minutes (the sausages will not be cooked all the way through). Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp butter, unsalted\n6 pork sausages"
    },
    {
      "id": 325965,
      "primary_message": "While the sausages cook, peel, halve, and slice onions into thin half-moons. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 325966,
      "primary_message": "Return skillet to medium heat, add more butter, and swirl to coat the bottom; add onion and cook, stirring constantly, until softened, about 3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 325967,
      "primary_message": "Sprinkle flour over onion and continue to cook, stirring constantly, until lightly golden, about 1 minute.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 325968,
      "primary_message": "Stir in broth and spices, then bring gravy to a simmer. Once simmering, return sausages to the skillet, reduce heat to low, and cover with a lid; cook, turning sausages occasionally, until gravy has thickened and sausages are cooked through, 8-10 minutes more. Remove from heat. ",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 325969,
      "primary_message": "When the potatoes are done, drain in a colander and return to the pot. Add butter, salt, and pepper; using a potato masher, mash until smooth. Cover to keep warm. ",
      "secondary_message": "2 tbsp butter, unsalted\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 325970,
      "primary_message": "Place vinegar, water, Dijon, and salt in large bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp white wine vinegar\n1 tbsp water\n1 tbsp Dijon mustard\n¾ tsp salt"
    },
    {
      "id": 325971,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage the dressing into the kale.",
      "secondary_message": null
    },
    {
      "id": 325972,
      "primary_message": "Halve tomatoes, add to the bowl with the kale, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 325973,
      "primary_message": "Divide mashed potatoes between plates, then top with sausages and gravy. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
