  "instructions": [
    {
      "id": 520345,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 520346,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 520347,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside.",
      "secondary_message": null
    },
    {
      "id": 520348,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 hearts romaine hearts\n1 pint grape tomatoes\n1 English cucumber"
    },
    {
      "id": 520349,
      "primary_message": "Using a clean cutting board, peel and mince shallot. Place in a large bowl along with dressing and ketchup. Stir to combine. ",
      "secondary_message": "1 shallot\n¼ cup ranch dressing\n2 tbsp ketchup"
    },
    {
      "id": 520350,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 520351,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 520352,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 520353,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 520354,
      "primary_message": "Divide tortillas between plates and fill with a small portion of the salad, then top with crispy bacon and blue cheese. Serve with remaining salad on the side and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
    }
  ],
