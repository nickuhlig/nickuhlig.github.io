  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 hearts romaine hearts\n1 ½ pints grape tomatoes\n1 ½ English cucumbers"
    },
    {
      "primary_message": "Using a clean cutting board, peel and mince shallots. Place in a large bowl along with dressing and ketchup. Stir to combine. ",
      "secondary_message": "2 shallots\n⅓ cup ranch dressing\n3 tbsp ketchup"
    },
    {
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "Divide tortillas between plates and fill with a small portion of the salad, then top with crispy bacon and blue cheese. Serve with remaining salad on the side and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    }
  ],
