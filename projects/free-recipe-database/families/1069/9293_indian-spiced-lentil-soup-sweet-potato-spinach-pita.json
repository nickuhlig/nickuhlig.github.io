  "instructions": [
    {
      "id": 147279,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (1 inch) piece ginger root\n½ lb sweet potato\n½ medium head cauliflower\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 147280,
      "primary_message": "Peel and small dice the onion. Peel and mince the garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 147281,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 147282,
      "primary_message": "Peel and mince or grate the ginger. ",
      "secondary_message": null
    },
    {
      "id": 147283,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 147284,
      "primary_message": "Add onion and garlic to the pan; cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 147285,
      "primary_message": "Meanwhile, rinse the lentils in a colander or strainer.",
      "secondary_message": "½ cup red lentils"
    },
    {
      "id": 147286,
      "primary_message": "Add ginger and spices to the pan; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "1 tbsp curry powder\n1 tsp coriander\n½ tsp cumin"
    },
    {
      "id": 147287,
      "primary_message": "Add the lentils, broth, water, salt and pepper to the pan; bring the mixture to a boil.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup water\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 147288,
      "primary_message": "Meanwhile, peel and small dice the sweet potato; add to the pan.",
      "secondary_message": null
    },
    {
      "id": 147289,
      "primary_message": "Trim and discard the leaves and thick stem of the cauliflower and cut into small, bite-sized pieces; add to the pan.",
      "secondary_message": null
    },
    {
      "id": 147290,
      "primary_message": "Stir to combine the soup, then cover and reduce the heat to a simmer. Cook, stirring occasionally, until lentils and vegetables are tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 147291,
      "primary_message": "Cut pita into wedges.",
      "secondary_message": "1 whole grain pita"
    },
    {
      "id": 147292,
      "primary_message": "Uncover the soup and stir in the spinach. Cook until spinach is wilted and soup is heated through, about 2 more minutes.",
      "secondary_message": null
    },
    {
      "id": 147293,
      "primary_message": "To serve, divide soup between bowls and serve with pita on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
