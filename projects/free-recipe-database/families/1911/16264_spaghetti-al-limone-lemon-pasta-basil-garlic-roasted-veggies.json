  "instructions": [
    {
      "id": 266393,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 266394,
      "primary_message": "Fill a large pot halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve ¾-cup cooking water before draining and set aside.)",
      "secondary_message": "1 ½ tsp salt\n15 oz spaghetti pasta"
    },
    {
      "id": 266395,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n1 ½ bunches kale\n1 ½ lemons\n1 small pkg fresh basil"
    },
    {
      "id": 266396,
      "primary_message": "Peel and mince garlic. Place in a small bowl along with oil, salt, and pepper; stir to combine the garlic oil.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 266397,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to a large baking sheet pan, drizzle with half of the garlic oil (reserving the rest for the kale), toss to coat, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 266398,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through baking, until broccoli is tender-crisp, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 266399,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Transfer to another large baking sheet pan, drizzle with remaining garlic oil, toss to coat, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 266400,
      "primary_message": "Add baking sheet to the oven and roast, tossing halfway through, until kale is tender-crisp, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 266401,
      "primary_message": "While the veggies are roasting, zest and juice lemons into a medium bowl. Add cream, oil, salt, and crushed red pepper; whisk to combine the lemon cream.",
      "secondary_message": "6 fl oz (¾ cup) heavy whipping cream\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 266402,
      "primary_message": "Finely grate Parmesan, add to the bowl with the lemon cream, and stir to combine. Set aside.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 266403,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Set aside.",
      "secondary_message": null
    },
    {
      "id": 266404,
      "primary_message": "Return drained pasta to the pot and place over medium heat. Stir in the Parmesan-lemon cream and reserved pasta water; cook, stirring gently, until cheese has melted and sauce has thickened slightly, 3-4 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 266405,
      "primary_message": "Stir basil into the pasta.",
      "secondary_message": null
    },
    {
      "id": 266406,
      "primary_message": "To serve, divide pasta and veggies between plates or bowls. Top pasta with additional crushed red pepper and enjoy!",
      "secondary_message": "3 pinch crushed red pepper"
    }
  ],
