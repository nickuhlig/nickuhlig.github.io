  "instructions": [
    {
      "id": 266379,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 266380,
      "primary_message": "Fill a large pot halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve ½-cup cooking water before draining and set aside.)",
      "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
    },
    {
      "id": 266381,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n1 bunch kale\n1 lemon\n1 small pkg fresh basil"
    },
    {
      "id": 266382,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with oil, salt, and pepper; stir to combine the garlic oil.",
      "secondary_message": "4 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 266383,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to a large baking sheet pan, drizzle with half of the garlic oil (reserving the rest for the kale), toss to coat, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 266384,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast broccoli while you prepare the kale.",
      "secondary_message": null
    },
    {
      "id": 266385,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces, add to the bowl with reserved garlic oil, and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 266386,
      "primary_message": "Remove baking sheet from the oven, add seasoned kale, and toss to combine with the broccoli. Return baking sheet to the oven and continue to roast until veggies are tender-crisp, 8-10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 266387,
      "primary_message": "While the veggies are roasting, zest and juice lemon into a small bowl. Add cream, oil, salt, and crushed red pepper; whisk to combine the lemon cream.",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 266388,
      "primary_message": "Finely grate Parmesan, add to the bowl with the lemon cream, and stir to combine. Set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 266389,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Set aside.",
      "secondary_message": null
    },
    {
      "id": 266390,
      "primary_message": "Return drained pasta to the pot and place over medium heat. Stir in the Parmesan-lemon cream and reserved pasta water; cook, stirring gently, until cheese has melted and sauce has thickened slightly, 2-3 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 266391,
      "primary_message": "Stir basil into the pasta.",
      "secondary_message": null
    },
    {
      "id": 266392,
      "primary_message": "To serve, divide pasta and veggies between plates or bowls. Top pasta with additional crushed red pepper and enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
