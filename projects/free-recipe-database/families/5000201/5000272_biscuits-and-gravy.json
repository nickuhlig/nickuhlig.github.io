  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Split the buttermilk biscuits.",
      "secondary_message": "1 batch buttermilk biscuits"
    },
    {
      "id": 1,
      "primary_message": "In a 25-cm cast iron skillet set over medium-high heat, sauté the sausage, breaking it up with a wooden spoon, until at least 1 1/2 tablespoons fat has rendered, about 6 minutes; if your sausage is lean and yields less than 1 1/2 tablespoons of fat, melt in butter, 1/2 tablespoon at a time, until you have about 1 1/2 tablespoons in the skillet. Add the onion, season with a pinch of salt, and cook, stirring occasionally, until onion is very soft and golden and the sausage is well browned, about 7 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in the flour until no dry bits remain, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in 2 tablespoons of milk until completely absorbed. Gradually pour in remaining milk while stirring constantly to avoid lumps. Bring the gravy to a simmer and cook, stirring and scraping the sides and bottom of the skillet, until a silky and thick, spoon-coating sauce forms, about 4 minutes. Season to taste with salt and a generous amount of black pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Serve warm biscuits with hot gravy spooned over top.",
      "secondary_message": null
    }
  ],
