  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a large pot of salted water to a boil over high heat. Fill a large bowl with water and ice. Add beans to boiling water and cook until tender crisp, about 4 minutes. Transfer to ice bath until cool. Transfer to a rimmed baking sheet lined with paper towels or a clean kitchen towel and dry beans carefully. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine mayonnaise, anchovies, parmesan, lemon juice, and Worcestershire sauce in a large bowl and whisk to combine. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add beans, pepperoncini, shallots, and pine nuts. Toss to combine, and serve.",
      "secondary_message": null
    }
  ],
