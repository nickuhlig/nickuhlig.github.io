  "instructions": [
    {
      "id": 255688,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pineapple\n½ jalapeño pepper\n½ small bunch cilantro\n½ lime\n1 head butter (Boston) lettuce"
    },
    {
      "id": 255689,
      "primary_message": "Cut skin off pineapple; quarter, core, and slice into ½-inch thick planks. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 255690,
      "primary_message": "Peel, halve, and slice onion into half-moons; add to the bowl with the pineapple. Drizzle with oil and toss to coat.",
      "secondary_message": "½ medium red onion\n2 tsp extra virgin olive oil"
    },
    {
      "id": 255691,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255692,
      "primary_message": "Once the pan is hot, add pineapple and onions. Grill, turning once, until charred and tender, about 4 minutes; remove to a plate. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 255693,
      "primary_message": "Meanwhile, peel and mince garlic; place in the reserved bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 255694,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the garlic. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 255695,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 255696,
      "primary_message": "Juice lime into the bowl, then add oil, vinegar, honey, and salt; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp honey\n⅛ tsp salt"
    },
    {
      "id": 255697,
      "primary_message": "Transfer the grilled pineapple to a cutting board and roughly chop. Add to the bowl with the dressing, stir to combine the salsa, and set aside.",
      "secondary_message": null
    },
    {
      "id": 255698,
      "primary_message": "Return grill pan to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255699,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 255700,
      "primary_message": "Once the pan is hot, coat with oil; add steak to the pan and cook until desired doneness, 2-5 minutes per side. Transfer to the plate with the onions and let rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 255701,
      "primary_message": "Meanwhile, chop or tear the lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 255702,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 255703,
      "primary_message": "To serve, divide lettuce between plates or bowls; top with steak, onions, and pineapple salsa. Enjoy!",
      "secondary_message": null
    }
  ],
