  "instructions": [
    {
      "id": 255672,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pineapples\n1 ½ jalapeño peppers\n1 small bunch cilantro\n1 ½ limes\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 255673,
      "primary_message": "Cut skin off pineapples; quarter, core, and slice into ½-inch thick planks. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 255674,
      "primary_message": "Peel, halve, and slice onions into half-moons; add to the bowl with the pineapple. Drizzle with oil and toss to coat.",
      "secondary_message": "1 ½ medium red onions\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 255675,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255676,
      "primary_message": "Once the pan is hot, working in batches if necessary, add pineapple and onions. Grill, turning once, until charred and tender, about 4 minutes; remove to a large plate. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 255677,
      "primary_message": "Meanwhile, peel and mince garlic; place in the reserved bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 255678,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the garlic. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 255679,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 255680,
      "primary_message": "Juice limes into the bowl, then add oil, vinegar, honey, and salt; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp honey\n½ tsp salt"
    },
    {
      "id": 255681,
      "primary_message": "Transfer the grilled pineapple to a cutting board and roughly chop. Add to the bowl with the dressing, stir to combine the salsa, and set aside.",
      "secondary_message": null
    },
    {
      "id": 255682,
      "primary_message": "Return grill pan to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255683,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 255684,
      "primary_message": "Once the pan is hot, coat with oil; working in batches if necessary, add steak to the pan and cook until desired doneness, 2-5 minutes per side. Transfer to the plate with the onions and let rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 255685,
      "primary_message": "Meanwhile, chop or tear the lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 255686,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 255687,
      "primary_message": "To serve, divide lettuce between plates or bowls; top with steak, onions, and pineapple salsa. Enjoy!",
      "secondary_message": null
    }
  ],
