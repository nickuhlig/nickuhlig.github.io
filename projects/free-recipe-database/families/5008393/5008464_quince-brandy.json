  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash and dry quince and either grate or finely chop. Fill 2 quart-size canning jars approximately 3/4 full of quince, add spices, and top with cognac. Seal and keep in a cool, dark place until well matured, a minimum of 6 weeks, or up to 1 year (or more?). Strain before using, passing the liquid through a fine mesh strainer and then a coffee filter to remove small particles. Enjoy.",
      "secondary_message": null
    }
  ],
