  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the ripe tomatoes into 1/4- to 1/2-inch dice. Finely dice the white onion. Finely dice the serrano chiles.",
      "secondary_message": "6 ripe tomatoes\n½ large white onion\n1 to 2 serrano chiles"
    },
    {
      "id": 1,
      "primary_message": "Season tomatoes with 1 teaspoon salt and toss to combine. Transfer to a fine-mesh strainer or colander set in a bowl and allow to drain for 20 to 30 minutes. Discard liquid.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine drained tomatoes with onion, chiles, cilantro, and lime juice. Toss to combine and season to taste with salt. Pico de gallo can be stored for up to 3 days in a sealed container in the refrigerator.",
      "secondary_message": null
    }
