  "instructions": [
    {
      "id": 428246,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 428247,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg new potatoes\n6 medium zucchini squash\n3 sticks celery"
    },
    {
      "id": 428248,
      "primary_message": "Halve potatoes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 428249,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring once, until potatoes are golden and fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 428250,
      "primary_message": "Meanwhile, trim and halve zucchini lengthwise. Scrape out the soft flesh from the middle of each half, place in a large bowl, and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 428251,
      "primary_message": "Arrange zucchini halves, cut-side up, on another large baking sheet; drizzle with additional oil and season with salt and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 428252,
      "primary_message": "Add zucchini boats to the oven and bake until starting to soften, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 428253,
      "primary_message": "Meanwhile, roughly chop reserved zucchini flesh and return to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428254,
      "primary_message": "Trim and small dice celery. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 428255,
      "primary_message": "Drain tuna and flake with a fork. Add to the bowl along with Parmesan, salt, and pepper. Set aside.",
      "secondary_message": "6 (170 g) cans chunk light tuna in water\n¾ cup Parmesan cheese, shredded\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 428256,
      "primary_message": "Place pesto, mayo, salt, and pepper in a small bowl; stir to combine the sauce. Add half of the sauce to the bowl with the tuna and stir to combine the filling. (Set remaining sauce aside for serving.)",
      "secondary_message": "¾ cup sun-dried tomato pesto\n½ cup mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 428257,
      "primary_message": "Remove zucchini boats from the oven and divide filling between them.",
      "secondary_message": null
    },
    {
      "id": 428258,
      "primary_message": "Return zucchini boats to the oven and continue to bake until flesh is tender and filling is warmed through, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 428259,
      "primary_message": "To serve, divide zucchini boats, potatoes, and remaining sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
