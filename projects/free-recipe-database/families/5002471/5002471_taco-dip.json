  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the white onion. Dice the avocado into 1/4 inch pieces. Dice the plum tomatoes into 1/4-inch pieces.",
      "secondary_message": "1 medium white onion\n1 avocado\n1 ¾ plum tomatoes"
    },
    {
      "id": 1,
      "primary_message": "In a large skillet, heat oil over medium until shimmering. Add chili powder, cumin, garlic powder, oregano, salt, and smoked paprika, and stir until fragrant, about 30 seconds. Stir in onions, water, and lime juice and cook, stirring occasionally, until onions soften and a light sauce forms, about 4 minutes. Transfer the mixture to a plate or small bowl to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl with a handheld electric mixer, beat sour cream and cream cheese on high speed until smooth, about 1 minute (alternatively, whisk vigorously for about 3 minutes). Add cooled onion mixture and continue beating on low speed, or stir until well combined, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spread mixture evenly in a shallow 10- or 11-inch serving bowl. Top evenly with lettuce, scallions, cheese, avocado, tomatoes, jalapeños, and olives. Finish with a drizzle of hot sauce or taco sauce and sprinkle with cilantro. Serve with tortilla chips or crutités.",
      "secondary_message": null
    }
  ],
