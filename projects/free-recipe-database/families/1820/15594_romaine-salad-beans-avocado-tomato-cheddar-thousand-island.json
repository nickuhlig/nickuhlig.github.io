  "instructions": [
    {
      "id": 256612,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small pkgs grape tomatoes\n1 small bunch green onions (scallions)\n2 avocados\n2 heads romaine lettuce"
    },
    {
      "id": 256613,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 256614,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl along with yogurt, ketchup, mayo, vinegar, water, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "2 cloves garlic\n2 tbsp capers\n½ cup plain Greek yogurt\n⅓ cup ketchup\n¼ cup mayonnaise\n2 tbsp red wine vinegar\n2 tbsp water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 256615,
      "primary_message": "Halve tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 256616,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 256617,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 256618,
      "primary_message": "Coarsely grate cheese and add to the plate.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 256619,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 256620,
      "primary_message": "Divide the romaine between plates or bowls; top with beans, tomato, avocado, and cheese. Sprinkle with green onions and serve with dressing on the side. Enjoy!",
      "secondary_message": null
    }
  ],
