  "instructions": [
    {
      "id": 256532,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 pints grape tomatoes\n1 small bunch green onions (scallions)\n1 ½ avocados\n3 heads romaine lettuce"
    },
    {
      "id": 256533,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl along with yogurt, ketchup, mayo, vinegar, water, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp capers\n¾ cup plain Greek yogurt\n½ cup ketchup\n⅓ cup mayonnaise\n3 tbsp red wine vinegar\n3 tbsp water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 256534,
      "primary_message": "Halve tomatoes and place on a platter.",
      "secondary_message": null
    },
    {
      "id": 256535,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the platter with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 256536,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the platter.",
      "secondary_message": null
    },
    {
      "id": 256537,
      "primary_message": "Coarsely grate cheese and add to the platter.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 256538,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 256539,
      "primary_message": "While the skillet heats up, peel and mince additional garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 256540,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ground turkey, garlic, and spices to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 5-7 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 ¼ lb ground turkey\n1 ½ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 256541,
      "primary_message": "Meanwhile, chop or tear romaine leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 256542,
      "primary_message": "Divide the romaine between plates or bowls; top with tomato, avocado, cheese, and turkey crumble. Sprinkle with green onions and serve with dressing on the side. Enjoy!",
      "secondary_message": null
    }
  ],
