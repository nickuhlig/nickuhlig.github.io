  "instructions": [
    {
      "id": 256621,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small pkgs grape tomatoes\n1 small bunch green onions (scallions)\n3 avocados\n3 heads romaine lettuce"
    },
    {
      "id": 256622,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 256623,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl along with yogurt, ketchup, mayo, vinegar, water, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp capers\n¾ cup plain Greek yogurt\n½ cup ketchup\n⅓ cup mayonnaise\n3 tbsp red wine vinegar\n3 tbsp water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 256624,
      "primary_message": "Halve tomatoes and place on a platter.",
      "secondary_message": null
    },
    {
      "id": 256625,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the platter with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 256626,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the platter.",
      "secondary_message": null
    },
    {
      "id": 256627,
      "primary_message": "Coarsely grate cheese and add to the platter.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 256628,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 256629,
      "primary_message": "Divide the romaine between plates or bowls; top with beans, tomato, avocado, and cheese. Sprinkle with green onions and serve with dressing on the side. Enjoy!",
      "secondary_message": null
    }
  ],
