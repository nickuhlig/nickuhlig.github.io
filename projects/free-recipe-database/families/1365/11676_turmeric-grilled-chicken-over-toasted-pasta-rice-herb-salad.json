  "instructions": [
    {
      "id": 197319,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "1 ½ cups jasmine rice"
    },
    {
      "id": 197320,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 197321,
      "primary_message": "While the pot heats up, use your hands to break the pasta into 1-inch pieces.",
      "secondary_message": "6 oz spaghetti pasta"
    },
    {
      "id": 197322,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add the pasta and cook, stirring constantly, until it turns golden, about 2 minutes. Stir in the rice, broth, and salt, then bring to a boil over high heat.",
      "secondary_message": "3 tbsp butter, unsalted\n48 fl oz (6 cups) chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 197323,
      "primary_message": "Meanwhile, combine spices in a small bowl.",
      "secondary_message": "1 ½ tsp turmeric\n1 ½ tsp cumin\n¾ tsp black pepper\n¾ tsp salt"
    },
    {
      "id": 197324,
      "primary_message": "Once the liquid in the pot comes to a boil, stir the mixture, cover the pot, and reduce heat to low. Cook until rice is tender and the liquid is mostly absorbed, 15-18 minutes. Once done, remove rice mixture from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 197325,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with the spice mixture on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 197326,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 197327,
      "primary_message": "While the grill pan heats up, peel and mince garlic using a clean cutting board; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 197328,
      "primary_message": "Once the grill pan is hot, coat with butter. Working in batches if necessary, add chicken and grill, flipping once, until cooked through and golden, 8-10 minutes. Remove to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 197329,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 tomatoes\n1 ½ English cucumbers\n1 small bunch green onions (scallions)\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg fresh mint"
    },
    {
      "id": 197330,
      "primary_message": "Zest and juice lemons into the bowl with the garlic. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 197331,
      "primary_message": "Medium dice tomatoes. Trim and medium dice cucumbers. Trim green onions and cut crosswise into ¼-inch pieces. Add veggies to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 197332,
      "primary_message": "Shave parsley leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 197333,
      "primary_message": "Slice chicken crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 197334,
      "primary_message": "To serve, divide rice mixture, chicken, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
