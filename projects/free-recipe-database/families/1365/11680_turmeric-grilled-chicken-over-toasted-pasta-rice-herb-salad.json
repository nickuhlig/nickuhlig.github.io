  "instructions": [
    {
      "id": 197383,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "½ cup jasmine rice"
    },
    {
      "id": 197384,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 197385,
      "primary_message": "While the saucepan heats up, use your hands to break the pasta into 1-inch pieces.",
      "secondary_message": "57 g spaghetti pasta"
    },
    {
      "id": 197386,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom. Add the pasta and cook, stirring constantly, until it turns golden, 1-2 minutes. Stir in the rice, broth, and salt, then bring to a boil over high heat.",
      "secondary_message": "1 tbsp butter, unsalted\n473 ml chicken or vegetable broth\n¼ tsp salt"
    },
    {
      "id": 197387,
      "primary_message": "Meanwhile, combine spices in a small bowl.",
      "secondary_message": "½ tsp turmeric\n½ tsp cumin\n¼ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 197388,
      "primary_message": "Once the liquid in the saucepan comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook until rice is tender and the liquid is mostly absorbed, 15-18 minutes. Once done, remove rice mixture from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 197389,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with the spice mixture on both sides.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 197390,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 197391,
      "primary_message": "While the grill pan heats up, peel and mince garlic using a clean cutting board; place in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 197392,
      "primary_message": "Once the grill pan is hot, coat with butter. Add chicken and grill, flipping once, until cooked through and golden, 8-10 minutes. Remove to a plate.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 197393,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 tomato\n½ English cucumber\n½ small bunch green onions (scallions)\n½ small bunch Italian (flat-leaf) parsley\n½ small pkg fresh mint"
    },
    {
      "id": 197394,
      "primary_message": "Zest and juice lemon into the bowl with the garlic. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 197395,
      "primary_message": "Medium dice tomato. Trim and medium dice cucumber. Trim green onions and cut crosswise into ¼-inch pieces. Add veggies to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 197396,
      "primary_message": "Shave parsley leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 197397,
      "primary_message": "Slice chicken crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 197398,
      "primary_message": "To serve, divide rice mixture, chicken, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
