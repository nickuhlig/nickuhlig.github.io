  "instructions": [
    {
      "id": 197303,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "1 cup jasmine rice"
    },
    {
      "id": 197304,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 197305,
      "primary_message": "While the saucepan heats up, use your hands to break the pasta into 1-inch pieces.",
      "secondary_message": "4 oz spaghetti pasta"
    },
    {
      "id": 197306,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom. Add the pasta and cook, stirring constantly, until it turns golden, about 2 minutes. Stir in the rice, broth, and salt, then bring to a boil over high heat.",
      "secondary_message": "2 tbsp butter, unsalted\n32 fl oz (4 cups) chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 197307,
      "primary_message": "Meanwhile, combine spices in a small bowl.",
      "secondary_message": "1 tsp turmeric\n1 tsp cumin\n½ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 197308,
      "primary_message": "Once the liquid in the saucepan comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook until rice is tender and the liquid is mostly absorbed, 15-18 minutes. Once done, remove rice mixture from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 197309,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with the spice mixture on both sides.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 197310,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 197311,
      "primary_message": "While the grill pan heats up, peel and mince garlic using a clean cutting board; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 197312,
      "primary_message": "Once the grill pan is hot, coat with butter. Working in batches if necessary, add chicken and grill, flipping once, until cooked through and golden, 8-10 minutes. Remove to a plate and loosely cover with foil.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 197313,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 tomatoes\n1 English cucumber\n1 small bunch green onions (scallions)\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg fresh mint"
    },
    {
      "id": 197314,
      "primary_message": "Zest and juice lemons into the bowl with the garlic. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 197315,
      "primary_message": "Medium dice tomatoes. Trim and medium dice cucumber. Trim green onions and cut crosswise into ¼-inch pieces. Add veggies to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 197316,
      "primary_message": "Shave parsley leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 197317,
      "primary_message": "Slice chicken crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 197318,
      "primary_message": "To serve, divide rice mixture, chicken, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
