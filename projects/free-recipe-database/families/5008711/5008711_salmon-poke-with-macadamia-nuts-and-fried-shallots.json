  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the raw skinless sashimi-grade salmon into 1/2-inch cubes. Thinly slice the scallion.",
      "secondary_message": "12 oz raw skinless sashimi-grade salmon\n1 scallion"
    },
    {
      "id": 1,
      "primary_message": "Heat vegetable oil and macadamia nuts in a small skillet over medium heat. Cook, tossing and stirring frequently, until nuts are golden brown on most surfaces, about 5 minutes. Transfer to a paper towel–lined plate and allow to cool for 5 minutes. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add salmon, onion, scallion, sesame seeds, shallots, soy sauce, sesame oil, and chili garlic sauce to bowl. Season with a small pinch of kosher salt and gently fold to combine. Taste and adjust with more soy sauce, sesame oil, or chili garlic sauce as desired. Let stand 5 minutes at room temperature, then serve on its own or on top of steamed rice.",
      "secondary_message": null
    }
  ],
