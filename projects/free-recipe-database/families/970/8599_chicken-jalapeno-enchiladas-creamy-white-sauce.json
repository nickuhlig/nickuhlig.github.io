  "instructions": [
    {
      "id": 131150,
      "primary_message": "Place chicken in a medium saucepan; cover with water and bring to a boil over high heat. Reduce heat to medium-low, cover, and let simmer until chicken is cooked through, 8-12 minutes. Remove chicken from the saucepan and place on a plate; discard cooking liquid. ",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n4 cup water"
    },
    {
      "id": 131151,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 jalapeño peppers\n1 tomato\n½ small bunch green onions (scallions)"
    },
    {
      "id": 131152,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely dice and set aside. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 131153,
      "primary_message": "Heat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 131154,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 131155,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 131156,
      "primary_message": "Add the jalapeños, onion, garlic, chili powder, and salt to the saucepan. Cook, stirring occasionally, until vegetables have softened, 4-5 minutes.",
      "secondary_message": "½ tsp chili powder\n½ tsp salt"
    },
    {
      "id": 131157,
      "primary_message": "Grate the mozzarella cheese. ",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 131158,
      "primary_message": "Transfer cooked vegetables from the saucepan to a medium bowl. Shred the chicken and add to the bowl with the vegetables. Stir to combine and set aside. ",
      "secondary_message": null
    },
    {
      "id": 131159,
      "primary_message": "Return small saucepan to stove over medium heat. Melt the butter, then add the flour. Whisk for 1 minute. ",
      "secondary_message": "1 ½ tbsp butter, unsalted\n1 ½ tbsp all-purpose flour"
    },
    {
      "id": 131160,
      "primary_message": "Add the broth and salt to the saucepan; whisk until thickened, 2-3 minutes. Remove from the heat and let cool, 3-5 minutes. ",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 131161,
      "primary_message": "Preheat oven to broil.",
      "secondary_message": null
    },
    {
      "id": 131162,
      "primary_message": "Grease the bottom of a baking dish with oil. Place ⅓ cup of chicken filling in the center of each tortilla. Top chicken with 1 tbsp of cheese. Roll tightly and place seam-side down in the baking dish. ",
      "secondary_message": "½ tsp extra virgin olive oil\n4 small flour tortillas"
    },
    {
      "id": 131163,
      "primary_message": "Add yogurt to the pan with the sauce and whisk until smooth. Pour the sauce over the tortillas in the baking dish. Top with the remaining cheese. Place baking dish in the oven and broil until cheese is melted and bubbly, 3-4 minutes.",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 131164,
      "primary_message": "Meanwhile, small dice the tomato and green onion. ",
      "secondary_message": null
    },
    {
      "id": 131165,
      "primary_message": "Divide the enchiladas between plates and top with tomato and green onion. Enjoy! ",
      "secondary_message": null
    }
  ],
