  "instructions": [
    {
      "primary_message": "Preheat the oven to 425°F. ",
      "secondary_message": null
    },
    {
      "primary_message": "Using a strainer, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth, cover, then bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes. Drain well and set aside.  ",
      "secondary_message": "1 cup green lentils, dried\n710 ml chicken or vegetable broth"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.  ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "Remove stems from the mushrooms and carefully scrape out the gills. Arrange on a baking sheet pan, gill-side up; drizzle with oil, then season with salt and pepper. ",
      "secondary_message": "extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven and bake until mushrooms are fork-tender, 12-15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, trim, seed, and small dice bell peppers. Place in a large bowl.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic. Add both to the bowl with the bell pepper. ",
      "secondary_message": "1 medium yellow onion\n3 clove garlic"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until softened, 6-7 minutes. Remove from heat. (Reserve bowl for the next step.) ",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "While the veggies are cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop almonds. Add to the bowl with the parsley.  ",
      "secondary_message": "⅔ cup almonds"
    },
    {
      "primary_message": "Crumble half of the goat cheese into the bowl.  ",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "primary_message": "Add cooked lentils and veggies, cranberries, vinegar, salt, and pepper to the bowl. Stir to combine the filling. ",
      "secondary_message": "⅔ cup dried cranberries\n¼ cup balsamic vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Divide lentil filling between the mushroom caps, then crumble remaining goat cheese over the top. Return to the oven and continue to bake until filling is warmed through, about 5 minutes. Remove from oven.  ",
      "secondary_message": null
    }
  ],
