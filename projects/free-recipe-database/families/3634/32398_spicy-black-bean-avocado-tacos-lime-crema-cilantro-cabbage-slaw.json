  "instructions": [
    {
      "id": 512153,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch cilantro\n1 jalapeño pepper\n½ small bunch green onions (scallions)\n½ small head red cabbage\n½ avocado"
    },
    {
      "id": 512154,
      "primary_message": "Juice half of the lime into a small bowl. Add yogurt and salt, then whisk to combine. Add water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set crema aside. (Reserve remaining lime for the next step.)",
      "secondary_message": "⅓ cup plain Greek yogurt\n⅛ tsp salt"
    },
    {
      "id": 512155,
      "primary_message": "Juice reserved lime into a medium bowl. Add oil and salt, then whisk to combine the dressing.",
      "secondary_message": "1 tsp neutral vegetable oil\n¼ tsp salt"
    },
    {
      "id": 512156,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 512157,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Slice crosswise into thin half-moons and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 512158,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512159,
      "primary_message": "Quarter cabbage lengthwise, then cut out and discard the core; slice crosswise into thin (shred-like) strips. Add to the bowl and toss to combine the slaw. Set aside.",
      "secondary_message": null
    },
    {
      "id": 512160,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 512161,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 512162,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 512163,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and cumin; cook, stirring frequently, until fragrant, about 30 seconds. ",
      "secondary_message": "1 tbsp neutral vegetable oil\n¼ tsp cumin, ground"
    },
    {
      "id": 512164,
      "primary_message": "Add beans, hot sauce, and salt to the skillet. Continue to cook, stirring occasionally, until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "1 tbsp hot sauce\n¼ tsp salt"
    },
    {
      "id": 512165,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Season with salt.",
      "secondary_message": "1 pinch salt"
    },
    {
      "id": 512166,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 512167,
      "primary_message": "Divide tortillas between plates, then top with beans, avocado, crema, and reserved cilantro. Serve with slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
