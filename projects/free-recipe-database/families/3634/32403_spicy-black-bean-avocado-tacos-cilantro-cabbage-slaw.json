  "instructions": [
    {
      "id": 512226,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small bunch cilantro\n3 jalapeño peppers\n1 small bunch green onions (scallions)\n1 ½ small heads red cabbage\n1 ½ avocados"
    },
    {
      "id": 512227,
      "primary_message": "Juice limes into a large bowl. Add oil and salt, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp neutral vegetable oil\n¾ tsp salt"
    },
    {
      "id": 512228,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 512229,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Slice crosswise into thin half-moons and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 512230,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512231,
      "primary_message": "Quarter each cabbage lengthwise, then cut out and discard the cores; slice crosswise into thin (shred-like) strips. Add to the bowl and toss to combine the slaw. Set aside.",
      "secondary_message": null
    },
    {
      "id": 512232,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 512233,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 512234,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 512235,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic and cumin; cook, stirring frequently, until fragrant, about 30 seconds. ",
      "secondary_message": "3 tbsp neutral vegetable oil\n¾ tsp cumin, ground"
    },
    {
      "id": 512236,
      "primary_message": "Add beans, hot sauce, and salt to the pot. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "3 tbsp hot sauce\n¾ tsp salt"
    },
    {
      "id": 512237,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Season with salt.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 512238,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 512239,
      "primary_message": "Divide tortillas between plates, then top with beans, avocado, and reserved cilantro. Serve with slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
