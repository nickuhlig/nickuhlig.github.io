  "instructions": [
    {
      "id": 175284,
      "primary_message": "Wash and dry thyme. Add thyme sprigs, water, vinegar, salt, and coriander to a medium saucepan; cover and bring to a boil over high heat.",
      "secondary_message": "½ small pkg fresh thyme\n4 cup water\n½ cup apple cider vinegar\n1 tbsp salt\n1 tsp coriander"
    },
    {
      "id": 175285,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) ",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 175286,
      "primary_message": "Once the liquid comes to a boil, uncover, add shrimp, and stir for a few seconds. Remove from heat, and let the shrimp pickle in the cooking liquid while you prepare the rest of the salad, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 175287,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ jalapeño pepper\n½ red bell pepper\n½ English cucumber\n1 medium carrot\n1 avocado"
    },
    {
      "id": 175288,
      "primary_message": "Grate the zest from the lemon and transfer to a medium bowl, then juice the lemon into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 175289,
      "primary_message": "Peel and mince the garlic; transfer to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 175290,
      "primary_message": "Add additional vinegar, oil, salt, and pepper to the bowl and whisk to combine the dressing.",
      "secondary_message": "1 tbsp apple cider vinegar\n2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 175291,
      "primary_message": "Thinly slice the jalapeño into rounds (be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 175292,
      "primary_message": "Peel and thinly slice the shallot into rings. Add shallots and jalapeños to the bowl with the dressing.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 175293,
      "primary_message": "Seed and slice bell pepper into thin strips. Peel and medium dice the cucumber. Peel and thinly slice the carrot into rounds. Add vegetables to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 175294,
      "primary_message": "Halve and pit the avocado; scoop out the flesh and medium dice. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 175295,
      "primary_message": "Drain the shrimp and discard the liquid. Remove tails, then add shrimp to the bowl with the vegetables and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 175296,
      "primary_message": "Toast and butter the bread, then slice on the diagonal to make toast points.",
      "secondary_message": "4 slices whole grain bread\n1 tbsp butter, unsalted"
    },
    {
      "id": 175297,
      "primary_message": "To serve, divide shrimp salad between bowls. Enjoy with a side of buttered toast points for dipping. ",
      "secondary_message": null
    }
  ],
