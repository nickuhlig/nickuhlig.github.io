  "instructions": [
    {
      "id": 175312,
      "primary_message": "Wash and dry thyme. Add thyme sprigs, water, vinegar, salt, and coriander to a large pot; cover and bring to a boil over high heat.",
      "secondary_message": "1 small pkg fresh thyme\n12 cup water\n1 ½ cup apple cider vinegar\n3 tbsp salt\n1 tbsp coriander"
    },
    {
      "id": 175313,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) ",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 175314,
      "primary_message": "Once the liquid comes to a boil, uncover, add shrimp, and stir for a few seconds. Remove from heat, and let the shrimp pickle in the cooking liquid while you prepare the rest of the salad, about 25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 175315,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 ½ jalapeño peppers\n1 ½ red bell peppers\n1 ½ English cucumbers\n3 medium carrots\n3 avocados"
    },
    {
      "id": 175316,
      "primary_message": "Grate the zest from the lemons and transfer to a large bowl, then juice the lemons into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 175317,
      "primary_message": "Peel and mince the garlic; transfer to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 175318,
      "primary_message": "Add additional vinegar, oil, salt, and pepper to the bowl and whisk to combine the dressing.",
      "secondary_message": "3 tbsp apple cider vinegar\n⅓ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 175319,
      "primary_message": "Thinly slice the jalapeños into rounds (be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 175320,
      "primary_message": "Peel and thinly slice shallots into rings. Add shallots and jalapeños to the bowl with the dressing.",
      "secondary_message": "1 ½ shallots"
    },
    {
      "id": 175321,
      "primary_message": "Seed and slice bell peppers into thin strips. Peel and medium dice cucumbers. Peel and thinly slice carrots into rounds. Add vegetables to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 175322,
      "primary_message": "Halve and pit avocados; scoop out the flesh and medium dice. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 175323,
      "primary_message": "Drain the shrimp and discard the liquid. Remove tails, then add shrimp to the bowl with the vegetables and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 175324,
      "primary_message": "Toast and butter the bread, then slice on the diagonal to make toast points.",
      "secondary_message": "12 slices whole grain bread\n3 tbsp butter, unsalted"
    },
    {
      "id": 175325,
      "primary_message": "To serve, divide shrimp salad between bowls. Enjoy with a side of buttered toast points for dipping. ",
      "secondary_message": null
    }
  ],
