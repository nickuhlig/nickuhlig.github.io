  "instructions": [
    {
      "id": 1,
      "primary_message": "Position the racks in the upper and lower thirds of the oven and preheat oven to 400°F. Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Put sugar, butter, eggs, and vanilla in bowl of stand mixer fitted with paddle attachment (or use a hand mixer) and mix on low until well blended.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk together flour, baking powder, and salt in bowl and stir into butter mixture. Mix sugar and cinnamon for rolling in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Use a 3/4-ounce scoop to portion dough into generous 1 1/2-tablespoon balls, roll each one in cinnamon sugar, and lay out on the prepared pans, leaving 2 inches between them. Bake for 10 minutes, rotating pans halfway through, or until just set and turning golden brown around the edges.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Let cookies cool for 10 minutes on the pans, then transfer to a wire rack to cool completely. The snickerdoodles can be kept in an airtight container for up to 1 week.",
      "secondary_message": null
    }
  ],
