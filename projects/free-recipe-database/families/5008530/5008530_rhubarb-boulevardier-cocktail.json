  "instructions": [
    {
      "id": 1,
      "primary_message": "To make the rhubarb syrup, place chopped rhubarb, water, and sugar in a heavy-bottomed pot. Cook over medium low heat, covered, stirring occasionally, for 7 minutes or until rhubarb is tender and begins to fall apart. Strain and let cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To make the cocktail, fill a mixing glass with ice. Add bourbon, Gran Classico, rhubarb syrup, and sweet vermouth. Stir until fully chilled, about 1 minute. Strain into cocktail glass, garnish with lemon twist.",
      "secondary_message": null
    }
  ],
