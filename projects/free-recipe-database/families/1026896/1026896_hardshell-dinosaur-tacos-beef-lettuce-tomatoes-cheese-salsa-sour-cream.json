  "instructions": [
    {
      "primary_message": "Preheat oven to 325°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "primary_message": "Once the skillet is hot, add onion, garlic, and beef. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 lb lean ground beef"
    },
    {
      "primary_message": "Meanwhile, remove taco shells from packaging, transfer to a baking sheet pan, and pull apart slightly. Place in the preheated oven and bake until crisp, 6-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "When the beef is done, drain any excess fat, add water and taco seasoning to the skillet, then stir to combine. Bring to a boil, then reduce heat to medium and simmer, stirring occasionally, until sauce is thickened, 3-4 minutes. Remove from heat.",
      "secondary_message": "1 (1 oz) pkg taco seasoning"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Transfer to a plate.\n\n",
      "secondary_message": "1 heart romaine hearts"
    },
    {
      "primary_message": "Wash, dry, and small dice tomatoes. Add to the plate with the lettuce.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill taco shells with cooked beef, lettuce, tomato, salsa, cheese, and sour cream. Insert tortilla chips into each taco, creating the \"spikes\" of your \"dinosaur.\" (Reserve any remaining lettuce and chips for the next step.)\n\n",
      "secondary_message": "⅔ cup salsa\n⅔ cup cheddar cheese, shredded\n⅔ cup sour cream\n1 (9.2 oz) bag tortilla chips, nacho cheese-flavored"
    },
    {
      "primary_message": "Transfer remaining lettuce to a platter, then arrange dinosaur tacos on top. Serve with extra chips on the side and enjoy!",
      "secondary_message": null
    }
  ],
