  "instructions": [
    {
      "id": 417892,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. Line a baking sheet pan with aluminum foil to make clean-up easier (optional). ",
      "secondary_message": null
    },
    {
      "id": 417893,
      "primary_message": "Wash, dry, and cut bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Slice each quarter crosswise into 3-4 pieces to make the \"chips.\"",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 417894,
      "primary_message": "Arrange bell pepper chips, skin-side down, in a single layer on the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 417895,
      "primary_message": "Drain and rinse beans in a colander. Place in a medium bowl, add spices, and stir to combine.",
      "secondary_message": "2 (398 ml) cans pinto beans\n1 tsp chili powder\n½ tsp oregano, dried\n½ tsp salt"
    },
    {
      "id": 417896,
      "primary_message": "Divide seasoned beans between bell pepper chips, then top with cheese.",
      "secondary_message": "1 cup shredded cheese, Mexican blend"
    },
    {
      "id": 417897,
      "primary_message": "Place baking sheet in the oven and broil until beans are warmed through and cheese is melted, 3-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 417898,
      "primary_message": "To serve, divide the \"nachos\" between plates and top with salsa. Enjoy!",
      "secondary_message": "1 cup salsa"
    }
  ],
