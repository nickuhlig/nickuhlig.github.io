  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the 70% bittersweet chocolate. Chop the roasted cashews.",
      "secondary_message": "227 g 70% bittersweet chocolate\n½ cup roasted cashews"
    },
    {
      "id": 1,
      "primary_message": "Adjust rack to middle position and preheat oven to 175°C (350°F). Line bottom and two sides of an 8- by 20-cm baking pan with foil, allowing edges to overhang the sides. Grease the pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large heatproof bowl set over a pan of barely simmering water, heat butter, chocolate, espresso powder, and salt until melted and smooth.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove from heat and let cool 5 minutes. Whisk in sugars until combined. Add eggs, one by one, whisking well after each addition. Add vanilla and mixture for one minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add flour to chocolate and whisk until combined and mixture is smooth and glossy (see note). Stir in cashews. Spread into pan and bake until just set and top is crusty, about 25 minutes. Transfer pan to wire rack to cool before cutting into squares.",
      "secondary_message": null
    }
  ],
