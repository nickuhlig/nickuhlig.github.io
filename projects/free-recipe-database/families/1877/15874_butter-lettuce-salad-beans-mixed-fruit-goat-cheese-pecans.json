  "instructions": [
    {
      "id": 261239,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 pears\n¾ lb red grapes\n3 (6 oz) pkgs blueberries\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 261240,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 261241,
      "primary_message": "Zest and juice lemons into a large bowl; add oil, vinegar, honey, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup apple cider vinegar\n2 tbsp honey\n1 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 261242,
      "primary_message": "Peel, halve, and thinly slice shallots. Add to the bowl with the dressing, along with the beans, and toss to combine.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 261243,
      "primary_message": "Quarter, core, and thinly slice pears; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 261244,
      "primary_message": "Halve grapes and add to the bowl along with the blueberries.",
      "secondary_message": null
    },
    {
      "id": 261245,
      "primary_message": "Chop or tear lettuce into bite-sized pieces, add to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 261246,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "⅓ cup pecans, dry roasted"
    },
    {
      "id": 261247,
      "primary_message": "To serve, divide salad between plates or bowls and crumble goat cheese over top. Sprinkle with pecans and enjoy!",
      "secondary_message": "3 (4 oz) logs goat cheese"
    }
  ],
