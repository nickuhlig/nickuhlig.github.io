  "instructions": [
    {
      "id": 261257,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 pears\n0.23 kg red grapes\n2 (170 g) pkg blueberries\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 261258,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 261259,
      "primary_message": "Zest and juice lemon into a large bowl; add oil, vinegar, honey, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n4 tsp honey\n2 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 261260,
      "primary_message": "Peel, halve, and thinly slice shallot. Add to the bowl with the dressing, along with the beans, and toss to combine.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 261261,
      "primary_message": "Quarter, core, and thinly slice pears; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 261262,
      "primary_message": "Halve grapes and add to the bowl along with the blueberries.",
      "secondary_message": null
    },
    {
      "id": 261263,
      "primary_message": "Chop or tear lettuce into bite-sized pieces, add to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 261264,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 261265,
      "primary_message": "To serve, divide salad between plates or bowls and crumble goat cheese over top. Sprinkle with pecans and enjoy!",
      "secondary_message": "2 (113 g) logs goat cheese"
    }
  ],
