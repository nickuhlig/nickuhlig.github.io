  "instructions": [
    {
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Season with pepper and salt, then toss to coat. Arrange in an even layer in air fryer basket. (Work in batches, if necessary, to accommodate the size of your air fryer basket.)",
      "secondary_message": "1 lb chicken wings, split with tips removed\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "primary_message": "Insert basket into air fryer and set temperature to 400°F. Cook, flipping halfway through, until wings are golden and crisp, 20-22 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, zest, and juice lemon into a clean medium bowl. Add honey, salt, and pepper, then whisk to combine the wing sauce; set aside.",
      "secondary_message": "½ lemon\n1 tbsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "When the wings are done, remove basket from air fryer. Add wings to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange wings on a platter. Enjoy!",
      "secondary_message": null
    }
  ],
