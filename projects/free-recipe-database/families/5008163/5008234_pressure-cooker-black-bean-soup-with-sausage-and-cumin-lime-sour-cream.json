  "instructions": [
    {
      "id": 1,
      "primary_message": "In a pressure cooker, heat oil over medium-high heat until shimmering. Add onion, celery, and garlic and cook, stirring, until lightly browned, about 6 minutes. Add mushrooms and cook, stirring, until they release their juices and just begin to brown, about 6 minutes. Add sausage and continue to cook, stirring frequently, for 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add chicken stock or water, beans, thyme, and bay leaf and stir well. Liquid should fully cover beans by at least 5 cm; if not, add water as needed. Season with salt. Cover pressure cooker and cook at high pressure for 40 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, in a small bowl, whisk together sour cream, lime zest, and cumin. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Using pressure-release valve, depressurize cooker. Stir stew, then season with salt and pepper as needed. Discard thyme and bay leaf. Spoon stew into bowls and top with generous dollops of sour cream. Garnish with cilantro, if desired. Serve.",
      "secondary_message": null
    }
  ],
