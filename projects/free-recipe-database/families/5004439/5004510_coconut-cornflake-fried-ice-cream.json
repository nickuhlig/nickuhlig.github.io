  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Crush the cornflakes. Finely chop the bittersweet chocolate.",
      "secondary_message": "5 cups cornflakes\n113 g bittersweet chocolate"
    },
    {
      "id": 1,
      "primary_message": "Scoop out ice cream into 5 balls and place on a chilled pan. Freeze until solid, about 1 hour. If necessary, re-shape ice cream into balls and freeze again until solid.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In medium bowl, stir together cornflakes, coconut, and salt. In another bowl, whisk eggs with 1 tablespoon coconut milk.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Working one ball at a time, firmly pack cornflake mixture around ice cream ball. Dip in egg mixture and then re-roll in cornflake mixture. Freeze until completely solid, at least 3 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Just before serving, heat chocolate with remaining 1/2 cup coconut milk in saucepan or in microwave, whisking frequently, until sauce is melted and smooth.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "In large heavy duty saucepan or Dutch oven, heat oil to 185°C (365°F). Carefully drop balls in oil and fry just until golden and crisp, about 30 seconds, turning balls to fry evenly. Remove from oil and place on paper towel lined plate. Serve immediately with sauce and garnishes.",
      "secondary_message": null
    }
  ],
