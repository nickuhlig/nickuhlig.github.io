  "instructions": [
    {
      "id": 42849,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 mangoes\n2 avocados\n2 limes\n1 small bunch cilantro"
    },
    {
      "id": 42850,
      "primary_message": "Peel the mangoes, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and small dice the flesh (cut into ¼-inch cubes). Transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42851,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42852,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42853,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces). Add to the salad bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 42854,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 42855,
      "primary_message": "While the grill pan / skillet heats up, pat the fish dry with paper towels and place on a plate. Rub with olive oil and season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb halibut fillet\n1 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 42856,
      "primary_message": "Once the grill pan / skillet is hot, add the halibut. Cook until the fish is opaque in the center and flaky, 4 to 6 minutes per side (depending on thickness), lowering the heat if needed to keep it from burning on the outside.",
      "secondary_message": null
    },
    {
      "id": 42857,
      "primary_message": "While the fish cooks, juice the limes and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42858,
      "primary_message": "Add olive oil, salt, and pepper to the salsa; toss to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42859,
      "primary_message": "To serve, divide the salsa between plates and top with the halibut fillets. Enjoy!",
      "secondary_message": null
    }
  ],
