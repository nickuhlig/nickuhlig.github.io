  "instructions": [
    {
      "id": 1,
      "primary_message": "In a blender, combine tomatoes, bread, garlic, olive oil, sherry vinegar, and salt. Blend on high speed until completely smooth and creamy, 1 to 2 minutes. For a punchier soup, season with an additional 1/8 teaspoon sherry vinegar.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer salmorejo to an airtight container and refrigerate until thoroughly chilled, at least 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To serve, portion salmorejo into individual bowls. Top with hard-boiled eggs, jamón serrano or ibérico, and a drizzle of extra-virgin olive oil. Serve cold.",
      "secondary_message": null
    }
  ],
