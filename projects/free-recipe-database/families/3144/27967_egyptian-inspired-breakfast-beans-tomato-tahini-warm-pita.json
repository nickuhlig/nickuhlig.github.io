  "instructions": [
    {
      "id": 448461,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 448462,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448463,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 448464,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 448465,
      "primary_message": "Meanwhile, drain and rinse beans in a colander.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 448466,
      "primary_message": "When the onion is soft, add beans and tomatoes to the pan. Stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer until the sauce has thickened and beans are tender, about 10 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 448467,
      "primary_message": "While the beans are cooking, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the pan with the beans and stir to combine (reserve the remaining for serving).",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 448468,
      "primary_message": "Cut pita breads into wedges and arrange on a baking sheet pan. When the beans are almost done, place pita bread in the oven and bake until warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 448469,
      "primary_message": "When the beans are done, wash, dry, and juice lemon into the pan. Add tahini, stir to combine, and remove from heat.",
      "secondary_message": "½ lemon\n1 tbsp tahini"
    },
    {
      "id": 448470,
      "primary_message": "Divide beans between plates or bowls and sprinkle with reserved parsley. Serve with pita on the side and enjoy!",
      "secondary_message": null
    }
  ],
