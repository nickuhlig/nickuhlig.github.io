  "instructions": [
    {
      "id": 448511,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 448512,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 448513,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448514,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 448515,
      "primary_message": "Meanwhile, drain and rinse beans in a colander.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 448516,
      "primary_message": "When the onion is soft, add beans and tomatoes to the pot. Stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer until the sauce has thickened and beans are tender, about 10 minutes.",
      "secondary_message": "3 (398 ml) cans diced tomatoes"
    },
    {
      "id": 448517,
      "primary_message": "While the beans are cooking, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the pot with the beans and stir to combine (reserve the remaining for serving).",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 448518,
      "primary_message": "Cut pita breads into wedges and divide between two baking sheet pans. When the beans are almost done, place pita bread in the oven and bake until warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 448519,
      "primary_message": "When the beans are done, wash, dry, and juice lemons into the pot. Add tahini, stir to combine, and remove from heat.",
      "secondary_message": "1 ½ lemons\n3 tbsp tahini"
    },
    {
      "id": 448520,
      "primary_message": "Divide beans between plates or bowls and sprinkle with reserved parsley. Serve with pita on the side and enjoy!",
      "secondary_message": null
    }
  ],
