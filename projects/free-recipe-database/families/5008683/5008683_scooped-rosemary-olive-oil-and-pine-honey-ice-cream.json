  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine half and half, rosemary, and salt in a 3 quart saucepan and heat to just below a simmer. Steep rosemary in dairy for 15 minutes, stirring occasionally, then discard rosemary.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk together egg yolks and honey till well-combined. Slowly pour in hot dairy, whisking constantly. Return yolk and dairy mixture to pot and heat on low, just below a simmer, stirring frequently. Custard is done when it forms a thin coat on the back of a spoon and a finger swipes a clean line across.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk in olive oil, then transfer to an airtight container to chill in the refrigerator overnight. The next day, churn according to manufacturer's instructions, then freeze for 2 to 3 hours or until firm. Ice cream is best if left to thaw on the counter 10 minutes before serving.",
      "secondary_message": null
    }
  ],
