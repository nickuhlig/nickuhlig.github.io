  "instructions": [
    {
      "id": 47817,
      "primary_message": "In a small saucepan, combine the quinoa and broth; bring to a boil over high heat.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 47818,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 Gala apples\n2 sticks celery\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 47819,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 47820,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the quinoa for 15 minutes. Once done, remove the quinoa from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 47821,
      "primary_message": "Quarter the apples lengthwise, then cut out the core and stem from each section; medium dice the apples into ½-inch cubes and transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47822,
      "primary_message": "Trim off and discard the ends of the celery; medium dice the celery into ½-inch pieces and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47823,
      "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47824,
      "primary_message": "Transfer the feta to a small bowl.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 47825,
      "primary_message": "Juice the lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 47826,
      "primary_message": "To the lemon juice, add olive oil, honey, curry powder, salt, and pepper; whisk together.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp honey\n1 tsp curry powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 47827,
      "primary_message": "Uncover the quinoa and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 47828,
      "primary_message": "Add the chickpeas and quinoa to the salad bowl, then pour the dressing overtop and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 47829,
      "primary_message": "To serve, divide the salad between plates or bowls and top with the feta. Enjoy!",
      "secondary_message": ""
    }
  ],
