  "instructions": [
    {
      "id": 1,
      "primary_message": "Put vodka, dill, and lemon zest in a sealable glass jar. Seal and shake, then let steep at room temperature for one day. Remove and discard lemon zest and dill.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add caraway seeds, star anise, and fennel seeds to the infused vodka. Let steep at room temperature for an additional 2 days. From here, taste the aquavit as it infuses. If you'd like a stronger flavor, continue to steep for up to 2 weeks. When desired flavor is achieved, strain through cheesecloth. Store at room temperature or in the refrigerator for up to 6 months.",
      "secondary_message": null
    }
  ],
