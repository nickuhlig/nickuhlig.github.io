  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thickly discard the stems from the watercress. Slice the english cucumber. Thinly slice the red onion.",
      "secondary_message": "½ bunch watercress\n¼ english cucumber\n¼ small red onion"
    },
    {
      "id": 1,
      "primary_message": "Heat water and ginger in a small saucepan until simmering. Add sake and salt and stir to combine. Add chicken. Return to a simmer, cover, remove from heat, and let rest for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, make the dressing. Combine sesame oil, mirin, gochujang, and vinegar an a small bowl and whisk together with a fork. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When chicken has cooked, remove from poaching liquid and let rest until cool enough to handle. Shred meat into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Combine watercress, lettuce, cucumber, and onionin a large serving bowl. Spread chicken on top. Drizzle with half of the dressing and serve with the remaining dressing on the side.",
      "secondary_message": null
    }
  ],
