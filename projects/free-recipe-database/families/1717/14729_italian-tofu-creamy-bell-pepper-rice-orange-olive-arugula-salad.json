  "instructions": [
    {
      "id": 243927,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 243928,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 243929,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 red bell peppers\n3 oranges\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 243930,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large pot. Add broth and salt to the pot; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n887 ml chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 243931,
      "primary_message": "While the broth is heating up, trim, seed, and mince bell peppers.",
      "secondary_message": null
    },
    {
      "id": 243932,
      "primary_message": "Once the broth comes to a boil, add bell pepper and stir to combine; cover the pot and reduce heat to low. Cook bell pepper-rice until liquid is mostly absorbed, 18-20 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 243933,
      "primary_message": "Meanwhile, place oil and spices in a large bowl; stir to combine the spice paste. ",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 243934,
      "primary_message": "Medium dice tofu, add to the bowl with the spice paste, and gently stir to coat. Divide tofu between two baking sheets and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 243935,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 243936,
      "primary_message": "While the tofu is cooking, peel and mince garlic. Place in the reserved bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n¾ tsp paprika\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 243937,
      "primary_message": "Peel and thinly slice shallots into rings. Add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 243938,
      "primary_message": "Cut off skin and white pith from the oranges; slice between the membranes to release segments. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 243939,
      "primary_message": "Halve olives lengthwise. Add to the bowl along with the arugula and toss to combine the salad. Set aside.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 243940,
      "primary_message": "Finely grate Parmesan. When the bell pepper-rice is done, add Parmesan to the pot and stir until creamy and combined.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 243941,
      "primary_message": "To serve, divide tofu, creamy bell pepper-rice, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
