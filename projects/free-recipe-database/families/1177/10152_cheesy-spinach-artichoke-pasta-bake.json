  "instructions": [
    {
      "id": 161794,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 161795,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n170 g rotini pasta"
    },
    {
      "id": 161796,
      "primary_message": "Wash and dry spinach (skip if it came pre-washed), then finely chop and transfer to a medium bowl.",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 161797,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 161798,
      "primary_message": "Peel and mince garlic. Peel and small dice onion.",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 161799,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add garlic and onion to the skillet. Cook, stirring frequently, until onion begins to soften, 2-3 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 161800,
      "primary_message": "Meanwhile, drain and finely chop artichokes. Place in a small bowl along with milk, yogurt, and cornstarch; whisk to combine.",
      "secondary_message": "½ (170 ml) jar artichoke hearts, marinated\n237 ml whole milk\n¼ cup plain Greek yogurt\n1 tsp cornstarch"
    },
    {
      "id": 161801,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 161802,
      "primary_message": "Add milk mixture to the skillet and simmer, stirring frequently, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 161803,
      "primary_message": "Meanwhile, grate Parmesan and mozzarella, keeping them separate.",
      "secondary_message": "28 g Parmesan cheese\n¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 161804,
      "primary_message": "Add Parmesan and salt to the skillet. Stir to combine and continue to cook until cheese is melted and sauce thickens, 3-4 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 161805,
      "primary_message": "Once the pasta is finished, drain and add to the skillet with the sauce. Toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 161806,
      "primary_message": "Top pasta with mozzarella. Place skillet in the oven and bake for 10 minutes, until cheese is melted and bubbly.",
      "secondary_message": null
    },
    {
      "id": 161807,
      "primary_message": "To serve, divide pasta bake between bowls and enjoy!",
      "secondary_message": null
    }
  ],
