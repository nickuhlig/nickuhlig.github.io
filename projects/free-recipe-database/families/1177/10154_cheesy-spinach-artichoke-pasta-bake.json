  "instructions": [
    {
      "id": 161822,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 161823,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n510 g rotini pasta"
    },
    {
      "id": 161824,
      "primary_message": "Wash and dry spinach (skip if it came pre-washed), then finely chop and transfer to a large bowl.",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 161825,
      "primary_message": "Peel and mince garlic. Peel and small dice onions.",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 161826,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 161827,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add garlic and onions to the skillet. Cook, stirring frequently, until onion begins to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 161828,
      "primary_message": "Meanwhile, drain and finely chop artichokes. Place in a medium bowl along with milk, yogurt, and cornstarch; whisk to combine.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated\n710 ml whole milk\n¾ cup plain Greek yogurt\n1 tbsp cornstarch"
    },
    {
      "id": 161829,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 161830,
      "primary_message": "Add milk mixture to the skillet and simmer, stirring frequently, for 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 161831,
      "primary_message": "Meanwhile, grate Parmesan and mozzarella, keeping them separate.",
      "secondary_message": "85 g Parmesan cheese\n¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 161832,
      "primary_message": "Add Parmesan and salt to the skillet. Stir to combine and continue to cook until cheese is melted and sauce thickens, 5-6 minutes.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 161833,
      "primary_message": "Once the pasta is finished, drain and transfer to a large baking dish. Pour spinach sauce over the pasta and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 161834,
      "primary_message": "Top pasta with mozzarella. Place skillet in the oven and bake for 10 minutes, until cheese is melted and bubbly.",
      "secondary_message": null
    },
    {
      "id": 161835,
      "primary_message": "To serve, divide pasta bake between bowls and enjoy!",
      "secondary_message": null
    }
  ],
