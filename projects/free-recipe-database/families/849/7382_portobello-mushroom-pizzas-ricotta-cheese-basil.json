  "instructions": [
    {
      "id": 135547,
      "primary_message": "Preheat the oven to 205°C (400°F) and position rack in the center of the oven. Line a baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 135548,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "8 caps portobello mushrooms\n½ small pkg fresh basil\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 135549,
      "primary_message": "Remove the mushroom stems and carefully scrape out the gills; discard stems and gills.",
      "secondary_message": null
    },
    {
      "id": 135550,
      "primary_message": "Place mushrooms, cap-side up, onto the baking sheet pan and season with oil, salt, and pepper; turn mushrooms over and bake for 10 minutes. When the mushrooms are done, remove from the oven and set aside to cool slightly. ",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 135551,
      "primary_message": "Grate the cheese and transfer to a medium bowl. ",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 135552,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons. ",
      "secondary_message": null
    },
    {
      "id": 135553,
      "primary_message": "Peel and mince garlic; transfer to a large bowl. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 135554,
      "primary_message": "Add oil, vinegar, oregano, salt, and pepper to the bowl with the garlic; whisk to combine. Add mixed greens to the bowl; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n¼ tsp oregano\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 135555,
      "primary_message": "Combine tomato paste and spices in a small bowl; stir to combine. ",
      "secondary_message": "12 tbsp tomato paste\n1 tsp Italian seasoning\n½ tsp garlic powder\n⅛ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 135556,
      "primary_message": "When the mushrooms are cool enough to handle, carefully lift each cap with a spatula and tip the juices out into the sink; return mushrooms, cap-side down, to the baking sheet pan. Blot the inside of each cap with a paper towel before filling. ",
      "secondary_message": null
    },
    {
      "id": 135557,
      "primary_message": "Fill each mushroom cap with 1½ tbsp tomato paste mixture. Divide ricotta cheese and mozzarella between mushrooms, then return to the oven and bake until cheese is melted and mushrooms are heated through, about 5 minutes. ",
      "secondary_message": "1 (425 g) pkg ricotta cheese"
    },
    {
      "id": 135558,
      "primary_message": "To serve, divide mushroom pizzas and salad between plates; sprinkle basil over the mushrooms and enjoy. ",
      "secondary_message": null
    }
  ],
