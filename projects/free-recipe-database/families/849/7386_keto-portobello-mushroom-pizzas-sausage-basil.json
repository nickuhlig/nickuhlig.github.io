  "instructions": [
    {
      "id": 135601,
      "primary_message": "Preheat the oven to 205°C (400°F) and position rack in the center of the oven. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 135602,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "12 caps portobello mushrooms\n¾ small pkg fresh basil\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 135603,
      "primary_message": "Remove the mushroom stems and carefully scrape out the gills; discard stems and gills.",
      "secondary_message": null
    },
    {
      "id": 135604,
      "primary_message": "Place mushrooms, cap-side up, onto the baking sheet pan and season with oil, salt, and pepper; turn mushrooms over and bake for 10 minutes. When the mushrooms are done, remove from the oven and set aside to cool slightly. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 135605,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 135606,
      "primary_message": "Slice the sausage into ½-inch-thick rounds.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 135607,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage slices to the skillet and cook, stirring occasionally, until the sausage slices are browned, about 5 minutes; remove from heat. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 135608,
      "primary_message": "Grate the cheese and transfer to a large bowl. ",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 135609,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons. ",
      "secondary_message": null
    },
    {
      "id": 135610,
      "primary_message": "Peel and mince garlic; transfer to another large bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 135611,
      "primary_message": "Add oil, vinegar, oregano, salt, and pepper to the bowl with the garlic; whisk to combine. Add mixed greens to the bowl; toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¼ cup red wine vinegar\n⅜ tsp oregano\n⅜ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 135612,
      "primary_message": "Combine spices in a small bowl; stir to combine",
      "secondary_message": "1 ½ tsp Italian seasoning\n¾ tsp garlic powder\n¼ tsp crushed red pepper\n3 pinch salt"
    },
    {
      "id": 135613,
      "primary_message": "When the mushrooms are cool enough to handle, carefully lift each cap with a spatula and tip the juices out into the sink; return mushrooms, cap-side down, to the baking sheet pan. Blot the inside of each cap with a paper towel before filling. ",
      "secondary_message": null
    },
    {
      "id": 135614,
      "primary_message": "Season each mushroom cap with ¼ tsp spice mixture. Divide cheese and sausage between mushrooms, then return to the oven and bake until cheese is melted and mushrooms are heated through, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 135615,
      "primary_message": "To serve, divide mushroom pizzas and salad between plates; sprinkle basil over the mushrooms and enjoy. ",
      "secondary_message": null
    }
  ],
