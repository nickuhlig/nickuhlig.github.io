  "instructions": [
    {
      "id": 33838,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lb sweet potatoes\n1 lime\n1 small bunch green onions (scallions)\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 33839,
      "primary_message": "Peel and small dice the potatoes (cut into ¼-inch cubes); transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 33840,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 33841,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces).",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 33842,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 33843,
      "primary_message": "Add the onion to the skillet; cook, stirring occasionally, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 33844,
      "primary_message": "While the onion cooks, trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 33845,
      "primary_message": "Juice the lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 33846,
      "primary_message": "Add more coconut oil and the sweet potatoes to the skillet; season with salt, chili powder, cumin, and black pepper. Cook, stirring occasionally, until they are browned and tender, 10 to 15 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\n1 tsp salt\n1 tsp chili powder\n½ tsp cumin\n½ tsp black pepper"
    },
    {
      "id": 33847,
      "primary_message": "While the potatoes cook, drain and rinse the beans, then set aside to drain further.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 33848,
      "primary_message": "In nonstick skillet, melt coconut oil over medium heat.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 33849,
      "primary_message": "Gently crack 4 of the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 2 to 3 minutes. Once done, separate the eggs and transfer to a plate. Repeat with the remaining eggs.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 33850,
      "primary_message": "Add the black beans, spinach, ½ of the green onions (save the rest for garnishing), and lime juice to the potatoes; cook, stirring constantly, until the spinach is wilted and the beans are heated through, 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 33851,
      "primary_message": "To serve, spoon the hash onto a plate, top with the fried eggs, and sprinkle with the remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
