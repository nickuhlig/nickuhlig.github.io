  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Shred the low-moisture mozzarella cheese.",
      "secondary_message": "113 g low-moisture mozzarella cheese"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to upper-middle position and preheat oven broiler on high. In a medium bowl, stir together mozzarella, ricotta, basil, lemon zest, crushed red pepper (if using), 2 tablespoons Parmesan, 1/4 teaspoon kosher salt, and 1/4 teaspoon black pepper; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large cast iron or stainless-steel skillet, heat oil over medium-high until shimmering. Add gnocchi and cook, without moving, until browned and crisp on bottom side, about 4 minutes. Stir, then continue cooking until browned in more spots, about 2 minutes. Add corn and cook, stirring occasionally, until corn is softened and beginning to char, about 3 minutes. Remove from heat, and sprinkle with remaining 1/4 teaspoon kosher salt and black pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a soup spoon, dollop ricotta mixture evenly over gnocchi. Broil until cheese is melted and beginning to brown on top, 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Drizzle with more oil, and sprinkle with remaining 2 tablespoons Parmesan and additional basil. Serve.",
      "secondary_message": null
    }
  ],
