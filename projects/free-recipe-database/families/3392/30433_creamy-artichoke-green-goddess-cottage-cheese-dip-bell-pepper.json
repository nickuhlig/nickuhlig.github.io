  "instructions": [
    {
      "id": 490117,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¼ small bunch fresh dill\n½ small pkg chives\n2 red bell peppers"
    },
    {
      "id": 490118,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Trim and roughly chop chives. Place both in a blender.",
      "secondary_message": null
    },
    {
      "id": 490119,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 490120,
      "primary_message": "Drain artichokes (saving the marinating liquid to thin out the dip if needed). Add artichokes to the blender with along with cottage cheese, yogurt, salt, and pepper.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated\n¾ cup cottage cheese\n⅓ cup plain Greek yogurt\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 490121,
      "primary_message": "Blend the mixture on high for several minutes until smooth and light green in color, scraping down the sides of the blender as needed. Add marinating liquid, 1 tablespoon at a time, if needed, to reach desired consistency. Set aside.",
      "secondary_message": null
    },
    {
      "id": 490122,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise, then slice into ½-inch thick strips.",
      "secondary_message": null
    },
    {
      "id": 490123,
      "primary_message": "Divide dip between bowls and sprinkle with sesame seeds. Serve with bell pepper on the side for dipping. Enjoy!",
      "secondary_message": "½ tsp sesame seeds"
    }
  ],
