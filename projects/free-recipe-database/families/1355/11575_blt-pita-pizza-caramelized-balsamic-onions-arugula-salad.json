  "instructions": [
    {
      "id": 196780,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 196781,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196782,
      "primary_message": "Add bacon to the skillet and cook until crispy, 3-5 minutes per side. Remove to a paper towel-lined plate.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 196783,
      "primary_message": "While the bacon is cooking, peel, halve, and thinly slice onion into half moons.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 196784,
      "primary_message": "Remove all but 1 tbsp of bacon fat from the skillet and return to medium heat. Add onions, salt, and pepper; cook, stirring often, until soft and golden, about 6 minutes.",
      "secondary_message": "⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 196785,
      "primary_message": "Meanwhile, wash, dry, and thinly slice tomatoes.",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 196786,
      "primary_message": "Coarsely grate the cheese.",
      "secondary_message": "⅓ (227 g) block mozzarella cheese"
    },
    {
      "id": 196787,
      "primary_message": "When the onions are soft, add vinegar and continue to cook until reduced, 1-2 minutes more.",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 196788,
      "primary_message": "Arrange pitas on a baking sheet pan and layer with tomatoes, onions, and cheese. Place in the oven and bake until cheese is melted, about 8 minutes.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 196789,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 196790,
      "primary_message": "Whisk together oil, vinegar, salt, and pepper in a medium bowl. Add the arugula and toss to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 196791,
      "primary_message": "Crumble or chop bacon into small pieces. ",
      "secondary_message": null
    },
    {
      "id": 196792,
      "primary_message": "To serve, divide pizzas between plates; top with bacon and arugula. Enjoy!",
      "secondary_message": null
    }
  ],
