  "instructions": [
    {
      "id": 585655,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 red bell pepper\n1 orange bell pepper\n½ jalapeño pepper\n½ small pkg fresh basil\n½ lime"
    },
    {
      "id": 585656,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 585657,
      "primary_message": "While the skillet heats up, slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 585658,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until browned and warmed through, 5-6 minutes (or cook according to package instructions). Transfer to a plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 585659,
      "primary_message": "Meanwhile, peel and mince garlic. Divide between a small and a medium bowl, then set the small bowl aside for later use.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 585660,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Add to the medium bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 585661,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 585662,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 585663,
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 585664,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies are fork-tender, 6-8 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 585665,
      "primary_message": "Meanwhile, place corn in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "⅔ cup frozen corn"
    },
    {
      "id": 585666,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince half of the leaves. Add to the small bowl with the garlic. (Reserve whole remaining basil leaves for later use.)",
      "secondary_message": null
    },
    {
      "id": 585667,
      "primary_message": "Juice lime into the bowl. Add yogurt, mayo, salt, and pepper, then stir to combine the sauce. Set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n3 tbsp mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 585668,
      "primary_message": "When the veggies are done, return sausage to the skillet along with the corn. Continue to cook, stirring occasionally, until corn is warmed through, 2-3 minutes more. Remove from heat, add reserved basil leaves, and stir once more to combine.",
      "secondary_message": null
    },
    {
      "id": 585669,
      "primary_message": "To serve, divide sausage skillet between plates or bowls. Drizzle with sauce and enjoy! ",
      "secondary_message": null
    }
  ],
