  "instructions": [
    {
      "id": 585460,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 red bell peppers\n3 orange bell peppers\n1 ½ jalapeño peppers\n1 small pkg fresh basil\n1 ½ limes"
    },
    {
      "id": 585461,
      "primary_message": "Preheat two large skillets over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 585462,
      "primary_message": "While the skillets heat up, slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 585463,
      "primary_message": "Once the skillets are hot, divide oil between them and swirl to coat the bottom; divide sausage between the skillets and cook, turning occasionally, until golden brown and crispy, 6-7 minutes. Transfer to a plate and set aside. (Reserve skillets with drippings for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 585464,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Divide between a small and a large bowl, then set the small bowl aside for later use.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 585465,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Add to the large bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 585466,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 585467,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 585468,
      "primary_message": "Peel, halve, and medium dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 585469,
      "primary_message": "Return skillets (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies are fork-tender, 8-10 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 585470,
      "primary_message": "Meanwhile, place corn in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 585471,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince half of the leaves. Add to the small bowl with the garlic. (Reserve whole remaining basil leaves for later use.)",
      "secondary_message": null
    },
    {
      "id": 585472,
      "primary_message": "Juice limes into the bowl. Add yogurt, mayo, salt, and pepper, then stir to combine the sauce. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n½ cup mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 585473,
      "primary_message": "When the veggies are done, return sausage to the skillets along with the corn. Continue to cook, stirring occasionally, until corn is warmed through, 3-4 minutes more. Remove from heat, add reserved basil leaves, and stir once more to combine.",
      "secondary_message": null
    },
    {
      "id": 585474,
      "primary_message": "To serve, divide sausage skillet between plates or bowls. Drizzle with sauce and enjoy! ",
      "secondary_message": null
    }
  ],
