  "instructions": [
    {
      "id": 585670,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n2 red bell peppers\n2 orange bell peppers\n1 jalapeño pepper\n1 small pkg fresh basil\n1 lime"
    },
    {
      "id": 585671,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 585672,
      "primary_message": "While the pot heats up, slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 585673,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until browned and warmed through, 6-7 minutes (or cook according to package instructions). Transfer to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 585674,
      "primary_message": "Meanwhile, peel and mince garlic. Divide between a small and a large bowl, then set the small bowl aside for later use.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 585675,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Add to the large bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 585676,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 585677,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 585678,
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 585679,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies are fork-tender, 8-10 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp smoked paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 585680,
      "primary_message": "Meanwhile, place corn in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 ⅓ cups frozen corn"
    },
    {
      "id": 585681,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince half of the leaves. Add to the small bowl with the garlic. (Reserve whole remaining basil leaves for later use.)",
      "secondary_message": null
    },
    {
      "id": 585682,
      "primary_message": "Juice lime into the bowl. Add yogurt, mayo, salt, and pepper, then stir to combine the sauce. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n⅓ cup mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 585683,
      "primary_message": "When the veggies are done, return sausage to the pot along with the corn. Continue to cook, stirring occasionally, until corn is warmed through, 3-4 minutes more. Remove from heat, add reserved basil leaves, and stir once more to combine.",
      "secondary_message": null
    },
    {
      "id": 585684,
      "primary_message": "To serve, divide sausage sauté between plates or bowls. Drizzle with sauce and enjoy! ",
      "secondary_message": null
    }
  ],
