  "instructions": [
    {
      "id": 496845,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 496846,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n½ lb cremini mushrooms\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 496847,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 496848,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the cauliflower rice along with oil and spices, then stir to combine. Transfer to a baking sheet pan and spread out in an even layer.",
      "secondary_message": "1 tbsp neutral vegetable oil\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 496849,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower and mushrooms are tender and golden, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 496850,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496851,
      "primary_message": "Once the skillet is hot, add beef, salt, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "¾ lb lean ground beef\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 496852,
      "primary_message": "While the beef is cooking, finely grate Parmesan. Set aside.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 496853,
      "primary_message": "When the beef is done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine, remove from heat, and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 496854,
      "primary_message": "When the cauliflower rice and mushrooms are done, remove from oven. Carefully add both to the skillet with the beef mixture along with Parmesan and soy sauce. Stir to combine.",
      "secondary_message": "2 tsp soy sauce"
    },
    {
      "id": 496855,
      "primary_message": "To serve, divide cauliflower rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
