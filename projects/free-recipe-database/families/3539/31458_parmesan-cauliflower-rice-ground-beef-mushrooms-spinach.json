  "instructions": [
    {
      "id": 496900,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 496901,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lb cremini mushrooms\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 496902,
      "primary_message": "Cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 496903,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the cauliflower rice along with oil and spices, then stir to combine. Divide between two large baking sheet pans and spread out in an even layer.",
      "secondary_message": "3 tbsp neutral vegetable oil\n1 tbsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 496904,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower and mushrooms are tender and golden, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 496905,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496906,
      "primary_message": "Once the pot is hot, add beef, salt, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 496907,
      "primary_message": "While the beef is cooking, finely grate Parmesan. Set aside.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 496908,
      "primary_message": "When the beef is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine, remove from heat, and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 496909,
      "primary_message": "When the cauliflower rice and mushrooms are done, remove from oven. Carefully add both to the pot with the beef mixture along with Parmesan and coconut aminos. Stir to combine.",
      "secondary_message": "2 tbsp coconut aminos"
    },
    {
      "id": 496910,
      "primary_message": "To serve, divide cauliflower rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
