  "instructions": [
    {
      "id": 478718,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 478719,
      "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 478720,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 478721,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ (454 g) pkgs strawberries\n6 kiwifruit\n3 (142 g) pkgs baby spinach"
    },
    {
      "id": 478722,
      "primary_message": "Peel and mince shallots. Place in a large bowl along with oil, vinegar, sesame seeds, Worcestershire, sugar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n¼ cup extra virgin olive oil\n2 tbsp white wine vinegar\n3 tbsp sesame seeds\n2 tbsp Worcestershire sauce\n2 tbsp brown sugar\n¾ tsp salt\n½ tsp black pepper\n½ tsp paprika"
    },
    {
      "id": 478723,
      "primary_message": "Trim and thinly slice strawberries. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 478724,
      "primary_message": "Peel, trim, and quarter kiwis lengthwise, then slice crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 478725,
      "primary_message": "Roughly chop pistachios. Add to the bowl, along with the spinach, and toss to combine the salad.",
      "secondary_message": "1 cup pistachios, unsalted"
    },
    {
      "id": 478726,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 478727,
      "primary_message": "To serve, divide salad between plates or bowls. Top with sliced pork and enjoy!",
      "secondary_message": null
    }
  ],
