  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "10 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Position rack in center of oven and preheat to 180°C (350°F). Line 2 large rimmed baking sheets with parchment paper. Whisk flour, baking soda, cinnamon, and salt in medium bowl to blend. Using electric mixer, beat butter and both sugars in large bowl until smooth. Beat in egg and vanilla. Add flour mixture and oats and stir until blended. Stir in all chocolate chips and cranberries.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Drop batter by rounded tablespoonfuls onto prepared sheets, 5 cm apart. Bake cookies, 1 sheet at a time, until edges are light brown, about 16 minutes. Cool on sheets 5 minutes. Transfer to rack; cool completely.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir chopped milk chocolate in top of double boiler until melted and smooth. Using small spoon, drizzle melted chocolate over cookies in zigzag pattern. Let stand until milk chocolate sets, about 1 hour. (Can be made 2 days ahead. Store in airtight container at room temperature.)",
      "secondary_message": null
    }
  ],
