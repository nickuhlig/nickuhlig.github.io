  "instructions": [
    {
      "id": 271107,
      "primary_message": "In a small saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ cup whole wheat couscous\n⅛ tsp salt"
    },
    {
      "id": 271108,
      "primary_message": "Meanwhile, place oil, Dijon, mayo, vinegar, water, sugar, salt, and pepper in a small bowl; whisk to combine the Dijon sauce and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n1 ½ tsp mayonnaise\n1 ½ tsp red wine vinegar\n1 tsp water\n¼ tsp brown sugar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 271109,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 bunch kale\n½ small pkg chives\n½ lemon"
    },
    {
      "id": 271110,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 271111,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271112,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 271113,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 271114,
      "primary_message": "While the steak is cooking, chop chives into small pieces; add half to the bowl with the kale (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 271115,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 271116,
      "primary_message": "When the steak is done, return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271117,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add kale, chives, garlic, salt, and crushed red pepper; cook, stirring often, until kale is tender, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 271118,
      "primary_message": "Juice lemon into the skillet with the kale and stir to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 271119,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 271120,
      "primary_message": "To serve, divide couscous, steak, and kale between plates. Drizzle Dijon sauce over the steak and garnish with reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
