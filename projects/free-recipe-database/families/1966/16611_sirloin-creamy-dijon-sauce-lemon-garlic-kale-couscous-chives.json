  "instructions": [
    {
      "id": 271247,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup whole wheat couscous\n¼ tsp salt"
    },
    {
      "id": 271248,
      "primary_message": "Meanwhile, place oil, Dijon, mayo, vinegar, water, sugar, salt, and pepper in a small bowl; whisk to combine the Dijon sauce and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp mayonnaise\n1 tbsp red wine vinegar\n2 tsp water\n½ tsp brown sugar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 271249,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 bunches kale\n1 small pkg chives\n1 lemon"
    },
    {
      "id": 271250,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 271251,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271252,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 271253,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 271254,
      "primary_message": "While the steak is cooking, chop chives into small pieces; add half to the bowl with the kale (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 271255,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 271256,
      "primary_message": "When the steak is done, return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271257,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add kale, chives, and garlic to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Season with salt and crushed red pepper; cook, stirring often, until kale is tender, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 271258,
      "primary_message": "Juice lemon into the skillet with the kale and stir to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 271259,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 271260,
      "primary_message": "To serve, divide couscous, steak, and kale between plates. Drizzle Dijon sauce over the steak and garnish with reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
