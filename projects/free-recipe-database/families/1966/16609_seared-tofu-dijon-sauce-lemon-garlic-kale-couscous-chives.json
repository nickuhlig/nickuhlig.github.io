  "instructions": [
    {
      "id": 271218,
      "primary_message": "Drain and cut tofu into ½-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Set aside.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 271219,
      "primary_message": "Place soy sauce, oil, maple syrup, salt, and pepper in a large bowl; stir to combine the marinade.",
      "secondary_message": "¼ cup soy sauce\n3 tbsp extra virgin olive oil\n3 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 271220,
      "primary_message": "Place tofu slices in the bowl with the marinade, gently turning to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 271221,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous\n½ tsp salt"
    },
    {
      "id": 271222,
      "primary_message": "Meanwhile, place oil, Dijon, mayo, vinegar, water, maple syrup, salt, and pepper in a small bowl; whisk to combine the Dijon sauce and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp Dijon mustard\n1 ½ tbsp vegan mayonnaise\n1 ½ tbsp red wine vinegar\n1 tbsp water\n1 ½ tsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 271223,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 bunches kale\n1 small pkg chives\n1 ½ lemons"
    },
    {
      "id": 271224,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271225,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu in a single layer, pouring leftover marinade over top. Cook, flipping once, until golden brown, about 6 minutes. Transfer to a plate and cover with aluminum foil. (Reserve bowl for next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 271226,
      "primary_message": "While the tofu is cooking, fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 271227,
      "primary_message": "Chop chives into small pieces; add half to the bowl with the kale (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 271228,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 271229,
      "primary_message": "When the tofu is done, return pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271230,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add kale, chives, and garlic to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Season with salt and crushed red pepper; cook, stirring often, until kale is tender, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 271231,
      "primary_message": "Juice lemons into the pot with the kale and stir to combine; remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 271232,
      "primary_message": "To serve, divide couscous, tofu, and kale between plates. Drizzle Dijon sauce over the tofu and garnish with reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
