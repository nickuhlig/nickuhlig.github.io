  "instructions": [
    {
      "id": 271314,
      "primary_message": "Drain and cut tofu into ½-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Set aside.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 271315,
      "primary_message": "Place soy sauce, oil, maple syrup, salt, and pepper in a medium bowl; stir to combine the marinade.",
      "secondary_message": "1 ½ tbsp soy sauce\n1 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 271316,
      "primary_message": "Place tofu slices in the bowl with the marinade, gently turning to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 271317,
      "primary_message": "In a small saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous\n⅛ tsp salt"
    },
    {
      "id": 271318,
      "primary_message": "Meanwhile, place oil, Dijon, mayo, vinegar, water, maple syrup, salt, and pepper in a small bowl; whisk to combine the Dijon sauce and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n1 ½ tsp vegan mayonnaise\n1 ½ tsp red wine vinegar\n1 tsp water\n½ tsp pure maple syrup\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 271319,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 bunch kale\n½ small pkg chives\n½ lemon"
    },
    {
      "id": 271320,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271321,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add tofu in a single layer, pouring any leftover marinade over the top. Cook, flipping once, until golden brown, about 6 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 271322,
      "primary_message": "While the tofu is cooking, fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 271323,
      "primary_message": "Chop chives into small pieces; add half to the bowl with the kale (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 271324,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 271325,
      "primary_message": "When the tofu is done, return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271326,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add kale, chives, garlic, salt, and crushed red pepper; cook, stirring often, until kale is tender, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 271327,
      "primary_message": "Juice lemon into the skillet with the kale and stir to combine ; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 271328,
      "primary_message": "To serve, divide couscous, tofu, and kale between plates. Drizzle Dijon sauce over the tofu and garnish with reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
