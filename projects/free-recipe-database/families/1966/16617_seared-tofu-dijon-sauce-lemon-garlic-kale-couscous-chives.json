  "instructions": [
    {
      "id": 271329,
      "primary_message": "Drain and cut tofu into ½-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Set aside.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 271330,
      "primary_message": "Place soy sauce, oil, maple syrup, salt, and pepper in a large bowl; stir to combine the marinade.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 271331,
      "primary_message": "Place tofu slices in the bowl with the marinade, gently turning to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 271332,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup whole wheat couscous\n¼ tsp salt"
    },
    {
      "id": 271333,
      "primary_message": "Meanwhile, place oil, Dijon, mayo, vinegar, water, maple syrup, salt, and pepper in a small bowl; whisk to combine the Dijon sauce and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp vegan mayonnaise\n1 tbsp red wine vinegar\n2 tsp water\n1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 271334,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 bunches kale\n1 small pkg chives\n1 lemon"
    },
    {
      "id": 271335,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271336,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu in a single layer, pouring leftover marinade over top. Cook, flipping once, until golden brown, about 6 minutes. Transfer to a plate and cover with aluminum foil. (Reserve bowl for next step.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 271337,
      "primary_message": "While the tofu is cooking, fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 271338,
      "primary_message": "Chop chives into small pieces; add half to the bowl with the kale (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 271339,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 271340,
      "primary_message": "When the tofu is done, return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271341,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add kale, chives, and garlic to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Season with salt and crushed red pepper; cook, stirring often, until kale is tender, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 271342,
      "primary_message": "Juice lemon into the skillet with the kale and stir to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 271343,
      "primary_message": "To serve, divide couscous, tofu, and kale between plates. Drizzle Dijon sauce over the tofu and garnish with reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
