  "instructions": [
    {
      "id": 271135,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous\n½ tsp salt"
    },
    {
      "id": 271136,
      "primary_message": "Meanwhile, place oil, Dijon, mayo, vinegar, water, sugar, salt, and pepper in a small bowl; whisk to combine the Dijon sauce and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp Dijon mustard\n1 ½ tbsp mayonnaise\n1 ½ tbsp red wine vinegar\n1 tbsp water\n¾ tsp brown sugar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 271137,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 bunches kale\n1 small pkg chives\n1 ½ lemons"
    },
    {
      "id": 271138,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 271139,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271140,
      "primary_message": "While the pot heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 271141,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 271142,
      "primary_message": "While the steak is cooking, chop chives into small pieces; add half to the bowl with the kale (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 271143,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 271144,
      "primary_message": "When the steak is done, return pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271145,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add kale, chives, and garlic to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Season with salt and crushed red pepper; cook, stirring often, until kale is tender, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 271146,
      "primary_message": "Juice lemons into the pot with the kale and stir to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 271147,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 271148,
      "primary_message": "To serve, divide couscous, steak, and kale between plates. Drizzle Dijon sauce over the steak and garnish with reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
