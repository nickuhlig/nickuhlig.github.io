  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and thinly slice the carrots. Mince the garlic. Peel and finely chop the ginger. Cut the green cabbage into 3/4-inch pieces. Rinse and drain the chickpeas. Cut the cauliflower into 1-inch florets. Shake the unsweetened full-fat coconut milk well before use.",
      "secondary_message": "2 medium carrots\n4 medium cloves garlic\n1 (1 ½ inch) piece ginger root\n½ head green cabbage\n1 (15 oz) can chickpeas\n½ medium head cauliflower\n1 (13 ½ oz) can unsweetened full-fat coconut milk"
    },
    {
      "id": 1,
      "primary_message": "In a large Dutch oven, heat oil over medium-high until shimmering. Add onion and carrots. Cook, stirring occasionally, until softened, 3 to 5 minutes. Stir in garlic, ginger, cumin, pepper, turmeric, and smoked paprika, and cook until fragrant, about 1 minute. Add cabbage and cook, stirring often, until cabbage turns bright green, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in broth, chickpeas, diced tomatoes, cauliflower, and salt. Bring mixture to a boil over high heat. Reduce heat to a simmer and cook, stirring occasionally, until cabbage and cauliflower are tender, 25 to 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in coconut milk and return to a simmer. Cook, stirring occasionally, until warmed through, about 2 minutes. Divide soup among serving bowls and top with cilantro. Serve with lime wedges.",
      "secondary_message": null
    }
  ],
