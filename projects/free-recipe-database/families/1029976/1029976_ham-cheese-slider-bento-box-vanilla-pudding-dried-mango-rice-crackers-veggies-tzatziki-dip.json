  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Place veggies in the medium compartment of the bento box. ",
      "secondary_message": "½ cup vegetable medley (baby carrots, broccoli and cauliflower florets)"
    },
    {
      "primary_message": "Place mango and rice cakes in the small compartments of the bento box. ",
      "secondary_message": "⅓ cup dried mango\n⅓ cup mini rice cake"
    },
    {
      "primary_message": "Place tzatziki in a small container with a lid. Place tzatziki and pudding cup in the large compartment of the bento box. ",
      "secondary_message": "¼ cup tzatziki sauce\n1 (3.6 oz) cup vanilla pudding snack"
    },
    {
      "primary_message": "Cut cheese into 4 quarters. Fold ham slices into quarters. ",
      "secondary_message": "1 slice cheddar cheese, sliced\n1 ½ oz deli ham, sliced"
    },
    {
      "primary_message": "Place rolls on a flat surface, then slice crosswise to separate into halves. Spread each half with mayo. Layer cheese and ham over the bottom halves of the rolls, then close with the top halves of the rolls. Add sliders to the large compartment of the bento box. ",
      "secondary_message": "2 Hawaiian sweet rolls\n1 tbsp mayonnaise"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
