  "instructions": [
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n¼ tsp salt"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 orange\n½ bunch kale\n½ pint grape tomatoes"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Juice orange into the bowl with the ginger and garlic. Add oil, vinegar, soy sauce, and honey, then whisk to combine the marinade. Transfer ⅓ to another medium bowl and set aside for the salad.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 tbsp rice vinegar\n1 tbsp honey"
    },
    {
      "primary_message": "Crumble tofu with your fingers into the remaining bowl with the marinade. Stir to coat and set aside.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the medium bowl reserved for the salad and stir to combine the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve grape tomatoes. Add to the bowl, toss to combine, and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add tofu and marinade. Cook, stirring occasionally, until tofu is golden, 5-7 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide rice, salad, and tofu between bowls. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
