  "instructions": [
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n¾ tsp salt"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 oranges\n1 ½ bunches kale\n1 ½ pints grape tomatoes"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "primary_message": "Juice oranges into the bowl with the ginger and garlic. Add oil, vinegar, soy sauce, and honey, then whisk to combine the marinade. Transfer ⅓ to another large bowl and set aside for the salad.",
      "secondary_message": "⅓ cup toasted sesame oil\n3 tbsp rice vinegar\n3 tbsp honey"
    },
    {
      "primary_message": "Crumble tofu with your fingers into the remaining bowl with the marinade. Stir to coat and set aside.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the large bowl reserved for the salad and stir to combine the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve grape tomatoes. Add to the bowl, toss to combine, and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add tofu and marinade. Cook, stirring occasionally, until tofu is golden, 6-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide rice, salad, and tofu between bowls. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
