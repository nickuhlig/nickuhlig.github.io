  "instructions": [
    {
      "id": 489891,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 489892,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 green bell peppers\n1 English cucumber"
    },
    {
      "id": 489893,
      "primary_message": "Juice lemon into a small bowl. Add yogurt and spices; whisk to combine the yogurt sauce and set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n½ tsp garlic powder\n½ tsp oregano, dried\n½ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 489894,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 489895,
      "primary_message": "Pat steak dry with paper towels and slice crosswise into thin strips. Add to the bowl with the bell peppers along with oil and spices; toss to combine.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n2 tsp extra virgin olive oil\n1 tsp oregano, dried\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 489896,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 489897,
      "primary_message": "Once the skillet is hot, add peppers and steak. Cook, stirring occasionally, until peppers are soft and steak is cooked through, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 489898,
      "primary_message": "Meanwhile, using a clean cutting board, peel, halve, and slice onion crosswise into thin half-moons.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 489899,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 489900,
      "primary_message": "Arrange pitas on a large baking sheet pan. Place in the oven and bake, flipping halfway through, until warmed through, 4-5 minutes. Remove from oven.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 489901,
      "primary_message": "To assemble, divide steak, peppers, onion, and cucumber between pitas. To make wraps easier to eat, place each pita on a square of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise, eat as is and get a little messy! Drizzle with yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
