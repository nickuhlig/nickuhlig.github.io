  "instructions": [
    {
      "id": 60140,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": ""
    },
    {
      "id": 60139,
      "primary_message": "Wash parsnips, tomatoes, and green onions. Peel the parsnips, halve crosswise, then halve or quarter lengthwise to form equal-size pieces. Trim root ends and cut green onions into 2 inch pieces. Transfer everything to a sheet pan.",
      "secondary_message": "12 medium parsnips\n1 ½ pint grape tomatoes\n1 ½ small bunches green onions"
    },
    {
      "id": 60138,
      "primary_message": "Drizzle with oil and season with thyme, salt, and pepper; toss to coat.",
      "secondary_message": "6 tbsp extra virgin olive oil\n¾ tsp thyme\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60137,
      "primary_message": "Place in the oven and roast, tossing once halfway through, until parsnips are tender, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 60136,
      "primary_message": "Heat a skillet over medium-heat.",
      "secondary_message": ""
    },
    {
      "id": 60135,
      "primary_message": "Season chicken with salt and pepper.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60134,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until browned and cooked through, 3-4 minutes per side.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 60133,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 60132,
      "primary_message": "Transfer chicken to a plate; return skillet to stove and reduce heat to low. Add garlic and vinegar. Scrape up any browned bits from bottom of skillet. Return chicken to skillet and coat with sauce.",
      "secondary_message": "6 tbsp balsamic vinegar"
    },
    {
      "id": 60131,
      "primary_message": "To serve, place chicken with roasted parsnips, tomatoes, and onions on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
