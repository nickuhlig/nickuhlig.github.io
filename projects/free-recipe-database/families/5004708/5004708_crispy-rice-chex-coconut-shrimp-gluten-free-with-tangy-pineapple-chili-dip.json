  "instructions": [
    {
      "id": 1,
      "primary_message": "Stir preserves, vinegar, cilantro, chili flakes, and 1 tablespoon water in a bowl until combined; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pat shrimp dry with paper towels. Stir cornstarch and baking soda in a small bowl. Place eggs in a deep sided bowl or large mug. Place Rice Chex® cereal, coconut, and 2 3⁄4 teaspoons salt (see note) in a large shallow dish.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour oil in Dutch oven to 2 inches deep. Heat over medium heat to 350°F (see note). Working one shrimp at a time, dredge in cornstarch mixture, dip in egg, then coat in Rice Chex® cereal and coconut, pressing well to adhere coating to shrimp.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Coat a batch of 6 or so shrimp (depending on size) and then carefully drop into oil. Cook until golden, 2 to 3 minutes. Transfer to paper towel lined plate and repeat with remaining batches of shrimp, adjusting heat as necessary to keep temperature of oil consistent. Serve immediately with dipping sauce.\n©2013 and ®/TM of General Mills",
      "secondary_message": null
    }
  ],
