  "instructions": [
    {
      "id": 242256,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g linguine pasta"
    },
    {
      "id": 242257,
      "primary_message": "Meanwhile, cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 242258,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small pkgs grape tomatoes\n4 medium zucchini squash\n1 small pkg fresh basil\n1 lemon"
    },
    {
      "id": 242259,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242260,
      "primary_message": "While the skillet heats up, cut the tofu into ¾-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 242261,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu to the skillet and sprinkle with spices; cook, turning often, until golden on all sides, about 6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp onion powder\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 242262,
      "primary_message": "Meanwhile, halve tomatoes and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 242263,
      "primary_message": "Trim and halve zucchini lengthwise; cut crosswise into ¼-inch thick half-moons. Add to the bowl with the tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 242264,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 242265,
      "primary_message": "When the tofu is done, remove to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": null
    },
    {
      "id": 242266,
      "primary_message": "Return the skillet to medium-high heat and add more oil, swirling to coat the bottom. Add garlic and crushed red pepper; cook, stirring constantly, until fragrant, about 15 seconds.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp crushed red pepper"
    },
    {
      "id": 242267,
      "primary_message": "Add tomatoes, zucchini, broth, Italian seasoning, and salt to the skillet. Stir to combine and bring to a boil; reduce heat and simmer until zucchini is soft and sauce has thickened, 6-7 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n1 tsp Italian seasoning\n1 tsp salt"
    },
    {
      "id": 242268,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Cut lemon into wedges; set both aside.",
      "secondary_message": null
    },
    {
      "id": 242269,
      "primary_message": "When the pasta is done, drain in a colander and return to the pot. Add zucchini-tomato sauce and tofu to the pot; gently toss to combine.",
      "secondary_message": null
    },
    {
      "id": 242270,
      "primary_message": "To serve, divide pasta between plates; top with basil and a squeeze of lemon. Enjoy!",
      "secondary_message": null
    }
  ],
