  "instructions": [
    {
      "id": 242085,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz linguine pasta"
    },
    {
      "id": 242086,
      "primary_message": "Meanwhile, cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 242087,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 pints grape tomatoes\n6 medium zucchini squash\n1 small pkg fresh basil\n1 lemon"
    },
    {
      "id": 242088,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242089,
      "primary_message": "While the pot heats up, cut the tofu into ¾-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 242090,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu to the pot and sprinkle with spices; cook, turning often, until golden on all sides, about 6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n¾ tsp onion powder\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 242091,
      "primary_message": "Meanwhile, halve tomatoes and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 242092,
      "primary_message": "Trim and halve zucchini lengthwise; cut crosswise into ¼-inch thick half-moons. Add to the bowl with the tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 242093,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 242094,
      "primary_message": "When the tofu is done, remove to a platter, loosely cover with aluminum foil, and set aside.",
      "secondary_message": null
    },
    {
      "id": 242095,
      "primary_message": "Return the pot to medium-high heat and add more oil, swirling to coat the bottom. Add garlic and crushed red pepper; cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp crushed red pepper"
    },
    {
      "id": 242096,
      "primary_message": "Add tomatoes, zucchini, broth, Italian seasoning, and salt to the pot. Stir to combine and bring to a boil; reduce heat and simmer until zucchini is soft and sauce has thickened, 8-10 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n1 ½ tsp Italian seasoning\n1 ½ tsp salt"
    },
    {
      "id": 242097,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Cut lemon into wedges; set both aside.",
      "secondary_message": null
    },
    {
      "id": 242098,
      "primary_message": "When the pasta is done, drain in a colander and return to the pot. Add zucchini-tomato sauce and tofu to the pot; gently toss to combine.",
      "secondary_message": null
    },
    {
      "id": 242099,
      "primary_message": "To serve, divide pasta between plates; top with basil and a squeeze of lemon. Enjoy!",
      "secondary_message": null
    }
  ],
