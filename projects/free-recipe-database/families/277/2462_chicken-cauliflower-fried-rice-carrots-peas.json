  "instructions": [
    {
      "id": 23816,
      "primary_message": "Wash cauliflower and cut off the leaves. Rice (grate) using a hand grater or in a food processor.",
      "secondary_message": "2 medium heads cauliflower\r\n"
    },
    {
      "id": 23817,
      "primary_message": "Wash carrots and green onions.",
      "secondary_message": "2 medium carrots\r\n1 small bunch green onions (scallions)"
    },
    {
      "id": 23818,
      "primary_message": "Trim ends, peel, and small dice carrots; transfer to a medium bowl. Trim ends and slice green onions on the diagonal into ¼ inch pieces; transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 23819,
      "primary_message": "Measure out peas and add to bowl with carrots.",
      "secondary_message": "1 cup frozen peas\r\n"
    },
    {
      "id": 23820,
      "primary_message": "Peel and mince garlic. Peel and mince ginger. Transfer both to a small bowl.",
      "secondary_message": "4 cloves garlic\r\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 23821,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 23822,
      "primary_message": "Cube chicken into bite-sized pieces. Season with salt and freshly ground pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 23823,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and stir-fry until browned, 3-4 minutes. Transfer to a plate.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 23824,
      "primary_message": "Add more oil to skillet followed by garlic and ginger. Stir fry until fragrant, 15-30 seconds.",
      "secondary_message": "2 tbsp toasted sesame oil\r\n"
    },
    {
      "id": 23825,
      "primary_message": "Add carrots and peas; stir-fry until tender-crisp, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23826,
      "primary_message": "Add cauliflower rice, mix well, and stir-fry until tender, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23827,
      "primary_message": "In a small bowl, whisk eggs.",
      "secondary_message": "2 eggs\r\n"
    },
    {
      "id": 23828,
      "primary_message": "Move all the ingredients to one side of the skillet and pour eggs on the other side. Scramble eggs and mix with everything else.",
      "secondary_message": ""
    },
    {
      "id": 23829,
      "primary_message": "Return chicken to skillet and add coconut aminos and green onions; stir to combine.",
      "secondary_message": "4 tbsp coconut aminos\r\n"
    },
    {
      "id": 23830,
      "primary_message": "Serve in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
