  "instructions": [
    {
      "id": 23666,
      "primary_message": "Wash cauliflower and cut off the leaves. Rice (grate) using a hand grater or in a food processor.",
      "secondary_message": "1 medium head cauliflower\r\n"
    },
    {
      "id": 23667,
      "primary_message": "Wash carrot and green onions.",
      "secondary_message": "1 medium carrot\r\n½ small bunch green onions (scallions)"
    },
    {
      "id": 23668,
      "primary_message": "Trim ends, peel, and small dice carrot; transfer to a medium bowl. Trim ends and slice green onions on the diagonal into ¼ inch pieces; transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 23669,
      "primary_message": "Measure out peas and add to bowl with carrot.",
      "secondary_message": "½ cup frozen peas\r\n"
    },
    {
      "id": 23670,
      "primary_message": "Peel and mince garlic. Peel and mince ginger. Transfer both to a small bowl.",
      "secondary_message": "2 cloves garlic\r\n1 (1 inch) piece ginger root"
    },
    {
      "id": 23671,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 23672,
      "primary_message": "Cube chicken into bite-sized pieces. Season with salt and freshly ground pepper.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 23673,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and stir-fry until browned, 3-4 minutes. Transfer to a plate.",
      "secondary_message": "½ tbsp toasted sesame oil"
    },
    {
      "id": 23674,
      "primary_message": "Add more oil to skillet followed by garlic and ginger. Stir fry until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp toasted sesame oil\r\n"
    },
    {
      "id": 23675,
      "primary_message": "Add carrot and peas; stir-fry until tender-crisp, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23676,
      "primary_message": "Add cauliflower rice, mix well, and stir-fry until tender, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23677,
      "primary_message": "In a small bowl, whisk egg.",
      "secondary_message": "1 egg\r\n"
    },
    {
      "id": 23678,
      "primary_message": "Move all the ingredients to one side of the skillet and pour egg on the other side. Scramble egg and mix with everything else.",
      "secondary_message": ""
    },
    {
      "id": 23679,
      "primary_message": "Return chicken to skillet and add soy sauce and green onions; stir to combine.",
      "secondary_message": "2 tbsp soy sauce\r\n"
    },
    {
      "id": 23680,
      "primary_message": "Serve in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
