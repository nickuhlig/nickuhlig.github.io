  "instructions": [
    {
      "id": 227372,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 jalapeño pepper\n¼ lb red grapes\n½ small bunch cilantro\n1 avocado"
    },
    {
      "id": 227373,
      "primary_message": "Juice lime into a medium bowl. Add honey and spices; whisk to combine the dressing.",
      "secondary_message": "½ tsp honey\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 227374,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 227375,
      "primary_message": "Peel and mince garlic and shallot. Add both to the bowl.",
      "secondary_message": "1 clove garlic\n1 shallot"
    },
    {
      "id": 227376,
      "primary_message": "Thinly slice grapes and add to the bowl. Stir to combine, then set aside.",
      "secondary_message": null
    },
    {
      "id": 227377,
      "primary_message": "Meanwhile, place oil and spices in another medium bowl; stir to combine the spice paste.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp cumin, ground\n¼ tsp coriander, ground\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 227378,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 227379,
      "primary_message": "While the grill pan heats up, place tilapia in the bowl with the spice paste and turn to coat.",
      "secondary_message": "¾ lb tilapia fillet"
    },
    {
      "id": 227380,
      "primary_message": "Once the grill pan is hot, coat with oil. Add the tilapia and grill until the flesh is opaque and flakey, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 227381,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the grapes.",
      "secondary_message": null
    },
    {
      "id": 227382,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl and stir to combine the salsa.",
      "secondary_message": null
    },
    {
      "id": 227383,
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 227384,
      "primary_message": "Use a fork to break the tilapia into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 227385,
      "primary_message": "To serve, divide tortillas between plates; fill with grilled tilapia and salsa. Enjoy!",
      "secondary_message": null
    }
  ],
