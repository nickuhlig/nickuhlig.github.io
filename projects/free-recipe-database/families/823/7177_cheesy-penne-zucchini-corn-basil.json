  "instructions": [
    {
      "id": 114970,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once the pasta is finished, drain and return to pot and set aside.",
      "secondary_message": "340 g penne pasta\n1 tsp salt"
    },
    {
      "id": 114971,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 114972,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 114973,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 114974,
      "primary_message": "Add onion and garlic to the skillet, stirring frequently, cook until slightly softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 114975,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 small pkgs fresh basil"
    },
    {
      "id": 114976,
      "primary_message": "Add the frozen corn to the skillet, stirring frequently, cook until slightly softened, 3-4 minutes.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 114977,
      "primary_message": "Trim zucchinis; halve lengthwise and cut crosswise into thin half moons.",
      "secondary_message": null
    },
    {
      "id": 114978,
      "primary_message": "Add the zucchinis and spices to the skillet. Increase heat to medium-high and sauté, stirring frequently, until the vegetables are soft and golden, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper\n1 tsp oregano\n¼ tsp crushed red pepper"
    },
    {
      "id": 114979,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; set aside.",
      "secondary_message": null
    },
    {
      "id": 114980,
      "primary_message": "Reduce the heat to low and stir the tomato sauce into the skillet, simmer for 3-4 minutes.",
      "secondary_message": "2 (213 ml) cans tomato sauce"
    },
    {
      "id": 114981,
      "primary_message": "Grate the Parmesan and mozzarella.",
      "secondary_message": "57 g Parmesan cheese\n⅔ (227 g) block mozzarella cheese"
    },
    {
      "id": 114982,
      "primary_message": "Add the sauce and veggies to the pot with the cooked pasta, along with the Parmesan, mozzarella, and fresh basil (reserving a small amount for garnish); stir to combine.",
      "secondary_message": null
    },
    {
      "id": 114983,
      "primary_message": "To serve, divide between plates and garnish with reserved basil; enjoy!",
      "secondary_message": null
    }
  ],
