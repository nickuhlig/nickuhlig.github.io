  "instructions": [
    {
      "id": 325773,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 325774,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 Gala apple\n1 lime\n1 (227 g) pkg sugar snap peas\n1 bunch radish\n½ small bunch cilantro"
    },
    {
      "id": 325775,
      "primary_message": "Peel, quarter, and core apple; roughly chop and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 325776,
      "primary_message": "Add ketchup, water, soy sauce, vinegar, sugar, Worcestershire, and spices to the blender with the apple. Blend on high until BBQ sauce is smooth, adding water 1 tablespoon at a time, if needed, to reach a saucy consistency; set aside.",
      "secondary_message": "¼ cup ketchup\n2 tbsp water\n2 tbsp soy sauce\n1 tsp apple cider vinegar\n1 tsp brown sugar\n½ tsp Worcestershire sauce\n½ tsp garlic powder\n½ tsp chili powder\n⅛ tsp black pepper"
    },
    {
      "id": 325777,
      "primary_message": "Pat chicken dry with paper towels and slice lengthwise into 1-inch thick strips; thread onto skewers and transfer to a plate. (If you don't have skewers, you can cook the chicken directly on the grill pan.)",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 325778,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325779,
      "primary_message": "While the grill pan heats up, coat skewers with half of the sauce. (Reserve remaining sauce for the next step.)",
      "secondary_message": null
    },
    {
      "id": 325780,
      "primary_message": "Once the grill pan is hot, coat with oil; add the skewers and grill, turning occasionally, until the chicken is cooked through, 8-10 minutes. Remove to a clean plate and coat with remaining sauce.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 325781,
      "primary_message": "Meanwhile, juice lime into a medium bowl, then add oil, mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp mayonnaise\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 325782,
      "primary_message": "Using a clean cutting board, peel, halve, and slice shallot into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 325783,
      "primary_message": "Halve snap peas; trim and thinly slice radishes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 325784,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 325785,
      "primary_message": "To serve, divide BBQ chicken skewers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
