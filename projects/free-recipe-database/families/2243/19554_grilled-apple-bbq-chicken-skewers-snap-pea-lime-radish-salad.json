  "instructions": [
    {
      "id": 325624,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 325625,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 Gala apples\n2 limes\n2 (8 oz) pkg sugar snap peas\n2 bunches radish\n1 small bunch cilantro"
    },
    {
      "id": 325626,
      "primary_message": "Peel, quarter, and core apples; roughly chop and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 325627,
      "primary_message": "Add ketchup, water, soy sauce, vinegar, sugar, Worcestershire, and spices to the blender with the apple. Blend on high until BBQ sauce is smooth, adding water 1 tablespoon at a time, if needed, to reach a saucy consistency; set aside.",
      "secondary_message": "½ cup ketchup\n¼ cup water\n¼ cup soy sauce\n2 tsp apple cider vinegar\n2 tsp brown sugar\n1 tsp Worcestershire sauce\n1 tsp garlic powder\n1 tsp chili powder\n¼ tsp black pepper"
    },
    {
      "id": 325628,
      "primary_message": "Pat chicken dry with paper towels and slice lengthwise into 1-inch thick strips; thread onto skewers and transfer to a plate. (If you don't have skewers, you can cook the chicken directly on the grill pan.)",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 325629,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325630,
      "primary_message": "While the grill pan heats up, coat skewers with half of the sauce. (Reserve remaining sauce for the next step.)",
      "secondary_message": null
    },
    {
      "id": 325631,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add the skewers and grill, turning occasionally, until the chicken is cooked through, 8-10 minutes. Remove to a clean plate and coat with remaining sauce.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 325632,
      "primary_message": "Meanwhile, juice limes into a medium bowl, then add oil, mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp mayonnaise\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 325633,
      "primary_message": "Using a clean cutting board, peel, halve, and slice shallot into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 325634,
      "primary_message": "Halve snap peas; trim and thinly slice radishes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 325635,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 325636,
      "primary_message": "To serve, divide BBQ chicken skewers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
