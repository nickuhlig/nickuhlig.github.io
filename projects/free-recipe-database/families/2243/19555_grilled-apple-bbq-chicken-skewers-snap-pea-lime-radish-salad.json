  "instructions": [
    {
      "id": 325637,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 325638,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 Gala apples\n3 limes\n3 (8 oz) pkg sugar snap peas\n3 bunches radish\n1 small bunch cilantro"
    },
    {
      "id": 325639,
      "primary_message": "Peel, quarter, and core apples; roughly chop and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 325640,
      "primary_message": "Add ketchup, water, soy sauce, vinegar, sugar, Worcestershire, and spices to the blender with the apple. Blend on high until BBQ sauce is smooth, adding water a few tablespoons at a time, if needed, to reach a saucy consistency; set aside.",
      "secondary_message": "¾ cup ketchup\n⅓ cup water\n⅓ cup soy sauce\n1 tbsp apple cider vinegar\n1 tbsp brown sugar\n1 ½ tsp Worcestershire sauce\n1 ½ tsp garlic powder\n1 ½ tsp chili powder\n½ tsp black pepper"
    },
    {
      "id": 325641,
      "primary_message": "Pat chicken dry with paper towels and slice lengthwise into 1-inch thick strips; thread onto skewers and transfer to a plate. (If you don't have skewers, you can cook the chicken directly on the grill pan.)",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 325642,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325643,
      "primary_message": "While the grill pan heats up, coat skewers with half of the sauce. (Reserve remaining sauce for the next step.)",
      "secondary_message": null
    },
    {
      "id": 325644,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add the skewers and grill, turning occasionally, until the chicken is cooked through, 8-10 minutes. Remove to a clean plate and coat with remaining sauce.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 325645,
      "primary_message": "Meanwhile, juice limes into a large bowl, then add oil, mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp mayonnaise\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 325646,
      "primary_message": "Using a clean cutting board, peel, halve, and slice shallots into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 325647,
      "primary_message": "Halve snap peas; trim and thinly slice radishes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 325648,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 325649,
      "primary_message": "To serve, divide BBQ chicken skewers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
