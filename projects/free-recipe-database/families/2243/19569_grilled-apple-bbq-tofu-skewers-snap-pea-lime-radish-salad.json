  "instructions": [
    {
      "id": 325826,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 325827,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 325828,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 Gala apples\n2 limes\n2 (227 g) pkg sugar snap peas\n2 bunches radish\n1 small bunch cilantro"
    },
    {
      "id": 325829,
      "primary_message": "Peel, quarter, and core apples; roughly chop and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 325830,
      "primary_message": "Add ketchup, water, soy sauce, vinegar, sugar, and spices to the blender with the apple. Blend on high until BBQ sauce is smooth, adding water 1 tablespoon at a time, if needed, to reach a saucy consistency; set aside.",
      "secondary_message": "½ cup ketchup\n¼ cup water\n¼ cup soy sauce\n2 tsp apple cider vinegar\n2 tsp brown sugar\n1 tsp garlic powder\n1 tsp chili powder\n½ tsp onion powder\n¼ tsp black pepper"
    },
    {
      "id": 325831,
      "primary_message": "Large dice tofu, thread onto skewers, and transfer to a plate. (If you don't have skewers, you can cook the tofu directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 325832,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325833,
      "primary_message": "While the grill pan heats up, coat skewers with half of the sauce. (Reserve remaining sauce for the next step.)",
      "secondary_message": null
    },
    {
      "id": 325834,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add the skewers and grill, turning occasionally, until the tofu is lightly charred and warmed through, 6-8 minutes. Return to the plate and coat with remaining sauce.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 325835,
      "primary_message": "Meanwhile, juice limes into a medium bowl, then add oil, mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp vegan mayonnaise\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 325836,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 325837,
      "primary_message": "Halve snap peas; trim and thinly slice radishes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 325838,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl, along with the pine nuts, and stir to combine the salad.",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 325839,
      "primary_message": "To serve, divide BBQ tofu skewers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
