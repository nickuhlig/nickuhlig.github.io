  "instructions": [
    {
      "id": 35161,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 35162,
      "primary_message": "While the water comes to a boil, wash the fresh produce.",
      "secondary_message": "0.227 kg green beans\n½ (454 g) pkg strawberries\n½ small pkg fresh rosemary"
    },
    {
      "id": 35163,
      "primary_message": "Trim and discard the ends of the green beans; transfer the beans to a medium bowl and set beside the stove.",
      "secondary_message": null
    },
    {
      "id": 35164,
      "primary_message": "Slide the rosemary leaves off the stems; discard the stems and roughly chop the leaves. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 35165,
      "primary_message": "Peel and mince the garlic; add to the rosemary.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 35166,
      "primary_message": "Add olive oil to the rosemary and garlic; mix together.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 35167,
      "primary_message": "Once the water in the saucepan is boiling, add the green beans. Cook until bright green and tender-crisp, 3 to 4 minutes. Once done, drain in a colander and rinse under cold water to stop the cooking process. Set aside to drain further.",
      "secondary_message": ""
    },
    {
      "id": 35168,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 35169,
      "primary_message": "Place the pork chops on a plate and season with salt and pepper, then rub with the rosemary and garlic mixture.",
      "secondary_message": "2 pork chops, boneless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 35170,
      "primary_message": "Place the pork chops in the hot skillet and pour in the remaining oil mixture; cook until cooked through, 3 to 5 minutes per side (depending on their thickness). Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 35171,
      "primary_message": "While the pork cooks, trim and discard the stem ends of the strawberries; slice the strawberries and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 35172,
      "primary_message": "Once the pork chops have been transferred, add the strawberries, balsamic vinegar, and honey to the skillet. Cook, scraping up any browned bit from the bottom of the skillet, until the strawberries have softened and the sauce is slightly thickened, 5 to 6 minutes.",
      "secondary_message": "¼ cup balsamic vinegar\n1 tbsp honey"
    },
    {
      "id": 35173,
      "primary_message": "Transfer the green beans to a bowl and season with salt and pepper; toss to mix.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 35174,
      "primary_message": "To serve, place the green beans and pork chops on a plate and spoon the balsamic-strawberry sauce over top. Enjoy!",
      "secondary_message": null
    }
  ],
