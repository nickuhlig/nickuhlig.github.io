  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the onion. Finely chop the red bell pepper. Halve, seed, and finely chop the jalapeno peppers. Mince the garlic. Grind the cumin seeds with spice grinder. Chop the cilantro leaves. Grate the cheddar cheese on box grater. Finely crush the tortilla chips. Pulse the tomatillos in processor until crushed.",
      "secondary_message": "1 large onion\n1 large red bell pepper\n2 jalapeno peppers\n2 medium cloves garlic\n1 tbsp cumin seeds\n½ cup cilantro leaves\n170 g cheddar cheese\n255 g tortilla chips\n7 tomatillos"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 190°C (375°F). Line 9- by 13-cm loaf pan with foil and spray with pan spray. Heat oil in large nonstick skillet over medium heat to shimmering. Add onions, pepper, jalapeños, and 1 teaspoon salt. Cook, stirring occasionally, until vegetables are softened, 6 to 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in garlic, cumin, cayenne, coriander, oregano, 1/2 teaspoon black pepper, and tomatoes. Cook until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to large bowl and cool briefly, about 10 minutes. Add chicken, eggs, cilantro, lime juice, broth, cheese, chips and 3/4 teaspoon salt. Toss gently until thoroughly combined. Gently pack into loaf pan.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bake 30 minutes. Stir crushed tomatillos with 1/4 teaspoon salt and spread over top of casserole. Continue to bake until the center of the casserole registers 70°C (160°F) on an instant read thermometer, about 30 minutes more. Let rest in pan 10 minutes. Lift out of pan, slice and serve.",
      "secondary_message": null
    }
  ],
