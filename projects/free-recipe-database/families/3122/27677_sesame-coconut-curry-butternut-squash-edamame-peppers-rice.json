  "instructions": [
    {
      "id": 444323,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 444324,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n2 red bell peppers\n2 red chili peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 444325,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 444326,
      "primary_message": "While the rice is cooking, trim and peel squash; halve lengthwise, scrape out the seeds, and large dice. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 444327,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the squash.",
      "secondary_message": null
    },
    {
      "id": 444328,
      "primary_message": "Quarter chili peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 444329,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 444330,
      "primary_message": "While the pot heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl with the other veggies. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 444331,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes. ",
      "secondary_message": "4 tsp toasted sesame oil\n2 tbsp curry powder\n1 ½ tsp garlic powder\n1 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 444332,
      "primary_message": "Add edamame, coconut milk, tahini, and sugar to the pot; stir to combine the curry and bring to a boil. Once boiling, reduce heat to medium and simmer, stirring occasionally, until curry has thickened and squash is tender, 8-10 minutes. Remove from heat. ",
      "secondary_message": "2 cups edamame\n1 (13.5 fl oz) can coconut milk\n2 tbsp tahini\n2 tsp brown sugar"
    },
    {
      "id": 444333,
      "primary_message": "To serve, divide rice and curry between plates or bowls; top with sesame seeds and reserved green onions. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
