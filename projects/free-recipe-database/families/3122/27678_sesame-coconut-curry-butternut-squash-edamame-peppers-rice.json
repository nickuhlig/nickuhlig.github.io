  "instructions": [
    {
      "id": 444334,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 444335,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n3 red bell peppers\n3 red chili peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 444336,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 444337,
      "primary_message": "While the rice is cooking, trim and peel each squash; halve lengthwise, scrape out the seeds, and large dice. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 444338,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the squash.",
      "secondary_message": null
    },
    {
      "id": 444339,
      "primary_message": "Quarter chili peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 444340,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 444341,
      "primary_message": "While the pot heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl with the other veggies. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 444342,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes. ",
      "secondary_message": "2 tbsp toasted sesame oil\n3 tbsp curry powder\n2 ½ tsp garlic powder\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 444343,
      "primary_message": "Add edamame, coconut milk, tahini, and sugar to the pot; stir to combine the curry and bring to a boil. Once boiling, reduce heat to medium and simmer, stirring occasionally, until curry has thickened and squash is tender, 8-10 minutes. Remove from heat. ",
      "secondary_message": "3 cups edamame\n1 ½ (13.5 fl oz) cans coconut milk\n3 tbsp tahini\n1 tbsp brown sugar"
    },
    {
      "id": 444344,
      "primary_message": "To serve, divide rice and curry between plates or bowls; top with sesame seeds and reserved green onions. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
