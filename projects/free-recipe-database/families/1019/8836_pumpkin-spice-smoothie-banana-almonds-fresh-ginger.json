  "instructions": [
    {
      "id": 326917,
      "primary_message": "This recipe will make about 12 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 326918,
      "primary_message": "Wash, dry, peel, and mince ginger; place in a blender.",
      "secondary_message": "3 (1 inch) pieces ginger root"
    },
    {
      "id": 326919,
      "primary_message": "Peel the bananas, break into chunks, and add to the blender. ",
      "secondary_message": "3 bananas"
    },
    {
      "id": 326920,
      "primary_message": "Add pumpkin purée, almond milk, almonds, maple syrup, spices, and 12 ice cubes to the blender. ",
      "secondary_message": "3 (15 oz) cans pure pumpkin purée\n36 fl oz (4 ½ cups) almond milk, unsweetened\n1 ½ cups almonds, sliced\n⅓ cup pure maple syrup\n1 tbsp cinnamon, ground\n1 ½ tsp nutmeg, ground\n¾ tsp cardamom, ground\n¾ tsp cloves, ground"
    },
    {
      "id": 326921,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 326922,
