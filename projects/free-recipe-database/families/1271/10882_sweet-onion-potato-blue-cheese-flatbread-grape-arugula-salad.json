  "instructions": [
    {
      "id": 182707,
      "primary_message": "Preheat oven to 220°C (425°F). Line a baking sheet pan with foil.",
      "secondary_message": null
    },
    {
      "id": 182708,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small pkg fresh rosemary\n0.23 kg new potatoes\n½ lemon\n0.11 kg red grapes\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 182709,
      "primary_message": "Slide rosemary leaves off sprigs; discard sprigs and mince the leaves. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 182710,
      "primary_message": "Cut potatoes into ⅛-inch thick slices; add to the bowl with the rosemary along with oil, salt, and pepper. Toss potatoes to coat, then arrange on the sheet pan in a single layer. Wipe the bowl clean with a paper towel and reserve for later use.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 182711,
      "primary_message": "Place potatoes in the oven and bake until fork-tender, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 182712,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 182713,
      "primary_message": "Peel and thinly slice onion into half rings.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 182714,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onions and salt; cook, stirring frequently, until onions are soft and golden brown, about 8 minutes. Remove from heat.",
      "secondary_message": "½ tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 182715,
      "primary_message": "Meanwhile, zest and juice lemon into the reserved bowl. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n½ tsp pure maple syrup\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 182716,
      "primary_message": "Carefully remove cooked potatoes from the sheet pan by lifting the corners of the foil and transferring the whole sheet to a flat surface. ",
      "secondary_message": null
    },
    {
      "id": 182717,
      "primary_message": "Arrange flatbreads on the sheet pan. Layer with potato slices, onions, and crumbled blue cheese. Place in the oven and cook until flatbreads become golden around the edges, and cheese is melted, about 5 minutes. Remove from oven.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese\n2 flatbreads or naan"
    },
    {
      "id": 182718,
      "primary_message": "Meanwhile, slice grapes in half and add to the bowl with the dressing. Add arugula and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 182719,
      "primary_message": "Slice flatbreads and divide between plates. Serve with arugula salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
