  "instructions": [
    {
      "id": 482721,
      "primary_message": "Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 482722,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 482723,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pineapples\n3 limes\n1 ½ medium heads napa cabbage\n1 small bunch cilantro"
    },
    {
      "id": 482724,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and slice lengthwise into thick planks. Place planks on a large plate, then drizzle with oil and season with salt on both sides.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 482725,
      "primary_message": "Preheat a grill pan, outdoor skillet, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 482726,
      "primary_message": "Once the pan is hot, working in batches, add the pineapple planks and grill, turning occasionally, until tender and charred in spots, about 8 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 482727,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and salt in a large bowl, then whisk to combine the marinade.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tbsp chili-garlic sauce\n¾ tsp salt"
    },
    {
      "id": 482728,
      "primary_message": "Large dice tofu. Add to the bowl with the marinade and stir to coat. ",
      "secondary_message": null
    },
    {
      "id": 482729,
      "primary_message": "Thread tofu onto skewers and place on a plate. Alternatively, you can cook the tofu pieces directly on the grill pan without using skewers. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 482730,
      "primary_message": "Return the pan to medium-high heat. Working in batches, add the tofu skewers and grill, turning occasionally, until the tofu is warmed through and charred in spots, about 8 minutes. Return to the plate. ",
      "secondary_message": null
    },
    {
      "id": 482731,
      "primary_message": "Meanwhile, peel and mince shallots. Place in the reserved bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 482732,
      "primary_message": "Juice limes into the bowl with the shallot, then add soy sauce, sugar, and chili-garlic sauce. Whisk to combine the dressing and set aside.",
      "secondary_message": "⅓ cup soy sauce\n2 tbsp brown sugar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 482733,
      "primary_message": "Small dice pineapple, return to the plate, and drizzle with half of the dressing. Stir to combine the salsa and set aside. (Reserve remaining dressing for the next step.)",
      "secondary_message": null
    },
    {
      "id": 482734,
      "primary_message": "Trim off and discard root end of the cabbages; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the reserved dressing.",
      "secondary_message": null
    },
    {
      "id": 482735,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Roughly chop cashews. Add both to the bowl and toss to combine the slaw.",
      "secondary_message": "1 cup cashews, roasted unsalted"
    },
    {
      "id": 482736,
      "primary_message": "Divide skewers and slaw between plates. Serve with pineapple salsa on the side and enjoy!",
      "secondary_message": null
    }
  ],
