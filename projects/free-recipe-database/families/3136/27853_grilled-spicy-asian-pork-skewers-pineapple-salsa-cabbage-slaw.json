  "instructions": [
    {
      "id": 482641,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 482642,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pineapple\n1 lime\n½ medium head napa cabbage\n½ small bunch cilantro"
    },
    {
      "id": 482643,
      "primary_message": "Cut off skin from pineapple; quarter, core, and slice lengthwise into thick planks. Place planks on a plate, then drizzle with oil and season with salt on both sides.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 482644,
      "primary_message": "Preheat a grill pan, outdoor skillet, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 482645,
      "primary_message": "Once the pan is hot, add the pineapple planks and grill, turning occasionally, until tender and charred in spots, about 8 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 482646,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and salt in a medium bowl, then whisk to combine the marinade.",
      "secondary_message": "2 tbsp mayonnaise\n1 ½ tsp chili-garlic sauce\n¼ tsp salt"
    },
    {
      "id": 482647,
      "primary_message": "Pat the pork dry with paper towels and cut into 1-inch cubes. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 482648,
      "primary_message": "Thread pork onto skewers and place on another plate. Alternatively, you can cook the pork pieces directly on the grill pan without using skewers. ",
      "secondary_message": null
    },
    {
      "id": 482649,
      "primary_message": "Return the pan to medium-high heat; add the pork skewers and grill, turning occasionally, until the pork is charred and cooked through, about 8 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 482650,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in a clean medium bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 482651,
      "primary_message": "Juice lime into the bowl with the shallot, then add fish sauce, soy sauce, sugar, and chili-garlic sauce. Whisk to combine the dressing and set aside. ",
      "secondary_message": "1 tbsp fish sauce\n1 tbsp soy sauce\n2 tsp brown sugar\n1 tsp chili-garlic sauce"
    },
    {
      "id": 482652,
      "primary_message": "Small dice pineapple, return to the plate, and drizzle with half of the dressing. Stir to combine the salsa and set aside. (Reserve remaining dressing for the next step.)",
      "secondary_message": null
    },
    {
      "id": 482653,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the reserved dressing.",
      "secondary_message": null
    },
    {
      "id": 482654,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 482655,
      "primary_message": "Roughly chop cashews. Add to the bowl and toss to combine the slaw.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 482656,
      "primary_message": "Divide skewers and slaw between plates. Serve with pineapple salsa on the side and enjoy!",
      "secondary_message": null
    }
  ],
