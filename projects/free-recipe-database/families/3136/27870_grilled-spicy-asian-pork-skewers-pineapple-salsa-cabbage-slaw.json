  "instructions": [
    {
      "id": 482913,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 482914,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pineapples\n3 limes\n1 ½ medium heads napa cabbage\n1 small bunch cilantro"
    },
    {
      "id": 482915,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and slice lengthwise into thick planks. Place planks on a large plate, then drizzle with oil and season with salt on both sides.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 482916,
      "primary_message": "Preheat a grill pan, outdoor skillet, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 482917,
      "primary_message": "Once the pan is hot, working in batches, add the pineapple planks and grill, turning occasionally, until tender and charred in spots, about 8 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 482918,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and salt in a large bowl, then whisk to combine the marinade.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tbsp chili-garlic sauce\n¾ tsp salt"
    },
    {
      "id": 482919,
      "primary_message": "Pat the pork dry with paper towels and cut into 1-inch cubes. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 482920,
      "primary_message": "Thread pork onto skewers and place on a plate. Alternatively, you can cook the pork pieces directly on the grill pan without using skewers. ",
      "secondary_message": null
    },
    {
      "id": 482921,
      "primary_message": "Return the pan to medium-high heat; working in batches, add the pork skewers and grill, turning occasionally, until the pork is charred and cooked through, about 8 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 482922,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallots. Place in a clean large bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 482923,
      "primary_message": "Juice limes into the bowl with the shallot, then add fish sauce, soy sauce, sugar, and chili-garlic sauce. Whisk to combine the dressing and set aside. ",
      "secondary_message": "3 tbsp fish sauce\n3 tbsp soy sauce\n2 tbsp brown sugar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 482924,
      "primary_message": "Small dice pineapple, return to the plate, and drizzle with half of the dressing. Stir to combine the salsa and set aside. (Reserve remaining dressing for the next step.)",
      "secondary_message": null
    },
    {
      "id": 482925,
      "primary_message": "Trim off and discard root end of the cabbages; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the reserved dressing.",
      "secondary_message": null
    },
    {
      "id": 482926,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 482927,
      "primary_message": "Roughly chop cashews. Add to the bowl and toss to combine the slaw.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 482928,
      "primary_message": "Divide skewers and slaw between plates. Serve with pineapple salsa on the side and enjoy!",
      "secondary_message": null
    }
  ],
