  "instructions": [
    {
      "id": 312265,
      "primary_message": "Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 312266,
      "primary_message": "Place chicken, salt, and pepper in a medium saucepan and cover with water by 1-inch; bring to a boil. Once boiling, reduce heat to low and simmer until chicken is cooked through, 8-10 minutes; transfer chicken to a plate to cool.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 312267,
      "primary_message": "Meanwhile, fill another medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 312268,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 red bell pepper\n1 medium carrot\n½ English cucumber\n½ small bunch cilantro"
    },
    {
      "id": 312269,
      "primary_message": "Once the water in the saucepan is boiling, add noodles and edamame; cook noodles according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water; set aside.",
      "secondary_message": "5 oz soba (buckwheat) noodles\n½ cup edamame, shelled"
    },
    {
      "id": 312270,
      "primary_message": "While the noodles and edamame cook, using a clean cutting board, peel and mince ginger and garlic. Place both in a medium bowl along with soy sauce, vinegar, oil, peanut butter, and honey; whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp toasted sesame oil\n1 tsp natural peanut butter\n1 tsp honey"
    },
    {
      "id": 312271,
      "primary_message": "Trim, seed, and thinly slice bell pepper; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 312272,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 312273,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 312274,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 312275,
      "primary_message": "Once the chicken is cool, shred using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat. Add to the bowl along with noodles and edamame.",
      "secondary_message": null
    },
    {
      "id": 312276,
      "primary_message": "Roughly chop peanuts and add to the bowl; toss to combine the noodle salad.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 312277,
      "primary_message": "To serve, divide noodle salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
