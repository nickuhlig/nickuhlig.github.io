  "instructions": [
    {
      "id": 1,
      "primary_message": "Place papaya, habanero(s), shallots, vinegar, lime juice, brown sugar, garlic, ginger, allspice, cloves, cinnamon, and nutmeg in jar of a blender. Puree until smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer mixture to a medium saucepan and bring to a boil over medium-high heat. Reduce heat to low and simmer for 10 minutes, stirring frequently. Season to taste with salt and pepper. Let cool to room temperature, then transfer to an airtight container and store in the refrigerator for up to a week.",
      "secondary_message": null
    }
