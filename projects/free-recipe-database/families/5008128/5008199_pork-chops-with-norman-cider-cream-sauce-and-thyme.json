  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the thyme leaves from the stems and chop them.",
      "secondary_message": "1 tsp fresh thyme"
    },
    {
      "id": 1,
      "primary_message": "Take the pork out of the fridge 15 minutes before you want to use it. Cut off the fatty rind if there is one. Season the chops all over with salt, pepper, and thyme, pressing the seasoning gently into the meat so it sticks.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat a wide skillet or sauté pan with the olive oil over medium heat. Bring a pot of salted water to boil for the gnocchi. Add the pork to the hot skillet and cook 5 minutes on each side, until nicely golden brown. Add the gnocchi to pot and cook 2 minutes until it floats to the top of the water, and drain.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "With the pork still in the pan, add the cider and then the cream. Cook another 5 minutes until the pork is cooked through and the sauce is reduced. Toss the gnocchi in the sauce with the pork chops and serve right away with a light green salad.",
      "secondary_message": null
    }
  ],
