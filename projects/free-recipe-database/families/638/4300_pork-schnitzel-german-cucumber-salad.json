  "instructions": [
    {
      "id": 48459,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 English cucumbers\n1 small bunch fresh dill"
    },
    {
      "id": 48460,
      "primary_message": "In a salad bowl, combine and mix together yogurt, vinegar, honey, Dijon, salt, and pepper.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp white wine vinegar\n2 tsp honey\n1 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 48461,
      "primary_message": "Trim off and discard the ends of the cucumbers; halve the cucumbers lengthwise, then slice crosswise into 6-mm-thick half-rounds at an angle. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 48462,
      "primary_message": "Using a knife, shave the dill leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 48463,
      "primary_message": "Toss the salad.",
      "secondary_message": null
    },
    {
      "id": 48464,
      "primary_message": "Crack the eggs into a medium bowl and beat with a whisk or fork.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 48465,
      "primary_message": "Place the flour and bread crumbs on two separate plates.",
      "secondary_message": "4 tbsp all-purpose flour\n1 ½ cups panko bread crumbs"
    },
    {
      "id": 48466,
      "primary_message": "Place the pork chops on a cutting board and, holding a knife parallel to the board, cut the chops in half horizontally to form thin fillets. Pat dry with paper towels. Season generously with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 48467,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 48468,
      "primary_message": "One piece at a time, thoroughly coat the seasoned pork chops in the flour (shaking off any excess), then in the beaten egg (letting the excess drip off), then in the bread crumbs (pressing to adhere). Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 48469,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 48470,
      "primary_message": "Place the breaded pork chops in the skillet; cook until they are golden brown and cooked through, 3 to 5 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 48471,
      "primary_message": "To serve, divide the schnitzel and cucumber salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
