  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium saucepan, heat half and half to a bare simmer and add rosemary. Cook on lowest possible heat for 20 minutes, covered, stirring bottom occasionally. Remove rosemary.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine egg yolks and maple syrup in a bowl and whisk until very well combined. Slowly add about 1/3 of dairy to bowl, one ladleful at a time, whisking constantly. Then transfer yolk mixture back to pot and whisk to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cook custard on medium low heat, whisking frequently, until it thickens to coat the back of a spoon but a swiped finger leaves a clean line. Add salt to taste, then strain into a container to chill overnight in refrigerator.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "The next day, churn according to manufacturer's instructions. Transfer ice cream to freezer for several hours so it can harden.",
      "secondary_message": null
    }
  ],
