  "instructions": [
    {
      "id": 385289,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 385290,
      "primary_message": "Wash, dry, and trim each squash, then halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "2 medium spaghetti squash\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 385291,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 385292,
      "primary_message": "While the squash is roasting, peel, halve, and medium dice onions. Place in a large bowl.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 385293,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385294,
      "primary_message": "While the skillet heats up, peel and thinly slice garlic. Add to the bowl with the onion.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 385295,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, crushed red pepper, and salt; cook, stirring occasionally, until starting to brown, 6-8 minutes. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 385296,
      "primary_message": "Meanwhile, drain and rinse chickpeas. ",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 385297,
      "primary_message": "Once the onion is starting to brown, add chickpeas, tomatoes, and more salt to the skillet; stir to combine the ragù. Reduce heat to medium-low and continue to cook, stirring occasionally, until the squash is done.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n½ tsp salt"
    },
    {
      "id": 385298,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl and set aside.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 385299,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 385300,
      "primary_message": "While the squash is cooling, wash, dry, and shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add half of the parsley to skillet, stir to combine, and remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 385301,
      "primary_message": "Once the squash has cooled slightly, scrape the inside with a fork to separate into spaghetti-like strands (use an oven mitt or towel to hold it with your other hand). Add squash to the bowl with the Parmesan and gently toss to combine.",
      "secondary_message": null
    },
    {
      "id": 385302,
      "primary_message": "To serve, divide squash and veggie ragù between plates or bowls. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
