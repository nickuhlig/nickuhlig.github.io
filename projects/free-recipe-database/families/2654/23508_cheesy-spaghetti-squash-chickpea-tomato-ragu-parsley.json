  "instructions": [
    {
      "id": 385303,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 385304,
      "primary_message": "Wash, dry, and trim each squash, then halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange halves, cut-side down, on the baking sheets.",
      "secondary_message": "3 medium spaghetti squash\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 385305,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 385306,
      "primary_message": "While the squash is roasting, peel, halve, and medium dice onions. Place in a large bowl.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 385307,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl with the onion.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 385308,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385309,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, crushed red pepper, and salt; cook, stirring occasionally, until starting to brown, 8-10 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 385310,
      "primary_message": "Meanwhile, drain and rinse chickpeas. ",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 385311,
      "primary_message": "Once the onion is starting to brown, add chickpeas, tomatoes, and more salt to the pot; stir to combine the ragù. Reduce heat to medium-low and continue to cook, stirring occasionally, until the squash is done.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n¾ tsp salt"
    },
    {
      "id": 385312,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl and set aside.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 385313,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 385314,
      "primary_message": "While the squash is cooling, wash, dry, and shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add half of the parsley to pot, stir to combine, and remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 385315,
      "primary_message": "Once the squash has cooled slightly, scrape the inside with a fork to separate into spaghetti-like strands (use an oven mitt or towel to hold it with your other hand). Add squash to the bowl with the Parmesan and gently toss to combine.",
      "secondary_message": null
    },
    {
      "id": 385316,
      "primary_message": "To serve, divide squash and veggie ragù between plates or bowls. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
