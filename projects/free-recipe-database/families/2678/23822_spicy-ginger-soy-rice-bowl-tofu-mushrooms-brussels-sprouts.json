  "instructions": [
    {
      "id": 388353,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 388354,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 388355,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 388356,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 388357,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n0.45 kg Brussels sprouts\n0.45 kg cremini mushrooms\n2 leeks"
    },
    {
      "id": 388358,
      "primary_message": "Peel and mince ginger. Place in a medium bowl along with soy sauce, chili-garlic sauce, oil, and maple syrup. Whisk to combine the marinade. Transfer half of the marinade to a small bowl and set aside for serving.",
      "secondary_message": "½ cup soy sauce\n3 tbsp chili-garlic sauce\n2 tbsp toasted sesame oil\n1 tbsp pure maple syrup"
    },
    {
      "id": 388359,
      "primary_message": "Medium dice tofu, add to the medium bowl with the marinade, and gently stir to coat. Set aside. (Wipe baking sheet dry with paper towels and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 388360,
      "primary_message": "Trim and thinly slice Brussels sprouts crosswise. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 388361,
      "primary_message": "Thinly slice mushrooms and add to the baking sheet with the Brussels sprouts. ",
      "secondary_message": null
    },
    {
      "id": 388362,
      "primary_message": "Trim off root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 388363,
      "primary_message": "Drizzle veggies with oil and season with salt. Toss to combine, then spread out in an even layer.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt"
    },
    {
      "id": 388364,
      "primary_message": "Transfer tofu to the reserved baking sheet and spread out in an even layer. Drizzle with any leftover marinade in the bowl.",
      "secondary_message": null
    },
    {
      "id": 388365,
      "primary_message": "Place baking sheets in the oven and roast, stirring halfway through, until veggies are tender and tofu is golden, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 388366,
      "primary_message": "Meanwhile, roughly chop cashews. ",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 388367,
      "primary_message": "When the veggies and tofu are done, remove from the oven. Sprinkle cashews over veggies and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 388368,
      "primary_message": "To serve, divide rice, tofu, and veggies between plates or bowls; drizzle with remaining marinade. Enjoy!",
      "secondary_message": null
    }
  ],
