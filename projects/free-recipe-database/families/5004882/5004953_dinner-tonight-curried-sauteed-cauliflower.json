  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat a large pan over medium-high heat. Add the oil, let it warm up for a bit and then dump in the cauliflower, onion, and curry powder.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir until the curry powder has coated the cauliflower. Cook for about six minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Toss in the cilantro, and then remove from the heat and serve. It’s also rather nice as a cold side.",
      "secondary_message": null
    }
