  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and halve zucchini lengthwise. Scrape out the soft flesh from the middle of each half, place in a medium bowl, and set aside for later use.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "primary_message": "Arrange zucchini halves, cut-side up, on a baking sheet pan; drizzle with oil and season with spices.",
      "secondary_message": "extra virgin olive oil\nItalian seasoning\nsalt\nblack pepper"
    },
    {
      "primary_message": "Place zucchini boats in the oven (it doesn't have to be fully heated) and bake until starting to soften, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, roughly chop reserved zucchini flesh and return to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice. Add to the bowl with the zucchini.",
      "secondary_message": "1 green bell pepper"
    },
    {
      "primary_message": "Roughly chop olives. Add to the bowl.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "primary_message": "Chop or tear prosciutto into bite-sized pieces. Add to the bowl, along with tomato sauce and spices, then stir to combine the filling. Set aside.",
      "secondary_message": "6 slices prosciutto\n1 (8 oz) can tomato sauce\nItalian seasoning\nsalt\n⅛ tsp crushed red pepper"
    },
    {
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "primary_message": "Remove zucchini boats from the oven, divide filling between them, and top with half of the cheese. (Reserve remaining cheese for later use.)",
      "secondary_message": null
    },
    {
      "primary_message": "Return zucchini boats to the oven and continue to bake until flesh is tender, filling is warmed through, and cheese is bubbly, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl along with oil and spices. Stir to combine the garlic oil.",
      "secondary_message": "1 clove garlic\nextra virgin olive oil\nItalian seasoning\nsalt\nblack pepper"
    },
    {
      "primary_message": "Place flatbread on another baking sheet, spread with garlic oil, then sprinkle with remaining cheese. Add to the oven and bake until slightly crispy and cheese is melted, 4-5 minutes. Remove from oven and cut into strips.",
      "secondary_message": "1 flatbread or naan"
    },
    {
      "primary_message": "To serve, divide stuffed zucchini and cheesy bread sticks between plates. Enjoy!",
      "secondary_message": null
    }
  ],
