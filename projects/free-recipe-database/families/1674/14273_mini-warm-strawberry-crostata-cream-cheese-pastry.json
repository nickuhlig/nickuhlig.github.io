  "instructions": [
    {
      "id": 237223,
      "primary_message": "Combine flour and salt in a medium bowl.",
      "secondary_message": "1 ½ cup all-purpose flour\n¼ tsp salt"
    },
    {
      "id": 237224,
      "primary_message": "Using a box grater, coarsely grate cold butter and cream cheese into the bowl with the flour. Using two hands, combine the ingredients by rubbing the mixture between your thumbs and fingers until it looks crumbly.",
      "secondary_message": "½ cup butter, unsalted\n¾ (8 oz) block cream cheese"
    },
    {
      "id": 237225,
      "primary_message": "Add cold water to the bowl and continue to mix with your hands to combine the dough.",
      "secondary_message": "1 ½ fl oz water"
    },
    {
      "id": 237226,
      "primary_message": "Divide the dough into 6 equal portions; pat each portion into a ½-inch thick disk. Wrap each disk tightly in plastic wrap and refrigerate until firm, about 1 hour (or overnight).",
      "secondary_message": null
    },
    {
      "id": 237227,
      "primary_message": "Once the dough has chilled, preheat oven to 425°F. Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 237228,
      "primary_message": "Wash, dry, trim, and slice strawberries crosswise into ¼-inch thick rounds; place in a medium bowl.",
      "secondary_message": "1 ½ (16 oz) pkg strawberries"
    },
    {
      "id": 237229,
      "primary_message": "Add sugar, cornstarch, and cinnamon to the bowl with the strawberries and gently toss to coat. Set aside.",
      "secondary_message": "⅓ cup granulated sugar\n3 tbsp cornstarch\n½ tsp cinnamon, ground"
    },
    {
      "id": 237230,
      "primary_message": "Sprinkle a small amount of flour over a flat working surface. Unwrap one piece of dough (leaving remaining dough in the refrigerator), and place on top of the floured work surface; sprinkle dough with a little more flour. ",
      "secondary_message": "1 ½ tsp all-purpose flour"
    },
    {
      "id": 237231,
      "primary_message": "Using a rolling pin, work the dough into a circle that is about ⅛-inch thick by 7-inches in diameter. Transfer dough to the baking sheet. Sprinkle your work surface with a little more flour and repeat with remaining dough.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 237232,
      "primary_message": "Arrange strawberries in the center of each dough circle (making sure to leave a 1½-inch border of dough around the strawberries). Drizzle any leftover juices over the fruit. ",
      "secondary_message": null
    },
    {
      "id": 237233,
      "primary_message": "Gently fold crust edges up toward the center, overlapping folds slightly, and pinch each fold to enclose the fruit.",
      "secondary_message": null
    },
    {
      "id": 237234,
      "primary_message": "Place crostatas in the oven and bake, rotating the baking sheet halfway through, until filling is bubbly and the pastry is golden brown, 25-30 minutes. Remove from oven and let cool slightly.",
      "secondary_message": null
    },
    {
      "id": 237235,
      "primary_message": "To serve, divide warm crostatas between plates and enjoy!",
      "secondary_message": null
    }
  ],
