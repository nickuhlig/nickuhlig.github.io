  "instructions": [
    {
      "id": 375990,
      "primary_message": "Drain and mince capers. Place in a medium bowl along with yogurt, mayo, and spices. Stir to combine the dressing.",
      "secondary_message": "1 tbsp capers\n¼ cup plain Greek yogurt\n3 tbsp avocado oil mayonnaise\n½ tsp dill, dried\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 375991,
      "primary_message": "Peel and mince shallot. Add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 375992,
      "primary_message": "Drain tuna, add to bowl, and flake with a fork. Stir to combine the tuna salad and set aside.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 375993,
      "primary_message": "Wash, dry, and trim celery; cut crosswise into 3-inch long sticks.",
      "secondary_message": "8 sticks celery"
    },
    {
      "id": 375994,
      "primary_message": "Divide tuna salad between plates and serve with celery sticks. Enjoy!",
      "secondary_message": null
    }
