  "instructions": [
    {
      "id": 375995,
      "primary_message": "Drain and mince capers. Place in a medium bowl along with yogurt, mayo, and spices. Stir to combine the dressing.",
      "secondary_message": "1 ½ tbsp capers\n⅓ cup plain Greek yogurt\n¼ cup avocado oil mayonnaise\n¾ tsp dill, dried\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 375996,
      "primary_message": "Peel and mince shallots. Add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 375997,
      "primary_message": "Drain tuna, add to bowl, and flake with a fork. Stir to combine the tuna salad and set aside.",
      "secondary_message": "3 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 375998,
      "primary_message": "Wash, dry, and trim celery; cut crosswise into 3-inch long sticks.",
      "secondary_message": "12 sticks celery"
    },
    {
      "id": 375999,
      "primary_message": "Divide tuna salad between plates and serve with celery sticks. Enjoy!",
      "secondary_message": null
    }
