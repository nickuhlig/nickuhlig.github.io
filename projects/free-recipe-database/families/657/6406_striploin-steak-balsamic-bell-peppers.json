  "instructions": [
    {
      "id": 78274,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 yellow bell peppers"
    },
    {
      "id": 78273,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Cut the quarters lengthwise into ¼-inch-thick strips. Transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 78272,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; cut lengthwise into ¼-inch-thick wedges. Add to the bowl with the bell peppers.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 78271,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the peppers and onion.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 78270,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 78269,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 78268,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 78267,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78266,
      "primary_message": "Once the steak has been transferred, reduce the heat to medium and add more coconut oil to the skillet.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 78265,
      "primary_message": "Add the peppers, onion, and garlic to the skillet and season with salt and pepper. Cook, stirring occasionally, until the peppers are just tender and lightly browned, 3 to 5 minutes. Once done, remove from the heat.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 78264,
      "primary_message": "Drizzle the peppers with balsamic vinegar and toss to coat.",
      "secondary_message": "3 tbsp balsamic vinegar"
    },
    {
      "id": 78263,
      "primary_message": "To serve, divide the steak and bell peppers between plates.",
      "secondary_message": ""
    }
  ],
