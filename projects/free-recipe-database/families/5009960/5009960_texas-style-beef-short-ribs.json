  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, combine pepper, salt, and garlic powder (if using) to make the rub. Season ribs all over liberally with the rub.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Fire up smoker or grill to 225°F adding chunks of smoking wood chunks when at temperature. When the wood is ignited and producing smoke, place the ribs in the smoker or grill, meat side up, and smoke until an instant-read thermometer registers 165°F when inserted into the thickest part of the ribs.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Wrap each rack of ribs tightly in butcher paper and return to smoker. Continue cooking until an instant-read thermometer registers 185°F when inserted into the thickest part of the ribs. There should be no resistance when inserting the thermometer into the meat.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer ribs to an empty cooler and let rest for a minimum of 30 minutes, up to 3 hours. Slice ribs into individual bones and serve.",
      "secondary_message": null
    }
  ],
