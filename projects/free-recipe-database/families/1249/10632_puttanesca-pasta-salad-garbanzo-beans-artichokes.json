  "instructions": [
    {
      "id": 170621,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n425 g spaghetti pasta"
    },
    {
      "id": 170622,
      "primary_message": "Meanwhile, peel and mince the garlic and shallots; place both in a large bowl. ",
      "secondary_message": "3 cloves garlic\n3 shallots"
    },
    {
      "id": 170623,
      "primary_message": "Add oil, vinegar, and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp balsamic vinegar\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 170624,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 170625,
      "primary_message": "Halve olives lengthwise and add to the bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 170626,
      "primary_message": "Roughly chop capers and add to the bowl.",
      "secondary_message": "4 ½ tbsp capers"
    },
    {
      "id": 170627,
      "primary_message": "Wash, dry, and halve tomatoes; add to the bowl.",
      "secondary_message": "3 small pkgs grape tomatoes"
    },
    {
      "id": 170628,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Add to the bowl and stir to combine.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 170629,
      "primary_message": "Drain pasta in a colander and rinse under cold water; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 170630,
      "primary_message": "Drain and rinse the beans; add to the bowl. Gently toss the salad to combine.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 170631,
      "primary_message": "To serve, divide pasta salad between bowls or plates. Garnish with pine nuts and enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
