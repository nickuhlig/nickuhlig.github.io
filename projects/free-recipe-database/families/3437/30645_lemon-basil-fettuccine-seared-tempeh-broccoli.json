  "instructions": [
    {
      "id": 486460,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until almost done, about 8 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz fettuccine pasta"
    },
    {
      "id": 486461,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil and spices.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 486462,
      "primary_message": "Slice tempeh crosswise into thin strips. Add to the bowl with the garlic-oil, stir to coat, and set aside to marinate.",
      "secondary_message": "3 (8 oz) packages tempeh"
    },
    {
      "id": 486463,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 crowns broccoli\n1 small pkg fresh basil\n1 ½ lemons"
    },
    {
      "id": 486464,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 486465,
      "primary_message": "When the pasta is almost done, add broccoli to the pot. Continue to cook, stirring occasionally, until pasta reaches desired firmness and broccoli is tender, 2-3 minutes more. Drain pasta and set aside. (Reserve a ½-cup pasta water before draining.)",
      "secondary_message": null
    },
    {
      "id": 486466,
      "primary_message": "Meanwhile, preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 486467,
      "primary_message": "Once the pot is hot, working in batches, add tempeh in a single layer; cook, flipping once, until browned and warmed through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 486468,
      "primary_message": "While the tempeh is cooking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 486469,
      "primary_message": "When the tempeh is done, juice lemons into the pot.",
      "secondary_message": null
    },
    {
      "id": 486470,
      "primary_message": "Add drained pasta, broccoli, reserved pasta cooking water, and half of the basil to the pot with the tempeh. Toss to combine and continue to cook until heated through, 2-3 minutes. Remove from heat. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 486471,
      "primary_message": "To serve, divide pasta between plates or bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
