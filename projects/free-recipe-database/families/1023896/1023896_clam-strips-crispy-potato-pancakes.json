  "instructions": [
    {
      "primary_message": "Make clam strips according to package directions.",
      "secondary_message": null
    },
    {
      "primary_message": "In a mixing bowl stir to combine hash brown potatoes, eggs, milk, flour, garlic seasoning cubes, baking powder, Kinder's® seasoning and half of the chives.",
      "secondary_message": null
    },
    {
      "primary_message": "Heat sauté pan oven medium heat and add vegetable oil. Using a ¼-cup scoop, add potato mixture and flatten to a small pancake size. Cook until golden brown, about 3 to 4 minutes each side.",
      "secondary_message": null
    },
    {
      "primary_message": "Plate potato pancakes and top with clam strips. Serve with cocktail sauce. Garnish with lemon wedges and remaining chives.",
      "secondary_message": null
    }
