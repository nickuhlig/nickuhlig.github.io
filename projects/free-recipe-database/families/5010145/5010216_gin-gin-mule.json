  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the leaves from the mint. Juice the lime.",
      "secondary_message": "10 fresh mint\n½ lime"
    },
    {
      "id": 1,
      "primary_message": "In a cocktail shaker, lightly muddle mint leaves with simple syrup and lime juice.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add gin and fill with ice; shake gently until chilled (you don't want to smash the mint to smithereens), about 10 seconds. Strain into a highball glass filled with ice, add ginger beer and stir. Garnish with lime wedge or mint sprig, or both.",
      "secondary_message": null
    }
