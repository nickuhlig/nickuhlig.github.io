  "instructions": [
    {
      "id": 170059,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n1 (2 ½ cm) piece ginger root\n½ jalapeño pepper\n½ small bunch cilantro\n½ small bunch green onions (scallions)\n1 medium carrot\n½ head butter (Boston) lettuce"
    },
    {
      "id": 170060,
      "primary_message": "Zest and juice the lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 170061,
      "primary_message": "Peel and grate or mince the ginger; peel and mince garlic. Transfer both to the bowl with the lime.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 170062,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl with the lime. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 170063,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the lime.",
      "secondary_message": null
    },
    {
      "id": 170064,
      "primary_message": "Trim off and discard ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Add half to the bowl with the lime; reserve the rest for garnish.",
      "secondary_message": null
    },
    {
      "id": 170065,
      "primary_message": "Drain salmon. Add to the bowl along with the egg, mayonnaise, almond meal, and salt; mash with a fork to combine.",
      "secondary_message": "1 (213 g) can wild pink salmon, traditional style\n1 egg\n2 tbsp avocado oil mayonnaise\n⅓ cup almond meal/flour\n⅛ tsp salt"
    },
    {
      "id": 170066,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 170067,
      "primary_message": "Using a ¼ cup measure, portion and form the salmon mixture into ½-inch thick patties.",
      "secondary_message": null
    },
    {
      "id": 170068,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place patties in the skillet and cook until browned on the outside and warmed through, about 3 minutes per side. Remove to a plate. ",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 170069,
      "primary_message": "Meanwhile, trim off and discard ends of the carrot. Using a julienne (or regular) peeler, peel the carrot into thin noodle-like sticks.",
      "secondary_message": null
    },
    {
      "id": 170070,
      "primary_message": "In a small bowl mix together chili-garlic sauce and mayonnaise.",
      "secondary_message": "1 tsp chili-garlic sauce\n2 tbsp mayonnaise"
    },
    {
      "id": 170071,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Divide carrots and salmon cakes between leaves; top with spicy mayo and reserved green onion. Enjoy!",
      "secondary_message": null
    }
  ],
