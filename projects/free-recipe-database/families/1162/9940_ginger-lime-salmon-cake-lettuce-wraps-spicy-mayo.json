  "instructions": [
    {
      "id": 170085,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 (2 ½ cm) pieces ginger root\n1 ½ jalapeño peppers\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n3 medium carrots\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 170086,
      "primary_message": "Zest and juice the limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 170087,
      "primary_message": "Peel and grate or mince the ginger; peel and mince garlic. Transfer both to the bowl with the lime.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 170088,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl with the lime. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 170089,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the lime.",
      "secondary_message": null
    },
    {
      "id": 170090,
      "primary_message": "Trim off and discard ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Add half to the bowl with the lime; reserve the rest for garnish.",
      "secondary_message": null
    },
    {
      "id": 170091,
      "primary_message": "Drain salmon. Add to the bowl along with the eggs, mayonnaise, almond meal, and salt; mash with a fork to combine.",
      "secondary_message": "3 (213 g) cans wild pink salmon, traditional style\n3 eggs\n⅓ cup avocado oil mayonnaise\n1 cup almond meal/flour\n¼ tsp salt"
    },
    {
      "id": 170092,
      "primary_message": "Using a ¼ cup measure, portion and form the salmon mixture into ½-inch thick patties.",
      "secondary_message": null
    },
    {
      "id": 170093,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 170094,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place patties in the skillet and cook until browned on the outside and warmed through, about 3 minutes per side. Remove to a plate. ",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 170095,
      "primary_message": "Meanwhile, trim off and discard ends of the carrots. Using a julienne (or regular) peeler, peel the carrots into thin noodle-like sticks.",
      "secondary_message": null
    },
    {
      "id": 170096,
      "primary_message": "In a small bowl mix together chili-garlic sauce and mayonnaise.",
      "secondary_message": "1 tbsp chili-garlic sauce\n⅓ cup mayonnaise"
    },
    {
      "id": 170097,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Divide carrots and salmon cakes between leaves; top with spicy mayo and reserved green onion. Enjoy!",
      "secondary_message": null
    }
  ],
