  "instructions": [
    {
      "primary_message": "Transfer soup to a medium saucepan and bring to a simmer over medium-high heat, stirring occasionally. Once simmering, reduce heat to medium and continue to cook until warmed through, 2-3 minutes more. Remove from heat and season with salt and pepper to taste.",
      "secondary_message": "2 (24 oz) container chicken noodle soup"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and juice lemon into the soup.",
      "secondary_message": "½ lemon"
    },
    {
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add parsley to the soup and stir to combine.",
      "secondary_message": "¼ small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "Divide soup between bowls and serve with crackers on the side. Enjoy!\n\n",
      "secondary_message": null
    }
  ],
