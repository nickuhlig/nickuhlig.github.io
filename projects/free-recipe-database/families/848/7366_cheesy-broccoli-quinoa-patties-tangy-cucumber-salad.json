  "instructions": [
    {
      "id": 110398,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and spread onto a baking sheet in a thin layer to cool.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 110399,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 English cucumber"
    },
    {
      "id": 110400,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 110401,
      "primary_message": "Peel and small dice the onion; set half aside in a medium bowl for the salad.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 110402,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 110403,
      "primary_message": "Add the other half of the onion to the skillet; cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 110404,
      "primary_message": "Finely mince the broccoli (you should have about 2 cups). Add to the skillet along with the onion and cook another 3-4 minutes, stirring frequently. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 110405,
      "primary_message": "Grate the cheddar.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 110406,
      "primary_message": "In a large bowl, combine the cooked quinoa, onion, broccoli, cheese, panko, and eggs.",
      "secondary_message": "½ cup panko bread crumbs\n2 eggs"
    },
    {
      "id": 110407,
      "primary_message": "Form the quinoa vegetable mixture into patties using a ¼-cup measure, firmly pressing the mixture together between your hands.",
      "secondary_message": null
    },
    {
      "id": 110408,
      "primary_message": "Wipe out the skillet with a paper towel and heat over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 110409,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place the patties in the skillet and cook for 5-6 minutes; flip and cook another 2-3 minutes, until golden brown on both sides.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 110410,
      "primary_message": "Trim the ends of the cucumber, then thinly slice.",
      "secondary_message": null
    },
    {
      "id": 110411,
      "primary_message": "Add cucumber, oil, vinegar, salt, and pepper to the bowl with the onion. Stir to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 110412,
      "primary_message": "To serve, divide the quinoa patties and cucumber salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
