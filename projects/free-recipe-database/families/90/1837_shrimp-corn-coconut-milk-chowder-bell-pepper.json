  "instructions": [
    {
      "id": 16763,
      "primary_message": "If using frozen shrimp, place in a medium bowl, cover with water, and set aside to thaw. If using fresh shrimp, skip this step.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 16764,
      "primary_message": "Wash potatoes and bell peppers. Peel and medium dice potatoes. Seed and medium dice peppers. Remove husks and silks from corn. Stand up in the middle of a medium bowl and slice kernels off the cob. Transfer everything to a medium bowl.",
      "secondary_message": "4 medium yellow potatoes\r\n2 red bell peppers\r\n4 ears corn"
    },
    {
      "id": 16765,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 16766,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\r\n2 cloves garlic"
    },
    {
      "id": 16767,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and, stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 16768,
      "primary_message": "Add garlic, potatoes, bell pepper, and corn to saucepan. Stir to combine.",
      "secondary_message": ""
    },
    {
      "id": 16769,
      "primary_message": "Add coconut milk, broth, cumin, coriander, salt, and pepper. Bring to a boil. Reduce heat and simmer until potatoes are tender, about 10 minutes.",
      "secondary_message": "1 (13.5 fl oz) can coconut milk\n16 fl oz (2 cups) chicken or vegetable broth\n1 tsp cumin\n1 tsp coriander\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 16770,
      "primary_message": "Drain shrimp and rinse under cold water until there are no more ice chunks. Place on paper towels and pat dry. Add to saucepan while the chowder is cooking.",
      "secondary_message": ""
    },
    {
      "id": 16771,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 16772,
      "primary_message": "To serve, pour soup into a bowl and enjoy with bread on the side!",
      "secondary_message": ""
    }
  ],
