  "instructions": [
    {
      "id": 416949,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 416950,
      "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate. Season both sides with salt and pepper.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 416951,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 416952,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 (170 g) pkgs blueberries\n1 ½ jalapeño peppers\n1 small bunch cilantro\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 416953,
      "primary_message": "Roughly chop half of the blueberries. Place both chopped and remaining whole blueberries in a medium bowl along with vinegar, oil, salt, and pepper. Stir to combine.",
      "secondary_message": "3 tbsp balsamic vinegar\n1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 416954,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the blueberries. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 416955,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl and stir once more to combine the salsa; set aside. (Reserve remaining cilantro for the next step.)",
      "secondary_message": null
    },
    {
      "id": 416956,
      "primary_message": "Place remaining cilantro in a large bowl along with mixed greens, carrots, and dressing. Toss to combine the salad.",
      "secondary_message": "1 ½ (283 g) bags shredded carrots\n¾ cup ranch dressing"
    },
    {
      "id": 416957,
      "primary_message": "To serve, divide pork chops and salad between plates; top chops with blueberry salsa. Enjoy!",
      "secondary_message": null
    }
  ],
