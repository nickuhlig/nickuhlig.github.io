  "instructions": [
    {
      "id": 416931,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 416932,
      "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate. Season both sides with salt and pepper.",
      "secondary_message": "2 pork chops, boneless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 416933,
      "primary_message": "Once the pan is hot, coat with oil. Add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 416934,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 (170 g) pkg blueberries\n½ jalapeño pepper\n½ small bunch cilantro\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 416935,
      "primary_message": "Roughly chop half of the blueberries. Place both chopped and remaining whole blueberries in a small bowl along with vinegar, oil, salt, and pepper. Stir to combine.",
      "secondary_message": "1 tbsp balsamic vinegar\n1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 416936,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the blueberries. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 416937,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl and stir once more to combine the salsa; set aside. (Reserve remaining cilantro for the next step.)",
      "secondary_message": null
    },
    {
      "id": 416938,
      "primary_message": "Place remaining cilantro in a medium bowl along with mixed greens, carrots, and dressing. Toss to combine the salad.",
      "secondary_message": "½ (283 g) bag shredded carrots\n¼ cup ranch dressing"
    },
    {
      "id": 416939,
      "primary_message": "To serve, divide pork chops and salad between plates; top chops with blueberry salsa. Enjoy!",
      "secondary_message": null
    }
  ],
