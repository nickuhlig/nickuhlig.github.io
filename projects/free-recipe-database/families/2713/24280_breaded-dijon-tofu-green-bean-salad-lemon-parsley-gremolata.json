  "instructions": [
    {
      "id": 439557,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 439558,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 439559,
      "primary_message": "Peel and mince garlic. Place half in a small bowl and half in a medium bowl. (Set medium bowl aside for later use.)",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 439560,
      "primary_message": "Add mayo and Dijon to the small bowl with the garlic. Stir to combine the Dijon mayo.",
      "secondary_message": "3 tbsp mayonnaise\n1 ½ tsp Dijon mustard"
    },
    {
      "id": 439561,
      "primary_message": "Cut the tofu planks in half crosswise. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet. Season both sides with salt and pepper.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 439562,
      "primary_message": "Spread half of the Dijon mayo over the top side of the tofu, sprinkle with half of the bread crumbs (pressing gently to adhere), and drizzle with half of the oil. Carefully flip tofu and repeat with remaining mayo, bread crumbs, and oil.",
      "secondary_message": "¾ cup panko bread crumbs\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 439563,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until tofu is golden, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 439564,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch Italian (flat-leaf) parsley\n1 lb green beans"
    },
    {
      "id": 439565,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 439566,
      "primary_message": "While the water is heating, zest lemon into the bowl with the reserved garlic. Cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 439567,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with additional oil and salt; stir to combine gremolata and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 439568,
      "primary_message": "Trim green beans. ",
      "secondary_message": null
    },
    {
      "id": 439569,
      "primary_message": "Once the water in the pot is boiling, add green beans and additional salt; cook until tender-crisp, 1-2 minutes. Drain and rinse under cold water to cool.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 439570,
      "primary_message": "Add cooled green beans to the bowl with the gremolata and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 439571,
      "primary_message": "To serve, divide tofu and green beans between plates; squeeze lemon over top. Enjoy!",
      "secondary_message": null
    }
  ],
