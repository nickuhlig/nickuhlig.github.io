  "instructions": [
    {
      "id": 439793,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 439794,
      "primary_message": "Peel and mince garlic. Place half in a small bowl and half in a large bowl. (Set large bowl aside for later use.)",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 439795,
      "primary_message": "Add mayo and Dijon to the small bowl with the garlic. Stir to combine the Dijon mayo.",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp Dijon mustard"
    },
    {
      "id": 439796,
      "primary_message": "Pat chicken dry with paper towels, place on a baking sheet pan, then season with salt and pepper on both sides. Spread out in an even layer.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 439797,
      "primary_message": "Spread the Dijon mayo over the top side of the chicken, then sprinkle with bread crumbs, pressing gently to adhere. Drizzle with oil.",
      "secondary_message": "1 cup panko bread crumbs\n4 tsp extra virgin olive oil"
    },
    {
      "id": 439798,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken is golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 439799,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small bunch Italian (flat-leaf) parsley\n0.91 kg green beans"
    },
    {
      "id": 439800,
      "primary_message": "Fill a large pot about two-thirds with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 439801,
      "primary_message": "While the water is heating, zest lemon into the bowl with the reserved garlic. Cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 439802,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with additional oil and salt; stir to combine gremolata and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 439803,
      "primary_message": "Trim green beans. ",
      "secondary_message": null
    },
    {
      "id": 439804,
      "primary_message": "Once the water in the pot is boiling, add green beans and additional salt; cook until tender-crisp, about 2 minutes. Drain and rinse under cold water to cool.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 439805,
      "primary_message": "Add cooled green beans to the bowl with the gremolata. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 439806,
      "primary_message": "To serve, divide chicken and green beans between plates; squeeze lemon over top. Enjoy!",
      "secondary_message": null
    }
  ],
