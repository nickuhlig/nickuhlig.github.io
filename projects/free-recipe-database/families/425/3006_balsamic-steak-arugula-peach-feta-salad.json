  "instructions": [
    {
      "id": 29658,
      "primary_message": "Peel and mince the garlic; transfer to a medium bowl (that can hold the steak).",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 29663,
      "primary_message": "Add balsamic vinegar and olive oil to the garlic; whisk together.",
      "secondary_message": "2 tbsp balsamic vinegar\n½ tbsp extra virgin olive oil"
    },
    {
      "id": 29652,
      "primary_message": "Place the steak on a plate and generously season both sides with salt and pepper.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 29664,
      "primary_message": "Transfer the steak to the balsamic marinade and turn to coat; set aside.",
      "secondary_message": null
    },
    {
      "id": 29651,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 29655,
      "primary_message": "While the pan/skillet warms up, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ (5 oz) pkg baby arugula\n1 peach"
    },
    {
      "id": 29711,
      "primary_message": "Place the arugula in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 29656,
      "primary_message": "Quarter the peach, twist to open, and remove the pit. Slice each quarter into 4 wedges and add to the arugula; toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 29653,
      "primary_message": "Once the pan/skillet is warm, add coconut oil and brush or swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 29654,
      "primary_message": "Remove the steak from the marinade and place in the pan/skillet; cook until desired doneness, 2 to 5 minutes per side. Once done, transfer to a plate and loosely cover with aluminum foil; let it rest for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 29657,
      "primary_message": "Place the feta into a small bowl.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 29660,
      "primary_message": "In a small bowl, combine and whisk together olive oil, balsamic vinegar, Dijon, salt, and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tbsp balsamic vinegar\n¼ tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 29661,
      "primary_message": "Transfer the steak to a cutting board and thinly slice against the grain.",
      "secondary_message": null
    },
    {
      "id": 29662,
      "primary_message": "To serve, place the steak slices on a plate and the salad on the side. Sprinkle the salad with feta and drizzle with the dressing. Enjoy!",
      "secondary_message": null
    }
  ],
