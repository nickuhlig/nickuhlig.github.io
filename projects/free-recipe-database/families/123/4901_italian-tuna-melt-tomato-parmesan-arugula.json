  "instructions": [
    {
      "id": 59618,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": ""
    },
    {
      "id": 59608,
      "primary_message": "Peel and mince garlic. In a medium bowl, whisk together garlic, oil, vinegar, Dijon, dill, salt, and pepper.",
      "secondary_message": "3 cloves garlic\n6 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n3 tbsp Dijon mustard\n1 ½ tsp dill\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 59617,
      "primary_message": "Drain tuna, add to bowl, and flake with a fork.",
      "secondary_message": "3 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 59616,
      "primary_message": "Wash, dry, and small dice celery. Add to bowl and mix well. Set aside.",
      "secondary_message": "3 sticks celery"
    },
    {
      "id": 59615,
      "primary_message": "Wash and dry arugula. Wash and slice tomatoes into rounds.",
      "secondary_message": "1 ½ (5 oz) pkg baby arugula\n3 tomatoes"
    },
    {
      "id": 59614,
      "primary_message": "Grate ¾ cup Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 59613,
      "primary_message": "Place bread slices on a sheet pan. Top 6 of the slices with a few arugula leaves, tomato slices, and tuna mixture. Sprinkle with Parmesan.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 59612,
      "primary_message": "Place in the oven and broil until cheese melts and browns, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 59611,
      "primary_message": "In a large bowl, prepare salad dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "4 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n⅜ tsp Dijon mustard\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 59610,
      "primary_message": "Add arugula to bowl and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 59609,
      "primary_message": "To serve, place tuna melts on a plate and have salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
