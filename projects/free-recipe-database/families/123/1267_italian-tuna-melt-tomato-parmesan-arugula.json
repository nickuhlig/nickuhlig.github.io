  "instructions": [
    {
      "id": 10569,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": ""
    },
    {
      "id": 10570,
      "primary_message": "Peel and mince garlic. In a medium bowl, whisk together garlic, oil, vinegar, Dijon, dill, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\n4 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n2 tbsp Dijon mustard\r\n1 tsp dill\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 10571,
      "primary_message": "Drain tuna, add to bowl, and flake with a fork.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 10572,
      "primary_message": "Wash, dry, and small dice celery. Add to bowl and mix well. Set aside.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 10573,
      "primary_message": "Wash and dry arugula. Wash and slice tomatoes into rounds.",
      "secondary_message": "1 (142 g) pkg baby arugula\r\n2 tomatoes"
    },
    {
      "id": 10574,
      "primary_message": "Grate ½ cup Parmesan.",
      "secondary_message": "56 g Parmesan cheese"
    },
    {
      "id": 10575,
      "primary_message": "Place bread slices on a sheet pan. Top 4 of the slices with a few arugula leaves, tomato slices, and tuna mixture. Sprinkle with Parmesan.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 10576,
      "primary_message": "Place in the oven and broil until cheese melts and browns, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 10577,
      "primary_message": "In a large bowl, prepare salad dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n¼ tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 10578,
      "primary_message": "Add arugula to bowl and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 10579,
      "primary_message": "To serve, place tuna melts on a plate and have salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
