  "instructions": [
    {
      "id": 184334,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.91 kg new potatoes\n1 small bunch fresh dill\n2 avocados\n1 small bunch green onions (scallions)\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 184335,
      "primary_message": "Cut potatoes in half and place in a large pot. Cover with hot water (from the tap) by 1-inch and bring to a boil over high heat. Once boiling, reduce heat to medium and cook until fork-tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 184336,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a small bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp apple cider vinegar\n4 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 184337,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing, stir to combine, and set aside. Reserve the other half for the potatoes.",
      "secondary_message": null
    },
    {
      "id": 184338,
      "primary_message": "Halve and pit the avocados; slice thinly while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 184339,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 184340,
      "primary_message": "Add peas to the potatoes during the last 2 minutes of cooking.",
      "secondary_message": "2 cups frozen peas"
    },
    {
      "id": 184341,
      "primary_message": "Drain potatoes and peas in a colander, then return to the pot. Add oil and reserved dill; toss to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 184342,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "2 (113 g) pkg smoked salmon"
    },
    {
      "id": 184343,
      "primary_message": "To serve, divide arugula between plates and top with dilly potatoes, avocado, green onions, and salmon. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
