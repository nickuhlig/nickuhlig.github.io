  "instructions": [
    {
      "id": 184294,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lb new potatoes\n½ small bunch fresh dill\n1 avocado\n½ small bunch green onions (scallions)\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 184295,
      "primary_message": "Cut potatoes in half and place in a medium saucepan. Cover with hot water (from the tap) by 1-inch and bring to a boil over high heat. Once boiling, reduce heat to medium and cook until fork-tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 184296,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a small bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n2 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 184297,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing, stir to combine, and set aside. Reserve the other half for the potatoes.",
      "secondary_message": null
    },
    {
      "id": 184298,
      "primary_message": "Halve and pit the avocado; slice thinly while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 184299,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 184300,
      "primary_message": "Add peas to the potatoes during the last 2 minutes of cooking.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 184301,
      "primary_message": "Drain potatoes and peas in a colander, then return to the pan. Add oil and reserved dill; toss to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 184302,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 184303,
      "primary_message": "To serve, divide arugula between plates and top with dilly potatoes, avocado, green onions, and salmon. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
