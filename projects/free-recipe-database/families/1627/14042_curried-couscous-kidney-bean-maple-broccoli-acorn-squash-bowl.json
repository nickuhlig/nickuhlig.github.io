  "instructions": [
    {
      "id": 233536,
      "primary_message": "Preheat oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 233537,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n1 acorn squash\n1 red bell pepper\n1 lime"
    },
    {
      "id": 233538,
      "primary_message": "Place maple syrup, oil, salt, and pepper in a large bowl; whisk to combine the sauce.",
      "secondary_message": "3 tbsp pure maple syrup\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 233539,
      "primary_message": "Separate broccoli heads into bite-sized florets and cut stems into smaller pieces; add to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 233540,
      "primary_message": "Halve acorn squash lengthwise, trim off the ends, then scoop out the seeds. Cut crosswise into ¼-inch-thick slices and add to the bowl; toss vegetables to coat.",
      "secondary_message": null
    },
    {
      "id": 233541,
      "primary_message": "Transfer broccoli-squash mixture to the baking sheet and spread out in an even layer. Place in the oven and bake, tossing halfway through, until veggies are fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 233542,
      "primary_message": "While the veggies are roasting, peel and small dice onion. Trim, seed, and small dice bell pepper.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 233543,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 233544,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans kidney beans"
    },
    {
      "id": 233545,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and bell pepper; cook, stirring occasionally, until soft, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 233546,
      "primary_message": "Add beans, broth, and spices to the pot; stir to combine and bring to a boil over high heat.",
      "secondary_message": "473 ml chicken or vegetable broth\n2 tsp curry powder\n2 tsp parsley flakes\n1 tsp salt\n½ tsp garlic powder"
    },
    {
      "id": 233547,
      "primary_message": "Once the liquid is boiling, remove from heat; add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "1 cup whole wheat couscous"
    },
    {
      "id": 233548,
      "primary_message": "Meanwhile, cut lime into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 233549,
      "primary_message": "To serve, divide curried couscous, roasted veggies, and lime wedges between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
