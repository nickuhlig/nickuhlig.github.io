  "instructions": [
    {
      "id": 233508,
      "primary_message": "Preheat oven to 450°F. Line two baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 233509,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 acorn squash\n1 ½ red bell peppers\n1 ½ limes"
    },
    {
      "id": 233510,
      "primary_message": "Place maple syrup, oil, salt, and pepper in a large bowl; whisk to combine the sauce.",
      "secondary_message": "¼ cup pure maple syrup\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 233511,
      "primary_message": "Separate broccoli heads into bite-sized florets and cut stems into smaller pieces; add to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 233512,
      "primary_message": "Halve each acorn squash lengthwise, trim off the ends, then scoop out the seeds. Cut crosswise into ¼-inch-thick slices and add to the bowl; toss vegetables to coat.",
      "secondary_message": null
    },
    {
      "id": 233513,
      "primary_message": "Divide broccoli-squash mixture between baking sheets and spread out in an even layer. Place in the oven and bake, tossing halfway through, until veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 233514,
      "primary_message": "While the veggies are roasting, peel and small dice onions. Trim, seed, and small dice bell peppers.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 233515,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 233516,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans kidney beans"
    },
    {
      "id": 233517,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and bell pepper; cook, stirring occasionally, until soft, 5-7 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 233518,
      "primary_message": "Add beans, broth, and spices to the pot; stir to combine and bring to a boil over high heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 tbsp curry powder\n1 tbsp parsley flakes\n1 ½ tsp salt\n¾ tsp garlic powder"
    },
    {
      "id": 233519,
      "primary_message": "Once the liquid is boiling, remove from heat; add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "1 ½ cups whole wheat couscous"
    },
    {
      "id": 233520,
      "primary_message": "Meanwhile, cut limes into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 233521,
      "primary_message": "To serve, divide curried couscous, roasted veggies, and lime wedges between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
