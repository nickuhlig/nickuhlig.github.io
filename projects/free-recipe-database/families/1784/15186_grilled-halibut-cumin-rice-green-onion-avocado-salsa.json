  "instructions": [
    {
      "id": 250488,
      "primary_message": "Peel and mince garlic; place in a small saucepan.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 250489,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to the saucepan with the garlic. Add water and spices; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n½ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 250490,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 avocado\n1 jalapeño pepper\n½ lime"
    },
    {
      "id": 250491,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 250492,
      "primary_message": "Place corn in the colander and run under hot water (from the tap); set aside to drain.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 250493,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250494,
      "primary_message": "While the grill pan heats up, trim green onions.",
      "secondary_message": null
    },
    {
      "id": 250495,
      "primary_message": "Once the grill pan is hot, coat with oil. Add green onions and grill, turning occasionally, until charred and tender, about 5 minutes. Remove to a cutting board to cool slightly.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 250496,
      "primary_message": "While the onions are grilling, halve and pit the avocado; scoop out the flesh with a spoon and small dice. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 250497,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl with the avocado. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 250498,
      "primary_message": "Drain tomatoes and add to the bowl along with the corn and spices; stir to combine the salsa and set aside.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n¼ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 250499,
      "primary_message": "Pat halibut dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb halibut fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 250500,
      "primary_message": "Return grill pan to medium-high heat and coat with more oil. Add halibut and grill, flipping once, until fish flakes easily with a fork, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 250501,
      "primary_message": "Meanwhile, chop grilled onions into 1-inch pieces, add to the salsa, and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 250502,
      "primary_message": "Cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 250503,
      "primary_message": "To serve, divide rice, salsa, and halibut between plates. Squeeze lime over top and enjoy!",
      "secondary_message": null
    }
  ],
