  "instructions": [
    {
      "id": 503208,
      "primary_message": "In a large pot, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook 15 minutes. Remove from heat and let stand, covered, 5 minutes.",
      "secondary_message": "2 ¼ cups quinoa\n36 fl oz (4 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 503209,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans pinto beans"
    },
    {
      "id": 503210,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ (16 oz) pkgs strawberries\n1 ½ jalapeño peppers\n1 ½ small bunches cilantro\n3 limes"
    },
    {
      "id": 503211,
      "primary_message": "Peel and small dice onions. ",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 503212,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503213,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 503214,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and garlic to the skillet and cook, stirring occasionally, until soft, 4-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 503215,
      "primary_message": "Remove stems and roughly chop strawberries; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 503216,
      "primary_message": "Add drained beans, frozen corn, broth, and spices to the skillet. Cook, stirring occasionally, until heated through, 6-8 minutes.",
      "secondary_message": "1 ½ cups frozen corn\n12 fl oz (1 ½ cups) chicken or vegetable broth\n1 ½ tsp chili powder\n1 ½ tsp salt\n¾ tsp cumin, ground\n¾ tsp oregano, dried\n¾ tsp paprika\n½ tsp crushed red pepper"
    },
    {
      "id": 503217,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the bowl with the strawberries. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 503218,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the strawberries.",
      "secondary_message": null
    },
    {
      "id": 503219,
      "primary_message": "Juice one and a half limes into the bowl with the strawberries; cut remaining limes into wedges. ",
      "secondary_message": null
    },
    {
      "id": 503220,
      "primary_message": "Peel and mince the shallots; add to the bowl. Stir to combine the salsa.",
      "secondary_message": "1 ½ shallots"
    },
    {
      "id": 503221,
      "primary_message": "To serve, divide quinoa between bowls, top with bean mixture, salsa, and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
