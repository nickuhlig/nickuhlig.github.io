  "instructions": [
    {
      "id": 503222,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook 15 minutes. Remove from heat and let stand, covered, 5 minutes.",
      "secondary_message": "¾ cup quinoa\n355 ml chicken or vegetable broth"
    },
    {
      "id": 503223,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can pinto beans"
    },
    {
      "id": 503224,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (454 g) pkg strawberries\n½ jalapeño pepper\n½ small bunch cilantro\n1 lime"
    },
    {
      "id": 503225,
      "primary_message": "Peel and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 503226,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503227,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 503228,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and garlic to the skillet and cook, stirring occasionally, until soft, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 503229,
      "primary_message": "Remove stems and roughly chop strawberries; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 503230,
      "primary_message": "Add drained beans, frozen corn, broth, and spices to the skillet. Cook, stirring occasionally, until heated through, about 5 minutes.",
      "secondary_message": "½ cup frozen corn\n118 ml (½ cup) chicken or vegetable broth\n½ tsp chili powder\n½ tsp salt\n¼ tsp cumin, ground\n¼ tsp oregano, dried\n¼ tsp paprika\n⅛ tsp crushed red pepper"
    },
    {
      "id": 503231,
      "primary_message": "Quarter the jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the bowl with the strawberries. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 503232,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the strawberries.",
      "secondary_message": null
    },
    {
      "id": 503233,
      "primary_message": "Juice half the lime into the bowl with the strawberries; cut the other half into wedges. ",
      "secondary_message": null
    },
    {
      "id": 503234,
      "primary_message": "Peel and mince the shallot; add to the bowl. Stir to combine the salsa.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 503235,
      "primary_message": "To serve, divide quinoa between bowls, top with bean mixture, salsa, and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
