  "instructions": [
    {
      "id": 73953,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 pints grape tomatoes\n3 limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 73952,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and mince the leaves. Transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 73951,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the cilantro.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 73950,
      "primary_message": "Juice 1 ½ of the limes and add to the bowl with the cilantro and garlic; cut the other 1 ½ lime into wedges and transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 73949,
      "primary_message": "To the bowl with the cilantro, garlic, and lime juice, add olive oil, crushed red pepper, salt, and pepper; whisk the mixture together (or blend with a hand blender for a smoother consistency).",
      "secondary_message": "3 tbsp extra virgin olive oil\n⅜ tsp crushed red pepper\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 73948,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 73947,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 73946,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 73945,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 73944,
      "primary_message": "While the steak cooks, quarter the grape tomatoes and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 73943,
      "primary_message": "Wrap the tortillas in a damp paper towel and microwave until heated through, 15 to 30 seconds.",
      "secondary_message": "24 small corn tortillas"
    },
    {
      "id": 73942,
      "primary_message": "Thinly slice the steak against the grain into strips.",
      "secondary_message": ""
    },
    {
      "id": 73941,
      "primary_message": "To serve, divide the steak slices between the tortillas, top with the tomatoes, drizzle with the chimichurri sauce, and garnish with the remaining lime wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
