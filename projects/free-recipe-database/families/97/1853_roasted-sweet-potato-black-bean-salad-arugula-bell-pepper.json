  "instructions": [
    {
      "id": 16943,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": ""
    },
    {
      "id": 16944,
      "primary_message": "Wash, peel, and medium dice potatoes. Transfer to a baking sheet pan. Drizzle with olive oil and season with salt and pepper; toss to coat.",
      "secondary_message": "0.227 kg sweet potatoes\n1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 16945,
      "primary_message": "Place in the oven and roast until tender, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 16946,
      "primary_message": "Drain and rinse beans. Place on paper towels and pat dry.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 16947,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lime juice, olive oil, vinegar, Dijon, honey, cumin, salt, and pepper.",
      "secondary_message": "1 clove garlic\r\njuice of ½ lime\r\n3 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n½ tsp Dijon mustard\r\n½ tsp honey\r\n¼ tsp cumin\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 16948,
      "primary_message": "Wash and dry arugula.",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 16949,
      "primary_message": "Wash, seed, and medium dice bell pepper.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 16950,
      "primary_message": "To serve, arrange a bed of arugula on a plate, top with potatoes, beans, and bell pepper. Drizzle with dressing and enjoy!",
      "secondary_message": ""
    }
  ],
