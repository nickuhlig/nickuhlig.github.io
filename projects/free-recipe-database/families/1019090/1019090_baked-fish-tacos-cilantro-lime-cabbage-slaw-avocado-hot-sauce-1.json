  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F and place rack in the center position. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the oven is heated, transfer fish sticks to the baking sheet and spread out in a single layer. Place in the oven and bake until starting to brown, about 7 minutes.",
      "secondary_message": "1 (24 oz) bag frozen breaded fish sticks"
    },
    {
      "primary_message": "Remove baking sheet from oven and turn the fish sticks. Return to the oven and continue baking until golden, crispy, and cooked through, 7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place shredded cabbage and dressing in a medium bowl. Toss to combine the slaw and set aside.",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n⅔ cup creamy cilantro lime dressing"
    },
    {
      "primary_message": "\nAbout 5 minutes before the fish sticks are done, place tortillas, stacked one on top of another, in the center of a large square of aluminum foil. Pull the edges of the foil up around the tortillas to close. Add tortillas to the oven and bake until warmed through, 3-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and quarter lime.",
      "secondary_message": "1 lime"
    },
    {
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": "1 avocado"
    },
    {
      "primary_message": "\nDivide warm tortillas between plates. Fill each tortilla with slaw, 3-4 fish sticks, and avocado. Drizzle with hot sauce and serve with lime for squeezing. Enjoy!",
      "secondary_message": "¼ cup hot sauce"
    }
  ],
