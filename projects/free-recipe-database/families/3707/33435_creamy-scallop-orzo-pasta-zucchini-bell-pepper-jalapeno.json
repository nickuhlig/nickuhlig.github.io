  "instructions": [
    {
      "id": 527953,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ½-cup pasta water before draining.)",
      "secondary_message": "1 ½ tsp salt\n425 g orzo pasta"
    },
    {
      "id": 527954,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n3 jalapeño peppers"
    },
    {
      "id": 527955,
      "primary_message": "Trim and small dice zucchini. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 527956,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 527957,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 527958,
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic Add both to the bowl with the other veggies.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 527959,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 527960,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 ½ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 527961,
      "primary_message": "Meanwhile, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg sea scallops\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 527962,
      "primary_message": "When the veggies are done, add scallops and cream to the pot, then gently stir to combine. Cook, stirring occasionally, until scallops are opaque, 5-6 minutes.",
      "secondary_message": "355 ml heavy whipping cream"
    },
    {
      "id": 527963,
      "primary_message": "Add cooked orzo to the pot and stir to combine. Add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Continue to cook until orzo is warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 527964,
      "primary_message": "To serve, divide the creamy scallop and pasta sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
