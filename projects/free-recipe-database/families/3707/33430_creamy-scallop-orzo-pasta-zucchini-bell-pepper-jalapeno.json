  "instructions": [
    {
      "id": 527893,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ¼-cup pasta water before draining.)",
      "secondary_message": "½ tsp salt\n5 oz orzo pasta"
    },
    {
      "id": 527894,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n1 red bell pepper\n1 jalapeño pepper"
    },
    {
      "id": 527895,
      "primary_message": "Trim and small dice zucchini. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 527896,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 527897,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 527898,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 527899,
      "primary_message": "While the skillet heats up, peel and mince shallot and garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 527900,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n½ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 527901,
      "primary_message": "Meanwhile, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb sea scallops\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 527902,
      "primary_message": "When the veggies are done, add scallops and cream to the skillet, then gently stir to combine. Cook, stirring occasionally, until scallops are opaque, about 5 minutes.",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 527903,
      "primary_message": "Add cooked orzo to the skillet and stir to combine. Add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Continue to cook until orzo is warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 527904,
      "primary_message": "To serve, divide the creamy scallop and pasta sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
