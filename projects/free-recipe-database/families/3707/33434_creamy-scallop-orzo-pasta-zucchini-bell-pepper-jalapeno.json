  "instructions": [
    {
      "id": 527941,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ½-cup pasta water before draining.)",
      "secondary_message": "1 tsp salt\n283 g orzo pasta"
    },
    {
      "id": 527942,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 red bell peppers\n2 jalapeño peppers"
    },
    {
      "id": 527943,
      "primary_message": "Trim and small dice zucchini. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 527944,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 527945,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 527946,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 527947,
      "primary_message": "While the skillet heats up, peel and mince shallots and garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 527948,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n1 tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 527949,
      "primary_message": "Meanwhile, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg sea scallops\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 527950,
      "primary_message": "When the veggies are done, add scallops and cream to the skillet, then gently stir to combine. Cook, stirring occasionally, until scallops are opaque, about 5 minutes.",
      "secondary_message": "237 ml heavy whipping cream"
    },
    {
      "id": 527951,
      "primary_message": "Add cooked orzo to the skillet and stir to combine. Add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Continue to cook until orzo is warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 527952,
      "primary_message": "To serve, divide the creamy scallop and pasta sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
