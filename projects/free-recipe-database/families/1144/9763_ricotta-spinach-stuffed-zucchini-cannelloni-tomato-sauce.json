  "instructions": [
    {
      "id": 155973,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 155974,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 155975,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n3 (142 g) pkg baby spinach\n6 medium zucchini squash"
    },
    {
      "id": 155976,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 155977,
      "primary_message": "Coarsely grate mozzarella. Finely grate Parmesan. ",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese\n170 g Parmesan cheese"
    },
    {
      "id": 155978,
      "primary_message": "When the water in the pot comes to a boil, remove lid, add the spinach and stir for a few seconds. Cook the spinach, uncovered, until wilted, 30-60 seconds. Once done, drain the spinach in a colander and rinse under cold water.",
      "secondary_message": null
    },
    {
      "id": 155979,
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can, then transfer to a cutting board. Roughly chop spinach and transfer a large bowl.",
      "secondary_message": null
    },
    {
      "id": 155980,
      "primary_message": "Add basil, ricotta, eggs, salt, pepper, Parmesan, and half of the mozzarella to the bowl with the spinach. Stir until well combined. ",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese\n3 eggs\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 155981,
      "primary_message": "Peel and mince or press garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 155982,
      "primary_message": "Divide tomato sauce between two baking dishes. Add garlic, tomato paste, and Italian seasoning (dividing evenly between baking dishes) and stir until combined.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n3 tbsp tomato paste\n1 tbsp Italian seasoning"
    },
    {
      "id": 155983,
      "primary_message": "Trim ends from zucchini; use a knife or vegetable peeler to slice zucchini lengthwise into very thin slices. ",
      "secondary_message": null
    },
    {
      "id": 155984,
      "primary_message": "Place a heaping tablespoon of the ricotta mixture at one end of each zucchini slice. Roll up the slices and place in the baking dishes with the tomato sauce, leaving at least a ½-inch space between rolls. ",
      "secondary_message": null
    },
    {
      "id": 155985,
      "primary_message": "Sprinkle remaining mozzarella over top of the cannelloni. ",
      "secondary_message": null
    },
    {
      "id": 155986,
      "primary_message": "Place in the oven and bake until cooked through, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 155987,
      "primary_message": "To serve, divide cannelloni and sauce between plates and enjoy!",
      "secondary_message": null
    }
  ],
