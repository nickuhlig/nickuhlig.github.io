  "instructions": [
    {
      "id": 155943,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 155944,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 155945,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small pkg fresh basil\n1 (142 g) pkg baby spinach\n2 medium zucchini squash"
    },
    {
      "id": 155946,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 155947,
      "primary_message": "Coarsely grate mozzarella. Finely grate Parmesan. ",
      "secondary_message": "½ (227 g) block mozzarella cheese\n57 g Parmesan cheese"
    },
    {
      "id": 155948,
      "primary_message": "When the water in the pot comes to a boil, remove lid, add the spinach and stir for a few seconds. Cook the spinach, uncovered, until wilted, 30-60 seconds. Once done, drain the spinach in a colander and rinse under cold water.",
      "secondary_message": null
    },
    {
      "id": 155949,
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can, then transfer to a cutting board. Roughly chop spinach and transfer a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 155950,
      "primary_message": "Add basil, ricotta, egg, salt, pepper, Parmesan, and half of the mozzarella to the bowl with the spinach. Stir until well combined. ",
      "secondary_message": "½ (425 g) pkg ricotta cheese\n1 egg\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 155951,
      "primary_message": "Peel and mince or press garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 155952,
      "primary_message": "Pour tomato sauce into a baking dish. Add garlic, tomato paste, and Italian seasoning; stir until combined. ",
      "secondary_message": "1 (213 ml) can tomato sauce\n1 tbsp tomato paste\n1 tsp Italian seasoning"
    },
    {
      "id": 155953,
      "primary_message": "Trim ends from zucchini; use a knife or vegetable peeler to slice zucchini lengthwise into very thin slices. ",
      "secondary_message": null
    },
    {
      "id": 155954,
      "primary_message": "Place a heaping tablespoon of the ricotta mixture at one end of each zucchini slice. Roll up the slices and place in the baking dish with the tomato sauce, leaving at least a ½-inch space between rolls. ",
      "secondary_message": null
    },
    {
      "id": 155955,
      "primary_message": "Sprinkle remaining mozzarella over top of the cannelloni. ",
      "secondary_message": null
    },
    {
      "id": 155956,
      "primary_message": "Place in the oven and bake until cooked through, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 155957,
      "primary_message": "To serve, divide cannelloni and sauce between plates and enjoy!",
      "secondary_message": null
    }
  ],
