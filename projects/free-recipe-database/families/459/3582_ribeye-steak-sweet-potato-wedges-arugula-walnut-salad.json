  "instructions": [
    {
      "id": 38361,
      "primary_message": "Preheat the oven to 500°F (260°C) and place the rack in the center position. Place a baking sheet in the oven to warm up.",
      "secondary_message": ""
    },
    {
      "id": 38362,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 (142 g) pkg baby arugula\n0.454 kg sweet potatoes"
    },
    {
      "id": 38363,
      "primary_message": "Cut the sweet potatoes into 1 ¼-cm-thick wedges (about 8 to 10 wedges per potato). Remove the baking sheet from the oven and transfer the potatoes to it.",
      "secondary_message": null
    },
    {
      "id": 38364,
      "primary_message": "Drizzle the potatoes with olive oil and season with salt and pepper; toss to coat, then spread out in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 38365,
      "primary_message": "Place the potatoes in the oven and bake for 10 minutes, then flip them over and continue to bake until they are tender, another 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 38366,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 38367,
      "primary_message": "While the skillet heats up, pat dry the steak with paper towels and place on a plate. Season the steak generously with salt and pepper on both sides.",
      "secondary_message": "0.68 kg ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 38368,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 38369,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 38370,
      "primary_message": "Once the steak is done, in a salad bowl, combine and whisk together olive oil, balsamic vinegar, and Dijon.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n½ tsp Dijon mustard"
    },
    {
      "id": 38371,
      "primary_message": "Roughly chop the walnuts and add to the salad bowl.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 38372,
      "primary_message": "Add the arugula to the salad bowl and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 38373,
      "primary_message": "To serve, arrange the steak, sweet potato wedges, and the arugula-walnut salad on a plate. Enjoy!",
      "secondary_message": null
    }
  ],
