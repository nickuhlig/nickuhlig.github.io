  "instructions": [
    {
      "id": 372684,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 372685,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Transfer to a baking sheet pan.",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 372686,
      "primary_message": "Wash and dry tomatoes. Add to the baking sheet with the peppers.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 372687,
      "primary_message": "Peel, halve, and thinly slice onion lengthwise. Add to the baking sheet, drizzle with vinaigrette, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n1 ½ tbsp balsamic vinaigrette\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 372688,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are tender and tomatoes start to burst, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 372689,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 372690,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 372691,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 372692,
      "primary_message": "When the veggies are done, remove from oven. Sprinkle with feta and toss to combine.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 372693,
      "primary_message": "To serve, divide chops and veggies between plates. Spoon tzatziki over the chops and enjoy!",
      "secondary_message": "½ cup tzatziki sauce"
    }
  ],
