  "instructions": [
    {
      "id": 372734,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 372735,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Divide between two large baking sheet pans.",
      "secondary_message": "6 green bell peppers"
    },
    {
      "id": 372736,
      "primary_message": "Wash and dry tomatoes. Add to the baking sheets with the peppers.",
      "secondary_message": "3 small pkgs grape tomatoes"
    },
    {
      "id": 372737,
      "primary_message": "Peel, halve, and thinly slice onions lengthwise. Add to the baking sheets, drizzle with vinaigrette, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 medium red onions\n¼ cup balsamic vinaigrette\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 372738,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are tender and tomatoes start to burst, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 372739,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 372740,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, bone-in\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 372741,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 372742,
      "primary_message": "When the veggies are done, remove from oven. Sprinkle with feta and toss to combine.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 372743,
      "primary_message": "To serve, divide chops and veggies between plates. Spoon tzatziki over the chops and enjoy!",
      "secondary_message": "1 ½ cups tzatziki sauce"
    }
  ],
