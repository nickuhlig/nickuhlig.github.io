  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Cabbage and Filling: Adjust oven rack to lower-middle position and preheat oven to 180°C (350°F). Place cabbage in a large heatproof bowl. Cover with boiling water and let stand 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, brown bratwurst in a large skillet over medium-high heat, breaking meat into little bits, about 10 minutes total. Drain, add rice, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Rolls and Sauce: Brown bacon in a large saucepan, stirring, over medium-high heat until crisp and rendered, about 5 minutes. Add onion and bell pepper and continue cooking, stirring often, until vegetables start to soften, about 4 minutes. Reduce heat to medium, add garlic and cook for 2 minutes longer. Add beer, bring to a boil, then lower heat and simmer for 5 minutes. Add tomatoes, paprika, and caraway. Season with salt and pepper. Return to a boil, reduce heat to low, and simmer until slightly thickened, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Drain cabbage, and remove large outer leaves, being careful not to tear them. Cut out and discard the tough rib from each leaf. Pat leaves dry with paper towels. Fill each leaf with about 1/3 cup of bratwurst filling. Roll up as you would a burrito, tucking the sides in first. Continue making rolls until all filling is used up.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spray a 9- by 33-cm baking dish with cooking spray and arrange rolls tightly in the dish. Pour sauce on top. Cover with foil and transfer to the oven to bake until bubbly, 35 to 40 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Remove from oven, let stand for 10 minutes, then serve, spooning sauce on top of cabbage rolls.",
      "secondary_message": null
    }
  ],
