  "instructions": [
    {
      "id": 50884,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) water"
    },
    {
      "id": 50885,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 50886,
      "primary_message": "Wash carrots and green onions. Peel and small dice carrots. Trim and discard root ends and chop onions. Transfer both to a plate. Measure out peas.",
      "secondary_message": "4 carrots\r\n1 small bunch green onions\r\n2 cups frozen peas"
    },
    {
      "id": 50887,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 50888,
      "primary_message": "Drain and medium dice tofu. Transfer to paper towels and pat dry.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 50889,
      "primary_message": "Coat bottom of skillet with oil. Add tofu and season with salt. Stirring occasionally, cook until lightly browned, 3-4 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\r\n¼ tsp salt"
    },
    {
      "id": 50890,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\r\n2 cloves garlic"
    },
    {
      "id": 50891,
      "primary_message": "Transfer tofu to a plate and return skillet to stove. Add more oil to skillet, followed by garlic, yellow onion, ½ of the green onions (save the rest for garnishing), carrots, and peas. Stirring often, cook until carrots are tender, 3-4 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 50894,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 50895,
      "primary_message": "Add rice, tofu, and soy sauce to vegetables. Stir until well combined and heated through, 1-2 minutes.",
      "secondary_message": "4 tbsp soy sauce"
    },
    {
      "id": 50896,
      "primary_message": "To serve, place fried rice in a bowl and garnish with remaining green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
