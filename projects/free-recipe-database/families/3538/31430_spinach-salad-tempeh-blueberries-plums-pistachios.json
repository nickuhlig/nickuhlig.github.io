  "instructions": [
    {
      "id": 496589,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 limes\n4 plums\n2 (5 oz) pkgs baby spinach\n1 (6 oz) pkg blueberries"
    },
    {
      "id": 496590,
      "primary_message": "Zest limes into a medium bowl. Juice one lime into the bowl with the lime zest, then add soy sauce, oil, and spices. Whisk to combine the marinade. (Reserve remaining lime for later use.)",
      "secondary_message": "4 tsp soy sauce\n2 tsp extra virgin olive oil\n1 tsp coriander, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 496591,
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces and add to the bowl with the marinade. Gently stir to coat and set aside.",
      "secondary_message": "2 (8 oz) packages tempeh"
    },
    {
      "id": 496592,
      "primary_message": "While the tempeh is marinating, juice remaining lime into a large bowl. Add oil, maple syrup, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp pure maple syrup\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 496593,
      "primary_message": "Peel, halve, and slice shallots lengthwise into thin strips. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 496594,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 496595,
      "primary_message": "Roughly chop pistachios. Add to the bowl and set aside.",
      "secondary_message": "⅔ cup pistachios, unsalted"
    },
    {
      "id": 496596,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496597,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh in a single layer (leaving any excess marinade in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 496598,
      "primary_message": "Meanwhile, add spinach and blueberries to the bowl with the dressing. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 496599,
      "primary_message": "To serve, divide salad between plates or bowls and top with tempeh. Enjoy!",
      "secondary_message": null
    }
  ],
