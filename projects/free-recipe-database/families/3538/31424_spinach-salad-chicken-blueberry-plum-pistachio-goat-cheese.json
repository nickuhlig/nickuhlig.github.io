  "instructions": [
    {
      "id": 496521,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 limes\n4 plums\n2 (5 oz) pkgs baby spinach\n1 (6 oz) pkg blueberries"
    },
    {
      "id": 496522,
      "primary_message": "Zest limes into a medium bowl. Juice one lime into the bowl with the lime zest, then add oil and spices. Whisk to combine the marinade. (Reserve remaining lime for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp coriander, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 496523,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Add to the bowl with the marinade and turn to coat. Set aside.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 496524,
      "primary_message": "While the chicken is marinating, juice remaining lime into a large bowl. Add oil, honey, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 496525,
      "primary_message": "Using a clean cutting board, peel, halve, and slice shallots lengthwise into thin strips. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 496526,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 496527,
      "primary_message": "Roughly chop pistachios. Add to the bowl and set aside.",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 496528,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496529,
      "primary_message": "Once the pan is hot, add chicken (leaving any excess marinade in the bowl) and grill, flipping once, until cooked through and golden, 8-10 minutes. Remove to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 496530,
      "primary_message": "When the chicken is almost done, crumble goat cheese into the bowl with the dressing, then add spinach and blueberries. Toss to combine the salad.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 496531,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 496532,
      "primary_message": "To serve, divide salad between plates or bowls and top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
