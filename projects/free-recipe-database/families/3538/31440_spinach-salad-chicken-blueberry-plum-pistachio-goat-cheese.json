  "instructions": [
    {
      "id": 496701,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 limes\n6 plums\n3 (142 g) pkgs baby spinach\n1 ½ (170 g) pkgs blueberries"
    },
    {
      "id": 496702,
      "primary_message": "Zest limes into a large bowl. Juice half of the limes into the bowl with the lime zest, then add oil and spices. Whisk to combine the marinade. (Reserve remaining limes for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 496703,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Add to the bowl with the marinade and turn to coat. Set aside.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 496704,
      "primary_message": "While the chicken is marinating, juice remaining limes into another large bowl. Add oil, honey, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp honey\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 496705,
      "primary_message": "Using a clean cutting board, peel, halve, and slice onion lengthwise into thin strips. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 496706,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 496707,
      "primary_message": "Roughly chop pistachios. Add to the bowl and set aside.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 496708,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496709,
      "primary_message": "Once the pan is hot, working in batches if necessary, add chicken (leaving any excess marinade in the bowl) and grill, flipping once, until cooked through and golden, 8-10 minutes. Remove to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 496710,
      "primary_message": "When the chicken is almost done, crumble goat cheese into the bowl with the dressing, then add spinach and blueberries. Toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 496711,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 496712,
      "primary_message": "To serve, divide salad between plates or bowls and top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
