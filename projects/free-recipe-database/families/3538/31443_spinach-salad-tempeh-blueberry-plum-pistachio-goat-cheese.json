  "instructions": [
    {
      "id": 496735,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 limes\n6 plums\n3 (142 g) pkgs baby spinach\n1 ½ (170 g) pkgs blueberries"
    },
    {
      "id": 496736,
      "primary_message": "Zest limes into a large bowl. Juice half of the limes into the bowl with the lime zest, then add soy sauce, oil, and spices. Whisk to combine the marinade. (Reserve remaining limes for later use.)",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp extra virgin olive oil\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 496737,
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces and add to the bowl with the marinade. Gently stir to coat and set aside.",
      "secondary_message": "3 (227g ) pkgs tempeh"
    },
    {
      "id": 496738,
      "primary_message": "While the tempeh is marinating, juice remaining limes into another large bowl. Add oil, honey, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp honey\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 496739,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin strips. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 496740,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 496741,
      "primary_message": "Roughly chop pistachios. Add to the bowl and set aside.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 496742,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496743,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh in a single layer (leaving any excess marinade in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 496744,
      "primary_message": "Meanwhile, crumble goat cheese into the bowl with the dressing, then add spinach and blueberries. Toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 496745,
      "primary_message": "To serve, divide salad between plates or bowls and top with tempeh. Enjoy!",
      "secondary_message": null
    }
  ],
