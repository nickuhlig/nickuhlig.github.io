  "instructions": [
    {
      "id": 23333,
      "primary_message": "Peel and small dice onion; transfer to a medium bowl. Peel and mince garlic; add to bowl.",
      "secondary_message": "1 medium yellow onion\r\n6 cloves garlic"
    },
    {
      "id": 23334,
      "primary_message": "Wash bell peppers, celery, and jalapeños. Seed and small dice bell peppers. Trim ends and small dice celery. Seed and mince jalapeños.",
      "secondary_message": "2 red bell peppers\r\n2 sticks celery\r\n2 jalapeño peppers"
    },
    {
      "id": 23335,
      "primary_message": "Heat a medium saucepan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 23336,
      "primary_message": "Add oil to saucepan and swirl to coat bottom. Add onion, garlic, bell pepper, celery, and jalapeño. Cook, stirring frequently, until vegetables have softened, 3-4 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 23337,
      "primary_message": "Add ground turkey to the vegetables and cook, breaking apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "0.68 kg ground turkey\n"
    },
    {
      "id": 23338,
      "primary_message": "Add chili powder, cumin, salt, and pepper; stir to combine.",
      "secondary_message": "2 tbsp chili powder\r\n1 tbsp cumin\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23339,
      "primary_message": "Add tomatoes and stir to combine. Cook, stirring occasionally, until chili is slightly reduced in volume, 8-10 minutes.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\r\n"
    },
    {
      "id": 23340,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and chop the leaves. Stir about ½ into the chili and save the rest for garnishing.",
      "secondary_message": "1 small bunch cilantro\r\n"
    },
    {
      "id": 23341,
      "primary_message": "Halve and pit avocados. Scoop out the flesh and medium dice.",
      "secondary_message": "2 avocados\r\n"
    },
    {
      "id": 23342,
      "primary_message": "Grate 1 cup of cheddar.",
      "secondary_message": "½ (227 g) block cheddar cheese\r\n"
    },
    {
      "id": 23343,
      "primary_message": "Cut lime into wedges.",
      "secondary_message": "1 lime\r\n"
    },
    {
      "id": 23344,
      "primary_message": "Serve chili in a bowl and garnish with avocado, cheddar, cilantro, and lime. Enjoy!",
      "secondary_message": ""
    }
  ],
