  "instructions": [
    {
      "id": 215172,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch cilantro\n3 tomatoes\n1 ½ English cucumbers\n1 ½ avocados\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 215173,
      "primary_message": "Zest lemons into a large bowl, then set lemons aside for later use.",
      "secondary_message": null
    },
    {
      "id": 215174,
      "primary_message": "Peel and mince garlic and shallots; transfer both to the bowl with the lemon zest.",
      "secondary_message": "3 cloves garlic\n2 shallots"
    },
    {
      "id": 215175,
      "primary_message": "Drain and rinse chickpeas. Add half the chickpeas to the bowl, along with mayo, tahini, and spices. Using a fork or potato masher, mash until smooth.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n¼ cup mayonnaise\n¼ cup tahini\n1 ½ tsp cumin\n1 ½ tsp coriander\n1 ½ tsp salt"
    },
    {
      "id": 215176,
      "primary_message": "Add remaining whole chickpeas to the bowl.",
      "secondary_message": null
    },
    {
      "id": 215177,
      "primary_message": "Shave parsley and cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 215178,
      "primary_message": "Drain and mince artichokes. Add to the bowl and stir to combine the chickpea salad. Set aside.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 215179,
      "primary_message": "Thinly slice tomatoes. Trim and thinly slice cucumbers. Transfer both to a large plate.",
      "secondary_message": null
    },
    {
      "id": 215180,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out with a spoon; add to the plate. Season veggies with salt and pepper; set aside.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 215181,
      "primary_message": "Juice lemons into another large bowl.",
      "secondary_message": null
    },
    {
      "id": 215182,
      "primary_message": "Peel and mince additional garlic; add to the bowl along with oil, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n1 ½ tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 215183,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 215184,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread chickpea salad inside each pita; layer with tomato, cucumber, and avocado.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 215185,
      "primary_message": "To serve, divide pitas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
