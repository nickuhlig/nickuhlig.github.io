  "instructions": [
    {
      "id": 215186,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ small bunch cilantro\n1 tomato\n½ English cucumber\n½ avocado\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 215187,
      "primary_message": "Zest lemon into a medium bowl, then set lemon aside for later use.",
      "secondary_message": null
    },
    {
      "id": 215188,
      "primary_message": "Peel and mince garlic and shallot; transfer both to the bowl with the lemon zest.",
      "secondary_message": "1 clove garlic\n½ shallot"
    },
    {
      "id": 215189,
      "primary_message": "Drain and rinse chickpeas. Add half the chickpeas to the bowl, along with mayo, tahini, and spices. Using a fork or potato masher, mash until smooth.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n1 ½ tbsp vegan mayonnaise\n1 ½ tbsp tahini\n½ tsp cumin\n½ tsp coriander\n½ tsp salt"
    },
    {
      "id": 215190,
      "primary_message": "Add remaining whole chickpeas to the bowl.",
      "secondary_message": null
    },
    {
      "id": 215191,
      "primary_message": "Shave parsley and cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 215192,
      "primary_message": "Drain and mince artichokes. Add to the bowl and stir to combine the chickpea salad. Set aside.",
      "secondary_message": "½ (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 215193,
      "primary_message": "Thinly slice tomato. Trim and thinly slice cucumber. Transfer both to a plate.",
      "secondary_message": null
    },
    {
      "id": 215194,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon; add to the plate. Season veggies with salt and pepper; set aside.",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 215195,
      "primary_message": "Juice lemon into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 215196,
      "primary_message": "Peel and mince additional garlic; add to the bowl along with oil, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 ½ tsp extra virgin olive oil\n½ tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 215197,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 215198,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread chickpea salad inside each pita; layer with tomato, cucumber, and avocado.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 215199,
      "primary_message": "To serve, divide pitas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
