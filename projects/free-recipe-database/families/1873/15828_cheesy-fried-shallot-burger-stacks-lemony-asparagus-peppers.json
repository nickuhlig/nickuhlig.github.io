  "instructions": [
    {
      "id": 264238,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 264239,
      "primary_message": "Peel, halve, and slice shallots into very thin half-moons. Place in a small bowl and sprinkle with salt; using your hands, massage the shallot until it starts to soften. Set aside.",
      "secondary_message": "2 shallots\n¼ tsp salt"
    },
    {
      "id": 264240,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n2 yellow bell peppers\n1 lemon\n2 tomatoes"
    },
    {
      "id": 264241,
      "primary_message": "Snap or cut off the woody ends of the asparagus; trim, seed, and slice bell peppers into thin strips. Transfer both to a large baking sheet pan, spreading them out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 264242,
      "primary_message": "Peel and mince garlic. Sprinkle garlic over the veggies and drizzle with oil. Squeeze lemon over top, then season with salt and pepper.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264243,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until crisp-tender, 12-15 minutes. Remove from the oven. ",
      "secondary_message": null
    },
    {
      "id": 264244,
      "primary_message": "While the veggies are roasting, grate cheese into a medium bowl.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 264245,
      "primary_message": "Add beef and spices to the bowl with the cheese; mix with your hands until well combined. Form the beef mixture into 8 equal-sized patties and place on a plate.",
      "secondary_message": "0.68 kg lean ground beef\n1 tsp thyme, dried\n1 tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264246,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 264247,
      "primary_message": "While the skillet heats up, use paper towels or a clean cloth to squeeze excess moisture out of the shallots. Divide shallots into 8 portions, then press into the top of each burger patty.",
      "secondary_message": null
    },
    {
      "id": 264248,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add patties, shallot-side down, and cook, undisturbed, until shallots are golden, about 4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 264249,
      "primary_message": "Using a metal spatula, carefully slide underneath the shallots and flip the patties (place any loose shallots back on top of the burgers); cook an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 264250,
      "primary_message": "Meanwhile, slice each tomato crosswise into 4 rounds.",
      "secondary_message": null
    },
    {
      "id": 264251,
      "primary_message": "Divide roasted veggies and tomato slices between plates; top each tomato slice with a burger patty. Enjoy!",
      "secondary_message": null
    }
  ],
