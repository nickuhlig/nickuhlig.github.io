  "instructions": [
    {
      "id": 264195,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 264196,
      "primary_message": "Peel, halve, and slice shallots into very thin half-moons. Place in a small bowl and sprinkle with salt; using your hands, massage the shallot until it starts to soften. Set aside.",
      "secondary_message": "2 shallots\n¼ tsp salt"
    },
    {
      "id": 264197,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n2 yellow bell peppers\n1 lemon\n2 tomatoes"
    },
    {
      "id": 264198,
      "primary_message": "Snap or cut off the woody ends of the asparagus; trim, seed, and slice bell peppers into thin strips. Transfer both to a large baking sheet pan, spreading them out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 264199,
      "primary_message": "Peel and mince garlic. Sprinkle garlic over the veggies and drizzle with oil. Squeeze lemon over top, then season with salt and pepper.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264200,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until crisp-tender, 12-15 minutes. Remove from the oven. ",
      "secondary_message": null
    },
    {
      "id": 264201,
      "primary_message": "While the veggies are roasting, grate cheese into a medium bowl.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 264202,
      "primary_message": "Add beef and spices to the bowl with the cheese; mix with your hands until well combined. Form the beef mixture into 4 equal-sized patties and place on a plate.",
      "secondary_message": "0.68 kg lean ground beef\n1 tsp thyme, dried\n1 tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264203,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 264204,
      "primary_message": "While the skillet heats up, use paper towels or a clean cloth to squeeze excess moisture out of the shallots. Divide shallots into 4 portions, then press into the top of each burger patty.",
      "secondary_message": null
    },
    {
      "id": 264205,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties, shallot-side down, and cook, undisturbed, until shallots are golden, about 4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 264206,
      "primary_message": "Using a metal spatula, carefully slide underneath the shallots and flip the patties (place any loose shallots back on top of the burgers); cook an additional 4-5 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 264207,
      "primary_message": "Meanwhile, toast the buns if desired. Slice tomatoes into rounds.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 264208,
      "primary_message": "Place bottom half of each bun on a plate, then top with sliced tomato and burgers. Close with the top half of the bun and serve with roasted veggies on the side. Enjoy!",
      "secondary_message": null
    }
  ],
