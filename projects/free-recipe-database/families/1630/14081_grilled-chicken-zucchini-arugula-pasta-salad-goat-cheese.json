  "instructions": [
    {
      "id": 234093,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g rotini pasta"
    },
    {
      "id": 234094,
      "primary_message": "Meanwhile, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 234095,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 234096,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add the chicken and grill until cooked through, 3-4 minutes per side; remove from heat and transfer chicken to a plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 234097,
      "primary_message": "While the chicken cooks, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 medium zucchini squash\n2 limes\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 234098,
      "primary_message": "Using a clean cutting board, trim and slice zucchini into ½-inch thick planks. Place on a plate, drizzle with oil, and season with salt and pepper on both sides.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 234099,
      "primary_message": "Return the grill pan to medium-high heat; add zucchini and cook, turning occasionally, until charred and fork-tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 234100,
      "primary_message": "Meanwhile, peel and mince shallot; transfer to a large bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 234101,
      "primary_message": "Juice limes into the bowl with the shallot; add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 234102,
      "primary_message": "When the pasta is done, drain in a colander and rinse under cold water to cool. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 234103,
      "primary_message": "When the zucchini is done, remove from the grill pan and cut into bite-sized pieces. Add to the bowl with the pasta, along with the arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 234104,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 234105,
      "primary_message": "To serve, divide salad and sliced chicken between plates. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 (113 g) log goat cheese"
    }
  ],
