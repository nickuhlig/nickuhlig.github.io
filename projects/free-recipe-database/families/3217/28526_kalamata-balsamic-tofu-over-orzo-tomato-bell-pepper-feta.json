  "instructions": [
    {
      "id": 456164,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 456165,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain in a colander.",
      "secondary_message": "1 tsp salt\n283 g orzo pasta"
    },
    {
      "id": 456166,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 yellow bell peppers\n2 small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 456167,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456168,
      "primary_message": "While the skillet heats up, cut the tofu planks in half, then cut each half into 2 triangles. Season with salt and pepper.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 456169,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the tofu and cook, flipping once, until browned and warmed through, about 6 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 456170,
      "primary_message": "While the tofu is cooking, trim, seed, and slice bell peppers lengthwise into thin strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 456171,
      "primary_message": "Roughly chop olives. Add to the bowl with the bell pepper.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 456172,
      "primary_message": "Return skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add bell pepper, olives, tomatoes, and spices to the skillet. Cook, stirring occasionally, until the veggies soften, 3-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 tsp oregano, dried\n½ tsp garlic powder\n½ tsp crushed red pepper"
    },
    {
      "id": 456173,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 456174,
      "primary_message": "When the veggies are soft, add half of the basil and vinegar to the skillet. Stir to combine and remove from heat. (Reserve remaining basil for serving.)",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 456175,
      "primary_message": "To serve, divide orzo and tofu between plates or bowls. Top with veggies, feta, and reserved basil. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
