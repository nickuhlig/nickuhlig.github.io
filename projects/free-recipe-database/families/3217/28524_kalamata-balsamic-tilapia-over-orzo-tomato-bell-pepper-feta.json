  "instructions": [
    {
      "id": 456141,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain in a colander.",
      "secondary_message": "1 ½ tsp salt\n425 g orzo pasta"
    },
    {
      "id": 456142,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n3 small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 456143,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456144,
      "primary_message": "While the skillet heats up, pat the tilapia dry with paper towels. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg tilapia fillet\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 456145,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add the tilapia and cook, flipping once, until fish is crispy and easily flakes with a fork, about 6 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 456146,
      "primary_message": "While the fish is cooking, trim, seed, and slice bell peppers lengthwise into thin strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 456147,
      "primary_message": "Roughly chop olives. Add to the bowl with the bell pepper.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 456148,
      "primary_message": "Return skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add bell pepper, olives, tomatoes, and spices to the skillet. Cook, stirring occasionally, until the veggies soften, 4-5 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n1 ½ tsp oregano, dried\n¾ tsp garlic powder\n¾ tsp crushed red pepper"
    },
    {
      "id": 456149,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 456150,
      "primary_message": "When the veggies are soft, add half of the basil and vinegar to the skillet. Stir to combine and remove from heat. (Reserve remaining basil for serving.)",
      "secondary_message": "3 tbsp balsamic vinegar"
    },
    {
      "id": 456151,
      "primary_message": "To serve, divide orzo and tilapia between plates or bowls. Top with veggies, feta, and reserved basil. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    }
  ],
