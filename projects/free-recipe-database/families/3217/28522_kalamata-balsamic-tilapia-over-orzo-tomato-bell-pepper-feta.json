  "instructions": [
    {
      "id": 456119,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain in a colander.",
      "secondary_message": "½ tsp salt\n142 g orzo pasta"
    },
    {
      "id": 456120,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n1 small pkg grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 456121,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456122,
      "primary_message": "While the skillet heats up, pat the tilapia dry with paper towels. Season both sides with salt and pepper.",
      "secondary_message": "⅓ kg tilapia fillet\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 456123,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the tilapia and cook, flipping once, until fish is crispy and easily flakes with a fork, about 6 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 456124,
      "primary_message": "While the fish is cooking, trim, seed, and slice bell pepper lengthwise into thin strips. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 456125,
      "primary_message": "Roughly chop olives. Add to the bowl with the bell pepper.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 456126,
      "primary_message": "Return skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add bell pepper, olives, tomatoes, and spices to the skillet. Cook, stirring occasionally, until the veggies soften, 3-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp oregano, dried\n¼ tsp garlic powder\n¼ tsp crushed red pepper"
    },
    {
      "id": 456127,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 456128,
      "primary_message": "When the veggies are soft, add half of the basil and vinegar to the skillet. Stir to combine and remove from heat. (Reserve remaining basil for serving.)",
      "secondary_message": "1 tbsp balsamic vinegar"
    },
    {
      "id": 456129,
      "primary_message": "To serve, divide orzo and tilapia between plates or bowls. Top with veggies, feta, and reserved basil. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
