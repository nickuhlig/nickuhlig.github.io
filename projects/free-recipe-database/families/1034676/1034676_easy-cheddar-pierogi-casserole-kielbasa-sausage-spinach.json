  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Coat a large baking dish with a thin layer of oil.\n\n",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Roughly chop and place in a large bowl.\n\n",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the spinach.\n\n",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "primary_message": "Slice sausage crosswise into thin rounds. Add to the bowl, along with shredded cheddar, cottage cheese, soup, salt, and pepper, then stir to combine. \n\n",
      "secondary_message": "1 (14 oz) pkg kielbasa sausage\n3 cups cheddar cheese, shredded\n1 (16 oz) tub cottage cheese\n1 (10.5 oz) can cheddar cheese soup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Arrange half of the pierogies in an even layer in the baking dish, then scoop half of the cheese mixture over top. Repeat with remaining pierogies and cheese mixture. Tightly cover the dish with aluminum foil.\n\n",
      "secondary_message": "2 (16 oz) pkg pierogies, frozen"
    },
    {
      "primary_message": "Place casserole in the preheated oven and bake for 30 minutes. Remove foil and continue to bake until the casserole is bubbling and cheese is melted, 20 minutes more. Remove from oven and let stand, 5 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide casserole between plates and enjoy!",
      "secondary_message": null
    }
  ],
