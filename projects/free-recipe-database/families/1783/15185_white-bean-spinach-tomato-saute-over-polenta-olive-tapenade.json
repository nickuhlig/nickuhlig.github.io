  "instructions": [
    {
      "id": 250474,
      "primary_message": "In a large pot, bring broth and water to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the broth. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 cup water\n2 ¼ cups polenta (cornmeal)"
    },
    {
      "id": 250475,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 yellow bell peppers\n3 (142 g) pkg baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 250476,
      "primary_message": "Zest lemons into a small bowl. Cut lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 250477,
      "primary_message": "Mince olives, sun-dried tomatoes, and capers; add to the bowl with the lemon zest.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n12 sun-dried tomatoes, oil-packed\n3 tbsp capers"
    },
    {
      "id": 250478,
      "primary_message": "Peel and mince garlic; add to the bowl along with the oil. Stir to combine the tapenade and set aside.",
      "secondary_message": "3 cloves garlic\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 250479,
      "primary_message": "Trim, seed, and medium dice bell peppers; peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 250480,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250481,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, and spices; cook, stirring occasionally, until soft, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 250482,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 250483,
      "primary_message": "Add beans and tomatoes to the pot with the veggies; cook, stirring occasionally, until warmed through, 6-7 minutes.",
      "secondary_message": "1 ½ (398 ml) cans diced tomatoes"
    },
    {
      "id": 250484,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 250485,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 250486,
      "primary_message": "Add oil, salt, and pepper to the polenta and stir to combine; if the polenta is too firm, add hot water, a few tablespoons at a time, until you reach a desired consistency.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 250487,
      "primary_message": "To serve, divide polenta and veggie sauté between bowls; top with olive tapenade and fresh basil. Serve with lemon wedges and enjoy!",
      "secondary_message": null
    }
  ],
