  "instructions": [
    {
      "id": 250404,
      "primary_message": "In a small saucepan, bring broth and water to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the broth. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup water\n¾ cup polenta (cornmeal)"
    },
    {
      "id": 250405,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 yellow bell pepper\n1 (5 oz) pkg baby spinach\n½ small pkg fresh basil"
    },
    {
      "id": 250406,
      "primary_message": "Zest lemon into a small bowl. Cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 250407,
      "primary_message": "Mince olives, sun-dried tomatoes, and capers; add to the bowl with the lemon zest.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n4 sun-dried tomatoes, oil-packed\n1 tbsp capers"
    },
    {
      "id": 250408,
      "primary_message": "Peel and mince garlic; add to the bowl along with the oil. Stir to combine the tapenade and set aside.",
      "secondary_message": "1 clove garlic\n1 tsp extra virgin olive oil"
    },
    {
      "id": 250409,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250410,
      "primary_message": "While the skillet heats up, trim, seed, and medium dice bell pepper; peel and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 250411,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, and spices; cook, stirring occasionally, until soft, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 250412,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 250413,
      "primary_message": "Add beans and tomatoes to the skillet; cook, stirring occasionally, until warmed through, about 5 minutes.",
      "secondary_message": "½ (14.5 oz) can diced tomatoes"
    },
    {
      "id": 250414,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 250415,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 250416,
      "primary_message": "Add oil, salt, and pepper to the polenta and stir to combine; if the polenta is too firm, add hot water, 1 tablespoon at a time, until you reach a desired consistency.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 250417,
      "primary_message": "To serve, divide polenta and veggie sauté between bowls; top with olive tapenade and fresh basil. Serve with lemon wedges and enjoy!",
      "secondary_message": null
    }
  ],
