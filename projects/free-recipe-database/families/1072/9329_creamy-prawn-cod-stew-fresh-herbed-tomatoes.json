  "instructions": [
    {
      "id": 155166,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.23 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 155167,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n1 clove garlic"
    },
    {
      "id": 155168,
      "primary_message": "Preheat a medium saucepan over medium-high heat. Once the pan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 155169,
      "primary_message": "Add onion and garlic to the pan; cook, stirring occasionally, until soft, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 155170,
      "primary_message": "Meanwhile, wash, dry, and chop the potatoes into quarters.",
      "secondary_message": "0.23 kg new potatoes"
    },
    {
      "id": 155171,
      "primary_message": "Add flour and spices to the pan; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "1 tbsp all-purpose flour\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 155172,
      "primary_message": "Gradually add broth, whisking constantly to avoid lumps.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 155173,
      "primary_message": "Add potatoes and bring the soup to a boil. Reduce heat to a simmer, cover, and cook for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 155174,
      "primary_message": "Meanwhile, cut the cod into 1-inch pieces. Add cod to the pan, cover, and simmer 5 more minutes.",
      "secondary_message": "0.23 kg cod fillet"
    },
    {
      "id": 155175,
      "primary_message": "Wash and small dice tomatoes; place in a small bowl. ",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 155176,
      "primary_message": "Add shrimp to the saucepan, cover, and cook until cod is opaque and shrimp is pink, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 155177,
      "primary_message": "Meanwhile, wash and shave parsley leaves off the stems; discard the stems and mince the leaves; add to the bowl with the tomatoes. Wash and juice lemon into the bowl, add oil and stir to combine. Set aside.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ lemon\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 155178,
      "primary_message": "Add milk to the saucepan, stir to combine, and cook until heated through, 2-3 minutes.",
      "secondary_message": "118 ml (½ cup) whole milk"
    },
    {
      "id": 155179,
      "primary_message": "To serve, divide soup between bowls and top with tomato-parsley mixture. Enjoy!",
      "secondary_message": null
    }
  ],
