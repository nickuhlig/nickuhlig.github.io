  "instructions": [
    {
      "id": 155110,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 155111,
      "primary_message": "Peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "3 medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 155112,
      "primary_message": "Preheat a large pot over medium-high heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 155113,
      "primary_message": "Add onion and garlic to the pot; cook, stirring occasionally, until soft, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 155114,
      "primary_message": "Meanwhile, wash, dry, and chop the potatoes into quarters.",
      "secondary_message": "1 ½ lb new potatoes"
    },
    {
      "id": 155115,
      "primary_message": "Add flour and spices to the pot; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "3 tbsp all-purpose flour\n¾ tsp salt\n¾ tsp black pepper\n½ tsp cayenne pepper"
    },
    {
      "id": 155116,
      "primary_message": "Gradually add broth, whisking constantly to avoid lumps.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
    },
    {
      "id": 155117,
      "primary_message": "Add potatoes and bring the soup to a boil. Reduce heat to a simmer, cover, and cook for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 155118,
      "primary_message": "Meanwhile, cut the cod into 1-inch pieces. Add cod to the pot, cover, and simmer 5 more minutes.",
      "secondary_message": "1 ½ lb cod fillet"
    },
    {
      "id": 155119,
      "primary_message": "Wash and small dice tomatoes; place in a medium bowl. ",
      "secondary_message": "6 tomatoes"
    },
    {
      "id": 155120,
      "primary_message": "Add shrimp to the pot, cover, and cook until cod is opaque and shrimp is pink, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 155121,
      "primary_message": "Meanwhile, wash and shave parsley leaves off the stems; discard the stems and mince the leaves; add to the bowl with the tomatoes. Wash and juice lemons into the bowl, add oil and stir to combine. Set aside.",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ lemons\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 155122,
      "primary_message": "Add milk to the pot, stir to combine, and cook until heated through, 4-5 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) whole milk"
    },
    {
      "id": 155123,
      "primary_message": "To serve, divide soup between bowls and top with tomato-parsley mixture. Enjoy!",
      "secondary_message": null
    }
  ],
