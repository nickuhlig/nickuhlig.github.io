  "instructions": [
    {
      "id": 286587,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 286588,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 286589,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n2 medium carrots\n2 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 286590,
      "primary_message": "Break lasagna noodles into thirds. Once the water in the pot is boiling, uncover, add salt and broken noodles, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once done, drain in a colander and set aside.",
      "secondary_message": "8 no-boil lasagna noodles\n1 tsp salt"
    },
    {
      "id": 286591,
      "primary_message": "While the noodles are cooking, trim the zucchini and carrots. Run the peeler along the zucchini and carrots to make long, noodle-like strips. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 286592,
      "primary_message": "Medium dice tomatoes; add to the bowl with the zucchini and carrot.",
      "secondary_message": null
    },
    {
      "id": 286593,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 286594,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 286595,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices to the skillet; cook, stirring occasionally, until veggies are tender, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 286596,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 286597,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 286598,
      "primary_message": "When the veggies are done, add lasagna noodles, half of the basil, and tomato sauce to the skillet; stir to combine and continue to cook until heated through, about 2 minutes. Remove lasagna from heat. (Reserve remaining basil for serving.)",
      "secondary_message": "2 (213 ml) cans tomato sauce"
    },
    {
      "id": 286599,
      "primary_message": "Top lasagna with dollops of ricotta and sprinkle with mozzarella.",
      "secondary_message": "1 (425 g) pkg ricotta cheese"
    },
    {
      "id": 286600,
      "primary_message": "Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 286601,
      "primary_message": "To serve, divide lasagna between plates or bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
