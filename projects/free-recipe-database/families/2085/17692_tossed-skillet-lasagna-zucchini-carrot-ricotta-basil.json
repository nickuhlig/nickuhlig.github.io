  "instructions": [
    {
      "id": 286557,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 286558,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 286559,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 medium carrots\n3 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 286560,
      "primary_message": "Break lasagna noodles into thirds. Once the water in the pot is boiling, uncover, add salt and broken noodles, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once done, drain in a colander and set aside.",
      "secondary_message": "12 no-boil lasagna noodles\n1 ½ tsp salt"
    },
    {
      "id": 286561,
      "primary_message": "While the noodles are cooking, trim the zucchini and carrots. Run the peeler along the zucchini and carrots to make long, noodle-like strips. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 286562,
      "primary_message": "Medium dice tomatoes; add to the bowl with the zucchini and carrot.",
      "secondary_message": null
    },
    {
      "id": 286563,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 286564,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 286565,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices to the pot; cook, stirring occasionally, until veggies are tender, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 286566,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 286567,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 286568,
      "primary_message": "When the veggies are done, add lasagna noodles, half of the basil, and tomato sauce to the pot; stir to combine and continue to cook until heated through, about 3 minutes. Remove from heat. (Reserve remaining basil for serving.)",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 286569,
      "primary_message": "Transfer lasagna filling to a large baking dish; top with dollops of ricotta and sprinkle with mozzarella.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese"
    },
    {
      "id": 286570,
      "primary_message": "Place baking dish in the oven and bake until the mozzarella is melted and golden, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 286571,
      "primary_message": "To serve, divide lasagna between plates or bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
