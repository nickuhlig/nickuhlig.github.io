  "instructions": [
    {
      "id": 314473,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 314474,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 314475,
      "primary_message": "In a large bowl, combine the ground turkey, bread crumbs, eggs, and spices; mix with your hands until well combined.",
      "secondary_message": "0.68 kg ground turkey\n½ cup panko bread crumbs\n2 eggs\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 314476,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 314477,
      "primary_message": "Coat the bottom of a large baking dish with oil. Using a tablespoon measure, form the turkey mixture into rounded meatballs and place in the dish. Place in the oven and bake until golden and cooked through 15-18 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 314478,
      "primary_message": "Meanwhile, peel and mince the garlic; wash, peel, and mince or grate the ginger. Place in a small saucepan.",
      "secondary_message": "4 cloves garlic\n2 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 314479,
      "primary_message": "Add soy sauce, vinegar, oil, chili-garlic sauce, and honey to the saucepan with the ginger and garlic; whisk to combine the sauce for the meatballs.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp rice vinegar\n2 tbsp toasted sesame oil\n4 tsp chili-garlic sauce\n4 tsp honey"
    },
    {
      "id": 314480,
      "primary_message": "Bring the sauce to boil over medium-high heat, stirring frequently; reduce heat to low and continue to cook, stirring occasionally, 2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 314481,
      "primary_message": "Peel and mince garlic; add to a large bowl along with water, peanut butter, vinegar, and soy sauce. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n¼ cup water\n2 tbsp natural peanut butter\n2 tsp rice vinegar\n2 tsp soy sauce"
    },
    {
      "id": 314482,
      "primary_message": "Add broccoli slaw to bowl with dressing and toss to combine.",
      "secondary_message": "1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 314483,
      "primary_message": "Remove meatballs from oven, drizzle with sauce, and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 314484,
      "primary_message": "To serve, divide rice and peanut slaw between plates. Top rice with meatballs and sauce. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
