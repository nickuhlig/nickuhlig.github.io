  "instructions": [
    {
      "id": 314497,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 314498,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 314499,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 314500,
      "primary_message": "In a medium bowl, combine the veggie ground, bread crumbs, and spices; mix with your hands until well combined.",
      "secondary_message": "227 g veggie ground, plant based\n¼ cup panko bread crumbs\n½ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 314501,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and place in a baking dish; set aside.",
      "secondary_message": null
    },
    {
      "id": 314502,
      "primary_message": "Wash and dry ginger. Peel and mince ginger and garlic; place both in another medium bowl.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n2 cloves garlic"
    },
    {
      "id": 314503,
      "primary_message": "Add water, soy sauce, vinegar, oil, chili-garlic sauce, and maple syrup to the bowl with the ginger and garlic; whisk to combine the sauce.",
      "secondary_message": "2 tbsp water\n1 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp toasted sesame oil\n2 tsp chili-garlic sauce\n2 tsp pure maple syrup"
    },
    {
      "id": 314504,
      "primary_message": "Pour sauce over the meatballs, turning them gently to coat. Place in the oven and bake until golden and cooked through, about 15 minutes. Remove from oven. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 314505,
      "primary_message": "Meanwhile, peel and mince additional garlic; place in the reserved bowl along with water, peanut butter, vinegar, and soy sauce. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tbsp water\n1 tbsp natural peanut butter\n1 tsp rice vinegar\n1 tsp soy sauce"
    },
    {
      "id": 314506,
      "primary_message": "Add broccoli slaw to the bowl with the dressing and toss to combine.",
      "secondary_message": "½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 314507,
      "primary_message": "To serve, divide rice and peanut slaw between plates. Top rice with meatballs and sauce from the baking dish. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
