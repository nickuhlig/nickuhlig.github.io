  "instructions": [
    {
      "id": 314323,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 314324,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 314325,
      "primary_message": "In a medium bowl, combine the ground turkey, bread crumbs, egg, and spices; mix with your hands until well combined.",
      "secondary_message": "¾ lb ground turkey\n¼ cup panko bread crumbs\n1 egg\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 314326,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 314327,
      "primary_message": "Coat the bottom of a baking dish with oil. Using a tablespoon measure, form the turkey mixture into rounded meatballs and place in the dish. Place in the oven and bake until golden and cooked through 15-18 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 314328,
      "primary_message": "Meanwhile, peel and mince the garlic; wash, peel, and mince or grate the ginger. Place in another small saucepan.",
      "secondary_message": "2 cloves garlic\n1 (1 inch) piece ginger root"
    },
    {
      "id": 314329,
      "primary_message": "Add soy sauce, vinegar, oil, chili-garlic sauce, and honey to the saucepan with the ginger and garlic; whisk to combine the sauce for the meatballs.",
      "secondary_message": "1 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp toasted sesame oil\n2 tsp chili-garlic sauce\n2 tsp honey"
    },
    {
      "id": 314330,
      "primary_message": "Bring the sauce to boil over medium-high heat, stirring frequently; reduce heat to low and continue to cook, stirring occasionally, 2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 314331,
      "primary_message": "Peel and mince garlic; add to a medium bowl along with water, peanut butter, vinegar, and soy sauce. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tbsp water\n1 tbsp natural peanut butter\n1 tsp rice vinegar\n1 tsp soy sauce"
    },
    {
      "id": 314332,
      "primary_message": "Add broccoli slaw to bowl with dressing and toss to combine.",
      "secondary_message": "½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 314333,
      "primary_message": "Remove meatballs from oven, drizzle with sauce, and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 314334,
      "primary_message": "To serve, divide rice and peanut slaw between plates. Top rice with meatballs and sauce. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
