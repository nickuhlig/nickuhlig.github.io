  "instructions": [
    {
      "id": 314519,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 314520,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 314521,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 314522,
      "primary_message": "In a medium bowl, combine the veggie ground, bread crumbs, and spices; mix with your hands until well combined.",
      "secondary_message": "680 g veggie ground, plant based\n¾ cup panko bread crumbs\n1 ½ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 314523,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and divide between two baking dishes; set aside.",
      "secondary_message": null
    },
    {
      "id": 314524,
      "primary_message": "Wash and dry ginger. Peel and mince ginger and garlic; place both in a large bowl.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n6 cloves garlic"
    },
    {
      "id": 314525,
      "primary_message": "Add water, soy sauce, vinegar, oil, chili-garlic sauce, and maple syrup to the bowl with the ginger and garlic; whisk to combine the sauce.",
      "secondary_message": "⅓ cup water\n3 tbsp soy sauce\n3 tbsp rice vinegar\n3 tbsp toasted sesame oil\n2 tbsp chili-garlic sauce\n2 tbsp pure maple syrup"
    },
    {
      "id": 314526,
      "primary_message": "Pour sauce over the meatballs, turning them gently to coat. Place in the oven and bake until golden and cooked through, 15-20 minutes. Remove from oven. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 314527,
      "primary_message": "Meanwhile, peel and mince additional garlic; place in the reserved bowl along with water, peanut butter, vinegar, and soy sauce. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n⅓ cup water\n3 tbsp natural peanut butter\n1 tbsp rice vinegar\n1 tbsp soy sauce"
    },
    {
      "id": 314528,
      "primary_message": "Add broccoli slaw to the bowl with the dressing and toss to combine.",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 314529,
      "primary_message": "To serve, divide rice and peanut slaw between plates. Top rice with meatballs and sauce from the baking dish. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
