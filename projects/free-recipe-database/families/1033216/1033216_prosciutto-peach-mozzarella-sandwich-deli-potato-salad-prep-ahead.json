  "instructions": [
    {
      "primary_message": "This recipe utilizes 2 two-compartment food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce. \n\n",
      "secondary_message": "1 peach\n1 tomato\n4 small leaf butter (Boston) lettuce"
    },
    {
      "primary_message": "Quarter peach lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Slice each quarter into thin wedges, then using a paper towel, pat peach wedges on both sides to remove excess liquid. Place on a plate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Slice tomato crosswise into thin rounds, then using a paper towel, pat tomato slices on both sides to remove excess liquid. Add to the plate with the peach.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Thinly slice mozzarella into rounds. Add to the plate.\n\n",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "primary_message": "Spread mayo over each bread slice. Layer half of the slices with lettuce, tomato, mozzarella, peaches, and prosciutto. Close with remaining bread slices. Cut sandwiches in half and wrap tightly in plastic wrap. Place in one half of the storage containers.\n\n",
      "secondary_message": "2 tbsp mayonnaise\n4 slice whole grain bread\n6 slice prosciutto"
    },
    {
      "primary_message": "Add potato salad to the other half of the food storage containers, cover, and refrigerate until ready to eat. Enjoy! \n\n",
      "secondary_message": "2 cups deli potato salad"
    }
  ],
