  "instructions": [
    {
      "id": 130961,
      "primary_message": "In a small saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n1 cup water"
    },
    {
      "id": 130962,
      "primary_message": "Meanwhile, in a small bowl, combine oil, vinegar, maple syrup, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 tsp pure maple syrup\n½ tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 130963,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 orange\n½ (170 g) pkg blueberries\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 130964,
      "primary_message": "Quarter orange; peel and slice the quarters into wedges.",
      "secondary_message": null
    },
    {
      "id": 130965,
      "primary_message": "To serve, divide the quinoa and spinach between plates or bowls; top with orange wedges, blueberries, and sliced almonds. Drizzle with dressing and enjoy!",
      "secondary_message": "¼ cup almonds, sliced"
    }
  ],
