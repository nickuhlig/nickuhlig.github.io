  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large baking dish. Add hot water (from the tap) and spices, then stir to combine.\n\n",
      "secondary_message": "1 ½ cups basmati rice\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp garlic powder"
    },
    {
      "primary_message": "Cut hot dogs crosswise into ½-inch thick pieces. Top rice with hot dogs and broccoli, spreading them out in an even layer (do not stir). ",
      "secondary_message": "1 (680 g) bag broccoli florets"
    },
    {
      "primary_message": "Small dice butter and dot over the casserole.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "primary_message": "Cover baking dish tightly with aluminum foil and place in the preheated oven. Bake until the rice and broccoli are tender and hot dogs are warmed through, about 60 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, uncover casserole, stir to combine, and divide between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
