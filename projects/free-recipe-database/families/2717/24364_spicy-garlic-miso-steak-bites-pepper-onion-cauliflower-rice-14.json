  "instructions": [
    {
      "primary_message": "Peel and mince garlic. Place in a small bowl along with miso paste, soy sauce, sugar, and crushed red pepper. Stir to combine the marinade. ",
      "secondary_message": "2 cloves garlic\n1 ½ tbsp miso paste, red\nsoy sauce\n2 tsp brown sugar\n¼ tsp crushed red pepper"
    },
    {
      "primary_message": "Pat the steak dry with paper towels, then cut into 1-inch cubes. Add to the bowl with the marinade, stir to coat, and set aside. ",
      "secondary_message": "340 g striploin (New York strip) steak"
    },
    {
      "primary_message": "Wash and dry bell pepper. Using a clean cutting board, trim, seed, and medium dice. Place in another small bowl.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper. ",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook, stirring occasionally, until desired doneness, 3-4 minutes for medium. Transfer to a plate, cover with aluminum foil, and set aside. (Reserve skillet with drippings for the next step.)",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add bell pepper, green onions, and cauliflower; cook, stirring occasionally, until tender, about 3 minutes. ",
      "secondary_message": "extra virgin olive oil\n1 (340 g) bag frozen, riced cauliflower"
    },
    {
      "primary_message": "When the cauliflower rice is done, remove from heat, add additional soy sauce, and stir to combine.",
      "secondary_message": "soy sauce"
    },
    {
      "primary_message": "To serve, divide cauliflower rice and steak bites between plates. Enjoy!",
      "secondary_message": null
    }
  ],
