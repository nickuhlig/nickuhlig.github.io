  "instructions": [
    {
      "id": 394968,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with miso paste, soy sauce, sugar, and crushed red pepper. Stir to combine the marinade. ",
      "secondary_message": "4 cloves garlic\n3 tbsp miso paste, red\n4 tsp soy sauce\n4 tsp brown sugar\n½ tsp crushed red pepper"
    },
    {
      "id": 394969,
      "primary_message": "Pat the steak dry with paper towels, then cut into 1-inch cubes. Add to the bowl with the marinade, stir to coat, and set aside. ",
      "secondary_message": "0.68 kg striploin (New York strip) steak"
    },
    {
      "id": 394970,
      "primary_message": "Wash and dry bell peppers. Using a clean cutting board, trim, seed, and medium dice. Place in another medium bowl.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 394971,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 394972,
      "primary_message": "While the skillet heats up, wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper. ",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 394973,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak and cook, stirring occasionally, until desired doneness, 3-4 minutes for medium. Transfer to a plate, cover with aluminum foil, and set aside. (Reserve skillet with drippings for the next step.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 394974,
      "primary_message": "Return skillet (with drippings) to medium-high heat, add more butter, and swirl to coat the bottom. Add bell pepper, green onions, and cauliflower; cook, stirring occasionally, until tender, about 3 minutes. ",
      "secondary_message": "4 tsp butter, unsalted\n2 (340 g) bags frozen, riced cauliflower"
    },
    {
      "id": 394975,
      "primary_message": "When the cauliflower rice is done, remove from heat, add additional soy sauce, and stir to combine.",
      "secondary_message": "2 tbsp soy sauce"
    },
    {
      "id": 394976,
      "primary_message": "To serve, divide cauliflower rice and steak bites between plates. Enjoy!",
      "secondary_message": null
    }
  ],
