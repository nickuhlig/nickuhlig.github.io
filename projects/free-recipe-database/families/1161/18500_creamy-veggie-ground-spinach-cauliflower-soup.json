  "instructions": [
    {
      "id": 303123,
      "primary_message": "Wash the cauliflower, then trim off and discard the leaves and thick stems. Using a box grater or food processor, coarsely grate the cauliflower, place in a medium bowl, and set aside.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 303124,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 303125,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until crumbly and cooked through, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based"
    },
    {
      "id": 303126,
      "primary_message": "Meanwhile, peel and small dice onion; peel and mince garlic. Add both to the pan and cook, stirring occasionally, until onion has softened, 2-3 minutes. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 303127,
      "primary_message": "Add cauliflower and broth to the pan; stir to combine, cover, and bring to a boil.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 303128,
      "primary_message": "Once boiling, reduce to a simmer and cook, stirring occasionally, until cauliflower starts to soften, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 303129,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 303130,
      "primary_message": "Wash spinach. (Skip this step if it came pre-washed.) Add to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful; stir to combine.",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 303131,
      "primary_message": "Add cream, salt, pepper, and most of the Parmesan (reserving a small handful for garnish) to the pan. Continue to cook, stirring occasionally, until cheese is melted, 1-2 minutes more.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 303132,
      "primary_message": "To serve, divide soup between bowls and garnish with the reserved Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
