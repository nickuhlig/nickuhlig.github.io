  "instructions": [
    {
      "id": 303053,
      "primary_message": "Wash, dry, and cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower and place in a large bowl. Set aside.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 303054,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 303055,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until crumbly and cooked through, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based"
    },
    {
      "id": 303056,
      "primary_message": "Meanwhile, peel and small dice onions; peel and mince garlic. Add both to the pot and cook, stirring occasionally, until onion has softened, 3-4 minutes. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 303057,
      "primary_message": "Add cauliflower and broth to the pot; stir to combine, cover, and bring to a boil.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 303058,
      "primary_message": "Once boiling, reduce to a simmer and cook, stirring occasionally, until cauliflower starts to soften, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 303059,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 303060,
      "primary_message": "Wash spinach. (Skip this step if it came pre-washed.) Add to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful; stir to combine.",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 303061,
      "primary_message": "Add cream, salt, pepper, and most of the Parmesan (reserving a small handful for garnish) to the pot. Continue to cook, stirring occasionally, until cheese is melted, 2-3 minutes more.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 303062,
      "primary_message": "To serve, divide soup between bowls and garnish with the reserved Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
