  "instructions": [
    {
      "id": 302993,
      "primary_message": "Use the tip of a knife to slice down the length of the sausages. Peel off casings and discard.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 302994,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 302995,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork and cook, breaking up with a spoon, until sausage is browned, 7-8 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 302996,
      "primary_message": "Meanwhile, peel and small dice onions. Peel and mince garlic. Add both to the pot and cook, stirring occasionally, until onion has softened, 3-4 minutes. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 302997,
      "primary_message": "Wash the cauliflower, then trim off and discard the leaves and thick stems. Using a box grater or food processor, coarsely grate the cauliflower. ",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 302998,
      "primary_message": "Add cauliflower and broth to the pot; stir, cover, and bring to a boil. Reduce to a simmer and cook for 6-8 minutes more. ",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 302999,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 303000,
      "primary_message": "Wash spinach (unless it came pre-washed) and add to the pot.",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 303001,
      "primary_message": "Add cream, salt, pepper, and most of the Parmesan (reserve a small amount for garnish). Heat to a simmer, stirring occasionally, until cheese is melted. ",
      "secondary_message": "6 fl oz (¾ cup) heavy whipping cream\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 303002,
      "primary_message": "To serve, divide the soup between bowls and garnish with the remaining Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
