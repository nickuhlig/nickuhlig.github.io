  "instructions": [
    {
      "id": 303133,
      "primary_message": "Wash the cauliflower, then trim off and discard the leaves and thick stems. Using a box grater or food processor, coarsely grate the cauliflower, place in a medium bowl, and set aside.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 303134,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 303135,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until crumbly and cooked through, about 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based"
    },
    {
      "id": 303136,
      "primary_message": "Meanwhile, peel and small dice onion; peel and mince garlic. Add both to the pot and cook, stirring occasionally, until onion has softened, 2-3 minutes. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 303137,
      "primary_message": "Add cauliflower and broth to the pot; stir to combine, cover, and bring to a boil.",
      "secondary_message": "1420 ml chicken or vegetable broth"
    },
    {
      "id": 303138,
      "primary_message": "Once boiling, reduce to a simmer and cook, stirring occasionally, until cauliflower starts to soften, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 303139,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 303140,
      "primary_message": "Wash spinach. (Skip this step if it came pre-washed.) Add to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful; stir to combine.",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 303141,
      "primary_message": "Add cream, salt, pepper, and most of the Parmesan (reserving a small handful for garnish) to the pot. Continue to cook, stirring occasionally, until cheese is melted, 1-2 minutes more.",
      "secondary_message": "237 ml heavy whipping cream\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 303142,
      "primary_message": "To serve, divide soup between bowls and garnish with the reserved Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
