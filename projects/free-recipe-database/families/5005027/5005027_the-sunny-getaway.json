  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Simple Syrup: Dissolve sugar in water over medium heat. Bring to a boil, then reduce to a simmer for 10 minutes, stirring frequently. Let cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Cocktail: Muddle limes and simple syrup in cocktail shaker until the limes are juiced.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fill cocktail shaker with ice, then add Meyer lemon juice, coconut milk, and vodka. Shake for 10 seconds.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Strain cocktail into a Collins glass filled with ice. Top with ginger beer and add lime slices to garnish if desired. Serve with a straw.",
      "secondary_message": null
    }
  ],
