  "instructions": [
    {
      "id": 347598,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 bunch radish\n2 medium zucchini squash\n1 yellow bell pepper\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 347599,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347600,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 347601,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 347602,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and garlic powder in a small bowl; whisk to combine the dipping sauce and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n4 tsp chili-garlic sauce\n½ tsp garlic powder"
    },
    {
      "id": 347603,
      "primary_message": "Trim, halve, and slice radishes into thin half-moons; place on another plate.",
      "secondary_message": null
    },
    {
      "id": 347604,
      "primary_message": "Trim zucchini and use a vegetable peeler to make thin ribbons; add to the plate with the radish and set aside for the zucchini rolls.",
      "secondary_message": null
    },
    {
      "id": 347605,
      "primary_message": "Place oil, vinegar, Dijon, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 347606,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl with the dressing, along with the arugula, and, toss to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 347607,
      "primary_message": "After the steak has rested, thinly slice against the grain and return to the plate.",
      "secondary_message": null
    },
    {
      "id": 347608,
      "primary_message": "To assemble the zucchini rolls, arrange zucchini ribbons on a flat surface; place a few pieces of steak and radish at one end and roll tightly to secure. (Assemble in batches if necessary.)",
      "secondary_message": null
    },
    {
      "id": 347609,
      "primary_message": "Divide zucchini rolls and salad between plates; serve with dipping sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
