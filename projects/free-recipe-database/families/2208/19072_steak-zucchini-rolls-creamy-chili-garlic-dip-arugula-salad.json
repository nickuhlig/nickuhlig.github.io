  "instructions": [
    {
      "id": 347646,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ bunches radish\n3 medium zucchini squash\n1 ½ yellow bell peppers\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 347647,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347648,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 347649,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 347650,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and garlic powder in a small bowl; whisk to combine the dipping sauce and set aside.",
      "secondary_message": "½ cup avocado oil mayonnaise\n2 tbsp chili-garlic sauce\n¾ tsp garlic powder"
    },
    {
      "id": 347651,
      "primary_message": "Trim, halve, and slice radishes into thin half-moons; place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 347652,
      "primary_message": "Trim zucchini and use a vegetable peeler to make thin ribbons; add to the plate with the radish and set aside for the zucchini rolls.",
      "secondary_message": null
    },
    {
      "id": 347653,
      "primary_message": "Place oil, vinegar, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 ½ tsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 347654,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the dressing, along with the arugula, and toss to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 347655,
      "primary_message": "After the steak has rested, thinly slice against the grain and return to the plate.",
      "secondary_message": null
    },
    {
      "id": 347656,
      "primary_message": "To assemble the zucchini rolls, arrange zucchini ribbons on a flat surface; place a few pieces of steak and radish at one end and roll tightly to secure. (Assemble in batches if necessary.)",
      "secondary_message": null
    },
    {
      "id": 347657,
      "primary_message": "Divide zucchini rolls and salad between plates; serve with dipping sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
