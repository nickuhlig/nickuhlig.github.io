  "instructions": [
    {
      "id": 221444,
      "primary_message": "Wash and dry strawberries; set aside.",
      "secondary_message": "½ (454 g) pkg strawberries"
    },
    {
      "id": 221445,
      "primary_message": "Using a box grater, coarsely grate cream cheese into a medium bowl; add vanilla. Use a silicone spatula or fork to soften and combine the cream cheese mixture, creating a smooth cream.",
      "secondary_message": "½ (227 g) block cream cheese\n¼ tsp vanilla extract"
    },
    {
      "id": 221446,
      "primary_message": "Using a strainer, sift powdered sugar into the bowl with the cream cheese. Use the spatula or fork to mash and combine the mixture until smooth and no lumps remain.",
      "secondary_message": "¼ cup powdered sugar"
    },
    {
      "id": 221447,
      "primary_message": "To serve, divide strawberries and dip between plates. Enjoy!",
      "secondary_message": null
    }
