  "instructions": [
    {
      "id": 66584,
      "primary_message": "Peel and mince the garlic. Wash and dry the parsley. Shave the leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "6 cloves garlic\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 66583,
      "primary_message": "In a large bowl, whisk together the minced garlic, ½ of the minced parsley (save the rest for garnishing), olive oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "12 tbsp extra virgin olive oil\n6 tbsp red wine vinegar\n6 tsp Dijon mustard\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 66582,
      "primary_message": "Cut the steak into cubes; transfer to the bowl with the marinade and toss to coat.",
      "secondary_message": "2 ¼ lb ribeye steak"
    },
    {
      "id": 66581,
      "primary_message": "Wash the tomatoes and mushrooms. Halve the mushrooms. Add the tomatoes and mushrooms to the marinade. Peel the onion and cut into chunks; add to the marinade. Toss beef and vegetables until well coated.",
      "secondary_message": "1 ½ pint grape tomatoes\n¾ lb white mushrooms\n1 ½ medium red onion"
    },
    {
      "id": 66580,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 66579,
      "primary_message": "Thread the steak and vegetables onto 18 skewers. Alternatively, you can cook the steak and vegetable pieces directly on the grill/skillet without using skewers.",
      "secondary_message": ""
    },
    {
      "id": 66578,
      "primary_message": "Add the kebabs (as many as will fit) to the grill or skillet. Cook until steak is browned and vegetables are tender, 3-5 minutes per side. Transfer to a plate and repeat with remaining kebabs.",
      "secondary_message": ""
    },
    {
      "id": 66577,
      "primary_message": "To serve, place kebabs on a plate and sprinkle with the remaining minced parsley. Enjoy!",
      "secondary_message": ""
    }
  ],
