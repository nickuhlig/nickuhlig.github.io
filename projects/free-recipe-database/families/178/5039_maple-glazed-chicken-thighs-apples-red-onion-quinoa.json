  "instructions": [
    {
      "id": 61074,
      "primary_message": "In a small saucepan, combine quinoa, broth, and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n18 fl oz (2 ¼ cups) chicken or vegetable broth\n¾ cup water"
    },
    {
      "id": 61073,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 61072,
      "primary_message": "Season chicken with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 61071,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until browned and cooked through, 3-4 minutes per side.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 61070,
      "primary_message": "Wash, core, and cut apples into wedges. Peel and cut onion into wedges.",
      "secondary_message": "6 Gala apples\n1 ½ medium red onion"
    },
    {
      "id": 61069,
      "primary_message": "Transfer chicken to a plate and return skillet to stove. Add more oil, apples, onion, and thyme. Stirring occasionally, cook until apples are just tender and golden, 5-6 minutes.",
      "secondary_message": "about 1 ½ tbsp virgin coconut oil\n1 ½ tsp thyme"
    },
    {
      "id": 61068,
      "primary_message": "In a medium bowl, mix together broth, maple syrup, and vinegar.",
      "secondary_message": "6 fl oz (¾ cup) chicken or vegetable broth\n6 tbsp pure maple syrup\n6 tbsp red wine vinegar"
    },
    {
      "id": 61067,
      "primary_message": "Return chicken to skillet and pour in sauce. Stir and cook until sauce thickens, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 61066,
      "primary_message": "Uncover quinoa and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 61065,
      "primary_message": "To serve, place quinoa on a plate and top with chicken, apples, and onion. Enjoy!",
      "secondary_message": ""
    }
  ],
