  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the dark chocolate.",
      "secondary_message": "12 ¼ oz dark chocolate"
    },
    {
      "id": 1,
      "primary_message": "Put equal parts water and ice into a medium bowl for the ice bath. Boil the water in a saucepan, or in the microwave, and pour it into a second medium bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the chopped chocolate and stir with a spatula or whisk until all the pieces are melted, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place the bowl with the chocolate over the ice bath and whisk vigorously. Continue to whisk until the mixture has the consistency of stiffly whipped cream, and then quickly divide it between individual serving cups or into a serving bowl. Refrigerate.",
      "secondary_message": null
    }
