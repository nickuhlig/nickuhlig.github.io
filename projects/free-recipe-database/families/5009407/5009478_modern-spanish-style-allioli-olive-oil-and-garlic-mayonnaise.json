  "instructions": [
    {
      "id": 1,
      "primary_message": "Place egg yolk, garlic, water, and lemon juice in the bottom of an immersion blender cup. Pour oil on top and allow to settle for 15 seconds. Place head of immersion blender at bottom of cup and switch it on. As mayonnaise forms, slowly tilt and lift the head of the immersion blender until all oil is emulsified. (For food processor instructions, see note).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer allioli to a medium bowl. Whisking constantly, slowly drizzle in extra-virgin olive oil. Season to taste with salt and pepper. Store in a sealed container in the refrigerator for up to two weeks.",
      "secondary_message": null
    }
  ],
