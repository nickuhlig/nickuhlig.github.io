  "instructions": [
    {
      "id": 309601,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lemon\n1 medium carrot\n½ yellow bell pepper\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 309602,
      "primary_message": "Juice lemon into a medium bowl. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Dijon mustard\n½ tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 309603,
      "primary_message": "Peel, trim, and slice carrot crosswise into thin rounds; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 309604,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 309605,
      "primary_message": "Place tomato sauce and spices in a small saucepan, stir to combine, and place over low heat. Cook, stirring occasionally, until heated through, about 3 minutes. Cover the marinara and remove from heat.",
      "secondary_message": "1 (213 ml) can tomato sauce\n¼ tsp Italian seasoning\n⅛ tsp onion powder\n⅛ tsp garlic powder\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 309606,
      "primary_message": "Meanwhile, whisk egg in a small bowl. Place almond meal on a plate.",
      "secondary_message": "1 egg\n⅓ cup almond meal/flour"
    },
    {
      "id": 309607,
      "primary_message": "Combine flour and spices in another small bowl.",
      "secondary_message": "1 tbsp all-purpose flour\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 309608,
      "primary_message": "Slice mozzarella into ½-inch thick rounds, pat dry with paper towels, and place on another plate; sprinkle flour mixture over both sides to coat.",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 309609,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 309610,
      "primary_message": "Working one slice at a time, dip the floured mozzarella into the bowl with the egg. Let the excess drip off, then dredge in the almond meal, gently pressing to adhere; return slices to the plate.",
      "secondary_message": null
    },
    {
      "id": 309611,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Carefully place coated mozzarella in the skillet and cook, flipping once, until golden brown, 1-2 minutes per side. Remove to a clean, paper towel-lined plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 309612,
      "primary_message": "Meanwhile, add mixed greens to the bowl with the veggies and dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 309613,
      "primary_message": "To serve, divide almond-crusted mozzarella and salad between plates; pour warm marinara over the mozzarella and sprinkle with additional Italian seasoning. Enjoy!",
      "secondary_message": "1 pinch Italian seasoning"
    }
  ],
