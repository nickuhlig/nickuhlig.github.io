  "instructions": [
    {
      "id": 309627,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 medium carrots\n1 ½ yellow bell peppers\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 309628,
      "primary_message": "Juice lemons into a large bowl. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n1 ½ tsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 309629,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 309630,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 309631,
      "primary_message": "Place tomato sauce and spices in a medium saucepan, stir to combine, and place over low heat. Cook, stirring occasionally, until heated through, 3-4 minutes. Cover the marinara and remove from heat.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n¾ tsp Italian seasoning\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 309632,
      "primary_message": "Meanwhile, whisk eggs in a medium bowl. Place almond meal on a plate.",
      "secondary_message": "3 eggs\n1 cup almond meal/flour"
    },
    {
      "id": 309633,
      "primary_message": "Combine flour and spices in a small bowl.",
      "secondary_message": "3 tbsp all-purpose flour\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 309634,
      "primary_message": "Slice mozzarella into ½-inch thick rounds, pat dry with paper towels, and place on a large baking sheet pan; sprinkle flour mixture over both sides to coat.",
      "secondary_message": "3 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 309635,
      "primary_message": "Working one slice at a time, dip the floured mozzarella into the bowl with the egg. Let the excess drip off, then dredge in the almond meal, gently pressing to adhere; return slices to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 309636,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 309637,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, carefully place coated mozzarella in the skillet and cook, flipping once, until golden brown, 1-2 minutes per side. Remove to a clean, paper towel-lined baking sheet.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 309638,
      "primary_message": "Meanwhile, add mixed greens to the bowl with the veggies and dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 309639,
      "primary_message": "To serve, divide almond-crusted mozzarella and salad between plates; pour warm marinara over the mozzarella and sprinkle with additional Italian seasoning. Enjoy!",
      "secondary_message": "3 pinch Italian seasoning"
    }
  ],
