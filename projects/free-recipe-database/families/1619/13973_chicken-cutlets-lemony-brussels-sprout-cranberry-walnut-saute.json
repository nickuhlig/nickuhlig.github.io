  "instructions": [
    {
      "id": 231612,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg Brussels sprouts\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 231613,
      "primary_message": "Trim and halve Brussels sprouts; transfer to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 231614,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 231615,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231616,
      "primary_message": "While the skillet heats up, sprinkle flour over both sides of each cutlet and press gently to adhere.",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 231617,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add cutlets and pan-fry until golden and cooked through, 3-4 minutes per side.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 231618,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince onion and garlic.",
      "secondary_message": "½ medium red onion\n2 cloves garlic"
    },
    {
      "id": 231619,
      "primary_message": "When the chicken is done, remove to a plate and cover loosely with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 231620,
      "primary_message": "Return skillet to medium-high heat, add additional oil, and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 231621,
      "primary_message": "Add onion and garlic to the skillet; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 231622,
      "primary_message": "Add Brussels sprouts, broth, cranberries, and salt to the skillet; cover and cook, stirring occasionally, until Brussels sprouts are fork-tender, about 5 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n1 cup dried cranberries\n½ tsp salt"
    },
    {
      "id": 231623,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the bowl used for the Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 231624,
      "primary_message": "Juice lemon into the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 231625,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 231626,
      "primary_message": "Uncover the skillet, then add the parsley, lemon juice, and walnuts. Stir to combine and remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 231627,
      "primary_message": "To serve, divide chicken and Brussels sprout sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
