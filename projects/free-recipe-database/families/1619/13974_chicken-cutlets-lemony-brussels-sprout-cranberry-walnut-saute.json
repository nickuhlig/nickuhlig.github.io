  "instructions": [
    {
      "id": 231628,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg Brussels sprouts\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 231629,
      "primary_message": "Trim and halve Brussels sprouts; transfer to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 231630,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 231631,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231632,
      "primary_message": "While the pot heats up, sprinkle flour over both sides of each cutlet and press gently to adhere.",
      "secondary_message": "⅓ cup all-purpose flour"
    },
    {
      "id": 231633,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add cutlets and pan-fry until golden and cooked through, 3-4 minutes per side.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 231634,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince onion and garlic.",
      "secondary_message": "1 medium red onion\n3 cloves garlic"
    },
    {
      "id": 231635,
      "primary_message": "When the chicken is done, remove to a plate and cover loosely with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 231636,
      "primary_message": "Return pot to medium-high heat, add additional oil, and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 231637,
      "primary_message": "Add onion and garlic to the pot; cook, stirring frequently, until fragrant, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 231638,
      "primary_message": "Add Brussels sprouts, broth, cranberries, and salt to the pot; cover and cook, stirring occasionally, until Brussels sprouts are fork-tender, 6-7 minutes.",
      "secondary_message": "355 ml chicken or vegetable broth\n1 ½ cups dried cranberries\n¾ tsp salt"
    },
    {
      "id": 231639,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the bowl used for the Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 231640,
      "primary_message": "Juice lemons into the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 231641,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 231642,
      "primary_message": "Uncover the pot, then add the parsley, lemon juice, and walnuts. Stir to combine and remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 231643,
      "primary_message": "To serve, divide chicken and Brussels sprout sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
