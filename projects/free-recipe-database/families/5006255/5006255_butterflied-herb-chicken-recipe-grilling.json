  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Soften the unsalted butter. Mince the garlic. Butterfly the whole chicken.",
      "secondary_message": "6 tbsp unsalted butter\n1 clove garlic\n1 whole chicken"
    },
    {
      "id": 1,
      "primary_message": "Mix the butter, herbs, garlic, and salt and pepper together in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using your fingers, carefully separate skin from each side of side of the breast and thighs and spread about 1 tablespoon of the herb butter under each area. Season skin with additional salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly. Place chicken skin-side down on the grill and cook until skin is deeply browned and crisp, about 10 to 15 minutes. Flip chicken over and continue to grill until an instant-read thermometer inserted in thickest part of breast registers 160°F, about 10 to 15 minutes more. Transfer chicken to a cutting board and allow to rest for 10 to 15 minutes. Carve and serve.",
      "secondary_message": null
    }
  ],
