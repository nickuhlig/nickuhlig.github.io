  "instructions": [
    {
      "id": 208046,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 208047,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 12 minutes. Remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 208048,
      "primary_message": "Meanwhile, wash, dry, and zest lemon into a medium bowl; set aside.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 208049,
      "primary_message": "Juice lemon into a small saucepan. Add sugar, cornstarch, and cinnamon; whisk until smooth.",
      "secondary_message": "¼ cup granulated sugar\n1 tsp cornstarch\n⅛ tsp cinnamon"
    },
    {
      "id": 208050,
      "primary_message": "Wash blueberries; add half to the saucepan with the lemon mixture (set remaining berries aside). Mash with a fork to crush the berries and release their juices.",
      "secondary_message": "1 (170 g) pkg blueberries"
    },
    {
      "id": 208051,
      "primary_message": "Place the saucepan over medium-low heat and bring to a simmer. Cook, stirring constantly, until thickened, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 208052,
      "primary_message": "Remove saucepan from heat and stir in remaining blueberries. Set blueberry compote aside.",
      "secondary_message": null
    },
    {
      "id": 208053,
      "primary_message": "Add ricotta, honey, and salt to the bowl with the lemon zest; whisk to combine.",
      "secondary_message": "1 (425 g) pkg ricotta cheese\n2 tbsp honey\n⅛ tsp salt"
    },
    {
      "id": 208054,
      "primary_message": "Spread ricotta mixture over each flatbread. Spoon blueberry compote over the ricotta.",
      "secondary_message": null
    },
    {
      "id": 208055,
      "primary_message": "To serve, slice pizzas into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
