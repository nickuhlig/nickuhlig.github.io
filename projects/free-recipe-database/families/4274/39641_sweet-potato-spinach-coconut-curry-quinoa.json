  "instructions": [
    {
      "id": 615178,
      "primary_message": "In a medium saucepan, combine broth and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups quinoa"
    },
    {
      "id": 615179,
      "primary_message": "Meanwhile, wash, dry, peel, and small dice sweet potatoes.",
      "secondary_message": "1.36 kg sweet potatoes"
    },
    {
      "id": 615180,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 615181,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 615182,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sweet potato, garlic, and spices; cook, stirring occasionally, until sweet potato is golden brown and tender, 12-15 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil\n2 tbsp curry powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 615183,
      "primary_message": "Add coconut milk and broth to the pot, then stir to combine the curry and bring to a boil. Once boiling, reduce heat to medium-low and continue to cook, stirring occasionally, until curry is slightly thickened, 5-6 minutes more.",
      "secondary_message": "1 ½ (398 ml) cans coconut milk\n355 ml chicken or vegetable broth"
    },
    {
      "id": 615184,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed). Roughly chop.",
      "secondary_message": "3 (142 g) pkgs baby spinach"
    },
    {
      "id": 615185,
      "primary_message": "When the curry is thickened, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook until fully wilted, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 615186,
      "primary_message": "To serve, divide quinoa and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
