  "instructions": [
    {
      "id": 615169,
      "primary_message": "In a medium saucepan, combine broth and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup quinoa"
    },
    {
      "id": 615170,
      "primary_message": "Meanwhile, wash, dry, peel, and small dice sweet potatoes.",
      "secondary_message": "0.91 kg sweet potato"
    },
    {
      "id": 615171,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 615172,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 615173,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sweet potato, garlic, and spices; cook, stirring occasionally, until sweet potato is golden brown and tender, 10-12 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n4 tsp curry powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 615174,
      "primary_message": "Add coconut milk and broth to the skillet, then stir to combine the curry and bring to a boil. Once boiling, reduce heat to medium-low and continue to cook, stirring occasionally, until curry is slightly thickened, 4-5 minutes more.",
      "secondary_message": "1 (398 ml) can coconut milk\n237 ml chicken or vegetable broth"
    },
    {
      "id": 615175,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed). Roughly chop.",
      "secondary_message": "2 (142 g) pkgs baby spinach"
    },
    {
      "id": 615176,
      "primary_message": "When the curry is thickened, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook until fully wilted, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 615177,
      "primary_message": "To serve, divide quinoa and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
