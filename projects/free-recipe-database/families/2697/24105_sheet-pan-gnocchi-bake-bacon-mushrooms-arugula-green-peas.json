  "instructions": [
    {
      "id": 416452,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 416453,
      "primary_message": "Wash, dry, and quarter mushrooms. Place in a large bowl.",
      "secondary_message": "1.02 kg cremini mushrooms"
    },
    {
      "id": 416454,
      "primary_message": "Peel, halve, and slice onions lengthwise into thin strips. Peel and mince garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 416455,
      "primary_message": "Small dice bacon and add to the bowl.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 416456,
      "primary_message": "Add gnocchi, oil, and spices to the bowl. Stir to combine, divide between two large baking sheet pans, and spread out in an even layer.",
      "secondary_message": "3 (454 g) pkgs potato gnocchi\n2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 416457,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until gnocchi is golden brown and bacon is crispy, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 416458,
      "primary_message": "Meanwhile, place Dijon, vinegar, Worcestershire, and honey in a small bowl. Stir to combine the sauce.",
      "secondary_message": "2 tbsp Dijon mustard\n2 tbsp white wine vinegar\n2 tbsp Worcestershire sauce\n1 tbsp honey"
    },
    {
      "id": 416459,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 416460,
      "primary_message": "When the gnocchi is done, remove from the oven. Divide the sauce, arugula, and peas between the baking sheets; stir to combine and spread out in an even layer.",
      "secondary_message": "2 ¼ cups frozen peas"
    },
    {
      "id": 416461,
      "primary_message": "Return baking sheets to the oven and continue to roast until arugula is wilted and peas are warmed through, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 416462,
      "primary_message": "To serve, divide gnocchi bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
