  "instructions": [
    {
      "id": 416463,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 416464,
      "primary_message": "Wash, dry, and quarter mushrooms. Place in a medium bowl.",
      "secondary_message": "⅓ kg cremini mushrooms"
    },
    {
      "id": 416465,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin strips. Peel and mince garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 416466,
      "primary_message": "Add gnocchi, oil, and spices to the bowl. Stir to combine, transfer to a large baking sheet pan, and spread out in an even layer. (Reserve the bowl for later use.)",
      "secondary_message": "1 (454 g) pkg potato gnocchi\n1 ½ tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 416467,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until gnocchi is golden brown and mushrooms are tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 416468,
      "primary_message": "Meanwhile, place nutritional yeast, Dijon, vinegar, soy sauce, and maple syrup in the reserved bowl. Stir to combine the sauce.",
      "secondary_message": "⅛ cup nutritional yeast flakes\n2 tsp Dijon mustard\n2 tsp white wine vinegar\n2 tsp soy sauce\n1 tsp pure maple syrup"
    },
    {
      "id": 416469,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 416470,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 416471,
      "primary_message": "When the gnocchi is done, remove from the oven. Add the sauce, walnuts, arugula, and peas to the baking sheet; stir to combine and spread out in an even layer.",
      "secondary_message": "¾ cup frozen peas"
    },
    {
      "id": 416472,
      "primary_message": "Return baking sheet to the oven and continue to roast until the arugula is wilted and peas are warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 416473,
      "primary_message": "To serve, divide gnocchi bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
