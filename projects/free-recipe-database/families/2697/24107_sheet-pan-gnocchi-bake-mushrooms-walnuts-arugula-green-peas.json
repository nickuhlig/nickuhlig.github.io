  "instructions": [
    {
      "id": 416474,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 416475,
      "primary_message": "Wash, dry, and quarter mushrooms. Place in a large bowl.",
      "secondary_message": "0.68 kg cremini mushrooms"
    },
    {
      "id": 416476,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin strips. Peel and mince garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 416477,
      "primary_message": "Add gnocchi, oil, and spices to the bowl. Stir to combine, divide between two baking sheet pans, and spread out in an even layer. (Reserve the bowl for later use.)",
      "secondary_message": "2 (454 g) pkgs potato gnocchi\n3 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 416478,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until gnocchi is golden brown and mushrooms are tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 416479,
      "primary_message": "Meanwhile, place nutritional yeast, Dijon, vinegar, soy sauce, and maple syrup in the reserved bowl. Stir to combine the sauce.",
      "secondary_message": "¼ cup nutritional yeast flakes\n4 tsp Dijon mustard\n4 tsp white wine vinegar\n4 tsp soy sauce\n2 tsp pure maple syrup"
    },
    {
      "id": 416480,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "⅔ cup walnuts"
    },
    {
      "id": 416481,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "1 (142 g) pkg baby arugula"
    },
    {
      "id": 416482,
      "primary_message": "When the gnocchi is done, remove from the oven. Divide the sauce, walnuts, arugula, and peas to the baking sheets; stir to combine and spread out in an even layer.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 416483,
      "primary_message": "Return baking sheets to the oven and continue to roast until the arugula is wilted and peas are warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 416484,
      "primary_message": "To serve, divide gnocchi bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
