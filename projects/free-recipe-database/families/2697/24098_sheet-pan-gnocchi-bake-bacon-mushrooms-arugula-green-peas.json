  "instructions": [
    {
      "id": 416375,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 416376,
      "primary_message": "Wash, dry, and quarter mushrooms. Place in a large bowl.",
      "secondary_message": "1 ½ lb cremini mushrooms"
    },
    {
      "id": 416377,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin strips. Peel and mince garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 416378,
      "primary_message": "Small dice bacon and add to the bowl.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 416379,
      "primary_message": "Add gnocchi, oil, and spices to the bowl. Stir to combine, divide between two baking sheet pans, and spread out in an even layer.",
      "secondary_message": "2 (16 oz) pkgs potato gnocchi\n4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 416380,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until gnocchi is golden brown and bacon is crispy, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 416381,
      "primary_message": "Meanwhile, place Dijon, vinegar, Worcestershire, and honey in a small bowl. Stir to combine the sauce.",
      "secondary_message": "4 tsp Dijon mustard\n4 tsp white wine vinegar\n4 tsp Worcestershire sauce\n2 tsp honey"
    },
    {
      "id": 416382,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 416383,
      "primary_message": "When the gnocchi is done, remove from the oven. Divide the sauce, arugula, and peas between the baking sheets; stir to combine and spread out in an even layer.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 416384,
      "primary_message": "Return baking sheets to the oven and continue to roast until arugula is wilted and peas are warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 416385,
      "primary_message": "To serve, divide gnocchi bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
