  "instructions": [
    {
      "id": 416430,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 416431,
      "primary_message": "Wash, dry, and quarter mushrooms. Place in a medium bowl.",
      "secondary_message": "⅓ kg cremini mushrooms"
    },
    {
      "id": 416432,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin strips. Peel and mince garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 416433,
      "primary_message": "Small dice bacon and add to the bowl.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 416434,
      "primary_message": "Add gnocchi, oil, and spices to the bowl. Stir to combine, transfer to a large baking sheet pan, and spread out in an even layer.",
      "secondary_message": "1 (454 g) pkg potato gnocchi\n2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 416435,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until gnocchi is golden brown and bacon is crispy, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 416436,
      "primary_message": "Meanwhile, place Dijon, vinegar, Worcestershire, and honey in a small bowl. Stir to combine the sauce.",
      "secondary_message": "2 tsp Dijon mustard\n2 tsp white wine vinegar\n2 tsp Worcestershire sauce\n1 tsp honey"
    },
    {
      "id": 416437,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 416438,
      "primary_message": "When the gnocchi is done, remove from the oven. Add the sauce, arugula, and peas to the baking sheet; stir to combine and spread out in an even layer.",
      "secondary_message": "¾ cup frozen peas"
    },
    {
      "id": 416439,
      "primary_message": "Return baking sheet to the oven and continue to roast until arugula is wilted and peas are warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 416440,
      "primary_message": "To serve, divide gnocchi bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
