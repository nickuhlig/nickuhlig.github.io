  "instructions": [
    {
      "id": 223902,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 medium zucchini squash\n½ small bunch cilantro"
    },
    {
      "id": 223903,
      "primary_message": "Peel and mince garlic and ginger.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 223904,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 223905,
      "primary_message": "While the saucepan heats up, peel and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 223906,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add garlic, ginger, onion, chili-garlic sauce, and salt; cook, stirring occasionally, until onion begins to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\n1 tsp chili-garlic sauce\n½ tsp salt"
    },
    {
      "id": 223907,
      "primary_message": "Add broth, tomatoes, and coconut milk to the pan. Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, for 5 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes\n½ (13.5 fl oz) can coconut milk"
    },
    {
      "id": 223908,
      "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then slice crosswise into half rounds.",
      "secondary_message": null
    },
    {
      "id": 223909,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 223910,
      "primary_message": "Purée the soup with an immersion (hand) blender or regular blender. Return puréed soup to the pan and stir in zucchini, beans, and rice.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "id": 223911,
      "primary_message": "Bring soup to a boil over high heat, then reduce heat to low. Cover and simmer, stirring occasionally, until rice is tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 223912,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 223913,
      "primary_message": "To serve, divide soup between bowls and top with cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
