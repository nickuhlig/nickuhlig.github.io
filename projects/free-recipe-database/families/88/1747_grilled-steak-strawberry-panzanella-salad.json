  "instructions": [
    {
      "id": 15799,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat. Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 15800,
      "primary_message": "Cube bread.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 15801,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "0.68 kg ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 15802,
      "primary_message": "Coat grill or bottom of skillet with oil. Add to grill/skillet and cook until desired doneness, 2-5 minutes. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 15803,
      "primary_message": "Coat bottom of sauté pan with oil. Add bread cubes and, stirring occasionally, toast until golden brown, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 15804,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by whisking together garlic, olive oil, vinegar, honey, salt, and pepper.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 15805,
      "primary_message": "Wash and dry strawberries, cucumber, and basil. Trim stem ends, quarter, and add strawberries to bowl with dressing. Medium dice and add cucumber to bowl. Pick basil leaves off the stems; roll them up crosswise, thinly slice into ribbons, and add to bowl.",
      "secondary_message": "1 (454 g) pkg strawberries\r\n1 English cucumber\r\n1 small pkg fresh basil"
    },
    {
      "id": 15806,
      "primary_message": "Add bread cubes to bowl and toss to mix.",
      "secondary_message": ""
    },
    {
      "id": 15807,
      "primary_message": "To serve, place salad on a plate and crumble with goat cheese over top. Serve with steak on the side. Enjoy!",
      "secondary_message": "1 (113 g) log goat cheese"
    }
  ],
