  "instructions": [
    {
      "id": 389033,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 small pkgs grape tomatoes\n4 leeks\n1 small bunch Italian (flat-leaf) parsley\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 389034,
      "primary_message": "Peel and mince shallot. Place in a medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 389035,
      "primary_message": "Zest and juice lemon into the bowl with the shallot. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 389036,
      "primary_message": "Halve tomatoes lengthwise. Add half to the bowl with the dressing and set aside. Place remaining tomatoes in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 389037,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Add to the second bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 389038,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 389039,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tomatoes, leeks, salt, and pepper; cook, stirring occasionally, until veggies start to soften and brown, about 8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 389040,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 389041,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the parsley. ",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 389042,
      "primary_message": "Add eggs, salt, and pepper to the bowl. Whisk to combine and set aside.",
      "secondary_message": "12 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 389043,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 389044,
      "primary_message": "When the veggies are done, reduce heat to medium and pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 389045,
      "primary_message": "Place skillet in the oven and broil until the top is set, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 389046,
      "primary_message": "Meanwhile, add arugula and pine nuts to the bowl with the dressing and tomatoes. Toss to combine the salad.",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 389047,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
