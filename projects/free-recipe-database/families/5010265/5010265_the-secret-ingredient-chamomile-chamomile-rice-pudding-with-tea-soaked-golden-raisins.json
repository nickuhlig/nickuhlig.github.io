  "instructions": [
    {
      "id": 1,
      "primary_message": "Start as though you were making a risotto. In two separate pots, heat the water and the milk. Place the chamomile flowers (not the tea bags) in the water, and allow to steep for at least ten minutes. Strain the flowers out, and return the chamomile water to the pan to keep warm.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Melt the butter in a wide pan with sides over medium low heat. Add the rice, and stir to coat, cooking for just a minute in the butter until the rice turns translucent.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Use a ladle to add the water bit by bit to the rice, adding more only as it is absorbed, and stirring continuously. Once you have used all the water, switch to milk, and continue to stir.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Meanwhile, brew a cup of chamomile tea with the tea bag. Place the golden raisins in the tea to rehydrate.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Once most of the milk has been used, and the pudding has reached a thick, porridge-like texture, add the sugar and stir it in to melt over the heat. Add the pinch of salt as well.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Take the pan off the heat. Stir in a splash of cream to finish, and serve hot, in separate bowls or ramekins. Strain the golden raisins out of the tea, and top the pudding with them. Serve with honey alongside.",
      "secondary_message": null
    }
  ],
