  "instructions": [
    {
      "id": 564069,
      "primary_message": "Wash, dry, trim, and roughly chop strawberries. Place in a small saucepan.",
      "secondary_message": "½ (16 oz) pkg strawberries"
    },
    {
      "id": 564070,
      "primary_message": "Wash, dry, and juice lemon into the pan with the strawberries. Add honey, cardamom, and salt, then bring to a simmer over medium-high heat. Once simmering, reduce heat to medium and cook, stirring occasionally, until compote is thickened slightly, 5-6 minutes. Remove from heat.",
      "secondary_message": "½ lemon\n1 tbsp honey\n¼ tsp cardamom, ground\n1 pinch salt"
    },
    {
      "id": 564071,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the pita.)",
      "secondary_message": null
    },
    {
      "id": 564072,
      "primary_message": "Place cottage cheese in a strainer to remove excess liquid. Set aside to drain further.",
      "secondary_message": "1 cup cottage cheese"
    },
    {
      "id": 564073,
      "primary_message": "Arrange pita breads on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes. Remove from oven. (Alternatively, you can use a toaster for the pita breads.)",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 564074,
      "primary_message": "Spread pita with drained cottage cheese, top with strawberry compote, and cut into wedges (if desired).",
      "secondary_message": null
    },
    {
      "id": 564075,
      "primary_message": "To serve, divide pita breads between plates and drizzle with honey. Enjoy!",
      "secondary_message": "2 tsp honey"
    }
  ],
