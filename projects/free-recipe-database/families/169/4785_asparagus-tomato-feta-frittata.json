  "instructions": [
    {
      "id": 58448,
      "primary_message": "Preheat oven to broil.",
      "secondary_message": ""
    },
    {
      "id": 58449,
      "primary_message": "Peel and mince garlic. Wash asparagus and snap off woody ends. Cut diagonally into 2 inch pieces. Wash and medium dice tomatoes.",
      "secondary_message": "6 cloves garlic\n3 small bunches asparagus\n3 tomatoes"
    },
    {
      "id": 58450,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 58451,
      "primary_message": "In a medium bowl, whisk together eggs, water, dill, salt, and pepper. Set aside.",
      "secondary_message": "18 eggs\n¾ cup water\n1 ½ tsp dill\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 58452,
      "primary_message": "Coat bottom of skillet with oil. Add garlic and cook until fragrant, 15-30 seconds. Add asparagus and cook until tender crisp, 2-3 minutes.",
      "secondary_message": "about 3 tbsp extra virgin olive oil"
    },
    {
      "id": 58453,
      "primary_message": "Add tomato and cook for another 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 58454,
      "primary_message": "Pour in egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 8-10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 58456,
      "primary_message": "Sprinkle feta over top. Place skillet in the oven under the broiler until the top is set, 2-3 minutes.",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 58455,
      "primary_message": "To serve, cut frittata into wedges and place on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
