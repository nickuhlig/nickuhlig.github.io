  "instructions": [
    {
      "id": 217592,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add almond milk, sugar, and vanilla; stir to combine and bring the mixture to a simmer over medium heat.",
      "secondary_message": "1 cup jasmine rice\n16 fl oz (2 cups) almond milk, unsweetened\n¼ cup brown sugar\n2 tsp vanilla extract"
    },
    {
      "id": 217593,
      "primary_message": "Once the liquid comes to a simmer, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 217594,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 Gala apples\n2 (1 inch) pieces ginger root\n1 orange"
    },
    {
      "id": 217595,
      "primary_message": "Quarter, core, and medium dice apples.",
      "secondary_message": null
    },
    {
      "id": 217596,
      "primary_message": "Peel and mince ginger. ",
      "secondary_message": null
    },
    {
      "id": 217597,
      "primary_message": "Preheat another medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 217598,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add apples, ginger, cranberries, sugar, cinnamon, and salt to the saucepan; stir to combine.",
      "secondary_message": "2 tsp virgin coconut oil\n½ cup dried cranberries\n¼ cup brown sugar\n½ tsp cinnamon\n⅛ tsp salt"
    },
    {
      "id": 217599,
      "primary_message": "Juice orange into the pan with the fruit and stir to combine. Cook, stirring occasionally, until apples are tender and the sauce has thickened, 5-6 minutes. Remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 217600,
      "primary_message": "Once the rice is done, remove from the heat. Add additional almond milk, stir to combine, and let it stand, still covered, for 5 minutes.",
      "secondary_message": "8 fl oz (1 cup) almond milk, unsweetened"
    },
    {
      "id": 217601,
      "primary_message": "To serve, divide rice pudding between bowls and top with fruit compote. Enjoy! ",
      "secondary_message": null
    }
  ],
