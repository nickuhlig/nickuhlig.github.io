  "instructions": [
    {
      "id": 217552,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add milk, sugar, and vanilla; stir to combine and bring the mixture to a simmer over medium heat.",
      "secondary_message": "½ cup jasmine rice\n8 fl oz (1 cup) whole milk\n2 tbsp brown sugar\n1 tsp vanilla extract"
    },
    {
      "id": 217553,
      "primary_message": "Once the liquid comes to a simmer, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 217554,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 Gala apple\n1 (1 inch) piece ginger root\n½ orange"
    },
    {
      "id": 217555,
      "primary_message": "Quarter, core, and medium dice apple.",
      "secondary_message": null
    },
    {
      "id": 217556,
      "primary_message": "Peel and mince ginger. ",
      "secondary_message": null
    },
    {
      "id": 217557,
      "primary_message": "Preheat another small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 217558,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add apple, ginger, cranberries, sugar, cinnamon, and salt to the saucepan; stir to combine.",
      "secondary_message": "1 tsp butter, unsalted\n¼ cup dried cranberries\n2 tbsp brown sugar\n¼ tsp cinnamon\n1 pinch salt"
    },
    {
      "id": 217559,
      "primary_message": "Juice orange into the pan with the fruit and stir to combine. Cook, stirring occasionally, until apples are tender and the sauce has thickened, 5-6 minutes. Remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 217560,
      "primary_message": "Once the rice is done, remove from the heat. Add cream, stir to combine, and let it stand, still covered, for 5 minutes.",
      "secondary_message": "4 fl oz (½ cup) heavy cream"
    },
    {
      "id": 217561,
      "primary_message": "To serve, divide rice pudding between bowls and top with fruit compote. Enjoy! ",
      "secondary_message": null
    }
  ],
