  "instructions": [
    {
      "id": 217632,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add milk, sugar, and vanilla; stir to combine and bring the mixture to a simmer over medium heat.",
      "secondary_message": "1 ½ cups jasmine rice\n710 ml whole milk\n⅓ cup brown sugar\n1 tbsp vanilla extract"
    },
    {
      "id": 217633,
      "primary_message": "Once the liquid comes to a simmer, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 217634,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 Gala apples\n3 (2 ½ cm) pieces ginger root\n1 ½ oranges"
    },
    {
      "id": 217635,
      "primary_message": "Quarter, core, and medium dice apples.",
      "secondary_message": null
    },
    {
      "id": 217636,
      "primary_message": "Peel and mince ginger. ",
      "secondary_message": null
    },
    {
      "id": 217637,
      "primary_message": "Preheat another medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 217638,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add apples, ginger, cranberries, sugar, cinnamon, and salt to the saucepan; stir to combine.",
      "secondary_message": "1 tbsp butter, unsalted\n¾ cup dried cranberries\n⅓ cup brown sugar\n¾ tsp cinnamon\n3 pinch salt"
    },
    {
      "id": 217639,
      "primary_message": "Juice oranges into the pan with the fruit and stir to combine. Cook, stirring occasionally, until apples are tender and the sauce has thickened, 6-7 minutes. Remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 217640,
      "primary_message": "Once the rice is done, remove from the heat. Add cream, stir to combine, and let it stand, still covered, for 5 minutes.",
      "secondary_message": "355 ml heavy cream"
    },
    {
      "id": 217641,
      "primary_message": "To serve, divide rice pudding between bowls and top with fruit compote. Enjoy! ",
      "secondary_message": null
    }
  ],
