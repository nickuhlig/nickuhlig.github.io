  "instructions": [
    {
      "id": 295303,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 yellow bell peppers\n3 oranges\n3 grapefruits\n1 ½ avocados\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 295304,
      "primary_message": "Zest lemons into a medium saucepan (set lemons aside for later use).",
      "secondary_message": null
    },
    {
      "id": 295305,
      "primary_message": "Add quinoa and broth to the saucepan with the zest, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 295306,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 295307,
      "primary_message": "Juice the lemons into a large bowl, then add oil, Dijon, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp Dijon mustard\n2 tbsp pure maple syrup\n1 ½ tsp garlic powder\n¾ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 295308,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 295309,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 295310,
      "primary_message": "Cut off skin and white pith from the oranges and grapefruits. Slice between the membranes to release segments; cut into bite-sized pieces and add both to the bowl, along with the beans. Stir to combine and set aside.",
      "secondary_message": null
    },
    {
      "id": 295311,
      "primary_message": "Transfer the cooked quinoa to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 295312,
      "primary_message": "Meanwhile, halve and pit avocados; scoop the flesh out with a spoon and medium dice. Add to the bowl with the dressing and citrus fruit.",
      "secondary_message": null
    },
    {
      "id": 295313,
      "primary_message": "Add cooled quinoa to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 295314,
      "primary_message": "To serve, divide spinach between plates and top with salad. Enjoy!",
      "secondary_message": null
    }
  ],
