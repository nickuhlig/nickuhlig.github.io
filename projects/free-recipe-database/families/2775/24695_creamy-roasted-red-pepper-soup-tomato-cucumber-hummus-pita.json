  "instructions": [
    {
      "id": 425293,
      "primary_message": "This recipe will make about 8 cups of soup; work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 425294,
      "primary_message": "Peel garlic and place in a blender.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 425295,
      "primary_message": "Drain roasted peppers. Add to the blender along with broth, cream, salt, and pepper. Blend the soup on high until smooth, 1-2 minutes.",
      "secondary_message": "2 (12 oz) jars roasted red bell peppers\n32 fl oz (4 cups) chicken or vegetable broth\n8 fl oz (1 cup) heavy whipping cream\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 425296,
      "primary_message": "Pour soup into a large pot and bring to a simmer over medium-high heat, stirring occasionally. Once simmering, remove from heat.",
      "secondary_message": null
    },
    {
      "id": 425297,
      "primary_message": "Meanwhile, wash, dry, and thinly slice tomatoes. Place on a plate.",
      "secondary_message": "4 tomatoes"
    },
    {
      "id": 425298,
      "primary_message": "Wash, dry, trim, and slice cucumber crosswise into thin rounds. Add to the plate with the tomato, then season with salt and pepper.",
      "secondary_message": "1 English cucumber\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 425299,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread each pocket with hummus, then stuff with tomato and cucumber slices.",
      "secondary_message": "4 whole grain pitas\n1 cup hummus"
    },
    {
      "id": 425300,
      "primary_message": "Divide soup between bowls and sprinkle with Parmesan; serve with pita pockets on the side. Enjoy!",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
