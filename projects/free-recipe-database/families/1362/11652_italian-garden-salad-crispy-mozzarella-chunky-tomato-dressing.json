  "instructions": [
    {
      "id": 196685,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ heads romaine lettuce\n3 English cucumbers\n1 small pkg fresh basil\n3 tomatoes"
    },
    {
      "id": 196686,
      "primary_message": "Chop or tear the lettuce into bite-sized pieces and transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 196687,
      "primary_message": "Trim cucumbers, quarter lengthwise, then slice crosswise into ¼-inch-thick pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196688,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196689,
      "primary_message": "Peel and thinly slice shallots into rings; add to the bowl. ",
      "secondary_message": "3 shallots"
    },
    {
      "id": 196690,
      "primary_message": "Drain and halve artichokes. Halve olives lengthwise. Add both to the bowl and toss to combine the salad; set aside.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated\n¾ cup Kalamata olives, pitted"
    },
    {
      "id": 196691,
      "primary_message": "Whisk eggs in a medium bowl. Place flour and bread crumbs on two separate plates. ",
      "secondary_message": "3 eggs\n¾ cup all-purpose flour\n1 ½ cup panko bread crumbs"
    },
    {
      "id": 196692,
      "primary_message": "Slice mozzarella into ½-inch thick rounds and pat dry with paper towels; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 196693,
      "primary_message": "Dredge mozzarella slices in flour, shake off excess, then dip into the bowl with the egg. Let the excess drip off, then dredge in the bread crumbs, pressing gently to adhere.",
      "secondary_message": null
    },
    {
      "id": 196694,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196695,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, carefully place breaded mozzarella in the skillet and cook, flipping once, until golden brown, 2-3 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 196696,
      "primary_message": "Meanwhile, small dice tomatoes and place in a medium bowl. Use a potato masher or fork to crush the tomatoes and release their juices.",
      "secondary_message": null
    },
    {
      "id": 196697,
      "primary_message": "Add oil, vinegar, and spices to the bowl with the tomatoes and whisk to combine the vinaigrette.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 196698,
      "primary_message": "To serve, divide salad between plates or bowls; top with crispy mozzarella and drizzle with vinaigrette. Enjoy!",
      "secondary_message": null
    }
  ],
