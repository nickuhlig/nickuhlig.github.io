  "instructions": [
    {
      "id": 196657,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ head romaine lettuce\n1 English cucumber\n½ small pkg fresh basil\n1 tomato"
    },
    {
      "id": 196658,
      "primary_message": "Chop or tear the lettuce into bite-sized pieces and transfer to a salad bowl.",
      "secondary_message": null
    },
    {
      "id": 196659,
      "primary_message": "Trim cucumber, quarter lengthwise, then slice crosswise into ¼-inch-thick pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196660,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196661,
      "primary_message": "Peel and thinly slice shallot into rings; add to the bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 196662,
      "primary_message": "Drain and halve artichokes. Halve olives lengthwise. Add both to the bowl and toss to combine the salad; set aside.",
      "secondary_message": "½ (170 ml) jar artichoke hearts, marinated\n¼ cup Kalamata olives, pitted"
    },
    {
      "id": 196663,
      "primary_message": "Whisk egg in a small bowl. Place flour and bread crumbs on two separate plates. ",
      "secondary_message": "1 egg\n¼ cup all-purpose flour\n½ cup panko bread crumbs"
    },
    {
      "id": 196664,
      "primary_message": "Slice mozzarella into ½-inch thick rounds and pat dry with paper towels; season with salt and pepper on both sides.",
      "secondary_message": "½ (227 g) pkg fresh mozzarella cheese\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 196665,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196666,
      "primary_message": "Dredge mozzarella slices in flour, shake off excess, then dip into the bowl with the egg. Let the excess drip off, then dredge in the bread crumbs, pressing  gently to adhere.",
      "secondary_message": null
    },
    {
      "id": 196667,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Carefully place breaded mozzarella in the skillet and cook, flipping once, until golden brown, 2-4 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 196668,
      "primary_message": "Meanwhile, small dice tomato and place in a small bowl. Use a potato masher or fork to crush the tomatoes and release their juices.",
      "secondary_message": null
    },
    {
      "id": 196669,
      "primary_message": "Add oil, vinegar, and spices to the bowl with the tomatoes and whisk to combine the vinaigrette.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp Italian seasoning\n⅛ tsp garlic powder\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 196670,
      "primary_message": "To serve, divide salad between plates or bowls; top with crispy mozzarella and drizzle with vinaigrette. Enjoy!",
      "secondary_message": null
    }
  ],
