  "instructions": [
    {
      "id": 173248,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n1 green bell pepper"
    },
    {
      "id": 173249,
      "primary_message": "Small dice the tomatoes and green pepper; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 173250,
      "primary_message": "Halve the olives lengthwise and add to the bowl with the tomatoes and bell pepper.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 173251,
      "primary_message": "Peel and mince the shallot; add to the bowl along with the olive oil, oregano, and pepper. Stir to combine.",
      "secondary_message": "1 shallot\n2 tsp extra virgin olive oil\n½ tsp oregano\n⅛ tsp black pepper"
    },
    {
      "id": 173252,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 173253,
      "primary_message": "Crack the eggs into a medium bowl. Add water and season with salt and pepper; whisk together.",
      "secondary_message": "8 eggs\n2 tbsp water\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 173254,
      "primary_message": "Add oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 173255,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove skillet from the heat.",
      "secondary_message": null
    },
    {
      "id": 173256,
      "primary_message": "Place tortillas on a flat surface and top with egg mixture, mixed vegetables, and feta. Tightly roll to close and enjoy! ",
      "secondary_message": "4 large flour tortillas\n½ (113 g) pkg crumbled feta cheese"
    }
  ],
