  "instructions": [
    {
      "id": 1,
      "primary_message": "Chop reserved turkey neck, gizzards, and trimmings into 2.5-cm chunks with a cleaver. Heat oil in a medium saucepan over medium-high heat until shimmering. Add turkey parts, onion, carrot, and celery and cook, stirring occasionally, until well browned, about 10 minutes total. Add stock, soy sauce, Marmite (if using), herbs, and bay leaves. Bring to a boil, then reduce to a simmer. Simmer for 1 hour, then strain through a fine-mesh strainer. Add any drippings from the roast turkey, then skim off excess fat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "You should have a little over 1 quart of fortified stock; if not, add water or more chicken stock to equal 1 quart. Discard solids and set stock aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Melt butter in a medium saucepan over medium heat. Add flour and cook, stirring constantly, until golden brown, about 3 minutes. Whisking constantly, add fortified broth in a thin, steady stream. Bring to a boil, reduce to a simmer, and cook until thickened and reduced to about 3 cups. Season to taste with salt and pepper. Gravy can be made up to 5 days in advance and stored in the refrigerator.",
      "secondary_message": null
    }
  ],
