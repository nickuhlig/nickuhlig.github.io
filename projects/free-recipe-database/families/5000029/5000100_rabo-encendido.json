  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim, rinse, and pat the oxtails dry. Mince the yellow onions. Stem, seed, and mince the green bell pepper. Stem, seed, and mince the red bell pepper. Mince the garlic.",
      "secondary_message": "1.81 kg oxtails\n2 medium yellow onions\n1 green bell pepper\n1 red bell pepper\n6 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 150°C (300°F) and set rack in middle position. Season oxtails all over with salt. In a large Dutch oven, heat 1 tablespoon olive oil over high heat until shimmering. Working in batches to avoid overcrowding the pan, cook oxtails until lightly browned all over, about 2 minutes per side. Transfer oxtails to plate, then repeat with remaining oil and oxtails. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Reduce heat to medium. Add onions, green and red bell peppers, and garlic. Season lightly with salt, then cook, stirring frequently to prevent browning, until vegetables have softened and onions are translucent, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Increase heat to medium-high, stir in tomato paste, and cook, stirring, for 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Return oxtails to Dutch oven along with any accumulated juices. Add wine, bay leaves, cloves, sazón, oregano, cumin, black pepper, and cayenne, mixing until everything is incorporated. Bring to a boil, cover partially with lid, then transfer to oven and cook until oxtails are tender and starting to fall off the bone, about 3 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Return Dutch oven to stovetop, uncover, and cook over high heat, stirring frequently, until the sauce reduces and thickens enough to coat the back of a spoon, about 30 minutes. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Serve immediately with rice and maduros.",
      "secondary_message": null
    }
  ],
