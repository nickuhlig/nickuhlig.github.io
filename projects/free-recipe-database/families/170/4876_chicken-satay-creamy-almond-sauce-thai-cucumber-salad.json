  "instructions": [
    {
      "id": 59377,
      "primary_message": "Peel and mince ginger. In a large bowl, whisk together ginger, almond butter, water, vinegar, coconut aminos, honey, lime juice, turmeric, and crushed red pepper. Transfer ½ of mixture to a medium bowl (to use as sauce) and set aside.",
      "secondary_message": "3 (2 ½ cm) pieces ginger\n9 tbsp natural almond butter\n6 tbsp warm water\n6 tbsp rice vinegar\n4 ½ tbsp coconut aminos\n1 ½ tbsp honey\n1 ½ limes\n3 tsp turmeric\n⅜ tsp crushed red pepper"
    },
    {
      "id": 59376,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Add ½ (save the rest for the salad) to the large bowl.",
      "secondary_message": "1 ½ small bunches cilantro"
    },
    {
      "id": 59375,
      "primary_message": "Cut chicken into bite-sized pieces. Add to large bowl and toss to coat.",
      "secondary_message": "1.362 kg chicken thighs, boneless skinless"
    },
    {
      "id": 59374,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 59373,
      "primary_message": "Thread chicken onto 18 skewers and place on a plate. Alternatively, you can cook the chicken pieces directly on the grill/skillet without using skewers.",
      "secondary_message": ""
    },
    {
      "id": 59372,
      "primary_message": "Coat grill or bottom of skillet with oil. Add skewers and cook until chicken is cooked through but still juicy, 3-4 minutes per side.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 59371,
      "primary_message": "In a large bowl, prepare salad dressing by whisking together remaining cilantro, lime juice, vinegar, coconut aminos, honey, and crushed red pepper.",
      "secondary_message": "1 ½ limes\n6 tbsp rice vinegar\n3 tbsp coconut aminos\n3 tbsp honey\n⅜ tsp crushed red pepper"
    },
    {
      "id": 59370,
      "primary_message": "Peel and thinly slice onion. Wash, trim ends, halve lengthwise, and thinly slice cucumbers into half rounds. Add everything to bowl with dressing and toss.",
      "secondary_message": "1 ½ medium red onion\n6 English cucumbers"
    },
    {
      "id": 59369,
      "primary_message": "To serve, place chicken skewers on a plate, add salad, and have with almond sauce on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
