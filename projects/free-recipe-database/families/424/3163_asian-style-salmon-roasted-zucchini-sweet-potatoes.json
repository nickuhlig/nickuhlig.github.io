  "instructions": [
    {
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n½ small bunch green onions (scallions)\n1 (1 inch) piece ginger root"
    },
    {
      "primary_message": "Peel and medium dice the sweet potatoes into ½-inch cubes; transfer to a large baking sheet.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and discard the ends of the zucchini; medium dice the zucchini into ½-inch cubes and add to the baking sheet.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince the garlic; sprinkle over the vegetables.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Drizzle the vegetables with olive oil and season with salt and pepper; toss to coat, then arrange in a single layer.",
      "secondary_message": "extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place the vegetables in the oven (even if it is not fully heated yet) and cook for 10 minutes while you prepare the salmon.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince or grate the ginger; transfer to a medium bowl (that can hold the salmon).",
      "secondary_message": null
    },
    {
      "primary_message": "Add soy sauce, olive oil, sesame oil, and honey to the ginger; whisk together.",
      "secondary_message": "1 tbsp tamari soy sauce\nextra virgin olive oil\n½ tsp toasted sesame oil\n½ tsp honey"
    },
    {
      "primary_message": "Place the salmon in the bowl and coat with the sauce.",
      "secondary_message": "¾ lb salmon fillet"
    },
    {
      "primary_message": "Take the baking sheet out of the oven and move the vegetables to the sides of the tray; place the salmon, skin-side-down, in the middle of the tray and pour any remaining marinade overtop.",
      "secondary_message": null
    },
    {
      "primary_message": "Return the tray to the oven and bake until the salmon is cooked through and the vegetables are tender, another 10 to 12 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "While the vegetables and salmon cook, trim and discard the ends of the green onions; chop the onions on an angle into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, place the roasted vegetables and salmon on a plate and sprinkle with the green onions and sesame seeds.",
      "secondary_message": "½ tsp sesame seeds"
    }
  ],
