  "instructions": [
    {
      "id": 92182,
      "primary_message": "Peel and slice the onions into thin half rings.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 92183,
      "primary_message": "Wash and dry the pineapples. Cut skin off pineapples, core, and cut into bite-sized pieces.",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 92184,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 ½ (398 ml) cans black beans"
    },
    {
      "id": 92185,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 92186,
      "primary_message": "In a medium bowl, combine garlic, tomato sauce, and spices. Stir to combine and set aside.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n½ tsp crushed red pepper\n½ tsp paprika\n½ tsp onion powder\n½ tsp black pepper"
    },
    {
      "id": 92187,
      "primary_message": "Preheat oven to broil.",
      "secondary_message": null
    },
    {
      "id": 92188,
      "primary_message": "Grate the mozzarella.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 92189,
      "primary_message": "To assemble, top the pitas with a thin layer of tomato sauce, cheese, red onion, pineapple, and black beans. Place on a baking sheet and cook in the oven for 2-3 minutes, until the cheese melts. Cook in batches if necessary.",
      "secondary_message": "12 whole grain pitas"
    },
    {
      "id": 92190,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems.",
      "secondary_message": "1 ½ small bunches cilantro"
    },
    {
      "id": 92191,
      "primary_message": "Remove from oven and top with cilantro leaves. Enjoy!",
      "secondary_message": null
    }
  ],
