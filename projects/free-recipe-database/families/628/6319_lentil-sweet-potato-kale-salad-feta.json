  "instructions": [
    {
      "id": 77040,
      "primary_message": "Rinse the lentils, then transfer to a small saucepan and cover with hot water (from the tap) by about 5 cm; season with salt and pepper. Bring to a boil over high heat.",
      "secondary_message": "1 ½ cups green lentils\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 77039,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n1 ½ bunch kale\n1 ½ lemon"
    },
    {
      "id": 77038,
      "primary_message": "Juice the lemons into a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 77037,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the lemon juice.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 77036,
      "primary_message": "Once the water in the saucepan is boiling, reduce the heat to a simmer and cook the lentils until they are just tender, 15 to 18 minutes. Drain in a colander, then set aside to cool and drain further.",
      "secondary_message": ""
    },
    {
      "id": 77035,
      "primary_message": "To the lemon juice and garlic, add olive oil, Dijon, maple syrup, cumin, salt, and pepper; whisk together.",
      "secondary_message": "4 ½ tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n1 ½ tsp pure maple syrup\n1 ½ tsp cumin\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 77034,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 77033,
      "primary_message": "Trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 77032,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 77031,
      "primary_message": "Add the shallots to the skillet; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 77030,
      "primary_message": "While the shallots cook, peel and medium dice the sweet potatoes into 1 ¼-cm cubes.",
      "secondary_message": ""
    },
    {
      "id": 77029,
      "primary_message": "Add the sweet potatoes to the skillet; cook, stirring occasionally, until the potatoes are tender, 6 to 8 minutes.",
      "secondary_message": ""
    },
    {
      "id": 77028,
      "primary_message": "While the potatoes cook, cut out and discard the kale stems; chop the leaves into 2 ½-cm pieces.",
      "secondary_message": ""
    },
    {
      "id": 77027,
      "primary_message": "Add the kale to the skillet; cook, tossing with the potatoes, until it is softened, 2 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 77026,
      "primary_message": "Transfer the feta to a small bowl.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 77025,
      "primary_message": "Transfer the potatoes and kale to a large salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77024,
      "primary_message": "Add the lentils to the salad bowl. Pour the dressing over the salad and toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 77023,
      "primary_message": "To serve, divide the salad between dishes and top with the feta. Enjoy!",
      "secondary_message": ""
    }
  ],
