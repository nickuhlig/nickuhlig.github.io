  "instructions": [
    {
      "id": 51910,
      "primary_message": "Rinse the lentils, then transfer to a small saucepan and cover with hot water (from the tap) by about 5 cm; season with salt and pepper. Bring to a boil over high heat.",
      "secondary_message": "½ cup green lentils\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 51911,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.34 kg sweet potatoes\n½ bunch kale\n½ lemon"
    },
    {
      "id": 51912,
      "primary_message": "Juice the lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 51913,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add to the lemon juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 51914,
      "primary_message": "Once the water in the saucepan is boiling, reduce the heat to a simmer and cook the lentils until they are just tender, 15 to 18 minutes. Drain in a colander, then set aside to cool and drain further.",
      "secondary_message": null
    },
    {
      "id": 51915,
      "primary_message": "To the lemon juice and garlic, add olive oil, Dijon, maple syrup, cumin, salt, and pepper; whisk together.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tsp Dijon mustard\n½ tsp pure maple syrup\n½ tsp cumin\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 51916,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 51917,
      "primary_message": "Trim off and discard the ends of the shallot; peel and halve the shallot lengthwise, then thinly slice crosswise into half-rounds.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 51918,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 51919,
      "primary_message": "Add the shallot to the skillet; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 51920,
      "primary_message": "While the shallot cooks, peel and medium dice the sweet potatoes into 1 ¼-cm cubes.",
      "secondary_message": null
    },
    {
      "id": 51921,
      "primary_message": "Add the sweet potatoes to the skillet; cook, stirring occasionally, until the potatoes are tender, 6 to 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 51922,
      "primary_message": "While the potatoes cook, cut out and discard the kale stems; chop the leaves into 2 ½-cm pieces.",
      "secondary_message": null
    },
    {
      "id": 51923,
      "primary_message": "Add the kale to the skillet; cook, tossing with the potatoes, until it is softened, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 51925,
      "primary_message": "Transfer the potatoes and kale to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 51926,
      "primary_message": "Add the lentils to the salad bowl. Pour the dressing over the salad and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 51927,
      "primary_message": "To serve, divide the salad between dishes. Enjoy!",
      "secondary_message": null
    }
  ],
