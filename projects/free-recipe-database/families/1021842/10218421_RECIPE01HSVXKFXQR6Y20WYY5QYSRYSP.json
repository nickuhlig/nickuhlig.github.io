  "instructions": [
    {
      "primary_message": "Cook the rice according to the package directions. While the rice is cooking, heat 1 tablespoon oil in a 12-inch skillet over medium heat. Add the garlic, broccoli and mushrooms and cook until the broccoli is tender-crisp, stirring occasionally. Remove the vegetables from the skillet.",
      "secondary_message": null
    },
    {
      "primary_message": "Season the chicken as desired. Heat the remaining 1 tablespoon oil in the skillet over medium-high heat. Add the chicken and cook until well browned, stirring often. Remove the chicken from the skillet. Add the wine to the skillet and heat to a boil, stirring to scrape up the browned bits from the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "primary_message": "Stir in the soup, 1/4 cup water and mustard – heat to a boil. Return the vegetables and chicken to the skillet. Reduce heat to low. Cover and cook for 5 minutes or until the chicken is cooked through. Season to taste. Serve the chicken mixture with hot cooked rice.",
      "secondary_message": null
    }
