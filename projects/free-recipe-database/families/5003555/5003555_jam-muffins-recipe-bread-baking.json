  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the oven to 375 degrees and spray 12 standard-sized muffin tins with baking spray, or line them with paper liners. Combine the flours, baking powder, and salt in a medium bowl. Whisk to combine.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a separate bowl, combine the milk, vegetable oil, vanilla, egg, and honey. Whisk to combine, making sure the honey is fully dissolved.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the wet ingredients to the dry and stir just enough to combine. It will be lumpy. Add the jam, and fold the mixture a few times to distribute it, but leave the mixture streaky. Portion the mixture evenly into the muffin tins.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bake at 375 degrees until the muffins are browned on top and a toothpick inserted in the center of the muffins comes out clean, about 20 minutes.Remove the muffins from the pan and cool completely on a rack.",
      "secondary_message": null
    }
  ],
