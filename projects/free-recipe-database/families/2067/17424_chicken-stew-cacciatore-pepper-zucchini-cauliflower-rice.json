  "instructions": [
    {
      "id": 282923,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 medium zucchini squash\n1 medium head cauliflower\n1 small pkg fresh basil"
    },
    {
      "id": 282924,
      "primary_message": "Peel, halve, and thinly slice onion; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 282925,
      "primary_message": "Trim, seed, and medium dice bell peppers; trim and quarter zucchini lengthwise, then cut crosswise into ¼-inch thick pieces. Add both to the bowl with the onion and garlic; set aside. ",
      "secondary_message": null
    },
    {
      "id": 282926,
      "primary_message": "Cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower; place in a large bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 282927,
      "primary_message": "Cut the chicken into bite-sized pieces. Sprinkle with cornstarch and season with spices on both sides. ",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n2 tbsp cornstarch\n2 tsp Italian seasoning\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 282928,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 282929,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until golden, 3-4 minutes. (The chicken will not be cooked all the way through.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 282930,
      "primary_message": "Add onion, garlic, bell pepper, zucchini, and spices to the pot with the chicken; continue to cook, stirring occasionally, until veggies soften, 3-4 minutes.",
      "secondary_message": "1 tsp thyme, dried\n1 tsp rosemary, dried\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 282931,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop olives. ",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 282932,
      "primary_message": "When the veggies are done, add olives, tomatoes, and broth to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until stew has thickened and chicken is cooked through, 6-8 minutes more. ",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 282933,
      "primary_message": "While the stew is simmering, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 282934,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower and salt; cook, stirring often, until cauliflower is lightly golden and cooked through, 5-7 minutes. Remove from heat. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 282935,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 282936,
      "primary_message": "When the stew is done, add half of the basil to the pot; stir to combine and remove from heat. (Reserve remaining basil for garnish.)",
      "secondary_message": null
    },
    {
      "id": 282937,
      "primary_message": "To serve, divide cauliflower rice and chicken stew between bowls; top with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
