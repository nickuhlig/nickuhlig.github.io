  "instructions": [
    {
      "id": 282953,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 282954,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 medium zucchini squash\n½ small pkg fresh basil"
    },
    {
      "id": 282955,
      "primary_message": "Peel, halve, and thinly slice onion; peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 282956,
      "primary_message": "Trim, seed, and medium dice bell pepper; trim and quarter zucchini lengthwise, then cut crosswise into ¼-inch thick pieces. Add both to the bowl with the onion and garlic; set aside. ",
      "secondary_message": null
    },
    {
      "id": 282957,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 282958,
      "primary_message": "While the pan heats up, cut the chicken into bite-sized pieces. Sprinkle with cornstarch and season with spices on both sides. ",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n1 tbsp cornstarch\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 282959,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until golden, 3-4 minutes. (The chicken will not be cooked all the way through.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 282960,
      "primary_message": "Add veggies and spices to the pan with the chicken; continue to cook, stirring occasionally, until veggies soften, 3-4 minutes.",
      "secondary_message": "1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 282961,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop olives. ",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 282962,
      "primary_message": "When the veggies are done, add tomatoes, broth, and olives to the pan; stir to combine and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until stew has thickened and chicken is cooked through, 6-8 minutes more. ",
      "secondary_message": "1 (398 ml) can diced tomatoes\n118 ml (½ cup) chicken or vegetable broth"
    },
    {
      "id": 282963,
      "primary_message": "While the stew is simmering, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 282964,
      "primary_message": "When the stew is done, add half of the basil to the pan; stir to combine and remove from heat. (Reserve remaining basil for garnish.)",
      "secondary_message": null
    },
    {
      "id": 282965,
      "primary_message": "To serve, divide quinoa and chicken stew between bowls; top with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
