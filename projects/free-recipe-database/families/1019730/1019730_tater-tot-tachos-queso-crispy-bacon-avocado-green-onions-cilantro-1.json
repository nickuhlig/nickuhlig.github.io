  "instructions": [
    {
      "primary_message": "Preheat oven to 475°F. Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer tater tots to the baking sheet. Sprinkle with taco seasoning, toss to coat, then spread out in an even layer. ",
      "secondary_message": "1 (32 oz) bag tater tots or puffs, frozen\n1 ½ tbsp taco seasoning"
    },
    {
      "primary_message": "Once heated, place tater tots in the oven and bake, tossing once, until golden brown and crispy, about 20 minutes (or cook according to package instructions).",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pot heats up, medium dice bacon.",
      "secondary_message": "12 slice bacon"
    },
    {
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Wipe the pot clean with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "primary_message": "Using a clean cutting board, medium dice cheese, then place in the reserved pot along with ro-tel tomatoes & chilies. Set the pot over low heat and cook, stirring occasionally, until cheese is melted and smooth, about 5 minutes. Remove cheese sauce from heat.",
      "secondary_message": "16 oz Velveeta cheese"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 avocado\n½ small bunch cilantro"
    },
    {
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and cut into bite-sized pieces. Place on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the plate with the avocado.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the plate.",
      "secondary_message": null
    },
    {
      "primary_message": "When the tater tots are done, remove from the oven and transfer to a serving platter. Top with cheese sauce, bacon, avocado, green onions, and cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
