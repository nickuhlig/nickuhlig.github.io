  "instructions": [
    {
      "id": 241757,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg chives\n1 ½ lemons\n1 ½ small pkgs grape tomatoes\n6 sticks celery\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 241758,
      "primary_message": "Peel and mince garlic. Trim and chop chives into small pieces.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 241759,
      "primary_message": "Place half of the garlic and half of the chives in a small bowl (reserving the rest for the next step); add oil, salt, and crushed red pepper. Stir to combine the garlic-chive oil and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch crushed red pepper"
    },
    {
      "id": 241760,
      "primary_message": "Juice lemons into a large bowl. Add remaining garlic and chives, oil, Dijon, honey, salt, and pepper to the bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 241761,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 241762,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a large plate. Season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 241763,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 241764,
      "primary_message": "Meanwhile, preheat oven to broil on high; position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 241765,
      "primary_message": "Halve tomatoes. Trim and thinly slice celery crosswise; add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 241766,
      "primary_message": "Add mixed greens and blue cheese to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 241767,
      "primary_message": "Slice rolls in half and place on a large baking sheet pan, cut-side up; drizzle with the garlic-chive oil. Place in the oven and toast until golden, 1-2 minutes. Remove from the oven and cut each round in half.",
      "secondary_message": "3 whole grain buns or rolls"
    },
    {
      "id": 241768,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 241769,
      "primary_message": "To serve, divide salad, steak, and crostini between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
