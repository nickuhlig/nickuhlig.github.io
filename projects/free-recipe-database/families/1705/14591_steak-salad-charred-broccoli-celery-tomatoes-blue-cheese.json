  "instructions": [
    {
      "id": 241798,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 241799,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 crowns broccoli\n1 ½ lemons\n1 ½ small pkgs grape tomatoes\n6 sticks celery\n1 small pkg chives\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 241800,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; transfer to a large baking sheet pan. Drizzle with oil, season with salt and crushed red pepper, toss to combine, and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 241801,
      "primary_message": "Place baking sheet in the oven and broil, tossing halfway through, until broccoli is crisp-tender and lightly charred around the edges, 15-18 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 241802,
      "primary_message": "Meanwhile, juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 241803,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil, Dijon, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 241804,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 241805,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a large plate. Season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 241806,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 241807,
      "primary_message": "Meanwhile, halve tomatoes. Trim and thinly slice celery crosswise; add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 241808,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 241809,
      "primary_message": "Add charred broccoli, mixed greens, and blue cheese to the bowl; toss to combine the salad and set aside.",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 241810,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 241811,
      "primary_message": "To serve, divide salad and steak between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
