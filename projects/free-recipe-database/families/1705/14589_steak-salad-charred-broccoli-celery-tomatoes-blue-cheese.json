  "instructions": [
    {
      "id": 241770,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 241771,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 crown broccoli\n½ lemon\n½ small pkg grape tomatoes\n2 sticks celery\n½ small pkg chives\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 241772,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; transfer to a baking sheet pan. Drizzle with oil, season with salt and crushed red pepper, toss to combine, and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 241773,
      "primary_message": "Place baking sheet in the oven and broil, tossing halfway through, until broccoli is crisp-tender and lightly charred around the edges, 12-15 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 241774,
      "primary_message": "Meanwhile, juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 241775,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil, Dijon, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 241776,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 241777,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 241778,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 241779,
      "primary_message": "Meanwhile, halve tomatoes. Trim and thinly slice celery crosswise; add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 241780,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 241781,
      "primary_message": "Add charred broccoli, mixed greens, and blue cheese to the bowl; toss to combine the salad and set aside.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 241782,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 241783,
      "primary_message": "To serve, divide salad and steak between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
