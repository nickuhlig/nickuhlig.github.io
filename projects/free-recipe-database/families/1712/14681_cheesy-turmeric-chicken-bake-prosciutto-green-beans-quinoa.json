  "instructions": [
    {
      "id": 243031,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 243032,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 243033,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 243034,
      "primary_message": "Divide chicken between two baking dishes and season with spices on both sides. ",
      "secondary_message": "1 ½ tsp garlic powder\n1 ½ tsp turmeric, ground\n¾ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 243035,
      "primary_message": "Using a clean cutting board, cut or tear prosciutto into pieces and place on top of the seasoned chicken.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 243036,
      "primary_message": "Wash, dry, and trim beans; divide into loose bundles and arrange on top of each cutlet. ",
      "secondary_message": "1 ½ lb green beans"
    },
    {
      "id": 243037,
      "primary_message": "Crumble cheese over the beans.",
      "secondary_message": "3 (4 oz) logs goat cheese"
    },
    {
      "id": 243038,
      "primary_message": "Wash and dry lemons. Zest and juice them over the chicken stacks; drizzle with oil.",
      "secondary_message": "1 ½ lemons\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 243039,
      "primary_message": "Place baking dishes in the oven and bake until chicken is cooked through, about 25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 243040,
      "primary_message": "When the chicken is done, change oven setting to broil on high and, working in batches, broil each dish until the chicken and cheese are golden, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 243041,
      "primary_message": "To serve, divide quinoa and chicken-bean stacks between plates; drizzle with sauce from the dishes and enjoy! ",
      "secondary_message": null
    }
  ],
