  "instructions": [
    {
      "id": 243115,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 243116,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 243117,
      "primary_message": "Place chicken in a large baking dish and season with spices on both sides. ",
      "secondary_message": "1 tsp garlic powder\n1 tsp turmeric, ground\n½ tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 243118,
      "primary_message": "Using a clean cutting board, cut or tear prosciutto into pieces and place on top of the seasoned chicken.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 243119,
      "primary_message": "Wash, dry, and trim beans; divide into loose bundles and arrange on top of each cutlet. ",
      "secondary_message": "0.45 kg green beans"
    },
    {
      "id": 243120,
      "primary_message": "Crumble cheese over the beans.",
      "secondary_message": "2 (113 g) logs goat cheese"
    },
    {
      "id": 243121,
      "primary_message": "Wash and dry lemon. Zest and juice it over the chicken stacks; drizzle with oil.",
      "secondary_message": "1 lemon\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 243122,
      "primary_message": "Place baking dish in the oven and bake until chicken is cooked through, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 243123,
      "primary_message": "When the chicken is done, change oven setting to broil on high and cook until the chicken and cheese are golden, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 243124,
      "primary_message": "To serve, divide chicken-bean stacks between plates; drizzle with sauce from the dish and enjoy! ",
      "secondary_message": null
    }
  ],
