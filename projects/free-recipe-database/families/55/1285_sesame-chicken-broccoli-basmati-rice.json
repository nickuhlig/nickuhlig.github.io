  "instructions": [
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "primary_message": "In a medium bowl, whisk together egg and cornstarch.",
      "secondary_message": "1 egg\n1 tbsp cornstarch"
    },
    {
      "primary_message": "Cut chicken into bite-sized pieces. Add to egg mixture and toss to coat. Set aside.",
      "secondary_message": "227 g chicken breasts, boneless skinless"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and cut broccoli into same-size florets. Cut remaining stalks into smaller pieces. Wash, trim root ends, and chop green onions.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. In a small bowl, prepare sauce by whisking together garlic, honey, soy sauce, oil, and seeds. Set aside.",
      "secondary_message": "1 clove garlic\n2 tbsp honey\n1 tsp toasted sesame oil\n1 tbsp sesame seeds"
    },
    {
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until golden brown, 2-3 minutes per side. Transfer to a bowl.",
      "secondary_message": "virgin coconut oil"
    },
    {
      "primary_message": "Return skillet to stove and add more oil. Add broccoli and, stirring frequently, cook until tender and bright green, 3-4 minutes.",
      "secondary_message": "virgin coconut oil"
    },
    {
      "primary_message": "Return chicken to skillet, pour in sauce, and add onions. Stir and cook until sauce thickens, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Uncover rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, place rice in a bowl and top with stir fry. Enjoy!",
      "secondary_message": null
    }
  ],
