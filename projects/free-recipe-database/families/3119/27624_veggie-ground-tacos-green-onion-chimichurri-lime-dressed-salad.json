  "instructions": [
    {
      "id": 443678,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches green onions (scallions)\n1 small bunch cilantro\n1 ½ limes\n1 ½ red bell peppers\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 443679,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a small bowl and half in a large bowl. (Set large bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 443680,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the small bowl with the green onion along with vinegar, water, oil, and spices. Stir to combine the chimichurri and set aside.",
      "secondary_message": "3 tbsp red wine vinegar\n3 tbsp water\n2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 443681,
      "primary_message": "Juice limes into the large bowl with the green onion. Add mayo, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 443682,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 443683,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad; set aside. ",
      "secondary_message": null
    },
    {
      "id": 443684,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 443685,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 443686,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 443687,
      "primary_message": "Divide tortillas between plates; fill with a small portion of salad, then top with veggie ground and chimichurri. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
