  "instructions": [
    {
      "id": 443781,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n½ small bunch cilantro\n½ lime\n½ red bell pepper\n½ head butter (Boston) lettuce"
    },
    {
      "id": 443782,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a small bowl and half in a medium bowl. (Set medium bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 443783,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the small bowl with the green onion along with vinegar, water, oil, and spices. Stir to combine the chimichurri and set aside.",
      "secondary_message": "1 tbsp red wine vinegar\n1 tbsp water\n2 tsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 443784,
      "primary_message": "Juice lime into the medium bowl with the green onion. Add mayo, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp vegan mayonnaise\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 443785,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 443786,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad; set aside. ",
      "secondary_message": null
    },
    {
      "id": 443787,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 443788,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 443789,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 443790,
      "primary_message": "Divide tortillas between plates; fill with a small portion of salad, then top with veggie ground and chimichurri. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
