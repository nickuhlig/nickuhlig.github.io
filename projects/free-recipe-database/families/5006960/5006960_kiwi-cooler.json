  "instructions": [
    {
      "id": 1,
      "primary_message": "Add kiwi and tarragon to mixing glass and muddle until kiwi is liquified, about 30 seconds. Add gin, lime, and simple syrup. Fill mixing glass with ice and shake until well chilled, about 30 seconds. Strain into ice-filled glass, top with seltzer and stir gently before serving, garnished with a tarragon sprig.",
      "secondary_message": null
    }
