  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the lemongrass into 1-inch pieces, then bruise it. Tear and bruise the fresh makrut lime leaves. Cut the fresh mushrooms into bite-sized pieces. Slice the bird's eye chilies.",
      "secondary_message": "2 stalks lemongrass\n3 to 4 fresh makrut lime leaves\n8 oz fresh mushrooms\n3 to 4 bird's eye chilies"
    },
    {
      "id": 1,
      "primary_message": "Prepare udon noodles according to package instructions; drain and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place coconut milk, vegetable broth, lemongrass, kaffir lime leaves, and galangal in a 2-quart saucepan set over medium heat. Bring mixture to a very gentle boil; reduce heat so the liquid barely simmer. Allow the broth to infuse for 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add mushrooms to the broth; adjust heat so mixture comes back to a gentle boil. Add prepared noodles to the pot; heat through. Remove pot from heat. Add sliced chilies while the soup is still hot. Season to taste with salt and 1/4 cup of lime juice. Adjust seasoning with more salt and lime juice as required, and serve immediately.",
      "secondary_message": null
    }
  ],
