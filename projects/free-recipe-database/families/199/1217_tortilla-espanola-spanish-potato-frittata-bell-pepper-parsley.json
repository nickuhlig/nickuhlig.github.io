  "instructions": [
    {
      "id": 9952,
      "primary_message": "Wash and dry potatoes and bell pepper. Peel potatoes and, using a mandoline or knife, thinly slice into rounds. Seed and cut pepper into small strips. Peel onion and thinly slice. Peel and mince garlic.",
      "secondary_message": "0.34 kg sweet potatoes\n1 red bell pepper\n½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 9953,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 9954,
      "primary_message": "Coat bottom of skillet with oil. Add potatoes, bell pepper, onion, and garlic. Stirring occasionally, cook until potatoes are tender (test with a fork), about 10 minutes.",
      "secondary_message": "about ¼ cup virgin coconut oil"
    },
    {
      "id": 9955,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. In a medium bowl, whisk together eggs, parsley, salt, and pepper.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\r\n4 eggs\r\n¼ tsp salt\r\n⅛ tsp black pepper\r\n1 pinch cayenne pepper"
    },
    {
      "id": 9956,
      "primary_message": "Drain potatoes and other vegetables in a colander, reserving about 1 tbsp of the oil. Coat bottom of skillet with the oil.",
      "secondary_message": ""
    },
    {
      "id": 9957,
      "primary_message": "Return potatoes to the skillet and pour in the egg mixture. Shake skillet to evenly distribute the mixture. Reduce heat to medium-low and cook until the eggs are mostly set but still a little runny in the center, 8-10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 9958,
      "primary_message": "Place a large plate or lid on top of the skillet and carefully flip the pan so that the tortilla falls onto the plate. Slide the tortilla back into the pan with the uncooked side face down. Cook for an additional 3-4 minutes. Flip tortilla one more time and warm the other side for about 1 minute.",
      "secondary_message": ""
    },
    {
      "id": 9959,
      "primary_message": "To serve, cut tortilla into wedges and place on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
