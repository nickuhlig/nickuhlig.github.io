  "instructions": [
    {
      "id": 347016,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season the cutlets with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 347017,
      "primary_message": "Preheat a stainless steel or cast iron skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347018,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chicken and cook, flipping once, until cooked through, 8-10 minutes.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 347019,
      "primary_message": "Meanwhile, peel and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 347020,
      "primary_message": "Wash and juice half the lemons into a small bowl; cut the other half into wedges and set aside. ",
      "secondary_message": "3 lemons"
    },
    {
      "id": 347021,
      "primary_message": "When the chicken is cooked, remove from skillet and set aside on a plate, loosely covered with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 347022,
      "primary_message": "Add the onion and garlic to the pan; cook, stirring frequently, until the onion is softened, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 347023,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 347024,
      "primary_message": "Add lemon juice, vinegar, and butter to skillet along with any accumulated drippings from the chicken plate. Cook, stirring frequently, scraping up any browned bits from the bottom of the skillet, about 1 minute.",
      "secondary_message": "2 tbsp white wine vinegar\n3 tbsp butter, unsalted"
    },
    {
      "id": 347025,
      "primary_message": "Add capers, parsley, and chicken to the skillet and cook, 2 minutes more. Remove skillet from heat and set aside.",
      "secondary_message": "6 tbsp capers"
    },
    {
      "id": 347026,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat. Wash spinach (unless it came pre-washed).",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 347027,
      "primary_message": "Add butter to the second skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 347028,
      "primary_message": "Working in batches if necessary, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 347029,
      "primary_message": "Finely grate Parmesan into the skillet and stir to combine.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 347030,
      "primary_message": "To serve, divide chicken and wilted spinach between plates, garnish with lemon wedges, and enjoy!",
      "secondary_message": null
    }
  ],
