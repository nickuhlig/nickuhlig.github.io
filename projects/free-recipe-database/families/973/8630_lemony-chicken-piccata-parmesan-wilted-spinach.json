  "instructions": [
    {
      "id": 347092,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 347093,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 347094,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season the cutlets with salt and pepper on both sides.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 347095,
      "primary_message": "Preheat a large stainless steel or cast iron skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347096,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chicken and cook, flipping once, until cooked through, 8-10 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 347097,
      "primary_message": "Meanwhile, peel and small dice onion; peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 347098,
      "primary_message": "Wash and juice one lemon into a small bowl; cut the other lemon into wedges and set aside. ",
      "secondary_message": "2 lemons"
    },
    {
      "id": 347099,
      "primary_message": "When the chicken is cooked, remove from skillet and set aside on a plate, loosely covered with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 347100,
      "primary_message": "Add the onion and garlic to the pan; cook, stirring frequently, until the onion is softened, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 347101,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 347102,
      "primary_message": "Add lemon juice, vinegar, and butter to skillet along with any accumulated drippings from the chicken plate. Cook, stirring frequently, scraping up any browned bits from the bottom of the skillet, about 1 minute.",
      "secondary_message": "4 tsp white wine vinegar\n4 tsp butter, unsalted"
    },
    {
      "id": 347103,
      "primary_message": "Add capers, parsley, and chicken to the skillet and cook, 2 minutes more. Remove skillet from heat and set aside.",
      "secondary_message": "4 tbsp capers"
    },
    {
      "id": 347104,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat. Wash spinach (unless it came pre-washed).",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 347105,
      "primary_message": "Add butter to the second skillet and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 347106,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper. Finely grate Parmesan into the skillet and stir to combine.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper\n57 g Parmesan cheese"
    },
    {
      "id": 347107,
      "primary_message": "To serve, divide chicken, rice, and wilted spinach between plates, garnish with lemon wedges, and enjoy!",
      "secondary_message": null
    }
  ],
