  "instructions": [
    {
      "id": 347046,
      "primary_message": "Cut tofu into ½-inch thick slices along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 347047,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 347048,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 347049,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 347050,
      "primary_message": "Finely grate Parmesan, place in a small bowl, and set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 347051,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 347052,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347053,
      "primary_message": "While the skillet heats up, sprinkle tofu with cornstarch, salt, and pepper on both sides.",
      "secondary_message": "2 tbsp cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 347054,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add tofu and cook until golden, 2-3 minutes per side. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 347055,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 347056,
      "primary_message": "Return skillet to medium heat, add more butter, and swirl to coat the bottom; add the onion and garlic. Cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 347057,
      "primary_message": "Juice lemon into the skillet, then add parsley, capers, and vinegar. Cook, stirring frequently, until the sauce is thickened, 2-3 minutes. Pour over the tofu and re-cover with foil. (Reserve skillet for the next step.)",
      "secondary_message": "4 tbsp capers\n4 tsp white wine vinegar"
    },
    {
      "id": 347058,
      "primary_message": "Wipe skillet clean with paper towels and return to medium-high heat; add more butter and swirl to coat the bottom.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 347059,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, and remove from heat.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 347060,
      "primary_message": "To serve, divide rice, tofu, sauce, and wilted spinach between plates. Sprinkle Parmesan over the spinach and enjoy!",
      "secondary_message": null
    }
  ],
