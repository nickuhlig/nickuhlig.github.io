  "instructions": [
    {
      "id": 1,
      "primary_message": "Place mozzarella and fontina in a medium bowl and toss with cornstarch until evenly coated. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in a medium saucepan over medium heat until shimmering. Add in garlic and red pepper flakes and cook until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in evaporated milk and bring to a boil. Reduce heat to low and add mozzarella, fontina, and Parmesan. Stir constantly until cheese is melted and smooth. Stir in basil, oregano, thyme, rosemary, and lemon zest. Season with salt and pepper to taste. Transfer to a bowl and serve immediately.",
      "secondary_message": null
    }
  ],
