  "instructions": [
    {
      "id": 245907,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 245908,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n473 ml chicken or vegetable broth"
    },
    {
      "id": 245909,
      "primary_message": "Meanwhile, wash and dry tomatoes; transfer to a large baking sheet pan.",
      "secondary_message": "2 small pkgs grape tomatoes"
    },
    {
      "id": 245910,
      "primary_message": "Wash, dry, trim, seed, and large dice bell peppers; add to the baking sheet with the tomatoes.",
      "secondary_message": "2 yellow bell peppers"
    },
    {
      "id": 245911,
      "primary_message": "Peel and large dice onions; add to the baking sheet.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 245912,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 245913,
      "primary_message": "Drizzle veggies with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 245914,
      "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides. Nestle chicken into the veggies on the baking sheet.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245915,
      "primary_message": "Place baking sheet in the oven and roast until veggies are tender and chicken is cooked through, 18-20 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 245916,
      "primary_message": "Transfer the baked chicken to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 245917,
      "primary_message": "Sprinkle capers over roasted veggies and stir to combine the ragout.",
      "secondary_message": "3 tbsp capers"
    },
    {
      "id": 245918,
      "primary_message": "To serve, divide quinoa, chicken thighs, and ragout between plates; top with feta and enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
