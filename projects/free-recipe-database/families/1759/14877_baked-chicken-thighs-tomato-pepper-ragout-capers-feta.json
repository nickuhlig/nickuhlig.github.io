  "instructions": [
    {
      "id": 245967,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 245968,
      "primary_message": "Wash and dry tomatoes; transfer to a baking sheet pan.",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 245969,
      "primary_message": "Wash, dry, trim, seed, and large dice bell pepper; add to the baking sheet with the tomatoes.",
      "secondary_message": "1 orange bell pepper"
    },
    {
      "id": 245970,
      "primary_message": "Peel and large dice onion; add to the baking sheet.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 245971,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 245972,
      "primary_message": "Drizzle veggies with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245973,
      "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides. Nestle chicken into the veggies on the baking sheet.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245974,
      "primary_message": "Place baking sheet in the oven and roast until veggies are tender and chicken is cooked through, 18-20 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 245975,
      "primary_message": "Transfer the baked chicken to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 245976,
      "primary_message": "Sprinkle capers over roasted veggies and stir to combine the ragout.",
      "secondary_message": "1 tbsp capers"
    },
    {
      "id": 245977,
      "primary_message": "To serve, divide chicken thighs and ragout between plates. Top with feta and enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
