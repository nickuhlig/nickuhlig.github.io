  "instructions": [
    {
      "id": 245884,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 245885,
      "primary_message": "Wash and dry tomatoes; divide between two baking sheet pans.",
      "secondary_message": "3 pints grape tomatoes"
    },
    {
      "id": 245886,
      "primary_message": "Wash, dry, trim, seed, and large dice bell peppers; add to the baking sheets with the tomatoes.",
      "secondary_message": "3 orange bell peppers"
    },
    {
      "id": 245887,
      "primary_message": "Peel and large dice onions; add to the baking sheets.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 245888,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 245889,
      "primary_message": "Drizzle veggies with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 245890,
      "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides. Nestle chicken into the veggies on the baking sheets.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 245891,
      "primary_message": "Place baking sheets in the oven and roast until veggies are tender and chicken is cooked through, 20-25 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 245892,
      "primary_message": "Transfer the baked chicken to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 245893,
      "primary_message": "Sprinkle capers over roasted veggies and stir to combine the ragout.",
      "secondary_message": "3 tbsp capers"
    },
    {
      "id": 245894,
      "primary_message": "To serve, divide chicken thighs and ragout between plates. Top with feta and enjoy!",
      "secondary_message": "3 (4 oz) pkgs crumbled feta cheese"
    }
  ],
