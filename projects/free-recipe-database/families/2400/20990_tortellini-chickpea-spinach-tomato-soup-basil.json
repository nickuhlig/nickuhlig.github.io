  "instructions": [
    {
      "id": 361726,
      "primary_message": "Drain and rinse chickpeas in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 361727,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 361728,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 361729,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom; add onion, garlic, and spices. Cook, stirring frequently, until starting to soften, 2-3 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 361730,
      "primary_message": "Add chickpeas, broth, and tomatoes to the pot; stir to combine, cover, and bring to a boil over high heat.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 361731,
      "primary_message": "Once the broth is boiling, uncover, add tortellini, and stir for a few seconds; return soup to a simmer. Once simmering, reduce heat to medium and cook until tortellini is just tender, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "18 oz cheese tortellini, fresh or frozen"
    },
    {
      "id": 361732,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 361733,
      "primary_message": "Wash and dry basil, then pick leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 361734,
      "primary_message": "Once the tortellini is tender, add spinach and basil to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 361735,
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
