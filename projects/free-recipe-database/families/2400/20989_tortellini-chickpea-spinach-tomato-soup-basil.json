  "instructions": [
    {
      "id": 361716,
      "primary_message": "Drain and rinse chickpeas in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 361717,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 361718,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 361719,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom; add onion, garlic, and spices. Cook, stirring frequently, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n1 tsp Italian seasoning\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 361720,
      "primary_message": "Add chickpeas, broth, and tomatoes to the pan; stir to combine, cover, and bring to a boil over high heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 361721,
      "primary_message": "Once the broth is boiling, uncover, add tortellini, and stir for a few seconds; return soup to a simmer. Once simmering, reduce heat to medium and cook until tortellini is just tender, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "9 oz cheese tortellini, fresh or frozen"
    },
    {
      "id": 361722,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "½ (5 oz) pkg baby spinach"
    },
    {
      "id": 361723,
      "primary_message": "Wash and dry basil, then pick leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 361724,
      "primary_message": "Once the tortellini is tender, add spinach and basil to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 361725,
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
