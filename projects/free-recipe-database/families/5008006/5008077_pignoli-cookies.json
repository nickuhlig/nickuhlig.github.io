  "ingredients": [
    {
      "ingredient_id": 2677,
      "name": "almond paste, crumbled",
      "quantity": "2 (227 g) cans"
    },
    {
      "ingredient_id": 1710,
      "name": "confectioners' sugar",
      "quantity": "1 ½ cups"
    },
    {
      "ingredient_id": 88,
      "name": "salt",
      "quantity": "½ tsp"
    },
    {
      "ingredient_id": 121,
      "name": "egg whites",
      "quantity": "2 large"
    },
    {
      "ingredient_id": 103,
      "name": "honey",
      "quantity": "2 tbsp"
    },
    {
      "ingredient_id": 216,
      "name": "pine nuts",
      "quantity": "1 cup"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 175°C (350°F). Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place almond paste in the bowl of a food processor. Pulse until finely ground. Add confectioners' sugar and salt and pulse until combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat egg whites until frothy, about 2 minutes. Add almond mixture and honey and beat until smooth.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place pine nuts in a shallow bowl. Roll dough into 5-cm rounds. Roll each round in pine nuts to coat, then place on prepared baking sheet.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake cookies until golden, about 15 minutes. Cool for 5 minutes on baking sheet then transfer to a wire rack and cool completely.",
      "secondary_message": null
    }
  ],
