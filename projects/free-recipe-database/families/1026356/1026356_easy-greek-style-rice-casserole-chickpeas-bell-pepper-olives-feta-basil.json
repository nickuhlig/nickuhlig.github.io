  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large baking dish. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half of the basil (reserving the rest for garnish), tomatoes, hot water (from the tap), and spices to the baking dish, then stir to combine.\n\n",
      "secondary_message": "1 ½ cups basmati rice\n2 (14.5 oz) can diced tomatoes\n1 tbsp Greek seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Trim, seed, and large dice bell peppers. Drain and rinse chickpeas. \n\n",
      "secondary_message": "3 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "primary_message": "Top rice with bell pepper, chickpeas, and olives, spreading them out in an even layer (do not stir). Cover the baking dish tightly with aluminum foil and place in the preheated oven. Bake until the rice is tender and veggies and chickpeas are warmed through, about 60 minutes. Remove from oven and allow to sit for 5 minutes.\n\n",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "primary_message": "To serve, uncover casserole, stir to combine, and divide between plates or bowls. Top with feta, tzatziki, and reserved basil. Enjoy!\n\n",
      "secondary_message": "2 (4 oz) pkg crumbled feta cheese\n1 ½ cups tzatziki sauce"
    }
  ],
