  "instructions": [
    {
      "id": 381729,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 381730,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh basil\n6 medium carrots\n6 medium parsnips"
    },
    {
      "id": 381731,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 381732,
      "primary_message": "Add goat cheese to the bowl with the basil; set aside to soften.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 381733,
      "primary_message": "Peel, trim, and slice carrots and parsnips crosswise into ¼-inch thick rounds. Divide veggies between two baking sheet pans, season with cardamom and salt, then stir to combine. Spread out in an even layer and drizzle with honey.",
      "secondary_message": "2 ½ tsp cardamom, ground\n¾ tsp salt\n2 tbsp honey"
    },
    {
      "id": 381734,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies. Place baking sheets in the oven (it doesn't need to be fully heated) and roast, stirring halfway through, until veggies are tender, about 25 minutes. Remove from oven.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 381735,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381736,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate. Season with spices on both sides. ",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n2 ½ tsp garam masala\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 381737,
      "primary_message": "Once the pan is hot, coat with butter. Working in batches if necessary, add steak and grill until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 381738,
      "primary_message": "While the steak is cooking, use the back of a spoon to mash and combine the basil-goat cheese. Set aside.",
      "secondary_message": null
    },
    {
      "id": 381739,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 381740,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 381741,
      "primary_message": "To serve, divide steak and veggies between plates. Top veggies with basil-goat cheese and pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
