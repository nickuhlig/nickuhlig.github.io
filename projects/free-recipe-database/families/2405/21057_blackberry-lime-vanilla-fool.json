  "instructions": [
    {
      "id": 355344,
      "primary_message": "Place a large bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 355345,
      "primary_message": "Wash and dry blackberries. Set aside one berry per person for serving; place remaining berries in a blender.",
      "secondary_message": "3 (6 oz) pkgs blackberries"
    },
    {
      "id": 355346,
      "primary_message": "Wash, dry, zest, and juices lime into the blender; add sugar and vanilla. Blend on high speed for several minutes until smooth.",
      "secondary_message": "1 ½ limes\n½ cup granulated sugar\n1 ½ tsp vanilla extract"
    },
    {
      "id": 355347,
      "primary_message": "Pour blackberry purée into a strainer placed over a medium bowl. Using a silicone spatula, press purée through the strainer to remove seeds; discard seeds and set sauce aside.",
      "secondary_message": null
    },
    {
      "id": 355348,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl.",
      "secondary_message": "24 fl oz (3 cups) heavy whipping cream"
    },
    {
      "id": 355349,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, 5-6 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 355350,
      "primary_message": "Add blackberry purée to the bowl with the whipped cream. Gently fold a few times so that there are streaks of sauce running through the fool.",
      "secondary_message": null
    },
    {
      "id": 355351,
      "primary_message": "Divide the fool between small bowls, cups, or jars; garnish each with a reserved berry and enjoy!",
      "secondary_message": null
    }
  ],
