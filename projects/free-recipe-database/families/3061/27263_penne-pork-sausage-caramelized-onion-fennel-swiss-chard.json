  "instructions": [
    {
      "id": 463192,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "1 tsp salt\n283 g penne pasta"
    },
    {
      "id": 463193,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 fennel bulbs\n1 bunch Swiss chard\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 463194,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Cut fennel in half lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 463195,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 463196,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the fennel. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 463197,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fennel, onion, and salt; cook, stirring occasionally, until soft and starting to brown, 6-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 463198,
      "primary_message": "Meanwhile, fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in the reserved medium bowl and stems in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 463199,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl with the chard leaves and set aside. (Set remaining parsley aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 463200,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl with the chard stems.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 463201,
      "primary_message": "Once the fennel and onion are soft, add the sausage. Cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "0.45 kg ground pork sausage"
    },
    {
      "id": 463202,
      "primary_message": "Add chard stems, garlic, and crushed red pepper to the skillet. Cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "½ tsp crushed red pepper"
    },
    {
      "id": 463203,
      "primary_message": "Add drained pasta, reserved pasta water, and vinegar to the skillet. Continue to cook, stirring frequently, until heated through, 1-2 minutes more.",
      "secondary_message": "2 tsp red wine vinegar"
    },
    {
      "id": 463204,
      "primary_message": "Add chard leaves and parsley to the skillet in handfuls, waiting for the greens to wilt slightly before adding the next handful. Cook, stirring occasionally, until the chard is tender, 30-60 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 463205,
      "primary_message": "To serve, divide pasta between plates or bowls and top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
