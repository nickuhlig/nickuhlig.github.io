  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Freshly grate the Parmesiano-Reggiano cheese on a microplane. Core and very finely dice the radicchio. Drain and rinse the chickpeas.",
      "secondary_message": "1 clove garlic\n1 oz Parmesiano-Reggiano cheese\n½ small head radicchio\n1 (15 oz) can chickpeas"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk to combine vinegar, lemon juice and zest, garlic, 1/2 teaspoon salt, and 1/2 teaspoon pepper. Slowly whisk in oil until emulsified; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large saucepan, bring 2 quarts water to boil. Add orzo and remaining 2 teaspoons salt and cook, stirring often, until fully tender, about 2 minutes past the al dente stage. Drain orzo and transfer to a rimmed baking sheet, then quickly toss with 2 tablespoons prepared dressing. Let cool completely on sheet pan, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add Pecorino, radicchio, chickpeas, basil, banana peppers, and cooled orzo to large bowl with remaining dressing and toss to thoroughly combine. Season with salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Let salad sit at room temperature for 30 minutes to allow flavors to meld. Serve, drizzled with extra olive oil, or transfer to the refrigerator if serving later.",
      "secondary_message": null
    }
  ],
