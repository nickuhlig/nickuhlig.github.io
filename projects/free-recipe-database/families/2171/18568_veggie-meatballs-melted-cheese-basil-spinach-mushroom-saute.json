  "instructions": [
    {
      "id": 304125,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 304126,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n0.68 kg cremini mushrooms\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 304127,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place in a large bowl (setting a small handful aside for garnish).",
      "secondary_message": null
    },
    {
      "id": 304128,
      "primary_message": "Add veggie ground, pine nuts, and spices to the bowl with the basil; mix with your hands until well combined. Using a heaping tablespoon measure, form mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": "680 g veggie ground, plant based\n½ cup pine nuts\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 304129,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 304130,
      "primary_message": "Add tomato sauce and spices to the bowl with the garlic; stir to combine the sauce. Divide between two baking dishes, then set aside.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 304131,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 304132,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 304133,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 304134,
      "primary_message": "When the meatballs are browned, transfer to the baking dishes and turn to coat in sauce. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 304135,
      "primary_message": "Top the saucy meatballs with cheese slices. Place baking dish in the oven and bake until cheese is melted and meatballs are cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 304136,
      "primary_message": "While the meatballs bake, thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 304137,
      "primary_message": "Return skillet to medium heat.",
      "secondary_message": null
    },
    {
      "id": 304138,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add mushrooms and cook, stirring often, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 304139,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, then remove from heat.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 304140,
      "primary_message": "To serve, divide sauce, meatballs, and veggie sauté between plates or bowls. Top meatballs with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
