  "instructions": [
    {
      "id": 304079,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 304080,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n0.68 kg cremini mushrooms\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 304081,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place in a large bowl (setting a small handful aside for garnish).",
      "secondary_message": null
    },
    {
      "id": 304082,
      "primary_message": "Add beef, eggs, and spices to the bowl with the basil; mix with your hands until well combined. Using a tablespoon measure, form beef mixture into rounded meatballs and place on a plate.",
      "secondary_message": "1.02 kg lean ground beef\n3 eggs\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 304083,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 304084,
      "primary_message": "Add tomato sauce and spices to the bowl with the garlic; stir to combine the sauce. Divide between two baking dishes, then set dishes aside.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 304085,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 304086,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 304087,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 304088,
      "primary_message": "When the meatballs are browned, transfer to the baking dishes and turn to coat in sauce. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 304089,
      "primary_message": "Top the saucy meatballs with cheese slices. Place baking dishes in the oven and bake until cheese is melted and meatballs are cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 304090,
      "primary_message": "While the meatballs bake, thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 304091,
      "primary_message": "Return skillet to medium heat.",
      "secondary_message": null
    },
    {
      "id": 304092,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add mushrooms and cook, stirring often, until softened, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 304093,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, then remove from heat.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 304094,
      "primary_message": "To serve, divide sauce, meatballs, and veggie sauté between plates or bowls. Top meatballs with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
