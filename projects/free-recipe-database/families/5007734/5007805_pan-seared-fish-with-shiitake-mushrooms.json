  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Stem and thinly slice the shiitakes of the fresh mushrooms like shiitake. Juice the lemon.",
      "secondary_message": "0.45 kg fresh mushrooms like shiitake\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Heat 2 tablespoons olive oil in a 30-cm skillet over medium-high heat until barely starting to smoke. Add the mushrooms, season with salt, pepper, and chili flakes, and cook, stirring occasionally, until well browned, 3 to 4 minutes. Transfer to a warmed serving plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Season the fish with salt and pepper. Wipe out skillet, add the remaining olive oil, and return to medium-high heat until shimmering. Add fish fillets and cook without moving until well browned on first side, about 3 minutes. Carefully flip with a flexible metal spatula and cook on second side until just cooked through, about 2 minutes longer. Transfer to plate with mushrooms.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In the same skillet, add 1 cup stock and cook over high heat until reduced by half, about 2 minutes. Off heat, stir in butter and lemon juice. Season to taste with salt and pepper. Pour over fish and mushrooms and serve, garnished with fresh parsley, chives, and/or lemon wedges.",
      "secondary_message": null
    }
  ],
