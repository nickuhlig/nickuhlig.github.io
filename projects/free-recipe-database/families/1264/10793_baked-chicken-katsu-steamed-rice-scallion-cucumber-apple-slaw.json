  "instructions": [
    {
      "id": 176470,
      "primary_message": "Preheat oven to 220°C (425°F). Line a baking sheet with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 176471,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 176472,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 176473,
      "primary_message": "Meanwhile, in a small bowl, whisk the eggs. Place flour and bread crumbs on two separate plates.",
      "secondary_message": "2 eggs\n½ cup all-purpose flour\n1 cup panko bread crumbs"
    },
    {
      "id": 176474,
      "primary_message": "Pat the chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n1 tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 176475,
      "primary_message": "Dredge chicken fillets in flour, shake off excess, then dip into the bowl with the egg. Let the excess drip off, then dredge the chicken fillets in the bread crumbs, pressing to adhere. Transfer to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 176476,
      "primary_message": "Place in the oven and bake for 12 minutes. Increase oven temperature to 230°C (450°F) and continue to bake until the crust is golden brown and the chicken is cooked through, 4-6 minutes more. Watch carefully because the bread crumbs can burn quickly. ",
      "secondary_message": null
    },
    {
      "id": 176477,
      "primary_message": "Meanwhile, peel and mince the garlic; place in a large bowl along with vinegar, oil, honey, and salt. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp rice vinegar\n4 tsp toasted sesame oil\n2 tsp honey\n⅛ tsp salt"
    },
    {
      "id": 176478,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 English cucumbers\n2 Granny Smith apples\n1 small bunch green onions (scallions)"
    },
    {
      "id": 176479,
      "primary_message": "Trim off and discard the ends of the cucumbers; thinly slice into match-like sticks. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 176480,
      "primary_message": "Core, quarter, and cut the apples into thin match-like sticks. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 176481,
      "primary_message": "Trim off and discard ends of the green onions. Slice onions lengthwise into long, thin strips, then cut crosswise into bite-sized pieces. Add to the bowl and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 176482,
      "primary_message": "In a small bowl, prepare the katsu sauce by whisking together ketchup, Worcestershire, sugar, and sesame seeds.",
      "secondary_message": "2 tbsp ketchup\n4 tsp Worcestershire sauce\n4 tsp brown sugar\n1 tsp sesame seeds"
    },
    {
      "id": 176483,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 176484,
      "primary_message": "To serve, divide rice, chicken, and slaw between bowls and drizzle with katsu sauce. Enjoy! ",
      "secondary_message": null
    }
  ],
