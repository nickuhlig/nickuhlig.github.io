  "instructions": [
    {
      "id": 114188,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 114189,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 green bell peppers\n3 avocados\n1 ½ limes"
    },
    {
      "id": 114190,
      "primary_message": "Seed and small dice the bell peppers; set aside.",
      "secondary_message": null
    },
    {
      "id": 114191,
      "primary_message": "Peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 114192,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 114193,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 114194,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 114195,
      "primary_message": "Add the bell peppers, onion, garlic, and chickpeas. Cook until the chickpeas are slightly golden, stirring occasionally, about 3-4 minutes. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 114196,
      "primary_message": "Add soy sauce, chili powder, and paprika to the chickpeas and sauté for 5-7 more minutes, until golden brown.",
      "secondary_message": "⅓ cup soy sauce\n1 ½ tsp chili powder\n¾ tsp paprika"
    },
    {
      "id": 114197,
      "primary_message": "Add the avocados, water, and salt to a blender. Juice the limes into the blender. Purée until smooth.",
      "secondary_message": "⅓ cup water\n⅜ tsp salt"
    },
    {
      "id": 114198,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15-30 seconds.",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 114199,
      "primary_message": "To assemble, add the chickpea vegetable mixture to each tortilla. Top with a drizzle of the avocado cream. Enjoy!",
      "secondary_message": null
    }
  ],
