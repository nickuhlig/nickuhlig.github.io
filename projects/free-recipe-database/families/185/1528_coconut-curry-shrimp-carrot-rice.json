  "instructions": [
    {
      "id": 13642,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n½ tsp salt\n16 fl oz (2 cups) water"
    },
    {
      "id": 13641,
      "primary_message": "If using frozen shrimp, place in a bowl and cover with cold water to thaw. Set aside.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 13643,
      "primary_message": "Wash and dry green onions. Trim root ends and chop.",
      "secondary_message": "1 small bunch green onions"
    },
    {
      "id": 40543,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 13644,
      "primary_message": "Drain and rinse shrimp under cold water until there are no more ice chunks. Place on paper towels and pat dry. Return to empty bowl. Add lime juice, ½ of the green onions (save the rest for garnishing), and pepper. Toss to coat.",
      "secondary_message": "1 lime\r\n⅛ tsp cayenne pepper"
    },
    {
      "id": 13645,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 13646,
      "primary_message": "Peel and mince garlic and ginger. In a small bowl mix together garlic, ginger, curry powder, salt, and water.",
      "secondary_message": "2 cloves garlic\n2 (1 inch) pieces ginger\n2 tbsp curry powder\n½ tsp salt\n4 tbsp water "
    },
    {
      "id": 13647,
      "primary_message": "Coat bottom of skillet with oil. Add curry mixture and cook for about 1 minute. Add coconut milk, stir, and cook 2-3 minutes.",
      "secondary_message": "about 2 tbsp virgin coconut oil\r\n1 (13.5 fl oz) can coconut milk"
    },
    {
      "id": 13648,
      "primary_message": "Add shrimp and cook until opaque, 4-5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 13649,
      "primary_message": "Wash, trim ends, peel, and coarsely grate carrots. Add to rice and stir to combine.",
      "secondary_message": "4 medium carrots"
    },
    {
      "id": 13650,
      "primary_message": "To serve, place rice and curry on a plate and garnish with remaining green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
