  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "18 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven racks to upper and lower middle positions and preheat oven to 175°C (350°F). Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour and salt. Set aside. In a large bowl, beat together butter, light brown sugar, and sugar until light and fluffy. Beat in vanilla and bourbon. Stir in flour mixture until combined. Stir in pecans. Chill dough in refrigerator for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Roll dough into 4-cm balls. Place cookies on baking sheets leaving 5 to 8 cm in between each cookie (you should fit about 15 cookies on each sheet) and bake cookies until golden brown, about 15 minutes.",
      "secondary_message": null
    }
  ],
