  "instructions": [
    {
      "primary_message": "Set a 6-quart electric pressure cooker to sauté on HIGH.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pressure cooker heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the pressure cooker insert is hot, add oil and swirl to coat the bottom. Add onion, pork, garlic, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n680 g ground pork sausage\n1 tbsp minced garlic\n¾ tsp salt\n½ tsp Italian seasoning\n½ tsp paprika\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, drain and rinse beans in a colander. ",
      "secondary_message": "1 (442 g) can cannellini (white kidney) beans"
    },
    {
      "primary_message": "Wash, dry, and slice potatoes crosswise into ¼-inch thick rounds. Add to the pressure cooker, along with broth and water, then stir to combine the soup. Lock lid and set to pressure cook on HIGH for 5 minutes.",
      "secondary_message": "4 cups chicken or vegetable broth"
    },
    {
      "primary_message": "When the soup is done, drape a clean towel over the vent, then manually release pressure. Remove lid.",
      "secondary_message": null
    },
    {
      "primary_message": "Add kale to the pot in handfuls (discarding any pieces with tough stems), waiting for it to wilt slightly before adding the next handful. Add cream, stir to combine, and remove from heat.",
      "secondary_message": "½ (283 g) bag kale, cut and ready to use\n½ cup heavy whipping cream"
    },
    {
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
