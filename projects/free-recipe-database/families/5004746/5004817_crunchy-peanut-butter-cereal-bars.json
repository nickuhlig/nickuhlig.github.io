  "instructions": [
    {
      "id": 1,
      "primary_message": "Grease a 9- by 23-cm pan. Heat butter in large saucepan (preferably non-stick) over medium-low heat until almost melted. Add marshmallows and salt and heat, stirring, until marshmallows have melted.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove from heat and stir in peanut butter until combined. Stir in cereal and peanuts until combined. Immediately spread into pan and press to smooth top. Let cool until set, about 15 minutes.",
      "secondary_message": null
    }
  ],
