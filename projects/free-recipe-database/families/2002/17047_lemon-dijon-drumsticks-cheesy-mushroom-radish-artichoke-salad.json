  "instructions": [
    {
      "id": 344357,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 344358,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 ½ lb cremini mushrooms\n1 ½ bunches radish\n3 small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 344359,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 344360,
      "primary_message": "Juice half of the lemons into the bowl with the garlic (reserve remaining lemons for the dressing). Add oil, Dijon, and spices; whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp Dijon mustard\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 344361,
      "primary_message": "Add chicken to the bowl with the marinade and turn to coat. Transfer drumsticks to the baking sheet, arranging them in a single layer; drizzle leftover marinade over top.",
      "secondary_message": "3 ¾ lb chicken drumsticks"
    },
    {
      "id": 344362,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until the chicken is golden brown and cooked through, about 35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344363,
      "primary_message": "While the chicken is cooking, juice reserved lemons into another large bowl.",
      "secondary_message": null
    },
    {
      "id": 344364,
      "primary_message": "Mince anchovy fillets; add to the bowl with the lemon juice along with oil and spices. Whisk to combine the dressing.",
      "secondary_message": "3 anchovy fillets, packed in oil\n2 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 344365,
      "primary_message": "Drain and thinly slice artichoke hearts; add to the bowl with the dressing.",
      "secondary_message": "6 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 344366,
      "primary_message": "Trim and thinly slice mushrooms and radishes; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344367,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344368,
      "primary_message": "Finely grate Parmesan, add to the bowl, and toss to combine the salad.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 344369,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
