  "instructions": [
    {
      "id": 344419,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 344420,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n0.45 kg cremini mushrooms\n1 bunch radish\n2 small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 344421,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 344422,
      "primary_message": "Juice one lemon into the bowl with the garlic (reserve remaining lemon for the dressing). Add oil, Dijon, and spices; whisk to combine the marinade.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 344423,
      "primary_message": "Add chicken to the bowl with the marinade and turn to coat. Transfer drumsticks to the baking sheet, arranging them in a single layer; drizzle leftover marinade over top.",
      "secondary_message": "1 ⅛ kg chicken drumsticks"
    },
    {
      "id": 344424,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until the chicken is golden brown and cooked through, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344425,
      "primary_message": "While the chicken is cooking, juice reserved lemon into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 344426,
      "primary_message": "Mince anchovy fillets; add to the bowl with the lemon juice along with oil and spices. Whisk to combine the dressing.",
      "secondary_message": "2 anchovy fillets, packed in oil\n4 tsp extra virgin olive oil\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 344427,
      "primary_message": "Drain and thinly slice artichoke hearts; add to the bowl with the dressing.",
      "secondary_message": "4 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 344428,
      "primary_message": "Trim and thinly slice mushrooms and radishes; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344429,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344430,
      "primary_message": "Finely grate Parmesan, add to the bowl, and toss to combine the salad.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 344431,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
