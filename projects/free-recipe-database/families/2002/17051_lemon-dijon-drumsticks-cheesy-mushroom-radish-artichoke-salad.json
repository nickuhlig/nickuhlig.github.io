  "instructions": [
    {
      "id": 344406,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 344407,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n0.23 kg cremini mushrooms\n½ bunch radish\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 344408,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 344409,
      "primary_message": "Juice half of the lemon into the bowl with the garlic (reserve remaining lemon for the dressing). Add oil, Dijon, and spices; whisk to combine the marinade.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 344410,
      "primary_message": "Add chicken to the bowl with the marinade and turn to coat. Transfer drumsticks to the baking sheet, arranging them in a single layer; drizzle leftover marinade over top.",
      "secondary_message": "0.57 kg chicken drumsticks"
    },
    {
      "id": 344411,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until the chicken is golden brown and cooked through, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344412,
      "primary_message": "While the chicken is cooking, juice reserved lemon into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 344413,
      "primary_message": "Mince anchovy fillet; add to the bowl with the lemon juice along with oil and spices. Whisk to combine the dressing.",
      "secondary_message": "1 anchovy fillet, packed in oil\n2 tsp extra virgin olive oil\n½ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 344414,
      "primary_message": "Drain and thinly slice artichoke hearts; add to the bowl with the dressing.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 344415,
      "primary_message": "Trim and thinly slice mushrooms and radishes; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344416,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344417,
      "primary_message": "Finely grate Parmesan, add to the bowl, and toss to combine the salad.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 344418,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
