  "instructions": [
    {
      "primary_message": "Heat oven to 400ºF.",
      "secondary_message": null
    },
    {
      "primary_message": "Place bottom halves of rolls in single layer in 13 x 9-inch pan; drizzle with butter. Top with turkey and American cheese. ",
      "secondary_message": null
    },
    {
      "primary_message": "Spread mustard onto cut sides of tops of rolls. Place over sandwiches; cover. ",
      "secondary_message": null
    },
    {
      "primary_message": "Bake for 20 minutes or until cheese is melted and sandwiches are heated through.",
      "secondary_message": null
    },
    {
      "primary_message": "CHEF'S TIP: For added flavor, consider incorporating Oscar Mayer™ Deli Fresh honey smoked turkey breast, Claussen kosher dill pickle sandwich slices and Kraft® real mayo!",
      "secondary_message": null
    }
