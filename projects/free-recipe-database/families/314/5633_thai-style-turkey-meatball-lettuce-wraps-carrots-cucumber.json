  "instructions": [
    {
      "id": 67288,
      "primary_message": "Wash and small dice the mushrooms; transfer to a medium bowl. Peel and mince or grate the ginger; add to the bowl.",
      "secondary_message": "0.341 kg white mushrooms\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 67287,
      "primary_message": "Add turkey, eggs, almond meal, fish sauce, and sesame oil to the bowl and mix with your hands until well combined.",
      "secondary_message": "1.02 kg ground turkey\n3 eggs\n⅜ cup almond meal/flour\n3 tbsp fish sauce\n3 tsp toasted sesame oil"
    },
    {
      "id": 67286,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 67285,
      "primary_message": "Form meat mixture into 1 inch size meatballs and place on a plate.",
      "secondary_message": ""
    },
    {
      "id": 67284,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add meatballs and cook, turning occasionally, until cooked through and browned on all sides, 5-7 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 67283,
      "primary_message": "Wash and dry the carrots, cucumbers, green onions, and lettuce. Trim carrot ends, peel, and grate. Halve cucumbers lengthwise, then halve each half, and slice crosswise on an angle. Trim green onion ends and thinly slice on an angle.",
      "secondary_message": "3 medium carrots\n1 ½ English cucumber\n1 ½ small bunch green onions (scallions)\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 67282,
      "primary_message": "In a small bowl, prepare the dressing by whisking together fish sauce, vinegar, sesame oil, and red pepper (optional).",
      "secondary_message": "3 tbsp fish sauce\n3 tbsp rice vinegar\n3 tsp toasted sesame oil\n⅜ tsp crushed red pepper (optional)"
    },
    {
      "id": 67281,
      "primary_message": "To serve, place meatballs in lettuce leaves and top with carrots and cucumber. Drizzle with dressing and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "3 tsp sesame seeds"
    }
  ],
