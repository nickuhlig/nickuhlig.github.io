  "instructions": [
    {
      "id": 26615,
      "primary_message": "Wash and small dice the mushrooms; transfer to a medium bowl. Peel and mince or grate the ginger; add to the bowl.",
      "secondary_message": "¼ lb white mushrooms\r\n1 (1 inch) piece ginger root"
    },
    {
      "id": 26616,
      "primary_message": "Add turkey, egg, almond meal, fish sauce, and sesame oil to the bowl and mix with your hands until well combined.",
      "secondary_message": "¾ lb ground turkey\n1 egg\n⅛ cup almond meal/flour\n1 tbsp fish sauce\n1 tsp toasted sesame oil"
    },
    {
      "id": 26617,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 26618,
      "primary_message": "Form meat mixture into 1 inch size meatballs and place on a plate.",
      "secondary_message": ""
    },
    {
      "id": 26619,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add meatballs and cook, turning occasionally, until cooked through and browned on all sides, 5-7 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 26620,
      "primary_message": "Wash and dry the carrot, cucumber, green onions, and lettuce. Trim carrot ends, peel, and grate. Halve cucumber lengthwise, then halve each half, and slice crosswise on an angle. Trim green onion ends and thinly slice on an angle.",
      "secondary_message": "1 medium carrot\r\n½ English cucumber\r\n½ small bunch green onions (scallions)\r\n1 head butter (Boston) lettuce"
    },
    {
      "id": 26621,
      "primary_message": "In a small bowl, prepare the dressing by whisking together fish sauce, vinegar, sesame oil, and red pepper (optional).",
      "secondary_message": "1 tbsp fish sauce\r\n1 tbsp rice vinegar\r\n1 tsp toasted sesame oil\r\n⅛ tsp crushed red pepper (optional)"
    },
    {
      "id": 26622,
      "primary_message": "To serve, place meatballs in lettuce leaves and top with carrots and cucumber. Drizzle with dressing and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds\r\n"
    }
  ],
