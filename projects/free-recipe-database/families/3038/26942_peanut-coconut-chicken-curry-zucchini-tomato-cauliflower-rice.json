  "instructions": [
    {
      "id": 488301,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n2 medium zucchini squash\n1 small pkg grape tomatoes\n1 yellow bell pepper\n1 small bunch cilantro"
    },
    {
      "id": 488302,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a medium bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 488303,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 488304,
      "primary_message": "While the pot heats up, cut chicken into bite-sized pieces.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 488305,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper; cook, stirring occasionally, until golden, 5-6 minutes. ",
      "secondary_message": "2 tbsp virgin coconut oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 488306,
      "primary_message": "Meanwhile, using a clean cutting board, trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 488307,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "id": 488308,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 488309,
      "primary_message": "Once the chicken is done, add curry powder and coriander to the pot. Continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "2 tbsp curry powder\n1 tbsp coriander, ground"
    },
    {
      "id": 488310,
      "primary_message": "Add chopped veggies, coconut milk, peanut butter, sugar, fish sauce, and chili-garlic sauce to the pot; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to low and cook until chicken and veggies are cooked through, and curry has thickened, 8-10 minutes. Remove from heat.",
      "secondary_message": "1 (398 ml) can coconut milk\n¼ cup natural peanut butter\n4 tsp brown sugar\n4 tsp fish sauce\n4 tsp chili-garlic sauce"
    },
    {
      "id": 488311,
      "primary_message": "While the curry is cooking, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 488312,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add riced cauliflower, water, and salt; cook, stirring occasionally, until cauliflower is soft, about 5 minutes.",
      "secondary_message": "2 tsp virgin coconut oil\n¼ cup water\n¼ tsp salt"
    },
    {
      "id": 488313,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 488314,
      "primary_message": "When the cauliflower rice is done, remove from heat, add cilantro, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 488315,
      "primary_message": "To serve, divide cauliflower rice and curry between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
