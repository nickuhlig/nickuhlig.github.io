  "instructions": [
    {
      "id": 483619,
      "primary_message": "Preheat oven to 175°C (350°F). Line two large baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 483620,
      "primary_message": "Peel bananas, break into chunks, and place in a large bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "3 bananas"
    },
    {
      "id": 483621,
      "primary_message": "Add eggs and maple syrup to the bowl with the banana. Stir to combine.",
      "secondary_message": "3 eggs\n3 tbsp pure maple syrup"
    },
    {
      "id": 483622,
      "primary_message": "Wash, dry, quarter, core, and small dice apples. Add to the bowl along with oats, protein powder, cinnamon, and salt. Stir once more to combine the batter.",
      "secondary_message": "2 Gala apples\n2 ¼ cup oats, quick cooking\n3 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n1 ½ tsp cinnamon, ground\n3 pinch salt"
    },
    {
      "id": 483623,
      "primary_message": "Using a ¼-cup measure, scoop batter onto the baking sheets, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 483624,
      "primary_message": "Allow to cool for a few minutes before transferring to plates. Enjoy!",
      "secondary_message": null
    }
  ],
