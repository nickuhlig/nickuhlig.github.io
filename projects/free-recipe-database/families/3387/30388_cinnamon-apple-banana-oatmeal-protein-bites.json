  "instructions": [
    {
      "id": 483607,
      "primary_message": "Preheat oven to 175°C (350°F). Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 483608,
      "primary_message": "Peel banana, break into chunks, and place in a medium bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "1 banana"
    },
    {
      "id": 483609,
      "primary_message": "Add egg and maple syrup to the bowl with the banana. Stir to combine.",
      "secondary_message": "1 egg\n1 tbsp pure maple syrup"
    },
    {
      "id": 483610,
      "primary_message": "Wash, dry, quarter, core, and small dice apple. Add to the bowl along with oats, protein powder, cinnamon, and salt. Stir once more to combine the batter.",
      "secondary_message": "½ Gala apple\n¾ cup oats, quick cooking\n1 serving vanilla whey-based protein powder (containing 20 grams protein/serving)\n½ tsp cinnamon, ground\n1 pinch salt"
    },
    {
      "id": 483611,
      "primary_message": "Using a ¼-cup measure, scoop batter onto the baking sheet, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 483612,
      "primary_message": "Allow to cool for a few minutes before transferring to plates. Enjoy!",
      "secondary_message": null
    }
  ],
