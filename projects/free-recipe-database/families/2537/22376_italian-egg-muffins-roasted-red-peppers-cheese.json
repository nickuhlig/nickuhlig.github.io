  "instructions": [
    {
      "id": 422874,
      "primary_message": "Preheat oven to 205°C (400°F) and position a rack in the lower third of the oven. Grease 8 muffin cups with butter; place muffin pan on a baking sheet pan (to catch any overflow during baking) and set aside.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 422875,
      "primary_message": "Pat roasted peppers dry with paper towels, then roughly chop into small pieces. Place in a medium bowl, along with the cheese, and stir to combine the filling.",
      "secondary_message": "1 (340 g) jar roasted red bell peppers\n1 cup shredded cheese, Italian blend"
    },
    {
      "id": 422876,
      "primary_message": "Divide filling between muffin cups and set aside. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 422877,
      "primary_message": "Crack eggs into the reserved bowl. Add spices, then whisk to combine. Pour eggs over the filling.",
      "secondary_message": "8 eggs\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp Italian seasoning"
    },
    {
      "id": 422878,
      "primary_message": "Place muffin pan in the oven and bake, rotating the pan halfway through, until eggs are set, about 15 minutes. Remove from the oven and let cool for 1 minute. Use a silicone spatula to wedge each egg muffin out of its cup.",
      "secondary_message": null
    },
    {
      "id": 422879,
      "primary_message": "To serve, divide egg muffins between plates and enjoy!",
      "secondary_message": null
    }
  ],
