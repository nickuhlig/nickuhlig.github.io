  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "Pat pork dry with paper towels; season with salt and pepper. Transfer to the baking sheet. ",
      "secondary_message": "1.36 kg pork tenderloin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn’t have to be fully heated) and roast until a thermometer inserted into the thickest part of the pork registers 145°F (for medium-rare), about 35 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place marmalade, soy sauce, cloves, and ginger in a small bowl. Stir to combine the glaze. ",
      "secondary_message": "⅔ cup orange marmalade\n1 tbsp soy sauce\n¼ tsp clove, ground\n¼ tsp ginger, ground"
    },
    {
      "primary_message": "During the last 15 minutes of roasting, brush pork with marmalade glaze every 5 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove baking sheet from the oven and transfer pork to a cutting board. Loosely cover with aluminum foil and let rest, 5-10 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Carve pork into slices. ",
      "secondary_message": null
    }
  ],
