  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the shallot. Mince the ginger. Mince the garlic clove.",
      "secondary_message": "2 tbsp shallot, about 1 medium shallot\n2 tsp fresh ginger\n1 medium garlic clove"
    },
    {
      "id": 1,
      "primary_message": "Heat oil over medium heat in a medium sauce until shimmering. Add in shallot and cook until softened, but not browned, about 4 minutes. Add in ginger and garlic and cook until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add in blueberries, vinegar, brown sugar, and salt and bring to a boil. Reduce heat and simmer until thickened, about 30-45 minutes. Let cool to room temperature, pour into an airtight container and store in refrigerator for up to 2 weeks.",
      "secondary_message": null
    }
  ],
