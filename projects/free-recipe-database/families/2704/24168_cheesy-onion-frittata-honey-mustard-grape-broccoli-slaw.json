  "instructions": [
    {
      "id": 422496,
      "primary_message": "Peel, halve, and small dice onions.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 422497,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 422498,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and spices; cook, stirring occasionally, until the onion is softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 422499,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in a large bowl; whisk to combine.",
      "secondary_message": "18 eggs\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 422500,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 422501,
      "primary_message": "When the onion is done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 422502,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 4-5 minutes. Remove from oven.",
      "secondary_message": "2 cups shredded cheese, Italian blend"
    },
    {
      "id": 422503,
      "primary_message": "Meanwhile, wash, dry, and halve grapes. Place in a clean large bowl along with broccoli slaw, dressing, and salt. Stir to combine and set aside.",
      "secondary_message": "1 ½ lb red grapes\n1 ½ (12 oz) pkgs broccoli slaw\n½ cup honey mustard dressing\n¼ tsp salt"
    },
    {
      "id": 422504,
      "primary_message": "Cut frittata into wedges and divide between plates; serve with slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
