  "instructions": [
    {
      "id": 422515,
      "primary_message": "Peel, halve, and small dice onion. Place in a large bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 422516,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 422517,
      "primary_message": "While the skillet heats up, small dice ham. Add to the bowl with the onion.",
      "secondary_message": "454 g ham steak, boneless"
    },
    {
      "id": 422518,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, ham, and spices; cook, stirring occasionally, until the onion is softened, about 4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 422519,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 422520,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 422521,
      "primary_message": "When the onion is done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 422522,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": "1 cup shredded cheese, Italian blend"
    },
    {
      "id": 422523,
      "primary_message": "Meanwhile, wash and dry grapes; using a clean cutting board, cut grapes in half. Place in a medium bowl along with broccoli slaw, dressing, and salt. Stir to combine and set aside.",
      "secondary_message": "0.45 kg red grapes\n1 (340 g) pkg broccoli slaw\n⅓ cup honey mustard dressing\n¼ tsp salt"
    },
    {
      "id": 422524,
      "primary_message": "Cut frittata into wedges and divide between plates; serve with slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
