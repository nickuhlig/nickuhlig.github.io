  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Clean the wild mushrooms. Mince the garlic on a microplane grater. Finely chop the shallot. Pick the thyme leaves. Juice the lemon.",
      "secondary_message": "0.23 kg mixed wild mushrooms\n1 medium clove garlic\n1 small shallot\n1 tsp thyme leaves\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Place eggs in a medium saucepan and cover with cold water. Bring to a boil over high heat, cover with a lid, and set aside for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Drizzle bread slices with half of olive oil. Broil until lightly charred. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, heat remaining 2 tablespoons olive oil in a large heavy-bottomed skillet over high heat until smoking. Add mushrooms and cook, stirring and tossing occasionally, until well browned on all sides, about 5 minutes. Add garlic, shallot, and thyme and cook, stirring constantly, until fragrant, about 15 seconds. Add lemon juice and toss to coat. Off-heat, season mushrooms with salt and pepper. Transfer to a small plate.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Peel eggs and crush with your hands. Top each slice of toast with mushrooms and crushed eggs. Drizzle with extra olive oil as desired and serve.",
      "secondary_message": null
    }
  ],
