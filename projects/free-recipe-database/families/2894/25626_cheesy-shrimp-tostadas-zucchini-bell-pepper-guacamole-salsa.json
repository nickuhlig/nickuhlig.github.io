  "instructions": [
    {
      "id": 418501,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 418502,
      "primary_message": "Divide tortillas between two large baking sheet pans. Drizzle with oil on both sides, then season with salt.",
      "secondary_message": "18 small corn tortillas\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 418503,
      "primary_message": "Place tortillas in the oven (it doesn't have to be fully heated) and bake until starting to crisp, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 418504,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; small dice. Place in a large bowl.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 418505,
      "primary_message": "Wash, dry, trim, and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 418506,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 418507,
      "primary_message": "Add shrimp and taco seasoning to the bowl with the veggies, then toss to combine and set aside.",
      "secondary_message": "¼ cup taco seasoning"
    },
    {
      "id": 418508,
      "primary_message": "Flip tortillas and sprinkle with cheese. Return baking sheet to the oven and continue to bake until cheese is melted, 4-5 minutes more. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 418509,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 418510,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add shrimp and veggies; cook, stirring occasionally, until shrimp are cooked through and veggies are tender, 5-6 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 418511,
      "primary_message": "To serve, divide tostadas between plates; top with shrimp, veggies, guacamole, and salsa. Enjoy!",
      "secondary_message": "1 ½ cups guacamole\n1 cup salsa"
    }
  ],
