  "instructions": [
    {
      "id": 423634,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 423635,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Place in a large bowl.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 423636,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper along with the mushrooms.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 (227g ) pkgs sliced white mushrooms"
    },
    {
      "id": 423637,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 423638,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until starting to soften, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt"
    },
    {
      "id": 423639,
      "primary_message": "Divide flatbreads between two baking sheet pans; evenly spread with peanut sauce, then top with veggies and cheese.",
      "secondary_message": "6 flatbreads or naan\n¾ cup peanut sauce\n1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 423640,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until pizzas are warmed through and cheese is melted, 8-10 minutes. Remove from oven and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 423641,
      "primary_message": "To serve, divide pizzas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
