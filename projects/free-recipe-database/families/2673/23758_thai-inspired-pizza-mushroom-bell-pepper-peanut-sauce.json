  "instructions": [
    {
      "id": 423618,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 423619,
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice. Place in a medium bowl.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 423620,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper along with the mushrooms.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 (227g ) pkg sliced white mushrooms"
    },
    {
      "id": 423621,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 423622,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until starting to soften, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt"
    },
    {
      "id": 423623,
      "primary_message": "Arrange flatbreads on a baking sheet pan; evenly spread with peanut sauce, then top with veggies and cheese.",
      "secondary_message": "2 flatbreads or naan\n¼ cup peanut sauce\n½ cup shredded cheese, Italian blend"
    },
    {
      "id": 423624,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until pizzas are warmed through and cheese is melted, 6-8 minutes. Remove from oven and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 423625,
      "primary_message": "To serve, divide pizzas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
