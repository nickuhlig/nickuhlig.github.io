  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble the tofu with your fingers into the skillet, then add sesame seeds, salt, and pepper. Cook, stirring occasionally, until tofu is golden and warmed through, 5-7 minutes. Remove from heat.",
      "secondary_message": "toasted sesame oil\n1 (12 oz) pkg extra firm tofu\n2 tsp sesame seeds\nsalt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ orange\n1 (1 inch) piece ginger root\n2 English cucumbers\n1 medium carrot\n½ red bell pepper\n½ small bunch cilantro"
    },
    {
      "primary_message": "Juice orange into a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince ginger and shallot. Add both to the bowl with the orange juice along with oil, vinegar, soy sauce, peanut butter, and salt. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\ntoasted sesame oil\n1 tbsp rice vinegar\n1 tbsp natural peanut butter\nsalt"
    },
    {
      "primary_message": "Trim and halve cucumbers crosswise, then run a vegetable peeler along the length of each cucumber to make ribbons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl, along with the tofu, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "primary_message": "To serve, divide the salad between plates or bowls and sprinkle with peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
