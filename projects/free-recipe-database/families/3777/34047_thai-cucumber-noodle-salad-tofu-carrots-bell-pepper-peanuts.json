  "instructions": [
    {
      "id": 561422,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 561423,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble the tofu with your fingers into the skillet, then add sesame seeds, salt, and pepper. Cook, stirring occasionally, until tofu is golden and warmed through, 7-8 minutes. Remove from heat.",
      "secondary_message": "1 tbsp toasted sesame oil\n3 (340 g) pkgs extra firm tofu\n2 tbsp sesame seeds\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 561424,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ oranges\n3 (2 ½ cm) pieces ginger root\n6 English cucumbers\n3 medium carrots\n1 ½ red bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 561425,
      "primary_message": "Juice oranges into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 561426,
      "primary_message": "Peel and mince ginger and shallots. Add both to the bowl with the orange juice along with oil, vinegar, soy sauce, peanut butter, and salt. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n⅓ cup toasted sesame oil\n3 tbsp rice vinegar\n3 tbsp soy sauce\n3 tbsp natural peanut butter\n¾ tsp salt"
    },
    {
      "id": 561427,
      "primary_message": "Trim and halve cucumbers crosswise, then run a vegetable peeler along the length of each cucumber to make ribbons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 561428,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 561429,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 561430,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl, along with the tofu, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 561431,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "1 cup peanuts, roasted unsalted"
    },
    {
      "id": 561432,
      "primary_message": "To serve, divide the salad between plates or bowls and sprinkle with peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
