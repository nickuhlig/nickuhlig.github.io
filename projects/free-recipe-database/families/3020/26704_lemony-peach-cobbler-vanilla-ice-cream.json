  "instructions": [
    {
      "id": 431785,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a small baking dish with butter. ",
      "secondary_message": "½ tsp butter, unsalted"
    },
    {
      "id": 431786,
      "primary_message": "Wash, dry, and quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Transfer to the baking dish and spread out in an even layer.",
      "secondary_message": "2 peaches"
    },
    {
      "id": 431787,
      "primary_message": "Wash, dry, zest, and juice lemon over peaches in the baking dish; set aside. ",
      "secondary_message": "½ lemon"
    },
    {
      "id": 431788,
      "primary_message": "Place flour, milk, sugar, baking powder, and salt in a small bowl. Stir to combine.",
      "secondary_message": "½ cup all-purpose flour\n89 ml (⅜ cup) whole milk\n3 tbsp brown sugar\n¾ tsp baking powder\n⅛ tsp salt"
    },
    {
      "id": 431789,
      "primary_message": "Place butter in a small saucepan set over medium-low and heat. Once the butter is melted, add to the bowl with the flour and stir to combine the topping (being careful not to over-mix).",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 431790,
      "primary_message": "Spoon topping over the peaches, then spread out evenly. Sprinkle additional sugar on top. ",
      "secondary_message": "1 tsp brown sugar"
    },
    {
      "id": 431791,
      "primary_message": "Place cobbler in the oven and bake until topping is golden brown and peaches are tender, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 431792,
      "primary_message": "To serve, divide peach cobbler and ice cream between bowls. Enjoy!",
      "secondary_message": "355 ml vanilla ice cream"
    }
  ],
