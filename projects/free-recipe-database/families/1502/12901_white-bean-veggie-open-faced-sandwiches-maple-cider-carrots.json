  "instructions": [
    {
      "id": 217186,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium carrots\n½ lb cremini mushrooms\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 217187,
      "primary_message": "Peel and trim carrots. Slice in half crosswise, then lengthwise into ½-inch thick sticks. Transfer to a medium bowl; add oil, vinegar, maple syrup, and salt. Toss to coat and set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp pure maple syrup\n¼ tsp salt"
    },
    {
      "id": 217188,
      "primary_message": "Meanwhile, drain and rinse beans; place in another medium bowl.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 217189,
      "primary_message": "Peel and mince garlic; add to the bowl with the beans, along with oil, vinegar, and spices. Using a potato masher or fork, mash until smooth and combined. Set aside. ",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n1 tsp apple cider vinegar\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 217190,
      "primary_message": "Thinly slice mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 217191,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 217192,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring frequently, until softened, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 217193,
      "primary_message": "Meanwhile, drain and roughly chop artichokes.",
      "secondary_message": "½ (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 217194,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 217195,
      "primary_message": "Add artichokes to the skillet, season with spices, and stir to combine. Cook until heated through, 1-2 minutes more. Remove from heat. ",
      "secondary_message": "½ tsp rosemary\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 217196,
      "primary_message": "Meanwhile, toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 217197,
      "primary_message": "Spread bean mixture over each slice of bread and divide between plates; using a slotted spoon, top slices with sautéed veggies. Serve with carrot sticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
