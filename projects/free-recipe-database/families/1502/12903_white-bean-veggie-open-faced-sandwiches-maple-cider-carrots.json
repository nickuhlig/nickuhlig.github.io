  "instructions": [
    {
      "id": 217210,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 medium carrots\n1 ½ lb cremini mushrooms\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 217211,
      "primary_message": "Peel and trim carrots. Slice in half crosswise, then lengthwise into ½-inch thick sticks. Transfer to a large bowl; add oil, vinegar, maple syrup, and salt. Toss to coat and set aside.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp pure maple syrup\n¾ tsp salt"
    },
    {
      "id": 217212,
      "primary_message": "Meanwhile, drain and rinse beans; place in another large bowl.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 217213,
      "primary_message": "Peel and mince garlic; add to the bowl with the beans, along with oil, vinegar, and spices. Using a potato masher or fork, mash until smooth and combined. Set aside. ",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 217214,
      "primary_message": "Thinly slice mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 217215,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 217216,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring frequently, until softened, about 5 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 217217,
      "primary_message": "Meanwhile, drain and roughly chop artichokes.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 217218,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 217219,
      "primary_message": "Add artichokes to the pot, season with spices, and stir to combine. Cook until heated through, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "1 ½ tsp rosemary\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 217220,
      "primary_message": "Meanwhile, toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 217221,
      "primary_message": "Spread bean mixture over each slice of bread and divide between plates; using a slotted spoon, top slices with sautéed veggies. Serve with carrot sticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
