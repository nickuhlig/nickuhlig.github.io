  "instructions": [
    {
      "id": 186518,
      "primary_message": "In a medium saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15-18 minutes. Transfer cooked quinoa to a large baking sheet pan and spread out in a thin layer to cool. ",
      "secondary_message": "1 ½ cups quinoa\n3 cup water\n½ tsp salt"
    },
    {
      "id": 186519,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 limes\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 small pkg fresh mint\n1 small bunch cilantro\n1 ½ small heads red cabbage\n1 ½ (5 oz) pkgs baby spinach\n1 ½ avocados"
    },
    {
      "id": 186520,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 186521,
      "primary_message": "Zest and juice limes into a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 186522,
      "primary_message": "Peel and mince garlic and ginger; transfer both to the salad bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 186523,
      "primary_message": "Trim and mince green onions; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186524,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186525,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186526,
      "primary_message": "Roughly chop peanuts and add half to the bowl (reserve the rest for garnish).",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 186527,
      "primary_message": "Add soy sauce, oils, and crushed red pepper to the bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup soy sauce\n¼ cup extra virgin olive oil\n3 tbsp toasted sesame oil\n3 pinch crushed red pepper"
    },
    {
      "id": 186528,
      "primary_message": "Halve each cabbage lengthwise and cut out the core; thinly slice crosswise and add to the bowl with the dressing. Using tongs, toss cabbage with the dressing to thoroughly coat.",
      "secondary_message": null
    },
    {
      "id": 186529,
      "primary_message": "Add spinach, edamame, and quinoa to the bowl; toss once more to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 186530,
      "primary_message": "Halve and pit avocados; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 186531,
      "primary_message": "To serve, divide salad between plates or bowls. Top with avocado and reserved peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
