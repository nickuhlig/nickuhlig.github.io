  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Hull and slice the strawberries. Hull the strawberries. Cut the lemon into half-moons.",
      "secondary_message": "2 cups strawberries\n4 large strawberries, plus more for garnish\n1 round slice lemon"
    },
    {
      "id": 1,
      "primary_message": "For the Strawberry Syrup: In a small saucepan, combine strawberries, sugar, and lemon rind. Cover and let stand, stirring occasionally, for 1 hour at room temperature.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Once the sugar has dissolved and the strawberries have released their liquid, bring the mixture to a simmer over medium heat. Cook, stirring gently, until the berries are tender, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a slotted spoon, transfer the cooked strawberries to a pint jar. Continue simmering the syrup until it thickens to a syrupy consistency, about 2 minutes. Discard lemon peel and pour syrup over berries. Let cool to room temperature, then store in the fridge for up to 1 month.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To Make One Cocktail: In a cocktail shaker, thoroughly muddle 4 hulled strawberries with the lemon. Add the strawberry syrup, balsamic, and bourbon, then fill shaker with ice and close shaker.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Shake vigorously until well chilled, about 15 seconds. Using both a cocktail strainer and a fine mesh strainer, strain the cocktail into a glass. Garnish with a strawberry.",
      "secondary_message": null
    }
  ],
