  "instructions": [
    {
      "primary_message": "Place bread crumbs in a small bowl. Set aside.",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "primary_message": "Wash, dry, peel, and coarsely grate sweet potato. Place in a medium bowl.",
      "secondary_message": "½ lb sweet potato"
    },
    {
      "primary_message": "Wash, dry, and coarsely grate broccoli. Add to the bowl with the sweet potato along with chicken and spices. Mix with your hands until well combined.",
      "secondary_message": "1 crown broccoli\n1 lb ground chicken\n2 tsp chili powder\n1 tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Using a generous tablespoon measure, form the chicken mixture into 2-inch nugget shapes. Add to the bowl with the bread crumbs, turn to coat, pressing gently to adhere, and place on a plate. Repeat with remaining chicken and bread crumbs. ",
      "secondary_message": null
    },
    {
      "primary_message": "Spray air fryer basket with cooking spray. Working in batches to best fit the size of your air fryer, add nuggets to the basket, spacing them at least ½-inch apart. Coat nuggets with additional cooking spray. \n\n",
      "secondary_message": "2 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Insert basket into the air fryer and set temperature to 400°F. Cook, flipping halfway, until nuggets are golden, crispy, and cooked through, 12-15 minutes. Remove basket from air fryer.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide nuggets between plates and serve with barbecue sauce for dipping. Enjoy! ",
      "secondary_message": "⅔ cup barbecue sauce"
    }
  ],
