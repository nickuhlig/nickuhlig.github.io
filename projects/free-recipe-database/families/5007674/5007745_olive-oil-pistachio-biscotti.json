  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together flour, salt, and baking powder; set aside. In a large bowl, whisk together olive oil and sugar until combined. Whisk in egg. Add dry ingredients to bowl and stir until comes together in a dough. Stir in pistachios. Divide dough in two and wrap each half in plastic wrap and chill for one hour or more.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Form each half of dough into an approximately 9-cm by 20-cm log and place one on each baking sheet. Bake until golden, 45 minutes. Take cookies out of oven and decrease oven temperature to 150°C (300°F).",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When cool enough to handle, use a serrated knife to cut logs on the bias to form 2.5-cm wide cookies. Place cookies, cut side down, on baking sheet. Place back in oven and bake until dry and toasted, about 10 minutes more.",
      "secondary_message": null
    }
  ],
