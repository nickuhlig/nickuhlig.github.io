  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Stem and roughly chop the and pitted cherries. Zest and juice the lemons. Lightly beat the egg.",
      "secondary_message": "2 cups and pitted cherries\n2 lemons\n1 large egg"
    },
    {
      "id": 1,
      "primary_message": "In a medium sauce pan combine cherries, 1/4 cup sugar, and lemon zest. In a small bowl whisk together lemon juice, corn starch, and vanilla. Pour mixture over cherries and stir to incorporate. Heat cherries over medium high heat, stirring frequently until juices come together to form thick sauce. Remove from heat, cover and refrigerate until cool, at least 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, cut out eight 15-cm squares of parchment paper. Divide pie dough into eight equal balls. On a well floured surface, roll out the dough balls into 13-cm rounds. Place each round on a piece of parchment paper, stacking them together so they don't stick. Refrigerate pie rounds for 30 minutes to 1 hour to allow them to firm up.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Line a large baking sheet with parchment paper. Remove the dough from the refrigerator. Place 2 to 2 1/2 tablespoons cooled cherry filling in the center of each round, then fold in half to enclose and crimp the edges to seal. Brush the outside of the pies with egg and sprinkle with remaining 3 tablespoons sugar. Make 3 small cuts on the top of the pies to vent. Refrigerate prepared pies for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Set rack to the middle position and preheat oven to 175°C (350°F). Bake pies until golden brown, 25 to 30 minutes. Remove from oven and let cool in the pan for 2 minutes then transfer to a wire rack to cool completely.",
      "secondary_message": null
    }
  ],
