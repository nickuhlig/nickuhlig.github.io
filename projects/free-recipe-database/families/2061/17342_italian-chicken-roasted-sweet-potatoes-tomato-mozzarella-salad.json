  "instructions": [
    {
      "id": 281562,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 281563,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg sweet potato\n½ small pkg grape tomatoes\n1 yellow bell pepper\n½ small pkg fresh basil"
    },
    {
      "id": 281564,
      "primary_message": "Peel and cut sweet potato lengthwise into ¼-inch thick strips; place in a medium bowl. Add oil and salt, toss to coat, then spread out on a baking sheet pan. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 281565,
      "primary_message": "Place sweet potato in the oven (it doesn't have to be fully heated) and bake, tossing once, until golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 281566,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp balsamic vinegar\n1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 281567,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 281568,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 281569,
      "primary_message": "Medium dice mozzarella and add to the bowl.",
      "secondary_message": "½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 281570,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 281571,
      "primary_message": "Pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with spices.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 281572,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 281573,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat and cover to keep warm.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 281574,
      "primary_message": "To serve, divide chicken, sweet potatoes, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
