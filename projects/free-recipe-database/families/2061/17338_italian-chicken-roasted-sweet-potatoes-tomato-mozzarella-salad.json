  "instructions": [
    {
      "id": 281513,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 281514,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n1 ½ pints grape tomatoes\n3 yellow bell peppers\n1 small pkg fresh basil"
    },
    {
      "id": 281515,
      "primary_message": "Peel and cut sweet potatoes lengthwise into ¼-inch thick strips; place in a large bowl. Add oil and salt, toss to coat, divide between two baking sheet pans, and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 281516,
      "primary_message": "Place sweet potato in the oven (it doesn't have to be fully heated) and bake, tossing once, until golden and fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 281517,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp balsamic vinegar\n1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 281518,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 281519,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 281520,
      "primary_message": "Medium dice mozzarella and add to the bowl.",
      "secondary_message": "1 ½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 281521,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 281522,
      "primary_message": "Pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with spices.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 281523,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 281524,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat and cover to keep warm.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 281525,
      "primary_message": "To serve, divide chicken, sweet potatoes, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
