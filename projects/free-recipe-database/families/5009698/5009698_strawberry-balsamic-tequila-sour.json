  "instructions": [
    {
      "id": 1,
      "primary_message": "In a cocktail shaker, muddle strawberries, simple syrup, lime juice, and balsamic syrup until strawberries are completely dissolved. Add mint leaves and gently tap 5 times with muddler. (Do not over-muddle mint or it will taste bitter and muddy.) Add tequila to shaker and fill 2/3 full with ice.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Shake until well chilled, about 15 seconds. Using a strainer, pour into a serving glass filled with ice. Garnish with additional mint or strawberry if desired.",
      "secondary_message": null
    }
  ],
