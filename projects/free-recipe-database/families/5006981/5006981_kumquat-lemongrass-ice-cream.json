  "instructions": [
    {
      "id": 1,
      "primary_message": "In a heavy medium saucepan, bring cream and milk to a simmer over medium heat. When dairy begins to bubble, add lemongrass, cover, shut off heat, and let steep for 2 hours. Pour through a fine-mesh strainer into a 1 quart liquid measure. Discard lemongrass.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While dairy is steeping, toss minced kumquats with 1/2 cup sugar in a bowl until sugar begins to dissolve. Let sit on counter for 10 minutes, toss again, then refrigerate overnight.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In another heavy medium saucepan, whisk egg yolks and remaining 1/2 cup sugar together until lighter in color and slightly thickened. Slowly pour in strained dairy, whisking constantly, about 1/4 cup at a time until half of dairy is integrated into eggs. Pour in remaining dairy and whisk to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cook over medium heat, whisking frequently, until a custard forms on the back of a spoon and a finger swiped across the back leaves a clean line. Stir in salt to taste, then strain custard into an airtight container and chill overnight.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "The next day, churn ice cream according to manufacturer's instructions. Drain kumquats from syrup, reserving syrup for another use. Transfer ice cream to an airtight container and quickly fold in kumquats. Chill in freezer for at least 4 hours before serving.",
      "secondary_message": null
    }
  ],
