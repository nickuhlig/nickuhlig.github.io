  "instructions": [
    {
      "id": 265797,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n1 ½ lemons\n1 small bunch cilantro"
    },
    {
      "id": 265798,
      "primary_message": "Rinse chickpeas and lentils in a colander or strainer; set aside to drain. ",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n1 ½ cups brown lentils, dried"
    },
    {
      "id": 265799,
      "primary_message": "Peel and small dice onions; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 265800,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Add both to the bowl with onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 265801,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 265802,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, carrot, celery, spices, and sugar to the pot; cook, stirring occasionally, until the veggies soften, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp cumin, ground\n1 tbsp chili powder\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper\n¾ tsp brown sugar"
    },
    {
      "id": 265803,
      "primary_message": "Add chickpeas, lentils, broth, and tomatoes to the pot; stir to combine, cover, and bring to a boil over medium-high heat.",
      "secondary_message": "2839 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes"
    },
    {
      "id": 265804,
      "primary_message": "Once the soup comes to a boil, reduce heat to a simmer and cover; cook, stirring occasionally, until lentils are tender, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 265805,
      "primary_message": "Meanwhile, juice lemons into the reserved bowl; add water, flour, and eggs. Whisk to combine the thickening liquid. ",
      "secondary_message": "1 ½ cup water\n2 tbsp all-purpose flour\n3 eggs"
    },
    {
      "id": 265806,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the thickening liquid and whisk to combine; set aside. (Reserve remaining cilantro for the next step.)",
      "secondary_message": null
    },
    {
      "id": 265807,
      "primary_message": "Place remaining cilantro in a small bowl. Add yogurt and water; stir to combine the cilantro yogurt and set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp water"
    },
    {
      "id": 265808,
      "primary_message": "When the lentils are tender, slowly pour the thickening liquid into the soup while gently stirring. Simmer until soup thickens, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 265809,
      "primary_message": "To serve, divide soup between bowls and top with cilantro yogurt. Enjoy! ",
      "secondary_message": null
    }
  ],
