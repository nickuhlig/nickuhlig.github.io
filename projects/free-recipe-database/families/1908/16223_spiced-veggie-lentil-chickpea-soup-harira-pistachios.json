  "instructions": [
    {
      "id": 265810,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n½ small bunch cilantro\n½ lemon"
    },
    {
      "id": 265811,
      "primary_message": "Rinse chickpeas and lentils in a colander or strainer; set aside to drain. ",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n½ cup brown lentils, dried"
    },
    {
      "id": 265812,
      "primary_message": "Peel and small dice onion; peel and mince garlic. Place both in a small bowl.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 265813,
      "primary_message": "Peel, trim, and small dice carrot; add to the bowl with onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 265814,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 265815,
      "primary_message": "While the pan heats up, trim and small dice celery; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 265816,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion, garlic, carrot, celery, spices, and sugar to the pan; cook, stirring occasionally, until the veggies soften, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp chili powder\n½ tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper\n¼ tsp brown sugar"
    },
    {
      "id": 265817,
      "primary_message": "Add chickpeas, lentils, broth, and tomatoes to the pan; stir to combine, cover, and bring to a boil over medium-high heat.",
      "secondary_message": "946 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes"
    },
    {
      "id": 265818,
      "primary_message": "Once the soup comes to a boil, reduce heat to a simmer and cover; cook, stirring occasionally, until lentils are tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 265819,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 265820,
      "primary_message": "Juice lemon into the bowl with the cilantro. Add water and flour; whisk to combine the thickening liquid and set aside. ",
      "secondary_message": "½ cup water\n4 tsp all-purpose flour"
    },
    {
      "id": 265821,
      "primary_message": "When the lentils are tender, slowly pour the thickening liquid into the soup while gently stirring. Simmer until soup thickens, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 265822,
      "primary_message": "Meanwhile, roughly chop pistachios. ",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 265823,
      "primary_message": "To serve, divide soup between bowls and top with pistachios. Enjoy! ",
      "secondary_message": null
    }
  ],
