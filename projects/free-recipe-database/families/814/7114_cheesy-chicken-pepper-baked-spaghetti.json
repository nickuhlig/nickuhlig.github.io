  "instructions": [
    {
      "id": 98305,
      "primary_message": "Add chicken and salt to a medium saucepan. Cover with water and bring to a boil. Turn heat down to medium and simmer until chicken is cooked through, about 10 minutes.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n2 tsp salt\n8 cup water"
    },
    {
      "id": 98306,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Snap the spaghetti into 2-inch pieces. Once the water boils, uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "8 oz spaghetti pasta\n2 tsp salt"
    },
    {
      "id": 98307,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n½ lb white mushrooms\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 98308,
      "primary_message": "Slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 98309,
      "primary_message": "Peel and small dice onion. Small dice the pepper.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 98310,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 98311,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 98312,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the peppers, mushrooms, onion, garlic, and spices. Cook for 5-6 minutes, until veggies begin to soften.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp salt\n½ tsp paprika\n¼ tsp black pepper"
    },
    {
      "id": 98313,
      "primary_message": "Sprinkle flour over the veggies and stir until fully incorporated. Then pour in the milk, scraping up any browned bits from the bottom of the skillet. Let simmer, stirring often, until slightly thickened, 3-4 minutes.",
      "secondary_message": "2 tbsp all-purpose flour\n16 fl oz (2 cups) whole milk"
    },
    {
      "id": 98314,
      "primary_message": "Preheat the oven to the broil setting and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 98315,
      "primary_message": "Grate the cheese.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 98316,
      "primary_message": "When chicken is done, drain, and shred with a fork. Add to vegetable mixture along with the cooked pasta and half of the cheese. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 98317,
      "primary_message": "Pour the spaghetti mixture into a baking dish. Top with remaining cheese and broil for 3 minutes until cheese on top melts and becomes golden brown.",
      "secondary_message": null
    },
    {
      "id": 98318,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 98319,
      "primary_message": "Divide between plates, garnish with parsley, and enjoy!",
      "secondary_message": null
    }
  ],
