  "instructions": [
    {
      "id": 484072,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n3 (2 ½ cm) pieces ginger root\n1 ½ jalapeño peppers\n1 ½ limes\n1 ½ red bell peppers\n1 ½ English cucumbers\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 484073,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between two large bowls. (Set one bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 484074,
      "primary_message": "Peel and mince ginger and shallot. Add both to the remaining bowl with the cilantro.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 484075,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 484076,
      "primary_message": "Add veggie ground, bread crumbs, and soy sauce to the bowl, then mix with your hands until well combined. Form the veggie ground mixture into 6 equal-sized patties and place on a plate. ",
      "secondary_message": "680 g veggie ground, plant based\n½ cup panko bread crumbs\n3 tbsp soy sauce"
    },
    {
      "id": 484077,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 484078,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-6 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 484079,
      "primary_message": "Meanwhile, juice limes into the reserved bowl with the cilantro. Add oil, sugar, and spices, then whisk to combine the dressing. ",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp brown sugar\n1 ½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 484080,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 484081,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 484082,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 484083,
      "primary_message": "Roughly chop peanuts. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 484084,
      "primary_message": "Place mayo and hot sauce in a small bowl. Stir to combine the spicy mayo.",
      "secondary_message": "½ cup vegan mayonnaise\n1 tbsp hot sauce"
    },
    {
      "id": 484085,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 484086,
      "primary_message": "Spread spicy mayo over the bottom half of each bun; top with burger patties and a small handful of salad. Close with the top half of each bun. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
