  "instructions": [
    {
      "id": 484012,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n2 (2 ½ cm) pieces ginger root\n1 jalapeño pepper\n1 lime\n1 red bell pepper\n1 English cucumber\n1 head butter (Boston) lettuce"
    },
    {
      "id": 484013,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between two medium bowls. (Set one bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 484014,
      "primary_message": "Peel and mince ginger and shallot. Add both to the remaining bowl with the cilantro.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 484015,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 484016,
      "primary_message": "Add veggie ground, bread crumbs, and soy sauce to the bowl, then mix with your hands until well combined. Form the veggie ground mixture into 4 equal-sized patties and place on a plate. ",
      "secondary_message": "454 g veggie ground, plant based\n⅓ cup panko bread crumbs\n2 tbsp soy sauce"
    },
    {
      "id": 484017,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 484018,
      "primary_message": "Once the pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-6 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 484019,
      "primary_message": "Meanwhile, juice lime into the reserved bowl with the cilantro. Add oil, sugar, and spices, then whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp brown sugar\n1 tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 484020,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 484021,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 484022,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 484023,
      "primary_message": "Roughly chop peanuts. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 484024,
      "primary_message": "Place mayo and hot sauce in a small bowl. Stir to combine the spicy mayo.",
      "secondary_message": "⅓ cup mayonnaise\n2 tsp hot sauce"
    },
    {
      "id": 484025,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 484026,
      "primary_message": "Spread spicy mayo over the bottom half of each bun; top with burger patties and a small handful of salad. Close with the top half of each bun. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
