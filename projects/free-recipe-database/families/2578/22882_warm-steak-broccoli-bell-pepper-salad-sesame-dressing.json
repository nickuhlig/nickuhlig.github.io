  "instructions": [
    {
      "id": 378400,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 378401,
      "primary_message": "While the skillet heats up, wash, dry, trim, and seed bell pepper; slice lengthwise into thin strips.",
      "secondary_message": "1 yellow bell pepper"
    },
    {
      "id": 378402,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and broccoli; cook, stirring occasionally, until starting to soften, about 4 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n½ (18 oz) bag broccoli florets"
    },
    {
      "id": 378403,
      "primary_message": "Meanwhile, pat the steak dry with paper towels and slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 378404,
      "primary_message": "When the veggies have softened, add steak and stir-fry sauce to the skillet. Cook, stirring occasionally, until veggies are tender and steak is cooked through, 3-4 minutes. Remove from heat.",
      "secondary_message": "2 tbsp stir-fry sauce"
    },
    {
      "id": 378405,
      "primary_message": "Meanwhile, place water, additional stir-fry sauce, oil, and sesame seeds in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp water\n2 tbsp stir-fry sauce\n2 tsp toasted sesame oil\n2 tsp sesame seeds"
    },
    {
      "id": 378406,
      "primary_message": "Wash and dry mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 378407,
      "primary_message": "To serve, divide dressed greens between plates or bowls; top with warm steak and veggies. Enjoy!",
      "secondary_message": null
    }
  ],
