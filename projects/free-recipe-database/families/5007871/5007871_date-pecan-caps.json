  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pit the dates. Chop the pecans. Separate the eggs.",
      "secondary_message": "1 cup dates\n1 cup pecans\n2 large eggs"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to upper middle position and preheat oven to 325°F. Butter two 12-cup mini-muffin tins.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, beat together cream cheese and butter with a wooden spoon until fluffy, about 2 minutes. Beat in flour until combined. Using floured hands (dough will be sticky) divide dough among muffin cups, pressing down on bottom and sides of dough to create shells. Let chill in refrigerator while making filling.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In the bowl of a food processor, combine dates, pecans, sugar, vanilla, and egg yolks. Pulse until almost smooth; set aside. In a medium bowl, beat egg whites until stiff peaks form. Fold egg whites into date mixture.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Fill each cup 2/3 way full with date mixture. Bake until caps are golden and tops have puffed and darkened, about 25 minutes. Let cool for 15 minutes in pan, then remove to a wire rack to finish cooling.",
      "secondary_message": null
    }
  ],
