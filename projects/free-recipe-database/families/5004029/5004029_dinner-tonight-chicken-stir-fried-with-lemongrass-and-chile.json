  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the boneless skinless chicken thighs into 1-inch chunks. Finely chop the shallot. Finely chop the Thai chiles. Trim and finely chop the lemongrass. Coarsely chop the leaves of the fresh cilantro.",
      "secondary_message": "1 ⅓ lb boneless skinless chicken thighs\n1 large shallot\n1 to 2 Thai chiles\n1 stalk lemongrass\n3 to 4 sprigs fresh cilantro"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, add the chicken, salt, sugar, curry powder, and fish sauce. Toss until the chicken pieces are evenly coated. Set aside in the fridge to marinate for at least 15 minutes and as much as an hour – whatever you have time for.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "When chicken is done marinating, remove from the fridge. Pour the oil into a large wok or skillet set over high heat. When just about ready to smoke, add the shallot, chiles, and lemongrass. Stir-fry until very fragrant, about one minute. Add the chicken and red bell pepper. Stir well, and then let the chicken pieces cook undisturbed until lightly browned, about 1 minute. Using a spatula, flip the chicken pieces, and cook until lightly browned on the other side, about another minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour in the coconut milk and reduce heat to maintain a simmer. Cook, stirring occasionally, until the coconut milk has almost completely evaporated, 6 to 8 minutes. The fat in the coconut milk will just start to separate.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer to a serving plate, and garnish with cilantro. Serve with white rice.",
      "secondary_message": null
    }
  ],
