  "instructions": [
    {
      "id": 258470,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top. Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 258471,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "8 caps portobello mushrooms\n2 green bell peppers\n2 tomatoes"
    },
    {
      "id": 258472,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258473,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and spices; cook, breaking apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ lb lean ground pork\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 258474,
      "primary_message": "Meanwhile, remove stems from the mushrooms and carefully scrape out the gills. Place on the baking sheet, rub with oil, and season with salt and pepper on both sides; arrange gill-side down.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 258475,
      "primary_message": "Place mushrooms in the oven and broil until starting to soften, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 258476,
      "primary_message": "While the mushrooms are broiling, trim and discard top and bottom portions of the bell peppers, then cut each crosswise into 4 rings; remove seeds.",
      "secondary_message": null
    },
    {
      "id": 258477,
      "primary_message": "Remove baking sheet from the oven, flip mushrooms, and add pepper rings. Return to oven and broil until mushrooms and peppers are fork-tender, 4 minutes more. ",
      "secondary_message": null
    },
    {
      "id": 258478,
      "primary_message": "Meanwhile, slice tomatoes crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 258479,
      "primary_message": "Thinly slice mozzarella.",
      "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 258480,
      "primary_message": "When the broiled veggies are ready, remove from oven. Place a bell pepper ring on top of each mushroom; fill with ground pork, then layer with tomato and mozzarella.",
      "secondary_message": null
    },
    {
      "id": 258481,
      "primary_message": "Place mushroom stacks in the oven and broil until cheese is melted and golden, about 2 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 258482,
      "primary_message": "To serve, divide mushroom stacks between plates and sprinkle with crushed red pepper; enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
