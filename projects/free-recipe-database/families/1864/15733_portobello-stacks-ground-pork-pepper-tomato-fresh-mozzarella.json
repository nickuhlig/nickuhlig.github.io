  "instructions": [
    {
      "id": 258522,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top. Line two large baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 258523,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "12 caps portobello mushrooms\n3 green bell peppers\n3 tomatoes"
    },
    {
      "id": 258524,
      "primary_message": "Remove stems from the mushrooms and carefully scrape out the gills. Place on one baking sheet, rub with oil, and season with salt and pepper on both sides; arrange gill-side down.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 258525,
      "primary_message": "Place mushrooms in the oven and broil, flipping halfway through cooking, until tender, about 4 minutes per side. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 258526,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258527,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and spices; cook, breaking apart with a spoon, until browned and crumbly, 6-7 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1.02 kg lean ground pork\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 258528,
      "primary_message": "While the pork cooks, trim and discard top and bottom portions of the bell peppers, then cut each crosswise into 4 rings; remove seeds. Arrange on the second baking sheet in a single layer; drizzle with oil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 258529,
      "primary_message": "When the mushrooms are done, place pepper rings in the oven and broil until fork-tender, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 258530,
      "primary_message": "Meanwhile, slice tomatoes crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 258531,
      "primary_message": "Thinly slice mozzarella.",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 258532,
      "primary_message": "When the broiled peppers are ready, remove from oven. Place a bell pepper ring on top of each mushroom; fill with ground pork, then layer with tomato and mozzarella.",
      "secondary_message": null
    },
    {
      "id": 258533,
      "primary_message": "Place mushroom stacks in the oven and broil until cheese is melted and golden, 2-3 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 258534,
      "primary_message": "To serve, divide mushroom stacks between plates and sprinkle with crushed red pepper; enjoy!",
      "secondary_message": "3 pinch crushed red pepper"
    }
  ],
