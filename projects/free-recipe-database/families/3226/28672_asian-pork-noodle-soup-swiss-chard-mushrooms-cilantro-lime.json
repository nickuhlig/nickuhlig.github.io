  "instructions": [
    {
      "id": 470681,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n½ lb cremini mushrooms\n½ bunch Swiss chard\n½ small bunch cilantro\n½ small bunch green onions (scallions)\n½ lime"
    },
    {
      "id": 470682,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 470683,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 470684,
      "primary_message": "Preheat a medium saucepan over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 470685,
      "primary_message": "While the pan heats up, fold chard leaves in half lengthwise and slice off the stems. Cut leaves into bite-sized pieces and thinly slice the stems, keeping them separate. Place leaves in another medium bowl, reserving stems for the next step.",
      "secondary_message": null
    },
    {
      "id": 470686,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add ginger, garlic, mushrooms, chard stems, pork, and spices. Cook, breaking the meat apart with a spoon, until the pork is cooked through and chard stems are tender, about 5 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil\n¾ lb lean ground pork\n¼ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 470687,
      "primary_message": "Add broth, water, soy sauce, and fish sauce to the pan. Stir to combine, cover, and bring to a boil over high heat.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 cup water\n1 ½ tbsp soy sauce\n1 ½ tbsp fish sauce"
    },
    {
      "id": 470688,
      "primary_message": "Once the broth is boiling, uncover, add rice noodles, and stir to combine the soup. Reduce heat to medium and simmer, stirring occasionally, until noodles are almost soft, 6-8 minutes.",
      "secondary_message": "3 oz flat rice (pad thai) noodles"
    },
    {
      "id": 470689,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the chard leaves. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 470690,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 470691,
      "primary_message": "When the noodles are almost soft, add chard leaves, cilantro, and green onions to the pan in handfuls, waiting for the leaves to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 470692,
      "primary_message": "Continue to cook until noodles and chard leaves are tender, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 470693,
      "primary_message": "Juice lime into the pan, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 470694,
      "primary_message": "To serve, divide soup between bowls, then top with reserved cilantro and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
