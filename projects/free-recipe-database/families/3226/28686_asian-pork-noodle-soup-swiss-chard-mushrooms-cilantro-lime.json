  "instructions": [
    {
      "id": 470877,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n0.68 kg cremini mushrooms\n1 ½ bunches Swiss chard\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 ½ limes"
    },
    {
      "id": 470878,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 470879,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 470880,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves into bite-sized pieces and thinly slice the stems, keeping them separate. Place leaves in a large bowl, reserving stems for later use.",
      "secondary_message": null
    },
    {
      "id": 470881,
      "primary_message": "Preheat a large pot over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 470882,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, mushrooms, chard stems, pork, and spices. Cook, breaking the meat apart with a spoon, until the pork is cooked through and chard stems are tender, 6-7 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n1.02 kg lean ground pork\n¾ tsp crushed red pepper\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 470883,
      "primary_message": "Add broth, water, soy sauce, and fish sauce to the pot. Stir to combine, cover, and bring to a boil over high heat.",
      "secondary_message": "1420 ml chicken or vegetable broth\n6 cup water\n¼ cup soy sauce\n¼ cup fish sauce"
    },
    {
      "id": 470884,
      "primary_message": "Once the broth is boiling, uncover, add rice noodles, and stir to combine the soup. Reduce heat to medium and simmer, stirring occasionally, until noodles are almost soft, 6-8 minutes.",
      "secondary_message": "255 g flat rice (pad thai) noodles"
    },
    {
      "id": 470885,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the chard leaves. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 470886,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 470887,
      "primary_message": "When the noodles are almost soft, add chard leaves, cilantro, and green onions to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 470888,
      "primary_message": "Continue to cook until noodles and chard leaves are tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 470889,
      "primary_message": "Juice limes into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 470890,
      "primary_message": "To serve, divide soup between bowls, then top with reserved cilantro and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
