  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Coat a baking sheet pan with cooking spray. \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place egg in a small bowl, whisk to combine, and set aside.\n\n",
      "secondary_message": "1 egg"
    },
    {
      "primary_message": "Open the crescent roll package and unroll the dough onto a flat surface. Separate into 8 triangles along the perforated lines. \n\n",
      "secondary_message": "1 (228 g) tube crescent roll dough"
    },
    {
      "primary_message": "Divide cheese and ham between the triangles, arranging in an overlapping row at the base of each triangle. Working from the base, roll the pastry around the ham and cheese. \n\n",
      "secondary_message": "8 slice colby jack cheese, sliced\n128 g honey ham, sliced"
    },
    {
      "primary_message": "Arrange rolls on the baking sheet, spacing them at least 1-inch apart. Brush with egg wash, then sprinkle with garlic powder and salt.\n\n",
      "secondary_message": "⅛ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "primary_message": "Place rolls in the oven and bake until golden and cheese is melted, about 12 minutes. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide rolls between plates and enjoy!",
      "secondary_message": null
    }
  ],
