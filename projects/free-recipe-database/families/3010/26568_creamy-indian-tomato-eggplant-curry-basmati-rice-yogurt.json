  "instructions": [
    {
      "id": 430473,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 430474,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 430475,
      "primary_message": "Meanwhile, wash, dry, trim, and quarter eggplants lengthwise, then cut crosswise into ½-inch thick pieces. Place in a medium bowl.",
      "secondary_message": "3 eggplants"
    },
    {
      "id": 430476,
      "primary_message": "Peel, halve, and medium dice onions. Add to the bowl with the eggplant. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 430477,
      "primary_message": "Wash, dry, peel, and mince ginger. Add to the bowl. ",
      "secondary_message": "3 (1 inch) pieces ginger root"
    },
    {
      "id": 430478,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 430479,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add eggplant, onion, ginger, and spices; cook, stirring occasionally, until eggplant softens, 5-7 minutes. ",
      "secondary_message": "¼ cup virgin coconut oil\n2 tbsp curry powder\n1 ½ tsp garlic powder\n1 ½ tsp salt"
    },
    {
      "id": 430480,
      "primary_message": "Add marinara sauce and cream to the pot; stir combine the curry and bring to a boil. Once boiling, reduce to a simmer and continue to cook, stirring occasionally, until eggplant is tender and curry thickens, about 5 minutes. Remove from heat and cover to keep warm. ",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce\n12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 430481,
      "primary_message": "To serve, divide rice and curry between plates or bowls, then top with yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
