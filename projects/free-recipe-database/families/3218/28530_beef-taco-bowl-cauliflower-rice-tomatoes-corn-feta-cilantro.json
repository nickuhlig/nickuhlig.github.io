  "instructions": [
    {
      "id": 456216,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 456217,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup white wine vinegar\n2 ½ tsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 456218,
      "primary_message": "Peel and halve onions. Slice half of the onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. (Reserve remaining onions for later use.)",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 456219,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ pints grape tomatoes\n1 small bunch cilantro\n3 limes"
    },
    {
      "id": 456220,
      "primary_message": "Cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 456221,
      "primary_message": "Drizzle oil over the cauliflower and season with salt. Stir to combine, then spread out in an even layer.",
      "secondary_message": "3 tbsp neutral vegetable oil\n¾ tsp salt"
    },
    {
      "id": 456222,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until rice is tender and golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 456223,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456224,
      "primary_message": "While the pot heats up, medium dice the reserved onions.",
      "secondary_message": null
    },
    {
      "id": 456225,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the onion and beef; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n2 ¼ lb lean ground beef"
    },
    {
      "id": 456226,
      "primary_message": "Add whole tomatoes, corn, and spices to the pot. Continue to cook, stirring occasionally, until tomatoes are starting to brown and burst, 6-8 minutes more.",
      "secondary_message": "2 ¼ cups frozen corn\n3 tbsp chili powder\n1 tbsp oregano, dried\n2 ½ tsp salt"
    },
    {
      "id": 456227,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 456228,
      "primary_message": "When the tomatoes are starting to burst, juice limes into the pot, then add water, hot sauce, and half of the cilantro. Cook, stirring occasionally, until sauce is thickened, 2-3 minutes. Remove from heat. (Reserve remaining cilantro for serving.) ",
      "secondary_message": "1 cup water\n2 tbsp hot sauce"
    },
    {
      "id": 456229,
      "primary_message": "To serve, divide cauliflower rice between plates or bowls. Top with beef and veggies, feta, pickled onion, and reserved cilantro. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
