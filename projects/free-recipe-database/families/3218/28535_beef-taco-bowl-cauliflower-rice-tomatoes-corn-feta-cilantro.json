  "instructions": [
    {
      "id": 456286,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 456287,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup white wine vinegar\n1 ½ tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 456288,
      "primary_message": "Peel and halve onions. Slice one onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. (Reserve remaining onion for later use.)",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 456289,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 small pkg grape tomatoes\n1 small bunch cilantro\n2 limes"
    },
    {
      "id": 456290,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 456291,
      "primary_message": "Drizzle oil over the cauliflower and season with salt. Stir to combine, then spread out in an even layer.",
      "secondary_message": "2 tbsp neutral vegetable oil\n½ tsp salt"
    },
    {
      "id": 456292,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until rice is tender and golden, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 456293,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456294,
      "primary_message": "While the skillet heats up, medium dice the reserved onion.",
      "secondary_message": null
    },
    {
      "id": 456295,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and beef; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp neutral vegetable oil\n0.68 kg lean ground beef"
    },
    {
      "id": 456296,
      "primary_message": "Add whole tomatoes, corn, and spices to the skillet. Continue to cook, stirring occasionally, until tomatoes are starting to brown and burst, 5-7 minutes more.",
      "secondary_message": "1 ½ cups frozen corn\n2 tbsp chili powder\n2 tsp oregano, dried\n1 ½ tsp salt"
    },
    {
      "id": 456297,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 456298,
      "primary_message": "When the tomatoes are starting to burst, juice limes into the skillet, then add water, hot sauce, and half of the cilantro. Cook, stirring occasionally, until sauce is thickened, 1-2 minutes. Remove from heat. (Reserve remaining cilantro for serving.) ",
      "secondary_message": "⅔ cup water\n4 tsp hot sauce"
    },
    {
      "id": 456299,
      "primary_message": "To serve, divide cauliflower rice between plates or bowls. Top with beef and veggies, feta, pickled onion, and reserved cilantro. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
