  "instructions": [
    {
      "id": 363348,
      "primary_message": "Preheat oven to 205°C (400°F). Line two large baking sheet pans with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 363349,
      "primary_message": "Place oil, curry paste, and soy sauce in a large bowl. Whisk to combine the sauce.",
      "secondary_message": "¼ cup toasted sesame oil\n3 tbsp Thai curry paste, red\n2 tbsp soy sauce"
    },
    {
      "id": 363350,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the sauce.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 363351,
      "primary_message": "Add broccoli to the bowl and toss to coat. Divide chicken and broccoli between the baking sheets, then spread out in an even layer.",
      "secondary_message": "1 ½ (510 g) bags broccoli florets"
    },
    {
      "id": 363352,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing broccoli and flipping chicken halfway through, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363353,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Once boiling, reduce heat to medium.",
      "secondary_message": null
    },
    {
      "id": 363354,
      "primary_message": "Remove husks and silks from corn.",
      "secondary_message": "6 ears corn"
    },
    {
      "id": 363355,
      "primary_message": "When the chicken and broccoli are almost done, uncover the pot and use tongs to lower the corn into the water. Cook until just tender, 5-6 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 363356,
      "primary_message": "Meanwhile, place additional oil, soy sauce, and sesame seeds in a small bowl. Whisk to combine the sesame oil and set aside.",
      "secondary_message": "3 tbsp toasted sesame oil\n1 tbsp soy sauce\n1 tbsp sesame seeds"
    },
    {
      "id": 363357,
      "primary_message": "To serve, divide chicken, broccoli, and corn between plates; drizzle corn with sesame oil. Enjoy!",
      "secondary_message": null
    }
  ],
