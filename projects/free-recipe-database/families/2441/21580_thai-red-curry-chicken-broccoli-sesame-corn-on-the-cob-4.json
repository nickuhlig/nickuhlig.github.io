  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. Line a baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "Place oil, curry paste, and soy sauce in a medium bowl. Whisk to combine the sauce.",
      "secondary_message": "toasted sesame oil\n1 tbsp Thai curry paste, red"
    },
    {
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the sauce.",
      "secondary_message": "454 g chicken thighs, boneless skinless"
    },
    {
      "primary_message": "Add broccoli to the bowl and toss to coat. Transfer chicken and broccoli to the baking sheet, then spread out in an even layer.",
      "secondary_message": "½ (510 g) bag broccoli florets"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing broccoli and flipping chicken halfway through, until cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Once boiling, reduce heat to medium.",
      "secondary_message": null
    },
    {
      "primary_message": "Remove husks and silks from corn.",
      "secondary_message": "2 ears corn"
    },
    {
      "primary_message": "When the chicken and broccoli are almost done, uncover the pot and use tongs to lower the corn into the water. Cook until just tender, about 5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place additional oil, soy sauce, and sesame seeds in a small bowl. Whisk to combine the sesame oil and set aside.",
      "secondary_message": "toasted sesame oil\n1 tsp sesame seeds"
    },
    {
      "primary_message": "To serve, divide chicken, broccoli, and corn between plates; drizzle corn with sesame oil. Enjoy!",
      "secondary_message": null
    }
  ],
