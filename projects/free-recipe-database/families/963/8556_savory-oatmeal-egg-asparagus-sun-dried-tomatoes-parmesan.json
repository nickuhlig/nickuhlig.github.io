  "instructions": [
    {
      "id": 129684,
      "primary_message": "Wash and dry the asparagus. Snap or cut off woody ends, then cut into 3-inch pieces. ",
      "secondary_message": "1 ½ small bunches asparagus"
    },
    {
      "id": 129685,
      "primary_message": "Add salt and broth to a medium saucepan, cover, and bring to a boil over high heat. Once boiling, stir in oats and reduce heat to medium-low. Cover and let simmer for 3-5 minutes or until oats reach desired consistency. ",
      "secondary_message": "3 pinch salt\n1420 ml chicken or vegetable broth\n3 cup oats, quick cooking"
    },
    {
      "id": 129686,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 129687,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus and season with salt and pepper. Cook, turning often, until crisp-tender, 5-7 minutes. When done, transfer asparagus to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 129688,
      "primary_message": "Return skillet to stove, reduce heat to medium, and add more oil. Gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes. Cook in batches if necessary. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 129689,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 129690,
      "primary_message": "Thinly slice sun-dried tomatoes. ",
      "secondary_message": "24 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 129691,
      "primary_message": "To serve, divide the oatmeal between bowls and top with asparagus and eggs. Garnish with Parmesan and sun-dried tomatoes. Enjoy! ",
      "secondary_message": null
    }
  ],
