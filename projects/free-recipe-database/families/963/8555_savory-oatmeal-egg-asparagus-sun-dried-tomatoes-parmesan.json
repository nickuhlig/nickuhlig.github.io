  "instructions": [
    {
      "id": 129676,
      "primary_message": "Wash and dry the asparagus. Snap or cut off woody ends, then cut into 3-inch pieces. ",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 129677,
      "primary_message": "Add salt and broth to a medium saucepan, cover, and bring to a boil over high heat. Once boiling, stir in oats and reduce heat to medium-low. Cover and let simmer for 3-5 minutes or until oats reach desired consistency. ",
      "secondary_message": "⅛ tsp salt\n946 ml chicken or vegetable broth\n2 cup oats, quick cooking"
    },
    {
      "id": 129678,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 129679,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus and season with salt and pepper. Cook, turning often, until crisp-tender, about 5 minutes. When done, transfer asparagus to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 129680,
      "primary_message": "Return skillet to stove, reduce heat to medium, and add more oil. Gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 129681,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 129682,
      "primary_message": "Thinly slice sun-dried tomatoes. ",
      "secondary_message": "16 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 129683,
      "primary_message": "To serve, divide the oatmeal between bowls and top with asparagus and eggs. Garnish with Parmesan and sun-dried tomatoes. Enjoy! ",
      "secondary_message": null
    }
  ],
