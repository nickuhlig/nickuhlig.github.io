  "instructions": [
    {
      "id": 431983,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 431984,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431985,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 431986,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 431987,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (6 oz) pkg blackberries\n2 tomatoes\n1 peach\n½ small pkg fresh basil"
    },
    {
      "id": 431988,
      "primary_message": "Place blackberries in a small bowl along with spices, then gently crush with a fork or potato masher. Set blackberry sauce aside.",
      "secondary_message": "¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 431989,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 431990,
      "primary_message": "Arrange pitas on a baking sheet pan. Spread blackberry sauce over each pita (leaving a ½-inch border around the edge), then top with cheese and crispy bacon.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 431991,
      "primary_message": "Place pizzas in the oven (it doesn't have to be fully heated) and bake until the pitas are crisp and cheese is melted, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 431992,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in a medium bowl along with oil, vinegar, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n2 tsp extra virgin olive oil\n1 ½ tsp white wine vinegar\n½ tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 431993,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 431994,
      "primary_message": "Quarter peach lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 431995,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl and stir to combine the salad (reserving a small handful for the pizzas).",
      "secondary_message": null
    },
    {
      "id": 431996,
      "primary_message": "When the pizzas are done, remove from the oven and sprinkle with reserved basil; cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 431997,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
