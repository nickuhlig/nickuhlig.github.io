  "instructions": [
    {
      "id": 432058,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 432059,
      "primary_message": "Medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 432060,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 432061,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 432062,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (170 g) pkgs blackberries\n6 tomatoes\n3 peaches\n1 small pkg fresh basil"
    },
    {
      "id": 432063,
      "primary_message": "Place blackberries in a medium bowl along with spices, then gently crush with a fork or potato masher. Set blackberry sauce aside.",
      "secondary_message": "¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 432064,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 432065,
      "primary_message": "Divide pitas between two baking sheet pans. Spread blackberry sauce over each pita (leaving a ½-inch border around the edge), then top with cheese and crispy bacon.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 432066,
      "primary_message": "Place pizzas in the oven (it doesn't have to be fully heated) and bake until the pitas are crisp and cheese is melted, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 432067,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in another medium bowl along with oil, vinegar, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n1 ½ tbsp white wine vinegar\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 432068,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 432069,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 432070,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl and stir to combine the salad (reserving a small handful for the pizzas).",
      "secondary_message": null
    },
    {
      "id": 432071,
      "primary_message": "When the pizzas are done, remove from the oven and sprinkle with reserved basil; cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 432072,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
