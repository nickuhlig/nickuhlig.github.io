  "instructions": [
    {
      "id": 417549,
      "primary_message": "Drain and rinse beans; transfer to a small saucepan.",
      "secondary_message": "1 (398 ml) can pinto beans"
    },
    {
      "id": 417550,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and add to the pan with the beans. Add water and taco seasoning; bring the mixture to a boil over high heat.",
      "secondary_message": "⅓ cup basmati rice\n⅔ cup water\n1 ½ tbsp taco seasoning"
    },
    {
      "id": 417551,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook until liquid is fully absorbed, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 417552,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 heart romaine hearts\n½ small pkg grape tomatoes\n½ bunch radish\n1 lime"
    },
    {
      "id": 417553,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 417554,
      "primary_message": "Halve tomatoes and add to the bowl with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 417555,
      "primary_message": "Trim and thinly slice radishes; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 417556,
      "primary_message": "Slice lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 417557,
      "primary_message": "Divide rice and beans, salad, chips, and lime wedges between bowls; serve with guacamole and salsa on the side. Enjoy!",
      "secondary_message": "57 g Late July sea salt multigrain tortilla chips\n½ cup guacamole\n½ cup Pace chunky salsa"
    }
  ],
