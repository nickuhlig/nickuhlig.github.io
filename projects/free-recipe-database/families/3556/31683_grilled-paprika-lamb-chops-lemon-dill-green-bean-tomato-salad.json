  "instructions": [
    {
      "id": 500367,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 500368,
      "primary_message": "While the pan heats up, pat the lamb chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "12 lamb loin chops\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 500369,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches, add chops and grill until lamb is golden brown and cooked through, about 3 minutes per side. Remove to a clean plate and set aside to rest.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 500370,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 500371,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "1.02 kg green beans\n1 ½ lemons\n1 small bunch fresh dill\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 500372,
      "primary_message": "Trim green beans.",
      "secondary_message": null
    },
    {
      "id": 500373,
      "primary_message": "Once the water is boiling, add green beans to the pot; cook until bright green and fork tender, 3-4 minutes. Drain in a colander, rinse under cold water to cool, and set aside to drain.",
      "secondary_message": null
    },
    {
      "id": 500374,
      "primary_message": "Meanwhile, zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 500375,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon.",
      "secondary_message": null
    },
    {
      "id": 500376,
      "primary_message": "Peel and mince shallots. Add to the bowl, along with mayo, Dijon, oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n3 tbsp mayonnaise\n2 tbsp Dijon mustard\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 500377,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with cooled green beans, and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 500378,
      "primary_message": "To serve, divide the lamb chops and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
