  "instructions": [
    {
      "id": 500283,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 500284,
      "primary_message": "While the pan heats up, pat the lamb chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "8 lamb loin chops\n1 tsp smoked paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 500285,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add chops and grill until lamb is golden brown and cooked through, about 3 minutes per side. Remove to a clean plate and set aside to rest.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 500286,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 500287,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb green beans\n1 lemon\n1 small bunch fresh dill\n1 pint grape tomatoes"
    },
    {
      "id": 500288,
      "primary_message": "Trim green beans.",
      "secondary_message": null
    },
    {
      "id": 500289,
      "primary_message": "Once the water is boiling, add green beans to the pot; cook until bright green and fork tender, 3-4 minutes. Drain in a colander, rinse under cold water to cool, and set aside to drain.",
      "secondary_message": null
    },
    {
      "id": 500290,
      "primary_message": "Meanwhile, zest and juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 500291,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon.",
      "secondary_message": null
    },
    {
      "id": 500292,
      "primary_message": "Peel and mince shallot. Add to the bowl, along with mayo, Dijon, oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp mayonnaise\n4 tsp Dijon mustard\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 500293,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with cooled green beans, and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 500294,
      "primary_message": "To serve, divide the lamb chops and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
