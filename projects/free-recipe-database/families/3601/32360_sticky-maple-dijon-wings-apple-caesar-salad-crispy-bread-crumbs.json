  "instructions": [
    {
      "id": 511879,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 511880,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed\n2 tbsp cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 511881,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 511882,
      "primary_message": "Meanwhile, place maple syrup, Dijon, salt, and pepper in a clean medium bowl. Whisk to combine the maple-Dijon sauce and set aside.",
      "secondary_message": "¼ cup pure maple syrup\n2 tbsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 511883,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 511884,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread crumbs and salt; cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to a small bowl and set aside to cool. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ cup panko bread crumbs\n⅛ tsp salt"
    },
    {
      "id": 511885,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 head romaine lettuce\n2 Gala apples"
    },
    {
      "id": 511886,
      "primary_message": "Peel and mince garlic. Mince anchovy fillets. Place both in another clean medium bowl.",
      "secondary_message": "2 cloves garlic\n2 anchovy fillets, packed in oil"
    },
    {
      "id": 511887,
      "primary_message": "Juice lemon into the bowl with the garlic and anchovy.",
      "secondary_message": null
    },
    {
      "id": 511888,
      "primary_message": "Finely grate Parmesan. Add to the bowl along with mayo, oil, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "57 g Parmesan cheese\n2 tbsp mayonnaise\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 511889,
      "primary_message": "When the wings are almost done, separate lettuce into leaves, tearing larger leaves into pieces as needed. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 511890,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl, gently toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 511891,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the maple-Dijon sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 511892,
      "primary_message": "To serve, divide wings and salad between plates. Top salad with crispy breadcrumbs and enjoy!",
      "secondary_message": null
    }
  ],
