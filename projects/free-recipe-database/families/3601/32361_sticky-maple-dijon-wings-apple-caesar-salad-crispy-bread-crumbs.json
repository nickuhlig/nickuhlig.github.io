  "instructions": [
    {
      "id": 511893,
      "primary_message": "Preheat oven to 260°C (500°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 511894,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Divide between the baking sheets and spread out in an even layer.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed\n3 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 511895,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 511896,
      "primary_message": "Meanwhile, place maple syrup, Dijon, salt, and pepper in a clean large bowl. Whisk to combine the maple-Dijon sauce and set aside.",
      "secondary_message": "⅓ cup pure maple syrup\n3 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 511897,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 511898,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread crumbs and salt; cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to a small bowl and set aside to cool. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ cup panko bread crumbs\n3 pinch salt"
    },
    {
      "id": 511899,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ heads romaine lettuce\n3 Gala apples"
    },
    {
      "id": 511900,
      "primary_message": "Peel and mince garlic. Mince anchovy fillet. Place both in another clean large bowl.",
      "secondary_message": "3 cloves garlic\n3 anchovy fillets, packed in oil"
    },
    {
      "id": 511901,
      "primary_message": "Juice lemons into the bowl with the garlic and anchovy.",
      "secondary_message": null
    },
    {
      "id": 511902,
      "primary_message": "Finely grate Parmesan. Add to the bowl along with mayo, oil, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "85 g Parmesan cheese\n3 tbsp mayonnaise\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 511903,
      "primary_message": "When the wings are almost done, separate lettuce into leaves, tearing larger leaves into pieces as needed. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 511904,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl, gently toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 511905,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the maple-Dijon sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 511906,
      "primary_message": "To serve, divide wings and salad between plates. Top salad with crispy breadcrumbs and enjoy!",
      "secondary_message": null
    }
  ],
