  "instructions": [
    {
      "id": 283348,
      "primary_message": "This recipe will make about 9 cups of smoothie. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 283349,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 bananas\n1 ½ limes\n1 ½ (6 oz) pkgs blackberries"
    },
    {
      "id": 283350,
      "primary_message": "Peel and thinly slice bananas; set aside.",
      "secondary_message": null
    },
    {
      "id": 283351,
      "primary_message": "Zest and juice limes into a blender.",
      "secondary_message": null
    },
    {
      "id": 283352,
      "primary_message": "Add frozen mixed berries, yogurt, milk, honey, and cinnamon to the blender.",
      "secondary_message": "6 cup frozen mixed berries\n3 cups plain Greek yogurt\n12 fl oz (1 ½ cups) whole milk\n⅓ cup honey\n¾ tsp cinnamon, ground"
    },
    {
      "id": 283353,
      "primary_message": "Blend on high speed until smooth, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 283354,
      "primary_message": "To serve, divide smoothie between bowls and top with banana, blackberries, and granola. Enjoy!",
      "secondary_message": "2 cup granola, nut free"
    }
