  "instructions": [
    {
      "id": 288659,
      "primary_message": "Place cherries, cranberries, vinegar, sugar, and spices in a small saucepan. Bring to a boil over medium-high heat.",
      "secondary_message": "¾ cup frozen cherries\n⅛ cup dried cranberries\n2 tsp red wine vinegar\n½ tsp brown sugar\n¼ tsp rosemary, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 288660,
      "primary_message": "Once boiling, gently crush the fruit with the back of a spoon to release juices. Reduce heat to a simmer and continue cooking, stirring occasionally, until thickened, about 15 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 288661,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 288662,
      "primary_message": "Wash, dry, and juice lemon into the bowl with the garlic. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "½ lemon\n2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 288663,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl. Use your hands to massage the dressing into the kale until slightly softened; set aside. ",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 288664,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 288665,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 veggie burger patties, plant-based"
    },
    {
      "id": 288666,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 288667,
      "primary_message": "Place bottom half of a bun on each plate, then top with burgers, blue cheese, and cherry sauce. Close with the top half of the bun and serve with salad on the side. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled blue cheese"
    }
  ],
