  "instructions": [
    {
      "id": 288649,
      "primary_message": "Place cherries, cranberries, vinegar, sugar, and spices in a medium saucepan. Bring to a boil over medium-high heat.",
      "secondary_message": "2 ¼ cup frozen cherries\n⅓ cup dried cranberries\n2 tbsp red wine vinegar\n1 ½ tsp brown sugar\n¾ tsp rosemary, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 288650,
      "primary_message": "Once boiling, gently crush the fruit with the back of a spoon to release juices. Reduce heat to a simmer and continue cooking, stirring occasionally, until thickened, 15-20 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 288651,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 288652,
      "primary_message": "Wash, dry, and juice lemons into the bowl with the garlic. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 ½ lemons\n2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 288653,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl. Use your hands to massage the dressing into the kale until slightly softened; set aside. ",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 288654,
      "primary_message": "Form the ground beef into 6 equal-sized patties, place on a plate, and season with spices.",
      "secondary_message": "2 ¼ lb lean ground beef\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 288655,
      "primary_message": "Preheat a large grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 288656,
      "primary_message": "Once the grill pan is hot, place patties in the pan and cook, undisturbed, for 5 minutes; flip patties and cook an additional 2-3 minutes, until cooked through. Work in batches if necessary. Once done, transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 288657,
      "primary_message": "If desired, place buns, cut-side down, on the grill pan to toast, 1-2 minutes.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 288658,
      "primary_message": "Place bottom half of a bun on each plate, then top with burgers, blue cheese, and cherry sauce. Close with the top half of the bun and serve with salad on the side. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    }
  ],
