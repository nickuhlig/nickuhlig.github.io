  "instructions": [
    {
      "id": 19098,
      "primary_message": "Fill a large pot halfway with water, add salt, and bring to a boil.",
      "secondary_message": "2 tsp salt"
    },
    {
      "id": 19099,
      "primary_message": "Wash asparagus and snap off woody ends. Add to boiling water and cook until bright green and tender-crisp, 2-3 minutes. Drain in a colander.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 19100,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 19101,
      "primary_message": "Wash and halve tomatoes. Peel and mince garlic.",
      "secondary_message": "1 small pkg grape tomatoes\r\n2 cloves garlic"
    },
    {
      "id": 19102,
      "primary_message": "Season steak with salt and pepper.",
      "secondary_message": "0.68 kg ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 19103,
      "primary_message": "Coat bottom of skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 19104,
      "primary_message": "Once steak has been transferred, lower heat to medium. Add garlic and tomatoes to skillet and cook for 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 19105,
      "primary_message": "Add balsamic vinegar, salt, and pepper to tomatoes. Stir and cook for another 1-2 minutes.",
      "secondary_message": "2 tbsp balsamic vinegar\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19106,
      "primary_message": "To serve, arrange asparagus on a plate and top with tomato mixture. Add steak on the side and enjoy!",
      "secondary_message": ""
    }
  ],
