  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine the meat, salt, pepper, garlic, basil, and tomatoes and toss together until evenly mixed. Chill until ready to grind.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Grind the mixture trough the small die into a bowl set in ice.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using the paddle attachment of a standing mixer, mix on low speed for 1 minute. Add the vinegar, oil, and wine, increase the speed to medium, and mix for 1 more minute, or until liquid is incorporated and the sausage has a uniform, sticky appearance.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Fry a bite-sized portion of the sausage, taste and adjust the seasoning if necessary.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Stuff the sausage into the hog casings and twist into 15-cm links. Refrigerate or freeze until ready to cook.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly over the charcoal grate. Grill the sausage over direct heat until cooked through, having an internal temperature of 160 degrees Fahrenheit.",
      "secondary_message": null
    }
  ],
