  "instructions": [
    {
      "id": 564459,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add orzo, and stir for a few seconds; cook until desired firmness, about 8 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g orzo pasta"
    },
    {
      "id": 564460,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch green onions (scallions)\n1 ½ (227 g) pkgs sugar snap peas"
    },
    {
      "id": 564461,
      "primary_message": "Zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 564462,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 564463,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the bowl with the dressing.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 564464,
      "primary_message": "Thinly slice green onions crosswise (at an angle). Add the white and pale green parts to the bowl. (Reserve dark green parts for serving.)",
      "secondary_message": null
    },
    {
      "id": 564465,
      "primary_message": "Place frozen peas in a colander and run under warm water (from the tap) to thaw. Add to the bowl.",
      "secondary_message": "3 cups frozen peas"
    },
    {
      "id": 564466,
      "primary_message": "When the orzo is done, drain in a colander, then add to the bowl with the dressing and veggies. Stir to combine and set aside to cool, 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 564467,
      "primary_message": "Meanwhile, thinly slice snap peas crosswise (at an angle).",
      "secondary_message": null
    },
    {
      "id": 564468,
      "primary_message": "Finely grate Parmesan. ",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 564469,
      "primary_message": "Once the orzo is cool, add Parmesan and snap peas to the bowl. Stir once more to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 564470,
      "primary_message": "To serve, divide orzo salad between plates or bowls. Top with reserved green onions and season with pepper. Enjoy!",
      "secondary_message": "3 pinch black pepper"
    }
  ],
