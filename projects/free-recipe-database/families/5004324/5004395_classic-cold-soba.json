  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the nori into thin strips.",
      "secondary_message": "1 large sheet nori"
    },
    {
      "id": 1,
      "primary_message": "Bring dashi, soy sauce, mirin, and sugar to gentle boil over medium heat. Remove from heat and allow to cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Set out 4 serving plates. Divide equally among plates: dab of wasabi, grated daikon, and scallions.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In the meantime, bring 2-quart pot of water to boil over high heat and add soba. Return water to boil and cook the noodles until tender but firm, 3 to 5 minutes. Have ready a large bowl or pot ready with ice water. Use strainer to remove soba from pot. Place soba into ice water and chill until noodles are cold. Drain noodles.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Divide noodles evenly between the four plates, mounding the noodles. Pour dipping sauce into individual little bowls to serve alongside noodles.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "To eat, stir some daikon, wasabi, and green onion into dipping sauce. Top noodles with sliced nori, then take some noodles with chopsticks and dip.",
      "secondary_message": null
    }
  ],
