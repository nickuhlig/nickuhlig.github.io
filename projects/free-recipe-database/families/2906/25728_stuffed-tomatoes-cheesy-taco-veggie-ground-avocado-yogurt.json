  "instructions": [
    {
      "id": 419152,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 419153,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, taco seasoning, and salt to the skillet; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n¼ cup taco seasoning\n½ tsp salt"
    },
    {
      "id": 419154,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ heads butter (Boston) lettuce\n1 ½ avocados\n12 tomatoes"
    },
    {
      "id": 419155,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips. Place on a large plate. ",
      "secondary_message": null
    },
    {
      "id": 419156,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the plate with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 419157,
      "primary_message": "Trim tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom. Season with salt.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 419158,
      "primary_message": "Add cheese to the skillet with the veggie ground and stir to combine.",
      "secondary_message": "2 cups shredded cheese, Mexican blend"
    },
    {
      "id": 419159,
      "primary_message": "To serve, divide tomatoes between plates. Stuff with cheesy veggie ground, then top with lettuce, avocado, and yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
