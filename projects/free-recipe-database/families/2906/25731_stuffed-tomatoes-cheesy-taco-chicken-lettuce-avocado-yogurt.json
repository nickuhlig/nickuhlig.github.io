  "instructions": [
    {
      "id": 419176,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 419177,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken, taco seasoning, and salt to the skillet; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n0.68 kg ground chicken\n¼ cup taco seasoning\n¾ tsp salt"
    },
    {
      "id": 419178,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ heads butter (Boston) lettuce\n1 ½ avocados\n12 tomatoes"
    },
    {
      "id": 419179,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips. Place on a large plate. ",
      "secondary_message": null
    },
    {
      "id": 419180,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the plate with the lettuce. ",
      "secondary_message": null
    },
    {
      "id": 419181,
      "primary_message": "Trim tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom. Season with salt.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 419182,
      "primary_message": "Add cheese to the skillet with the chicken and stir to combine.",
      "secondary_message": "2 cups shredded cheese, Mexican blend"
    },
    {
      "id": 419183,
      "primary_message": "To serve, divide tomatoes between plates. Stuff with cheesy chicken, then top with lettuce, avocado, and yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
