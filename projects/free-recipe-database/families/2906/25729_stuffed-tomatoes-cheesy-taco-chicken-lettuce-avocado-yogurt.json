  "instructions": [
    {
      "id": 419160,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 419161,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken, taco seasoning, and salt to the skillet; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat. ",
      "secondary_message": "2 tsp extra virgin olive oil\n0.23 kg ground chicken\n1 ½ tbsp taco seasoning\n¼ tsp salt"
    },
    {
      "id": 419162,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ head butter (Boston) lettuce\n½ avocado\n4 tomatoes"
    },
    {
      "id": 419163,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips. Place on a plate. ",
      "secondary_message": null
    },
    {
      "id": 419164,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the plate with the lettuce. ",
      "secondary_message": null
    },
    {
      "id": 419165,
      "primary_message": "Trim tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom. Season with salt.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 419166,
      "primary_message": "Add cheese to the skillet with the chicken and stir to combine.",
      "secondary_message": "⅔ cup shredded cheese, Mexican blend"
    },
    {
      "id": 419167,
      "primary_message": "To serve, divide tomatoes between plates. Stuff with cheesy chicken, then top with lettuce, avocado, and yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
