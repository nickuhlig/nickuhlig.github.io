  "instructions": [
    {
      "id": 474349,
      "primary_message": "Preheat the oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 474350,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n0.23 kg cremini mushrooms\n½ lime\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 474351,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 474352,
      "primary_message": "Halve mushrooms and add to the baking sheet with the cauliflower. Drizzle with oil and season with salt. Stir to combine, then spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 474353,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower rice and mushrooms are tender and golden, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 474354,
      "primary_message": "Meanwhile, place ketchup, vinegar, sugar, Dijon, Worcestershire, chili powder, and salt in a small bowl. Stir to combine the BBQ sauce and set aside.",
      "secondary_message": "2 tbsp ketchup\n1 tbsp apple cider vinegar\n1 tsp brown sugar\n1 tsp Dijon mustard\n½ tsp Worcestershire sauce\n¼ tsp chili powder\n⅛ tsp salt"
    },
    {
      "id": 474355,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 474356,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a cutting board; slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "⅓ kg flank steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 474357,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and stir-fry until just cooked through, 3-4 minutes. Transfer to a plate and loosely cover with aluminum foil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 474358,
      "primary_message": "Meanwhile, using a clean cutting board, cut half of the lime into wedges and set aside for serving. (Reserve remaining lime for the next step.)",
      "secondary_message": null
    },
    {
      "id": 474359,
      "primary_message": "Juice remaining lime into a medium bowl, then add oil, Dijon, and salt. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n1 pinch salt"
    },
    {
      "id": 474360,
      "primary_message": "Add arugula to the bowl with the dressing and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 474361,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. ",
      "secondary_message": "⅔ cup frozen corn"
    },
    {
      "id": 474362,
      "primary_message": "Divide cauliflower rice, steak, corn, and arugula between bowls; drizzle steak with BBQ sauce. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
