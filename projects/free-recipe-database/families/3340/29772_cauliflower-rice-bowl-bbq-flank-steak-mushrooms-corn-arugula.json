  "instructions": [
    {
      "id": 474377,
      "primary_message": "Preheat the oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 474378,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n0.68 kg cremini mushrooms\n1 ½ limes\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 474379,
      "primary_message": "Cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 474380,
      "primary_message": "Halve mushrooms and add to the baking sheets with the cauliflower. Drizzle with oil and season with salt. Stir to combine, then spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 474381,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower rice and mushrooms are tender and golden, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 474382,
      "primary_message": "Meanwhile, place ketchup, vinegar, sugar, Dijon, Worcestershire, chili powder, and salt in a small bowl. Stir to combine the BBQ sauce and set aside.",
      "secondary_message": "⅓ cup ketchup\n3 tbsp apple cider vinegar\n1 tbsp brown sugar\n1 tbsp Dijon mustard\n1 ½ tsp Worcestershire sauce\n¾ tsp chili powder\n½ tsp salt"
    },
    {
      "id": 474383,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 474384,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a cutting board; slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "1.02 kg flank steaks\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 474385,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and stir-fry until just cooked through, 3-4 minutes. Transfer to a plate and loosely cover with aluminum foil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 474386,
      "primary_message": "Meanwhile, using a clean cutting board, cut half of the limes into wedges and set aside for serving. (Reserve remaining lime for the next step.)",
      "secondary_message": null
    },
    {
      "id": 474387,
      "primary_message": "Juice remaining lime into a large bowl, then add oil, Dijon, and salt. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n3 pinch salt"
    },
    {
      "id": 474388,
      "primary_message": "Add arugula to the bowl with the dressing and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 474389,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. ",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 474390,
      "primary_message": "Divide cauliflower rice, steak, corn, and arugula between bowls; drizzle steak with BBQ sauce. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
