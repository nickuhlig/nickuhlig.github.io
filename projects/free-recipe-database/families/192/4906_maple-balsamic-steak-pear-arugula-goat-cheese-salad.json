  "instructions": [
    {
      "id": 59663,
      "primary_message": "In a large bowl, whisk together vinegar, maple syrup, Dijon, salt, and pepper. Transfer ½ to a small bowl.",
      "secondary_message": "9 tbsp balsamic vinegar\n4 ½ tbsp pure maple syrup\n1 ½ tsp Dijon mustard\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 59671,
      "primary_message": "Place steak in large bowl and turn to coat.",
      "secondary_message": "1.02 kg ribeye steak"
    },
    {
      "id": 59670,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 59669,
      "primary_message": "Wash, core, and cut pears into thin wedges. Peel and thinly slice onion into half rings.",
      "secondary_message": "3 pears\n1 ½ medium red onion"
    },
    {
      "id": 59668,
      "primary_message": "Coat grill or bottom of skillet with oil. Add pear and onion slices; cook until lightly browned and tender, 2-3 minutes per side. Transfer to a large bowl.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 59667,
      "primary_message": "Add steak to grill/skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": ""
    },
    {
      "id": 59666,
      "primary_message": "Wash and dry arugula. Add to bowl with pears and onion and toss.",
      "secondary_message": "1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 59665,
      "primary_message": "Crumble goat cheese.",
      "secondary_message": "1 ½ (113 g) log goat cheese"
    },
    {
      "id": 59664,
      "primary_message": "To serve, place steak and salad on a plate, sprinkle with goat cheese, and drizzle with remaining sauce. Enjoy!",
      "secondary_message": ""
    }
  ],
