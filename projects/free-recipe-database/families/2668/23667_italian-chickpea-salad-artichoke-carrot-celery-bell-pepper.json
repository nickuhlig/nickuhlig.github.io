  "instructions": [
    {
      "id": 386655,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n1 ½ red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 386656,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 386657,
      "primary_message": "Place oil, vinegar, sugar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp white wine vinegar\n1 ½ tsp brown sugar\n1 ½ tsp Italian seasoning\n¾ tsp onion powder\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 386658,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 386659,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386660,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386661,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386662,
      "primary_message": "Drain and mince artichokes. Add to the bowl, along with the chickpeas, and stir to combine the salad.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 386663,
      "primary_message": "To serve, divide chickpea salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
