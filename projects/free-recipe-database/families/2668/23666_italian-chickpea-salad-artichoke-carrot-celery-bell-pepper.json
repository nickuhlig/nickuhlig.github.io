  "instructions": [
    {
      "id": 386646,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 red bell pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 386647,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 386648,
      "primary_message": "Place oil, vinegar, sugar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp white wine vinegar\n1 tsp brown sugar\n1 tsp Italian seasoning\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 386649,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 386650,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386651,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386652,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386653,
      "primary_message": "Drain and mince artichokes. Add to the bowl, along with the chickpeas, and stir to combine the salad.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 386654,
      "primary_message": "To serve, divide chickpea salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
