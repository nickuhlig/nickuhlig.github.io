  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Tartar Sauce: In a small mixing bowl, stir together yogurt, mayonnaise, capers, dill, lemon juice, and garlic until well combined. Season to taste with salt and pepper. Ideally, let sit covered in the refrigerator for at least 30 minutes before serving.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Salmon: Adjust oven rack to middle position and heat oven to 135°C (275°F). Lay four large pieces of foil onto the counter and place a salmon fillet in the center of each one, presentation-side up. Season with salt and pepper, then lay 2 or 3 lemon slices on top of each piece of fish. Place 2 small butter pieces (about 1/2 tablespoon total) on top of each portion, then scatter dill over the top.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Working with one fillet at a time, loosely fold the foil over the top of the fish, rolling gently to seal; seal the open ends. There should be a small amount of air space still left inside the packets. Place packets on a rimmed baking sheet.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bake until the center registers 115 to 50°C (125°F) (46 to 52°C) with an instant-read thermometer for medium-rare to medium or to desired doneness, 20 to 25 minutes. Serve with tartar sauce.",
      "secondary_message": null
    }
  ],
