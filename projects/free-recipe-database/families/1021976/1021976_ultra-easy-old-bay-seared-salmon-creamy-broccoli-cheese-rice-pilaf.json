  "instructions": [
    {
      "primary_message": "Place water, milk, rice mix, oil, and salt in a medium saucepan. Bring to a boil over medium-high heat. Once the liquid comes to a boil, stir the mixture, then add broccoli florets, allowing them to sit on top of the rice. Cover the saucepan, reduce heat to medium-low, and cook until rice is tender and broccoli is very soft, 7-10 minutes. Remove from heat and let sit 2 minutes, then stir until creamy and combined.",
      "secondary_message": "½ cup whole milk\n1 (5.7 oz) pkg cheddar-broccoli rice & pasta kit\n2 tbsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, pat salmon dry with paper towels and place, skin-side down, on a plate. Season the top side of the salmon with Old Bay seasoning.",
      "secondary_message": "12 oz salmon fillet\n1 tsp Old Bay seasoning"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "To serve, divide salmon and broccoli rice pilaf between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
