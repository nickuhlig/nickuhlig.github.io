  "instructions": [
    {
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Once done, remove quinoa from heat and spread it out on a baking sheet pan to cool, about 15 minutes.",
      "secondary_message": "½ cup quinoa\n1 cup chicken or vegetable broth"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ English cucumber"
    },
    {
      "primary_message": "Juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil and spices. Whisk to combine the dressing and divide between two (quart-sized) jars.",
      "secondary_message": "1 clove garlic\n¼ cup extra virgin olive oil\n¾ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Peel, halve, and small dice onion. Add to the jars with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "primary_message": "Roughly chop olives. Add to the jars.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "primary_message": "Medium dice tomatoes. Add to the jars.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and medium dice cucumber. Add to the jars.",
      "secondary_message": null
    },
    {
      "primary_message": "Place chicken on the cutting board and, using your hands, remove meat from the skin and bones; separate the meat into shred-like pieces. Add to the jars along with the feta.",
      "secondary_message": "½ (532 g) whole chicken rotisserie chicken, white and dark meat\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "primary_message": "When the quinoa is cooled, add to the jars, packing lightly if necessary.",
      "secondary_message": null
    },
    {
      "primary_message": "Screw lids onto jars and store in the fridge until needed. (Best if used within 2-3 days.)",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, empty jar into a bowl (making sure to scrape out all of the dressing!), then stir to combine. Enjoy!",
      "secondary_message": null
    }
  ],
