  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat bacon grease in medium saucepan over medium heat until shimmering. Add flour and tomato paste and cook, whisking constantly, until mixture darkens slightly, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Slowly whisk in diced tomatoes, milk, and heavy cream. Reduce to a simmer and cook until thickened, about 5 minutes, stirring occasionally. Remove from heat; season with salt and pepper to taste. Serve immediately.",
      "secondary_message": null
    }
