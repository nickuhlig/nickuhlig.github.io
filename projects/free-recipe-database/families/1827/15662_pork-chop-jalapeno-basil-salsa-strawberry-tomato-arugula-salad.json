  "instructions": [
    {
      "id": 258313,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lime\n1 jalapeño pepper\n½ small pkg fresh basil\n½ (16 oz) pkg strawberries\n½ pint grape tomatoes\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 258314,
      "primary_message": "Juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 258315,
      "primary_message": "Peel and mince garlic and shallot; add to the bowl with the lime juice along with oil, honey, and salt.",
      "secondary_message": "1 clove garlic\n1 shallot\n1 ½ tbsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt"
    },
    {
      "id": 258316,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 258317,
      "primary_message": "Pick basil leaves off the stems, discard stems, and mince the leaves. Add to the bowl and stir to combine the salsa; set aside.",
      "secondary_message": null
    },
    {
      "id": 258318,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258319,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 258320,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer chops to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 258321,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 258322,
      "primary_message": "Trim and quarter strawberries lengthwise; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258323,
      "primary_message": "Halve tomatoes; add to the bowl along with the arugula and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258324,
      "primary_message": "To serve, divide pork chops and salad between plates; spoon salsa over the chops and enjoy!",
      "secondary_message": null
    }
  ],
