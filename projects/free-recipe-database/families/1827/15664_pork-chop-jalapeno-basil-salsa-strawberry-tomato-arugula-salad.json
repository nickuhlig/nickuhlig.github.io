  "instructions": [
    {
      "id": 258337,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ limes\n3 jalapeño peppers\n1 ½ small pkgs fresh basil\n1 ½ (16 oz) pkg strawberries\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 258338,
      "primary_message": "Juice limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 258339,
      "primary_message": "Peel and mince garlic and onion; add to the bowl with the lime juice along with oil, honey, and salt.",
      "secondary_message": "3 cloves garlic\n½ medium red onion\n¼ cup extra virgin olive oil\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 258340,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 258341,
      "primary_message": "Pick basil leaves off the stems, discard stems, and mince the leaves. Add to the bowl and stir to combine the salsa; set aside.",
      "secondary_message": null
    },
    {
      "id": 258342,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258343,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 258344,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer chops to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 258345,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 258346,
      "primary_message": "Trim and quarter strawberries lengthwise; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258347,
      "primary_message": "Halve tomatoes; add to the bowl along with the arugula and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258348,
      "primary_message": "To serve, divide pork chops and salad between plates; spoon salsa over the chops and enjoy!",
      "secondary_message": null
    }
  ],
