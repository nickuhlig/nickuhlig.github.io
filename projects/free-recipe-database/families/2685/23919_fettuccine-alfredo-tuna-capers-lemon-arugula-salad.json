  "instructions": [
    {
      "id": 389555,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g fettuccine pasta"
    },
    {
      "id": 389556,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ small pkgs grape tomatoes\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 389557,
      "primary_message": "Juice lemons into a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 389558,
      "primary_message": "Drain tuna, add to the pan with the lemon juice, and break into bite-sized pieces.",
      "secondary_message": "6 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 389559,
      "primary_message": "Add Alfredo sauce, capers, and spices to the pan. Stir to combine the sauce and bring to a simmer over medium-high heat, stirring occasionally.",
      "secondary_message": "1 ½ (454 g) jars Alfredo sauce\n6 tbsp capers\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 389560,
      "primary_message": "Meanwhile, halve tomatoes and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 389561,
      "primary_message": "Once the sauce is simmering, remove from heat and cover with a lid to keep warm.",
      "secondary_message": null
    },
    {
      "id": 389562,
      "primary_message": "When the pasta is done, drain in a colander and return to the pot. Add the warm sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 389563,
      "primary_message": "To serve, divide pasta and arugula between plates. Top arugula with tomatoes, then drizzle with dressing. Enjoy!",
      "secondary_message": "⅓ cup Italian salad dressing"
    }
  ],
