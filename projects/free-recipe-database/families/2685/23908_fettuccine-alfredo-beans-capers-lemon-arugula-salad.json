  "instructions": [
    {
      "id": 389456,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n5 oz fettuccine pasta"
    },
    {
      "id": 389457,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lemon\n½ pint grape tomatoes\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 389458,
      "primary_message": "Juice lemon into a small saucepan.",
      "secondary_message": null
    },
    {
      "id": 389459,
      "primary_message": "Drain and rinse beans. Add to the pan with the lemon juice.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 389460,
      "primary_message": "Add Alfredo sauce, capers, and spices to the pan. Stir to combine the sauce and bring to a simmer over medium-high heat, stirring occasionally.",
      "secondary_message": "½ (16 oz) jar Alfredo sauce\n1 tbsp capers\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 389461,
      "primary_message": "Meanwhile, halve tomatoes and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 389462,
      "primary_message": "Once the sauce is simmering, remove from heat and cover with a lid to keep warm.",
      "secondary_message": null
    },
    {
      "id": 389463,
      "primary_message": "When the pasta is done, drain in a colander and return to the pan. Add the warm sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 389464,
      "primary_message": "To serve, divide pasta and arugula between plates. Top arugula with tomatoes, then drizzle with dressing. Enjoy!",
      "secondary_message": "2 tbsp Italian salad dressing"
    }
  ],
