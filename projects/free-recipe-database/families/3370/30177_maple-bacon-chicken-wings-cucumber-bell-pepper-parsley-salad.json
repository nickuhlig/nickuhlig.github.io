  "instructions": [
    {
      "id": 479777,
      "primary_message": "Preheat oven to 500°F. Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 479778,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with baking powder, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed\n1 tbsp baking powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 479779,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 479780,
      "primary_message": "Meanwhile, small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 479781,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479782,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until almost crispy, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 479783,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Place in a clean large bowl along with ketchup, water, maple syrup, soy sauce, vinegar, and cornstarch. Whisk to combine a smooth slurry.",
      "secondary_message": "6 cloves garlic\n⅓ cup ketchup\n⅓ cup water\n3 tbsp pure maple syrup\n3 tbsp soy sauce\n3 tbsp apple cider vinegar\n1 tbsp cornstarch"
    },
    {
      "id": 479784,
      "primary_message": "When the bacon is almost crispy, pour slurry into the skillet, stirring constantly. Bring to a boil over high heat and cook, stirring frequently, until sauce thickens, 3-4 minutes. Return sauce to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 479785,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 English cucumbers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 479786,
      "primary_message": "Place oil, vinegar, maple syrup, salt, and pepper in another large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n1 tbsp pure maple syrup\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 479787,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 479788,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 479789,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 479790,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 479791,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
