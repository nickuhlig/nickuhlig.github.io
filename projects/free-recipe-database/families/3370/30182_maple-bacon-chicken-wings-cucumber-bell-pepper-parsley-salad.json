  "instructions": [
    {
      "id": 479852,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 479853,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with baking powder, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed\n2 tsp baking powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 479854,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 479855,
      "primary_message": "While the chicken wings are baking, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479856,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 479857,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until almost crispy, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 479858,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Place in a clean medium bowl along with ketchup, water, maple syrup, soy sauce, vinegar, and cornstarch. Whisk to combine a smooth slurry.",
      "secondary_message": "4 cloves garlic\n¼ cup ketchup\n¼ cup water\n2 tbsp pure maple syrup\n2 tbsp soy sauce\n2 tbsp apple cider vinegar\n2 tsp cornstarch"
    },
    {
      "id": 479859,
      "primary_message": "When the bacon is almost crispy, pour slurry into the skillet, stirring constantly. Bring to a boil over high heat and cook, stirring frequently, until sauce thickens, 2-3 minutes. Return sauce to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 479860,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 English cucumbers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 479861,
      "primary_message": "Place oil, vinegar, maple syrup, salt, and pepper in another medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n2 tsp pure maple syrup\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 479862,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 479863,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 479864,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 479865,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 479866,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
