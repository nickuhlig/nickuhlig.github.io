  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a large pot of water to boil. With a large knife, cut off the top quarter of the artichokes and then remove the stem. Sprinkle the 1/4 teaspoon of salt on top of the them and then place them in a steamer basket over the boiling water. Cook for 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, combine all the ingredients for the vinaigrette and whisk until fully combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove the artichokes from the steamer basket and serve with the vinaigrette as a dipping sauce.",
      "secondary_message": null
    }
  ],
