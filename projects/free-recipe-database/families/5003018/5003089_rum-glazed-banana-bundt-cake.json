  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Soften the unsalted butter. Mash the ripe bananas. Toast and coarsely chop the cashews.",
      "secondary_message": "16 tbsp (8 oz) unsalted butter\n3 ripe bananas\n1 cup cashews"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Grease and flour a 10- to 12-cup bundt pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a stand mixer fitted with a paddle attachment, beat sugar, butter, and salt on medium speed until lightened, about 2 minutes. Add eggs, one at a time until incorporated. Add bananas, sour cream, and vanilla.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In medium bowl, whisk flour, baking powder, cinnamon, and baking soda. Reduce mixer speed to low and add flour mixture until just incorporated. Fold in nuts and coconut.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spoon batter into pan and bake until just firm and a toothpick inserted into the center comes out clean, 45 to 50 minutes. Let cake cool in pan for 30 minutes, then invert onto wire rack to cool completely before glazing.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "In small bowl, stir confectioners' sugar with rum. Drizzle over cake. Let set, about 15 minutes.",
      "secondary_message": null
    }
  ],
