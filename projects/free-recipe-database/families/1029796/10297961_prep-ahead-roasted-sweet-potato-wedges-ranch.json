  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 small and 4 mini food storage containers. (For kid-sized portions, divide sweet potato wedges and dressing into 6 portions instead of 4.)",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, and trim sweet potatoes. Cut each sweet potato in half crosswise, then each half lengthwise into 6-8 wedges, depending on size. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping every 10 minutes, until potatoes are golden brown and fork-tender, 25-30 minutes. Remove from oven and allow to cool completely, about 10 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "When the sweet potatoes are cool, divide between small containers. Divide dressing between mini containers.",
      "secondary_message": "¾ cup ranch dressing"
    },
    {
      "primary_message": "Cover containers and refrigerate. When ready to eat, heat sweet potatoes (if desired) in the oven, air-fryer, or microwave. Dip in dressing and enjoy!",
      "secondary_message": null
    }
  ],
