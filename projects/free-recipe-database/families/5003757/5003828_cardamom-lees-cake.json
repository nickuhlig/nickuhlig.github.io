  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Keep the heavy cream cold until you use it. Finely grind the cardamom seeds.",
      "secondary_message": "2 cups heavy cream\n¼ to ½ tsp cardamom seeds, to taste"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, combine cream, cocoa powder, sugar, cardamom seeds, and salt. With an electric mixer or whisk, whip until cream forms stiff peaks.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a pie plate or wide, shallow dish, combine milk and wine. Briefly dip biscuits in milk-wine mixture, about 5 seconds, then arrange in a single layer in a 9 by 13 cake pan (about 18 cookies per layer). Using an offset spatula, spread 1/4 of whipped cream in a thin, even layer across biscuits, taking care not to tear layer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Repeat with three more layers of biscuits and whipped cream, cover with plastic wrap, and refrigerate for four hours (or up to overnight). Serve chilled.",
      "secondary_message": null
    }
  ],
