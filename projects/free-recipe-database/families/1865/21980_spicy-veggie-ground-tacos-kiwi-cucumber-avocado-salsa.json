  "instructions": [
    {
      "id": 369072,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 kiwifruit\n1 avocado\n1 English cucumber\n1 lime\n1 jalapeño pepper"
    },
    {
      "id": 369073,
      "primary_message": "Trim, peel, and small dice kiwis. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 369074,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl with the kiwi.",
      "secondary_message": null
    },
    {
      "id": 369075,
      "primary_message": "Trim and small dice cucumber; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369076,
      "primary_message": "Juice lime into the bowl, then season with salt and crushed red pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 369077,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 369078,
      "primary_message": "While the skillet heats up, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 369079,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add jalapeño, veggie ground, and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n4 tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 369080,
      "primary_message": "Meanwhile, warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 369081,
      "primary_message": "To serve, divide tortillas between plates and fill with spicy veggie ground. Top with salsa and enjoy!",
      "secondary_message": null
    }
  ],
