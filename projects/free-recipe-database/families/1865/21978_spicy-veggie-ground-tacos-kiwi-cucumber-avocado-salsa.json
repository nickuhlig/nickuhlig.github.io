  "instructions": [
    {
      "id": 368992,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 kiwifruit\n1 ½ avocados\n1 ½ English cucumbers\n1 ½ limes\n1 ½ jalapeño peppers"
    },
    {
      "id": 368993,
      "primary_message": "Trim, peel, and small dice kiwis. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 368994,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl with the kiwi.",
      "secondary_message": null
    },
    {
      "id": 368995,
      "primary_message": "Trim and small dice cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 368996,
      "primary_message": "Juice limes into the bowl, then season with salt and crushed red pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 368997,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368998,
      "primary_message": "While the skillet heats up, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 368999,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add jalapeño, veggie ground, and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n2 tbsp chili powder\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 369000,
      "primary_message": "Meanwhile, warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 369001,
      "primary_message": "To serve, divide tortillas between plates and fill with spicy veggie ground. Top with salsa and enjoy!",
      "secondary_message": null
    }
  ],
