  "instructions": [
    {
      "id": 369022,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 kiwifruit\n1 ½ avocados\n1 ½ English cucumbers\n1 ½ limes\n1 ½ jalapeño peppers"
    },
    {
      "id": 369023,
      "primary_message": "Trim, peel, and small dice kiwis; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 369024,
      "primary_message": "Halve, pit, and scoop out the avocado flesh with a spoon; small dice and add to the bowl with the kiwi.",
      "secondary_message": null
    },
    {
      "id": 369025,
      "primary_message": "Trim and small dice cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369026,
      "primary_message": "Juice limes into the bowl, then season with salt and crushed red pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 369027,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 369028,
      "primary_message": "While the skillet heats up, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 369029,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add jalapeño, pork, and spices; cook, breaking apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1.02 kg lean ground pork\n2 tbsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 369030,
      "primary_message": "Meanwhile, warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 369031,
      "primary_message": "To serve, divide tortillas between plates and fill with spicy pork. Top with salsa and enjoy!",
      "secondary_message": null
    }
  ],
