  "instructions": [
    {
      "id": 80603,
      "primary_message": "Preheat oven to 230°C (450°F) and place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 80604,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potato\n1 ½ small bunches cilantro\n1 ½ small bunches green onions (scallions)"
    },
    {
      "id": 80605,
      "primary_message": "Cut sweet potatoes in half lengthwise. Rub the inside and outside of the potato with oil and season with salt. Place cut side down on a large baking sheet pan and pierce skin all over with a fork. Bake for 25 minutes until sweet potatoes are fork tender.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp salt"
    },
    {
      "id": 80606,
      "primary_message": "Meanwhile, preheat a large pot over medium heat. When heated, add butter to the pan.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 80607,
      "primary_message": "Peel and small dice the onion. Peel and mince or press the garlic. Add to onions and garlic to the pan; cook, stirring frequently, until translucent, about 5 minutes.",
      "secondary_message": "3 medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 80608,
      "primary_message": "Drain and rinse beans in a colander. Add to pot with the onion and garlic.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 80609,
      "primary_message": "Drain diced tomatoes using the colander and discard juice. Add tomatoes to pot.",
      "secondary_message": "3 (398 ml) cans diced tomatoes"
    },
    {
      "id": 80610,
      "primary_message": "Season the bean mixture with chili powder, cumin, salt, and cayenne pepper. Stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp cumin\n¾ tsp chili powder\n⅜ tsp cayenne pepper"
    },
    {
      "id": 80611,
      "primary_message": "Turn heat up to medium-high and cook, stirring occasionally, until the beans are warmed through and tender, 5 minutes. Mash some of the beans with a potato masher.",
      "secondary_message": null
    },
    {
      "id": 80612,
      "primary_message": "Remove the sweet potatoes from the oven when fork-tender. Let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 80613,
      "primary_message": "Scrape out the flesh of the sweet potatoes, leaving the skins intact and a thin layer of potato inside, set skins aside.",
      "secondary_message": null
    },
    {
      "id": 80614,
      "primary_message": "Add the sweet potato flesh to a bowl with the bean mixture, stir to combine.",
      "secondary_message": null
    },
    {
      "id": 80615,
      "primary_message": "Grate cheddar cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 80616,
      "primary_message": "Halve and pit the avocados; slice avocados crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": "3 avocados"
    },
    {
      "id": 80617,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 80618,
      "primary_message": "Trim and discard root ends of green onions, and chop.",
      "secondary_message": null
    },
    {
      "id": 80619,
      "primary_message": "To serve, return the bean mixture to the sweet potato skins. Top with cheese, avocado, cilantro and green onion. Squeeze lime over top. Enjoy!",
      "secondary_message": "1 ½ limes"
    }
  ],
