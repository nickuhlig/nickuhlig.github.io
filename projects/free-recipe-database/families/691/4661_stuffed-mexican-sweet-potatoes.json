  "instructions": [
    {
      "id": 80518,
      "primary_message": "Preheat oven to 450°F and place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 80519,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb sweet potato\n½ small bunch cilantro\n½ small bunch green onions (scallions)"
    },
    {
      "id": 80520,
      "primary_message": "Cut sweet potato in half lengthwise. Rub the inside and outside of the potato with oil and season with salt. Place cut side down on a baking sheet pan and pierce skin all over with a fork. Bake for 25 minutes until sweet potatoes are fork tender.",
      "secondary_message": "1 tsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 80521,
      "primary_message": "Meanwhile, preheat a medium saucepan over medium heat. When heated, add butter to the pan.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 80522,
      "primary_message": "Peel and small dice the onion. Peel and mince or press the garlic. Add to onions and garlic to the pan; cook, stirring frequently, until translucent, about 5 minutes.",
      "secondary_message": "1 medium yellow onion\n1 clove garlic"
    },
    {
      "id": 80523,
      "primary_message": "Drain and rinse beans in a colander. Add to pan with the onion and garlic.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 80524,
      "primary_message": "Drain diced tomatoes using the colander and discard juice. Add tomatoes to pan.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 80525,
      "primary_message": "Season the bean mixture with chili powder, cumin, salt, and cayenne pepper. Stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "½ tsp salt\n¼ tsp cumin\n¼ tsp chili powder\n⅛ tsp cayenne pepper"
    },
    {
      "id": 80526,
      "primary_message": "Turn heat up to medium-high and cook, stirring occasionally, until the beans are warmed through and tender, 5 minutes. Mash some of the beans with a potato masher.",
      "secondary_message": null
    },
    {
      "id": 80527,
      "primary_message": "Remove the sweet potatoes from the oven when fork-tender. Let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 80528,
      "primary_message": "Scrape out the flesh of the sweet potatoes, leaving the skins intact and a thin layer of potato inside, set skins aside.",
      "secondary_message": null
    },
    {
      "id": 80529,
      "primary_message": "Add the sweet potato flesh to a bowl with the bean mixture, stir to combine.",
      "secondary_message": null
    },
    {
      "id": 80530,
      "primary_message": "Grate cheddar cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 80531,
      "primary_message": "Halve and pit the avocado; slice avocado crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 80532,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 80533,
      "primary_message": "Trim and discard root ends of green onions, and chop.",
      "secondary_message": null
    },
    {
      "id": 80534,
      "primary_message": "To serve, return the bean mixture to the sweet potato skins. Top with cheese, avocado, cilantro and green onion. Squeeze lime over top. Enjoy!",
      "secondary_message": "½ lime"
    }
  ],
