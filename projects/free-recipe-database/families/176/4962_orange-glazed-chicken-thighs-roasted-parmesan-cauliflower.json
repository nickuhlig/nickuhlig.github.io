  "instructions": [
    {
      "id": 60261,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": ""
    },
    {
      "id": 60251,
      "primary_message": "Wash, dry, and separate cauliflower into bite-sized florets. Transfer to a sheet pan.",
      "secondary_message": "3 medium heads cauliflower"
    },
    {
      "id": 60260,
      "primary_message": "Peel and mince garlic. Add ½ of the garlic (save the rest for the sauce), lemon juice, oil, salt, and pepper to cauliflower; toss to coat.",
      "secondary_message": "9 cloves garlic\n1 ½ lemon\n3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60259,
      "primary_message": "Place the cauliflower in the oven and roast until it is tender and browned on the bottom, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 60258,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 60252,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until browned, 2-3 minutes per side.",
      "secondary_message": "about 3 tbsp virgin coconut oil\n1.362 kg chicken thighs, boneless skinless"
    },
    {
      "id": 60257,
      "primary_message": "Wash and halve oranges. Juice 1 ½ oranges into a small bowl and slice the remaining oranges into wedges. Add honey, vinegar, and remaining garlic to bowl and mix.",
      "secondary_message": "3 oranges\n3 tbsp honey\n3 tbsp balsamic vinegar"
    },
    {
      "id": 60256,
      "primary_message": "Pour sauce over top chicken and add orange wedges. Cook until sauce thickens, 4-5 minutes. Flip chicken a few times to evenly coat in sauce.",
      "secondary_message": ""
    },
    {
      "id": 60255,
      "primary_message": "Grate 1/3 cup Parmesan.",
      "secondary_message": "42 g Parmesan cheese"
    },
    {
      "id": 60254,
      "primary_message": "Remove cauliflower from oven, sprinkle with Parmesan, and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 60253,
      "primary_message": "To serve, place chicken, orange slices, and cauliflower on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
