  "instructions": [
    {
      "id": 11855,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 11856,
      "primary_message": "Wash, dry, and separate cauliflower into bite-sized florets. Transfer to a sheet pan.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 11857,
      "primary_message": "Peel and mince garlic. Add ½ of the garlic (save the rest for the sauce), lemon juice, oil, salt, and pepper to cauliflower; toss to coat.",
      "secondary_message": "3 cloves garlic\r\n½ lemon\r\n1 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 11858,
      "primary_message": "Place the cauliflower in the oven and roast until it is tender and browned on the bottom, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11859,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 11860,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until browned, 2-3 minutes per side.",
      "secondary_message": "about 1 tbsp virgin coconut oil\r\n1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 11861,
      "primary_message": "Wash and halve orange. Juice ½ into a small bowl and slice the other ½ into wedges. Add honey, vinegar, and remaining garlic to bowl and mix.",
      "secondary_message": "1 orange\r\n1 tbsp honey\r\n1 tbsp balsamic vinegar"
    },
    {
      "id": 11862,
      "primary_message": "Pour sauce over top chicken and add orange wedges. Cook until sauce thickens, 4-5 minutes. Flip chicken a few times to evenly coat in sauce.",
      "secondary_message": ""
    },
    {
      "id": 11863,
      "primary_message": "Grate ⅛ cup Parmesan.",
      "secondary_message": "½ oz Parmesan cheese"
    },
    {
      "id": 11864,
      "primary_message": "Remove cauliflower from oven, sprinkle with Parmesan, and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 11865,
      "primary_message": "To serve, place chicken, orange slices, and cauliflower on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
