  "instructions": [
    {
      "id": 330914,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 (170 g) pkg blueberries\n4 caps portobello mushrooms\n1 small pkg grape tomatoes\n1 avocado\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 330915,
      "primary_message": "Juice one lemon into a blender. (Reserve remaining lemon for the dressing.)",
      "secondary_message": null
    },
    {
      "id": 330916,
      "primary_message": "Peel garlic; add to the blender along with blueberries, ketchup, sugar, soy sauce, and spices. Blend on high until very smooth, about 1 minute. Set BBQ sauce aside.",
      "secondary_message": "2 cloves garlic\n¼ cup ketchup\n2 tsp brown sugar\n1 tsp soy sauce\n½ tsp cumin, ground\n¼ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 330917,
      "primary_message": "Remove stems from the mushrooms and carefully scrape out the gills; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 330918,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 330919,
      "primary_message": "While the grill pan heats up, peel and slice onion crosswise into ¼-inch thick rings; add to the plate with the mushrooms. Drizzle veggies with oil and season with salt and pepper on both sides.",
      "secondary_message": "1 medium yellow onion\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 330920,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add the veggies and grill, undisturbed, until tender and lightly charred on one side, 3-4 minutes. (Reserve plate for later use.)",
      "secondary_message": null
    },
    {
      "id": 330921,
      "primary_message": "While the veggies are grilling, thinly slice cheese. ",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 330922,
      "primary_message": "When the veggies are charred on one side, flip, then top each mushroom with cheese; continue to grill until veggies are tender and cheese is melted, 3-4 minutes more. Return to the plate and loosely cover with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 330923,
      "primary_message": "Meanwhile, juice the remaining lemon into a medium bowl; add oil, Dijon, and spices. Whisk to combine the dressing and set aside. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp parsley flakes\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 330924,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 330925,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl along with mixed greens and almonds; toss to combine the salad. Set aside. ",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 330926,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 330927,
      "primary_message": "Spread half of the BBQ sauce over the bottom half of each bun; layer with mushrooms, onions, and remaining sauce. Close with the top half of each bun.",
      "secondary_message": null
    },
    {
      "id": 330928,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
