  "instructions": [
    {
      "id": 330839,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 (6 oz) pkgs blueberries\n6 caps portobello mushrooms\n1 ½ pints grape tomatoes\n1 ½ avocados\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 330840,
      "primary_message": "Juice half of the lemons into a blender. (Reserve remaining lemons for the dressing.)",
      "secondary_message": null
    },
    {
      "id": 330841,
      "primary_message": "Peel garlic; add to the blender along with blueberries, ketchup, sugar, soy sauce, and spices. Blend on high until very smooth, 1-2 minutes. Set BBQ sauce aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup ketchup\n1 tbsp brown sugar\n1 ½ tsp soy sauce\n¾ tsp cumin, ground\n½ tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 330842,
      "primary_message": "Remove stems from the mushrooms and carefully scrape out the gills; place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 330843,
      "primary_message": "Peel and slice onions crosswise into ¼-inch thick rings; add to the plate with the mushrooms. Drizzle veggies with oil and season with salt and pepper on both sides.",
      "secondary_message": "1 ½ medium yellow onions\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 330844,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 330845,
      "primary_message": "Once the grill pan is hot, working in batches, add the veggies and grill, undisturbed, until tender and lightly charred on one side, 3-4 minutes. (Reserve plate for later use.)",
      "secondary_message": null
    },
    {
      "id": 330846,
      "primary_message": "While the veggies are grilling, thinly slice cheese. ",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 330847,
      "primary_message": "When the veggies are charred on one side, flip, then top each mushroom with cheese; continue to grill until veggies are tender and cheese is melted, 3-4 minutes more. Return to the plate and loosely cover with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 330848,
      "primary_message": "Meanwhile, juice the remaining lemons into a large bowl; add oil, Dijon, and spices. Whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp parsley flakes\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 330849,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 330850,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl along with mixed greens and almonds; toss to combine the salad. Set aside. ",
      "secondary_message": "¾ cup almonds, sliced"
    },
    {
      "id": 330851,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 330852,
      "primary_message": "Spread half of the BBQ sauce over the bottom half of each bun; layer with mushrooms, onions, and remaining sauce. Close with the top half of each bun.",
      "secondary_message": null
    },
    {
      "id": 330853,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
