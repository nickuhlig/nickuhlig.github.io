  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, coat with nonstick cooking spray and add burger patties. Cook until warmed through and golden, about 4 minutes per side. Remove from heat.",
      "secondary_message": "1 spritz nonstick cooking spray\n4 veggie burger patties, plant-based"
    },
    {
      "primary_message": "Meanwhile, place tzatziki and feta in a small bowl. Stir to combine. ",
      "secondary_message": "¼ cup tzatziki sauce\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "primary_message": "Toast buns if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "To assemble the burgers, spread the bottom half of each bun with tzatziki-feta sauce, then top with veggie burger patties and roasted peppers. Close with the top half of each bun.",
      "secondary_message": "½ (340 g) jar roasted red bell peppers"
    },
    {
      "primary_message": "To serve, divide burgers between plates. Enjoy!",
      "secondary_message": null
    }
  ],
