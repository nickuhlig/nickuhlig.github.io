  "instructions": [
    {
      "id": 627716,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 627717,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 fennel bulbs\n3 pints grape tomatoes\n1 small bunch fresh dill\n1 ½ lemons"
    },
    {
      "id": 627718,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 627719,
      "primary_message": "Halve grape tomatoes. Add to the baking sheets with the fennel, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 627720,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until fennel is fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 627721,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 627722,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "12 lamb loin chops\n1 ½ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 627723,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and sear, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 627724,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 627725,
      "primary_message": "Zest and juice lemons into the bowl with the dill. Add tahini, water, oil, maple syrup, Dijon, and spices, then whisk to combine the sauce.",
      "secondary_message": "⅓ cup tahini\n3 tbsp water\n1 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 ½ tsp Dijon mustard\n¾ tsp garlic powder\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 627726,
      "primary_message": "To serve, divide roasted veggies and lamb between plates. Drizzle with lemon-tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
