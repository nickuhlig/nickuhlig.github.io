  "instructions": [
    {
      "id": 627738,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 627739,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 fennel bulbs\n2 small pkgs grape tomatoes\n1 small bunch fresh dill\n1 lemon"
    },
    {
      "id": 627740,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 627741,
      "primary_message": "Halve grape tomatoes. Add to the baking sheet with the fennel, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 627742,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until fennel is fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 627743,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 627744,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "8 lamb loin chops\n1 tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 627745,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and sear, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 627746,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 627747,
      "primary_message": "Zest and juice lemon into the bowl with the dill. Add tahini, water, oil, maple syrup, Dijon, and spices, then whisk to combine the sauce.",
      "secondary_message": "¼ cup tahini\n2 tbsp water\n2 tsp extra virgin olive oil\n2 tsp pure maple syrup\n1 tsp Dijon mustard\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 627748,
      "primary_message": "To serve, divide roasted veggies and lamb between plates. Drizzle with lemon-tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
