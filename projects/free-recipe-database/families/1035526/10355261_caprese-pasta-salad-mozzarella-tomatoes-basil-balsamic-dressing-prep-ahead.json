  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. \n\n",
      "secondary_message": "1 tsp salt\n283 g farfalle pasta"
    },
    {
      "primary_message": "Meanwhile, place oil, vinegar, salt, and pepper in a medium bowl, then whisk to combine the dressing.\n\n",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp balsamic vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Wash, dry, and halve grape tomatoes. Add to the bowl with the dressing.\n\n",
      "secondary_message": "2 pint grape tomatoes"
    },
    {
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl, along with mozzarella, and stir to combine the salad. Divide between the containers.\n\n",
      "secondary_message": "2 (227 g) pkg fresh mozzarella balls (ciliegine or \"cherry size\")"
    },
    {
      "primary_message": "Wash and dry basil. Pick leaves off the stems and add to the containers (keeping the leaves in a small pile).\n\n",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "primary_message": "Cover containers and refrigerate. When ready to eat, tear basil into bite-sized pieces, stir into the pasta salad, and enjoy!",
      "secondary_message": null
    }
  ],
