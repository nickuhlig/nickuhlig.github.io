  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 small pkg fresh tarragon\n1 lemon"
    },
    {
      "primary_message": "Peel, trim, and slice carrots on an angle into ¼-inch thick pieces. Transfer to a large skillet.",
      "secondary_message": null
    },
    {
      "primary_message": "Add broth, honey, salt, and pepper to the skillet with the carrots. Cover and bring to a boil over high heat.",
      "secondary_message": "4 fl oz chicken or vegetable broth\n1 ½ tbsp honey\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until carrots start to soften, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, pick tarragon leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "When the carrots have softened, uncover and increase the heat to medium-high. Continue to cook, stirring often, until the glaze has reduced by half, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Add more honey and butter to the skillet. Continue to cook until carrots are fork-tender and glaze has thickened, 3-4 minutes more.",
      "secondary_message": "2 tbsp honey\n1 ½ tbsp butter, unsalted"
    },
    {
      "primary_message": "When the carrots are done, zest and juice lemon into the skillet, then add tarragon. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer carrots to a serving dish. Enjoy!",
      "secondary_message": null
    }
  ],
