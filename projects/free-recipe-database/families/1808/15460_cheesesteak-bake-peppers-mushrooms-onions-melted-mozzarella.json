  "instructions": [
    {
      "id": 269133,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 269134,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n2 green bell peppers\n1 ½ lb white mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 269135,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips; divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 269136,
      "primary_message": "Slice mushrooms into ¼-inch thick pieces; add to the baking sheets with the peppers.",
      "secondary_message": null
    },
    {
      "id": 269137,
      "primary_message": "Peel and mince garlic; peel, halve, and thinly slice onions into half-moons. Add both to the baking sheets, toss to combine the veggies, then spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 269138,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies; season with salt and pepper.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 269139,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tender, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 269140,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 269141,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 269142,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest for 5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 269143,
      "primary_message": "While the steak is cooking, coarsely grate mozzarella.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 269144,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 269145,
      "primary_message": "When the veggies are done, remove from the oven. Turn oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 269146,
      "primary_message": "Thinly slice steak against the grain. Arrange steak slices over the roasted veggies and sprinkle with cheese. Working in batches, return each baking sheet to the oven and broil until cheese is melted, about 1 minute. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 269147,
      "primary_message": "To serve, divide the cheesesteak bake between plates and top with parsley. Enjoy!",
      "secondary_message": null
    }
  ],
