  "instructions": [
    {
      "id": 269103,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 269104,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n½ green bell pepper\n½ lb white mushrooms\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 269105,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 269106,
      "primary_message": "Slice mushrooms into ¼-inch thick pieces; add to the baking sheet with the peppers.",
      "secondary_message": null
    },
    {
      "id": 269107,
      "primary_message": "Peel and mince garlic; peel, halve, and thinly slice onion into half-moons. Add both to the baking sheet, toss to combine the veggies, then spread out in an even layer.",
      "secondary_message": "2 cloves garlic\n½ medium yellow onion"
    },
    {
      "id": 269108,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies; season with salt and pepper.",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 269109,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 269110,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 269111,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "¾ lb ribeye steak\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 269112,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest for 5 minutes.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 269113,
      "primary_message": "While the steak is cooking, coarsely grate mozzarella.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 269114,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 269115,
      "primary_message": "When the veggies are done, remove from the oven. Turn oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 269116,
      "primary_message": "Thinly slice steak against the grain. Arrange steak slices over the roasted veggies and sprinkle with cheese. Return baking sheet to the oven and broil until cheese is melted, about 1 minute. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 269117,
      "primary_message": "To serve, divide the cheesesteak bake between plates and top with parsley. Enjoy!",
      "secondary_message": null
    }
  ],
