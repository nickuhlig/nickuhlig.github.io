  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the carrots. Cut the red tomatoes into quarters. Cut the Spanish onion into strips. Cut the habanero peppers in half. Cut the garlic in half. Juice the lime.",
      "secondary_message": "2 large carrots\n2 medium red tomatoes\n¼ Spanish onion\n3 habanero peppers\n3 cloves garlic\n1 lime"
    },
    {
      "id": 1,
      "primary_message": "Heat the oil in a skillet on medium heat. Add the carrots and let them cook for about 5 minutes. Then add to the skillet the tomatoes, onion, habaneros and garlic cloves and cook, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer skillet contents to a blender and add lime juice and vinegar and pulse (you can add a bit of water a tablespoon at a time if it’s too thick).",
      "secondary_message": null
    },
