  "instructions": [
    {
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "primary_message": "Wash and dry the herbs. Shave cilantro leaves off the stems; discard stems and mince the leaves. Chop chives into small pieces. Place both in a small bowl and set aside. (Reserve lemongrass for the next step.)\n\n",
      "secondary_message": "1 (0.5 oz) pkg Asian-inspired fresh herb blend"
    },
    {
      "primary_message": "Remove any dry outer layers from the lemongrass and discard; mince remaining lemongrass and place in another small bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemongrass.",
      "secondary_message": "3 clove garlic"
    },
    {
      "primary_message": "Preheat a large skillet over medium heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel and mince shallots. Add to the bowl with the lemongrass and garlic.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add lemongrass, garlic, shallot, and crushed red pepper; cook, stirring occasionally, until softened and fragrant, 2-3 minutes.\n\n",
      "secondary_message": "2 tbsp neutral vegetable oil\n¼ tsp crushed red pepper"
    },
    {
      "primary_message": "Meanwhile, medium dice tofu.",
      "secondary_message": null
    },
    {
      "primary_message": "When the shallots have softened, add tofu and soy sauce to the skillet. Cook, stirring occasionally, until tofu is warmed through and golden, 6-8 minutes.",
      "secondary_message": "3 tbsp soy sauce"
    },
    {
      "primary_message": "When the tofu is done, add reserved cilantro and chives to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Enjoy tofu as a filling for lettuce wraps or as part of a rice or noodle bowl!",
      "secondary_message": null
    }
  ],
