  "instructions": [
    {
      "id": 510197,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, reduce heat to low and gradually add polenta to the pan in a thin steady stream, whisking continuously, until incorporated. Cover and cook, stirring occasionally, until polenta is soft and creamy, 15-25 minutes.",
      "secondary_message": "1065 ml chicken or vegetable broth\n1 ½ cups polenta (cornmeal)"
    },
    {
      "id": 510198,
      "primary_message": "Meanwhile, medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 510199,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 510200,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 510201,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ small pkgs grape tomatoes\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 510202,
      "primary_message": "Using a clean cutting board, trim and cut green onions crosswise into thin pieces. Place half in a large bowl along with oil, vinegar, Dijon, maple syrup, and spices. Stir to combine the dressing. (Reserve remaining green onions for serving.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 ½ tsp pure maple syrup\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 510203,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 510204,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 510205,
      "primary_message": "When the polenta has about 5 minutes left, return skillet (with drippings) to medium heat. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "6 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 510206,
      "primary_message": "When the polenta is done, add cheese and spices to the pan, then stir to combine. If the polenta is too firm, add hot water, a few tablespoons at a time, until you reach a desired consistency. Remove from heat.",
      "secondary_message": "1 ½ tsp smoked paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 510207,
      "primary_message": "Add spinach to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 510208,
      "primary_message": "Divide polenta between bowls, then top each with bacon, a fried egg, and reserved green onions. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
