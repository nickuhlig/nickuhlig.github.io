  "instructions": [
    {
      "id": 510125,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, reduce heat to low and gradually add polenta to the pan in a thin steady stream, whisking continuously, until incorporated. Cover and cook, stirring occasionally, until polenta is soft and creamy, 15-25 minutes.",
      "secondary_message": "36 fl oz (4 ½ cups) chicken or vegetable broth\n1 ½ cups polenta (cornmeal)"
    },
    {
      "id": 510126,
      "primary_message": "Meanwhile, small dice tempeh.",
      "secondary_message": "3 (8 oz) packages tempeh"
    },
    {
      "id": 510127,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 510128,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh, soy sauce, smoked paprika, and salt; cook, stirring occasionally, until golden, 4-5 minutes. Remove tempeh to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp soy sauce\n¾ tsp smoked paprika\n¾ tsp salt"
    },
    {
      "id": 510129,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 510130,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a large bowl along with oil, vinegar, Dijon, maple syrup, and spices. Stir to combine the dressing. (Reserve remaining green onions for serving.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 ½ tsp pure maple syrup\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 510131,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 510132,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 510133,
      "primary_message": "When the polenta has about 5 minutes left, return skillet to medium heat, add more oil, and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 510134,
      "primary_message": "When the polenta is done, add cheese and spices to the pan, then stir to combine. If the polenta is too firm, add hot water, a few tablespoons at a time, until you reach a desired consistency. Remove from heat.",
      "secondary_message": "1 ½ tsp smoked paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 510135,
      "primary_message": "Add spinach to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 510136,
      "primary_message": "Divide polenta between bowls, then top each with tempeh, a fried egg, and reserved green onions. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
