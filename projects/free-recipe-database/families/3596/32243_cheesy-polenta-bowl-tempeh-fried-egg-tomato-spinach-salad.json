  "instructions": [
    {
      "id": 510113,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, reduce heat to low and gradually add polenta to the pan in a thin steady stream, whisking continuously, until incorporated. Cover and cook, stirring occasionally, until polenta is soft and creamy, 15-25 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 cup polenta (cornmeal)"
    },
    {
      "id": 510114,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 510115,
      "primary_message": "While the skillet heats up, small dice tempeh.",
      "secondary_message": "2 (8 oz) packages tempeh"
    },
    {
      "id": 510116,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh, soy sauce, smoked paprika, and salt; cook, stirring occasionally, until golden, 3-4 minutes. Remove tempeh to a plate. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp soy sauce\n½ tsp smoked paprika\n½ tsp salt"
    },
    {
      "id": 510117,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n1 pint grape tomatoes\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 510118,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl along with oil, vinegar, Dijon, maple syrup, and spices. Stir to combine the dressing. (Reserve remaining green onions for serving.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp apple cider vinegar\n2 tsp Dijon mustard\n1 tsp pure maple syrup\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 510119,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 510120,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 510121,
      "primary_message": "When the polenta has about 5 minutes left, return skillet to medium heat, add more oil, and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 510122,
      "primary_message": "When the polenta is done, add cheese and spices to the pan, then stir to combine. If the polenta is too firm, add hot water, 1 tablespoon at a time, until you reach a desired consistency. Remove from heat.",
      "secondary_message": "1 tsp smoked paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 510123,
      "primary_message": "Add spinach to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 510124,
      "primary_message": "Divide polenta between bowls, then top each with tempeh, a fried egg, and reserved green onions. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
