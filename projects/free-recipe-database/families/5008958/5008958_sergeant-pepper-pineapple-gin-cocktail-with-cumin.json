  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lime.",
      "secondary_message": "1 lime"
    },
    {
      "id": 1,
      "primary_message": "For the Cumin-Pepper Syrup: In a small saucepan, toast cumin seeds over medium heat until fragrant and just beginning to darken. Add water, sugar, and black peppercorns, stirring to dissolve sugar. Simmer for 15 minutes, strain, and let cool before using.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Cocktails: Add pineapple juice, orgeat, lime juice, Cumin-Pepper Syrup, gin, and cayenne to a cocktail shaker and add one large and two standard ice cubes (or fill 2/3 full with standard ice cubes). Shake until well chilled and frothy, about 30 seconds. Strain into two cocktail glasses and serve immediately.",
      "secondary_message": null
    }
