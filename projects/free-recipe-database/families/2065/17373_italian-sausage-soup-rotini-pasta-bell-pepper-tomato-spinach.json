  "instructions": [
    {
      "id": 322883,
      "primary_message": "Peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 322884,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 322885,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 322886,
      "primary_message": "While the pot heats up, use the tip of a knife to slice down the length of each sausage; peel off casings and discard. ",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 322887,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, sausage, and spices; cook, breaking the meat apart with a spoon, until sausage is brown and crumbly, 5-7 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp parsley flakes\n2 tsp oregano, dried\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 322888,
      "primary_message": "Meanwhile, wash and dry bell peppers; using a clean cutting board, trim, seed, and small dice. ",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 322889,
      "primary_message": "When the sausage is done, add bell pepper to the pot and stir to combine. Continue to cook, stirring occasionally, until starting to soften, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 322890,
      "primary_message": "Add broth, tomatoes, water, pasta, and vinegar to the pot; stir to combine. Cover and bring to a boil; once boiling, reduce heat to medium, and simmer until pasta is cooked through, about 8 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes\n2 cup water\n6 oz rotini pasta\n3 tbsp balsamic vinegar"
    },
    {
      "id": 322891,
      "primary_message": "While the soup is simmering, wash and dry the spinach (skip this step if the spinach came pre-washed), then roughly chop.",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 322892,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 322893,
      "primary_message": "Add spinach to the soup in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 322894,
      "primary_message": "To serve, divide the soup between bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
