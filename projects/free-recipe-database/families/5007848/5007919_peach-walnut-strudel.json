  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thaw the 17.3 ounce package frozen puff pastry. Pit and slice the peaches into 1/8-inch slices. Juice the lemon. Chop the toasted walnuts. Melt the butter.",
      "secondary_message": "½ 17.3 ounce package frozen puff pastry\n3 peaches\n½ lemon\n¼ cup toasted walnuts\n2 tbsp butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and line a baking sheet with parchment paper. Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, combine sliced peaches, 1/3 cup sugar, cinnamon, cornstarch, and lemon juice. Stir in walnuts.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Lightly flour a clean work surface and roll puff pastry out to a 16 by 30-cm rectangle. With the short side facing you, cover 1/2 of pastry with peach mixture, leaving a 2.5-cm border at the end closest to you. Roll the pastry up, jelly roll-style, and crimp to seal edges. Transfer strudel to prepared baking sheet and brush top with melted butter. Sprinkle with remaining 1 teaspoon sugar. Cut three slits on top of the pastry to let steam escape.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bake until pastry is golden, about 35 minutes. Transfer baking sheet to a wire rack and let cool for 20 minutes before serving",
      "secondary_message": null
    }
  ],
