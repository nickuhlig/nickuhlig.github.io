  "instructions": [
    {
      "id": 584392,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 584393,
      "primary_message": "In a small saucepan, combine water, quinoa, and salt; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "1 cup water\n½ cup quinoa\n¼ tsp salt"
    },
    {
      "id": 584394,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n½ (8 oz) pkg sugar snap peas\n½ small pkg fresh mint\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 584395,
      "primary_message": "Zest and juice half of the lemon into a medium bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 584396,
      "primary_message": "Mince capers. Add to the bowl with the lemon juice, along with yogurt and spices, then whisk to combine the marinade.",
      "secondary_message": "1 tbsp capers\n¼ cup plain Greek yogurt\n1 tsp dill, dried\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 584397,
      "primary_message": "Pat the chicken dry with paper towels and large dice. Add to the bowl with the marinade, stir to coat, and set aside.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 584398,
      "primary_message": "Using a clean cutting board, peel and mince shallot. Place in another medium bowl along with oil, vinegar, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 tsp Dijon mustard\n½ tsp pure maple syrup\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 584399,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584400,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 584401,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584402,
      "primary_message": "While the pan heats up, thread chicken onto skewers and place on a plate. (Alternatively, you can cook the chicken pieces directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 584403,
      "primary_message": "Once the pan is hot, coat with oil. Add skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 584404,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 584405,
      "primary_message": "Divide quinoa, salad, and skewers between plates or bowls. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
