  "instructions": [
    {
      "id": 584448,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 584449,
      "primary_message": "In a medium saucepan, combine water, quinoa, and salt; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "2 cup water\n1 cup quinoa\n½ tsp salt"
    },
    {
      "id": 584450,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 lemons\n1 (227 g) pkg sugar snap peas\n1 small pkg fresh mint\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 584451,
      "primary_message": "Zest and juice one lemon into a medium bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 584452,
      "primary_message": "Mince capers. Add to the bowl with the lemon juice, along with yogurt and spices, then whisk to combine the marinade.",
      "secondary_message": "2 tbsp capers\n½ cup plain Greek yogurt\n2 tsp dill, dried\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 584453,
      "primary_message": "Pat the chicken dry with paper towels and large dice. Add to the bowl with the marinade, stir to coat, and set aside.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 584454,
      "primary_message": "Using a clean cutting board, peel and mince shallot. Place in another medium bowl along with oil, vinegar, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n2 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 584455,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584456,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 584457,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584458,
      "primary_message": "While the pan heats up, thread chicken onto skewers and place on a plate. (Alternatively, you can cook the chicken pieces directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 584459,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 584460,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 584461,
      "primary_message": "Divide quinoa, salad, and skewers between plates or bowls. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
