  "instructions": [
    {
      "id": 584420,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 584421,
      "primary_message": "In a medium saucepan, combine water, quinoa, and salt; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "3 cup water\n1 ½ cups quinoa\n¾ tsp salt"
    },
    {
      "id": 584422,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 lemons\n1 ½ (8 oz) pkgs sugar snap peas\n1 small pkg fresh mint\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 584423,
      "primary_message": "Zest and juice half of the lemons into a large bowl. Cut remaining lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 584424,
      "primary_message": "Mince capers. Add to the bowl with the lemon juice, along with yogurt and spices, then whisk to combine the marinade.",
      "secondary_message": "3 tbsp capers\n¾ cup plain Greek yogurt\n1 tbsp dill, dried\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 584425,
      "primary_message": "Pat the chicken dry with paper towels and large dice. Add to the bowl with the marinade, stir to coat, and set aside.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 584426,
      "primary_message": "Using a clean cutting board, peel and mince shallots. Place in another large bowl along with oil, vinegar, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 ½ tsp pure maple syrup\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 584427,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584428,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 584429,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584430,
      "primary_message": "While the pan heats up, thread chicken onto skewers and place on a plate. (Alternatively, you can cook the chicken pieces directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 584431,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches, add skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 584432,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 584433,
      "primary_message": "Divide quinoa, salad, and skewers between plates or bowls. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
