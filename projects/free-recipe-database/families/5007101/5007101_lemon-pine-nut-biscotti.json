  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Line a baking sheet with parchment paper. In a medium bowl, combine flour, baking powder, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, vigorously whisk together sugar, eggs, and egg yolk until light and creamy, about 5 minutes. Whisk in vanilla, lemon juice, and zest. Add dry ingredients and stir to combine. Stir in pine nuts.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Flour your hands (dough with be sticky) and form dough into one 4- by 12-inch long log (see note). Bake until just golden and starting to dry, about 25 minutes. Reduce oven temperature to 275°F.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When cool enough to touch, use a serrated to cut cookies on the bias to be 1 1/2-inches wide. Place cookies cut side down on baking sheet and put back in oven until dry and toasted, 15 to 20 minutes more.",
      "secondary_message": null
    }
  ],
