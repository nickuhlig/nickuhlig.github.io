  "instructions": [
    {
      "id": 580036,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pan is boiling, reduce heat to medium-low.",
      "secondary_message": "3 tbsp white wine vinegar"
    },
    {
      "id": 580037,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 580038,
      "primary_message": "While the skillet heats up, wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "3 (142 g) pkgs baby spinach"
    },
    {
      "id": 580039,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat, season with salt and pepper, then stir to combine. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 580040,
      "primary_message": "Transfer cooked spinach to a colander. Using the back of a spoon, squeeze as much water from the spinach as you can; set aside.",
      "secondary_message": null
    },
    {
      "id": 580041,
      "primary_message": "Gently crack eggs into small bowls (two eggs per bowl).",
      "secondary_message": "12 eggs"
    },
    {
      "id": 580042,
      "primary_message": "Adjust the heat of the pot as necessary so that the water is simmering. Working in batches, gently tip bowls into the pot, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2 ½-3 minutes. Using a slotted spoon, transfer eggs to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 580043,
      "primary_message": "Meanwhile, split and toast muffins (if desired), then spread with goat cheese. ",
      "secondary_message": "6 English muffins\n1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 580044,
      "primary_message": "To serve, divide muffins between plates. Top with spinach and poached eggs, then season with salt and pepper. Enjoy!",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    }
  ],
