  "instructions": [
    {
      "id": 506384,
      "primary_message": "Preheat oven to 425°F. Coat one half of a large baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 506385,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 crowns broccoli\n2 small bunches green onions (scallions)\n2 (1 inch) pieces ginger root\n1 head butter (Boston) lettuce"
    },
    {
      "id": 506386,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to the unoiled half of the baking sheet, drizzle with oil and soy sauce, then season with pepper; toss to coat and spread out in an even layer. Set aside.",
      "secondary_message": "2 tbsp neutral vegetable oil\n2 tbsp soy sauce\n½ tsp black pepper"
    },
    {
      "id": 506387,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Divide between a medium bowl and a small saucepan.",
      "secondary_message": null
    },
    {
      "id": 506388,
      "primary_message": "Peel and mince ginger and garlic. Divide both between the bowl and saucepan with the green onions. (Set pan aside for later use.)",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 506389,
      "primary_message": "Add beef, bread crumbs, eggs, and spices to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "1 ½ lb lean ground beef\n½ cup panko bread crumbs\n2 eggs\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 506390,
      "primary_message": "Using a tablespoon measure, form the beef mixture into rounded meatballs. Arrange on the oiled half of the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 506391,
      "primary_message": "Place baking sheet in the oven and bake, tossing broccoli and turning meatballs halfway, until meatballs are cooked through and broccoli is fork-tender and lightly charred, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 506392,
      "primary_message": "When the meatballs are almost done, add cold water, soy sauce, cornstarch, sugar, oil, and vinegar to the pan with the green onions. Set over medium heat and cook, stirring frequently, until the sauce thickens, 2-3 minutes. Remove from heat.",
      "secondary_message": "½ cup water\n¼ cup soy sauce\n4 tsp cornstarch\n4 tsp brown sugar\n2 tsp neutral vegetable oil\n2 tsp rice vinegar"
    },
    {
      "id": 506393,
      "primary_message": "When the meatballs and broccoli are done, remove from oven. Drizzle sauce over meatballs and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 506394,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with meatballs and sprinkle with sesame seeds. Serve with broccoli on the side and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
