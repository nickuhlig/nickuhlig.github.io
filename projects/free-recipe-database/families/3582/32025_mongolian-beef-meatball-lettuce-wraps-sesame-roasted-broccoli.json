  "instructions": [
    {
      "id": 506461,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a large baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 506462,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "3 crowns broccoli\n3 small bunches green onions (scallions)\n3 (2 ½ cm) pieces ginger root\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 506463,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to another large baking sheet, drizzle with oil and soy sauce, then season with pepper; toss to coat and spread out in an even layer. Set aside.",
      "secondary_message": "3 tbsp neutral vegetable oil\n3 tbsp soy sauce\n¾ tsp black pepper"
    },
    {
      "id": 506464,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Divide between a large bowl and a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 506465,
      "primary_message": "Peel and mince ginger and garlic. Divide both between the bowl and saucepan with the green onions. (Set pan aside for later use.)",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 506466,
      "primary_message": "Add beef, bread crumbs, eggs, and spices to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "1.02 kg lean ground beef\n¾ cup panko bread crumbs\n3 eggs\n¾ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 506467,
      "primary_message": "Using a tablespoon measure, form the beef mixture into rounded meatballs. Arrange on the oiled baking sheet.",
      "secondary_message": null
    },
    {
      "id": 506468,
      "primary_message": "Place baking sheets in the oven and bake, tossing broccoli and turning meatballs halfway, until meatballs are cooked through and broccoli is fork-tender and lightly charred, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 506469,
      "primary_message": "When the meatballs are almost done, add cold water, soy sauce, cornstarch, sugar, oil, and vinegar to the pan with the green onions. Set over medium heat and cook, stirring frequently, until the sauce thickens, 2-3 minutes. Remove from heat.",
      "secondary_message": "¾ cup water\n⅓ cup soy sauce\n2 tbsp cornstarch\n2 tbsp brown sugar\n1 tbsp neutral vegetable oil\n1 tbsp rice vinegar"
    },
    {
      "id": 506470,
      "primary_message": "When the meatballs and broccoli are done, remove from oven. Drizzle sauce over meatballs and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 506471,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with meatballs and sprinkle with sesame seeds. Serve with broccoli on the side and enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
