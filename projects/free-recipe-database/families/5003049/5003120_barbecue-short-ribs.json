  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl combine salt, black pepper, white pepper, paprika, and garlic powder to make the rub. Season ribs all over liberally with the rub.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Fire up smoker or grill to 105°C, adding chunks of smoking wood chunks when at temperature. When the wood is ignited and producing smoke, place the ribs in the smoker or grill, meat side up, and smoke until ribs reach 82°C on an instant-read thermometer inserted into the middle of the meat, about 4 to 5 hours. Spray ribs with apple juice about every hour during cooking.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove ribs from smoker, let rest for 10 minutes, then serve.",
      "secondary_message": null
    }
  ],
