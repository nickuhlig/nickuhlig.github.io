  "instructions": [
    {
      "id": 269651,
      "primary_message": "Drain salmon, place in a medium bowl, and flake with a fork.",
      "secondary_message": "4 (213 g) cans wild pink salmon, traditional style"
    },
    {
      "id": 269652,
      "primary_message": "Peel and mince shallots; add to the bowl with the salmon.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 269653,
      "primary_message": "Add eggs, flour, and spices to the bowl; stir until well combined.",
      "secondary_message": "4 eggs\n¼ cup all-purpose flour\n1 tsp salt\n1 tsp cayenne pepper\n¼ tsp black pepper"
    },
    {
      "id": 269654,
      "primary_message": "Using a ¼-cup measure, form the salmon mixture into ½-inch thick patties; place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 269655,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 269656,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fritters and cook until golden brown and crispy, 3-4 minutes per side; transfer to a paper towel-lined plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 269657,
      "primary_message": "While the patties are cooking, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 red bell peppers\n1 English cucumber\n1 small bunch cilantro\n1 avocado"
    },
    {
      "id": 269658,
      "primary_message": "Zest and juice limes into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 269659,
      "primary_message": "Add oil and spices to the bowl with the lime; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp crushed red pepper\n¼ tsp black pepper"
    },
    {
      "id": 269660,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 269661,
      "primary_message": "Trim cucumber, cut crosswise into 3-inch portions, then cut each portion lengthwise into thin sticks. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 269662,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 269663,
      "primary_message": "Halve and pit avocado. Slice thinly while still in skin, then scoop out into the bowl. Gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 269664,
      "primary_message": "To serve, divide salmon cakes and salad between plates; top salmon cakes with yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
