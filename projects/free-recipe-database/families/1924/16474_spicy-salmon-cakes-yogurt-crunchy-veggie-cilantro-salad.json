  "instructions": [
    {
      "id": 269665,
      "primary_message": "Drain salmon, place in a large bowl, and flake with a fork.",
      "secondary_message": "6 (213 g) cans wild pink salmon, traditional style"
    },
    {
      "id": 269666,
      "primary_message": "Peel and mince onion; add to the bowl with the salmon.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 269667,
      "primary_message": "Add eggs, flour, and spices to the bowl; stir until well combined.",
      "secondary_message": "6 eggs\n⅓ cup all-purpose flour\n1 ½ tsp salt\n1 ½ tsp cayenne pepper\n½ tsp black pepper"
    },
    {
      "id": 269668,
      "primary_message": "Using a ¼-cup measure, form the salmon mixture into ½-inch thick patties; place on a platter.",
      "secondary_message": null
    },
    {
      "id": 269669,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 269670,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fritters and cook until golden brown and crispy, 3-4 minutes per side; transfer to a paper towel-lined plate.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 269671,
      "primary_message": "While the patties are cooking, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n3 red bell peppers\n1 ½ English cucumbers\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 269672,
      "primary_message": "Zest and juice limes into another large bowl.",
      "secondary_message": null
    },
    {
      "id": 269673,
      "primary_message": "Add oil and spices to the bowl with the lime; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp crushed red pepper\n½ tsp black pepper"
    },
    {
      "id": 269674,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 269675,
      "primary_message": "Trim cucumbers, cut crosswise into 3-inch portions, then cut each portion lengthwise into thin sticks. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 269676,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 269677,
      "primary_message": "Halve and pit avocados. Slice thinly while still in skin, then scoop out into the bowl. Gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 269678,
      "primary_message": "To serve, divide salmon cakes and salad between plates; top salmon cakes with yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
