  "instructions": [
    {
      "id": 128821,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Pat dry with paper towel and season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 128822,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 128823,
      "primary_message": "When the grill pan or skillet is hot, drizzle with oil and add fillets. Working in batches if necessary, grill until cooked through, about 3-4 minutes per side. When the chicken is done, set aside on a plate and cover with aluminum foil. Wipe out and reserve pan for use later.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 128824,
      "primary_message": "Wash and dry the cucumbers and tomatoes. Cut the tomatoes into wedges and the cucumbers into thin, half moons; set aside.",
      "secondary_message": "1 ½ English cucumbers\n3 tomatoes"
    },
    {
      "id": 128825,
      "primary_message": "Add vinegar to a small saucepan and bring to a boil over medium-high heat. Once boiling, reduce to medium-low and continue to simmer, uncovered, until reduced by half, 7-10 minutes; remove from heat and set aside.",
      "secondary_message": "¾ cup balsamic vinegar"
    },
    {
      "id": 128826,
      "primary_message": "Combine mayonnaise and spices in a small bowl; whisk to combine the ranch dressing.",
      "secondary_message": "½ cup mayonnaise\n1 ½ tsp dill\n½ tsp parsley flakes\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 128827,
      "primary_message": "Grate cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 128828,
      "primary_message": "Wash and dry spinach. (Skip if it came pre-washed.)",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 128829,
      "primary_message": "Thinly slice the cooked chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 128830,
      "primary_message": "Lay the tortillas on a flat surface and divide spinach, chicken, grated cheese, and ranch dressing between them. Roll tightly to close. ",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 128831,
      "primary_message": "Return grill pan or regular skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 128832,
      "primary_message": "Working in batches if necessary, place wraps on the grill and cook, rotating every 1-2 minutes, until tortilla is crispy and golden. Cut each wrap in half.",
      "secondary_message": null
    },
    {
      "id": 128833,
      "primary_message": "To serve, divide wraps and veggies between plates. Drizzle veggies with balsamic reduction and enjoy!",
      "secondary_message": null
    }
  ],
