  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the bittersweet chocolate. Cut the unsalted butter into 1/2-inch pieces. Soften the unsalted butter. Finely chop the bittersweet chocolate.",
      "secondary_message": "170 g bittersweet chocolate\n8 tbsp (4 oz) unsalted butter\n6 tbsp (3 oz) unsalted butter\n170 g bittersweet chocolate"
    },
    {
      "id": 1,
      "primary_message": "For the Brownie Layer: Adjust rack to middle position and preheat oven to 180°C (350°F). Grease 8- by 20-cm baking pan and line with 8- by 36-cm piece of parchment paper, allowing both ends to overhang the edge of the pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In microwave or over pan of barely simmering water, heat chocolate and butter, stirring, until melted and smooth. Whisk in sugar, brown sugar, and salt. Whisk in peanut butter, eggs, yolk, and vanilla until smooth.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Sift flour and cocoa powder into small bowl. Stir into chocolate mixture until completely combined. Pour into prepared pan and smooth the top. Bake until just set and toothpick inserted into center comes out with moist crumbs, 20 to 25 minutes. Transfer to wire rack to cool completely before topping with peanut butter layer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For the Peanut Butter Layer: In standing mixer fitted with paddle attachment (or hand held mixer), beat peanut butter and butter on medium low speed until creamy. Beat in confectioners' sugar, vanilla, and salt until smooth and creamy. Spoon into pan over brownies and smooth the top. Chill while making ganache topping.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "For the Ganache Topping: Place chocolate, sugar, and peanut butter in medium bowl. Heat cream in microwave or on stove until just simmering. Whisk into chocolate mixture until smooth. Pour over peanut butter layer (see note). Chill until firm, 2 to 3 hours.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "To cut, run sharp knife along inside edge of pan. Grab parchment paper, lift brownies out of pan, and place on work surface. Use a large hot, wet knife to cut into squares.",
      "secondary_message": null
    }
  ],
