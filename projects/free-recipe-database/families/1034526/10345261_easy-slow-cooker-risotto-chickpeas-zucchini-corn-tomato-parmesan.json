  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n½ lemon\n1 ½ pint grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "primary_message": "Trim and coarsely grate zucchini. Place in a 4-quart slow cooker insert and set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a skillet over medium heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.\n\n",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, salt, and pepper; cook, stirring occasionally, until softened, 3-4 minutes.\n\n",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, drain and rinse chickpeas. Add to the slow cooker with the zucchini.\n\n\n\n",
      "secondary_message": "2 (254 g) can garbanzo beans (chickpeas)"
    },
    {
      "primary_message": "When the onion is softened, add rice and garlic to the skillet. Continue to cook, stirring often, until rice is translucent, 2-3 minutes more. Add rice mixture to the slow cooker, along with broth, corn, salt, and pepper, then stir to combine. Cover and cook until the rice is tender, about 2 hours on HIGH. \n\n\n\n",
      "secondary_message": "1 cup arborio rice\n1 tbsp minced garlic\n2 cups chicken or vegetable broth\n1 cup frozen corn\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "When the rice is done, juice lemon into the slow cooker.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Halve grape tomatoes. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add both to the slow cooker, along with Parmesan, then stir to combine the risotto. Remove from heat.\n\n",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    },
    {
      "primary_message": "To serve, divide risotto between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
