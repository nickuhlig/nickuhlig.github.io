  "instructions": [
    {
      "id": 453840,
      "primary_message": "Preheat oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 453841,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 acorn squash\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 453842,
      "primary_message": "Halve each acorn squash lengthwise; trim ends, scrape out the seeds, and cut crosswise into ½-inch thick half-moons. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 453843,
      "primary_message": "Small dice bacon and butter. Sprinkle both over the squash, then season with salt and pepper.",
      "secondary_message": "8 slices bacon\n4 tsp butter, unsalted\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 453844,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until bacon is crisp and squash is tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 453845,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot and garlic. Place both in a small bowl and set aside. ",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 453846,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 453847,
      "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg sea scallops\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 453848,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add scallops in a single layer; cook until golden brown and opaque throughout, 1½-2 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 453849,
      "primary_message": "Wipe skillet clean with paper towels, then return to medium-low heat. Add more butter and swirl to coat the bottom. Add shallot, garlic, salt, and pepper; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 453850,
      "primary_message": "Juice lemon into the skillet and stir to combine the sauce. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 453851,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the skillet with the sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 453852,
      "primary_message": "To serve, divide squash, bacon, and scallops between plates; spoon lemon parsley sauce over scallops. Enjoy!",
      "secondary_message": null
    }
  ],
