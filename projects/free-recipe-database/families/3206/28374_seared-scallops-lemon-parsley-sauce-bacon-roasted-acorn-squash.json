  "instructions": [
    {
      "id": 453814,
      "primary_message": "Preheat oven to 450°F. Line two large baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 453815,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "3 acorn squash\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 453816,
      "primary_message": "Halve each acorn squash lengthwise; trim ends, scrape out the seeds, and cut crosswise into ½-inch thick half-moons. Divide between the baking sheets and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 453817,
      "primary_message": "Small dice bacon and butter. Sprinkle both over the squash, then season with salt and pepper.",
      "secondary_message": "12 slices bacon\n2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 453818,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until bacon is crisp and squash is tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 453819,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallots and garlic. Place both in a small bowl and set aside. ",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 453820,
      "primary_message": "Pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb sea scallops\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 453821,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 453822,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add scallops in a single layer; cook until golden brown and opaque throughout, 1½-2 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 453823,
      "primary_message": "Wipe skillet clean with paper towels, then return to medium-low heat. Add more butter and swirl to coat the bottom. Add shallot, garlic, salt, and pepper; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "¼ cup butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 453824,
      "primary_message": "Juice lemons into the skillet and stir to combine the sauce. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 453825,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the skillet with the sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 453826,
      "primary_message": "To serve, divide squash, bacon, and scallops between plates; spoon lemon parsley sauce over scallops. Enjoy!",
      "secondary_message": null
    }
  ],
