  "instructions": [
    {
      "id": 426458,
      "primary_message": "Place corn in a colander and run under hot water (from the tap) to thaw. Place on a clean towel or paper towels and pat dry, then transfer to a large bowl. ",
      "secondary_message": "6 cups frozen corn"
    },
    {
      "id": 426459,
      "primary_message": "Add eggs, cheese, flour, and spices to the bowl with the corn. Stir to combine the batter. ",
      "secondary_message": "6 eggs\n1 cup Parmesan cheese, shredded\n1 cup all-purpose flour\n1 ½ tsp chili powder\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426460,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 426461,
      "primary_message": "Working in batches, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a large paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 426462,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed). Place in a clean large bowl. ",
      "secondary_message": "1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 426463,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl with the spinach.",
      "secondary_message": "1 ½ avocados"
    },
    {
      "id": 426464,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl along with vinaigrette, salt, and pepper. Toss to combine the salad. ",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers\n⅓ cup French vinaigrette\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 426465,
      "primary_message": "To serve, divide fritters and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
