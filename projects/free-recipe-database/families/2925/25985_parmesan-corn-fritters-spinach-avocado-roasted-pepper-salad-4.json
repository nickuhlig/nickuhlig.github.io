  "instructions": [
    {
      "primary_message": "Place corn in a colander and run under hot water (from the tap) to thaw. Place on a clean towel or paper towels and pat dry, then transfer to a medium bowl. ",
      "secondary_message": "4 cups frozen corn"
    },
    {
      "primary_message": "Add eggs, cheese, flour, and spices to the bowl with the corn. Stir to combine the batter. ",
      "secondary_message": "4 eggs\n⅔ cup Parmesan cheese, shredded\n1 tsp chili powder\nsalt\nblack pepper"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed). Place in a clean medium bowl. ",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl with the spinach.",
      "secondary_message": "1 avocado"
    },
    {
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl along with vinaigrette, salt, and pepper. Toss to combine the salad. ",
      "secondary_message": "1 (340 g) jar roasted red bell peppers\n¼ cup French vinaigrette\nsalt\nblack pepper"
    },
    {
      "primary_message": "To serve, divide fritters and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
