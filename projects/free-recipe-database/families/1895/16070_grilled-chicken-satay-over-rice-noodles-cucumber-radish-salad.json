  "instructions": [
    {
      "id": 263633,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 263634,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 263635,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 (1 inch) piece ginger root\n1 English cucumber\n½ bunch radish\n½ small bunch cilantro\n½ small pkg fresh mint"
    },
    {
      "id": 263636,
      "primary_message": "Juice half of the lime into a small bowl (reserve remaining lime for later use).",
      "secondary_message": null
    },
    {
      "id": 263637,
      "primary_message": "Peel and mince ginger; add to the bowl with the lime juice along with peanut butter, fish sauce, water, sugar, and spices. Whisk to combine the satay sauce.",
      "secondary_message": "2 tbsp natural peanut butter\n1 tbsp fish sauce\n1 tbsp water\n2 tsp brown sugar\n¼ tsp turmeric, ground\n⅛ tsp curry powder\n1 pinch crushed red pepper"
    },
    {
      "id": 263638,
      "primary_message": "Once the water in the pan is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "5 oz flat rice (pad thai) noodles"
    },
    {
      "id": 263639,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces; place in a medium bowl. Pour half of the satay sauce over the chicken and stir to coat. (Set remaining sauce aside for serving.)",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 263640,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263641,
      "primary_message": "While the grill pan heats up, thread chicken onto skewers and place on a plate; alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 263642,
      "primary_message": "Once the grill pan is hot, coat with oil. Add the skewers and cook, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 263643,
      "primary_message": "Meanwhile, juice remaining lime into another medium bowl. Add oil, fish sauce, sugar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tsp toasted sesame oil\n1 tsp fish sauce\n1 tsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 263644,
      "primary_message": "Peel, trim, and slice cucumber crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 263645,
      "primary_message": "Trim and slice radishes into thin rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 263646,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl with the veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 263647,
      "primary_message": "To serve, divide rice noodles, salad, and chicken skewers between plates or bowls; drizzle reserved satay sauce over the chicken. Enjoy!",
      "secondary_message": null
    }
  ],
