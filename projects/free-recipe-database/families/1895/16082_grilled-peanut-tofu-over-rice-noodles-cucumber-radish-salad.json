  "instructions": [
    {
      "id": 263807,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 263808,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 263809,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 (2 ½ cm) piece ginger root\n1 English cucumber\n½ bunch radish\n½ small bunch cilantro\n½ small pkg fresh mint"
    },
    {
      "id": 263810,
      "primary_message": "Juice half of the lime into a small bowl (reserve remaining lime for later use).",
      "secondary_message": null
    },
    {
      "id": 263811,
      "primary_message": "Peel and mince ginger; add to the bowl with the lime juice along with peanut butter, soy sauce, water, sugar, and spices. Whisk to combine the peanut sauce.",
      "secondary_message": "2 tbsp natural peanut butter\n1 tbsp soy sauce\n1 tbsp water\n2 tsp brown sugar\n¼ tsp turmeric, ground\n⅛ tsp curry powder\n1 pinch crushed red pepper"
    },
    {
      "id": 263812,
      "primary_message": "Once the water in the pan is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "142 g flat rice (pad thai) noodles"
    },
    {
      "id": 263813,
      "primary_message": "Cut the tofu planks in half, then cut each half into 2 triangles; return to the baking sheet. Pour half of the peanut sauce over the tofu and turn to coat. (Set remaining sauce aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 263814,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263815,
      "primary_message": "Once the grill pan is hot, coat with oil. Add the tofu and cook, turning once, until golden brown and warmed through, 4-5 minutes. Remove to a plate.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 263816,
      "primary_message": "Meanwhile, juice remaining lime into another medium bowl. Add oil, soy sauce, sugar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp toasted sesame oil\n1 tsp soy sauce\n1 tsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 263817,
      "primary_message": "Peel, trim, and slice cucumber crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 263818,
      "primary_message": "Trim and slice radishes into thin rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 263819,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl with the veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 263820,
      "primary_message": "To serve, divide rice noodles, salad, and tofu between plates or bowls; drizzle reserved peanut sauce over the tofu. Enjoy!",
      "secondary_message": null
    }
  ],
