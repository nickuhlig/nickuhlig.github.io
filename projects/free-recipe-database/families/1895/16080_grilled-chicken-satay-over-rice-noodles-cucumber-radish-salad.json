  "instructions": [
    {
      "id": 263777,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 263778,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 263779,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 (2 ½ cm) pieces ginger root\n2 English cucumbers\n1 bunch radish\n1 small bunch cilantro\n1 small pkg fresh mint"
    },
    {
      "id": 263780,
      "primary_message": "Juice one lime into a small bowl (reserve remaining lime for later use).",
      "secondary_message": null
    },
    {
      "id": 263781,
      "primary_message": "Peel and mince ginger; add to the bowl with the lime juice along with peanut butter, fish sauce, water, sugar, and spices. Whisk to combine the satay sauce.",
      "secondary_message": "¼ cup natural peanut butter\n2 tbsp fish sauce\n2 tbsp water\n4 tsp brown sugar\n½ tsp turmeric, ground\n¼ tsp curry powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 263782,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces; place in a medium bowl. Pour half of the satay sauce over the chicken, stir to coat, and set aside. (Set remaining sauce aside for serving.)",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 263783,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "283 g flat rice (pad thai) noodles"
    },
    {
      "id": 263784,
      "primary_message": "Thread chicken onto skewers and place on a plate; alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 263785,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263786,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add the skewers and cook, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 263787,
      "primary_message": "Meanwhile, juice remaining lime into another medium bowl. Add oil, fish sauce, sugar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "4 tsp toasted sesame oil\n2 tsp fish sauce\n2 tsp brown sugar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 263788,
      "primary_message": "Peel, trim, and slice cucumbers crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 263789,
      "primary_message": "Trim and slice radishes into thin rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 263790,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl with the veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 263791,
      "primary_message": "To serve, divide rice noodles, salad, and chicken skewers between plates or bowls; drizzle reserved satay sauce over the chicken. Enjoy!",
      "secondary_message": null
    }
  ],
