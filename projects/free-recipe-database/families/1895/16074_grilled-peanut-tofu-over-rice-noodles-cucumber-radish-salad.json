  "instructions": [
    {
      "id": 263692,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 263693,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 263694,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 (1 inch) pieces ginger root\n2 English cucumbers\n1 bunch radish\n1 small bunch cilantro\n1 small pkg fresh mint"
    },
    {
      "id": 263695,
      "primary_message": "Juice one lime into a small bowl (reserve remaining lime for later use).",
      "secondary_message": null
    },
    {
      "id": 263696,
      "primary_message": "Peel and mince ginger; add to the bowl with the lime juice along with peanut butter, soy sauce, water, sugar, and spices. Whisk to combine the peanut sauce.",
      "secondary_message": "¼ cup natural peanut butter\n2 tbsp soy sauce\n2 tbsp water\n4 tsp brown sugar\n½ tsp turmeric, ground\n¼ tsp curry powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 263697,
      "primary_message": "Cut the tofu planks in half, then cut each half into 2 triangles; return to the baking sheet. Pour half of the peanut sauce over the tofu, turn to coat, and set aside. (Set remaining sauce aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 263698,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "10 oz flat rice (pad thai) noodles"
    },
    {
      "id": 263699,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263700,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add the tofu and cook, turning once, until golden brown and warmed through, 4-5 minutes. Remove to a plate.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 263701,
      "primary_message": "Meanwhile, juice remaining lime into another medium bowl. Add oil, soy sauce, sugar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tsp soy sauce\n2 tsp brown sugar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 263702,
      "primary_message": "Peel, trim, and slice cucumbers crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 263703,
      "primary_message": "Trim and slice radishes into thin rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 263704,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl with the veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 263705,
      "primary_message": "To serve, divide rice noodles, salad, and tofu between plates or bowls; drizzle reserved peanut sauce over the tofu. Enjoy!",
      "secondary_message": null
    }
  ],
