  "instructions": [
    {
      "id": 442738,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 442739,
      "primary_message": "Wash and dry blueberries. Set aside a few berries per person for serving; place remaining berries in a blender.",
      "secondary_message": "2 (6 oz) pkgs blueberries"
    },
    {
      "id": 442740,
      "primary_message": "Wash, dry, zest, and juice orange into the blender, then add sugar and vanilla. Blend on high speed for several minutes until smooth. Set sauce aside.",
      "secondary_message": "1 orange\n⅓ cup granulated sugar\n1 tsp vanilla extract"
    },
    {
      "id": 442741,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl.",
      "secondary_message": "16 fl oz (2 cups) heavy whipping cream"
    },
    {
      "id": 442742,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 442743,
      "primary_message": "Add blueberry sauce to the bowl with the whipped cream. Gently fold a few times so that there are streaks of sauce running through the fool.",
      "secondary_message": null
    },
    {
      "id": 442744,
      "primary_message": "Divide the fool between small bowls, cups, or jars; garnish each with reserved berries and enjoy!",
      "secondary_message": null
    }
  ],
