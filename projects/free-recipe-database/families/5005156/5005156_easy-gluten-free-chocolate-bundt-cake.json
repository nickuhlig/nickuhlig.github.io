  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cool the strong black coffee. Whisk the eggs. Sift the powdered sugar.",
      "secondary_message": "1 ½ cups strong black coffee\n2 large eggs\n1 ⅓ cups powdered sugar"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Spray a 12-cup Bundt pan with nonstick cooking spray.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large bowl, whisk together granulated sugar, white rice flour, cocoa powder, sweet rice flour, tapioca starch, baking powder, baking soda, salt, and xanthan gum. Add coffee, vegetable oil, eggs, and vanilla extract. Whisk until batter is smooth. Pour batter into prepared pan.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake until a cake tester comes out with a few damp crumbs clinging to it, about 55 minutes (If you tap the top of the cake, it should feel firm.)",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Allow cake to cool in the pan for five minutes and then turn cake out onto a wire rack to cool. (The easiest way to do this is to place a small wire rack upside down on to the cake pan. Carefully invert the cake and the wire rack. Slowly lift the cake pan off the cake. Ice as desired with chocolate glaze or confectionary glaze.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "For Chocolate Glaze: Set cooled cake on a plate. On top of a double boiler, combine heavy cream and chocolate. Heat, stirring frequently, until melted. Allow to cool for two minutes. Pour chocolate glaze evenly over cake. Allow to set for 15 minutes before serving.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For Confectionery Glaze: Set cooled cake on a plate. In a small bowl, combine powdered sugar, water, and vanilla extract. Stir with a fork until smooth. Icing should be thick but pourable; if the icing is too thick, add a little more water. Pour icing evenly over the cake and allow to set for 15 minutes before serving.",
      "secondary_message": null
    }
  ],
