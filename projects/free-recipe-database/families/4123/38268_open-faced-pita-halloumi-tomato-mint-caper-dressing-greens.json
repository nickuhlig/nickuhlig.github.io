  "instructions": [
    {
      "id": 597689,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 597690,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels, then cut crosswise into ½-inch thick slices.",
      "secondary_message": "3 (250 g) pkgs halloumi cheese"
    },
    {
      "id": 597691,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 597692,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh mint\n3 tomatoes\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 597693,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in a small bowl along with dressing, capers, and pepper, then stir to combine. ",
      "secondary_message": "¾ cup Italian salad dressing\n3 tbsp capers\n½ tsp black pepper"
    },
    {
      "id": 597694,
      "primary_message": "Slice tomatoes crosswise into thin rounds. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 597695,
      "primary_message": "Drain and thinly slice roasted peppers. Add to the plate with the tomato and set aside.",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers"
    },
    {
      "id": 597696,
      "primary_message": "Toast pita breads if desired, then cut in half. ",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 597697,
      "primary_message": "To serve, divide pita bread and spinach between plates; top pita with tomato, halloumi, and roasted red peppers. Drizzle pita and spinach with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
