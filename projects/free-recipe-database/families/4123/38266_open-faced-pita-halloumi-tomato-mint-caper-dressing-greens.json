  "instructions": [
    {
      "id": 597671,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 597672,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels, then cut crosswise into ½-inch thick slices.",
      "secondary_message": "1 (250 g) pkg halloumi cheese"
    },
    {
      "id": 597673,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 597674,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small pkg fresh mint\n1 tomato\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 597675,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in a small bowl along with dressing, capers, and pepper, then stir to combine. ",
      "secondary_message": "¼ cup Italian salad dressing\n1 tbsp capers\n⅛ tsp black pepper"
    },
    {
      "id": 597676,
      "primary_message": "Slice tomato crosswise into thin rounds. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 597677,
      "primary_message": "Drain and thinly slice roasted peppers. Add to the plate with the tomato and set aside.",
      "secondary_message": "½ (340 g) jar roasted red bell peppers"
    },
    {
      "id": 597678,
      "primary_message": "Toast pita breads if desired, then cut in half. ",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 597679,
      "primary_message": "To serve, divide pita bread and spinach between plates; top pita with tomato, halloumi, and roasted red peppers. Drizzle pita and spinach with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
