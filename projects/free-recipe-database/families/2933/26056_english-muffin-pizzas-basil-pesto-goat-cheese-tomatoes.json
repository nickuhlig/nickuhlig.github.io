  "instructions": [
    {
      "id": 414909,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 414910,
      "primary_message": "Split muffins and arrange cut-side down on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. ",
      "secondary_message": "2 English muffins"
    },
    {
      "id": 414911,
      "primary_message": "Meanwhile, crumble goat cheese into a small bowl.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 414912,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise.",
      "secondary_message": "½ small pkg grape tomatoes"
    },
    {
      "id": 414913,
      "primary_message": "Spread toasted muffins with pesto, then top with cheese, tomatoes, salt, and pepper.",
      "secondary_message": "3 tbsp basil pesto\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 414914,
      "primary_message": "Return baking sheet to the oven and broil until pizzas are warmed through, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 414915,
      "primary_message": "To serve, divide pizzas between plates and enjoy!",
      "secondary_message": null
    }
  ],
