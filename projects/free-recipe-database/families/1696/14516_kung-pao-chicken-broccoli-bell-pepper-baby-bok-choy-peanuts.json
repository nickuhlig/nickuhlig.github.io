  "instructions": [
    {
      "id": 240540,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 red bell peppers\n6 sticks celery\n9 baby bok choy\n1 ½ jalapeño peppers\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 240541,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 240542,
      "primary_message": "Trim, seed, and medium dice bell peppers. Trim and slice celery into ½-inch thick pieces; add both to the bowl with the broccoli. ",
      "secondary_message": null
    },
    {
      "id": 240543,
      "primary_message": "Trim bok choy ends and cut crosswise into 1-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 240544,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 240545,
      "primary_message": "Medium dice chicken and place in another large bowl. Sprinkle with cornstarch, salt, and pepper; toss to coat.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n3 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 240546,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 240547,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the pot and stir-fry until golden brown and just cooked through, 4-5 minutes. Transfer to a plate. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 240548,
      "primary_message": "Return pot to medium-high heat and add more oil, swirling to coat the bottom. Add veggies and cook, stirring occasionally, until crisp-tender, 5-6 minutes. (Reserve bowl for next step.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 240549,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince or grate ginger; place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 240550,
      "primary_message": "Add cold water, vinegar, soy sauce, chili-garlic sauce, additional cornstarch, and sugar to the bowl with the ginger; whisk to combine the sauce. ",
      "secondary_message": "¾ cup water\n3 tbsp rice vinegar\n3 tbsp soy sauce\n2 tbsp chili-garlic sauce\n1 tbsp cornstarch\n1 tbsp brown sugar"
    },
    {
      "id": 240551,
      "primary_message": "Add cooked chicken and sauce to the pot with the veggies. Bring sauce to a boil and cook, stirring frequently, until it thickens, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 240552,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the pot along with the peanuts and stir to combine.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 240553,
      "primary_message": "To serve, divide stir-fry between bowls and enjoy! ",
      "secondary_message": null
    }
  ],
