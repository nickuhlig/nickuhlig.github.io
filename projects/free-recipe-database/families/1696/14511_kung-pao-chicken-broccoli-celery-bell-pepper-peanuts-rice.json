  "instructions": [
    {
      "id": 240467,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 240468,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 red bell pepper\n1 stick celery\n½ jalapeño pepper\n1 (2 ½ cm) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 240469,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 240470,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 240471,
      "primary_message": "Trim, seed, and medium dice bell pepper. Trim and slice celery into ½-inch thick pieces; add both to the bowl with the broccoli. ",
      "secondary_message": null
    },
    {
      "id": 240472,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 240473,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 240474,
      "primary_message": "While the skillet heats up, medium dice chicken and place in another medium bowl. Sprinkle with cornstarch, salt, and pepper; toss to coat.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n1 tbsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 240475,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet and stir-fry until golden brown and just cooked through, 4-5 minutes. Transfer to a plate. ",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 240476,
      "primary_message": "Return skillet to medium-high heat and add more oil, swirling to coat the bottom. Add veggies and cook, stirring occasionally, until crisp-tender, 4-5 minutes. (Reserve bowl for next step.)",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 240477,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince or grate ginger; place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 240478,
      "primary_message": "Add cold water, vinegar, soy sauce, chili-garlic sauce, additional cornstarch, and sugar to the bowl with the ginger; whisk to combine the sauce. ",
      "secondary_message": "¼ cup water\n1 tbsp rice vinegar\n1 tbsp soy sauce\n2 tsp chili-garlic sauce\n1 tsp cornstarch\n1 tsp brown sugar"
    },
    {
      "id": 240479,
      "primary_message": "Add cooked chicken and sauce to the skillet with the veggies. Bring sauce to a boil and cook, stirring frequently, until it thickens, about 1 minute. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 240480,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the skillet along with the peanuts and stir to combine. ",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 240481,
      "primary_message": "To serve, divide rice and stir-fry between bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
