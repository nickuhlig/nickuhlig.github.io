  "instructions": [
    {
      "id": 210450,
      "primary_message": "Preheat oven to 220°C (425°F). Arrange racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 210451,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Arrange chicken cutlets on a  large baking sheet pan; drizzle with oil and season both sides with spices.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 210452,
      "primary_message": "Place chicken on the bottom rack of the oven (it doesn't have to be fully heated) and bake, flipping once, until cooked through, 15-18 minutes. Remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 210453,
      "primary_message": "Meanwhile, holding a knife parallel to a clean cutting board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into bite-sized pieces, place on a second, large baking sheet pan, and spread out in an even layer.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 210454,
      "primary_message": "Drizzle oil over the pita and sprinkle with Italian seasoning and salt. Gently toss to combine, then spread back out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 210455,
      "primary_message": "Place pita chips on the top rack of the oven and bake, tossing halfway through, until chips are crisp, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 210456,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 210457,
      "primary_message": "Add yogurt, water, vinegar, sugar, Dijon, and spices to the bowl with the garlic; whisk until smooth. Add feta and stir to combine the dressing; set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n2 tbsp water\n4 tsp red wine vinegar\n2 tsp brown sugar\n1 tsp Dijon mustard\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 210458,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 English cucumbers\n1 bunch radish\n2 small pkgs grape tomatoes\n1 small pkg fresh mint\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 210459,
      "primary_message": "Peel, trim, and thinly slice cucumbers. Trim and thinly slice radishes. Transfer both to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 210460,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210461,
      "primary_message": "Pick mint leaves off the stems; shave parsley leaves off the stems. Discard stems and mince the leaves. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210462,
      "primary_message": "Cut chicken into bite-sized pieces. Add to the bowl along with the pita chips and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 210463,
      "primary_message": "To serve, divide salad between plates or bowls. Spoon dressing on top and enjoy!",
      "secondary_message": null
    }
  ],
