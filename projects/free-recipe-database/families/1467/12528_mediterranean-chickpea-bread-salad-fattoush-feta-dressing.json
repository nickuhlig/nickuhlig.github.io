  "instructions": [
    {
      "id": 210506,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 210507,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 210508,
      "primary_message": "Holding a knife parallel to the cutting board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into bite-sized pieces. Divide pita pieces between two baking sheet pans and spread out in an even layer.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 210509,
      "primary_message": "Drizzle oil over the pita and sprinkle with Italian seasoning and salt. Gently toss to combine, then spread back out in an even layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tbsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 210510,
      "primary_message": "Place baking sheets in the oven and bake, tossing halfway through, until pita chips are crisp, about 8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 210511,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 210512,
      "primary_message": "Add yogurt, water, vinegar, sugar, Dijon, and spices to the bowl with the garlic; whisk until smooth. Add feta and stir to combine the dressing; set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp water\n2 tbsp red wine vinegar\n1 tbsp brown sugar\n1 ½ tsp Dijon mustard\n¾ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper\n1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 210513,
      "primary_message": "Transfer chickpeas to a large bowl. Drizzle with oil, season with spices, and stir to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 210514,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n1 ½ bunches radish\n3 small pkgs grape tomatoes\n1 small pkg fresh mint\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 210515,
      "primary_message": "Peel, trim, and thinly slice cucumbers. Trim and thinly slice radishes. Transfer both to the bowl with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 210516,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210517,
      "primary_message": "Pick mint leaves off the stems; shave parsley leaves off the stems. Discard stems and mince the leaves. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210518,
      "primary_message": "Add pita chips to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 210519,
      "primary_message": "To serve, divide salad between plates or bowls. Spoon dressing on top and enjoy!",
      "secondary_message": null
    }
  ],
