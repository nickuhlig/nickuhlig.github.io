  "instructions": [
    {
      "id": 210394,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 210395,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 210396,
      "primary_message": "Holding a knife parallel to the cutting board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into bite-sized pieces, place on a baking sheet pan, and spread out in an even layer.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 210397,
      "primary_message": "Drizzle oil over the pita and sprinkle with Italian seasoning and salt. Gently toss to combine, then spread back out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 210398,
      "primary_message": "Place baking sheet in the oven and bake, tossing halfway through, until pita chips are crisp, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 210399,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 210400,
      "primary_message": "Add yogurt, water, vinegar, sugar, Dijon, and spices to the bowl with the garlic; whisk until smooth. Add feta and stir to combine the dressing; set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp water\n2 tsp red wine vinegar\n1 tsp brown sugar\n½ tsp Dijon mustard\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper\n½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 210401,
      "primary_message": "Transfer chickpeas to a large bowl. Drizzle with oil, season with spices, and stir to combine.",
      "secondary_message": "1 tsp extra virgin olive oil\n½ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 210402,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n½ bunch radish\n1 pint grape tomatoes\n½ small pkg fresh mint\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 210403,
      "primary_message": "Peel, trim, and thinly slice cucumber. Trim and thinly slice radishes. Transfer both to the bowl with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 210404,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210405,
      "primary_message": "Pick mint leaves off the stems; shave parsley leaves off the stems. Discard stems and mince the leaves. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210406,
      "primary_message": "Add pita chips to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 210407,
      "primary_message": "To serve, divide salad between plates or bowls. Spoon dressing on top and enjoy!",
      "secondary_message": null
    }
  ],
