  "instructions": [
    {
      "id": 210380,
      "primary_message": "Preheat oven to 425°F. Arrange racks in the upper, center, and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 210381,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Arrange chicken cutlets on a large baking sheet pan; drizzle with oil and season both sides with spices.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 210382,
      "primary_message": "Place chicken on the bottom rack of the oven (it doesn't have to be fully heated) and bake, flipping once, until cooked through, about 18 minutes. Remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 210383,
      "primary_message": "Meanwhile, holding a knife parallel to a clean cutting board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into bite-sized pieces. Divide pita pieces between two additional baking sheet pans and spread out in an even layer.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 210384,
      "primary_message": "Drizzle oil over the pita and sprinkle with Italian seasoning and salt. Gently toss to combine, then spread back out in an even layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tbsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 210385,
      "primary_message": "Place pita chips on the center and top racks of the oven and bake, tossing halfway through, until chips are crisp, about 8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 210386,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 210387,
      "primary_message": "Add yogurt, water, vinegar, sugar, Dijon, and spices to the bowl with the garlic; whisk until smooth. Add feta and stir to combine the dressing; set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp water\n2 tbsp red wine vinegar\n1 tbsp brown sugar\n1 ½ tsp Dijon mustard\n¾ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 210388,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n1 ½ bunches radish\n3 pints grape tomatoes\n1 small pkg fresh mint\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 210389,
      "primary_message": "Peel, trim, and thinly slice cucumbers. Trim and thinly slice radishes. Transfer both to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 210390,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210391,
      "primary_message": "Pick mint leaves off the stems; shave parsley leaves off the stems. Discard stems and mince the leaves. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210392,
      "primary_message": "Cut chicken into bite-sized pieces. Add to the bowl along with the pita chips and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 210393,
      "primary_message": "To serve, divide salad between plates or bowls. Spoon dressing on top and enjoy!",
      "secondary_message": null
    }
  ],
