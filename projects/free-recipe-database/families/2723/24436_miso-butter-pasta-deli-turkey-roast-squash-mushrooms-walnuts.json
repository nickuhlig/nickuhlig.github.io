  "instructions": [
    {
      "id": 426307,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 426308,
      "primary_message": "Place butternut squash and mushrooms on a baking sheet pan. Season with salt and pepper, then spread out in an even layer.",
      "secondary_message": "2 cup frozen butternut squash, pieces\n1 (227g ) pkg sliced white mushrooms\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 426309,
      "primary_message": "Small dice butter; sprinkle half over the veggies. (Place remaining butter in a small bowl and set aside.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 426310,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring veggies halfway through, until fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 426311,
      "primary_message": "Meanwhile, fill a medium saucepan about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ¼-cup cooking water before draining and set aside.)",
      "secondary_message": "½ tsp salt\n142 g spaghetti pasta"
    },
    {
      "id": 426312,
      "primary_message": "While the pasta is cooking, peel and mince garlic. Add to the bowl with the remaining butter along with miso paste, additional salt, and pepper. Mash with the back of a spoon to combine.",
      "secondary_message": "1 clove garlic\n1 tbsp miso paste, red\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 426313,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the miso butter and set aside.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 426314,
      "primary_message": "Stack turkey slices one on top of another, then medium dice.",
      "secondary_message": "227 g oven roasted turkey breast, sliced"
    },
    {
      "id": 426315,
      "primary_message": "When the pasta is done, drain and return to the pan. Add roasted veggies, walnuts, miso butter, turkey, reserved pasta water, and Parmesan, then stir to combine.",
      "secondary_message": "⅛ cup Parmesan cheese, shredded"
    },
    {
      "id": 426316,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
