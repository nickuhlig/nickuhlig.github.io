  "instructions": [
    {
      "id": 426346,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 426347,
      "primary_message": "Place butternut squash and mushrooms on a large baking sheet pan. Season with salt and pepper, then spread out in an even layer.",
      "secondary_message": "4 cup frozen butternut squash, pieces\n2 (227g ) pkgs sliced white mushrooms\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 426348,
      "primary_message": "Small dice butter; sprinkle half over the veggies. (Place remaining butter in a small bowl and set aside.)",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 426349,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring veggies halfway through, until fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 426350,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ½-cup cooking water before draining and set aside.)",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 426351,
      "primary_message": "While the pasta is cooking, peel and mince garlic. Add to the bowl with the remaining butter along with miso paste, additional salt, and pepper. Mash with the back of a spoon to combine.",
      "secondary_message": "2 cloves garlic\n2 tbsp miso paste, red\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 426352,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the miso butter and set aside.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 426353,
      "primary_message": "When the pasta is done, drain and return to the pot. Add roasted veggies, walnuts, miso butter, reserved pasta water, and Parmesan, then stir to combine.",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    },
    {
      "id": 426354,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
