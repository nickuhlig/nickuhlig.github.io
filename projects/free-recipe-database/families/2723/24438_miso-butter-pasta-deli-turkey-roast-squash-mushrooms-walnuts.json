  "instructions": [
    {
      "id": 426327,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 426328,
      "primary_message": "Divide butternut squash and mushrooms between two large baking sheet pans. Season with salt and pepper, then spread out in an even layer.",
      "secondary_message": "6 cup frozen butternut squash, pieces\n3 (227g ) pkgs sliced white mushrooms\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426329,
      "primary_message": "Small dice butter; sprinkle half over the veggies. (Place remaining butter in a small bowl and set aside.)",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 426330,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring veggies halfway through, until fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 426331,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve ¾-cup cooking water before draining and set aside.)",
      "secondary_message": "1 ½ tsp salt\n425 g spaghetti pasta"
    },
    {
      "id": 426332,
      "primary_message": "While the pasta is cooking, peel and mince garlic. Add to the bowl with the remaining butter along with miso paste, additional salt, and pepper. Mash with the back of a spoon to combine.",
      "secondary_message": "3 cloves garlic\n3 tbsp miso paste, red\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426333,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the miso butter and set aside.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 426334,
      "primary_message": "Stack turkey slices one on top of another, then medium dice.",
      "secondary_message": "680 g oven roasted turkey breast, sliced"
    },
    {
      "id": 426335,
      "primary_message": "When the pasta is done, drain and return to the pot. Add roasted veggies, walnuts, miso butter, turkey, reserved pasta water, and Parmesan, then stir to combine.",
      "secondary_message": "⅓ cup Parmesan cheese, shredded"
    },
    {
      "id": 426336,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
