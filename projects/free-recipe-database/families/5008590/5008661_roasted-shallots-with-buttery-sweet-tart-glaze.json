  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 200°C (400°F). In a 30-cm oven-safe skillet, melt butter over medium-high heat until foaming. Add sugar and stir to dissolve.\nStir in vinegar, add thyme, and simmer until a glaze forms, about 1 minute.\nAdd shallots, season with salt, and stir, turning to coat with glaze.\nTransfer to oven and roast until shallots are browned and tender, about 40 minutes. Serve shallots right away, or refrigerate up to 3 days and reheat before serving.",
      "secondary_message": null
    }
