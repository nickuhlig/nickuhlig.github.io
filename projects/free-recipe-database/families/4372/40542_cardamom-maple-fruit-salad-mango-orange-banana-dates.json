  "instructions": [
    {
      "id": 627087,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 mango\n1 orange\n1 banana"
    },
    {
      "id": 627088,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 627089,
      "primary_message": "Peel orange, separate into segments, and roughly chop the flesh. Add to the bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 627090,
      "primary_message": "Peel and thinly slice banana. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 627091,
      "primary_message": "Roughly chop dates. Add to the bowl, stir to combine the fruit salad, and set aside.",
      "secondary_message": "¼ cup medjool dates, pitted"
    },
    {
      "id": 627092,
      "primary_message": "Place maple syrup and cardamom in a small bowl, then stir to combine.",
      "secondary_message": "1 ½ tbsp pure maple syrup\n⅛ tsp cardamom, ground"
    },
    {
      "id": 627093,
      "primary_message": "To serve, divide fruit salad between bowls, drizzle with cardamom-maple syrup, and enjoy!",
      "secondary_message": null
    }
  ],
