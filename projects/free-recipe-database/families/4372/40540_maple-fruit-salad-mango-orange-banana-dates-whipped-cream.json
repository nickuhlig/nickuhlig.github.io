  "instructions": [
    {
      "id": 627069,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 627070,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 mangoes\n2 oranges\n2 bananas"
    },
    {
      "id": 627071,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; roughly chop the flesh. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 627072,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 627073,
      "primary_message": "Peel and thinly slice bananas. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 627074,
      "primary_message": "Roughly chop dates. Add to the bowl, stir to combine the fruit salad, and set aside.",
      "secondary_message": "½ cup medjool dates, pitted"
    },
    {
      "id": 627075,
      "primary_message": "Place maple syrup and cardamom in a small bowl, then stir to combine. Set aside.",
      "secondary_message": "3 tbsp pure maple syrup\n¼ tsp cardamom, ground"
    },
    {
      "id": 627076,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "237 ml heavy whipping cream"
    },
    {
      "id": 627077,
      "primary_message": "To serve, divide fruit salad between bowls. Drizzle with cardamom-maple syrup and top with whipped cream. Enjoy!",
      "secondary_message": null
    }
  ],
