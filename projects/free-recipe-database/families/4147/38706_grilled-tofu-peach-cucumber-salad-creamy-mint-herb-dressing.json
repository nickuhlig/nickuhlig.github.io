  "instructions": [
    {
      "id": 603352,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 603353,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg fresh mint\n1 ½ English cucumbers\n3 heads romaine lettuce\n6 peaches"
    },
    {
      "id": 603354,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 603355,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 603356,
      "primary_message": "Pick mint leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 603357,
      "primary_message": "Peel garlic. Add to the blender along with yogurt, mayo, oil, capers, salt, and pepper. Blend on high until dressing is smooth, 1-2 minutes. Set aside.",
      "secondary_message": "3 cloves garlic\n1 cup plain Greek yogurt\n⅓ cup mayonnaise\n¼ cup extra virgin olive oil\n4 ½ tbsp capers\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 603358,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 603359,
      "primary_message": "While the pan heats up, cut tofu planks in half crosswise, then cut each half into two triangles. Season with salt and pepper on both sides.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 603360,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add tofu and grill, flipping once, until golden and warmed through, 6-8 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve pan for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 603361,
      "primary_message": "Meanwhile, trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 603362,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the cucumber and set aside.",
      "secondary_message": null
    },
    {
      "id": 603363,
      "primary_message": "Halve peaches lengthwise (around the pit); twist halves to separate, then remove and discard pits. Place on another plate, drizzle the cut-side with oil, then season with salt and pepper.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 603364,
      "primary_message": "Return the grill pan to medium-high heat. Working in batches if necessary, place peaches on the grill, cut-side down, and cook, turning once, until charred and warmed through, about 3 minutes. Remove to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 603365,
      "primary_message": "Meanwhile, add ⅔ of the dressing to the bowl with the lettuce and toss to combine the salad. (Reserve remaining dressing for serving.)",
      "secondary_message": null
    },
    {
      "id": 603366,
      "primary_message": "Thinly slice grilled peaches.",
      "secondary_message": null
    },
    {
      "id": 603367,
      "primary_message": "To serve, divide salad between plates or bowls, then top with tofu and peaches. Drizzle tofu with reserved dressing and enjoy!",
      "secondary_message": null
    }
  ],
