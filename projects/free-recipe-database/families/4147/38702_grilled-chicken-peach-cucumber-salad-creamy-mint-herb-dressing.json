  "instructions": [
    {
      "id": 603290,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 603291,
      "primary_message": "While the pan heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 603292,
      "primary_message": "Once the pan is hot, coat with oil. Add chicken and grill, flipping once, until golden and cooked through, 8-10 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve pan for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 603293,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg fresh mint\n1 English cucumber\n2 heads romaine lettuce\n4 peaches"
    },
    {
      "id": 603294,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 603295,
      "primary_message": "Using a clean cutting board, shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 603296,
      "primary_message": "Pick mint leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 603297,
      "primary_message": "Peel garlic. Add to the blender along with yogurt, mayo, oil, capers, salt, and pepper. Blend on high until dressing is smooth, 1-2 minutes. Set aside.",
      "secondary_message": "2 cloves garlic\n½ cup plain Greek yogurt\n¼ cup mayonnaise\n3 tbsp extra virgin olive oil\n2 tbsp capers\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 603298,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 603299,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the cucumber and set aside.",
      "secondary_message": null
    },
    {
      "id": 603300,
      "primary_message": "Halve peaches lengthwise (around the pit); twist halves to separate, then remove and discard pits. Place on another plate, drizzle the cut-side with oil, then season with salt and pepper.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 603301,
      "primary_message": "Return the grill pan to medium-high heat. Place peaches on the grill, cut-side down, and cook, turning once, until charred and warmed through, about 3 minutes. Remove to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 603302,
      "primary_message": "Meanwhile, add dressing to the bowl with the lettuce and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 603303,
      "primary_message": "Thinly slice grilled chicken and peaches.",
      "secondary_message": null
    },
    {
      "id": 603304,
      "primary_message": "To serve, divide salad between plates or bowls, then top with sliced chicken and peaches. Enjoy!",
      "secondary_message": null
    }
  ],
