  "instructions": [
    {
      "id": 603212,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 603213,
      "primary_message": "While the pan heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 603214,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add chicken and grill, flipping once, until golden and cooked through, 8-10 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve pan for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 603215,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg fresh mint\n1 ½ English cucumbers\n3 heads romaine lettuce\n6 peaches"
    },
    {
      "id": 603216,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 603217,
      "primary_message": "Using a clean cutting board, shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 603218,
      "primary_message": "Pick mint leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 603219,
      "primary_message": "Peel garlic. Add to the blender along with yogurt, mayo, oil, capers, salt, and pepper. Blend on high until dressing is smooth, 1-2 minutes. Set aside.",
      "secondary_message": "3 cloves garlic\n¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n¼ cup extra virgin olive oil\n3 tbsp capers\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 603220,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 603221,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the cucumber and set aside.",
      "secondary_message": null
    },
    {
      "id": 603222,
      "primary_message": "Halve peaches lengthwise (around the pit); twist halves to separate, then remove and discard pits. Place on another plate, drizzle the cut-side with oil, then season with salt and pepper.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 603223,
      "primary_message": "Return the grill pan to medium-high heat. Working in batches if necessary, place peaches on the grill, cut-side down, and cook, turning once, until charred and warmed through, about 3 minutes. Remove to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 603224,
      "primary_message": "Meanwhile, add dressing to the bowl with the lettuce and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 603225,
      "primary_message": "Thinly slice grilled chicken and peaches.",
      "secondary_message": null
    },
    {
      "id": 603226,
      "primary_message": "To serve, divide salad between plates or bowls, then top with sliced chicken and peaches. Enjoy!",
      "secondary_message": null
    }
  ],
