  "instructions": [
    {
      "id": 457684,
      "primary_message": "Preheat oven to 425°F. Coat two baking sheet pans with a thin layer of oil. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 457685,
      "primary_message": "Place ⅔ of the dressing in a large bowl. Place remaining dressing in a small bowl and set aside for the sauce.",
      "secondary_message": "⅔ cup ranch dressing"
    },
    {
      "id": 457686,
      "primary_message": "Add broccoli to the large bowl with the dressing along with salt and pepper. Stir to coat, then transfer broccoli to one of the baking sheets and spread out in an even layer. (Reserve bowl for the next step.)",
      "secondary_message": "2 (18 oz) bags broccoli florets\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 457687,
      "primary_message": "Place pork, bread crumbs, and spices in the reserved bowl. Using your hands, mix well to combine.",
      "secondary_message": "1 ½ lb lean ground pork\n½ cup panko bread crumbs\n1 tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 457688,
      "primary_message": "Using a tablespoon measure, form the pork mixture into rounded meatballs. Arrange on the other baking sheet.  ",
      "secondary_message": null
    },
    {
      "id": 457689,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing broccoli and turning meatballs halfway through, until meatballs are cooked and broccoli is fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 457690,
      "primary_message": "Meanwhile, add yogurt, salt, and pepper to the small bowl with the dressing. Stir to combine the sauce.",
      "secondary_message": "½ cup plain Greek yogurt\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 457691,
      "primary_message": "To serve, divide sauce and broccoli between plates; top sauce with meatballs. Enjoy!",
      "secondary_message": null
    }
  ],
