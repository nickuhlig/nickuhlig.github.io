  "instructions": [
    {
      "id": 457700,
      "primary_message": "Preheat oven to 425°F. Coat a large baking sheet pan with a thin layer of oil. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 457701,
      "primary_message": "Place ⅔ of the dressing in a medium bowl. Place remaining dressing in a small bowl and set aside for the sauce.",
      "secondary_message": "⅓ cup ranch dressing"
    },
    {
      "id": 457702,
      "primary_message": "Add broccoli to the medium bowl with the dressing along with salt and pepper. Stir to coat, then transfer broccoli to one half of the baking sheet and spread out in an even layer. (Reserve bowl for the next step.)",
      "secondary_message": "1 (18 oz) bag broccoli florets\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 457703,
      "primary_message": "Place veggie ground, bread crumbs, and spices in the reserved bowl. Using your hands, mix well to combine.",
      "secondary_message": "8 oz veggie ground, plant based\n¼ cup panko bread crumbs\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 457704,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs.\" Arrange on the other half of the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 457705,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing broccoli and turning meatballs halfway through, until meatballs are cooked and broccoli is fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 457706,
      "primary_message": "Meanwhile, add yogurt, salt, and pepper to the small bowl with the dressing. Stir to combine the sauce.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 457707,
      "primary_message": "To serve, divide sauce and broccoli between plates; top sauce with meatballs. Enjoy!",
      "secondary_message": null
    }
  ],
