  "instructions": [
    {
      "id": 457716,
      "primary_message": "Preheat oven to 425°F. Coat two large baking sheet pans with a thin layer of oil. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 457717,
      "primary_message": "Place ⅔ of the dressing in a large bowl. Place remaining dressing in a small bowl and set aside for the sauce.",
      "secondary_message": "1 cup ranch dressing"
    },
    {
      "id": 457718,
      "primary_message": "Add broccoli to the large bowl with the dressing along with salt and pepper. Stir to coat, then transfer broccoli to one of the baking sheets and spread out in an even layer. (Reserve bowl for the next step.)",
      "secondary_message": "3 (18 oz) bags broccoli florets\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 457719,
      "primary_message": "Place veggie ground, bread crumbs, and spices in the reserved bowl. Using your hands, mix well to combine.",
      "secondary_message": "24 oz veggie ground, plant based\n¾ cup panko bread crumbs\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 457720,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs.\" Arrange on the other baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 457721,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing broccoli and turning meatballs halfway through, until meatballs are cooked and broccoli is fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 457722,
      "primary_message": "Meanwhile, add yogurt, salt, and pepper to the small bowl with the dressing. Stir to combine the sauce.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 457723,
      "primary_message": "To serve, divide sauce and broccoli between plates; top sauce with meatballs. Enjoy!",
      "secondary_message": null
    }
  ],
