  "instructions": [
    {
      "primary_message": "Remove beef from the fridge and let it stand at room temperature for 30 minutes. ",
      "secondary_message": "1.13 kg beef tenderloin roast"
    },
    {
      "primary_message": "Preheat oven to 450°F. Pour water into a roasting pan, then sit a trivet or wire rack inside the pan. ",
      "secondary_message": null
    },
    {
      "primary_message": "Using several 5 to 6-inch lengths of butcher’s twine, tie the tenderloin at 2-inch intervals (using simple or butcher’s knots) to secure the beef. Transfer to the prepared roasting pan and set aside. ",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic; place in a small bowl. ",
      "secondary_message": "4 clove garlic"
    },
    {
      "primary_message": "Wash, dry, and slide thyme leaves off the stems; discard stems and add leaves to the bowl with the garlic. ",
      "secondary_message": "1 small pkg fresh thyme"
    },
    {
      "primary_message": "Add Dijon, salt, and pepper to the bowl; stir to combine the Dijon mixture.   ",
      "secondary_message": "1 tbsp Dijon mustard\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "primary_message": "Using your hands or a pastry brush, evenly spread all sides of the beef with the Dijon mixture, then drizzle with oil. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Place pan in the oven and roast, turning the tenderloin halfway through, until golden on the outside and the thickest part of the center reaches 145°F (for medium), 25-30 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "When the tenderloin is done, remove from the oven and transfer to a platter. Loosely cover with aluminum foil and let rest, 15 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "After resting, use kitchen scissors to remove string before slicing and serving.  ",
      "secondary_message": null
    }
  ],
