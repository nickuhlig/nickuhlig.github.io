  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the bacon into 1/2-inch pieces. Melt and cool the butter slightly. Shred the cheddar cheese. Finely slice the scallions.",
      "secondary_message": "6 slices bacon\n3 tbsp butter\n170 g cheddar cheese\n½ cup scallions"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 220°C (425°F). Cook bacon in a 25-cm cast iron skillet over medium-high heat until fat renders and bacon crisps, about 10 minutes. Transfer bacon to a paper towel-lined plate. Pour bacon fat out into a small bowl. Return 2 tablespoons to pan and place pan in oven. Reserve an additional 2 tablespoons fat and discard the rest or save for another use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together cornmeal, flour, sugar, baking powder, salt, and baking soda. In a separate medium bowl, whisk together sour cream, buttermilk, eggs, 3 tablespoons melted butter, and 2 tablespoons reserved bacon fat. Pour wet ingredients into bowl with dry ingredients and whisk until completely combined. Stir in bacon, cheese, and scallions.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using pot holders, carefully remove hot pan from oven. Pour in cornbread batter and place in oven. Bake until skewer inserted into middle of cornbread comes out clean, about 20 minutes. Let bread cool in pan for 5 minutes, then carefully turn out to wire rack and let cool an additional 10 minutes. Serve immediately. Reheat any leftover cornbread before serving again.",
      "secondary_message": null
    }
  ],
