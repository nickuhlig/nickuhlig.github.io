  "instructions": [
    {
      "id": 376636,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 376637,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 stick celery\n¼ small bunch fresh dill"
    },
    {
      "id": 376638,
      "primary_message": "Cut cauliflower into 1-inch florets and slice stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 376639,
      "primary_message": "Once the water comes to a boil, uncover, then add cauliflower and salt; stir for a few seconds. Cook until tender-crisp, about 3 minutes. Drain and set aside to cool slightly.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 376640,
      "primary_message": "Meanwhile, place mayo, Dijon, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n2 tsp Dijon mustard\n2 tsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder\n¼ tsp curry powder\n⅛ tsp paprika"
    },
    {
      "id": 376641,
      "primary_message": "Peel and mince shallot. Add to the bowl with the dressing.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 376642,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 376643,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 376644,
      "primary_message": "Small dice ham. Add to the bowl, along with the cauliflower, and stir to combine the salad.",
      "secondary_message": "8 oz ham steak, boneless"
    },
    {
      "id": 376645,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
