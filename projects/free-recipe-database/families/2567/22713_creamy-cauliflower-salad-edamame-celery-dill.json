  "instructions": [
    {
      "id": 376741,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 376742,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 sticks celery\n1 small bunch fresh dill"
    },
    {
      "id": 376743,
      "primary_message": "Cut each cauliflower into 1-inch florets and slice stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 376744,
      "primary_message": "Once the water comes to a boil, uncover, then add cauliflower, edamame, and salt; stir for a few seconds. Cook until cauliflower and edamame are tender-crisp, 3-4 minutes. Drain and set aside to cool slightly.",
      "secondary_message": "3 cups edamame\n¾ tsp salt"
    },
    {
      "id": 376745,
      "primary_message": "Meanwhile, place mayo, Dijon, vinegar, sugar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "½ cup vegan mayonnaise\n2 tbsp Dijon mustard\n2 tbsp red wine vinegar\n1 ½ tsp brown sugar\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder\n¾ tsp curry powder\n½ tsp paprika"
    },
    {
      "id": 376746,
      "primary_message": "Peel and mince shallots. Add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 376747,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 376748,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add dill, cauliflower, and edamame to the bowl; stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 376749,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
