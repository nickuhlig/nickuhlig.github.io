  "instructions": [
    {
      "id": 1,
      "primary_message": "Fit your food processor with the thin slicer attachment. Push the Parmigiano-Reggiano through first, then the parsley, and then the mushrooms. Remove the slicing disc, and put a serving plate over the food processor bowl. Invert the bowl, so the mushroom salad comes out with the mushrooms on the bottom and the parmesan on top.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Zest the lemon over the salad and top with cracked black pepper to taste. In a small bowl, whisk together the lemon juice, vinegar, olive oil, and salt until emulsified. Drizzle over the salad and serve right away.",
      "secondary_message": null
    }
  ],
