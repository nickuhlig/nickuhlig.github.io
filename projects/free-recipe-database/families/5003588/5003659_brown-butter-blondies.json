  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Grease pan with butter.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place butter in a small saucepan over medium heat. Cook, stirring occasionally, until melted. Continue to cook (the butter will foam) until it is fragrant and a nutty brown color. Take off the heat and pour through a sieve into a large bowl. Let cool to room temperature.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, whisk together flour, baking powder, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add brown sugar to bowl with butter and whisk until smooth. Add egg and vanilla and whisk to combine. Stir in dry ingredients until just incorporated. Pour batter into pan and smooth top. Bake until a cake tester inserted into the middle comes out clean, 20-30 minutes. Let cool at least 15 minutes before cutting.",
      "secondary_message": null
    }
  ],
