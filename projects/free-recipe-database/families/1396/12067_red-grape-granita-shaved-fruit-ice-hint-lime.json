  "instructions": [
    {
      "id": 203390,
      "primary_message": "Wash and dry grapes; transfer to a blender.",
      "secondary_message": "0.45 kg red grapes"
    },
    {
      "id": 203391,
      "primary_message": "Wash, dry, and juice lime into the blender.",
      "secondary_message": "½ lime"
    },
    {
      "id": 203392,
      "primary_message": "Add sugar and blend on high speed for several minutes until smooth.",
      "secondary_message": "⅓ cup granulated sugar"
    },
    {
      "id": 203393,
      "primary_message": "Pour grape pureé into a strainer placed over a medium bowl. Using a silicone spatula, press pureé through the strainer to remove skins; discard skins.",
      "secondary_message": null
    },
    {
      "id": 203394,
      "primary_message": "Transfer strained grape pureé to a small baking dish. Cover with plastic wrap and place in the freezer. Let chill until completely frozen, about 8 hours (or overnight).",
      "secondary_message": null
    },
    {
      "id": 203395,
      "primary_message": "Once the pureé is completely frozen, remove from the freezer. Using a fork, scrape the ice from end to end, to form shards. Re-cover with plastic wrap and return to the freezer until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 203396,
      "primary_message": "To serve, divide granita between bowls and enjoy!",
      "secondary_message": null
    }
  ],
