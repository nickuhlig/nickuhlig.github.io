  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "0.45 kg unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to upper middle position and preheat oven to 175°C (350°F). Butter an 20-cm springform pan. In a small bowl, whisk together flour and salt; set aside. In the bowl of a food processor, process butter until light and fluffy, about 3 minutes. Add sugar and pulse for 1 minute. Add flour mixture and pulse just until dough comes together.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Divide dough into two equal portions. Press one half of dough into bottom of prepared pan until even. Spread with filling of choice, leaving 1-cm border at edge of pan. On a lightly floured surface, roll second half of dough out into 20-cm circle. Transfer to pan and place on top of filling. Gently press down on edge of dough to seal. Bake until golden, about 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Let cookies rest in pan for 15 minutes, then transfer to a cooling rack. When cool, cut into wedges or squares.",
      "secondary_message": null
    }
  ],
