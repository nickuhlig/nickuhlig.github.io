  "instructions": [
    {
      "id": 364649,
      "primary_message": "Preheat oven to 450°F. Line two large baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 364650,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ lb cremini mushrooms\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 364651,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 364652,
      "primary_message": "Juice lemons into the bowl with the garlic, then add oil, Dijon, and spices; whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp Dijon mustard\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 364653,
      "primary_message": "Add mushrooms to the bowl with the marinade.",
      "secondary_message": null
    },
    {
      "id": 364654,
      "primary_message": "Pat chicken dry with paper towels, add to the bowl, and toss to coat. Transfer mushrooms and drumsticks to the baking sheets, arranging them in an even layer; drizzle any leftover marinade over top.",
      "secondary_message": "3 ¾ lb chicken drumsticks"
    },
    {
      "id": 364655,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until mushrooms and chicken are cooked through, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 364656,
      "primary_message": "Meanwhile, place mayo, oil, vinegar, Dijon, salt, and pepper in a clean large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp avocado oil mayonnaise\n1 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 364657,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 364658,
      "primary_message": "Right before serving, add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 364659,
      "primary_message": "To serve, divide chicken, mushrooms, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
