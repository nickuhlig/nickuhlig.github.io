  "instructions": [
    {
      "id": 364682,
      "primary_message": "Preheat oven to 230°C (450°F). Line two large baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 364683,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n0.68 kg new potatoes\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 364684,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 364685,
      "primary_message": "Juice lemons into the bowl with the garlic, then add oil, Dijon, and spices; whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp Dijon mustard\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 364686,
      "primary_message": "Quarter potatoes and add to the bowl with the marinade.",
      "secondary_message": null
    },
    {
      "id": 364687,
      "primary_message": "Pat chicken dry with paper towels, add to the bowl, and toss to coat. Transfer potatoes and drumsticks to the baking sheets, arranging them in an even layer; drizzle any leftover marinade over top.",
      "secondary_message": "1.7 kg chicken drumsticks"
    },
    {
      "id": 364688,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until potatoes and chicken are cooked through, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 364689,
      "primary_message": "Meanwhile, place mayo, oil, vinegar, Dijon, salt, and pepper in a clean large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 364690,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 364691,
      "primary_message": "Right before serving, add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 364692,
      "primary_message": "To serve, divide chicken, potatoes, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
