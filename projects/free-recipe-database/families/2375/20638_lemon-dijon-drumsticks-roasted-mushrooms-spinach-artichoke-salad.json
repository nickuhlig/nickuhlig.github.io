  "instructions": [
    {
      "id": 364627,
      "primary_message": "Preheat oven to 450°F. Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 364628,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n½ lb cremini mushrooms\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 364629,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 364630,
      "primary_message": "Juice lemon into the bowl with the garlic, then add oil, Dijon, and spices; whisk to combine the marinade.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 364631,
      "primary_message": "Add mushrooms to the bowl with the marinade.",
      "secondary_message": null
    },
    {
      "id": 364632,
      "primary_message": "Pat chicken dry with paper towels, add to the bowl, and toss to coat. Transfer mushrooms and drumsticks to the baking sheet, arranging them in an even layer; drizzle any leftover marinade over top.",
      "secondary_message": "1 ¼ lb chicken drumsticks"
    },
    {
      "id": 364633,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until mushrooms and chicken are cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 364634,
      "primary_message": "Meanwhile, place mayo, oil, vinegar, Dijon, salt, and pepper in a clean medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp avocado oil mayonnaise\n1 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 364635,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 364636,
      "primary_message": "Right before serving, add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 364637,
      "primary_message": "To serve, divide chicken, mushrooms, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
