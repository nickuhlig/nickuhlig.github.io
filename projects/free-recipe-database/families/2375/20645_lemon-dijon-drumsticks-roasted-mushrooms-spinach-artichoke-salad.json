  "instructions": [
    {
      "id": 364704,
      "primary_message": "Preheat oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 364705,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n0.45 kg cremini mushrooms\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 364706,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 364707,
      "primary_message": "Juice lemon into the bowl with the garlic, then add oil, Dijon, and spices; whisk to combine the marinade.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 364708,
      "primary_message": "Add mushrooms to the bowl with the marinade.",
      "secondary_message": null
    },
    {
      "id": 364709,
      "primary_message": "Pat chicken dry with paper towels, add to the bowl, and toss to coat. Transfer mushrooms and drumsticks to the baking sheet, arranging them in an even layer; drizzle any leftover marinade over top.",
      "secondary_message": "1 ⅛ kg chicken drumsticks"
    },
    {
      "id": 364710,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until mushrooms and chicken are cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 364711,
      "primary_message": "Meanwhile, place mayo, oil, vinegar, Dijon, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp avocado oil mayonnaise\n2 tsp extra virgin olive oil\n2 tsp white wine vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 364712,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 364713,
      "primary_message": "Right before serving, add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 364714,
      "primary_message": "To serve, divide chicken, mushrooms, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
