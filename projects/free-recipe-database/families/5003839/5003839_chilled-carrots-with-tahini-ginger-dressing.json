  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon. Peel and grate the ginger. Mince the cilantro leaves.",
      "secondary_message": "½ lemon\n1 tsp ginger root\n2 tsp cilantro leaves, tender stems"
    },
    {
      "id": 1,
      "primary_message": "Bring a pot of salted water to a boil and fill a large bowl with ice water. Add carrots and cook until tender-crisp, about 3 minutes. Immediately transfer to ice water bath to chill.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together olive oil, lemon juice and zest, ginger, cilantro, and tahini. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Drain carrots, add to bowl with dressing and toss to coat. Serve.",
