  "instructions": [
    {
      "id": 239081,
      "primary_message": "Line the bottom of a baking dish with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 239082,
      "primary_message": "Place coconut and almonds in a skillet set over medium-high heat. Cook, stirring constantly, until coconut and almonds are lightly toasted, 2-3 minutes. Transfer to a small bowl and set aside.",
      "secondary_message": "⅓ cup shredded unsweetened coconut\n⅓ cup almonds, sliced"
    },
    {
      "id": 239083,
      "primary_message": "Fill a small saucepan about halfway with hot water (from the tap); cover and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 239084,
      "primary_message": "Meanwhile, small dice dates; add to the bowl with the toasted coconut and almonds.",
      "secondary_message": "⅛ cup medjool dates, pitted"
    },
    {
      "id": 239085,
      "primary_message": "Uncover the saucepan and place another small heat-proof bowl over the simmering water, allowing it to sit on the rim. Add chocolate and oil to the bowl; using a silicone spatula, stir continuously, until melted.",
      "secondary_message": "⅓ cup dark chocolate chips\n1 tsp virgin coconut oil"
    },
    {
      "id": 239086,
      "primary_message": "Remove bowl from the heat. Add vanilla and salt; stir until smooth.",
      "secondary_message": "⅛ tsp vanilla extract\n1 pinch salt"
    },
    {
      "id": 239087,
      "primary_message": "Add coconut, almonds, and dates to the bowl with the chocolate; stir to incorporate.",
      "secondary_message": null
    },
    {
      "id": 239088,
      "primary_message": "Using a tablespoon measure, place heaping mounds of the chocolate mixture in the baking dish. Place dish in the freezer (or refrigerator if space is limited) and chill until firm, 5-10 minutes. Store in the freezer (or refrigerator) until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 239089,
      "primary_message": "To serve, remove haystacks from the parchment paper and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
