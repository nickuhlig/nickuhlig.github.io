  "instructions": [
    {
      "id": 239099,
      "primary_message": "Line a baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 239100,
      "primary_message": "Place coconut and almonds in a large skillet set over medium-high heat. Cook, stirring constantly, until coconut and almonds are lightly toasted, about 3 minutes. Transfer to a small bowl and set aside.",
      "secondary_message": "1 cup shredded unsweetened coconut\n1 cup almonds, sliced"
    },
    {
      "id": 239101,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 239102,
      "primary_message": "Meanwhile, small dice dates; add to the bowl with the toasted coconut and almonds.",
      "secondary_message": "⅓ cup medjool dates, pitted"
    },
    {
      "id": 239103,
      "primary_message": "Uncover the saucepan and place a medium heat-proof bowl over the simmering water, allowing it to sit on the rim. Add chocolate and oil to the bowl; using a silicone spatula, stir continuously, until melted.",
      "secondary_message": "1 cup dark chocolate chips\n1 tbsp virgin coconut oil"
    },
    {
      "id": 239104,
      "primary_message": "Remove bowl from the heat. Add vanilla and salt; stir until smooth.",
      "secondary_message": "½ tsp vanilla extract\n3 pinch salt"
    },
    {
      "id": 239105,
      "primary_message": "Add coconut, almonds, and dates to the bowl with the chocolate; stir to incorporate.",
      "secondary_message": null
    },
    {
      "id": 239106,
      "primary_message": "Using a tablespoon measure, place heaping mounds of the chocolate mixture on the baking sheet. Place baking sheet in the freezer (or refrigerator if space is limited) and chill until firm, 5-10 minutes. Store in the freezer (or refrigerator) until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 239107,
      "primary_message": "To serve, remove haystacks from the parchment paper and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
