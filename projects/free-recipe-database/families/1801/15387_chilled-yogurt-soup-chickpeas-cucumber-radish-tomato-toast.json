  "instructions": [
    {
      "id": 253374,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 small pkg fresh mint\n1 English cucumber\n1 bunch radish\n4 tomatoes"
    },
    {
      "id": 253375,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 253376,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 253377,
      "primary_message": "While the skillet heats up, peel and mince garlic and onion.",
      "secondary_message": "2 cloves garlic\n½ medium red onion"
    },
    {
      "id": 253378,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, onion, cumin, and salt to the skillet; cook, stirring constantly, until soft and golden, about 2 minutes. Once done, transfer to a medium bowl.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 253379,
      "primary_message": "Add yogurt, broth, sugar, salt, and pepper to the bowl with the garlic and shallot. Whisk to combine the soup base.",
      "secondary_message": "4 cups plain Greek yogurt\n16 fl oz (2 cups) chicken or vegetable broth\n1 tsp brown sugar\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 253380,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the soup base.",
      "secondary_message": null
    },
    {
      "id": 253381,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 253382,
      "primary_message": "Peel and small dice cucumber; trim and small dice radishes. Add both to the bowl along with the chickpeas and stir to combine the soup. Cover and place in the refrigerator until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 253383,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 253384,
      "primary_message": "Peel and mince additional garlic. Place in a small bowl along with oil and salt; stir to combine the garlic oil.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 253385,
      "primary_message": "Slice rolls in half and place on a large baking sheet pan, cut-side up; drizzle with the garlic oil. Place rolls in the oven and broil until golden, 1-2 minutes. Remove from the oven.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 253386,
      "primary_message": "Meanwhile, slice tomatoes into thin rounds. Arrange tomato slices over the toasted rolls and season with salt and pepper.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 253387,
      "primary_message": "Divide soup between bowls and serve with tomato toasts on the side. Enjoy!",
      "secondary_message": null
    }
  ],
