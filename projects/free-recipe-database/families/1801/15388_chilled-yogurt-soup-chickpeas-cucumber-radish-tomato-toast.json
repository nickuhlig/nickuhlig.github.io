  "instructions": [
    {
      "id": 253388,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches cilantro\n1 ½ small pkgs fresh mint\n1 ½ English cucumbers\n1 ½ bunches radish\n6 tomatoes"
    },
    {
      "id": 253389,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 253390,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 253391,
      "primary_message": "While the skillet heats up, peel and mince garlic and onion.",
      "secondary_message": "3 cloves garlic\n1 medium red onion"
    },
    {
      "id": 253392,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, onion, cumin, and salt to the skillet; cook, stirring constantly, until soft and golden, 2-3 minutes. Once done, transfer to a large bowl.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 253393,
      "primary_message": "Add yogurt, broth, sugar, salt, and pepper to the bowl with the garlic and shallot. Whisk to combine the soup base.",
      "secondary_message": "6 cups plain Greek yogurt\n24 fl oz (3 cups) chicken or vegetable broth\n1 ½ tsp brown sugar\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 253394,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the soup base.",
      "secondary_message": null
    },
    {
      "id": 253395,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 253396,
      "primary_message": "Peel and small dice cucumbers; trim and small dice radishes. Add both to the bowl along with the chickpeas and stir to combine the soup. Cover and place in the refrigerator until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 253397,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 253398,
      "primary_message": "Peel and mince additional garlic. Place in a small bowl along with oil and salt; stir to combine the garlic oil.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 253399,
      "primary_message": "Slice rolls in half and divide between two baking sheet pans, cut-side up; drizzle with the garlic oil. Working in batches, place rolls in the oven and broil until golden, 1-2 minutes. Remove from the oven.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 253400,
      "primary_message": "Meanwhile, slice tomatoes into thin rounds. Arrange tomato slices over the toasted rolls and season with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 253401,
      "primary_message": "Divide soup between bowls and serve with tomato toasts on the side. Enjoy!",
      "secondary_message": null
    }
  ],
