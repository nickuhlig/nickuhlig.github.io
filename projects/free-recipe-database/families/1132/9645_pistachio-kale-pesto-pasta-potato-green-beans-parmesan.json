  "instructions": [
    {
      "id": 183156,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 183157,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 bunch kale\n2 medium yellow potatoes\n1 lb green beans\n2 small pkgs fresh basil\n½ lemon"
    },
    {
      "id": 183158,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into 3-inch pieces; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 183159,
      "primary_message": "Peel and dice potatoes into ¾-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 183160,
      "primary_message": "Trim and discard the ends of green beans, then cut in half.",
      "secondary_message": null
    },
    {
      "id": 183161,
      "primary_message": "Once the water in the pot comes to a boil, uncover, add salt and kale, and stir. Cook until bright green and wilted, 30-60 seconds. Transfer kale to a colander using a slotted spoon. Reserve bowl for later.",
      "secondary_message": "2 tsp salt"
    },
    {
      "id": 183162,
      "primary_message": "Once the water in the pot returns to a boil, add potatoes and pasta; stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "10 oz rotini pasta"
    },
    {
      "id": 183163,
      "primary_message": "Meanwhile, peel garlic; transfer to a blender along with cooked kale, water, pistachios, oil, and salt. ",
      "secondary_message": "2 cloves garlic\n⅓ cup water\n¼ cup pistachios, unsalted\n¼ cup extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 183164,
      "primary_message": "Pick basil leaves off the stems; add to the blender. Juice lemon into the blender.",
      "secondary_message": null
    },
    {
      "id": 183165,
      "primary_message": "Finely grate Parmesan. Add half to the blender; set the rest aside for garnish. Blend on high, adding 1 tbsp of water at a time, if needed, until smooth; transfer pesto to the reserved bowl.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 183166,
      "primary_message": "Add green beans to the pot with the pasta during the last 5 minutes of cooking. ",
      "secondary_message": null
    },
    {
      "id": 183167,
      "primary_message": "Roughly chop additional pistachios. ",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 183168,
      "primary_message": "Drain the pasta and vegetables, then transfer to the bowl with the pesto; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 183169,
      "primary_message": "To serve, divide pasta between bowls or plates. Garnish with reserved Parmesan, pistachios, and pepper. Enjoy! ",
      "secondary_message": "¼ tsp black pepper"
    }
  ],
