  "instructions": [
    {
      "id": 438543,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 438544,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 438545,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a medium bowl along with fish sauce, soy sauce, sugar, cornstarch, and spices. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n1 ½ tbsp fish sauce\n1 tbsp soy sauce\n1 tbsp brown sugar\n1 tsp cornstarch\n¼ tsp crushed red pepper\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 438546,
      "primary_message": "Medium dice chicken and add to bowl with the marinade. Stir to coat and set aside.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 438547,
      "primary_message": "While the chicken is marinating, wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n3 baby bok choy\n½ small bunch green onions (scallions)"
    },
    {
      "id": 438548,
      "primary_message": "Using a clean cutting board, trim, seed, and slice bell pepper lengthwise into thin strips. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 438549,
      "primary_message": "Trim and cut bok choy crosswise into ½-inch strips. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 438550,
      "primary_message": "Trim and cut green onions crosswise into 1-inch pieces. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 438551,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 438552,
      "primary_message": "Once the skillet is hot, add oil, and swirl to coat the bottom. Using a slotted spoon, add chicken to the skillet, leaving the marinade in the bowl. Cook, stirring occasionally, until the chicken is golden brown, 5-6 minutes. (Reserve marinade for the next step.)",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 438553,
      "primary_message": "Add the veggies, reserved marinade, and water to the skillet. Continue to cook, stirring occasionally, until veggies are tender and sauce has thickened, 3-4 minutes more. Remove from heat.",
      "secondary_message": "2 tbsp water"
    },
    {
      "id": 438554,
      "primary_message": "Meanwhile, roughly chop cashews.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 438555,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls; sprinkle with cashews. Enjoy!",
      "secondary_message": null
    }
  ],
