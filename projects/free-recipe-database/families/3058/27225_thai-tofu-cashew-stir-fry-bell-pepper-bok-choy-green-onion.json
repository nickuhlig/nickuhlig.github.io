  "instructions": [
    {
      "id": 438610,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 438611,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 438612,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 438613,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with soy sauce, sugar, cornstarch, and crushed red pepper. Whisk to combine the marinade.",
      "secondary_message": "6 cloves garlic\n⅓ cup soy sauce\n3 tbsp brown sugar\n1 tbsp cornstarch\n¾ tsp crushed red pepper"
    },
    {
      "id": 438614,
      "primary_message": "Medium dice tofu and add to bowl with the marinade. Stir to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 438615,
      "primary_message": "While the tofu is marinating, wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n9 baby bok choy\n1 small bunch green onions (scallions)"
    },
    {
      "id": 438616,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Place in another large bowl.",
      "secondary_message": null
    },
    {
      "id": 438617,
      "primary_message": "Trim and cut bok choy crosswise into ½-inch strips. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 438618,
      "primary_message": "Trim and cut green onions crosswise into 1-inch pieces. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 438619,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 438620,
      "primary_message": "Once the pot is hot, add oil, and swirl to coat the bottom. Using a slotted spoon, add tofu to the pot, leaving the marinade in the bowl. Cook, stirring occasionally, until the tofu is golden brown, 6-7 minutes. (Reserve marinade for the next step.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 438621,
      "primary_message": "Add the veggies, reserved marinade, and water to the pot. Continue to cook, stirring occasionally, until veggies are tender and sauce has thickened, 4-5 minutes more. Remove from heat.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 438622,
      "primary_message": "Meanwhile, roughly chop cashews.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 438623,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls; sprinkle with cashews. Enjoy!",
      "secondary_message": null
    }
  ],
