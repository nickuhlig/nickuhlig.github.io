  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve the garlic. Zest and juice the lemon. Pick the thyme leaves from the stems. Cut the blanched and cooled haricots verts into 1/2-inch lengths. Halve the baby grape tomatoes. Chop the Niçoise olives.",
      "secondary_message": "1 medium clove garlic\n1 lemon\n1 tsp fresh thyme leaves\n6 tbsp blanched and cooled haricots verts\n½ cup baby grape tomatoes\n3 tbsp Niçoise olives"
    },
    {
      "id": 1,
      "primary_message": "Rub the tuna steak in 1 1/2 teaspoons olive oil. Season with herbes de Provence, salt, and pepper. Heat 2 teaspoons oil in a small nonstick skillet over medium-high heat until shimmering. Sear the tuna for 45 seconds on each side, and immediately rub the hot fish with the cut side of the garlic. Set aside to cool for a few minutes, then cut into 1/2-inch cubes",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk together the remaining 1/4 cup olive oil, lemon zest and juice, the thyme, the mayonnaise, and the honey, and season with salt and pepper. Cube the tuna. Toss the tuna, potatoes, beans, tomatoes, olives, onions, capers, and anchovies with the lemon dressing in a large bowl. Season to taste with salt and pepper. Arrange the tuna salad in the lettuce cups and serve immediately.",
      "secondary_message": null
    }
  ],
