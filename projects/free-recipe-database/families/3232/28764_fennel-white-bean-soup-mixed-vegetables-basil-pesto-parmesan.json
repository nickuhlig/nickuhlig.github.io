  "instructions": [
    {
      "id": 459834,
      "primary_message": "Wash and dry fennel; trim off root end and dark green stalks, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": "3 fennel bulbs"
    },
    {
      "id": 459835,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 459836,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add fennel and spices; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 459837,
      "primary_message": "Meanwhile, drain and rinse beans in a colander. ",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 459838,
      "primary_message": "When the fennel has softened, add beans, broth, frozen veggies, and pesto to the pot. Stir to combine the soup and bring to a boil.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n3 cups frozen mixed vegetables (carrots, corn, green beans, peas)\n⅓ cup basil pesto"
    },
    {
      "id": 459839,
      "primary_message": "Once boiling, reduce heat to medium-low, cover, and cook until veggies are tender, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 459840,
      "primary_message": "To serve, divide soup between bowls, top with cheese, and drizzle with additional pesto. Enjoy!",
      "secondary_message": "¾ cup Parmesan cheese, shredded\n⅓ cup basil pesto"
    }
  ],
