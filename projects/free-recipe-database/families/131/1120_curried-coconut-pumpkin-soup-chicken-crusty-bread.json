  "instructions": [
    {
      "id": 8818,
      "primary_message": "Heat a small saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 8819,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "½ medium yellow onion\r\n1 clove garlic"
    },
    {
      "id": 8820,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and, stirring frequently, cook until softened, 4-5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 8821,
      "primary_message": "Add garlic and cook until fragrant, 15-30 seconds. Add pumpkin, broth, curry powder, turmeric, and salt. Stir until well combined and cook for 2-3 minutes.",
      "secondary_message": "½ (15 oz) can pure pumpkin purée\n8 fl oz (1 cup) chicken or vegetable broth\n½ tsp curry powder\n½ tsp turmeric\n⅛ tsp salt"
    },
    {
      "id": 8822,
      "primary_message": "Add coconut milk and stir to combine. Simmer until rest of the meal is ready.",
      "secondary_message": "½ (13.5 fl oz) can coconut milk"
    },
    {
      "id": 8823,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 8824,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "½ lb chicken breasts, boneless skinless\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 8825,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until cooked through, 2-3 minutes per side.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 8826,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 8827,
      "primary_message": "Toast bread.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 8828,
      "primary_message": "Shred chicken with your hands or cut into bite-sized pieces.",
      "secondary_message": ""
    },
    {
      "id": 8829,
      "primary_message": "To serve, pour soup in a bowl, garnish with chicken and parsley, and have crusty bread on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
