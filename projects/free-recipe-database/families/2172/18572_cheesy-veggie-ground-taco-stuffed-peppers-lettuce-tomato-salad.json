  "instructions": [
    {
      "id": 323981,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 323982,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n½ lime\n½ small bunch cilantro\n½ head romaine lettuce\n½ pint grape tomatoes"
    },
    {
      "id": 323983,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 323984,
      "primary_message": "Place baking sheet in the oven and broil until peppers are lightly charred and tender, 5-6 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 323985,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323986,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 323987,
      "primary_message": "While the veggie ground is cooking, juice lime into a medium bowl. Add oil and spices; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp cumin, ground\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 323988,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing (reserving the other half for the veggie ground). ",
      "secondary_message": null
    },
    {
      "id": 323989,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 323990,
      "primary_message": "When the veggie ground is done, add reserved cilantro and half of the cheese (setting the rest aside for topping the peppers) to the skillet; stir to combine the filling.",
      "secondary_message": null
    },
    {
      "id": 323991,
      "primary_message": "Divide veggie ground mixture between pepper halves and top with remaining cheese. Return baking sheet to the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 323992,
      "primary_message": "Meanwhile, halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips; add to the bowl with the dressing and cilantro.",
      "secondary_message": null
    },
    {
      "id": 323993,
      "primary_message": "Halve tomatoes and add to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 323994,
      "primary_message": "To serve, divide stuffed peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
