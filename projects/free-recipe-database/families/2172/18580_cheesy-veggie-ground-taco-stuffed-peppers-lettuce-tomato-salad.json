  "instructions": [
    {
      "id": 324109,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 324110,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 red bell peppers\n1 ½ limes\n1 small bunch cilantro\n1 ½ heads romaine lettuce\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 324111,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 324112,
      "primary_message": "Place baking sheet in the oven and broil until peppers are lightly charred and tender, 6-7 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 324113,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 324114,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 324115,
      "primary_message": "While the veggie ground is cooking, juice limes into a large bowl. Add oil and spices; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 324116,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing (reserving the other half for the veggie ground). ",
      "secondary_message": null
    },
    {
      "id": 324117,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 324118,
      "primary_message": "When the veggie ground is done, add reserved cilantro and half of the cheese (setting the rest aside for topping the peppers) to the skillet; stir to combine the filling.",
      "secondary_message": null
    },
    {
      "id": 324119,
      "primary_message": "Divide veggie ground mixture between pepper halves and top with remaining cheese. Return baking sheet to the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 324120,
      "primary_message": "Meanwhile, halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips; add to the bowl with the dressing and cilantro.",
      "secondary_message": null
    },
    {
      "id": 324121,
      "primary_message": "Halve tomatoes and add to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 324122,
      "primary_message": "To serve, divide stuffed peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
