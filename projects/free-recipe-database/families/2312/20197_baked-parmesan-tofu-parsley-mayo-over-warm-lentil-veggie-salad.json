  "instructions": [
    {
      "id": 337166,
      "primary_message": "Cut the tofu into ½-inch thick slices along the long side. Sandwich the tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 337167,
      "primary_message": "Preheat oven to 220°C (425°F). Line another large baking sheet with aluminum foil (optional) and coat with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 337168,
      "primary_message": "Using a strainer, rinse lentils under cold water, then drain and transfer to a medium saucepan; add water and salt. Cover and bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes.",
      "secondary_message": "1 ½ cups green lentils, dried\n6 cup water\n1 ½ tsp salt"
    },
    {
      "id": 337169,
      "primary_message": "Meanwhile, finely grate Parmesan; peel and mince garlic. Place both in a large bowl along with oil, salt, and pepper; stir to combine the topping. ",
      "secondary_message": "85 g Parmesan cheese\n3 cloves garlic\n¼ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 337170,
      "primary_message": "Transfer tofu to the prepared baking sheet and, using the back of a spoon, evenly spread each slice with the topping. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 337171,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until topping is golden and tofu is warmed through, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 337172,
      "primary_message": "While the tofu is baking, wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n1 ½ English cucumbers\n6 tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 337173,
      "primary_message": "Peel and mince shallots; place in the reserved bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 337174,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the shallot. ",
      "secondary_message": null
    },
    {
      "id": 337175,
      "primary_message": "Trim and small dice cucumbers; small dice tomatoes. Add both to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 337176,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 337177,
      "primary_message": "Place reserved parsley in a small bowl along with mayo and salt; stir to combine the parsley mayo and set aside. ",
      "secondary_message": "⅓ cup mayonnaise\n3 pinch salt"
    },
    {
      "id": 337178,
      "primary_message": "When the lentils are done, drain in a colander and transfer to the bowl with the veggies. Add vinegar, oil, salt, and pepper; stir to combine the lentil salad.",
      "secondary_message": "3 tbsp balsamic vinegar\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 337179,
      "primary_message": "To serve, divide lentil salad and tofu between plates; spoon parsley mayo over tofu and enjoy!",
      "secondary_message": null
    }
  ],
