  "instructions": [
    {
      "id": 337138,
      "primary_message": "Cut the tofu into ½-inch thick slices along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 337139,
      "primary_message": "Preheat oven to 220°C (425°F). Line another baking sheet with aluminum foil (optional) and coat with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 337140,
      "primary_message": "Using a strainer, rinse lentils under cold water, then drain and transfer to a small saucepan; add water and salt. Cover and bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes.",
      "secondary_message": "½ cup green lentils, dried\n2 cup water\n½ tsp salt"
    },
    {
      "id": 337141,
      "primary_message": "Meanwhile, finely grate Parmesan; peel and mince garlic. Place both in a medium bowl along with oil, salt, and pepper; stir to combine the topping. ",
      "secondary_message": "28 g Parmesan cheese\n1 clove garlic\n4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 337142,
      "primary_message": "Transfer tofu to the prepared baking sheet and, using the back of a spoon, evenly spread each slice with the topping. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 337143,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until topping is golden and tofu is warmed through, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 337144,
      "primary_message": "While the tofu is baking, wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n½ English cucumber\n2 tomatoes\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 337145,
      "primary_message": "Peel and mince shallot; place in the reserved bowl. ",
      "secondary_message": "½ shallot"
    },
    {
      "id": 337146,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the shallot. ",
      "secondary_message": null
    },
    {
      "id": 337147,
      "primary_message": "Trim and small dice cucumber; small dice tomatoes. Add both to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 337148,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 337149,
      "primary_message": "Place reserved parsley in a small bowl along with mayo and salt; stir to combine the parsley mayo and set aside. ",
      "secondary_message": "2 tbsp mayonnaise\n1 pinch salt"
    },
    {
      "id": 337150,
      "primary_message": "When the lentils are done, drain in a colander and transfer to the bowl with the veggies. Add vinegar, oil, salt, and pepper; stir to combine the lentil salad.",
      "secondary_message": "1 tbsp balsamic vinegar\n2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 337151,
      "primary_message": "To serve, divide lentil salad and tofu between plates; spoon parsley mayo over tofu and enjoy! ",
      "secondary_message": null
    }
  ],
