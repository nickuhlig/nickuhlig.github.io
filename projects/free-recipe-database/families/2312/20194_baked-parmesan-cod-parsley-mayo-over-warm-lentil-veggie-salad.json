  "instructions": [
    {
      "id": 337124,
      "primary_message": "Preheat oven to 220°C (425°F). Line a large baking sheet pan with aluminum foil (optional) and coat with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 337125,
      "primary_message": "Using a strainer, rinse lentils under cold water, then drain and transfer to a medium saucepan; add water and salt. Cover and bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes.",
      "secondary_message": "1 ½ cups green lentils, dried\n6 cup water\n1 ½ tsp salt"
    },
    {
      "id": 337126,
      "primary_message": "Meanwhile, finely grate Parmesan and place in a large bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 337127,
      "primary_message": "Peel and mince garlic; add to the bowl with the Parmesan along with oil, salt, and pepper. Stir to combine the topping. ",
      "secondary_message": "3 cloves garlic\n¼ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 337128,
      "primary_message": "Pat fish dry with paper towels and transfer to the baking sheet. Using the back of a spoon, evenly spread each fillet with the topping. (Reserve bowl for later use.)",
      "secondary_message": "1.02 kg cod fillet"
    },
    {
      "id": 337129,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until topping is golden and fish is cooked through, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 337130,
      "primary_message": "While the fish is baking, wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n1 ½ English cucumbers\n6 tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 337131,
      "primary_message": "Peel and mince shallots; place in the reserved bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 337132,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the shallot. ",
      "secondary_message": null
    },
    {
      "id": 337133,
      "primary_message": "Trim and small dice cucumbers; small dice tomatoes. Add both to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 337134,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 337135,
      "primary_message": "Place reserved parsley in a small bowl along with mayo and salt; stir to combine the parsley mayo and set aside. ",
      "secondary_message": "⅓ cup mayonnaise\n3 pinch salt"
    },
    {
      "id": 337136,
      "primary_message": "When the lentils are done, drain in a colander and transfer to the bowl with the veggies. Add vinegar, oil, salt, and pepper; stir to combine the lentil salad.",
      "secondary_message": "3 tbsp balsamic vinegar\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 337137,
      "primary_message": "To serve, divide lentil salad and fish between plates; spoon parsley mayo over fish and enjoy! ",
      "secondary_message": null
    }
  ],
