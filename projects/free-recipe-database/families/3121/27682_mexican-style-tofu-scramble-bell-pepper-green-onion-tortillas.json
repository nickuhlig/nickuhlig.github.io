  "instructions": [
    {
      "id": 444370,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 444372,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n½ small bunch green onions (scallions)\n½ jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 444374,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 444376,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 444378,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 444380,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 444381,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl. (Reserve the remainder for serving.)",
      "secondary_message": null
    },
    {
      "id": 444383,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, cilantro, and spices; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp coriander, ground\n¼ tsp salt"
    },
    {
      "id": 444385,
      "primary_message": "Crumble tofu into large pieces with your fingers and add to the skillet along with salt and pepper. Continue to cook, stirring occasionally, until tofu is golden, 4-5 minutes. Remove from heat.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 444387,
      "primary_message": "Warm tortillas in another skillet or the microwave (optional).",
      "secondary_message": "4 small flour tortillas"
    },
    {
      "id": 444388,
      "primary_message": "Divide tofu scramble and tortillas between plates; sprinkle tofu with reserved cilantro. Serve with hot sauce on the side and enjoy!",
      "secondary_message": "1 tsp hot sauce"
    }
  ],
