  "instructions": [
    {
      "id": 444202,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 444203,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 small bunch green onions (scallions)\n1 ½ jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 444204,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 444205,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 444206,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 444207,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 444208,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl. (Reserve the remainder for serving.)",
      "secondary_message": null
    },
    {
      "id": 444209,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, cilantro, and spices; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp coriander, ground\n¾ tsp salt"
    },
    {
      "id": 444210,
      "primary_message": "Crumble tofu into large pieces with your fingers and add to the skillet along with salt and pepper. Continue to cook, stirring occasionally, until tofu is golden, 5-6 minutes. Remove from heat.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 444211,
      "primary_message": "Warm tortillas in another skillet or the microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 444212,
      "primary_message": "Divide tofu scramble and tortillas between plates; sprinkle tofu with reserved cilantro. Serve with hot sauce on the side and enjoy!",
      "secondary_message": "1 tbsp hot sauce"
    }
  ],
