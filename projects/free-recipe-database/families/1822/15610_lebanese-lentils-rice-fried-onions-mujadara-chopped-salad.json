  "instructions": [
    {
      "id": 256824,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a large pot. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook for 10 minutes (the lentils will not be cooked all the way through).",
      "secondary_message": "1 ½ cups brown lentils, dried\n60 fl oz (7 ½ cups) chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 256825,
      "primary_message": "Meanwhile, preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 256826,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onions into half-moons.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 256827,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion, cumin, and salt; cook, stirring occasionally, until soft and golden brown, 18-20 minutes. Remove from heat and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 256828,
      "primary_message": "While the onions are cooking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 tomatoes\n1 ½ heads romaine lettuce\n1 small pkg fresh mint"
    },
    {
      "id": 256829,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and add to the pot with the lentils; return to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice"
    },
    {
      "id": 256830,
      "primary_message": "Once the liquid returns to a boil, stir the mixture, cover the pot, and reduce heat to low. Cook lentils and rice until tender and liquid is mostly absorbed, 18-20 minutes more. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 256831,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n¾ tsp oregano, dried\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 256832,
      "primary_message": "Trim and small dice cucumbers; small dice tomatoes. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 256833,
      "primary_message": "Stack lettuce leaves, one on top of another; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256834,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256835,
      "primary_message": "Add feta to the bowl and toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 256836,
      "primary_message": "To serve, divide salad and the lentil-rice mixture between plates; top lentils and rice with fried onions. Enjoy!",
      "secondary_message": null
    }
  ],
