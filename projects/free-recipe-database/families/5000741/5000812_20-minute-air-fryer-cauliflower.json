  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the tough outer leaves and core from the cauliflower.",
      "secondary_message": "1 large head cauliflower"
    },
    {
      "id": 1,
      "primary_message": "Preheat a 6-quart air fryer to 205°C (400°F) (205ºC) for 5 minutes. Cut cauliflower into 8 wedges, then cut into 5-cm florets (should be about 4 cups total). In a large bowl, toss cauliflower with oil, water salt and pepper until well coated; use your hands to make sure all nooks and crannies are coated with oil and seasonings.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Arrange half (about 2 cups) of the florets into the preheated air fryer basket; cook, shaking basket twice during cooking, until tender and well browned, 10 to 12 minutes. Transfer to a bowl and cover to keep warm; and repeat cooking with the remaining cauliflower. Combine cauliflower and serve.",
      "secondary_message": null
    }
  ],
