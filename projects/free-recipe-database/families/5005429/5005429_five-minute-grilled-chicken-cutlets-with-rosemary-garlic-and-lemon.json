  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Cut the boneless skinless chicken breasts into 8 cutlets.",
      "secondary_message": "3 medium cloves garlic\n4 boneless skinless chicken breasts"
    },
    {
      "id": 1,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Alternatively, set half the burners on a gas grill to the highest heat setting, cover, and preheat for 10 minutes. Clean and oil the grilling grate.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk together garlic, rosemary, lemon juice, and olive oil in a large bowl. Season to taste with salt and pepper. Transfer half of mixture to a separate container and set aside. Add chicken to the large bowl and turn pieces to thoroughly coat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place chicken directly over the hot side of the grill, cover, and cook, rotating the pieces occasionally (but not flipping them), until the chicken is almost completely cooked through and only a few pink spots remain on the top side, about 4 minutes. Flip chicken and cook on second side until just done, about 30 seconds. Transfer to a serving platter. Re-whisk reserved marinade and pour it over the chicken. Serve immediately.",
      "secondary_message": null
    }
  ],
