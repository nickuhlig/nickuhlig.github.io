  "instructions": [
    {
      "id": 345906,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 345907,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 345908,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ bunch radish\n½ pint grape tomatoes\n½ avocado\n1 head butter (Boston) lettuce"
    },
    {
      "id": 345909,
      "primary_message": "Zest and juice lemon into a small bowl; add oil, honey, chili-garlic sauce, soy sauce, and spices. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp chili-garlic sauce\n1 tsp soy sauce\n1 tsp garlic powder\n1 tsp paprika\n1 tsp parsley flakes\n½ tsp salt"
    },
    {
      "id": 345910,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345911,
      "primary_message": "While the skillet heats up, cut tofu into 1-inch cubes; place in a medium bowl and season with salt and pepper. Drizzle with half of the sauce and gently stir to coat. (Reserve remaining sauce for later use.)",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 345912,
      "primary_message": "Once the skillet is hot, add tofu and any sauce left in the bowl; cook, turning every few minutes, until golden brown, about 8 minutes. Remove from heat and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 345913,
      "primary_message": "Meanwhile, roughly chop capers; add to the bowl with the remaining sauce along with mayo and ketchup. Whisk to combine the creamy dressing and set aside.",
      "secondary_message": "1 tbsp capers\n2 tbsp mayonnaise\n2 tbsp ketchup"
    },
    {
      "id": 345914,
      "primary_message": "Trim and thinly slice radishes; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 345915,
      "primary_message": "Halve tomatoes and add to the plate with the radish.",
      "secondary_message": null
    },
    {
      "id": 345916,
      "primary_message": "Peel and quarter eggs; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 345917,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 345918,
      "primary_message": "Chop or tear lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 345919,
      "primary_message": "Divide lettuce between plates or bowls; top with radish, tomato, egg, avocado, and tofu. Serve with creamy dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
