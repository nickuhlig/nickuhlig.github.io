  "instructions": [
    {
      "id": 345990,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 345991,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ bunch radish\n½ small pkg grape tomatoes\n½ avocado\n1 head butter (Boston) lettuce"
    },
    {
      "id": 345992,
      "primary_message": "Zest and juice lemon into a small bowl; add oil, honey, chili-garlic sauce, Worcestershire, and spices. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp chili-garlic sauce\n1 tsp Worcestershire sauce\n1 tsp garlic powder\n1 tsp paprika\n1 tsp parsley flakes\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 345993,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 345994,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345995,
      "primary_message": "While the skillet heats up, place shrimp in a medium bowl, drizzle with half of the sauce, and toss to coat. (Reserve remaining sauce for later use.)",
      "secondary_message": null
    },
    {
      "id": 345996,
      "primary_message": "Once the skillet is hot, add shrimp and any sauce left in the bowl; cook until opaque, 1-2 minutes per side. Remove from heat and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 345997,
      "primary_message": "Meanwhile, roughly chop capers; add to the bowl with the remaining sauce along with mayo and ketchup. Whisk to combine the creamy dressing and set aside.",
      "secondary_message": "1 tbsp capers\n2 tbsp mayonnaise\n2 tbsp ketchup"
    },
    {
      "id": 345998,
      "primary_message": "Trim and thinly slice radishes; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 345999,
      "primary_message": "Halve tomatoes and add to the plate with the radish.",
      "secondary_message": null
    },
    {
      "id": 346000,
      "primary_message": "Peel and quarter eggs; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 346001,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 346002,
      "primary_message": "Chop or tear lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 346003,
      "primary_message": "Divide lettuce between plates or bowls; top with radish, tomato, egg, avocado, and shrimp. Serve with creamy dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
