  "instructions": [
    {
      "id": 346018,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 346019,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 ½ bunches radish\n1 ½ small pkgs grape tomatoes\n1 ½ avocados\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 346020,
      "primary_message": "Zest and juice lemons into a small bowl; add oil, honey, chili-garlic sauce, Worcestershire, and spices. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup extra virgin olive oil\n2 tbsp honey\n1 tbsp chili-garlic sauce\n1 tbsp Worcestershire sauce\n1 tbsp garlic powder\n1 tbsp paprika\n1 tbsp parsley flakes\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 346021,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 346022,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346023,
      "primary_message": "While the skillet heats up, place shrimp in a large bowl, drizzle with half of the sauce, and toss to coat. (Reserve remaining sauce for later use.)",
      "secondary_message": null
    },
    {
      "id": 346024,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add shrimp in a single layer (along with any sauce left in the bowl); cook until opaque, about 1-2 minutes per side. Remove to a plate and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 346025,
      "primary_message": "Meanwhile, roughly chop capers; add to the bowl with the remaining sauce along with mayo and ketchup. Whisk to combine the creamy dressing and set aside.",
      "secondary_message": "3 tbsp capers\n⅓ cup mayonnaise\n⅓ cup ketchup"
    },
    {
      "id": 346026,
      "primary_message": "Trim and thinly slice radishes; place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 346027,
      "primary_message": "Halve tomatoes and add to the plate with the radish.",
      "secondary_message": null
    },
    {
      "id": 346028,
      "primary_message": "Peel and quarter eggs; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 346029,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 346030,
      "primary_message": "Chop or tear lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 346031,
      "primary_message": "Divide lettuce between plates or bowls; top with radish, tomato, egg, avocado, and shrimp. Serve with creamy dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
