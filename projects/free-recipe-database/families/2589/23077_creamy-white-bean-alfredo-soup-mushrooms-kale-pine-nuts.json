  "instructions": [
    {
      "id": 380608,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 380609,
      "primary_message": "While the pan heats up, drain and rinse beans in a colander; set aside to drain further. ",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 380610,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 (227g ) pkg sliced white mushrooms"
    },
    {
      "id": 380611,
      "primary_message": "Add beans, broth, Alfredo sauce, and spices to the pan. Stir to combine the soup and bring to a boil over medium-high heat. ",
      "secondary_message": "473 ml chicken or vegetable broth\n½ (454 g) jar Alfredo sauce\n1 tsp Italian seasoning\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 380612,
      "primary_message": "Once boiling, add kale to the pan in handfuls, waiting for the kale to wilt slightly before adding the next handful. Reduce heat to low and continue to cook until beans and kale are tender, about 5 minutes.",
      "secondary_message": "½ (283 g) bag kale, cut and ready to use"
    },
    {
      "id": 380613,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 380614,
      "primary_message": "When the soup is done, remove from heat, add parsley, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 380615,
      "primary_message": "To serve, divide soup between bowls. Top with pine nuts and enjoy!",
      "secondary_message": "¼ cup pine nuts"
    }
  ],
