  "instructions": [
    {
      "id": 380524,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 380525,
      "primary_message": "While the pan heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 380526,
      "primary_message": "Once the pan is hot, add bacon and cook, stirring occasionally, until golden, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 380527,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further. ",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 380528,
      "primary_message": "When the bacon is done, add mushrooms to the pan. Cook, stirring occasionally, until softened, about 3 minutes. ",
      "secondary_message": "1 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 380529,
      "primary_message": "Add beans, broth, Alfredo sauce, and spices to the pan. Stir to combine the soup and bring to a boil over medium-high heat. ",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n½ (16 oz) jar Alfredo sauce\n1 tsp Italian seasoning\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 380530,
      "primary_message": "Once boiling, add kale to the pan in handfuls, waiting for the kale to wilt slightly before adding the next handful. Reduce heat to low and continue to cook until beans and kale are tender, about 5 minutes.",
      "secondary_message": "½ (10 oz) bag kale, cut and ready to use"
    },
    {
      "id": 380531,
      "primary_message": "Meanwhile, using a clean cutting board, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 380532,
      "primary_message": "When the soup is done, remove from heat, add parsley, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 380533,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
