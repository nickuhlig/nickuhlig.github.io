  "instructions": [
    {
      "id": 380570,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 380571,
      "primary_message": "While the pot heats up, drain and rinse beans in a colander; set aside to drain further. ",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 380572,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until softened, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 380573,
      "primary_message": "Add beans, broth, Alfredo sauce, and spices to the pot. Stir to combine the soup and bring to a boil over medium-high heat. ",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 ½ (16 oz) jars Alfredo sauce\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 380574,
      "primary_message": "Once boiling, add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Reduce heat to low and continue to cook until beans and kale are tender, about 5 minutes.",
      "secondary_message": "1 ½ (10 oz) bags kale, cut and ready to use"
    },
    {
      "id": 380575,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 380576,
      "primary_message": "When the soup is done, remove from heat, add parsley, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 380577,
      "primary_message": "To serve, divide soup between bowls. Top with pine nuts and enjoy!",
      "secondary_message": "¾ cup pine nuts"
    }
  ],
