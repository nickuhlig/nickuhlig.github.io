  "instructions": [
    {
      "id": 123919,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 123920,
      "primary_message": "Cut chicken into bite-sized pieces.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 123921,
      "primary_message": "When the skillet is hot, add butter and swirl to coat the bottom. Add chicken and season with salt and pepper. Cook, stirring often, until chicken is cooked through, about 7 minutes. Transfer chicken to a medium bowl and set aside.",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 123922,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach\n½ lb white mushrooms\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 123923,
      "primary_message": "Peel and mince the garlic. Thinly slice the mushrooms; transfer both to a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 123924,
      "primary_message": "Peel and small dice the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 123925,
      "primary_message": "Return skillet to medium-high heat and add more butter; swirl to coat. Add the onion and cook until slightly softened, 2-3 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 123926,
      "primary_message": "Add garlic, mushrooms, chili-garlic sauce, and salt to the skillet. Cook until mushrooms begin to soften, 2-3 minutes.",
      "secondary_message": "¼ tsp chili-garlic sauce\n¼ tsp salt"
    },
    {
      "id": 123927,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Once wilted, add the flour and cook, stirring often, until the spinach mixture thickens, 2-3 minutes.",
      "secondary_message": "1 ½ tsp all-purpose flour"
    },
    {
      "id": 123928,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 123929,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 123930,
      "primary_message": "Stir chicken, cheese, and parsley (reserving some for garnish) into the spinach mixture; cook until heated through, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 123931,
      "primary_message": "Slice pita in half and carefully open them using your fingers. Fill each pita bread with an equal portion of filling.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 123932,
      "primary_message": "Divide filled pita pockets among dishes and sprinkle reserved parsley over the top. Enjoy!",
      "secondary_message": null
    }
  ],
