  "instructions": [
    {
      "id": 124031,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 124032,
      "primary_message": "Cut chicken into bite-sized pieces.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 124033,
      "primary_message": "When the skillet is hot, add butter and swirl to coat the bottom. Add chicken and season with salt and pepper. Cook, stirring often, until chicken is cooked through, about 8 minutes. Transfer chicken to a large bowl and set aside.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ ml salt\n¾ tsp black pepper"
    },
    {
      "id": 124034,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (142 g) pkg baby spinach\n0.68 kg white mushrooms\n1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 124035,
      "primary_message": "Peel and mince the garlic. Thinly slice the mushrooms; transfer both to a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 124036,
      "primary_message": "Peel and small dice the onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 124037,
      "primary_message": "Return skillet to medium-high heat and add more butter; swirl to coat. Add the onion and cook until slightly softened, 3-4 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 124038,
      "primary_message": "Add garlic, mushrooms, chili-garlic sauce, and salt to the skillet. Cook until mushrooms begin to soften, 3-4 minutes.",
      "secondary_message": "¾ tsp chili-garlic sauce\n¾ tsp salt"
    },
    {
      "id": 124039,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Once wilted, add the flour and cook, stirring often, until the spinach mixture thickens, 3-4 minutes.",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 124040,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 124041,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 124042,
      "primary_message": "Stir chicken, cheese, and parsley (reserving some for garnish) into the spinach mixture; cook until heated through, about 2 minutes. Alternatively, transfer chicken, cheese, parsley, and spinach mixture to a large pot, and cook until heated through. ",
      "secondary_message": null
    },
    {
      "id": 124043,
      "primary_message": "Slice pita in half and carefully open them using your fingers. Fill each pita bread with an equal portion of filling.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 124044,
      "primary_message": "Divide filled pita pockets among dishes and sprinkle reserved parsley over the top. Enjoy!",
      "secondary_message": null
    }
  ],
