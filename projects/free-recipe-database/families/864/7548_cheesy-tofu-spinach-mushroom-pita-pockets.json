  "instructions": [
    {
      "id": 123989,
      "primary_message": "Drain and cut the tofu into bite-sized pieces; place on paper towels or a clean towel and pat dry.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 123990,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 123991,
      "primary_message": "When the skillet is hot, add butter and swirl to coat the bottom. Add tofu and season with salt and pepper. Cook, stirring often, until tofu becomes lightly golden, about 8 minutes. Transfer tofu to a large bowl and set aside.",
      "secondary_message": "3 tbsp butter, unsalted\n5.625 ml salt\n¾ tsp black pepper"
    },
    {
      "id": 123992,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (5 oz) pkgs baby spinach\n1 ½ lb white mushrooms\n1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 123993,
      "primary_message": "Peel and mince the garlic. Thinly slice the mushrooms; transfer both to a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 123994,
      "primary_message": "Peel and small dice the onion.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 123995,
      "primary_message": "Return skillet to medium-high heat and add more butter; swirl to coat. Add the onion and cook until slightly softened, 3-4 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 123996,
      "primary_message": "Add garlic, mushrooms, chili-garlic sauce, and salt to the skillet. Cook until mushrooms begin to soften, 3-4 minutes.",
      "secondary_message": "¾ tsp chili-garlic sauce\n¾ tsp salt"
    },
    {
      "id": 123997,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Once wilted, add the flour and cook, stirring often, until the spinach mixture thickens, 3-4 minutes.",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 123998,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 123999,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 124000,
      "primary_message": "Stir tofu, cheese, and parsley (reserving some for garnish) into the spinach mixture, and cook until heated through, about 2 minutes. Alternatively, transfer tofu, cheese, parsley, and spinach mixture to a large pot, and cook until heated through. ",
      "secondary_message": null
    },
    {
      "id": 124001,
      "primary_message": "Slice pita in half and carefully open them using your fingers. Fill each pita bread with an equal portion of filling.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 124002,
      "primary_message": "Divide filled pita pockets among dishes and sprinkle reserved parsley over the top. Enjoy!",
      "secondary_message": null
    }
  ],
