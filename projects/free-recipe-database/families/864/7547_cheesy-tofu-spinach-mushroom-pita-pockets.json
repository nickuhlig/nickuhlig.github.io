  "instructions": [
    {
      "id": 123975,
      "primary_message": "Drain and cut the tofu into bite-sized pieces; place on paper towels or a clean towel and pat dry.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 123976,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 123977,
      "primary_message": "When the skillet is hot, add butter and swirl to coat the bottom. Add tofu and season with salt and pepper. Cook, stirring often, until tofu becomes lightly golden, about 7 minutes. Transfer tofu to a medium bowl and set aside.",
      "secondary_message": "2 tbsp butter, unsalted\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 123978,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 (5 oz) pkgs baby spinach\n1 lb white mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 123979,
      "primary_message": "Peel and mince the garlic. Thinly slice the mushrooms; transfer both to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 123980,
      "primary_message": "Peel and small dice the onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 123981,
      "primary_message": "Return skillet to medium-high heat and add more butter; swirl to coat. Add the onion and cook until slightly softened, 2-3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 123982,
      "primary_message": "Add garlic, mushrooms, chili-garlic sauce, and salt to the skillet. Cook until mushrooms begin to soften, 2-3 minutes.",
      "secondary_message": "½ tsp chili-garlic sauce\n½ tsp salt"
    },
    {
      "id": 123983,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Once wilted, add the flour and cook, stirring often, until the spinach mixture thickens, 2-3 minutes.",
      "secondary_message": "1 tbsp all-purpose flour"
    },
    {
      "id": 123984,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 123985,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 123986,
      "primary_message": "Stir tofu, cheese, and parsley (reserving some for garnish) into the spinach mixture; cook until heated through, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 123987,
      "primary_message": "Slice pita in half and carefully open them using your fingers. Fill each pita bread with an equal portion of filling.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 123988,
      "primary_message": "Divide filled pita pockets among dishes and sprinkle reserved parsley over the top. Enjoy!",
      "secondary_message": null
    }
  ],
