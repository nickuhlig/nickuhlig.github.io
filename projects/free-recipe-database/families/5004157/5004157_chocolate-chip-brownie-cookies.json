  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the 70% bittersweet chocolate. Finely chop the unsweetened chocolate.",
      "secondary_message": "5 oz 70% bittersweet chocolate\n1 oz unsweetened chocolate"
    },
    {
      "id": 1,
      "primary_message": "In heatproof bowl, melt butter, 70% chocolate, and unsweetened chocolate in the microwave or over a pan of barely simmering water until just-melted and smooth. Let cool slightly.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Beat eggs, sugar, and salt with mixer fitted with whip attachment on medium-high speed until lightened, about 2 minutes. On low speed stir in chocolate mixture and vanilla until combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In small bowl whisk flour with baking powder. Stir into chocolate mixture. Chill until firm enough to scoop, about 30 minutes. Fold in chocolate chips (see note).",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Adjust oven rack to upper-middle and lower-middle positions and preheat oven to 350°F. Line two baking sheets with parchment paper. Scoop 1/4-cup balls onto sheets, spacing at least 2 inches apart (about 7 per pan). Bake until puffed and just beginning to crack, 12 to 15 minutes. Let cool on the pan 5 minutes, then gently transfer to wire rack.",
      "secondary_message": null
    }
  ],
