  "instructions": [
    {
      "id": 607092,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 607093,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium spaghetti squash\n1 lemon\n1 head romaine lettuce"
    },
    {
      "id": 607094,
      "primary_message": "Trim each spaghetti squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with butter, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "4 tsp butter, unsalted\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 607095,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 607096,
      "primary_message": "Meanwhile, finely grate Parmesan. Place half in a medium bowl. (Reserve remaining Parmesan for later use.)",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 607097,
      "primary_message": "Peel and mince garlic. Add to the bowl with the Parmesan.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 607098,
      "primary_message": "Juice lemon into the bowl. Add mayo, Dijon, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 607099,
      "primary_message": "Preheat a small saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 607100,
      "primary_message": "While the pan heats up, peel and mince additional garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 607101,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add garlic, cream, pepper, and salt, then stir to combine; bring to a simmer. ",
      "secondary_message": "2 tbsp butter, unsalted\n4 fl oz (½ cup) heavy whipping cream\n1 tsp black pepper\n½ tsp salt"
    },
    {
      "id": 607102,
      "primary_message": "When the cream is simmering, reduce heat to low and add reserved Parmesan to the pan. Continue to cook, stirring frequently, until cheese is melted and sauce is smooth, 3-4 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 607103,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 607104,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 607105,
      "primary_message": "When the squash is cooled slightly, scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.) Place in a medium bowl, along with the sauce, and gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 607106,
      "primary_message": "To serve, divide spaghetti squash and salad between plates or bowls. Top spaghetti squash with additional pepper and enjoy! ",
      "secondary_message": "½ tsp black pepper"
    }
  ],
