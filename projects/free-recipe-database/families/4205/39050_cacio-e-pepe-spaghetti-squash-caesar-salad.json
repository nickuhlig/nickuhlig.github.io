  "instructions": [
    {
      "id": 607242,
      "primary_message": "Preheat the oven to 260°C (500°F) and place rack in the center position. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 607243,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium spaghetti squash\n1 ½ lemons\n1 ½ heads romaine lettuce"
    },
    {
      "id": 607244,
      "primary_message": "Trim each spaghetti squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with butter, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheets.",
      "secondary_message": "2 tbsp butter, unsalted\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 607245,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes. ",
      "secondary_message": null
    },
    {
      "id": 607246,
      "primary_message": "Meanwhile, finely grate Parmesan. Place half in a large bowl. (Reserve remaining Parmesan for later use.)",
      "secondary_message": "255 g Parmesan cheese"
    },
    {
      "id": 607247,
      "primary_message": "Peel and mince garlic. Add to the bowl with the Parmesan.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 607248,
      "primary_message": "Juice lemons into the bowl. Add mayo, Dijon, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "⅓ cup avocado oil mayonnaise\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 607249,
      "primary_message": "Preheat a small saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 607250,
      "primary_message": "While the pan heats up, peel and mince additional garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 607251,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add garlic, cream, pepper, and salt, then stir to combine; bring to a simmer. ",
      "secondary_message": "3 tbsp butter, unsalted\n177 ml heavy whipping cream\n1 ½ tsp black pepper\n¾ tsp salt"
    },
    {
      "id": 607252,
      "primary_message": "When the cream is simmering, reduce heat to low and add reserved Parmesan to the pan. Continue to cook, stirring frequently, until cheese is melted and sauce is smooth, 4-5 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 607253,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 607254,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 607255,
      "primary_message": "When the squash is cooled slightly, scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.) Place in a large bowl, along with the sauce, and gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 607256,
      "primary_message": "To serve, divide spaghetti squash and salad between plates or bowls. Top spaghetti squash with additional pepper and enjoy! ",
      "secondary_message": "¾ tsp black pepper"
    }
  ],
