  "instructions": [
    {
      "id": 20795,
      "primary_message": "Rinse lentils under cold water and transfer to a small saucepan. Cover with broth and bring to a boil. Reduce heat to a simmer and, stirring occasionally, cook until just tender, 15-20 minutes.",
      "secondary_message": "¾ cup green lentils\n354 ml (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 20796,
      "primary_message": "Wash carrots and celery. Peel and small dice carrots. Small dice celery.",
      "secondary_message": "2 medium carrots\r\n2 sticks celery"
    },
    {
      "id": 20797,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 20798,
      "primary_message": "Peel and thinly slice shallot crosswise; separate into rings.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 20799,
      "primary_message": "Coat bottom of skillet with oil. Add shallot and, stirring occasionally, cook until it begins to soften, 2-3 minutes.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 20800,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 20801,
      "primary_message": "Add carrots and celery to skillet and season with salt and pepper. Continue to cook, stirring occasionally, until vegetables are tender, about 5 minutes more.",
      "secondary_message": "¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 20802,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare salad dressing by whisking together garlic, olive oil, vinegar, Dijon, thyme, salt, and pepper.",
      "secondary_message": "1 clove garlic\r\n1 ½ tbsp extra virgin olive oil\r\n½ tbsp red wine vinegar\r\n⅛ tsp Dijon mustard\r\n⅛ tsp thyme\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 20803,
      "primary_message": "Add vegetables and parsley to bowl with vinaigrette.",
      "secondary_message": ""
    },
    {
      "id": 20804,
      "primary_message": "Drain lentils and add to bowl. Toss salad.",
      "secondary_message": ""
    },
    {
      "id": 20805,
      "primary_message": "Serve on a plate and crumble goat cheese over top. Enjoy!",
      "secondary_message": "½ (113 g) log goat cheese"
    }
  ],
