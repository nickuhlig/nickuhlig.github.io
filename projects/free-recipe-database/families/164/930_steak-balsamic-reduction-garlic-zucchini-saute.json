  "instructions": [
    {
      "id": 8352,
      "primary_message": "Peel and mince garlic. Wash and dry zucchini and parsley. Trim zucchini ends; halve lengthwise and slice into half rounds. Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "3 cloves garlic\r\n2 zucchini\r\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 8351,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 8353,
      "primary_message": "Coat bottom of skillet with oil. Add garlic and crushed red pepper and cook until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp virgin coconut oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 8354,
      "primary_message": "Add zucchini, salt, and pepper. Stirring frequently, cook until tender and lightly browned, 5-6 minutes. Transfer to a bowl and stir in parsley.",
      "secondary_message": "¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 8355,
      "primary_message": "Return skillet to stove and add more oil. Season steak with salt and pepper and place in skillet. Cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil\n0.34 kg ribeye steak"
    },
    {
      "id": 8356,
      "primary_message": "Discard any fat from skillet, return to stove, and reduce heat to medium-low. Add vinegar, salt, and pepper. Cook until reduced by about ½, 2-3 minutes.",
      "secondary_message": "½ cup balsamic vinegar\r\n⅛ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 8357,
      "primary_message": "Thinly slice steak against the grain. Add any accumulated juices to skillet and stir to combine.",
      "secondary_message": ""
    },
    {
      "id": 8358,
      "primary_message": "To serve, place steak and zucchini on a plate and drizzle with balsamic reduction. Enjoy!",
      "secondary_message": ""
    }
  ],
