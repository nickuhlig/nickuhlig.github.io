  "instructions": [
    {
      "id": 501224,
      "primary_message": "Peel, halve, and small dice onion. Place in a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 501225,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 501226,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl with the onion.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 501227,
      "primary_message": "Once the pot is hot, add onion, garlic, sausage, and spices. Cook, breaking sausage apart with a spoon, until browned and crumbly, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "0.45 kg ground pork sausage\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 501228,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 501229,
      "primary_message": "When the sausage is done, add broth, tomatoes, pumpkin, and water to the pot. Stir to combine.",
      "secondary_message": "946 ml chicken or vegetable broth\n2 (398 ml) cans diced tomatoes\n1 (398 ml) can pure pumpkin purée\n2 cup water"
    },
    {
      "id": 501230,
      "primary_message": "Add pasta to the pot and stir once more to combine. Cover and bring to a boil over medium-high heat. Once the soup is boiling, reduce heat to medium and simmer until pasta is desired firmness, about 8 minutes.",
      "secondary_message": "170 g rotini pasta"
    },
    {
      "id": 501231,
      "primary_message": "Meanwhile, wash and dry the spinach (skip this step if it came pre-washed). Roughly chop spinach and place in the reserved bowl.",
      "secondary_message": "2 (142 g) pkgs baby spinach"
    },
    {
      "id": 501232,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the spinach. (Set remaining parsley aside for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 501233,
      "primary_message": "When the pasta is done, add spinach and parsley to the pot in handfuls, waiting for the greens to wilt slightly before adding the next handful. Stir to combine the soup and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 501234,
      "primary_message": "To serve, divide soup between bowls, then top with Parmesan and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
