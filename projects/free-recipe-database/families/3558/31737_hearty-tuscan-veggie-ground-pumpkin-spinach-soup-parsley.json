  "instructions": [
    {
      "id": 501299,
      "primary_message": "Peel, halve, and small dice onions. Place in a large bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 501300,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 501301,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl with the onions.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 501302,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onions, garlic, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 501303,
      "primary_message": "When the veggie ground is done, add broth, tomatoes, pumpkin, and water to the pot. Stir to combine.",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes\n1 ½ (398 ml) cans pure pumpkin purée\n3 cup water"
    },
    {
      "id": 501304,
      "primary_message": "Add pasta to the pot and stir once more to combine. Cover and bring to a boil over medium-high heat. Once the soup is boiling, reduce heat to medium and simmer until pasta is desired firmness, about 8 minutes.",
      "secondary_message": "255 g rotini pasta"
    },
    {
      "id": 501305,
      "primary_message": "Meanwhile, wash and dry the spinach (skip this step if it came pre-washed). Roughly chop spinach and place in the reserved bowl.",
      "secondary_message": "3 (142 g) pkgs baby spinach"
    },
    {
      "id": 501306,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the spinach. (Set remaining parsley aside for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 501307,
      "primary_message": "When the pasta is done, add spinach and parsley to the pot in handfuls, waiting for the greens to wilt slightly before adding the next handful. Stir to combine the soup and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 501308,
      "primary_message": "To serve, divide soup between bowls and top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
