  "instructions": [
    {
      "id": 501021,
      "primary_message": "Peel, halve, and small dice onion. Place in a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 501022,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 501023,
      "primary_message": "While the pan heats up, peel and mince garlic. Add to the bowl with the onion.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 501024,
      "primary_message": "Once the pan is hot, add onion, garlic, sausage, and spices. Cook, breaking sausage apart with a spoon, until browned and crumbly, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "½ lb ground pork sausage\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 501025,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 501026,
      "primary_message": "When the sausage is done, add broth, tomatoes, pumpkin, and water to the pan. Stir to combine.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes\n½ (15 oz) can pure pumpkin purée\n1 cup water"
    },
    {
      "id": 501027,
      "primary_message": "Add pasta to the pan and stir once more to combine. Cover and bring to a boil over medium-high heat. Once the soup is boiling, reduce heat to medium and simmer until pasta is desired firmness, about 8 minutes.",
      "secondary_message": "3 oz rotini pasta"
    },
    {
      "id": 501028,
      "primary_message": "Meanwhile, wash and dry the spinach (skip this step if it came pre-washed). Roughly chop spinach and place in the reserved bowl.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 501029,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the spinach. (Set remaining parsley aside for serving.)",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 501030,
      "primary_message": "When the pasta is done, add spinach and parsley to the pan in handfuls, waiting for the greens to wilt slightly before adding the next handful. Stir to combine the soup and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 501031,
      "primary_message": "To serve, divide soup between bowls, then top with Parmesan and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
