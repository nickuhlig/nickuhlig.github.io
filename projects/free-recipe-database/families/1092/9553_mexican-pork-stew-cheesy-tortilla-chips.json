  "instructions": [
    {
      "id": 152323,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 152324,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches cilantro\n3 green bell peppers\n3 limes"
    },
    {
      "id": 152325,
      "primary_message": "Slice the pork chops crosswise into thin strips. ",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 152326,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152327,
      "primary_message": "On a clean cutting board, shave the cilantro leaves off the stems; mince the stems and the leaves, keeping them separate. Set the leaves aside in one small bowl and the stems in another. ",
      "secondary_message": null
    },
    {
      "id": 152328,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 152329,
      "primary_message": "Add pork strips to the pot and cook, tossing occasionally, until the pork is browned and cooked through, 4-5 minutes. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 152330,
      "primary_message": "Meanwhile, seed and medium dice the bell peppers. Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 152331,
      "primary_message": "Return the pot to medium heat; add more oil, cilantro stems, peppers, and garlic. Cook, stirring often, until peppers soften, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 152332,
      "primary_message": "Combine spices in a small bowl. ",
      "secondary_message": "1 tbsp paprika\n1 ½ tsp cumin\n1 ½ tsp chili powder\n1 ½ tsp onion powder\n1 ½ tsp salt\n¾ tsp crushed red pepper\n¾ tsp oregano\n¾ tsp black pepper"
    },
    {
      "id": 152333,
      "primary_message": "Add half of the spice mix, pork, tomatoes, corn, and broth to the pot and stir to combine. Bring to a boil on high, then reduce heat to medium and simmer until slightly thickened, 8-10 minutes. ",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n1 ½ cups frozen corn\n48 fl oz (6 cups) chicken or vegetable broth"
    },
    {
      "id": 152334,
      "primary_message": "Meanwhile, cut each tortilla into 8 triangles and place on a large baking sheet pan. Drizzle with oil and remaining seasoning mix. Toss to coat, then spread out in a single layer. Place in the oven and bake until golden and crispy, 8-10 minutes.",
      "secondary_message": "6 small corn tortillas\n1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 152335,
      "primary_message": "Zest and juice half of the limes into a small bowl. Cut the remaining limes into wedges. ",
      "secondary_message": null
    },
    {
      "id": 152336,
      "primary_message": "Add yogurt and salt to the bowl with the lime zest and stir to combine. ",
      "secondary_message": "¾ cup plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 152337,
      "primary_message": "Coarsely grate cheese. Remove tortillas from the oven and sprinkle with cheese. Return to the oven and bake until the cheese melts, 2-3 minutes. ",
      "secondary_message": "⅜ (8 oz) block mozzarella cheese"
    },
    {
      "id": 152338,
      "primary_message": "To serve, divide pork stew between bowls and top with tortilla chips, cilantro leaves, and a dollop of lime yogurt. Enjoy! ",
      "secondary_message": null
    }
  ],
