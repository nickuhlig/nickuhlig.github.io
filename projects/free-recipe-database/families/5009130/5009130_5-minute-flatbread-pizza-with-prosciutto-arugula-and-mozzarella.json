  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat 1 tablespoon of vegetable oil in a 12-inch skillet over medium-high heat until hot. Add the flatbread and cook until browned, about 2 minutes. Flip and then immediately top with the cheese, tomatoes, 2 or 3 pieces of prosciutto and cover and cook until the cheese melts, less than a minute.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small mixing bowl, dress the arugula with the extra-virgin olive oil, lemon juice, salt and pepper and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Slide the pita out, place on a serving plate and keep warm in the oven while you cook the remaining batches. Top pizzas with the dressed arugula, parmesan, and a hit of pepper.",
      "secondary_message": null
    }
  ],
