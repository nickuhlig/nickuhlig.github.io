  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F. Grease or spray a 12-cavity mini donut pan. Reserve 12 M&M’S® Milk Chocolate Pastels; set aside. Finely chop remaining M&M’S®; set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "In large bowl, whisk together flour, sugar, baking powder, baking soda and salt until combined.",
      "secondary_message": null
    },
    {
      "primary_message": "In medium bowl, whisk together egg, buttermilk, oil and vanilla. Stir wet ingredients into dry ingredients just until blended. Fold in reserved chopped M&M’S®.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide batter evenly among prepared donut mold. Bake for 5 to 6 minutes or until tester inserted in center of donut comes out clean. Transfer pan to rack; let cool for 5 minutes. Reinforce donut holes with handle of wooden spoon, if necessary.",
      "secondary_message": null
    },
    {
      "primary_message": "In another medium bowl, add powdered sugar. Toss donuts in powdered sugar until coated. Transfer to parchment paper–lined baking sheet.",
      "secondary_message": null
    },
    {
      "primary_message": "Cut each marshmallow into an “X” shape, resulting in quarters. Transfer melted pink candy melts to small piping bag with snipped tip. Pipe a pink log onto center of each marshmallow quarter to resemble the inner pink part of bunny ears.",
      "secondary_message": null
    },
    {
      "primary_message": "Pipe remaining melted pink candy melts on the ends of one side of each ear and glue 2 ears on top of each donut. Let stand until melted pink candy melts are firm and set, about 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Decorate the center of each donut with 1 whole M&M® Milk Chocolate Pastel to resemble bunny noses.",
      "secondary_message": null
    },
    {
      "primary_message": "Chef's tip: Substitute mini donut pan with mini muffin cups.",
      "secondary_message": null
    },
    {
      "primary_message": "Chef's tip: Substitute pink candy melts with store-bought tube of pink frosting.",
      "secondary_message": null
    }
  ],
