  "instructions": [
    {
      "id": 63744,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 63743,
      "primary_message": "Peel and mince garlic. In a large bowl, prepared dressing by mixing together garlic, mayo, Dijon, dill, paprika, salt, and pepper.",
      "secondary_message": "3 cloves garlic\n9 tbsp mayonnaise\n3 tsp Dijon mustard\n¾ tsp dill\n⅜ tsp paprika\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 63742,
      "primary_message": "Wash celery and green onions. Small dice celery and add to bowl with dressing. Trim and discard green onion roots ends, chop, and add to bowl.",
      "secondary_message": "6 sticks celery\n1 ½ small bunch green onions (scallions)"
    },
    {
      "id": 63741,
      "primary_message": "Wash and dry spinach.",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 63740,
      "primary_message": "Wash tomatoes.",
      "secondary_message": "3 small pkg grape tomatoes"
    },
    {
      "id": 63739,
      "primary_message": "Toast bread.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 63738,
      "primary_message": "Peel, medium dice, and add eggs to bowl with other ingredients. Stir to combine.",
      "secondary_message": ""
    },
    {
      "id": 63737,
      "primary_message": "Place bread in pairs on a flat surface. Arrange spinach leaves over one slice of bread in each pair, then top with egg salad and a second slice of bread.",
      "secondary_message": ""
    },
    {
      "id": 63736,
      "primary_message": "Serve sandwiches with tomatoes on the side and enjoy!",
      "secondary_message": ""
    }
  ],
