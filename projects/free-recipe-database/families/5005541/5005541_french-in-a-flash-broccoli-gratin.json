  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the oven to 375°F. Blanch the broccoli in salted boiling water for 2 minutes. Drain.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Toss the broccoli with the cream fraîche, three quarters of the cheese, and salt and pepper. Spoon the broccoli mixture into a greased baking dish. Top with the panko, and the remaining cheese. Bake until the top is golden and bubbling—30 to 35 minutes.",
      "secondary_message": null
    }
