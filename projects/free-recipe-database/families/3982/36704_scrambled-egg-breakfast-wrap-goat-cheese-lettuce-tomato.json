  "instructions": [
    {
      "id": 576135,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise, then slice crosswise into thin half-moons. Place on a plate.",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 576136,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the plate with the tomato and set aside.",
      "secondary_message": "1 head butter (Boston) lettuce"
    },
    {
      "id": 576137,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 576138,
      "primary_message": "While the skillet heats up, place eggs and spices in a medium bowl. Whisk to combine.",
      "secondary_message": "8 eggs\n½ tsp basil, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 576139,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny, then remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 576140,
      "primary_message": "Place tortillas on a flat surface and divide scrambled eggs down the center of each. Top with lettuce and tomato, then season with salt. Crumble goat cheese over top, then fold in sides of tortillas and roll tightly to close the wraps.",
      "secondary_message": "4 large flour tortillas\n¼ tsp salt\n1 (113 g) log goat cheese"
    },
    {
      "id": 576141,
      "primary_message": "To serve, cut wraps in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
