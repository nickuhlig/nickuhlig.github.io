  "instructions": [
    {
      "id": 576107,
      "primary_message": "Wash, dry, and halve tomato lengthwise, then slice crosswise into thin half-moons. Place on a plate.",
      "secondary_message": "1 tomato"
    },
    {
      "id": 576108,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the plate with the tomato and set aside.",
      "secondary_message": "½ head butter (Boston) lettuce"
    },
    {
      "id": 576109,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 576110,
      "primary_message": "While the skillet heats up, place eggs and spices in a medium bowl. Whisk to combine.",
      "secondary_message": "4 eggs\n¼ tsp basil, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 576111,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny, then remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 576112,
      "primary_message": "Place tortillas on a flat surface and divide prosciutto between them. Top with scrambled eggs, lettuce, and tomato, then season with salt. Fold in sides of tortillas and roll tightly to close the wraps.",
      "secondary_message": "2 large flour tortillas\n4 slices prosciutto\n⅛ tsp salt"
    },
    {
      "id": 576113,
      "primary_message": "To serve, cut wraps in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
