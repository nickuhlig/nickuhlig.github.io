  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the white chocolate.",
      "secondary_message": "71 g white chocolate, plus extra for garnish"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Line standard muffin tin with cupcake liners.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place 71 g chocolate in medium bowl. Heat cream to simmer and pour over chocolate. Let sit 5 minutes, then stir until smooth. Chill until cold, at least 1 hour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In large bowl, stir flour, cocoa, baking soda, salt, and sugar until combined. Add sour cream, egg, oil, 1 tablespoon raspberry preserves, and vanilla. Whisk until smooth.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Divide batter between cups and bake until set, about 18 minutes. Let cupcakes cool in the pan 5 minutes, then transfer to wire rack to cool completely, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Using small paring knife, cut a 2.5-cm wide, 1.5-cm deep cone from tops of cupcakes. Fill each cupcake with 1 teaspoon raspberry preserves and 1 raspberry. Top with the piece of cake that was removed.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Using mixer, whip chilled white chocolate mixture on medium-high speed to medium peak. Reduce speed to low and mix in remaining 2 tablespoons raspberry preserves.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Spoon over cupcakes and top with remaining raspberries and shavings of white chocolate.",
      "secondary_message": null
    }
  ],
