  "instructions": [
    {
      "id": 489267,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ English cucumber\n¼ small pkg fresh mint"
    },
    {
      "id": 489268,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 ¼ cups edamame"
    },
    {
      "id": 489269,
      "primary_message": "Zest and juice lemon into a medium bowl. Add oil, honey, Dijon, and spices, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp honey\n½ tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp onion powder\n⅛ tsp garlic powder\n⅛ tsp oregano, dried"
    },
    {
      "id": 489270,
      "primary_message": "Trim and small dice cucumber. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 489271,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with edamame and feta. Stir to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 489272,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
