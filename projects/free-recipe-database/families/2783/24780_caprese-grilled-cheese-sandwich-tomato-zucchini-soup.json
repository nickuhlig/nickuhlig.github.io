  "instructions": [
    {
      "id": 421056,
      "primary_message": "Place broth, marinara sauce, cream, salt, and pepper in a large pot. Stir to combine the soup and bring to a boil over medium-high heat. ",
      "secondary_message": "1420 ml chicken or vegetable broth\n1 ½ (680 g) jars marinara sauce\n177 ml heavy whipping cream\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 421057,
      "primary_message": "While the soup is heating, wash, dry, trim, and small dice zucchini.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 421058,
      "primary_message": "Once the soup is boiling, add zucchini to the pot and stir to combine. Reduce heat to low and continue to cook, stirring occasionally, until zucchini is tender, 8-10 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 421059,
      "primary_message": "Meanwhile, wash, dry, and thinly slice tomatoes.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 421060,
      "primary_message": "Place the bread slices on a flat surface and spread with pesto. Top half of the slices with tomato and cheese. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "12 slices whole grain bread\n¾ cup basil pesto\n1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 421061,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 421062,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 421063,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Transfer to the cutting board and slice in half.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 421064,
      "primary_message": "Divide the soup between bowls and serve with sandwiches on the side. Enjoy!",
      "secondary_message": null
    }
  ],
