  "instructions": [
    {
      "primary_message": "Place broth, marinara sauce, cream, salt, and pepper in a medium saucepan. Stir to combine the soup and bring to a boil over medium-high heat. ",
      "secondary_message": "473 ml chicken or vegetable broth\n½ (680 g) jar marinara sauce\n59 ml heavy whipping cream\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "While the soup is heating, wash, dry, trim, and small dice zucchini.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "primary_message": "Once the soup is boiling, add zucchini to the pan and stir to combine. Reduce heat to low and continue to cook, stirring occasionally, until zucchini is tender, 8-10 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and thinly slice tomato.",
      "secondary_message": "1 tomato"
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface and spread with pesto. Top half of the slices with tomato and cheese. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "¼ cup basil pesto\n½ cup shredded cheese, Italian blend"
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "butter, unsalted"
    },
    {
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Transfer to the cutting board and slice in half.",
      "secondary_message": "butter, unsalted"
    },
    {
      "primary_message": "Divide the soup between bowls and serve with sandwiches on the side. Enjoy!",
      "secondary_message": null
    }
  ],
