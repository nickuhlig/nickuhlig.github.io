  "instructions": [
    {
      "id": 28316,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 28323,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n1 (1 inch) piece ginger root\n½ small bunch cilantro"
    },
    {
      "id": 28330,
      "primary_message": "Small dice the tomato; transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 28317,
      "primary_message": "Once the water is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 15-18 minutes. Remove from the heat and let the rice stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 28318,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 28314,
      "primary_message": "Peel and small dice the onion; transfer to a small bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 28319,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 28320,
      "primary_message": "Add the onion to the skillet and cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 28322,
      "primary_message": "While the onion cooks, peel and mince the ginger; transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 28315,
      "primary_message": "Peel and mince the garlic; add to the bowl of ginger.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 28321,
      "primary_message": "Add curry powder to the bowl of ginger and garlic.",
      "secondary_message": "2 tsp curry powder"
    },
    {
      "id": 28324,
      "primary_message": "Add the spice mixture to the onions; cook, stirring constantly, for about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 28325,
      "primary_message": "Add the ground beef and cook, breaking apart into smaller pieces, until browned, 2 to 3 minutes.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 28326,
      "primary_message": "Add the tomato, water and season with salt; bring to a boil. Reduce heat to medium-low and simmer for 6 to 8 minutes.",
      "secondary_message": "½ cup water\n½ tsp salt"
    },
    {
      "id": 28327,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and chop the leaves.",
      "secondary_message": ""
    },
    {
      "id": 28328,
      "primary_message": "Add the peas and half of the cilantro (save the rest for garnishing) to the skillet; stir to combine and cook until the peas are warmed through, 2 to 3 minutes.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 28329,
      "primary_message": "Divide the rice between two plates (or one plate and one lunch container), top with the beef kheema, and garnish with the remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
