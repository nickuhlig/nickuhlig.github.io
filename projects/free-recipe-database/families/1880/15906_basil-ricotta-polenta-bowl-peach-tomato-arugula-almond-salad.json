  "instructions": [
    {
      "id": 261323,
      "primary_message": "In a large pot, bring broth to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the liquid. Cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "1183 ml chicken or vegetable broth\n1 cup polenta (cornmeal)"
    },
    {
      "id": 261324,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg grape tomatoes\n4 peaches\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 261325,
      "primary_message": "Place oil, vinegar, honey, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp honey\n1 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 261326,
      "primary_message": "Peel and mince shallot; add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 261327,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 261328,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice each quarter and add to the bowl; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 261329,
      "primary_message": "Roughly chop almonds and set aside.",
      "secondary_message": "¼ cup almonds"
    },
    {
      "id": 261330,
      "primary_message": "When the polenta is almost done, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 261331,
      "primary_message": "Add half of the basil to the bowl with the tomatoes and peaches (reserve the rest of the basil for the polenta).",
      "secondary_message": null
    },
    {
      "id": 261332,
      "primary_message": "Add arugula and almonds to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 261333,
      "primary_message": "When the polenta is done, add ricotta, salt, and pepper; whisk until smooth and creamy.",
      "secondary_message": "1 (425 g) pkg ricotta cheese\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 261334,
      "primary_message": "To serve, divide polenta and salad between bowls; sprinkle reserved basil over the polenta. Enjoy!",
      "secondary_message": null
    }
  ],
