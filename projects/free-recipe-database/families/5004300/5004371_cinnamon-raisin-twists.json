  "ingredients": [
    {
      "ingredient_id": 2843,
      "name": "all-butter puff pastry, defrosted",
      "quantity": "397 g"
    },
    {
      "ingredient_id": 346,
      "name": "sugar",
      "quantity": "½ cup"
    },
    {
      "ingredient_id": 74,
      "name": "cinnamon",
      "quantity": "½ tbsp"
    },
    {
      "ingredient_id": 214,
      "name": "raisins",
      "quantity": "1 cup"
    },
    {
      "ingredient_id": 115,
      "name": "butter, melted",
      "quantity": "3 tbsp"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 175°C (350°F). Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together sugar and cinnamon.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Lay puff pastry out on a clean surface so that the long side of the rectangle is closest to you. Brush surface with melted butter.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Sprinkle cinnamon sugar evenly across puff pastry, then cover with raisins.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Fold puff pastry in half horizontally. Cut into about 12 2.5-cm, vertical strips.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Lightly press down sides of first strip to keep filling inside. Carefully twist strip into a spiral. I found it was easiest to do this while keeping the twist as close to my work surface as possible. Continue to twist remaining strips.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Carefully transfer twists to prepared baking sheet. Bake twists until golden, about 30 minutes.",
      "secondary_message": null
    }
  ],
