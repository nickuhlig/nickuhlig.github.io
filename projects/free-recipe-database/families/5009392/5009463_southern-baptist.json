  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Ginger Syrup: Slice ginger into chunks and place in bottom of mixing glass. Muddle until broken up well. Strain juice through fine-mesh tea strainer, pressing on solids to extract juice. Measure out 14 g fresh ginger juice, pour into small glass, mix with sugar until dissolved, stirring well. Mixture will be very thick.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Cocktail: Pour rye, 21 g ginger syrup and lime juice into a cocktail shaker. Fill with ice and shake until well chilled, about 15 seconds. Strain into coupe, garnish as desired and serve.",
      "secondary_message": null
    }
  ],
