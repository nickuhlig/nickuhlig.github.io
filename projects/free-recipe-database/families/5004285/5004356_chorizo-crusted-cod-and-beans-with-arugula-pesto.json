  "instructions": [
    {
      "id": 1,
      "primary_message": "Place the oven rack in the lower middle position. Preheat the oven to 205°C (400°F). Put the garlic, arugula, Pecorino, and 1/4 cup olive oil in a food processor and process until a rough paste is formed. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Season the cod with salt and pepper. Layer the thin slices of chorizo on the top of each fillet like the scales on a fish. Heat remaining 2 teaspoons of oil to a small nonstick skillet over medium-high heat until shimmering. Carefully place the fish (with its chorizo scales facing up) in the skillet. Cook for 2 minutes on the stovetop, then transfer to the oven until the fish is cooked through, 10 to 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove fish from skillet and set aside. Add beans and 1 tablespoon of water to the skillet and heat over medium high heat until the water is evaporated and beans are warm. Stir in pesto. To plate, make a bed of the pesto beans, and top with the chorizo fish.",
      "secondary_message": null
    }
  ],
