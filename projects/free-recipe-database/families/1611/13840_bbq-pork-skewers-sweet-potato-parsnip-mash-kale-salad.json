  "instructions": [
    {
      "id": 229814,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them. ",
      "secondary_message": null
    },
    {
      "id": 229815,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb sweet potato\n1 medium parsnip\n½ bunch kale"
    },
    {
      "id": 229816,
      "primary_message": "Peel and medium dice sweet potato and parsnip. Transfer to a medium saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until veggies can be easily pierced with a fork, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 229817,
      "primary_message": "Meanwhile, place ketchup, Worcestershire, sugar, vinegar, Dijon, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "3 tbsp ketchup\n2 tsp Worcestershire sauce\n1 tsp brown sugar\n1 tsp apple cider vinegar\n1 tsp Dijon mustard\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229818,
      "primary_message": "Pat pork chops dry with paper towels and place on a cutting board; cut into 1-inch pieces. Thread pork onto skewers and place on a plate; alternatively, you can cook the pork pieces directly on the grill pan without using skewers.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 229819,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 229820,
      "primary_message": "While the grill pan heats up, pour half the BBQ sauce over the skewers and turn to coat. Reserve remaining sauce for serving.",
      "secondary_message": null
    },
    {
      "id": 229821,
      "primary_message": "Once the grill pan is hot, coat with oil. Add skewers and grill, rotating every 2½-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tsp virgin coconut oil"
    },
    {
      "id": 229822,
      "primary_message": "When the sweet potatoes and parsnips are done, drain, and return to the pan.",
      "secondary_message": null
    },
    {
      "id": 229823,
      "primary_message": "Add milk, oil, salt, and pepper to the sweet potatoes and parsnips; mash until smooth. Cover and set aside.",
      "secondary_message": "2 fl oz (¼ cup) whole milk\n1 tbsp virgin coconut oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229824,
      "primary_message": "Peel and mince garlic; transfer to a medium bowl. Add oil and mash with the back of a spoon until soft and combined.",
      "secondary_message": "1 clove garlic\n2 tsp virgin coconut oil"
    },
    {
      "id": 229825,
      "primary_message": "Add vinegar, Dijon, sugar, salt, and pepper to the bowl with the garlic; whisk to combine the dressing.",
      "secondary_message": "2 tsp apple cider vinegar\n1 tsp Dijon mustard\n½ tsp brown sugar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229826,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and transfer to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 229827,
      "primary_message": "To serve, divide pork skewers, sweet potato-parsnip mash, and kale salad between plates. Top skewers with reserved BBQ sauce and enjoy!",
      "secondary_message": null
    }
  ],
