  "instructions": [
    {
      "id": 360312,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 360313,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 360314,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 2-3 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 360315,
      "primary_message": "Add marinara, water, spices, and sugar to the pot. Stir to combine the curry and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until slightly thickened, 6-8 minutes. ",
      "secondary_message": "1 (680 g) jar marinara sauce\n1 cup water\n4 tsp garam masala\n1 tsp garlic powder\n1 tsp salt\n1 tsp brown sugar"
    },
    {
      "id": 360316,
      "primary_message": "Meanwhile, halve eggs and place in a small bowl; set aside. ",
      "secondary_message": "8 hard-cooked eggs, peeled"
    },
    {
      "id": 360317,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 360318,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 360319,
      "primary_message": "Once the curry has thickened, add spinach and cilantro to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 360320,
      "primary_message": "Add eggs to the curry, gently stir to combine, and continue to cook until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 360321,
      "primary_message": "Meanwhile, toast naan if desired, then cut into wedges. ",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 360322,
      "primary_message": "Divide curry between bowls and serve with naan on the side. Enjoy!",
      "secondary_message": null
    }
  ],
