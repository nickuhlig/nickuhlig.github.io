  "instructions": [
    {
      "id": 360290,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 360291,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 360292,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 360293,
      "primary_message": "Add marinara, water, spices, and sugar to the pot. Stir to combine the curry and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until slightly thickened, 8-10 minutes. ",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce\n1 ½ cup water\n2 tbsp garam masala\n1 ½ tsp garlic powder\n1 ½ tsp salt\n1 ½ tsp brown sugar"
    },
    {
      "id": 360294,
      "primary_message": "Meanwhile, halve eggs and place in a medium bowl; set aside. ",
      "secondary_message": "12 hard-cooked eggs, peeled"
    },
    {
      "id": 360295,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 360296,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 360297,
      "primary_message": "Once the curry has thickened, add spinach and cilantro to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 360298,
      "primary_message": "Add eggs to the curry, gently stir to combine, and continue to cook until warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 360299,
      "primary_message": "Meanwhile, toast naan if desired, then cut into wedges. ",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 360300,
      "primary_message": "Divide curry between bowls and serve with naan on the side. Enjoy!",
      "secondary_message": null
    }
  ],
