  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the garlic. Stem and thinly slice the serrano pepper. Stem the Swiss chard, then separate and chop the leaves.",
      "secondary_message": "12 cloves garlic\n1 serrano pepper\n0.9 kg Swiss chard"
    },
    {
      "id": 1,
      "primary_message": "In a large Dutch oven or deep skillet, heat olive oil and garlic over medium heat and cook, stirring frequently, until softened and lightly golden, 4 to 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add serrano and cook until fragrant, about 30 seconds. Add chard leaves in three or four batches, tossing and covering for about 1 minute between additions to help the greens wilt and make room for more. Once all the chard has been added, uncover and cook, stirring occasionally, until the leaves are tender and most of the released liquid has evaporated, 4 to 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove from heat and stir in lemon juice. Season with salt and lemon juice to taste. Serve warm.",
      "secondary_message": null
    }
  ],
