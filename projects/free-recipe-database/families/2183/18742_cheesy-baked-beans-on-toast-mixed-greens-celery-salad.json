  "instructions": [
    {
      "id": 306930,
      "primary_message": "Preheat oven to 230°C (450°F). Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 306931,
      "primary_message": "Drain and rinse beans in a colander, then transfer to a large baking dish.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 306932,
      "primary_message": "Peel, halve, and mince shallots; add to the baking dish along with tomato sauce, maple syrup, Dijon, and spices. Stir to combine.",
      "secondary_message": "2 shallots\n3 (213 ml) cans tomato sauce\n2 tbsp pure maple syrup\n2 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp paprika\n3 pinch cumin, ground"
    },
    {
      "id": 306933,
      "primary_message": "Place baking dish on lower rack of the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until beans are soft and sauce has thickened, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 306934,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n1 ½ English cucumbers\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 306935,
      "primary_message": "Place yogurt, mayo, water, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp mayonnaise\n2 tbsp water\n2 tbsp apple cider vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 306936,
      "primary_message": "Trim and slice celery crosswise into thin pieces; trim and medium dice cucumbers. Add both to the bowl with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 306937,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 306938,
      "primary_message": "Divide bread slices between two large baking sheet pans; working in batches, place on upper rack of the oven and toast, flipping once, until golden, 4-5 minutes. Remove from oven. ",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 306939,
      "primary_message": "When the baked beans are done, remove from oven and stir well. Divide beans between toast slices and top each with an even layer of cheese. ",
      "secondary_message": null
    },
    {
      "id": 306940,
      "primary_message": "Working in batches, return baking sheets to upper rack of the oven and bake until cheese is melted, 3-4 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 306941,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 306942,
      "primary_message": "Divide \"baked beans on toast\" between plates and serve with salad on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
