  "instructions": [
    {
      "id": 306709,
      "primary_message": "Preheat oven to 450°F. Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 306710,
      "primary_message": "Drain and rinse beans in a colander, then transfer to a small baking dish.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 306711,
      "primary_message": "Peel, halve, and mince shallot; add to the baking dish along with tomato sauce, maple syrup, Dijon, Worcestershire, and spices. Stir to combine.",
      "secondary_message": "½ shallot\n1 (8 oz) can tomato sauce\n2 tsp pure maple syrup\n2 tsp Dijon mustard\n1 tsp Worcestershire sauce\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp paprika\n1 pinch cumin, ground"
    },
    {
      "id": 306712,
      "primary_message": "Place baking dish on lower rack of the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until beans are soft and sauce has thickened, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 306713,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n½ English cucumber\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 306714,
      "primary_message": "Place yogurt, mayo, water, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tbsp mayonnaise\n2 tsp water\n2 tsp apple cider vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 306715,
      "primary_message": "Trim and slice celery crosswise into thin pieces; trim and medium dice cucumber. Add both to the bowl with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 306716,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 306717,
      "primary_message": "Arrange bread slices on a baking sheet pan; place on upper rack of the oven and toast, flipping once, until golden, 4-5 minutes. Remove from oven. ",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 306718,
      "primary_message": "When the baked beans are done, remove from oven and stir well. Divide beans between toast slices and top each with an even layer of cheese. ",
      "secondary_message": null
    },
    {
      "id": 306719,
      "primary_message": "Return baking sheet to upper rack of the oven and bake until cheese is melted, 3-4 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 306720,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 306721,
      "primary_message": "Divide \"baked beans on toast\" between plates and serve with salad on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
