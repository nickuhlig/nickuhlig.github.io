      "id": 1,
      "primary_message": "Pour the whiskey, sweet vermouth, and bitters into a mixing glass or shaker filled with ice. Stir until outside of mixing glass is very cold to touch.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place a maraschino cherry in each of two chilled cocktail glasses. Dividing evenly, strain the contents of the mixing glass over cherries and serve immediately.",
      "secondary_message": null
    }
