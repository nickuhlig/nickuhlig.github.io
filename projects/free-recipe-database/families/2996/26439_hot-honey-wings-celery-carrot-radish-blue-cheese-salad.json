  "instructions": [
    {
      "id": 429379,
      "primary_message": "Preheat oven to 260°C (500°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 429380,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch and spices, then toss to coat. Transfer to the baking sheets and spread out in an even layer.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed\n2 tbsp cornstarch\n1 tbsp paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 429381,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. ",
      "secondary_message": null
    },
    {
      "id": 429382,
      "primary_message": "Meanwhile, place honey and hot sauce in a clean large bowl. Whisk to combine the hot honey and set aside.",
      "secondary_message": "⅓ cup honey\n3 tbsp hot sauce"
    },
    {
      "id": 429383,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 sticks celery\n6 medium carrots\n1 ½ bunches radish\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 429384,
      "primary_message": "Peel and mince shallots. Place in another large bowl along with oil, vinegar, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 shallots\n⅓ cup extra virgin olive oil\n¼ cup rice vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 429385,
      "primary_message": "Trim and thinly slice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 429386,
      "primary_message": "Peel and trim carrots; run the peeler along each carrot to make long, noodle-like strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 429387,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 429388,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl, along with blue cheese, and gently toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled blue cheese"
    },
    {
      "id": 429389,
      "primary_message": "When the wings are done, remove from the oven and add to the bowl with the hot honey. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 429390,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
