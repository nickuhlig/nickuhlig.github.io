  "instructions": [
    {
      "id": 429355,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 429356,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch and spices, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken wings, split with tips removed\n2 tsp cornstarch\n1 tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 429357,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 429358,
      "primary_message": "Meanwhile, place honey and hot sauce in a clean medium bowl. Whisk to combine the hot honey and set aside.",
      "secondary_message": "2 tbsp honey\n1 tbsp hot sauce"
    },
    {
      "id": 429359,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 sticks celery\n2 medium carrots\n½ bunch radish\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 429360,
      "primary_message": "Peel and mince shallot. Place in another medium bowl along with oil, vinegar, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "½ shallot\n2 tbsp extra virgin olive oil\n1 ½ tbsp rice vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 429361,
      "primary_message": "Trim and thinly slice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 429362,
      "primary_message": "Peel and trim carrots; run the peeler along each carrot to make long, noodle-like strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 429363,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 429364,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl, along with blue cheese, and gently toss to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 429365,
      "primary_message": "When the wings are done, remove from the oven and add to the bowl with the hot honey. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 429366,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
