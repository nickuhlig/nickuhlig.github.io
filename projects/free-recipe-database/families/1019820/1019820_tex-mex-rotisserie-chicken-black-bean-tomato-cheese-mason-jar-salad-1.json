  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 pint grape tomatoes\n1 heart romaine hearts"
    },
    {
      "primary_message": "Zest and juice lime into a small bowl, then add mayo, oil, honey, and spices. Whisk to combine the dressing and divide between 2 (quart-size) jars.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Peel and small dice shallot. Add to the jars with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "primary_message": "Drain and rinse beans in a colander. Add to the jars.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "primary_message": "Halve tomatoes lengthwise and add to the jars.",
      "secondary_message": null
    },
    {
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, then add to jars along with the cheese.",
      "secondary_message": "½ (30 oz) whole chicken rotisserie chicken, white and dark meat\n⅔ cup shredded cheese, Mexican blend"
    },
    {
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the jars, packing lightly if necessary.",
      "secondary_message": null
    },
    {
      "primary_message": "Screw lids onto jars and store in the fridge until needed. (Best if used within 2-3 days.)",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, empty jar into a bowl (making sure to scrape out all of the dressing!) and toss to combine the salad. Enjoy!",
      "secondary_message": null
    }
  ],
