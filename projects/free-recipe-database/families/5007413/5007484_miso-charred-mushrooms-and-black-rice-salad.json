  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Rinse the forbidden black rice. Grate the ginger. Wipe the Portobello mushroom caps clean. Juice the lime. Slice the Savoy cabbage into very thin strips. Very thinly slice the scallions. Mince the jalapeño. Chop the fresh cilantro leaves.",
      "secondary_message": "½ cup forbidden black rice\n2 tsp ginger root\n4 Portobello mushroom caps\n½ lime\n3 leaves Savoy cabbage\n2 scallions\n¼ jalapeño\n2 tbsp fresh cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "Bring a medium-large pot of salted water to a boil. Add the rice to the boiling salted water, and cook without a lid until tender, about 35 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, arrange a rack 15 to 20 cm below broiler element and pre-heat broiler to high. In a bowl, whisk together the miso, 2 tablespoons mirin, and fresh ginger. Slather the mushrooms, top and bottom, with the miso mixture. Place on a foil-lined rimmed baking sheet, and broil until tender and charred, turning once, about 20 minutes total. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisking together the rice vinegar, lime juice, soy sauce, remaining 1 teaspoon mirin, and sesame oil. Set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Once the rice has been cooking for 30 minutes, add the fresh edamame beans. When the rice has only one minute left to cook (it’s been boiling for 34 minutes), add the shredded cabbage. If using frozen edamame, add with the cabbage at the 34 minutes mark. Drain the rice, edamame, and cabbage all together in a fine-mesh colander. Drain and transfer to a large bowl. Toss with the dressing, jalapeño, cilantro, and sesame seeds.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Serve the rice salad with the mushrooms, thickly sliced, perched on top.",
      "secondary_message": null
    }
  ],
