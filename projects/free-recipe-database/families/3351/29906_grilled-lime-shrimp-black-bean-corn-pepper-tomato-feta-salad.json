  "instructions": [
    {
      "id": 476171,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 476172,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n4 tomatoes\n1 orange bell pepper\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 476173,
      "primary_message": "Zest limes into a medium bowl and set aside for later use. Juice limes into a large bowl, then add oil, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 tsp oregano, dried\n1 tsp garlic powder\n1 tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 476174,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 476175,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw, then add to the bowl and set aside.",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 476176,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 476177,
      "primary_message": "Add shrimp to the bowl with the lime zest, season with salt and pepper, then stir to coat.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 476178,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 476179,
      "primary_message": "While the pan heats up, thread shrimp onto the skewers and place on a plate. (If you don't have skewers, you can cook the shrimp directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 476180,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add skewers to the pan and cook, turning occasionally, until shrimp are cooked through, about 5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 476181,
      "primary_message": "Meanwhile, medium dice tomatoes. Add to the bowl with the beans and corn.",
      "secondary_message": null
    },
    {
      "id": 476182,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476183,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 476184,
      "primary_message": "To serve, divide shrimp skewers and salad between plates. Top salad with feta and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
