  "instructions": [
    {
      "id": 476185,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 476186,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n6 tomatoes\n1 ½ orange bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 476187,
      "primary_message": "Zest limes into a large bowl and set aside for later use. Juice limes into another large bowl, then add oil, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tbsp pure maple syrup\n1 ½ tsp oregano, dried\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 476188,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 476189,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw, then add to the bowl and set aside.",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 476190,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 476191,
      "primary_message": "Add shrimp to the bowl with the lime zest, season with salt and pepper, then stir to coat.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 476192,
      "primary_message": "Thread shrimp onto the skewers and place on a plate. (If you don't have skewers, you can cook the shrimp directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 476193,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 476194,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches, add skewers to the pan and cook, turning occasionally, until shrimp are cooked through, about 5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 476195,
      "primary_message": "Meanwhile, medium dice tomatoes. Add to the bowl with the beans and corn.",
      "secondary_message": null
    },
    {
      "id": 476196,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476197,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 476198,
      "primary_message": "To serve, divide shrimp skewers and salad between plates. Top salad with feta and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
