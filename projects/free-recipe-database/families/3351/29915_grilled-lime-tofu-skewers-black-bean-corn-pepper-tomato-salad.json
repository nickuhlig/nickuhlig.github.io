  "instructions": [
    {
      "id": 476297,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 476298,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 476299,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n4 tomatoes\n1 orange bell pepper\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 476300,
      "primary_message": "Zest limes into a medium bowl and set aside for later use. Juice limes into a large bowl, then add oil, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 tsp oregano, dried\n1 tsp garlic powder\n1 tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 476301,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 476302,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw, then add to the bowl and set aside.",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 476303,
      "primary_message": "Large dice tofu. Add to the bowl with the lime zest, along with soy sauce, salt, and pepper. Gently stir to coat.",
      "secondary_message": "2 tbsp soy sauce\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 476304,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 476305,
      "primary_message": "While the pan heats up, thread tofu onto the skewers and place on a plate. (If you don't have skewers, you can cook the tofu directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 476306,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add skewers to the pan and cook, turning occasionally, until tofu is charred and warmed through, about 8 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 476307,
      "primary_message": "Meanwhile, medium dice tomatoes. Add to the bowl with the beans and corn.",
      "secondary_message": null
    },
    {
      "id": 476308,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476309,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 476310,
      "primary_message": "To serve, divide tofu skewers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
