  "instructions": [
    {
      "id": 476563,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 476564,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 476565,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n6 tomatoes\n1 ½ orange bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 476566,
      "primary_message": "Zest limes into a large bowl and set aside for later use. Juice limes into another large bowl, then add oil, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tbsp pure maple syrup\n1 ½ tsp oregano, dried\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 476567,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 476568,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw, then add to the bowl and set aside.",
      "secondary_message": "4 ½ cups frozen corn"
    },
    {
      "id": 476569,
      "primary_message": "Large dice tofu. Add to the bowl with the lime zest, along with soy sauce, salt, and pepper. Gently stir to coat.",
      "secondary_message": "3 tbsp soy sauce\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 476570,
      "primary_message": "Thread tofu onto the skewers and place on a plate. (If you don't have skewers, you can cook the tofu directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 476571,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 476572,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches, add skewers to the pan and cook, turning occasionally, until tofu is charred and warmed through, about 8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 476573,
      "primary_message": "Meanwhile, medium dice tomatoes. Add to the bowl with the beans and corn.",
      "secondary_message": null
    },
    {
      "id": 476574,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476575,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 476576,
      "primary_message": "To serve, divide tofu skewers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
