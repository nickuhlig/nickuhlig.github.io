  "instructions": [
    {
      "id": 476493,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 476494,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 476495,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 tomatoes\n½ orange bell pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 476496,
      "primary_message": "Zest lime into a medium bowl and set aside for later use. Juice lime into another medium bowl, then add oil, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp pure maple syrup\n½ tsp oregano, dried\n½ tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 476497,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 476498,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw, then add to the bowl and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 476499,
      "primary_message": "Large dice tofu. Add to the bowl with the lime zest, along with soy sauce, salt, and pepper. Gently stir to coat.",
      "secondary_message": "1 tbsp soy sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 476500,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 476501,
      "primary_message": "While the pan heats up, thread tofu onto the skewers and place on a plate. (If you don't have skewers, you can cook the tofu directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 476502,
      "primary_message": "Once the pan is hot, coat with oil. Add skewers to the pan and cook, turning occasionally, until tofu is charred and warmed through, about 8 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 476503,
      "primary_message": "Meanwhile, medium dice tomatoes. Add to the bowl with the beans and corn.",
      "secondary_message": null
    },
    {
      "id": 476504,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476505,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 476506,
      "primary_message": "To serve, divide tofu skewers and salad between plates. Top salad with feta and enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
