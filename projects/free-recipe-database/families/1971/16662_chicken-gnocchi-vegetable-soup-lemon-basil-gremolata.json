  "instructions": [
    {
      "id": 271978,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n4 sticks celery\n1 small pkg fresh basil\n1 lemon"
    },
    {
      "id": 271979,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 271980,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add to the bowl with the carrot and celery.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 271981,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271982,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 271983,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies, chicken, and spices; cook, stirring occasionally, until the veggies start to soften and chicken is almost cooked through, about 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 271984,
      "primary_message": "Add broth to the pot, stir to combine, and bring to a boil.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
    },
    {
      "id": 271985,
      "primary_message": "Once the soup is boiling, reduce heat to medium, cover, and simmer until veggies are tender and chicken is cooked through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 271986,
      "primary_message": "Meanwhile, using a clean cutting board, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 271987,
      "primary_message": "Peel and mince additional garlic; add to the bowl with the basil.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 271988,
      "primary_message": "Zest and juice lemon into the bowl; add oil and stir to combine the gremolata. Set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 271989,
      "primary_message": "When the veggies and chicken and done, add gnocchi to the soup and continue to simmer, uncovered, until gnocchi start to float to the surface, about 4 minutes.",
      "secondary_message": "2 (16 oz) pkg potato gnocchi"
    },
    {
      "id": 271990,
      "primary_message": "To serve, divide soup between bowls and top with gremolata. Enjoy!",
      "secondary_message": null
    }
  ],
