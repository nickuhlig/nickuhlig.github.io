  "instructions": [
    {
      "id": 1,
      "primary_message": "In a mason jar or other glass container, thoroughly mix the starter and milk. Cover with a coffee filter or piece of cheese cloth (do not seal tightly with a lid) and leave to culture out of drafts at a warm room temperature (between 70-26°C or 21-26°C is recommended) until milk has clabbered (10-24 hours).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To test if the milk has thickened, tip the jar slightly. It should move away from the wall of the jar as a single mass. Just as with yogurt making, once the milk sets, it will get more tart the longer you allow the culturing to continue.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Refrigerate to halt culturing for at least 6 hours. Stir before using.",
      "secondary_message": null
    }
  ],
