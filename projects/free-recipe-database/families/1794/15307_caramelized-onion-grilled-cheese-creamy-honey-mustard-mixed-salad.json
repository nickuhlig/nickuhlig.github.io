  "instructions": [
    {
      "id": 252283,
      "primary_message": "Peel, halve, and thinly slice onions into half-moons.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 252284,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 252285,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until soft and caramelized, 15-20 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt"
    },
    {
      "id": 252286,
      "primary_message": "Meanwhile, place mayo, honey, water, and Dijon in a large bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n3 tbsp honey\n3 tbsp water\n1 tbsp Dijon mustard"
    },
    {
      "id": 252287,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n1 ½ red bell peppers\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 252288,
      "primary_message": "Trim ends of the cucumbers; quarter lengthwise, then slice crosswise into ¼-inch thick pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 252289,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 252290,
      "primary_message": "Grate mozzarella.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 252291,
      "primary_message": "When the onions are done, add vinegar to the pot, stir to combine, then remove from the heat.",
      "secondary_message": "1 ½ tbsp red wine vinegar"
    },
    {
      "id": 252292,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 252293,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Evenly top half of the slices with the onions and mozzarella. Cover the sandwiches with the remaining bread slices.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 252294,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Cooking in batches if necessary, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 252295,
      "primary_message": "While the sandwiches are cooking, chop the lettuce into bite-sized pieces and transfer to the bowl with the dressing and veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 252296,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet; return the sandwiches to the skillet, browned-side-up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes. Once done, transfer to a cutting board and slice in half.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 252297,
      "primary_message": "To serve, divide the salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
