  "instructions": [
    {
      "id": 252208,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 252209,
      "primary_message": "Peel, halve, and thinly slice onion into half-moons.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 252210,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until soft and caramelized, 15-20 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 252211,
      "primary_message": "Meanwhile, place mayo, honey, water, and Dijon in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp honey\n1 tbsp water\n1 tsp Dijon mustard"
    },
    {
      "id": 252212,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n½ red bell pepper\n1 head butter (Boston) lettuce"
    },
    {
      "id": 252213,
      "primary_message": "Trim ends of the cucumber; quarter lengthwise, then slice crosswise into ¼-inch thick pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 252214,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 252215,
      "primary_message": "Grate mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 252216,
      "primary_message": "When the onions are done, add vinegar and Worcestershire to the pan, stir to combine, then remove from the heat.",
      "secondary_message": "1 ½ tsp red wine vinegar\n½ tsp Worcestershire sauce"
    },
    {
      "id": 252217,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 252218,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Evenly top half of the slices with the onions and mozzarella. Cover the sandwiches with the remaining bread slices.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 252219,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "1 ½ tsp butter, unsalted"
    },
    {
      "id": 252220,
      "primary_message": "While the sandwiches are cooking, chop the lettuce into bite-sized pieces and transfer to the bowl with the dressing and veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 252221,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet; return sandwiches to the skillet, browned-side-up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Once done, transfer to a cutting board and slice in half.",
      "secondary_message": "1 ½ tsp butter, unsalted"
    },
    {
      "id": 252222,
      "primary_message": "To serve, divide the salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
