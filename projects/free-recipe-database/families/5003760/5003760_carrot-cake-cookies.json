  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Grate the carrots. Chop the walnuts.",
      "secondary_message": "8 tbsp unsalted butter\n1 cup carrots\n½ cup walnuts"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together flour, cinnamon, nutmeg, cardamom, baking powder, baking soda, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, beat together butter and brown sugar with a wooden spoon until fluffy, about 3 minutes. Beat in egg and vanilla. Add dry ingredients to the bowl and beat until just combined. Stir in carrots, raisins, oats, and walnuts until evenly distributed throughout the dough. Cover dough with plastic wrap and let chill in refrigerator for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven rack to upper and middles position and preheat oven to 350°F. Place sugar in a shallow bowl. Take a heaping teaspoon of dough and roll into a ball. Gently roll ball in sugar then place on baking sheet. Repeat with remaining dough. Bake cookies until golden, 15-17 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Let cookies cool for 10 minutes on the baking sheet before transferring to a wire rack to finish cooling. Let cookies cool completely before eating.",
      "secondary_message": null
    }
  ],
