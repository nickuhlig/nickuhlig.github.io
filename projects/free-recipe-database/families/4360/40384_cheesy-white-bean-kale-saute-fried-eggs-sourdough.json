  "instructions": [
    {
      "id": 625375,
      "primary_message": "Wash, dry, and halve grape tomatoes. Place in a medium bowl. ",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 625376,
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl with the tomato.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 625377,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 625378,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 625379,
      "primary_message": "While the pot heats up, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 625380,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies, beans, and spices; cook, stirring occasionally, until veggies are softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp butter, unsalted\n1 tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 625381,
      "primary_message": "Meanwhile, coarsely grate cheddar. Place in the reserved bowl and set aside.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 625382,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 625383,
      "primary_message": "When the veggies are soft, add kale to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Add cheese and stir to combine. Continue to cook, stirring occasionally, until the kale is fully wilted and cheese is melted, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 625384,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 625385,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat, then season with salt and pepper.",
      "secondary_message": "2 tsp butter, unsalted\n8 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 625386,
      "primary_message": "Meanwhile, toast bread if desired.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 625387,
      "primary_message": "To serve, divide bean-kale sauté, eggs, and bread between plates. Enjoy!",
      "secondary_message": null
    }
  ],
