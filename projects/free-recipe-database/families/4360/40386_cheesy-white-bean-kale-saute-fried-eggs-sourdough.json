  "instructions": [
    {
      "id": 625401,
      "primary_message": "Wash, dry, and halve grape tomatoes. Place in a medium bowl. ",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 625402,
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl with the tomato.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 625403,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 625404,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 625405,
      "primary_message": "While the pan heats up, drain and rinse beans.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 625406,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add veggies, beans, and spices; cook, stirring occasionally, until veggies are softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 625407,
      "primary_message": "Meanwhile, coarsely grate cheddar. Place in the reserved bowl and set aside.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 625408,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces.",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 625409,
      "primary_message": "When the veggies are soft, add kale to the pan in handfuls, waiting for it to wilt slightly before adding the next handful. Add cheese and stir to combine. Continue to cook, stirring occasionally, until the kale is fully wilted and cheese is melted, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 625410,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 625411,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat, then season with salt and pepper.",
      "secondary_message": "1 tsp butter, unsalted\n4 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 625412,
      "primary_message": "Meanwhile, toast bread if desired.",
      "secondary_message": "2 slices sourdough bread"
    },
    {
      "id": 625413,
      "primary_message": "To serve, divide bean-kale sauté, eggs, and bread between plates. Enjoy!",
      "secondary_message": null
    }
  ],
