  "instructions": [
    {
      "id": 98440,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 98441,
      "primary_message": "Trim off the root ends and the dark green top of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice into thick pieces and then roughly chop.",
      "secondary_message": "3 leeks"
    },
    {
      "id": 98442,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 98443,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 98444,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 98445,
      "primary_message": "Add the leeks and garlic to the pot. Cook until the leeks begin to soften, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 98446,
      "primary_message": "Wash and roughly chop the spinach leaves.",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 98447,
      "primary_message": "Add the spinach to the pot and season with salt and pepper; cook, tossing, until the spinach has wilted, 1 to 2 minutes.",
      "secondary_message": "¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 98448,
      "primary_message": "Split the vegetable mixture between six small baking dishes. Top each with 3 tbsp of cream.",
      "secondary_message": "266 ml heavy cream"
    },
    {
      "id": 98449,
      "primary_message": "Gently crack one egg into the center of each dish.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 98450,
      "primary_message": "Place in the oven and bake for 15-20 minutes, checking periodically, until the whites of the egg have cooked through.",
      "secondary_message": null
    },
    {
      "id": 98451,
      "primary_message": "Remove from the oven and top with thyme and red pepper flakes. Enjoy!",
      "secondary_message": "3 pinch thyme\n3 pinch crushed red pepper"
    }
  ],
