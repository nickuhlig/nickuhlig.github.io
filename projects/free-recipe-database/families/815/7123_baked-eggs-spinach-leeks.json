  "instructions": [
    {
      "id": 98428,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 98429,
      "primary_message": "Trim off the root ends and the dark green top of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice into thick pieces and then roughly chop.",
      "secondary_message": "2 leeks"
    },
    {
      "id": 98430,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 98431,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 98432,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 98433,
      "primary_message": "Add the leeks and garlic to the skillet. Cook until the leeks begin to soften, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 98434,
      "primary_message": "Wash and roughly chop the spinach leaves.",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 98435,
      "primary_message": "Add the spinach to the skillet and season with salt and pepper; cook, tossing, until the spinach has wilted, 2-3 minutes.",
      "secondary_message": "½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 98436,
      "primary_message": "Split the vegetable mixture between four small baking dishes. Top each with 3 tbsp of cream.",
      "secondary_message": "177 ml heavy cream"
    },
    {
      "id": 98437,
      "primary_message": "Gently crack one egg into the center of each dish.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 98438,
      "primary_message": "Place in the oven and bake for 15-20 minutes, checking periodically, until the whites of the egg have cooked through.",
      "secondary_message": null
    },
    {
      "id": 98439,
      "primary_message": "Remove from the oven and top with thyme and red pepper flakes. Enjoy!",
      "secondary_message": "⅛ tsp thyme\n⅛ tsp crushed red pepper"
    }
  ],
