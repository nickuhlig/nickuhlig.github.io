  "instructions": [
    {
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the water is boiling, add noodles and salt; cook until noodles are tender, about 5 minutes. Once done, drain and rinse thoroughly under cold water; set aside.",
      "secondary_message": "142 g soba (buckwheat) noodles\n¼ tsp salt"
    },
    {
      "primary_message": "Meanwhile, divide peanut sauce and sesame seeds between 2 (quart-size) jars.",
      "secondary_message": "½ cup peanut sauce\n2 tsp sesame seeds"
    },
    {
      "primary_message": "Add shredded cabbage to the jars with the peanut sauce and sesame seeds, packing gently.",
      "secondary_message": "½ (397 g) bag shredded cabbage (coleslaw mix)"
    },
    {
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost. Pat dry with paper towels and add to the jars.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and seed bell pepper; medium dice. Add to the jars along with the cooled soba noodles.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "primary_message": "Screw lids onto jars and store in the fridge until needed. (Best if used within 2-3 days.)",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, empty jar into a bowl (making sure to scrape out all of the dressing!) and toss to combine the salad. Enjoy!",
      "secondary_message": null
    }
  ],
