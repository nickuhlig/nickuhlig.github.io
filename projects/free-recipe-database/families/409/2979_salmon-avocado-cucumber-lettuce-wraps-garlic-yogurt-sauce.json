  "instructions": [
    {
      "id": 29241,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 head butter (Boston) lettuce\n½ English cucumber\n1 avocado\n½ lemon\n½ small bunch green onions (scallions)"
    },
    {
      "id": 29243,
      "primary_message": "Trim and discard the ends of the cucumber; halve the cucumber lengthwise, then thinly slice crosswise on an angle. Transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 29242,
      "primary_message": "Halve and pit the avocado; scoop out the flesh and thinly slice crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 29245,
      "primary_message": "Juice the lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 29244,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 29246,
      "primary_message": "Place the salmon on a plate; drizzle with ½ of the lemon juice (save the rest for the sauce), and season with salt and pepper.",
      "secondary_message": "¾ lb salmon fillet\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 29274,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 29247,
      "primary_message": "Place the salmon in the skillet; cook until it is opaque and cooked through, 3 to 5 minutes per side (depending on the thickness). Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 29248,
      "primary_message": "Separate the lettuce into leaves and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 29253,
      "primary_message": "Trim and discard the root ends of the green onions; chop the onions into ¼-inch pieces. Add about ½ of the onions to the bowl with the remaining lemon juice and the other ½ to the large bowl.",
      "secondary_message": ""
    },
    {
      "id": 29249,
      "primary_message": "Peel and mince the garlic; add to the small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 29250,
      "primary_message": "Add yogurt, olive oil, salt, and pepper to the small bowl and mix together.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 29251,
      "primary_message": "Using your hands or a fork, flake the salmon and add to the large bowl. Toss the ingredients together.",
      "secondary_message": null
    },
    {
      "id": 29252,
      "primary_message": "To serve, make the lettuce wraps by spooning the salmon mixture into the lettuce leaves, then topping with the yogurt sauce. Enjoy!",
      "secondary_message": null
    }
  ],
