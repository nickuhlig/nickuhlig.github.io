  "instructions": [
    {
      "id": 431614,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "½ tsp salt\n9 oz cheese ravioli, fresh or frozen"
    },
    {
      "id": 431615,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431616,
      "primary_message": "While the skillet heats up, wash, dry, and remove stems from portobello mushrooms; slice into ¼-inch thick strips.",
      "secondary_message": "2 caps portobello mushrooms"
    },
    {
      "id": 431617,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add sliced portobello and white mushrooms to the skillet along with salt and pepper; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n1 (8 oz) pkg sliced white mushrooms\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 431618,
      "primary_message": "Meanwhile, wash, dry, and chop chives into small pieces. Place in a small bowl along with miso paste, water, and chili-garlic sauce. Whisk to combine the sauce and set aside.",
      "secondary_message": "½ small pkg chives\n2 tbsp miso paste, white\n2 tbsp water\n2 tsp chili-garlic sauce"
    },
    {
      "id": 431619,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 431620,
      "primary_message": "When the mushrooms are soft, add beans to the skillet and cook, stirring occasionally, until warmed through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 431621,
      "primary_message": "Add drained ravioli, miso sauce, and more butter to the skillet. Stir until butter is melted and pasta is coated in sauce, about 1 minute; remove from heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 431622,
      "primary_message": "To serve, divide ravioli, beans, and mushrooms between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
