  "instructions": [
    {
      "id": 431605,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n27 oz cheese ravioli, fresh or frozen"
    },
    {
      "id": 431606,
      "primary_message": "Meanwhile, wash, dry, and remove stems from portobello mushrooms; slice into ¼-inch thick strips.",
      "secondary_message": "6 caps portobello mushrooms"
    },
    {
      "id": 431607,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431608,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add sliced portobello and white mushrooms to the pot along with salt and pepper; cook, stirring occasionally, until starting to soften, 5-6 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n3 (8 oz) pkgs sliced white mushrooms\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 431609,
      "primary_message": "Meanwhile, wash, dry, and chop chives into small pieces. Place in a small bowl along with miso paste, water, and chili-garlic sauce. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 small pkg chives\n⅓ cup miso paste, white\n⅓ cup water\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 431610,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 431611,
      "primary_message": "When the mushrooms are soft, add shrimp to the pot and cook, stirring occasionally, until the shrimp are opaque and cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 431612,
      "primary_message": "Add drained ravioli, miso sauce, and more butter to the pot. Stir until butter is melted and pasta is coated in sauce, 1-2 minutes; remove from heat.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 431613,
      "primary_message": "To serve, divide ravioli, shrimp, and mushrooms between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
