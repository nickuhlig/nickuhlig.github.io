  "instructions": [
    {
      "id": 431596,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "1 tsp salt\n18 oz cheese ravioli, fresh or frozen"
    },
    {
      "id": 431597,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431598,
      "primary_message": "While the skillet heats up, wash, dry, and remove stems from portobello mushrooms; slice into ¼-inch thick strips.",
      "secondary_message": "4 caps portobello mushrooms"
    },
    {
      "id": 431599,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add sliced portobello and white mushrooms to the skillet along with salt and pepper; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n2 (8 oz) pkgs sliced white mushrooms\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 431600,
      "primary_message": "Meanwhile, wash, dry, and chop chives into small pieces. Place in a small bowl along with miso paste, water, and chili-garlic sauce. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 small pkg chives\n¼ cup miso paste, white\n¼ cup water\n4 tsp chili-garlic sauce"
    },
    {
      "id": 431601,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 431602,
      "primary_message": "When the mushrooms are soft, add shrimp to the skillet and cook, stirring occasionally, until the shrimp are opaque and cooked through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 431603,
      "primary_message": "Add drained ravioli, miso sauce, and more butter to the skillet. Stir until butter is melted and pasta is coated in sauce, about 1 minute; remove from heat.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 431604,
      "primary_message": "To serve, divide ravioli, shrimp, and mushrooms between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
