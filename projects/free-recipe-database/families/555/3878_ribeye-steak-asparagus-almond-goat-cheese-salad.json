  "instructions": [
    {
      "id": 43021,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n½ lemon"
    },
    {
      "id": 43022,
      "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears into 5-cm pieces at an angle. Transfer to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 43023,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 43024,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 43025,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "0.34 kg ribeye steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 43026,
      "primary_message": "Once the skillet is hot, add the almonds. Cook, stirring frequently to avoid burning, until fragrant and lightly toasted, 3 to 4 minutes. Once done, transfer to a small bowl.",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "id": 43027,
      "primary_message": "Once the almonds have been transferred, increase the heat to medium-high. Add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 43028,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 43029,
      "primary_message": "Once the water in the saucepan is boiling, uncover and season with salt. Add the asparagus and cook until bright green, 2 to 4 minutes (depending on the thickness of the spears). Drain in a colander and run under cold water to stop the cooking process. Set aside to drain further.",
      "secondary_message": "1 tbsp salt"
    },
    {
      "id": 43030,
      "primary_message": "Grate all of the zest from the lemon, then juice it. Add the zest and juice to the bowl that held the asparagus.",
      "secondary_message": ""
    },
    {
      "id": 43031,
      "primary_message": "To the lemon zest and juice, add olive oil, Dijon, salt, and pepper; whisk together.",
      "secondary_message": "½ tbsp extra virgin olive oil\n¼ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 43032,
      "primary_message": "Add the asparagus to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 43033,
      "primary_message": "Crumble goat cheese into a small bowl.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 43034,
      "primary_message": "To serve, divide the steak and asparagus between plates, then top the asparagus with the crumbled goat cheese and toasted almonds.",
      "secondary_message": null
    }
  ],
