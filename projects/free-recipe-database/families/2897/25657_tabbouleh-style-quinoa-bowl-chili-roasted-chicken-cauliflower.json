  "instructions": [
    {
      "id": 410588,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 410589,
      "primary_message": "In a small saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 410590,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces. Transfer to a baking sheet pan along with the cauliflower. Drizzle with oil and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n1 (283 g) bag cauliflower florets\n1 tbsp extra virgin olive oil\n2 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 410591,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is tender and chicken is cooked through, 15-18 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 410592,
      "primary_message": "While the chicken and cauliflower are cooking, wash and dry the fresh produce. ",
      "secondary_message": "½ small pkg fresh mint\n½ English cucumber\n2 tomatoes"
    },
    {
      "id": 410593,
      "primary_message": "Using a clean cutting board, pick mint leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 410594,
      "primary_message": "Trim and small dice cucumber. Add to the bowl with the mint. ",
      "secondary_message": null
    },
    {
      "id": 410595,
      "primary_message": "Small dice tomatoes. Add to the bowl along with the vinaigrette, salt, and pepper; set aside. ",
      "secondary_message": "3 tbsp French vinaigrette\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 410596,
      "primary_message": "Transfer the cooked quinoa to another baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410597,
      "primary_message": "Add cooled quinoa to the bowl with the veggies and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 410598,
      "primary_message": "To serve, divide quinoa salad, chicken, and cauliflower between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
