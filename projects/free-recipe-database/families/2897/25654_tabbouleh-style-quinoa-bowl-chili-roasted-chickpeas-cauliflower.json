  "instructions": [
    {
      "id": 410555,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 410556,
      "primary_message": "In a small saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 410557,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Transfer to a baking sheet pan along with the cauliflower. Drizzle with oil and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)\n1 (10 oz) bag cauliflower florets\n1 tbsp extra virgin olive oil\n2 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 410558,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is tender and chickpeas are crispy, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 410559,
      "primary_message": "While the chickpeas and cauliflower are roasting, wash and dry the fresh produce. ",
      "secondary_message": "½ small pkg fresh mint\n½ English cucumber\n2 tomatoes"
    },
    {
      "id": 410560,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 410561,
      "primary_message": "Trim and small dice cucumber. Add to the bowl with the mint. ",
      "secondary_message": null
    },
    {
      "id": 410562,
      "primary_message": "Small dice tomatoes. Add to the bowl along with the vinaigrette, salt, and pepper; set aside. ",
      "secondary_message": "3 tbsp French vinaigrette\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 410563,
      "primary_message": "Transfer the cooked quinoa to another baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410564,
      "primary_message": "Add cooled quinoa to the bowl with the veggies and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 410565,
      "primary_message": "To serve, divide quinoa salad, chickpeas, and cauliflower between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
