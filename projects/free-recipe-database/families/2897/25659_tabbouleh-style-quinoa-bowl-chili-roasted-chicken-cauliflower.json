  "instructions": [
    {
      "id": 410610,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 410611,
      "primary_message": "In a medium saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n3 cup water\n½ tsp salt"
    },
    {
      "id": 410612,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces. Divide chicken and cauliflower between two large baking sheet pans. Drizzle with oil and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n3 (283 g) bags cauliflower florets\n3 tbsp extra virgin olive oil\n2 tbsp chili powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 410613,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is tender and chicken is cooked through, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 410614,
      "primary_message": "While the chicken and cauliflower are cooking, wash and dry the fresh produce. ",
      "secondary_message": "1 small pkg fresh mint\n1 ½ English cucumbers\n6 tomatoes"
    },
    {
      "id": 410615,
      "primary_message": "Using a clean cutting board, pick mint leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 410616,
      "primary_message": "Trim and small dice cucumbers. Add to the bowl with the mint. ",
      "secondary_message": null
    },
    {
      "id": 410617,
      "primary_message": "Small dice tomatoes. Add to the bowl along with the vinaigrette, salt, and pepper; set aside. ",
      "secondary_message": "½ cup French vinaigrette\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 410618,
      "primary_message": "Transfer the cooked quinoa to another large baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410619,
      "primary_message": "Add cooled quinoa to the bowl with the veggies and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 410620,
      "primary_message": "To serve, divide quinoa salad, chicken, and cauliflower between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
