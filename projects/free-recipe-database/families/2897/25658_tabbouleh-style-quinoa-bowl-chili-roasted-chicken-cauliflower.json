  "instructions": [
    {
      "id": 410599,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 410600,
      "primary_message": "In a medium saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 410601,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces. Transfer to a large baking sheet pan along with the cauliflower. Drizzle with oil and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n2 (283 g) bags cauliflower florets\n2 tbsp extra virgin olive oil\n4 tsp chili powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 410602,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is tender and chicken is cooked through, 15-18 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 410603,
      "primary_message": "While the chicken and cauliflower are cooking, wash and dry the fresh produce. ",
      "secondary_message": "1 small pkg fresh mint\n1 English cucumber\n4 tomatoes"
    },
    {
      "id": 410604,
      "primary_message": "Using a clean cutting board, pick mint leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 410605,
      "primary_message": "Trim and small dice cucumber. Add to the bowl with the mint. ",
      "secondary_message": null
    },
    {
      "id": 410606,
      "primary_message": "Small dice tomatoes. Add to the bowl along with the vinaigrette, salt, and pepper; set aside. ",
      "secondary_message": "⅓ cup French vinaigrette\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 410607,
      "primary_message": "Transfer the cooked quinoa to another large baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410608,
      "primary_message": "Add cooled quinoa to the bowl with the veggies and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 410609,
      "primary_message": "To serve, divide quinoa salad, chicken, and cauliflower between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
