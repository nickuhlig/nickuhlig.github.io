  "instructions": [
    {
      "id": 273519,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium yellow potatoes\n1 crown broccoli\n1 leek\n½ (142 g) pkg baby spinach\n½ lemon"
    },
    {
      "id": 273520,
      "primary_message": "Peel and mince garlic; place in a small bowl along with butter and salt. Mash with the back of a spoon to combine the garlic butter; set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp butter, unsalted\n⅛ tsp salt"
    },
    {
      "id": 273521,
      "primary_message": "Peel and small dice potatoes; separate broccoli into small florets and small dice the stems. Place both in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 273522,
      "primary_message": "Trim off the root end and dark green top of the leek, leaving only the white and pale green parts. Cut in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. ",
      "secondary_message": null
    },
    {
      "id": 273523,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 273524,
      "primary_message": "Once the pan is hot, add half of the garlic butter (reserving the rest for the garlic bread) and swirl to coat the bottom. Add the leek and cook, stirring often, until starting to soften, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 273525,
      "primary_message": "Add broccoli, potato, and flour to the pan; stir to combine. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp all-purpose flour"
    },
    {
      "id": 273526,
      "primary_message": "Gradually stir broth, milk, and spices into the pan. Cover and bring to a boil over high heat; once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, about 10 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n355 ml whole milk\n¾ tsp salt\n¼ tsp black pepper\n¼ tsp rosemary, dried"
    },
    {
      "id": 273527,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 273528,
      "primary_message": "Finely grate Parmesan and add to the bowl with the spinach; set aside.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 273529,
      "primary_message": "Slice lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 273530,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 273531,
      "primary_message": "Once the veggies are tender, use a potato masher to crush the potatoes and broccoli, creating a semi-smooth soup. ",
      "secondary_message": null
    },
    {
      "id": 273532,
      "primary_message": "Add spinach and Parmesan to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to stir until cheese is melted and combined, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 273533,
      "primary_message": "Slice rolls in half and place on a baking sheet pan, cut-side up; spread with remaining garlic butter. Place in the oven and broil until lightly toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 273534,
      "primary_message": "Divide soup between bowls and sprinkle with crushed red pepper. Serve with garlic bread and lemon wedges for squeezing over top. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
