  "instructions": [
    {
      "id": 273487,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 medium yellow potatoes\n2 crowns broccoli\n2 leeks\n1 (5 oz) pkg baby spinach\n1 lemon"
    },
    {
      "id": 273488,
      "primary_message": "Peel and mince garlic; place in a small bowl along with butter and salt. Mash with the back of a spoon to combine the garlic butter; set aside.",
      "secondary_message": "6 cloves garlic\n⅓ cup butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 273489,
      "primary_message": "Peel and small dice potatoes; separate broccoli into small florets and small dice the stems. Place both in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 273490,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. ",
      "secondary_message": null
    },
    {
      "id": 273491,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 273492,
      "primary_message": "Once the pot is hot, add half of the garlic butter (reserving the rest for the garlic bread) and swirl to coat the bottom. Add the leek and cook, stirring often, until starting to soften, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 273493,
      "primary_message": "Add broccoli, potato, and flour to the pot; stir to combine. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 273494,
      "primary_message": "Gradually stir broth, milk, and spices into the pot. Cover and bring to a boil over high heat; once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, about 10 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n24 fl oz (3 cups) whole milk\n1 ½ tsp salt\n½ tsp black pepper\n½ tsp rosemary, dried"
    },
    {
      "id": 273495,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 273496,
      "primary_message": "Finely grate Parmesan and add to the bowl with the spinach; set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 273497,
      "primary_message": "Slice lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 273498,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 273499,
      "primary_message": "Once the veggies are tender, use a potato masher to crush the potatoes and broccoli, creating a semi-smooth soup. ",
      "secondary_message": null
    },
    {
      "id": 273500,
      "primary_message": "Add spinach and Parmesan to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to stir until cheese is melted and combined, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 273501,
      "primary_message": "Slice rolls in half and place on a large baking sheet pan, cut-side up; spread with remaining garlic butter. Place in the oven and broil until lightly toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 273502,
      "primary_message": "Divide soup between bowls and sprinkle with crushed red pepper. Serve with garlic bread and lemon wedges for squeezing over top. Enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
