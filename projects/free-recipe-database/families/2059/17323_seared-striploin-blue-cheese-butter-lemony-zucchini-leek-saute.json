  "instructions": [
    {
      "id": 282254,
      "primary_message": "Place blue cheese, butter, and thyme in a small bowl; set aside to soften.",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese\n⅓ cup butter, unsalted\n¾ tsp thyme, dried"
    },
    {
      "id": 282255,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 leeks\n6 medium zucchini squash\n1 ½ lemons"
    },
    {
      "id": 282256,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 282257,
      "primary_message": "Peel and mince garlic; add to the bowl with the leek and set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 282258,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 282259,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 282260,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 282261,
      "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons.",
      "secondary_message": null
    },
    {
      "id": 282262,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 282263,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add the leek, garlic, and spices; sauté until soft and golden, 4-5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 282264,
      "primary_message": "Add zucchini and water to the pot; continue to cook, stirring occasionally, until the liquid is evaporated and zucchini is fork-tender, 6 minutes more.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 282265,
      "primary_message": "While the zucchini is cooking, gently mash the softened butter, blue cheese, and thyme with the back of a spoon to combine.",
      "secondary_message": null
    },
    {
      "id": 282266,
      "primary_message": "When the zucchini is done, juice lemons into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 282267,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 282268,
      "primary_message": "To serve, divide steak and veggie sauté between plates; top steak with blue cheese butter and enjoy!",
      "secondary_message": null
    }
  ],
