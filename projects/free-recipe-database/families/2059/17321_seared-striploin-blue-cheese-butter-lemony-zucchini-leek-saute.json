  "instructions": [
    {
      "id": 282226,
      "primary_message": "Place blue cheese, butter, and thyme in a small bowl; set aside to soften.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese\n2 tbsp butter, unsalted\n¼ tsp thyme, dried"
    },
    {
      "id": 282227,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 leek\n2 medium zucchini squash\n½ lemon"
    },
    {
      "id": 282228,
      "primary_message": "Trim off the root end and dark green top of the leek, leaving only the white and pale green parts. Cut the leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in another small bowl.",
      "secondary_message": null
    },
    {
      "id": 282229,
      "primary_message": "Peel and mince garlic; add to the bowl with the leek and set aside.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 282230,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 282231,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 282232,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 282233,
      "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons.",
      "secondary_message": null
    },
    {
      "id": 282234,
      "primary_message": "When the steak is done, return the skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add the leek, garlic, and spices; sauté until soft and golden, 3-4 minutes.",
      "secondary_message": "1 tsp butter, unsalted\n¼ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 282235,
      "primary_message": "Add zucchini and water to the skillet; continue to cook, stirring occasionally, until the liquid is evaporated and zucchini is fork-tender, 5 minutes more.",
      "secondary_message": "3 tbsp water"
    },
    {
      "id": 282236,
      "primary_message": "While the zucchini is cooking, gently mash the softened butter, blue cheese, and thyme with the back of a spoon to combine.",
      "secondary_message": null
    },
    {
      "id": 282237,
      "primary_message": "When the zucchini is done, juice lemon into the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 282238,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 282239,
      "primary_message": "To serve, divide steak and veggie sauté between plates; top steak with blue cheese butter and enjoy!",
      "secondary_message": null
    }
  ],
