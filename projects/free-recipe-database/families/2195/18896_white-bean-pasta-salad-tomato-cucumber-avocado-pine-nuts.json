  "instructions": [
    {
      "id": 310984,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool; set aside.",
      "secondary_message": "½ tsp salt\n142 g rotini pasta"
    },
    {
      "id": 310985,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small pkg grape tomatoes\n½ English cucumber\n½ avocado"
    },
    {
      "id": 310986,
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 310987,
      "primary_message": "Peel and mince shallot; add to the bowl with the lemon juice.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 310988,
      "primary_message": "Add mayo and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp vegan mayonnaise\n½ tsp basil, dried\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 310989,
      "primary_message": "Quarter tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 310990,
      "primary_message": "Trim and small dice cucumber; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 310991,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 310992,
      "primary_message": "Drain and rinse beans, then add to the bowl.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 310993,
      "primary_message": "Add cooked pasta and pine nuts to the bowl, then stir to combine the pasta salad.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 310994,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
