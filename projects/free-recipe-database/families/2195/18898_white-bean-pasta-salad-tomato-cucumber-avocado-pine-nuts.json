  "instructions": [
    {
      "id": 311006,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool; set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 311007,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ small pkgs grape tomatoes\n1 ½ English cucumbers\n1 ½ avocados"
    },
    {
      "id": 311008,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 311009,
      "primary_message": "Peel and mince shallots; add to the bowl with the lemon juice.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 311010,
      "primary_message": "Add mayo and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup vegan mayonnaise\n1 ½ tsp basil, dried\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 311011,
      "primary_message": "Quarter tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 311012,
      "primary_message": "Trim and small dice cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 311013,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 311014,
      "primary_message": "Drain and rinse beans, then add to the bowl.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 311015,
      "primary_message": "Add cooked pasta and pine nuts to the bowl, then stir to combine the pasta salad.",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 311016,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
