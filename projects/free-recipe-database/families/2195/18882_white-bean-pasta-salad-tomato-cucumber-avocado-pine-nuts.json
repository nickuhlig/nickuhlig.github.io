  "instructions": [
    {
      "id": 310830,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool; set aside.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 310831,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 pint grape tomatoes\n1 English cucumber\n1 avocado"
    },
    {
      "id": 310832,
      "primary_message": "Juice lemon into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 310833,
      "primary_message": "Peel and mince shallot; add to the bowl with the lemon juice.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 310834,
      "primary_message": "Add mayo and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp basil, dried\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 310835,
      "primary_message": "Quarter tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 310836,
      "primary_message": "Trim and small dice cucumber; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 310837,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 310838,
      "primary_message": "Drain and rinse beans, then add to the bowl.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 310839,
      "primary_message": "Add cooked pasta and pine nuts to the bowl, then stir to combine the pasta salad.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 310840,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
