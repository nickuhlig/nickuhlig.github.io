  "instructions": [
    {
      "id": 205908,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 205909,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 205910,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n3 medium zucchini squash\n1 ½ limes"
    },
    {
      "id": 205911,
      "primary_message": "Snap or cut off the woody ends of the asparagus and cut into 2-inch pieces. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 205912,
      "primary_message": "Trim and cut the zucchini crosswise into thin rounds; divide between baking sheets. Drizzle veggies with oil, season with spices, and toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp cumin\n¾ tsp turmeric\n¾ tsp cinnamon\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 205913,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until veggies are fork-tender, 18-20 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 205914,
      "primary_message": "Meanwhile, zest and juice limes into a medium bowl. Add mayo and spices; whisk to combine the sauce.",
      "secondary_message": "½ cup vegan mayonnaise\n1 tbsp curry powder\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 205915,
      "primary_message": "Coarsely chop pistachios and place in another medium bowl along with the raisins.",
      "secondary_message": "1 ½ cups pistachios, unsalted\n¾ cup raisins"
    },
    {
      "id": 205916,
      "primary_message": "Medium dice apricots and add to the bowl with the pistachios; stir to combine.",
      "secondary_message": "18 dried apricots"
    },
    {
      "id": 205917,
      "primary_message": "To serve, divide quinoa between bowls and top with roasted veggies; sprinkle with fruit and nut mix. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
