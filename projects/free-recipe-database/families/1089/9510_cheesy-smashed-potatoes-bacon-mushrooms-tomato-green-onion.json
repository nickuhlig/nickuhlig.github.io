  "instructions": [
    {
      "id": 151831,
      "primary_message": "Wash potatoes; transfer to a large pot, add salt, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, about 15 minutes.",
      "secondary_message": "3 lb new potatoes\n2 tsp salt"
    },
    {
      "id": 151832,
      "primary_message": "Meanwhile, preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 151833,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 151834,
      "primary_message": "Add bacon to the skillet and cook until crispy, 3-5 minutes per side. Cook in batches if necessary.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 151835,
      "primary_message": "Meanwhile, grate the cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 151836,
      "primary_message": "Wash and dry the remaining fresh produce.",
      "secondary_message": "1 lb white mushrooms\n1 small bunch green onions (scallions)\n2 tomatoes"
    },
    {
      "id": 151837,
      "primary_message": "Thinly slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 151838,
      "primary_message": "When the bacon is done, remove and set aside on a paper towel-lined plate. Transfer the bacon fat to a small bowl and set aside, leaving about 2 tsp in the skillet.",
      "secondary_message": null
    },
    {
      "id": 151839,
      "primary_message": "Return skillet to medium heat. Add mushrooms and season with salt and pepper. Cook, stirring often, until tender, 3-4 minutes; remove from heat and set aside.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 151840,
      "primary_message": "Crumble or chop bacon into small pieces.",
      "secondary_message": null
    },
    {
      "id": 151841,
      "primary_message": "When the potatoes are done, drain and transfer to a large baking sheet pan. Using a fork or potato masher, gently crush each potato, flattening them to a 1-inch thickness. Drizzle with 3 tbsp reserved bacon fat and season with salt and pepper; toss to coat.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 151842,
      "primary_message": "Sprinkle cheese, mushrooms, and bacon over the potatoes. Place in the oven and bake until cheese is melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 151843,
      "primary_message": "Meanwhile, trim off and discard ends of green onions, then cut crosswise into ¼-inch pieces at an angle. Small dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 151844,
      "primary_message": "To serve, divide smashed potatoes between plates or bowls. Top with green onion, tomato, and yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
