  "instructions": [
    {
      "id": 151870,
      "primary_message": "Wash potatoes; transfer to a large pot, add salt, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, about 15 minutes.",
      "secondary_message": "3 lb new potatoes\n2 tsp salt"
    },
    {
      "id": 151871,
      "primary_message": "Meanwhile, preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 151872,
      "primary_message": "Wash and dry the remaining fresh produce.",
      "secondary_message": "2 crowns broccoli\n½ lb white mushrooms\n1 small bunch green onions (scallions)\n2 tomatoes"
    },
    {
      "id": 151873,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Thinly slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 151874,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 151875,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the broccoli, mushrooms, salt, and pepper; cook, stirring often, until mushrooms are soft and broccoli is tender-crisp, 4-5 minutes. Remove from heat and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 151876,
      "primary_message": "Meanwhile, grate the cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 151877,
      "primary_message": "When the potatoes are done, drain and transfer to a large baking sheet pan. Using a fork or potato masher, gently crush each potato, flattening them to a 1-inch thickness. Drizzle with oil and season with salt and pepper; toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 151878,
      "primary_message": "Sprinkle cheese, broccoli, and mushrooms over the potatoes. Place in the oven and bake until cheese is melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 151879,
      "primary_message": "Meanwhile, trim off and discard ends of green onions, then cut crosswise into ¼-inch pieces at an angle. Small dice the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 151880,
      "primary_message": "To serve, divide smashed potatoes and vegetables between plates or bowls. Top with green onion, tomato, and yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
