  "instructions": [
    {
      "id": 151920,
      "primary_message": "Wash potatoes; transfer to a large pot, add salt, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, about 15 minutes.",
      "secondary_message": "2.04 kg new potatoes\n1 tbsp salt"
    },
    {
      "id": 151921,
      "primary_message": "Meanwhile, preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 151922,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 151923,
      "primary_message": "Add bacon to the skillet and cook until crispy, 3-5 minutes per side. Cook in batches if necessary.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 151924,
      "primary_message": "Meanwhile, grate the cheese. ",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 151925,
      "primary_message": "Wash and dry the remaining fresh produce.",
      "secondary_message": "0.68 kg white mushrooms\n1 small bunch green onions (scallions)\n3 tomatoes"
    },
    {
      "id": 151926,
      "primary_message": "Thinly slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 151927,
      "primary_message": "When the bacon is done, remove and set aside on a paper towel-lined plate. Transfer the bacon fat to a small bowl and set aside, leaving about 1 tbsp in the skillet. ",
      "secondary_message": null
    },
    {
      "id": 151928,
      "primary_message": "Return skillet to medium heat. Add mushrooms and season with salt and pepper. Cook, stirring often, until tender, 4-5 minutes; remove from heat and set aside.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 151929,
      "primary_message": "Crumble or chop bacon into small pieces. ",
      "secondary_message": null
    },
    {
      "id": 151930,
      "primary_message": "When the potatoes are done, drain and divide between 2 large baking sheet pans. Using a fork or potato masher, gently crush each potato, flattening them to a 1-inch thickness. Drizzle with ¼ cup reserved bacon fat and season with salt and pepper; toss to coat.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 151931,
      "primary_message": "Sprinkle cheese, mushrooms, and bacon over the potatoes. Place in the oven and bake until cheese is melted, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 151932,
      "primary_message": "Meanwhile, trim off and discard ends of green onions, then cut crosswise into ¼-inch pieces at an angle. Small dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 151933,
      "primary_message": "To serve, divide smashed potatoes between plates or bowls. Top with green onion, tomato, and yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
