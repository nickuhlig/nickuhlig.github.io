  "instructions": [
    {
      "id": 151892,
      "primary_message": "Wash potatoes; transfer to a medium saucepan, add salt, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, about 15 minutes.",
      "secondary_message": "0.68 kg new potatoes\n1 tsp salt"
    },
    {
      "id": 151893,
      "primary_message": "Meanwhile, preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 151894,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 151895,
      "primary_message": "Add bacon to the skillet and cook until crispy, 3-5 minutes per side.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 151896,
      "primary_message": "Meanwhile, grate the cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 151897,
      "primary_message": "Wash and dry the remaining fresh produce.",
      "secondary_message": "0.23 kg white mushrooms\n½ small bunch green onions (scallions)\n1 tomato"
    },
    {
      "id": 151898,
      "primary_message": "Thinly slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 151899,
      "primary_message": "When the bacon is done, remove and set aside on a paper towel-lined plate. Transfer the bacon fat to a small bowl and set aside, leaving about 1 tsp in the skillet.",
      "secondary_message": null
    },
    {
      "id": 151900,
      "primary_message": "Return skillet to medium heat. Add mushrooms and season with salt and pepper. Cook, stirring often, until tender, 3-4 minutes; remove from heat and set aside.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 151901,
      "primary_message": "Crumble or chop bacon into small pieces.",
      "secondary_message": null
    },
    {
      "id": 151902,
      "primary_message": "When the potatoes are done, drain and transfer to a baking sheet pan. Using a fork or potato masher, gently crush each potato, flattening them to a 1-inch thickness. Drizzle with 1 ½ tbsp reserved bacon fat and season with salt and pepper; toss to coat.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 151903,
      "primary_message": "Sprinkle cheese, mushrooms, and bacon over the potatoes. Place in the oven and bake until cheese is melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 151904,
      "primary_message": "Meanwhile, trim off and discard ends of green onions, then cut crosswise into ¼-inch pieces at an angle. Small dice the tomato.",
      "secondary_message": null
    },
    {
      "id": 151905,
      "primary_message": "To serve, divide smashed potatoes between plates or bowls. Top with green onion, tomato, and yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
