  "instructions": [
    {
      "id": 151956,
      "primary_message": "Wash potatoes; transfer to a large pot, add salt, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, about 15 minutes.",
      "secondary_message": "2.04 kg new potatoes\n1 tbsp salt"
    },
    {
      "id": 151957,
      "primary_message": "Meanwhile, preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 151958,
      "primary_message": "Wash and dry the remaining fresh produce.",
      "secondary_message": "3 crowns broccoli\n0.45 kg white mushrooms\n1 small bunch green onions (scallions)\n3 tomatoes"
    },
    {
      "id": 151959,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Thinly slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 151960,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 151961,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the broccoli, mushrooms, salt, and pepper; cook, stirring often, until mushrooms are soft and broccoli is tender-crisp, 5-6 minutes. Work in batches if necessary. Remove from heat and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 151962,
      "primary_message": "Meanwhile, grate the cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 151963,
      "primary_message": "When the potatoes are done, drain and divide between 2 large baking sheet pans. Using a fork or potato masher, gently crush each potato, flattening them to a 1-inch thickness. Drizzle with oil and season with salt and pepper; toss to coat.",
      "secondary_message": "¼ cup extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 151964,
      "primary_message": "Sprinkle cheese, broccoli, and mushrooms over the potatoes. Place in the oven and bake until cheese is melted, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 151965,
      "primary_message": "Meanwhile, trim off and discard ends of green onions, then cut crosswise into ¼-inch pieces at an angle. Small dice the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 151966,
      "primary_message": "To serve, divide smashed potatoes and vegetables between plates or bowls. Top with green onion, tomato, and yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
