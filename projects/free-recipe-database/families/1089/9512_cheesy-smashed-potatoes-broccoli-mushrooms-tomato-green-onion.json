  "instructions": [
    {
      "id": 151859,
      "primary_message": "Wash potatoes; transfer to a medium saucepan, add salt, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, about 15 minutes.",
      "secondary_message": "1 ½ lb new potatoes\n1 tsp salt"
    },
    {
      "id": 151860,
      "primary_message": "Meanwhile, preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 151861,
      "primary_message": "Wash and dry the remaining fresh produce.",
      "secondary_message": "1 crown broccoli\n¼ lb white mushrooms\n½ small bunch green onions (scallions)\n1 tomato"
    },
    {
      "id": 151862,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Thinly slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 151863,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 151864,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the broccoli, mushrooms, salt, and pepper; cook, stirring often, until mushrooms are soft and broccoli is tender-crisp, 3-4 minutes. Remove from heat and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 151865,
      "primary_message": "Meanwhile, grate the cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 151866,
      "primary_message": "When the potatoes are done, drain and transfer to a baking sheet pan. Using a fork or potato masher, gently crush each potato, flattening them to a 1-inch thickness. Drizzle with oil and season with salt and pepper; toss to coat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 151867,
      "primary_message": "Sprinkle cheese, broccoli, and mushrooms over the potatoes. Place in the oven and bake until cheese is melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 151868,
      "primary_message": "Meanwhile, trim off and discard ends of green onions, then cut crosswise into ¼-inch pieces at an angle. Small dice the tomato.",
      "secondary_message": null
    },
    {
      "id": 151869,
      "primary_message": "To serve, divide smashed potatoes and vegetables between plates or bowls. Top with green onion, tomato, and yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
