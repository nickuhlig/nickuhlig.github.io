  "instructions": [
    {
      "id": 121962,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium zucchini squash\n1 tomato\n½ mango\n1 red bell pepper\n½ small bunch cilantro\n½ small pkg fresh mint\n1 lime"
    },
    {
      "id": 121963,
      "primary_message": "Trim ends, peel, and small dice zucchini. Small dice tomato. Transfer both to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 121964,
      "primary_message": "Peel the mango and slice the flesh away from the pit, starting with the flat sides; small dice and add to the large bowl. ",
      "secondary_message": null
    },
    {
      "id": 121965,
      "primary_message": "Seed bell pepper, small dice, and transfer to the large bowl.",
      "secondary_message": null
    },
    {
      "id": 121966,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 121967,
      "primary_message": "Pick mint leaves off the stems; discard the stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 121968,
      "primary_message": "Juice the lime over the veggies; add oil and spices and toss until well coated. Set aside in fridge until ready to serve.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp cayenne pepper\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 121969,
      "primary_message": "In a small bowl, combine the spices for the fish. ",
      "secondary_message": "2 tsp paprika\n1 tsp cumin\n1 tsp garlic powder\n1 tsp onion powder\n1 tsp oregano\n¼ tsp cayenne pepper"
    },
    {
      "id": 121970,
      "primary_message": "Using paper towel, pat the fillets dry, then rub with spice mixture on both sides. ",
      "secondary_message": "0.45 kg tilapia fillet"
    },
    {
      "id": 121971,
      "primary_message": "Preheat a skillet over medium-high heat. When the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 121972,
      "primary_message": "Add the fillets to the skillet and cook, 3 minutes per side, until opaque and cooked through. ",
      "secondary_message": null
    },
    {
      "id": 121973,
      "primary_message": "To serve, divide the salad between plates and top with blackened tilapia. Enjoy! ",
      "secondary_message": null
    }
  ],
