  "instructions": [
    {
      "id": 121902,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n2 tomatoes\n1 mango\n2 red bell peppers\n1 small bunch cilantro\n1 small pkg fresh mint\n2 limes"
    },
    {
      "id": 121903,
      "primary_message": "Trim ends, peel, and small dice zucchini. Small dice tomatoes. Transfer both to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 121904,
      "primary_message": "Peel the mango and slice the flesh away from the pit, starting with the flat sides; small dice and add to the large bowl. ",
      "secondary_message": null
    },
    {
      "id": 121905,
      "primary_message": "Seed bell peppers, small dice, and transfer to the large bowl.",
      "secondary_message": null
    },
    {
      "id": 121906,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 121907,
      "primary_message": "Pick mint leaves off the stems; discard the stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 121908,
      "primary_message": "Juice the limes over the veggies; add oil and spices and toss until well coated. Set aside in fridge until ready to serve.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp cayenne pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 121909,
      "primary_message": "In a small bowl, combine the spices for the fish. ",
      "secondary_message": "4 tsp paprika\n2 tsp cumin\n2 tsp garlic powder\n2 tsp onion powder\n2 tsp oregano\n½ tsp cayenne pepper"
    },
    {
      "id": 121910,
      "primary_message": "Using paper towel, pat the fillets dry, then rub with spice mixture on both sides. ",
      "secondary_message": "2 lb tilapia fillet"
    },
    {
      "id": 121911,
      "primary_message": "Preheat a skillet over medium-high heat. When the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 121912,
      "primary_message": "Working in batches if necessary, add the fillets to the skillet and cook, 3 minutes per side, until opaque and cooked through. ",
      "secondary_message": null
    },
    {
      "id": 121913,
      "primary_message": "To serve, divide the salad between plates and top with blackened tilapia. Enjoy! ",
      "secondary_message": null
    }
  ],
