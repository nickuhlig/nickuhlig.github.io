  "instructions": [
    {
      "id": 409268,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 yellow bell peppers\n2 pints grape tomatoes\n1 small pkg fresh mint"
    },
    {
      "id": 409269,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 409270,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 409271,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the peppers, tomatoes, and salt. Cook, stirring occasionally, until tender and starting to brown, 12-15 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 409272,
      "primary_message": "Meanwhile, place ricotta, cream, salt, and pepper in a blender. Blend on high until smooth, about 1 minute. Set aside.",
      "secondary_message": "1 (15 oz) pkg ricotta cheese\n8 fl oz (1 cup) heavy whipping cream\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 409273,
      "primary_message": "Peel and thinly slice garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 409274,
      "primary_message": "When the veggies are tender, add garlic and crushed red pepper to the skillet. Cook, stirring occasionally, until garlic is golden, about 30 seconds.",
      "secondary_message": "½ tsp crushed red pepper"
    },
    {
      "id": 409275,
      "primary_message": "When the garlic is done, add vinegar, stir to combine, and remove from heat. Transfer veggies to a medium bowl, loosely cover with aluminum foil, and set aside. (Reserve skillet for the next step.)",
      "secondary_message": "1 tbsp balsamic vinegar"
    },
    {
      "id": 409276,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 409277,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n4 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 409278,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the veggies and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 409279,
      "primary_message": "To serve, divide whipped ricotta between plates or bowls; top with veggies and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
