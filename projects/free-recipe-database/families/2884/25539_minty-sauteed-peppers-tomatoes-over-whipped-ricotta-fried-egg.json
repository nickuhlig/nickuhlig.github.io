  "instructions": [
    {
      "id": 409280,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "3 yellow bell peppers\n3 pints grape tomatoes\n1 small pkg fresh mint"
    },
    {
      "id": 409281,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 409282,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 409283,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the peppers, tomatoes, and salt. Cook, stirring occasionally, until tender and starting to brown, 15-18 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 409284,
      "primary_message": "Meanwhile, place ricotta, cream, salt, and pepper in a blender. Blend on high until smooth, about 1 minute. Set aside.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n12 fl oz (1 ½ cups) heavy whipping cream\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 409285,
      "primary_message": "Peel and thinly slice garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 409286,
      "primary_message": "When the veggies are tender, add garlic and crushed red pepper to the pot. Cook, stirring occasionally, until garlic is golden, about 30 seconds.",
      "secondary_message": "¾ tsp crushed red pepper"
    },
    {
      "id": 409287,
      "primary_message": "When the garlic is done, add vinegar and stir to combine. Remove from heat and cover.",
      "secondary_message": "1 ½ tbsp balsamic vinegar"
    },
    {
      "id": 409288,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 409289,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n6 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 409290,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the pot with the veggies and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 409291,
      "primary_message": "To serve, divide whipped ricotta between plates or bowls; top with veggies and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
