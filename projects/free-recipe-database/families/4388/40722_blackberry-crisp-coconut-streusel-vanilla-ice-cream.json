  "instructions": [
    {
      "id": 629306,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 629307,
      "primary_message": "Wash, dry, zest, and juice lime into a small bowl.",
      "secondary_message": "½ lime"
    },
    {
      "id": 629308,
      "primary_message": "Wash and dry blackberries. Add to the bowl with the lime, along with sugar, cornstarch, cinnamon, and salt, then stir to combine. Transfer to a small baking dish and set aside. (Reserve bowl for later use.)",
      "secondary_message": "1 (170 g) pkg blackberries\n2 tbsp brown sugar\n2 tsp cornstarch\n⅛ tsp cinnamon, ground\n1 pinch salt"
    },
    {
      "id": 629309,
      "primary_message": "Place oil in a small saucepan and melt over medium heat, stirring occasionally.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 629310,
      "primary_message": "Meanwhile, place flour, oats, coconut, sugar, and salt in the reserved bowl. Stir to combine.",
      "secondary_message": "3 tbsp all-purpose flour\n2 tbsp oats, quick cooking\n⅛ cup shredded unsweetened coconut\n2 tbsp brown sugar\n⅛ tsp salt"
    },
    {
      "id": 629311,
      "primary_message": "When the oil is melted, add to the bowl with flour mixture and stir to combine the streusel. Using your hands, slightly break up the streusel, then sprinkle over the blackberries.",
      "secondary_message": null
    },
    {
      "id": 629312,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until blackberries are soft and streusel is golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 629313,
      "primary_message": "To serve, divide blackberry crisp and ice cream between bowls. Enjoy!",
      "secondary_message": "355 ml vanilla ice cream, vegan"
    }
  ],
