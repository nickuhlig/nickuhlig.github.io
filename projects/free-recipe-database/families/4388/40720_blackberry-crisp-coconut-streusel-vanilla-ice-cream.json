  "instructions": [
    {
      "id": 629290,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 629291,
      "primary_message": "Wash, dry, zest, and juice lime into a medium bowl.",
      "secondary_message": "1 lime"
    },
    {
      "id": 629292,
      "primary_message": "Wash and dry blackberries. Add to the bowl with the lime, along with sugar, cornstarch, cinnamon, and salt, then stir to combine. Transfer to a baking dish and set aside. (Reserve bowl for later use.)",
      "secondary_message": "2 (170 g) pkgs blackberries\n¼ cup brown sugar\n4 tsp cornstarch\n¼ tsp cinnamon, ground\n⅛ tsp salt"
    },
    {
      "id": 629293,
      "primary_message": "Place butter in a small saucepan and melt over medium heat, stirring occasionally.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 629294,
      "primary_message": "Meanwhile, place flour, oats, coconut, sugar, and salt in the reserved bowl. Stir to combine.",
      "secondary_message": "⅓ cup all-purpose flour\n¼ cup oats, quick cooking\n¼ cup shredded unsweetened coconut\n¼ cup brown sugar\n¼ tsp salt"
    },
    {
      "id": 629295,
      "primary_message": "When the butter is melted, add to the bowl with flour mixture and stir to combine the streusel. Using your hands, slightly break up the streusel, then sprinkle over the blackberries.",
      "secondary_message": null
    },
    {
      "id": 629296,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until blackberries are soft and streusel is golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 629297,
      "primary_message": "To serve, divide blackberry crisp and ice cream between bowls. Enjoy!",
      "secondary_message": "710 ml vanilla ice cream"
    }
  ],
