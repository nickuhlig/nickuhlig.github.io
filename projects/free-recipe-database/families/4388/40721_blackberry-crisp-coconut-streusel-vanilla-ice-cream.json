  "instructions": [
    {
      "id": 629298,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 629299,
      "primary_message": "Wash, dry, zest, and juice limes into a medium bowl.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 629300,
      "primary_message": "Wash and dry blackberries. Add to the bowl with the lime, along with sugar, cornstarch, cinnamon, and salt, then stir to combine. Transfer to a large baking dish and set aside. (Reserve bowl for later use.)",
      "secondary_message": "3 (170 g) pkgs blackberries\n⅓ cup brown sugar\n2 tbsp cornstarch\n½ tsp cinnamon, ground\n3 pinch salt"
    },
    {
      "id": 629301,
      "primary_message": "Place butter in a small saucepan and melt over medium heat, stirring occasionally.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 629302,
      "primary_message": "Meanwhile, place flour, oats, coconut, sugar, and salt in the reserved bowl. Stir to combine.",
      "secondary_message": "½ cup all-purpose flour\n⅓ cup oats, quick cooking\n⅓ cup shredded unsweetened coconut\n⅓ cup brown sugar\n¼ tsp salt"
    },
    {
      "id": 629303,
      "primary_message": "When the butter is melted, add to the bowl with flour mixture and stir to combine the streusel. Using your hands, slightly break up the streusel, then sprinkle over the blackberries.",
      "secondary_message": null
    },
    {
      "id": 629304,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until blackberries are soft and streusel is golden, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 629305,
      "primary_message": "To serve, divide blackberry crisp and ice cream between bowls. Enjoy!",
      "secondary_message": "1065 ml vanilla ice cream"
    }
  ],
