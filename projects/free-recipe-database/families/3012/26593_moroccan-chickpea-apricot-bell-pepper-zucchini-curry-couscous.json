  "instructions": [
    {
      "id": 430720,
      "primary_message": "In a small saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 430721,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 red bell pepper\n1 medium zucchini squash\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 430722,
      "primary_message": "Peel, trim, and slice carrot crosswise into ¼-inch thick rounds. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 430723,
      "primary_message": "Trim, seed, and thinly slice bell pepper. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 430724,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 430725,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium red onion\n2 cloves garlic"
    },
    {
      "id": 430726,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the veggies and spices; cook, stirring occasionally, until the veggies start to soften, about 5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n1 ½ tsp garam masala\n½ tsp salt\n⅛ tsp cinnamon, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 430727,
      "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 430728,
      "primary_message": "Roughly chop apricots and add to the bowl with the zucchini.",
      "secondary_message": "8 dried apricots"
    },
    {
      "id": 430729,
      "primary_message": "Drain and rinse chickpeas in a colander.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 430730,
      "primary_message": "Once the veggies start to soften, add zucchini, apricots, chickpeas, tomatoes, broth, tomato paste, and sugar to the skillet. Stir to combine the curry and bring to a boil over high heat. ",
      "secondary_message": "1 (398 ml) can diced tomatoes\n237 ml chicken or vegetable broth\n2 tbsp tomato paste\n2 tsp brown sugar"
    },
    {
      "id": 430731,
      "primary_message": "Once boiling, reduce heat to medium-low, and cook, stirring occasionally, until veggies and chickpeas are tender, 10-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 430732,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 430733,
      "primary_message": "When the curry is done, remove from heat, add half of the parsley, and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 430734,
      "primary_message": "To serve, divide couscous and curry between plates or bowls; top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
