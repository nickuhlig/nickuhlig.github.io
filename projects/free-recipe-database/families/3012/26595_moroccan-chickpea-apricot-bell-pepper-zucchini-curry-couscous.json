  "instructions": [
    {
      "id": 430750,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 430751,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 red bell peppers\n3 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 430752,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 430753,
      "primary_message": "Trim, seed, and thinly slice bell peppers. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 430754,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium red onions\n6 cloves garlic"
    },
    {
      "id": 430755,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 430756,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies and spices; cook, stirring occasionally, until the veggies start to soften, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tbsp chili powder\n1 ½ tbsp garam masala\n1 ½ tsp salt\n½ tsp cinnamon, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 430757,
      "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 430758,
      "primary_message": "Roughly chop apricots and add to the bowl with the zucchini.",
      "secondary_message": "24 dried apricots"
    },
    {
      "id": 430759,
      "primary_message": "Drain and rinse chickpeas in a colander.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 430760,
      "primary_message": "Once the veggies start to soften, add zucchini, apricots, chickpeas, tomatoes, broth, tomato paste, and sugar to the pot. Stir to combine the curry and bring to a boil over high heat.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n710 ml chicken or vegetable broth\n6 tbsp tomato paste\n2 tbsp brown sugar"
    },
    {
      "id": 430761,
      "primary_message": "Once boiling, reduce heat to medium-low, and cook, stirring occasionally, until veggies and chickpeas are tender, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 430762,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 430763,
      "primary_message": "When the curry is done, remove from heat, add half of the parsley, and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 430764,
      "primary_message": "To serve, divide couscous and curry between plates or bowls; top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
