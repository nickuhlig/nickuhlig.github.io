  "instructions": [
    {
      "primary_message": "In a small bowl, whisk to combine mayonnaise, whipped topping, lemon juice, lemon zest, and sugar. Set aside.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spray a sauté pan with non-stick cooking spray. Over medium heat, brown Aidell’s® Chicken & Apple Sausage pieces for 3 to 5 minutes until slightly caramelized. Remove from heat and let cool completely.\n",
      "secondary_message": null
    },
    {
      "primary_message": "On a butter lettuce-lined platter, arrange all remaining ingredients into sections. Season with pepper, if desired. Top with dressing before serving.\n",
      "secondary_message": null
    }
  ],
