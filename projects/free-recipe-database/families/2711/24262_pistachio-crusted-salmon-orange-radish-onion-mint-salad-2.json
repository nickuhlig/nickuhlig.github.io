  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 bunch radish\n2 oranges\n½ small pkg fresh mint"
    },
    {
      "primary_message": "Mince pistachios. Place in a small bowl along with bread crumbs, oil, and salt; stir to combine the coating.",
      "secondary_message": "¼ cup pistachios, unsalted\nextra virgin olive oil\nsalt"
    },
    {
      "primary_message": "Pat salmon dry with paper towels and place, skin-side down, on the baking sheet; season the top side with salt and pepper. Spread the fish with mayo, then sprinkle evenly with the coating, pressing gently to adhere.",
      "secondary_message": "¾ lb salmon fillet\nsalt\nblack pepper\n1 ½ tbsp mayonnaise"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until salmon is cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, juice half of the lemon into a medium bowl. Cut the remaining lemon into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add additional oil, salt, and pepper to the bowl with the lemon juice. Whisk to combine the dressing.",
      "secondary_message": "extra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the dressing. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "primary_message": "Trim and thinly slice radishes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Cut off skin and white pith from oranges; slice between the membranes to release segments. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide salmon and salad between plates; serve with lemon wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
