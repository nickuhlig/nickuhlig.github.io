  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together white rice flour, cornstarch, sweet rice flour, granulated sugar, baking powder, salt, and xathan gum. Add eggs, milk, vegetable oil, and vanilla extract. Whisk until smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Lightly oil a flat griddle pan. Heat griddle over medium-high heat. Pour batter, approximately 1/4 cup, onto griddle. Batter should \"sizzle\" when it hits the pan. Dot the surface of each pancake with a few pieces of cheese or small 1/2 teaspoon dots of ricotta.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cook for approximately 3 minutes. Flip pancakes when bubbles appear all over the surface of the pancake and begin to pop. The pancake should begin to look almost dry. Flip and cook another 1-1 1/2 minutes.",
      "secondary_message": null
    }
  ],
