  "instructions": [
    {
      "id": 364528,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 364529,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ red bell pepper\n½ English cucumber\n½ small bunch cilantro"
    },
    {
      "id": 364530,
      "primary_message": "Zest and juice lime into a small bowl. Add coconut milk, sugar, curry powder, and salt; whisk to combine the dressing and set aside.",
      "secondary_message": "½ (13.5 fl oz) can coconut milk\n1 tbsp brown sugar\n1 tsp curry powder\n½ tsp salt"
    },
    {
      "id": 364531,
      "primary_message": "Once the water in the saucepan is boiling, add the noodles and edamame; cook noodles according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water.",
      "secondary_message": "5 oz soba (buckwheat) noodles\n1 cup edamame, shelled"
    },
    {
      "id": 364532,
      "primary_message": "Meanwhile, trim, seed, and halve bell pepper crosswise, then slice into thin strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 364533,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 364534,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 364535,
      "primary_message": "Add noodles, edamame, cabbage, and carrots to the bowl; toss to combine the salad.",
      "secondary_message": "½ (14 oz) bag shredded cabbage (coleslaw mix)\n½ (10 oz) bag shredded carrots"
    },
    {
      "id": 364536,
      "primary_message": "To serve, divide salad between plates or bowls; drizzle with dressing and enjoy. Enjoy!",
      "secondary_message": null
    }
  ],
