  "instructions": [
    {
      "id": 364573,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 364574,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ red bell peppers\n1 ½ English cucumbers\n1 small bunch cilantro"
    },
    {
      "id": 364575,
      "primary_message": "Zest and juice limes into a small bowl. Add coconut milk, sugar, curry powder, and salt; whisk to combine the dressing and set aside.",
      "secondary_message": "1 ½ (398 ml) cans coconut milk\n3 tbsp brown sugar\n1 tbsp curry powder\n1 ½ tsp salt"
    },
    {
      "id": 364576,
      "primary_message": "Once the water in the pot is boiling, add the noodles and edamame; cook noodles according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water.",
      "secondary_message": "425 g soba (buckwheat) noodles\n3 cups edamame"
    },
    {
      "id": 364577,
      "primary_message": "Meanwhile, trim, seed, and halve bell peppers crosswise, then slice into thin strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 364578,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 364579,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 364580,
      "primary_message": "Add noodles, edamame, cabbage, and carrots to the bowl; toss to combine the salad.",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 364581,
      "primary_message": "To serve, divide salad between plates or bowls; drizzle with dressing and enjoy. Enjoy!",
      "secondary_message": null
    }
  ],
