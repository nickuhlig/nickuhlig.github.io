  "instructions": [
    {
      "id": 430045,
      "primary_message": "Place flour, chia seeds, sugar, baking powder, and salt in a medium bowl. Whisk to combine the flour mixture. ",
      "secondary_message": "⅔ cup all-purpose flour\n2 tbsp chia seeds\n1 tbsp brown sugar\n½ tsp baking powder\n⅛ tsp salt"
    },
    {
      "id": 430046,
      "primary_message": "Place egg and milk in a small bowl; whisk to combine.",
      "secondary_message": "1 egg\n118 ml (½ cup) whole milk"
    },
    {
      "id": 430047,
      "primary_message": "Melt butter in a large skillet over low heat. Once melted, pour butter into the bowl with the eggs, whisking quickly to combine. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 430048,
      "primary_message": "Create a well in the center of the flour mixture. Add the egg mixture and whisk until batter is just combined.",
      "secondary_message": null
    },
    {
      "id": 430049,
      "primary_message": "Wash, dry, and add raspberries to the bowl with the batter. Using the back of a spoon, lightly crush the raspberries (breaking them into smaller pieces), then stir to incorporate them into the batter.",
      "secondary_message": "½ (170 g) pkg raspberries"
    },
    {
      "id": 430050,
      "primary_message": "Return skillet to medium-high heat. Add more butter and swirl to coat the bottom.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 430051,
      "primary_message": "Working in batches if necessary, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart. Cook, flipping once, until pancakes are golden and cooked through, 2-3 minutes. Remove to a plate. ",
      "secondary_message": null
    },
    {
      "id": 430052,
      "primary_message": "Meanwhile, peel and thinly slice banana. ",
      "secondary_message": "1 banana"
    },
    {
      "id": 430053,
      "primary_message": "To serve, divide pancakes between plates; top with sliced banana, then drizzle with honey. Enjoy!",
      "secondary_message": "2 tsp honey"
    }
  ],
