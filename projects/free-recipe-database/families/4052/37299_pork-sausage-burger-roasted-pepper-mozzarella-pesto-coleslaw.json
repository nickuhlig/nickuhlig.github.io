  "instructions": [
    {
      "id": 584545,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584546,
      "primary_message": "While the pan heats up, form the pork sausage into 6 equal-sized patties and place on a plate. Season the top side with salt and pepper.",
      "secondary_message": "0.68 kg ground pork sausage\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 584547,
      "primary_message": "Once the pan is hot, working in batches if necessary, add patties and cook, undisturbed, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 584548,
      "primary_message": "Meanwhile, drain roasted peppers. Thinly slice cheese.",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers\n¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 584549,
      "primary_message": "When the patties are done on one side, flip, then top with cheese and roasted peppers. Continue to grill until sausage is cooked through, 5-7 minutes more. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 584550,
      "primary_message": "While the patties are cooking, place shredded cabbage in a large bowl. Drizzle with dressing, sprinkle with spices, then stir until well combined. Set slaw aside.",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n⅓ cup ranch dressing\n3 pinch garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 584551,
      "primary_message": "Grill buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 584552,
      "primary_message": "Spread pesto on the bottom half of each bun, then top with cheesy patties. Close with the top half of each bun.",
      "secondary_message": "¼ cup basil pesto"
    },
    {
      "id": 584553,
      "primary_message": "To serve, divide burgers and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
