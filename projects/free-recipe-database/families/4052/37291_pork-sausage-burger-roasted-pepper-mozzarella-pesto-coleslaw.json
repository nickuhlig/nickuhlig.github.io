  "instructions": [
    {
      "id": 584476,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584477,
      "primary_message": "While the pan heats up, form the pork sausage into 2 equal-sized patties and place on a plate. Season the top side with salt and pepper.",
      "secondary_message": "½ lb ground pork sausage\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 584478,
      "primary_message": "Once the pan is hot, add patties and cook, undisturbed, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 584479,
      "primary_message": "Meanwhile, drain roasted peppers. Thinly slice cheese.",
      "secondary_message": "½ (12 oz) jar roasted red bell peppers\n¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 584480,
      "primary_message": "When the patties are done on one side, flip, then top with cheese and roasted peppers. Continue to grill until sausage is cooked through, 5-7 minutes more. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 584481,
      "primary_message": "While the patties are cooking, place shredded cabbage in a medium bowl. Drizzle with dressing, sprinkle with spices, then stir until well combined. Set slaw aside.",
      "secondary_message": "½ (14 oz) bag shredded cabbage (coleslaw mix)\n2 tbsp ranch dressing\n1 pinch garlic powder\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 584482,
      "primary_message": "Grill buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 584483,
      "primary_message": "Spread pesto on the bottom half of each bun, then top with cheesy patties. Close with the top half of each bun.",
      "secondary_message": "1 ½ tbsp basil pesto"
    },
    {
      "id": 584484,
      "primary_message": "To serve, divide burgers and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
