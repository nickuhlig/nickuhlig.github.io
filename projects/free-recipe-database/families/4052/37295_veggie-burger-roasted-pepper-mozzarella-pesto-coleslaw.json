  "instructions": [
    {
      "id": 584511,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584512,
      "primary_message": "Once the pan is hot, coat with oil; add patties, then season the top side with salt and pepper. Cook, undisturbed, for 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 veggie burger patties, plant-based\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 584513,
      "primary_message": "Meanwhile, drain roasted peppers. Thinly slice cheese.",
      "secondary_message": "1 (12 oz) jar roasted red bell peppers\n½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 584514,
      "primary_message": "When the patties are done on one side, flip, then top with cheese and roasted peppers. Continue to grill until cooked through, 5-7 minutes more. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 584515,
      "primary_message": "While the patties are cooking, place shredded cabbage in a medium bowl. Drizzle with dressing, sprinkle with spices, then stir until well combined. Set slaw aside.",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n¼ cup ranch dressing\n⅛ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 584516,
      "primary_message": "Grill buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 584517,
      "primary_message": "Spread pesto on the bottom half of each bun, then top with cheesy patties. Close with the top half of each bun.",
      "secondary_message": "3 tbsp basil pesto"
    },
    {
      "id": 584518,
      "primary_message": "To serve, divide burgers and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
