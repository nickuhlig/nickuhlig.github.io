  "instructions": [
    {
      "id": 311779,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 311780,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 311781,
      "primary_message": "Place spices in a small bowl and stir to combine the spice mix; set aside.",
      "secondary_message": "2 tsp chili powder\n1 tsp cumin, ground\n½ tsp garlic powder\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 311782,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n½ bunch kale\n½ lime"
    },
    {
      "id": 311783,
      "primary_message": "Trim, halve, seed, and slice bell peppers into thin strips; transfer to another baking sheet.",
      "secondary_message": null
    },
    {
      "id": 311784,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick strips; add to the baking sheet with the bell pepper.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 311785,
      "primary_message": "Large dice tofu and add to the baking sheet. Sprinkle veggies and tofu with ⅔ of the spice mix, then drizzle with oil; toss to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 311786,
      "primary_message": "Place baking sheet in the oven and roast until veggies start to soften, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 311787,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 311788,
      "primary_message": "Drain and rinse beans in a colander. Add beans to the bowl with the kale along with oil and salt; toss to combine.",
      "secondary_message": "1 (15 oz) can black beans\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 311789,
      "primary_message": "When the veggies are soft, add kale and beans to the baking sheet; toss to combine, then return to the oven and continue to bake until kale is tender, 5-6 minutes more.",
      "secondary_message": null
    },
    {
      "id": 311790,
      "primary_message": "Meanwhile, zest and juice lime into the bowl with the remaining spice mix; add mayo and water, then stir to combine the sauce.",
      "secondary_message": "3 tbsp vegan mayonnaise\n1 tsp water"
    },
    {
      "id": 311791,
      "primary_message": "To serve, divide tofu, beans, and veggies between bowls; drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
