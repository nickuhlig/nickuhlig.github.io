  "instructions": [
    {
      "id": 311842,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 311843,
      "primary_message": "Place spices in a small bowl and stir to combine the spice mix; set aside.",
      "secondary_message": "2 tbsp chili powder\n1 tbsp cumin, ground\n1 ½ tsp garlic powder\n1 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 311844,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 red bell peppers\n1 ½ bunches kale\n1 ½ limes"
    },
    {
      "id": 311845,
      "primary_message": "Trim, halve, seed, and slice bell peppers into thin strips; divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 311846,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick strips; add to the baking sheets with the bell pepper.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 311847,
      "primary_message": "Pat pork chops dry with paper towels and place on a cutting board; thinly slice crosswise into bite-sized strips. Add to the baking sheets, sprinkle with ⅔ of the spice mix, then drizzle with oil; toss to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "6 pork chops, boneless\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 311848,
      "primary_message": "Place baking sheets in the oven and roast until veggies start to soften, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 311849,
      "primary_message": "Meanwhile, using a clean cutting board, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 311850,
      "primary_message": "Drain and rinse beans in a colander. Add beans to the bowl with the kale along with oil and salt; toss to combine.",
      "secondary_message": "3 (398 ml) cans black beans\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 311851,
      "primary_message": "When the veggies are soft, add kale and beans to the baking sheets; toss to combine, then return to the oven and continue to bake until kale is tender and pork is cooked through, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 311852,
      "primary_message": "Meanwhile, zest and juice limes into the bowl with the remaining spice mix; add yogurt and water, then stir to combine the sauce.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 tbsp water"
    },
    {
      "id": 311853,
      "primary_message": "To serve, divide pork, beans, and veggies between bowls; drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
