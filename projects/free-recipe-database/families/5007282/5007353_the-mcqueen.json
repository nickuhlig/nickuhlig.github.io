  "instructions": [
    {
      "id": 1,
      "primary_message": "Stir mezcal, Scotch, dark agave, and bitters in a mixing glass with ice. Let sit for a minute or so to let ice start to melt. Mist coupe glass with Ardbeg 10yr. (If you don't have an atomizer, pour a small amount in bottom of coupe glass and swirl vigorously until it lines the glass and liquid flies out.) Strain cocktail into misted coupe. Squeeze grapefruit twist and briefly flame.",
      "secondary_message": null
    }
