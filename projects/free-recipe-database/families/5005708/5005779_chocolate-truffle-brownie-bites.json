  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and heat oven to 190°C (375°F). Generously grease muffin pan with butter. Sift cocoa over muffin cups and tilt pan to coat. Gently knock out excess cocoa.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large heatproof bowl placed over pan of barely simmering water, heat 6 tablespoons butter, bittersweet chocolate, milk chocolate, and espresso powder, stirring frequently, until melted and smooth. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In medium bowl, whisk eggs with sugar until light, about 45 seconds. Sift flour and salt over eggs and whisk to combine. Whisk in vanilla and chocolate mixture until smooth.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spoon 3 tablespoons batter into each cup. Bake until edges are set and center is just set, 17 to 20 minutes. Place pan on cooling rack to cool completely, 1 hour or more. Run knife around each brownie and remove from pan.",
      "secondary_message": null
    }
  ],
