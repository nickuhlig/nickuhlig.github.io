  "instructions": [
    {
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Place oil, vinegar, salt, and pepper in a small bowl. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Small dice cheese. Add to the bowl with the dressing.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "primary_message": "Wash, dry, and small dice tomatoes. Add to the bowl, stir to combine the topping, and set aside. ",
      "secondary_message": null
    },
    {
      "primary_message": "Cut baguette on the diagonal into 3/4-inch thick slices. Arrange on a baking sheet pan in a single layer.",
      "secondary_message": "½ loaf baguette"
    },
    {
      "primary_message": "Place baking sheet in the oven and broil until baguette slices are lightly toasted on one side, about 1 minute.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, peel and mince garlic. Place in another small bowl, along with oil, and stir to combine the garlic oil. ",
      "secondary_message": "1 clove garlic\n1 ½ tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Remove baking sheet from the oven. Flip baguette slices, then drizzle with the garlic oil.",
      "secondary_message": null
    },
    {
      "primary_message": "Return baking sheet to the oven and continue to broil until baguette slices are lightly toasted on the other side, about 1 minute. Remove from oven and set aside to cool slightly, 3 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "primary_message": "Arrange toasted baguette slices on a platter. Spoon tomato-mozzarella mixture on top, then garnish with basil and drizzle with additional vinegar. Enjoy!",
      "secondary_message": "1 tbsp balsamic vinegar"
    }
  ],
