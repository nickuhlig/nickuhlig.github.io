  "instructions": [
    {
      "id": 68322,
      "primary_message": "In a small saucepan, combine quinoa and water; bring to a boil.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) water"
    },
    {
      "id": 68335,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "1 ½ pint grape tomatoes\n1 ½ English cucumber\n1 ½ lemon\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 68334,
      "primary_message": "Juice the lemons into a small bowl; pour ½ of the juice into the quinoa (save the rest for the tzatziki sauce).",
      "secondary_message": ""
    },
    {
      "id": 68333,
      "primary_message": "Once the quinoa is boiling, reduce the heat to a simmer and cover; cook for 15 minutes. Once cooked, remove the saucepan from the heat and let the quinoa stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68332,
      "primary_message": "Halve the tomatoes and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 68331,
      "primary_message": "Small dice a ⅓ of the cucumbers and add to the remaining lemon juice; halve the other ⅔ of the cucumbers lengthwise, then thinly slice crosswise on an angle. Add to the tomatoes.",
      "secondary_message": ""
    },
    {
      "id": 68330,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and roughly chops the leaves. Add to the tomatoes and cucumber.",
      "secondary_message": ""
    },
    {
      "id": 68321,
      "primary_message": "Peel and mince the garlic; add to the bowl with the lemon juice and cucumber.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 68329,
      "primary_message": "Preheat a grill pan or skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 68320,
      "primary_message": "Place the chicken on a cutting board and holding a knife parallel to the board, cut the chicken in half horizontally to form thin fillets. Season with salt and pepper, then rub with olive oil.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper\n1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 68328,
      "primary_message": "Place the chicken in the grill pan or skillet; cook until golden brown and cooked through, 3 to 4 minutes per side. Once done, transfer to a clean cutting board.",
      "secondary_message": ""
    },
    {
      "id": 68319,
      "primary_message": "Add yogurt, salt, and pepper to the bowl with the lemon juice, cucumber, and garlic; mix together and set aside.",
      "secondary_message": "1 ½ cup plain Greek yogurt\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 68327,
      "primary_message": "Measure out the olives and add to the vegetables.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 68326,
      "primary_message": "Measure out the feta and add to the bowl.",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 68325,
      "primary_message": "Uncover the quinoa and fluff with a fork; add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68324,
      "primary_message": "Cut the chicken crosswise into bite-sized strips and add to the bowl. Toss the ingredients until well combined.",
      "secondary_message": ""
    },
    {
      "id": 68323,
      "primary_message": "To serve, place the quinoa mixture into a bowl and spoon the tzatziki sauce over top. Enjoy!",
      "secondary_message": ""
    }
  ],
