  "instructions": [
    {
      "id": 432142,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven. Line a baking sheet pan with aluminum foil (for easier cleanup), coat with thin layer of oil, and set aside.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 432143,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 medium zucchini squash\n1 lemon"
    },
    {
      "id": 432144,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 432145,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Add to the bowl with the broccoli and set aside.",
      "secondary_message": null
    },
    {
      "id": 432146,
      "primary_message": "Juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 432147,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the lemon juice along with mayo and spices; stir to combine and set aside.",
      "secondary_message": "1 oz Parmesan cheese\n¼ cup avocado oil mayonnaise\n¼ tsp basil, dried\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 432148,
      "primary_message": "Pat tilapia dry with paper towels, place on the baking sheet, and drizzle with oil. Place fish in the oven and broil until almost cooked through, about 4 minutes.",
      "secondary_message": "¾ lb tilapia fillet\n1 tsp extra virgin olive oil"
    },
    {
      "id": 432149,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 432150,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli, zucchini, pine nuts, salt, and pepper; cook, stirring often, until veggies are tender-crisp, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ cup pine nuts\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 432151,
      "primary_message": "When the fish is almost cooked through, remove from the oven. Spread the mayo mixture over the fillets. Return to the oven and continue to broil until topping is browned and fish is cooked through, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 432152,
      "primary_message": "To serve, divide fish and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
