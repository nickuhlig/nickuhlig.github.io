  "instructions": [
    {
      "id": 432118,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 432119,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 432120,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 medium zucchini squash\n1 lemon"
    },
    {
      "id": 432121,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 432122,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Add to the bowl with the broccoli and set aside.",
      "secondary_message": null
    },
    {
      "id": 432123,
      "primary_message": "Juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 432124,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the lemon juice along with mayo and spices; stir to combine and set aside.",
      "secondary_message": "2 oz Parmesan cheese\n½ cup mayonnaise\n½ tsp basil, dried\n½ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 432125,
      "primary_message": "Transfer pressed tofu to the cutting board and wipe the baking sheet dry with paper towels. Return tofu to the baking sheet and coat with oil on both sides. Place tofu in the oven and broil until warmed through, about 4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 432126,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 432127,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli, zucchini, pine nuts, salt, and pepper; cook, stirring often until veggies are tender-crisp, 6-7 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ cup pine nuts\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 432128,
      "primary_message": "When the tofu is done, remove from the oven. Carefully flip, then spread the tops with the mayo mixture. Return to the oven and continue to broil until topping is browned, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 432129,
      "primary_message": "To serve, divide tofu and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
