  "instructions": [
    {
      "id": 432095,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven. Line a large baking sheet pan with aluminum foil (for easier cleanup), coat with thin layer of oil, and set aside.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 432096,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 medium zucchini squash\n3 lemons"
    },
    {
      "id": 432097,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 432098,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Add to the bowl with the broccoli and set aside.",
      "secondary_message": null
    },
    {
      "id": 432099,
      "primary_message": "Juice lemons into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 432100,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the lemon juice along with mayo and spices; stir to combine and set aside.",
      "secondary_message": "3 oz Parmesan cheese\n¾ cup mayonnaise\n¾ tsp basil, dried\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 432101,
      "primary_message": "Pat tilapia dry with paper towels, place on the baking sheet, and drizzle with oil. Place fish in the oven and broil until almost cooked through, about 4 minutes.",
      "secondary_message": "2 ¼ lb tilapia fillet\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 432102,
      "primary_message": "Meanwhile, preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 432103,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add broccoli, zucchini, pine nuts, salt, and pepper; cook, stirring often, until veggies are tender-crisp, 7-8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ cup pine nuts\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 432104,
      "primary_message": "When the fish is almost cooked through, remove from the oven. Spread the mayo mixture over the fillets. Return to the oven and continue to broil until topping is browned and fish is cooked through, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 432105,
      "primary_message": "To serve, divide fish and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
