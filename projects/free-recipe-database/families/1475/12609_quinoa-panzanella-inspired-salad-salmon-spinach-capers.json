  "instructions": [
    {
      "id": 212818,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 212819,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 pints grape tomatoes\n1 ½ English cucumbers\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 212820,
      "primary_message": "Peel and mince garlic. Transfer to a large bowl along with oil, vinegar, salt, and pepper; whisk to combine dressing.",
      "secondary_message": "3 cloves garlic\n⅓ cup extra virgin olive oil\n⅓ cup red wine vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 212821,
      "primary_message": "Peel and small dice onions; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 212822,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212823,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 212824,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 212825,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place on a large plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb salmon fillet\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 212826,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 212827,
      "primary_message": "Working in batches if necessary, place salmon, skin-side down, in the skillet. Cook, flipping once, until the flesh is opaque and flaky, 3-5 minutes per side; remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 212828,
      "primary_message": "Meanwhile, transfer the cooked quinoa to a large baking sheet pan, spread out in an even layer, and cool for 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 212829,
      "primary_message": "Remove skin from salmon and use a fork to break the fillets into bite-sized chunks.",
      "secondary_message": null
    },
    {
      "id": 212830,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the veggies, along with capers and cooled quinoa. Stir to combine the salad.",
      "secondary_message": "6 tbsp capers"
    },
    {
      "id": 212831,
      "primary_message": "To serve, divide spinach, quinoa salad, and flaked salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
