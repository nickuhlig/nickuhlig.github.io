  "instructions": [
    {
      "id": 212832,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 212833,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg grape tomatoes\n½ English cucumber\n½ small pkg fresh basil\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 212834,
      "primary_message": "Peel and mince garlic. Transfer to a medium bowl along with oil, vinegar, salt, and pepper; whisk to combine dressing.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 212835,
      "primary_message": "Peel and small dice onion; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 212836,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212837,
      "primary_message": "Trim and medium dice cucumber; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 212838,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 212839,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg salmon fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 212840,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 212841,
      "primary_message": "Place salmon, skin-side down, in the skillet. Cook, flipping once, until the flesh is opaque and flaky, 3-5 minutes per side; remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 212842,
      "primary_message": "Meanwhile, transfer the cooked quinoa to a baking sheet pan, spread out in an even layer, and cool for 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 212843,
      "primary_message": "Remove skin from salmon and use a fork to break the fillet into bite-sized chunks.",
      "secondary_message": null
    },
    {
      "id": 212844,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the veggies, along with capers and cooled quinoa. Stir to combine the salad.",
      "secondary_message": "2 tbsp capers"
    },
    {
      "id": 212845,
      "primary_message": "To serve, divide spinach, quinoa salad, and flaked salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
