  "instructions": [
    {
      "id": 212846,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n473 ml chicken or vegetable broth"
    },
    {
      "id": 212847,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 small pkgs grape tomatoes\n1 English cucumber\n1 small pkg fresh basil\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 212848,
      "primary_message": "Peel and mince garlic. Transfer to a large bowl along with oil, vinegar, salt, and pepper; whisk to combine dressing.",
      "secondary_message": "2 cloves garlic\n¼ cup extra virgin olive oil\n¼ cup red wine vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 212849,
      "primary_message": "Peel and small dice onion; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 212850,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212851,
      "primary_message": "Trim and medium dice cucumber; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 212852,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 212853,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg salmon fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 212854,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 212855,
      "primary_message": "Place salmon, skin-side down, in the skillet. Cook, flipping once, until the flesh is opaque and flaky, 3-5 minutes per side; remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 212856,
      "primary_message": "Meanwhile, transfer the cooked quinoa to a baking sheet pan, spread out in an even layer, and cool for 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 212857,
      "primary_message": "Remove skin from salmon and use a fork to break the fillets into bite-sized chunks.",
      "secondary_message": null
    },
    {
      "id": 212858,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the veggies, along with capers and cooled quinoa. Stir to combine the salad.",
      "secondary_message": "4 tbsp capers"
    },
    {
      "id": 212859,
      "primary_message": "To serve, divide spinach, quinoa salad, and flaked salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
