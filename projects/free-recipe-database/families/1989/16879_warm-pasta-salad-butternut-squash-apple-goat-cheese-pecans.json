  "instructions": [
    {
      "id": 274917,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 274918,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 Gala apples\n1 ½ small butternut squash\n1 small pkg fresh thyme"
    },
    {
      "id": 274919,
      "primary_message": "Quarter and core apples, then cut each quarter into ¾-inch cubes; divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 274920,
      "primary_message": "Trim, peel, and halve each squash lengthwise; scrape out seeds and cut into ¾-inch cubes. Add to the baking sheets with the apple.",
      "secondary_message": null
    },
    {
      "id": 274921,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Sprinkle leaves over the apple and squash, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 274922,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until apple and squash are golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 274923,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse in a colander.",
      "secondary_message": "1 ½ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 274924,
      "primary_message": "While the pasta is cooking, place oil, vinegar, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 274925,
      "primary_message": "Peel and mince garlic and shallots; add both to the bowl with the dressing. Stir to combine and set aside.",
      "secondary_message": "3 cloves garlic\n2 shallots"
    },
    {
      "id": 274926,
      "primary_message": "Roughly chop pecans and set aside.",
      "secondary_message": "1 cup pecans, dry roasted"
    },
    {
      "id": 274927,
      "primary_message": "When the apple, squash, and pasta are done, add to the bowl with the dressing; gently stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 274928,
      "primary_message": "To serve, divide warm pasta salad between plates or bowls. Crumble goat cheese over top and sprinkle with pecans. Enjoy!",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    }
  ],
