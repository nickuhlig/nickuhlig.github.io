  "instructions": [
    {
      "id": 1,
      "primary_message": "Place onions and scallions in a bowl, cover with cold water, add 6 ice cubes, and place in refrigerator until ready to use, at least 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine garlic, pepper flakes, and Thai chiles in a mortar and pestle and pound into a fine paste. Add sugar, fish sauce, and lime juice, and pound until the sugar is dissolved. Taste dressing and add more sugar, fish sauce, lime juice, or pepper flakes to taste. It should be strongly spicy, sweet, salty, and acidic.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine tomatoes, bean sprouts, pork rinds, mint, cilantro, and dressing in a large bowl and toss to combine. Carefully drain onions and scallions. Add to bowl and toss to combine. Serve immediately.",
      "secondary_message": null
    }
  ],
