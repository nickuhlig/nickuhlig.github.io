  "instructions": [
    {
      "id": 154316,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 154317,
      "primary_message": "Wash, peel, and slice potatoes into ¼-inch thick strips. Place on a baking sheet and toss with oil and salt. ",
      "secondary_message": "2 medium yellow potatoes\n2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 154318,
      "primary_message": "Spread potatoes out in a single layer and place in the oven (it doesn't have to be fully heated). Roast until golden brown, tossing once halfway through, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 154319,
      "primary_message": "Meanwhile, peel and thinly slice onion. Peel and mince garlic. Transfer both to a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 154320,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 154321,
      "primary_message": "Thinly slice steak against the grain. Add steak and salt to the bowl with the onion and toss to combine. ",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp salt"
    },
    {
      "id": 154322,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom. Add steak mixture and cook, stirring often, until steak is browned and cooked to desired doneness, 4-6 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 154323,
      "primary_message": "Meanwhile, wash and dry bell pepper and mushrooms. On a clean cutting board, thinly slice the mushrooms and pepper. ",
      "secondary_message": "1 red bell pepper\n0.23 kg cremini mushrooms"
    },
    {
      "id": 154324,
      "primary_message": "When the steak is done, transfer to a medium bowl and cover with aluminum foil. Return skillet to medium heat; add oil, peppers, and mushrooms. Cook, stirring often, until veggies are browned, 5-7 minutes. Add veggies to the bowl with the steak.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 154325,
      "primary_message": "In a small bowl, make a slurry by whisking broth with cornstarch until smooth.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n2 tsp cornstarch"
    },
    {
      "id": 154326,
      "primary_message": "Return skillet to medium-high heat; add the cornstarch slurry, additional broth, Worcestershire sauce, pepper, and any juices from the bowl with the steak. Cook, whisking constantly, until slightly thickened, 2-3 minutes.",
      "secondary_message": "355 ml chicken or vegetable broth\n2 tsp Worcestershire sauce\n⅛ tsp black pepper"
    },
    {
      "id": 154327,
      "primary_message": "Slice cheese. ",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 154328,
      "primary_message": "Split buns in half and place on a baking sheet pan, cut-side facing up. Layer cheese over bottom buns. Place in the oven and toast until bread is golden brown, and cheese is melted, 2-3 minutes.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 154329,
      "primary_message": "Divide steak and veggies between bottom buns, drizzle with warm sauce and top with the other half of the bun. Serve with fries and remaining sauce on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
