  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon. Mince the gloves garlic. Cut the beef sirloin tips into 1 1/2-inch cubes. Clean and halve the cremini mushrooms.",
      "secondary_message": "½ lemon\n3 gloves garlic\n1 ½ lb beef sirloin tips\n8 oz cremini mushrooms"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together oil, Worcestershire sauce, soy sauce, lemon juice, mustard, garlic, brown sugar, and black pepper. Place beef cubes and mushrooms in a large resealable plastic bag. Add marinade and seal bag, pressing out as much air as possible, and moving bag as needed to ensure meat is well coated in the marinade. Refrigerate for at least 1 hour and up to 5 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Thread beef onto skewers, alternating with mushrooms and onions.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For a charcoal grill, light one chimney full of charcoal. When all charcoal is lit and covered with gray ash, pour out and spread coals evenly over entire surface of coal grate. Alternatively, set all the burners of a gas grill to high heat. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Grill skewers until beef is well seared on all sides and center of beef registers between 125-130°F (52-54°C) on an instant read thermometer, about 3 minutes per side. Transfer skewers to platter and let rest for 5 to 10 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
