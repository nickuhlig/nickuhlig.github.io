  "instructions": [
    {
      "id": 326779,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium red potatoes\n3 medium carrots\n3 red bell peppers\n3 green bell peppers"
    },
    {
      "id": 326780,
      "primary_message": "Peel and small dice potatoes.",
      "secondary_message": null
    },
    {
      "id": 326781,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 326782,
      "primary_message": "Once the pot is hot, add potatoes and ground beef; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1.02 kg lean ground beef"
    },
    {
      "id": 326783,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 326784,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the carrot.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 326785,
      "primary_message": "When the beef is done, add veggies to the pot; continue to cook, stirring occasionally, until starting to soften, 8-10 minutes more.",
      "secondary_message": null
    },
    {
      "id": 326786,
      "primary_message": "While the veggies are cooking, trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 326787,
      "primary_message": "When the veggies are starting to soften, add bell peppers to the pot along with tomato sauce, raisins, soy sauce, and spices. Stir to combine, cover, and bring to a simmer.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 cup raisins\n3 tbsp soy sauce\n¾ tsp salt\n¾ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 326788,
      "primary_message": "Once simmering, reduce heat to medium and cook, stirring occasionally, until the veggies are tender and liquid is mostly absorbed, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 326789,
      "primary_message": "To serve, divide sauté between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
