  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium red potatoes\n2 medium carrots\n2 red bell peppers\n2 green bell peppers"
    },
    {
      "primary_message": "Peel and small dice potatoes.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add potatoes and ground beef; cook, breaking the meat apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the carrot.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "primary_message": "When the beef is done, add veggies to the skillet; continue to cook, stirring occasionally, until starting to soften, 6-7 minutes more.",
      "secondary_message": null
    },
    {
      "primary_message": "While the veggies are cooking, trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "primary_message": "When the veggies are starting to soften, add bell peppers to the skillet along with tomato sauce, raisins, soy sauce, and spices. Stir to combine, cover, and bring to a simmer.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n⅔ cup raisins\n½ tsp salt\n½ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "primary_message": "Once simmering, reduce heat to medium and cook, stirring occasionally, until the veggies are tender and liquid is mostly absorbed, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide skillet between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
