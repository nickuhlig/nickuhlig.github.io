  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and quarter new potatoes. Place in a medium bowl along with carrots, oil, and spices. Stir to combine, transfer to a large baking sheet pan, and spread out in an even layer. (Reserve bowl for later use.) ",
      "secondary_message": "454 g new potatoes\n1 (454 g) pkg baby carrots\n2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are starting to soften, about 15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place mayo, dressing, salt, and pepper in the reserved bowl. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp mayonnaise\n2 tbsp ranch dressing\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Add to the bowl with the sauce and turn to coat.",
      "secondary_message": "454 g chicken breasts, boneless skinless"
    },
    {
      "primary_message": "When the veggies are starting to soften, remove from the oven, stir, and spread back out in an even layer. Add chicken to the baking sheet, nestling cutlets into the veggies.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Return baking sheet to the oven and continue to roast until chicken is cooked through and veggies are fork-tender, 15-20 minutes more. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, rinse peas under hot water (from the tap) to thaw and set aside.\n\n",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "primary_message": "When the chicken and veggies are done, remove chicken to a cutting board and slice into strips. Add peas to the baking sheet with the other veggies and stir to combine.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide chicken and veggies between plates. Drizzle with additional ranch and enjoy!",
      "secondary_message": "ranch dressing"
    }
  ],
