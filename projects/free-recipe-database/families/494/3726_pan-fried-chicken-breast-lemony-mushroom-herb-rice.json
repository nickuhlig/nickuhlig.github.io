  "instructions": [
    {
      "id": 40784,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb cremini mushrooms\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 40785,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 40786,
      "primary_message": "While the pan heats up, trim off and discard the ends of the shallots; peel and mince the shallots.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 40787,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 40788,
      "primary_message": "Once the pan is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 40789,
      "primary_message": "Add the shallots and garlic to the pan; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 40790,
      "primary_message": "While the shallots and garlic cook, thinly slice the mushrooms lengthwise from cap to stem.",
      "secondary_message": null
    },
    {
      "id": 40791,
      "primary_message": "Add the mushrooms to the pan and season with salt and pepper; cook, stirring frequently, until the mushrooms are tender and the liquid has evaporated, 5 to 7 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 40792,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 40793,
      "primary_message": "While the skillet heats up, pat the chicken breasts dry with paper towels and place on a plate; generously season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 40794,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 40795,
      "primary_message": "Carefully place the chicken breasts in the skillet; cook until the chicken is golden brown and cooked through (check doneness with a thermometer or cut into the chicken with a knife), 6 to 8 minutes per side. Once done, transfer the chicken to plate and tent with foil to keep warm.",
      "secondary_message": null
    },
    {
      "id": 40796,
      "primary_message": "Once the mushrooms are tender, add the rice and broth to the pan; stir and scrape up any browned bits from the bottom. Bring the mixture to a boil, then reduce the heat to low, cover, and simmer for 15-18 minutes.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 40797,
      "primary_message": "While the chicken and rice cook, zest and juice the lemon; transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 40798,
      "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the bowl with the lemon zest and juice.",
      "secondary_message": null
    },
    {
      "id": 40799,
      "primary_message": "Once the rice is cooked, add the lemon zest, juice, parsley, and olive oil; stir to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 40800,
      "primary_message": "To serve, divide the rice and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
