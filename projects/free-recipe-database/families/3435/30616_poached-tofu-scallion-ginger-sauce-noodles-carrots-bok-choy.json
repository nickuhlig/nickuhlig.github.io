  "instructions": [
    {
      "id": 486091,
      "primary_message": "Cut tofu in half along the short side to make 2 smaller \"blocks.\" Place in a medium saucepan and cover with hot water (from the tap). Bring to a boil over high heat. Once boiling, reduce to a simmer and cook until tofu is warmed through, about 15 minutes.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 486092,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 486093,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ small bunch green onions (scallions)\n4 baby bok choy\n2 medium carrots"
    },
    {
      "id": 486094,
      "primary_message": "Once the water in the pot is boiling, remove from heat. Carefully pour water into a medium, heat-proof bowl, and add rice noodles. Soak for 10 minutes (or prepare according to package instructions). Drain in a colander and set aside. (Reserve pot for later use.)",
      "secondary_message": "142 g flat rice (pad thai) noodles"
    },
    {
      "id": 486095,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 486096,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the ginger and garlic along with soy sauce, oil, sugar, and crushed red pepper. Stir to combine the sauce and set aside.",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp toasted sesame oil\n1 tsp brown sugar\n½ tsp crushed red pepper"
    },
    {
      "id": 486097,
      "primary_message": "Trim and separate bok choy into leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 486098,
      "primary_message": "Peel and trim carrots; run the peeler along each carrot to make long, noodle-like strips. Add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 486099,
      "primary_message": "Return pot to medium-high heat. Once hot, add oil and swirl to coat the bottom; add bok choy, carrot, and soy sauce. Stir-fry until veggies are fork-tender, 3-4 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n1 tbsp soy sauce"
    },
    {
      "id": 486100,
      "primary_message": "Add drained noodles to the pot and stir to combine. Continue to cook, stirring occasionally, until warmed through, 1 minute more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 486101,
      "primary_message": "To serve, divide noodles and veggies between bowls. Top with poached tofu and drizzle with sauce. Enjoy!",
      "secondary_message": null
    }
  ],
