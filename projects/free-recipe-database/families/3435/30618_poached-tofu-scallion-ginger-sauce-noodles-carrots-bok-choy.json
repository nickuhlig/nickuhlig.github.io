  "instructions": [
    {
      "id": 486113,
      "primary_message": "Cut tofu in half along the short side to make 6 smaller \"blocks.\" Place in a large pot and cover with hot water (from the tap). Bring to a boil over high heat. Once boiling, reduce to a simmer and cook until tofu is warmed through, about 15 minutes.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 486114,
      "primary_message": "Meanwhile, fill another large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 486115,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n12 baby bok choy\n6 medium carrots"
    },
    {
      "id": 486116,
      "primary_message": "Once the water in the pot is boiling, remove from heat. Carefully pour water into a large, heat-proof bowl, and add rice noodles. Soak for 10 minutes (or prepare according to package instructions). Drain in a colander and set aside. (Reserve pot for later use.)",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 486117,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 486118,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the ginger and garlic along with soy sauce, oil, sugar, and crushed red pepper. Stir to combine the sauce and set aside.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp toasted sesame oil\n1 tbsp brown sugar\n1 ½ tsp crushed red pepper"
    },
    {
      "id": 486119,
      "primary_message": "Trim and separate bok choy into leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 486120,
      "primary_message": "Peel and trim carrots; run the peeler along each carrot to make long, noodle-like strips. Add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 486121,
      "primary_message": "Return pot to medium-high heat. Once hot, add oil and swirl to coat the bottom; add bok choy, carrot, and soy sauce. Stir-fry until veggies are fork-tender, 4-5 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil\n3 tbsp soy sauce"
    },
    {
      "id": 486122,
      "primary_message": "Add drained noodles to the pot and stir to combine. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 486123,
      "primary_message": "To serve, divide noodles and veggies between bowls. Top with poached tofu and drizzle with sauce. Enjoy!",
      "secondary_message": null
    }
  ],
