  "instructions": [
    {
      "id": 601766,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n4 sticks celery\n1 small bunch asparagus"
    },
    {
      "id": 601767,
      "primary_message": "Peel, trim, and medium dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 601768,
      "primary_message": "Trim and medium dice celery. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 601769,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut into 1-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601770,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601771,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 601772,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until the veggies are softened, 4-5 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 601773,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 601774,
      "primary_message": "When the veggies are softened, add flour to the pot. Continue to cook, stirring constantly, until veggies are well coated, about 1 minute.",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 601775,
      "primary_message": "Add broth and milk to the pot; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until soup thickens slightly, 6-8 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "946 ml chicken or vegetable broth\n237 ml whole milk"
    },
    {
      "id": 601776,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601777,
      "primary_message": "While the skillet heats up, place half of the bread slices on a flat surface. Top with Parmesan, then season with pepper. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "8 slices whole grain bread\n1 tsp black pepper"
    },
    {
      "id": 601778,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 601779,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Once done, transfer to a cutting board and slice in half.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 601780,
      "primary_message": "Divide soup between bowls and serve with sandwiches on the side. Enjoy!",
      "secondary_message": null
    }
  ],
