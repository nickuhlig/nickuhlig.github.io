  "instructions": [
    {
      "id": 601751,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n½ small bunch asparagus"
    },
    {
      "id": 601752,
      "primary_message": "Peel, trim, and medium dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 601753,
      "primary_message": "Trim and medium dice celery. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 601754,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut into 1-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601755,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601756,
      "primary_message": "While the pan heats up, peel, halve, and medium dice onion. Add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 601757,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until the veggies are softened, 4-5 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 601758,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 601759,
      "primary_message": "When the veggies are softened, add flour to the pan. Continue to cook, stirring constantly, until veggies are well coated, about 1 minute.",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 601760,
      "primary_message": "Add broth and milk to the pan; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until soup thickens slightly, 6-8 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "473 ml chicken or vegetable broth\n118 ml (½ cup) whole milk"
    },
    {
      "id": 601761,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601762,
      "primary_message": "While the skillet heats up, place half of the bread slices on a flat surface. Top with Parmesan, then season with pepper. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "4 slices whole grain bread\n½ tsp black pepper"
    },
    {
      "id": 601763,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 601764,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Once done, transfer to a cutting board and slice in half.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 601765,
      "primary_message": "Divide soup between bowls and serve with sandwiches on the side. Enjoy!",
      "secondary_message": null
    }
  ],
