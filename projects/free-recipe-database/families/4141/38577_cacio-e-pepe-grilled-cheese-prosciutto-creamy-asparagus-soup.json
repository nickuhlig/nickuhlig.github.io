  "instructions": [
    {
      "id": 601556,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n1 ½ small bunches asparagus"
    },
    {
      "id": 601557,
      "primary_message": "Peel, trim, and medium dice carrots. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 601558,
      "primary_message": "Trim and medium dice celery. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 601559,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut into 1-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601560,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601561,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 601562,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until the veggies are softened, 5-6 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 601563,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "9 oz Parmesan cheese"
    },
    {
      "id": 601564,
      "primary_message": "When the veggies are softened, add flour to the pot. Continue to cook, stirring constantly, until veggies are well coated, 1-2 minutes.",
      "secondary_message": "⅓ cup all-purpose flour"
    },
    {
      "id": 601565,
      "primary_message": "Add broth and milk to the pot; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until soup thickens slightly, 6-8 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n12 fl oz (1 ½ cups) whole milk"
    },
    {
      "id": 601566,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601567,
      "primary_message": "While the skillet heats up, place half of the bread slices on a flat surface. Top with Parmesan, season with pepper, then layer with prosciutto. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "12 slices whole grain bread\n1 ½ tsp black pepper\n12 slices prosciutto"
    },
    {
      "id": 601568,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 601569,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Once done, transfer to a cutting board and slice in half.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 601570,
      "primary_message": "Divide soup between bowls and serve with sandwiches on the side. Enjoy!",
      "secondary_message": null
    }
  ],
