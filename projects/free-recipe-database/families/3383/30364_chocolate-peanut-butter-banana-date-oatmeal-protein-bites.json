  "instructions": [
    {
      "id": 483571,
      "primary_message": "Preheat oven to 175°C (350°F). Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 483572,
      "primary_message": "Peel banana, break into chunks, and place in a medium bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "1 banana"
    },
    {
      "id": 483573,
      "primary_message": "Roughly chop dates. Add to the bowl with the banana along with egg, peanut butter, and maple syrup. Stir to combine.",
      "secondary_message": "¼ cup medjool dates, pitted\n1 egg\n3 tbsp natural peanut butter\n1 tbsp pure maple syrup"
    },
    {
      "id": 483574,
      "primary_message": "Add oats, protein powder, cocoa powder, cinnamon, and salt to the bowl. Stir once more to combine the batter.",
      "secondary_message": "¾ cup oats, quick cooking\n1 serving vanilla whey-based protein powder (containing 20 grams protein/serving)\n1 tbsp cocoa powder\n¼ tsp cinnamon, ground\n1 pinch salt"
    },
    {
      "id": 483575,
      "primary_message": "Using a ¼-cup measure, scoop batter onto the baking sheet, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 483576,
      "primary_message": "Allow to cool for a few minutes before transferring to plates. Enjoy!",
      "secondary_message": null
    }
  ],
