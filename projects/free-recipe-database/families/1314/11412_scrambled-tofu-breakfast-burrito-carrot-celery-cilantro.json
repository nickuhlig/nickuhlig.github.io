  "instructions": [
    {
      "id": 192185,
      "primary_message": "Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 192186,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 192187,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 192188,
      "primary_message": "While the skillet heats up, peel and small dice onions.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 192189,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until slightly softened, about 6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 192190,
      "primary_message": "Meanwhile, peel and coarsely grate carrots. Trim and mince celery. Add both to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 192191,
      "primary_message": "Peel and mince garlic; add to the skillet.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 192192,
      "primary_message": "Crumble the tofu with your fingers into the skillet. Add soy sauce and spices; increase heat to medium-high and continue to cook, stirring often, until veggies are soft and tofu begins to brown, 7-8 minutes more. Remove from heat.",
      "secondary_message": "⅓ cup soy sauce\n2 ½ tsp turmeric\n2 ½ tsp curry powder\n2 ½ tsp cumin\n2 ½ tsp paprika"
    },
    {
      "id": 192193,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 192194,
      "primary_message": "Juice lime into the skillet; add cilantro and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 192195,
      "primary_message": "Place tortillas on a flat surface, spread with mayo and top with tofu scramble. Tightly roll to close and cut in half. Enjoy! ",
      "secondary_message": "6 large flour tortillas\n2 tbsp vegan mayonnaise"
    }
  ],
