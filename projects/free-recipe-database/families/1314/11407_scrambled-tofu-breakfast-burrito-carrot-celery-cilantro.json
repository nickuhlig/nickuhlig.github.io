  "instructions": [
    {
      "id": 192130,
      "primary_message": "Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 192131,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 192132,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 192133,
      "primary_message": "While the skillet heats up, peel and small dice onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 192134,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until slightly softened, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 192135,
      "primary_message": "Meanwhile, peel and coarsely grate carrot. Trim and mince celery. Add both to the skillet and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 192136,
      "primary_message": "Peel and mince garlic; add to the skillet.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 192137,
      "primary_message": "Crumble the tofu with your fingers into the skillet. Add soy sauce and spices; increase heat to medium-high and continue to cook, stirring often, until veggies are soft and tofu begins to brown, about 5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp soy sauce\n¾ tsp turmeric\n¾ tsp curry powder\n¾ tsp cumin\n¾ tsp paprika"
    },
    {
      "id": 192138,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 192139,
      "primary_message": "Juice lime into the skillet; add cilantro and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 192140,
      "primary_message": "Place tortillas on a flat surface, spread with mayo and top with tofu scramble. Tightly roll to close and cut in half. Enjoy! ",
      "secondary_message": "2 large flour tortillas\n2 tsp mayonnaise"
    }
  ],
