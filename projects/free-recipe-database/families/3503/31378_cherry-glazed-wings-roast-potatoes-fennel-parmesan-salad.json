  "instructions": [
    {
      "id": 495744,
      "primary_message": "Preheat oven to 260°C (500°F).",
      "secondary_message": null
    },
    {
      "id": 495745,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg new potatoes\n½ lemon\n1 fennel bulb\n2 sticks celery"
    },
    {
      "id": 495746,
      "primary_message": "Halve new potatoes. Transfer to one half of a baking sheet pan, drizzle with oil, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495747,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Add to the other half of the baking sheet, drizzle with oil, toss to coat, and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken wings, split with tips removed\n2 tsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 495748,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing potatoes and turning chicken halfway, until potatoes are tender and wings are cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 495749,
      "primary_message": "Meanwhile, juice lemon into a clean medium bowl. Add oil, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 495750,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 495751,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 495752,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and gently toss to combine the salad. Set aside.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 495753,
      "primary_message": "Rinse cherries under hot water (from the tap) to thaw. Place in a blender along with ketchup, vinegar, hot sauce, and spices. Blend on high until smooth, 1-2 minutes. (Add water, 1 tablespoon at a time, if needed, to reach a drizzling consistency.) Set sauce aside.",
      "secondary_message": "½ cup frozen cherries\n2 tbsp ketchup\n2 tsp apple cider vinegar\n2 tsp hot sauce\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 495754,
      "primary_message": "When the potatoes and chicken are done, remove from oven. Drizzle wings with sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 495755,
      "primary_message": "To serve, divide potatoes, saucy wings, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
