  "instructions": [
    {
      "id": 495699,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": null
    },
    {
      "id": 495700,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n1 ½ lemons\n3 fennel bulbs\n6 sticks celery"
    },
    {
      "id": 495701,
      "primary_message": "Halve new potatoes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 495702,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Transfer to another large baking sheet, drizzle with oil, toss to coat, and spread out in an even layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed\n2 tbsp cornstarch\n¾ tsp salt\n½ tsp black pepper\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 495703,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing potatoes and turning chicken halfway, until potatoes are tender and wings are cooked through, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 495704,
      "primary_message": "Meanwhile, juice lemons into a clean large bowl. Add oil, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 495705,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 495706,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 495707,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and gently toss to combine the salad. Set aside.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 495708,
      "primary_message": "Rinse cherries under hot water (from the tap) to thaw. Place in a blender along with ketchup, vinegar, hot sauce, and spices. Blend on high until smooth, 1-2 minutes. (Add water, a few tablespoons at a time, if needed, to reach a drizzling consistency.) Set sauce aside.",
      "secondary_message": "1 ½ cup frozen cherries\n⅓ cup ketchup\n2 tbsp apple cider vinegar\n2 tbsp hot sauce\n¾ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495709,
      "primary_message": "When the potatoes and chicken are done, remove from oven. Drizzle wings with sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 495710,
      "primary_message": "To serve, divide potatoes, saucy wings, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
