  "instructions": [
    {
      "id": 409952,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil over medium-high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of cooking water before draining and set aside.)",
      "secondary_message": "1 ½ tsp salt\n425 g penne pasta"
    },
    {
      "id": 409953,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "9 medium zucchini squash\n1 ½ lemons\n1 small pkg fresh basil"
    },
    {
      "id": 409954,
      "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into ¼-inch thick pieces. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 409955,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 409956,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 409957,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring frequently, until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 409958,
      "primary_message": "Add zucchini and salt to the pot with the onion. Continue to cook, stirring occasionally, until zucchini is tender, 8-10 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 409959,
      "primary_message": "Meanwhile, zest and juice lemons into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 409960,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl with the lemon. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 409961,
      "primary_message": "Finely grate Parmesan. Add half to the bowl along with the ricotta and spices. Stir to combine. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "170 g Parmesan cheese\n1 ½ (425 g) pkgs ricotta cheese\n¾ tsp salt\n¾ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 409962,
      "primary_message": "When the zucchini is done, add pasta, reserved pasta water, and ricotta mixture to the pot. Continue to cook, stirring occasionally, until the sauce coats the pasta and Parmesan has melted, about 3 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 409963,
      "primary_message": "To serve, divide the pasta between plates or bowls; top with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
