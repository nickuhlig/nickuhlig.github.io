  "instructions": [
    {
      "id": 409928,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil over medium-high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ½-cup of cooking water before draining and set aside.)",
      "secondary_message": "½ tsp salt\n142 g penne pasta"
    },
    {
      "id": 409929,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 medium zucchini squash\n½ lemon\n½ small pkg fresh basil"
    },
    {
      "id": 409930,
      "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into ¼-inch thick pieces. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 409931,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 409932,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 409933,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring frequently, until starting to soften, 2-3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 409934,
      "primary_message": "Add zucchini and salt to the skillet. Continue to cook, stirring occasionally, until zucchini is tender, 6-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 409935,
      "primary_message": "Meanwhile, zest and juice lemon into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 409936,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl with the lemon. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 409937,
      "primary_message": "Finely grate Parmesan. Add half to the bowl along with the ricotta and spices. Stir to combine. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "57 g Parmesan cheese\n½ (425 g) pkg ricotta cheese\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 409938,
      "primary_message": "When the zucchini is done, add pasta, reserved pasta water, and ricotta mixture to the skillet. Continue to cook, stirring occasionally, until the sauce coats the pasta and Parmesan has melted, about 2 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 409939,
      "primary_message": "To serve, divide the pasta between plates or bowls; top with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
