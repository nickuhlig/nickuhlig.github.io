  "instructions": [
    {
      "id": 1,
      "primary_message": "Pat chicken wings dry with paper towels. Place wings in a large bowl and sprinkle with baking powder and salt, tossing to coat evenly. Arrange wings in a single layer on wire rack placed over a baking sheet. Refrigerate uncovered for at least 8 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together soy sauce, honey, hoisin sauce, garlic, ginger, five-spice powder, and sesame oil. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Alternatively, set half the burners on a gas grill to medium-high heat, cover, and preheat for 10 minutes. Clean and oil the grilling grate. Place the wings skin side up over the cool side of the grill, cover, and cook until skins are crisp and are starting to brown, 30 to 40 minutes. Brush wings all over with glaze. Move wings to hot side of grill and cook until browned all over, about 3 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer wings to a platter. Garnish with scallions and sesame seeds. Serve immediately.",
      "secondary_message": null
    }
  ],
