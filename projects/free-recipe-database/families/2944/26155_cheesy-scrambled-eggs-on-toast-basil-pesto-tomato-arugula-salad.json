  "instructions": [
    {
      "id": 417042,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n½ small pkg grape tomatoes\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 417043,
      "primary_message": "Mince pine nuts and place in a small bowl.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 417044,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add to the bowl with the pine nuts.",
      "secondary_message": null
    },
    {
      "id": 417045,
      "primary_message": "Add oil and spices to the bowl, then stir to combine the pesto. Add water, 1 teaspoon at a time, if needed, to make a spreadable consistency. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder"
    },
    {
      "id": 417046,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp balsamic vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 417047,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 417048,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 417049,
      "primary_message": "Finely grate Parmesan. Set aside for the eggs.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 417050,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 417051,
      "primary_message": "While the skillet heats up, crack eggs into another medium bowl, then season with salt and pepper. Whisk until smooth.",
      "secondary_message": "4 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 417052,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 417053,
      "primary_message": "Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove from heat, add Parmesan, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 417054,
      "primary_message": "Meanwhile, halve the tomatoes and add to the bowl with the dressing along with the arugula. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 417055,
      "primary_message": "To serve, divide salad and toast between plates. Spread toast with pesto and top with cheesy scrambled eggs. Enjoy!",
      "secondary_message": null
    }
  ],
