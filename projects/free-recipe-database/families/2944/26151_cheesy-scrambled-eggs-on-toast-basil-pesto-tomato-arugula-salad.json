  "instructions": [
    {
      "id": 416986,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 small pkgs fresh basil\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 416987,
      "primary_message": "Mince pine nuts and place in a small bowl.",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 416988,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add to the bowl with the pine nuts.",
      "secondary_message": null
    },
    {
      "id": 416989,
      "primary_message": "Add oil and spices to the bowl, then stir to combine the pesto. Add water, 1 teaspoon at a time, if needed, to make a spreadable consistency. Set aside.",
      "secondary_message": "⅓ cup extra virgin olive oil\n½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 416990,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 416991,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 416992,
      "primary_message": "Divide bread between two baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 416993,
      "primary_message": "Finely grate Parmesan. Set aside for the eggs.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 416994,
      "primary_message": "Crack eggs into another large bowl, then season with salt and pepper. Whisk until smooth.",
      "secondary_message": "12 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 416995,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 416996,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 416997,
      "primary_message": "Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove from heat, add Parmesan, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 416998,
      "primary_message": "Meanwhile, halve the tomatoes and add to the bowl with the dressing along with the arugula. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 416999,
      "primary_message": "To serve, divide salad and toast between plates. Spread toast with pesto and top with cheesy scrambled eggs. Enjoy!",
      "secondary_message": null
    }
  ],
