  "instructions": [
    {
      "id": 536459,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ yellow bell peppers\n3 crowns broccoli\n1 small pkg fresh basil"
    },
    {
      "id": 536460,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 536461,
      "primary_message": "Coarsely grate cheese. Place on a plate and set aside. ",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 536462,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 536463,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 536464,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 536465,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 536466,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until softened, 7-8 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 536467,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 536468,
      "primary_message": "Place eggs and spices in the reserved bowl, then whisk to combine.",
      "secondary_message": "18 eggs\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 536469,
      "primary_message": "Drain and thinly slice artichoke hearts and sun-dried tomatoes. Add both to the bowl with the egg.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated\n18 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 536470,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 536471,
      "primary_message": "When the veggies are done, add beans to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 536472,
      "primary_message": "Reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 536473,
      "primary_message": "Sprinkle cheese over frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 536474,
      "primary_message": "To serve, sprinkle frittata with reserved basil, then cut into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
