  "instructions": [
    {
      "id": 536379,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ yellow bell pepper\n1 crown broccoli\n½ small pkg fresh basil"
    },
    {
      "id": 536380,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 536381,
      "primary_message": "Coarsely grate cheese. Place on a plate and set aside. ",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 536382,
      "primary_message": "Trim, seed, and medium dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 536383,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 536384,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 536385,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 536386,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until softened, 6-7 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 536387,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 536388,
      "primary_message": "Place eggs and spices in the reserved bowl, then whisk to combine.",
      "secondary_message": "6 eggs\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 536389,
      "primary_message": "Drain and thinly slice artichoke hearts and sun-dried tomatoes. Add both to the bowl with the egg.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated\n6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 536390,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 536391,
      "primary_message": "When the veggies are done, add beans to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 536392,
      "primary_message": "Reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 536393,
      "primary_message": "Sprinkle cheese over frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 536394,
      "primary_message": "To serve, sprinkle frittata with reserved basil, then cut into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
