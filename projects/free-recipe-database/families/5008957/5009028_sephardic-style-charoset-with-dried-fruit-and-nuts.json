  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large saucepan, bring wine to a simmer over medium heat, then stir in fruit, cinnamon, and cloves. Cook uncovered until fruit is well hydrated and wine has been absorbed, about 5 minutes. Add salt to taste and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a food processor, roughly chop almonds in short pulses, about 6 one-second pulses. There should be no whole almonds remaining; a mix of large chunks and small crumbs is preferable. Remove almonds from food processor and transfer to a large mixing bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add fruit mixture to food processor and pulse until fruit just begins to come together into a paste, 3 to 5 one-second pulses. Do not overprocess—some chunks of fruit should be intact.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer fruit to mixing bowl and combine well with almonds. Stir in orange blossom water and additional salt if needed. Flavor of charoset will improve over time. Serve warm or at room temperature.",
      "secondary_message": null
    }
  ],
