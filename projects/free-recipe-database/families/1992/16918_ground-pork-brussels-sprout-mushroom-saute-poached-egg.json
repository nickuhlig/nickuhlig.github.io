  "instructions": [
    {
      "id": 275373,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg Brussels sprouts\n⅓ kg white mushrooms\n1 small pkg chives"
    },
    {
      "id": 275374,
      "primary_message": "Trim and thinly slice Brussels sprouts; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 275375,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the Brussels sprouts; set aside.",
      "secondary_message": null
    },
    {
      "id": 275376,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 275377,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 275378,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, pork, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg lean ground pork\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 275379,
      "primary_message": "While the pork is cooking, fill a large skillet about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the skillet is boiling, reduce heat to medium-low.",
      "secondary_message": "3 tbsp apple cider vinegar"
    },
    {
      "id": 275380,
      "primary_message": "When the pork is done, reduce heat to medium. Add Brussels sprouts, mushrooms, water, and Dijon to the pot; stir to combine, cover, and cook, undisturbed, until veggies are tender, 6-8 minutes.",
      "secondary_message": "¾ cup water\n1 tbsp Dijon mustard"
    },
    {
      "id": 275381,
      "primary_message": "Meanwhile, gently crack eggs into small bowls, 2 eggs per bowl.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 275382,
      "primary_message": "Adjust the heat of the skillet as necessary so that the water is simmering. Gently tip bowls into the skillet, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 275383,
      "primary_message": "While the eggs are poaching, mince the chives.",
      "secondary_message": null
    },
    {
      "id": 275384,
      "primary_message": "To serve, divide pork and veggie sauté between plates or bowls. Top with a poached egg, season with salt and pepper, then sprinkle with chives. Enjoy!",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    }
  ],
