  "instructions": [
    {
      "id": 364132,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 364133,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ oranges\n6 peaches\n3 avocados\n3 (142 g) pkg baby arugula\n3 (170 g) pkg blackberries"
    },
    {
      "id": 364134,
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic. Place both in a large bowl.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 364135,
      "primary_message": "Zest and juice oranges into the bowl with the onion and garlic. Add oil, Dijon, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 364136,
      "primary_message": "Halve peaches lengthwise (around the pit); twist halves to separate, then remove and discard pits. Wrap one slice of prosciutto around each peach half.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 364137,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 364138,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, place peaches on the grill, cut-side down. Cook, turning halfway through, until peaches are warmed through and prosciutto is golden and crispy, about 5 minutes. Remove to a large plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 364139,
      "primary_message": "Meanwhile, halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 364140,
      "primary_message": "Add cooked couscous, arugula, and blackberries to the bowl. Gently toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 364141,
      "primary_message": "To serve, divide salad and peaches between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    }
  ],
