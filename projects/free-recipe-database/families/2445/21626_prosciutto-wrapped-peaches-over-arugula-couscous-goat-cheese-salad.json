  "instructions": [
    {
      "id": 364062,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 364063,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 orange\n4 peaches\n2 avocados\n2 (5 oz) pkgs baby arugula\n2 (6 oz) pkgs blackberries"
    },
    {
      "id": 364064,
      "primary_message": "Peel and mince shallots and garlic; place both in a large bowl.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 364065,
      "primary_message": "Zest and juice orange into the bowl with the shallot and garlic. Add oil, Dijon, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 364066,
      "primary_message": "Halve peaches lengthwise (around the pit); twist halves to separate, then remove and discard pits. Wrap one slice of prosciutto around each peach half.",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 364067,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 364068,
      "primary_message": "Once the grill pan is hot, place peaches on the grill, cut-side down. Cook, turning halfway through, until peaches are warmed through and prosciutto is golden and crispy, about 5 minutes. Remove to a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 364069,
      "primary_message": "Meanwhile, halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 364070,
      "primary_message": "Add cooked couscous, arugula, and blackberries to the bowl. Gently toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 364071,
      "primary_message": "To serve, divide salad and peaches between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese"
    }
  ],
