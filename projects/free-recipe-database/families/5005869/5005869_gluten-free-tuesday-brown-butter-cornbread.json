  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position. Place a seasoned 12-inch cast iron skillet in the oven. Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "I small pot, melt butter over medium heat until golden brown, about 3 minutes. Do not overcook. Remove it from the heat and allow to cool for three minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In medium bowl, combine cornmeal, brown rice flour, baking powder, baking soda, and salt. Whisk to combine. Add buttermilk, eggs, maple syrup, and brown butter. Whisk until batter forms.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove cast iron skillet from oven. Spray with non-stick cooking spray or lightly brush bottom and sides of pan with with vegetable oil.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour batter into hot pan. Batter will sizzle when it hits pan. Return pan to oven. Bake for until cornbread is golden brown and toothpick inserted into center comes out clean, 18 to 22 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Allow to cool slightly, cut into pieces and serve. Cornbread is best the day it is made.",
      "secondary_message": null
    }
  ],
