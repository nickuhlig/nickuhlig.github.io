  "instructions": [
    {
      "id": 221779,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 221780,
      "primary_message": "Cut buns into 1-inch cubes, transfer to a baking sheet pan, and spread out in a single layer. Place in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until bread is dry but not toasted, about 5 minutes. Remove from oven and set aside to cool.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 221781,
      "primary_message": "Meanwhile, grease 4 muffin cups with a thick layer of butter; set aside.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 221782,
      "primary_message": "Place eggs, milk, cream, sugar, vanilla, nutmeg, and cinnamon in a large bowl; whisk until smooth. ",
      "secondary_message": "2 eggs\n118 ml (½ cup) whole milk\n118 ml (½ cup) heavy cream\n¼ cup granulated sugar\n½ tsp vanilla extract\n¼ tsp nutmeg, ground\n⅛ tsp cinnamon"
    },
    {
      "id": 221783,
      "primary_message": "Once the bread cubes have cooled, transfer to the bowl with the egg mixture. Using a silicone spatula, gently stir to combine, making sure all of the bread is submerged. Set aside for 10 minutes to soak.",
      "secondary_message": null
    },
    {
      "id": 221784,
      "primary_message": "Meanwhile, wash and dry the blueberries.",
      "secondary_message": "2 (170 g) pkg blueberries"
    },
    {
      "id": 221785,
      "primary_message": "Combine blueberries, maple syrup, and butter in a medium saucepan. Bring to a boil over high heat. Reduce to a simmer and cook, stirring occasionally, until blueberries soften and release their juices, 3-5 minutes. Remove from heat, cover, and set aside while you finish the bread pudding.",
      "secondary_message": "3 tbsp pure maple syrup\n4 tsp butter, unsalted"
    },
    {
      "id": 221786,
      "primary_message": "Spoon soaked bread into the prepared muffin cups, creating a mound of bread in the center of each cup. Divide remaining egg mixture between the cups, filling each to the rim.",
      "secondary_message": null
    },
    {
      "id": 221787,
      "primary_message": "Carefully place the muffin pan in the oven. Cook, rotating the pan halfway through baking, until bread puddings puff up to double their size, and custard is set, about 30 minutes. Remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 221788,
      "primary_message": "Slide a knife down and around the side of each pudding to loosen. Holding the muffin pan over a baking sheet pan, carefully invert, and tap the pan to loosen the puddings.",
      "secondary_message": null
    },
    {
      "id": 221789,
      "primary_message": "To serve, divide blueberry sauce, bread pudding, and ice cream between bowls. Enjoy!",
      "secondary_message": "355 ml vanilla ice cream"
    }
  ],
