  "instructions": [
    {
      "id": 514155,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 fennel bulbs\n2 medium carrots\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 514156,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 514157,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and medium dice.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 514158,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper; cook, stirring occasionally, until cooked through and golden, 4-5 minutes. Remove to a plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 514159,
      "primary_message": "Meanwhile, using a clean cutting board, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 514160,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 514161,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 514162,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onion. Add to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 514163,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 7-8 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 514164,
      "primary_message": "Meanwhile, return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add orzo and cook, stirring frequently, until golden and toasted, 3-4 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n170 g orzo pasta"
    },
    {
      "id": 514165,
      "primary_message": "When the veggies are soft, add chicken, toasted orzo, broth, and tomatoes to the pot. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook until orzo is tender, 8-10 minutes. Remove from heat.",
      "secondary_message": "1893 ml chicken or vegetable broth\n2 (398 ml) cans diced tomatoes"
    },
    {
      "id": 514166,
      "primary_message": "While the soup is cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 514167,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
