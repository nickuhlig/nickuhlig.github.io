  "instructions": [
    {
      "id": 514103,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 fennel bulb\n1 medium carrot\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 514104,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 514105,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and medium dice.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 514106,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper; cook, stirring occasionally, until cooked through and golden, 4-5 minutes. Remove to a plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 514107,
      "primary_message": "Meanwhile, using a clean cutting board, trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 514108,
      "primary_message": "Peel, trim, and slice carrot crosswise into ¼-inch thick rounds. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 514109,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 514110,
      "primary_message": "While the pan heats up, peel, halve, and medium dice onion. Add to the bowl with the other veggies.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 514111,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 7-8 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 514112,
      "primary_message": "Meanwhile, return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add orzo and cook, stirring frequently, until golden and toasted, 3-4 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n3 oz orzo pasta"
    },
    {
      "id": 514113,
      "primary_message": "When the veggies are soft, add chicken, toasted orzo, broth, and tomatoes to the pan. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook until orzo is tender, 8-10 minutes. Remove from heat.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 514114,
      "primary_message": "While the soup is cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 514115,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
