  "instructions": [
    {
      "id": 514168,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 fennel bulbs\n3 medium carrots\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 514169,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 514170,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and medium dice.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 514171,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken, salt, and pepper; cook, stirring occasionally, until cooked through and golden, 4-5 minutes. Remove to a plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 514172,
      "primary_message": "Meanwhile, using a clean cutting board, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 514173,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 514174,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 514175,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onions. Add to the bowl with the other veggies.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 514176,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 8-10 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 514177,
      "primary_message": "Meanwhile, return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add orzo and cook, stirring frequently, until golden and toasted, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n255 g orzo pasta"
    },
    {
      "id": 514178,
      "primary_message": "When the veggies are soft, add chicken, toasted orzo, broth, and tomatoes to the pot. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook until orzo is tender, 8-10 minutes. Remove from heat.",
      "secondary_message": "2839 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes"
    },
    {
      "id": 514179,
      "primary_message": "While the soup is cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 514180,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
