  "instructions": [
    {
      "id": 501509,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 501510,
      "primary_message": "Meanwhile, place vinegar, maple syrup, and salt in a large bowl. Whisk to combine the pickling liquid and set aside.",
      "secondary_message": "3 tbsp rice vinegar\n1 tbsp pure maple syrup\n¾ tsp salt"
    },
    {
      "id": 501511,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 501512,
      "primary_message": "While the rice is cooking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 red bell peppers\n3 (2 ½ cm) pieces ginger root\n3 avocados\n1 ½ limes"
    },
    {
      "id": 501513,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 501514,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl and toss to combine; set aside.",
      "secondary_message": null
    },
    {
      "id": 501515,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 501516,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble tempeh into the skillet and cook, undisturbed, for 5-7 minutes. Using a spatula, carefully flip and continue to cook, undisturbed, until golden brown, 5-7 minutes more.",
      "secondary_message": "3 tbsp toasted sesame oil\n3 (227g ) pkgs tempeh"
    },
    {
      "id": 501517,
      "primary_message": "Meanwhile, peel and mince ginger. Place in a small bowl along with soy sauce, vinegar, maple syrup, and chili-garlic sauce. Whisk to combine the glaze.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp rice vinegar\n2 tbsp pure maple syrup\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 501518,
      "primary_message": "When the tempeh is done, add glaze to the skillet. Cook, stirring often, until glaze thickens, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 501519,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 501520,
      "primary_message": "Cut limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 501521,
      "primary_message": "To serve, divide rice, pickled veggies, and glazed tempeh between bowls. Top with avocado and lime. Enjoy!",
      "secondary_message": null
    }
  ],
