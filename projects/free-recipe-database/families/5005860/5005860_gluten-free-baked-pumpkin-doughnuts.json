  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°F. Spray a doughnut pan with nonstick cooking spray (see note). Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large bowl, whisk together millet flour, granulated sugar, oat flour, pumpkin pie spice, baking powder, salt, and xanthan gum. In small bowl, stir together pumpkin, eggs, vegetable oil, and orange juice until smooth. Pour pumpkin mixture over dry ingredients and whisk until no lumps remain.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake until doughnuts spring back to the touch, about 18 minutes. Turn doughnuts out onto a wire rack to cool. Repeat with remaining batter. Allow doughnuts to cool completely.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For the Coating: In a 9-inch square pan, stir together granulated sugar and ground cinnamon. One at a time, dredge the doughnuts in the sugar-cinnamon mixture. Shake off excess sugar. Store doughnuts, covered, on the counter for up to 3 days.",
      "secondary_message": null
    }
  ],
