  "instructions": [
    {
      "id": 203646,
      "primary_message": "Preheat oven to 205°C (400°F). Line two baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 203647,
      "primary_message": "Wash, dry, and slice mushrooms.",
      "secondary_message": "0.68 kg cremini mushrooms"
    },
    {
      "id": 203648,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 203649,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 203650,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 203651,
      "primary_message": "Add mushrooms and garlic to the pot; season with salt and pepper. Cook, stirring frequently, until the mushrooms are soft, 6-7 minutes.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 203652,
      "primary_message": "Meanwhile, wash, dry, and roughly chop spinach. (Skip washing if the spinach came pre-washed.)",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 203653,
      "primary_message": "Grate the cheeses.",
      "secondary_message": "1 (227 g) block mozzarella cheese\n1 (227 g) block cheddar cheese"
    },
    {
      "id": 203654,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove pot from heat.",
      "secondary_message": null
    },
    {
      "id": 203655,
      "primary_message": "To assemble the quesadillas, lay the tortillas on a flat surface; divide cheeses and veggie mixture between them, arranging the filling on one half of the tortilla.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 203656,
      "primary_message": "Fold tortillas in half and transfer to the baking sheets. Coat tops of the quesadillas with half the oil, carefully flip, and coat the other side with remaining oil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 203657,
      "primary_message": "Place quesadillas in the oven and bake for 5-7 minutes. Remove from the oven, carefully flip, and continue to bake until cheese is melted and tortillas are golden brown, 5-7 minutes more.",
      "secondary_message": null
    },
    {
      "id": 203658,
      "primary_message": "Cut quesadillas into wedges and divide between plates. Serve with a side of yogurt for dipping. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
