  "instructions": [
    {
      "id": 203620,
      "primary_message": "Preheat oven to 205°C (400°F). Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 203621,
      "primary_message": "Wash, dry, and slice mushrooms.",
      "secondary_message": "0.23 kg cremini mushrooms"
    },
    {
      "id": 203622,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 203623,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 203624,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 203625,
      "primary_message": "Add mushrooms and garlic to the skillet; season with salt and pepper. Cook, stirring frequently, until the mushrooms are soft, 4-5 minutes.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 203626,
      "primary_message": "Meanwhile, wash, dry, and roughly chop spinach. (Skip washing if the spinach came pre-washed.)",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 203627,
      "primary_message": "Grate the cheeses.",
      "secondary_message": "⅓ (227 g) block mozzarella cheese\n⅓ (227 g) block cheddar cheese"
    },
    {
      "id": 203628,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove skillet from heat.",
      "secondary_message": null
    },
    {
      "id": 203629,
      "primary_message": "To assemble the quesadillas, lay the tortillas on a flat surface; divide cheeses and veggie mixture between them, arranging the filling on one half of the tortilla.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 203630,
      "primary_message": "Fold tortillas in half and transfer to the baking sheet. Coat tops of the quesadillas with half the oil, carefully flip, and coat the other side with remaining oil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 203631,
      "primary_message": "Place quesadillas in the oven and bake for 5 minutes. Remove from the oven, carefully flip, and continue to bake until cheese is melted and tortillas are golden brown, 5-6 minutes more.",
      "secondary_message": null
    },
    {
      "id": 203632,
      "primary_message": "Cut quesadillas into wedges and divide between plates. Serve with a side of yogurt for dipping. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
