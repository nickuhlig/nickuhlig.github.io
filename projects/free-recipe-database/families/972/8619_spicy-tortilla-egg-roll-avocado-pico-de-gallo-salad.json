  "instructions": [
    {
      "id": 171066,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n1 ½ pints grape tomatoes\n1 ½ red bell peppers\n1 ½ small bunches cilantro\n1 ½ limes\n1 ½ avocados"
    },
    {
      "id": 171067,
      "primary_message": "Peel and mince garlic; transfer to a large bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 171068,
      "primary_message": "Trim cucumbers, then halve lengthwise and slice thinly crosswise. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 171069,
      "primary_message": "Halve grape tomatoes. Seed and slice bell peppers into thin strips; transfer both to the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 171070,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 171071,
      "primary_message": "Juice the limes into the bowl and season with salt and pepper. Stir to combine the salad, then set aside. ",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 171072,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 171073,
      "primary_message": "Crack the eggs into another medium bowl and season with salt and pepper; whisk together.",
      "secondary_message": "12 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 171074,
      "primary_message": "Once the skillet is hot, add the oil and swirl to coat the bottom. ",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 171075,
      "primary_message": "Pour one-sixth of the egg mixture (or about ⅓ cup) into the skillet and swirl to make an omelet the size of a tortilla. Let cook, undisturbed, for 30 seconds. Before the egg fully sets, place a tortilla on top and press down gently with a spatula. When egg is cooked, after about 1 minute, flip tortilla and cook for 30 seconds more; transfer to a plate and cover with aluminum foil.",
      "secondary_message": "1 large flour tortilla"
    },
    {
      "id": 171076,
      "primary_message": "Add more oil (½ tsp per tortilla) to the skillet and repeat with remaining egg mixture and tortillas.  ",
      "secondary_message": "2 ½ tsp extra virgin olive oil\n5 large flour tortillas"
    },
    {
      "id": 171077,
      "primary_message": "Meanwhile, halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 171078,
      "primary_message": "Lay the tortillas, egg-side-up, on a flat surface; divide the avocado, pico de gallo salad, and chili-garlic sauce between them. Roll tightly to close, then slice each roll in half. ",
      "secondary_message": "3 tbsp chili-garlic sauce"
    },
    {
      "id": 171079,
      "primary_message": "To serve, divide rolls between plates. Enjoy!",
      "secondary_message": null
    }
  ],
