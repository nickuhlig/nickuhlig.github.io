  "instructions": [
    {
      "id": 548135,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 548136,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 548137,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n0.45 kg sweet potato\n1 small bunch asparagus\n1 head butter (Boston) lettuce"
    },
    {
      "id": 548138,
      "primary_message": "Place mayo and spices in a large bowl, then stir to combine.",
      "secondary_message": "⅓ cup vegan mayonnaise\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 548139,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the mayo mixture.",
      "secondary_message": null
    },
    {
      "id": 548140,
      "primary_message": "Peel and halve sweet potatoes lengthwise, then cut crosswise into ¼-inch thick half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 548141,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut crosswise into 3-inch pieces. Add to the bowl and toss to combine. Add bread crumbs to the bowl, then gently toss once more to coat. Transfer veggies to a large baking sheet pan and spread out in an even layer; drizzle with oil.",
      "secondary_message": "1 cup panko bread crumbs\n2 tbsp neutral vegetable oil"
    },
    {
      "id": 548142,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until veggies are golden and fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 548143,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 548144,
      "primary_message": "While the skillet heats up, large dice tofu. Place in a medium bowl, along with cornstarch, and toss to coat.",
      "secondary_message": "2 tbsp cornstarch"
    },
    {
      "id": 548145,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes.",
      "secondary_message": "4 tsp neutral vegetable oil"
    },
    {
      "id": 548146,
      "primary_message": "Add chili-garlic sauce to the skillet and stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": "4 tsp chili-garlic sauce"
    },
    {
      "id": 548147,
      "primary_message": "Meanwhile, place soy sauce, additional chili-garlic sauce, and sugar in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "¼ cup soy sauce\n2 tsp chili-garlic sauce\n2 tsp brown sugar"
    },
    {
      "id": 548148,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with veggies and tofu. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
