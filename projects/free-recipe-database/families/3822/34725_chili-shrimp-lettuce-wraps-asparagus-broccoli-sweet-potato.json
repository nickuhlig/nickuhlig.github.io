  "instructions": [
    {
      "id": 548065,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 548066,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n0.68 kg sweet potato\n1 ½ small bunches asparagus\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 548067,
      "primary_message": "Place mayo and spices in a large bowl, then stir to combine.",
      "secondary_message": "½ cup mayonnaise\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 548068,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the mayo mixture.",
      "secondary_message": null
    },
    {
      "id": 548069,
      "primary_message": "Peel and halve sweet potatoes lengthwise, then cut crosswise into ¼-inch thick half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 548070,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut crosswise into 3-inch pieces. Add to the bowl and toss to combine. Add bread crumbs to the bowl, then gently toss once more to coat. Divide veggies between two large baking sheet pans and spread out in an even layer; drizzle with oil.",
      "secondary_message": "1 ½ cup panko bread crumbs\n3 tbsp neutral vegetable oil"
    },
    {
      "id": 548071,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until veggies are golden and fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 548072,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 548073,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 548074,
      "primary_message": "While the skillet heats up, place shrimp in a clean large bowl, along with cornstarch, and toss to coat.",
      "secondary_message": "3 tbsp cornstarch"
    },
    {
      "id": 548075,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp and cook, stirring occasionally, until just opaque and starting to color, 3-4 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 548076,
      "primary_message": "Add chili-garlic sauce to the skillet and stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": "2 tbsp chili-garlic sauce"
    },
    {
      "id": 548077,
      "primary_message": "Meanwhile, place soy sauce, additional chili-garlic sauce, and sugar in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup soy sauce\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar"
    },
    {
      "id": 548078,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with veggies and shrimp. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
