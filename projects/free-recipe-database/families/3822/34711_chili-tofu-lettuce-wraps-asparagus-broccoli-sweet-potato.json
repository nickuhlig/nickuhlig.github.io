  "instructions": [
    {
      "id": 547869,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 547870,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 547871,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n½ lb sweet potato\n½ small bunch asparagus\n½ head butter (Boston) lettuce"
    },
    {
      "id": 547872,
      "primary_message": "Place mayo and spices in a medium bowl, then stir to combine.",
      "secondary_message": "3 tbsp vegan mayonnaise\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 547873,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the mayo mixture.",
      "secondary_message": null
    },
    {
      "id": 547874,
      "primary_message": "Peel and halve sweet potato lengthwise, then cut crosswise into ¼-inch thick half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 547875,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut crosswise into 3-inch pieces. Add to the bowl and toss to combine. Add bread crumbs to the bowl, then gently toss once more to coat. Transfer veggies to another baking sheet and spread out in an even layer; drizzle with oil.",
      "secondary_message": "½ cup panko bread crumbs\n1 tbsp neutral vegetable oil"
    },
    {
      "id": 547876,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until veggies are golden and fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 547877,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 547878,
      "primary_message": "While the skillet heats up, large dice tofu. Place in a clean medium bowl, along with cornstarch, and toss to coat.",
      "secondary_message": "1 tbsp cornstarch"
    },
    {
      "id": 547879,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 547880,
      "primary_message": "Add chili-garlic sauce to the skillet and stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": "2 tsp chili-garlic sauce"
    },
    {
      "id": 547881,
      "primary_message": "Meanwhile, place soy sauce, additional chili-garlic sauce, and sugar in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp soy sauce\n1 tsp chili-garlic sauce\n1 tsp brown sugar"
    },
    {
      "id": 547882,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with veggies and tofu. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
