  "instructions": [
    {
      "id": 46465,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 46466,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ (142 g) pkg baby spinach\n0.227 kg white mushrooms"
    },
    {
      "id": 46467,
      "primary_message": "Trim off the discard the stem ends of the mushrooms; thinly slice the mushrooms lengthwise from cap to stem. Transfer to a bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 46468,
      "primary_message": "When the water in the saucepan comes to a boil, uncover the pan and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions). Once done, drain the pasta in a colander.",
      "secondary_message": "1 tbsp salt\n170 g (1 ⅓ cups) macaroni (elbow) pasta"
    },
    {
      "id": 46469,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 46470,
      "primary_message": "While the pan heats up, trim off and discard the ends of the shallot; peel and small dice the shallot (cut into 6-mm pieces).",
      "secondary_message": "1 shallot"
    },
    {
      "id": 46471,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 46472,
      "primary_message": "Add the shallots and mushrooms to the pan. Cook, stirring frequently, until the mushrooms release their water and begin to brown, 4 to 6 minutes.",
      "secondary_message": ""
    },
    {
      "id": 46473,
      "primary_message": "Sprinkle flour over the mushroom mixture and stir to combine.",
      "secondary_message": "1 tbsp all-purpose flour"
    },
    {
      "id": 46474,
      "primary_message": "Slowly pour the milk into the pan and stir to combine; season with salt and pepper and bring to a boil. Once boiling, reduce the heat to low and simmer until the sauce is thickened, 4 to 6 minutes.",
      "secondary_message": "177 ml (¾ cup) whole milk\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 46475,
      "primary_message": "Coarsely grate 1 cup of cheddar.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 46476,
      "primary_message": "Add the cheddar to the pan; stir until the cheese is melted and the sauce is smooth. Remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 46477,
      "primary_message": "Add the pasta and spinach to the pan; stir until the pasta is thoroughly coated with the sauce and the spinach is wilted.",
      "secondary_message": null
    },
    {
      "id": 46478,
      "primary_message": "To serve, divide the macaroni and cheese between plates or bowls and season with freshly ground pepper (if desired). Enjoy!",
      "secondary_message": null
    }
  ],
