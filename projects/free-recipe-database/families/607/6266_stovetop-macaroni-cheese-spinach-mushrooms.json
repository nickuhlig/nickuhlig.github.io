  "instructions": [
    {
      "id": 76270,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": ""
    },
    {
      "id": 76269,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ (5 oz) pkg baby spinach\n1 ½ lb white mushrooms"
    },
    {
      "id": 76282,
      "primary_message": "Trim off the discard the stem ends of the mushrooms; thinly slice the mushrooms lengthwise from cap to stem. Transfer to a bowl and set aside.",
      "secondary_message": ""
    },
    {
      "id": 76281,
      "primary_message": "When the water in the pot comes to a boil, uncover the pan and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions). Once done, drain the pasta in a colander.",
      "secondary_message": "3 tbsp salt\n18 oz (3 cups) macaroni (elbow) pasta"
    },
    {
      "id": 76280,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 76279,
      "primary_message": "While the pan heats up, trim off and discard the ends of the shallots; peel and small dice the shallots (cut into ¼-inch pieces).",
      "secondary_message": "3 shallots"
    },
    {
      "id": 76278,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 76277,
      "primary_message": "Add the shallots and mushrooms to the pan. Cook, stirring frequently, until the mushrooms release their water and begin to brown, 4 to 6 minutes.",
      "secondary_message": ""
    },
    {
      "id": 76276,
      "primary_message": "Sprinkle flour over the mushroom mixture and stir to combine.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 76275,
      "primary_message": "Slowly pour the milk into the pan and stir to combine; season with salt and pepper and bring to a boil. Once boiling, reduce the heat to low and simmer until the sauce is thickened, 4 to 6 minutes.",
      "secondary_message": "18 fl oz (2 ¼ cups) whole milk\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 76274,
      "primary_message": "Coarsely grate 3 cups of cheddar.",
      "secondary_message": "1 ½ (8 oz) block cheddar cheese"
    },
    {
      "id": 76273,
      "primary_message": "Add the cheddar to the pan; stir until the cheese is melted and the sauce is smooth. Remove from the heat.",
      "secondary_message": ""
    },
    {
      "id": 76272,
      "primary_message": "Add the pasta and spinach to the pan; stir until the pasta is thoroughly coated with the sauce and the spinach is wilted.",
      "secondary_message": ""
    },
    {
      "id": 76271,
      "primary_message": "To serve, divide the macaroni and cheese between plates or bowls and season with freshly ground pepper (if desired). Enjoy!",
      "secondary_message": ""
    }
  ],
