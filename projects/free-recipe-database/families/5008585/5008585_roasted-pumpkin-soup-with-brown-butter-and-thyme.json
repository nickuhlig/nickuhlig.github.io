  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely slice the yellow onion.",
      "secondary_message": "1 small yellow onion"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to lower-middle position and preheat oven to 375°F. Split pumpkins in half with a heavy chef's knife or cleaver. Scoop out seeds and discard or save for another use. Rub pumpkins on all surfaces with oil and season with salt and pepper. Place cut-side-down on a foil-lined rimmed baking sheet and place in oven. Scatter whole thyme stems on top. Roast until completely tender, flipping halfway through cooking, 1 to 1 1/2 hours total. Remove from oven and let rest until cool enough to handle.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, melt 2 tablespoons butter in a large Dutch oven over medium-high heat. Add leeks and onion and cook, stirring frequently, until softened but not browned, about 4 minutes. Add stock, bay leaves, and maple syrup and bring to a simmer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a large spoon, scoop flesh out of pumpkin and add it to the pot. Discard stem and skins. Let simmer for 15 minutes longer, then remove bay leaves and discard.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Purée soup in a blender in batches until completely smooth, straining through a fine-mesh strainer to catch any particles or fibers. Season soup to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "To serve, heat remaining 4 tablespoons butter in a small skillet over medium heat, swirling constantly, until foam subsides and butter takes on a deep brown color with a nutty aroma, about 1 minute. Remove from heat and add remaining tablespoon thyme leaves (they'll crackle as they hit the hot butter). Add lemon juice and season brown butter to taste with salt.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Ladle soup into serving bowls and drizzle with thyme brown butter. Serve immediately.",
      "secondary_message": null
    }
  ],
