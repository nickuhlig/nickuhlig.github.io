  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Chop the dark chocolate.",
      "secondary_message": "2 tbsp unsalted butter\n170 g dark chocolate"
    },
    {
      "id": 1,
      "primary_message": "To Make the Beignets: In a small saucepan, heat milk over medium-low heat until warm to the touch, then take off heat. Whisk in buttermilk, 1 teaspoon sugar, and yeast. Let stand 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together flour, baking soda, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour yeast mixture into a stand mixer fitted with a dough hook. Add flour mixture, remaining sugar, and butter to mixer. Mix until ingredients are combined and form a ball, then continue to let the mixer knead for 5 minutes. Cover bowl with a dish towel and let sit in a warm place for 40 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "On a lightly floured surface, roll dough out into a 1.5-cm thick rectangle. Cut dough into rectangles measuring approximately 1 by 5 cm.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Line 2 rimmed baking sheets with parchment paper. Place beignets on baking sheet, cover with a dish towel, and let rest 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Preheat oven to 200°C (400°F). Bake beignets until puffed and golden brown, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Fill a shallow dish with confectioners' sugar. While still hot, roll beignets in sugar to coat. When ready to serve beignets, roll or dust them with extra sugar.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "To Make the Sauce: In a medium saucepan, heat heavy cream over medium heat until simmering. Whisk in sugar. Take heavy cream off heat and whisk in chocolate until melted.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Whisk in salt, coffee, and vanilla extract. Serve warm with beignets.",
      "secondary_message": null
    }
  ],
