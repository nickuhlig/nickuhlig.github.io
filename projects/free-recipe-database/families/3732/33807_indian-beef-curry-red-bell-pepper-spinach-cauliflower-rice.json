  "instructions": [
    {
      "id": 534590,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 534591,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n3 (2 ½ cm) pieces ginger root\n1 ½ red bell peppers\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 534592,
      "primary_message": "Cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 534593,
      "primary_message": "Add oil, salt, and pepper to the bowl with the cauliflower, then stir to combine. Divide cauliflower rice between two baking sheet pans and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp neutral vegetable oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 534594,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower rice halfway through, until golden and tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 534595,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in the reserved bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 534596,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 534597,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 534598,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels, then cut into 1-inch cubes.",
      "secondary_message": "1.02 kg ribeye steak"
    },
    {
      "id": 534599,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, bell pepper, steak, and spices; cook, stirring occasionally, until the steak is golden brown and bell pepper is tender, 6-7 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 tbsp garam masala\n1 ½ tsp curry powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 534600,
      "primary_message": "Add water and almond flour to the skillet, then stir to combine the curry. Continue to cook, stirring often, until thickened, 4-5 minutes more.",
      "secondary_message": "1 cup water\n½ cup almond meal/flour"
    },
    {
      "id": 534601,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook until spinach is completely wilted, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 534602,
      "primary_message": "To serve, divide cauliflower rice and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
