  "instructions": [
    {
      "id": 534538,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 534539,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium head cauliflower\n2 (1 inch) pieces ginger root\n1 red bell pepper\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 534540,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 534541,
      "primary_message": "Add oil, salt, and pepper to the bowl with the cauliflower, then stir to combine. Transfer cauliflower rice to a large baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp neutral vegetable oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 534542,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower rice halfway through, until golden and tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 534543,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in the reserved bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 534544,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 534545,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 534546,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels, then cut into 1-inch cubes.",
      "secondary_message": "1 ½ lb ribeye steak"
    },
    {
      "id": 534547,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, bell pepper, steak, and spices; cook, stirring occasionally, until the steak is golden brown and bell pepper is tender, 5-6 minutes.",
      "secondary_message": "4 tsp neutral vegetable oil\n2 tsp garam masala\n1 tsp curry powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 534548,
      "primary_message": "Add water and almond flour to the skillet, then stir to combine the curry. Continue to cook, stirring often, until thickened, 3-4 minutes more.",
      "secondary_message": "¾ cup water\n⅓ cup almond meal/flour"
    },
    {
      "id": 534549,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook until spinach is completely wilted, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 534550,
      "primary_message": "To serve, divide cauliflower rice and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
