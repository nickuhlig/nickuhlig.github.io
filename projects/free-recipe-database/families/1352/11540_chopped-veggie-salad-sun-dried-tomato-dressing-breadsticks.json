  "instructions": [
    {
      "id": 221674,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 221675,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n2 medium carrots\n4 sticks celery\n1 English cucumber\n2 tomatoes\n1 head romaine lettuce\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 221676,
      "primary_message": "Peel and mince garlic. Mince the sun-dried tomatoes. Add both to a large salad bowl.",
      "secondary_message": "4 cloves garlic\n18 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 221677,
      "primary_message": "Zest and juice one lemon into the salad bowl. Thinly slice remaining lemon into rounds and set aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 221678,
      "primary_message": "Add oil, maple syrup, Dijon, and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp pure maple syrup\n1 ½ tsp Dijon mustard\n1 ½ tsp salt\n½ tsp oregano\n½ tsp black pepper"
    },
    {
      "id": 221679,
      "primary_message": "Drizzle 1 tbsp dressing over each flatbread, then cut into 1½-inch wide strips and place on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 221680,
      "primary_message": "Meanwhile, peel, halve, and thinly slice the onion. Peel and thinly slice carrots into rounds. Add both to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 221681,
      "primary_message": "Trim celery, then cut crosswise into ¼-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221682,
      "primary_message": "Trim and medium dice cucumber. Medium dice tomatoes; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221683,
      "primary_message": "Halve romaine leaves lengthwise, then thinly slice crosswise into shreds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221684,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221685,
      "primary_message": "Drain and rinse the beans; add to the bowl.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 221686,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl and toss to combine the salad.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 221687,
      "primary_message": "To serve, divide salad between plates. Serve with breadsticks and lemon slices. Enjoy! ",
      "secondary_message": null
    }
  ],
