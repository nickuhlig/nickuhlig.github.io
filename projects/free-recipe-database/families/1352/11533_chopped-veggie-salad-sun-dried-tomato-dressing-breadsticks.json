  "instructions": [
    {
      "id": 221576,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 221577,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 medium carrot\n2 sticks celery\n½ English cucumber\n1 tomato\n½ head romaine lettuce\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 221578,
      "primary_message": "Peel and mince garlic. Mince the sun-dried tomatoes. Add both to a large salad bowl.",
      "secondary_message": "2 cloves garlic\n9 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 221579,
      "primary_message": "Zest and juice half the lemon into the salad bowl. Thinly slice remaining lemon into rounds and set aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 221580,
      "primary_message": "Add oil, maple syrup, Dijon, and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp pure maple syrup\n¾ tsp Dijon mustard\n¾ tsp salt\n¼ tsp oregano\n¼ tsp black pepper"
    },
    {
      "id": 221581,
      "primary_message": "Drizzle 1 tbsp dressing over the flatbread, then cut into 1½-inch wide strips and place on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven.",
      "secondary_message": "1 flatbread or naan"
    },
    {
      "id": 221582,
      "primary_message": "Meanwhile, peel, halve, and thinly slice the onion. Peel and thinly slice carrot into rounds. Add both to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 221583,
      "primary_message": "Trim celery, then cut crosswise into ¼-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221584,
      "primary_message": "Trim and medium dice cucumber. Medium dice tomato; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221585,
      "primary_message": "Halve romaine leaves lengthwise, then thinly slice crosswise into shreds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221586,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221587,
      "primary_message": "Drain and rinse the beans; add to the bowl.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 221588,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl and toss to combine the salad.",
      "secondary_message": "½ (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 221589,
      "primary_message": "To serve, divide salad between plates. Serve with breadsticks and lemon slices. Enjoy! ",
      "secondary_message": null
    }
  ],
