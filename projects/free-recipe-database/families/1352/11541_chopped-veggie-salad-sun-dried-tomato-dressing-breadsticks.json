  "instructions": [
    {
      "id": 221688,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 221689,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n3 medium carrots\n6 sticks celery\n1 ½ English cucumbers\n3 tomatoes\n1 ½ heads romaine lettuce\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 221690,
      "primary_message": "Peel and mince garlic. Mince the sun-dried tomatoes. Add both to a large salad bowl.",
      "secondary_message": "6 cloves garlic\n27 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 221691,
      "primary_message": "Zest and juice 1½ lemons into the salad bowl. Thinly slice remaining lemon into rounds and set aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 221692,
      "primary_message": "Add oil, maple syrup, Dijon, and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "½ cup extra virgin olive oil\n2 ½ tsp pure maple syrup\n2 ½ tsp Dijon mustard\n2 ½ tsp salt\n¾ tsp oregano\n¾ tsp black pepper"
    },
    {
      "id": 221693,
      "primary_message": "Drizzle 1 tbsp dressing over each flatbread, then cut into 1½-inch wide strips and place on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 221694,
      "primary_message": "Meanwhile, peel, halve, and thinly slice the onion. Peel and thinly slice carrots into rounds. Add both to the bowl with the dressing.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 221695,
      "primary_message": "Trim celery, then cut crosswise into ¼-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221696,
      "primary_message": "Trim and medium dice cucumbers. Medium dice tomatoes; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221697,
      "primary_message": "Halve romaine leaves lengthwise, then thinly slice crosswise into shreds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221698,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 221699,
      "primary_message": "Drain and rinse the beans; add to the bowl.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 221700,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl and toss to combine the salad.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 221701,
      "primary_message": "To serve, divide salad between plates. Serve with breadsticks and lemon slices. Enjoy! ",
      "secondary_message": null
    }
  ],
