  "instructions": [
    {
      "id": 459355,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n0.45 kg cremini mushrooms\n1 small bunch green onions (scallions)"
    },
    {
      "id": 459356,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 459357,
      "primary_message": "Roughly chop mushrooms. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 459358,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 459359,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 459360,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 459361,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, turkey, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n0.68 kg ground turkey\n1 tsp chili powder\n½ tsp coriander, ground\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 459362,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 459363,
      "primary_message": "When the turkey is done, reduce heat to low and add cheese to the skillet. Continue to cook, stirring occasionally, until cheese is melted and combined, 2-3 minutes more. Remove from heat. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 459364,
      "primary_message": "Place tortillas on a flat surface and divide turkey filling down the center of each one. Fold in sides of tortillas and roll tightly to close the burritos.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 459365,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 459366,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Lay burritos, seam-side down, in the skillet; cook, rotating every 2-3 minutes, until golden brown and crispy on all sides. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 459367,
      "primary_message": "To serve, cut burritos in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
