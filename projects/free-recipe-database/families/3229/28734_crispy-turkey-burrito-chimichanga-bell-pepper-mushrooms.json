  "instructions": [
    {
      "id": 459368,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n0.68 kg cremini mushrooms\n1 small bunch green onions (scallions)"
    },
    {
      "id": 459369,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 459370,
      "primary_message": "Roughly chop mushrooms. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 459371,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 459372,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 459373,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 459374,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, turkey, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg ground turkey\n1 ½ tsp chili powder\n¾ tsp coriander, ground\n¾ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 459375,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 459376,
      "primary_message": "When the turkey is done, reduce heat to low and add cheese to the skillet. Continue to cook, stirring occasionally, until cheese is melted and combined, 3-4 minutes more. Remove from heat. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 459377,
      "primary_message": "Place tortillas on a flat surface and divide turkey filling down the center of each one. Fold in sides of tortillas and roll tightly to close the burritos.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 459378,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 459379,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Working in batches, lay burritos, seam-side down, in the skillet; cook, rotating every 2-3 minutes, until golden brown and crispy on all sides. Transfer to a plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 459380,
      "primary_message": "To serve, cut burritos in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
