  "instructions": [
    {
      "id": 459394,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n0.45 kg cremini mushrooms\n1 small bunch green onions (scallions)"
    },
    {
      "id": 459395,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 459396,
      "primary_message": "Roughly chop mushrooms. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 459397,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 459398,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 459399,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 459400,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add vegetables, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n1 tsp chili powder\n½ tsp coriander, ground\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 459401,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 459402,
      "primary_message": "When the veggie ground is done, reduce heat to low and add cheese to the skillet. Continue to cook, stirring occasionally, until cheese is melted and combined, 2-3 minutes more. Remove from heat. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 459403,
      "primary_message": "Place tortillas on a flat surface and divide veggie ground filling down the center of each one. Fold in sides of tortillas and roll tightly to close the burritos.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 459404,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 459405,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Lay burritos, seam-side down, in the skillet; cook, rotating every 2-3 minutes, until golden brown and crispy on all sides.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 459406,
      "primary_message": "To serve, cut burritos in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
