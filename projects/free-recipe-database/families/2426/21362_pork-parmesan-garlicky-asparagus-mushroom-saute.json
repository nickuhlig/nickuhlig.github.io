  "instructions": [
    {
      "id": 358592,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 358593,
      "primary_message": "Finely grate cheese and place half in a medium bowl. Add bread crumbs and spices to bowl, then stir to combine the coating. (Set remaining cheese aside for later use.)",
      "secondary_message": "85 g Parmesan cheese\n½ cup panko bread crumbs\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 358594,
      "primary_message": "Pat pork chops dry with paper towels. Place on a plate and spread both sides with mayo. Sprinkle the coating over both sides and press gently to adhere.",
      "secondary_message": "4 pork chops, boneless\n2 tbsp mayonnaise"
    },
    {
      "id": 358595,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 358596,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork chops and pan-fry until golden and almost cooked through, about 2 minutes per side. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 358597,
      "primary_message": "Pour tomato sauce over pork chops and sprinkle with reserved cheese.",
      "secondary_message": "2 (213 ml) cans tomato sauce"
    },
    {
      "id": 358598,
      "primary_message": "Place skillet in the oven (it doesn't have to be fully heated) and bake until pork is cooked through and cheese is melted, 6-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 358599,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms; place in a medium bowl.",
      "secondary_message": "0.45 kg cremini mushrooms"
    },
    {
      "id": 358600,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 358601,
      "primary_message": "While the skillet heats up, peel and mince garlic; add to the bowl with the mushrooms.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 358602,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and garlic; cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 358603,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears crosswise into 1-inch pieces.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 358604,
      "primary_message": "When the mushrooms are soft, add asparagus, salt, and pepper to the skillet. Continue to cook, stirring occasionally, until the veggies are fork-tender, 4-5 minutes more. Remove from heat.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 358605,
      "primary_message": "To serve, divide veggies, pork, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
