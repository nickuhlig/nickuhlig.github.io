  "instructions": [
    {
      "id": 358522,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 358523,
      "primary_message": "Finely grate cheese and place half in a medium bowl. Add bread crumbs and spices to bowl, then stir to combine the coating. (Set remaining cheese aside for later use.)",
      "secondary_message": "4 ½ oz Parmesan cheese\n¾ cup panko bread crumbs\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 358524,
      "primary_message": "Pat pork chops dry with paper towels. Place on a plate and spread both sides with mayo. Sprinkle the coating over both sides and press gently to adhere.",
      "secondary_message": "6 pork chops, boneless\n3 tbsp mayonnaise"
    },
    {
      "id": 358525,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 358526,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add pork chops and pan-fry until golden and almost cooked through, about 2 minutes per side. Transfer to a large baking dish.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 358527,
      "primary_message": "Return skillet to medium-high heat. Pour tomato sauce into the skillet and cook, stirring occasionally, until warmed through, 3-4 minutes. Pour sauce over pork chops in the baking dish and sprinkle with reserved cheese.",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 358528,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until pork is cooked through and cheese is melted, 6-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 358529,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms; place in a medium bowl.",
      "secondary_message": "1 ½ lb cremini mushrooms"
    },
    {
      "id": 358530,
      "primary_message": "Peel and mince garlic; add to the bowl with the mushrooms.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 358531,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 358532,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms and garlic; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 358533,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears crosswise into 1-inch pieces.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 358534,
      "primary_message": "When the mushrooms are soft, add asparagus, salt, and pepper to the pot. Continue to cook, stirring occasionally, until the veggies are fork-tender, 5-6 minutes more. Remove from heat.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 358535,
      "primary_message": "To serve, divide veggies, pork, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
