  "instructions": [
    {
      "id": 174706,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 174707,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 red bell peppers\n6 yellow bell peppers\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 174708,
      "primary_message": "Cut off the top ½-inch of each pepper; remove seeds, stems, and white membranes. Small dice remaining top portion of the peppers and set aside. Place the whole peppers on a large baking sheet pan and rub with oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 174709,
      "primary_message": "Peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 174710,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 174711,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add diced peppers, onion, garlic, and salt to the skillet; cook, stirring frequently, until softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 174712,
      "primary_message": "Meanwhile, drain and roughly chop artichokes.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 174713,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 174714,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 174715,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 174716,
      "primary_message": "Add artichokes, Parmesan, beans, and yogurt to the skillet. Stir to combine.",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 174717,
      "primary_message": "Fill peppers with equal portions of the bean mixture.",
      "secondary_message": null
    },
    {
      "id": 174718,
      "primary_message": "Grate mozzarella and sprinkle over the peppers. Place in the oven and bake until peppers are tender and cheese is melted, 16-18 minutes.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 174719,
      "primary_message": "To serve, divide peppers between plates and enjoy!",
      "secondary_message": null
    }
  ],
