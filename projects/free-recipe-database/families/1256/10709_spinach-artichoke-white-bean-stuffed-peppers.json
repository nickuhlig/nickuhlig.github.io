  "instructions": [
    {
      "id": 174734,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 174735,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 red bell peppers\n4 yellow bell peppers\n2 (142 g) pkg baby spinach"
    },
    {
      "id": 174736,
      "primary_message": "Cut off the top ½-inch of each pepper; remove seeds, stems, and white membranes. Small dice remaining top portion of the peppers and set aside. Place the whole peppers on a baking sheet pan and rub with oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 174737,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 174738,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 174739,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add diced peppers, onion, garlic, and salt to the skillet; cook, stirring frequently, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 174740,
      "primary_message": "Meanwhile, drain and roughly chop artichokes.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 174741,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 174742,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 174743,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 174744,
      "primary_message": "Add artichokes, Parmesan, beans, and yogurt to the skillet. Stir to combine.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 174745,
      "primary_message": "Fill peppers with equal portions of the bean mixture.",
      "secondary_message": null
    },
    {
      "id": 174746,
      "primary_message": "Grate mozzarella and sprinkle over the peppers. Place in the oven and bake until peppers are tender and cheese is melted, 15-17 minutes.",
      "secondary_message": "⅔ (227 g) block mozzarella cheese"
    },
    {
      "id": 174747,
      "primary_message": "To serve, divide peppers between plates and enjoy!",
      "secondary_message": null
    }
  ],
