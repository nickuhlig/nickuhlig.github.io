  "instructions": [
    {
      "id": 1,
      "primary_message": "Set oven rack to lower middle position and preheat oven to 95°C (200°F). Divide meat into four even 0.23 kg portions. Form into four 10-cm-wide patties, leaving slight depression in center of each. Season liberally with kosher salt and black pepper and place patties on wire rack set in rimmed baking sheet. Place in oven and cook until center of each patty registers 50°C (120°F) on an instant read thermometer for medium rare (44°C for rare, 57°C and up for medium well to well), 15 to 30 minutes (time may vary depending on oven temperature cycling). Tent burgers loosely with foil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add vegetable oil to 30-cm heavy-bottomed stainless steel or cast iron skillet and heat over high heat until smoking. Add burger patties and cook until browned crust develops on first side, 45 seconds to 1 minute 15 seconds. Flip patties. Add cheese if desired. Cook until second side develops dark brown crust, additional 45 seconds to 1 minute 15 seconds. Transfer to buns, top as desired, and serve immediately.",
      "secondary_message": null
    }
  ],
