  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lime. Chop the chipotle chilis. Tear the Oaxacan cheese into pieces. Shred the iceberg lettuce. Slice the tomato.",
      "secondary_message": "½ lime\n1 chipotle chilis, canned in adobo sauce, plus 1 tablespoon adobo sauce\n2 oz Oaxacan cheese\n½ cup iceberg lettuce\n1 small tomato"
    },
    {
      "id": 1,
      "primary_message": "Combine the mayonnaise, lime juice, chipotle pepper, and adobo sauce in a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place a large, non-stick skillet over medium heat. Add the chorizo to the pan, breaking it up with a wooden spoon, and cook until the chorizo is heated through, 3 to 5 minutes. Scrape the chorizo out of the pan and transfer to a large platter and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Return the pan to medium heat, then crack two eggs into the pan. Place a lid on the pan and cook the eggs until the whites are set, but the yolks are still runny, 3 to 4 minutes. There should be enough fat left from the chorizo to keep the eggs from sticking. Carefully transfer the eggs to another large platter and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cut the cemita rolls in half crosswise, then slather the chipotle mayo on each of the halves. Equally distribute the chorizo sausage among the two bottom halves of the bread. Layer the cheese, lettuce, tomato, and avocado on top of the chorizo. Place an egg on each bottom half, then top the sandwich with the remaining top halves. Serve immediately.",
      "secondary_message": null
    }
  ],
