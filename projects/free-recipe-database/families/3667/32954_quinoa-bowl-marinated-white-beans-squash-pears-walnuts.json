  "instructions": [
    {
      "id": 519537,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 519538,
      "primary_message": "In a medium saucepan, combine quinoa, broth, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n473 ml chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 519539,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n2 pears"
    },
    {
      "id": 519540,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 519541,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 519542,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 519543,
      "primary_message": "Zest and juice lemon into the bowl with the shallot.",
      "secondary_message": null
    },
    {
      "id": 519544,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil, salt, and pepper. Stir to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 519545,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing, stir to combine, and set aside to marinate.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 519546,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "⅔ cup walnuts"
    },
    {
      "id": 519547,
      "primary_message": "Quarter, core, and medium dice pears.",
      "secondary_message": null
    },
    {
      "id": 519548,
      "primary_message": "To serve, divide quinoa between bowls. Top with marinated beans, roasted squash, pear, and walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
