  "instructions": [
    {
      "id": 519474,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 519475,
      "primary_message": "In a medium saucepan, combine quinoa, broth, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 519476,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n3 pears"
    },
    {
      "id": 519477,
      "primary_message": "Trim and peel each squash; halve each lengthwise, scrape out the seeds, and medium dice the flesh. Transfer to a large baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 519478,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 519479,
      "primary_message": "Meanwhile, peel and mince shallots. Place in a medium bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 519480,
      "primary_message": "Zest and juice lemons into the bowl with the shallot.",
      "secondary_message": null
    },
    {
      "id": 519481,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil, salt, and pepper. Stir to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 519482,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing, stir to combine, and set aside to marinate.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 519483,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "1 cup walnuts"
    },
    {
      "id": 519484,
      "primary_message": "Quarter, core, and medium dice pears.",
      "secondary_message": null
    },
    {
      "id": 519485,
      "primary_message": "To serve, divide quinoa between bowls. Top with marinated beans, roasted squash, pear, and walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
