  "instructions": [
    {
      "id": 519486,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 519487,
      "primary_message": "In a small saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 519488,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small butternut squash\n½ lemon\n½ small bunch Italian (flat-leaf) parsley\n1 pear"
    },
    {
      "id": 519489,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 519490,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 519491,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a small bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 519492,
      "primary_message": "Zest and juice lemon into the bowl with the shallot.",
      "secondary_message": null
    },
    {
      "id": 519493,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil, salt, and pepper. Stir to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 519494,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing, stir to combine, and set aside to marinate.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 519495,
      "primary_message": "Roughly chop walnuts. Place on a plate.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 519496,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the plate with the walnuts.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 519497,
      "primary_message": "Quarter, core, and medium dice pear. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 519498,
      "primary_message": "To serve, divide quinoa between bowls. Top with marinated beans, roasted squash, pear, walnuts, and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
