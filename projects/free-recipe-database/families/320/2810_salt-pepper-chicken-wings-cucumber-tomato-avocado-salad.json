  "instructions": [
    {
      "id": 27240,
      "primary_message": "Preheat the oven to 260°C (500°F).",
      "secondary_message": ""
    },
    {
      "id": 27241,
      "primary_message": "In a large bowl, mix together salt and pepper.",
      "secondary_message": "2 tsp salt\r\n3 tsp black pepper"
    },
    {
      "id": 27242,
      "primary_message": "Add the chicken wings to the bowl and toss to coat.",
      "secondary_message": "0.908 kg chicken wings, split with tips removed\r\n"
    },
    {
      "id": 27243,
      "primary_message": "Transfer the wings to a baking sheet and spread out in a single layer. Place in the oven and, turning halfway through cooking time, bake until crispy, 20-25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 27244,
      "primary_message": "Wash the green onions, trim ends, and thinly slice on an angle. Peel and mince the garlic.",
      "secondary_message": "1 small bunch green onions (scallions)\r\n4 cloves garlic"
    },
    {
      "id": 27245,
      "primary_message": "In a small bowl, mix together the minced garlic, green onions, and sesame oil. Set aside.",
      "secondary_message": "2 tbsp toasted sesame oil\r\n"
    },
    {
      "id": 27246,
      "primary_message": "Wash the tomatoes and cucumber. Halve the tomatoes and transfer to a medium bowl. Medium dice the cucumber and add to the bowl.",
      "secondary_message": "1 small pkg grape tomatoes\r\n1 English cucumber"
    },
    {
      "id": 27247,
      "primary_message": "Peel and medium dice the onion and add to the bowl.",
      "secondary_message": "1 medium red onion\r\n"
    },
    {
      "id": 27248,
      "primary_message": "Halve and pit the avocados; scoop out the flesh with a spoon, medium dice, and add to the bowl.",
      "secondary_message": "2 avocados\r\n"
    },
    {
      "id": 27249,
      "primary_message": "Drizzle the salad with olive oil and season with salt and pepper. Toss to coat.",
      "secondary_message": "4 tbsp extra virgin olive oil\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 27250,
      "primary_message": "Once the chicken wings are cooked, add the sesame oil mixture over top and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 27251,
      "primary_message": "Serve the wings on a plate with salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
