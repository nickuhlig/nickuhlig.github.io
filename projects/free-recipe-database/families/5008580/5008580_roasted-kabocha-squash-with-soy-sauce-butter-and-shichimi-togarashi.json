  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to center position and preheat oven to 400°F. In a small saucepan or microwaveable bowl, combine soy sauce and butter and heat until melted. Place squash in a large bowl and drizzle with soy sauce/butter mixture and togarashi.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Spread the squash in an even layer on a parchment-lined, rimmed baking sheet. Make sure there is a bit of space between each piece so that they can brown and cook evenly from all sides.\nTransfer to oven and roast until tender and starting to brown gently, 20 to 25 minutes.\nSeason to taste with salt (if necessary) and serve immediately.",
      "secondary_message": null
    }
  ],
