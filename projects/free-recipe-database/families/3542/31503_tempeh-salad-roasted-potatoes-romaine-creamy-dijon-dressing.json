  "instructions": [
    {
      "id": 497440,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 497441,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n1 ½ English cucumbers\n3 heads romaine lettuce"
    },
    {
      "id": 497442,
      "primary_message": "Halve new potatoes lengthwise, then cut each half into ¼-inch thick wedges. Place in a large bowl, add oil and spices, then stir to coat. Transfer to a large baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 497443,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until potatoes are golden and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 497444,
      "primary_message": "Meanwhile, peel, halve, and mince onion; peel and mince garlic. Place both in the reserved bowl along with oil, mayo, Dijon, vinegar, sugar, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "½ medium red onion\n3 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp vegan mayonnaise\n2 tbsp Dijon mustard\n2 tbsp red wine vinegar\n¾ tsp brown sugar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 497445,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497446,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces and place in another medium bowl. Add soy sauce and spices, then gently stir to coat.",
      "secondary_message": "3 (8 oz) packages tempeh\n3 tbsp soy sauce\n1 ½ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 497447,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh in a single layer (leaving any excess sauce in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 497448,
      "primary_message": "Meanwhile, trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 497449,
      "primary_message": "When the potatoes are almost done, chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 497450,
      "primary_message": "To serve, divide salad and roasted potatoes between plates or bowls. Top salad with tempeh and enjoy!",
      "secondary_message": null
    }
  ],
