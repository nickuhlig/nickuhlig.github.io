  "instructions": [
    {
      "id": 497564,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 497565,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg new potatoes\n1 English cucumber\n2 heads romaine lettuce"
    },
    {
      "id": 497566,
      "primary_message": "Halve new potatoes lengthwise, then cut each half into ¼-inch thick wedges. Place in a large bowl, add oil and spices, then stir to coat. Transfer to a baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 497567,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until potatoes are golden and fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 497568,
      "primary_message": "Meanwhile, peel and mince shallots and garlic. Place both in the reserved bowl along with oil, mayo, Dijon, vinegar, sugar, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 shallots\n2 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp mayonnaise\n4 tsp Dijon mustard\n4 tsp red wine vinegar\n½ tsp brown sugar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 497569,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497570,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces and place in another medium bowl. Add soy sauce and spices, then gently stir to coat.",
      "secondary_message": "2 (227g ) pkgs tempeh\n2 tbsp soy sauce\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 497571,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh in a single layer (leaving any excess sauce in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 497572,
      "primary_message": "Meanwhile, trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 497573,
      "primary_message": "When the potatoes are almost done, chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 497574,
      "primary_message": "To serve, divide salad and roasted potatoes between plates or bowls. Top salad with tempeh and enjoy!",
      "secondary_message": null
    }
  ],
