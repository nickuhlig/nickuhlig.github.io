  "instructions": [
    {
      "id": 497373,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 497374,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n1 ½ English cucumbers\n3 heads romaine lettuce"
    },
    {
      "id": 497375,
      "primary_message": "Halve new potatoes lengthwise, then cut each half into ¼-inch thick wedges. Place in a large bowl, add oil and spices, then stir to coat. Transfer to a large baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 497376,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until potatoes are golden and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 497377,
      "primary_message": "Meanwhile, peel, halve, and mince onion; peel and mince garlic. Place both in the reserved bowl along with oil, mayo, Dijon, vinegar, sugar, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "½ medium red onion\n3 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp mayonnaise\n2 tbsp Dijon mustard\n2 tbsp red wine vinegar\n¾ tsp brown sugar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 497378,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497379,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 497380,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 497381,
      "primary_message": "Meanwhile, trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 497382,
      "primary_message": "When the potatoes are almost done, chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 497383,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 497384,
      "primary_message": "To serve, divide salad and roasted potatoes between plates or bowls. Top salad with steak and enjoy!",
      "secondary_message": null
    }
  ],
