  "instructions": [
    {
      "id": 497517,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 497518,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg new potatoes\n½ English cucumber\n1 head romaine lettuce"
    },
    {
      "id": 497519,
      "primary_message": "Halve new potatoes lengthwise, then cut each half into ¼-inch thick wedges. Place in a medium bowl, add oil and spices, then stir to coat. Transfer to a baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 497520,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until potatoes are golden and fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 497521,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. Place both in the reserved bowl along with oil, mayo, Dijon, vinegar, sugar, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 shallot\n1 clove garlic\n1 tbsp extra virgin olive oil\n1 tbsp mayonnaise\n2 tsp Dijon mustard\n2 tsp red wine vinegar\n¼ tsp brown sugar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 497522,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497523,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 497524,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 497525,
      "primary_message": "Meanwhile, trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 497526,
      "primary_message": "When the potatoes are almost done, chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 497527,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 497528,
      "primary_message": "To serve, divide salad and roasted potatoes between plates or bowls. Top salad with steak and enjoy!",
      "secondary_message": null
    }
  ],
