  "instructions": [
    {
      "id": 297604,
      "primary_message": "Preheat oven to 205°C (400°F). Coat a large baking dish with a thin layer of oil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 297605,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n1 green bell pepper\n1 English cucumber\n1 small pkg grape tomatoes\n1 head butter (Boston) lettuce"
    },
    {
      "id": 297606,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 297607,
      "primary_message": "Peel and mince garlic. Add to the bowl with the dill along with turkey, eggs, half the feta (reserving the rest for the yogurt sauce), bread crumbs, Dijon, and spices; mix with your hands until well combined.",
      "secondary_message": "2 cloves garlic\n0.68 kg ground turkey\n2 eggs\n1 (113 g) pkg crumbled feta cheese\n⅓ cup panko bread crumbs\n2 tsp Dijon mustard\n2 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 297608,
      "primary_message": "Using a rounded tablespoon measure, form the meat mixture into meatballs and place in the baking dish. Place meatballs in the oven and bake until cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297609,
      "primary_message": "While the meatballs are baking, peel and mince additional garlic. Place in a small bowl along with remaining feta, yogurt, water, salt, and pepper; whisk to combine the feta sauce. Set aside.",
      "secondary_message": "2 cloves garlic\n⅔ cup plain Greek yogurt\n2 tbsp water\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 297610,
      "primary_message": "Place oil, vinegar, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n¼ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 297611,
      "primary_message": "Peel, halve, and thinly slice shallot into half-moons. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 297612,
      "primary_message": "Trim, seed, and thinly slice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297613,
      "primary_message": "Trim and thinly slice cucumber crosswise into rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297614,
      "primary_message": "Halve tomatoes and olives. Add both to the bowl and toss to combine the salad.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 297615,
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with salad, meatballs, and feta sauce. Enjoy!",
      "secondary_message": null
    }
  ],
