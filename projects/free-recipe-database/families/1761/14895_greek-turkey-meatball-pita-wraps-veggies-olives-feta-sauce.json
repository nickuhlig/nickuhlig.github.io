  "instructions": [
    {
      "id": 297553,
      "primary_message": "Preheat oven to 205°C (400°F). Coat a baking dish with a thin layer of oil and set aside.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 297554,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch fresh dill\n½ green bell pepper\n½ English cucumber\n½ small pkg grape tomatoes"
    },
    {
      "id": 297555,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 297556,
      "primary_message": "Peel and mince garlic. Add to the bowl with the dill along with turkey, egg, half the feta (reserving the rest for the yogurt sauce), bread crumbs, Dijon, and spices; mix with your hands until well combined.",
      "secondary_message": "1 clove garlic\n⅓ kg ground turkey\n1 egg\n½ (113 g) pkg crumbled feta cheese\n3 tbsp panko bread crumbs\n1 tsp Dijon mustard\n1 tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 297557,
      "primary_message": "Using a rounded tablespoon measure, form the meat mixture into meatballs and place in the baking dish. Place meatballs in the oven and bake until cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297558,
      "primary_message": "While the meatballs are baking, peel and mince additional garlic. Place in a small bowl along with remaining feta, yogurt, water, salt, and pepper; whisk to combine the feta sauce. Set aside.",
      "secondary_message": "1 clove garlic\n⅓ cup plain Greek yogurt\n1 tbsp water\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 297559,
      "primary_message": "Place oil, vinegar, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1 tsp red wine vinegar\n⅛ tsp oregano, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 297560,
      "primary_message": "Peel, halve, and thinly slice shallot into half-moons. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 297561,
      "primary_message": "Trim, seed, and thinly slice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297562,
      "primary_message": "Trim and thinly slice cucumber crosswise into rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297563,
      "primary_message": "Halve tomatoes and olives. Add both to the bowl and toss to combine the salad.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 297564,
      "primary_message": "Slice each pita in half and carefully open them using your fingers.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 297565,
      "primary_message": "Divide pita, meatballs, salad, and feta sauce between plates. Fill pitas with fixings and enjoy!",
      "secondary_message": null
    }
  ],
