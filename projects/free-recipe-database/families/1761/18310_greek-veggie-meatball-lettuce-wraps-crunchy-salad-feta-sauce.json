  "instructions": [
    {
      "id": 297691,
      "primary_message": "Preheat oven to 205°C (400°F). Coat a large baking sheet pan with a thin layer of oil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 297692,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n1 ½ green bell peppers\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 297693,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 297694,
      "primary_message": "Peel and mince garlic. Add to the bowl with the dill along with veggie ground, eggs, half of the feta (reserving the rest for the yogurt sauce), bread crumbs, Dijon, and spices; mix with your hands until well combined.",
      "secondary_message": "3 cloves garlic\n680 g veggie ground, plant based\n3 eggs\n1 ½ (113 g) pkg crumbled feta cheese\n¾ cup panko bread crumbs\n1 tbsp Dijon mustard\n2 ½ tsp oregano, dried\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 297695,
      "primary_message": "Using a rounded tablespoon measure, form the mixture into \"meatballs\" and place on the baking sheet. Place in the oven and bake until cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297696,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a small bowl along with remaining feta, yogurt, water, salt, and pepper; whisk to combine the feta sauce. Set aside.",
      "secondary_message": "3 cloves garlic\n1 cup plain Greek yogurt\n3 tbsp water\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 297697,
      "primary_message": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 297698,
      "primary_message": "Peel, halve, and thinly slice shallots into half-moons. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 297699,
      "primary_message": "Trim, seed, and thinly slice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297700,
      "primary_message": "Trim and thinly slice cucumbers crosswise into rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297701,
      "primary_message": "Halve tomatoes and olives. Add both to the bowl and toss to combine the salad.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 297702,
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with salad, meatballs, and feta sauce. Enjoy!",
      "secondary_message": null
    }
  ],
