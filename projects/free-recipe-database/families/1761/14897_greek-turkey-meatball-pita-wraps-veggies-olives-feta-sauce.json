  "instructions": [
    {
      "id": 297579,
      "primary_message": "Preheat oven to 205°C (400°F). Coat a large baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 297580,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n1 ½ green bell peppers\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 297581,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 297582,
      "primary_message": "Peel and mince garlic. Add to the bowl with the dill along with turkey, eggs, half the feta (reserving the rest for the yogurt sauce), bread crumbs, Dijon, and spices; mix with your hands until well combined.",
      "secondary_message": "3 cloves garlic\n1.02 kg ground turkey\n3 eggs\n1 ½ (113 g) pkg crumbled feta cheese\n½ cup panko bread crumbs\n1 tbsp Dijon mustard\n1 tbsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 297583,
      "primary_message": "Using a rounded tablespoon measure, form the meat mixture into meatballs and place on the baking sheet. Place meatballs in the oven and bake until cooked through, about 18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297584,
      "primary_message": "While the meatballs are baking, peel and mince additional garlic. Place in a small bowl along with remaining feta, yogurt, water, salt, and pepper; whisk to combine the feta sauce. Set aside.",
      "secondary_message": "3 cloves garlic\n1 cup plain Greek yogurt\n3 tbsp water\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 297585,
      "primary_message": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 297586,
      "primary_message": "Peel, halve, and thinly slice onion into half-moons. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 297587,
      "primary_message": "Trim, seed, and thinly slice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297588,
      "primary_message": "Trim and thinly slice cucumbers crosswise into rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297589,
      "primary_message": "Halve tomatoes and olives. Add both to the bowl and toss to combine the salad.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 297590,
      "primary_message": "Slice each pita in half and carefully open them using your fingers.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 297591,
      "primary_message": "Divide pita, meatballs, salad, and feta sauce between plates. Fill pitas with fixings and enjoy!",
      "secondary_message": null
    }
  ],
