  "instructions": [
    {
      "id": 274837,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 274838,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 274839,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 274840,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n3 (2 ½ cm) pieces ginger root\n3 limes\n1 ½ red bell peppers\n1 small bunch green onions (scallions)\n1 small bunch cilantro"
    },
    {
      "id": 274841,
      "primary_message": "Peel and medium dice sweet potatoes; transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to combine, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper\n½ tsp coriander, ground\n½ tsp cumin, ground"
    },
    {
      "id": 274842,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing once, until sweet potatoes are fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 274843,
      "primary_message": "While the sweet potatoes are roasting, place edamame in a colander and rinse under hot water (from the tap) to thaw. Set aside to drain.",
      "secondary_message": "2 ¼ cups edamame"
    },
    {
      "id": 274844,
      "primary_message": "Peel and mince ginger and garlic; place both in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 274845,
      "primary_message": "Juice limes into the bowl with the ginger and garlic; add almond butter, water, and soy sauce. Whisk to combine the sauce, adding additional water, 1 tablespoon at a time, if necessary, to reach a drizzling consistency. Set sauce aside.",
      "secondary_message": "½ cup natural almond butter\n⅓ cup water\n1 ½ tbsp soy sauce"
    },
    {
      "id": 274846,
      "primary_message": "Trim, seed, and cut bell peppers into thin strips; transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 274847,
      "primary_message": "Trim and cut green onions crosswise into ¼-inch pieces; add to the plate with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 274848,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 274849,
      "primary_message": "When the rice is done, add cilantro and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 274850,
      "primary_message": "To serve, divide rice, roasted sweet potatoes, broccoli slaw, edamame, bell pepper, and green onions between bowls. Drizzle with sauce and enjoy! ",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    }
  ],
