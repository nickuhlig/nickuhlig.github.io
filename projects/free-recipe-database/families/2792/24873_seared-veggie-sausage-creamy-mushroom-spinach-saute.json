  "instructions": [
    {
      "id": 400554,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400555,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Transfer sausages to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp butter, unsalted\n6 pre-cooked vegan sausage"
    },
    {
      "id": 400556,
      "primary_message": "Meanwhile, place spinach in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "1 ½ (16oz) bags frozen chopped spinach"
    },
    {
      "id": 400557,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 400558,
      "primary_message": "While the pot heats up, peel, halve, and mince onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 400559,
      "primary_message": "Once the pot is hot, add additional butter and swirl to coat the bottom. Add onion and mushrooms; cook, stirring occasionally, until mushrooms soften, 3-4 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted\n3 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 400560,
      "primary_message": "Add spinach, cream, and spices to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook until spinach is warmed through and sauce thickens slightly, 2-3 minutes. Remove from heat. ",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 400561,
      "primary_message": "To serve, divide sausages and creamy veggie sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
