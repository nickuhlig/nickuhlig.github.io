  "instructions": [
    {
      "id": 400592,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400593,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Transfer sausages to a plate and loosely cover with foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp butter, unsalted\n2 pre-cooked vegan sausage"
    },
    {
      "id": 400594,
      "primary_message": "Meanwhile, place spinach in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "½ (454 g) bag frozen chopped spinach"
    },
    {
      "id": 400595,
      "primary_message": "Peel and mince shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 400596,
      "primary_message": "When the sausages are done, return skillet to medium heat. Add more butter and swirl to coat the bottom. Add shallot and mushrooms; cook, stirring occasionally, until mushrooms soften, 2-3 minutes. ",
      "secondary_message": "1 tsp butter, unsalted\n1 (227g ) pkg sliced white mushrooms"
    },
    {
      "id": 400597,
      "primary_message": "Add spinach, cream, and spices to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook until spinach is warmed through and sauce thickens slightly, 1-2 minutes. Remove from heat. ",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400598,
      "primary_message": "To serve, divide sausages and creamy veggie sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
