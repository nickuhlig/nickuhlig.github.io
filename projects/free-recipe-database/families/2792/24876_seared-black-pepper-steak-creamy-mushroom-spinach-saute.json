  "instructions": [
    {
      "id": 400582,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400583,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 400584,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 400585,
      "primary_message": "Meanwhile, place spinach in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "1 ½ (454 g) bags frozen chopped spinach"
    },
    {
      "id": 400586,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400587,
      "primary_message": "While the pot heats up, peel, halve, and mince onion. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 400588,
      "primary_message": "Once the pot is hot, add additional butter and swirl to coat the bottom. Add onion and mushrooms; cook, stirring occasionally, until mushrooms soften, 3-4 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted\n3 (227g ) pkg sliced white mushrooms"
    },
    {
      "id": 400589,
      "primary_message": "Add spinach, cream, and spices to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook until spinach is warmed through and sauce thickens slightly, 2-3 minutes. Remove from heat. ",
      "secondary_message": "355 ml heavy whipping cream\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 400590,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 400591,
      "primary_message": "To serve, divide steak and creamy veggie sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
