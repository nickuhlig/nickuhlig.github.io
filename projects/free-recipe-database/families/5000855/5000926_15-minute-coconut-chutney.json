  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small skillet over medium heat, heat ghee and chana dal. Toast dal until fragrant and golden. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a blender, combine coconut, hot water, tamarind paste, sugar, chile powder, and toasted chana dal. Blend until smooth, adding more water if needed to achieve a thick, hummus-like consistency. Season with kosher salt to taste. Transfer coconut chutney to a serving bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For Tempering: Heat ghee and urad dal in a small skillet over medium-high heat. Once dal is lightly toasted, add mustard seeds and asafetida and fry until seeds begin to pop. Pour entire mixture over chutney and serve immediately. The chutney will keep for 2 to 3 days in the refrigerator (see note).",
      "secondary_message": null
    }
  ],
