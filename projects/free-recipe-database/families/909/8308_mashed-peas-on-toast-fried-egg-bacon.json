  "instructions": [
    {
      "id": 173946,
      "primary_message": "Preheat a skillet over medium-high heat; add bacon and cook until crisp, 5-7 minutes. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 173947,
      "primary_message": "Meanwhile, peel and mince shallot and garlic.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 173948,
      "primary_message": "When the bacon is done, remove and set aside on a paper towel-lined plate. Transfer the bacon fat to a small bowl and set aside, leaving about 1 tbsp of fat in the skillet.",
      "secondary_message": null
    },
    {
      "id": 173949,
      "primary_message": "Return the skillet to medium-high heat; add shallots and garlic and cook, stirring occasionally, until softened, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 173950,
      "primary_message": "Add peas, water, and goat cheese to the skillet with the shallots; cook, stirring occasionally, until almost no liquid remains, about 5 minutes.",
      "secondary_message": "1 cup frozen peas\n2 tbsp water\n¼ (113 g) log goat cheese"
    },
    {
      "id": 173951,
      "primary_message": "Roughly chop the bacon and return to the plate.",
      "secondary_message": null
    },
    {
      "id": 173952,
      "primary_message": "Wash and juice lemon into a medium bowl.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 173953,
      "primary_message": "Add pea mixture to the bowl with the lemon juice and season with salt and pepper; mash until almost smooth.",
      "secondary_message": "⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 173954,
      "primary_message": "Wipe out skillet and put back on stove over medium heat.",
      "secondary_message": null
    },
    {
      "id": 173955,
      "primary_message": "Add 1 tablespoon of reserved bacon fat to the skillet and swirl to coat the bottom; gently crack eggs into skillet and cook until whites are set but yolks are still runny, about 3 minutes.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 173956,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 173957,
      "primary_message": "To serve, spread mashed peas over toast, top with bacon, egg, salt, and pepper. Enjoy!",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    }
  ],
