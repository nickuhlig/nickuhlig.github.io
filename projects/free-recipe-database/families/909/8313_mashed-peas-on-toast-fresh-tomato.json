  "instructions": [
    {
      "id": 174000,
      "primary_message": "Peel and mince shallots and garlic.",
      "secondary_message": "3 shallots\n3 cloves garlic"
    },
    {
      "id": 174001,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 174002,
      "primary_message": "Add oil and swirl to coat the bottom of the skillet; add shallots and garlic. Cook, stirring occasionally, until softened, about 2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 174003,
      "primary_message": "Add peas and water to pan; cook until almost no liquid remains, about 5 minutes.",
      "secondary_message": "3 cups frozen peas\n⅓ cup water"
    },
    {
      "id": 174004,
      "primary_message": "Wash and juice lemon into a medium bowl.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 174005,
      "primary_message": "Add pea mixture and mayonnaise to the bowl with the lemon juice; season with salt and pepper. Using a potato masher, mash until almost smooth.",
      "secondary_message": "3 tbsp vegan mayonnaise\n⅜ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 174006,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 174007,
      "primary_message": "Wash and slice tomato.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 174008,
      "primary_message": "To serve, spread mashed peas over toast, top with tomato, salt, and pepper. Enjoy!",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    }
  ],
