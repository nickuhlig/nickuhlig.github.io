  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, quarter, and core apple; slice into wedges. Place in the medium compartment of the bento box.",
      "secondary_message": "½ Gala apple"
    },
    {
      "primary_message": "Place carrots and crackers each in their own small compartments of the bento box. ",
      "secondary_message": "⅓ cup baby carrots\n⅓ cup cheese sandwich crackers"
    },
    {
      "primary_message": "Place mayo, vinegar, and spices in a small bowl, then whisk to combine the dressing. ",
      "secondary_message": "2 tbsp mayonnaise\n½ tsp apple cider vinegar\n¼ tsp basil, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Wash, dry, trim, and small dice celery. Add to the bowl with the dressing.\n\n",
      "secondary_message": "½ stick celery"
    },
    {
      "primary_message": "Roughly chop chicken, add to the bowl, and stir to combine the chicken salad. ",
      "secondary_message": "85 g cooked chicken"
    },
    {
      "primary_message": "Spread chicken salad over one slice of bread. Close sandwich with the remaining slice of bread, then cut in half. Place sandwich in the large compartment of the bento box. ",
      "secondary_message": "2 slice white bread"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
