  "instructions": [
    {
      "id": 236369,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 236370,
      "primary_message": "Place vinegar and sugar in a small saucepan over medium-high heat; stir until sugar is dissolved. Continue to cook, stirring often, until reduced by about half, or until thick enough to coat the back of a spoon, 10-15 minutes.",
      "secondary_message": "¼ cup balsamic vinegar\n1 ½ tsp brown sugar"
    },
    {
      "id": 236371,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 236372,
      "primary_message": "Coarsely chop bacon and transfer to the skillet. Cook, stirring occasionally, until crispy, 4-5 minutes.",
      "secondary_message": "2 slices bacon"
    },
    {
      "id": 236373,
      "primary_message": "While the bacon is cooking, peel, halve, and thinly slice onion into half rings.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 236374,
      "primary_message": "Using a slotted spoon, remove crispy bacon from the skillet and transfer to a small bowl (leave cooking liquids in the skillet).",
      "secondary_message": null
    },
    {
      "id": 236375,
      "primary_message": "Return skillet to medium-high heat; add onions and cook, stirring occasionally, until caramelized, about 7 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 236376,
      "primary_message": "Place flatbreads on a baking sheet pan and drizzle with oil; top each flatbread with crumbled goat cheese, bacon, and onion. Place baking sheet in the oven and bake until flatbread become golden and crispy, about 10 minutes.",
      "secondary_message": "2 flatbreads or naan\n1 tsp extra virgin olive oil\n½ (4 oz) log goat cheese"
    },
    {
      "id": 236377,
      "primary_message": "Meanwhile, wash and dry arugula (skip if it came pre-washed). Transfer arugula to a medium bowl along with oil, salt, and pepper; toss to combine the salad and set aside.",
      "secondary_message": "½ (5 oz) pkg baby arugula\n1 tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 236378,
      "primary_message": "Wash, dry, and slice lemon into wedges.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 236379,
      "primary_message": "When pizzas are done, remove from the oven; top each with a small handful of arugula salad and drizzle on balsamic glaze.",
      "secondary_message": null
    },
    {
      "id": 236380,
      "primary_message": "Divide pizzas and remaining arugula salad between plates. Serve with lemon wedges for squeezing over the salad. Enjoy!",
      "secondary_message": null
    }
  ],
