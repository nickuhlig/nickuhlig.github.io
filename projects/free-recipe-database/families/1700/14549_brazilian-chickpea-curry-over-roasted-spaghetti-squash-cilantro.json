  "instructions": [
    {
      "id": 343651,
      "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 343652,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium spaghetti squash\n3 green bell peppers\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 343653,
      "primary_message": "Trim off and discard ends of each squash; halve squash lengthwise and scrape out the seeds from each half. Rub the inside of the squash with oil and season with salt and pepper. Arrange the squash halves cut-side-down on the baking sheets.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 343654,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 343655,
      "primary_message": "Meanwhile, drain and rinse the chickpeas; transfer to a large pot.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 343656,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the pot with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 343657,
      "primary_message": "Add tomatoes, coconut milk, and spices to the pot; stir to combine the curry and bring to a boil over medium-high heat.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n1 ½ (13.5 fl oz) cans coconut milk\n2 tbsp paprika\n2 tbsp cumin, ground\n1 tbsp brown sugar\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n1 ½ tsp salt\n¾ tsp cayenne pepper"
    },
    {
      "id": 343658,
      "primary_message": "Once the curry is boiling, reduce to a simmer and cook, stirring occasionally, until slightly thickened, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 343659,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 343660,
      "primary_message": "Cut limes into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 343661,
      "primary_message": "Remove squash from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 343662,
      "primary_message": "To serve, divide squash and curry between plates; top with cilantro, yogurt, and a squeeze of lime. Enjoy!",
      "secondary_message": "1 cup plain Greek yogurt"
    }
  ],
