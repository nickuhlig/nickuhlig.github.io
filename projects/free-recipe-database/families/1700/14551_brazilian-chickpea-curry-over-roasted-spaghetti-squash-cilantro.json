  "instructions": [
    {
      "id": 343675,
      "primary_message": "Preheat the oven to 260°C (500°F) and place the rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 343676,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium spaghetti squash\n2 green bell peppers\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 343677,
      "primary_message": "Trim off and discard ends of each squash; halve squash lengthwise and scrape out the seeds from each half. Rub the inside of the squash with oil and season with salt and pepper. Arrange the squash halves cut-side-down on the baking sheet.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 343678,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 343679,
      "primary_message": "Meanwhile, drain and rinse the chickpeas; transfer to a large pot.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 343680,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the pot with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 343681,
      "primary_message": "Add tomatoes, coconut milk, and spices to the pot; stir to combine the curry and bring to a boil over medium-high heat.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n1 (398 ml) can coconut milk\n4 tsp paprika\n4 tsp cumin, ground\n2 tsp brown sugar\n1 tsp garlic powder\n1 tsp onion powder\n1 tsp salt\n½ tsp cayenne pepper"
    },
    {
      "id": 343682,
      "primary_message": "Once the curry is boiling, reduce to a simmer and cook, stirring occasionally, until slightly thickened, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 343683,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 343684,
      "primary_message": "Cut lime into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 343685,
      "primary_message": "Remove squash from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 343686,
      "primary_message": "To serve, divide squash and curry between plates; top with cilantro, yogurt, and a squeeze of lime. Enjoy!",
      "secondary_message": "⅔ cup plain Greek yogurt"
    }
  ],
