  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cool the strongly brewed tea. Lightly beat the egg. Thickly cut the Old-fashioned oats if possible.",
      "secondary_message": "1 cup strongly brewed tea, such as Irish Breakfast\n1 large egg\nOld-fashioned oats"
    },
    {
      "id": 1,
      "primary_message": "Combine raisins and tea in a bowl, cover and refrigerate overnight.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Butter and flour loaf pan, knocking out any excess flour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, combine flour, sugar, cinnamon, nutmeg, egg, raisins, and tea. Stir to combine and pour into prepared loaf pan. Sprinkle top with oats. Bake bread until top is brown, about 1 hour 40 minutes. Let cool 15 minutes then transfer to a wire rack to finish cooling.",
      "secondary_message": null
    }
