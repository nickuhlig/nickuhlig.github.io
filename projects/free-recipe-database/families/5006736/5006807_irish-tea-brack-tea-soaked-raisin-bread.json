  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine raisins and tea in a bowl, cover and refrigerate overnight.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Butter and flour loaf pan, knocking out any excess flour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, combine flour, sugar, cinnamon, nutmeg, egg, raisins, and tea. Stir to combine and pour into prepared loaf pan. Sprinkle top with oats. Bake bread until top is brown, about 1 hour 40 minutes. Let cool 15 minutes then transfer to a wire rack to finish cooling.",
      "secondary_message": null
    }
