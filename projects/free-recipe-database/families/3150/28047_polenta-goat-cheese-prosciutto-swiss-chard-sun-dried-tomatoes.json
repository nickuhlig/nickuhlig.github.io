  "instructions": [
    {
      "id": 449514,
      "primary_message": "In a large pot, bring broth to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated; add salt. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "2129 ml chicken or vegetable broth\n2 ¼ cups polenta (cornmeal)\n¾ tsp salt"
    },
    {
      "id": 449515,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves into bite-sized pieces and thinly slice the stems, keeping them separate. Place leaves in a large bowl and stems in a medium bowl.",
      "secondary_message": "3 bunches Swiss chard"
    },
    {
      "id": 449516,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 449517,
      "primary_message": "While the pot heats up, peel and thinly slice garlic. Add to the bowl with the stems and set aside.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 449518,
      "primary_message": "Once the pot is hot, working in batches, add prosciutto and cook until crispy, about 1 minute per side. Remove to a plate and set aside. (Reserve pot for the next step.)",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 449519,
      "primary_message": "Return pot to medium heat, add butter, and swirl to coat the bottom. Add chard stems, garlic, salt, and pepper to the pot; cook, stirring occasionally, until softened, about 4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 449520,
      "primary_message": "Meanwhile, roughly chop sun-dried tomatoes. Add to the pot and stir to combine.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 449521,
      "primary_message": "Add chard leaves to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Cook, stirring occasionally, until warmed through and tender, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 449522,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise, and thinly slice into ribbons. Place in the reserved medium bowl.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 449523,
      "primary_message": "Crumble goat cheese into the bowl with the basil and stir to combine.",
      "secondary_message": "3 (113 g) logs goat cheese"
    },
    {
      "id": 449524,
      "primary_message": "When the polenta is done, add butter, pepper, and half of both the basil and goat cheese to the pot, then stir to combine (reserve remaining basil and goat cheese for serving).",
      "secondary_message": "3 tbsp butter, unsalted\n½ tsp black pepper"
    },
    {
      "id": 449525,
      "primary_message": "To serve, divide polenta and Swiss chard sauté between bowls. Crumble prosciutto over top, then sprinkle with reserved basil and goat cheese. Enjoy!",
      "secondary_message": null
    }
  ],
