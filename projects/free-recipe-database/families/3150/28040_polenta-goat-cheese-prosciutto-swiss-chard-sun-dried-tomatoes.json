  "instructions": [
    {
      "id": 449433,
      "primary_message": "In a medium saucepan, bring broth to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated; add salt. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 ½ cups polenta (cornmeal)\n½ tsp salt"
    },
    {
      "id": 449434,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves into bite-sized pieces and thinly slice the stems, keeping them separate. Place leaves in a medium bowl and stems in another medium bowl.",
      "secondary_message": "2 bunches Swiss chard"
    },
    {
      "id": 449435,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 449436,
      "primary_message": "While the skillet heats up, peel and thinly slice garlic. Add to the bowl with the stems and set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 449437,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add prosciutto and cook until crispy, about 1 minute per side. Remove to a plate and set aside. (Reserve skillet for the next step.)",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 449438,
      "primary_message": "Return skillet to medium heat, add butter, and swirl to coat the bottom. Add chard stems, garlic, salt, and pepper to the skillet; cook, stirring occasionally, until softened, about 3 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 449439,
      "primary_message": "Meanwhile, roughly chop sun-dried tomatoes. Add to the skillet and stir to combine.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 449440,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Cook, stirring occasionally, until warmed through and tender, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 449441,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise, and thinly slice into ribbons. Place in the reserved bowl.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 449442,
      "primary_message": "Crumble goat cheese into the bowl with the basil and stir to combine.",
      "secondary_message": "2 (4 oz) logs goat cheese"
    },
    {
      "id": 449443,
      "primary_message": "When the polenta is done, add butter, pepper, and half of both the basil and goat cheese to the pan, then stir to combine (reserve remaining basil and goat cheese for serving).",
      "secondary_message": "2 tbsp butter, unsalted\n¼ tsp black pepper"
    },
    {
      "id": 449444,
      "primary_message": "To serve, divide polenta and Swiss chard sauté between bowls. Crumble prosciutto over top, then sprinkle with reserved basil and goat cheese. Enjoy!",
      "secondary_message": null
    }
  ],
