  "instructions": [
    {
      "id": 367277,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ¾-cup cooking water before draining and set aside.)",
      "secondary_message": "1 ½ tsp salt\n425 g penne pasta"
    },
    {
      "id": 367278,
      "primary_message": "Peel and mince garlic. Place in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 367279,
      "primary_message": "Wash, dry, and zest lemons into the bowl with the garlic. (Reserve lemons for later use.)",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 367280,
      "primary_message": "Preheat another large pot over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 367281,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, lemon zest, bread crumbs, and spices. Cook, stirring often, until golden and toasted, about 5 minutes. Remove from heat and return to the bowl. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 cup panko bread crumbs\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 367282,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a large bowl.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 367283,
      "primary_message": "Mince anchovy fillets. Peel and mince additional garlic.",
      "secondary_message": "9 anchovy fillets, packed in oil\n3 cloves garlic"
    },
    {
      "id": 367284,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add anchovies, garlic, salt, and pepper; cook, stirring often, until garlic is fragrant and golden, about 3 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 367285,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 367286,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 367287,
      "primary_message": "Juice reserved lemons into the pot with the kale. Add pasta, reserved pasta water, and Parmesan. Continue to cook, stirring occasionally, until sauce has thickened slightly and Parmesan has melted, about 3 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 367288,
      "primary_message": "To serve, divide pasta between plates or bowls and top with the bread crumb mixture. Enjoy!",
      "secondary_message": null
    }
  ],
