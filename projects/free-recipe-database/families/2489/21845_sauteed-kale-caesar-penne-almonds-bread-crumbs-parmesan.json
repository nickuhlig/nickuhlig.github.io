  "instructions": [
    {
      "id": 367227,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ½-cup cooking water before draining and set aside.)",
      "secondary_message": "1 tsp salt\n283 g penne pasta"
    },
    {
      "id": 367228,
      "primary_message": "Peel and mince garlic. Place in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 367229,
      "primary_message": "Roughly chop almonds. Add to the bowl with the garlic.",
      "secondary_message": "½ cup almonds"
    },
    {
      "id": 367230,
      "primary_message": "Preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 367231,
      "primary_message": "While the skillet heats up, wash, dry, and zest lemon into the bowl with the garlic and almonds. (Reserve lemon for later use.)",
      "secondary_message": "1 lemon"
    },
    {
      "id": 367232,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, almonds, lemon zest, bread crumbs, and spices. Cook, stirring often, until golden and toasted, about 4 minutes. Remove from heat and return to the bowl. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n⅔ cup panko bread crumbs\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 367233,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a large bowl.",
      "secondary_message": "2 bunches kale"
    },
    {
      "id": 367234,
      "primary_message": "Mince anchovy fillets. Peel and mince additional garlic.",
      "secondary_message": "6 anchovy fillets, packed in oil\n2 cloves garlic"
    },
    {
      "id": 367235,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add anchovies, garlic, salt, and pepper; cook, stirring often, until garlic is fragrant and golden, about 2 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 367236,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until tender, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 367237,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 367238,
      "primary_message": "Juice reserved lemon into the skillet. Add pasta, reserved pasta water, and Parmesan. Continue to cook, stirring occasionally, until sauce has thickened slightly and Parmesan has melted, about 2 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 367239,
      "primary_message": "To serve, divide pasta between plates or bowls and top with the bread crumb mixture. Enjoy!",
      "secondary_message": null
    }
  ],
