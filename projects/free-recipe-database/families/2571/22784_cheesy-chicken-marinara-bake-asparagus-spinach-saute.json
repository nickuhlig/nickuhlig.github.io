  "instructions": [
    {
      "id": 421526,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 421527,
      "primary_message": "Pat chicken dry with paper towels and transfer to a large baking dish. Drizzle with oil and season with spices on both sides. ",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 421528,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until chicken is just cooked through, 12-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 421529,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus. Cut spears into 2-inch pieces and place in a medium bowl; set aside. ",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 421530,
      "primary_message": "When the chicken is done, remove from oven. Pour marinara sauce over the chicken, then sprinkle with cheese. ",
      "secondary_message": "1 (680 g) jar marinara sauce\n1 cup shredded cheese, Italian blend"
    },
    {
      "id": 421531,
      "primary_message": "Return baking dish to the oven and continue to bake until sauce is warmed through and cheese is melted, about 5 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 421532,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 421533,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, salt, and pepper; cook, stirring occasionally, until fork-tender, about 3 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 421534,
      "primary_message": "While the asparagus is cooking, wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "2 (142 g) pkgs baby spinach"
    },
    {
      "id": 421535,
      "primary_message": "When the asparagus is done, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 421536,
      "primary_message": "To serve, divide marinara chicken bake and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
