  "instructions": [
    {
      "id": 421504,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 421505,
      "primary_message": "Pat chicken dry with paper towels and divide between two baking dishes. Drizzle with oil and season with spices on both sides. ",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 421506,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake until chicken is just cooked through, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 421507,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus. Cut spears into 2-inch pieces and place in a medium bowl; set aside. ",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 421508,
      "primary_message": "When the chicken is done, remove from oven. Pour marinara sauce over the chicken, then sprinkle with cheese. ",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce\n1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 421509,
      "primary_message": "Return baking dishes to the oven and continue to bake until sauce is warmed through and cheese is melted, 5-7 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 421510,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 421511,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, salt, and pepper; cook, stirring occasionally, until fork-tender, about 4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 421512,
      "primary_message": "While the asparagus is cooking, wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 421513,
      "primary_message": "When the asparagus is done, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 421514,
      "primary_message": "To serve, divide marinara chicken bake and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
