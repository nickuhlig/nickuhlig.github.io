  "instructions": [
    {
      "id": 1,
      "primary_message": "In the bowl of a food processor, combine flour, sugar, salt, baking powder, and lemon zest. Pulse to combine, about 5 short pulses. Add butter and pulse until it is the size of peas, about 5 pulses more. Add egg, egg yolk, vanilla extract, and milk and pulse until dough forms, adding the ice water (and more if needed) to help it come together. Wrap dough in plastic wrap and chill in refrigerator for 2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to middle position and preheat to 175°C (350°F). Butter tart pan.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Divide dough into roughly 2/3 and 1/3 pieces. Press the larger piece evenly into the bottom of the tart pan, also covering the sides of the pan. Place jam in a bowl and whisk to make it easier to spread. Spread jam evenly over the crust to coat.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Roll out remaining dough onto a clean, lightly floured surface until it is 0.5-cm thick. Cut dough into 2.5-cm wide strips. Lay them parallel to each other, about 2.5-cm apart, across top of tart. Re-roll dough if needed and cut out more strips. Place the newly cut strips across the existing ones so that they are perpendicular to them and create a lattice pattern. For more help with creating a lattice crust, see directions here.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Brush lattice crust with egg wash and sprinkle with sugar. Place tart in the oven and bake until crust is golden and jam is set, about 50 minutes. Let cool completely before serving.",
      "secondary_message": null
    }
  ],
