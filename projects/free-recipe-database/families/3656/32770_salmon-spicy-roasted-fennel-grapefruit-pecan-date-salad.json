  "instructions": [
    {
      "id": 521961,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 521962,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n2 fennel bulbs\n2 grapefruits"
    },
    {
      "id": 521963,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 521964,
      "primary_message": "Peel and mince garlic. Add to the bowl with the green onions along with soy sauce and spices. Stir to combine the marinade.",
      "secondary_message": "1 clove garlic\n1 tbsp soy sauce\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 521965,
      "primary_message": "Pat the salmon dry with paper towels and add to the bowl with the marinade. Turn to coat and set aside.",
      "secondary_message": "⅓ kg salmon fillet"
    },
    {
      "id": 521966,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice each half into ½-inch thick wedges. Transfer to one half of a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 521967,
      "primary_message": "Place fennel in the oven (it doesn't have to be fully heated) and roast until starting to soften, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 521968,
      "primary_message": "Meanwhile, place oil, honey, vinegar, Dijon, and spices in another medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp honey\n1 tsp apple cider vinegar\n½ tsp Dijon mustard\n¼ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 521969,
      "primary_message": "Cut off skin and white pith from the grapefruits; halve and slice crosswise into thin half-moons. Remove any visible seeds, add to the bowl with the dressing, and set aside.",
      "secondary_message": null
    },
    {
      "id": 521970,
      "primary_message": "When the fennel has started to soften, remove from the oven and arrange salmon on the other half of the baking sheet. Return to the oven and continue to roast until salmon is opaque and cooked through and fennel is tender, 10-12 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 521971,
      "primary_message": "Meanwhile, roughly chop dates and pecans. Add both to the bowl with the dressing.",
      "secondary_message": "¼ cup medjool dates, pitted\n¼ cup pecan halves"
    },
    {
      "id": 521972,
      "primary_message": "Just before serving, transfer roasted fennel to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 521973,
      "primary_message": "To serve, divide salmon and salad between plates. Top salmon with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
