  "instructions": [
    {
      "id": 521741,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 521742,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n6 fennel bulbs\n6 grapefruits"
    },
    {
      "id": 521743,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a large bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 521744,
      "primary_message": "Peel and mince garlic. Add to the bowl with the green onions along with soy sauce and spices. Stir to combine the marinade.",
      "secondary_message": "3 cloves garlic\n3 tbsp soy sauce\n¾ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 521745,
      "primary_message": "Pat the salmon dry with paper towels and add to the bowl with the marinade. Turn to coat and set aside.",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 521746,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice each half into ½-inch thick wedges. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 521747,
      "primary_message": "Place fennel in the oven (it doesn't have to be fully heated) and roast, tossing halfway, until golden and tender, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 521748,
      "primary_message": "Meanwhile, place oil, honey, vinegar, Dijon, and spices in another large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp honey\n1 tbsp apple cider vinegar\n1 ½ tsp Dijon mustard\n¾ tsp crushed red pepper\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 521749,
      "primary_message": "Cut off skin and white pith from the grapefruits; halve and slice crosswise into thin half-moons. Remove any visible seeds, add to the bowl with the dressing, and set aside.",
      "secondary_message": null
    },
    {
      "id": 521750,
      "primary_message": "Arrange salmon on another large baking sheet. Add to the oven and roast until salmon is opaque and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 521751,
      "primary_message": "Meanwhile, roughly chop dates and pecans. Add both to the bowl with the dressing.",
      "secondary_message": "¾ cup medjool dates, pitted\n¾ cup pecan halves"
    },
    {
      "id": 521752,
      "primary_message": "Just before serving, transfer roasted fennel to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 521753,
      "primary_message": "To serve, divide salmon and salad between plates. Top salmon with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
