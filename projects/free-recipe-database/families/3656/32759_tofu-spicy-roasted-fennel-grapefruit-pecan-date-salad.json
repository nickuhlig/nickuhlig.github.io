  "instructions": [
    {
      "id": 521810,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 521811,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 521812,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n4 fennel bulbs\n4 grapefruits"
    },
    {
      "id": 521813,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 521814,
      "primary_message": "Peel and mince garlic. Add to the bowl with the green onions along with soy sauce and spices. Stir to combine the marinade.",
      "secondary_message": "2 cloves garlic\n¼ cup soy sauce\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 521815,
      "primary_message": "Cut the tofu planks in half crosswise. Add to the bowl with the marinade and gently turn to coat. Set aside. (Wipe the baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 521816,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice each half into ½-inch thick wedges. Transfer to the reserved baking sheet, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 521817,
      "primary_message": "Place fennel in the oven (it doesn't have to be fully heated) and roast, tossing halfway, until golden and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 521818,
      "primary_message": "Meanwhile, place oil, maple syrup, vinegar, Dijon, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp pure maple syrup\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n½ tsp crushed red pepper\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 521819,
      "primary_message": "Cut off skin and white pith from the grapefruits. Halve and slice crosswise into thin half-moons. Remove any visible seeds, add to the bowl with the dressing, and set aside.",
      "secondary_message": null
    },
    {
      "id": 521820,
      "primary_message": "Arrange tofu on another baking sheet. Add to the oven and roast until tofu is golden and warmed through, 10-12 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 521821,
      "primary_message": "Meanwhile, roughly chop dates and pecans. Add both to the bowl with the dressing.",
      "secondary_message": "½ cup medjool dates, pitted\n½ cup pecan halves"
    },
    {
      "id": 521822,
      "primary_message": "Just before serving, transfer roasted fennel to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 521823,
      "primary_message": "To serve, divide tofu and salad between plates. Top tofu with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
