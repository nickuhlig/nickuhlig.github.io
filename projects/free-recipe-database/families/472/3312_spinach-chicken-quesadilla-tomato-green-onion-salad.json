  "instructions": [
    {
      "id": 34289,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg grape tomatoes\n½ small bunch green onions (scallions)\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 34290,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 34291,
      "primary_message": "Pat the chicken dry with paper towels, then cut into bite-sized pieces.",
      "secondary_message": "0.34 kg chicken breasts, boneless skinless"
    },
    {
      "id": 34292,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 34293,
      "primary_message": "Add the chicken to the skillet and season with salt and pepper. Cook, stirring occasionally, until the chicken is lightly browned and cooked through, 4 to 6 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 34294,
      "primary_message": "Wash and dry the cutting board and knife.",
      "secondary_message": null
    },
    {
      "id": 34295,
      "primary_message": "Coarsely grate 1 cup of mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese.\n"
    },
    {
      "id": 34296,
      "primary_message": "Add the spinach to the chicken and toss until the spinach is wilted, 1 to 2 minutes. Then, remove the skillet from the heat.",
      "secondary_message": null
    },
    {
      "id": 34297,
      "primary_message": "Add olive oil to a nonstick skillet and heat over medium heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 34298,
      "primary_message": "Place the tortillas on a flat work surface and cover half of each tortilla with cheese, chicken and spinach mixture, and more cheese on top. Fold each tortilla in half and press down to close.",
      "secondary_message": "2 large flour tortillas\n\n"
    },
    {
      "id": 34299,
      "primary_message": "Place both quesadillas in the nonstick skillet, straight edges next to each other. Cook until golden brown on both sides and the cheese is melted, 3 to 4 minutes per side. Once done, transfer each quesadilla to a cutting board and cut into 4 wedges.",
      "secondary_message": null
    },
    {
      "id": 34300,
      "primary_message": "Halve the grape tomatoes and transfer to a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 34301,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 34302,
      "primary_message": "Drizzle the salad with olive oil and season with salt and pepper; toss to combine.",
      "secondary_message": "½ tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 34303,
      "primary_message": "Place the yogurt in a small bowl.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 34304,
      "primary_message": "To serve, place a quesadilla on a plate and serve with the salad and yogurt dip on the side. Enjoy!",
      "secondary_message": null
    }
  ],
