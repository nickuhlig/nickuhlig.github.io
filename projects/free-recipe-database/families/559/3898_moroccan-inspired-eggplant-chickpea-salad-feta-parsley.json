  "instructions": [
    {
      "id": 43302,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n½ lemon\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 43306,
      "primary_message": "Juice the lemon and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 43307,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add to the lemon juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 43308,
      "primary_message": "To the lemon juice and garlic, add olive oil, Dijon, paprika, cumin, salt, and pepper; whisk together. Transfer half of the dressing to a large salad bowl and set aside; leave the remaining dressing in the small bowl.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp paprika\n½ tsp cumin\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 43304,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 43309,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 43303,
      "primary_message": "Trim off and discard the ends of the eggplant; slice crosswise into ¼-inch-thick rounds.",
      "secondary_message": ""
    },
    {
      "id": 43312,
      "primary_message": "Once the grill pan or skillet is hot, add the eggplant slices. Brush or rub the tops of the slices with half of the remaining dressing, then flip them over and brush or rub the other sides with the rest of the dressing. Cook until the slices are tender and browned on both sides, 3 to 5 minutes per side. Once done, transfer the slices to a plate. Cook in batches if necessary.",
      "secondary_message": ""
    },
    {
      "id": 43314,
      "primary_message": "While the eggplant slices cook, trim off and discard the ends of the shallot; peel and mince the shallot. Add to the salad bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 43305,
      "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43310,
      "primary_message": "Add the feta to the salad bowl.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 43508,
      "primary_message": "Add the chickpeas to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43311,
      "primary_message": "Cut the eggplant slices into bite-sized pieces and add to the salad bowl. Toss the salad until thoroughly coated with the dressing.",
      "secondary_message": null
    },
    {
      "id": 43313,
      "primary_message": "To serve, divide the salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
