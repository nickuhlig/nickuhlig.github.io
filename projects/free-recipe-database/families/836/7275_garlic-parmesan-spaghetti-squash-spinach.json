  "instructions": [
    {
      "id": 106418,
      "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line two baking sheets with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 106419,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium spaghetti squash\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 106420,
      "primary_message": "Trim off and discard the ends of the squashes; halve squashes lengthwise and scrape out the seeds from each half.",
      "secondary_message": null
    },
    {
      "id": 106421,
      "primary_message": "Rub the inside of the squash halves with oil and season with salt and pepper. Arrange squash halves cut-side-down on the baking sheet.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 106422,
      "primary_message": "Place squash halves in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 106423,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 106424,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 106425,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 106426,
      "primary_message": "Add the garlic to the pot, stir until fragrant, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 106427,
      "primary_message": "Add the spinach to the pot and season with salt and pepper; cook, stirring frequently, until the spinach has wilted, 4-5 minutes.",
      "secondary_message": "¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 106428,
      "primary_message": "Grate Parmesan cheese; reserve a small amount for garnish.",
      "secondary_message": "7 ½ oz Parmesan cheese"
    },
    {
      "id": 106429,
      "primary_message": "Stir in the cream and Parmesan into the spinach. Cook until the Parmesan has melted and incorporated into the cream; remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy cream"
    },
    {
      "id": 106430,
      "primary_message": "Once tender, remove squash halves from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of each squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand). Transfer to the skillet with the sauce and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 106431,
      "primary_message": "Divide between plates, garnish with reserved Parmesan, and enjoy!",
      "secondary_message": null
    }
  ],
