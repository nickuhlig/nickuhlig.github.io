  "instructions": [
    {
      "id": 106432,
      "primary_message": "Preheat the oven to 260°C (500°F) and place the rack in the center position. Line a baking sheet with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 106433,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium spaghetti squash\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 106434,
      "primary_message": "Trim off and discard the ends of the squash; halve the squash lengthwise and scrape out the seeds from each half.",
      "secondary_message": null
    },
    {
      "id": 106435,
      "primary_message": "Rub the inside of the squash with oil and season with salt and pepper. Arrange the squash halves cut-side-down on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 106436,
      "primary_message": "Place squash halves in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 106437,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 106438,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 106439,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 106440,
      "primary_message": "Add the garlic to the skillet, stir until fragrant, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 106441,
      "primary_message": "Add the spinach to the skillet and season with salt and pepper; cook, stirring frequently, until the spinach has wilted, 1-2 minutes.",
      "secondary_message": "¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 106442,
      "primary_message": "Grate Parmesan cheese; reserve a small amount for garnish.",
      "secondary_message": "71 g Parmesan cheese"
    },
    {
      "id": 106443,
      "primary_message": "Stir the cream and Parmesan into the spinach. Cook until the Parmesan has melted and incorporated into the cream; remove from heat.",
      "secondary_message": "118 ml (½ cup) heavy cream"
    },
    {
      "id": 106444,
      "primary_message": "Once tender, remove the squash halves from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand). Transfer to the skillet with the sauce and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 106445,
      "primary_message": "Divide between plates, garnish with reserved Parmesan, and enjoy!",
      "secondary_message": null
    }
  ],
