  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Rinse the cilantro. Remove the husks from the fresh tomatillos, then wash and quarter them. Coarsely chop the red onion. Quarter the jalapeno peppers. Shred the Monterey Jack cheese.",
      "secondary_message": "1 bunch cilantro, divided\n8 fresh tomatillos\n1 small red onion\n2 jalapeno peppers\n227 g Monterey Jack cheese"
    },
    {
      "id": 1,
      "primary_message": "If using chicken breasts, halve each breast on the bias so that pieces are of equal thickness. In medium saucepan over medium heat, heat chicken broth to simmer. Add cilantro stems to broth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add chicken to broth and gently cook until just cooked through (chicken should register 155 to 71°C on an instant-read thermometer), 8 to 10 minutes, reducing heat if necessary to maintain a bare simmer. Transfer chicken to plate and shred into small bite-sized pieces when cool enough to handle.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While chicken is cooking, pulse tomatillos, onion, jalapenos, lime juice, 1/2 teaspoon salt, and cilantro leaves in food processor to form a medium chunky consistency. Do not puree. Season to taste with more salt as desired.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat large cast iron or non-stick skillet over medium-high heat. Place one tortilla in pan and sprinkle with 1/4 of cheese. Arrange 1/4 of the chicken pieces over cheese and spread 1/4 of the salsa over the chicken. Place a tortilla on top and gently press with spatula.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cook until both sides are crisp, brown, and spotty, and cheese has melted, 1 to 2 minutes per side, adjusting heat so as not to burn tortillas. Continue with remaining ingredients to form 4 quesadillas total. Cut into wedges and serve immediately.",
      "secondary_message": null
    }
  ],
