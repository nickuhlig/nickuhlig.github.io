  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to upper middle and lower middle positions and preheat oven to 165°C (325°F). Brush both sides of each slice of bread with butter; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In medium bowl combine hearts of palm, cheddar, mayonnaise, onion, mustard, zest, and cayenne. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spread about 1 tablespoon cheese mixture on 24 slices of bread. Arrange 1 slice of cheese mixture-coated bread on a second slice of cheese mixture-coated bread, then top that slice with one of the remaining buttered slices. Gently press the triple-decker sandwiches down to adhere, and cut each into 3 pieces.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Arrange sandwiches on two baking sheets, leaving about 2.5 cm between them. Bake until golden, about 20 minutes, carefully flipping the sandwiches with a spatula halfway through baking. Transfer trays to cooling racks and cool about 5 minutes before serving.",
      "secondary_message": null
    }
  ],
