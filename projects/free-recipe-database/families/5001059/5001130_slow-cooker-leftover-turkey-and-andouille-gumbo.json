  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large sauté pan, heat 1 tablespoon oil over medium heat until shimmering. Add celery, pepper, and onion and cook, stirring often, until vegetables have begun to soften, about 5 minutes. Add garlic and continue cooking for 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer vegetables to the bowl of a slow cooker and return pot to the stove over low heat. Add remaining oil and flour. Cook mixture, stirring slowly and continuously, until roux is dark brown and fragrant, about 20 minutes. Do not allow it to burn.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Raise heat to medium-high and gradually whisk in stock, stirring constantly to prevent lumps. When all of liquid has been added and it starts to thicken, pour into cooker. Add turkey, andouille, Worcestershire sauce, hot sauce, cayenne, Cajun seasoning, thyme, and bay leaves. Season with salt and pepper, to taste.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cover and cook on low setting for about 4 hours, stirring periodically. Before serving, discard bay leaves and thyme sprigs and adjust seasoning, if needed. To serve, ladle gumbo over rice.",
      "secondary_message": null
    }
  ],
