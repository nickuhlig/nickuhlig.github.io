  "instructions": [
    {
      "id": 246855,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 246856,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 yellow bell pepper\n½ pint grape tomatoes\n½ (8 oz) pkg sugar snap peas\n½ small bunch Italian (flat-leaf) parsley\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 246857,
      "primary_message": "Place edamame and peas in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "¾ cup edamame, shelled\n¾ cup frozen peas"
    },
    {
      "id": 246858,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 246859,
      "primary_message": "Add oil, vinegar, maple syrup, Dijon, salt, and pepper to the bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n2 tsp pure maple syrup\n2 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 246860,
      "primary_message": "Trim, seed, and halve bell pepper crosswise; slice into thin strips and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 246861,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246862,
      "primary_message": "Trim and halve snap peas crosswise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246863,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246864,
      "primary_message": "Add drained edamame and peas to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246865,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246866,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 246867,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
