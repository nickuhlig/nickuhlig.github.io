  "instructions": [
    {
      "id": 246881,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n15 oz rotini pasta"
    },
    {
      "id": 246882,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 yellow bell peppers\n1 ½ pints grape tomatoes\n1 ½ (8 oz) pkg sugar snap peas\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 246883,
      "primary_message": "Place edamame and peas in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "2 ¼ cups edamame\n2 ¼ cups frozen peas"
    },
    {
      "id": 246884,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 246885,
      "primary_message": "Add oil, vinegar, maple syrup, Dijon, salt, and pepper to the bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n⅓ cup red wine vinegar\n2 tbsp pure maple syrup\n2 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 246886,
      "primary_message": "Trim, seed, and halve bell peppers crosswise; slice into thin strips and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 246887,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246888,
      "primary_message": "Trim and halve snap peas crosswise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246889,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246890,
      "primary_message": "Add drained edamame and peas to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246891,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 246892,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 246893,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
