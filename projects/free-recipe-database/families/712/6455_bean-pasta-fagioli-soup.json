  "instructions": [
    {
      "id": 100305,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, about 8-10 minutes (or according to package directions). When done, drain pasta; set aside.",
      "secondary_message": "8 oz macaroni (elbow) pasta\n1 tsp salt"
    },
    {
      "id": 100306,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 medium zucchini squash\n2 sticks celery"
    },
    {
      "id": 100307,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 100308,
      "primary_message": "Peel and small dice the carrot. Small dice the zucchini and celery.",
      "secondary_message": null
    },
    {
      "id": 100309,
      "primary_message": "Heat a large pot over medium-low heat. Add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 100310,
      "primary_message": "Add the minced garlic, carrots, zucchini, celery, and onion powder.",
      "secondary_message": "2 tsp onion powder"
    },
    {
      "id": 100311,
      "primary_message": "Cook, stirring well, until veggies begin to soften, about 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 100312,
      "primary_message": "Stir in the broth, tomato sauce, diced tomatoes, basil, oregano, thyme, salt, and pepper. Bring to a boil, then reduce and simmer, about 10 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes\n2 (8 oz) cans tomato sauce\n1 tsp basil\n1 tsp oregano\n½ tsp thyme\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 100313,
      "primary_message": "Drain and rinse the canned beans in a colander. Stir the cooked pasta and beans into the pot with the soup.",
      "secondary_message": "1 (15 oz) can kidney beans\n1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 100314,
      "primary_message": "Use a vegetable peeler to shave the Parmesan cheese.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 100315,
      "primary_message": "To serve, divide between bowls, garnish with Parmesan cheese and enjoy!",
      "secondary_message": null
    }
  ],
