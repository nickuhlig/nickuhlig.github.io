  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Hard-boil the eggs, then peel and halve them lengthwise. Juice the lemon. Mince the smoked salmon.",
      "secondary_message": "6 large eggs\n½ lemon\n¼ cup plus 2 tbsp smoked salmon, plus more for garnish"
    },
    {
      "id": 1,
      "primary_message": "Place all of the yolks in a medium bowl. Select 8 of the best looking egg white halves and set aside. Reserve the remaining 4 for another use. Add cream cheese, mayonnaise, lemon juice, sesame seeds, dehydrated onion, caraway seeds, and smoked salmon to yolks and, using a sturdy whisk, mash and stir together until thoroughly combined. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer yolk filling to zipper-lock bag. Filling and egg white halves can be stored covered in the refrigerator up to overnight before filling and serving (lay egg white halves cut-side-down on a large plate and cover with plastic wrap). Cut off corner of zipper-lock bag and pipe filling mixture into egg white halves, overstuffing each hole. Garnish deviled eggs with sesame seeds, dehydrated onion, caraway seeds, smoked salmon, and scallions. Serve immediately.",
      "secondary_message": null
    }
  ],
