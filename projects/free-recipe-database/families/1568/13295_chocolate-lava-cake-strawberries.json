  "instructions": [
    {
      "id": 248242,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 248243,
      "primary_message": "Meanwhile, coat 4 muffin cups with a thick layer of butter and sprinkle with flour; set aside.",
      "secondary_message": "2 tsp butter, unsalted\n1 tsp all-purpose flour"
    },
    {
      "id": 248244,
      "primary_message": "Fill a small saucepan about halfway with hot water (from the tap); cover and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 248245,
      "primary_message": "While the water heats up, use a strainer to sift powdered sugar into a small bowl. Add flour and salt, then stir to combine.",
      "secondary_message": "½ cup powdered sugar\n¼ cup all-purpose flour\n⅛ tsp salt"
    },
    {
      "id": 248246,
      "primary_message": "Uncover the pan and place a small, heat-proof, bowl over the simmering water, allowing it to sit on the rim. Add chocolate and butter to the bowl; using a silicone spatula, stir continuously, until melted. Remove from the heat. ",
      "secondary_message": "⅔ cup dark chocolate chips\n½ cup butter, unsalted"
    },
    {
      "id": 248247,
      "primary_message": "Place eggs and vanilla in a medium bowl; whisk to combine. ",
      "secondary_message": "4 eggs\n½ tsp vanilla extract"
    },
    {
      "id": 248248,
      "primary_message": "Add flour mixture and melted chocolate to the bowl with the egg; whisk until smooth and combined. Divide batter between the prepared muffin cups.",
      "secondary_message": null
    },
    {
      "id": 248249,
      "primary_message": "Place cakes in the oven and bake until the sides appear solid and firm (the centers will still be soft), 8-10 minutes. Remove from oven and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 248250,
      "primary_message": "Meanwhile, wash, dry, trim, and halve strawberries. ",
      "secondary_message": "1 (16 oz) pkg strawberries"
    },
    {
      "id": 248251,
      "primary_message": "Use a knife to carefully remove cakes from the muffin cups and divide between plates. Serve with strawberries on the side and enjoy!",
      "secondary_message": null
    }
  ],
