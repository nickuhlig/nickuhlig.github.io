  "instructions": [
    {
      "id": 147507,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n½ lime\n1 avocado\n½ small bunch cilantro\n½ small bunch green onions (scallions)\n1 tomato"
    },
    {
      "id": 147508,
      "primary_message": "Small dice potato into ¼-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 147509,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 147510,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add potatoes and salt; cook, stirring often, until golden and crisp, about 12 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 147511,
      "primary_message": "Meanwhile, finely chop the walnuts and transfer to a small bowl. ",
      "secondary_message": "⅔ cup walnuts"
    },
    {
      "id": 147512,
      "primary_message": "Peel and mince the garlic. Mince the sun-dried tomatoes; add both to the bowl with the walnuts.",
      "secondary_message": "2 cloves garlic\n4 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 147513,
      "primary_message": "Add water, sugar, and spices to the bowl with the walnuts and stir to combine. ",
      "secondary_message": "¾ cup water\n½ tsp brown sugar\n¾ tsp paprika\n¾ tsp cumin\n¾ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 147514,
      "primary_message": "When the potatoes are done, add the walnut mixture to the skillet; cook, stirring often, until the liquid has evaporated, about 4 minutes. Remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 147515,
      "primary_message": "Juice the lime into a blender.",
      "secondary_message": null
    },
    {
      "id": 147516,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out into the blender.",
      "secondary_message": null
    },
    {
      "id": 147517,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and add leaves to the blender. ",
      "secondary_message": null
    },
    {
      "id": 147518,
      "primary_message": "Peel garlic; add to the blender along with almond milk and salt. Blend on high until smooth; set avocado cream aside. ",
      "secondary_message": "1 clove garlic\n59 ml (¼ cup) almond milk, unsweetened\n¼ tsp salt"
    },
    {
      "id": 147519,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 147520,
      "primary_message": "Small dice the tomato. ",
      "secondary_message": null
    },
    {
      "id": 147521,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15-30 seconds.",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 147522,
      "primary_message": "To serve, divide the tortillas between plates and fill with potato-walnut mixture. Top with green onion, tomato, and avocado cream. Enjoy! ",
      "secondary_message": null
    }
  ],
