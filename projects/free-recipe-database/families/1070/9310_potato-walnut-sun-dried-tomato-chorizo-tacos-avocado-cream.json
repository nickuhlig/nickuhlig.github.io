  "instructions": [
    {
      "id": 147539,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n1 ½ limes\n3 avocados\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n3 tomatoes"
    },
    {
      "id": 147540,
      "primary_message": "Small dice potatoes into ¼-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 147541,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 147542,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add potatoes and salt; cook, stirring often, until golden and crisp, about 15 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 147543,
      "primary_message": "Meanwhile, finely chop the walnuts and transfer to a large bowl. ",
      "secondary_message": "2 cups walnuts"
    },
    {
      "id": 147544,
      "primary_message": "Peel and mince the garlic. Mince the sun-dried tomatoes; add both to the bowl with the walnuts.",
      "secondary_message": "6 cloves garlic\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 147545,
      "primary_message": "Add water, sugar, and spices to the bowl with the walnuts and stir to combine. ",
      "secondary_message": "2 ¼ cup water\n1 ½ tsp brown sugar\n2 tsp paprika\n2 tsp cumin\n2 tsp chili powder\n¾ tsp salt"
    },
    {
      "id": 147546,
      "primary_message": "When the potatoes are done, add the walnut mixture to the skillet; cook, stirring often, until the liquid has evaporated, 5-6 minutes. Remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 147547,
      "primary_message": "Juice limes into a blender.",
      "secondary_message": null
    },
    {
      "id": 147548,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out into the blender.",
      "secondary_message": null
    },
    {
      "id": 147549,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and add leaves to the blender. ",
      "secondary_message": null
    },
    {
      "id": 147550,
      "primary_message": "Peel garlic; add to the blender along with almond milk and salt. Blend on high until smooth; set avocado cream aside. ",
      "secondary_message": "3 cloves garlic\n177 ml almond milk, unsweetened\n¾ tsp salt"
    },
    {
      "id": 147551,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 147552,
      "primary_message": "Small dice the tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 147553,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15-30 seconds.",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 147554,
      "primary_message": "To serve, divide the tortillas between plates and fill with potato-walnut mixture. Top with green onion, tomato, and avocado cream. Enjoy! ",
      "secondary_message": null
    }
  ],
