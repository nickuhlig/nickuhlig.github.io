  "instructions": [
    {
      "primary_message": "Line the bottom and sides of a large baking dish with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place butter in a large pot and melt over medium-low heat.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "primary_message": "Add mini marshmallows to the pot and heat, stirring constantly, until melted and combined with the butter, about 5 minutes. Remove from heat.",
      "secondary_message": "1 (283 g) pkg mini marshmallows"
    },
    {
      "primary_message": "Add popcorn, crackers, pretzel sticks, and peanuts to the pot, then stir until thoroughly combined.",
      "secondary_message": "5 cups popcorn, salted\n1 ½ cups cheddar cheese crackers\n1 ½ cups pretzel sticks\n1 cup peanuts, honey roasted"
    },
    {
      "primary_message": "Pour popcorn mixture into the prepared baking dish and, using the back of a metal spoon, spread into the sides, forming an even layer. Set aside to cool, about 1 hour (it will firm up as it cools).",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer cooled marshmallow treats to a cutting board. Peel away the parchment paper, then cut into 24 squares.",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange marshmallow squares on a plate and serve. Enjoy!",
      "secondary_message": null
    }
  ],
