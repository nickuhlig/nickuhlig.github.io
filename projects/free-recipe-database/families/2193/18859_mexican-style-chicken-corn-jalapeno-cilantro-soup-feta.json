  "instructions": [
    {
      "id": 310539,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n1 ½ orange bell peppers\n3 jalapeño peppers\n1 ½ bunches radish\n1 small bunch cilantro"
    },
    {
      "id": 310540,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 310541,
      "primary_message": "Trim and small dice celery; trim, seed, and medium dice bell peppers. Add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 310542,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the veggies. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 310543,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310544,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring frequently, until softened, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 310545,
      "primary_message": "Add flour and spices to the pot; continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "3 tbsp all-purpose flour\n2 tbsp chili powder\n1 tbsp cumin, ground\n1 tbsp coriander, ground\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 310546,
      "primary_message": "Add chicken, broth, and tomato sauce to the pot. Stir to combine, cover, and bring to a boil over high heat; once boiling, reduce heat to medium-low and simmer, stirring occasionally, until chicken is cooked through, 10-12 minutes.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1420 ml chicken or vegetable broth\n3 (213 ml) cans tomato sauce"
    },
    {
      "id": 310547,
      "primary_message": "Meanwhile, trim, halve, and thinly slice radishes crosswise; place in the reserved bowl. Drizzle with vinegar, sprinkle with salt, and stir to combine; set aside to marinate. ",
      "secondary_message": "2 tbsp apple cider vinegar\n½ tsp salt"
    },
    {
      "id": 310548,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 310549,
      "primary_message": "When the chicken is done, remove thighs to a plate using tongs (continue to simmer soup over low heat). Shred the chicken using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat.",
      "secondary_message": null
    },
    {
      "id": 310550,
      "primary_message": "Return shredded chicken to the pot, along with cilantro, corn, and additional vinegar; stir to combine the soup and continue to simmer until warmed through, 3-4 minutes more.",
      "secondary_message": "1 ½ cups frozen corn\n2 tbsp apple cider vinegar"
    },
    {
      "id": 310551,
      "primary_message": "To serve, divide soup between bowls; top with pickled radish and feta. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
