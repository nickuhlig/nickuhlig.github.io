  "instructions": [
    {
      "id": 310566,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 sticks celery\n1 orange bell pepper\n2 jalapeño peppers\n1 bunch radish\n1 small bunch cilantro\n1 avocado"
    },
    {
      "id": 310567,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 310568,
      "primary_message": "Trim and small dice celery; trim, seed, and medium dice bell pepper. Add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 310569,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310570,
      "primary_message": "While the pot heats up, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the veggies. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 310571,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring frequently, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 310572,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further. ",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 310573,
      "primary_message": "When the veggies are soft, add flour and spices to the pot; continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "2 tbsp all-purpose flour\n4 tsp chili powder\n2 tsp cumin, ground\n2 tsp coriander, ground\n1 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 310574,
      "primary_message": "Add beans, broth, and tomato sauce to the pot. Stir to combine, cover, and bring to a boil over high heat; once boiling, reduce heat to medium-low and simmer, stirring occasionally, until beans are tender, about 10 minutes. ",
      "secondary_message": "946 ml chicken or vegetable broth\n2 (213 ml) cans tomato sauce"
    },
    {
      "id": 310575,
      "primary_message": "Meanwhile, trim, halve, and thinly slice radishes crosswise; place in the reserved bowl. Drizzle with vinegar, sprinkle with salt, and stir to combine; set aside to marinate. ",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 310576,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 310577,
      "primary_message": "When the veggies are done, add cilantro, corn, and additional vinegar to the pot; stir to combine the soup and continue to simmer until heated through, about 3 minutes. ",
      "secondary_message": "1 cup frozen corn\n4 tsp apple cider vinegar"
    },
    {
      "id": 310578,
      "primary_message": "Meanwhile, halve and pit avocado; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "id": 310579,
      "primary_message": "To serve, divide soup between bowls; top with pickled radish, avocado, and feta. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
