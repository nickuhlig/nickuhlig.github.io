  "instructions": [
    {
      "id": 310513,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n½ orange bell pepper\n1 jalapeño pepper\n½ bunch radish\n½ small bunch cilantro"
    },
    {
      "id": 310514,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 310515,
      "primary_message": "Trim and small dice celery; trim, seed, and medium dice bell pepper. Add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 310516,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310517,
      "primary_message": "While the pan heats up, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the veggies. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 310518,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring frequently, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 310519,
      "primary_message": "Add flour and spices to the pan; continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "1 tbsp all-purpose flour\n2 tsp chili powder\n1 tsp cumin, ground\n1 tsp coriander, ground\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 310520,
      "primary_message": "Add chicken, broth, and tomato sauce to the pan. Stir to combine, cover, and bring to a boil over high heat; once boiling, reduce heat to medium-low and simmer, stirring occasionally, until chicken is cooked through, 10-12 minutes.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n473 ml chicken or vegetable broth\n1 (213 ml) can tomato sauce"
    },
    {
      "id": 310521,
      "primary_message": "Meanwhile, trim, halve, and thinly slice radishes crosswise; place in the reserved bowl. Drizzle with vinegar, sprinkle with salt, and stir to combine; set aside to marinate. ",
      "secondary_message": "2 tsp apple cider vinegar\n⅛ tsp salt"
    },
    {
      "id": 310522,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 310523,
      "primary_message": "When the chicken is done, remove thighs to a plate using tongs (continue to simmer soup over low heat). Shred the chicken using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat.",
      "secondary_message": null
    },
    {
      "id": 310524,
      "primary_message": "Return shredded chicken to the pan, along with cilantro, corn, and additional vinegar; stir to combine the soup and continue to simmer until warmed through, 2-3 minutes more.",
      "secondary_message": "½ cup frozen corn\n2 tsp apple cider vinegar"
    },
    {
      "id": 310525,
      "primary_message": "To serve, divide soup between bowls; top with pickled radish and feta. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
