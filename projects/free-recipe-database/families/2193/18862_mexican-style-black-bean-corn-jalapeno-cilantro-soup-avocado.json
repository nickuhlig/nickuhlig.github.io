  "instructions": [
    {
      "id": 310580,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n1 ½ orange bell peppers\n3 jalapeño peppers\n1 ½ bunches radish\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 310581,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 310582,
      "primary_message": "Trim and small dice celery; trim, seed, and medium dice bell peppers. Add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 310583,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the veggies. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 310584,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310585,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring frequently, until softened, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 310586,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further. ",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 310587,
      "primary_message": "When the veggies are soft, add flour and spices to the pot; continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "3 tbsp all-purpose flour\n2 tbsp chili powder\n1 tbsp cumin, ground\n1 tbsp coriander, ground\n1 ½ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 310588,
      "primary_message": "Add beans, broth, and tomato sauce to the pot. Stir to combine, cover, and bring to a boil over high heat; once boiling, reduce heat to medium-low and simmer, stirring occasionally, until beans are tender, about 10 minutes. ",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 (213 ml) cans tomato sauce"
    },
    {
      "id": 310589,
      "primary_message": "Meanwhile, trim, halve, and thinly slice radishes crosswise; place in the reserved bowl. Drizzle with vinegar, sprinkle with salt, and stir to combine; set aside to marinate. ",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 310590,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 310591,
      "primary_message": "When the veggies are done, add cilantro, corn, and additional vinegar to the pot; stir to combine the soup and continue to simmer until heated through, about 4 minutes. ",
      "secondary_message": "1 ½ cups frozen corn\n2 tbsp apple cider vinegar"
    },
    {
      "id": 310592,
      "primary_message": "Meanwhile, halve and pit avocados; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "id": 310593,
      "primary_message": "To serve, divide soup between bowls; top with pickled radish, avocado, and feta. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
