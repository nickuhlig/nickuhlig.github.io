  "instructions": [
    {
      "id": 375178,
      "primary_message": "Place yogurt, mayo, vinegar, sugar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 ½ tbsp apple cider vinegar\n1 ½ tbsp brown sugar\n¾ tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp crushed red pepper"
    },
    {
      "id": 375179,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Add to the bowl with the dressing.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 375180,
      "primary_message": "Wash, dry, and halve grapes. Add to the bowl.",
      "secondary_message": "0.68 kg red grapes"
    },
    {
      "id": 375181,
      "primary_message": "Add blue cheese to the bowl and stir to combine the salad.",
      "secondary_message": "1 (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 375182,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
