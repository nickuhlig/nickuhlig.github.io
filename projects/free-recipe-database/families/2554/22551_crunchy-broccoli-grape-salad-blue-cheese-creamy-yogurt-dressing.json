  "instructions": [
    {
      "id": 375163,
      "primary_message": "Place yogurt, mayo, vinegar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp avocado oil mayonnaise\n1 ½ tbsp apple cider vinegar\n¾ tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp crushed red pepper"
    },
    {
      "id": 375164,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Add to the bowl with the dressing.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 375165,
      "primary_message": "Wash, dry, and halve grapes. Add to the bowl.",
      "secondary_message": "1 ½ lb red grapes"
    },
    {
