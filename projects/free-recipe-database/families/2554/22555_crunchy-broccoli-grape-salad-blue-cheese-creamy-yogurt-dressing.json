  "instructions": [
    {
      "id": 375183,
      "primary_message": "Place yogurt, mayo, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp avocado oil mayonnaise\n1 ½ tsp apple cider vinegar\n¼ tsp salt\n⅛ tsp garlic powder\n⅛ tsp onion powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 375184,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Add to the bowl with the dressing.",
