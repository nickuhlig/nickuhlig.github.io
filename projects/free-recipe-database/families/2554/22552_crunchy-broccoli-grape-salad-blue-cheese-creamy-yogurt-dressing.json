  "instructions": [
    {
      "id": 375168,
      "primary_message": "Place yogurt, mayo, vinegar, sugar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 ½ tsp apple cider vinegar\n1 ½ tsp brown sugar\n¼ tsp salt\n⅛ tsp garlic powder\n⅛ tsp onion powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 375169,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Add to the bowl with the dressing.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 375170,
      "primary_message": "Wash, dry, and halve grapes. Add to the bowl.",
      "secondary_message": "0.23 kg red grapes"
    },
    {
      "id": 375171,
      "primary_message": "Add blue cheese to the bowl and stir to combine the salad.",
      "secondary_message": "¼ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 375172,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
