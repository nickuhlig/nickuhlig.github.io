  "instructions": [
    {
      "id": 213216,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 213217,
      "primary_message": "Once the bowl is chilled, remove from the freezer. Measure cold cream, sugar, and vanilla into the bowl.",
      "secondary_message": "4 fl oz (½ cup) heavy cream\n1 tsp granulated sugar\n½ tsp vanilla extract"
    },
    {
      "id": 213218,
      "primary_message": "Use a whisk to beat the cream vigorously, until medium-soft peaks form, about 2 minutes. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.) Set aside.",
      "secondary_message": null
    },
    {
      "id": 213219,
      "primary_message": "Place ice cream, milk, cocoa powder, and cherries in a blender. Blend on high until smooth.",
      "secondary_message": "16 fl oz (2 cups) vanilla ice cream\n8 fl oz (1 cup) whole milk\n1 tbsp cocoa powder\n½ cup frozen cherries"
    },
    {
      "id": 213220,
      "primary_message": "To serve, divide milkshake between glasses, top with whipped cream, and enjoy!",
      "secondary_message": null
    }
  ],
