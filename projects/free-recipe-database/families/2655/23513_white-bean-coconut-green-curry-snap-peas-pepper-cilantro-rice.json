  "instructions": [
    {
      "id": 385357,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 385358,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 385359,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 385360,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl along with the snap peas.",
      "secondary_message": "1 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 385361,
      "primary_message": "Place broth, coconut milk, curry paste, and salt in a large pot; stir to combine. Bring the curry to a simmer over medium heat.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n¼ cup Thai curry paste, green\n½ tsp salt"
    },
    {
      "id": 385362,
      "primary_message": "While the curry heats up, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 385363,
      "primary_message": "Once the curry is simmering, add veggies and beans to the pot; stir to combine. Return curry to a simmer and continue to cook until veggies are soft and beans are warmed through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 385364,
      "primary_message": "Meanwhile, cut lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 385365,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the curry, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 385366,
      "primary_message": "Divide rice and curry between plates or bowls; serve with lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
