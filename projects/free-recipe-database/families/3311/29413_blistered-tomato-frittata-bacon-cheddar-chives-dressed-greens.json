  "instructions": [
    {
      "id": 468497,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 468498,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 468499,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 3-4 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 468500,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n½ head butter (Boston) lettuce\n1 small pkg chives"
    },
    {
      "id": 468501,
      "primary_message": "Return skillet (with drippings) to medium-high heat. Add tomatoes and salt; cook, stirring occasionally, until starting to brown and burst, 5-7 minutes. ",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 468502,
      "primary_message": "Meanwhile, place eggs in a medium bowl, then add salt and pepper. Whisk to combine.",
      "secondary_message": "6 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 468503,
      "primary_message": "Coarsely grate cheddar. Add to the bowl with the egg, along with crispy bacon, and whisk once more to combine.",
      "secondary_message": "⅓ (8 oz) block cheddar cheese"
    },
    {
      "id": 468504,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 468505,
      "primary_message": "When the tomatoes are done, transfer half to a small bowl and set aside for serving. Spread remaining tomatoes out in an even layer in the skillet.",
      "secondary_message": null
    },
    {
      "id": 468506,
      "primary_message": "Reduce heat to medium-low and pour the egg mixture into in the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 468507,
      "primary_message": "Place skillet in the oven and broil until top of the frittata is just set, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 468508,
      "primary_message": "Meanwhile, using a clean cutting board, chop chives into small pieces. Place half in a clean medium bowl along with oil, vinegar, salt, and pepper, then whisk to combine the dressing. (Reserving remaining chives for serving.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 468509,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 468510,
      "primary_message": "Cut frittata into wedges and divide between plates; top with tomatoes and reserved chives. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
