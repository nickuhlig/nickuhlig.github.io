  "instructions": [
    {
      "id": 468567,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 468568,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 468569,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 468570,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 small pkgs grape tomatoes\n1 ½ heads butter (Boston) lettuce\n2 small pkgs chives"
    },
    {
      "id": 468571,
      "primary_message": "Return skillet (with drippings) to medium-high heat. Add tomatoes and salt; cook, stirring occasionally, until starting to brown and burst, 7-9 minutes. ",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 468572,
      "primary_message": "Meanwhile, place eggs in a large bowl, then add salt and pepper. Whisk to combine.",
      "secondary_message": "18 eggs\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 468573,
      "primary_message": "Coarsely grate cheddar. Add to the bowl with the egg, along with crispy bacon, and whisk once more to combine.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 468574,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 468575,
      "primary_message": "When the tomatoes are done, transfer half to a small bowl and set aside for serving. Spread remaining tomatoes out in an even layer in the skillet.",
      "secondary_message": null
    },
    {
      "id": 468576,
      "primary_message": "Reduce heat to medium-low and pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 468577,
      "primary_message": "Place skillet in the oven and broil until top of the frittata is just set, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 468578,
      "primary_message": "Meanwhile, using a clean cutting board, chop chives into small pieces. Place half in a clean large bowl along with oil, vinegar, salt, and pepper, then whisk to combine the dressing. (Reserving remaining chives for serving.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 468579,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 468580,
      "primary_message": "Cut frittata into wedges and divide between plates; top with tomatoes and reserved chives. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
