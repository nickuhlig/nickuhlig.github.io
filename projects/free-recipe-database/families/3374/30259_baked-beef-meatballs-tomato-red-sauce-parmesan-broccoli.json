  "instructions": [
    {
      "id": 482024,
      "primary_message": "Preheat oven to 450°F. Place oven racks in the upper and middle positions.",
      "secondary_message": null
    },
    {
      "id": 482025,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "2 crowns broccoli\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 482026,
      "primary_message": "Place baking sheet on the upper rack of the oven (it doesn't have to be fully heated) and roast until broccoli is golden brown and tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 482027,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems. Mince the leaves and place half in a medium bowl. (Reserve remaining basil for serving.)",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 482028,
      "primary_message": "Finely grate Parmesan. Add half to the bowl with the basil. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 482029,
      "primary_message": "Add beef, almond meal, egg, and spices to the bowl with the basil and Parmesan; use your hands to combine the beef mixture. Using a tablespoon measure, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "¾ lb lean ground beef\n3 tbsp almond meal/flour\n1 egg\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper\n¼ tsp garlic powder\n1 pinch nutmeg, ground"
    },
    {
      "id": 482030,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 482031,
      "primary_message": "While the skillet heats up, place tomato sauce and spices in a small bowl. Stir to combine the sauce.",
      "secondary_message": "1 (8 oz) can tomato sauce\n½ tsp Italian seasoning\n¼ tsp crushed red pepper\n1 pinch salt"
    },
    {
      "id": 482032,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 482033,
      "primary_message": "Add tomato sauce to the skillet with the meatballs and stir to coat. Place skillet on the middle rack of the oven and bake until meatballs are cooked through and sauce is warm, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 482034,
      "primary_message": "To serve, divide meatballs and broccoli between plates or bowls. Top meatballs with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
