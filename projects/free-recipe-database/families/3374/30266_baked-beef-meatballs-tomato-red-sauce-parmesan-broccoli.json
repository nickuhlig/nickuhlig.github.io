  "instructions": [
    {
      "id": 482140,
      "primary_message": "Preheat oven to 230°C (450°F). Place oven racks in the upper and middle positions.",
      "secondary_message": null
    },
    {
      "id": 482141,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a large baking sheet pan, drizzle with oil, and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "4 crowns broccoli\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 482142,
      "primary_message": "Place baking sheet on the upper rack of the oven (it doesn't have to be fully heated) and roast until broccoli is golden brown and tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 482143,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems. Mince the leaves and place half in a medium bowl. (Reserve remaining basil for serving.)",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 482144,
      "primary_message": "Finely grate Parmesan. Add half to the bowl with the basil. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 482145,
      "primary_message": "Add beef, bread crumbs, eggs, and spices to the bowl with the basil and Parmesan; use your hands to combine the beef mixture. Using a tablespoon measure, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "0.68 kg lean ground beef\n1 cup panko bread crumbs\n2 eggs\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper\n½ tsp garlic powder\n⅛ tsp nutmeg, ground"
    },
    {
      "id": 482146,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 482147,
      "primary_message": "While the skillet heats up, place tomato sauce and spices in a small bowl. Stir to combine the sauce.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n1 tsp Italian seasoning\n½ tsp crushed red pepper\n⅛ tsp salt"
    },
    {
      "id": 482148,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until browned on all sides, about 3-4 minutes (the meatballs will not be cooked all the way through). ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 482149,
      "primary_message": "Add tomato sauce to the skillet with the meatballs and stir to coat. Place skillet on the middle rack of the oven and bake until meatballs are cooked through and sauce is warm, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 482150,
      "primary_message": "To serve, divide meatballs and broccoli between plates or bowls. Top meatballs with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
