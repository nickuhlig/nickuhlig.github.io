  "instructions": [
    {
      "id": 482186,
      "primary_message": "Preheat oven to 230°C (450°F). Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 482187,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Divide between two large baking sheet pans, drizzle with oil, and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "6 crowns broccoli\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 482188,
      "primary_message": "Place baking sheets on the middle and lower racks of the oven (it doesn't have to be fully heated) and roast until broccoli is golden brown and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 482189,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems. Mince the leaves and place half in a large bowl. (Reserve remaining basil for serving.)",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 482190,
      "primary_message": "Finely grate Parmesan. Add half to the bowl with the basil. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 482191,
      "primary_message": "Add beef, almond meal, eggs, and spices to the bowl with the basil and Parmesan; use your hands to combine the beef mixture. Using a tablespoon measure, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "1.02 kg lean ground beef\n½ cup almond meal/flour\n3 eggs\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper\n¾ tsp garlic powder\n3 pinch nutmeg, ground"
    },
    {
      "id": 482192,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 482193,
      "primary_message": "While the skillet heats up, place tomato sauce and spices in a small bowl. Stir to combine the sauce.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n3 pinch salt"
    },
    {
      "id": 482194,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add meatballs and cook, turning often, until browned on all sides, about 3-4 minutes (the meatballs will not be cooked all the way through). Transfer to a large baking dish.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 482195,
      "primary_message": "When the meatballs are done, add tomato sauce to the skillet, and cook, stirring frequently, until warmed through, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 482196,
      "primary_message": "Transfer warm tomato sauce to the baking dish with the meatballs, then stir to coat.",
      "secondary_message": null
    },
    {
      "id": 482197,
      "primary_message": "Place baking dish on the upper rack of the oven and bake until meatballs are cooked through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 482198,
      "primary_message": "To serve, divide meatballs and broccoli between plates or bowls. Top meatballs with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
