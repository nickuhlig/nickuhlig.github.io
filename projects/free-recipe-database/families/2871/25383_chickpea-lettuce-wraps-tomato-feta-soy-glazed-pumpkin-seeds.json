  "instructions": [
    {
      "id": 407156,
      "primary_message": "Preheat the oven to 350°F. Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 407157,
      "primary_message": "Place pumpkin seeds, soy sauce, and maple syrup in a large bowl; stir to combine. Transfer seeds to the baking sheet and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "¾ cup pumpkin seeds\n1 ½ tbsp soy sauce\n1 ½ tsp pure maple syrup"
    },
    {
      "id": 407158,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring seeds halfway through, until golden and toasted, 10-12 minutes. Remove from oven and set aside to cool (the seeds will harden as they cool).",
      "secondary_message": null
    },
    {
      "id": 407159,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 small bunch green onions (scallions)\n1 ½ pints grape tomatoes\n1 small bunch cilantro\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 407160,
      "primary_message": "Zest and juice limes into the reserved bowl. Add oil, vinegar, salt, and crushed red pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp rice vinegar\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 407161,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 407162,
      "primary_message": "Halve or quarter tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 407163,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 407164,
      "primary_message": "Drain and rinse chickpeas in a colander. Add to the bowl.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 407165,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl.",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 407166,
      "primary_message": "Break apart the cooled pumpkin seeds. Add to the bowl, along with feta, and stir to combine the chickpea salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 407167,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with chickpea salad. Enjoy!",
      "secondary_message": null
    }
  ],
