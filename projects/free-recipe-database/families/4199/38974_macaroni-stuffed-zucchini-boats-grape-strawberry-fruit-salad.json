  "instructions": [
    {
      "id": 606431,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 606432,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve pot for later use.)",
      "secondary_message": "1 tsp salt\n283 g macaroni (elbow) pasta"
    },
    {
      "id": 606433,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n1 (454 g) pkg strawberries\n0.3 kg red grapes"
    },
    {
      "id": 606434,
      "primary_message": "Trim, and halve zucchini lengthwise. Scrape out the soft flesh from the middle of each half, place in a medium bowl, and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 606435,
      "primary_message": "Arrange zucchini halves, cut-side up, on a baking sheet pan; drizzle with oil, then season with salt and pepper. Place in the oven (it doesn't have to be fully heated) and bake until softened, about 15 minutes. Remove from oven.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 606436,
      "primary_message": "While the zucchini is baking, trim and quarter strawberries lengthwise. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 606437,
      "primary_message": "Halve grapes. Add to the bowl with the strawberries, stir to combine the fruit salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 606438,
      "primary_message": "Coarsely grate cheese. Set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 606439,
      "primary_message": "Roughly chop reserved zucchini flesh.",
      "secondary_message": null
    },
    {
      "id": 606440,
      "primary_message": "When the pasta is done, return the pot to medium-high heat, add oil, and swirl to coat the bottom. Add chopped zucchini and cook, stirring occasionally, until tender, about 2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 606441,
      "primary_message": "Add flour to the pot and continue to cook, stirring constantly, until zucchini is well coated, about 30 seconds.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 606442,
      "primary_message": "Slowly pour milk into the pot, whisking constantly. Continue to cook, whisking constantly, until sauce has thickened, 1-2 minutes more.",
      "secondary_message": "473 ml whole milk"
    },
    {
      "id": 606443,
      "primary_message": "Add cheese and spices to the pot. Continue whisking until cheese is melted and sauce is smooth, about 1 minute. Add cooked pasta, stir to combine, and remove from heat.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 606444,
      "primary_message": "Divide zucchini boats between plates, then fill with macaroni and cheese. Serve with fruit salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
