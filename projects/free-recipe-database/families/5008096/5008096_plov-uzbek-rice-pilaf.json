  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the onions into thin half moons. Toast and freshly grind the coriander. Toast and freshly grind the cumin.",
      "secondary_message": "2 medium onions\n2 tsp coriander\n1 ½ tsp cumin"
    },
    {
      "id": 1,
      "primary_message": "Rinse rice in a fine mesh strainer until water runs clear. Transfer rice to bowl and cover with water while prepping other ingredients.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil on high in large sauté pan until almost smoking and stir in carrots. Fry, stirring frequently, until oil is orange colored and carrots are deeply caramelized on the edges. Add onions and salt, stir to coat with oil, and fry until browned.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add spices and stir to combine until fragrant, then add rice. Stir frequently until rice browns slightly and smells nutty. Pour in one cup fresh water, bring to a boil, then reduce to a simmer and cover. Let rice cook for 15 minutes, then check for doneness—add water in 1/4 cup increments if rice is still dry and cook uncovered. Fold rice on bottom of pan over to prevent burning. Plov is done when rice is tender but still toothsome. Season to taste and serve immediately.",
      "secondary_message": null
    }
  ],
