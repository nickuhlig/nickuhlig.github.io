  "instructions": [
    {
      "id": 77674,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "24 baby bok choy\n3 oranges"
    },
    {
      "id": 77673,
      "primary_message": "Halve the oranges crosswise. Juice three halves into a small bowl. Slice the other halves into half-rounds and transfer to a separate small bowl.",
      "secondary_message": ""
    },
    {
      "id": 77672,
      "primary_message": "Trim the bok choy ends and cut in half lengthwise.",
      "secondary_message": ""
    },
    {
      "id": 77671,
      "primary_message": "Preheat a (stainless steel or cast iron) skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 77670,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg salmon fillet\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 77669,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 77668,
      "primary_message": "Carefully place the salmon, skin-side-down, in the skillet; cook until the flesh is opaque and flaky, 3 to 4 minutes per side (depending on thickness). Once done, transfer the salmon to a plate.",
      "secondary_message": ""
    },
    {
      "id": 77667,
      "primary_message": "While the salmon cooks, trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 77666,
      "primary_message": "Once the salmon has been transferred, add the orange juice to the skillet and scrape up any browned bits from the bottom. Then, add ½ of the garlic (save the rest for the bok choy), coconut aminos, and honey; stir to combine.",
      "secondary_message": "3 tbsp coconut aminos\n3 tbsp honey"
    },
    {
      "id": 77665,
      "primary_message": "Add the orange slices and the salmon to the skillet. Move the salmon around to evenly coat in the sauce. Cook until the sauce is slightly reduced, then remove from the heat, 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 77664,
      "primary_message": "Add coconut oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 77663,
      "primary_message": "Once the skillet is hot, add the remaining garlic and the bok choy. Cook, tossing frequently, until the bok choy is wilted and tender, 3 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 77662,
      "primary_message": "To the bok choy, add coconut aminos and sesame oil. Toss to coat, then remove from the heat.",
      "secondary_message": "3 tbsp coconut aminos\n¾ tsp toasted sesame oil"
    },
    {
      "id": 77661,
      "primary_message": "To serve, divide the salmon, bok choy, and orange slices between plates, then spoon the skillet sauce overtop. Enjoy!",
      "secondary_message": ""
    }
  ],
