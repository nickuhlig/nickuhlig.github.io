  "instructions": [
    {
      "id": 534985,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 534986,
      "primary_message": "While the skillet heats up, medium dice bacon. Slice sausages crosswise into 1-inch thick rounds.",
      "secondary_message": "6 slices bacon\n3 pork sausages"
    },
    {
      "id": 534987,
      "primary_message": "Once the skillet is hot, add bacon and sausage; cook, stirring occasionally, until crispy and cooked through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 534988,
      "primary_message": "Meanwhile, wash and dry tomatoes. Using a clean cutting board, thinly slice, then place on a plate and set aside.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 534989,
      "primary_message": "Wash, dry, and thinly slice mushrooms. Place in a large bowl.",
      "secondary_message": "0.68 kg cremini mushrooms"
    },
    {
      "id": 534990,
      "primary_message": "Peel, halve, and medium dice onions. Add to the bowl with the mushroom.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 534991,
      "primary_message": "When the bacon and sausage are done, add mushroom, onion, and spices to the skillet. Continue to cook, stirring occasionally, until veggies are soft, 5-6 minutes more. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp paprika\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 534992,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 534993,
      "primary_message": "Place eggs, salt, and pepper in the reserved bowl, then whisk to combine. Set aside.",
      "secondary_message": "18 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 534994,
      "primary_message": "Drain and rinse beans in a colander.",
      "secondary_message": "3 (398 ml) cans pinto beans"
    },
    {
      "id": 534995,
      "primary_message": "When the veggies are tender, add beans to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 534996,
      "primary_message": "Reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 534997,
      "primary_message": "Arrange tomato slices on top of the frittata, then place skillet in the oven and broil until top is set and tomatoes are tender, 4-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 534998,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
