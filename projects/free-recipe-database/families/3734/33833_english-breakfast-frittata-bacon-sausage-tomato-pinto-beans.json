  "instructions": [
    {
      "id": 534929,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 534930,
      "primary_message": "While the skillet heats up, medium dice bacon. Slice sausages crosswise into 1-inch thick rounds.",
      "secondary_message": "4 slices bacon\n2 pork sausages"
    },
    {
      "id": 534931,
      "primary_message": "Once the skillet is hot, add bacon and sausage; cook, stirring occasionally, until crispy and cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 534932,
      "primary_message": "Meanwhile, wash and dry tomatoes. Using a clean cutting board, thinly slice, then place on a plate and set aside.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 534933,
      "primary_message": "Wash, dry, and thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": "1 lb cremini mushrooms"
    },
    {
      "id": 534934,
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl with the mushroom.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 534935,
      "primary_message": "When the bacon and sausage are done, add mushroom, onion, and spices to the skillet. Continue to cook, stirring occasionally, until veggies are soft, 4-5 minutes more. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp paprika\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 534936,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 534937,
      "primary_message": "Place eggs, salt, and pepper in the reserved bowl, then whisk to combine. Set aside.",
      "secondary_message": "12 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 534938,
      "primary_message": "Drain and rinse beans in a colander.",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "id": 534939,
      "primary_message": "When the veggies are done, add beans to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 534940,
      "primary_message": "Reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 534941,
      "primary_message": "Arrange tomato slices on top of the frittata, then place skillet in the oven and broil until top is set and tomatoes are tender, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 534942,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
