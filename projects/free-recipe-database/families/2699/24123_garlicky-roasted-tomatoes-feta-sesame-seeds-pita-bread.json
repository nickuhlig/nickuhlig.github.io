  "instructions": [
    {
      "id": 392029,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 392030,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise. Place in a baking dish, just large enough to fit the tomatoes in a single layer.",
      "secondary_message": "1 ½ pints grape tomatoes"
    },
    {
      "id": 392031,
      "primary_message": "Peel and mince garlic. Sprinkle garlic and feta evenly over the tomatoes.",
      "secondary_message": "3 cloves garlic\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 392032,
      "primary_message": "Sprinkle sesame seeds and spices over the feta, then drizzle with oil. ",
      "secondary_message": "2 tbsp sesame seeds\n¾ tsp oregano, dried\n½ tsp black pepper\n3 pinch salt\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 392033,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until tomatoes have softened and juices start to bubble, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 392034,
      "primary_message": "Meanwhile, cut pita breads into wedges and arrange on a large baking sheet pan. When the tomatoes are almost done, add pita bread to the oven and bake until warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": "3 whole grain pitas"
    },
    {
      "id": 392035,
      "primary_message": "Divide roasted tomatoes and feta between plates. Serve with warm pita bread. Enjoy!",
      "secondary_message": null
    }
  ],
