  "instructions": [
    {
      "id": 392022,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 392023,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise. Place in a small baking dish, just large enough to fit the tomatoes in a single layer.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 392024,
      "primary_message": "Peel and mince garlic. Sprinkle garlic and feta evenly over the tomatoes.",
      "secondary_message": "2 cloves garlic\n1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 392025,
      "primary_message": "Sprinkle sesame seeds and spices over the feta, then drizzle with oil. ",
      "secondary_message": "4 tsp sesame seeds\n½ tsp oregano, dried\n¼ tsp black pepper\n⅛ tsp salt\n4 tsp extra virgin olive oil"
    },
    {
      "id": 392026,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until tomatoes have softened and juices start to bubble, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 392027,
      "primary_message": "Meanwhile, cut pita breads into wedges and arrange on a baking sheet pan. When the tomatoes are almost done, add pita bread to the oven and bake until warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 392028,
      "primary_message": "Divide roasted tomatoes and feta between plates. Serve with warm pita bread. Enjoy!",
      "secondary_message": null
    }
  ],
