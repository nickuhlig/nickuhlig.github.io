  "instructions": [
    {
      "primary_message": "This recipe uses Betty Crocker red velvet cake mix; if using a different brand please adjust recipe ingredients and cooking times per package instructions.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 350°F. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cover two large baking dishes with aluminum foil, so that the foil is level with the rims. Using a sharp knife, cut 12 \"X's\" into the foil of each dish, spacing them evenly apart. Gently push cones into the X's, so that they are supported and standing up. Set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place cake mix, eggs, water, and oil in a medium bowl. Using a hand-held mixer, blend on medium for 2 minutes, scraping down the sides of the bowl as needed, until the batter is combined.\n\n",
      "secondary_message": "1 (432 g) box red velvet cake mix\n½ cup neutral vegetable oil"
    },
    {
      "primary_message": "Fill ice cream cones about three-quarters with cake batter. Place cake cones in the preheated oven and bake until a toothpick inserted in the center comes out clean, 30-35 minutes. Remove cake cones from the oven and set aside to cool completely, about 1 hour.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the cake cones are cool, transfer frosting to a piping bag with a star tip.\n\n",
      "secondary_message": "2 (454 g) tub cream cheese frosting"
    },
    {
      "primary_message": "Decorate cake cones with frosting, then top with sprinkles.\n\n",
      "secondary_message": "2 tbsp rainbow sprinkles"
    },
    {
      "primary_message": "Serve, share, and enjoy!\n\n",
      "secondary_message": null
    }
  ],
