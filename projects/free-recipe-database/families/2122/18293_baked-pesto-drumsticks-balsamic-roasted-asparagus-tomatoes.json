  "instructions": [
    {
      "id": 344154,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 344155,
      "primary_message": "Place chicken on a baking sheet pan. Drizzle with pesto, sprinkle with salt and pepper, then toss to coat; spread drumsticks out in a single layer.",
      "secondary_message": "0.57 kg chicken drumsticks\n¼ cup basil pesto\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 344156,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated), and bake, turning once, until cooked through, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344157,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; transfer to another baking sheet.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 344158,
      "primary_message": "Wash and dry tomatoes; add to the baking sheet with the asparagus. Drizzle veggies with vinaigrette, sprinkle with salt and pepper, then toss to combine; spread out in an even layer.",
      "secondary_message": "1 small pkg grape tomatoes\n1 tbsp balsamic vinaigrette\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 344159,
      "primary_message": "Add veggies to the oven and roast, tossing halfway through, until the asparagus is fork-tender and tomatoes start to burst, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344160,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
