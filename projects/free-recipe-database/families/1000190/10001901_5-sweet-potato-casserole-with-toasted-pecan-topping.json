  "instructions": [
    {
      "primary_message": "Small dice butter, place in a medium bowl, and set aside to soften. ",
      "secondary_message": "4 tbsp butter, unsalted"
    },
    {
      "primary_message": "Wash, dry, peel, and medium dice sweet potatoes. Place in a large pot and cover with hot water (from the tap); add salt and bring to a boil over high heat. ",
      "secondary_message": "1 tsp salt"
    },
    {
      "primary_message": "Once the liquid in the pot is boiling, reduce heat to medium, cover, and simmer until sweet potatoes are tender, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, preheat oven to 375°F. Coat a baking dish with additional butter and set aside. ",
      "secondary_message": "butter, unsalted"
    },
    {
      "primary_message": "Roughly chop pecans and add to the bowl with the softened butter. ",
      "secondary_message": "½ cup pecan halves"
    },
    {
      "primary_message": "Halve dates lengthwise and thinly slice crosswise. Add to the bowl along with flour, sugar, and spices. Use your hands to combine the topping. ",
      "secondary_message": "½ cup medjool dates, pitted\n⅓ cup all-purpose flour\n¼ cup brown sugar\n½ tsp cinnamon, ground\n¼ tsp nutmeg, ground\n¼ tsp salt"
    },
    {
      "primary_message": "When the sweet potatoes are tender, drain and return to the pot. Add cream, additional butter, vanilla, salt, and pepper. Mash until smooth and combined, then transfer to the baking dish and spread out in an even layer. Sprinkle with the pecan topping. ",
      "secondary_message": "59 ml heavy whipping cream\n3 tbsp butter, unsalted\n1 tsp vanilla extract\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking dish in the oven and bake until warmed through and the topping is golden, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    }
  ],
