  "instructions": [
    {
      "id": 182276,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 182277,
      "primary_message": "Place chicken in a large pot. Cover with water by 1-inch and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 182278,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince onion. Place in a small bowl along with the vinegar and salt; set aside.",
      "secondary_message": "½ medium red onion\n1 ½ tbsp red wine vinegar\n¾ tsp salt"
    },
    {
      "id": 182279,
      "primary_message": "Once the water in the pot is boiling, turn heat down to medium and simmer until chicken is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 182280,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 avocados\n3 limes\n1 ½ small bunches green onions (scallions)"
    },
    {
      "id": 182281,
      "primary_message": "Halve and pit the avocados and scoop out into a large bowl. Mash with a fork until smooth.",
      "secondary_message": null
    },
    {
      "id": 182282,
      "primary_message": "Juice limes into the bowl with the avocado.",
      "secondary_message": null
    },
    {
      "id": 182283,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 182284,
      "primary_message": "Coarsely grate cheese and add to the bowl.",
      "secondary_message": "⅜ (227 g) block cheddar cheese"
    },
    {
      "id": 182285,
      "primary_message": "Add yogurt and spices to the bowl and stir to combine.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 ½ tsp salt\n¾ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 182286,
      "primary_message": "Drain vinegar from the onions and add to the bowl with the avocado mixture.",
      "secondary_message": null
    },
    {
      "id": 182287,
      "primary_message": "When the chicken is done, drain and shred with a fork. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 182288,
      "primary_message": "Divide chicken salad between tortillas and spread out in an even layer. Roll up tightly and slice in half.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 182289,
      "primary_message": "To serve, divide rolls between plates and enjoy!",
      "secondary_message": null
    }
  ],
