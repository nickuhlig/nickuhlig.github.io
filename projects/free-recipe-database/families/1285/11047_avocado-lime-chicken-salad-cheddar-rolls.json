  "instructions": [
    {
      "id": 182206,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 182207,
      "primary_message": "Place chicken in a medium saucepan. Cover with water by 1-inch and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 182208,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in a small bowl along with the vinegar and salt; set aside.",
      "secondary_message": "1 shallot\n1 ½ tsp red wine vinegar\n¼ tsp salt"
    },
    {
      "id": 182209,
      "primary_message": "Once the water in the pan is boiling, turn heat down to medium and simmer until chicken is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 182210,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 avocado\n1 lime\n½ small bunch green onions (scallions)"
    },
    {
      "id": 182211,
      "primary_message": "Halve and pit the avocado and scoop out into a medium bowl. Mash with a fork until smooth.",
      "secondary_message": null
    },
    {
      "id": 182212,
      "primary_message": "Juice lime into the bowl with the avocado.",
      "secondary_message": null
    },
    {
      "id": 182213,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 182214,
      "primary_message": "Coarsely grate cheese and add to the bowl.",
      "secondary_message": "⅛ (8 oz) block cheddar cheese"
    },
    {
      "id": 182215,
      "primary_message": "Add yogurt and spices to the bowl and stir to combine.",
      "secondary_message": "¼ cup plain Greek yogurt\n½ tsp salt\n¼ tsp garlic powder\n⅛ tsp black pepper"
    },
    {
      "id": 182216,
      "primary_message": "Drain vinegar from the shallots and add to the bowl with the avocado mixture.",
      "secondary_message": null
    },
    {
      "id": 182217,
      "primary_message": "When the chicken is done, drain and shred with a fork. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 182218,
      "primary_message": "Divide chicken salad between tortillas and spread out in an even layer. Roll up tightly and slice in half.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 182219,
      "primary_message": "To serve, divide rolls between plates and enjoy!",
      "secondary_message": null
    }
  ],
