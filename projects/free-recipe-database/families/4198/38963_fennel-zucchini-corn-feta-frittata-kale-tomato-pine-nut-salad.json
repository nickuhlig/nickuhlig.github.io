  "instructions": [
    {
      "id": 606281,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 fennel bulbs\n3 medium zucchini squash\n1 ½ bunches kale\n1 ½ pints grape tomatoes"
    },
    {
      "id": 606282,
      "primary_message": "Juice lemons into a large bowl. Add mayo, Dijon, honey, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "3 tbsp mayonnaise\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 606283,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Place in another large bowl. ",
      "secondary_message": null
    },
    {
      "id": 606284,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 606285,
      "primary_message": "While the skillet heats up, trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the fennel. ",
      "secondary_message": null
    },
    {
      "id": 606286,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fennel, zucchini, corn, and salt; cook, stirring occasionally, until veggies are tender but not browned, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ cups frozen corn\n¾ tsp salt"
    },
    {
      "id": 606287,
      "primary_message": "Meanwhile, crack eggs into the reserved bowl. Add half of the feta (reserving the rest for the salad) and spices, then whisk to combine. Set aside.",
      "secondary_message": "18 eggs\n1 ½ (4 oz) pkgs crumbled feta cheese\n1 ½ tsp parsley flakes\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 606288,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 606289,
      "primary_message": "When the veggies are tender, pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 606290,
      "primary_message": "Place skillet in the oven and broil until top of the frittata is just set, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 606291,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 606292,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with reserved feta and pine nuts, then toss to combine the salad.",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 606293,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
