  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Melt butter in a microwave safe bowl or a small saucepan. Transfer to a large bowl.\n\n",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "primary_message": "Wash and dry broccoli. Add to the bowl with the melted butter.\n\n",
      "secondary_message": "½ (510 g) bag broccoli florets"
    },
    {
      "primary_message": "Medium dice ham. Add to the bowl along with diced potatoes, soup, sour cream, and 1 cup of the cheese. Stir to combine, transfer to a large baking dish, and spread out in an even layer. Sprinkle casserole with the remaining cheese.\n\n",
      "secondary_message": "227 g ham steak, boneless\n1 (907 g) bag diced potatoes, frozen\n1 (298 g) can condensed cream of chicken soup\n1 cup sour cream\n2 cups cheddar cheese, shredded"
    },
    {
      "primary_message": "Place casserole in the oven (it doesn't have to be fully heated) and bake until cooked through and cheese is golden and bubbly, about 45 minutes. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide casserole between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
