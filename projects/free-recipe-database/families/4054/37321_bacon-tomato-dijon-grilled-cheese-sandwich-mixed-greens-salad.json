  "instructions": [
    {
      "id": 584812,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584813,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ English cucumber\n1 red bell pepper\n1 tomato\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 584814,
      "primary_message": "Once the skillet is hot, add bacon and cook until crispy, 3-5 minutes per side. Remove to a paper towel-lined plate and set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 584815,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n1 tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 584816,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584817,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 584818,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "⅓ (227 g) block cheddar cheese"
    },
    {
      "id": 584819,
      "primary_message": "Slice tomato crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 584820,
      "primary_message": "Place bread slices on a flat surface. Spread half of the bread with Dijon, then layer with cheddar, tomato, and bacon. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "4 slices whole grain bread\n2 tbsp Dijon mustard"
    },
    {
      "id": 584821,
      "primary_message": "Return skillet (with drippings) to medium heat, add oil, and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 584822,
      "primary_message": "Remove the sandwiches to a plate and add more oil to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Once done, transfer to a cutting board and slice in half.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 584823,
      "primary_message": "Add mixed greens to the bowl with dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 584824,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
