  "instructions": [
    {
      "id": 584838,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584839,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ English cucumbers\n3 red bell peppers\n3 tomatoes\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 584840,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add bacon and cook until crispy, 3-5 minutes per side. Remove to a paper towel-lined plate and set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 584841,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 584842,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584843,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 584844,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 584845,
      "primary_message": "Slice tomatoes crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 584846,
      "primary_message": "Place bread slices on a flat surface. Spread half of the bread with Dijon, then layer with cheddar, tomato, and bacon. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "12 slices whole grain bread\n⅓ cup Dijon mustard"
    },
    {
      "id": 584847,
      "primary_message": "Return skillet (with drippings) to medium heat, add oil, and swirl to coat the bottom. Working in batches, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 584848,
      "primary_message": "Remove the sandwiches to a plate and add more oil to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Once done, transfer to a cutting board and slice in half.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 584849,
      "primary_message": "Add mixed greens to the bowl with dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 584850,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
