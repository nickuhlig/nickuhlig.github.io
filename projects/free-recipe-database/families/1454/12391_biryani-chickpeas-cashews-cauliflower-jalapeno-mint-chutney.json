  "instructions": [
    {
      "id": 208132,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "id": 208133,
      "primary_message": "Peel and mince garlic and onion. ",
      "secondary_message": "2 cloves garlic\n½ medium yellow onion"
    },
    {
      "id": 208134,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208135,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom. Add garlic, onion, and spices; cook, stirring occasionally, until veggies begin to soften, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp turmeric\n¼ tsp cumin\n¼ tsp coriander\n¼ tsp salt\n1 pinch cinnamon"
    },
    {
      "id": 208136,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ lime\n1 (1 inch) piece ginger root\n½ jalapeño pepper\n½ small pkg fresh mint\n½ small bunch cilantro"
    },
    {
      "id": 208137,
      "primary_message": "Once the veggies are soft, add broth to the saucepan and bring to a boil. ",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 208138,
      "primary_message": "Once the broth comes to a boil, add rice, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 208139,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 208140,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208141,
      "primary_message": "Drain and rinse the chickpeas. ",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 208142,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower, chickpeas, broth, and spices; cook, stirring occasionally, until cauliflower is tender, 10-12 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 fl oz (¼ cup) chicken or vegetable broth\n½ tsp salt\n½ tsp turmeric\n¼ tsp cumin\n¼ tsp coriander"
    },
    {
      "id": 208143,
      "primary_message": "Meanwhile, juice lime into a small bowl. Peel and mince ginger; add to the bowl along with the sugar. Whisk to combine.",
      "secondary_message": "2 tsp brown sugar"
    },
    {
      "id": 208144,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 208145,
      "primary_message": "Pick mint and cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the chutney.",
      "secondary_message": null
    },
    {
      "id": 208146,
      "primary_message": "To serve, divide rice and veggies between bowls. Top with chutney and cashews. Enjoy! ",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    }
  ],
