  "instructions": [
    {
      "id": 208207,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "1 ½ cups basmati rice"
    },
    {
      "id": 208208,
      "primary_message": "Peel and mince garlic and onions. ",
      "secondary_message": "6 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 208209,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208210,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, onion, and spices; cook, stirring occasionally, until veggies begin to soften, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp turmeric\n¾ tsp cumin\n¾ tsp coriander\n¾ tsp salt\n3 pinch cinnamon"
    },
    {
      "id": 208211,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ limes\n3 (2 ½ cm) pieces ginger root\n1 ½ jalapeño peppers\n1 ½ small pkgs fresh mint\n1 ½ small bunches cilantro"
    },
    {
      "id": 208212,
      "primary_message": "Once the veggies are soft, add broth to the pot and bring to a boil. ",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 208213,
      "primary_message": "Once the broth comes to a boil, add rice, stir the mixture, cover the pot, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 208214,
      "primary_message": "Meanwhile, cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 208215,
      "primary_message": "Heat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208216,
      "primary_message": "Drain and rinse the chickpeas. ",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 208217,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add cauliflower, chickpeas, broth, and spices; cook, stirring occasionally, until cauliflower is tender, about 15 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n177 ml chicken or vegetable broth\n1 ½ tsp salt\n1 ½ tsp turmeric\n¾ tsp cumin\n¾ tsp coriander"
    },
    {
      "id": 208218,
      "primary_message": "Meanwhile, juice limes into a medium bowl. Peel and mince ginger; add to the bowl along with the sugar. Whisk to combine.",
      "secondary_message": "2 tbsp brown sugar"
    },
    {
      "id": 208219,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 208220,
      "primary_message": "Pick mint and cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the chutney.",
      "secondary_message": null
    },
    {
      "id": 208221,
      "primary_message": "To serve, divide rice and veggies between bowls. Top with chutney and cashews. Enjoy! ",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    }
  ],
