  "instructions": [
    {
      "id": 158505,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n½ small bunch green onions (scallions)\n½ small bunch Italian (flat-leaf) parsley\n1 pint grape tomatoes"
    },
    {
      "id": 158506,
      "primary_message": "Peel and mince or press (or press) the garlic into a medium salad bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 158507,
      "primary_message": "Add the mustard, maple syrup, olive oil, balsamic, salt, and pepper to the bowl with the garlic. Set aside.",
      "secondary_message": "4 tsp Dijon mustard\n4 tsp pure maple syrup\n4 tsp balsamic vinegar\n¼ cup extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 158508,
      "primary_message": "Halve the grape tomatoes and set aside. ",
      "secondary_message": null
    },
    {
      "id": 158509,
      "primary_message": "Shave the leaves off parsley stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 158510,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces and set both aside.",
      "secondary_message": null
    },
    {
      "id": 158511,
      "primary_message": "Halve and pit avocado, scoop flesh out into a medium bowl, and mash with a fork  Add Dijon, curry powder, turmeric powder, cayenne, nutritional yeast, salt, and pepper. Mix well.",
      "secondary_message": "1 avocado\n2 tbsp Dijon mustard\n2 tsp curry powder\n2 tsp turmeric\n⅛ tsp cayenne pepper\n¼ cup nutritional yeast flakes\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 158512,
      "primary_message": "Drain tofu. Transfer to paper towels and gently pat dry. Using your hands, crumble tofu into the bowl with the avocado mixture. ",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 158513,
      "primary_message": "Add parsley and green onion to bowl with the tofu and avocado, stir to combine.",
      "secondary_message": null
    },
    {
      "id": 158514,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 158515,
      "primary_message": "Assemble the sandwiches by arranging several leaves of the spring mix on half the bread slices and topping with equal portions of the tofu salad and a second slice of bread. ",
      "secondary_message": null
    },
    {
      "id": 158516,
      "primary_message": "Mix remaining spring mix with the dressing and tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 158517,
      "primary_message": "To serve, arrange a sandwich on each plate with the salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
