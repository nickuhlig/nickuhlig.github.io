  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and finely chop the carrot. Finely chop the celery. Mince the garlic. Pick the parsley leaves from the stems and mince them.",
      "secondary_message": "1 large carrot\n1 rib celery\n2 medium cloves garlic\n¼ cup flat-leaf parsley"
    },
    {
      "id": 1,
      "primary_message": "Place turkey wings and meat in the bowl of a slow cooker.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in a Dutch oven over medium heat. Add carrot, celery, and onion and sauté, stirring often, until vegetables start to soften, about 5 minutes. Add garlic and continue cooking, stirring, until fragrant, about 1 minute longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer vegetables to slow cooker along with bay leaves, thyme, poultry seasoning, lemon, Worcestershire sauce, stock, and wine. Season with salt and pepper, cover and cook on low setting for 6 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove turkey and pull meat from bones. Discard skin and bones and return meat to slow cooker. Add couscous and continue cooking until couscous is tender, 1 to 1 1/2 hours longer.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Discard bay leaves, thyme sprigs, and lemon half. Taste and adjust seasonings, if needed. Ladle into bowls, garnish with herbs and serve.",
      "secondary_message": null
    }
  ],
