  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the rhubarb.",
      "secondary_message": "2 cups rhubarb"
    },
    {
      "id": 1,
      "primary_message": "Add rhubarb, lime zest, and lemon zest to a quart-sized jar. Add the vodka, seal, shake, and let sit for four days.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "After four days, add coriander, juniper, fennel, lavender, chamomile, cinchona, angelica, and rum in second quart-sized jar. Seal, shake, and set both aside for 10 more days.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "After 10 days, strain the solids out of each jar, reserving the solids and liquids separately. Combine the strained solids with the water in a small saucepan and set aside. Combine the strained liquids in a single jar and set aside. Heat the solids and the water over medium heat until simmering, 5 to 7 minutes. Remove from heat and let cool. Transfer to jar with liquids. Seal, shake, and set aside for another two days.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Strain through sieve, pushing down to extract as much liquid as you can. Then bottle by filtering through a coffee filter or cheesecloth. Store at room temperature for up to a year.",
      "secondary_message": null
    }
  ],
