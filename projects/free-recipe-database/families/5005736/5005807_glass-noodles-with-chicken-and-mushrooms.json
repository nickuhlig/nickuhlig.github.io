  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the ginger. Chop the stems of the cilantro, then chop the leaves. Mince the garlic. Seed and mince the green bird chiles. Slice the shiitake mushrooms thin. Slice the oyster mushrooms thin. Slice the celery thin. Cut the green onions into 2-inch lengths.",
      "secondary_message": "1 (2 ½ cm) piece ginger, divided\n1 bunch cilantro, divided\n6 medium cloves garlic\n2 green bird chiles\n283 g shiitake mushrooms\n142 g oyster mushrooms\n2 stalks celery\n1 bunch green onions"
    },
    {
      "id": 1,
      "primary_message": "In large bowl, soak noodles in warm water for at least 30 minutes. When softened, cut noodles into 10 to 13-cm lengths. In small bowl, toss chicken with 1 tablespoon Shaoxing wine, 1/2 teaspoon of grated ginger, and 1/4 teaspoon salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large wok or 30-cm nonstick skillet, heat 4 tablespoons oil over medium heat until shimmering. Add remaining grated ginger, cilantro stems, garlic, chiles, and 1 teaspoon salt. Cook, stirring, until beginning to turn golden, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add shiitake mushrooms and cook until softened and beginning to brown, about 5 minutes, adding another tablespoon oil if mixture is too dry. Add chicken and cook until almost cooked through, about 2 minutes. Stir in oyster mushrooms and celery. Cook for 1 minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Increase heat to medium-high. Stir in soy sauce, white pepper, chile flakes, remaining 2 tablespoons Shaoxing wine, and chicken stock. Bring to simmer. Stir in noodles and green onions and cook, stirring, until mixture is well combined and noodles are cooked through, 3 to 5 minutes. Stir in cilantro leaves, season to taste, and serve.",
      "secondary_message": null
    }
  ],
