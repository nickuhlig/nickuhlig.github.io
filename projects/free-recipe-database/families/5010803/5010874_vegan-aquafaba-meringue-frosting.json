  "instructions": [
    {
      "id": 1,
      "primary_message": "In a 2-quart saucepan, combine aquafaba with sugar and cardamom. Set over medium-low heat and cook, stirring and scraping with a silicone spatula, until mixture reaches 84°C.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove from heat and immediately scrape mixture into the bowl of a stand mixer fitted with the whisk. Add the cream of tartar and whisk at high speed until satiny white, stiff peaks form, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Frost cakes as desired with the meringue frosting.",
      "secondary_message": null
    }
