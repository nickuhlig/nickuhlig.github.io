  "instructions": [
    {
      "id": 184426,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n½ small bunch green onions (scallions)\n1 yellow bell pepper\n2 medium yellow potatoes"
    },
    {
      "id": 184427,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice into ¼-inch thick pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 184428,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces. Place half in the bowl with the leeks (reserve the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 184429,
      "primary_message": "Seed and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184430,
      "primary_message": "Small dice potatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184431,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 184432,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 184433,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 184434,
      "primary_message": "Add bowl of prepared veggies and corn to the pot. Cook, stirring frequently, until vegetables soften, 4-5 minutes. ",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 184435,
      "primary_message": "Add flour to the pot, stir to coat vegetables, then pour in the broth. Season with spices and bring to a simmer. Cook, stirring occasionally, until potatoes are tender and chowder has thickened, 10-12 minutes.",
      "secondary_message": "1 tbsp all-purpose flour\n710 ml chicken or vegetable broth\n¾ tsp salt\n½ tsp basil\n½ tsp thyme\n¼ tsp black pepper"
    },
    {
      "id": 184436,
      "primary_message": "Add cream and, using a potato masher, gently crush some of the potatoes to further thicken the soup.",
      "secondary_message": "118 ml (½ cup) heavy cream"
    },
    {
      "id": 184437,
      "primary_message": "To serve, divide soup between bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
