  "instructions": [
    {
      "primary_message": "Preheat oven to 375-degrees. Place tomatoes in a 9 x 9 baking dish/pan. In a 1 cup measure, combine 6 teaspoons olive oil with garlic and thyme. Drizzle over tomatoes and toss. Roast tomatoes in oven until bursting (about 22 minutes).",
      "secondary_message": null
    },
    {
      "primary_message": "While tomatoes are roasting, place feta, Parmesan, milk, lemon zest, salt and pepper into a food processor and process until nicely smooth.",
      "secondary_message": null
    },
    {
      "primary_message": "Brush the tops of the toast triangles with remaining 4 teaspoons olive oil and place on a baking sheet and put in the oven for the last 8 minutes of the roasting time for the tomatoes. ",
      "secondary_message": null
    },
    {
      "primary_message": "To assemble, spread a scant tablespoon of the feta mixture down the center of each toast triangle then add some of the tomato mixture (use a small spoon to get the tomato mixture and less liquid). Add a sprinkle of Parmesan and some fresh thyme if desired and serve.",
      "secondary_message": null
    }
  ],
