  "instructions": [
    {
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 English cucumber\n1 avocado"
    },
    {
      "primary_message": "Peel and mince or grate the ginger. Transfer to a small bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add soy sauce, vinegar, oil, and honey to the bowl and whisk to combine. ",
      "secondary_message": "2 tbsp rice vinegar\n2 tsp toasted sesame oil\n1 tsp honey"
    },
    {
      "primary_message": "Once the water in the saucepan is boiling, add the noodles and edamame; cook according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water. Return to the saucepan and toss with 2 tbsp of the dressing. ",
      "secondary_message": "340 g soba (buckwheat) noodles\n1 ½ cups edamame"
    },
    {
      "primary_message": "Meanwhile, thinly slice cucumber into match-like sticks. ",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit the avocado. Slice thinly while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide noodles and edamame between bowls and top with smoked salmon, cucumbers, and avocado. Drizzle with remaining dressing and enjoy! ",
      "secondary_message": "1 (113 g) pkg smoked salmon"
    }
  ],
