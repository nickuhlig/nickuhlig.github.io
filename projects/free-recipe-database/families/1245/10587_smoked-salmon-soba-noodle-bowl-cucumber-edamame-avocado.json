  "instructions": [
    {
      "id": 190532,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 190533,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ English cucumbers\n1 ½ avocados"
    },
    {
      "id": 190534,
      "primary_message": "Peel and mince or grate the ginger. Transfer to a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 190535,
      "primary_message": "Add soy sauce, vinegar, oil, and honey to the bowl and whisk to combine. ",
      "secondary_message": "½ cup soy sauce\n3 tbsp rice vinegar\n1 tbsp toasted sesame oil\n1 ½ tsp honey"
    },
    {
      "id": 190536,
      "primary_message": "Once the water in the pot is boiling, add the noodles and edamame; cook according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water. Return to the pot and toss with 3 tbsp of the dressing. ",
      "secondary_message": "18 oz soba (buckwheat) noodles\n2 ¼ cups edamame"
    },
    {
      "id": 190537,
      "primary_message": "Meanwhile, thinly slice cucumbers into match-like sticks. ",
      "secondary_message": null
    },
    {
      "id": 190538,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 190539,
      "primary_message": "To serve, divide noodles and edamame between bowls and top with smoked salmon, cucumbers, and avocado. Drizzle with remaining dressing and enjoy! ",
      "secondary_message": "1 ½ (4 oz) pkgs smoked salmon"
    }
  ],
