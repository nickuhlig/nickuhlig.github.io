  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Dark Chocolate Ganache: In a 1-quart stainless steel saucier, bring the cream to a gentle simmer. When it's bubbling hard around the edges, pour over dark chocolate in a medium bowl. Let stand 30 seconds, then whisk gently to combine. Stand at room temperature until 29°C, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the White Chocolate Ganache: In a 1-quart stainless steel saucier, bring the cream to a gentle simmer. When it's bubbling hard around the edges, pour over white chocolate in a medium bowl. Let stand 30 seconds, then add a pinch of salt and whisk gently to combine. Stand at room temperature until 28°C, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To Combine: Pour half the dark ganache into a small serving bowl, followed by half the white ganache. Then pour in half the remaining dark ganache, followed by half the remaining white ganache, then repeat. Swirl together with a toothpick and serve with fresh fruit, pretzels, shortbread cookies, or whatever you're inclined to dunk in chocolate.",
      "secondary_message": null
    }
  ],
