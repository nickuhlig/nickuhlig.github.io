  "instructions": [
    {
      "id": 185112,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 jalapeño peppers\n1 small bunch cilantro\n6 peaches\n3 limes\n1 ½ avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 185113,
      "primary_message": "Combine spices in a small bowl.",
      "secondary_message": "1 ½ tsp chili powder\n¾ tsp cumin\n¾ tsp salt\n3 pinch garlic powder\n3 pinch onion powder\n3 pinch black pepper"
    },
    {
      "id": 185114,
      "primary_message": "Heat a large grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 185115,
      "primary_message": "While the grill pan heats up, pat the pork chops dry with paper towels and season with spice mixture on both sides.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 185116,
      "primary_message": "Once the grill pan is hot, coat with oil. Cooking in batches if necessary, add pork and cook, flipping occasionally, until cooked through, about 8 minutes. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 185117,
      "primary_message": "Meanwhile, peel and small dice onions. Peel and mince garlic. Place both in a large bowl.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 185118,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 185119,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 185120,
      "primary_message": "Halve and pit peaches. Working in batches if necessary, add peach halves to the grill pan, cut-side down, and cook until the flesh is soft and charred, about 4 minutes. Once done, transfer to a cutting board, medium dice, and add to the bowl with the cilantro.",
      "secondary_message": null
    },
    {
      "id": 185121,
      "primary_message": "Juice limes into the bowl, season with salt, and stir to combine the salsa.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 185122,
      "primary_message": "Meanwhile, thinly slice the pork chops crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 185123,
      "primary_message": "Halve and pit avocados; slice thinly while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 185124,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Top with pork slices, peach salsa, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
