  "instructions": [
    {
      "id": 185086,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n½ small bunch cilantro\n2 peaches\n1 lime\n½ avocado\n½ head butter (Boston) lettuce"
    },
    {
      "id": 185087,
      "primary_message": "Combine spices in a small bowl.",
      "secondary_message": "½ tsp chili powder\n¼ tsp cumin\n¼ tsp salt\n1 pinch garlic powder\n1 pinch onion powder\n1 pinch black pepper"
    },
    {
      "id": 185088,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 185089,
      "primary_message": "While the grill pan heats up, pat the pork chops dry with paper towels and season with spice mixture on both sides.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 185090,
      "primary_message": "Once the grill pan is hot, coat with oil. Add pork and cook, flipping occasionally, until cooked through, about 8 minutes. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 185091,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 185092,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 185093,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 185094,
      "primary_message": "Halve and pit peaches. Add peach halves to the grill pan, cut-side down, and cook until the flesh is soft and charred, about 4 minutes. Once done, transfer to a cutting board, medium dice, and add to the bowl with the cilantro.",
      "secondary_message": null
    },
    {
      "id": 185095,
      "primary_message": "Juice lime into the bowl, season with salt, and stir to combine the salsa.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 185096,
      "primary_message": "Meanwhile, thinly slice the pork chops crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 185097,
      "primary_message": "Halve and pit avocado; slice thinly while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 185098,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Top with pork slices, peach salsa, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
