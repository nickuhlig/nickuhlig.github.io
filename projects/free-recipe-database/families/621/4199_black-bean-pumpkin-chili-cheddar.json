  "instructions": [
    {
      "id": 47403,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 47404,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stems, seeds, and membranes. Medium dice the peppers into 1 ¼-cm cubes and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 47405,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 47406,
      "primary_message": "While the saucepan heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion into 6-mm pieces and add to the bowl with the peppers.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 47407,
      "primary_message": "Once the saucepan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 47408,
      "primary_message": "Add the bell peppers and onion to the saucepan; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 47409,
      "primary_message": "While the vegetables cook, open the cans of beans but don't drain.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 47410,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 47411,
      "primary_message": "Add the garlic, chili powder, cumin, and cinnamon to the saucepan; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "2 tbsp chili powder\n2 tsp cumin\n½ tsp cinnamon"
    },
    {
      "id": 47412,
      "primary_message": "Add the beans, diced tomatoes, and pumpkin purée to the saucepan; season with salt and pepper. Bring the mixture to a boil, then reduce to a simmer and cook for 10 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n1 (398 ml) can pure pumpkin purée\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 47413,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle. Stir ¾ of the green onions into the chili and save the rest for garnishing.",
      "secondary_message": ""
    },
    {
      "id": 47414,
      "primary_message": "Coarsely grate 1 cup of cheddar.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 47415,
      "primary_message": "To serve, divide the chili between bowls and top with the cheddar and remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
