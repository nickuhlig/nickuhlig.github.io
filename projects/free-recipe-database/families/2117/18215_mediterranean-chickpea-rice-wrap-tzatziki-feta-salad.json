  "instructions": [
    {
      "id": 295522,
      "primary_message": "Drain and rinse chickpeas; place in a small saucepan.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 295523,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and add to the pan with the chickpeas. Add water and spices; bring the mixture to a boil over high heat.",
      "secondary_message": "¼ cup basmati rice\n½ cup water\n½ tsp cumin, ground\n¼ tsp turmeric, ground\n¼ tsp salt"
    },
    {
      "id": 295524,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook until liquid is fully absorbed, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 295525,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 tomato\n½ English cucumber\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 295526,
      "primary_message": "Medium dice tomato; trim and medium dice cucumber. Place both in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 295527,
      "primary_message": "Peel and mince garlic. When the chickpea-rice mixture is done, remove from heat, add the garlic and additional salt, then stir to combine.",
      "secondary_message": "1 clove garlic\n⅛ tsp salt"
    },
    {
      "id": 295528,
      "primary_message": "Add mixed greens, feta, and dressing to the bowl with the tomato and cucumber; toss to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n2 tbsp italian salad dressing"
    },
    {
      "id": 295529,
      "primary_message": "To assemble the wraps, place tortillas on a flat surface and spread each with an even layer of tzatziki. Divide warm chickpea-rice mixture between tortillas, top with a small portion of salad (reserving the rest for serving), and roll tightly to close.",
      "secondary_message": "2 large flour tortillas\n½ cup tzatziki sauce"
    },
    {
      "id": 295530,
      "primary_message": "Cut wraps in half and divide between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
