  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve the garlic. Warm the cooked juicy and tender italian-american meatballs in red sauce. Slice the fresh mozzarella about 1/4 inch thick.",
      "secondary_message": "1 medium clove garlic\n1 recipe cooked juicy and tender italian-american meatballs in red sauce\n0.45 kg fresh mozzarella"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 180°C (350°F). Warm rolls in oven, 5 to 10 minutes. Slice off and discard ends of each roll. Cut rolls in half lengthwise.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Drizzle cut sides of top and bottom roll halves with olive oil and rub with clove of garlic until fragrant. Arrange bottom roll halves on a baking sheet, cut side up. Spoon a generous layer of tomato sauce onto each of the bottom halves.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Slice meatballs in half and arrange on sandwiches, overlapping as necessary for even coverage. Spoon more tomato sauce on top of meatball halves and grate Parmesan all over.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Lay sliced mozzarella on top of meatballs. Transfer baking sheet to oven and bake until mozzarella is fully melted, about 4 minutes; warm roll top halves in oven for last minute of cooking.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Close sandwiches and serve immediately.",
      "secondary_message": null
    }
  ],
