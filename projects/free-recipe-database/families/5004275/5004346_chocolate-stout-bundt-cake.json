  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Butter bundt pan and dust with cocoa.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large bowl, whisk brown sugar, granulated sugar, salt, and eggs until combined. Whisk in butter, sour cream, vanilla, and stout until combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In medium bowl, whisk flour with cocoa, baking soda, and baking powder. Whisk into wet mixture until combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour into prepared pan and bake until just firm to touch and toothpick inserted into center comes out with moist crumbs, 45 to 50 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer to wire rack to cool completely. Loosen edges with knife and invert onto serving plate.",
      "secondary_message": null
    }
  ],
