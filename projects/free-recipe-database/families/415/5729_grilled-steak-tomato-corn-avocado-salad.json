  "instructions": [
    {
      "id": 68428,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ pint grape tomatoes\n3 ears corn\n3 avocados\n3 jalapeño peppers\n1 ½ limes\n1 ½ small bunches green onions"
    },
    {
      "id": 68438,
      "primary_message": "Halve the tomatoes and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 68427,
      "primary_message": "Halve the avocados lengthwise, then remove and discard the pit. Scoop out and medium dice the flesh; add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68426,
      "primary_message": "Cut the jalapeño peppers into quarters lengthwise; remove and discard the seeds and white membranes. Finely dice the peppers and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68437,
      "primary_message": "Trim and discard the ends of the green onions; chop the onions crosswise on an angle into ¼-inch pieces. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68436,
      "primary_message": "Juice the limes and pour over the salad.",
      "secondary_message": ""
    },
    {
      "id": 68435,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 68425,
      "primary_message": "Place the steak on a plate and season with salt and pepper on both sides; set aside.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 68434,
      "primary_message": "Shuck the corn to remove the leaves and silk threads.",
      "secondary_message": ""
    },
    {
      "id": 68433,
      "primary_message": "Place the corn on the grill pan / skillet. Cook, turning frequently, until it is softened and lightly charred, 3 to 4 minutes in total. Once done, transfer to a cutting board.",
      "secondary_message": ""
    },
    {
      "id": 68424,
      "primary_message": "Once the corn has been transferred, coat the bottom of the grill pan / skillet with coconut oil.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 68432,
      "primary_message": "Place the steak in the grill pan / skillet; cook until desired doneness, 2 to 5 minutes per side. Once done, transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": ""
    },
    {
      "id": 68431,
      "primary_message": "While the steak cooks, stand the corn vertically and slice off the kernels; add them to the bowl with the other salad ingredients.",
      "secondary_message": ""
    },
    {
      "id": 68430,
      "primary_message": "Drizzle the salad with olive oil and season with salt, pepper, and cumin; toss to combine.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper\n⅜ tsp cumin"
    },
    {
      "id": 68429,
      "primary_message": "To serve, place the steak and salad on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
