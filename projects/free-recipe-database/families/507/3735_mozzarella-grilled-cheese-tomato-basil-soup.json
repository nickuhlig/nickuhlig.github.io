  "instructions": [
    {
      "id": 40935,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 40936,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and transfer to a small bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 40937,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the onion.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 40938,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 40939,
      "primary_message": "Add the onion and garlic to the saucepan; season with salt and pepper. Cook, stirring frequently, until the onion is softened, 4 to 6 minutes.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 40940,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons. Transfer the basil to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 40941,
      "primary_message": "Coarsely grate 1 cup of mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 40942,
      "primary_message": "Add the diced tomatoes, broth, and basil to the saucepan; season with additional salt and pepper. Bring the mixture to a boil, then reduce the heat to a simmer and cook for 8 to 10 minutes.",
      "secondary_message": "1 398 ml) can diced tomatoes\n236 ml (1 cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 40943,
      "primary_message": "Add butter to a nonstick skillet and heat over medium-low heat.",
      "secondary_message": "½ tbsp butter, unsalted"
    },
    {
      "id": 40944,
      "primary_message": "Place the bread slices on a clean, dry work surface. Divide the cheese between 2 of the bread slices, then top with the remaining bread slices.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 40945,
      "primary_message": "Once melted, spread the butter around the skillet, then season the bottom of the skillet with salt.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 40946,
      "primary_message": "Place the sandwiches in the skillet and cook until golden brown and crispy on the first side, 3 to 4 minutes. Then, add more butter and carefully flip the sandwiches; cook until golden brown on the other side and the cheese has melted, 3 to 4 minutes. Once done, transfer to a cutting board.",
      "secondary_message": "½ tbsp butter, unsalted"
    },
    {
      "id": 40947,
      "primary_message": "Using a hand blender, purée the soup until smooth. Alternatively, use a potato masher to mash the tomatoes (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 40948,
      "primary_message": "Cut the grilled cheese sandwiches in half diagonally.",
      "secondary_message": null
    },
    {
      "id": 40949,
      "primary_message": "To serve, divide the soup between small bowls and serve with the grilled cheese on the side. Enjoy!",
      "secondary_message": null
    }
  ],
