  "instructions": [
    {
      "id": 333564,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 small bunches asparagus\n1 lemon"
    },
    {
      "id": 333565,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; place in a medium bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 333566,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 333567,
      "primary_message": "While the skillet heats up, cut the steak into portions, pat dry with paper towels, and place on a plate; season with spices on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 333568,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 333569,
      "primary_message": "Meanwhile, using a clean cutting board, snap (or cut) off woody ends of the asparagus; cut spears into 2-inch pieces and add to the bowl with the broccoli. ",
      "secondary_message": null
    },
    {
      "id": 333570,
      "primary_message": "When the steak is done, return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until fork-tender, 5-7 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 333571,
      "primary_message": "Meanwhile, place ketchup, Dijon, Worcestershire, vinegar, soy sauce, honey, and crushed red pepper in a small bowl; whisk to combine the steak sauce and set aside. ",
      "secondary_message": "¼ cup ketchup\n2 tbsp Dijon mustard\n2 tbsp Worcestershire sauce\n2 tbsp balsamic vinegar\n2 tsp soy sauce\n2 tsp honey\n¼ tsp crushed red pepper"
    },
    {
      "id": 333572,
      "primary_message": "When the veggies are done, juice lemon into the skillet, stir to combine, and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 333573,
      "primary_message": "To serve, divide steak and veggies between plates; drizzle sauce over steaks and enjoy!",
      "secondary_message": null
    }
  ],
