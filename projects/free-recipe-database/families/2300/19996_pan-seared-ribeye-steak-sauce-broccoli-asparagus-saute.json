  "instructions": [
    {
      "id": 333636,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 small bunches asparagus\n1 ½ lemons"
    },
    {
      "id": 333637,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; place in a large bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 333638,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 333639,
      "primary_message": "While the skillet heats up, cut the steak into portions, pat dry with paper towels, and place on a plate; season with spices on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 333640,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate and loosely cover with aluminum foil. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 333641,
      "primary_message": "Meanwhile, using a clean cutting board, snap (or cut) off woody ends of the asparagus; cut spears into 2-inch pieces and add to the bowl with the broccoli. ",
      "secondary_message": null
    },
    {
      "id": 333642,
      "primary_message": "Preheat a large pot over medium-high heat.  ",
      "secondary_message": null
    },
    {
      "id": 333643,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until fork-tender, 7-8 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 333644,
      "primary_message": "Meanwhile, place ketchup, Dijon, Worcestershire, vinegar, soy sauce, honey, and crushed red pepper in a small bowl; whisk to combine the steak sauce and set aside. ",
      "secondary_message": "⅓ cup ketchup\n3 tbsp Dijon mustard\n3 tbsp Worcestershire sauce\n3 tbsp balsamic vinegar\n1 tbsp soy sauce\n1 tbsp honey\n½ tsp crushed red pepper"
    },
    {
      "id": 333645,
      "primary_message": "When the veggies are done, juice lemons into the pot, stir to combine, and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 333646,
      "primary_message": "To serve, divide steak and veggies between plates; drizzle sauce over steaks and enjoy!",
      "secondary_message": null
    }
  ],
