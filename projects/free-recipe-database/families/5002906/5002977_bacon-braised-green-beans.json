  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the bacon into 1/2-inch pieces. Thinly slice the onion. Thinly slice the garlic. Trim the green beans.",
      "secondary_message": "170 g bacon\n1 medium onion\n3 medium cloves garlic\n1.13 kg green beans"
    },
    {
      "id": 1,
      "primary_message": "Heat bacon in a large Dutch oven over medium-high heat and cook, stirring frequently, until fat has rendered and bacon is beginning to crisp, about 6 minutes. Add onion, garlic, and pepper flakes and cook, stirring, until onions are softened but not browned, about 8 minutes. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add green beans, stock, and vinegar and stir to combine. Bring to a boil, reduce to a bare simmer, cover, and cook, stirring occasionally, until beans are tender but retain a slight crunch to them, about 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove lid, set heat to high, add butter, and cook, stirring, until liquid is reduced to a saucy glaze, about 5 minutes. Season to taste with salt and pepper and serve.",
      "secondary_message": null
    }
  ],
