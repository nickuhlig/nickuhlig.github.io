  "instructions": [
    {
      "id": 283263,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 283264,
      "primary_message": "Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and transfer to a medium bowl, reserving pot for later use.",
      "secondary_message": "2 tsp salt\n283 g rotini pasta"
    },
    {
      "id": 283265,
      "primary_message": "Meanwhile, wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Place in another medium bowl.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 283266,
      "primary_message": "Wash, dry, trim, and halve zucchini lengthwise; slice crosswise into ¼-inch thick half-moons. Add to the bowl with the broccoli.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 283267,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 283268,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add broccoli, zucchini, salt, and pepper. Cook, stirring often, until veggies are tender-crisp, 6-7 minutes. Cover, remove from heat, and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 283269,
      "primary_message": "Meanwhile, cut cream cheese into small pieces; coarsely grate cheddar. ",
      "secondary_message": "⅔ (227 g) block cream cheese\n½ (227 g) block cheddar cheese"
    },
    {
      "id": 283270,
      "primary_message": "Once the pasta has been drained, place both cheeses, milk, salt, and paprika in the reserved pot. Set over medium heat and bring the mixture to a simmer, whisking frequently, until cheeses melt and combine, 2-3 minutes.",
      "secondary_message": "237 ml whole milk\n1 tsp salt\n½ tsp paprika"
    },
    {
      "id": 283271,
      "primary_message": "Drain tuna and flake with a fork; add to the cheese sauce along with the cooked pasta. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. ",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 283272,
      "primary_message": "To serve, divide pasta and veggies between plates or bowls. Top pasta with crushed red pepper and enjoy!",
      "secondary_message": "½ tsp crushed red pepper"
    }
  ],
