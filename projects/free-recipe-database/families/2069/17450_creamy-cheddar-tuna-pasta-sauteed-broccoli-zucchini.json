  "instructions": [
    {
      "id": 283253,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 283254,
      "primary_message": "Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and transfer to a small bowl, reserving saucepan for later use.",
      "secondary_message": "1 tsp salt\n142 g rotini pasta"
    },
    {
      "id": 283255,
      "primary_message": "Meanwhile, wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Place in another small bowl.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 283256,
      "primary_message": "Wash, dry, trim, and halve zucchini lengthwise; slice crosswise into ¼-inch thick half-moons. Add to the bowl with the broccoli.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 283257,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 283258,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add broccoli, zucchini, salt, and pepper. Cook, stirring often, until veggies are tender-crisp, 6-7 minutes. Cover, remove from heat, and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 283259,
      "primary_message": "Meanwhile, cut cream cheese into small pieces; coarsely grate cheddar. ",
      "secondary_message": "⅓ (227 g) block cream cheese\n¼ (227 g) block cheddar cheese"
    },
    {
      "id": 283260,
      "primary_message": "Once the pasta has been drained, place both cheeses, milk, salt, and paprika in the reserved saucepan. Set over medium heat and bring the mixture to a simmer, whisking frequently, until cheeses melt and combine, 2-3 minutes.",
      "secondary_message": "118 ml (½ cup) whole milk\n½ tsp salt\n¼ tsp paprika"
    },
    {
      "id": 283261,
      "primary_message": "Drain tuna and flake with a fork; add to the cheese sauce along with the cooked pasta. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. ",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 283262,
      "primary_message": "To serve, divide pasta and veggies between plates or bowls. Top pasta with crushed red pepper and enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
