  "instructions": [
    {
      "id": 521427,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 medium yellow potato\n½ lemon\n½ small pkg chives\n½ bunch radish\n½ English cucumber\n1 yellow bell pepper\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 521428,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 521429,
      "primary_message": "While the skillet heats up, peel and small dice potato.",
      "secondary_message": null
    },
    {
      "id": 521430,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add potato and spices; cook, stirring occasionally, until golden brown and tender, 10-12 minutes. Transfer potatoes to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil\n½ tsp parsley flakes\n¼ tsp garlic powder\n¼ tsp paprika\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 521431,
      "primary_message": "Meanwhile, zest lemon into a small bowl. (Cut lemon into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 521432,
      "primary_message": "Chop chives into small pieces. Add half to the bowl with the lemon zest along with mayo, vinegar, salt, and pepper. Stir to combine the chive mayo and set aside. (Reserve remaining chives for serving.)",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp white wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 521433,
      "primary_message": "Pat cod dry with paper towels and cut into 1-inch pieces. Place in a medium bowl, season with spices, and gently toss to coat.",
      "secondary_message": "⅓ kg cod fillet\n½ tsp parsley flakes\n½ tsp garlic powder\n¼ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 521434,
      "primary_message": "When the potatoes are done, return skillet to medium heat, add more oil, and swirl to coat the bottom. Add cod and cook, turning occasionally, until golden brown and cooked through, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 521435,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 521436,
      "primary_message": "Using a clean cutting board, trim and slice radishes crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 521437,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 521438,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 521439,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 521440,
      "primary_message": "Divide tortillas between plates. Spread with chive mayo, fill with fish and potatoes, then top with reserved chives. Serve with salad on the side and lemon wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
