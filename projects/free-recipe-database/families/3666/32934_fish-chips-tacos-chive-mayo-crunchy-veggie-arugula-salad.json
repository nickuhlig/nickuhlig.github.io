  "instructions": [
    {
      "id": 521371,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 medium yellow potatoes\n1 ½ lemons\n1 small pkg chives\n1 ½ bunches radish\n1 ½ English cucumbers\n3 yellow bell peppers\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 521372,
      "primary_message": "Peel and small dice potatoes.",
      "secondary_message": null
    },
    {
      "id": 521373,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 521374,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add potatoes and spices; cook, stirring occasionally, until golden brown and tender, 12-14 minutes. Transfer potatoes to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp parsley flakes\n¾ tsp garlic powder\n¾ tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 521375,
      "primary_message": "Meanwhile, zest lemons into a small bowl. (Cut lemons into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 521376,
      "primary_message": "Chop chives into small pieces. Add half to the bowl with the lemon zest along with mayo, vinegar, salt, and pepper. Stir to combine the chive mayo and set aside. (Reserve remaining chives for serving.)",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp white wine vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 521377,
      "primary_message": "Pat cod dry with paper towels and cut into 1-inch pieces. Place in a large bowl, season with spices, and gently toss to coat.",
      "secondary_message": "2 ¼ lb cod fillet\n1 ½ tsp parsley flakes\n1 ½ tsp garlic powder\n¾ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 521378,
      "primary_message": "When the potatoes are done, return skillet to medium heat, add more oil, and swirl to coat the bottom. Working in batches if necessary, add cod and cook, turning occasionally, until golden brown and cooked through, 4-5 minutes. Transfer to the plate with the potatoes and re-cover with foil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 521379,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 tbsp honey\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 521380,
      "primary_message": "Using a clean cutting board, trim and slice radishes crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 521381,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 521382,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 521383,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 521384,
      "primary_message": "Divide tortillas between plates. Spread with chive mayo, fill with fish and potatoes, then top with reserved chives. Serve with salad on the side and lemon wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
