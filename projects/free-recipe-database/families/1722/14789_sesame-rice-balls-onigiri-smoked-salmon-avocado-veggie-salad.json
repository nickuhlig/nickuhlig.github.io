  "instructions": [
    {
      "id": 244801,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 244802,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 244803,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n3 medium carrots\n1 ½ avocados"
    },
    {
      "id": 244804,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with mayo, vinegar, sugar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n⅓ cup mayonnaise\n1 ½ tbsp rice vinegar\n1 tbsp brown sugar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 244805,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 244806,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 244807,
      "primary_message": "Peel, halve, and thinly slice shallot. Add to the bowl and stir to combine the salad; set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 244808,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 244809,
      "primary_message": "Once the skillet is hot, add sesame seeds; cook, stirring constantly, until seeds are toasted and golden brown, about 2 minutes. Remove from heat.",
      "secondary_message": "⅓ cup sesame seeds"
    },
    {
      "id": 244810,
      "primary_message": "Uncover the rice and fluff with a fork. Add toasted sesame seeds, vinegar, and sugar; stir to combine, then spread the rice out on a large baking sheet pan to cool, about 5 minutes.",
      "secondary_message": "1 ½ tsp rice vinegar\n1 ½ tsp brown sugar"
    },
    {
      "id": 244811,
      "primary_message": "Meanwhile, place soy sauce, vinegar, sugar, and crushed red pepper in a small bowl; whisk to combine the dipping sauce. Set aside.",
      "secondary_message": "3 tbsp soy sauce\n1 ½ tbsp rice vinegar\n1 ½ tsp brown sugar\n½ tsp crushed red pepper"
    },
    {
      "id": 244812,
      "primary_message": "Chop or tear salmon into bite-sized pieces. Halve and pit avocados; slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": "3 (113 g) pkg smoked salmon"
    },
    {
      "id": 244813,
      "primary_message": "Portion out the rice using a scant ¼-cup measure. Using lightly oiled hands, form each portion of rice into a ping pong-sized ball and return to the baking sheet. Layer salmon and avocado pieces over each rice ball.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 244814,
      "primary_message": "Divide rice balls (onigiri) and salad between plates. Serve with dipping sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
