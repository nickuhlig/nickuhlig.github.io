  "instructions": [
    {
      "id": 58192,
      "primary_message": "In a small saucepan, combine quinoa and broth. Bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 58191,
      "primary_message": "Wash apples and celery. Core and medium dice apples. Trim ends and medium dice celery. Transfer both to a large bowl.",
      "secondary_message": "6 Gala apples\n6 sticks celery\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 58194,
      "primary_message": "Core and medium dice the apples. Trim ends and medium dice the celery. Shave parsley leaves off the stems; discard the stems and mince the leaves. Transfer ingredients to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 58198,
      "primary_message": "Add almonds and cranberries to bowl.",
      "secondary_message": "¾ cup almonds\n¾ cup dried cranberries"
    },
    {
      "id": 58193,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lemon juice, oil, honey, salt, and pepper.",
      "secondary_message": "3 cloves garlic\n1 ½ lemon\n9 tbsp extra virgin olive oil\n1 ½ tsp honey\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 58195,
      "primary_message": "Uncover quinoa, fluff with a fork, and add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 58196,
      "primary_message": "Pour dressing over top salad and toss.",
      "secondary_message": ""
    },
    {
      "id": 58197,
      "primary_message": "To serve, place salad on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
