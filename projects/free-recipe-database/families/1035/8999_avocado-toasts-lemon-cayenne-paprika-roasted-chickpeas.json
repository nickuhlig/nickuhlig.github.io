  "instructions": [
    {
      "id": 140053,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 140054,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry, then transfer to a medium bowl. Add oil and spices to the bowl with the chickpeas and stir to combine. ",
      "secondary_message": "½ (398 ml) can garbanzo beans (chickpeas)\n1 ½ tsp extra virgin olive oil\n¼ tsp paprika\n⅛ tsp salt\n1 pinch cayenne pepper"
    },
    {
      "id": 140055,
      "primary_message": "Transfer chickpeas to a baking sheet and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until slightly crispy, about 15 minutes. Reserve bowl for next step.",
      "secondary_message": null
    },
    {
      "id": 140056,
      "primary_message": "Meanwhile, wash and juice lemon into the medium bowl.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 140057,
      "primary_message": "Wash, halve, and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. ",
      "secondary_message": "1 avocado"
    },
    {
      "id": 140058,
      "primary_message": "Add avocado, salt, and garlic powder to the bowl with the lemon juice and mash with a potato masher or fork. ",
      "secondary_message": "⅛ tsp salt\n⅛ tsp garlic powder"
    },
    {
      "id": 140059,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 140060,
      "primary_message": "To serve, divide toasts between dishes. Top with a layer of mashed avocado and a pile of warm roasted chickpeas. Enjoy! ",
      "secondary_message": null
    }
  ],
