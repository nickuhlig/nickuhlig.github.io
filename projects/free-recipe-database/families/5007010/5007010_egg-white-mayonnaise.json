  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Keep the egg white cold until you use it.",
      "secondary_message": "1 large egg white"
    },
    {
      "id": 1,
      "primary_message": "Combine egg white, lemon juice, mustard, salt, and oil in a container just wide enough to accommodate an immersion blender, such as a cocktail shaker or wide-mouth mason jar. Set blender to low, place flush with the bottom of the container, and pulse until oil disappears into a creamy spread, about 20 seconds. Refrigerate in an airtight container up to 2 weeks.",
      "secondary_message": null
    }
  ],
