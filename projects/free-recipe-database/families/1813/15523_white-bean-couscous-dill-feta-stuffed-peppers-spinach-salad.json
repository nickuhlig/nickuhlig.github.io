  "instructions": [
    {
      "id": 255534,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 yellow bell peppers\n1 small bunch fresh dill\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 255535,
      "primary_message": "Peel and mince garlic. Peel and small dice onions.",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 255536,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255537,
      "primary_message": "While the pot heats up, drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 255538,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic and onion; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 255539,
      "primary_message": "Add beans, broth, and spices to the pot; stir to combine and bring to a boil over high heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 255540,
      "primary_message": "Once the liquid is boiling, remove from heat; add couscous and stir to combine. Cover and let stand for 10 minutes.",
      "secondary_message": "1 ½ cups whole wheat couscous"
    },
    {
      "id": 255541,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 255542,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 255543,
      "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are tender and charred, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 255544,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the pot with the cooked couscous.",
      "secondary_message": null
    },
    {
      "id": 255545,
      "primary_message": "Mince olives and artichokes; add both to the pot along with half the feta (reserving the rest for topping the peppers). Stir to combine the filling.",
      "secondary_message": "½ cup Kalamata olives, pitted\n1 ½ (6 oz) jars artichoke hearts, marinated\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 255546,
      "primary_message": "Divide couscous filling between pepper halves and top with reserved feta. Return baking sheet to the oven and broil until cheese is golden, about 3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 255547,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a large bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n½ tsp salt\n3 pinch black pepper\n3 pinch oregano, dried"
    },
    {
      "id": 255548,
      "primary_message": "Mince walnuts. Add to the bowl with the dressing along with the spinach; toss to combine the salad.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 255549,
      "primary_message": "To serve, divide peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
