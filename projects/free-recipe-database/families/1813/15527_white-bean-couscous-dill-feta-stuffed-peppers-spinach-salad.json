  "instructions": [
    {
      "id": 255592,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 yellow bell peppers\n½ small bunch fresh dill\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 255593,
      "primary_message": "Peel and mince garlic. Peel and small dice onion.",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 255594,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255595,
      "primary_message": "While the pan heats up, drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 255596,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add garlic and onion; cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 255597,
      "primary_message": "Add beans, broth, and spices to the pan; stir to combine and bring to a boil over high heat.",
      "secondary_message": "237 ml chicken or vegetable broth\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 255598,
      "primary_message": "Once the liquid is boiling, remove from heat; add couscous and stir to combine. Cover and let stand for 10 minutes.",
      "secondary_message": "½ cup whole wheat couscous"
    },
    {
      "id": 255599,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 255600,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 255601,
      "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are tender and charred, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 255602,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the pan with the cooked couscous.",
      "secondary_message": null
    },
    {
      "id": 255603,
      "primary_message": "Mince olives and artichokes; add both to the pan along with half the feta (reserving the rest for topping the peppers). Stir to combine the filling.",
      "secondary_message": "⅛ cup Kalamata olives, pitted\n½ (170 ml) jar artichoke hearts, marinated\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 255604,
      "primary_message": "Divide couscous filling between pepper halves and top with reserved feta. Return baking sheet to the oven and broil until cheese is golden, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 255605,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a medium bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 ½ tsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n⅛ tsp salt\n1 pinch black pepper\n1 pinch oregano, dried"
    },
    {
      "id": 255606,
      "primary_message": "Mince walnuts. Add to the bowl with the dressing along with the spinach; toss to combine the salad.",
      "secondary_message": "⅛ cup walnuts"
    },
    {
      "id": 255607,
      "primary_message": "To serve, divide peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
