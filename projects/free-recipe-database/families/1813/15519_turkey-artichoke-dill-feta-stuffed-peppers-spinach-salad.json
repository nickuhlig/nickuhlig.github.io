  "instructions": [
    {
      "id": 255474,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 255475,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 yellow bell peppers\n1 small bunch fresh dill\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 255476,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 255477,
      "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are tender and charred, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 255478,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255479,
      "primary_message": "While the skillet heats up, peel and mince garlic. Peel and small dice onion.",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 255480,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and onion; cook, stirring often, until starting to soften, 2-3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 255481,
      "primary_message": "Add ground turkey and spices to the skillet; continue to cook, breaking the turkey apart with a spoon, until browned and crumbly, 3-4 minutes. Remove from heat.",
      "secondary_message": "1 ½ lb ground turkey\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 255482,
      "primary_message": "While the turkey is cooking, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the skillet with the cooked turkey.",
      "secondary_message": null
    },
    {
      "id": 255483,
      "primary_message": "Mince olives and artichokes; add both to the skillet along with half the feta (reserving the rest for topping the peppers). Stir to combine the filling.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n1 (6 oz) jar artichoke hearts, marinated\n1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 255484,
      "primary_message": "Divide turkey filling between pepper halves and top with reserved feta. Return baking sheet to the oven and broil until cheese is golden, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 255485,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a medium bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 ½ tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp oregano, dried"
    },
    {
      "id": 255486,
      "primary_message": "Mince walnuts. Add to the bowl with the dressing along with the spinach; toss to combine the salad.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 255487,
      "primary_message": "To serve, divide peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
