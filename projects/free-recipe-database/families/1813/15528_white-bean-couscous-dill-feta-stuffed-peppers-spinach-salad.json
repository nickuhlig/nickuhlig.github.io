  "instructions": [
    {
      "id": 255608,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 yellow bell peppers\n1 small bunch fresh dill\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 255609,
      "primary_message": "Peel and mince garlic. Peel and small dice onion.",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 255610,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255611,
      "primary_message": "While the pot heats up, drain and rinse beans; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 255612,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic and onion; cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 255613,
      "primary_message": "Add beans, broth, and spices to the pot; stir to combine and bring to a boil over high heat.",
      "secondary_message": "473 ml chicken or vegetable broth\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 255614,
      "primary_message": "Once the liquid is boiling, remove from heat; add couscous and stir to combine. Cover and let stand for 10 minutes.",
      "secondary_message": "1 cup whole wheat couscous"
    },
    {
      "id": 255615,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 255616,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 255617,
      "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are tender and charred, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 255618,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the pot with the cooked couscous.",
      "secondary_message": null
    },
    {
      "id": 255619,
      "primary_message": "Mince olives and artichokes; add both to the pot along with half the feta (reserving the rest for topping the peppers). Stir to combine the filling.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n1 (170 ml) jar artichoke hearts, marinated\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 255620,
      "primary_message": "Divide couscous filling between pepper halves and top with reserved feta. Return baking sheet to the oven and broil until cheese is golden, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 255621,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a medium bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 ½ tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp oregano, dried"
    },
    {
      "id": 255622,
      "primary_message": "Mince walnuts. Add to the bowl with the dressing along with the spinach; toss to combine the salad.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 255623,
      "primary_message": "To serve, divide peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
