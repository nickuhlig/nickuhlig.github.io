  "instructions": [
    {
      "id": 188758,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188759,
      "primary_message": "Add beef and spices to the saucepan and, breaking apart with a spoon, cook until browned and crumbly, 3-4 minutes.",
      "secondary_message": "⅓ kg lean ground beef\n½ tsp oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 188760,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 188761,
      "primary_message": "Transfer beef to a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 188762,
      "primary_message": "Return saucepan to medium-high heat, add oil, and swirl to coat the bottom.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 188763,
      "primary_message": "Add onion and garlic to the saucepan; cook, stirring frequently, until softened, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 188764,
      "primary_message": "Add broth to the saucepan and bring to a boil.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 188765,
      "primary_message": "Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "½ crown broccoli"
    },
    {
      "id": 188766,
      "primary_message": "Add broccoli to the saucepan and cook, stirring occasionally, until broccoli is tender, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 188767,
      "primary_message": "Ladle half the soup into a blender and purée until smooth. Return to the saucepan along with the cooked beef.",
      "secondary_message": null
    },
    {
      "id": 188768,
      "primary_message": "Reduce heat to medium, add milk, stir, and cook 5 minutes more.",
      "secondary_message": "177 ml whole milk"
    },
    {
      "id": 188769,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "⅓ (227 g) block cheddar cheese"
    },
    {
      "id": 188770,
      "primary_message": "Add cheese to the saucepan (reserving a small amount for garnish) and stir until melted.",
      "secondary_message": null
    },
    {
      "id": 188771,
      "primary_message": "To serve, divide soup between bowls and top with reserved cheese. Enjoy!",
      "secondary_message": null
    }
  ],
