  "instructions": [
    {
      "id": 188786,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188787,
      "primary_message": "Add beef and spices to the pot and, breaking apart with a spoon, cook until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tsp oregano\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 188788,
      "primary_message": "Meanwhile, peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 188789,
      "primary_message": "Transfer beef to a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 188790,
      "primary_message": "Return pot to medium-high heat, add oil, and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 188791,
      "primary_message": "Add onion and garlic to the pot; cook, stirring frequently, until softened, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 188792,
      "primary_message": "Add broth to the pot and bring to a boil.",
      "secondary_message": "1420 ml chicken or vegetable broth"
    },
    {
      "id": 188793,
      "primary_message": "Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 188794,
      "primary_message": "Add broccoli to the pot and cook, stirring occasionally, until broccoli is tender, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 188795,
      "primary_message": "Working in batches if necessary, ladle half the soup into a blender and purée until smooth. Return to the pot along with the cooked beef.",
      "secondary_message": null
    },
    {
      "id": 188796,
      "primary_message": "Reduce heat to medium, add milk, stir, and cook 5 minutes more.",
      "secondary_message": "532 ml whole milk"
    },
    {
      "id": 188797,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 188798,
      "primary_message": "Add cheese to the pot (reserving a small amount for garnish) and stir until melted.",
      "secondary_message": null
    },
    {
      "id": 188799,
      "primary_message": "To serve, divide soup between bowls and top with reserved cheese. Enjoy!",
      "secondary_message": null
    }
  ],
