  "instructions": [
    {
      "id": 188730,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188731,
      "primary_message": "Add beef and spices to the pot and, breaking apart with a spoon, cook until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 ½ lb lean ground beef\n1 tsp oregano\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 188732,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 188733,
      "primary_message": "Transfer beef to a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 188734,
      "primary_message": "Return pot to medium-high heat, add oil, and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 188735,
      "primary_message": "Add onion and garlic to the pot; cook, stirring frequently, until softened, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 188736,
      "primary_message": "Add broth to the pot and bring to a boil.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth"
    },
    {
      "id": 188737,
      "primary_message": "Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 188738,
      "primary_message": "Add broccoli to the pot and cook, stirring occasionally, until broccoli is tender, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 188739,
      "primary_message": "Working in batches if necessary, ladle half the soup into a blender and purée until smooth. Return to the pot along with the cooked beef.",
      "secondary_message": null
    },
    {
      "id": 188740,
      "primary_message": "Reduce heat to medium, add milk, stir, and cook 5 minutes more.",
      "secondary_message": "12 fl oz (1 ½ cups) whole milk"
    },
    {
      "id": 188741,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 188742,
      "primary_message": "Add cheese to the pot (reserving a small amount for garnish) and stir until melted.",
      "secondary_message": null
    },
    {
      "id": 188743,
      "primary_message": "To serve, divide soup between bowls and top with reserved cheese. Enjoy!",
      "secondary_message": null
    }
  ],
