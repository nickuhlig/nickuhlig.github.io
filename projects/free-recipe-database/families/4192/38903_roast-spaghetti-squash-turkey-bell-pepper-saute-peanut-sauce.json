  "instructions": [
    {
      "id": 605577,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 605578,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium spaghetti squash\n3 limes\n3 (2 ½ cm) pieces ginger root\n3 red bell peppers"
    },
    {
      "id": 605579,
      "primary_message": "Trim each spaghetti squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheets. ",
      "secondary_message": "1 ½ tbsp neutral vegetable oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 605580,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 605581,
      "primary_message": "Meanwhile, juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 605582,
      "primary_message": "Peel and mince ginger. Add to the bowl with the lime juice along with peanut butter, water, soy sauce, chili-garlic sauce, sugar, and spices. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "½ cup natural peanut butter\n3 tbsp water\n3 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n¾ tsp turmeric, ground\n¾ tsp curry powder\n½ tsp salt"
    },
    {
      "id": 605583,
      "primary_message": "Trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 605584,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 605585,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, turkey, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "2 tbsp neutral vegetable oil\n1.02 kg ground turkey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 605586,
      "primary_message": "Add half of the peanut sauce to the pot and stir to combine. Remove from heat and cover to keep warm. (Reserve remaining peanut sauce for serving.)",
      "secondary_message": null
    },
    {
      "id": 605587,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 605588,
      "primary_message": "To serve, divide squash and turkey sauté between plates or bowls. Drizzle with reserved peanut sauce and enjoy!",
      "secondary_message": null
    }
  ],
