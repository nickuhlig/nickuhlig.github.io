  "instructions": [
    {
      "id": 605601,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 605602,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium spaghetti squash\n2 limes\n2 (2 ½ cm) pieces ginger root\n2 red bell peppers"
    },
    {
      "id": 605603,
      "primary_message": "Trim each spaghetti squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheet. ",
      "secondary_message": "1 tbsp neutral vegetable oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 605604,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 605605,
      "primary_message": "Meanwhile, juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 605606,
      "primary_message": "Peel and mince ginger. Add to the bowl with the lime juice along with peanut butter, water, soy sauce, chili-garlic sauce, sugar, and spices. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "⅓ cup natural peanut butter\n2 tbsp water\n2 tbsp soy sauce\n2 tsp chili-garlic sauce\n2 tsp brown sugar\n½ tsp turmeric, ground\n½ tsp curry powder\n¼ tsp salt"
    },
    {
      "id": 605607,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 605608,
      "primary_message": "While the skillet heats up, trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 605609,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, veggie ground, salt, and pepper; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "4 tsp neutral vegetable oil\n454 g veggie ground, plant based\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 605610,
      "primary_message": "Add half of the peanut sauce to the skillet and stir to combine. Remove from heat and cover to keep warm. (Reserve remaining peanut sauce for serving.)",
      "secondary_message": null
    },
    {
      "id": 605611,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 605612,
      "primary_message": "To serve, divide squash and veggie ground sauté between plates or bowls. Drizzle with reserved peanut sauce and enjoy!",
      "secondary_message": null
    }
  ],
