  "instructions": [
    {
      "id": 419343,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 419344,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 419345,
      "primary_message": "Place tortilla chips in a medium bowl and crush with the back of a spoon to create coarse crumbs. Add spices and stir to combine the coating.",
      "secondary_message": "2 oz tortilla chips\n1 ½ tbsp taco seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 419346,
      "primary_message": "Cut tofu crosswise into planks. Wipe baking sheet dry with paper towels and return tofu to the pan.",
      "secondary_message": null
    },
    {
      "id": 419347,
      "primary_message": "Spread half of the mayo over top side of the tofu, sprinkle with half of the coating, and drizzle with half of the oil. Carefully flip tofu and repeat with remaining mayo, coating, and oil. (Reserve bowl for the salad.)",
      "secondary_message": "1 tbsp mayonnaise\n2 tsp extra virgin olive oil"
    },
    {
      "id": 419348,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until tofu is golden brown, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 419349,
      "primary_message": "Meanwhile, wash, dry, and medium dice tomato. Place in the reserved bowl.",
      "secondary_message": "1 tomato"
    },
    {
      "id": 419350,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the tomato, toss to combine the salad, and set aside.",
      "secondary_message": "2 hearts romaine hearts"
    },
    {
      "id": 419351,
      "primary_message": "When the tofu is done, slice crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 419352,
      "primary_message": "To serve, divide salad between plates or bowls, then top with cheese and tofu. Drizzle with dressing. Enjoy!",
      "secondary_message": "½ cup shredded cheese, Mexican blend\n¼ cup ranch dressing"
    }
  ],
