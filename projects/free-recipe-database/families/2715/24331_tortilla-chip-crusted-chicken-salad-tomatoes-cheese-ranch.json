  "instructions": [
    {
      "id": 419373,
      "primary_message": "Preheat oven to 220°C (425°F). Line a baking sheet pan with aluminum foil and coat with a thin layer of oil; set aside. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 419374,
      "primary_message": "Place tortilla chips in a small bowl and crush with the back of a spoon to create coarse crumbs. Add spices and stir to combine the coating.",
      "secondary_message": "57 g tortilla chips\n1 ½ tbsp taco seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 419375,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 419376,
      "primary_message": "Spread mayo over both sides of the cutlets, then dredge in the coating, pressing gently to adhere. Transfer cutlets to the baking sheet.",
      "secondary_message": "1 tbsp mayonnaise"
    },
    {
      "id": 419377,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping chicken halfway through, until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 419378,
      "primary_message": "Meanwhile, wash and dry tomato. Using a clean cutting board, medium dice, and place in a medium bowl.",
      "secondary_message": "1 tomato"
    },
    {
      "id": 419379,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the tomato, toss to combine the salad, and set aside.",
      "secondary_message": "2 hearts romaine hearts"
    },
    {
      "id": 419380,
      "primary_message": "When the chicken is done, slice into strips.",
      "secondary_message": null
    },
    {
      "id": 419381,
      "primary_message": "To serve, divide salad between plates or bowls, then top with cheese and chicken. Drizzle with dressing. Enjoy!",
      "secondary_message": "½ cup shredded cheese, Mexican blend\n¼ cup ranch dressing"
    }
  ],
