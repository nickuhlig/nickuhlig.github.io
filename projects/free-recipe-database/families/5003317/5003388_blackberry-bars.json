  "instructions": [
    {
      "id": 1,
      "primary_message": "Make Crust: In the bowl of a food processor, pulse together flour and confectioners sugar until combined. Add butter and pulse until butter is the size of peas. Add milk and pulse until dough comes together into a ball. Press dough evenly into prepared pan and place in refrigerator for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Grease baking dish with butter. Place almond slivers on a baking sheet and toast until golden, 6 to 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake crust until just beginning to color on top and brown on edges, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Make Topping: In a medium bowl, whisk together egg whites until frothy, then whisk in confectioners sugar until smooth. Whisk in almond extract.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spread jam evenly over top of parbaked crust. Dollop egg white mixture over top, leaving sporadic patches of jam peeking through. Top with toasted almonds. Bake until topping is golden, about 15 minutes. Let cool, then cut into 12 bars and serve. Store cooled bars in a sealed container at room temperature for up to 5 days.",
      "secondary_message": null
    }
  ],
