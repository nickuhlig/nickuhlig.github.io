  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the unsalted butter into 1/2-inch pieces.",
      "secondary_message": "6 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "In a pot of lightly salted boiling water, cook spaghetti until al dente, according to timing given in package instructions.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, using a sharp paring knife, slice mentaiko lobes open and scrape out roe. Reserve 2 teaspoons roe for garnish and place the rest in a large heatproof bowl. Add soy sauce to bowl with roe and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When spaghetti is cooked, transfer to bowl with roe using tongs. Add 1/4 cup pasta-cooking water and butter, 2 pieces at a time, and stir and toss pasta until butter is melted and forms sauce. Continue to stir and toss pasta until evenly coated in sauce, any excess liquid has been absorbed, and a smooth, creamy sauce has formed. Transfer to individual serving bowls, top each bowl with reserved roe, and garnish with nori strips. Serve right away, mixing nori and roe garnish in with chopsticks before eating.",
      "secondary_message": null
    }
  ],
