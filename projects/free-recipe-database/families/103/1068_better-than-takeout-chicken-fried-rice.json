  "instructions": [
    {
      "id": 8231,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml (2 cups) water"
    },
    {
      "id": 40521,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 8232,
      "primary_message": "Peel and mince garlic. Peel and small dice onion. Wash and dry carrots and green onions. Peel and small dice the carrots. Trim root ends and chop the onions. Measure out peas.",
      "secondary_message": "2 cloves garlic\r\n1 medium yellow onion\r\n4 medium carrots\r\n1 small bunch green onions (scallions)\r\n2 cups frozen peas"
    },
    {
      "id": 8233,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 8234,
      "primary_message": "Cut chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 8235,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and, stirring occasionally, cook until cooked through, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "about 2 tbsp toasted sesame oil"
    },
    {
      "id": 8236,
      "primary_message": "Return skillet to stove, increase heat to medium-high, and add more oil. Add garlic, yellow onion, carrots, and peas to skillet. Stir fry until tender, 2-3 minutes.",
      "secondary_message": "about 2 tbsp toasted sesame oil"
    },
    {
      "id": 8237,
      "primary_message": "In a small bowl, whisk eggs.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 8238,
      "primary_message": "Move vegetables to one side of the skillet and pour eggs on the other side. Scramble eggs until cooked and mix with vegetables.",
      "secondary_message": ""
    },
    {
      "id": 8239,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 8240,
      "primary_message": "Add rice, chicken, and soy sauce to vegetables. Stir until well combined and heated through, 1-2 minutes.",
      "secondary_message": "4 tbsp soy sauce"
    },
    {
      "id": 8241,
      "primary_message": "Remove from heat and sprinkle with green onions.",
      "secondary_message": ""
    },
    {
      "id": 8242,
      "primary_message": "To serve, place fried rice in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
