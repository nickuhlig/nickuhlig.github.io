  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim the oxtail of fat. Halve the garlic crosswise. Peel and finely dice the shallots.",
      "secondary_message": "4 lb oxtail\n1 head garlic\n11 shallots"
    },
    {
      "id": 1,
      "primary_message": "Place the oxtail, 4 cups of the red wine, garlic, thyme, and peppercorns in a large pot or sauté pan. Add water to cover by 1/2 inch. Bring the mixture to a boil, reduce the heat, and simmer until meat is falling off bones, about 3 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer the oxtail to a bowl; when cool enough to handle, remove the meat from the bones and cut it roughly into small cubes, about 1/2-inch. Refrigerate the meat until it's ready to use.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Strain the oxtail stock into a large skillet, discarding the solids. Bring the liquid to a boil over high heat; reduce the heat to medium and simmer until the mixture is reduced to 3 cups, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "While the stock reduces, combine 3 tablespoons of the butter with the flour until it forms a paste. Over medium heat, whisk the paste, 1 tablespoon at a time, into the reduced liquid. Cook until the mixture thickens slightly, about 3 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "In a separate large skillet, melt the remaining 5 tablespoons butter over medium heat. Add the carrots, shallots, and a pinch of salt and cook until slightly softened, about 15 minutes. Stir in the sugars, the remaining red wine, the vinegar, the 1 1/2 teaspoons salt, and the pepper. Cook over medium-high heat stirring frequently until the liquid has completely evaporated, about 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Stir in the oxtail meat and thickened oxtail stock. Season to taste with salt and pepper. Set aside or transfer the marmalade to an airtight container and refrigerate overnight. Before serving, reheat in a saucepan over medium heat until warmed through, and served with toasted rounds of bread.",
      "secondary_message": null
    }
  ],
