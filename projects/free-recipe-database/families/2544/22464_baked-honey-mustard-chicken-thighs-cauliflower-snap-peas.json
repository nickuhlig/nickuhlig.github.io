  "instructions": [
    {
      "id": 374398,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 374399,
      "primary_message": "Transfer cauliflower to a large baking sheet pan. Drizzle with oil and season with spices. Toss to coat and spread out in an even layer. ",
      "secondary_message": "3 (10 oz) bags cauliflower florets\n2 tbsp extra virgin olive oil\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 374400,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until starting to soften, about 10 minutes. Remove from oven and set aside. ",
      "secondary_message": null
    },
    {
      "id": 374401,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and place on a plate. Season with salt and pepper.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 374402,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 374403,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the chicken and cook until golden brown and almost cooked through, about 3 minutes per side. Transfer to a plate. (Reserve skillet with juices for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 374404,
      "primary_message": "Arrange chicken on top of the cauliflower, then drizzle dressing over the chicken. Return baking sheet to the oven and bake until cauliflower is fork-tender and chicken is cooked through, 8-10 minutes. Remove from oven. ",
      "secondary_message": "¾ cup honey mustard dressing"
    },
    {
      "id": 374405,
      "primary_message": "Meanwhile, return skillet (with juices) to medium-high heat. Add snap peas and spices; cook, stirring occasionally, until fork-tender, 4-5 minutes. Remove from heat. ",
      "secondary_message": "3 (8 oz) pkg sugar snap peas\n½ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 374406,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
