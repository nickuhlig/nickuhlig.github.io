  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Coarsely chop the kimchi brine plus 1 cup drained kimchi. Lightly beat the egg.",
      "secondary_message": "¼ cup kimchi brine plus 1 cup drained kimchi\n1 large egg"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, stir together the all-purpose flour, rice flour, water, kimchi brine, and egg; the mixture should be the consistency of slightly lumpy pancake batter. Stir in the chopped kimchi, scallion segments, shrimp, and salt. Add a little more water if needed. Set batter aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, stir together soy sauce, rice vinegar, sesame oil, sugar or honey, and sesame seeds. Set dipping sauce aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat oven to its lowest heat setting. In a large skillet, heat about 1 tablespoon oil over medium-high heat until shimmering. Pour 1/4 cup of batter into the skillet and spread it into a 10-cm circle. Repeat until pan is full but not crowded. (Alternatively, you can make one large 20-cm pancake per batch). Cook until the edges turn golden and crispy, 2 to 4 minutes. Flip pancakes, add a little more oil, if needed, and cook for about another 2 to 3 minutes until cooked through. Repeat with the remaining batter, adding oil as needed.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Arrange cooked pancakes in a single layer on a baking sheet and keep in warm oven until ready to serve. Serve whole or cut into wedges, garnished with scallions, and with dipping sauce and quick-pickled radishes on the side.",
      "secondary_message": null
    }
  ],
