  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Muffins: Adjust oven rack to middle position, and preheat to 350°F (175ºC). Line a 12-cup muffin pan with paper liners.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk flour, brown sugar, cinnamon, baking soda, ginger, and salt to combine. Using a flexible spatula, fold in carrots, apple, coconut, golden raisins, and pecans until well combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium bowl, whisk eggs, oil, 1 teaspoon orange zest, 1/4 cup orange juice, and vanilla to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Fold egg mixture into carrot mixture until just combined. Divide batter evenly among prepared muffin cups (heaping 1/3 cup each). (It’s OK if the batter reaches the top of the paper liner.)",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake until a cake tester or wooden pick inserted into the center comes out clean, 25 to 28 minutes. Let cool in pan for 10 minutes; transfer to a wire rack to cool completely, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For the Glaze: In a medium bowl, whisk powdered sugar and 1/2 teaspoon orange zest. Whisk in 3 to 4 teaspoons orange juice, 1/2 teaspoon at a time, until mixture is smooth and pourable.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Drizzle glaze over the cooled muffins. Garnish with additional orange zest if desired. Serve.",
      "secondary_message": null
    }
  ],
