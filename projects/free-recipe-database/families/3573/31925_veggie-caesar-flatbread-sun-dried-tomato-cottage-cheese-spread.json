  "instructions": [
    {
      "id": 504657,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 504658,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 504659,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n1 head romaine lettuce\n2 tomatoes"
    },
    {
      "id": 504660,
      "primary_message": "Zest and juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 504661,
      "primary_message": "Peel garlic. Add to the blender along with capers, sun-dried tomatoes, Dijon, oil, honey, salt, and pepper. Blend on high until smooth. Transfer half of the dressing to a medium bowl and set aside for the salad.",
      "secondary_message": "4 cloves garlic\n4 tbsp capers\n4 sun-dried tomatoes, oil-packed\n2 tbsp Dijon mustard\n4 tsp extra virgin olive oil\n1 tsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 504662,
      "primary_message": "Add cottage cheese and more oil to the blender with the remaining dressing. Blend once more on high until smooth. Set cottage cheese spread aside.",
      "secondary_message": "1 cup cottage cheese\n4 tsp extra virgin olive oil"
    },
    {
      "id": 504663,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 504664,
      "primary_message": "Medium dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 504665,
      "primary_message": "Drain and roughly chop artichoke hearts. Add to the bowl.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 504666,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and gently toss to combine the salad.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 504667,
      "primary_message": "Spoon the cottage cheese spread over each flatbread, then top with salad.",
      "secondary_message": null
    },
    {
      "id": 504668,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
