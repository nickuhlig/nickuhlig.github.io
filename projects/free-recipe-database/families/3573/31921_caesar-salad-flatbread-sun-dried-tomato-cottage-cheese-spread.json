  "instructions": [
    {
      "id": 504609,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 504610,
      "primary_message": "Arrange flatbreads on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 504611,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ head romaine lettuce\n1 tomato"
    },
    {
      "id": 504612,
      "primary_message": "Zest and juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 504613,
      "primary_message": "Peel garlic. Add to the blender along with anchovy fillets, sun-dried tomatoes, Dijon, oil, honey, salt, and pepper. Blend on high until smooth. Transfer half of the dressing to a medium bowl and set aside for the salad.",
      "secondary_message": "2 cloves garlic\n2 anchovy fillets, packed in oil\n2 sun-dried tomatoes, oil-packed\n1 tbsp Dijon mustard\n2 tsp extra virgin olive oil\n½ tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 504614,
      "primary_message": "Add cottage cheese and more oil to the blender with the remaining dressing. Blend once more on high until smooth. Set cottage cheese spread aside.",
      "secondary_message": "½ cup cottage cheese\n2 tsp extra virgin olive oil"
    },
    {
      "id": 504615,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 504616,
      "primary_message": "Medium dice tomato. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 504617,
      "primary_message": "Drain and roughly chop artichoke hearts. Add to the bowl.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 504618,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and gently toss to combine the salad.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 504619,
      "primary_message": "Spoon the cottage cheese spread over each flatbread, then top with salad.",
      "secondary_message": null
    },
    {
      "id": 504620,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
