  "instructions": [
    {
      "id": 8592,
      "primary_message": "Rinse lentils under cold water and transfer to a small saucepan. Add water and salt; bring to a boil. Reduce heat to a simmer and cook until tender, 15-25 minutes.",
      "secondary_message": "¾ cup brown lentils\r\n⅛ tsp salt\r\n1 ½ cups water"
    },
    {
      "id": 8593,
      "primary_message": "Wash and dry zucchini, potato, bell pepper, and parsley.",
      "secondary_message": "1 zucchini\r\n1 medium yellow potato\r\n1 red bell pepper\r\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 8594,
      "primary_message": "Coarsely grate the zucchini. Peel and coarsely grate the potato. Place both in the middle of a clean tea towel, bring the corners together, and squeeze out excess moisture. Transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 8595,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 8596,
      "primary_message": "Add oil, flour, salt, and pepper to bowl and mix.",
      "secondary_message": "½ tbsp extra virgin olive oil\n3 tbsp all-purpose flour\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 8597,
      "primary_message": "Once the skillet is hot, add oil to coat the bottom. Using a ¼ cup measure, form the zucchini mixture into patties. Working in batches if necessary, add patties to the skillet and flatten into ½-thick circles using the back of a spatula. Cook, flipping once, until golden and cooked through, 6-8 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 8598,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. In a small bowl, prepare sauce by mixing together ½ of the minced parsley (save the rest for the salad), yogurt, salt, and pepper. Set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 8599,
      "primary_message": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together garlic, oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "1 clove garlic\n1 ½ tbsp extra virgin olive oil\n½ tbsp balsamic vinegar\n⅛ tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 8600,
      "primary_message": "Add remaining parsley to bowl with dressing. Seed bell pepper, cut into small strips, and add to the bowl.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 8602,
      "primary_message": "Drain lentils, add to bowl, and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 8603,
      "primary_message": "To serve, divide lentil salad and fritters between plates. Crumble goat cheese over the salad and top fritters with yogurt sauce. Enjoy!",
      "secondary_message": "½ (113 g) log goat cheese"
    }
  ],
