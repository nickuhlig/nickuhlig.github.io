  "instructions": [
    {
      "id": 29758,
      "primary_message": "Heat the oven to 450°F and position rack in the center.",
      "secondary_message": null
    },
    {
      "id": 29759,
      "primary_message": "Place the eggs in a small saucepan and fill with enough water to cover the eggs by about 1 inch. Cover the saucepan and bring to a full rolling boil over high heat.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 29760,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n1 ½ lb new potatoes"
    },
    {
      "id": 29761,
      "primary_message": "Cut the potatoes lengthwise into 4 wedges and transfer to a baking sheet.",
      "secondary_message": null
    },
    {
      "id": 29762,
      "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears into 1-inch pieces and add to the potatoes.",
      "secondary_message": null
    },
    {
      "id": 29763,
      "primary_message": "Drizzle the potatoes and asparagus with olive oil and season with salt and pepper; toss to coat, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 29764,
      "primary_message": "Place the sheet in the oven and roast until the vegetables are tender, 10 to 15 minutes. Once done, remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 29765,
      "primary_message": "Once the water in the saucepan in boiling, remove the pan from the heat, cover, and let it sit for 8 minutes. Drain and place the saucepan under cold running water for 1 to 2 minutes to allow the eggs to cool. Alternatively, add ice to the saucepan.",
      "secondary_message": ""
    },
    {
      "id": 29766,
      "primary_message": "Juice the lemon into a large bowl, then add olive oil, Dijon, salt, and pepper; whisk together. Set aside.",
      "secondary_message": "1 lemon\n4 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 29767,
      "primary_message": "Peel, halve lengthwise, then thinly slice the shallots; add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 29768,
      "primary_message": "Measure out the almonds and add to the bowl.",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "id": 29769,
      "primary_message": "Measure out the capers and add to the bowl.",
      "secondary_message": "2 tbsp capers"
    },
    {
      "id": 29770,
      "primary_message": "Transfer the roasted vegetables to the bowl and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 29771,
      "primary_message": "Peel and quarter the eggs lengthwise.",
      "secondary_message": null
    },
    {
      "id": 29772,
      "primary_message": "To serve, divide the salad between plates and place the egg wedges overtop. Enjoy!",
      "secondary_message": null
    }
  ],
