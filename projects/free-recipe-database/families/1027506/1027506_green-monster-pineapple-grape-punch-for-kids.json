  "instructions": [
    {
      "primary_message": "Wash, dry, and halve grapes. Place in a pitcher or large jug. (If you have children under the age of 5, quarter the grapes to prevent a potential choking hazard.)",
      "secondary_message": "½ lb green grapes"
    },
    {
      "primary_message": "Add 64 fl oz (8 cups) chilled soda, 32 fl oz (4 cups) chilled pineapple juice, and food coloring to the pitcher, then gently stir to combine (add more food coloring as needed to achieve your desired color). Add ice to the pitcher and gently stir once more to combine. ",
      "secondary_message": "64 fl oz lemon lime soda\n32 fl oz pineapple juice\n6 drop green food coloring"
    },
    {
      "primary_message": "To serve, divide punch between cups and enjoy!",
      "secondary_message": null
    }
