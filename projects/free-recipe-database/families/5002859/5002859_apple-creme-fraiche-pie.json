  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Lightly beat the egg. Beat the Egg wash: 1 egg with a big pinch of salt.",
      "secondary_message": "1 egg\nEgg wash: 1 egg"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk together crème fraîche, sugar, egg, salt, vanilla, cinnamon, and flour and set aside. In the bowl of a food processor, combine the oats and brown sugar and pulse until they are a sandy consistency, about 15 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Arrange the apples in the chilled shaped crust and pour the custard mixture over the top. Sprinkle the oatmeal mixture over the top of the custard. Remove the chilled dough sheet from the fridge and cut into 1/2 inch strips. Use the strips to weave a lattice top. Allow the pie to rest in the fridge for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven rack to lower position and preheat oven to 400°F. When the pie has rested, brush it with egg wash, sprinkle sugar over the top. Bake for 15 minutes, then rotate the pie and turn the oven down to 350°F. Bake until the filling is set in the middle and crust is golden brown, about 30 minutes longer. Cool completely before serving, at least 1 hour.",
      "secondary_message": null
    }
  ],
