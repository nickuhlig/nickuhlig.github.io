  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Grate the ginger.",
      "secondary_message": "2 medium cloves garlic\n1 tsp fresh ginger"
    },
    {
      "id": 1,
      "primary_message": "Heat soy sauce, vinegar, mirin, brown sugar, garlic, ginger, crushed red pepper, and sesame oil in a small saucepan over medium heat, whisking until sugar is dissolved. Combine corn starch with 1 tablespoon water in a small bowl and whisk into sauce. Bring to a boil and cook until sauce is slightly reduced and thickened, about 3 minutes. Transfer to a bowl and allow to cool for 5 minutes. Serve with Korean Fried Chicken, garnishing with scallions, if desired.",
      "secondary_message": null
    }
