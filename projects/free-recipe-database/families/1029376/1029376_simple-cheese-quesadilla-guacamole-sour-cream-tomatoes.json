  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 avocado\n¼ lime\n1 tomato"
    },
    {
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and place in a small bowl. Mash with a fork or potato masher until smooth.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Juice lime into the bowl with the avocado, add spices, and stir to combine the guacamole. Set aside.\n\n",
      "secondary_message": "1 pinch garlic powder\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "primary_message": "Small dice tomato and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide cheese between them, arranging on one half of each tortilla. Fold in half to close. ",
      "secondary_message": "2 cups Monterey Jack cheese, shredded"
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, place assembled quesadillas in the skillet and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 4-5 minutes. Remove to a cutting board and cut into wedges.\n\n",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "primary_message": "Divide quesadillas between plates. Serve with guacamole, tomatoes, and sour cream. Enjoy! ",
      "secondary_message": "½ cup sour cream"
    }
  ],
