  "instructions": [
    {
      "id": 398917,
      "primary_message": "Pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 398918,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398919,
      "primary_message": "Once the grill pan is hot, coat with oil; Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 398920,
      "primary_message": "Meanwhile, fill a large pot with 2-inches of hot water (from the tap), cover, and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 398921,
      "primary_message": "While the water comes to a boil, peel and mince shallots. Place in a small bowl along with miso paste, chili-garlic sauce, oil, sesame seeds, sugar, and garlic powder. Stir to combine the spicy miso sauce and set aside.",
      "secondary_message": "2 shallots\n¼ cup miso paste, white\n2 tbsp chili-garlic sauce\n2 tbsp toasted sesame oil\n1 tbsp sesame seeds\n1 tbsp brown sugar\n¾ tsp garlic powder"
    },
    {
      "id": 398922,
      "primary_message": "Once the water is boiling, reduce heat to medium, then add cauliflower and broccoli. Re-cover and steam until veggies are fork tender, 5-6 minutes.",
      "secondary_message": "3 (283 g) bags cauliflower florets\n1 ½ (510 g) bags broccoli florets"
    },
    {
      "id": 398923,
      "primary_message": "When the veggies are done, drain and return to the pot. Drizzle with oil, sprinkle with sesame seeds, and season with salt and pepper; toss to coat.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp sesame seeds\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 398924,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 398925,
      "primary_message": "To serve, divide steak and veggies between plates; drizzle steak with spicy miso sauce. Enjoy!",
      "secondary_message": null
    }
  ],
