  "instructions": [
    {
      "id": 398881,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398882,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 398883,
      "primary_message": "Once the grill pan is hot, coat with oil; add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 398884,
      "primary_message": "Meanwhile, fill a large pot with 2-inches of hot water (from the tap), cover, and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 398885,
      "primary_message": "While the water comes to a boil, peel and mince shallot. Place in a small bowl along with miso paste, chili-garlic sauce, oil, sesame seeds, sugar, and garlic powder. Stir to combine the spicy miso sauce and set aside.",
      "secondary_message": "1 shallot\n3 tbsp miso paste, white\n4 tsp chili-garlic sauce\n4 tsp toasted sesame oil\n2 tsp sesame seeds\n2 tsp brown sugar\n½ tsp garlic powder"
    },
    {
      "id": 398886,
      "primary_message": "Once the water is boiling, reduce heat to medium, then add cauliflower and broccoli. Re-cover and steam until veggies are fork tender, 5-6 minutes.",
      "secondary_message": "2 (10 oz) bags cauliflower florets\n1 (18 oz) bag broccoli florets"
    },
    {
      "id": 398887,
      "primary_message": "When the veggies are done, drain and return to the pot. Drizzle with oil, sprinkle with sesame seeds, and season with salt and pepper; toss to coat.",
      "secondary_message": "4 tsp toasted sesame oil\n4 tsp sesame seeds\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 398888,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 398889,
      "primary_message": "To serve, divide steak and veggies between plates; drizzle steak with spicy miso sauce. Enjoy!",
      "secondary_message": null
    }
  ],
