  "instructions": [
    {
      "id": 291490,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 291491,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n1 small bunch fresh dill\n1 ½ English cucumbers\n1 ½ pints grape tomatoes\n1 ½ green bell peppers"
    },
    {
      "id": 291492,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 291493,
      "primary_message": "Peel and finely dice the onion. Peel and mince garlic; add both to the bowl with the parsley.",
      "secondary_message": "1 medium red onion\n3 cloves garlic"
    },
    {
      "id": 291494,
      "primary_message": "Add ground beef, eggs, and spices to the bowl and mix with your hands until well combined. ",
      "secondary_message": "2 ¼ lb lean ground beef\n3 eggs\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 291495,
      "primary_message": "Coat a large baking sheet pan with olive oil. Using a tablespoon measure, form the meat mixture into rounded meatballs and place in the dish, spacing them 1-inch apart. Place the dish in the oven and bake until cooked through, 15-20 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 291496,
      "primary_message": "Meanwhile, make the tzatziki. Mince half of the cucumber and transfer to a medium bowl along with the yogurt, oil, and salt.",
      "secondary_message": "1 cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 291497,
      "primary_message": "Juice and grate the zest from the lemon into the tzatziki bowl.",
      "secondary_message": null
    },
    {
      "id": 291498,
      "primary_message": "Shave the dill leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. Add both to the tzatziki and stir to combine.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 291499,
      "primary_message": "Halve the remaining cucumber lengthwise, then slice crosswise into half rounds. Halve the tomatoes. Transfer both to a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 291500,
      "primary_message": "Seed the peppers and slice crosswise to form rings. Peel and slice the remaining shallot into rings. Add both to the salad bowl.",
      "secondary_message": "1 ½ shallots"
    },
    {
      "id": 291501,
      "primary_message": "Add veggies, feta, olives, oil, and oregano to a salad bowl and stir to combine. ",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese\n⅜ cup Kalamata olives, pitted\n2 tbsp extra virgin olive oil\n¾ tsp oregano, dried"
    },
    {
      "id": 291502,
      "primary_message": "To serve, divide salad between bowls and top with meatballs and Tzatziki sauce. Enjoy!",
      "secondary_message": null
    }
  ],
