  "instructions": [
    {
      "id": 291516,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 291517,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 English cucumber\n1 lemon\n1 small bunch fresh dill\n1 pint grape tomatoes\n2 green bell peppers"
    },
    {
      "id": 291518,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 291519,
      "primary_message": "Peel and mince shallots and garlic; add both to the bowl with the parsley. ",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 291520,
      "primary_message": "Add veggie ground, eggs, almond flour, and spices to the bowl and mix with your hands until well combined. ",
      "secondary_message": "16 oz veggie ground, plant based\n2 eggs\n¼ cup almond meal/flour\n2 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 291521,
      "primary_message": "Coat a large baking dish with a thin layer of oil. Using a tablespoon measure, form the mixture into rounded meatballs and arrange in the dish. Place dish in the oven and bake until cooked through, about 15 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 291522,
      "primary_message": "Meanwhile, mince half of the cucumber and place in a small bowl along with yogurt and salt. (Reserve remaining cucumber for later use.) ",
      "secondary_message": "⅔ cup plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 291523,
      "primary_message": "Zest and juice lemon into the bowl with the cucumber and yogurt. ",
      "secondary_message": null
    },
    {
      "id": 291524,
      "primary_message": "Shave the dill leaves off the stems; discard stems and mince the leaves. Peel and mince garlic. Add both to the bowl and stir to combine the tzatziki. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 291525,
      "primary_message": "Halve the remaining cucumber lengthwise, then slice crosswise into half-moons. Halve tomatoes. Place both in another medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 291526,
      "primary_message": "Trim, seed, and thinly slice bell peppers into rounds. Peel and slice additional shallots into thin rings. Add both to the bowl with the cucumber and tomato. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 291527,
      "primary_message": "Add feta, olives, oil, and oregano to the bowl and stir to combine the salad. ",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese\n½ cup Kalamata olives, pitted\n2 tsp extra virgin olive oil\n1 tsp oregano, dried"
    },
    {
      "id": 291528,
      "primary_message": "To serve, divide salad between bowls; top with veggie meatballs and tzatziki sauce. Enjoy!",
      "secondary_message": null
    }
  ],
