  "instructions": [
    {
      "id": 291529,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 291530,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ English cucumbers\n1 ½ lemons\n1 small bunch fresh dill\n1 ½ pints grape tomatoes\n3 green bell peppers"
    },
    {
      "id": 291531,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 291532,
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic. Add both to the bowl with the parsley.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 291533,
      "primary_message": "Add veggie ground, eggs, almond flour, and spices to the bowl and mix with your hands until well combined. ",
      "secondary_message": "24 oz veggie ground, plant based\n3 eggs\n⅓ cup almond meal/flour\n1 tbsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 291534,
      "primary_message": "Coat a large baking sheet pan with a thin layer of oil. Using a tablespoon measure, form the mixture into rounded meatballs and arrange on the baking sheet. Place in the oven and bake until cooked through, 15-20 minutes. ",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 291535,
      "primary_message": "Meanwhile, mince half of the cucumbers and place in another medium bowl along with yogurt and salt. (Reserve remaining cucumber for later use.) ",
      "secondary_message": "1 cup plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 291536,
      "primary_message": "Zest and juice lemons into the bowl with the cucumber and yogurt. ",
      "secondary_message": null
    },
    {
      "id": 291537,
      "primary_message": "Shave the dill leaves off the stems; discard stems and mince the leaves. Peel and mince garlic. Add both to the bowl and stir to combine the tzatziki. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 291538,
      "primary_message": "Halve the remaining cucumber lengthwise, then slice crosswise into half-moons. Halve tomatoes. Place both in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 291539,
      "primary_message": "Trim, seed, and thinly slice bell peppers into rounds. Peel, halve, and slice additional onion into thin half-moons. Add both to the bowl with the cucumber and tomato. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 291540,
      "primary_message": "Add feta, olives, oil, and oregano to the bowl and stir to combine the salad. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup Kalamata olives, pitted\n1 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried"
    },
    {
      "id": 291541,
      "primary_message": "To serve, divide salad between bowls; top with veggie meatballs and tzatziki sauce. Enjoy!",
      "secondary_message": null
    }
  ],
