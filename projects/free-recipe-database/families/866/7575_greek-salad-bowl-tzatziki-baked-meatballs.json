  "instructions": [
    {
      "id": 291568,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 291569,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ lemons\n1 ½ small bunches fresh dill\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes\n3 green bell peppers"
    },
    {
      "id": 291570,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 291571,
      "primary_message": "Peel and finely dice the onion. Peel and mince garlic; add both to the bowl with the parsley.",
      "secondary_message": "1 medium red onion\n6 cloves garlic"
    },
    {
      "id": 291572,
      "primary_message": "Add ground beef, eggs, almond flour, and spices to the bowl and mix with your hands until well combined. ",
      "secondary_message": "1.02 kg lean ground beef\n3 eggs\n⅓ cup almond meal/flour\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 291573,
      "primary_message": "Coat a large baking sheet pan (or two) with a thin layer of olive oil. Using a tablespoon measure, form the meat mixture into rounded meatballs and place in the dish. Place the dish in the oven and bake until cooked through, 15-20 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 291574,
      "primary_message": "Meanwhile, make the tzatziki. Mince half of the cucumber and transfer to a medium bowl along with the yogurt and salt.",
      "secondary_message": "1 cup plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 291575,
      "primary_message": "Juice and grate the zest from the lemons into the tzatziki bowl.",
      "secondary_message": null
    },
    {
      "id": 291576,
      "primary_message": "Shave the dill leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. Add both to the tzatziki and stir to combine.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 291577,
      "primary_message": "Halve the remaining cucumber lengthwise, then slice crosswise into half rounds. Halve the tomatoes. Transfer both to a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 291578,
      "primary_message": "Seed the peppers and slice crosswise to form rings. Peel and slice the shallots into rings. Add both to the salad bowl.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 291579,
      "primary_message": "Add veggies, feta, olives, oil, and oregano to a salad bowl and stir to combine. ",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese\n¾ cup Kalamata olives, pitted\n1 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried"
    },
    {
      "id": 291580,
      "primary_message": "To serve, divide salad between bowls and top with meatballs and Tzatziki sauce. Enjoy!",
      "secondary_message": null
    }
  ],
