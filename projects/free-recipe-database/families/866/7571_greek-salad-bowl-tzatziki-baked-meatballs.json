  "instructions": [
    {
      "id": 291477,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 291478,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n1 lemon\n½ small bunch fresh dill\n1 English cucumber\n1 pint grape tomatoes\n1 green bell pepper"
    },
    {
      "id": 291479,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 291480,
      "primary_message": "Peel and finely dice the shallots. Peel and mince garlic; add both to the bowl with the parsley.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 291481,
      "primary_message": "Add ground beef, egg, and spices to the bowl and mix with your hands until well combined. ",
      "secondary_message": "1 ½ lb lean ground beef\n2 eggs\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 291482,
      "primary_message": "Coat a large baking dish with olive oil. Using a tablespoon measure, form the meat mixture into rounded meatballs and place in the dish, spacing them 1-inch apart. Place the dish in the oven and bake until cooked through, 15-20 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 291483,
      "primary_message": "Meanwhile, make the tzatziki. Mince half of the cucumber and transfer to a medium bowl along with the yogurt, oil, and salt.",
      "secondary_message": "⅔ cup plain Greek yogurt\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 291484,
      "primary_message": "Juice and grate the zest from the lemon into the tzatziki bowl.",
      "secondary_message": null
    },
    {
      "id": 291485,
      "primary_message": "Shave the dill leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. Add both to the tzatziki and stir to combine. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 291486,
      "primary_message": "Halve the remaining cucumber lengthwise, then slice crosswise into half rounds. Halve the tomatoes. Transfer both to a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 291487,
      "primary_message": "Seed the pepper and slice crosswise to form rings. Peel and slice the remaining shallot into rings. Add both to the salad bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 291488,
      "primary_message": "Add veggies, feta, olives, oil, and oregano to a salad bowl and stir to combine. ",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese\n¼ cup Kalamata olives, pitted\n4 tsp extra virgin olive oil\n½ tsp oregano, dried"
    },
    {
      "id": 291489,
      "primary_message": "To serve, divide salad between bowls and top with meatballs and Tzatziki sauce. Enjoy!",
      "secondary_message": null
    }
  ],
