  "instructions": [
    {
      "id": 291438,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 291439,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n1 small bunch fresh dill\n1 English cucumber\n1 pint grape tomatoes\n2 green bell peppers"
    },
    {
      "id": 291440,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 291441,
      "primary_message": "Peel and finely dice the shallot. Peel and mince garlic; add both to the bowl with the parsley.",
      "secondary_message": "2 shallots\n4 cloves garlic"
    },
    {
      "id": 291442,
      "primary_message": "Add ground beef, eggs, almond flour, and spices to the bowl and mix with your hands until well combined. ",
      "secondary_message": "1 ½ lb lean ground beef\n2 eggs\n¼ cup almond meal/flour\n2 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 291443,
      "primary_message": "Coat a large baking dish with a thin layer of olive oil. Using a tablespoon measure, form the meat mixture into rounded meatballs and place in the dish. Place the dish in the oven and bake until cooked through, 15-20 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 291444,
      "primary_message": "Meanwhile, make the tzatziki. Mince half of the cucumber and transfer to a medium bowl along with the yogurt and salt. ",
      "secondary_message": "⅔ cup plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 291445,
      "primary_message": "Juice and grate the zest from the lemon into the tzatziki bowl. ",
      "secondary_message": null
    },
    {
      "id": 291446,
      "primary_message": "Shave the dill leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. Add both to the tzatziki and stir to combine.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 291447,
      "primary_message": "Halve the remaining cucumber lengthwise, then slice crosswise into half rounds. Halve the tomatoes. Transfer both to a medium salad bowl. ",
      "secondary_message": null
    },
    {
      "id": 291448,
      "primary_message": "Seed the peppers and slice crosswise to form rings. Peel and slice the remaining shallots into rings. Add both to the salad bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 291449,
      "primary_message": "Add veggies, feta, olives, oil, and oregano to a salad bowl and stir to combine. ",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese\n½ cup Kalamata olives, pitted\n2 tsp extra virgin olive oil\n1 tsp oregano, dried"
    },
    {
      "id": 291450,
      "primary_message": "To serve, divide salad between bowls and top with meatballs and Tzatziki sauce. Enjoy!",
      "secondary_message": null
    }
  ],
