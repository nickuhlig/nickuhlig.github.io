  "instructions": [
    {
      "id": 291542,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 291543,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ lemon\n½ small bunch fresh dill\n½ English cucumber\n½ small pkg grape tomatoes\n1 green bell pepper"
    },
    {
      "id": 291544,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Transfer to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 291545,
      "primary_message": "Peel and finely dice the shallot. Peel and mince garlic; add both to the bowl with the parsley. ",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 291546,
      "primary_message": "Add ground beef, egg, almond flour, and spices to the bowl and mix with your hands until well combined. ",
      "secondary_message": "⅓ kg lean ground beef\n1 egg\n2 tbsp almond meal/flour\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 291547,
      "primary_message": "Coat a baking dish with a thin layer of olive oil. Using a tablespoon measure, form the meat mixture into rounded meatballs and place in the dish. Place the dish in the oven and bake until cooked through, 15-20 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 291548,
      "primary_message": "Meanwhile, make the tzatziki. Mince half of the cucumber and transfer to a medium bowl along with the yogurt and salt. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n¼ tsp salt"
    },
    {
      "id": 291549,
      "primary_message": "Juice and grate the zest from the lemon into the tzatziki bowl. ",
      "secondary_message": null
    },
    {
      "id": 291550,
      "primary_message": "Shave the dill leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. Add both to the tzatziki and stir to combine. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 291551,
      "primary_message": "Halve the remaining cucumber lengthwise, then slice crosswise into half rounds. Halve the tomatoes. Transfer both to a medium salad bowl. ",
      "secondary_message": null
    },
    {
      "id": 291552,
      "primary_message": "Seed the pepper and slice crosswise to form rings. Peel and slice the remaining shallot into rings. Add both to the salad bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 291553,
      "primary_message": "Add feta, olives, oil, and oregano to the salad bowl and stir to combine. ",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n¼ cup Kalamata olives, pitted\n1 tsp extra virgin olive oil\n½ tsp oregano, dried"
    },
    {
      "id": 291554,
      "primary_message": "To serve, divide salad between bowls and top with meatballs and tzatziki sauce. Enjoy!",
      "secondary_message": null
    }
  ],
