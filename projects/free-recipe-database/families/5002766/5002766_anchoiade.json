  "instructions": [
    {
      "id": 1,
      "primary_message": "Fit the food processor with a blade, and set it to whirl. Drop in the garlic, so it smashes to smithereens. Drop in all the anchovies at once. Add the olive oil and vinegar. Then stop the machine, scrape down the sides, and whiz until pretty smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Spoon into a small bowl and serve with a few handfuls of fresh sugar snaps, or spoon it over roasted red and yellow peppers, or serve it as a dip for olive bread.",
      "secondary_message": null
    }
  ],
