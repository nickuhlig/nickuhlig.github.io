  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Soften the cream cheese. Shred the Pepper Jack cheese. Cut the scallions into small pieces.",
      "secondary_message": "1 lb cream cheese\n1 ½ cups Pepper Jack cheese\n3 scallions"
    },
    {
      "id": 1,
      "primary_message": "Arrange bacon strips on a foil-lined baking sheet and set oven to 400°F. Place bacon in oven as it preheats and bake until crisp, about 20 minutes. (Check frequently, as different ovens will preheat at different rates.)",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a small bowl, thoroughly mix refried beans with 1/4 cup of Buffalo hot sauce. Spread refried beans in an even layer in an 8- by 8-inch baking dish or round casserole dish.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a separate mixing bowl, mix cream cheese with ranch dressing and dry ranch seasoning. Gently spread cream cheese mixture over bean layer in baking dish, being careful not to blend the two together.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Mix chicken with remaining 1/2 cup Buffalo hot sauce. Spread chicken all over cream cheese layer.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Sprinkle pepper jack cheese evenly over chicken.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Once bacon has finished cooking, transfer it to a paper towel–lined plate to absorb any excess grease. Bake dip until it is warmed through and cheese on top has melted, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "While dip is still hot, top with blue cheese crumbles.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Crumble bacon and sprinkle all over.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Top with scallions and serve with chips and celery. The dip can be served hot, warm, or at room temperature. It can be assembled in advance (leaving blue cheese, bacon, and scallions off until the very end) and reheated in the oven before serving.",
      "secondary_message": null
    }
  ],
