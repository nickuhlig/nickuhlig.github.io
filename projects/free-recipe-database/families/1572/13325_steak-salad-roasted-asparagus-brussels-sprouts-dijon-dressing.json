  "instructions": [
    {
      "id": 222722,
      "primary_message": "Preheat the oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 222723,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb Brussels sprouts\n1 small bunch asparagus\n1 head butter (Boston) lettuce"
    },
    {
      "id": 222724,
      "primary_message": "Trim and quarter Brussels sprouts; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 222725,
      "primary_message": "Snap or cut off woody ends of the asparagus; cut into bite-sized pieces and add to the bowl with the sprouts. Drizzle with oil, sprinkle with spices, and toss to combine.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 222726,
      "primary_message": "Transfer veggies to a large baking sheet pan and spread out in an even layer. Place in the oven and roast until fork-tender, 12-15 minutes. (Reserve bowl for the salad.)",
      "secondary_message": null
    },
    {
      "id": 222727,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 222728,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 222729,
      "primary_message": "Once the grill pan is hot, coat with oil. Add steak and grill until desired doneness, 2-5 minutes per side. Transfer to a clean plate, cover loosely with aluminum foil, and set aside to rest.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 222730,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to the bowl used for the veggies.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 222731,
      "primary_message": "Add oil, vinegar, Dijon, salt, and pepper to the bowl with the garlic; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 222732,
      "primary_message": "When the veggies are done, transfer to the bowl with the dressing and toss to combine. Set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 222733,
      "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl with the veggies and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 222734,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 222735,
      "primary_message": "To serve, divide roasted vegetable salad between plates or bowls and top with steak. Enjoy!",
      "secondary_message": null
    }
  ],
