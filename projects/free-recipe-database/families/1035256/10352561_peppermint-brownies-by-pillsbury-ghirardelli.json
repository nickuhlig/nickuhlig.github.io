  "instructions": [
    {
      "primary_message": "In a medium bowl combine sweetened condensed milk, both sugars, peppermint extract and salt. Place peppermint filling in the refrigerator for 30 minutes while you make the brownies and ganache.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Make the Pillsbury® Chocolate Fudge Brownie mix according to the box instructions (using 1/4-cup water). \n",
      "secondary_message": null
    },
    {
      "primary_message": "While the brownies are baking, make the ganache. In a small saucepan over medium-low heat, add heavy cream, corn syrup and salted butter. Place Guittard® extra dark chocolate chips in a small bowl. Heat the cream mixture until bubbles start to form, approximately 5-7 minutes. Stir to combine. Place in the refrigerator until semi-firm.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove brownies from the oven and cool overnight (or at least 3 hours) in the pan. Once cooled, spread a layer of peppermint filling and chill for 30 minutes. Spread room temperature ganache over the peppermint layer and top with candy cane pieces. Brownies will keep up to 5 days refrigerated.",
      "secondary_message": null
    }
  ],
