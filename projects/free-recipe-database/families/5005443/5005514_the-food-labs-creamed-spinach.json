  "instructions": [
    {
      "id": 1,
      "primary_message": "Melt butter in a Dutch oven or large saucepan over medium-high heat. Add shallots and garlic and cook, stirring, until softened, about 2 minutes. Add spinach in 4 batches, turning each batch with tongs or a rubber spatula and allowing it to wilt before adding the next.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add flour and cook, stirring constantly, until no dry flour remains. Slowly stir in heavy cream and milk. Bring to a simmer, stirring, then reduce the heat to the lowest possible setting and cook, stirring occasionally, until the spinach is completely softened and the sauce has thickened, about 1 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in nutmeg and crème fraîche and season to taste with salt and pepper. Remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "If desired, preheat the broiler to high. Transfer creamed spinach to a 1-quart oval or round casserole dish and top it with the cheese. Broil until spinach is bubbly and cheese has formed a well-browned crust, about 2 minutes. Serve.",
      "secondary_message": null
    }
  ],
