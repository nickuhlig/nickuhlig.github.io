  "instructions": [
    {
      "id": 1,
      "primary_message": "Fill a large bowl with 1900 ml room-temperature water and add salt, stirring to dissolve. Add fish and let soak for 10 minutes. Drain fish and pat dry inside and out with paper towels.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat oven to 205°C (400°F) and position rack in center of oven. Line a rimmed baking sheet with parchment paper. Season fish inside and out with salt and pepper and rub inside and out with olive oil. Stuff belly cavity lemon slices and herb sprigs.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Roast fish until an instant-read thermometer inserted into thickest part registers 57°C (135°F), about 20 minutes for 0.45 kg fish and 25 minutes for 0.91 kg fish, depending on dimensions of fish. Alternatively, roast until fins come right off when pulled and flesh can be felt to flake under the skin when you press on it. Let rest 5 minutes. Serve, following our guide to filleting a whole cooked fish. Drizzle with additional olive oil, if desired.",
      "secondary_message": null
    }
  ],
