  "instructions": [
    {
      "id": 545004,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 545005,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n3 medium beets\n3 medium turnips\n1 small bunch fresh dill\n1 ½ lemons\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 545006,
      "primary_message": "Peel and medium dice sweet potatoes. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 545007,
      "primary_message": "Peel and trim beets and turnips; halve each lengthwise, then slice into ¼-inch thick wedges. Add both to the baking sheets with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 545008,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick wedges. Add to the baking sheets. Drizzle veggies with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ medium red onions\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 545009,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast until just fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 545010,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 545011,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until lightly toasted, 2-3 minutes. Transfer to a large bowl and set aside. (Reserve skillet for later use.)",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "id": 545012,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 545013,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic. (Reserve a small handful of dill for serving.)",
      "secondary_message": null
    },
    {
      "id": 545014,
      "primary_message": "Juice lemons into the bowl. Add yogurt, milk, salt, and pepper. Whisk to combine the dill dressing and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n89 ml (⅜ cup) whole milk\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 545015,
      "primary_message": "When the veggies are just tender, remove baking sheets from the oven, then drizzle with honey. Toss to combine and spread back out in an even layer. Return baking sheets to the oven and continue to roast until veggies are caramelized, 6-7 minutes.",
      "secondary_message": "¼ cup honey"
    },
    {
      "id": 545016,
      "primary_message": "Meanwhile, return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 545017,
      "primary_message": "Remove baking sheets from the oven. Carefully transfer warm veggies to the bowl with the almonds. Add arugula, then gently toss until slightly wilted and salad is combined, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 545018,
      "primary_message": "To serve, divide salad and sausages between plates or bowls. Drizzle with dressing, sprinkle with reserved dill, and enjoy! ",
      "secondary_message": null
    }
  ],
