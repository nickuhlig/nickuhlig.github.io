  "instructions": [
    {
      "id": 544743,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 544744,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n3 medium beets\n3 medium turnips\n1 small bunch fresh dill\n1 ½ lemons\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 544745,
      "primary_message": "Peel and medium dice sweet potatoes. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 544746,
      "primary_message": "Peel and trim beets and turnips; halve each lengthwise, then slice into ¼-inch thick wedges. Add both to the baking sheets with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 544747,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick wedges. Add to the baking sheets. Drizzle veggies with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ medium red onions\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 544748,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast until just fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 544749,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 544750,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until lightly toasted, 2-3 minutes. Transfer to a large bowl and set aside. (Reserve skillet for the next step.)",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "id": 544751,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat, cover to keep warm, and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pork sausages"
    },
    {
      "id": 544752,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 544753,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic. (Reserve a small handful of dill for serving.)",
      "secondary_message": null
    },
    {
      "id": 544754,
      "primary_message": "Juice lemons into the bowl. Add yogurt, milk, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 fl oz (⅜ cup) whole milk\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 544755,
      "primary_message": "When the veggies are just tender, remove baking sheets from the oven, then drizzle with honey. Toss to combine and spread back out in an even layer. Return baking sheets to the oven and continue to roast until veggies are caramelized, 6-7 minutes.",
      "secondary_message": "¼ cup honey"
    },
    {
      "id": 544756,
      "primary_message": "Remove baking sheets from the oven. Carefully transfer warm veggies to the bowl with the almonds. Add arugula, then gently toss until slightly wilted and salad is combined, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 544757,
      "primary_message": "To serve, divide salad and sausages between plates or bowls. Drizzle with dressing, sprinkle with reserved dill, and enjoy! ",
      "secondary_message": null
    }
  ],
