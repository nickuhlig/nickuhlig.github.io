  "instructions": [
    {
      "id": 544974,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 544975,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg sweet potato\n1 medium beet\n1 medium turnip\n½ small bunch fresh dill\n½ lemon\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 544976,
      "primary_message": "Peel and medium dice sweet potato. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 544977,
      "primary_message": "Peel and trim beet and turnip; halve each lengthwise, then slice into ¼-inch thick wedges. Add both to the baking sheet with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 544978,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick wedges. Add to the baking sheet. Drizzle veggies with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "½ medium red onion\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 544979,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast until just fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 544980,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 544981,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until lightly toasted, 2-3 minutes. Transfer to a medium bowl and set aside. (Reserve skillet for later use.)",
      "secondary_message": "⅛ cup almonds, sliced"
    },
    {
      "id": 544982,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 544983,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic. (Reserve a small handful of dill for serving.)",
      "secondary_message": null
    },
    {
      "id": 544984,
      "primary_message": "Juice lemon into the bowl. Add yogurt, milk, salt, and pepper. Whisk to combine the dill dressing and set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp whole milk\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 544985,
      "primary_message": "When the veggies are just tender, remove baking sheet from the oven, then drizzle with honey. Toss to combine and spread back out in an even layer. Return baking sheet to the oven and continue to roast until veggies are caramelized, about 5 minutes.",
      "secondary_message": "1 ½ tbsp honey"
    },
    {
      "id": 544986,
      "primary_message": "Meanwhile, return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 pre-cooked vegan sausage"
    },
    {
      "id": 544987,
      "primary_message": "Remove baking sheet from the oven. Carefully transfer warm veggies to the bowl with the almonds. Add arugula, then gently toss until slightly wilted and salad is combined, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 544988,
      "primary_message": "To serve, divide salad and sausages between plates or bowls. Drizzle with dressing, sprinkle with reserved dill, and enjoy! ",
      "secondary_message": null
    }
  ],
