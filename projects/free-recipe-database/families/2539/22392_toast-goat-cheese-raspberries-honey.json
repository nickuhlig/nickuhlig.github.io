  "instructions": [
    {
      "id": 373938,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 373939,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 373940,
      "primary_message": "Meanwhile, wash and dry raspberries.",
      "secondary_message": "1 ½ (6 oz) pkgs raspberries"
    },
    {
      "id": 373941,
      "primary_message": "Divide goat cheese between toast slices and spread out in an even layer. Top with raspberries and drizzle with honey.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese\n2 tbsp honey"
    },
    {
      "id": 373942,
      "primary_message": "To serve, divide toast between plates and enjoy!",
      "secondary_message": null
    }
  ],
