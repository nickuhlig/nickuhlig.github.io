  "instructions": [
    {
      "id": 271093,
      "primary_message": "Preheat oven to 220°C (425°F). Position racks in the upper, center, and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 271094,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n1 ½ small pkgs grape tomatoes\n1 ½ lemons\n1 small bunch fresh dill"
    },
    {
      "id": 271095,
      "primary_message": "Cut butter into small pieces and place in a small bowl; set aside.",
      "secondary_message": "½ cup butter, unsalted"
    },
    {
      "id": 271096,
      "primary_message": "Snap or cut off woody ends of the asparagus; halve tomatoes. Divide both between two baking sheet pans, spreading them out in an even layer. Season with salt and pepper, then sprinkle ⅓ of the butter over veggies. ",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 271097,
      "primary_message": "Place baking sheets on lower racks of the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until crisp-tender, about 15 minutes. Remove from the oven. ",
      "secondary_message": null
    },
    {
      "id": 271098,
      "primary_message": "Meanwhile, pat halibut dry with paper towels, cut into portions (if necessary), and transfer to a large baking sheet. Season with spices, then sprinkle ½ of the remaining butter over fish. ",
      "secondary_message": "1.02 kg halibut fillet\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp thyme, dried"
    },
    {
      "id": 271099,
      "primary_message": "Place baking sheet on upper rack of the oven and roast until fish is cooked through, 12-15 minutes. Remove from the oven. ",
      "secondary_message": null
    },
    {
      "id": 271100,
      "primary_message": "While the fish is roasting, using a clean cutting board, peel and mince garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 271101,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 271102,
      "primary_message": "Once the pan is hot, add remaining butter and swirl to coat the bottom. Add garlic and cook, stirring frequently, until fragrant, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 271103,
      "primary_message": "Zest and juice lemons into the pan with the garlic; add cream, capers, salt, and pepper. Bring sauce to a simmer and cook, stirring occasionally, until slightly thickened, 5-6 minutes.",
      "secondary_message": "355 ml heavy whipping cream\n3 tbsp capers\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 271104,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 271105,
      "primary_message": "Add half of the dill (reserving the rest for garnish) to the sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 271106,
      "primary_message": "To serve, divide fish and veggies between plates; spoon sauce over fish and sprinkle with reserved dill. Enjoy!",
      "secondary_message": null
    }
  ],
