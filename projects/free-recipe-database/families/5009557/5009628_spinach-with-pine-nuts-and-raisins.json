  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat olive oil in a 30-cm heavy-bottomed stainless steel skillet over medium heat until shimmering. Add pinenuts and cook, stirring and shaking frequently until they begin to turn golden, about 2 minutes. Add raisins and cook, stirring often, until heated through, about 1 minute. Add garlic and cook, stirring constantly, until fragrant, about 1 minute. Add spinach to pan. Sprinkle with 2 teaspoons water. Cook, stirring constantly until spinach is wilted, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in lemon zest and sherry vinegar. Season with salt and pepper to taste. Serve warm.",
      "secondary_message": null
    }
  ],
