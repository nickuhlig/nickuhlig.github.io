  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel, core, and cut the mixed good cooking apples into large chunks. Juice the lemon.",
      "secondary_message": "8 mixed good cooking apples\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Place apple and apple cider in a large heavy pot and bring to a simmer over medium heat. Cover and cook until apples are completely tender, about 20 to 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place half of the apples in the jar of a blender and purée until completely smooth. Pour into a medium bowl and repeat with remaining apples.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour puréed apples back into large pot and bring to a simmer over medium-low heat. Stir in sugar, lemon juice, cinnamon, nutmeg, cloves, and allspice. Continue to simmer, uncovered, until sauce turns a deep brown and thickens, about 1 to 2 hours, stirring regularly to prevent burning.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Let apple butter cool to room temperature, then store in an airtight container in the refrigerator for up to 3 weeks.",
      "secondary_message": null
    }
  ],
