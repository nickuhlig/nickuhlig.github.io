  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Split the vanilla bean. Dice the dried apricots. Cool the brewed white tea.",
      "secondary_message": "¼ vanilla bean\n¼ cup dried apricots\n12 fl oz brewed white tea"
    },
    {
      "id": 1,
      "primary_message": "For the Stone Fruit Syrup: Add water, sugar, and vanilla bean to a small saucepan and bring to a simmer, stirring to dissolve sugar. Add dried apricots and simmer for 5 minutes, then remove from heat. Let stand for 5 minutes, then remove vanilla bean and pour syrup and fruit into a blender. Add fresh peach or nectarine and blend until smooth. Strain through a fine-mesh strainer, if desired, for a more polished appearance. Syrup can be used immediately or refrigerated for up to 1 week.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Punch: Add Stone Fruit Syrup, rum, tea, and lemon to a pitcher. Serve immediately or refrigerate up to 6 hours. To serve, pour punch into ice-filled glasses, each garnished with a mint sprig.",
      "secondary_message": null
    }
  ],
