  "instructions": [
    {
      "id": 70443,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 avocados\n3 limes\n3 mangoes\n3 red bell peppers\n1 ½ head romaine lettuce\n1 ½ small bunches cilantro"
    },
    {
      "id": 70442,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": ""
    },
    {
      "id": 70441,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 70440,
      "primary_message": "Juice the limes into a small bowl, then add ½ of the cilantro (transfer the rest to a small bowl and save for garnishing), minced garlic, olive oil, honey, crushed red pepper, salt, and pepper; whisk together. Pour ½ of the sauce into a large bowl and set the rest aside.",
      "secondary_message": "9 tbsp extra virgin olive oil\n3 tsp honey\n⅜ tsp crushed red pepper\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 70439,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "0.681 kg chicken breasts, boneless skinless"
    },
    {
      "id": 70438,
      "primary_message": "Add the chicken to the medium bowl and coat with the sauce; set aside to marinade for 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 70437,
      "primary_message": "Seed and cut the peppers into strips lengthwise; transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 70436,
      "primary_message": "Peel the mangoes and cut the flesh away from the pit; medium dice the flesh. Add to the plate next to the pepper.",
      "secondary_message": ""
    },
    {
      "id": 70435,
      "primary_message": "Halve and pit the avocados; scoop out the flesh and medium dice. Add to the plate next to the pepper and mango.",
      "secondary_message": ""
    },
    {
      "id": 70434,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 70433,
      "primary_message": "Quarter the lettuce lengthwise, then chop crosswise into 2 ½-cm strips; transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 70432,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 70431,
      "primary_message": "Remove the chicken from the marinade and pat dry with paper towels; place the fillets in the skillet and cook until browned and cooked through, 3 to 4 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 70430,
      "primary_message": "Slice the chicken crosswise into strips.",
      "secondary_message": ""
    },
    {
      "id": 70429,
      "primary_message": "Divide the lettuce between plates and layer the peppers, mangoes, avocado, and chicken over top. Drizzle with the remaining sauce and garnish with the remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
