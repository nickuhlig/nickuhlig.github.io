  "instructions": [
    {
      "id": 495195,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat. ",
      "secondary_message": "½ cup jasmine rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 495196,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 orange\n2 plums\n4 baby bok choy"
    },
    {
      "id": 495197,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 495198,
      "primary_message": "While the rice is cooking, juice orange into a small bowl. Add vinegar, ketchup, soy sauce, sugar, and cornstarch, then whisk to combine the sauce. Set aside. ",
      "secondary_message": "2 tbsp rice vinegar\n2 tbsp ketchup\n2 tsp soy sauce\n2 tsp brown sugar\n1 ½ tsp cornstarch"
    },
    {
      "id": 495199,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 495200,
      "primary_message": "Trim and cut bok choy crosswise into ½-inch strips. Add to the bowl with the plums and set aside.",
      "secondary_message": null
    },
    {
      "id": 495201,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495202,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 495203,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, chicken, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil\n0.23 kg ground chicken\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495204,
      "primary_message": "Add sauce, plums, and bok choy to the skillet. Stir-fry until plums and bok choy are just tender and sauce is thickened, 2-3 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 495205,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
