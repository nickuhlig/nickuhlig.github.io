  "instructions": [
    {
      "id": 495118,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat. ",
      "secondary_message": "1 ½ cups jasmine rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 495119,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 oranges\n6 plums\n12 baby bok choy"
    },
    {
      "id": 495120,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 495121,
      "primary_message": "While the rice is cooking, juice oranges into a medium bowl. Add vinegar, ketchup, soy sauce, sugar, and cornstarch, then whisk to combine the sauce. Set aside. ",
      "secondary_message": "⅓ cup rice vinegar\n⅓ cup ketchup\n2 tbsp soy sauce\n2 tbsp brown sugar\n1 ½ tbsp cornstarch"
    },
    {
      "id": 495122,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 495123,
      "primary_message": "Trim and cut bok choy crosswise into ½-inch strips. Add to the bowl with the plums and set aside.",
      "secondary_message": null
    },
    {
      "id": 495124,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495125,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 495126,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, veggie ground, salt, and pepper; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n24 oz veggie ground, plant based\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 495127,
      "primary_message": "Add sauce, plums, and bok choy to the pot. Stir-fry until plums and bok choy are just tender and sauce is thickened, about 3 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 495128,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
