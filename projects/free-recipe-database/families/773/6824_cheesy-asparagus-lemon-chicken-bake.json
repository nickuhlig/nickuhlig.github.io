  "instructions": [
    {
      "id": 90285,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 90286,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n¾ small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 90287,
      "primary_message": "In a small bowl, mix together the spices.",
      "secondary_message": "1 ½ tsp garlic powder\n1 ½ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 90288,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place chicken fillets in a baking dish and season with the spice mixture (save the bowl to use later).",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 90289,
      "primary_message": "Cut (or snap off) and discard the woody ends of the asparagus. Divide asparagus and arrange on top of each chicken breast.",
      "secondary_message": null
    },
    {
      "id": 90290,
      "primary_message": "Grate the zest from the lemons and transfer to the bowl used for the spices. Juice the lemons into the same bowl. Add oil and whisk to combine. Pour the lemon oil mixture over the chicken and asparagus.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 90291,
      "primary_message": "Grate mozzarella cheese.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 90292,
      "primary_message": "Sprinkle the cheese over the asparagus and place in the oven; bake until chicken is cooked through, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 90293,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 90294,
      "primary_message": "A few minutes before the end of the cooking time, change setting to broil and continue baking until the chicken and cheese are golden, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 90295,
      "primary_message": "To serve, divide the chicken topped with asparagus between plates and garnish with parsley and crushed red pepper. Enjoy!",
      "secondary_message": "¾ tsp crushed red pepper"
    }
  ],
