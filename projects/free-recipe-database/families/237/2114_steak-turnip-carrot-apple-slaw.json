  "instructions": [
    {
      "id": 20000,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 20001,
      "primary_message": "Peel and mince garlic. In a medium bowl, prepare slaw dressing by whisking together garlic, olive oil, lemon juice, vinegar, honey, salt, and pepper.",
      "secondary_message": "1 clove garlic\r\n1 tbsp extra virgin olive oil\r\njuice of ½ lemon\r\n½ tbsp apple cider vinegar\r\n½ tsp honey\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 20002,
      "primary_message": "Season steak with salt and pepper.",
      "secondary_message": "¾ lb ribeye steak\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 20003,
      "primary_message": "Coat grill or bottom of skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 20004,
      "primary_message": "Wash and dry turnip, carrot, apple, and green onions.",
      "secondary_message": "1 medium turnip\n1 medium carrot\n1 Gala apple\n½ small bunch green onions (scallions)"
    },
    {
      "id": 20005,
      "primary_message": "Trim ends and peel turnip and carrot; coarsely grate and add to bowl with dressing. Core, coarsely grate, and add apple to bowl. Trim and discard root ends of onions, thinly slice, and add to bowl. Toss salad.",
      "secondary_message": ""
    },
    {
      "id": 20006,
      "primary_message": "Serve steak with slaw on the side and enjoy!",
      "secondary_message": ""
    }
  ],
