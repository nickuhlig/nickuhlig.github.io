  "instructions": [
    {
      "primary_message": "This recipe utilizes 2 large and 2 mini food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). ",
      "secondary_message": "9 oz cheese tortellini, fresh or frozen"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes. Place in a medium bowl. ",
      "secondary_message": "½ pint grape tomatoes"
    },
    {
      "primary_message": "Roughly chop peppers and olives. Add both to the bowl with the tomatoes along with Parmesan, salt, and pepper.",
      "secondary_message": "½ (12 oz) jar roasted red bell peppers\n⅓ cup Kalamata olives, pitted\n⅓ cup Parmesan cheese, shredded\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "When the tortellini is done, drain and rinse under cold water to cool completely. Add to the bowl and stir to combine the pasta mix.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Divide greens and pasta mix between large containers. Divide dressing between mini containers.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n⅓ cup Italian salad dressing"
    },
    {
      "primary_message": "Cover containers and refrigerate. When ready to eat, drizzle with dressing, and enjoy!",
      "secondary_message": null
    }
  ],
