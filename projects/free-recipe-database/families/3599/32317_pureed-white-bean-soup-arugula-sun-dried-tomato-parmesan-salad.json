  "instructions": [
    {
      "id": 511325,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 leeks\n1 lemon\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 511326,
      "primary_message": "Trim off root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 511327,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 511328,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add leek and salt; cook, stirring occasionally, until tender and just starting to brown in spots, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 511329,
      "primary_message": "Meanwhile, peel and thinly slice garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 511330,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 511331,
      "primary_message": "When the leek is done, using a stirring spoon, remove half of the cooked leek to a small bowl and set aside for serving. Add garlic, thyme, and pepper to the pan with the remaining leek, then continue to cook, stirring frequently, until fragrant, about 30 seconds.",
      "secondary_message": "¼ tsp thyme, dried\n¼ tsp black pepper"
    },
    {
      "id": 511332,
      "primary_message": "Add beans and broth to the pan, then stir to combine. Bring the soup to a boil over medium-high heat. Once boiling, reduce heat to medium and simmer until slightly thickened, about 10 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 511333,
      "primary_message": "Meanwhile, juice half of the lemon into a medium bowl. Add oil, salt, and pepper, then whisk to combine the dressing. (Reserve remaining lemon for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 511334,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the dressing.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 511335,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and set aside.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 511336,
      "primary_message": "When the soup is done, remove from heat. Juice reserved lemon into the pan, then use a hand blender to purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.)",
      "secondary_message": null
    },
    {
      "id": 511337,
      "primary_message": "Add arugula and pine nuts to the bowl with the dressing. Gently toss to combine the salad.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 511338,
      "primary_message": "Divide soup between bowls, top with reserved leek, and drizzle with oil. Serve with salad on the side and enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
