  "instructions": [
    {
      "id": 511381,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 leeks\n2 lemons\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 511382,
      "primary_message": "Trim off root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 511383,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 511384,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leek and salt; cook, stirring occasionally, until tender and just starting to brown in spots, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 511385,
      "primary_message": "Meanwhile, peel and thinly slice garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 511386,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 511387,
      "primary_message": "When the leek is done, using a stirring spoon, remove half of the cooked leek to a small bowl and set aside for serving. Add garlic, thyme, and pepper to the pot with the remaining leek, then continue to cook, stirring frequently, until fragrant, about 30 seconds.",
      "secondary_message": "½ tsp thyme, dried\n½ tsp black pepper"
    },
    {
      "id": 511388,
      "primary_message": "Add beans and broth to the pot, then stir to combine. Bring the soup to a boil over medium-high heat. Once boiling, reduce heat to medium and simmer until slightly thickened, about 10 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth"
    },
    {
      "id": 511389,
      "primary_message": "Meanwhile, juice one of the lemons into a medium bowl. Add oil, salt, and pepper, then whisk to combine the dressing. (Reserve remaining lemon for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 511390,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the dressing.",
      "secondary_message": "8 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 511391,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and set aside.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 511392,
      "primary_message": "When the soup is done, remove from heat. Juice reserved lemon into the pot, then use a hand blender to purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.)",
      "secondary_message": null
    },
    {
      "id": 511393,
      "primary_message": "Add arugula and pine nuts to the bowl with the dressing. Gently toss to combine the salad.",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 511394,
      "primary_message": "Divide soup between bowls, top with reserved leek, and drizzle with oil. Serve with salad on the side and enjoy!",
      "secondary_message": "4 tsp extra virgin olive oil"
    }
  ],
