  "instructions": [
    {
      "id": 52879,
      "primary_message": "Rinse lentils under cold water and transfer to a medium saucepan. Add broth and spices; stir and bring to a boil. Lentils should be covered by about 1 inch of liquid; add water if needed.",
      "secondary_message": "¾ cup brown lentils\n2 tsp curry powder\n12 fl oz chicken or vegetable broth\n1 tsp salt\n1 tsp garlic powder"
    },
    {
      "id": 52880,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n2 tomatoes\n2 medium carrots\n1 medium red onion\n1 English cucumber\n½ lemon"
    },
    {
      "id": 52881,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion. Add ¾ of the onion to the saucepan with the lentils. Put the other ¼ in a blender.",
      "secondary_message": null
    },
    {
      "id": 52882,
      "primary_message": "Peel, and small dice the carrots. Small dice the tomatoes. Add both to the saucepan with the lentils.",
      "secondary_message": null
    },
    {
      "id": 52883,
      "primary_message": "When lentil mixture comes to a boil, stir, cover with a lid and turn to low heat. Simmer for about 20 minutes or until lentils are tender.",
      "secondary_message": null
    },
    {
      "id": 52884,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 52885,
      "primary_message": "Trim and discard the ends of the cucumber; halve the cucumber lengthwise, then thinly slice crosswise on an angle. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 52886,
      "primary_message": "Warm the whole chili in the preheated skillet, 1 minute per side. Remove the stem and add chili to blender. Turn the skillet to medium low heat.",
      "secondary_message": "1 red chili pepper"
    },
    {
      "id": 52887,
      "primary_message": "Juice the lemon and add the juice to the blender. Blend with onion, chili, mustard, sugar, salt, and yogurt. Transfer to the small bowl with the cucumber. Gently mix until evenly coated.",
      "secondary_message": "¼ tsp Dijon mustard\n½ tsp salt\n¼ cup plain Greek yogurt\n1 tsp brown sugar"
    },
    {
      "id": 52888,
      "primary_message": "Place naan bread in skillet, toasting both sides, about 1 minute per side.",
      "secondary_message": "1 flatbread or naan"
    },
    {
      "id": 52889,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Put aside in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 52890,
      "primary_message": "Once lentils are tender, give them a quick pulse with an immersion blender. Stir in half of the cilantro.",
      "secondary_message": null
    },
    {
      "id": 52891,
      "primary_message": "To serve, ladle the lentils into a bowl and garnish with the remaining cilantro. Serve with the toasted naan and cucumber salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
