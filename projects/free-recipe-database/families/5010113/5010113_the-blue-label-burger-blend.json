  "instructions": [
    {
      "id": 1,
      "primary_message": "Procedure (Meat Grinder): Place feed shaft, blade, and 1/4-inch die of meat grinder in freezer until well-chilled. Meanwhile, place meat chunks on rimmed baking sheet, leaving space between each piece and place in freezer for 10 minutes until meat is firm, but not frozen.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine meat in large bowl and toss to combine. Grind meat and refrigerate immediately until ready for use. Handle as gently as possible.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Procedure (Food Processor): Place bowl and blade of food processor in freezer until well-chilled. Meanwhile, place meat chunks on rimmed baking sheet, leaving space between each piece, and place in freezer for 10 minutes until meat is firm, but not frozen.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Combine meat in large bowl and toss to combine. Working in two batches, place meat cubes in food processor and pulse until medium-fine grind is achieved, about 8 to 10 one-second pulses, scraping down processor bowl as necessary. Refrigerate until ready to use.",
      "secondary_message": null
    }
  ],
