  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in a medium saucepan over medium heat until shimmering. Add onions and cook, stirring occasionally, until onions have softened, about 5 minutes. Add garlic, jalapeño, ginger, turmeric, and allspice and cook until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in bananas, vinegar, honey, rum, tomato paste, soy sauce, and salt; bring to simmer. Reduce heat to low, cover, and cook for 15 minutes, stirring often. Remove from heat and let cool for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer ketchup to a food processor fitted with a steel blade and process until smooth, about 1 minute. Thin with water as needed to reach a ketchup-like consistency. Season with additional salt to taste. Transfer to an airtight container and store in refrigerator for up to 2 weeks.",
      "secondary_message": null
    }
  ],
