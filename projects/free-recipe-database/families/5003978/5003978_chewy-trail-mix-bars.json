  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the almonds.",
      "secondary_message": "1 cup almonds"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°F. Line an 8- by 8-inch baking dish with parchment paper, allowing some paper to overhang from the sides. In a large bowl, combine oats, sugar, salt, cinnamon, apricots, peanut butter chips, cranberries, raisins, almonds, and coconut; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together corn syrup, honey, vanilla, melted butter, and water until combined. Pour wet ingredients over oat mixture. Use your hands or a spoon to stir mixture until combined. Press into prepared baking sheet, smoothing top. Bake until golden on the edges, about 30 minutes. Let cool completely before using the sides of the parchment paper to lift mixture from pan. Cut into bars. Uneaten bars can be stored in an airtight container for up to 5 days.",
      "secondary_message": null
    }
  ],
