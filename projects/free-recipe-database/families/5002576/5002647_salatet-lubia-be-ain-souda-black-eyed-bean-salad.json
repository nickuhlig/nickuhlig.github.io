  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the shallot. Mince the garlic. Drain and rinse the black-eyed peas. Halve the cherry tomatoes. Cut the green bell pepper into 1/4-inch pieces. Cut the yellow pepper into 1/4-inch pieces. Trim and cut the Persian cucumbers into 1/4-inch pieces.",
      "secondary_message": "1 medium shallot\n1 large clove garlic\n1 (439 g) can black-eyed peas\n170 g cherry tomatoes\n1 green bell pepper\n1 yellow pepper\n2 Persian cucumbers"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk to combine oil, lime juice, vinegar, shallot, garlic, cumin, paprika, red pepper flakes, salt, and pepper. Add black-eyed peas, cherry tomatoes, green bell pepper, yellow or red bell pepper, cucumbers, olives, and cilantro or parsley; toss to combine. Season to taste with additional salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cover and refrigerate until flavors meld, at least 30 minutes and up to 4 hours. Serve.",
      "secondary_message": null
    }
