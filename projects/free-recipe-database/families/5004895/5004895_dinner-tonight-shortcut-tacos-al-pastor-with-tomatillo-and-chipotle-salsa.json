  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat a skillet over medium-high heat. Add the tomatillos cut side down and toss in the garlic cloves. Cook for about 3 minutes, and then flip everything and cook for another 3 minutes. Transfer ingredients to a blender or food processor. Add two of the chilies in adobo. Purée mixture until very smooth. Season with salt to taste. Then transfer to the fridge to cool while making the tacos.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Purée the remaining chipotle chiles along with the adobo sauce in a blender or food processor. Thin out the purée with a splash of water if it is too thick. Brush this onto the pork.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Set a large grill or grill pan over medium-high heat. Toss on the meat, onions, and pineapple. Cook the meat for about 2-3 minutes a side. Cook the onions and pineapple, turning occasionally, until they are soft, about 6-8 minutes. Transfer everything to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Chop everything into little 1/4-inch pieces. Transfer to a large bowl and toss together, seasoning with salt to taste. Serve with tortillas and the salsa.",
      "secondary_message": null
    }
  ],
