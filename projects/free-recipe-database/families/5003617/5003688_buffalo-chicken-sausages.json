  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cube the skin on boneless chicken thighs. Keep the apple cider vinegar cold until you use it.",
      "secondary_message": "1.81 kg skin on boneless chicken thighs\n¼ cup apple cider vinegar"
    },
    {
      "id": 1,
      "primary_message": "Combine chicken, buffalo wing sauce, hot sauce, salt, paprika, and cayenne in a large bowl. Chill until ready to grind.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Grind the mixture through a meat grinder, fitted with small die, into a bowl set in ice.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using paddle attachment of a standing mixer, mix on low speed for 1 minute. Add in vinegar, increase speed to medium, and mix until liquid is incorporated, about 1 minute more.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Form a small sausage patty; place rest of sausage mixture in refrigerator. Cook patty in a small frying pan over medium-high heat or on a plate in the microwave until cooked through. Taste and adjust seasonings of sausage if necessary.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Stuff sausage into hog casings and twist into 15-cm links. Refrigerate until ready to cook.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals evenly over half of the charcoal grate. Alternatively, set all the burners of a gas grill to high heat. Set cooking grate in place, cover grill, and allow to preheat for 5 minutes. Clean and oil grilling grate.\nGrill over medium-high direct heat until sausage registers 71°C when an instant read thermometer is inserted in middle of link. Remove from grill, let rest for 5 minutes, and serve.",
      "secondary_message": null
    }
  ],
