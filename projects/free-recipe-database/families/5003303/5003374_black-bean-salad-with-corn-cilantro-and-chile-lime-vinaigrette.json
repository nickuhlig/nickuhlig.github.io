  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Drain and rinse the black beans. Mince the yellow onion. Boil and shuck the corn, then slice off the kernels. Finely chop the jalapeño. Juice the lime. Crumble the corn chips. Pick the cilantro leaves and tender stems from the thick stems and mince them.",
      "secondary_message": "1 (411 g) can black beans\n2 tbsp yellow onion\n⅔ cup corn\n1 jalapeño\n½ lime\n¼ cup corn chips\n1 ½ tbsp cilantro leaves, tender stems"
    },
    {
      "id": 1,
      "primary_message": "Combine beans, onion, corn, and jalapeño in a medium bowl. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together lime juice, oil, vinegar, chile powder, and cumin. Season with salt and pepper and whisk again.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Toss vinaigrette with black bean mixture. Refrigerate for at least 1 hour or overnight. When you’re ready to serve the salad, add corn chips and cilantro and stir to combine. Serve cold or at room temperature.",
      "secondary_message": null
    }
  ],
