  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely slice the onions. Roughly chop the garlic cloves. Cut the roma tomatoes lengthwise into 8 wedges.",
      "secondary_message": "2 large onions\n12 medium garlic cloves\n2 medium roma tomatoes"
    },
    {
      "id": 1,
      "primary_message": "Toss beef in a large bowl with 1 tablespoon salt and 1/2 tablespoon pepper. Set aside. Heat oil in a large lidded saucepan over medium heat until shimmering. Add onions and cook, stirring frequently, until softened, about 5 minutes. Add garlic, ginger, chillies, tomatoes and stir vigorously until fragrant , about 3 minutes. Add turmeric, 1/2 tablespoon pepper, and ground cumin. Cook, stirring constantly, until fragrant and oil is tinged yellow with the spices, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Move the onion mix to one side of the pan and add the beef to the cleared side. Brown beef on both sides. About 5 minutes. Stir and mix the onion and beef together. Add malt vinegar. Stir through. Cover the pan with the lid. Reduce heat to low and allow beef to cook in its juices until just cooked through, about 25 minutes. Serve hot with bread and french fries to soak up the gravy.",
      "secondary_message": null
    }
  ],
