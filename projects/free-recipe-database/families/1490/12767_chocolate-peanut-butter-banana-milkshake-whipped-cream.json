  "instructions": [
    {
      "id": 215004,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 215005,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 215006,
      "primary_message": "Once the bowl is chilled, remove from the freezer. Measure cold cream, sugar, and vanilla into the bowl.",
      "secondary_message": "237 ml heavy cream\n2 tsp granulated sugar\n1 tsp vanilla extract"
    },
    {
      "id": 215007,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.). Set aside.",
      "secondary_message": null
    },
    {
      "id": 215008,
      "primary_message": "Peel bananas, break into chunks, and transfer to a blender.",
      "secondary_message": "2 bananas"
    },
    {
      "id": 215009,
      "primary_message": "Add ice cream, milk, peanut butter, and cocoa powder to the blender. Blend on high until smooth.",
      "secondary_message": "946 ml vanilla ice cream\n355 ml whole milk\n2 tbsp natural peanut butter\n2 tbsp cocoa powder"
    },
    {
      "id": 215010,
      "primary_message": "To serve, divide milkshake between glasses and top with whipped cream and cocoa powder. Enjoy!",
      "secondary_message": "¼ tsp cocoa powder"
    }
  ],
