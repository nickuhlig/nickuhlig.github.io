  "instructions": [
    {
      "id": 214998,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 214999,
      "primary_message": "Once the bowl is chilled, remove from the freezer. Measure cold cream, sugar, and vanilla into the bowl.",
      "secondary_message": "118 ml (½ cup) heavy cream\n1 tsp granulated sugar\n½ tsp vanilla extract"
    },
    {
      "id": 215000,
      "primary_message": "Use a whisk to beat the cream vigorously, until medium-soft peaks form, about 2 minutes. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.). Set aside.",
      "secondary_message": null
    },
    {
      "id": 215001,
      "primary_message": "Peel banana, break into chunks, and transfer to a blender.",
      "secondary_message": "1 banana"
    },
    {
      "id": 215002,
      "primary_message": "Add ice cream, milk, peanut butter, and cocoa powder to the blender. Blend on high until smooth.",
      "secondary_message": "473 ml vanilla ice cream\n177 ml whole milk\n1 tbsp natural peanut butter\n1 tbsp cocoa powder"
    },
    {
      "id": 215003,
      "primary_message": "To serve, divide milkshake between glasses and top with whipped cream and cocoa powder. Enjoy!",
      "secondary_message": "⅛ tsp cocoa powder"
    }
  ],
