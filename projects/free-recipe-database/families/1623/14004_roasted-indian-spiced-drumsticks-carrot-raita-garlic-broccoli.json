  "instructions": [
    {
      "id": 344843,
      "primary_message": "Preheat oven to 450°F. Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 344844,
      "primary_message": "Place spices in a large bowl and stir to combine.",
      "secondary_message": "2 tsp cumin, ground\n1 ½ tsp salt\n¾ tsp coriander, ground\n¾ tsp cardamom, ground\n¾ tsp black pepper\n¾ tsp cinnamon, ground\n½ tsp cloves, ground\n½ tsp nutmeg, ground"
    },
    {
      "id": 344845,
      "primary_message": "Add chicken to the bowl with the spice mix and toss to thoroughly coat; divide chicken between baking sheets.",
      "secondary_message": "3 ¾ lb chicken drumsticks"
    },
    {
      "id": 344846,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until chicken is golden brown and cooked through, about 35 minutes.",
      "secondary_message": null
    },
    {
      "id": 344847,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 crowns broccoli\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 344848,
      "primary_message": "Peel, trim, and coarsely grate carrots; transfer to a medium bowl. Add yogurt, salt, and pepper; stir to combine the raita and set aside.",
      "secondary_message": "2 ¼ cups plain Greek yogurt\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 344849,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 344850,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 344851,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 344852,
      "primary_message": "While the pot heats up, trim green onions and slice crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 344853,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, green onions, and salt; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 344854,
      "primary_message": "Add broccoli and water to the pot; cook, stirring often, until the broccoli is bright green and fork-tender, about 6 minutes. Remove from heat.",
      "secondary_message": "⅓ cup water"
    },
    {
      "id": 344855,
      "primary_message": "To serve, divide spiced drumsticks, broccoli, and carrot raita between plates. Enjoy!",
      "secondary_message": null
    }
  ],
