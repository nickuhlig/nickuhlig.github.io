  "instructions": [
    {
      "id": 344868,
      "primary_message": "Preheat oven to 450°F. Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 344869,
      "primary_message": "Place spices in a large bowl and stir to combine.",
      "secondary_message": "1 ½ tsp cumin, ground\n1 tsp salt\n½ tsp coriander, ground\n½ tsp cardamom, ground\n½ tsp black pepper\n½ tsp cinnamon, ground\n¼ tsp cloves, ground\n¼ tsp nutmeg, ground"
    },
    {
      "id": 344870,
      "primary_message": "Add chicken to the bowl with the spice mix and toss to thoroughly coat; transfer to the baking sheet.",
      "secondary_message": "2 ½ lb chicken drumsticks"
    },
    {
      "id": 344871,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until chicken is golden brown and cooked through, 30-35 minutes.",
      "secondary_message": null
    },
    {
      "id": 344872,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 344873,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 344874,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 344875,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 344876,
      "primary_message": "While the skillet heats up, trim green onions and slice crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 344877,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, green onions, and salt; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 344878,
      "primary_message": "Add broccoli and water to the skillet; cook, stirring often, until the broccoli is bright green and fork-tender, about 5 minutes. Remove from heat.",
      "secondary_message": "¼ cup water"
    },
    {
      "id": 344879,
      "primary_message": "To serve, divide spiced drumsticks and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
