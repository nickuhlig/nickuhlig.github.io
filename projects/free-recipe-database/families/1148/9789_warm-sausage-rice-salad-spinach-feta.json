  "instructions": [
    {
      "id": 195193,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "⅔ cup basmati rice\n1 ⅓ cup water"
    },
    {
      "id": 195194,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, add the sausages, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed and sausages are cooked through, 15-18 minutes. Once done, remove from the heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "5 pork sausages"
    },
    {
      "id": 195195,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 lemons\n1 small bunch Italian (flat-leaf) parsley\n1 English cucumber\n2 red bell peppers\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 195196,
      "primary_message": "Juice the lemons into a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 195197,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "id": 195198,
      "primary_message": "Peel and mince the garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 195199,
      "primary_message": "Add oil, Dijon, vinegar, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp Dijon mustard\n2 tsp apple cider vinegar\n1 tsp honey\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 195200,
      "primary_message": "Small dice the cucumber; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 195201,
      "primary_message": "Seed and small dice the bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 195202,
      "primary_message": "When the rice is done, carefully remove the sausages. Allow them to cool slightly; cut lengthwise and then crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 195203,
      "primary_message": "Add sausage and rice to the bowl with the veggies and dressing. Toss to combine.",
      "secondary_message": null
    },
    {
      "id": 195204,
      "primary_message": "To serve, divide spinach between plates and top with sausage and rice salad. Sprinkle feta over top and enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
