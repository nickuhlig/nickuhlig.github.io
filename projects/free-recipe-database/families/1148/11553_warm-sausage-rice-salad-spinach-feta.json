  "instructions": [
    {
      "id": 195313,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large pot. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 195314,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, add the sausages, cover the pot, and reduce the heat to low. Cook the rice until the liquid is fully absorbed and sausages are cooked through, 15-18 minutes. Once done, remove from the heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "8 pre-cooked vegan sausage"
    },
    {
      "id": 195315,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ English cucumbers\n3 red bell peppers\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 195316,
      "primary_message": "Juice the lemons into a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 195317,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "id": 195318,
      "primary_message": "Peel and mince the garlic; add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 195319,
      "primary_message": "Add oil, Dijon, vinegar, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n1 tbsp apple cider vinegar\n1 ½ tsp honey\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 195320,
      "primary_message": "Small dice the cucumbers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 195321,
      "primary_message": "Seed and small dice the bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 195322,
      "primary_message": "When the rice is done, carefully remove the sausages. Allow them to cool slightly; cut lengthwise and then crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 195323,
      "primary_message": "Add sausage and rice to the bowl with the veggies and dressing. Toss to combine.",
      "secondary_message": null
    },
    {
      "id": 195324,
      "primary_message": "To serve, divide spinach between plates and top with sausage and rice salad. Sprinkle feta over top and enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
