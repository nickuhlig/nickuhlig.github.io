  "instructions": [
    {
      "primary_message": "FOR THE PEAR PURÉE: Wash and dry the fresh produce. ",
      "secondary_message": "1 pear\n¼ lemon\n¼ small pkg fresh rosemary"
    },
    {
      "primary_message": "Quarter, core, and medium dice pear. Place in a small saucepan. ",
      "secondary_message": null
    },
    {
      "primary_message": "Juice lemon into the pan with the pear.",
      "secondary_message": null
    },
    {
      "primary_message": "Add one sprig of rosemary to the pan along with water and honey (reserve remaining rosemary for serving). Bring liquid to a simmer over medium-high heat. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until pear is very soft, 8-10 minutes. Remove from heat and let cool, 5 minutes. ",
      "secondary_message": "1 ½ tbsp honey"
    },
    {
      "primary_message": "Discard rosemary, then transfer cooled pear (and any liquid in the pan) to a blender. Blend on high speed until smooth, about 30 seconds. ",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer pear purée to a shaker along with 4 fl oz (1/2 cup) gin and ice cubes. Shake until well chilled, about 30 seconds. ",
      "secondary_message": "4 fl oz gin\n⅔ cup ice cube"
    },
    {
      "primary_message": "Strain into tall glasses. Add additional ice, then top off with 8 fl oz (1 cup) chilled club soda. Gently stir to combine and garnish with reserved rosemary sprigs. Enjoy!",
      "secondary_message": "1 cup ice cube\n8 fl oz club soda"
    }
  ],
