  "instructions": [
    {
      "id": 377120,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 377121,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 377122,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until bacon has released its fat and is starting to brown, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 377123,
      "primary_message": "Meanwhile, using a clean cutting board, peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 377124,
      "primary_message": "Add onion, garlic, chicken, and spices to the pot with the bacon. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "0.68 kg ground chicken\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 377125,
      "primary_message": "Add broth, marinara sauce, cabbage, and carrots to the pot. Stir to combine the stew and bring to a simmer over medium-high heat.",
      "secondary_message": "2129 ml chicken or vegetable broth\n1 ½ (680 g) jars marinara sauce\n1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 377126,
      "primary_message": "Once the stew is simmering, reduce heat to medium and cook until veggies are tender, 6-8 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 377127,
      "primary_message": "To serve, divide stew between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
