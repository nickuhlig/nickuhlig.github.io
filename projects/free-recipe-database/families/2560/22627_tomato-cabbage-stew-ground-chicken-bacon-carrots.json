  "instructions": [
    {
      "id": 377104,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 377105,
      "primary_message": "While the pan heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 377106,
      "primary_message": "Once the pan is hot, add bacon and cook, stirring occasionally, until bacon has released its fat and is starting to brown, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 377107,
      "primary_message": "Meanwhile, using a clean cutting board, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 377108,
      "primary_message": "Add onion, garlic, chicken, and spices to the pan with the bacon. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "0.23 kg ground chicken\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 377109,
      "primary_message": "Add broth, marinara sauce, cabbage, and carrots to the pan. Stir to combine the stew and bring to a simmer over medium-high heat.",
      "secondary_message": "710 ml chicken or vegetable broth\n½ (680 g) jar marinara sauce\n½ (397 g) bag shredded cabbage (coleslaw mix)\n½ (283 g) bag shredded carrots"
    },
    {
      "id": 377110,
      "primary_message": "Once the stew is simmering, reduce heat to medium and cook until veggies are tender, 6-8 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 377111,
      "primary_message": "To serve, divide stew between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
