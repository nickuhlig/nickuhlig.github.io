  "instructions": [
    {
      "id": 274560,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 274561,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lb sweet potato\n½ pint grape tomatoes\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 274562,
      "primary_message": "Peel and cut sweet potato into ½-inch cubes; transfer to a baking sheet pan. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 274563,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potatoes are golden brown and fork-tender, about 20 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 274564,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 274565,
      "primary_message": "While the skillet heats up, slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 274566,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until golden brown and crispy, 4-5 minutes (or cook sausages according to package instructions). Use a slotted spoon to transfer the sausage to a paper towel-lined plate and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 274567,
      "primary_message": "While the sausage is cooking, place oil, vinegar, sugar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n½ tsp brown sugar\n½ tsp Italian seasoning\n¼ tsp parsley flakes\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 274568,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 274569,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 274570,
      "primary_message": "To serve, divide salad between plates or bowls; top with roasted sweet potato and crispy sausage. Enjoy!",
      "secondary_message": null
    }
  ],
