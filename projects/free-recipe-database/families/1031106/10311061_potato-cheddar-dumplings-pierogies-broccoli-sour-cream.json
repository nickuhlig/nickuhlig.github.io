  "instructions": [
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Bring to a boil over high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Once the water is boiling, uncover, add pierogies, and stir for a few seconds. Return water to a boil and cook until they float to the surface, about 3 minutes. Use a slotted spoon to remove the pierogies to a large plate. (Reserve pot with hot water for later use.) ",
      "secondary_message": "2 (456 g) pkg pierogies, frozen"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces.\n\n",
      "secondary_message": "2 crown broccoli"
    },
    {
      "primary_message": "When the pierogies are done, preheat a large skillet over medium heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, add pierogies and arrange in a single layer; cook, undisturbed, until golden brown, 4-5 minutes. Flip and continue to cook until golden brown on the second side, 4-5 minutes more. Return to the plate and loosely cover with aluminum foil to keep warm. (Reserve skillet for later use.)\n\n",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "primary_message": "Meanwhile, set pot (with hot water) over medium-high heat and return to a boil. Once boiling, add broccoli and cook until fork tender, 3-4 minutes. Drain in a colander.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Return the skillet to medium-high heat. Add broccoli, salt, and garlic powder; cook, stirring occasionally, until lightly golden, 3-4 minutes. Remove from heat.\n\n",
      "secondary_message": "¼ tsp salt\n¼ tsp garlic powder"
    },
    {
      "primary_message": "Divide pierogies and broccoli between plates. Serve with sour cream on the side and enjoy!\n\n",
      "secondary_message": "¾ cup sour cream"
    }
  ],
