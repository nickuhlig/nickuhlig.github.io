  "instructions": [
    {
      "id": 26748,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 26749,
      "primary_message": "Slice the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 26750,
      "primary_message": "Coat the grill or skillet with oil. Add the chicken and cook until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n"
    },
    {
      "id": 26751,
      "primary_message": "Peel and mince the garlic. In a small bowl, prepare the dressing by whisking together the minced garlic, olive oil, vinegar, Dijon, salt, and pepper. Set aside.",
      "secondary_message": "2 cloves garlic\r\n6 tbsp extra virgin olive oil\r\n2 tbsp balsamic vinegar\r\n½ tsp Dijon mustard\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 26752,
      "primary_message": "Halve and pit the avocados; slice the flesh crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": "2 avocados\r\n"
    },
    {
      "id": 26753,
      "primary_message": "Wash the tomatoes and basil. Halve the tomatoes. Pick the basil leaves off the stems; discard the stems and thinly slice the leaves crosswise into ribbons.",
      "secondary_message": "1 pint grape tomatoes\r\n1 small pkg fresh basil"
    },
    {
      "id": 26754,
      "primary_message": "Thinly slice the mozzarella.",
      "secondary_message": "1 (8 oz) ball fresh mozzarella cheese\r\n"
    },
    {
      "id": 26755,
      "primary_message": "Wash and dry the mixed greens.",
      "secondary_message": "2 (5 oz) pkg spring mix (mixed greens)\r\n"
    },
    {
      "id": 26756,
      "primary_message": "Slice the chicken crosswise on a angle.",
      "secondary_message": ""
    },
    {
      "id": 26757,
      "primary_message": "Arrange a bed of the mixed greens on a plate, top with the tomatoes, avocado slices, mozzarella, and chicken. Sprinkle with basil and drizzle with balsamic vinaigrette. Enjoy!",
      "secondary_message": ""
    }
  ],
