  "instructions": [
    {
      "id": 368219,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 368220,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 368221,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n½ English cucumber\n½ small bunch green onions (scallions)\n1 (1 inch) piece ginger root"
    },
    {
      "id": 368222,
      "primary_message": "Peel and trim carrot. Using the peeler, run it along the length of the carrot to make long, noodle-like strips; roughly chop into bite-sized pieces. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 368223,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the plate with the carrot.",
      "secondary_message": null
    },
    {
      "id": 368224,
      "primary_message": "Trim green onions and cut crosswise into thin pieces. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 368225,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368226,
      "primary_message": "While the skillet heats up, peel and mince ginger and garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 368227,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, chili-garlic sauce, and salt; cook, stirring often, until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp chili-garlic sauce\n¼ tsp salt"
    },
    {
      "id": 368228,
      "primary_message": "Add veggie ground to the skillet and cook, breaking it apart with a spoon, until beginning to brown, 2-3 minutes.",
      "secondary_message": "8 oz veggie ground, plant based"
    },
    {
      "id": 368229,
      "primary_message": "Add sugar and soy sauce to the skillet, stir to combine, and continue to cook, undisturbed, for 2 minutes.",
      "secondary_message": "2 tbsp brown sugar\n2 tsp soy sauce"
    },
    {
      "id": 368230,
      "primary_message": "Stir the veggie ground, then continue to cook, undisturbed, until the sugar begins to caramelize and the veggie ground becomes dark brown, 2 minutes more. Remove from heat and stir in half of the green onions.",
      "secondary_message": null
    },
    {
      "id": 368231,
      "primary_message": "To serve, divide rice between bowls. Top with veggie ground, cucumbers, carrots, and remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
