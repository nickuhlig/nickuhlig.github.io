  "instructions": [
    {
      "id": 368245,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 368246,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 368247,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n1 ½ English cucumbers\n1 small bunch green onions (scallions)\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 368248,
      "primary_message": "Peel and trim carrots. Using the peeler, run it along the length of each carrot to make long, noodle-like strips; roughly chop into bite-sized pieces. Place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 368249,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the plate with the carrot.",
      "secondary_message": null
    },
    {
      "id": 368250,
      "primary_message": "Trim green onions and cut crosswise into thin pieces. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 368251,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 368252,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368253,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, chili-garlic sauce, and salt; cook, stirring often, until fragrant, about 30 seconds.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp chili-garlic sauce\n¾ tsp salt"
    },
    {
      "id": 368254,
      "primary_message": "Add veggie ground to the skillet and cook, breaking it apart with a spoon, until beginning to brown, about 3 minutes.",
      "secondary_message": "24 oz veggie ground, plant based"
    },
    {
      "id": 368255,
      "primary_message": "Add sugar and soy sauce to the skillet, stir to combine, and continue to cook, undisturbed, for 2-3 minutes.",
      "secondary_message": "⅓ cup brown sugar\n2 tbsp soy sauce"
    },
    {
      "id": 368256,
      "primary_message": "Stir the veggie ground, then continue to cook, undisturbed, until the sugar begins to caramelize and the veggie ground becomes dark brown, 2-3 minutes more. Remove from heat and stir in half of the green onions.",
      "secondary_message": null
    },
    {
      "id": 368257,
      "primary_message": "To serve, divide rice between bowls. Top with veggie ground, cucumbers, carrots, and remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
