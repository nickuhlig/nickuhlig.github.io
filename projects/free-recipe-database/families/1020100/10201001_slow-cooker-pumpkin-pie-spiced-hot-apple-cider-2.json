  "instructions": [
    {
      "primary_message": "Wash, dry, quarter, and core apple; thinly slice. Place in a 4-quart slow cooker insert.",
      "secondary_message": "1 Gala apple"
    },
    {
      "primary_message": "Break cinnamon sticks in half and add to the insert with the sliced apple.",
      "secondary_message": null
    },
    {
      "primary_message": "Add apple juice, sugar, pumpkin pie spice, and vanilla to the insert, then stir to combine. Cover and cook until hot and flavors have blended, about 4 hours on low or 2 hours on high.",
      "secondary_message": "8 cups apple juice\n3 tbsp brown sugar\n1 tsp pumpkin pie spice mix\n1 tsp vanilla extract"
    },
    {
      "primary_message": " To serve, remove cinnamon sticks and divide cider between mugs. Enjoy!",
      "secondary_message": null
    }
  ],
