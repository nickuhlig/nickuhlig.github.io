  "instructions": [
    {
      "id": 1,
      "primary_message": "Place olive oil in a large pot and heat over medium high heat. Add garlic and potatoes and saute for 2 minutes. Add olives and cook, stirring frequently, for 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add tomatoes to pot and stir to combine. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Reduce heat to low and cover pot. Simmer, stirring occasionally, until potatoes are tender, about 40 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add oregano, lemon juice, and parsley to potatoes. Taste to correct seasoning. Right before serving, add feta to pot, and mix to combine.",
      "secondary_message": null
    }
  ],
