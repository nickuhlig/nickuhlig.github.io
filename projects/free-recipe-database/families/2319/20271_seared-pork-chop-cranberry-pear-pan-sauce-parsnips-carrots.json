  "instructions": [
    {
      "id": 338827,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 338828,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium parsnips\n4 medium carrots\n2 pears"
    },
    {
      "id": 338829,
      "primary_message": "Peel, trim, and medium dice parsnips and carrots; transfer both to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 338830,
      "primary_message": "Drizzle veggies with oil and season with spices; stir to combine and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 338831,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 338832,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 338833,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 338834,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 338835,
      "primary_message": "Meanwhile, quarter, core, and small dice pears; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 338836,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the pear.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 338837,
      "primary_message": "When the chops are done, add more oil to the skillet and swirl to coat the bottom; add pear, onion, garlic, and spices. Cook, stirring occasionally, until pear and onion start to soften, 2-3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 338838,
      "primary_message": "Add broth, cranberries, and honey to the skillet; continue to cook, stirring often, until fruit is tender and sauce is thickened, 2-3 minutes more. Remove from heat.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ cup dried cranberries\n4 tsp honey"
    },
    {
      "id": 338839,
      "primary_message": "To serve, divide chops and roasted veggies between plates; spoon pan sauce over chops. Enjoy!",
      "secondary_message": null
    }
  ],
