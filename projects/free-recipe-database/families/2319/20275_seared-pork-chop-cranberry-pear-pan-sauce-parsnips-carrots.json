  "instructions": [
    {
      "id": 338879,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 338880,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium parsnips\n6 medium carrots\n3 pears"
    },
    {
      "id": 338881,
      "primary_message": "Peel, trim, and medium dice parsnips and carrots; divide both between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 338882,
      "primary_message": "Drizzle veggies with oil and season with spices; stir to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 338883,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 338884,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 338885,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 338886,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 338887,
      "primary_message": "Meanwhile, quarter, core, and small dice pears; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 338888,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the pear.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 338889,
      "primary_message": "When the chops are done, add more oil to the skillet and swirl to coat the bottom; add pear, onion, garlic, and spices. Cook, stirring occasionally, until pear and onion start to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 338890,
      "primary_message": "Add broth and cranberries to the skillet; continue to cook, stirring often, until fruit is tender and sauce is thickened, 3-4 minutes more. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n¾ cup dried cranberries"
    },
    {
      "id": 338891,
      "primary_message": "To serve, divide chops and roasted veggies between plates; spoon pan sauce over chops. Enjoy!",
      "secondary_message": null
    }
  ],
