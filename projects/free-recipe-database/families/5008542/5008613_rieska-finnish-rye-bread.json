  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 205°C (400°F). Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In the bowl of a food processor combine rye flour, flour, baking powder, and salt and pulse five times to combine. Add butter and pulse until it is the size of peas, about another 5 pulses. Add buttermilk and pulse until dough comes together into a ball.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Shape dough into an 20-cm round. Bake until brown, about 40 minutes.",
      "secondary_message": null
    }
  ],
