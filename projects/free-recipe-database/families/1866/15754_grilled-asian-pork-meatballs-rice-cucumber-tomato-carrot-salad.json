  "instructions": [
    {
      "id": 258764,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n710 ml chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 258765,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 258766,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n1 ½ English cucumbers\n3 tomatoes\n3 medium carrots"
    },
    {
      "id": 258767,
      "primary_message": "Zest and juice limes into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 258768,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the lime juice.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 258769,
      "primary_message": "Trim and mince green onions. Add half to the bowl with the lime juice (place remaining green onion in another large bowl and set aside for the salad).",
      "secondary_message": null
    },
    {
      "id": 258770,
      "primary_message": "Add pork, fish sauce, and crushed red pepper to the bowl with the lime juice. Mix with your hands until well combined.",
      "secondary_message": "1.02 kg lean ground pork\n2 tbsp fish sauce\n½ tsp crushed red pepper"
    },
    {
      "id": 258771,
      "primary_message": "Using a scant ¼-cup measure, form the pork mixture into 24 short, sausage-like shapes, approximately 3-inches long; place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 258772,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258773,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add meatballs to the pan and grill, rotating every 2-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a clean plate.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 258774,
      "primary_message": "Meanwhile, add oil, vinegar, fish sauce, sugar, pepper, and salt to the bowl with the remaining green onion. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp toasted sesame oil\n2 tbsp rice vinegar\n1 tbsp fish sauce\n1 ½ tsp brown sugar\n½ tsp black pepper\n3 pinch salt"
    },
    {
      "id": 258775,
      "primary_message": "Peel and medium dice cucumbers; medium dice tomatoes. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258776,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258777,
      "primary_message": "To serve, divide rice, meatballs, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
