  "instructions": [
    {
      "id": 258697,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)\n½ English cucumber\n1 tomato\n1 medium carrot"
    },
    {
      "id": 258698,
      "primary_message": "Zest and juice lime into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 258699,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the lime juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 258700,
      "primary_message": "Trim and mince green onions. Add half to the bowl with the lime juice (place remaining green onion in another medium bowl and set aside for the salad).",
      "secondary_message": null
    },
    {
      "id": 258701,
      "primary_message": "Add pork, fish sauce, and crushed red pepper to the bowl with the lime juice. Mix with your hands until well combined.",
      "secondary_message": "¾ lb lean ground pork\n2 tsp fish sauce\n⅛ tsp crushed red pepper"
    },
    {
      "id": 258702,
      "primary_message": "Place sesame seeds on a plate, spreading them out in an even layer.",
      "secondary_message": "4 tsp sesame seeds"
    },
    {
      "id": 258703,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258704,
      "primary_message": "While the grill pan heats up, using a scant ¼-cup measure, form the pork mixture into 8 short, sausage-like shapes, approximately 3-inches long; place on the plate with the sesame seeds. Roll each meatball in the seeds to coat.",
      "secondary_message": null
    },
    {
      "id": 258705,
      "primary_message": "Once the grill pan is hot, coat with oil. Add meatballs to the pan and grill, rotating every 2-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a clean plate.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 258706,
      "primary_message": "Meanwhile, add oil, vinegar, fish sauce, sugar, pepper, and salt to the bowl with the remaining green onion. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp toasted sesame oil\n2 tsp rice vinegar\n1 tsp fish sauce\n½ tsp brown sugar\n⅛ tsp black pepper\n1 pinch salt"
    },
    {
      "id": 258707,
      "primary_message": "Peel and medium dice cucumber; medium dice tomato. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258708,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258709,
      "primary_message": "To serve, divide meatballs and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
