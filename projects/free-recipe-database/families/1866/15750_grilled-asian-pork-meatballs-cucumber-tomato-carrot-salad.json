  "instructions": [
    {
      "id": 258710,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 English cucumber\n2 tomatoes\n2 medium carrots"
    },
    {
      "id": 258711,
      "primary_message": "Zest and juice lime into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 258712,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the lime juice.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 258713,
      "primary_message": "Trim and mince green onions. Add half to the bowl with the lime juice (place remaining green onion in another medium bowl and set aside for the salad).",
      "secondary_message": null
    },
    {
      "id": 258714,
      "primary_message": "Add pork, fish sauce, and crushed red pepper to the bowl with the lime juice. Mix with your hands until well combined.",
      "secondary_message": "1 ½ lb lean ground pork\n4 tsp fish sauce\n¼ tsp crushed red pepper"
    },
    {
      "id": 258715,
      "primary_message": "Place sesame seeds on a plate, spreading them out in an even layer.",
      "secondary_message": "3 tbsp sesame seeds"
    },
    {
      "id": 258716,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258717,
      "primary_message": "While the grill pan heats up, using a scant ¼-cup measure, form the pork mixture into 16 short, sausage-like shapes, approximately 3-inches long; place on the plate with the sesame seeds. Roll each meatball in the seeds to coat.",
      "secondary_message": null
    },
    {
      "id": 258718,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add meatballs to the pan and grill, rotating every 2-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a clean plate.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 258719,
      "primary_message": "Meanwhile, add oil, vinegar, fish sauce, sugar, pepper, and salt to the bowl with the remaining green onion. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp toasted sesame oil\n4 tsp rice vinegar\n2 tsp fish sauce\n1 tsp brown sugar\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 258720,
      "primary_message": "Peel and medium dice cucumber; medium dice tomatoes. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258721,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258722,
      "primary_message": "To serve, divide meatballs and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
