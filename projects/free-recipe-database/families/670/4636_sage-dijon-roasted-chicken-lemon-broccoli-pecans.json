  "instructions": [
    {
      "id": 126233,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 126234,
      "primary_message": "Melt butter in the microwave or in a small saucepan. Add mustard, salt, and sage; whisk together. ",
      "secondary_message": "2 tbsp butter, unsalted\n2 tbsp Dijon mustard\n½ tsp salt\n½ tsp sage"
    },
    {
      "id": 126235,
      "primary_message": "Pat the chicken thighs dry with paper towel and place in a baking dish. Brush the chicken thighs evenly with the butter mixture. Place in the oven on the bottom rack and bake for 20 minutes or until cooked through. ",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 126236,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 crowns broccoli\n1 lemon"
    },
    {
      "id": 126237,
      "primary_message": "Cut the broccoli head into small, bite-sized florets and thinly slice the thicker stem portions.",
      "secondary_message": null
    },
    {
      "id": 126238,
      "primary_message": "Place the broccoli on the baking sheet pan. Drizzle with olive oil and season with salt and pepper; toss on the pan to coat. Spread out in a single layer and place in the oven. Roast for 10 to 12 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 126239,
      "primary_message": "Thinly slice half of the lemon, stack the slices and then finely dice. Transfer chopped lemon, including peel (but not seeds), to a blender. Juice the other half of the lemon. Add lemon juice, honey, oil, and salt; blend until smooth. ",
      "secondary_message": "2 tbsp honey\n¼ cup extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 126240,
      "primary_message": "Roughly chop the pecans. Remove broccoli from oven and toss in lemon dressing and pecans. ",
      "secondary_message": "½ cup pecans, dry roasted"
    },
    {
      "id": 126241,
      "primary_message": "To serve, divide the chicken thighs and broccoli mixture between the dishes. Enjoy! ",
      "secondary_message": null
    }
  ],
