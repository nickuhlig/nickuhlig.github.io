  "instructions": [
    {
      "id": 126242,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 126243,
      "primary_message": "Melt butter in the microwave or in a small saucepan. Add mustard, salt, and sage; whisk together. ",
      "secondary_message": "3 tbsp butter, unsalted\n3 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp sage"
    },
    {
      "id": 126244,
      "primary_message": "Pat the chicken thighs dry with paper towel and place in a baking dish. Brush the chicken thighs evenly with the butter mixture. Place in the oven on the bottom rack and bake for 20 minutes or until cooked through. ",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 126245,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 crowns broccoli\n1 ½ lemons"
    },
    {
      "id": 126246,
      "primary_message": "Cut the broccoli heads into small, bite-sized florets and thinly slice the thicker stem portions.",
      "secondary_message": null
    },
    {
      "id": 126247,
      "primary_message": "Place the broccoli on several baking sheet pans so that it can be spread out in a single layer. Drizzle with olive oil and season with salt and pepper; toss on the pan to coat. Place in the oven and roast for 10 to 12 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 126248,
      "primary_message": "Thinly slice half of the lemon, stack the slices and then finely dice. Transfer chopped lemon, including peel (but not seeds), to a blender. Juice the remaining lemon. Add lemon juice, honey, oil, and salt; blend until smooth. ",
      "secondary_message": "3 tbsp honey\n⅓ cup extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 126249,
      "primary_message": "Roughly chop the pecans. Remove broccoli from oven and toss in lemon dressing and pecans. ",
      "secondary_message": "¾ cup pecans, dry roasted"
    },
    {
      "id": 126250,
      "primary_message": "To serve, divide the chicken thighs and broccoli mixture between the dishes. Enjoy! ",
      "secondary_message": null
    }
  ],
