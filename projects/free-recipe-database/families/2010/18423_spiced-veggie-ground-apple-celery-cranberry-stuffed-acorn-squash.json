  "instructions": [
    {
      "id": 301727,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 301728,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 acorn squash\n2 Gala apples\n4 sticks celery"
    },
    {
      "id": 301729,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 301730,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 301731,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 301732,
      "primary_message": "Quarter and core apples, then medium dice; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 301733,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301734,
      "primary_message": "While the skillet heats up, trim and small dice celery; add to the bowl with the veggies and apple.",
      "secondary_message": null
    },
    {
      "id": 301735,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, apple, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n16 oz veggie ground, plant based\n1 tsp cinnamon, ground\n½ tsp nutmeg, ground\n½ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 301736,
      "primary_message": "When the veggie ground is done, add broth, cranberries, and sugar; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until slightly thickened, 2-3 minutes more. Cover and remove from heat.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n¼ cup dried cranberries\n4 tsp brown sugar"
    },
    {
      "id": 301737,
      "primary_message": "To serve, divide squash halves between plates and fill with the veggie ground stuffing. Enjoy!",
      "secondary_message": null
    }
  ],
