  "instructions": [
    {
      "id": 301804,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 301805,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 acorn squash\n3 Gala apples\n6 sticks celery"
    },
    {
      "id": 301806,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 301807,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 301808,
      "primary_message": "Meanwhile, peel, halve, and small dice onions; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 301809,
      "primary_message": "Quarter and core apples, then medium dice; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 301810,
      "primary_message": "Trim and small dice celery; add to the bowl with the veggies and apple.",
      "secondary_message": null
    },
    {
      "id": 301811,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301812,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, apple, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 ½ tsp cinnamon, ground\n¾ tsp nutmeg, ground\n¾ tsp salt\n½ tsp cayenne pepper"
    },
    {
      "id": 301813,
      "primary_message": "When the veggie ground is done, add broth, cranberries, and sugar; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until slightly thickened, 3-4 minutes more. Cover and remove from heat.",
      "secondary_message": "355 ml chicken or vegetable broth\n⅓ cup dried cranberries\n2 tbsp brown sugar"
    },
    {
      "id": 301814,
      "primary_message": "To serve, divide squash halves between plates and fill with the veggie ground stuffing. Enjoy!",
      "secondary_message": null
    }
  ],
