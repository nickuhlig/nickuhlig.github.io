  "instructions": [
    {
      "id": 301705,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 301706,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 acorn squash\n3 Gala apples\n6 sticks celery"
    },
    {
      "id": 301707,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 301708,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 301709,
      "primary_message": "Meanwhile, peel, halve, and small dice onions; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 301710,
      "primary_message": "Quarter and core apples, then medium dice; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 301711,
      "primary_message": "Trim and small dice celery; add to the bowl with the veggies and apple.",
      "secondary_message": null
    },
    {
      "id": 301712,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301713,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, apple, pork, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 ¼ lb lean ground pork\n1 ½ tsp salt\n1 ½ tsp cinnamon, ground\n¾ tsp nutmeg, ground\n½ tsp cayenne pepper"
    },
    {
      "id": 301714,
      "primary_message": "When the pork is done, add broth, cranberries, and sugar; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until slightly thickened, 3-4 minutes more. Cover and remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n⅓ cup dried cranberries\n2 tbsp brown sugar"
    },
    {
      "id": 301715,
      "primary_message": "To serve, divide squash halves between plates and fill with the pork and veggie stuffing. Enjoy!",
      "secondary_message": null
    }
  ],
