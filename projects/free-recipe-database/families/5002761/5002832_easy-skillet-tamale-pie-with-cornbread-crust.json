  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the onion. Thinly slice the garlic. Thaw the frozen corn kernels if frozen. Drain and rinse the black beans. Thinly slice the scallions. Finely mince the stems of the fresh cilantro leaves.",
      "secondary_message": "1 medium onion\n4 medium cloves garlic\n1 cup frozen corn kernels\n1 (425 g) can black beans\n3 scallions\n½ cup fresh cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to center position and preheat oven to 220°C (425°F). Heat butter in a 30-cm cast iron or stainless steel skillet over medium heat until melted. Continue to cook, swirling pan gently until butter is nutty-smelling and solids are a toasty brown. Transfer to a heatproof cup or bowl and reserve for Brown Butter Cornbread Crust.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Return pan to high heat. Add beef and cook, stirring and breaking up with a wooden spoon or a potato masher until starting to brown, about 8 minutes. Add onion and garlic and cook, stirring frequently, until softened and fragrant, about 4 minutes. Add chile powder, cayenne (if using), cumin, and coriander. Stir until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add corn, black beans, tomatoes, and chicken stock. Bring to a simmer, then stir in cheese. Reduce heat to low and cook, stirring occasionally, until thickened into a rich stew-like consistency, about 10 minutes. Remove from heat and stir in scallions and cilantro. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For the Brown Butter Cornbread Crust: In a large bowl, combine cornmeal, flour, sugar, 1 teaspoon kosher salt, baking powder, and baking soda. In a second bowl, combine eggs, sour cream, and buttermilk and whisk until homogenous. Whisking constantly, slowly drizzle in reserved browned butter. Whisk wet ingredients into dry ingredients until homogenous.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Using a large spoon, place small dollops of the cornbread batter mixture on top of the beef filling, then use the back of the spoon to spread it into an even layer. Transfer the skillet to the oven and bake until pale golden brown and a skewer inserted into the cornbread comes out clean, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Let cool 15 minutes, then serve with sour cream.",
      "secondary_message": null
    }
  ],
