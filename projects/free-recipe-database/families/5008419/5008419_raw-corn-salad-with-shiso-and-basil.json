  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the fresh corn kernels from 3 to 4 cobs. Halve the grape tomatoes. Halve and thinly slice the red radishes. Slice the cucumber. Finely slice the shallot. Crumble the feta cheese.",
      "secondary_message": "3 cups fresh corn kernels\n2 cups grape tomatoes\n6 to 8 medium red radishes\n1 large cucumber\n1 medium shallot\n3 oz feta cheese"
    },
    {
      "id": 1,
      "primary_message": "For the Salad: Combine corn, tomatoes, radishes, cucumber, shallot, feta cheese, and herbs in a large bowl. Toss gently to combine.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Dressing: Combine balsamic vinegar, olive oil, and Dijon mustard in a small bowl or sealable container. Whisk well or seal the container and shake vigorously until dressing is smooth and emulsified. Season with salt and pepper, blend again, and pour over salad. Toss until ingredients are evenly coated, then serve right away, garnishing with shiso and basil leaves.",
      "secondary_message": null
    }
  ],
