  "instructions": [
    {
      "id": 583644,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 583645,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove from heat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 veggie burger patties, plant-based"
    },
    {
      "id": 583646,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n3 plums\n3 tomatoes\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 583647,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl along with mayo, salt, and pepper, then stir to combine the basil mayo. Set aside. ",
      "secondary_message": "½ cup vegan mayonnaise\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 583648,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pit. Cut each half into thin slices. Place on another plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 583649,
      "primary_message": "Place oil, vinegar, Dijon, maple syrup, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 583650,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 583651,
      "primary_message": "Set aside a small handful of arugula for each burger, then add remaining arugula to the bowl. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 583652,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 583653,
      "primary_message": "Spread basil mayo over the bottom half of each bun; top with burger patties, plums, and reserved arugula. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
