  "instructions": [
    {
      "id": 583583,
      "primary_message": "Place pork, bread crumbs, Worcestershire sauce, and spices in a large bowl, then mix with your hands until well combined. Form the pork mixture into 6 equal-sized patties and place on a plate.",
      "secondary_message": "2 ¼ lb lean ground pork\n⅓ cup panko bread crumbs\n1 tbsp Worcestershire sauce\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 583584,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 583585,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 583586,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n3 plums\n3 tomatoes\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 583587,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl along with yogurt, mayo, salt, and pepper, then stir to combine the basil yogurt. Set aside. ",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 583588,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pit. Cut each half into thin slices. Place on another plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 583589,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 583590,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 583591,
      "primary_message": "Set aside a small handful of arugula for each burger, then add remaining arugula to the bowl. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 583592,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 583593,
      "primary_message": "Spread basil yogurt over the bottom half of each bun; top with reserved arugula, burger patties, and plums. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
