  "instructions": [
    {
      "id": 583572,
      "primary_message": "Place pork, bread crumbs, Worcestershire sauce, and spices in a medium bowl, then mix with your hands until well combined. Form the pork mixture into 4 equal-sized patties and place on a plate.",
      "secondary_message": "1 ½ lb lean ground pork\n¼ cup panko bread crumbs\n2 tsp Worcestershire sauce\n1 tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 583573,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 583574,
      "primary_message": "Once the pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 583575,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n2 plums\n2 tomatoes\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 583576,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl along with yogurt, mayo, salt, and pepper, then stir to combine the basil yogurt. Set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp mayonnaise\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 583577,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pit. Cut each half into thin slices. Place on another plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 583578,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 583579,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 583580,
      "primary_message": "Set aside a small handful of arugula for each burger, then add remaining arugula to the bowl. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 583581,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 583582,
      "primary_message": "Spread basil yogurt over the bottom half of each bun; top with reserved arugula, burger patties, and plums. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
