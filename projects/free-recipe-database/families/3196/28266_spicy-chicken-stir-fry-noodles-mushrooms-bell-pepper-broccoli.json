  "instructions": [
    {
      "id": 452336,
      "primary_message": "Fill a large pot with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 452337,
      "primary_message": "Meanwhile, preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 452338,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and slice crosswise into thin strips. Sprinkle with cornstarch, salt, and pepper.",
      "secondary_message": "1.02 kg chicken thighs, boneless skinless\n1 tbsp cornstarch\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 452339,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chicken and stir-fry until cooked through, 5-6 minutes. Transfer chicken to a plate and loosely cover with aluminum foil. (Reserve pot with drippings for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 452340,
      "primary_message": "While the chicken is cooking, wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n1 ½ red bell peppers\n3 crowns broccoli\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 452341,
      "primary_message": "Using a clean cutting board, thinly slice mushrooms. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 452342,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 452343,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 452344,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 452345,
      "primary_message": "Return pot (with drippings) to medium heat. Once the pot is hot, add veggies, salt, and pepper; stir-fry until veggies are fork-tender, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 452346,
      "primary_message": "While the veggies are cooking, place soy sauce, water, fish sauce, chili-garlic sauce, and cornstarch in the reserved bowl. Whisk to combine the stir-fry sauce.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp water\n1 tbsp fish sauce\n1 tbsp chili-garlic sauce\n1 tbsp cornstarch"
    },
    {
      "id": 452347,
      "primary_message": "When the veggies are done, add sauce to the pot. Continue to cook, stirring occasionally, until sauce has thickened, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 452348,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 452349,
      "primary_message": "Once the sauce has thickened, add drained noodles, chicken, and green onions to the pot. Toss to combine and continue to cook until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 452350,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
