  "instructions": [
    {
      "id": 452132,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse.",
      "secondary_message": "5 oz flat rice (pad thai) noodles"
    },
    {
      "id": 452133,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 452134,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and slice crosswise into thin strips. Sprinkle with cornstarch, salt, and pepper.",
      "secondary_message": "¾ lb chicken thighs, boneless skinless\n1 tsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 452135,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and stir-fry until cooked through, 4-5 minutes. Transfer chicken to a plate and loosely cover with aluminum foil. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 452136,
      "primary_message": "While the chicken is cooking, wash and dry the fresh produce.",
      "secondary_message": "½ lb cremini mushrooms\n½ red bell pepper\n1 crown broccoli\n1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 452137,
      "primary_message": "Using a clean cutting board, thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 452138,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 452139,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 452140,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 452141,
      "primary_message": "Return skillet (with drippings) to medium heat. Once the skillet is hot, add veggies, salt, and pepper; stir-fry until veggies are fork-tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 452142,
      "primary_message": "While the veggies are cooking, place soy sauce, water, fish sauce, chili-garlic sauce, and cornstarch in the reserved bowl. Whisk to combine the stir-fry sauce.",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp water\n1 tsp fish sauce\n1 tsp chili-garlic sauce\n1 tsp cornstarch"
    },
    {
      "id": 452143,
      "primary_message": "When the veggies are done, add sauce to the skillet. Continue to cook, stirring occasionally, until sauce has thickened, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 452144,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 452145,
      "primary_message": "Once the sauce has thickened, add drained noodles, chicken, and green onions to the skillet. Toss to combine and continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 452146,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
