  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and small dice tomatoes. Place on a large plate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice. Add to the plate with the tomato, keeping them separate.\n\n",
      "secondary_message": "1 orange bell pepper"
    },
    {
      "primary_message": "Drain and rinse beans. Add to the plate.\n\n",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "primary_message": "Drain corn and olives. Add both to the plate and set nacho toppings aside. \n\n",
      "secondary_message": "1 (8.5 oz) can whole kernel corn, canned\n1 (6.5 oz) can sliced black olives"
    },
    {
      "primary_message": "Cut four 12 x 12-inch squares of parchment paper, then place each square on a plate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide tortilla chips between the parchment-covered plates and sprinkle with half of the cheese. Allow everyone to build their nachos with their choice of the toppings available, then sprinkle with remaining cheese. \n\n",
      "secondary_message": "1 (11 oz) bag tortilla chips\n3 cups shredded cheese, Mexican blend"
    },
    {
      "primary_message": "Keeping the nachos on the parchment paper, transfer the paper to two large baking sheet pans (two squares per pan). Place nachos in the oven and bake until cheese is melted and starting to turn golden, 12-15 minutes. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer nachos to plates (you can leave them on the parchment or slide them off). Enjoy your creations with salsa, guacamole, and sour cream for dipping!\n\n",
      "secondary_message": "1 cup salsa\n1 cup guacamole\n½ cup sour cream"
    }
  ],
