  "instructions": [
    {
      "id": 33615,
      "primary_message": "Heat the oven to 500°F (260°C). Lightly coat a large baking sheet with oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 33621,
      "primary_message": "In a small saucepan, bring broth and water to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking constantly, until the polenta is incorporated into the liquid. Cook, stirring occasionally, until grains are soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "473 ml (2 cups) chicken or vegetable broth\n2 cups water\n1 cup polenta (cornmeal)"
    },
    {
      "id": 33616,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.454 kg brussels sprouts\n4 medium carrots\n1 small pkg fresh thyme"
    },
    {
      "id": 33617,
      "primary_message": "Trim and quarter Brussels sprouts. Transfer to the baking sheet.",
      "secondary_message": ""
    },
    {
      "id": 33618,
      "primary_message": "Trim and peel carrots; halve lengthwise and cut into ¼-inch-thick pieces on an angle. Transfer to the baking sheet.",
      "secondary_message": ""
    },
    {
      "id": 33619,
      "primary_message": "Drain and rinse the chickpeas; place on a clean towel (or paper towels) and pat dry. Transfer to the baking sheet.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 33620,
      "primary_message": "Toss the vegetables and chickpeas and spread out evenly on the sheet. Place in the oven and roast until the vegetables are tender and chickpeas are golden brown, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 33622,
      "primary_message": "Slide the thyme leaves off the stems; discard the stems and chop the leaves.",
      "secondary_message": ""
    },
    {
      "id": 33623,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 33625,
      "primary_message": "In a small bowl, combine and whisk together the thyme, garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "4 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 33626,
      "primary_message": "Remove the sheet from the oven. Pour the sauce over the vegetables and chickpeas; toss to coat.",
      "secondary_message": null
    },
    {
      "id": 33627,
      "primary_message": "Place the sheet back in the oven and continue to cook until the vegetables are tender, about 5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 33628,
      "primary_message": "Add a oil to the polenta and season with salt and pepper; stir to combine.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 33629,
      "primary_message": "Divide the polenta between plates and top with the roasted vegetables and chickpeas. Enjoy!",
      "secondary_message": null
    }
  ],
