  "instructions": [
    {
      "id": 431889,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 431890,
      "primary_message": "Arrange tortillas on a large baking sheet pan. Drizzle with oil on both sides, then season with salt.",
      "secondary_message": "8 small corn tortillas\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 431891,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until tortillas are golden and crispy, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 431892,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431893,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with spices. ",
      "secondary_message": "4 tsp extra virgin olive oil\n8 eggs\n½ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 431894,
      "primary_message": "While the eggs are cooking, wash, dry, and small dice tomatoes.",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 431895,
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 431896,
      "primary_message": "To serve, divide crispy tortillas between plates; top with eggs, tomatoes, avocado, and feta. Drizzle with hot sauce and enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n2 tsp hot sauce"
    }
  ],
