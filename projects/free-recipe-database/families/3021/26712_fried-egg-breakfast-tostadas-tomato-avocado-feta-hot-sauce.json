  "instructions": [
    {
      "id": 431849,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 431850,
      "primary_message": "Divide tortillas between two large baking sheet pans. Drizzle with oil on both sides, then season with salt.",
      "secondary_message": "12 small corn tortillas\n1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 431851,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until tortillas are golden and crispy, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 431852,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431853,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with spices. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n12 eggs\n¾ tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 431854,
      "primary_message": "While the eggs are cooking, wash, dry, and small dice tomatoes.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 431855,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": "1 ½ avocados"
    },
    {
      "id": 431856,
      "primary_message": "To serve, divide crispy tortillas between plates; top with eggs, tomatoes, avocado, and feta. Drizzle with hot sauce and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n1 tbsp hot sauce"
    }
  ],
