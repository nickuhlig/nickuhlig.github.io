  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine ingredients in medium bowl and whisk together until powder is fully integrated into oil and clumps form into something like lumpy biscuit dough. Transfer powder to fine mesh strainer. Push mixture through strainer using whisk in circular pattern; this will create a fine powder. Store in a dry container or use immediately.",
      "secondary_message": null
    }
