  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oven to 350°F. Prepare a rimmed baking sheet with non-stick spray or oil. Combine flour, salt, and baking soda in a large bowl and whisk to combine. Add buttermilk and barley malt syrup to the bowl and mix just until all dry ingredients are evenly combined.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Scrape batter out onto prepared sheet pan and smooth out to the edges as evenly as possible. Bake until edges are just browning and puling away from the pan, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Loosen cake with a spatula and flip out on a cooling rack immediately. Reduce oven to 275°F. Set aside to cool about 40 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Working in 4 or 5 batches, roughly break up cake into chunks by hand and then pulse in food processor until bits reach desired size.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spread cereal bits across 2 rimmed baking sheets and bake until completely dry (about 45 minutes), stirring cereal and rotating pans every 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Once dry, turn off oven, crack door, and leave to cool. Store in air-tight container.",
      "secondary_message": null
    }
  ],
