  "instructions": [
    {
      "id": 510593,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ½-cup pasta water before draining.)",
      "secondary_message": "1 ½ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 510594,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n1 ½ medium heads napa cabbage\n1 small pkg chives"
    },
    {
      "id": 510595,
      "primary_message": "Peel, trim, and coarsely grate carrots. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 510596,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 510597,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 510598,
      "primary_message": "Once the pot is hot, add garlic and sausage. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 ½ lb ground pork sausage"
    },
    {
      "id": 510599,
      "primary_message": "Meanwhile, trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 510600,
      "primary_message": "Chop chives into small pieces. Add half to the bowl. (Reserve remaining chives for serving.)",
      "secondary_message": null
    },
    {
      "id": 510601,
      "primary_message": "When the sausage is done, add carrot, cabbage, chives, and spices to the pot. Stir to combine, then cover and cook, stirring occasionally, until cabbage is tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 510602,
      "primary_message": "While the cabbage is cooking, place water, Dijon, and honey in the reserved bowl. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup water\n3 tbsp Dijon mustard\n2 tbsp honey"
    },
    {
      "id": 510603,
      "primary_message": "When the cabbage is tender, add sauce to the pot, along with drained pasta, and stir to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 510604,
      "primary_message": "To serve, divide pasta between plates or bowls. Top with reserved chives and enjoy!",
      "secondary_message": null
    }
  ],
