  "instructions": [
    {
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ¼-cup pasta water before draining.)",
      "secondary_message": "salt"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n½ medium head napa cabbage\n½ small pkg chives"
    },
    {
      "primary_message": "Peel, trim, and coarsely grate carrots. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Once the skillet is hot, add garlic and sausage. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "½ lb ground pork sausage"
    },
    {
      "primary_message": "Meanwhile, trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "primary_message": "Chop chives into small pieces. Add half to the bowl. (Reserve remaining chives for serving.)",
      "secondary_message": null
    },
    {
      "primary_message": "When the sausage is done, add carrot, cabbage, chives, and spices to the skillet. Stir to combine, then cover and cook, stirring occasionally, until cabbage is tender, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "½ tsp thyme, dried\nsalt\n¼ tsp black pepper"
    },
    {
      "primary_message": "While the cabbage is cooking, place water, Dijon, and honey in the reserved bowl. Whisk to combine the sauce.",
      "secondary_message": "1 tbsp Dijon mustard\n2 tsp honey"
    },
    {
      "primary_message": "When the cabbage is tender, add sauce to the skillet, along with drained pasta, and stir to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pasta between plates or bowls. Top with reserved chives and enjoy!",
      "secondary_message": null
    }
  ],
