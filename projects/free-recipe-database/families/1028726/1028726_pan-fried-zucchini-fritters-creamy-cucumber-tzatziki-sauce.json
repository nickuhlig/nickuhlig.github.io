  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n½ lemon\n¼ small bunch fresh dill\n½ English cucumber"
    },
    {
      "primary_message": "Trim and coarsely grate zucchini. Transfer to a colander and sprinkle with salt. Place the colander in a bowl to catch the excess moisture and set aside to drain.",
      "secondary_message": "½ tsp salt"
    },
    {
      "primary_message": "Meanwhile, juice lemon into a small bowl. Add yogurt and spices, then stir to combine.",
      "secondary_message": "½ cup plain Greek yogurt\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the yogurt mixture.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and coarsely grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add to the bowl, stir to combine the tzatziki, and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Use paper towels or a clean cloth to squeeze excess moisture out of the grated zucchini, then transfer to a medium bowl. Add eggs, flour, baking powder, and spices, then stir to combine the batter.",
      "secondary_message": "½ cup all-purpose flour\n1 tsp baking powder\n¼ tsp salt\n¼ tsp black pepper\n1 pinch nutmeg, ground"
    },
    {
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Working in batches, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, 4-6 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide fritters between plates and serve with tzatziki for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
