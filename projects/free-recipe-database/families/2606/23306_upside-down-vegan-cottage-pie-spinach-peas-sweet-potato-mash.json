  "instructions": [
    {
      "id": 383124,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg sweet potato\n2 medium carrots\n2 sticks celery\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 383125,
      "primary_message": "Peel and medium dice sweet potatoes. Place in a medium saucepan, cover with hot water (from the tap), and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 383126,
      "primary_message": "Once the liquid in the saucepan is boiling, reduce heat to medium, cover, and simmer until sweet potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 383127,
      "primary_message": "Meanwhile, peel, halve, and small dice onions.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 383128,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 383129,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and salt; cook, stirring occasionally until softened, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 383130,
      "primary_message": "While the onion is cooking, peel, trim, and small dice carrots. Trim and small dice celery. ",
      "secondary_message": null
    },
    {
      "id": 383131,
      "primary_message": "Once the onion is soft, add the carrot and celery. Cook, stirring occasionally, until tender, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 383132,
      "primary_message": "While the veggies are cooking, peel and mince garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 383133,
      "primary_message": "Add garlic, veggie ground, and spices to the skillet. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "454 g veggie ground, plant based\n½ tsp salt\n½ tsp black pepper\n⅛ tsp nutmeg, ground"
    },
    {
      "id": 383134,
      "primary_message": "When the sweet potatoes are done, drain and return to the pan. Add oil and spices; using a potato masher, mash until smooth. Cover to keep warm and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper\n½ tsp nutmeg, ground"
    },
    {
      "id": 383135,
      "primary_message": "When the veggie ground is done, add peas, water, and vinegar to the skillet. Stir to combine. ",
      "secondary_message": "1 cup frozen peas\n¼ cup water\n4 tsp balsamic vinegar"
    },
    {
      "id": 383136,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine, and continue to cook until peas are warmed through, 1 minute more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 383137,
      "primary_message": "To serve, divide sweet potato mash between plates or bowls; top with veggie ground filling. Enjoy!",
      "secondary_message": null
    }
  ],
