  "instructions": [
    {
      "id": 383068,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "⅓ kg sweet potato\n1 medium carrot\n1 stick celery\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 383069,
      "primary_message": "Peel and medium dice sweet potato. Place in a medium saucepan, cover with hot water (from the tap), and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 383070,
      "primary_message": "Once the liquid in the saucepan is boiling, reduce heat to medium, cover, and simmer until sweet potato is tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 383071,
      "primary_message": "Meanwhile, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 383072,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 383073,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and salt; cook, stirring occasionally until softened, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 383074,
      "primary_message": "While the onion is cooking, peel, trim, and small dice carrot. Trim and small dice celery. ",
      "secondary_message": null
    },
    {
      "id": 383075,
      "primary_message": "Once the onion is soft, add the carrot and celery. Cook, stirring occasionally, until tender, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 383076,
      "primary_message": "While the veggies are cooking, peel and mince garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 383077,
      "primary_message": "Add garlic, beef, and spices to the skillet. Cook, breaking the meat apart with a spoon, until the beef is browned and crumbly, 5-6 minutes.",
      "secondary_message": "⅓ kg lean ground beef\n½ tsp salt\n¼ tsp black pepper\n1 pinch nutmeg, ground"
    },
    {
      "id": 383078,
      "primary_message": "When the sweet potatoes are done, drain and return to the pan. Add oil and spices; using a potato masher, mash until smooth. Cover to keep warm and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp nutmeg, ground"
    },
    {
      "id": 383079,
      "primary_message": "When the beef is done, add peas and vinegar to the skillet. Stir to combine.",
      "secondary_message": "½ cup frozen peas\n2 tsp balsamic vinegar"
    },
    {
      "id": 383080,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine, and continue to cook until peas are warmed through, 1 minute more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 383081,
      "primary_message": "To serve, divide sweet potato mash between plates or bowls; top with beef-veggie filling. Enjoy!",
      "secondary_message": null
    }
  ],
