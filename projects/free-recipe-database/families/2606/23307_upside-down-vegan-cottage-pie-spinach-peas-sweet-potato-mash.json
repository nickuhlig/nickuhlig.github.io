  "instructions": [
    {
      "id": 383138,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1.02 kg sweet potatoes\n3 medium carrots\n3 sticks celery\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 383139,
      "primary_message": "Peel and medium dice sweet potatoes. Place in a large pot, cover with hot water (from the tap), and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 383140,
      "primary_message": "Once the liquid in the pot is boiling, reduce heat to medium, cover, and simmer until sweet potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 383141,
      "primary_message": "Meanwhile, peel, halve, and small dice onions.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 383142,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 383143,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and salt; cook, stirring occasionally until softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 383144,
      "primary_message": "While the onion is cooking, peel, trim, and small dice carrots. Trim and small dice celery. ",
      "secondary_message": null
    },
    {
      "id": 383145,
      "primary_message": "Once the onion is soft, add the carrot and celery. Cook, stirring occasionally, until tender, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 383146,
      "primary_message": "While the veggies are cooking, peel and mince garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 383147,
      "primary_message": "Add garlic, veggie ground, and spices to the skillet. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "680 g veggie ground, plant based\n¾ tsp salt\n¾ tsp black pepper\n¼ tsp nutmeg, ground"
    },
    {
      "id": 383148,
      "primary_message": "When the sweet potatoes are done, drain and return to the pot. Add oil and spices; using a potato masher, mash until smooth. Cover to keep warm and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp nutmeg, ground"
    },
    {
      "id": 383149,
      "primary_message": "When the veggie ground is done, add peas, water, and vinegar to the skillet. Stir to combine. ",
      "secondary_message": "1 ½ cups frozen peas\n⅓ cup water\n1 ½ tbsp balsamic vinegar"
    },
    {
      "id": 383150,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine, and continue to cook until peas are warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 383151,
      "primary_message": "To serve, divide sweet potato mash between plates or bowls; top with veggie ground filling. Enjoy!",
      "secondary_message": null
    }
  ],
