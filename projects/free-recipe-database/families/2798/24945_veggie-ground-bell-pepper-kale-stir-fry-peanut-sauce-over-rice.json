  "instructions": [
    {
      "id": 401391,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 401392,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 401393,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a small bowl along with peanut sauce, vinegar, water, salt, and pepper. Stir to combine the sauce and set aside. ",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 cup peanut sauce\n3 tbsp rice vinegar\n3 tbsp water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 401394,
      "primary_message": "Wash, dry, trim, and seed bell peppers; medium dice.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 401395,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 401396,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper and veggie ground; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil\n680 g veggie ground, plant based"
    },
    {
      "id": 401397,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": "1 ½ (283 g) bags kale, cut and ready to use"
    },
    {
      "id": 401398,
      "primary_message": "Add the sauce and continue to cook until kale is tender and sauce thickens slightly, 2-3 minutes more. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 401399,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
