  "instructions": [
    {
      "id": 401346,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 401347,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 401348,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a small bowl along with peanut sauce, vinegar, water, salt, and pepper. Stir to combine the sauce and set aside. ",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n⅓ cup peanut sauce\n1 tbsp rice vinegar\n1 tbsp water\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 401349,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 401350,
      "primary_message": "While the skillet heats up, wash, dry, trim, and seed bell pepper; medium dice.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 401351,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and chicken; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n0.23 kg ground chicken"
    },
    {
      "id": 401352,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": "½ (283 g) bag kale, cut and ready to use"
    },
    {
      "id": 401353,
      "primary_message": "Add the sauce and continue to cook until kale is tender and sauce thickens slightly, 1-2 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 401354,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
