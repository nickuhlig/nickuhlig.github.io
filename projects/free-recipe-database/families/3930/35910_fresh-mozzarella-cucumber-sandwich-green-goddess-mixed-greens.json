  "instructions": [
    {
      "id": 564787,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg fresh basil\n1 ½ red bell peppers\n1 ½ (142 g) pkgs spring mix (mixed greens)\n1 ½ English cucumbers"
    },
    {
      "id": 564788,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 564789,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 564790,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 564791,
      "primary_message": "Pick basil leaves off the stems; discard stems and add leaves to the blender, along with yogurt, mayo, oil, capers, salt, and pepper. Blend on high until dressing is smooth, then transfer half to a large bowl. (Reserve remaining dressing for later use.)",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n¼ cup extra virgin olive oil\n3 tbsp capers\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 564792,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the dressing, along with the mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 564793,
      "primary_message": "Trim and cut cucumbers crosswise into thin rounds. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 564794,
      "primary_message": "Slice mozzarella into rounds. Add to the plate with the cucumber.",
      "secondary_message": "1 ½ (227 g) pkgs fresh mozzarella cheese"
    },
    {
      "id": 564795,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 564796,
      "primary_message": "To assemble the sandwiches, spread each bread slice with the reserved dressing. Layer half of the slices with cucumber and mozzarella. Season with salt, close with remaining bread slices, and cut in half.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 564797,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
