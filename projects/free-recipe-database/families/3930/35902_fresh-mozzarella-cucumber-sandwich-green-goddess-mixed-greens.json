  "instructions": [
    {
      "id": 564699,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ small pkg fresh basil\n½ red bell pepper\n½ (5 oz) pkg spring mix (mixed greens)\n½ English cucumber"
    },
    {
      "id": 564700,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 564701,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 564702,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 564703,
      "primary_message": "Pick basil leaves off the stems; discard stems and add leaves to the blender, along with yogurt, mayo, oil, capers, salt, and pepper. Blend on high until dressing is smooth, then transfer half to a medium bowl. (Reserve remaining dressing for later use.)",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 ½ tbsp extra virgin olive oil\n1 tbsp capers\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 564704,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl with the dressing, along with the mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 564705,
      "primary_message": "Trim and cut cucumber crosswise into thin rounds. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 564706,
      "primary_message": "Slice mozzarella into rounds. Add to the plate with the cucumber.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 564707,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 564708,
      "primary_message": "To assemble the sandwiches, spread each bread slice with the reserved dressing. Layer half of the slices with cucumber and mozzarella. Season with salt, close with remaining bread slices, and cut in half.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 564709,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
