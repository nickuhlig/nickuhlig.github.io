  "instructions": [
    {
      "id": 1,
      "primary_message": "Soak dried shiitake mushrooms in 2 cups water until all mushrooms are soft throughout, about 20 minutes. Reserve soaking liquid (strain out any crumbs or solids at the bottom if necessary). Squeeze out mushrooms and remove stems. Slice caps thinly and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Soak dried baby shrimp in just enough water to cover until slightly soft and moist, about 10 minutes. Drain and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Slice cabbage head in halves, then quarters. Cut out tough stem portions and discard. Coarsely shred remaining leaves.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat oil in a large pan or wok with a lid over medium-high heat. Add garlic, chiles, dried shrimp, and sliced shiitake mushrooms. Stir until very fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add cabbage to pan along with white pepper and a pinch of salt. Toss occasionally, until its volume has decreased slightly and oil and other ingredients are incorporated throughout, 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Pour in reserved soaking liquid from mushrooms and stir. Cover pan, reduce heat slightly, and cook at a steady simmer for 5 to 6 minutes. Check on the dish; once leaves are fully wilted and translucent, remove lid. Taste and season with salt as desired. Remove from heat and serve immediately.",
      "secondary_message": null
    }
  ],
