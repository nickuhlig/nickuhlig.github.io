  "instructions": [
    {
      "id": 344275,
      "primary_message": "Preheat the oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 344276,
      "primary_message": "Peel and mince garlic; place in a large bowl, along with oil and spices, and whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n2 ½ tsp cumin, ground\n2 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp paprika\n¾ tsp turmeric, ground\n½ tsp cinnamon, ground\n3 pinch cayenne pepper"
    },
    {
      "id": 344277,
      "primary_message": "Add chicken to the bowl with the marinade and turn to coat. Transfer drumsticks to the baking sheet, spreading them out in a single layer.",
      "secondary_message": "1.7 kg chicken drumsticks"
    },
    {
      "id": 344278,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, turning once, until the chicken is golden brown and cooked through, about 35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344279,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ bunches kale\n1 small bunch Italian (flat-leaf) parsley\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 344280,
      "primary_message": "Juice lemons into a clean large bowl. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 344281,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 344282,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344283,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344284,
      "primary_message": "Halve tomatoes; add to the bowl, along with feta, and toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 344285,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
