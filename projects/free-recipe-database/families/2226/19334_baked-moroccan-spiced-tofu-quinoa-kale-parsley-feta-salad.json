  "instructions": [
    {
      "id": 344286,
      "primary_message": "Preheat the oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 344287,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 344288,
      "primary_message": "Place quinoa and broth in a small saucepan and bring to a boil over high heat. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 344289,
      "primary_message": "Peel and mince garlic; place in a medium bowl, along with oil and spices, and whisk to combine the marinade.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp coriander, ground\n½ tsp salt\n¼ tsp paprika\n¼ tsp turmeric, ground\n⅛ tsp cinnamon, ground\n1 pinch cayenne pepper"
    },
    {
      "id": 344290,
      "primary_message": "Medium dice tofu, add to the bowl with the marinade, and gently toss to coat. Return tofu to the baking sheet and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 344291,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344292,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ bunch kale\n½ small bunch Italian (flat-leaf) parsley\n½ English cucumber\n½ small pkg grape tomatoes"
    },
    {
      "id": 344293,
      "primary_message": "Juice lemon into the reserved bowl. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 344294,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 344295,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344296,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344297,
      "primary_message": "Halve tomatoes, add to the bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 344298,
      "primary_message": "Transfer cooked quinoa to another baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 344299,
      "primary_message": "Once the quinoa has cooled slightly, add to the bowl, along with the feta, and toss to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 344300,
      "primary_message": "To serve, divide salad between plates or bowls and top with tofu. Enjoy!",
      "secondary_message": null
    }
  ],
