  "instructions": [
    {
      "id": 344316,
      "primary_message": "Preheat the oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 344317,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 344318,
      "primary_message": "Place quinoa and broth in a medium saucepan and bring to a boil over high heat. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 344319,
      "primary_message": "Peel and mince garlic; place in a large bowl, along with oil and spices, and whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n2 ½ tsp cumin, ground\n½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp paprika\n¾ tsp turmeric, ground\n½ tsp cinnamon, ground\n3 pinch cayenne pepper"
    },
    {
      "id": 344320,
      "primary_message": "Medium dice tofu, add to the bowl with the marinade, and gently toss to coat. Divide tofu between two baking sheets and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 344321,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344322,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ bunches kale\n1 small bunch Italian (flat-leaf) parsley\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 344323,
      "primary_message": "Juice lemons into the reserved bowl. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 344324,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 344325,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344326,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344327,
      "primary_message": "Halve tomatoes, add to the bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 344328,
      "primary_message": "Transfer cooked quinoa to a large baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 344329,
      "primary_message": "Once the quinoa has cooled slightly, add to the bowl, along with the feta, and toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 344330,
      "primary_message": "To serve, divide salad between plates or bowls and top with tofu. Enjoy!",
      "secondary_message": null
    }
  ],
