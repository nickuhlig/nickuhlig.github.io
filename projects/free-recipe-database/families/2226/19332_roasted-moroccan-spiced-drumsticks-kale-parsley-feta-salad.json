  "instructions": [
    {
      "id": 344264,
      "primary_message": "Preheat the oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 344265,
      "primary_message": "Peel and mince garlic; place in a medium bowl, along with oil and spices, and whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n1 tsp salt\n½ tsp paprika\n½ tsp turmeric, ground\n¼ tsp cinnamon, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 344266,
      "primary_message": "Add chicken to the bowl with the marinade and turn to coat. Transfer drumsticks to the baking sheet, spreading them out in a single layer.",
      "secondary_message": "1 ⅛ kg chicken drumsticks"
    },
    {
      "id": 344267,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, turning once, until the chicken is golden brown and cooked through, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344268,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 bunch kale\n1 small bunch Italian (flat-leaf) parsley\n1 English cucumber\n1 small pkg grape tomatoes"
    },
    {
      "id": 344269,
      "primary_message": "Juice lemon into a clean medium bowl. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 344270,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 344271,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344272,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 344273,
      "primary_message": "Halve tomatoes; add to the bowl, along with feta, and toss to combine the salad.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 344274,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
