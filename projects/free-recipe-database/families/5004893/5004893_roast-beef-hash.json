  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a large pot of water to a boil. Add the potatoes and cook until tender, about 15-20 minutes. A knife should easily slip into them. Remove and stash in the fridge for 15 minutes or so while you prep the rest of the ingredients. Then dice the potatoes into 1/4 inch cubes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour the oil into a large skillet over medium-high heat. Dump in the potatoes and cook for 10 minutes or so, stirring occasionally, until they begin to brown. Add the onion and cook for another 10 minutes, or until they are very soft.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the roast beef, garlic, thyme, cayenne, and nutmeg. Cook for 5 more minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour in the heavy cream and stir until distributed. Then press down on the hash with the back of a spatula and cook for a final 10 minutes, stirring every 2 minutes until very crispy and browned. Season with salt and pepper. Top with a fried egg.",
      "secondary_message": null
    }
  ],
