  "instructions": [
    {
      "id": 1,
      "primary_message": "In a mixer fitted with the paddle attachment, cream together the butter, salt, cheese, and herbs until just combined. Scrape down the sides of the bowl with a silicone spatula, and add the egg. Mix until just combined. It will look a bit curdled.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the flour, and run the machine just until the dough comes together (you can’t see any dry flour), and not a second more. Turn the dough out onto a big sheet of plastic wrap, and knead two to three times, so the dough has no air pockets or cracks. Roll the dough, using the plastic wrap, into a 10-inch log. Refrigerate for 2 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat the oven to 350°F. Cut the ragged ends off the log of dough, and then slice into 1/4-inch rounds. Place the rounds on a parchment-lined baking sheet, and bake until the edges of the sablés are just golden, 15-17 minutes. Let stand 5 minutes outside to cool, then transfer to a wire rack. Serve with lots of rosé!",
      "secondary_message": null
    }
  ],
