  "ingredients": [
    {
      "ingredient_id": 115,
      "name": "unsalted butter, room temperature",
      "quantity": "1 stick"
    },
    {
      "ingredient_id": 88,
      "name": "Kosher salt",
      "quantity": "½ tsp"
    },
    {
      "ingredient_id": 120,
      "name": "finely grated good Parmesan cheese",
      "quantity": "½ cup"
    },
    {
      "ingredient_id": 286,
      "name": "fresh rosemary leaves, chopped",
      "quantity": "1 tbsp"
    },
    {
      "ingredient_id": 1677,
      "name": "fresh thyme leaves, chopped",
      "quantity": "1 tbsp"
    },
    {
      "ingredient_id": 121,
      "name": "egg",
      "quantity": "1"
    },
    {
