  "instructions": [
    {
      "id": 278297,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 278298,
      "primary_message": "When the pan is hot, add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Place toasted bread crumbs in a small bowl and set pan aside for later use.",
      "secondary_message": "⅓ cup panko bread crumbs"
    },
    {
      "id": 278299,
      "primary_message": "Meanwhile, finely grate Parmesan, place in another small bowl, and set aside.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 278300,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 medium carrots\n2 sticks celery\n½ small bunch Italian (flat-leaf) parsley\n½ avocado\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 278301,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 278302,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the carrot and celery.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 278303,
      "primary_message": "Return the saucepan to medium heat.",
      "secondary_message": null
    },
    {
      "id": 278304,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the veggies and spices; cook, stirring occasionally, until starting to soften, about 5 minutes. (Reserve bowl for next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 278305,
      "primary_message": "Meanwhile, place oil, mayo, vinegar, honey, and spices in the reserved bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp mayonnaise\n1 tsp white wine vinegar\n½ tsp honey\n¼ tsp basil, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 278306,
      "primary_message": "Add broth to the pan with the veggies; stir to combine, cover, and bring the soup to a boil. Once boiling, reduce heat to medium-low and simmer until veggies are soft, about 5 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth"
    },
    {
      "id": 278307,
      "primary_message": "While the soup is cooking, shave parsley leaves off the stems; discard stems, mince the leaves, and set aside.",
      "secondary_message": null
    },
    {
      "id": 278308,
      "primary_message": "When the veggies are soft, uncover the soup, and stir in the bread crumbs and parsley; return to a simmer.",
      "secondary_message": null
    },
    {
      "id": 278309,
      "primary_message": "Gently crack eggs into small bowls (2 eggs per bowl). Carefully tip bowls into the pan, sliding the eggs carefully into the soup. Cook until whites are set but yolks are still soft, 2½-3 minutes. Remove soup from the heat.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 278310,
      "primary_message": "While the eggs are poaching, halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl with the dressing, along with mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 278311,
      "primary_message": "Divide soup and eggs between bowls, then sprinkle with Parmesan. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
