  "instructions": [
    {
      "id": 278235,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 278236,
      "primary_message": "When the pot is hot, add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Place toasted bread crumbs in a small bowl and set pot aside for later use.",
      "secondary_message": "1 cup panko bread crumbs"
    },
    {
      "id": 278237,
      "primary_message": "Meanwhile, finely grate Parmesan, place in another small bowl, and set aside.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 278238,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 medium carrots\n6 sticks celery\n1 small bunch Italian (flat-leaf) parsley\n1 ½ avocados\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 278239,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 278240,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the carrot and celery.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 278241,
      "primary_message": "Return the pot to medium heat.",
      "secondary_message": null
    },
    {
      "id": 278242,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies and spices; cook, stirring occasionally, until starting to soften, 5-6 minutes. (Reserve bowl for next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 278243,
      "primary_message": "Meanwhile, place oil, mayo, vinegar, honey, and spices in the reserved bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp mayonnaise\n1 tbsp white wine vinegar\n1 ½ tsp honey\n¾ tsp basil, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 278244,
      "primary_message": "Add broth to the pot with the veggies; stir to combine, cover, and bring the soup to a boil. Once boiling, reduce heat to medium-low and simmer until veggies are soft, 5-6 minutes.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth"
    },
    {
      "id": 278245,
      "primary_message": "While the soup is cooking, shave parsley leaves off the stems; discard stems, mince the leaves, and set aside.",
      "secondary_message": null
    },
    {
      "id": 278246,
      "primary_message": "When the veggies are soft, uncover the soup, and stir in the bread crumbs and parsley; return to a simmer.",
      "secondary_message": null
    },
    {
      "id": 278247,
      "primary_message": "Gently crack eggs into small bowls (2 eggs per bowl). ",
      "secondary_message": "12 eggs"
    },
    {
      "id": 278248,
      "primary_message": "Working in batches if necessary, carefully tip bowls into the pot, sliding the eggs carefully into the soup. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a plate (remove soup from the heat once all of the eggs have been poached).",
      "secondary_message": null
    },
    {
      "id": 278249,
      "primary_message": "While the eggs are poaching, halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl with the dressing, along with mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 278250,
      "primary_message": "Divide soup and eggs between bowls, then sprinkle with Parmesan. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
