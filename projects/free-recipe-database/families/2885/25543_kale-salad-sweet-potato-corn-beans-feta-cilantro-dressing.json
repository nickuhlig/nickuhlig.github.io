  "instructions": [
    {
      "id": 409328,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 409329,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb sweet potato\n1 lime\n½ jalapeño pepper\n½ small bunch cilantro\n1 bunch kale"
    },
    {
      "id": 409330,
      "primary_message": "Peel and medium dice sweet potato. Transfer to a baking sheet pan, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp chili powder\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 409331,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potatoes are browned and fork-tender, 15-20 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 409332,
      "primary_message": "Meanwhile, juice lime into a blender.",
      "secondary_message": null
    },
    {
      "id": 409333,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Roughly chop and add to the blender. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 409334,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender along with yogurt, oil, honey, and salt. Blend on high until smooth, adding 1 tablespoon of water, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt"
    },
    {
      "id": 409335,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 409336,
      "primary_message": "Add dressing to the bowl with the kale and, using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 409337,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the kale.",
      "secondary_message": "1 (15 oz) can pinto beans"
    },
    {
      "id": 409338,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 409339,
      "primary_message": "Add cooled sweet potato and feta to the bowl. Gently toss to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 409340,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
