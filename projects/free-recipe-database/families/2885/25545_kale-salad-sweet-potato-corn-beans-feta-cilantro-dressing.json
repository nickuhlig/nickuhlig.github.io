  "instructions": [
    {
      "id": 409354,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 409355,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n3 limes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n3 bunches kale"
    },
    {
      "id": 409356,
      "primary_message": "Peel and medium dice sweet potatoes. Divide between two baking sheet pans, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 409357,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potatoes are browned and fork-tender, about 20 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 409358,
      "primary_message": "Meanwhile, juice limes into a blender.",
      "secondary_message": null
    },
    {
      "id": 409359,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Roughly chop and add to the blender. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 409360,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender along with yogurt, oil, honey, and salt. Blend on high until smooth, adding 1-2 tablespoons of water, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 409361,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 409362,
      "primary_message": "Add dressing to the bowl with the kale and, using your hands, massage kale with the dressing until wilted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 409363,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the kale.",
      "secondary_message": "3 (15 oz) cans pinto beans"
    },
    {
      "id": 409364,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl.",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 409365,
      "primary_message": "Add cooled sweet potato and feta to the bowl. Gently toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 409366,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
