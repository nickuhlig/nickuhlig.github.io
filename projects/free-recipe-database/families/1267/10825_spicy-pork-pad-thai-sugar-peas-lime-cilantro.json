  "instructions": [
    {
      "id": 177916,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ (8 oz) pkg sugar snap peas\n½ small bunch green onions (scallions)\n½ small bunch cilantro"
    },
    {
      "id": 177917,
      "primary_message": "Fill a medium saucepan halfway with water and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Then using a strainer or colander, rinse the rice noodles under cold, running water.",
      "secondary_message": "4 oz flat rice (pad thai) noodles"
    },
    {
      "id": 177918,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 177919,
      "primary_message": "When the skillet is hot, add pork and, breaking apart with a spoon, cook until browned and crumbly, 4-6 minutes. ",
      "secondary_message": "¾ lb lean ground pork"
    },
    {
      "id": 177920,
      "primary_message": "Meanwhile, juice half the lime into a small bowl. Add sauces and sugar; whisk to combine. ",
      "secondary_message": "2 tbsp soy sauce\n2 tsp fish sauce\n2 tsp chili-garlic sauce\n½ tsp brown sugar"
    },
    {
      "id": 177921,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 177922,
      "primary_message": "Slice peas and green onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 177923,
      "primary_message": "Add garlic and vegetables to the skillet and cook, stirring frequently, until they begin to soften, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 177924,
      "primary_message": "Push pork and veggies to the edge of the skillet and crack the egg in the center. Scramble until the egg is lightly set, then mix in with the pork and veggies.",
      "secondary_message": "1 egg"
    },
    {
      "id": 177925,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add cilantro to the skillet, reserving some for garnish. ",
      "secondary_message": null
    },
    {
      "id": 177926,
      "primary_message": "Add noodles and sauce to the skillet. Stir until coated and warmed through, 1-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 177927,
      "primary_message": "Cut remaining lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 177928,
      "primary_message": "To serve, divide Pad Thai between bowls and garnish with remaining cilantro and lime wedges. ",
      "secondary_message": null
    }
  ],
