  "instructions": [
    {
      "id": 177929,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 (8 oz) pkg sugar snap peas\n1 small bunch green onions (scallions)\n1 small bunch cilantro"
    },
    {
      "id": 177930,
      "primary_message": "Fill a medium saucepan halfway with water and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Then using a strainer or colander, rinse the rice noodles under cold, running water.",
      "secondary_message": "8 oz flat rice (pad thai) noodles"
    },
    {
      "id": 177931,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 177932,
      "primary_message": "When the skillet is hot, add pork and, breaking apart with a spoon, cook until browned and crumbly, 5-7 minutes. ",
      "secondary_message": "1 ½ lb lean ground pork"
    },
    {
      "id": 177933,
      "primary_message": "Meanwhile, juice half the limes into a small bowl. Add sauces and sugar; whisk to combine. ",
      "secondary_message": "¼ cup soy sauce\n4 tsp fish sauce\n4 tsp chili-garlic sauce\n1 tsp brown sugar"
    },
    {
      "id": 177934,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 177935,
      "primary_message": "Slice peas and green onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 177936,
      "primary_message": "Add garlic and vegetables to the skillet and cook, stirring frequently, until they begin to soften, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 177937,
      "primary_message": "Push pork and veggies to the edge of the skillet and crack eggs in the center. Scramble until eggs are lightly set, then mix in with the pork and veggies.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 177938,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add cilantro to the skillet, reserving some for garnish. ",
      "secondary_message": null
    },
    {
      "id": 177939,
      "primary_message": "Add noodles and sauce to the skillet. Stir until coated and warmed through, 2-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 177940,
      "primary_message": "Cut remaining lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 177941,
      "primary_message": "To serve, divide Pad Thai between bowls and garnish with remaining cilantro and lime wedges. ",
      "secondary_message": null
    }
  ],
