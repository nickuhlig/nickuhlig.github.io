  "instructions": [
    {
      "id": 177969,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n1 (8 oz) pkg sugar snap peas\n1 small bunch green onions (scallions)\n2 red bell peppers\n2 limes\n1 small bunch cilantro"
    },
    {
      "id": 177970,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 177971,
      "primary_message": "When the skillet is hot, add pork and, breaking apart with a spoon, cook until browned and crumbly, 5-7 minutes. ",
      "secondary_message": "1 ½ lb lean ground pork"
    },
    {
      "id": 177972,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 177973,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise and then thinly slice crosswise. Transfer to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 177974,
      "primary_message": "Seed and slice bell peppers into thin strips, add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 177975,
      "primary_message": "Slice peas and green onions crosswise into ¼-inch pieces at an angle. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 177976,
      "primary_message": "Add garlic and vegetables to the skillet and cook, stirring frequently, until they begin to soften 4-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 177977,
      "primary_message": "Meanwhile, juice half the limes into a small bowl. Add sauces and sugar; whisk to combine. ",
      "secondary_message": "¼ cup soy sauce\n4 tsp fish sauce\n4 tsp chili-garlic sauce\n1 tsp brown sugar"
    },
    {
      "id": 177978,
      "primary_message": "Push pork and veggies to the edge of the skillet and crack the egg in the center. Scramble until the egg is lightly set, then mix in with the pork and veggies.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 177979,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add cilantro to the skillet, reserving some for garnish. ",
      "secondary_message": null
    },
    {
      "id": 177980,
      "primary_message": "Add sauce to the skillet. Stir until coated and warmed through, 2-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 177981,
      "primary_message": "Cut remaining lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 177982,
      "primary_message": "To serve, divide Pad Thai between bowls and garnish with remaining cilantro and lime wedges. ",
      "secondary_message": null
    }
  ],
