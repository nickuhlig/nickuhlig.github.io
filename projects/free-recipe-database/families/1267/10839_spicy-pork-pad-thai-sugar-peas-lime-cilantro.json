  "instructions": [
    {
      "id": 178104,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ (227 g) pkg sugar snap peas\n1 ½ small bunches green onions (scallions)\n1 small bunch cilantro"
    },
    {
      "id": 178105,
      "primary_message": "Fill a large pot halfway with water and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Then using a strainer or colander, rinse the rice noodles under cold, running water.",
      "secondary_message": "340 g flat rice (pad thai) noodles"
    },
    {
      "id": 178106,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 178107,
      "primary_message": "When the skillet is hot, add pork and, breaking apart with a spoon, cook until browned and crumbly, 5-7 minutes. ",
      "secondary_message": "1.02 kg lean ground pork"
    },
    {
      "id": 178108,
      "primary_message": "Meanwhile, juice half the limes into a small bowl. Add sauces and sugar; whisk to combine. ",
      "secondary_message": "⅓ cup soy sauce\n2 tbsp fish sauce\n2 tbsp chili-garlic sauce\n1 ½ tsp brown sugar"
    },
    {
      "id": 178109,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 178110,
      "primary_message": "Slice peas and green onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 178111,
      "primary_message": "Add garlic and vegetables to the skillet and cook, stirring frequently, until they begin to soften, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 178112,
      "primary_message": "Push pork and veggies to the edge of the skillet and crack eggs in the center. Scramble until eggs are lightly set, then mix in with the pork and veggies.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 178113,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add cilantro to the skillet, reserving some for garnish. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 178114,
      "primary_message": "Return noodles to the pot. Place over medium heat and add sauce, veggies, and meat. Stir until coated and warmed through, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 178115,
      "primary_message": "Cut remaining limes into wedges. ",
      "secondary_message": null
    },
    {
      "id": 178116,
      "primary_message": "To serve, divide Pad Thai between bowls and garnish with remaining cilantro and lime wedges. ",
      "secondary_message": null
    }
  ],
