  "instructions": [
    {
      "id": 178145,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n1 ½ (227 g) pkg sugar snap peas\n1 ½ small bunches green onions (scallions)\n1 red bell pepper\n3 limes\n1 small bunch cilantro"
    },
    {
      "id": 178146,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 178147,
      "primary_message": "When the pot is hot, add pork and, breaking apart with a spoon, cook until browned and crumbly, 6-8 minutes. ",
      "secondary_message": "1.02 kg lean ground pork"
    },
    {
      "id": 178148,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 178149,
      "primary_message": "Trim off and discard the root end of each cabbage; halve each cabbage lengthwise and thinly slice crosswise. Transfer to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 178150,
      "primary_message": "Seed and slice bell peppers into thin strips, add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 178151,
      "primary_message": "Slice peas and green onions crosswise into ¼-inch pieces at an angle. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 178152,
      "primary_message": "Add garlic and vegetables to the pot and cook, stirring frequently, until they begin to soften 4-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 178153,
      "primary_message": "Meanwhile, juice half the limes into a small bowl. Add sauces and sugar; whisk to combine. ",
      "secondary_message": "⅓ cup soy sauce\n2 tbsp fish sauce\n2 tbsp chili-garlic sauce\n1 ½ tsp brown sugar"
    },
    {
      "id": 178154,
      "primary_message": "Push pork and veggies to the edge of the pot and crack the egg in the center. Scramble until the egg is lightly set, then mix in with the pork and veggies.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 178155,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add cilantro to the pot, reserving some for garnish. ",
      "secondary_message": null
    },
    {
      "id": 178156,
      "primary_message": "Add sauce to the pot. Stir until coated and warmed through, 2-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 178157,
      "primary_message": "Cut remaining limes into wedges. ",
      "secondary_message": null
    },
    {
      "id": 178158,
      "primary_message": "To serve, divide Pad Thai between bowls and garnish with remaining cilantro and lime wedges. ",
      "secondary_message": null
    }
  ],
