  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 175°C (350°F). Lightly grease each ramekin with non-stick cooking spray. In small bowl, whisk together granulated sugar, white rice flour, cocoa powder, tapioca starch, salt, and baking soda. Add milk (or coffee), vegetable oil, and egg. Whisk until smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Sprinkle chocolate chips evenly between the two prepared ramekins. Divide batter evenly between the ramekins. Bake until cake is firm and aromatic, about 25 minutes. Remove from oven. Allow to cool for five minutes. Dusk with confectioners' sugar if desired. Serve warm.",
      "secondary_message": null
    }
  ],
