  "instructions": [
    {
      "id": 200611,
      "primary_message": "In a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 ⅓ cups whole wheat couscous"
    },
    {
      "id": 200612,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n1 English cucumber\n1 pint grape tomatoes\n1 yellow bell pepper\n1 small bunch Italian (flat-leaf) parsley\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 200613,
      "primary_message": "Mince olives and transfer to a large bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 200614,
      "primary_message": "Zest and juice lemon into the bowl with the olives.",
      "secondary_message": null
    },
    {
      "id": 200615,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil, vinegar, honey, and salt; whisk to combine the dressing.",
      "secondary_message": "4 cloves garlic\n¼ cup extra virgin olive oil\n¼ cup red wine vinegar\n1 tsp honey\n1 tsp salt"
    },
    {
      "id": 200616,
      "primary_message": "Peel and thinly slice onion into half rings. Add to the bowl and toss to combine.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 200617,
      "primary_message": "Trim and quarter cucumber lengthwise, then slice crosswise into ¼-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200618,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200619,
      "primary_message": "Seed and slice bell pepper into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200620,
      "primary_message": "Once the couscous is done, transfer to a large baking sheet pan and spread out in an even layer to cool.",
      "secondary_message": null
    },
    {
      "id": 200621,
      "primary_message": "Shave parsley leaves off the stems; discard stems, mince leaves, and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200622,
      "primary_message": "Drain and rinse chickpeas; add to the bowl.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 200623,
      "primary_message": "Add couscous and feta to the bowl; toss to combine the salad.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 200624,
      "primary_message": "To serve, divide mixed greens between bowls. Top with couscous salad and enjoy!",
      "secondary_message": null
    }
  ],
