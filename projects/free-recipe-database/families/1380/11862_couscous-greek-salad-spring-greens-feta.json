  "instructions": [
    {
      "id": 200625,
      "primary_message": "In a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n2 cups whole wheat couscous"
    },
    {
      "id": 200626,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n1 ½ pints grape tomatoes\n1 ½ yellow bell peppers\n1 small bunch Italian (flat-leaf) parsley\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 200627,
      "primary_message": "Mince olives and transfer to a large bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 200628,
      "primary_message": "Zest and juice lemons into the bowl with the olives.",
      "secondary_message": null
    },
    {
      "id": 200629,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil, vinegar, honey, and salt; whisk to combine the dressing.",
      "secondary_message": "6 cloves garlic\n⅓ cup extra virgin olive oil\n⅓ cup red wine vinegar\n1 ½ tsp honey\n1 ½ tsp salt"
    },
    {
      "id": 200630,
      "primary_message": "Peel and thinly slice onions into half rings. Add to the bowl and toss to combine.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 200631,
      "primary_message": "Trim and quarter cucumbers lengthwise, then slice crosswise into ¼-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200632,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200633,
      "primary_message": "Seed and slice bell peppers into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200634,
      "primary_message": "Once the couscous is done, transfer to a large baking sheet pan and spread out in an even layer to cool.",
      "secondary_message": null
    },
    {
      "id": 200635,
      "primary_message": "Shave parsley leaves off the stems; discard stems, mince leaves, and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200636,
      "primary_message": "Drain and rinse chickpeas; add to the bowl.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 200637,
      "primary_message": "Add couscous and feta to the bowl; toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 200638,
      "primary_message": "To serve, divide mixed greens between bowls. Top with couscous salad and enjoy!",
      "secondary_message": null
    }
  ],
