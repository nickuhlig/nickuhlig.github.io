  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Cake: Adjust oven rack to middle position and preheat oven to 350°F. Brush tube pan with oil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine cinnamon, cloves, allspice, and ginger in large bowl. Stir in hot coffee. Set aside and cool to room temperature. Rub orange zest into granulated sugar until sugar is damp and no strands of zest remain. Add brown sugar and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk together flour and salt in medium bowl. Add 1 1/4 cups honey, 1 cup oil, cider, and whiskey to coffee mixture and whisk to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "With electric mixer on medium speed, beat together eggs and sugar mixture in large bowl until well combined, about 3 minutes. Reduce speed to low, then add honey mixture and mix until blended, about 1 minute. Add flour mixture and mix just until combined.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour batter into prepared pan (batter will be thin) and bake until tester inserted in center comes out clean, about 1 hour. Transfer to rack and cool cake in pan 15 minutes, then invert directly onto rack and cool completely, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For the Glaze: Warm remaining 3/4 cup honey in microwave or small saucepan. Brush the sides of the cake, then drizzle remaining honey over cake. Serve.",
      "secondary_message": null
    }
  ],
