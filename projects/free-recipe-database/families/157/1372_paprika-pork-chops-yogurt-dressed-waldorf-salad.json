  "instructions": [
    {
      "id": 11837,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": ""
    },
    {
      "id": 11838,
      "primary_message": "Place pork chops in a small baking dish. Rub both sides with paprika, salt, and pepper.",
      "secondary_message": "4 pork chops, boneless\n1 tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 11839,
      "primary_message": "Place in the oven and bake until cooked through, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11840,
      "primary_message": "In a medium bowl, prepare dressing by whisking together lemon juice, yogurt, honey, salt, and pepper.",
      "secondary_message": "½ lemon\n½ cup plain Greek yogurt\n2 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 11841,
      "primary_message": "Wash and dry apples and celery. Core and medium dice apples. Medium dice celery. Add to bowl with dressing.",
      "secondary_message": "4 Gala apples\n4 sticks celery"
    },
    {
      "id": 11842,
      "primary_message": "Add raisins to bowl. Roughly chop walnuts and add to bowl. Toss salad.",
      "secondary_message": "½ cup raisins\r\n½ cup walnuts"
    },
    {
      "id": 27811,
      "primary_message": "Cut remaining piece of lemon into wedges for serving.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 11843,
      "primary_message": "To serve, place pork chops and salad on a plate and garnish with lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
