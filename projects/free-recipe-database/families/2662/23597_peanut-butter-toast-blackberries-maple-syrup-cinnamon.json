  "instructions": [
    {
      "id": 386153,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 386154,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 386155,
      "primary_message": "Meanwhile, wash and dry blackberries.",
      "secondary_message": "2 (6 oz) pkgs blackberries"
    },
    {
      "id": 386156,
      "primary_message": "Spread 2 tablespoons peanut butter over each slice of toast. Top with blackberries, drizzle with maple syrup, and sprinkle with cinnamon.",
      "secondary_message": "½ cup natural peanut butter\n4 tsp pure maple syrup\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 386157,
      "primary_message": "To serve, divide toast between plates and enjoy!",
      "secondary_message": null
    }
  ],
