  "instructions": [
    {
      "primary_message": "This recipe uses pre-sliced and frozen strawberries and bananas. If you would like to use fresh fruit, wash, dry, and slice equal parts strawberries and bananas (to yield 4 cups). Divide into 1-cup portions, and freeze until ready to use.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide milk, yogurt, and protein powder between 4 medium jars or food storage containers, then whisk to combine. Seal jars and store protein base in the fridge until ready to use. (Best if used within 4 days.)\n\n",
      "secondary_message": "4 cups whole milk\n2 cups plain Greek yogurt\n4 serving vanilla whey-based protein powder (containing 20 grams protein/serving)"
    },
    {
      "primary_message": "To make your smoothie, remove one jar of protein base from the fridge and shake well to combine. Transfer to a blender, along with 1 cup of frozen strawberries and bananas, then blend on high until smooth, 1-2 minutes. (Reserve remaining strawberries and bananas for remaining smoothies.) \n\n",
      "secondary_message": "4 cups frozen strawberries & bananas"
    },
    {
      "primary_message": "To serve, pour smoothie into a glass and enjoy!",
      "secondary_message": null
    }
  ],
