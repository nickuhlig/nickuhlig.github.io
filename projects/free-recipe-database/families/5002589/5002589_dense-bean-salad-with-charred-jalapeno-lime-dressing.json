  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack 6 inches below heat source and preheat oven to broil. In a large bowl, stir together cherry tomatoes, red onion, and 1/2 teaspoon salt. Let stand until tomatoes release some juices and onion softens slightly, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, on a rimmed baking sheet, place jalapeño, scallions, garlic, and corn, arranging jalapeño cut-side-down and pushing corn kernels to one side of sheet. Broil, stirring corn and turning scallions halfway through, until vegetables are charred in spots, 5 to 8 minutes. Let cool slightly, about 5 minutes. Peel garlic; discard skins. Transfer jalapeño, scallions, and peeled garlic to a blender; set corn aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To blender, add lime juice, vinegar, honey, cumin, chile powder, black pepper, and remaining 1/2 teaspoon salt and blend on high until mostly smooth, about 30 seconds. With blender running, stream in oil and blend until smooth and emulsified, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To bowl with salted tomatoes, stir in chickpeas, pinto beans, black beans, cilantro, and reserved charred corn until combined. Gently fold in queso fresco.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add prepared jalapeño-lime dressing to bean salad and toss to combine. Season with salt and black pepper to taste. Garnish with additional cilantro. Serve with lime wedges.",
      "secondary_message": null
    }
  ],
