  "instructions": [
    {
      "id": 28429,
      "primary_message": "Fill a medium saucepan halfway with water; cover and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 28431,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 28443,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets; season with salt and pepper.",
      "secondary_message": "½ lb chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 28433,
      "primary_message": "Add butter to the pan and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 28444,
      "primary_message": "Place the chicken in the pan and cook until golden brown and cooked through, 3 to 4 minutes per side. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 28432,
      "primary_message": "While the chicken cooks, wash and dry the knife and cutting board. Then peel and mince the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 28442,
      "primary_message": "Once the water in the saucepan is boiling, season with salt and add the pasta; stir for the few seconds. Cook until desired firmness, 9 to 10 minutes.",
      "secondary_message": "1 tbsp salt\n4 oz (1 quarter coin = 2 oz) fettuccine pasta"
    },
    {
      "id": 28434,
      "primary_message": "Once the chicken has been transferred, reduce the heat to medium-low and add more butter to the pan.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 28435,
      "primary_message": "Add the garlic and flour to the pan and whisk for about 1 minute.",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 28436,
      "primary_message": "Add the broth and whisk until smooth, then add the milk and cook, stirring frequently, until the sauce is thickened, 4 to 5 minutes.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n4 fl oz (½ cup) whole milk"
    },
    {
      "id": 28430,
      "primary_message": "Wash and dry the broccoli; cut the head into bite-sized florets and medium dice the stems. Transfer to a medium bowl. Add to the pasta during the last 3 to 4 minutes of cooking time.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 28437,
      "primary_message": "Finely grate ¼ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 28438,
      "primary_message": "Add the Parmesan to the sauce and season with salt and pepper; stir until smooth, then reduce the heat to low until the pasta is ready.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 28446,
      "primary_message": "Wash the lemon; grate all of the zest, then juice the lemon.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 28439,
      "primary_message": "Drain the pasta and broccoli in a colander, reserving about ½ cup of the pasta water.",
      "secondary_message": null
    },
    {
      "id": 28445,
      "primary_message": "Slice the chicken crosswise.",
      "secondary_message": null
    },
    {
      "id": 28440,
      "primary_message": "Add the pasta, broccoli, chicken, lemon zest and juice, and ½ of the reserved pasta water to the sauce; toss to combine. Add more pasta water to thin out the sauce if needed.",
      "secondary_message": null
    },
    {
      "id": 28441,
      "primary_message": "Divide the fettuccine alfredo between two plates (or one plate and one lunch container). Enjoy!",
      "secondary_message": null
    }
  ],
