  "instructions": [
    {
      "id": 586095,
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 586096,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 fennel bulbs\n1 bunch radish\n2 small bunches asparagus\n1 small pkg fresh basil"
    },
    {
      "id": 586097,
      "primary_message": "Zest and juice lemon into a small bowl. Add yogurt, Dijon, and spices, then whisk to combine the yogurt sauce. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n1 tsp Dijon mustard\n1 tsp onion powder\n1 tsp parsley flakes\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 586098,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice into thin strips. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 586099,
      "primary_message": "Trim and halve radishes lengthwise. Add to the baking sheet with the fennel, drizzle with oil, then season with salt and pepper; toss to coat and spread out in an even layer. Place veggies in the oven (it doesn't have to be fully heated) and bake until starting to soften, about 10 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 586100,
      "primary_message": "Meanwhile, snap (or cut) off woody ends of the asparagus; cut spears into bite-sized pieces. Place in a large bowl, drizzle with oil, then season with salt and pepper. Toss to coat and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 586101,
      "primary_message": "Peel and mince garlic. Place in another small bowl along with oil, salt, and pepper, then stir to combine the garlic oil.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 586102,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 586103,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Using your hands, rub with the garlic oil on both sides.",
      "secondary_message": "4 pork chops, bone-in"
    },
    {
      "id": 586104,
      "primary_message": "Once the skillet is hot, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 586105,
      "primary_message": "When the veggies have started to soften, remove baking sheet from oven. Add asparagus, toss to combine, and spread back out in an even layer. Return baking sheet to the oven and continue to roast until veggies are fork-tender, 10-12 minutes more. Remove from oven. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 586106,
      "primary_message": "Meanwhile, pick basil leaves off the stems; discard stems and roughly chop the leaves. Place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 586107,
      "primary_message": "When the veggies are done, remove from the oven. Transfer to the bowl with the basil, along with almonds, and stir to combine the salad.",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 586108,
      "primary_message": "To serve, divide yogurt sauce between plates or bowls, then top with veggies and pork chops. Enjoy!",
      "secondary_message": null
    }
  ],
