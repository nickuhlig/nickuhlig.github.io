  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat water over medium-high heat until just boiling. Add in tamarind concentrate and stir until completely incorporated. Add jaggery, salt, cayenne, cumin, and ginger. Stir until sugar and salt are completely dissolved.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Reduce heat to a simmer and cook until thickened to a point that it's slightly syrupy, about 20 minutes, stirring occasionally. Let cool for 10 minutes. Use immediately or transfer to an airtight container and store in refrigerator for up to 1 month.",
      "secondary_message": null
    }
  ],
