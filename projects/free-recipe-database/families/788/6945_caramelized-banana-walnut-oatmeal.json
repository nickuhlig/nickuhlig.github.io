  "instructions": [
    {
      "id": 95990,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 95991,
      "primary_message": "Roughly chop walnuts and add to the skillet. Toast, stirring often, until fragrant, 2-3 minutes. Set aside to cool.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 95992,
      "primary_message": "Peel and slice the bananas into ¼-inch rounds.",
      "secondary_message": "2 bananas"
    },
    {
      "id": 95993,
      "primary_message": "Add salt and water to a medium saucepan and bring to a boil over high heat. Once boiling, stir in oats, cinnamon, and half of the bananas; reduce heat to medium. Cover and let simmer for 3-5 minutes or until oats reach desired consistency and banana has softened.",
      "secondary_message": "1 pinch salt\n1 ¾ cup water\n1 cup oats, quick cooking\n1 tsp cinnamon"
    },
    {
      "id": 95994,
      "primary_message": "Return the skillet to medium heat and add oil and maple syrup.",
      "secondary_message": "1 tbsp virgin coconut oil\n1 tbsp pure maple syrup"
    },
    {
      "id": 95995,
      "primary_message": "Place the remaining banana slices flat side down in the skillet. Cook until golden brown, 2-3 minutes and then flip and continue cooking for 1-2 more minutes.",
      "secondary_message": null
    },
    {
      "id": 95996,
      "primary_message": "To serve, divide oatmeal between bowls, top with walnuts and bananas, and drizzle with maple syrup. Enjoy!",
      "secondary_message": "1 tbsp pure maple syrup"
    }
  ],
