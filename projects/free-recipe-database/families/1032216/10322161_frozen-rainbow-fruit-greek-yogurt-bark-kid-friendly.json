  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "1 mango\n2 kiwifruit\n1 (170 g) pkg raspberries\n1 (170 g) pkg blueberries"
    },
    {
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; small dice the flesh. Place on a plate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and small dice kiwis. Add to the plate with the mango, along with both berries, and set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Line two large baking sheet pans with parchment paper. Space three ⅓-cup scoops of yogurt out on each baking sheet, then spread the yogurt out in an even circle (about ¼-inch thick). Let each chef decorate their portion of yogurt with choice of fruit, arranging in a rainbow if desired. \n\n",
      "secondary_message": "2 cups vanilla Greek yogurt"
    },
    {
      "primary_message": "Place baking sheets in the freezer and chill until the yogurt is completely frozen, about 2 hours.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove baking sheets from the freezer and break the yogurt bark apart with your hands.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide bark between plates, show off your creations, and enjoy! (Return any leftover bark to the freezer to keep it firm.)",
      "secondary_message": null
    }
  ],
