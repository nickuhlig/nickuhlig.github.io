  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the unsalted butter and bring it to room temperature. Melt the unsalted butter.",
      "secondary_message": "8 tbsp unsalted butter\n1 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Place warm water, yeast, and 1/4 teaspoon sugar together in the bowl of a stand mixer fitted with a paddle attachment. Let stand 5 minutes. Add flour, another 1/4 cup sugar, and salt and mix to combine. Add milk and yolks and beat to combine. Add diced butter to the bowl and beat on medium speed for 5 minutes. Scrape down the sides of the bowl, cover dough with a dish towel, and let rise in a warm place until doubled in volume, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, cover cherries with boiling water. Let stand 6 minutes, then drain, gently patting cherries dry. Dry out bowl and combine cherries, almonds, and remaining 1/4 cup sugar until combined; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Line a baking sheet with parchment paper. Roll dough out onto a lightly floured surface to 12- by 16-inch rectangle. Brush rectangle with butter, leaving a 1-inch border on all sides. Sprinkle dough evenly with cherry-almond filling. Roll dough up, long side first, gently pressing together at the end to seal.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Dip a very sharp knife in flour then cut roll into 12 equal pieces. Place each bun, cut side down, on prepared baking sheet. Cover with a dish towel and let rise in a warm place until almost doubled in size, 45 minutes. Meanwhile, adjust an oven rack to the center position and preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Brush the top of each bun with melted butter and sprinkle with sugar and almonds. Bake until puffed and golden, about 30 minutes. Serve warm.",
      "secondary_message": null
    }
  ],
