  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a medium pot of salted water to a boil. Meanwhile, cut greens from turnip bulbs, leaving a small portion of stem (less than 1/2 inch) attached to each bulb. Wash leafy greens and turnips well of any sand. Peel turnips. (You can also leave the turnip skin on, as it's edible, in which case, just wash and scrub them extra well.) Slice each turnip pole to pole into 4 to 6 wedges of 1/2 inch thick each.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add leafy greens to boiling water and cook just until tender, 1 to 2 minutes. Using tongs or a spider, transfer greens to cold water to chill, then drain, squeeze out excess water, and chop into small pieces.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil in a cast iron, carbon steel, or stainless steel skillet over high heat, just until the first wisps of smoke appear. Add turnip wedges, season with salt and pepper, and cook, stirring and tossing occasionally, until well browned in spots, about 3 minutes; lower heat if turnips threaten to burn.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add chopped greens and toss to combine, cooking just until greens are warmed through, about 1 minute longer. Drizzle with fresh oil, season with salt and pepper, and serve.",
      "secondary_message": null
    }
  ],
