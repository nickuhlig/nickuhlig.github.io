  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Salted Grapefruit Cordial: Bury grapefruit peel in sugar in a pint-sized container. Cover and refrigerate for 24 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "The next day, add grapefruit juice, 1/4 cup lime juice, water, and salt to sugar and stir or shake until sugar is completely dissolved. Remove grapefruit peel and refrigerate cordial, which will last for several weeks.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Cocktail: In a cocktail shaker, combine tequila, 28 g of cordial, 21 g of lime juice, and Campari. Fill shaker with ice, and shake until well chilled, about 15 seconds. Strain into a highball glass filled with ice and top with soda to taste. Garnish with a grapefruit twist if desired.",
      "secondary_message": null
    }
  ],
