  "instructions": [
    {
      "id": 399882,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 399883,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 399884,
      "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 399885,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 399886,
      "primary_message": "While the rice is cooking, place oil and spices in a large bowl; stir to combine the spice paste.",
      "secondary_message": "2 tbsp toasted sesame oil\n½ tsp garlic powder\n½ tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 399887,
      "primary_message": "Medium dice tofu. Add to the bowl with the spice paste, along with the cauliflower, and gently stir to coat. Transfer to the baking sheet and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": "2 (283 g) bags cauliflower florets"
    },
    {
      "id": 399888,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tofu and cauliflower are golden brown, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 399889,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; small dice. Place in the reserved bowl.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 399890,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; add to the bowl with the bell pepper. Set aside.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 399891,
      "primary_message": "When the tofu and cauliflower are done, remove from the oven. Add to the bowl, along with the peanut sauce, and stir to combine.",
      "secondary_message": "1 cup peanut sauce"
    },
    {
      "id": 399892,
      "primary_message": "To serve, divide rice between plates or bowls; top with tofu and veggies. Enjoy!",
      "secondary_message": null
    }
  ],
