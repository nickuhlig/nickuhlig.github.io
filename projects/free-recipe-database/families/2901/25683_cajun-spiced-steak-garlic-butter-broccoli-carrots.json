  "instructions": [
    {
      "id": 410832,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410833,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; sprinkle Cajun seasoning on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 tbsp Cajun seasoning"
    },
    {
      "id": 410834,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and set aside to rest. (Reserve skillet for later use.)",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 410835,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 410836,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium heat; add more butter and swirl to coat the bottom. Add garlic and cook, stirring frequently, until fragrant, about 30 seconds.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 410837,
      "primary_message": "Add broccoli, carrots, and salt to the skillet. Cook, stirring frequently, until veggies are tender, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 ½ (18 oz) bags broccoli florets\n1 ½ (10 oz) bags shredded carrots\n¾ tsp salt"
    },
    {
      "id": 410838,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 410839,
      "primary_message": "To serve, divide steak and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
