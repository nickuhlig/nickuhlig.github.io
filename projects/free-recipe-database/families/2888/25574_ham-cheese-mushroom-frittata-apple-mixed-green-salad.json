  "instructions": [
    {
      "id": 422573,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n2 Granny Smith apples\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 422574,
      "primary_message": "Small dice ham. Place in a medium bowl. ",
      "secondary_message": "16 oz ham steak, boneless"
    },
    {
      "id": 422575,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 422576,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. Add to the bowl with the ham along with the mushrooms.",
      "secondary_message": "2 (8 oz) pkgs sliced white mushrooms"
    },
    {
      "id": 422577,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ham, green onions, and mushrooms; cook, stirring occasionally, until veggies soften, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 422578,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 422579,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 422580,
      "primary_message": "When the veggies are done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 422581,
      "primary_message": "Sprinkle cheese over the frittata. Place in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": "1 cup shredded cheese, Italian blend"
    },
    {
      "id": 422582,
      "primary_message": "Meanwhile, quarter, core, and thinly slice apples.",
      "secondary_message": null
    },
    {
      "id": 422583,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Add mixed greens to the plate, top with apple, and drizzle with vinaigrette. Enjoy!",
      "secondary_message": "¼ cup French vinaigrette"
    }
  ],
