  "instructions": [
    {
      "id": 422584,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n3 Granny Smith apples\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 422585,
      "primary_message": "Small dice ham. Place in a large bowl. ",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 422586,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 422587,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. Add to the bowl with the ham along with the mushrooms.",
      "secondary_message": "3 (8 oz) pkgs sliced white mushrooms"
    },
    {
      "id": 422588,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ham, green onions, and mushrooms; cook, stirring occasionally, until veggies soften, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 422589,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "18 eggs\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 422590,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 422591,
      "primary_message": "When the veggies are done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 422592,
      "primary_message": "Sprinkle cheese over the frittata. Place in the oven and broil until top is set and cheese is melted, 4-5 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 422593,
      "primary_message": "Meanwhile, quarter, core, and thinly slice apples.",
      "secondary_message": null
    },
    {
      "id": 422594,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Add mixed greens to the plate, top with apple, and drizzle with vinaigrette. Enjoy!",
      "secondary_message": "⅓ cup French vinaigrette"
    }
  ],
