  "instructions": [
    {
      "id": 215362,
      "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line a large baking sheet with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 215363,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium spaghetti squash\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n2 limes"
    },
    {
      "id": 215364,
      "primary_message": "Trim off and discard ends of the squashes; halve each squash lengthwise and scrape out the seeds from each half. Rub the inside of the squash with olive oil and season with salt and pepper. Arrange the squash halves cut-side-down on the baking sheet.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 215365,
      "primary_message": "Place the squashes in the oven (it doesn't have to be fully heated) and roast until tender so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 215366,
      "primary_message": "Trim off and discard the ends of the green onions; cut crosswise into ¼-inch pieces at an angle. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 215367,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the green onion.",
      "secondary_message": null
    },
    {
      "id": 215368,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 215369,
      "primary_message": "Peel and mince shallots. Peel and mince garlic. ",
      "secondary_message": "2 shallots\n6 cloves garlic"
    },
    {
      "id": 215370,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom. Add shallots and garlic and cook until lightly golden, 1-2 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 215371,
      "primary_message": "Crack the eggs into a medium bowl and season with salt and pepper; beat with a whisk or fork.",
      "secondary_message": "8 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 215372,
      "primary_message": "Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove skillet from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 215373,
      "primary_message": "Once tender, remove the squash halves from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand). ",
      "secondary_message": null
    },
    {
      "id": 215374,
      "primary_message": "While the squash cools, juice the lime into a small bowl. Add soy sauce, maple syrup, vinegar, oil, and cayenne to bowl with lime juice; whisk to combine the sauce. ",
      "secondary_message": "¼ cup tamari soy sauce\n3 tbsp pure maple syrup\n2 tbsp rice vinegar\n2 tsp extra virgin olive oil\n¼ tsp cayenne pepper"
    },
    {
      "id": 215375,
      "primary_message": "Return skillet to medium-high heat; add spaghetti squash and sauce to the skillet with the egg and cook until heated through, about 2 minutes. Alternatively, reheat spaghetti squash with sauce in one skillet and the egg in another; combine when serving. ",
      "secondary_message": null
    },
    {
      "id": 215376,
      "primary_message": "To serve, divide the pad Thai between plates or bowls and garnish with green onions, cilantro, and peanuts. Enjoy!",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    }
  ],
