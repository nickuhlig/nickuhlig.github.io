  "instructions": [
    {
      "id": 145882,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n2 small bunches cilantro\n2 small bunches fresh dill\n2 small bunches Italian (flat-leaf) parsley\n1 lemon\n4 tomatoes"
    },
    {
      "id": 145883,
      "primary_message": "Trim off the root ends and the dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Cut into ¼ inch thick pieces. ",
      "secondary_message": null
    },
    {
      "id": 145884,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 145885,
      "primary_message": "Peel and mince garlic. Place ⅓ of the garlic in a small bowl and reserve for later. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 145886,
      "primary_message": "Preheat a large overproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 145887,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add leeks, onion, and remaining garlic to the skillet; cook, stirring occasionally, until soft and lightly golden, about 10 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 145888,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 145889,
      "primary_message": "Crack eggs into a large bowl. Add baking powder and spices; whisk thoroughly to combine.",
      "secondary_message": "8 eggs\n2 tsp baking powder\n½ tsp salt\n½ tsp black pepper\n½ tsp turmeric"
    },
    {
      "id": 145890,
      "primary_message": "Shave the leaves off the stems of the cilantro, dill, and parsley; discard the stems and mince the leaves. Transfer to the bowl with the eggs.",
      "secondary_message": null
    },
    {
      "id": 145891,
      "primary_message": "When the leeks are done, transfer them to the bowl with the eggs and stir quickly to combine.",
      "secondary_message": null
    },
    {
      "id": 145892,
      "primary_message": "Return skillet to the stove over medium heat. Add more oil and swirl to coat. Pour the egg mixture into the skillet and smooth out in an even layer. Cook, undisturbed, until the bottom and sides are firm but the top is still runny, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 145893,
      "primary_message": "Meanwhile, zest and juice lemon into the bowl with the garlic. Add yogurt and spices; whisk to combine. ",
      "secondary_message": "1 cup plain Greek yogurt\n½ tsp oregano\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 145894,
      "primary_message": "Place skillet in the oven and cook until top is set and golden brown, 4-5 minutes. Remove from the oven and slice into wedges. ",
      "secondary_message": null
    },
    {
      "id": 145895,
      "primary_message": "Toast flatbreads and cut into wedges. Cut tomatoes into wedges.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 145896,
      "primary_message": "To serve, divide frittata, flatbread, and tomatoes between plates. Drizzle olive oil over tomatoes and season with salt and pepper; enjoy with a side of garlicky yogurt!",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    }
  ],
