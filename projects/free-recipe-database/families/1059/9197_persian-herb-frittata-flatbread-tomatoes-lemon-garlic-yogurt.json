  "instructions": [
    {
      "id": 145867,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 leek\n1 small bunch cilantro\n1 small bunch fresh dill\n1 small bunch Italian (flat-leaf) parsley\n½ lemon\n2 tomatoes"
    },
    {
      "id": 145868,
      "primary_message": "Trim off the root ends and the dark green top of the leek, leaving only the white and pale green parts. Cut the leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Cut into ¼ inch thick pieces. ",
      "secondary_message": null
    },
    {
      "id": 145869,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 145870,
      "primary_message": "Peel and mince garlic. Place ⅓ of the garlic in a small bowl and reserve for later. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 145871,
      "primary_message": "Preheat an overproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 145872,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add leek, onion, and remaining garlic to the skillet; cook, stirring occasionally, until soft and lightly golden, 7-10 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 145873,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 145874,
      "primary_message": "Crack eggs into a medium bowl. Add baking powder and spices; whisk thoroughly to combine.",
      "secondary_message": "4 eggs\n1 tsp baking powder\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp turmeric"
    },
    {
      "id": 145875,
      "primary_message": "Shave the leaves off the stems of the cilantro, dill, and parsley; discard the stems and mince the leaves. Transfer to the bowl with the eggs.",
      "secondary_message": null
    },
    {
      "id": 145876,
      "primary_message": "When the leeks are done, transfer them to the bowl with the eggs and stir quickly to combine.",
      "secondary_message": null
    },
    {
      "id": 145877,
      "primary_message": "Return skillet to the stove over medium heat. Add more oil and swirl to coat. Pour the egg mixture into the skillet and smooth out in an even layer. Cook, undisturbed, until the bottom and sides are firm but the top is still runny, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 145878,
      "primary_message": "Meanwhile, zest and juice lemon into the bowl with the garlic. Add yogurt and spices; whisk to combine. ",
      "secondary_message": "½ cup plain Greek yogurt\n¼ tsp oregano\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 145879,
      "primary_message": "Place skillet in the oven and cook until top is set and golden brown, 3-4 minutes. Remove from the oven and slice into wedges. ",
      "secondary_message": null
    },
    {
      "id": 145880,
      "primary_message": "Toast flatbread and cut into wedges. Cut tomatoes into wedges.",
      "secondary_message": "1 flatbread or naan"
    },
    {
      "id": 145881,
      "primary_message": "To serve, divide frittata, flatbread, and tomatoes between plates. Drizzle olive oil over tomatoes and season with salt and pepper; enjoy with a side of garlicky yogurt!",
      "secondary_message": "½ tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    }
  ],
