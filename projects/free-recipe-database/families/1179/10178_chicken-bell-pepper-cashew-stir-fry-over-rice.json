  "instructions": [
    {
      "id": 162134,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 162135,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 162136,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n6 green bell peppers\n1 ½ small bunches green onions (scallions)"
    },
    {
      "id": 162137,
      "primary_message": "Peel and mince ginger. Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 162138,
      "primary_message": "Place soy sauce, oil, cornstarch, vinegar, and sugar in a small bowl; whisk to combine the sauce.",
      "secondary_message": "¾ cup soy sauce\n3 tbsp toasted sesame oil\n2 tbsp cornstarch\n1 ½ tbsp rice vinegar\n1 ½ tbsp brown sugar"
    },
    {
      "id": 162139,
      "primary_message": "Seed and medium dice bell peppers. ",
      "secondary_message": null
    },
    {
      "id": 162140,
      "primary_message": "Cut chicken thighs into ½-inch pieces.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 162141,
      "primary_message": "Heat a large pot over high heat.",
      "secondary_message": null
    },
    {
      "id": 162142,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 162143,
      "primary_message": "Add chicken and stir-fry for 4-5 minutes. Add ginger, garlic, and bell peppers; continue to cook, stirring often, until veggies begin to soften, 4-5 more minutes.",
      "secondary_message": null
    },
    {
      "id": 162144,
      "primary_message": "Pour sauce into the pot. Reduce heat to medium-high and cook, stirring often, until the sauce thickens, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 162145,
      "primary_message": "Meanwhile, trim green onions on a clean cutting board and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 162146,
      "primary_message": "Add cashews to the pot and stir to combine.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 162147,
      "primary_message": "To serve, divide rice between bowls; top with chicken stir-fry and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
