  "instructions": [
    {
      "id": 162106,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 162107,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 162108,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n2 green bell peppers\n½ small bunch green onions (scallions)"
    },
    {
      "id": 162109,
      "primary_message": "Peel and mince ginger. Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 162110,
      "primary_message": "Place soy sauce, oil, cornstarch, vinegar, and sugar in a small bowl; whisk to combine the sauce.",
      "secondary_message": "¼ cup soy sauce\n1 tbsp toasted sesame oil\n2 tsp cornstarch\n1 ½ tsp rice vinegar\n1 ½ tsp brown sugar"
    },
    {
      "id": 162111,
      "primary_message": "Seed and medium dice bell peppers. ",
      "secondary_message": null
    },
    {
      "id": 162112,
      "primary_message": "Cut chicken thighs into ½-inch pieces.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 162113,
      "primary_message": "Heat a large skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 162114,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 162115,
      "primary_message": "Add chicken and stir-fry for 2-3 minutes. Add ginger, garlic, and bell peppers; continue to cook, stirring often, until veggies begin to soften, 2-3 more minutes.",
      "secondary_message": null
    },
    {
      "id": 162116,
      "primary_message": "Pour sauce into the skillet. Reduce heat to medium-high and cook, stirring often, until the sauce thickens, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 162117,
      "primary_message": "Meanwhile, trim green onions on a clean cutting board and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 162118,
      "primary_message": "Add cashews to the skillet and stir to combine.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 162119,
      "primary_message": "To serve, divide rice between bowls; top with chicken stir-fry and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
