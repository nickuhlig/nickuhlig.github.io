  "instructions": [
    {
      "id": 303407,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 303408,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 303409,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 303410,
      "primary_message": "Break lasagna noodles into thirds. Once the water in the pot is boiling, uncover, add salt and broken noodles, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once done, drain in a colander and set aside.",
      "secondary_message": "12 no-boil lasagna noodles\n1 ½ tsp salt"
    },
    {
      "id": 303411,
      "primary_message": "While the noodles are cooking, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 303412,
      "primary_message": "Trim zucchini; run a peeler along the zucchini to make long, noodle-like strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 303413,
      "primary_message": "Peel and mince garlic; medium dice tomatoes. Add both to the bowl with the zucchini.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 303414,
      "primary_message": "Chop shrimp into small pieces.",
      "secondary_message": null
    },
    {
      "id": 303415,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 303416,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, shrimp, and spices to the skillet; cook, stirring occasionally, until shrimp are opaque and veggies are tender, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 303417,
      "primary_message": "Meanwhile, using a clean cutting board, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 303418,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 303419,
      "primary_message": "When the veggies are done, add lasagna noodles, half of the basil, and cream to the skillet; toss to combine and continue to cook until heated through, about 3 minutes. Remove from heat. (Reserve remaining basil for serving.)",
      "secondary_message": "355 ml heavy whipping cream"
    },
    {
      "id": 303420,
      "primary_message": "Transfer veggie-shrimp mixture to a large baking dish. Top lasagna bake with mozzarella.",
      "secondary_message": null
    },
    {
      "id": 303421,
      "primary_message": "Place baking dish in the oven and bake until the mozzarella is melted and golden, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 303422,
      "primary_message": "To serve, divide lasagna bake between plates or bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
