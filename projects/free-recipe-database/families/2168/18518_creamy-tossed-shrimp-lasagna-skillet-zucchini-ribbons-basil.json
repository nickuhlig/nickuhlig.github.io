  "instructions": [
    {
      "id": 303375,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 303376,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 303377,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 tomato\n½ small pkg fresh basil"
    },
    {
      "id": 303378,
      "primary_message": "Break lasagna noodles into thirds. Once the water in the pan is boiling, uncover, add salt and broken noodles, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once done, drain in a colander and set aside.",
      "secondary_message": "4 no-boil lasagna noodles\n½ tsp salt"
    },
    {
      "id": 303379,
      "primary_message": "While the noodles are cooking, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 303380,
      "primary_message": "Trim zucchini; run a peeler along the zucchini to make long, noodle-like strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 303381,
      "primary_message": "Peel and mince garlic; medium dice tomato. Add both to the bowl with the zucchini.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 303382,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 303383,
      "primary_message": "While the skillet heats up, chop shrimp into small pieces.",
      "secondary_message": null
    },
    {
      "id": 303384,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, shrimp, and spices to the skillet; cook, stirring occasionally, until shrimp are opaque and veggies are tender, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 303385,
      "primary_message": "Meanwhile, using a clean cutting board, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 303386,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 303387,
      "primary_message": "When the veggies are done, add lasagna noodles, half of the basil, and cream to the skillet; toss to combine and continue to cook until heated through, about 2 minutes. Remove from heat. (Reserve remaining basil for serving.)",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 303388,
      "primary_message": "Top lasagna skillet with mozzarella.",
      "secondary_message": null
    },
    {
      "id": 303389,
      "primary_message": "Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 303390,
      "primary_message": "To serve, divide lasagna skillet between plates or bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
