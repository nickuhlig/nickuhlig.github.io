  "instructions": [
    {
      "id": 268974,
      "primary_message": "Preheat oven to 450°F. Coat a baking dish with a thin layer of oil.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 268975,
      "primary_message": "Peel and mince garlic; place in a small bowl along with tomato sauce and Italian seasoning. Stir to combine and set aside.",
      "secondary_message": "1 clove garlic\n1 (8 oz) can tomato sauce\n½ tsp Italian seasoning"
    },
    {
      "id": 268976,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 268977,
      "primary_message": "Place chicken on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Place cutlets in the baking dish and season with salt and pepper on both sides.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 268978,
      "primary_message": "Pour tomato sauce over the chicken, top with prosciutto slices, and sprinkle with cheese.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 268979,
      "primary_message": "Place baking dish in the oven and bake until chicken is cooked through and cheese is golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 268980,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "¼ lb white mushrooms\n½ lemon\n½ green bell pepper\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 268981,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 268982,
      "primary_message": "While the skillet heats up, using a clean cutting board, thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 268983,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add half of the mushrooms (reserving the rest for the salad) and cook, stirring occasionally, until soft and golden, 4-5 minutes. Remove from heat.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 268984,
      "primary_message": "While the mushrooms are cooking, juice lemon into a medium bowl; add oil, mayo, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp avocado oil mayonnaise\n1 tsp white wine vinegar\n½ tsp basil, dried\n¼ tsp oregano, dried\n¼ tsp parsley flakes\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 268985,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the dressing along with the reserved mushrooms.",
      "secondary_message": null
    },
    {
      "id": 268986,
      "primary_message": "Right before serving, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 268987,
      "primary_message": "To serve, divide smothered chicken and salad between plates. Top chicken with sautéed mushrooms and sprinkle with crushed red pepper. Enjoy!",
      "secondary_message": "1 pinch crushed red pepper"
    }
  ],
