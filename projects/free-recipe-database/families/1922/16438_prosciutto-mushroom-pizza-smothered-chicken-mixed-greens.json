  "instructions": [
    {
      "id": 269046,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 269047,
      "primary_message": "Peel and mince garlic; place in a medium bowl along with tomato sauce and Italian seasoning. Stir to combine and set aside.",
      "secondary_message": "3 cloves garlic\n3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning"
    },
    {
      "id": 269048,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 269049,
      "primary_message": "Place chicken on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Place cutlets on the baking sheet and season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 269050,
      "primary_message": "Pour tomato sauce over the chicken, layer with prosciutto slices, and sprinkle with cheese.",
      "secondary_message": "18 slices prosciutto"
    },
    {
      "id": 269051,
      "primary_message": "Place baking sheet in the oven and bake until chicken is cooked through and cheese is golden, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 269052,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "⅓ kg white mushrooms\n1 ½ lemons\n1 ½ green bell peppers\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 269053,
      "primary_message": "Using a clean cutting board, thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 269054,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 269055,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add half of the mushrooms (reserving the rest for the salad) and cook, stirring occasionally, until soft and golden, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 269056,
      "primary_message": "While the mushrooms are cooking, juice lemons into a large bowl; add oil, mayo, vinegar, honey, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp mayonnaise\n1 tbsp white wine vinegar\n1 tbsp honey\n1 ½ tsp basil, dried\n¾ tsp oregano, dried\n¾ tsp parsley flakes\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 269057,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the dressing along with the reserved mushrooms.",
      "secondary_message": null
    },
    {
      "id": 269058,
      "primary_message": "Peel, halve, and thinly slice shallots; add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 269059,
      "primary_message": "Right before serving, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 269060,
      "primary_message": "To serve, divide smothered chicken and salad between plates. Top chicken with sautéed mushrooms and sprinkle with crushed red pepper. Enjoy!",
      "secondary_message": "3 pinch crushed red pepper"
    }
  ],
