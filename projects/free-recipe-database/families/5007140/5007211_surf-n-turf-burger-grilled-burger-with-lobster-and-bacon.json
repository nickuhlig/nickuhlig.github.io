  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the cooked lobster meat into 1/4-inch pieces. Juice the lemon. Finely chop the chives.",
      "secondary_message": "0.23 kg cooked lobster meat\n½ lemon\n1 tbsp chives"
    },
    {
      "id": 1,
      "primary_message": "Combine lobster, mayonnaise, lemon juice, and chives in a small bowl. Season to taste with salt and pepper. Refrigerate until ready to use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "When ready to serve, season burger patties generously with salt and pepper and cook burgers to desired doneness on a hot grill or in a skillet on the stovetop, 52°C for medium rare or 57°C for medium, topping with cheese for last minute of cooking. Let burger patties rest for 5 minutes off heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Top bottom buns with mayonnaise, tomato, and lettuce. Top with burger patty, then divide lobster salad mixture evenly between burgers. Top each burger with 2 slices bacon. Close burgers and serve immediately.",
      "secondary_message": null
    }
  ],
