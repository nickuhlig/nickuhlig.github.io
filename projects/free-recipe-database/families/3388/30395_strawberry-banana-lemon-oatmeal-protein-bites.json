  "instructions": [
    {
      "id": 483649,
      "primary_message": "Preheat oven to 175°C (350°F). Line two baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 483650,
      "primary_message": "Peel bananas, break into chunks, and place in a medium bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "2 bananas"
    },
    {
      "id": 483651,
      "primary_message": "Wash, dry, zest, and juice lemon into the bowl with the banana. Add eggs and maple syrup, then stir to combine.",
      "secondary_message": "1 lemon\n2 eggs\n2 tbsp pure maple syrup"
    },
    {
      "id": 483652,
      "primary_message": "Wash, dry, trim, and roughly chop strawberries. Add to the bowl along with oats, protein powder, and almond flour. Stir once more to combine the batter.",
      "secondary_message": "½ (454 g) pkg strawberries\n2 cup oats, quick cooking\n2 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n¼ cup almond meal/flour"
    },
    {
      "id": 483653,
      "primary_message": "Using a ¼-cup measure, scoop batter onto the baking sheets, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 483654,
      "primary_message": "Allow to cool for a few minutes before transferring to plates. Enjoy!",
      "secondary_message": null
    }
  ],
