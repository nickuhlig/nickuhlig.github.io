  "instructions": [
    {
      "id": 483637,
      "primary_message": "Preheat oven to 350°F. Line two large baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 483638,
      "primary_message": "Peel bananas, break into chunks, and place in a large bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "3 bananas"
    },
    {
      "id": 483639,
      "primary_message": "Wash, dry, zest, and juice lemons into the bowl with the banana. Add eggs and maple syrup, then stir to combine.",
      "secondary_message": "1 ½ lemons\n3 eggs\n3 tbsp pure maple syrup"
    },
    {
      "id": 483640,
      "primary_message": "Wash, dry, trim, and roughly chop strawberries. Add to the bowl along with oats, protein powder, and almond flour. Stir once more to combine the batter.",
      "secondary_message": "1 (16 oz) pkg strawberries\n3 cup oats, quick cooking\n3 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n⅓ cup almond meal/flour"
    },
    {
      "id": 483641,
      "primary_message": "Using a ¼-cup measure, scoop batter onto the baking sheets, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 483642,
      "primary_message": "Allow to cool for a few minutes before transferring to plates. Enjoy!",
      "secondary_message": null
    }
  ],
