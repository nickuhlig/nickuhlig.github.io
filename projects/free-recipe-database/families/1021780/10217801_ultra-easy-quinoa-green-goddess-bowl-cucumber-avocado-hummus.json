  "instructions": [
    {
      "primary_message": "Peel film back to dotted line and place quinoa bowls in microwave. Heat on high until warmed through, about 90 seconds. Carefully remove from microwave and discard film, then set aside to cool slightly.",
      "secondary_message": "2 (119 g) bowl quinoa, cooked"
    },
    {
      "primary_message": "Meanwhile, wash, dry, trim, and slice cucumber crosswise into thin rounds.",
      "secondary_message": "½ English cucumber"
    },
    {
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": "½ avocado"
    },
    {
      "primary_message": "Place contents of the salad kit in a medium bowl, including dressing and topping packets. Toss to combine the salad.",
      "secondary_message": "1 (283 g) pkg green goddess chopped salad kit"
    },
    {
      "primary_message": "To serve, transfer quinoa to serving bowls, then top with salad, cucumber, avocado, and hummus. If desired, drizzle with olive oil, and season with salt and pepper. Enjoy!",
      "secondary_message": "⅔ cup hummus"
    }
  ],
