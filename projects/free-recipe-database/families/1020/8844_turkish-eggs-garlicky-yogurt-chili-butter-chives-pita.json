  "instructions": [
    {
      "id": 317536,
      "primary_message": "Wash and chop chives into small pieces; set aside. ",
      "secondary_message": "½ small pkg chives"
    },
    {
      "id": 317537,
      "primary_message": "Peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 317538,
      "primary_message": "Add yogurt to the bowl with the garlic and whisk to combine; set aside.",
      "secondary_message": "3 cups plain Greek yogurt"
    },
    {
      "id": 317539,
      "primary_message": "Combine butter, crushed red pepper, and paprika in a small saucepan over medium heat. Cook for 1-2 minutes until butter is melted and frothy; watch the butter carefully as it can burn easily. Remove from heat. ",
      "secondary_message": "2 tbsp butter, unsalted\n⅛ tsp crushed red pepper\n½ tsp paprika"
    },
    {
      "id": 317540,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 317541,
      "primary_message": "Toast the pita bread if desired, then slice into wedges. ",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 317542,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Gently crack eggs into the skillet and season with salt. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n4 eggs\n⅛ tsp salt"
    },
    {
      "id": 317543,
      "primary_message": "If necessary, return chili butter to the stove over low heat until melted and bubbly, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 317544,
      "primary_message": "To serve, divide garlicky yogurt between bowls or plates. Place eggs on top of the yogurt, top with chives, and drizzle with warm chili butter just before serving. Enjoy with toasted pita bread for dipping!",
      "secondary_message": null
    }
  ],
