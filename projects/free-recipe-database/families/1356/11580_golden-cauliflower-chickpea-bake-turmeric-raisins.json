  "instructions": [
    {
      "id": 195677,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 195678,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium heads cauliflower\n3 lemons\n2 small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 195679,
      "primary_message": "Trim cauliflower leaves, separate the heads into small florets, and cut stems into smaller pieces. Divide between two baking sheet pans and spread out in an even layer. Drizzle with oil and season with salt.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 195680,
      "primary_message": "Place cauliflower in the oven (it doesn't need to be fully heated) to roast while you prepare the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 195681,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "6 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 195682,
      "primary_message": "Peel, halve, and thinly slice the onions.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 195683,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 195684,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 195685,
      "primary_message": "Add onion, cumin, and turmeric to the skillet. Cook, stirring often, until onion begins to soften, 7-8 minutes.",
      "secondary_message": "1 tbsp cumin\n1 tbsp turmeric"
    },
    {
      "id": 195686,
      "primary_message": "Juice lemons into the skillet and add chickpeas, raisins, water, and salt. Cook, stirring frequently, until the water has evaporated, 7-8 minutes more.",
      "secondary_message": "¾ cup raisins\n⅓ cup water\n¾ tsp salt"
    },
    {
      "id": 195687,
      "primary_message": "Remove cauliflower from the oven, divide chickpea-onion mixture between the baking sheets and toss to combine. Return to the oven and bake until the cauliflower is tender and golden, tossing once, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 195688,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 195689,
      "primary_message": "When the cauliflower is done, add parsley and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 195690,
      "primary_message": "To serve, divide cauliflower-chickpea bake between bowls and enjoy!",
      "secondary_message": null
    }
  ],
