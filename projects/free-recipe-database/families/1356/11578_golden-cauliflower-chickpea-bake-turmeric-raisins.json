  "instructions": [
    {
      "id": 195649,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 195650,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 lemon\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 195651,
      "primary_message": "Trim cauliflower leaves, separate the head into small florets, and cut stems into smaller pieces. Transfer to a baking sheet pan and spread out in an even layer. Drizzle with oil and season with salt.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 195652,
      "primary_message": "Place cauliflower in the oven (it doesn't need to be fully heated) to roast while you prepare the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 195653,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 195654,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 195655,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice the onion.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 195656,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 195657,
      "primary_message": "Add onion, cumin, and turmeric to the skillet. Cook, stirring often, until onion begins to soften, about 5 minutes.",
      "secondary_message": "1 tsp cumin\n1 tsp turmeric"
    },
    {
      "id": 195658,
      "primary_message": "Juice lemon into the skillet and add chickpeas, raisins, water, and salt. Cook, stirring frequently, until the water has evaporated, 5 minutes more.",
      "secondary_message": "¼ cup raisins\n2 tbsp water\n¼ tsp salt"
    },
    {
      "id": 195659,
      "primary_message": "Remove cauliflower from the oven, top with chickpea-onion mixture and toss to combine. Return to the oven and bake until the cauliflower is tender and golden, tossing once, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 195660,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 195661,
      "primary_message": "When the cauliflower is done, add parsley and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 195662,
      "primary_message": "To serve, divide cauliflower-chickpea bake between bowls and enjoy!",
      "secondary_message": null
    }
  ],
