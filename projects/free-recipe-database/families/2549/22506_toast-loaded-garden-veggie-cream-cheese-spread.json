  "instructions": [
    {
      "id": 374782,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 374783,
      "primary_message": "Cut cream cheese into small pieces. Place in a medium bowl and set aside to soften.",
      "secondary_message": "1 (8 oz) block cream cheese"
    },
    {
      "id": 374784,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 red bell pepper\n1 small pkg chives"
    },
    {
      "id": 374785,
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the bowl with the cream cheese.",
      "secondary_message": null
    },
    {
      "id": 374786,
      "primary_message": "Trim, seed, and mince bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 374787,
      "primary_message": "Chop chives into small pieces. Add to the bowl along with the pepper. Using the back of a spoon, mash and combine the veggie cream cheese.",
      "secondary_message": "3 pinch black pepper"
    },
    {
      "id": 374788,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 374789,
      "primary_message": "To serve, divide toast between plates and spread with veggie cream cheese. Enjoy!",
      "secondary_message": null
    }
  ],
