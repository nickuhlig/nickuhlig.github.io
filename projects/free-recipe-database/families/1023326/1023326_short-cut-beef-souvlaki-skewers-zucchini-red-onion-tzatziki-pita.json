  "instructions": [
    {
      "primary_message": "If using wooden skewers, place 6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and trim zucchini, then slice crosswise into 1/2-inch thick rounds. Peel, halve, and large dice onion. Cut steak into bite sized pieces. Thread veggies and steak onto skewers, alternating ingredients. Place on a plate, drizzle with oil, then season with salt and pepper.\n",
      "secondary_message": "2 medium zucchini squash\n1 medium red onion\n12 oz striploin (New York strip) steak\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Preheat a grill pan or outdoor grill over medium-high heat. Once the pan is hot, add skewers and grill, turning occasionally, until beef is cooked through and veggies are tender, about 8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Toast pita bread on the grill pan if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide pita and skewers between plates. Serve with a side of tzatziki and enjoy!",
      "secondary_message": "⅔ cup tzatziki sauce"
    }
  ],
