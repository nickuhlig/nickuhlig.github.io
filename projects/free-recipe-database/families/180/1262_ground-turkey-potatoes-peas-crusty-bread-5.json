  "instructions": [
    {
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "primary_message": "Coat bottom of pan with oil. Add ground turkey and, breaking apart with a spoon, cook until browned and crumbly, 2-3 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n1 ½ lb ground turkey"
    },
    {
      "primary_message": "Add onion and garlic and, stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, peel, and large dice potatoes. Wash and medium dice tomatoes. Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Measure out peas.",
      "secondary_message": "2 medium yellow potatoes\n2 tomatoes\n1 small bunch cilantro\n2 cups frozen peas"
    },
    {
      "primary_message": "Add potatoes, tomatoes, ½ of the cilantro (save the rest for garnishing), frozen peas, tomato sauce, oregano, cumin, and salt; stir well. Reduce heat to medium-low, cover, and cook until potatoes are tender, 15-20 minutes.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n½ tsp salt"
    },
    {
      "primary_message": "Toast bread.",
      "secondary_message": "4 slices gluten-free bread"
    },
    {
      "primary_message": "To serve, place in a bowl and garnish with remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
