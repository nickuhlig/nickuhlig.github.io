  "instructions": [
    {
      "id": 10435,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 10436,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\r\n2 cloves garlic"
    },
    {
      "id": 10437,
      "primary_message": "Coat bottom of pan with oil. Add ground turkey and, breaking apart with a spoon, cook until browned and crumbly, 2-3 minutes.",
      "secondary_message": "about 1 tbsp virgin coconut oil\n0.34 kg ground turkey"
    },
    {
      "id": 10438,
      "primary_message": "Add onion and garlic and, stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 10439,
      "primary_message": "Wash, peel, and large dice potato. Wash and medium dice tomato. Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Measure out peas.",
      "secondary_message": "1 medium yellow potato\r\n1 tomato\r\n½ small bunch cilantro\r\n1 cup frozen peas"
    },
    {
      "id": 10440,
      "primary_message": "Add potato, tomato, ½ of the cilantro (save the rest for garnishing), frozen peas, tomato sauce, oregano, cumin, and salt; stir well. Reduce heat to medium-low, cover, and cook until potato is tender, 15-20 minutes.",
      "secondary_message": "1 (213 ml) can tomato sauce\r\n1 tsp oregano\r\n½ tsp cumin\r\n¼ tsp salt"
    },
    {
      "id": 10441,
      "primary_message": "Toast bread.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 10442,
      "primary_message": "To serve, place in a bowl and garnish with remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
