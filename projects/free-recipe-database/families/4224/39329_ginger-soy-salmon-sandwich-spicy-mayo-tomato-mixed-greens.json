  "instructions": [
    {
      "id": 611083,
      "primary_message": "Preheat oven to 400°F. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 611084,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n1 small bunch cilantro\n3 (1 inch) pieces ginger root\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 611085,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 611086,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl with the green onion. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 611087,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl, along with soy sauce and spices, then whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n½ cup soy sauce\n¾ tsp crushed red pepper\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 611088,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end (or corner) firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin.",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 611089,
      "primary_message": "Pat the salmon dry with paper towels and cut into portions. Add to the bowl, turn to coat, and set aside to marinate, 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 611090,
      "primary_message": "Meanwhile, place mayo and hot sauce in a small bowl. Stir to combine the spicy mayo and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n3 tbsp hot sauce"
    },
    {
      "id": 611091,
      "primary_message": "Place oil, vinegar, honey, salt, and pepper in another large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 611092,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 611093,
      "primary_message": "When the salmon is done marinating, transfer to the baking sheet. Sprinkle with bread crumbs on the top side, pressing gently to adhere.",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 611094,
      "primary_message": "Place baking sheet in the oven and bake until salmon is opaque and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 611095,
      "primary_message": "When the salmon is almost done, add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 611096,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 611097,
      "primary_message": "Spread spicy mayo over the bottom half of each bun, then top with salmon and reserved cilantro. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
