  "instructions": [
    {
      "id": 253696,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n2 medium carrots\n1 pint grape tomatoes\n1 red chili pepper\n1 avocado\n½ small pkg fresh basil"
    },
    {
      "id": 253697,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 253698,
      "primary_message": "Trim and mince green onions; add half to the bowl with the dressing. (Place remaining green onions in a small bowl and set aside for the sauce.)",
      "secondary_message": null
    },
    {
      "id": 253699,
      "primary_message": "Peel, trim, and julienne or coarsely grate the carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 253700,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 253701,
      "primary_message": "Halve chili pepper lengthwise; seed and remove ribs with a spoon. Thinly slice crosswise and add to the bowl. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 253702,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl along with the pumpkin seeds. Gently stir to combine the salad and set aside.",
      "secondary_message": "⅛ cup pumpkin seeds"
    },
    {
      "id": 253703,
      "primary_message": "Drain tuna, place in another medium bowl, and flake with a fork.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 253704,
      "primary_message": "Peel and mince garlic; add to the bowl with the tuna.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 253705,
      "primary_message": "Add egg, bread crumbs, yogurt, and spices to the bowl; stir well to combine the tuna mixture.",
      "secondary_message": "1 egg\n⅓ cup panko bread crumbs\n¼ cup plain Greek yogurt\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 253706,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 253707,
      "primary_message": "Meanwhile, using a ⅓-cup measure, form the tuna mixture into ½-inch thick fritters; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 253708,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters and cook until golden and warmed through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 253709,
      "primary_message": "While the fritters are cooking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add basil, yogurt, salt, and pepper to the bowl with the remaining green onions. Stir to combine the sauce.",
      "secondary_message": "½ cup plain Greek yogurt\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 253710,
      "primary_message": "To serve, divide fritters, salad, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
