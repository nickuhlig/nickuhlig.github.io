  "instructions": [
    {
      "id": 253726,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n6 medium carrots\n3 pints grape tomatoes\n3 red chili peppers\n3 avocados\n1 small pkg fresh basil"
    },
    {
      "id": 253727,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 253728,
      "primary_message": "Trim and mince green onions; add half to the bowl with the dressing. (Place remaining green onions in a medium bowl and set aside for the sauce.)",
      "secondary_message": null
    },
    {
      "id": 253729,
      "primary_message": "Peel, trim, and julienne or coarsely grate the carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 253730,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 253731,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon. Thinly slice crosswise and add to the bowl. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 253732,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl along with the pumpkin seeds. Gently stir to combine the salad and set aside.",
      "secondary_message": "⅓ cup pumpkin seeds"
    },
    {
      "id": 253733,
      "primary_message": "Drain tuna, place in another large bowl, and flake with a fork.",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 253734,
      "primary_message": "Peel and mince garlic; add to the bowl with the tuna.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 253735,
      "primary_message": "Add eggs, bread crumbs, yogurt, and spices to the bowl; stir well to combine the tuna mixture.",
      "secondary_message": "3 eggs\n1 cup panko bread crumbs\n¾ cup plain Greek yogurt\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 253736,
      "primary_message": "Using a ⅓-cup measure, form the tuna mixture into ½-inch thick fritters; place on a platter.",
      "secondary_message": null
    },
    {
      "id": 253737,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 253738,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fritters and cook until golden and warmed through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 253739,
      "primary_message": "While the fritters are cooking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add basil, yogurt, salt, and pepper to the bowl with the remaining green onions. Stir to combine the sauce.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 253740,
      "primary_message": "To serve, divide fritters, salad, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
