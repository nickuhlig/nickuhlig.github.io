  "instructions": [
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "1 ½ cups basmati rice\nsalt"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Place in a medium bowl. ",
      "secondary_message": "3 green bell peppers"
    },
    {
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add half to the bowl with the bell pepper. (Reserve remaining green onion for serving.)",
      "secondary_message": "3 small bunches green onions (scallions)"
    },
    {
      "primary_message": "Small dice ham and add to the bowl with the veggies. ",
      "secondary_message": "680 g ham steak, boneless"
    },
    {
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies, ham, flour, and Cajun seasoning. Cook, stirring occasionally, until veggies start to soften, about 4 minutes. ",
      "secondary_message": "3 tbsp butter, unsalted\n2 tbsp Cajun seasoning"
    },
    {
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "3 (266 g) cans kidney beans"
    },
    {
      "primary_message": "When the veggies are soft, add beans, tomatoes, and salt to the pot. Stir to combine the stew and bring to a boil. Once boiling, reduce heat to low, cover with a lid, and cook until beans are tender and stew has thickened, 8-10 minutes. Remove from heat. ",
      "secondary_message": "3 (411 g) cans diced tomatoes\nsalt"
    },
    {
      "primary_message": "To serve, divide rice and stew between plates or bowls. Sprinkle with reserved green onion and enjoy!",
      "secondary_message": null
    }
  ],
