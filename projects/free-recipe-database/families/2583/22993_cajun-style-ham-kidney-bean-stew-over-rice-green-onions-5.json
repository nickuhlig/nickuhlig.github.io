  "instructions": [
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\nsalt"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell pepper; small dice. Place in a small bowl.",
      "secondary_message": "1 green bell pepper"
    },
    {
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add half to the bowl with the bell pepper. (Reserve remaining green onion for serving.)",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, small dice ham. Add to the bowl with the veggies. ",
      "secondary_message": "227 g ham steak, boneless"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, ham, flour, and Cajun seasoning. Cook, stirring occasionally, until veggies start to soften, about 3 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp all-purpose flour\n2 tsp Cajun seasoning"
    },
    {
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "1 (266 g) can kidney beans"
    },
    {
      "primary_message": "When the veggies are soft, add beans, tomatoes, and salt to the skillet. Stir to combine the stew and bring to a boil. Once boiling, reduce heat to low, cover with a lid, and cook until beans are tender and stew has thickened, 8-10 minutes. Remove from heat. ",
      "secondary_message": "1 (411 g) can diced tomatoes\nsalt"
    },
    {
      "primary_message": "To serve, divide rice and stew between plates or bowls. Sprinkle with reserved green onion and enjoy!",
      "secondary_message": null
    }
  ],
