  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium-high heat. Once hot, coat with nonstick cooking spray and add veggie bacon strips. Cook, turning halfway through, until crisp, about 3 minutes. Remove from heat.",
      "secondary_message": "2 spritz nonstick cooking spray\n8 strip plant-based bacon"
    },
    {
      "primary_message": "Meanwhile, place contents of the salad kit in a medium bowl, including dressing and topping packets. Toss to combine the salad.",
      "secondary_message": "1 (11.57 oz) pkg everything chopped salad kit"
    },
    {
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": "1 avocado"
    },
    {
      "primary_message": "Arrange tortillas on a flat surface, then divide avocado, bacon, and salad between them. Roll tortillas tightly to close and cut in half.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
