  "instructions": [
    {
      "id": 443001,
      "primary_message": "Peel and slice bananas crosswise into thin slices.",
      "secondary_message": "2 bananas"
    },
    {
      "id": 443002,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 443003,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Spread bread with peanut butter, top half with banana slices, then close the sandwiches with the remaining slices.",
      "secondary_message": "4 slices whole grain bread\n¼ cup natural peanut butter"
    },
    {
      "id": 443004,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "1 tsp virgin coconut oil"
    },
    {
      "id": 443005,
      "primary_message": "Remove the sandwiches to a plate and add more oil to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and warmed through, 2-4 minutes more. Transfer to a cutting board and slice in half.",
      "secondary_message": "1 tsp virgin coconut oil"
    },
    {
      "id": 443006,
      "primary_message": "To serve, divide sandwiches between plates and enjoy!",
      "secondary_message": null
    }
  ],
