  "instructions": [
    {
      "id": 462644,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 462645,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n½ small pkg grape tomatoes\n½ lemon\n½ small pkg fresh basil"
    },
    {
      "id": 462646,
      "primary_message": "Once the water in the pan is boiling, add salt and gnocchi; cook, stirring frequently, until cooked through, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "½ tsp salt\n1 (454 g) pkg potato gnocchi"
    },
    {
      "id": 462647,
      "primary_message": "While the gnocchi are cooking, trim and medium dice zucchini. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 462648,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462649,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the zucchini.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 462650,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, capers, and spices. Cook, stirring occasionally, until zucchini and onion soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tbsp capers\n½ tsp salt\n¼ tsp Italian seasoning\n⅛ tsp black pepper"
    },
    {
      "id": 462651,
      "primary_message": "Meanwhile, drain tuna, place in the reserved bowl, and flake with a fork.",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 462652,
      "primary_message": "Halve grape tomatoes and add to the bowl with the tuna.",
      "secondary_message": null
    },
    {
      "id": 462653,
      "primary_message": "When the veggies are soft, juice lemon into the skillet. Add cooked gnocchi, tuna, and tomatoes, then stir to combine. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 462654,
      "primary_message": "Meanwhile, medium dice mozzarella.",
      "secondary_message": "½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 462655,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 462656,
      "primary_message": "Add mozzarella and basil to the skillet with the gnocchi, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 462657,
      "primary_message": "To serve, divide tuna-gnocchi skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
