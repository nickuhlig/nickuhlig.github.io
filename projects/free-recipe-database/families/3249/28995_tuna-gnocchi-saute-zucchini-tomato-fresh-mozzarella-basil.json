  "instructions": [
    {
      "id": 462672,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 462673,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 ½ small pkgs grape tomatoes\n1 ½ lemons\n1 small pkg fresh basil"
    },
    {
      "id": 462674,
      "primary_message": "Once the water in the pot is boiling, add salt and gnocchi; cook, stirring frequently, until cooked through, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "1 ½ tsp salt\n3 (454 g) pkgs potato gnocchi"
    },
    {
      "id": 462675,
      "primary_message": "While the gnocchi are cooking, trim and medium dice zucchini. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 462676,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl with the zucchini.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 462677,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462678,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, capers, and spices. Cook, stirring occasionally, until zucchini and onion soften, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp capers\n1 ½ tsp salt\n¾ tsp Italian seasoning\n½ tsp black pepper"
    },
    {
      "id": 462679,
      "primary_message": "Meanwhile, drain tuna, place in the reserved bowl, and flake with a fork.",
      "secondary_message": "3 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 462680,
      "primary_message": "Halve grape tomatoes and add to the bowl with the tuna.",
      "secondary_message": null
    },
    {
      "id": 462681,
      "primary_message": "When the veggies are soft, juice lemons into the pot. Add cooked gnocchi, tuna, and tomatoes, then stir to combine. Continue to cook, stirring occasionally, until warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 462682,
      "primary_message": "Meanwhile, medium dice mozzarella.",
      "secondary_message": "1 ½ (227 g) pkgs fresh mozzarella cheese"
    },
    {
      "id": 462683,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 462684,
      "primary_message": "Add mozzarella and basil to the pot with the gnocchi, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 462685,
      "primary_message": "To serve, divide tuna-gnocchi sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
