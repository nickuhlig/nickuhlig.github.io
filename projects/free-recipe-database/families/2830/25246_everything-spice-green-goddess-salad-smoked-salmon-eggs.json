  "instructions": [
    {
      "id": 405758,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 405759,
      "primary_message": "Meanwhile, place seeds and spices in a small bowl; stir to combine the \"everything spice\" mixture. Set aside for serving.",
      "secondary_message": "2 tsp sesame seeds\n1 tsp poppy seeds\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 405760,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch fresh dill\n½ small pkg chives\n½ English cucumber\n½ pint grape tomatoes\n1 avocado\n1 head romaine lettuce"
    },
    {
      "id": 405761,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 405762,
      "primary_message": "Shave dill leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 405763,
      "primary_message": "Roughly chop chives. Add to the blender along with yogurt, oil, capers, anchovy fillet, and spices. Blend on high until dressing is smooth; set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 ½ tbsp extra virgin olive oil\n½ tbsp capers\n1 anchovy fillet, packed in oil\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 405764,
      "primary_message": "Trim and large dice cucumber. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 405765,
      "primary_message": "Halve tomatoes lengthwise. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 405766,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and large dice the flesh. Add to the plate. ",
      "secondary_message": null
    },
    {
      "id": 405767,
      "primary_message": "Peel and quarter eggs. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 405768,
      "primary_message": "Chop or tear smoked salmon into bite-sized pieces. Add to the plate.",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 405769,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 405770,
      "primary_message": "Divide lettuce between plates or bowls. Top with cucumber, tomatoes, avocado, eggs, smoked salmon, and additional capers. Sprinkle with everything spice and serve with dressing on the side. Enjoy!",
      "secondary_message": "1 tbsp capers"
    }
  ],
