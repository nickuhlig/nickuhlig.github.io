  "instructions": [
    {
      "id": 405823,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 405824,
      "primary_message": "Meanwhile, place seeds and spices in a small bowl; stir to combine the \"everything spice\" mixture. Set aside for serving.",
      "secondary_message": "2 tbsp sesame seeds\n1 tbsp poppy seeds\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 405825,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch fresh dill\n2 small pkgs chives\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes\n3 avocados\n3 heads romaine lettuce"
    },
    {
      "id": 405826,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 405827,
      "primary_message": "Shave dill leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 405828,
      "primary_message": "Roughly chop chives. Add to the blender along with yogurt, oil, capers, anchovy fillets, and spices. Blend on high until dressing is smooth; set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup extra virgin olive oil\n1 ½ tbsp capers\n3 anchovy fillets, packed in oil\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 405829,
      "primary_message": "Trim and large dice cucumbers. Place on a platter.",
      "secondary_message": null
    },
    {
      "id": 405830,
      "primary_message": "Halve tomatoes lengthwise. Add to the platter with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 405831,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and large dice the flesh. Add to the platter. ",
      "secondary_message": null
    },
    {
      "id": 405832,
      "primary_message": "Peel and quarter eggs. Add to the platter.",
      "secondary_message": null
    },
    {
      "id": 405833,
      "primary_message": "Chop or tear smoked salmon into bite-sized pieces. Add to the platter.",
      "secondary_message": "3 (113 g) pkg smoked salmon"
    },
    {
      "id": 405834,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 405835,
      "primary_message": "Divide lettuce between plates or bowls. Top with cucumber, tomatoes, avocado, eggs, smoked salmon, and additional capers. Sprinkle with everything spice and serve with dressing on the side. Enjoy!",
      "secondary_message": "3 tbsp capers"
    }
  ],
