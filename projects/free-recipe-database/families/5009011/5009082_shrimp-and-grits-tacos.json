  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely grate the cheddar cheese. Peel and devein the shrimp. Chop the white onion. Stem, seed, and chop the serrano chiles. Mince the garlic cloves. Quarter the cherry tomatoes. Roughly chop the fresh cilantro leaves. Warm the corn tortillas. Quarter the limes.",
      "secondary_message": "113 g cheddar cheese\n0.45 kg shrimp, medium\n1 medium white onion\n2 serrano chiles\n2 medium garlic cloves\n0.45 kg cherry tomatoes\n½ cup fresh cilantro leaves\n12 corn tortillas\n2 limes"
    },
    {
      "id": 1,
      "primary_message": "Bring water and milk to a boil in a saucepan over high heat. Whisk in the grits and 2 teaspoons kosher salt. Reduce heat to a bare simmer and cook, stirring every other minute, until grits are creamy, 20 to 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "When grits are done, turn off heat and stir in 2 tablespoons butter and cheddar cheese. Season with lots of black pepper. Cover and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, melt remaining 2 tablespoons butter in a large non-stick skillet over medium heat. When butter stops foaming add shrimp. Cook until pink on the bottom, about 1 minute. Flip and cook until pink on the other side and firm, about 1 minute longer. Season with salt and pepper to taste and transfer to a bowl with a slotted spoon and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add the onion, serranos, and garlic to the skillet and cook, stirring, until onion is translucent, about 3 minutes. Add the tomatoes and cook until they soften, release their juice, and make a thick sauce, about 4 minutes. Add half of the cilantro and season with salt and pepper. Turn off heat and stir the shrimp back in.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Smear some of the grits on a tortilla and top with shrimp and salsa mixture. Garnish with more cilantro. Repeat with remaining tortillas. Serve tacos with lime wedges.",
      "secondary_message": null
    }
  ],
