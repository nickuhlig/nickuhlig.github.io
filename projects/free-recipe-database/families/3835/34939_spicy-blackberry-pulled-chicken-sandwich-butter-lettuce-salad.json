  "instructions": [
    {
      "id": 550971,
      "primary_message": "Place broth, vinegar, Worcestershire, sugar, and spices in a medium saucepan. Stir to combine and bring to a boil over high heat. ",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n1 tbsp apple cider vinegar\n2 tsp Worcestershire sauce\n2 tsp brown sugar\n1 tsp chili powder\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 550972,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n1 medium carrot\n1 (170 g) pkg blackberries\n½ head butter (Boston) lettuce"
    },
    {
      "id": 550973,
      "primary_message": "Once the liquid is boiling, add chicken to the pan and reduce heat to medium-low. Cover and cook until chicken is cooked through, 12-15 minutes.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 550974,
      "primary_message": "While the chicken is cooking, place mayo, vinegar, oil, and spices in a medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "1 tbsp mayonnaise\n1 tsp apple cider vinegar\n1 tsp extra virgin olive oil\n¼ tsp basil, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 550975,
      "primary_message": "Medium dice tomato. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 550976,
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 550977,
      "primary_message": "When the chicken is done, transfer to a plate, leaving the liquid in the pan. ",
      "secondary_message": null
    },
    {
      "id": 550978,
      "primary_message": "Add blackberries and hot sauce to the pan, then mash with a potato masher to create a chunky sauce. Return to medium heat and cook, stirring occasionally, until thickened, 6-8 minutes.",
      "secondary_message": "1 tbsp hot sauce"
    },
    {
      "id": 550979,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 550980,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 550981,
      "primary_message": "Using two forks, shred the chicken into bite-sized pieces. Return to the pan with the reduced sauce, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 550982,
      "primary_message": "Divide buns between plates. Top the bottoms with pulled chicken, then close with the top half of the bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
