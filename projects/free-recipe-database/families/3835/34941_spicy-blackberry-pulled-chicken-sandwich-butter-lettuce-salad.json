  "instructions": [
    {
      "id": 550995,
      "primary_message": "Place broth, vinegar, Worcestershire, sugar, and spices in a large pot. Stir to combine and bring to a boil over high heat. ",
      "secondary_message": "355 ml chicken or vegetable broth\n3 tbsp apple cider vinegar\n2 tbsp Worcestershire sauce\n2 tbsp brown sugar\n1 tbsp chili powder\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 550996,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n3 medium carrots\n3 (170 g) pkgs blackberries\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 550997,
      "primary_message": "Once the liquid is boiling, add chicken to the pot and reduce heat to medium-low. Cover and cook until chicken is cooked through, about 15 minutes.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 550998,
      "primary_message": "While the chicken is cooking, place mayo, vinegar, oil, and spices in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp mayonnaise\n1 tbsp apple cider vinegar\n1 tbsp extra virgin olive oil\n¾ tsp basil, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 550999,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 551000,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 551001,
      "primary_message": "When the chicken is done, transfer to a plate, leaving the liquid in the pot. ",
      "secondary_message": null
    },
    {
      "id": 551002,
      "primary_message": "Add blackberries and hot sauce to the pot, then mash with a potato masher to create a chunky sauce. Return to medium heat and cook, stirring occasionally, until thickened, 8-10 minutes.",
      "secondary_message": "3 tbsp hot sauce"
    },
    {
      "id": 551003,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 551004,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 551005,
      "primary_message": "Using two forks, shred the chicken into bite-sized pieces. Return to the pot with the reduced sauce, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 551006,
      "primary_message": "Divide buns between plates. Top the bottoms with pulled chicken, then close with the top half of the bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
