  "instructions": [
    {
      "id": 448809,
      "primary_message": "Using a strainer, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes. Drain and set aside.",
      "secondary_message": "1 ½ cups green lentils, dried\n36 fl oz (4 ½ cups) chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 448810,
      "primary_message": "While the lentils are cooking, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 fennel bulbs\n1 ½ lemons\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 448811,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Cut fennel in half lengthwise, then slice crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 448812,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the fennel.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 448813,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448814,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add fennel, onion, and salt; cook, stirring occasionally, until soft and starting to brown, 8-10 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 448815,
      "primary_message": "Meanwhile, zest and juice lemons into the reserved bowl. Add yogurt and salt, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "2 cups plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 448816,
      "primary_message": "When the fennel and onion are soft, add veggie ground to the pot. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "24 oz veggie ground, plant based"
    },
    {
      "id": 448817,
      "primary_message": "While the veggie ground is cooking, peel and thinly slice garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 448818,
      "primary_message": "When the veggie ground is done, add lentils, garlic, vinegar, and spices to the pot. Cook, stirring frequently, until warmed through and fragrant, 1-2 minutes.",
      "secondary_message": "1 ½ tbsp red wine vinegar\n1 tbsp paprika\n1 ½ tsp crushed red pepper\n¾ tsp Italian seasoning\n3 pinch nutmeg, ground"
    },
    {
      "id": 448819,
      "primary_message": "Add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Cook, stirring occasionally, until the spinach is tender, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 448820,
      "primary_message": "To serve, divide lemony yogurt and lentil sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
