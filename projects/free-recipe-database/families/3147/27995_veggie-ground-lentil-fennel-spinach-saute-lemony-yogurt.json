  "instructions": [
    {
      "id": 448797,
      "primary_message": "Using a strainer, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes. Drain and set aside.",
      "secondary_message": "1 cup green lentils, dried\n24 fl oz (3 cups) chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 448798,
      "primary_message": "While the lentils are cooking, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 fennel bulbs\n1 lemon\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 448799,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Cut fennel in half lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 448800,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448801,
      "primary_message": "While the skillet heats up, peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the fennel.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 448802,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fennel, onion, and salt; cook, stirring occasionally, until soft and starting to brown, 7-9 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 448803,
      "primary_message": "Meanwhile, zest and juice lemon into the reserved bowl. Add yogurt and salt, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "1 ⅓ cups plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 448804,
      "primary_message": "When the fennel and onion are soft, add veggie ground to the skillet. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "16 oz veggie ground, plant based"
    },
    {
      "id": 448805,
      "primary_message": "While the veggie ground is cooking, peel and thinly slice garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 448806,
      "primary_message": "When the veggie ground is done, add lentils, garlic, vinegar, and spices to the skillet. Cook, stirring frequently, until warmed through and fragrant, about 1 minute.",
      "secondary_message": "1 tbsp red wine vinegar\n2 tsp paprika\n1 tsp crushed red pepper\n½ tsp Italian seasoning\n⅛ tsp nutmeg, ground"
    },
    {
      "id": 448807,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Cook, stirring occasionally, until the spinach is tender, about 30 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 448808,
      "primary_message": "To serve, divide lemony yogurt and lentil sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
