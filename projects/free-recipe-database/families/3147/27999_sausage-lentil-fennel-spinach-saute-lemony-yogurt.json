  "instructions": [
    {
      "id": 448845,
      "primary_message": "Using a strainer, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes. Drain and set aside.",
      "secondary_message": "1 ½ cups green lentils, dried\n1065 ml chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 448846,
      "primary_message": "While the lentils are cooking, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 fennel bulbs\n1 ½ lemons\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 448847,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Cut fennel in half lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 448848,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the fennel.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 448849,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448850,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fennel, onion, and salt; cook, stirring occasionally, until soft and starting to brown, 7-9 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 448851,
      "primary_message": "Meanwhile, zest and juice lemons into the reserved bowl. Add yogurt and salt, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "2 cups plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 448852,
      "primary_message": "When the fennel and onion are soft, add sausage to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "0.68 kg ground pork sausage"
    },
    {
      "id": 448853,
      "primary_message": "While the sausage is cooking, peel and thinly slice garlic. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 448854,
      "primary_message": "When the sausage is done, add cooked lentils, garlic, vinegar, and crushed red pepper to the skillet. Cook, stirring frequently, until warmed through and fragrant, 1-2 minutes.",
      "secondary_message": "1 tbsp red wine vinegar\n¾ tsp crushed red pepper"
    },
    {
      "id": 448855,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Cook, stirring occasionally, until the spinach is tender, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 448856,
      "primary_message": "To serve, divide lemony yogurt and lentil sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
