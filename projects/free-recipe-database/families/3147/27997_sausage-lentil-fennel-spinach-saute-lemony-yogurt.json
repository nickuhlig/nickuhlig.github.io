  "instructions": [
    {
      "id": 448821,
      "primary_message": "Using a strainer, rinse lentils under cold water; drain and transfer to a small saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes. Drain and set aside.",
      "secondary_message": "½ cup green lentils, dried\n355 ml chicken or vegetable broth\n¼ tsp salt"
    },
    {
      "id": 448822,
      "primary_message": "While the lentils are cooking, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 fennel bulb\n½ lemon\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 448823,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Cut fennel in half lengthwise, then slice crosswise into thin half-moons. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 448824,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448825,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the fennel.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 448826,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fennel, onion, and salt; cook, stirring occasionally, until soft and starting to brown, 6-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 448827,
      "primary_message": "Meanwhile, zest and juice lemon into the reserved bowl. Add yogurt and salt, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n¼ tsp salt"
    },
    {
      "id": 448828,
      "primary_message": "When the fennel and onion are soft, add sausage to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "0.23 kg ground pork sausage"
    },
    {
      "id": 448829,
      "primary_message": "While the sausage is cooking, peel and thinly slice garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 448830,
      "primary_message": "When the sausage is done, add cooked lentils, garlic, vinegar, and crushed red pepper to the skillet. Cook, stirring frequently, until warmed through and fragrant, about 1 minute.",
      "secondary_message": "1 tsp red wine vinegar\n¼ tsp crushed red pepper"
    },
    {
      "id": 448831,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Cook, stirring occasionally, until the spinach is tender, about 30 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 448832,
      "primary_message": "To serve, divide lemony yogurt and lentil sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
