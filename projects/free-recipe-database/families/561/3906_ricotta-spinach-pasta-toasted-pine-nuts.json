  "instructions": [
    {
      "id": 43417,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 43418,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces) and transfer to a small bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 43419,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the onion.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 43420,
      "primary_message": "Finely grate 1 cup of Parmesan. Transfer to a small bowl.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 43421,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 43422,
      "primary_message": "When the water in the saucepan comes to a boil, uncover the pan and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions). Once cooked, drain the pasta in a colander, reserving 1 cup of the cooking water.",
      "secondary_message": "2 tbsp salt\n10 oz (about 3 cups) penne pasta"
    },
    {
      "id": 43423,
      "primary_message": "Add the pine nuts to the pan; cook, stirring constantly, until they are golden brown, 3 to 5 minutes. Transfer to a small bowl.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 43424,
      "primary_message": "Once the pine nuts have been transferred, add olive oil to the pan and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 43425,
      "primary_message": "Add the onion and garlic to the pan; cook, stirring frequently, until the onion is softened, 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 43426,
      "primary_message": "Add the spinach to the pan and season the mixture with salt and pepper; cook, tossing frequently, until the spinach is wilted, 1 to 2 minutes.",
      "secondary_message": "2 (5 oz) pkg baby spinach\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 43427,
      "primary_message": "Add the ricotta to the pan and stir until it is thoroughly mixed with the spinach.",
      "secondary_message": "½ (15 oz) pkg (1 cup) ricotta cheese  "
    },
    {
      "id": 43428,
      "primary_message": "Add the pasta, about ½ of the Parmesan, and reserved cooking water to the pan; cook, stirring constantly, until the pasta is well combined, 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 43429,
      "primary_message": "To serve, divide the pasta between bowls, garnish with the remaining Parmesan, and sprinkle with the toasted pine nuts. Enjoy!",
      "secondary_message": null
    }
  ],
