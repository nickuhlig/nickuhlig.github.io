  "instructions": [
    {
      "id": 624132,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 624133,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 624134,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 624135,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Add to the baking sheets with the cauliflower, then drizzle with oil and season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n3 tbsp extra virgin olive oil\n1 tbsp smoked paprika\n1 ½ tsp cumin, ground\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 624136,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 624137,
      "primary_message": "Meanwhile, juice lemons into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 624138,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice, along with mayo, salt, and pepper, then whisk to combine the sauce. Set aside.",
      "secondary_message": "3 cloves garlic\n¾ cup mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 624139,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 624140,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a large bowl.",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 624141,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the pine nuts, along with arugula and cranberries.",
      "secondary_message": "¾ cup dried cranberries"
    },
    {
      "id": 624142,
      "primary_message": "When the cauliflower and chickpeas are done, add both to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 624143,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
