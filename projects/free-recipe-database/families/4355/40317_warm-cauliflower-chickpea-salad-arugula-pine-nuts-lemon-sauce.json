  "instructions": [
    {
      "id": 624072,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 624073,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 624074,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 624075,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Add to the baking sheet with the cauliflower, then drizzle with oil and season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)\n1 tbsp extra virgin olive oil\n1 tsp smoked paprika\n½ tsp cumin, ground\n½ tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 624076,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is golden and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 624077,
      "primary_message": "Meanwhile, juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 624078,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice, along with mayo, salt, and pepper, then whisk to combine the sauce. Set aside.",
      "secondary_message": "1 clove garlic\n¼ cup mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 624079,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 624080,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a medium bowl.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 624081,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the pine nuts, along with arugula and cranberries.",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 624082,
      "primary_message": "When the cauliflower and chickpeas are done, add both to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 624083,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
