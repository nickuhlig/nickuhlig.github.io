  "instructions": [
    {
      "id": 627855,
      "primary_message": "Place sugar and spices in a small bowl. Stir to combine the spice rub.",
      "secondary_message": "2 tsp brown sugar\n1 tsp salt\n½ tsp garlic powder\n½ tsp smoked paprika\n½ tsp black pepper"
    },
    {
      "id": 627856,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 627857,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with the spice rub on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak"
    },
    {
      "id": 627858,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 627859,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 bunch kale\n2 fennel bulbs\n2 Gala apples"
    },
    {
      "id": 627860,
      "primary_message": "Place oil, vinegar, sugar, Dijon, salt, and pepper in a large bowl, then whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp balsamic vinegar\n1 tsp brown sugar\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 627861,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Add to the bowl with the dressing, then using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 627862,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 627863,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 627864,
      "primary_message": "Peel and thinly slice shallot into rings. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 627865,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 627866,
      "primary_message": "Roughly chop apricots. Add to bowl, toss to combine the salad, and set aside.",
      "secondary_message": "8 dried apricots"
    },
    {
      "id": 627867,
      "primary_message": "Thinly slice steak into strips.",
      "secondary_message": null
    },
    {
      "id": 627868,
      "primary_message": "To serve, divide salad and steak between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
