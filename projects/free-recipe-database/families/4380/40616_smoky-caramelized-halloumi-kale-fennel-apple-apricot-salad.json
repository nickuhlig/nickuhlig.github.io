  "instructions": [
    {
      "id": 627909,
      "primary_message": "Place sugar and spices in a large bowl. Stir to combine the spice mix.",
      "secondary_message": "1 tbsp brown sugar\n¾ tsp garlic powder\n¾ tsp smoked paprika\n¾ tsp black pepper"
    },
    {
      "id": 627910,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 627911,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels; holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half lengthwise into 1-inch thick strips. Add to the bowl with the spice mix and turn to coat.",
      "secondary_message": "3 (250 g) pkgs halloumi cheese"
    },
    {
      "id": 627912,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 627913,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ bunches kale\n3 fennel bulbs\n3 Gala apples"
    },
    {
      "id": 627914,
      "primary_message": "Place oil, vinegar, sugar, Dijon, salt, and pepper in a clean large bowl, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 ½ tsp brown sugar\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 627915,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Add to the bowl with the dressing, then, using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 627916,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 627917,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 627918,
      "primary_message": "Peel and thinly slice shallot into rings. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 627919,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 627920,
      "primary_message": "Roughly chop apricots. Add to bowl, toss to combine the salad, and set aside.",
      "secondary_message": "12 dried apricots"
    },
    {
      "id": 627921,
      "primary_message": "To serve, divide salad and halloumi between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
