  "instructions": [
    {
      "id": 500103,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 500104,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small pineapple\n½ avocado\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 500105,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 500106,
      "primary_message": "Place mayo and spices in a medium bowl. Stir to combine.",
      "secondary_message": "1 tbsp mayonnaise\n½ tsp chili powder\n¼ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 500107,
      "primary_message": "Add shrimp to the bowl with the mayo mixture and stir to coat. Add bread crumbs and coconut to the bowl, then gently toss once more to coat. Transfer shrimp to a baking sheet pan and spread out in an even layer; drizzle with oil.",
      "secondary_message": "¼ cup panko bread crumbs\n¼ cup shredded unsweetened coconut\n2 tsp extra virgin olive oil"
    },
    {
      "id": 500108,
      "primary_message": "Place shrimp in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 500109,
      "primary_message": "Meanwhile, juice half of the lime into a clean medium bowl, then add oil, salt, and pepper. Whisk to combine the dressing. (Cut remaining lime into wedges and set aside for serving.) ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 500110,
      "primary_message": "Cut off skin from pineapple; quarter, core, and small dice the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 500111,
      "primary_message": "Peel and mince shallot. Add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 500112,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 500113,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Roughly chop and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 500114,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 500115,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 500116,
      "primary_message": "Divide tortillas between plates, then fill with shrimp and a small portion of salad. Serve with remaining salad and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
