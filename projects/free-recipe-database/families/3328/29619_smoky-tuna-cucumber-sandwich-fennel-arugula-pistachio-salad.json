  "instructions": [
    {
      "id": 472063,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n3 fennel bulbs\n1 ½ (142 g) pkgs baby arugula\n1 ½ English cucumbers"
    },
    {
      "id": 472064,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between one medium and one large bowl (set large bowl aside for the salad). ",
      "secondary_message": null
    },
    {
      "id": 472065,
      "primary_message": "Add yogurt, mayo, Dijon, and spices to the medium bowl with the parsley. Stir to combine the creamy dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 472066,
      "primary_message": "Drain tuna, add to the bowl with the creamy dressing, and flake with a fork. Stir to combine the tuna salad and set aside.",
      "secondary_message": "3 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 472067,
      "primary_message": "Zest and juice lemons into the large bowl with the parsley. Add oil, Dijon, honey, and salt, then whisk to combine the salad dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 472068,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the salad dressing.",
      "secondary_message": null
    },
    {
      "id": 472069,
      "primary_message": "Roughly chop pistachios. Add to the bowl, along with arugula, and toss to combine the salad. Set aside.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 472070,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 472071,
      "primary_message": "Toast bread if desired. Divide tuna salad between half of the slices and spread out in an even layer. Layer with cucumber, close sandwiches with remaining slices of bread, and cut in half.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 472072,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
