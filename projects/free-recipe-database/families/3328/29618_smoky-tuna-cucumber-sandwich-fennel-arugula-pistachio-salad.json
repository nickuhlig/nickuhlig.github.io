  "instructions": [
    {
      "id": 472053,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n2 fennel bulbs\n1 (142 g) pkg baby arugula\n1 English cucumber"
    },
    {
      "id": 472054,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between two medium bowls (set one bowl aside for the salad). ",
      "secondary_message": null
    },
    {
      "id": 472055,
      "primary_message": "Add yogurt, mayo, Dijon, and spices to the remaining bowl with the parsley. Stir to combine the creamy dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n¼ cup mayonnaise\n2 tsp Dijon mustard\n1 tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 472056,
      "primary_message": "Drain tuna, add to the bowl with the creamy dressing, and flake with a fork. Stir to combine the tuna salad and set aside.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 472057,
      "primary_message": "Zest and juice lemon into the second bowl with the parsley. Add oil, Dijon, honey, and salt, then whisk to combine the salad dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt"
    },
    {
      "id": 472058,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the salad dressing.",
      "secondary_message": null
    },
    {
      "id": 472059,
      "primary_message": "Roughly chop pistachios. Add to the bowl, along with arugula, and toss to combine the salad. Set aside.",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 472060,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 472061,
      "primary_message": "Toast bread if desired. Divide tuna salad between half of the slices and spread out in an even layer. Layer with cucumber, close sandwiches with remaining slices of bread, and cut in half.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 472062,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
