  "instructions": [
    {
      "id": 472095,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 472096,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n3 fennel bulbs\n1 ½ (142 g) pkgs baby arugula\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 472097,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between two large bowls (set one bowl aside for the salad). ",
      "secondary_message": null
    },
    {
      "id": 472098,
      "primary_message": "Add yogurt, mayo, Dijon, and spices to the remaining bowl with the parsley. Stir to combine the creamy dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 472099,
      "primary_message": "Crumble tofu with your fingers into the bowl with the creamy dressing; using a fork, mash to combine the tofu salad. Set aside. (Wipe baking sheet dry with paper towels and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 472100,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 472101,
      "primary_message": "Zest and juice lemons into the second bowl with the parsley. Add oil, Dijon, honey, and salt, then whisk to combine the salad dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 472102,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the salad dressing.",
      "secondary_message": null
    },
    {
      "id": 472103,
      "primary_message": "Roughly chop pistachios. Add to the bowl, along with arugula, and toss to combine the salad. Set aside.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 472104,
      "primary_message": "Divide bread between reserved baking sheet and an additional baking sheet. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 472105,
      "primary_message": "Divide toast slices between plates, then layer with tofu salad and sprouts. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
