  "instructions": [
    {
      "id": 471881,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 471882,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ lemon\n1 fennel bulb\n½ (5 oz) pkg baby arugula\n½ (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 471883,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between two medium bowls (set one bowl aside for the salad). ",
      "secondary_message": null
    },
    {
      "id": 471884,
      "primary_message": "Add yogurt, mayo, Dijon, and spices to the remaining bowl with the parsley. Stir to combine the creamy dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 tsp Dijon mustard\n½ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 471885,
      "primary_message": "Crumble tofu with your fingers into the bowl with the creamy dressing; using a fork, mash to combine the tofu salad. Set aside. (Wipe baking sheet dry with paper towels and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 471886,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 471887,
      "primary_message": "Zest and juice lemon into the second bowl with the parsley. Add oil, Dijon, honey, and salt, then whisk to combine the salad dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt"
    },
    {
      "id": 471888,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the salad dressing.",
      "secondary_message": null
    },
    {
      "id": 471889,
      "primary_message": "Roughly chop pistachios. Add to the bowl, along with arugula, and toss to combine the salad. Set aside.",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 471890,
      "primary_message": "Arrange bread on the reserved baking sheet. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 471891,
      "primary_message": "Divide toast slices between plates, then layer with tofu salad and sprouts. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
