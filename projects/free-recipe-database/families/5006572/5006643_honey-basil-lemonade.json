  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine lemon juice, honey, basil leaves, and salt in a blender. Blend on high speed until smooth, about 1 minute. Strain through a fine mesh strainer into a pitcher. Discard solids. Add cold water and whisk to combine. Add ice. Serve in ice-filled glasses garnished with basil leaves.",
      "secondary_message": null
    }
