  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly chop the dark chocolate.",
      "secondary_message": "113 g dark chocolate, about 70%"
    },
    {
      "id": 1,
      "primary_message": "In a medium microwave-safe liquid measuring cup, add chocolate. Microwave on high power in 30-second intervals, stirring with a rubber spatula after each interval, until melted, about 90 seconds. Let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a blender, process cottage cheese, maple syrup, and water until smooth, 30 to 60 seconds, stopping to scrape down sides of blender as needed. With blender running, drizzle in cooled chocolate until just combined, about 15 seconds, stopping to scrape down sides of blender as needed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer chocolate mousse to 2 (227 g) glasses, jars, or ramekins. Cover with plastic wrap. Refrigerate until fully chilled and set, about 2 hours. Serve with whipped cream, berries, shaved chocolate, and flaky sea salt, if desired.",
      "secondary_message": null
    }
  ],
