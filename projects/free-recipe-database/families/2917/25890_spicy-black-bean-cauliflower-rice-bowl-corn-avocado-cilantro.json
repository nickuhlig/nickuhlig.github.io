  "instructions": [
    {
      "id": 412984,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 412985,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small bunch green onions (scallions)\n3 small bunches cilantro\n3 limes\n1 ½ avocados"
    },
    {
      "id": 412986,
      "primary_message": "Cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 412987,
      "primary_message": "Trim and thinly slice green onions crosswise. Add half to the bowl with the cauliflower. (Place remaining onions on a plate and set aside.)",
      "secondary_message": null
    },
    {
      "id": 412988,
      "primary_message": "Add oil and spices to the bowl, then stir to combine. Divide cauliflower rice between two baking sheet pans and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp cumin, ground\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 412989,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until rice is tender and golden, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 412990,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Place half in the reserved bowl. (Add remaining cilantro to the plate with the onions.)",
      "secondary_message": null
    },
    {
      "id": 412991,
      "primary_message": "Juice half of the limes into the bowl with the cilantro. Cut remaining limes into wedges and add to the plate.",
      "secondary_message": null
    },
    {
      "id": 412992,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 412993,
      "primary_message": "While the pot heats up, drain and rinse beans in a colander. ",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 412994,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add beans, corn, and spices; cook, stirring occasionally, until beans and corn are warmed through and spices are fragrant, 5-7 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n6 cups frozen corn\n1 ½ tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 412995,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh. Slice crosswise into thin pieces. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 412996,
      "primary_message": "When the cauliflower is done, remove from the oven. Add lime and cilantro mixture, then stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 412997,
      "primary_message": "Divide cauliflower rice between bowls; top with spicy bean sauté, reserved cilantro, green onions, and avocado. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
