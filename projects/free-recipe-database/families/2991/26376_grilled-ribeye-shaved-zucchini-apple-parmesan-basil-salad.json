  "instructions": [
    {
      "id": 428593,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428594,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 428595,
      "primary_message": "Once the pan is hot, coat with oil; working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 428596,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 Granny Smith apples\n1 small pkg fresh basil"
    },
    {
      "id": 428597,
      "primary_message": "Trim zucchini, then run a vegetable peeler along the length of each zucchini to make ribbons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 428598,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 428599,
      "primary_message": "Pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add to the bowl, along with Parmesan and vinaigrette, then gently toss to combine the salad.",
      "secondary_message": "¾ cup Parmesan cheese, shredded\n⅓ cup French vinaigrette"
    },
    {
      "id": 428600,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 428601,
      "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
