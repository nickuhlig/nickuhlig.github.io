  "instructions": [
    {
      "id": 428611,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428612,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 428613,
      "primary_message": "Once the pan is hot, coat with oil; add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 428614,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n1 small pkg fresh basil\n1 lemon"
    },
    {
      "id": 428615,
      "primary_message": "Trim zucchini, then run a vegetable peeler along the length of each zucchini to make ribbons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 428616,
      "primary_message": "Pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 428617,
      "primary_message": "Juice lemon into the bowl. Drizzle with oil, then sprinkle with Parmesan and spices. Gently toss to combine the salad.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ cup Parmesan cheese, shredded\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 428618,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 428619,
      "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
