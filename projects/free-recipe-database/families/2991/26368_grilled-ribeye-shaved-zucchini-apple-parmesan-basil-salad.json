  "instructions": [
    {
      "id": 428521,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428522,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb ribeye steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 428523,
      "primary_message": "Once the pan is hot, coat with oil; add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 428524,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n1 Granny Smith apple\n½ small pkg fresh basil"
    },
    {
      "id": 428525,
      "primary_message": "Trim zucchini, then run a vegetable peeler along the length of the zucchini to make ribbons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 428526,
      "primary_message": "Quarter, core, and thinly slice apple. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 428527,
      "primary_message": "Pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add to the bowl, along with Parmesan and vinaigrette, then gently toss to combine the salad.",
      "secondary_message": "¼ cup Parmesan cheese, shredded\n2 tbsp French vinaigrette"
    },
    {
      "id": 428528,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 428529,
      "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
