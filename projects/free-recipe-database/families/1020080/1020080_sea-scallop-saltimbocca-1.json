  "instructions": [
    {
      "primary_message": "Heat a 10-inch sauté pan with canola oil over medium-high heat. Allow oil to get hot, shimmering but not smoking. ",
      "secondary_message": null
    },
    {
      "primary_message": "Season Scallops with salt and pepper to taste, then place in the pan (the scallops should sizzle). Once placed down, do not move scallops until ready to flip.",
      "secondary_message": null
    },
    {
      "primary_message": "Sear for 3-4 minutes and flip. Sear another 2-3 minutes, then remove from the pan and reserve warm on dinner plates.",
      "secondary_message": null
    },
    {
      "primary_message": "Add garlic and shallots to pan and cook until fragrant, but not browned. About 30 seconds – 1 minute.",
      "secondary_message": null
    },
    {
      "primary_message": "Add Dijon mustard and allow to cook for 1 minute.",
      "secondary_message": null
    },
    {
      "primary_message": "Add the wine. Bring to a simmer and boil until wine is reduced by half.",
      "secondary_message": null
    },
    {
      "primary_message": "Whisk in soft butter over low heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Add prosciutto, peas, lemon zest, sage, and parsley. Warm throughout without boiling.",
      "secondary_message": null
    },
    {
      "primary_message": "Dress the seared scallops with the sauce, and serve immediately.",
      "secondary_message": null
    },
    {
      "primary_message": "This dish is excellent served with pesto & Parmesan mashed potatoes.",
      "secondary_message": null
    }
  ],
