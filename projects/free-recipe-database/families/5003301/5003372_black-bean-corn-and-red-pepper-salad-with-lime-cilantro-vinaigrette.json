  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Rinse and drain the black beans. Cut off the kernels of the fresh cooked corn the cob. Dice the red bell peppers. Mince the garlic. Mince the shallots. Zest and juice the limes. Chop the fresh cilantro leaves. Chop the avocados.",
      "secondary_message": "2 (425 g) cans black beans\n1 ¾ cups fresh cooked corn\n2 red bell peppers\n2 medium cloves garlic\n2 tbsp shallots, from one medium shallot\n6 limes\n½ cup fresh cilantro leaves, plus more for garnish\n2 Avocados"
    },
    {
      "id": 1,
      "primary_message": "Combine black beans, corn, red peppers, garlic, shallots, and salt in a large bowl and mix well.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a separate small bowl, whisk cayenne, sugar, olive oil, and lime juice together to make vinaigrette.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour vinaigrette over beans, add cilantro, and stir well. Cover and let chill at least 30 minutes and up to over night. Right before serving, add avocados and fold gently, being careful not to mash. Garnish with more chopped cilantro if desired. Serve at room temperature.",
      "secondary_message": null
    }
  ],
