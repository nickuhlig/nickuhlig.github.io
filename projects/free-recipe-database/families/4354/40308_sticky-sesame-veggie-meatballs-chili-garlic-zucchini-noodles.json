  "instructions": [
    {
      "id": 623955,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 623956,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 (2 ½ cm) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 623957,
      "primary_message": "Trim zucchini; use a julienne (or regular) peeler to make noodles. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 623958,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623959,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a medium bowl along with veggie ground, bread crumbs, and spices. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the veggie ground mixture into \"meatballs\" and place on a plate.",
      "secondary_message": "1 clove garlic\n227 g veggie ground, plant based\n¼ cup panko bread crumbs\n1 tsp toasted sesame oil\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 623960,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623961,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 623962,
      "primary_message": "Meanwhile, place water, soy sauce, sesame seeds, maple syrup, vinegar, and cornstarch in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "¼ cup water\n2 tbsp soy sauce\n2 tsp sesame seeds\n2 tsp pure maple syrup\n1 tsp rice vinegar\n1 tsp cornstarch"
    },
    {
      "id": 623963,
      "primary_message": "When the meatballs are done, add sauce to the skillet. Continue to cook, turning meatballs occasionally, until sauce has thickened slightly, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 623964,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a clean small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 623965,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the garlic, along with oil and crushed red pepper. Stir to combine the chili oil.",
      "secondary_message": "1 tbsp toasted sesame oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 623966,
      "primary_message": "When the zucchini is done, drizzle with chili oil and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 623967,
      "primary_message": "To serve, divide zucchini noodles and meatballs between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
