  "instructions": [
    {
      "id": 623786,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 623787,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 623788,
      "primary_message": "Trim zucchini; use a julienne (or regular) peeler to make noodles. Divide between two large baking sheet pans, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623789,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623790,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a large bowl along with pork, bread crumbs, and spices. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the pork mixture into meatballs and place on a plate.",
      "secondary_message": "3 cloves garlic\n2 ¼ lb lean ground pork\n½ cup panko bread crumbs\n¾ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 623791,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623792,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Transfer to a clean plate.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 623793,
      "primary_message": "While the meatballs are cooking, place water, soy sauce, sesame seeds, honey, vinegar, and cornstarch in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "¾ cup water\n⅓ cup soy sauce\n2 tbsp sesame seeds\n2 tbsp honey\n1 tbsp rice vinegar\n1 tbsp cornstarch"
    },
    {
      "id": 623794,
      "primary_message": "When the meatballs are done, return to the skillet. Add sauce and continue to cook, turning meatballs occasionally, until sauce has thickened slightly, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 623795,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a clean small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 623796,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the garlic, along with oil and crushed red pepper. Stir to combine the chili oil.",
      "secondary_message": "3 tbsp toasted sesame oil\n¼ tsp crushed red pepper"
    },
    {
      "id": 623797,
      "primary_message": "When the zucchini is done, drizzle with chili oil and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 623798,
      "primary_message": "To serve, divide zucchini noodles and meatballs between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
