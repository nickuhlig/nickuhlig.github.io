  "instructions": [
    {
      "id": 623929,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 623930,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n2 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 623931,
      "primary_message": "Trim zucchini; use a julienne (or regular) peeler to make noodles. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623932,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623933,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a medium bowl along with pork, bread crumbs, and spices. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the pork mixture into meatballs and place on a plate.",
      "secondary_message": "2 cloves garlic\n0.68 kg lean ground pork\n⅓ cup panko bread crumbs\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 623934,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623935,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 623936,
      "primary_message": "While the meatballs are cooking, place water, soy sauce, sesame seeds, honey, vinegar, and cornstarch in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "½ cup water\n¼ cup soy sauce\n4 tsp sesame seeds\n4 tsp honey\n2 tsp rice vinegar\n2 tsp cornstarch"
    },
    {
      "id": 623937,
      "primary_message": "When the meatballs are done, add sauce to the skillet. Continue to cook, turning meatballs occasionally, until sauce has thickened slightly, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 623938,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a clean small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 623939,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the garlic, along with oil and crushed red pepper. Stir to combine the chili oil.",
      "secondary_message": "2 tbsp toasted sesame oil\n¼ tsp crushed red pepper"
    },
    {
      "id": 623940,
      "primary_message": "When the zucchini is done, drizzle with chili oil and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 623941,
      "primary_message": "To serve, divide zucchini noodles and meatballs between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
