  "instructions": [
    {
      "id": 18809,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "about 7 cups water\n1 tbsp salt\n170 g (1 quarter coin = 57 g) linguine pasta"
    },
    {
      "id": 18810,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 18811,
      "primary_message": "Peel and small dice onion. Peel and mince garlic. Thinly slice sun-dried tomatoes.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic\n6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 18812,
      "primary_message": "Coat bottom of pan with oil. Add onion, garlic, tomatoes, and crushed red pepper. Stirring frequently, cook until onion is softened, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n⅛ tsp crushed red pepper"
    },
    {
      "id": 18813,
      "primary_message": "Wash and dry spinach.",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 18814,
      "primary_message": "Add tomato sauce, basil, salt, and pepper to pan. Stir to combine and simmer for 3-4 minutes.",
      "secondary_message": "1 (213 ml) can tomato sauce\r\n¼ tsp basil\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 18815,
      "primary_message": "Finely grate ⅛ cup of Parmesan.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 18816,
      "primary_message": "Add yogurt to pan, reduce heat to medium-low, and stir to combine.",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 18817,
      "primary_message": "Add spinach and fold in until wilted. Remove pan from heat until pasta is ready.",
      "secondary_message": ""
    },
    {
      "id": 18818,
      "primary_message": "Drain pasta in a colander, reserving about ½ cup of the pasta water.",
      "secondary_message": ""
    },
    {
      "id": 18819,
      "primary_message": "Add pasta and ½ of the water to sauce; toss to coat. If sauce is too thick, add more pasta water to thin it out.",
      "secondary_message": ""
    },
    {
      "id": 18820,
      "primary_message": "Place pasta in a bowl or on a plate and garnish with grated Parmesan.",
      "secondary_message": ""
    }
  ],
