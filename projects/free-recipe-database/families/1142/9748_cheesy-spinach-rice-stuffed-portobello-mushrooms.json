  "instructions": [
    {
      "id": 155754,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 155755,
      "primary_message": "Using a strainer or colander, rinse rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 155756,
      "primary_message": "Once liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook rice until the liquid is fully absorbed, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 155757,
      "primary_message": "Meanwhile, wash and dry mushrooms; remove stems and carefully scrape out gills, making sure not to damage the rim of the mushrooms. Divide between two baking sheets and rub with oil; set aside.",
      "secondary_message": "12 caps portobello mushrooms\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 155758,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 155759,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 155760,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 155761,
      "primary_message": "Add garlic to the pot and cook until fragrant, 15-30 seconds.",
      "secondary_message": null
    },
    {
      "id": 155762,
      "primary_message": "Wash and dry the spinach. (Skip if it came pre-washed.) Add to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 155763,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 155764,
      "primary_message": "Add Parmesan, yogurt, salt, and pepper to the pot and stir to combine; remove from the heat. When the rice is done, add to the pot and stir to combine.",
      "secondary_message": "2 cups plain Greek yogurt\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 155765,
      "primary_message": "Fill mushroom caps with equal portions of the rice mixture. Place in the oven and bake for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 155766,
      "primary_message": "Meanwhile, grate mozzarella.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 155767,
      "primary_message": "Remove baking sheets from oven and top mushrooms with mozzarella. Bake for another 5-7 minutes, until cheese is golden and melted.",
      "secondary_message": null
    },
    {
      "id": 155768,
      "primary_message": "To serve, divide mushrooms between plates. Enjoy!",
      "secondary_message": null
    }
  ],
