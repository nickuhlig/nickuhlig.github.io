  "instructions": [
    {
      "id": 8405,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": ""
    },
    {
      "id": 8406,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n472 ml (2 cups) chicken or vegetable broth"
    },
    {
      "id": 8407,
      "primary_message": "Wash and dry cauliflower and mushrooms. Cut the cauliflower into bite-sized florets and transfer to a sheet pan. Quarter the mushrooms and add to pan.",
      "secondary_message": "2 medium heads cauliflower\n0.227 kg white mushrooms"
    },
    {
      "id": 8408,
      "primary_message": "Drizzle cauliflower and mushrooms with oil and season with thyme, salt, and pepper. Toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n1 tsp thyme\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 8409,
      "primary_message": "Place in the oven and roast, stirring halfway through, until tender, about 20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 8410,
      "primary_message": "In a large bowl, prepare dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "6 tbsp extra virgin olive oil\r\n2 tbsp balsamic vinegar\r\n½ tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 8411,
      "primary_message": "Drain and rinse chickpeas; place on paper towels and pat dry. Add to bowl with dressing and toss to coat.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 8412,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Add to bowl.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 8413,
      "primary_message": "Add almonds to bowl.",
      "secondary_message": "½ cup almonds"
    },
    {
      "id": 8414,
      "primary_message": "Uncover quinoa and fluff with a fork. Add quinoa, cauliflower, and mushrooms to bowl and toss.",
      "secondary_message": ""
    },
    {
      "id": 8415,
      "primary_message": "To serve, place salad on a plate or in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
