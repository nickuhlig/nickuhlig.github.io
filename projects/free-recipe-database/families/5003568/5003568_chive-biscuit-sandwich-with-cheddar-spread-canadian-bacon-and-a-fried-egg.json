  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the unsalted butter into ¼-inch pieces and keep it cold until you use it. Keep the buttermilk cold until you use it. Soften the cream cheese.",
      "secondary_message": "4 oz unsalted butter\n2 cups buttermilk\n4 oz cream cheese"
    },
    {
      "id": 1,
      "primary_message": "For the Chive Biscuits: Adjust oven rack to middle position and preheat oven to 425°F. Line rimmed baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Sift flour, cake flour, baking powder, sugar, salt, baking soda, and pepper twice.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add chilled butter to bowl, and, using two knives, cut into dry ingredients until mixture resembles coarse meal. Stir in chives.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add 1 1/2 cups buttermilk and stir with wooden spoon just till combined. If mixture looks dry, add more buttermilk, 1 tablespoon at a time until dough is cohesive.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Turn dough out onto a lightly floured surface and gently knead just until it comes together, no more than 6 times. Pat dough into a 1-inch thick circle. Use floured biscuit cutter to stamp out the biscuits—don’t twist—and arrange them about 1 inch apart on prepared baking sheet.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Bake until golden, 12 to 15 minutes. Transfer tray to cooling rack.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "For the Cheddar Spread: Meanwhile, in medium bowl, use fork to combine cheddar, cream cheese, mayonnaise, dry mustard, Worcestershire sauce, and hot sauce. Season to taste with salt and pepper. Set aside.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "For the Bacon and Eggs: Melt 2 tablespoons butter in large nonstick skillet over medium-high heat. Cook bacon until browned on both sides, about 2 minutes per side, then transfer to plate and tent with foil.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Add remaining tablespoon butter to skillet. Crack eggs into skillet and season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "When egg whites begin to bubble and turn opaque, add water and cover pan with lid.",
      "secondary_message": null
    },
    {
      "id": 11,
      "primary_message": "Cook eggs 3 to 4 minutes until egg whites are set and egg yolk has a shell-pink color. Continue cooking eggs if you prefer a set yolk.",
      "secondary_message": null
    },
    {
      "id": 12,
      "primary_message": "Using a spatula, divide the six eggs and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 13,
      "primary_message": "To assemble: Cut biscuits in half and spread both halves with cheddar spread. Top bottom halves with 2 slices Canadian bacon, then top with one egg and sandwich with second biscuit half. Serve.",
      "secondary_message": null
    }
  ],
