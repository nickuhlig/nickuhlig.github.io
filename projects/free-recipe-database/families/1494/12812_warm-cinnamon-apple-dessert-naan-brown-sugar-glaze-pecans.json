  "instructions": [
    {
      "id": 216087,
      "primary_message": "Preheat the oven to 450°F and position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 216088,
      "primary_message": "Transfer naan to a baking sheet pan. Place on the upper rack of the oven (it doesn't have to be fully heated) and bake until slightly crispy, about 10 minutes. Remove from oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 216089,
      "primary_message": "Meanwhile, wash and dry apples. Peel, quarter, core, and small dice; transfer to a another baking sheet and spread out in an even layer.",
      "secondary_message": "4 Gala apples"
    },
    {
      "id": 216090,
      "primary_message": "Using a box grater, coarsely grate cold butter. Sprinkle butter, sugar, and cinnamon over the apples.",
      "secondary_message": "2 tbsp butter, unsalted\n2 tbsp brown sugar\n½ tsp cinnamon"
    },
    {
      "id": 216091,
      "primary_message": "Place apples on the lower rack of the oven and bake until fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 216092,
      "primary_message": "Meanwhile, melt additional butter in a medium saucepan over low heat.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 216093,
      "primary_message": "Once butter is melted, whisk in cream, sugar, honey, and salt. Increase heat to medium and simmer, whisking frequently, until glaze is slightly thickened and glossy, about 2 minutes. Remove from heat, and let cool slightly to further thicken the sauce.",
      "secondary_message": "2 fl oz (¼ cup) heavy cream\n¼ cup brown sugar\n2 tbsp honey\n⅛ tsp salt"
    },
    {
      "id": 216094,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 216095,
      "primary_message": "To assemble, spoon baked apples over the surface of each crispy naan. Drizzle with brown sugar glaze and sprinkle with pecans. ",
      "secondary_message": null
    },
    {
      "id": 216096,
      "primary_message": "Cut naan into pieces.",
      "secondary_message": null
    },
    {
      "id": 216097,
      "primary_message": "To serve, divide naan pieces between plates and enjoy!",
      "secondary_message": null
    }
  ],
