  "instructions": [
    {
      "id": 216192,
      "primary_message": "Preheat the oven to 230°C (450°F) and position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 216193,
      "primary_message": "Transfer naan to a large baking sheet pan. Place on the upper rack of the oven (it doesn't have to be fully heated) and bake until slightly crispy, about 10 minutes. Remove from oven.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 216194,
      "primary_message": "Meanwhile, wash and dry apples. Peel, quarter, core, and small dice; transfer to another large baking sheet and spread out in an even layer.",
      "secondary_message": "6 Gala apples"
    },
    {
      "id": 216195,
      "primary_message": "Using a box grater, coarsely grate cold butter. Sprinkle butter, sugar, and cinnamon over the apples.",
      "secondary_message": "3 tbsp butter, unsalted\n3 tbsp brown sugar\n¾ tsp cinnamon"
    },
    {
      "id": 216196,
      "primary_message": "Place apples on the lower rack of the oven and bake until fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 216197,
      "primary_message": "Meanwhile, melt additional butter in a medium saucepan over low heat.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 216198,
      "primary_message": "Once butter is melted, whisk in cream, sugar, honey, and salt. Increase heat to medium and simmer, whisking frequently, until glaze is slightly thickened and glossy, about 3 minutes. Remove from heat, and let cool slightly to further thicken the sauce.",
      "secondary_message": "89 ml (⅜ cup) heavy cream\n⅓ cup brown sugar\n3 tbsp honey\n3 pinch salt"
    },
    {
      "id": 216199,
      "primary_message": "To assemble, spoon baked apples over the surface of each crispy naan. Drizzle with brown sugar glaze. ",
      "secondary_message": null
    },
    {
      "id": 216200,
      "primary_message": "Cut naan into pieces.",
      "secondary_message": null
    },
    {
      "id": 216201,
      "primary_message": "To serve, divide naan pieces between plates and enjoy!",
      "secondary_message": null
    }
  ],
