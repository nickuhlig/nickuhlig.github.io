  "instructions": [
    {
      "primary_message": "Melt butter in small nonstick saucepan over medium heat, stirring frequently, until butter bubbles up then down and has a light brown color. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add browned butter, eggs, olive oil, sugar, vanilla extract and salt to blender and blend for 30 seconds. ",
      "secondary_message": null
    },
    {
      "primary_message": "Whisk flours and baking powder together then add half of the mixture to wet ingredients and blend until smooth, then add the remaining half and blend. Pour in the milk and blend until smooth. ",
      "secondary_message": null
    },
    {
      "primary_message": "Start heating a 9 or 10-inch nonstick skillet or crepe pan over medium heat. Pour 1/4-cup of the batter into the pan and quickly swirl it so that the batter forms a circle about 9-inches wide. When underside is golden brown (about 1 minute), flip the pancake over, add a large cheese slice to one half, sprinkle some green onions over the cheese and cook until underside is brown (about 1 minute more). ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove pancake to a serving plate, top the cheese with a turkey slice then fold one half over the cheese/turkey half then fold again and garnish with preserves. ",
      "secondary_message": null
    },
    {
      "primary_message": "Repeat steps #3 and #4 with remaining batter and toppings. Enjoy immediately or store in the refrigerator and enjoy within a couple of days.",
      "secondary_message": null
    }
  ],
