  "instructions": [
    {
      "id": 50170,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water to the saucepan; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 50171,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n1 (2 ½ cm) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 50172,
      "primary_message": "In a medium salad bowl, combine and whisk together rice vinegar, honey, and crushed red pepper.",
      "secondary_message": "1 tbsp rice vinegar\n1 tsp honey\n⅛ tsp crushed red pepper"
    },
    {
      "id": 50173,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 50174,
      "primary_message": "Trim off and discard the ends of the cucumber; slice the cucumber crosswise into very thin rounds. Add to the salad bowl and toss.",
      "secondary_message": null
    },
    {
      "id": 50175,
      "primary_message": "Peel and grate or mince the ginger. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 50176,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add to the bowl with the ginger.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 50177,
      "primary_message": "To the ginger and garlic, add soy sauce, sesame oil, and honey.",
      "secondary_message": "2 tbsp soy sauce\n½ tsp toasted sesame oil\n1 tsp honey"
    },
    {
      "id": 50178,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 50179,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 50180,
      "primary_message": "Once the skillet is hot, add the ground beef to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes.",
      "secondary_message": "0.34 kg lean ground beef"
    },
    {
      "id": 50181,
      "primary_message": "Add the soy sauce mixture and about ¾ of the green onions (save the rest for garnishing) to the beef; stir to combine and cook for an additional 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 50182,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 50183,
      "primary_message": "To serve, divide the rice, beef, and cucumbers between plates; garnish with the remaining green onions and chili-garlic sauce. Enjoy!",
      "secondary_message": "1 tsp chili-garlic sauce"
    }
  ],
