  "instructions": [
    {
      "id": 78080,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water to the saucepan; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cups water"
    },
    {
      "id": 78079,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n3 (1 inch) pieces ginger root\n1 ½ small bunch green onions (scallions)"
    },
    {
      "id": 78078,
      "primary_message": "In a large salad bowl, combine and whisk together rice vinegar, honey, and crushed red pepper.",
      "secondary_message": "3 tbsp rice vinegar\n3 tsp honey\n⅜ tsp crushed red pepper"
    },
    {
      "id": 78077,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78076,
      "primary_message": "Trim off and discard the ends of the cucumbers; slice the cucumbers crosswise into very thin rounds. Add to the salad bowl and toss.",
      "secondary_message": ""
    },
    {
      "id": 78075,
      "primary_message": "Peel and grate or mince the ginger. Transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 78074,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the ginger.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 78073,
      "primary_message": "To the ginger and garlic, add soy sauce, sesame oil, and honey.",
      "secondary_message": "6 tbsp soy sauce\n1 ½ tsp toasted sesame oil\n3 tsp honey"
    },
    {
      "id": 78072,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 78071,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 78070,
      "primary_message": "Once the skillet is hot, add the ground beef to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef"
    },
    {
      "id": 78069,
      "primary_message": "Add the soy sauce mixture and about ¾ of the green onions (save the rest for garnishing) to the beef; stir to combine and cook for an additional 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78068,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 78067,
      "primary_message": "To serve, divide the rice, beef, and cucumbers between plates; garnish with the remaining green onions and chili-garlic sauce. Enjoy!",
      "secondary_message": "3 tsp chili-garlic sauce"
    }
  ],
