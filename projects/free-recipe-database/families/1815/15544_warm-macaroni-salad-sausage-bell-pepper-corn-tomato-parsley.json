  "instructions": [
    {
      "id": 255848,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "340 g macaroni (elbow) pasta"
    },
    {
      "id": 255849,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 orange bell peppers\n3 small pkgs grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 255850,
      "primary_message": "Place corn in a colander and rinse under hot water (from the tap) to thaw; transfer to a large bowl and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 255851,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255852,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add sausages and cook, turning occasionally until golden brown and almost cooked through, 5-6 minutes. Remove to a plate, leaving the cooking juices in the pot.",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 pork sausages"
    },
    {
      "id": 255853,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onions into half-moons; add to the bowl with the corn.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 255854,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 255855,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 255856,
      "primary_message": "Return pot (with cooking juices) to medium heat; add veggies and Italian seasoning. Stir to combine, then nestle sausages into the veggies; cover and cook until the veggies are charred and sausages are cooked through, 8-10 minutes. Remove from the heat.",
      "secondary_message": "1 tbsp Italian seasoning"
    },
    {
      "id": 255857,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 255858,
      "primary_message": "When the pasta is done, drain in the colander and return to the pot.",
      "secondary_message": null
    },
    {
      "id": 255859,
      "primary_message": "Zest and juice lemons into the pot with the pasta. Add the parsley (reserving a small handful for serving), oil, salt, and pepper; stir to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 255860,
      "primary_message": "Cut sausages crosswise into rounds; add to the pot with the pasta along with charred veggies and any cooking juices. Stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 255861,
      "primary_message": "To serve, divide pasta salad between plates or bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
