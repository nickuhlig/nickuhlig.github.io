  "instructions": [
    {
      "id": 255834,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "227 g macaroni (elbow) pasta"
    },
    {
      "id": 255835,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 orange bell peppers\n2 small pkgs grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 255836,
      "primary_message": "Place corn in a colander and rinse under hot water (from the tap) to thaw; transfer to a medium bowl and set aside.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 255837,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255838,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally until golden brown and almost cooked through, 5-6 minutes. Remove to a plate, leaving the cooking juices in the skillet.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 pork sausages"
    },
    {
      "id": 255839,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onion into half-moons; add to the bowl with the corn.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 255840,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 255841,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 255842,
      "primary_message": "Return skillet (with cooking juices) to medium heat; add veggies and Italian seasoning. Stir to combine, then nestle sausages into the veggies; cover and cook until the veggies are charred and sausages are cooked through, 6-8 minutes. Remove from the heat.",
      "secondary_message": "2 tsp Italian seasoning"
    },
    {
      "id": 255843,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 255844,
      "primary_message": "When the pasta is done, drain in the colander and return to the pot.",
      "secondary_message": null
    },
    {
      "id": 255845,
      "primary_message": "Zest and juice lemon into the pot with the pasta. Add the parsley (reserving a small handful for serving), oil, salt, and pepper; stir to combine.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 255846,
      "primary_message": "Cut sausages crosswise into rounds; add to the pot along with charred veggies and any cooking juices. Stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 255847,
      "primary_message": "To serve, divide pasta salad between plates or bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
