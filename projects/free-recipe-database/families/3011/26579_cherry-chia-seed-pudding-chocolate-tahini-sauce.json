  "instructions": [
    {
      "id": 430553,
      "primary_message": "Roughly chop frozen cherries. Place about ¼ of the chopped cherries in a small bowl or container, cover, and refrigerate until ready to serve. Place remaining cherries in a blender.",
      "secondary_message": "2 cup frozen cherries"
    },
    {
      "id": 430554,
      "primary_message": "Add milk, sugar, maple syrup, vanilla, and cardamom to the blender. Blend on high speed for several minutes until smooth.",
      "secondary_message": "473 ml whole milk\n⅓ cup granulated sugar\n¼ cup pure maple syrup\n1 tsp vanilla extract\n¼ tsp cardamom, ground"
    },
    {
      "id": 430555,
      "primary_message": "Pour the cherry mixture into a medium bowl, add chia seeds, and whisk to combine. Let the mixture rest, whisking occasionally, until chia seeds start to swell, about 15 minutes.",
      "secondary_message": "½ cup chia seeds"
    },
    {
      "id": 430556,
      "primary_message": "Meanwhile, place cocoa powder, maple syrup, water, tahini, vanilla, and salt in a small saucepan. Cook over low heat, whisking constantly, until sauce is combined and thickened, 2-3 minutes. Pour into another small bowl or container, cover, and place in the fridge.",
      "secondary_message": "½ cup cocoa powder\n⅓ cup pure maple syrup\n89 ml (⅜ cup) water\n2 tbsp tahini\n½ tsp vanilla extract\n⅛ tsp salt"
    },
    {
      "id": 430557,
      "primary_message": "When the chia seeds are slightly swollen, whisk the pudding once more to separate any seeds that are clumped together. Cover the bowl with plastic wrap or a lid and refrigerate until set, about 2 hours (or overnight).",
      "secondary_message": null
    },
    {
      "id": 430558,
      "primary_message": "To serve, divide chia seed pudding between small bowls or cups; top with chocolate-tahini sauce and reserved cherries. Enjoy!",
      "secondary_message": null
    }
  ],
