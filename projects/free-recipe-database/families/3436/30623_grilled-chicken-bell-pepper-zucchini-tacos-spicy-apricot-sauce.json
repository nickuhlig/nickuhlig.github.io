  "instructions": [
    {
      "id": 486170,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 apricots\n2 medium zucchini squash\n2 red bell peppers"
    },
    {
      "id": 486171,
      "primary_message": "Halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Small dice the flesh and place in a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 486172,
      "primary_message": "Add sugar, vinegar, soy sauce, salt, and crushed red pepper to the pan with the apricots. Set pan over medium-low heat and cook, stirring occasionally, until apricots are soft and juicy, 10-15 minutes.",
      "secondary_message": "2 tbsp brown sugar\n2 tsp apple cider vinegar\n2 tsp soy sauce\n½ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 486173,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 486174,
      "primary_message": "While the pan heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with spices on both sides.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 486175,
      "primary_message": "Once the pan is hot, coat with oil. Add the chicken and cook until charred and cooked through, 3-4 minutes per side. Transfer to a plate and cover with aluminum foil to keep warm. (Reserve pan for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 486176,
      "primary_message": "While the chicken is cooking, using a clean cutting board, trim and slice zucchini lengthwise into ¼-inch thick planks. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 486177,
      "primary_message": "Trim, seed, and quarter bell peppers; add to the bowl with the zucchini. Drizzle with oil, season with spices, and toss to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 486178,
      "primary_message": "Return pan to medium-high heat. Working in batches if necessary, add veggies and cook, turning occasionally, until charred and fork-tender, about 5 minutes. Add to the plate with the chicken.",
      "secondary_message": null
    },
    {
      "id": 486179,
      "primary_message": "When the apricots are done, remove from heat. Use a potato masher to mash and combine a semi-smooth sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 486180,
      "primary_message": "Transfer grilled chicken and veggies to the cutting board and roughly chop into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 486181,
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 486182,
      "primary_message": "To serve, divide tortillas between plates, fill with grilled chicken and veggies, then top with apricot sauce. Enjoy!",
      "secondary_message": null
    }
  ],
