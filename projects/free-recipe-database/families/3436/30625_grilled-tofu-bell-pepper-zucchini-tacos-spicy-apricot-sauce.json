  "instructions": [
    {
      "id": 486196,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 486197,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 apricots\n1 medium zucchini squash\n1 red bell pepper"
    },
    {
      "id": 486198,
      "primary_message": "Halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Small dice the flesh and place in a small saucepan.",
      "secondary_message": null
    },
    {
      "id": 486199,
      "primary_message": "Add sugar, vinegar, soy sauce, salt, and crushed red pepper to the pan with the apricots. Set pan over medium-low heat and cook, stirring occasionally, until apricots are soft and juicy, 10-15 minutes.",
      "secondary_message": "1 tbsp brown sugar\n1 tbsp apple cider vinegar\n1 tsp soy sauce\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 486200,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 486201,
      "primary_message": "While the pan heats up, slice tofu into 2-inch wide planks. Season with spices on both sides.",
      "secondary_message": "½ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 486202,
      "primary_message": "Once the pan is hot, coat with oil; add the tofu and cook until golden brown, 3-4 minutes per side. Transfer to a plate and cover with aluminum foil to keep warm. (Reserve pan for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 486203,
      "primary_message": "While the tofu is cooking, trim and slice zucchini lengthwise into ¼-inch thick planks. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 486204,
      "primary_message": "Trim, seed, and quarter bell pepper; add to the bowl with the zucchini. Drizzle with oil, season with spices, and toss to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp onion powder\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 486205,
      "primary_message": "Return pan to medium-high heat; add veggies and cook, turning occasionally, until charred and fork-tender, about 5 minutes. Add to the plate with the tofu.",
      "secondary_message": null
    },
    {
      "id": 486206,
      "primary_message": "When the apricots are done, remove from heat. Use a potato masher to mash and combine a semi-smooth sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 486207,
      "primary_message": "Transfer grilled tofu and veggies to the cutting board and roughly chop into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 486208,
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 486209,
      "primary_message": "To serve, divide tortillas between plates, fill with grilled tofu and veggies, then top with apricot sauce. Enjoy!",
      "secondary_message": null
    }
  ],
