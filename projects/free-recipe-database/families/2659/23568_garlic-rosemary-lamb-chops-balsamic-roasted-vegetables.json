  "instructions": [
    {
      "id": 385925,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 385926,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n6 medium carrots\n1 small pkg fresh rosemary"
    },
    {
      "id": 385927,
      "primary_message": "Halve potatoes and divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 385928,
      "primary_message": "Peel, trim, and slice carrots crosswise into ½-inch thick rounds. Add to the baking sheets with the potatoes along with cauliflower.",
      "secondary_message": "3 (283 g) bags cauliflower florets"
    },
    {
      "id": 385929,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Sprinkle half over the veggies, drizzle with vinaigrette, then season with salt and pepper. Toss to coat and spread out in an even layer. (Reserve remaining rosemary for the chops.)",
      "secondary_message": "½ cup balsamic vinaigrette\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 385930,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing veggies halfway through, until golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 385931,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385932,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate. Season both sides with reserved rosemary and spices.",
      "secondary_message": "12 lamb loin chops\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 385933,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, about 3 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 385934,
      "primary_message": "To serve, divide chops and roasted veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
