  "instructions": [
    {
      "id": 385905,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 385906,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg new potatoes\n2 medium carrots\n½ small pkg fresh rosemary"
    },
    {
      "id": 385907,
      "primary_message": "Halve potatoes and transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 385908,
      "primary_message": "Peel, trim, and slice carrots crosswise into ½-inch thick rounds. Add to the baking sheet with the potatoes along with cauliflower.",
      "secondary_message": "1 (283 g) bag cauliflower florets"
    },
    {
      "id": 385909,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Sprinkle half over the veggies, drizzle with vinaigrette, then season with salt and pepper. Toss to coat and spread out in an even layer. (Reserve remaining rosemary for the chops.)",
      "secondary_message": "3 tbsp balsamic vinaigrette\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 385910,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing veggies halfway through, until golden and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 385911,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385912,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate. Season both sides with reserved rosemary and spices.",
      "secondary_message": "4 lamb loin chops\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 385913,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, about 3 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 385914,
      "primary_message": "To serve, divide chops and roasted veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
