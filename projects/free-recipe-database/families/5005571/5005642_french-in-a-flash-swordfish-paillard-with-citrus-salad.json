  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the fennel bulb.",
      "secondary_message": "1 fennel bulb"
    },
    {
      "id": 1,
      "primary_message": "Cut the skin off the fish fillets, and butterfly them. Place each fillet between 2 large sheets of plastic wrap, and pound fish to between 1/4- and 1.5-cm thin with rolling pin. Place fish in baking dish with 1/4 cup olive oil, and season with salt and pepper. Preheat panini press or two-sided grill press to its highest heat setting.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Zest orange and reserve. Segment orange and grapefruit. Wring out juice from what is left of orange and reserve. Toss orange and grapefruit segments with spinach and arugula salad, black olives, and fennel.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk together orange juice and zest, lemon juice, remaining 1/4 cup olive oil, and salt and pepper until emulsified. Toss salad with dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Once grill press is hot, grill fish, one fillet at a time, until fish is opaque, and just beginning to color, about 1 minute. Set aside, and repeat with remaining fish fillets. Cut clove of garlic in half, and while fish is hot, rub each fillet very gently with cut edge of garlic clove. Place fish on large platter and top with salad. Serve immediately.",
      "secondary_message": null
    }
  ],
