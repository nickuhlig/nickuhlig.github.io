  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 350°F. Coat a 9 x 13-inch baking dish with cooking spray. \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place cake mix and orange soda in a medium bowl. Using a hand-held mixer, blend on medium for 2 minutes, scraping down the sides of the bowl as needed. \n\n",
      "secondary_message": "1 (397 g) box white cake mix\n355 ml orange soda"
    },
    {
      "primary_message": "Transfer batter to the baking dish and spread out in an even layer. Place in the preheated oven and bake for 25-30 minutes, until a toothpick inserted in the center comes out clean. Remove from oven and set aside to cool completely, about 1 hour.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the cake is cool, spread frosting evenly over top. Cut into portions, then top each piece with an orange candy. \n\n",
      "secondary_message": "1 (453 g) tub vanilla frosting\n½ cup gummy orange candy"
    },
    {
      "primary_message": "Share and enjoy!",
      "secondary_message": null
    }
  ],
