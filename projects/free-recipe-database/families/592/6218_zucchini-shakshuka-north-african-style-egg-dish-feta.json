  "instructions": [
    {
      "id": 75633,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 75648,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 75632,
      "primary_message": "While the pan heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces).",
      "secondary_message": "1 ½ medium yellow onion"
    },
    {
      "id": 75647,
      "primary_message": "Once the pan is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 75646,
      "primary_message": "Add the onion to the pan; cook, stirring frequently, until slightly softened, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 75645,
      "primary_message": "While the onion cooks, trim off and discard the ends of the zucchini; halve the zucchini lengthwise, then cut the halves crosswise into ¼-inch-thick half-rounds at an angle.",
      "secondary_message": ""
    },
    {
      "id": 75631,
      "primary_message": "Add the zucchini to the pan and season with salt and pepper; cook, stirring occasionally, until softened, 4 to 5 minutes.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 75644,
      "primary_message": "While the zucchini cooks, trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "1 ½ cloves garlic"
    },
    {
      "id": 75643,
      "primary_message": "Add the minced garlic, paprika, and cumin to the pan; cook, stirring, until fragrant, 15 to 30 seconds.",
      "secondary_message": "6 tsp paprika\n3 tsp cumin"
    },
    {
      "id": 75642,
      "primary_message": "Add the tomatoes to the pan and stir to combine; simmer for 5 to 6 minutes.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 75641,
      "primary_message": "While the tomatoes simmer, using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves.",
      "secondary_message": ""
    },
    {
      "id": 75640,
      "primary_message": "Stir about ¾ of the parsley into the tomato mixture (save the rest for garnishing); stir to combine.",
      "secondary_message": ""
    },
    {
      "id": 75639,
      "primary_message": "Break the eggs into the saucepan.",
      "secondary_message": "18 eggs"
    },
    {
      "id": 75638,
      "primary_message": "Season the eggs with salt and pepper.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 75637,
      "primary_message": "Reduce the heat to low and cover the pan; cook until the egg whites are set and the yolks are still runny, 5 to 7 minutes.",
      "secondary_message": ""
    },
    {
      "id": 75636,
      "primary_message": "Place the feta in a small bowl.",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 75635,
      "primary_message": "Uncover the pan and garnish the shakshuka with feta and the remaining parsley.",
      "secondary_message": ""
    },
    {
      "id": 75634,
      "primary_message": "To serve, divide the shakshuka between plates. Enjoy!",
      "secondary_message": ""
    }
  ],
