  "instructions": [
    {
      "id": 59947,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 59940,
      "primary_message": "In a large bowl, mix together tomatoes, tomato sauce, and water. Set aside.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n3 (213 ml) cans tomato sauce\n1 ½ cup water"
    },
    {
      "id": 59939,
      "primary_message": "Add ground beef to the sauté pan and, breaking apart with a spoon, cook until browned and crumbly, 2-3 minutes.",
      "secondary_message": "1.02 kg lean ground beef"
    },
    {
      "id": 59946,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 59945,
      "primary_message": "Add garlic, Italian seasoning, and pepper to pan. Stir for 15-30 seconds.",
      "secondary_message": "3 tsp Italian seasoning\n¾ tsp crushed red pepper"
    },
    {
      "id": 59944,
      "primary_message": "Break lasagna noodles into thirds and arrange over top beef. Pour sauce over top noodles. Cover and bring to a boil. Reduce heat to a simmer and cook until noodles are tender, 8-10 minutes.",
      "secondary_message": "12 no-boil lasagna noodles"
    },
    {
      "id": 59938,
      "primary_message": "Grate 1 ½ cup of mozzarella and ⅓ cup of Parmesan. Measure out 1 ½ cup of ricotta.",
      "secondary_message": "¾ (227 g) block mozzarella cheese\n42 g Parmesan cheese\n¾ (425 g) pkg ricotta cheese"
    },
    {
      "id": 59943,
      "primary_message": "Wash and dry basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons.",
      "secondary_message": "1 ½ small pkg fresh basil"
    },
    {
      "id": 59937,
      "primary_message": "Once noodles are tender, reduce heat to low and uncover. Sprinkle with ½ of the mozzarella; fold into the noodles. Then place spoonfuls of ricotta over top and finish off by sprinkling with remaining mozzarella and Parmesan.",
      "secondary_message": ""
    },
    {
      "id": 59942,
      "primary_message": "Cover and cook until cheese melts, 4-5 minutes. Garnish with basil.",
      "secondary_message": ""
    },
    {
      "id": 59941,
      "primary_message": "To serve, place pasta on a plate or in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
