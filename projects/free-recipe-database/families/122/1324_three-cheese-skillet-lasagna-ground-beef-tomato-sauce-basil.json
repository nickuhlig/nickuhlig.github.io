  "instructions": [
    {
      "id": 11243,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 11244,
      "primary_message": "In a medium bowl, mix together tomatoes, tomato sauce, and water. Set aside.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\r\n1 (8 oz) can tomato sauce\r\n½ cup water"
    },
    {
      "id": 11245,
      "primary_message": "Add ground beef to the sauté pan and, breaking apart with a spoon, cook until browned and crumbly, 2-3 minutes.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 11246,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 11247,
      "primary_message": "Add garlic, Italian seasoning, and pepper to pan. Stir for 15-30 seconds.",
      "secondary_message": "1 tsp Italian seasoning\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 11248,
      "primary_message": "Break lasagna noodles into thirds and arrange over top beef. Pour sauce over top noodles. Cover and bring to a boil. Reduce heat to a simmer and cook until noodles are tender, 8-10 minutes.",
      "secondary_message": "4 no-boil lasagna noodles"
    },
    {
      "id": 11249,
      "primary_message": "Grate ½ cup of mozzarella and ⅛ cup of Parmesan. Measure out ½ cup of ricotta.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese\n½ oz Parmesan cheese\n¼ (15 oz) pkg ricotta cheese"
    },
    {
      "id": 11250,
      "primary_message": "Wash and dry basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 11251,
      "primary_message": "Once noodles are tender, reduce heat to low and uncover. Sprinkle with ½ of the mozzarella and fold into the noodles. Then place spoonfuls of ricotta over top and finish off by sprinkling with remaining mozzarella and Parmesan.",
      "secondary_message": ""
    },
    {
      "id": 11252,
      "primary_message": "Cover and cook until cheese melts, 4-5 minutes. Garnish with basil.",
      "secondary_message": ""
    },
    {
      "id": 11253,
      "primary_message": "To serve, place pasta on a plate or in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
