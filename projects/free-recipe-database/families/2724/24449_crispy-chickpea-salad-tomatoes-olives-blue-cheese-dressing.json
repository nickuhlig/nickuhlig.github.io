  "instructions": [
    {
      "id": 395949,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 395950,
      "primary_message": "Drain and rinse chickpeas. Transfer to a baking sheet pan and pat dry with paper towels. Drizzle with oil and sprinkle with Cajun seasoning. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n1 tbsp Cajun seasoning"
    },
    {
      "id": 395951,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are crisp, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 395952,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n1 small pkg chives\n4 hearts romaine hearts"
    },
    {
      "id": 395953,
      "primary_message": "Halve tomatoes lengthwise. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 395954,
      "primary_message": "Chop chives into small pieces. Add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 395955,
      "primary_message": "Thinly slice olives. Add to the plate.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 395956,
      "primary_message": "Trim the root end from the romaine hearts, then cut each heart into halves and separate leaves. Divide leaves between plates and set aside.",
      "secondary_message": null
    },
    {
      "id": 395957,
      "primary_message": "To serve, top romaine with crispy chickpeas, tomatoes, blue cheese, olives, and chives; drizzle with dressing. Enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese\n½ cup blue cheese dressing"
    }
  ],
