  "instructions": [
    {
      "id": 395989,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 395990,
      "primary_message": "Once the skillet is hot, working in batches, add the prosciutto and cook until crispy, about 1 minute per side. Remove to a large plate and set aside. (Reserve skillet for the steak.)",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 395991,
      "primary_message": "Meanwhile, pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 395992,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Working in batches if necessary, sdd steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 395993,
      "primary_message": "While the steak is cooking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 ½ small pkgs chives\n6 hearts romaine hearts"
    },
    {
      "id": 395994,
      "primary_message": "Halve tomatoes lengthwise. Add to the plate with the prosciutto.",
      "secondary_message": null
    },
    {
      "id": 395995,
      "primary_message": "Chop chives into small pieces. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 395996,
      "primary_message": "Thinly slice olives. Add to the plate and set aside.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 395997,
      "primary_message": "Trim the root ends from the romaine hearts; cut each heart lengthwise into halves, then separate the leaves. Divide between plates and set aside.",
      "secondary_message": null
    },
    {
      "id": 395998,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 395999,
      "primary_message": "To serve, top romaine with steak, tomatoes, olives, and chives; crumble crispy prosciutto over top and drizzle with dressing. Enjoy!",
      "secondary_message": "¾ cup blue cheese dressing"
    }
  ],
