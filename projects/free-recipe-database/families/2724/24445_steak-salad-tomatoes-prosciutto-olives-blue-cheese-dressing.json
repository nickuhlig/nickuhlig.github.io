  "instructions": [
    {
      "id": 395907,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 395908,
      "primary_message": "Once the skillet is hot, add the prosciutto and cook until crispy, about 1 minute per side. Remove to a plate and set aside. (Reserve skillet for the steak.)",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 395909,
      "primary_message": "Meanwhile, pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 395910,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 395911,
      "primary_message": "While the steak is cooking, wash and dry the fresh produce.",
      "secondary_message": "½ pint grape tomatoes\n½ small pkg chives\n2 hearts romaine hearts"
    },
    {
      "id": 395912,
      "primary_message": "Halve tomatoes lengthwise. Add to the plate with the prosciutto.",
      "secondary_message": null
    },
    {
      "id": 395913,
      "primary_message": "Chop chives into small pieces. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 395914,
      "primary_message": "Thinly slice olives. Add to the plate and set aside.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 395915,
      "primary_message": "Trim the root ends from the romaine hearts; cut each heart lengthwise into halves, then separate the leaves. Divide between plates and set aside.",
      "secondary_message": null
    },
    {
      "id": 395916,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 395917,
      "primary_message": "To serve, top romaine with steak, tomatoes, olives, and chives; crumble crispy prosciutto over top and drizzle with dressing. Enjoy!",
      "secondary_message": "¼ cup blue cheese dressing"
    }
  ],
