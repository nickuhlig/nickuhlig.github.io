  "instructions": [
    {
      "id": 385602,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n0.23 kg cremini mushrooms\n1 (2 ½ cm) piece ginger root\n1 avocado\n½ head butter (Boston) lettuce"
    },
    {
      "id": 385603,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp rice vinegar\n¾ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 385604,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 385605,
      "primary_message": "Roughly chop mushrooms. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 385606,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385607,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n227 g veggie ground, plant based"
    },
    {
      "id": 385608,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in another small bowl along with sesame seeds, soy sauce, and additional vinegar. Stir to combine the sauce. ",
      "secondary_message": "1 clove garlic\n1 tbsp sesame seeds\n1 tbsp soy sauce\n1 tsp rice vinegar"
    },
    {
      "id": 385609,
      "primary_message": "When the veggie ground is done, add mushrooms to the skillet. Continue to cook, stirring occasionally, until mushrooms start to brown, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 385610,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 385611,
      "primary_message": "When the mushrooms are done, add sauce to the skillet and stir to combine. Continue to cook until heated through, about 30 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 385612,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with the veggie ground mixture, then top with pickled green onions and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
