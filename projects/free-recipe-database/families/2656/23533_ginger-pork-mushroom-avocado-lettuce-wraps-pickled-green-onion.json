  "instructions": [
    {
      "id": 385569,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n0.23 kg cremini mushrooms\n1 ½ (2 ½ cm) pieces ginger root\n1 avocado\n½ head butter (Boston) lettuce"
    },
    {
      "id": 385570,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp rice vinegar\n¾ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 385571,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 385572,
      "primary_message": "Roughly chop mushrooms. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 385573,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385574,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and salt; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-7 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n⅓ kg lean ground pork\n1 pinch salt"
    },
    {
      "id": 385575,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in another small bowl along with sesame seeds, soy sauce, and additional vinegar. Stir to combine the sauce.",
      "secondary_message": "1 clove garlic\n1 tbsp sesame seeds\n1 tbsp soy sauce\n1 tsp rice vinegar"
    },
    {
      "id": 385576,
      "primary_message": "When the pork is done, add the mushrooms to the skillet. Continue to cook, stirring occasionally, until mushrooms start to brown, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 385577,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 385578,
      "primary_message": "When the mushrooms are done, add sauce to the skillet and stir to combine. Continue to cook until heated through, about 30 seconds. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 385579,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with the pork mixture, then top with pickled green onions and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
