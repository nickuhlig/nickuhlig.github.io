  "instructions": [
    {
      "id": 385459,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches green onions (scallions)\n1 ½ lb cremini mushrooms\n4 (1 inch) pieces ginger root\n3 avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 385460,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup rice vinegar\n1 ½ tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 385461,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 385462,
      "primary_message": "Roughly chop mushrooms. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 385463,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385464,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork and salt; cook, breaking the meat apart with a spoon, until browned and crumbly, 7-8 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 ¼ lb lean ground pork\n¼ tsp salt"
    },
    {
      "id": 385465,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in another small bowl along with sesame seeds, soy sauce, and additional vinegar. Stir to combine the sauce.",
      "secondary_message": "3 cloves garlic\n3 tbsp sesame seeds\n3 tbsp soy sauce\n1 tbsp rice vinegar"
    },
    {
      "id": 385466,
      "primary_message": "When the pork is done, add the mushrooms to the pot. Continue to cook, stirring occasionally, until mushrooms start to brown, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 385467,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 385468,
      "primary_message": "When the mushrooms are done, add sauce to the pot and stir to combine. Continue to cook until heated through, about 1 minute. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 385469,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with the pork mixture, then top with pickled green onions and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
