  "instructions": [
    {
      "id": 385624,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches green onions (scallions)\n0.68 kg cremini mushrooms\n3 (2 ½ cm) pieces ginger root\n3 avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 385625,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup rice vinegar\n1 ½ tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 385626,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 385627,
      "primary_message": "Roughly chop mushrooms. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 385628,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385629,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil\n680 g veggie ground, plant based"
    },
    {
      "id": 385630,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in another small bowl along with sesame seeds, soy sauce, and additional vinegar. Stir to combine the sauce. ",
      "secondary_message": "3 cloves garlic\n3 tbsp sesame seeds\n3 tbsp soy sauce\n1 tbsp rice vinegar"
    },
    {
      "id": 385631,
      "primary_message": "When the veggie ground is done, add mushrooms to the pot. Continue to cook, stirring occasionally, until mushrooms start to brown, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 385632,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 385633,
      "primary_message": "When the mushrooms are done, add sauce to the pot and stir to combine. Continue to cook until heated through, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 385634,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with the veggie ground mixture, then top with pickled green onions and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
