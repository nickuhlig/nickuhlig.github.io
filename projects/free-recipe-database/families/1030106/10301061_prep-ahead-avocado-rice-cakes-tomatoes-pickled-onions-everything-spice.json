  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 (3-compartment) food storage containers as well as 4 mini containers and 4 sandwich bags. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp red wine vinegar\n1 tsp brown sugar\n½ tsp salt"
    },
    {
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to coat, and set aside to pickle for 10 minutes.",
      "secondary_message": "½ medium red onion"
    },
    {
      "primary_message": "Meanwhile, divide rice cakes between sandwich bags (two per bag). Seal bags and store at room temperature.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide everything spice between mini containers, cover with lids, and set aside.",
      "secondary_message": "2 tbsp everything bagel seasoning"
    },
    {
      "primary_message": "Wash, dry, and slice tomatoes crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "primary_message": "When the onions are done pickling, drain and divide among food storage containers, along with sliced tomatoes, everything spice, and guacamole cups (2 cups per container). Cover containers and refrigerate.",
      "secondary_message": "8 (57 g) cup guacamole"
    },
    {
      "primary_message": "When ready to eat, spread guacamole over rice cakes, then top with sliced tomato, pickled onions, and everything spice. Enjoy!",
      "secondary_message": null
    }
  ],
