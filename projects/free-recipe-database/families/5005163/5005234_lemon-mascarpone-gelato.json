  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Keep the mascarpone cheese cold until you use it. Keep the whole milk cold until you use it. Zest and juice the lemon.",
      "secondary_message": "2 cups mascarpone cheese\n1 ½ cups whole milk\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, slowly whisk together all ingredients until well combined. If cheese and milk are not already chilled, chill mixture in refrigerator for 2 to 3 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer mixture to ice cream maker and churn according to manufacturer's instructions. Serve immediately as soft serve or chill in freezer for 4 hours for a firmer texture.",
      "secondary_message": null
    }
