  "instructions": [
    {
      "id": 88964,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n⅜ tsp salt\n710 ml (3 cups) water"
    },
    {
      "id": 88965,
      "primary_message": "Wash oranges and grate 1 ½ tbsp of zest into a medium bowl, then juice oranges into the same bowl. Add water, soy sauce, rice vinegar, maple syrup, chili-garlic sauce, and cornstarch to bowl and whisk together.",
      "secondary_message": "3 oranges\n1 ½ tbsp warm water\n6 tbsp soy sauce\n3 tbsp rice vinegar\n3 tbsp maple syrup\n¾ tsp chili-garlic sauce\n1 ½ tbsp cornstarch"
    },
    {
      "id": 88966,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 88967,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 88968,
      "primary_message": "Drain tofu and pat dry with paper towels. Medium dice.",
      "secondary_message": "3 (340 g) pkg extra firm tofu"
    },
    {
      "id": 88969,
      "primary_message": "Coat bottom of skillet with oil. Add tofu and cook, stirring occasionally, until golden brown, 7-9 minutes. Transfer to a plate.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 88970,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 88971,
      "primary_message": "Wash broccoli. Separate into bite-sized florets and cut stem into smaller pieces.",
      "secondary_message": "6 medium crowns broccoli"
    },
    {
      "id": 88972,
      "primary_message": "Once tofu has been transferred, coat skillet with more oil. Add garlic and broccoli. Cook, stirring occasionally, until tender-crisp and bright green, 3-4 minutes.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 88973,
      "primary_message": "Return tofu to skillet and pour in sauce. Stir to coat until sauce thickens, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 88974,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 88975,
      "primary_message": "Serve broccoli and tofu over top rice and enjoy!",
      "secondary_message": ""
    }
  ],
