  "instructions": [
    {
      "id": 78520,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water to the saucepan; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cups water"
    },
    {
      "id": 78519,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 green bell peppers\n3 (2 ½ cm) pieces ginger root\n1 ½ small bunch green onions (scallions)"
    },
    {
      "id": 78518,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stems, seeds, and membranes. Large dice the sections (cut into 2-cm cubes) and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 78517,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78516,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 78515,
      "primary_message": "While the skillet heats up, drain and large dice the tofu (cut into 2-cm cubes); place the cubes on paper towels or a clean towel and pat dry.",
      "secondary_message": "3 (340 g) pkg extra firm tofu"
    },
    {
      "id": 78514,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 78513,
      "primary_message": "Add the tofu to the skillet; cook, stirring occasionally, until golden brown, 6 to 8 minutes. Once done, transfer the tofu to a plate or bowl.",
      "secondary_message": ""
    },
    {
      "id": 78512,
      "primary_message": "While the tofu cooks, peel and grate or mince the ginger; transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 78511,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the ginger.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 78510,
      "primary_message": "Once the tofu has been transferred, add more coconut oil to the skillet followed by the bell peppers, ginger, and garlic. Stir-fry the peppers until they begin to soften, 2 to 4 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 78509,
      "primary_message": "While the peppers cook, trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle and transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 78506,
      "primary_message": "In a small bowl, whisk together cornstarch with 2 tbsp of water, then add soy sauce, sesame oil, and maple syrup and whisk again.",
      "secondary_message": "3 tsp cornstarch\n9 tbsp soy sauce\n1 ½ tbsp toasted sesame oil\n1 ½ tbsp pure maple syrup"
    },
    {
      "id": 78508,
      "primary_message": "Return the tofu to the skillet, add ½ of the green onions (save the rest for garnishing), and pour the sauce over top. Stir-fry until the vegetables and tofu are coated in the sauce and the sauce has thickened, 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78507,
      "primary_message": "To serve, place the rice into a bowl, top with the stir fry, and garnish with the remaining green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
