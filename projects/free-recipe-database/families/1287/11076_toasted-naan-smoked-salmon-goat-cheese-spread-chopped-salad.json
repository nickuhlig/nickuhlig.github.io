  "instructions": [
    {
      "id": 184136,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 184137,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch fresh dill\n1 small bunch green onions (scallions)\n1 ½ English cucumbers\n1 ½ bunches radish\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 184138,
      "primary_message": "Zest lemons into a medium bowl, then juice them into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 184139,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add half of the dill to each bowl.",
      "secondary_message": null
    },
    {
      "id": 184140,
      "primary_message": "Chop salmon into ¼-inch pieces and add to the medium bowl with the lemon zest.",
      "secondary_message": "1 ½ (113 g) pkg smoked salmon"
    },
    {
      "id": 184141,
      "primary_message": "Crumble goat cheese into the bowl with the salmon. Add yogurt and crushed red pepper; mash with a fork to combine the spread and set aside.",
      "secondary_message": "1 ½ (113 g) logs goat cheese\n¾ cup plain Greek yogurt\n3 pinch crushed red pepper"
    },
    {
      "id": 184142,
      "primary_message": "Divide naan between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until crispy, 10-12 minutes. Remove from the oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 184143,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the large bowl with the lemon juice, along with oil, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 184144,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 184145,
      "primary_message": "Trim and medium dice the cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184146,
      "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184147,
      "primary_message": "Halve tomatoes and add to the bowl. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 184148,
      "primary_message": "Divide salmon-goat cheese spread between toasted naan and smooth out in an even layer. Cut into quarters.",
      "secondary_message": null
    },
    {
      "id": 184149,
      "primary_message": "To serve, divide naan and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
