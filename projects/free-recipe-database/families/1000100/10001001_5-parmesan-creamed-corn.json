  "instructions": [
    {
      "primary_message": "Preheat a medium saucepan over medium heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the pan heats up, peel, halve, and small dice onion.  ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 4-5 minutes.  ",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "primary_message": "Add flour and cook, stirring frequently, for 1 minute.  ",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "primary_message": "Add corn, milk, cream, salt, and pepper to the pan. Stir to combine and bring to a simmer over medium-high heat.  ",
      "secondary_message": "3 cups frozen corn\n473 ml whole milk\n118 ml heavy whipping cream\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Once simmering, reduce heat to low and continue to cook, stirring occasionally, until thickened, 4-5 minutes.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove corn from the heat, then add Parmesan and paprika. Purée half of the mixture with an immersion (or regular) blender.  ",
      "secondary_message": "½ cup Parmesan cheese, shredded\n¾ tsp paprika"
    },
    {
      "primary_message": "Transfer creamed corn to a serving dish and serve.",
      "secondary_message": null
    }
  ],
