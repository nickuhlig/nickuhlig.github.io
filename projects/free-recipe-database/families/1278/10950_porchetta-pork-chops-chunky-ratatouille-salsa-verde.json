  "instructions": [
    {
      "id": 180338,
      "primary_message": "Preheat oven to 220°C (425°F). Line a large baking sheet pan with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 180339,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 small pkgs fresh basil\n3 eggplants\n3 medium zucchini squash\n3 red bell peppers\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 180340,
      "primary_message": "Grate zest from the lemons. Peel and mince garlic. Place both in a medium bowl along with oil, vinegar, and spices.",
      "secondary_message": "6 cloves garlic\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 ½ tsp rosemary\n1 ½ tsp sage\n1 ½ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 180341,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add to the bowl and whisk to combine the salsa verde.",
      "secondary_message": null
    },
    {
      "id": 180342,
      "primary_message": "Place pork chops on the baking sheet and rub with ¾ of the salsa verde, coating both sides (reserve remaining salsa for serving). Place in the oven and bake until golden brown and cooked through, 12-15 minutes. Remove from the oven and loosely cover with foil.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 180343,
      "primary_message": "Meanwhile, trim eggplants and cut into ¾-inch pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 180344,
      "primary_message": "Trim zucchini, quarter lengthwise, and slice crosswise into ¾-inch pieces. Add to the bowl with the eggplant. ",
      "secondary_message": null
    },
    {
      "id": 180345,
      "primary_message": "Trim, seed, and cut bell peppers into ¾-inch pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 180346,
      "primary_message": "Peel and mince onion. Halve tomatoes. Add both to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 180347,
      "primary_message": "Heat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 180348,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 180349,
      "primary_message": "Add veggies, capers, salt, and pepper to the skillet. Juice lemons into the skillet, stir, cover, and bring to a simmer. Cook, stirring often, until veggies are tender, about 15 minutes.",
      "secondary_message": "1 ½ tbsp capers\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 180350,
      "primary_message": "Slice pork into strips.",
      "secondary_message": null
    },
    {
      "id": 180351,
      "primary_message": "To serve, divide ratatouille and pork chops between plates. Top with remaining salsa verde and enjoy!",
      "secondary_message": null
    }
  ],
