  "instructions": [
    {
      "id": 180282,
      "primary_message": "Preheat oven to 425°F. Line a baking sheet pan with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 180283,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 small pkgs fresh basil\n2 eggplants\n2 medium zucchini squash\n2 red bell peppers\n1 pint grape tomatoes"
    },
    {
      "id": 180284,
      "primary_message": "Grate zest from the lemons. Peel and mince garlic. Place both in a medium bowl along with oil, vinegar, and spices.",
      "secondary_message": "4 cloves garlic\n¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n1 tsp rosemary\n1 tsp sage\n1 tsp salt\n½ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 180285,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add to the bowl and whisk to combine the salsa verde.",
      "secondary_message": null
    },
    {
      "id": 180286,
      "primary_message": "Place pork chops on the baking sheet and rub with ¾ of the salsa verde, coating both sides (reserve remaining salsa for serving). Place in the oven and bake until golden brown and cooked through, 12-15 minutes. Remove from the oven and loosely cover with foil.",
      "secondary_message": "4 pork chops, boneless"
    },
    {
      "id": 180287,
      "primary_message": "Meanwhile, trim eggplants and cut into ¾-inch pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 180288,
      "primary_message": "Trim zucchini, quarter lengthwise, and slice crosswise into ¾-inch pieces. Add to the bowl with the eggplant. ",
      "secondary_message": null
    },
    {
      "id": 180289,
      "primary_message": "Trim, seed, and cut bell peppers into ¾-inch pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 180290,
      "primary_message": "Peel and mince onion. Halve tomatoes. Add both to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 180291,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 180292,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 180293,
      "primary_message": "Add veggies, capers, salt, and pepper to the skillet. Juice lemons into the skillet, stir, cover, and bring to a simmer. Cook, stirring often, until veggies are tender, 12-15 minutes.",
      "secondary_message": "1 tbsp capers\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 180294,
      "primary_message": "Slice pork into strips.",
      "secondary_message": null
    },
    {
      "id": 180295,
      "primary_message": "To serve, divide ratatouille and pork chops between plates. Top with remaining salsa verde and enjoy!",
      "secondary_message": null
    }
  ],
