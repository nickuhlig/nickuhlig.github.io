  "instructions": [
    {
      "id": 180268,
      "primary_message": "Preheat oven to 425°F. Line a baking sheet pan with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 180269,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small pkg fresh basil\n1 eggplant\n1 medium zucchini squash\n1 red bell pepper\n½ pint grape tomatoes"
    },
    {
      "id": 180270,
      "primary_message": "Grate zest from the lemon. Peel and mince garlic. Place both in a small bowl along with oil, vinegar, and spices.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp rosemary\n½ tsp sage\n½ tsp salt\n¼ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 180271,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add to the bowl and whisk to combine the salsa verde.",
      "secondary_message": null
    },
    {
      "id": 180272,
      "primary_message": "Place pork chops on the baking sheet and rub with ¾ of the salsa verde, coating both sides (reserve remaining salsa for serving). Place in the oven and bake until golden brown and cooked through, 12-15 minutes. Remove from the oven and loosely cover with foil.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 180273,
      "primary_message": "Meanwhile, trim eggplant and cut into ¾-inch pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 180274,
      "primary_message": "Trim zucchini, quarter lengthwise, and slice crosswise into ¾-inch pieces. Add to the bowl with the eggplant. ",
      "secondary_message": null
    },
    {
      "id": 180275,
      "primary_message": "Trim, seed, and cut bell pepper into ¾-inch pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 180276,
      "primary_message": "Peel and mince shallot. Halve tomatoes. Add both to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 180277,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 180278,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 180279,
      "primary_message": "Add veggies, capers, salt, and pepper to the skillet. Juice lemon into the skillet, stir, cover, and bring to a simmer. Cook, stirring often, until veggies are tender, 12-15 minutes.",
      "secondary_message": "½ tbsp capers\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 180280,
      "primary_message": "Slice pork into strips.",
      "secondary_message": null
    },
    {
      "id": 180281,
      "primary_message": "To serve, divide ratatouille and pork chops between plates. Top with remaining salsa verde and enjoy!",
      "secondary_message": null
    }
  ],
