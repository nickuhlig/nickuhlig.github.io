  "instructions": [
    {
      "id": 563683,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool; set aside.",
      "secondary_message": "1 tsp salt\n283 g rotini pasta"
    },
    {
      "id": 563684,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with yogurt, mayo, vinegar, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n½ cup plain Greek yogurt\n¼ cup mayonnaise\n2 tsp red wine vinegar\n2 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper\n½ tsp dill, dried"
    },
    {
      "id": 563685,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n4 sticks celery\n1 small pkg grape tomatoes"
    },
    {
      "id": 563686,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 563687,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 563688,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 563689,
      "primary_message": "Rinse peas under hot water (from the tap) to thaw. Add to the bowl.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 563690,
      "primary_message": "Drain tuna, add to the bowl, and flake with a fork.",
      "secondary_message": "4 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 563691,
      "primary_message": "Add cooled pasta to the bowl, along with feta, and stir to combine the pasta salad.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 563692,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
