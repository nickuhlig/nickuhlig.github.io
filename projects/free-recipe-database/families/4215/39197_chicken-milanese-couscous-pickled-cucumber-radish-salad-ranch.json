  "instructions": [
    {
      "id": 609331,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 English cucumbers\n1 ½ bunches radish\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 609332,
      "primary_message": "Zest lemons into a medium saucepan, add water and salt, then bring to a boil over high heat. (Reserve lemons for later use.)",
      "secondary_message": "3 cup water\n¾ tsp salt"
    },
    {
      "id": 609333,
      "primary_message": "Once the water is boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "1 ½ cups whole wheat couscous"
    },
    {
      "id": 609334,
      "primary_message": "Meanwhile, place vinegar, honey, salt, and crushed red pepper in a large bowl. Stir to combine the pickling liquid.",
      "secondary_message": "¼ cup white wine vinegar\n1 tbsp honey\n1 ½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 609335,
      "primary_message": "Trim and halve cucumbers crosswise, then run a vegetable peeler along the length of each cucumber half to make ribbons. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 609336,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl, gently toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 609337,
      "primary_message": "Place bread crumbs, salt, and pepper in a small bowl, then stir to combine.",
      "secondary_message": "1 cup panko bread crumbs\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 609338,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 609339,
      "primary_message": "Transfer chicken to a plate, spread half of the mayo over the top side, then sprinkle with half of the bread crumbs, pressing gently to adhere. Carefully flip chicken, then repeat with remaining mayo and bread crumbs. (Reserve bowl for later use.)",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 609340,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 609341,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 609342,
      "primary_message": "Meanwhile, juice the reserved lemons into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 609343,
      "primary_message": "Using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice, along with yogurt, mayo, and spices, then whisk to combine the ranch dressing. Set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n¼ cup mayonnaise\n¾ tsp garlic powder\n¾ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 609344,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 609345,
      "primary_message": "To serve, divide pickled salad and couscous between plates or bowls. Top with chicken, drizzle with ranch, and enjoy!",
      "secondary_message": null
    }
  ],
