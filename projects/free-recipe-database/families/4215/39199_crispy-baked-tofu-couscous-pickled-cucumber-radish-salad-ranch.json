  "instructions": [
    {
      "id": 609361,
      "primary_message": "Preheat the oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 609362,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 609363,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 English cucumbers\n1 bunch radish\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 609364,
      "primary_message": "Zest lemon into a medium saucepan, add water and salt, then bring to a boil over high heat. (Reserve lemon for later use.)",
      "secondary_message": "2 cup water\n½ tsp salt"
    },
    {
      "id": 609365,
      "primary_message": "Once the water is boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "1 cup whole wheat couscous"
    },
    {
      "id": 609366,
      "primary_message": "Meanwhile, place vinegar, honey, salt, and crushed red pepper in a medium bowl. Stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp white wine vinegar\n2 tsp honey\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 609367,
      "primary_message": "Trim and halve cucumbers crosswise, then run a vegetable peeler along the length of each cucumber half to make ribbons. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 609368,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl, gently toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 609369,
      "primary_message": "Place bread crumbs, salt, and pepper in a small bowl, then stir to combine.",
      "secondary_message": "⅔ cup panko bread crumbs\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 609370,
      "primary_message": "Cut the tofu planks in half crosswise. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 609371,
      "primary_message": "Spread half of the mayo over the top side of the tofu then sprinkle with half of the bread crumbs, pressing gently to adhere. Carefully flip tofu, then repeat with remaining mayo and bread crumbs. Drizzle with oil. (Reserve bowl for later use.)",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 609372,
      "primary_message": "Place tofu in the oven and bake, turning once, until the breading is crispy and golden brown, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 609373,
      "primary_message": "Meanwhile, juice reserved lemon into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 609374,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice, along with yogurt, mayo, and spices, then whisk to combine the ranch dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n¼ cup mayonnaise\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 609375,
      "primary_message": "To serve, divide pickled salad and couscous between plates or bowls. Top with tofu, drizzle with ranch, and enjoy!",
      "secondary_message": null
    }
  ],
