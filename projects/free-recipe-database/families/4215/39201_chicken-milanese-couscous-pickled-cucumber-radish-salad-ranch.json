  "instructions": [
    {
      "id": 609391,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 English cucumber\n½ bunch radish\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 609392,
      "primary_message": "Zest lemon into a small saucepan, add water and salt, then bring to a boil over high heat. (Reserve lemon for later use.)",
      "secondary_message": "1 cup water\n¼ tsp salt"
    },
    {
      "id": 609393,
      "primary_message": "Once the water is boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "½ cup whole wheat couscous"
    },
    {
      "id": 609394,
      "primary_message": "Meanwhile, place vinegar, honey, salt, and crushed red pepper in a medium bowl. Stir to combine the pickling liquid.",
      "secondary_message": "1 ½ tbsp white wine vinegar\n1 tsp honey\n½ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 609395,
      "primary_message": "Trim and halve cucumber crosswise, then run a vegetable peeler along the length of each cucumber half to make ribbons. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 609396,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl, gently toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 609397,
      "primary_message": "Place bread crumbs, salt, and pepper in a small bowl, then stir to combine.",
      "secondary_message": "⅓ cup panko bread crumbs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 609398,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 609399,
      "primary_message": "Transfer chicken to a plate, spread half of the mayo over the top side, then sprinkle with half of the bread crumbs, pressing gently to adhere. Carefully flip chicken, then repeat with remaining mayo and bread crumbs. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp mayonnaise"
    },
    {
      "id": 609400,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 609401,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 609402,
      "primary_message": "Meanwhile, juice the reserved lemon into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 609403,
      "primary_message": "Using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice, along with yogurt, mayo, and spices, then whisk to combine the ranch dressing. Set aside.",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 ½ tbsp mayonnaise\n¼ tsp garlic powder\n¼ tsp onion powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 609404,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 609405,
      "primary_message": "To serve, divide pickled salad and couscous between plates or bowls. Top with chicken, drizzle with ranch, and enjoy!",
      "secondary_message": null
    }
  ],
