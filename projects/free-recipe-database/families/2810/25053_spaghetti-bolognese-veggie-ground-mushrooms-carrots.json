  "instructions": [
    {
      "id": 426890,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g spaghetti pasta"
    },
    {
      "id": 426891,
      "primary_message": "Meanwhile, preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 426892,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 426893,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, mushrooms, carrots, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n3 (227g ) pkgs sliced white mushrooms\n1 ½ (283 g) bags shredded carrots\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 426894,
      "primary_message": "Add marinara sauce to the pot, stir to combine, and bring to a simmer over medium-high heat. ",
      "secondary_message": "1 ½ (680 g) jars marinara sauce"
    },
    {
      "id": 426895,
      "primary_message": "Once the sauce is simmering, reduce heat to medium and continue to simmer until the vegetables are soft, 6-7 minutes more.",
      "secondary_message": null
    },
    {
      "id": 426896,
      "primary_message": "When the sauce is done, add pasta to the pot, toss to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 426897,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
