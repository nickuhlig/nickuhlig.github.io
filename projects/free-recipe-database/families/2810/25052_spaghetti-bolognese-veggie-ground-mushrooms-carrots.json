  "instructions": [
    {
      "id": 426882,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 426883,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 426884,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 426885,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, mushrooms, carrots, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n2 (227g ) pkgs sliced white mushrooms\n1 (283 g) bag shredded carrots\n2 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426886,
      "primary_message": "Add marinara sauce to the skillet, stir to combine, and bring to a simmer over medium-high heat. ",
      "secondary_message": "1 (680 g) jar marinara sauce"
    },
    {
      "id": 426887,
      "primary_message": "Once the sauce is simmering, reduce heat to medium and continue to simmer until the vegetables are soft, 5-6 minutes more.",
      "secondary_message": null
    },
    {
      "id": 426888,
      "primary_message": "When the sauce is done, add pasta to the skillet, toss to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 426889,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
