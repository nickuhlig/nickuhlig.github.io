  "instructions": [
    {
      "id": 426858,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 426859,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 426860,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 426861,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, chicken, mushrooms, carrots, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n0.45 kg ground chicken\n2 (227g ) pkgs sliced white mushrooms\n1 (283 g) bag shredded carrots\n2 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426862,
      "primary_message": "Add marinara sauce to the skillet, stir to combine, and bring to a simmer over medium-high heat. ",
      "secondary_message": "1 (680 g) jar marinara sauce"
    },
    {
      "id": 426863,
      "primary_message": "Once the sauce is simmering, reduce heat to medium and continue to simmer until the veggies are soft, 5-6 minutes more.",
      "secondary_message": null
    },
    {
      "id": 426864,
      "primary_message": "When the sauce is done, add pasta to the skillet, toss to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 426865,
      "primary_message": "To serve, divide pasta between plates or bowls; top with Parmesan. Enjoy!",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
