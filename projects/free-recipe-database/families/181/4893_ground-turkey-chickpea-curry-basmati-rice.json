  "instructions": [
    {
      "id": 59540,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n¾ tsp salt\n24 fl oz (3 cups) water"
    },
    {
      "id": 59539,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 59538,
      "primary_message": "Peel and small dice onion. Wash and small dice tomatoes. Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ medium yellow onion\n6 tomatoes\n1 ½ small bunches cilantro"
    },
    {
      "id": 59532,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 59534,
      "primary_message": "Coat bottom of pan with oil. Add ground turkey and, breaking apart with a spoon, cook until browned and crumbly, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "about 3 tbsp virgin coconut oil\n2 ¼ lb ground turkey"
    },
    {
      "id": 59530,
      "primary_message": "Return pan to stove and add onion. Stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 59531,
      "primary_message": "Drain and rinse chickpeas; place on paper towels and pat dry.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 59537,
      "primary_message": "Add curry powder to the onion and stir for 1-2 minutes.",
      "secondary_message": "3 tbsp curry powder"
    },
    {
      "id": 59536,
      "primary_message": "Return turkey to pan. Add tomatoes, chickpeas, and ½ of the cilantro (save the rest for garnishing); stir to combine. Reduce heat to medium and cook until liquid thickens, 4-5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 59535,
      "primary_message": "Reduce heat to low. Add yogurt, salt, and pepper. Stir to combine and cook for another 2-3 minutes.",
      "secondary_message": "1 ½ cup plain Greek yogurt\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 59533,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 59529,
      "primary_message": "To serve, place rice on a plate, top with curry, and garnish with remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
