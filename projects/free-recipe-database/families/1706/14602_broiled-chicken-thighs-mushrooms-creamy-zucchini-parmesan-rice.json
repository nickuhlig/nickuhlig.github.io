  "instructions": [
    {
      "id": 241942,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n0.45 kg white mushrooms\n1 small pkg chives"
    },
    {
      "id": 241943,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth, salt, and garlic powder to the pan; bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n710 ml chicken or vegetable broth\n½ tsp salt\n½ tsp garlic powder"
    },
    {
      "id": 241944,
      "primary_message": "While the broth is heating, trim and coarsely grate the zucchini.",
      "secondary_message": null
    },
    {
      "id": 241945,
      "primary_message": "Once the broth comes to a boil, add zucchini and stir the mixture; cover the saucepan and reduce heat to low. Cook zucchini-rice until liquid is mostly absorbed, about 18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 241946,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 241947,
      "primary_message": "Pat chicken dry with paper towels and place on a large baking sheet pan.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 241948,
      "primary_message": "Halve mushrooms and add to the baking sheet with the chicken.",
      "secondary_message": null
    },
    {
      "id": 241949,
      "primary_message": "Drizzle chicken and mushrooms with oil and season with spices; toss to coat, then spread out in a single layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp garlic powder\n½ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 241950,
      "primary_message": "Place baking sheet in the oven and broil, flipping the chicken halfway through, until chicken and mushrooms are golden brown and cooked through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 241951,
      "primary_message": "Meanwhile, chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 241952,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 241953,
      "primary_message": "When the zucchini-rice is done, add chives and Parmesan to the pan and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 241954,
      "primary_message": "To serve, divide chicken, mushrooms, and zucchini-chive rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
