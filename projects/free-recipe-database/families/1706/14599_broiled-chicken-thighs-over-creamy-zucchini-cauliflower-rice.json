  "instructions": [
    {
      "id": 241903,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n2 medium zucchini squash\n1 small pkg chives"
    },
    {
      "id": 241904,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 241905,
      "primary_message": "Trim and coarsely grate zucchini; add to the bowl with the cauliflower and set aside.",
      "secondary_message": null
    },
    {
      "id": 241906,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 241907,
      "primary_message": "Pat chicken dry with paper towels and place on a large baking sheet pan.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 241908,
      "primary_message": "Drizzle chicken with oil and season with spices on both sides; spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp garlic powder\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 241909,
      "primary_message": "Place baking sheet in the oven and broil, flipping the chicken halfway through, until golden brown and cooked through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 241910,
      "primary_message": "Meanwhile, preheat a large sauté pan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 241911,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add cauliflower, zucchini, cream, and spices to the pan; cook, stirring often, until veggies are soft, 6-8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 fl oz (½ cup) heavy whipping cream\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 241912,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 241913,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 241914,
      "primary_message": "Add Parmesan, chives, and additional cream to the pan with the veggies. Reduce heat to medium and continue to cook, stirring often, until slightly thickened, 2-3 minutes. Remove from heat. ",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 241915,
      "primary_message": "To serve, divide chicken and creamy zucchini-cauliflower rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
