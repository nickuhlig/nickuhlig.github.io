  "instructions": [
    {
      "id": 241994,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 medium zucchini squash\n1 small pkg chives"
    },
    {
      "id": 241995,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 241996,
      "primary_message": "Trim and coarsely grate zucchini; add to the bowl with the cauliflower and set aside.",
      "secondary_message": null
    },
    {
      "id": 241997,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 241998,
      "primary_message": "Pat chicken dry with paper towels and place on a large baking sheet pan.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 241999,
      "primary_message": "Drizzle chicken with oil and season with spices on both sides; spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp garlic powder\n½ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 242000,
      "primary_message": "Place baking sheet in the oven and broil, flipping the chicken halfway through, until golden brown and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 242001,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242002,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add cauliflower, zucchini, cream, and spices to the pot; cook, stirring often, until veggies are soft, 8-10 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n177 ml heavy whipping cream\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 242003,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 242004,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 242005,
      "primary_message": "Add Parmesan, chives, and additional cream to the pot with the veggies. Reduce heat to medium and continue to cook, stirring often, until slightly thickened, 3-4 minutes. Remove from heat. ",
      "secondary_message": "177 ml heavy whipping cream"
    },
    {
      "id": 242006,
      "primary_message": "To serve, divide chicken and creamy zucchini-cauliflower rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
