  "instructions": [
    {
      "id": 241955,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n0.68 kg white mushrooms\n1 small pkg chives"
    },
    {
      "id": 241956,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large pot. Add broth, salt, and garlic powder to the pot; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n1065 ml chicken or vegetable broth\n¾ tsp salt\n¾ tsp garlic powder"
    },
    {
      "id": 241957,
      "primary_message": "While the broth is heating, trim and coarsely grate the zucchini.",
      "secondary_message": null
    },
    {
      "id": 241958,
      "primary_message": "Once the broth comes to a boil, add zucchini and stir the mixture; cover the pot and reduce heat to low. Cook zucchini-rice until liquid is mostly absorbed, about 18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 241959,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 241960,
      "primary_message": "Pat chicken dry with paper towels and divide between two baking sheet pans.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 241961,
      "primary_message": "Halve mushrooms and add to the baking sheets with the chicken.",
      "secondary_message": null
    },
    {
      "id": 241962,
      "primary_message": "Drizzle chicken and mushrooms with oil and season with spices; toss to coat, then spread out in a single layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp salt\n¾ tsp garlic powder\n¾ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 241963,
      "primary_message": "Working in batches, place each baking sheet in the oven and broil, flipping the chicken halfway through, until chicken and mushrooms are golden brown and cooked through, about 10 minutes. Remove from oven and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 241964,
      "primary_message": "Meanwhile, chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 241965,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "128 g Parmesan cheese"
    },
    {
      "id": 241966,
      "primary_message": "When the zucchini-rice is done, add chives and Parmesan to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 241967,
      "primary_message": "To serve, divide chicken, mushrooms, and zucchini-chive rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
