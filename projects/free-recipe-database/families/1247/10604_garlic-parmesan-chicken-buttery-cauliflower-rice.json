  "instructions": [
    {
      "id": 170291,
      "primary_message": "Preheat oven to 400°F and line a baking sheet pan with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 170292,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 170293,
      "primary_message": "In a small bowl, combine Parmesan (reserving a small amount for garnish) and spices.",
      "secondary_message": "1 tsp paprika\n1 tsp garlic powder\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 170294,
      "primary_message": "Melt butter in a skillet or microwave (optional), 15-30 seconds. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 170295,
      "primary_message": "Coat chicken with Parmesan spice blend, place on the baking sheet pan, and drizzle with melted butter.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 170296,
      "primary_message": "Place in the oven and bake, until chicken is golden brown and cooked through, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 170297,
      "primary_message": "Meanwhile, wash, dry, and cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 170298,
      "primary_message": "Heat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 170299,
      "primary_message": "Peel and small the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 170300,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onions and cook, stirring often, until soft and fragrant, 2-3 minutes.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 170301,
      "primary_message": "Meanwhile, wash, dry, and zest lemons into a small bowl.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 170302,
      "primary_message": "Juice lemon into the skillet; add cauliflower, broth, and spices. Cook, stirring frequently, until tender, 3-4 minutes. ",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n2 tsp parsley flakes\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 170303,
      "primary_message": "To serve, divide cauliflower rice between plates or bowls and top with chicken. Garnish with lemon zest, Parmesan cheese, and crushed red pepper flakes. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
