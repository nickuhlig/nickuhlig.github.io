  "instructions": [
    {
      "id": 170343,
      "primary_message": "Preheat oven to 205°C (400°F) and line a large baking sheet pan with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 170344,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 170345,
      "primary_message": "In a medium bowl, combine Parmesan (reserving a small amount for garnish) and spices. ",
      "secondary_message": "1 ½ tsp paprika\n1 ½ tsp garlic powder\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 170346,
      "primary_message": "Melt butter in a skillet or microwave (optional), 15-30 seconds. ",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 170347,
      "primary_message": "Coat chicken with Parmesan spice blend, place on the baking sheet pan, and drizzle with melted butter. ",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 170348,
      "primary_message": "Place in the oven and bake, until chicken is golden brown and cooked through, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 170349,
      "primary_message": "Meanwhile, wash, dry, and cut cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 170350,
      "primary_message": "Heat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 170351,
      "primary_message": "Peel and small dice the onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 170352,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onions and cook, stirring often, until soft and fragrant, 3-4 minutes.",
      "secondary_message": "½ cup butter, unsalted"
    },
    {
      "id": 170353,
      "primary_message": "Meanwhile, wash, dry, and zest lemons into a small bowl.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 170354,
      "primary_message": "Juice lemons into the skillet; add cauliflower, broth, and spices. Cook, stirring frequently, until tender, 4-5 minutes. ",
      "secondary_message": "177 ml chicken or vegetable broth\n1 tbsp parsley flakes\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 170355,
      "primary_message": "To serve, divide cauliflower rice between plates or bowls and top with chicken. Garnish with lemon zest, Parmesan cheese, and crushed red pepper flakes. Enjoy!",
      "secondary_message": "3 pinch crushed red pepper"
    }
  ],
