  "instructions": [
    {
      "id": 170317,
      "primary_message": "Preheat oven to 205°C (400°F) and line a baking sheet pan with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 170318,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 170319,
      "primary_message": "In a small bowl, combine Parmesan (reserving a small amount for garnish) and spices. ",
      "secondary_message": "½ tsp paprika\n½ tsp garlic powder\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 170320,
      "primary_message": "Melt butter in a skillet or microwave (optional), 15-30 seconds. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 170321,
      "primary_message": "Coat chicken with Parmesan spice blend, place on the baking sheet pan, and drizzle with melted butter.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 170322,
      "primary_message": "Place in the oven and bake, until chicken is golden brown and cooked through, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 170323,
      "primary_message": "Meanwhile, wash, dry, and cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 170324,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 170325,
      "primary_message": "Peel and small dice shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 170326,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add shallots and cook, stirring often, until soft and fragrant, 2-3 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 170327,
      "primary_message": "Meanwhile, wash, dry, and zest lemons into a small bowl.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 170328,
      "primary_message": "Juice lemon into the skillet; add cauliflower, broth, and spices. Cook, stirring frequently, until tender, 2-3 minutes. ",
      "secondary_message": "59 ml (¼ cup) chicken or vegetable broth\n1 tsp parsley flakes\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 170329,
      "primary_message": "To serve, divide cauliflower rice between plates or bowls and top with chicken. Garnish with lemon zest, Parmesan cheese, and crushed red pepper flakes. Enjoy!",
      "secondary_message": "1 pinch crushed red pepper"
    }
  ],
