  "instructions": [
    {
      "id": 419856,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n142 g rotini pasta"
    },
    {
      "id": 419857,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small pkg fresh basil\n½ English cucumber"
    },
    {
      "id": 419858,
      "primary_message": "Juice lemon into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 419859,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the lemon juice. ",
      "secondary_message": null
    },
    {
      "id": 419860,
      "primary_message": "Drain and mince capers. Add to the bowl along with vinaigrette, salt, and pepper; stir to combine the dressing. ",
      "secondary_message": "1 tbsp capers\n¼ cup French vinaigrette\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 419861,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 419862,
      "primary_message": "Drain and roughly chop roasted peppers and artichoke hearts. Add both to the bowl. ",
      "secondary_message": "½ (340 g) jar roasted red bell peppers\n1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 419863,
      "primary_message": "Drain salmon, add to the bowl, and flake with a fork.",
      "secondary_message": "1 (213 g) can wild pink salmon, traditional style"
    },
    {
      "id": 419864,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl and stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 419865,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
