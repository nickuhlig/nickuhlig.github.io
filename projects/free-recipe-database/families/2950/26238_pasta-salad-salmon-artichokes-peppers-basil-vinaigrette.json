  "instructions": [
    {
      "id": 419876,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 419877,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small pkg fresh basil\n1 ½ English cucumbers"
    },
    {
      "id": 419878,
      "primary_message": "Juice lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 419879,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the lemon juice. ",
      "secondary_message": null
    },
    {
      "id": 419880,
      "primary_message": "Drain and mince capers. Add to the bowl along with vinaigrette, salt, and pepper; stir to combine the dressing. ",
      "secondary_message": "3 tbsp capers\n¾ cup French vinaigrette\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 419881,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 419882,
      "primary_message": "Drain and roughly chop roasted peppers and artichoke hearts. Add both to the bowl. ",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers\n3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 419883,
      "primary_message": "Drain salmon, add to the bowl, and flake with a fork.",
      "secondary_message": "3 (213 g) cans wild pink salmon, traditional style"
    },
    {
      "id": 419884,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl and stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 419885,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
