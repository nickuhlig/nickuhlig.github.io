  "instructions": [
    {
      "id": 432409,
      "primary_message": "Cut cream cheese into small pieces and place in a small bowl along with cinnamon. Using the back of a spoon, mash and combine the cream cheese, then set aside.",
      "secondary_message": "1 (8 oz) block cream cheese\n¾ tsp cinnamon, ground"
    },
    {
      "id": 432410,
      "primary_message": "Wash, dry, and roughly chop blueberries.",
      "secondary_message": "3 (6 oz) pkgs blueberries"
    },
    {
      "id": 432411,
      "primary_message": "Lay tortillas on a flat surface and spread one half of each tortilla with the cream cheese mixture. Top with chopped blueberries and almonds; drizzle with honey and fold in half to close.",
      "secondary_message": "6 large flour tortillas\n¾ cup almonds, sliced\n2 tbsp honey"
    },
    {
      "id": 432412,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 432413,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 432414,
      "primary_message": "To serve, cut each quesadilla into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
