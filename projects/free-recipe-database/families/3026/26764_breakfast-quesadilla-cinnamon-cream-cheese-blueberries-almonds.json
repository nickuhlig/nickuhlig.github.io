  "instructions": [
    {
      "id": 432397,
      "primary_message": "Cut cream cheese into small pieces and place in a small bowl along with cinnamon. Using the back of a spoon, mash and combine the cream cheese, then set aside.",
      "secondary_message": "⅓ (8 oz) block cream cheese\n¼ tsp cinnamon, ground"
    },
    {
      "id": 432398,
      "primary_message": "Wash, dry, and roughly chop blueberries.",
      "secondary_message": "1 (6 oz) pkg blueberries"
    },
    {
      "id": 432399,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 432400,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and spread one half of each tortilla with the cream cheese mixture. Top with chopped blueberries and almonds; drizzle with honey and fold in half to close.",
      "secondary_message": "2 large flour tortillas\n¼ cup almonds, sliced\n2 tsp honey"
    },
    {
      "id": 432401,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add quesadillas and cook, flipping halfway through, until filling is warmed through and tortillas are golden on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 432402,
      "primary_message": "To serve, cut each quesadilla into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
