  "instructions": [
    {
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "680 g ribeye steak\nsalt\nblack pepper"
    },
    {
      "primary_message": "Wash and quarter lettuce lengthwise. Rub cut sides with a little olive oil and season with salt and pepper.",
      "secondary_message": "2 heads romaine lettuce\n2 tbsp extra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Coat grill or bottom of skillet with oil. Place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "primary_message": "Place lettuce quarters, cut side down, on grill/skillet. Cook until charred and leaves begin to wilt, 2-3 minutes. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. In a small saucepan, combine vinegar and garlic; bring to a boil over medium-high heat. Reduce heat to low. Stirring occasionally, simmer until liquid is reduced and thickened, 5-10 minutes.",
      "secondary_message": "2 cloves garlic\n1 cup balsamic vinegar"
    },
    {
      "primary_message": "Wash, trim stem ends, and slice strawberries. Wash blueberries.",
      "secondary_message": "1 (454 g) pkg strawberries\n2 (170 g) pkg blueberries"
    },
    {
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, place lettuce cut side up on a plate and top with berries and steak slices. Sprinkle with walnuts and drizzle with balsamic reduction. Enjoy!",
      "secondary_message": null
    }
  ],
