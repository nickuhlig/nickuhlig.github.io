  "instructions": [
    {
      "id": 485664,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485665,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 485666,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 485667,
      "primary_message": "Add orzo, broth, and spices to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes.",
      "secondary_message": "425 g orzo pasta\n1420 ml chicken or vegetable broth\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 485668,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ (227 g) pkgs sugar snap peas\n6 medium zucchini squash\n1 ½ lemons\n1 small pkg fresh basil"
    },
    {
      "id": 485669,
      "primary_message": "Trim and halve snap peas. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 485670,
      "primary_message": "Trim and small dice zucchini. Add to the bowl with the snap peas. ",
      "secondary_message": null
    },
    {
      "id": 485671,
      "primary_message": "Zest lemons into the bowl. Cut lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 485672,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 485673,
      "primary_message": "Place cottage cheese in a strainer and set strainer in a bowl to catch the excess liquid. Set aside to drain.",
      "secondary_message": "3 cups cottage cheese"
    },
    {
      "id": 485674,
      "primary_message": "When the broth is mostly absorbed, add snap peas, zucchini, lemon zest, and basil to the pot, then stir to combine. Return to a simmer and cook until veggies are tender, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 485675,
      "primary_message": "When the veggies are done, add cottage cheese to the pot. Continue to cook, stirring frequently, until thickened, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 485676,
      "primary_message": "Divide orzo between plates or bowls, top with reserved basil, and drizzle with oil. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil"
    }
  ],
