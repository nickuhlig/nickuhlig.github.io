  "instructions": [
    {
      "id": 485612,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485613,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 485614,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 485615,
      "primary_message": "Add orzo, broth, and spices to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes.",
      "secondary_message": "10 oz orzo pasta\n32 fl oz (4 cups) chicken or vegetable broth\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 485616,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (8 oz) pkg sugar snap peas\n4 medium zucchini squash\n1 lemon\n1 small pkg fresh basil"
    },
    {
      "id": 485617,
      "primary_message": "Trim and halve snap peas. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 485618,
      "primary_message": "Trim and small dice zucchini. Add to the bowl with the snap peas. ",
      "secondary_message": null
    },
    {
      "id": 485619,
      "primary_message": "Zest lemon into the bowl. Cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 485620,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 485621,
      "primary_message": "Place cottage cheese in a strainer and set strainer in a bowl to catch the excess liquid. Set aside to drain.",
      "secondary_message": "2 cups cottage cheese"
    },
    {
      "id": 485622,
      "primary_message": "When the broth is mostly absorbed, add snap peas, zucchini, lemon zest, and basil to the skillet, then stir to combine. Return to a simmer and cook until veggies are tender, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 485623,
      "primary_message": "When the veggies are done, add cottage cheese to the skillet. Continue to cook, stirring frequently, until thickened, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 485624,
      "primary_message": "Divide orzo between plates or bowls, top with reserved basil, and drizzle with oil. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": "4 tsp extra virgin olive oil"
    }
  ],
