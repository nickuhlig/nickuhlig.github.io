  "instructions": [
    {
      "id": 208099,
      "primary_message": "Wash, dry, and halve potatoes. Transfer to a medium saucepan, cover with hot water (from the tap), and bring to a boil over high heat. Reduce heat to medium and cook until fork-tender, 10-15 minutes.",
      "secondary_message": "0.45 kg new potatoes"
    },
    {
      "id": 208100,
      "primary_message": "Meanwhile, place ketchup, vinegar, Dijon, honey, Worcestershire, and spices in a medium bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "¼ cup ketchup\n2 tbsp apple cider vinegar\n1 ½ tbsp Dijon mustard\n1 tbsp honey\n1 tsp Worcestershire sauce\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 208101,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208102,
      "primary_message": "Pat chicken dry with paper towels and slice into ¾-inch tenders. Transfer to a plate and pour ½ of the BBQ sauce over the chicken; turn to coat. (Reserve remaining sauce for later.)",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 208103,
      "primary_message": "Once the grill pan is hot, coat with oil. Place tenders on the pan and grill, turning occasionally, until cooked through, 6-8 minutes. Discard marinade.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 208104,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince the shallot; place in another medium bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 208105,
      "primary_message": "Add yogurt, mayo, vinegar, and spices to the bowl with the shallot; whisk to combine the dressing. ",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tsp apple cider vinegar\n1 tsp parsley flakes\n½ tsp dill\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 208106,
      "primary_message": "Wash, dry, and roughly chop spinach; add to the bowl with the dressing. (Skip washing the spinach if it came pre-washed.)",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 208107,
      "primary_message": "Drain and rinse potatoes with cold water to cool. Add to the bowl with the spinach and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 208108,
      "primary_message": "When done, transfer tenders to the bowl with the reserved BBQ sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 208109,
      "primary_message": "To serve, divide tenders and potato salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
