  "instructions": [
    {
      "id": 208121,
      "primary_message": "Wash, dry, and halve potatoes. Transfer to a large pot, cover with hot water (from the tap), and bring to a boil over high heat. Reduce heat to medium and cook until fork-tender, 10-15 minutes.",
      "secondary_message": "1.36 kg new potatoes"
    },
    {
      "id": 208122,
      "primary_message": "Meanwhile, place ketchup, vinegar, Dijon, honey, Worcestershire, and spices in a large bowl; whisk to combine the BBQ sauce. ",
      "secondary_message": "¾ cup ketchup\n⅓ cup apple cider vinegar\n¼ cup Dijon mustard\n3 tbsp honey\n1 tbsp Worcestershire sauce\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp chili powder\n¾ tsp salt"
    },
    {
      "id": 208123,
      "primary_message": "Pat chicken dry with paper towels and slice into ¾-inch tenders. Transfer to a baking dish and pour ½ of the BBQ sauce over the chicken; turn to coat. (Reserve remaining sauce for later.)",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 208124,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208125,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, place tenders on the pan and grill, turning occasionally, until cooked through, 6-8 minutes. Discard marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 208126,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince onion; place in another large bowl. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 208127,
      "primary_message": "Add yogurt, mayo, vinegar, and spices to the bowl with the onion; whisk to combine the dressing. ",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n2 tbsp apple cider vinegar\n1 tbsp parsley flakes\n1 ½ tsp dill\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 208128,
      "primary_message": "Wash, dry, and roughly chop spinach; add to the bowl with the dressing. (Skip washing the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 208129,
      "primary_message": "Drain and rinse potatoes with cold water to cool. Add to the bowl with the spinach and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 208130,
      "primary_message": "When done, transfer tenders to the bowl with the reserved BBQ sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 208131,
      "primary_message": "To serve, divide tenders and potato salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
