  "instructions": [
    {
      "id": 208077,
      "primary_message": "Wash, dry, and halve potatoes. Transfer to a large pot, cover with hot water (from the tap), and bring to a boil over high heat. Reduce heat to medium and cook until fork-tender, 10-15 minutes.",
      "secondary_message": "2 lb new potatoes"
    },
    {
      "id": 208078,
      "primary_message": "Meanwhile, place ketchup, vinegar, Dijon, honey, Worcestershire, and spices in a large bowl; whisk to combine the BBQ sauce. ",
      "secondary_message": "½ cup ketchup\n¼ cup apple cider vinegar\n3 tbsp Dijon mustard\n2 tbsp honey\n2 tsp Worcestershire sauce\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp chili powder\n½ tsp salt"
    },
    {
      "id": 208079,
      "primary_message": "Pat chicken dry with paper towels and slice into ¾-inch tenders. Transfer to a large plate and pour ½ of the BBQ sauce over the chicken; turn to coat. (Reserve remaining sauce for later.)",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 208080,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208081,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, place tenders on the pan and grill, turning occasionally, until cooked through, 6-8 minutes. Discard marinade.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 208082,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince the shallots; place in another large bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 208083,
      "primary_message": "Add yogurt, mayo, vinegar, and spices to the bowl with the shallot; whisk to combine the dressing. ",
      "secondary_message": "½ cup plain Greek yogurt\n¼ cup mayonnaise\n4 tsp apple cider vinegar\n2 tsp parsley flakes\n1 tsp dill\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 208084,
      "primary_message": "Wash, dry, and roughly chop spinach; add to the bowl with the dressing. (Skip washing the spinach if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 208085,
      "primary_message": "Drain and rinse potatoes with cold water to cool. Add to the bowl with the spinach and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 208086,
      "primary_message": "When done, transfer tenders to the bowl with the reserved BBQ sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 208087,
      "primary_message": "To serve, divide tenders and potato salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
