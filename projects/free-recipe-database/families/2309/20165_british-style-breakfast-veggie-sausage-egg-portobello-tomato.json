  "instructions": [
    {
      "id": 336763,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 336764,
      "primary_message": "Wash and dry mushrooms; remove stems and carefully scrape out the gills. Transfer to a baking sheet pan. ",
      "secondary_message": "2 caps portobello mushrooms"
    },
    {
      "id": 336765,
      "primary_message": "Wash, dry, and cut tomato in half crosswise; add to the baking sheet with the mushrooms, arranging the veggies on one half in a single layer. Drizzle with oil and season with spices.",
      "secondary_message": "1 tomato\n1 tsp extra virgin olive oil\n¼ tsp parsley flakes\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 336766,
      "primary_message": "Arrange sausages on the other half of the baking sheet.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 336767,
      "primary_message": "Place baking sheet in the oven and broil, flipping veggies and sausages halfway through, until veggies are fork-tender and sausages are warmed through, 6-8 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 336768,
      "primary_message": "Meanwhile, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 336769,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but yolks are still runny, about 4 minutes. Remove from heat, then season with salt and pepper. ",
      "secondary_message": "1 tsp extra virgin olive oil\n2 eggs\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 336770,
      "primary_message": "While the eggs are cooking, toast bread if desired and cut in half.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 336771,
      "primary_message": "To serve, divide mushrooms, tomatoes, sausages, eggs, and bread between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
