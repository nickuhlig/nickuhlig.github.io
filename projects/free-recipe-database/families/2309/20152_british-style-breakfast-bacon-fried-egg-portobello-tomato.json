  "instructions": [
    {
      "id": 336646,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line two baking sheet pans with aluminum foil to make cleanup easier (optional). ",
      "secondary_message": null
    },
    {
      "id": 336647,
      "primary_message": "Wash and dry mushrooms; remove stems and carefully scrape out the gills. Divide between baking sheets.",
      "secondary_message": "6 caps portobello mushrooms"
    },
    {
      "id": 336648,
      "primary_message": "Wash, dry, and cut tomatoes in half crosswise; add to the baking sheets with the mushrooms, arranging the veggies on one half of the baking sheets in a single layer. Drizzle with oil and season with spices.",
      "secondary_message": "3 tomatoes\n2 tbsp extra virgin olive oil\n¾ tsp parsley flakes\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 336649,
      "primary_message": "Arrange bacon on the other half of the baking sheets.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 336650,
      "primary_message": "Working in batches, place baking sheets in the oven and broil, flipping veggies and bacon halfway through, until veggies are tender and bacon is crisp, 6-8 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 336651,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 336652,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but yolks are still runny, about 4 minutes. Remove from heat, then season with salt and pepper. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 eggs\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 336653,
      "primary_message": "While the eggs are cooking, toast bread if desired and cut in half. ",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 336654,
      "primary_message": "To serve, divide mushrooms, tomatoes, bacon, eggs, and bread between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
