  "instructions": [
    {
      "id": 1,
      "primary_message": "Place cilantro, mint, onion, coconut, lemon juice, chilies, garlic, and ginger in the workbowl of a food processor. Pulse until all ingredients are finely chopped, stopping to scrape down sides of bowl as needed. Add additional water as needed, 1 tablespoon at a time, to form a thick, but pourable sauce. Use immediately or transfer to an airtight container and store in refrigerator for up to a week.",
      "secondary_message": null
    }
  ],
