  "instructions": [
    {
      "id": 462894,
      "primary_message": "Drain and roughly chop roasted peppers. Divide between two large bowls. (Set one bowl aside for the salad.)",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers"
    },
    {
      "id": 462895,
      "primary_message": "Add veggie ground, bread crumbs, eggs, salt, and pepper to the first bowl with the peppers. Use your hands to combine the veggie ground mixture. Using a scant ¼-cup measure, form the mixture into ½-inch thick patties and place on a plate.",
      "secondary_message": "680 g veggie ground, plant based\n1 cup panko bread crumbs\n3 eggs\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 462896,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462897,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add patties and cook, flipping once, until golden and cooked through, 3-4 minutes per side. Transfer to a clean plate. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 462898,
      "primary_message": "Meanwhile, wash, dry, and shave dill leaves off the stems; discard stems and mince the leaves. Add to the second bowl with the peppers. ",
      "secondary_message": "1 small bunch fresh dill"
    },
    {
      "id": 462899,
      "primary_message": "Wash, dry, trim, and halve cucumbers lengthwise, then cut crosswise into thin half-moons. ",
      "secondary_message": "1 ½ English cucumbers"
    },
    {
      "id": 462900,
      "primary_message": "Add carrots, almonds, and vinaigrette to the bowl, then stir to combine the salad. ",
      "secondary_message": "1 ½ (283 g) bags shredded carrots\n¾ cup almonds, sliced\n⅓ cup French vinaigrette"
    },
    {
      "id": 462901,
      "primary_message": "To serve, divide patties and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
