  "instructions": [
    {
      "id": 498069,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 498070,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n1 pint grape tomatoes\n1 bunch kale"
    },
    {
      "id": 498071,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 498072,
      "primary_message": "Add tomatoes to the baking sheet with the peppers. Drizzle veggies with oil, then season with salt and crushed red pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 498073,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are browned and fork-tender, 18-20 minutes. Remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 498074,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 498075,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. ",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 498076,
      "primary_message": "Mince anchovy fillets. Place in a medium bowl.",
      "secondary_message": "2 anchovy fillets, packed in oil"
    },
    {
      "id": 498077,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the anchovy along with oil, vinegar, and spices; whisk to combine the dressing. ",
      "secondary_message": "1 oz Parmesan cheese\n2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n¼ tsp salt\n¼ tsp oregano, dried\n¼ tsp crushed red pepper"
    },
    {
      "id": 498078,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing and, using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 498079,
      "primary_message": "Drain and roughly chop olives and artichokes. Add both to the bowl.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n½ (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 498080,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces. Add to the bowl.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 498081,
      "primary_message": "When the veggies are cool, add to the bowl along with toasted pine nuts. Gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 498082,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
