  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Spiced Simple Syrup: Combine cinnamon, cloves, lemon, sugar, and water in a small saucepan and bring to a simmer over medium heat, stirring frequently. Cook until sugar has melted, remove from heat, and allow to cool to room temperature before straining. Syrup can be stored in an airtight container in the refrigerator for up to 5 days.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Cinnamon Batter: In a small bowl mash together butter, brown sugar, and ground cinnamon, and mix until all the ingredients are evenly incorporated.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Divide batter between 4 mugs; pour 1 1/2 ounces of rum into each mug, followed by 1 teaspoon spiced simple syrup. Pour 6 ounces boiling water in each mug and stir until batter is dissolved. Serve hot garnished with cinnamon sticks.",
      "secondary_message": null
    }
  ],
