  "instructions": [
    {
      "id": 105260,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (16 oz) pkg strawberries\n1 kiwifruit\n¼ (6 oz) pkg blueberries"
    },
    {
      "id": 105261,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 105262,
      "primary_message": "Add the bananas, oats, milk, and cinnamon to the blender. Purée for 30 seconds, until smooth.",
      "secondary_message": "2 bananas\n1 ⅓ cup oats, quick cooking\n4 fl oz (½ cup) whole milk\n¼ tsp cinnamon"
    },
    {
      "id": 105263,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 ½ tsp butter, unsalted"
    },
    {
      "id": 105264,
      "primary_message": "Using a ¼-cup measure, pour the batter into the skillet. Cook for 1-2 minutes on each side, until browned. Work in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 105265,
      "primary_message": "Slice the strawberries in half. Peel and slice the kiwi.",
      "secondary_message": null
    },
    {
      "id": 105266,
      "primary_message": "Divide the pancakes, strawberries, kiwi, and blueberries between plates. Top with maple syrup and enjoy!",
      "secondary_message": "2 tbsp pure maple syrup"
    }
  ],
