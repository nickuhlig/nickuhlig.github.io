  "instructions": [
    {
      "id": 489569,
      "primary_message": "Place yogurt in a medium bowl, add water, and whisk until smooth. Set aside.",
      "secondary_message": "2 cups plain Greek yogurt\n⅓ cup water"
    },
    {
      "id": 489570,
      "primary_message": "Wash, dry, quarter, and core pears; slice lengthwise into thin wedges.",
      "secondary_message": "6 pears"
    },
    {
      "id": 489571,
      "primary_message": "Divide pear wedges between plates. Top with yogurt, pumpkin seeds, and cranberries.",
      "secondary_message": "¾ cup pumpkin seeds\n¾ cup dried cranberries"
    },
    {
      "id": 489572,
      "primary_message": "To serve, drizzle pear \"nachos\" with honey and enjoy!",
      "secondary_message": "3 tbsp honey"
    }
