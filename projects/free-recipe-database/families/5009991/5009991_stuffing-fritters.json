  "instructions": [
    {
      "id": 1,
      "primary_message": "Melt butter in a 12-inch skillet over medium heat. When foaming subsides, add onions, apple, and celery. Cook, stirring occasionally, until onions, apple, and celery have softened, but not browned, about 7 minutes. Stir in sage and thyme and cook until fragrant, about 30 seconds. Remove from heat and season with salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To make the batter: Stir together flour, cornmeal, buttermilk, eggs, sugar, baking powder, baking soda, and salt in a large bowl. Stir in onion and apple mixture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil and bacon drippings (if using) to 375°F in a large pot or Dutch oven over high heat. Using a cookie scoop or 2 spoons, drop heaping tablespoons of batter into oil and fry until golden brown, flipping halfway through cooking, about 5 minutes total. Remove to a paper towel-lined plate to drain. Season with additional salt to taste, then serve immediately.",
      "secondary_message": null
    }
  ],
