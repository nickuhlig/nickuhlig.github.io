  "instructions": [
    {
      "id": 61731,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small pkg grape tomatoes\n3 jalapeño peppers\n1 ½ limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 61730,
      "primary_message": "Quarter the tomatoes and transfer to a medium bowl (that will hold the salsa).",
      "secondary_message": ""
    },
    {
      "id": 61729,
      "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the salsa bowl.",
      "secondary_message": ""
    },
    {
      "id": 61728,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salsa bowl.",
      "secondary_message": ""
    },
    {
      "id": 61727,
      "primary_message": "Heat a nonstick skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 61726,
      "primary_message": "Trim off and discard the ends of the onions and remove the outer layer; small dice the onions (cut into 6-mm pieces). Add ½ of the onions to the salsa bowl and leave the rest on the cutting board.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 61725,
      "primary_message": "Once the skillet is hot, add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 61724,
      "primary_message": "Add the remaining diced onion to the skillet; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 61723,
      "primary_message": "Juice the limes and add to the salsa bowl.",
      "secondary_message": ""
    },
    {
      "id": 61722,
      "primary_message": "Season the salsa with salt and pepper; mix together and set aside.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 61721,
      "primary_message": "Add the ground beef to the skillet and season with chili powder, cumin, salt, and pepper. Cook, breaking apart with a spoon, until the beef is browned and crumbly, 3 to 4 minutes. Once done, transfer the mixture to a bowl.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tsp chili powder\n1 ½ tsp cumin\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 61720,
      "primary_message": "While the beef cooks, coarsely grate 3 cups of cheddar.",
      "secondary_message": "1 ½ (227 g) block cheddar cheese"
    },
    {
      "id": 61719,
      "primary_message": "Once the beef mixture has been transferred, remove any leftover bits from the skillet.",
      "secondary_message": ""
    },
    {
      "id": 61718,
      "primary_message": "Place the tortillas on a flat surface. Layer one half of each tortilla with cheese, followed by some of the beef mixture, followed by more cheese. Fold tortillas over to close.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 61717,
      "primary_message": "Place 2 of the quesadillas in the skillet, straight edges next to each other. Cook until golden brown on both sides and the cheese is melted, 2-4 minutes per side. Once done, transfer the quesadillas to a cutting board. Repeat with the remaining quesadillas.",
      "secondary_message": ""
    },
    {
      "id": 61716,
      "primary_message": "Cut each quesadilla into 4 wedges.",
      "secondary_message": ""
    },
    {
      "id": 61715,
      "primary_message": "To serve, divide the quesadillas between plates and serve with the pico de gallo and Greek yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
