  "instructions": [
    {
      "id": 41997,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n1 jalapeño pepper\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 41998,
      "primary_message": "Quarter the tomatoes and transfer to a medium bowl (that will hold the salsa).",
      "secondary_message": null
    },
    {
      "id": 41999,
      "primary_message": "Quarter the jalapeño pepper lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the pepper and add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 42000,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 42001,
      "primary_message": "Heat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 42002,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces). Add ½ of the onion to the salsa bowl and leave the rest on the cutting board.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 42003,
      "primary_message": "Once the skillet is hot, add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 42004,
      "primary_message": "Add the remaining diced onion to the skillet; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 42005,
      "primary_message": "Juice the lime and add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 42006,
      "primary_message": "Season the salsa with salt and pepper; mix together and set aside.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42007,
      "primary_message": "Add the ground beef to the skillet and season with chili powder, cumin, salt, and pepper. Cook, breaking apart with a spoon, until the beef is browned and crumbly, 3 to 4 minutes. Once done, transfer the mixture to a bowl.",
      "secondary_message": "¾ lb lean ground beef\n½ tsp chili powder\n½ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42008,
      "primary_message": "While the beef cooks, coarsely grate 1 cup of cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 42009,
      "primary_message": "Once the beef mixture has been transferred, remove any leftover bits from the skillet.",
      "secondary_message": null
    },
    {
      "id": 42010,
      "primary_message": "Place the tortillas on a flat surface. Layer one half of each tortilla with ¼ of the cheese, ½ of the beef mixture, and another ¼ of the cheese. Fold tortillas over to close.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 42011,
      "primary_message": "Place both quesadillas in the skillet, straight edges next to each other. Cook until golden brown on both sides and the cheese is melted, 2-4 minutes per side. Once done, transfer the quesadillas to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 42012,
      "primary_message": "Cut each quesadilla into 4 wedges.",
      "secondary_message": null
    },
    {
      "id": 42013,
      "primary_message": "To serve, divide the quesadillas between plates and serve with the pico de gallo and Greek yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
