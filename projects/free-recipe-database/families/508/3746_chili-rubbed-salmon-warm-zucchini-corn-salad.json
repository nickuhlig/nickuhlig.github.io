  "instructions": [
    {
      "id": 41105,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n½ small bunch green onions\n½ lime"
    },
    {
      "id": 41106,
      "primary_message": "Trim off and discard the ends of the zucchini; using a box grater, coarsely grate the zucchini. Transfer to a colander (with a bowl underneath) and season with salt; set aside to drain.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 41107,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 41108,
      "primary_message": "While the skillet heats up, pat the salmon fillets dry with paper towels and place on a plate; season with chili powder, salt, and pepper.",
      "secondary_message": "0.34 kg salmon fillets\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 41109,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 41110,
      "primary_message": "Place the salmon, skin-side-down, in the skillet; cook until the flesh is opaque and flaky, 3 to 4 minutes per side (depending on thickness). Once done, transfer to a plate and cover with foil to keep warm.",
      "secondary_message": ""
    },
    {
      "id": 41111,
      "primary_message": "While the salmon cooks, trim off and discard the ends of the shallot; peel and mince the shallot. Transfer to a small bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 41112,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 41113,
      "primary_message": "Once the salmon has been transferred, reduce the heat to medium. Add more oil and the shallots to the skillet; cook, stirring frequently, until softened, 30 to 60 seconds.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 41114,
      "primary_message": "Once the shallots have softened, add the corn to the skillet; cook, stirring frequently, until warmed through and lightly charred, 1 to 2 minutes.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 41115,
      "primary_message": "Cut the lime into 4 wedges.",
      "secondary_message": ""
    },
    {
      "id": 41116,
      "primary_message": "Add the drained zucchini and about ¾ of the green onions (save the rest for garnishing) to the skillet; season with chili powder, salt, and pepper. Increase the heat to medium-high and cook until the zucchini is heated through, 2 to 3 minutes.",
      "secondary_message": "¼ tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 41117,
      "primary_message": "To serve, divide the zucchini and corn salad between plates or bowls, top with the salmon fillets, and garnish with the remaining green onions and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
