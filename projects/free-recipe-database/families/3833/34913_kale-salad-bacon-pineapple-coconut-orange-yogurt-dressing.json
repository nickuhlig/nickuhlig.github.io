  "instructions": [
    {
      "id": 550567,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 550568,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 550569,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 550570,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 orange\n2 bunches kale\n1 small pineapple"
    },
    {
      "id": 550571,
      "primary_message": "Using a clean cutting board, zest and juice orange into a large bowl. Add yogurt, oil, vinegar, and spices, then whisk to combine the dressing.",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 550572,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 550573,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 550574,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 550575,
      "primary_message": "Wipe skillet clean with paper towels, then return to medium heat. Add coconut and almonds; cook, stirring frequently, until golden and toasted, 3-4 minutes. Remove from heat. ",
      "secondary_message": "⅔ cup shredded unsweetened coconut\n½ cup almonds, sliced"
    },
    {
      "id": 550576,
      "primary_message": "To serve, divide salad between plates or bowls; top with bacon, coconut, and almonds. Enjoy!",
      "secondary_message": null
    }
  ],
