  "instructions": [
    {
      "id": 550497,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 550498,
      "primary_message": "While the skillet heats up, medium dice tempeh. Place in a small bowl, along with soy sauce and spices, then stir to coat.",
      "secondary_message": "1 (8 oz) package tempeh\n1 tbsp soy sauce\n½ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 550499,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh and cook, stirring occasionally, until golden, 4-5 minutes. Transfer tempeh to a plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 550500,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ orange\n1 bunch kale\n½ small pineapple"
    },
    {
      "id": 550501,
      "primary_message": "Zest and juice orange into a medium bowl, then add yogurt, oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n2 tsp apple cider vinegar\n¼ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 550502,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 550503,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 550504,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "½ cup edamame, shelled"
    },
    {
      "id": 550505,
      "primary_message": "Wipe skillet clean with paper towels, then return to medium heat. Add coconut and almonds; cook, stirring frequently, until golden and toasted, 3-4 minutes. Remove from heat. ",
      "secondary_message": "⅓ cup shredded unsweetened coconut\n¼ cup almonds, sliced"
    },
    {
      "id": 550506,
      "primary_message": "To serve, divide salad between plates or bowls; top with tempeh, coconut, and almonds. Enjoy!",
      "secondary_message": null
    }
  ],
