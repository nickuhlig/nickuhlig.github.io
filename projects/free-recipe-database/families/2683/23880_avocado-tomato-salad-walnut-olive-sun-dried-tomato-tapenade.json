  "instructions": [
    {
      "id": 389088,
      "primary_message": "Place oil, vinegar, salt, and pepper in a small bowl. Stir to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 389089,
      "primary_message": "Mince walnuts, olives, and sun-dried tomatoes. Add all three to the bowl with the dressing and stir to combine the tapenade. Set aside.",
      "secondary_message": "¾ cup walnuts\n⅓ cup Kalamata olives, pitted\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 389090,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": "6 tomatoes"
    },
    {
      "id": 389091,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and slice lengthwise into thin pieces.",
      "secondary_message": "3 avocados"
    },
    {
      "id": 389092,
      "primary_message": "To serve, divide tomato and avocado slices between plates, then spoon tapenade over top. Enjoy!",
      "secondary_message": null
    }
