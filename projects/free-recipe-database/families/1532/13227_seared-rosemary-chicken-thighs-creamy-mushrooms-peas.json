  "instructions": [
    {
      "id": 221482,
      "primary_message": "Wash, dry, and thinly slice mushrooms; transfer to a medium bowl and set aside.",
      "secondary_message": "1 ½ lb cremini mushrooms"
    },
    {
      "id": 221483,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 221484,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 221485,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Working in batches, add chicken in a single layer and cook until golden brown, about 2 minutes per side. Transfer to a clean plate, and loosely cover with aluminum foil (the chicken will not be cooked all the way through). ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 221486,
      "primary_message": "While the chicken browns, peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 221487,
      "primary_message": "Return the pot to medium heat, add more butter, and swirl to coat the bottom. Add onion and garlic to the pot; cook, stirring occasionally, until onion begins to soften, 3-4 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 221488,
      "primary_message": "Add mushrooms to the pot and cook until golden brown and tender, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 221489,
      "primary_message": "While the mushrooms cook, place peas in a colander and run under hot water (from the tap) to thaw.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 221490,
      "primary_message": "Add peas, cream, and spices to the pot; stir to combine.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy cream\n1 ½ tsp rosemary\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 221491,
      "primary_message": "Return chicken to the pot (overlapping the chicken thighs slightly, if necessary), along with any accumulated juices. Cover and simmer until chicken is cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 221492,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 221493,
      "primary_message": "When the chicken is done, add Parmesan to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 221494,
      "primary_message": "To serve, divide chicken and veggies between plates, spooning sauce on top. Enjoy!",
      "secondary_message": null
    }
  ],
