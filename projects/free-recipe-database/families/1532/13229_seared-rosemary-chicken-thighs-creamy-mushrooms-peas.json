  "instructions": [
    {
      "id": 221508,
      "primary_message": "Wash, dry, and thinly slice mushrooms; transfer to a medium bowl and set aside.",
      "secondary_message": "0.45 kg cremini mushrooms"
    },
    {
      "id": 221509,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 221510,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 221511,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chicken in a single layer and cook until golden brown, about 2 minutes per side. Transfer to a clean plate, and loosely cover with aluminum foil (the chicken will not be cooked all the way through). ",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 221512,
      "primary_message": "While the chicken browns, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 221513,
      "primary_message": "Return the skillet to medium heat, add more butter, and swirl to coat the bottom. Add onion and garlic to the skillet; cook, stirring occasionally, until onion begins to soften, 2-3 minutes. ",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 221514,
      "primary_message": "Add mushrooms to the skillet and cook until golden brown and tender, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 221515,
      "primary_message": "While the mushrooms cook, place peas in a colander and run under hot water (from the tap) to thaw.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 221516,
      "primary_message": "Add peas, cream, and spices to the skillet; stir to combine.",
      "secondary_message": "237 ml heavy cream\n1 tsp rosemary\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 221517,
      "primary_message": "Return chicken to the skillet (overlapping the chicken thighs slightly, if necessary), along with any accumulated juices. Cover and simmer until chicken is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 221518,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 221519,
      "primary_message": "When the chicken is done, add Parmesan to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 221520,
      "primary_message": "To serve, divide chicken and veggies between plates, spooning skillet sauce on top. Enjoy!",
      "secondary_message": null
    }
  ],
