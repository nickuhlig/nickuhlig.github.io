  "instructions": [
    {
      "id": 221495,
      "primary_message": "Wash, dry, and thinly slice mushrooms; transfer to a medium bowl and set aside.",
      "secondary_message": "0.23 kg cremini mushrooms"
    },
    {
      "id": 221496,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 221497,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 221498,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chicken in a single layer and cook until golden brown, about 2 minutes per side. Transfer to a clean plate, and loosely cover with aluminum foil (the chicken will not be cooked all the way through). ",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 221499,
      "primary_message": "While the chicken browns, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 221500,
      "primary_message": "Return the skillet to medium heat, add more butter, and swirl to coat the bottom. Add onion and garlic to the skillet; cook, stirring occasionally, until onion begins to soften, 2-3 minutes. ",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 221501,
      "primary_message": "Add mushrooms to the skillet and cook until golden brown and tender, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 221502,
      "primary_message": "While the mushrooms cook, place peas in a colander and run under hot water (from the tap) to thaw.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 221503,
      "primary_message": "Add peas, cream, and spices to the skillet; stir to combine.",
      "secondary_message": "118 ml (½ cup) heavy cream\n½ tsp rosemary\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 221504,
      "primary_message": "Return chicken to the skillet, along with any accumulated juices. Cover and simmer until chicken is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 221505,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 221506,
      "primary_message": "When the chicken is done, add Parmesan to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 221507,
      "primary_message": "To serve, divide chicken and veggies between plates, spooning skillet sauce on top. Enjoy!",
      "secondary_message": null
    }
  ],
