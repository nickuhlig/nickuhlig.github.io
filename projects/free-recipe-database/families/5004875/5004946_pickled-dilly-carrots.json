  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a small pot of water to a boil to blanch the carrots.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Prepare 1 pint and a half-jar, or two 340 g jelly jars. Place lids in a small pot of water and bring to the barest bubble to soften sealing compound.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Peel carrots and trim to fit jars. Cut into thin sticks.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When water comes to a boil, drop in carrots and cook for either 90 seconds if you plan on canning your pickles, or 3 minutes if you’re making them as refrigerator pickles.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "When time is up, remove carrots from water and run under cold water to stop cooking.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Combine vinegar, water and salt in a small saucepan and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Place spices and garlic cloves into bottom of jars.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Pack carrots sticks upright in jars.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Pour boiling brine over carrots, leaving 1.5 cm headspace.",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "Tap jars gently to remove air bubbles.",
      "secondary_message": null
    },
    {
      "id": 11,
      "primary_message": "Wipe rims and apply lids and rings.",
      "secondary_message": null
    },
    {
      "id": 12,
      "primary_message": "If you’re canning the pickles, process them for 10 minutes in a boiling water bath.",
      "secondary_message": null
    },
    {
      "id": 13,
      "primary_message": "When time is up, remove jars from canner and let cool.",
      "secondary_message": null
    },
    {
      "id": 14,
      "primary_message": "Sealed jars can be stored in a cool, dark place for up to 1 year. Refrigerator pickles should be placed in the fridge as soon as the jars are cool.",
      "secondary_message": null
    },
    {
      "id": 15,
      "primary_message": "Let pickles rest in pickling liquid for at least 48 hours before eating.",
      "secondary_message": null
    }
  ],
