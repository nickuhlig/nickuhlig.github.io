  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Toast the sliced almonds.",
      "secondary_message": "½ cup sliced almonds"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, combine milk and gelatin. Stir well to incorporate. Set aside and let gelatin bloom for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk iced coffee, sugar, salt, and vanilla aggressively until sugar is dissolved. In a small saucepan on very low heat, bring milk to a bare simmer, then stir into iced coffee.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Churn in ice cream machine according to manufacturer's instructions. Stir in toasted almonds and transfer to an airtight container, then freeze for 2 to 3 hours or until firmly set. Let sherbet sit at room temperature 10 to 15 minutes before serving.",
      "secondary_message": null
    }
