  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice and toast the blanched almonds and let them cool. Bring the unsalted butter to room temperature. Zest the orange. Slice the blanched almonds.",
      "secondary_message": "½ cup blanched almonds\n16 tbsp unsalted butter\n1 orange\n1 ½ cups blanched almonds"
    },
    {
      "id": 1,
      "primary_message": "In the bowl of a food processor, grind toasted almonds until the consistency of coarse flour. Add to a medium bowl with flour, baking powder, and salt. Stir to combine and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, beat together butter and sugar with an electric hand mixer until fluffy, about 3 minutes. Add egg yolk, orange zest, and vanilla; beat to combine. Add dry ingredients to the bowl and beat until it comes together into a dough. Divide dough into 2 equal pieces. Form each piece into a 1-inch wide log, cover with plastic wrap, and refrigerate 1 hour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven rack to lower and middle positions and preheat oven to 350°F. Line 2 baking sheets with parchment paper. Cut the first log of dough into 1/4-inch wide slices.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place egg white in a shallow bowl. Fill another shallow bowl with sliced almonds. Dip each cookie into egg white, then into sliced almonds to coat. Place on baking sheet. Repeat with remaining dough. Bake cookies until golden, about 15 minutes. Let cool 5 minutes then transfer to a wire rack. Dust with confectioners' sugar to coat.",
      "secondary_message": null
    }
  ],
