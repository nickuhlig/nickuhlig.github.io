  "instructions": [
    {
      "id": 151667,
      "primary_message": "Boil water in a kettle. (If you do not have a kettle, boil water in a saucepan, starting with hot tap water.) In a small bowl, pour boiling water over cashews and set aside to soak. ",
      "secondary_message": "1 ⅓ cup water\n⅔ cup cashews, roasted unsalted"
    },
    {
      "id": 151668,
      "primary_message": "In a small saucepan, combine quinoa and water. Bring to a boil. Reduce heat to low, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "⅔ cup quinoa\n1 ⅓ cup water"
    },
    {
      "id": 151669,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 151670,
      "primary_message": "Preheat a large skillet over medium heat. Add oil and swirl to coat the bottom. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 151671,
      "primary_message": "Add onions and garlic to the skillet and sauté until the onions are tender, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 151672,
      "primary_message": "Meanwhile, wash, dry, and medium dice celery and broccoli. ",
      "secondary_message": "2 sticks celery\n2 crowns broccoli"
    },
    {
      "id": 151673,
      "primary_message": "Roughly chop the sun-dried tomatoes. ",
      "secondary_message": "16 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 151674,
      "primary_message": "Increase the heat to medium-high and add the celery, broccoli, and sun-dried tomatoes to the skillet. Sauté until broccoli is tender, about 8 minutes. ",
      "secondary_message": null
    },
    {
      "id": 151675,
      "primary_message": "Drain the cashews and transfer them to a blender. ",
      "secondary_message": null
    },
    {
      "id": 151676,
      "primary_message": "Peel garlic. Add to the blender along with almond milk, nutritional yeast, Dijon, vinegar, salt, and onion powder. Blend until smooth; add water, 1 tbsp at a time, if needed, to make a thick sauce.",
      "secondary_message": "2 cloves garlic\n237 ml almond milk, unsweetened\n½ cup nutritional yeast flakes\n4 tsp Dijon mustard\n4 tsp white wine vinegar\n1 tsp salt\n½ tsp onion powder"
    },
    {
      "id": 151677,
      "primary_message": "Add the cooked quinoa, pumpkin seeds, and sauce to the vegetables in the skillet and stir to combine. ",
      "secondary_message": "¼ cup pumpkin seeds"
    },
    {
      "id": 151678,
      "primary_message": "Lay the tortillas on a flat surface and divide vegetable mixture between them. Roll tightly to close, folding in the ends.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 151679,
      "primary_message": "Return the skillet or a grill pan to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 151680,
      "primary_message": "Working in batches if necessary, place wraps on the grill and flip every 1-2 minutes, until tortilla is crispy and golden. ",
      "secondary_message": null
    },
    {
      "id": 151681,
      "primary_message": "To serve, cut wraps on an angle and divide between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
