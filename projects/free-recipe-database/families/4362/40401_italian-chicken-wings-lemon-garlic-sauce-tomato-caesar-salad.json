  "instructions": [
    {
      "id": 625782,
      "primary_message": "Preheat the oven to 500°F. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 625783,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch and spices, then toss to coat. Transfer to the baking sheet, spread out in an even layer, and drizzle with oil.",
      "secondary_message": "1 lb chicken wings, split with tips removed\n1 tbsp cornstarch\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 625784,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 625785,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 tomato\n½ head romaine lettuce"
    },
    {
      "id": 625786,
      "primary_message": "Peel and mince garlic. Divide between a clean medium bowl and a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 625787,
      "primary_message": "Zest lemon into the medium bowl with the garlic. Juice lemon into the small bowl with the garlic, then add mayo, salt, and pepper. Whisk to combine the lemon-garlic dipping sauce and set aside.",
      "secondary_message": "2 tbsp mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 625788,
      "primary_message": "Mince anchovy fillets. Add to the medium bowl along with oil, vinegar, honey, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 anchovy fillets, packed in oil\n2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 tsp honey\n¼ tsp black pepper"
    },
    {
      "id": 625789,
      "primary_message": "Halve tomato lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 625790,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 625791,
      "primary_message": "When the wings are almost done, using a peeler, shave Parmesan into curls. Add to the bowl and toss to combine the salad.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 625792,
      "primary_message": "Divide wings and salad between plates. Serve with dipping sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
