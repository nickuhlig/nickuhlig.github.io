  "instructions": [
    {
      "id": 625839,
      "primary_message": "Preheat the oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 625840,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 625841,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 tomatoes\n1 ½ heads romaine lettuce"
    },
    {
      "id": 625842,
      "primary_message": "Peel and mince garlic. Divide between a large bowl and a small bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 625843,
      "primary_message": "Zest lemons into the large bowl with the garlic. Juice lemons into the small bowl with the garlic, then add mayo, salt, and pepper. Whisk to combine the lemon-garlic sauce and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 625844,
      "primary_message": "Add soy sauce, oil, vinegar, honey, and pepper to the large bowl, then whisk to combine the dressing. Set aside.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 tbsp honey\n¾ tsp black pepper"
    },
    {
      "id": 625845,
      "primary_message": "Medium dice tofu and place in another large bowl. Add cornstarch and spices, then toss to coat. Wipe baking sheet dry with paper towels, then divide tofu between the baking sheet and another baking sheet. Spread out in an even layer and drizzle with oil.",
      "secondary_message": "3 tbsp cornstarch\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 625846,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, tossing once, until golden and warmed through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 625847,
      "primary_message": "Meanwhile, halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 625848,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 625849,
      "primary_message": "When the tofu is almost done, using a peeler, shave Parmesan into curls. Add to the bowl and toss to combine the salad.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 625850,
      "primary_message": "Divide tofu and salad between plates. Drizzle sauce over tofu and enjoy!",
      "secondary_message": null
    }
  ],
