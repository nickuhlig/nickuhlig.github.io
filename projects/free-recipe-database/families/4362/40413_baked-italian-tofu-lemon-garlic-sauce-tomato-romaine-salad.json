  "instructions": [
    {
      "id": 625920,
      "primary_message": "Preheat the oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 625921,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 625922,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 tomato\n½ head romaine lettuce"
    },
    {
      "id": 625923,
      "primary_message": "Peel and mince garlic. Divide between a medium bowl and a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 625924,
      "primary_message": "Zest lemon into the medium bowl with the garlic. Juice lemon into the small bowl with the garlic, then add mayo, salt, and pepper. Whisk to combine the lemon-garlic sauce and set aside.",
      "secondary_message": "2 tbsp mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 625925,
      "primary_message": "Add soy sauce, oil, vinegar, honey, and pepper to the medium bowl, then whisk to combine the dressing. Set aside.",
      "secondary_message": "1 tbsp soy sauce\n2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 tsp honey\n¼ tsp black pepper"
    },
    {
      "id": 625926,
      "primary_message": "Medium dice tofu and place in another medium bowl. Add cornstarch and spices, then toss to coat. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet. Spread out in an even layer and drizzle with oil.",
      "secondary_message": "1 tbsp cornstarch\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 625927,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, tossing once, until golden and warmed through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 625928,
      "primary_message": "Meanwhile, halve tomato lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 625929,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 625930,
      "primary_message": "When the tofu is almost done, using a peeler, shave Parmesan into curls. Add to the bowl and toss to combine the salad.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 625931,
      "primary_message": "Divide tofu and salad between plates. Drizzle sauce over tofu and enjoy!",
      "secondary_message": null
    }
  ],
