  "instructions": [
    {
      "id": 625909,
      "primary_message": "Preheat the oven to 260°C (500°F). Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 625910,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch and spices, then toss to coat. Divide between the baking sheets, spread out in an even layer, and drizzle with oil.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed\n3 tbsp cornstarch\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 625911,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 625912,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 tomatoes\n1 ½ heads romaine lettuce"
    },
    {
      "id": 625913,
      "primary_message": "Peel and mince garlic. Divide between a clean large bowl and a small bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 625914,
      "primary_message": "Zest lemons into the large bowl with the garlic. Juice lemons into the small bowl with the garlic, then add mayo, salt, and pepper. Whisk to combine the lemon-garlic dipping sauce and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 625915,
      "primary_message": "Mince anchovy fillets. Add to the large bowl along with oil, vinegar, honey, and pepper, then whisk to combine the dressing.",
      "secondary_message": "6 anchovy fillets, packed in oil\n2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 tbsp honey\n¾ tsp black pepper"
    },
    {
      "id": 625916,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 625917,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 625918,
      "primary_message": "When the wings are almost done, using a peeler, shave Parmesan into curls. Add to the bowl and toss to combine the salad.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 625919,
      "primary_message": "Divide wings and salad between plates. Serve with dipping sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
