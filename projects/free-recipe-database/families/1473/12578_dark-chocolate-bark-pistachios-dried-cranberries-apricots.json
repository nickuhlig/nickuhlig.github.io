  "instructions": [
    {
      "id": 212152,
      "primary_message": "Line the bottom of a baking dish with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 212153,
      "primary_message": "Fill a small saucepan about halfway with hot water (from the tap); cover and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 212154,
      "primary_message": "Meanwhile, small dice apricots; transfer to a small bowl along with cranberries and pistachios. Toss to combine the dried fruit mix and set aside.",
      "secondary_message": "4 dried apricots\n¼ cup dried cranberries\n¼ cup pistachios, unsalted"
    },
    {
      "id": 212155,
      "primary_message": "Uncover the pan and place another small, heat-proof, bowl over the simmering water, allowing it to sit on the rim. Add chocolate and oil to the bowl; using a silicone spatula, stir continuously, until melted.",
      "secondary_message": "⅔ cup dark chocolate chips\n1 tsp virgin coconut oil"
    },
    {
      "id": 212156,
      "primary_message": "Remove bowl from the heat, add vanilla and salt; stir until smooth.",
      "secondary_message": "¼ tsp vanilla extract\n1 pinch salt"
    },
    {
      "id": 212157,
      "primary_message": "Add half the dried fruit mix to the bowl and stir to incorporate. (Set remaining dried fruit mix aside.)",
      "secondary_message": null
    },
    {
      "id": 212158,
      "primary_message": "Pour chocolate mixture into the baking dish. Using a silicone spatula, spread out to a thickness of between ¼ and ½-inch. ",
      "secondary_message": null
    },
    {
      "id": 212159,
      "primary_message": "Sprinkle remaining dried fruit mix over the chocolate, pressing gently into the surface to adhere. Place baking dish in the freezer (or refrigerator if space is limited) and chill until firm, 5-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 212160,
      "primary_message": "Remove bark from the freezer, transfer to a cutting board, and chop into large pieces. Store in the freezer (or refrigerator) until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 212161,
      "primary_message": "To serve, divide chocolate bark between plates and enjoy!",
      "secondary_message": null
    }
  ],
