  "instructions": [
    {
      "id": 212361,
      "primary_message": "Line a the bottom of a large baking dish with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 212362,
      "primary_message": "Small dice apricots and transfer to a small bowl along with cranberries. Toss to combine the dried fruit mix and set aside.",
      "secondary_message": "12 dried apricots\n⅓ cup dried cranberries"
    },
    {
      "id": 212363,
      "primary_message": "Place oil in a medium saucepan and warm over medium heat. ",
      "secondary_message": "½ cup virgin coconut oil"
    },
    {
      "id": 212364,
      "primary_message": "Remove saucepan from the heat, add cocoa powder, maple syrup, vanilla, and salt. Whisk until smooth.",
      "secondary_message": "½ cup cocoa powder\n¼ cup pure maple syrup\n½ tsp vanilla extract\n⅛ tsp salt"
    },
    {
      "id": 212365,
      "primary_message": "Add half the dried fruit mix to the saucepan and stir to incorporate. (Set remaining dried fruit mix aside.)",
      "secondary_message": null
    },
    {
      "id": 212366,
      "primary_message": "Pour chocolate mixture into the baking dish. Using a silicone spatula, spread out to a thickness of between ¼ and ½-inch. ",
      "secondary_message": null
    },
    {
      "id": 212367,
      "primary_message": "Sprinkle remaining dried fruit mix over the chocolate, pressing gently into the surface to adhere. Place baking dish in the freezer and chill until firm, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 212368,
      "primary_message": "Remove bark from the freezer, transfer to a cutting board, and chop into large pieces. Store in the freezer until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 212369,
      "primary_message": "To serve, divide bark between plates and enjoy!",
      "secondary_message": null
    }
  ],
