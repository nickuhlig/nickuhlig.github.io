  "instructions": [
    {
      "id": 212325,
      "primary_message": "Line a the bottom of a baking dish with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 212326,
      "primary_message": "Small dice apricots; transfer to a small bowl along with cranberries and pistachios. Toss to combine the dried fruit mix and set aside.",
      "secondary_message": "4 dried apricots\n¼ cup dried cranberries\n¼ cup pistachios, unsalted"
    },
    {
      "id": 212327,
      "primary_message": "Place oil in a small saucepan and warm over medium heat. ",
      "secondary_message": "⅓ cup virgin coconut oil"
    },
    {
      "id": 212328,
      "primary_message": "Remove saucepan from the heat, add cocoa powder, maple syrup, vanilla, and salt. Whisk until smooth.",
      "secondary_message": "⅓ cup cocoa powder\n3 tbsp pure maple syrup\n¼ tsp vanilla extract\n1 pinch salt"
    },
    {
      "id": 212329,
      "primary_message": "Add half the dried fruit mix to the saucepan and stir to incorporate. (Set remaining dried fruit mix aside.)",
      "secondary_message": null
    },
    {
      "id": 212330,
      "primary_message": "Pour chocolate mixture into the baking dish. Using a silicone spatula, spread out to a thickness of between ¼ and ½-inch. ",
      "secondary_message": null
    },
    {
      "id": 212331,
      "primary_message": "Sprinkle remaining dried fruit mix over the chocolate, pressing gently into the surface to adhere. Place baking dish in the freezer and chill until firm, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 212332,
      "primary_message": "Remove bark from the freezer, transfer to a cutting board, and chop into large pieces. Store in the freezer until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 212333,
      "primary_message": "To serve, divide bark between plates and enjoy!",
      "secondary_message": null
    }
  ],
