  "instructions": [
    {
      "id": 187014,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line two baking sheet pans with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 187015,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 caps portobello mushrooms\n3 red bell peppers\n2 yellow bell peppers\n1 small pkg fresh basil\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 187016,
      "primary_message": "Remove mushroom stems and carefully scrape out the gills, place mushroom caps on one of the baking sheets. Drizzle with oil and season with salt and pepper. Place in the oven and broil, until soft and lightly charred around the edges, 4-5 minutes. Remove from oven.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 187017,
      "primary_message": "Meanwhile, seed and slice bell peppers into thin strips; place on the other baking sheet. Drizzle with oil and season with salt and pepper. Once the mushrooms are done cooking, place peppers in the oven and broil, until soft and lightly charred around the edges, 4-5 minutes. Remove from oven.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 187018,
      "primary_message": "Meanwhile, coarsely grate cheese and set aside.",
      "secondary_message": "1 ½ (227 g) blocks cheddar cheese"
    },
    {
      "id": 187019,
      "primary_message": "Combine vinegar, oil, honey, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup red wine vinegar\n2 tbsp extra virgin olive oil\n2 tbsp honey\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 187020,
      "primary_message": "Transfer the cooked peppers to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": null
    },
    {
      "id": 187021,
      "primary_message": "Whisk together flour, spices, and half of the milk in a medium saucepan. Heat over medium, whisking frequently, until thick, 2-3 minutes. Pour in remaining milk and whisk to combine.",
      "secondary_message": "3 tbsp all-purpose flour\n½ tsp onion powder\n½ tsp garlic powder\n532 ml whole milk"
    },
    {
      "id": 187022,
      "primary_message": "Once the milk is steaming, remove from heat, and add the cheese. Continue whisking until the cheese has melted, creating a thick sauce, about 3 minutes; set aside.",
      "secondary_message": null
    },
    {
      "id": 187023,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the peppers and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 187024,
      "primary_message": "Split and toast the buns, if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 187025,
      "primary_message": "Thinly slice mushrooms. Fill buns with mushrooms and drizzle with cheese sauce.",
      "secondary_message": null
    },
    {
      "id": 187026,
      "primary_message": "To serve, divide \"cheesesteaks\" and mixed greens between plates. Top greens with roasted peppers and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
