  "instructions": [
    {
      "id": 186974,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line two baking sheet pans with aluminum foil. Turn on overhead exhaust fan or open a window (this may get a little smoky). ",
      "secondary_message": null
    },
    {
      "id": 186975,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 red bell peppers\n2 yellow bell peppers\n1 small pkg fresh basil\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 186976,
      "primary_message": "Seed and slice bell peppers into thin strips, divide between the baking sheets, and drizzle with oil. Working in batches if necessary, place in the oven and broil, until peppers are soft and lightly charred around the edges, 4-5 minutes. Remove from oven.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 186977,
      "primary_message": "Meanwhile, coarsely grate cheese and set aside.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 186978,
      "primary_message": "Combine vinegar, honey, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup red wine vinegar\n2 tbsp honey\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 186979,
      "primary_message": "Transfer the cooked peppers to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": null
    },
    {
      "id": 186980,
      "primary_message": "Pat the steaks dry with paper towels and place on the baking sheets used for the peppers. Drizzle with oil and season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 186981,
      "primary_message": "Working in batches if necessary, place steaks in the oven and broil, flipping halfway through, until desired doneness, 8-10 minutes for medium. Remove from oven and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 186982,
      "primary_message": "Meanwhile, whisk together flour, spices, and half of the milk in a medium saucepan. Heat over medium, whisking frequently, until thick, 2-3 minutes. Pour in remaining milk and whisk to combine.",
      "secondary_message": "2 tbsp all-purpose flour\n½ tsp onion powder\n½ tsp garlic powder\n355 ml whole milk"
    },
    {
      "id": 186983,
      "primary_message": "Once the milk is steaming, remove from heat, and add the cheese. Continue whisking until the cheese has melted, creating a thick sauce, 2-3 minutes; set aside.",
      "secondary_message": null
    },
    {
      "id": 186984,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the peppers and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 186985,
      "primary_message": "Split and toast the buns, if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 186986,
      "primary_message": "Thinly slice steak against the grain. Fill buns with steak and drizzle with cheese sauce.",
      "secondary_message": null
    },
    {
      "id": 186987,
      "primary_message": "To serve, divide cheesesteaks and mixed greens between plates. Top greens with roasted peppers and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
