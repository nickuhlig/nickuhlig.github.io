  "instructions": [
    {
      "id": 186988,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a baking sheet pan with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 186989,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 caps portobello mushrooms\n1 red bell pepper\n½ yellow bell pepper\n½ small pkg fresh basil\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 186990,
      "primary_message": "Remove mushroom stems and carefully scrape out the gills, place mushroom caps on one half of the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 186991,
      "primary_message": "Seed and slice bell peppers into thin strips; place on the other half of the baking sheet. Drizzle the veggies with oil and season with salt and pepper. Place in the oven and broil, until veggies are soft and lightly charred around the edges, 4-5 minutes. Remove from oven.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 186992,
      "primary_message": "Meanwhile, coarsely grate cheese and set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 186993,
      "primary_message": "Combine vinegar, oil, honey, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp red wine vinegar\n2 tsp extra virgin olive oil\n2 tsp honey\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 186994,
      "primary_message": "Transfer the cooked peppers to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": null
    },
    {
      "id": 186995,
      "primary_message": "Whisk together flour, spices, and half of the milk in a small saucepan. Heat over medium, whisking frequently, until thick, 1-2 minutes. Pour in remaining milk and whisk to combine.",
      "secondary_message": "1 tbsp all-purpose flour\n⅛ tsp onion powder\n⅛ tsp garlic powder\n177 ml whole milk"
    },
    {
      "id": 186996,
      "primary_message": "Once the milk is steaming, remove from heat, and add the cheese. Continue whisking until the cheese has melted, creating a thick sauce, 2-3 minutes; set aside.",
      "secondary_message": null
    },
    {
      "id": 186997,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the peppers and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 186998,
      "primary_message": "Split and toast the buns, if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 186999,
      "primary_message": "Thinly slice mushrooms. Fill buns with mushrooms and drizzle with cheese sauce.",
      "secondary_message": null
    },
    {
      "id": 187000,
      "primary_message": "To serve, divide \"cheesesteaks\" and mixed greens between plates. Top greens with roasted peppers and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
