  "instructions": [
    {
      "id": 186826,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a baking sheet pan with aluminum foil. Turn on overhead exhaust fan or open a window (this may get a little smoky). ",
      "secondary_message": null
    },
    {
      "id": 186827,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 red bell pepper\n½ yellow bell pepper\n½ small pkg fresh basil\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 186828,
      "primary_message": "Seed and slice bell peppers into thin strips, transfer to the baking sheet, and drizzle with oil. Place in the oven and broil, until peppers are soft and lightly charred around the edges, 4-5 minutes. Remove from oven.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 186829,
      "primary_message": "Meanwhile, coarsely grate cheese and set aside.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 186830,
      "primary_message": "Combine vinegar, honey, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp red wine vinegar\n2 tsp honey\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 186831,
      "primary_message": "Transfer the cooked peppers to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": null
    },
    {
      "id": 186832,
      "primary_message": "Pat the steak dry with paper towels and place on the baking sheet used for the peppers. Drizzle with oil and season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 186833,
      "primary_message": "Place steak in the oven and broil, flipping halfway through, until desired doneness, 8-10 minutes for medium. Remove from oven and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 186834,
      "primary_message": "Meanwhile, whisk together flour, spices, and half of the milk in a small saucepan. Heat over medium, whisking frequently, until thick, 1-2 minutes. Pour in remaining milk and whisk to combine.",
      "secondary_message": "2 tsp all-purpose flour\n⅛ tsp onion powder\n⅛ tsp garlic powder\n4 fl oz (½ cup) whole milk"
    },
    {
      "id": 186835,
      "primary_message": "Once the milk is steaming, remove from heat, and add the cheese. Continue whisking until the cheese has melted, creating a thick sauce, 2-3 minutes; set aside.",
      "secondary_message": null
    },
    {
      "id": 186836,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the peppers and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 186837,
      "primary_message": "Split and toast the buns, if desired. ",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 186838,
      "primary_message": "Thinly slice steak against the grain. Fill buns with steak and drizzle with cheese sauce.",
      "secondary_message": null
    },
    {
      "id": 186839,
      "primary_message": "To serve, divide cheesesteaks and mixed greens between plates. Top greens with roasted peppers and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
