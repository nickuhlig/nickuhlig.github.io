  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 150°C (300°F). Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, mix together oats, pistachios, pumpkin seeds, coconut chips, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small saucepan, combine brown sugar, olive oil, and maple syrup. Bring heat to medium and whisk occasionally until sugar has dissolved. Pour over oat mixture.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spread oat mixture on prepared baking sheet. Bake until lightly golden, about 40 minutes. Remove from oven and mix in dried cherries.",
      "secondary_message": null
    }
  ],
