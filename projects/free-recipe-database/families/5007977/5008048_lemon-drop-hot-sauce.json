  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the stems and seeds from the dried lemon drop chile peppers. Peel the garlic.",
      "secondary_message": "28 g dried lemon drop chile peppers\n4 cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "In a skillet over medium heat, toast chiles, coriander, and cumin until just fragrant, about 10 seconds. Remove from heat and transfer to a blender along with garlic, vinegar, and olive oil. Blend until very smooth, scraping down sides of blender as needed, for 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour hot sauce through a fine-meshed strainer into a bowl. With a rubber spatula, push sauce through strainer to separate all liquid from chunks of pepper and spices. Add honey and salt to taste, starting with about 1/4 teaspoon, then transfer to a very clean bottle or jar. Store sauce in refrigerator, where it keeps well.",
      "secondary_message": null
    }
  ],
