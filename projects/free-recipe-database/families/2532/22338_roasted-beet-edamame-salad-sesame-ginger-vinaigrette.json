  "instructions": [
    {
      "id": 373530,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 373531,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium beets\n1 ½ (2 ½ cm) pieces ginger root\n1 small pkg chives"
    },
    {
      "id": 373532,
      "primary_message": "Trim, peel, and cut beets into ½-inch cubes. Divide between two baking sheet pans, drizzle with oil, season with salt and pepper, then toss to coat. Spread out in an even layer.",
      "secondary_message": "1 ½ tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 373533,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and roast, stirring halfway through, until beets are fork-tender, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 373534,
      "primary_message": "Meanwhile, place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 373535,
      "primary_message": "Peel and mince ginger and garlic. Place in a medium bowl along with vinegar, soy sauce, oil, and maple syrup. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp apple cider vinegar\n2 tbsp soy sauce\n1 tbsp toasted sesame oil\n1 tbsp pure maple syrup"
    },
    {
      "id": 373536,
      "primary_message": "Chop chives into small pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 373537,
      "primary_message": "When the beets are done, carefully transfer to the bowl with the dressing. Add edamame and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 373538,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
