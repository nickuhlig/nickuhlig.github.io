  "instructions": [
    {
      "id": 516084,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 516085,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n1 ½ English cucumbers\n3 tomatoes\n1 ½ yellow bell peppers"
    },
    {
      "id": 516086,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Divide between two large bowls. (Set one bowl aside for the Greek salad.)",
      "secondary_message": null
    },
    {
      "id": 516087,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the dill.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 516088,
      "primary_message": "Roughly chop capers. Add to the bowl along with half of the feta, yogurt, salt, and pepper. Stir to combine the creamy dressing. (Reserve remaining feta for serving.)",
      "secondary_message": "3 tbsp capers\n1 ½ (113 g) pkgs crumbled feta cheese\n1 ½ cups plain Greek yogurt\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 516089,
      "primary_message": "Drain tuna, add to the bowl with the creamy dressing, and flake with a fork. Stir to combine the tuna salad and set aside.",
      "secondary_message": "6 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 516090,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 516091,
      "primary_message": "Meanwhile, add oil, vinegar, and spices to the remaining large bowl with the dill. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 516092,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 516093,
      "primary_message": "Medium dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 516094,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 516095,
      "primary_message": "Roughly chop olives. Add to the bowl and stir to combine the Greek salad.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 516096,
      "primary_message": "Spread the tuna salad over each flatbread, then top with the Greek salad and reserved feta.",
      "secondary_message": null
    },
    {
      "id": 516097,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
