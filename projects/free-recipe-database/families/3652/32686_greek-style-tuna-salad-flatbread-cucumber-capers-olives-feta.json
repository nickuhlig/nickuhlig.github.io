  "instructions": [
    {
      "id": 515975,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 515976,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch fresh dill\n½ English cucumber\n1 tomato\n½ yellow bell pepper"
    },
    {
      "id": 515977,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Divide between two medium bowls. (Set one bowl aside for the Greek salad.)",
      "secondary_message": null
    },
    {
      "id": 515978,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the dill.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 515979,
      "primary_message": "Roughly chop capers. Add to the bowl along with half of the feta, yogurt, salt, and pepper. Stir to combine the creamy dressing. (Reserve remaining feta for serving.)",
      "secondary_message": "1 tbsp capers\n½ (4 oz) pkg crumbled feta cheese\n½ cup plain Greek yogurt\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 515980,
      "primary_message": "Drain tuna, add to the bowl with the creamy dressing, and flake with a fork. Stir to combine the tuna salad and set aside.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 515981,
      "primary_message": "Arrange flatbreads on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 515982,
      "primary_message": "Meanwhile, add oil, vinegar, and spices to the remaining medium bowl with the dill. Whisk to combine the dressing.",
      "secondary_message": "1 tsp extra virgin olive oil\n1 tsp red wine vinegar\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 515983,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 515984,
      "primary_message": "Medium dice tomato. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 515985,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 515986,
      "primary_message": "Roughly chop olives. Add to the bowl and stir to combine the Greek salad.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 515987,
      "primary_message": "Spread the tuna salad over each flatbread, then top with the Greek salad and reserved feta.",
      "secondary_message": null
    },
    {
      "id": 515988,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
