  "instructions": [
    {
      "id": 516030,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 516031,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n1 English cucumber\n2 tomatoes\n1 yellow bell pepper"
    },
    {
      "id": 516032,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Divide between two medium bowls. (Set one bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 516033,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the dill.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 516034,
      "primary_message": "Roughly chop capers. Add to the bowl along with half of the feta, cottage cheese, yogurt, salt, and pepper. Stir to combine the topping and set aside. (Reserve remaining feta for serving.)",
      "secondary_message": "2 tbsp capers\n1 (4 oz) pkg crumbled feta cheese\n1 cup cottage cheese\n1 cup plain Greek yogurt\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 516035,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 516036,
      "primary_message": "Meanwhile, add oil, vinegar, and spices to the remaining medium bowl with the dill. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp red wine vinegar\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 516037,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 516038,
      "primary_message": "Medium dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 516039,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 516040,
      "primary_message": "Roughly chop olives. Add to the bowl and stir to combine the salad.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 516041,
      "primary_message": "Spread the cottage cheese topping over each flatbread, then top with the salad and reserved feta.",
      "secondary_message": null
    },
    {
      "id": 516042,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
