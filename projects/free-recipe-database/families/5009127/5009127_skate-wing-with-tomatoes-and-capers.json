  "instructions": [
    {
      "id": 1,
      "primary_message": "To cook fillets: Dredge each section of skate wing with flour and shake fillets to remove excess flour. Heat skillet over medium heat and add half of the butter to pan. Add skate fillets to pan and pan-fry on one side until surface is golden-brown, then add the rest of the butter to pan and pan-fry on other side, 1 to 2 minutes per side. Remove fillets from pan and keep on warmed plates.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add shallots to pan and cook over medium heat until softened, about 3 minutes. Add tomatoes and capers, making sure to include the juices of the tomatoes. Simmer until mixture begins to look like a thickened sauce, about 2 minutes. Remove from heat and add olive oil, salt, and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spoon sauce over and around each fish fillet. Serve immediately.",
      "secondary_message": null
    }
  ],
