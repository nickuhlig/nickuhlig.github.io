  "instructions": [
    {
      "id": 404568,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 404569,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 small bunches Italian (flat-leaf) parsley\n2 small pkgs grape tomatoes\n2 English cucumbers"
    },
    {
      "id": 404570,
      "primary_message": "Zest lemons into a small bowl. Add salt and pepper, then stir to combine the lemon seasoning. (Reserve lemons for later use.)",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 404571,
      "primary_message": "Pat chicken dry with paper towels, transfer to the baking sheet, and sprinkle with lemon seasoning on both sides. (Reserve bowl for later use.)",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 404572,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken is golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 404573,
      "primary_message": "Meanwhile, juice one lemon into the small reserved bowl. Juice the remaining lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 404574,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide parsley between the two bowls, then set the medium bowl aside for later use.",
      "secondary_message": null
    },
    {
      "id": 404575,
      "primary_message": "Add tahini, water, vinegar, and spices to the small bowl. Whisk to combine the lemon-tahini sauce and set aside.",
      "secondary_message": "¼ cup tahini\n¼ cup water\n1 tsp rice vinegar\n½ tsp garlic powder\n½ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 404576,
      "primary_message": "Add oil, additional vinegar, salt, and pepper to the medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tsp rice vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 404577,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the dressing.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 404578,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 404579,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl, along with the feta, and gently stir to combine the salad.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 404580,
      "primary_message": "To serve, divide chicken and salad between plates. Drizzle chicken with lemon-tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
