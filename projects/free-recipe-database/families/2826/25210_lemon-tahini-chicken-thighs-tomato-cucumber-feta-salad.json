  "instructions": [
    {
      "id": 404516,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 404517,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 pint grape tomatoes\n1 English cucumber"
    },
    {
      "id": 404518,
      "primary_message": "Zest lemon into a small bowl. Add salt and pepper, then stir to combine the lemon seasoning. (Reserve lemon for later use.)",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 404519,
      "primary_message": "Pat chicken dry with paper towels, transfer to the baking sheet, and sprinkle with lemon seasoning on both sides. (Reserve bowl for later use.)",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 404520,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken is golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 404521,
      "primary_message": "Meanwhile, juice half of the lemon into the small reserved bowl. Juice the remaining lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 404522,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide parsley between the two bowls, then set the medium bowl aside for later use.",
      "secondary_message": null
    },
    {
      "id": 404523,
      "primary_message": "Add tahini, water, vinegar, and spices to the small bowl. Whisk to combine the lemon-tahini sauce and set aside.",
      "secondary_message": "2 tbsp tahini\n2 tbsp water\n½ tsp rice vinegar\n¼ tsp garlic powder\n¼ tsp black pepper\n1 pinch salt"
    },
    {
      "id": 404524,
      "primary_message": "Add oil, additional vinegar, salt, and pepper to the medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp rice vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 404525,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 404526,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 404527,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl, along with the feta, and gently stir to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 404528,
      "primary_message": "To serve, divide chicken and salad between plates. Drizzle chicken with lemon-tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
