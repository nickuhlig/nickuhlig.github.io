  "instructions": [
    {
      "id": 407625,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 jalapeño peppers\n1 small bunch green onions (scallions)\n2 small bunches cilantro\n6 sticks celery\n1 English cucumber"
    },
    {
      "id": 407626,
      "primary_message": "Peel and mince ginger. Place in a small bowl along with soy sauce, oil, chili-garlic sauce, and sugar. Whisk to combine the sauce and set aside for serving.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp toasted sesame oil\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar"
    },
    {
      "id": 407627,
      "primary_message": "Place vinegar, oil, sugar, and salt in a medium bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "⅓ cup rice vinegar\n4 tsp toasted sesame oil\n4 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 407628,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 407629,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt"
    },
    {
      "id": 407630,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 407631,
      "primary_message": "Meanwhile, thinly slice jalapeño peppers crosswise into rings; seed and remove ribs with a spoon to reduce spice level (optional). Add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 407632,
      "primary_message": "Trim and slice green onions on the diagonal into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 407633,
      "primary_message": "Trim and slice celery on the diagonal into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 407634,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 407635,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add the leaves to the bowl. Stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 407636,
      "primary_message": "Thinly slice steak against the grain. ",
      "secondary_message": null
    },
    {
      "id": 407637,
      "primary_message": "To serve, divide steak and salad between plates. Drizzle sauce over the steak and enjoy!",
      "secondary_message": null
    }
  ],
