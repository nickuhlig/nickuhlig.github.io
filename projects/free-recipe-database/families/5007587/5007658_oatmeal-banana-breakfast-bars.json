  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 190°C (375°F). Grease a 20-cm square baking pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, stir together oats, coconut, walnuts, apricots, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium bowl, mix together mashed bananas, sugar, and melted butter until combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add banana mixture to oats and stir until evenly incorporated. Spread mixture into prepared baking dish.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake until bars are golden brown, about 25 minutes. Let cool, then cut into squares.",
      "secondary_message": null
    }
