  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl combine the ground white pepper powder, soy sauce, salt, cornstarch, sesame oil, and water together. Mix well and add the minced garlic (see notes). Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring a large pot of water to boil. Add the chopped choy sum and cook until bright green, about 40 seconds. Drain well.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat vegetable oil in a wok over high heat until smoking. Add the choy sum, stir, and season with a few pinches of salt. Continue to cook while stirring regularly for about 2 minutes. Push the choy sum away from the center of the wok (see note). Stir the sauce and add it to the center. Once it starts bubbling, combine it with the choy sum. Season to taste with more salt as desired. Transfer to a serving platter and serve immediately.",
      "secondary_message": null
    }
  ],
