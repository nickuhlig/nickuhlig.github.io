  "instructions": [
    {
      "id": 14218,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "about 14 cups water\n2 tbsp salt\n340 g (4 ½ cups) penne pasta"
    },
    {
      "id": 14219,
      "primary_message": "Wash asparagus, snap off woody ends, and cut diagonally into 5 cm pieces. Add to pasta during the final 2-3 minutes of cooking time. Boil until bright green and tender-crisp.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 14220,
      "primary_message": "Wash lemons and grate 2 tsp of zest. Wash and chop chives into small pieces.",
      "secondary_message": "2 lemons\r\n1 small pkg chives"
    },
    {
      "id": 14221,
      "primary_message": "Heat a small saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 14222,
      "primary_message": "Add butter to saucepan and let it melt. Add flour and whisk until smooth.",
      "secondary_message": "2 tbsp butter, unsalted \r\n2 tbsp all-purpose flour"
    },
    {
      "id": 14223,
      "primary_message": "Add broth and, stirring constantly, cook until sauce thickens, 2-3 minutes.",
      "secondary_message": "236 ml (1 cup) chicken or vegetable broth"
    },
    {
      "id": 14224,
      "primary_message": "Add zest, lemon juice, goat cheese, ½ of the chives (save the rest for garnishing), and salt. Stir until smooth. Remove from heat.",
      "secondary_message": "juice of 1 lemon\r\n1 (113 g) log goat cheese\r\n1 tsp salt"
    },
    {
      "id": 14225,
      "primary_message": "Drain pasta and asparagus and return to pot.",
      "secondary_message": ""
    },
    {
      "id": 14226,
      "primary_message": "Add sauce to pasta and toss.",
      "secondary_message": ""
    },
    {
      "id": 14227,
      "primary_message": "Cut remaining lemon into wedges.",
      "secondary_message": ""
    },
    {
      "id": 14228,
      "primary_message": "To serve, place pasta in a bowl or on a plate. Garnish with pine nuts, remaining chives, freshly ground pepper, and lemon wedges. Enjoy!",
      "secondary_message": "¼ cup pine nuts"
    }
  ],
