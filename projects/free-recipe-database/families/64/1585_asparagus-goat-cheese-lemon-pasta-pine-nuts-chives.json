  "instructions": [
    {
      "id": 14207,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "about 7 cups water\n1 tbsp salt\n6 oz (2 ¼ cups) penne pasta"
    },
    {
      "id": 14208,
      "primary_message": "Wash asparagus, snap off woody ends, and cut diagonally into 2 inch pieces. Add to pasta during the final 2-3 minutes of cooking time. Boil until bright green and tender-crisp.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 14209,
      "primary_message": "Wash lemon and grate 1 tsp of zest. Wash and chop chives into small pieces.",
      "secondary_message": "1 lemon\r\n½ small pkg chives"
    },
    {
      "id": 14210,
      "primary_message": "Heat a small saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 14211,
      "primary_message": "Add butter to saucepan and let it melt. Add flour and whisk until smooth.",
      "secondary_message": "1 tbsp butter, unsalted \r\n1 tbsp all-purpose flour"
    },
    {
      "id": 14212,
      "primary_message": "Add broth and, stirring constantly, cook until sauce thickens, 2-3 minutes.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 14213,
      "primary_message": "Add zest, lemon juice, goat cheese, ½ of the chives (save the rest for garnishing), and salt. Stir until smooth. Remove from heat.",
      "secondary_message": "juice of ½ lemon\r\n½ (4 oz) log goat cheese\r\n½ tsp salt"
    },
    {
      "id": 14214,
      "primary_message": "Drain pasta and asparagus and return to saucepan.",
      "secondary_message": ""
    },
    {
      "id": 14215,
      "primary_message": "Add sauce to pasta and toss.",
      "secondary_message": ""
    },
    {
      "id": 14216,
      "primary_message": "Cut remaining ½ lemon into wedges.",
      "secondary_message": ""
    },
    {
      "id": 14217,
      "primary_message": "To serve, place pasta in a bowl or on a plate. Garnish with pine nuts, remaining chives, freshly ground pepper, and lemon wedges. Enjoy!",
      "secondary_message": "⅛ cup pine nuts"
    }
  ],
