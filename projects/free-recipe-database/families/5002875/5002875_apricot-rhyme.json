  "instructions": [
    {
      "id": 1,
      "primary_message": "For apricot infused rye: Combine dried apricots and rye in an airtight jar and let sit for 3 days. Strain out fruit.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the thyme simple syrup: Bring 1 cup water to a simmer, stir in sugar until dissolved. Add a fistful of fresh thyme. Once cool, pour syrup with thyme into a resealable jar, steep 24 hours before removing thyme.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the cocktail: Fill a cocktail shaker with ice. Add 1 1/2 ounces apricot infused rye, 3/4 ounce thyme simple syrup, 1/2 ounce dry vermouth, and squeezed lemon wedge (add peel to shaker.) Shake well, strain into ice-filled rocks glass, garnish with sprig of thyme.",
      "secondary_message": null
    }
  ],
