  "instructions": [
    {
      "id": 332269,
      "primary_message": "Place vinegar, ketchup, sugar, Worcestershire, Dijon, and spices in a small saucepan; stir to combine the BBQ sauce.",
      "secondary_message": "¾ cup balsamic vinegar\n¾ cup ketchup\n2 tbsp brown sugar\n1 ½ tbsp Worcestershire sauce\n1 ½ tbsp Dijon mustard\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 332270,
      "primary_message": "Bring sauce to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until thickened, about 10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 332271,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; slice lengthwise into ¼-inch thick strips. Place in a large bowl.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 332272,
      "primary_message": "Wash, dry, and slice mushrooms into ½-inch thick pieces; add to the bowl with the bell pepper.",
      "secondary_message": "6 caps portobello mushrooms"
    },
    {
      "id": 332273,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces; add to the bowl with the other veggies. Drizzle with oil, season with spices, and toss to coat.",
      "secondary_message": "1 ½ medium red onions\n2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 332274,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 332275,
      "primary_message": "Once the grill pan is hot, working in batches, add veggies and cook, turning occasionally, until tender, 8-10 minutes. Transfer veggies to a large plate and loosely cover with aluminum foil. (Reserve bowl for the next step).",
      "secondary_message": null
    },
    {
      "id": 332276,
      "primary_message": "Meanwhile, mince sun-dried tomatoes and capers; place both in the reserved bowl.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n4 ½ tbsp capers"
    },
    {
      "id": 332277,
      "primary_message": "Add beef and spices to the bowl with sun-dried tomatoes and capers; mix with your hands until well combined. Form the beef mixture into 6 equal-sized patties and place on another plate.",
      "secondary_message": "2 ¼ lb lean ground beef\n1 tbsp parsley flakes\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 332278,
      "primary_message": "Once the veggies are done, return the grill pan to medium-high heat and coat with oil. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 2-3 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 332279,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 332280,
      "primary_message": "To assemble the burgers, layer the bottom half of each bun with a patty, BBQ sauce, and a small portion of grilled veggies; close with the top half of each bun. (Reserve remaining veggies for serving.)",
      "secondary_message": null
    },
    {
      "id": 332281,
      "primary_message": "To serve, divide burgers and remaining veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
