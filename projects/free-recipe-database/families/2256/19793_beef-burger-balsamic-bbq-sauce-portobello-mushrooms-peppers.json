  "instructions": [
    {
      "id": 332243,
      "primary_message": "Place vinegar, ketchup, sugar, Worcestershire, Dijon, and spices in a small saucepan; stir to combine the BBQ sauce.",
      "secondary_message": "¼ cup balsamic vinegar\n¼ cup ketchup\n2 tsp brown sugar\n1 ½ tsp Worcestershire sauce\n1 ½ tsp Dijon mustard\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 332244,
      "primary_message": "Bring sauce to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until thickened, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 332245,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell pepper; slice lengthwise into ¼-inch thick strips. Place in a medium bowl.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 332246,
      "primary_message": "Wash, dry, and slice mushrooms into ½-inch thick pieces; add to the bowl with the bell pepper.",
      "secondary_message": "2 caps portobello mushrooms"
    },
    {
      "id": 332247,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 332248,
      "primary_message": "While the grill pan heats up, peel, halve, and slice onion lengthwise into ¼-inch thick pieces; add to the bowl with the other veggies. Drizzle with oil, season with spices, and toss to coat.",
      "secondary_message": "½ medium red onion\n2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 332249,
      "primary_message": "Once the grill pan is hot, add veggies and cook, turning occasionally, until tender, 8-10 minutes. Transfer veggies to a plate and loosely cover with aluminum foil. (Reserve bowl for the next step).",
      "secondary_message": null
    },
    {
      "id": 332250,
      "primary_message": "Meanwhile, mince sun-dried tomatoes and capers; place both in the reserved bowl.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed\n1 ½ tbsp capers"
    },
    {
      "id": 332251,
      "primary_message": "Add beef and spices to the bowl with sun-dried tomatoes and capers; mix with your hands until well combined. Form the beef mixture into 2 equal-sized patties and place on another plate.",
      "secondary_message": "¾ lb lean ground beef\n1 tsp parsley flakes\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 332252,
      "primary_message": "Once the veggies are done, return the grill pan to medium-high heat and coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 2-3 minutes, until cooked through. Once done, transfer to the plate with the veggies.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 332253,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 332254,
      "primary_message": "To assemble the burgers, layer the bottom half of each bun with a patty, BBQ sauce, and a small portion of grilled veggies; close with the top half of each bun. (Reserve remaining veggies for serving.)",
      "secondary_message": null
    },
    {
      "id": 332255,
      "primary_message": "To serve, divide burgers and remaining veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
