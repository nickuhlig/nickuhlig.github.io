  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 green bell peppers\n3 red bell peppers\n680 g white mushrooms"
    },
    {
      "primary_message": "Peel and mince ginger and garlic; place both in a small bowl along with soy sauce, vinegar, and honey. Whisk to combine the sauce.",
      "secondary_message": "6 cloves garlic\n3 tbsp rice vinegar\n2 tbsp honey"
    },
    {
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets; divide between two baking dishes. Pour half of the sauce over the chicken and turn to coat (reserve remaining sauce for later use).",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake until chicken is almost cooked through, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pot is hot, working in batches if necessary, add bacon and cook until crispy, 3-5 minutes per side. Remove bacon to a paper towel-lined plate. (Reserve pot with drippings for later use.)",
      "secondary_message": "12 slices bacon"
    },
    {
      "primary_message": "While the bacon cooks, using a clean cutting board, trim, seed, and thinly slice bell peppers; place in a large bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Thinly slice mushrooms and add to the bowl with the bell peppers.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and slice onions into thin half-moons; add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "primary_message": "Return pot (with drippings) to medium heat; add veggies and cook, stirring occasionally, until softened, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "primary_message": "When the chicken is almost cooked through, remove from oven. Change oven setting to broil on high.",
      "secondary_message": null
    },
    {
      "primary_message": "Layer chicken with bacon and cheese. Return baking dishes to the oven and broil until cheese is melted and chicken is cooked through, about 5 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "When the veggies are done, add remaining sauce to the pot, stir to combine, and continue to cook until heated through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide veggies and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
