  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Split and scrape the vanilla bean. Melt the unsalted butter.",
      "secondary_message": "1 vanilla bean\n43 g unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "For the Batter: In a large bowl, combine flour, powdered sugar, salt, baking soda, baking powder, and scrapings of one large vanilla bean, mixing by hand until the seeds are well dispersed. Add buttermilk, melted butter, egg whites, and vanilla extract and whisk until smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Waffles: Set waffle iron to medium and preheat until indicator is ready. For an 20-cm square machine, scrape in roughly half the batter. For a 18-cm Belgian machine, scrape in about one-third. Close lid and cook until waffle is golden brown but still steaming, 4 1/2 to 6 minutes depending on the depth and heat of your machine. Serve immediately, with copious amounts of maple syrup, and griddle remaining batter as before.",
      "secondary_message": null
    }
  ],
