  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Brined Pork Chops: In a large bowl, whisk together water, salt, and sugar until solids are dissolved. Place pork chops in brine and refrigerate for 30 to 60 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Rub: In a small bowl, mix together paprika, salt, black pepper, sugar, cayenne pepper, garlic powder, onion powder, and cumin. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To make the glaze: In a small saucepan, whisk together apricot preserves, honey, mustard, soy sauce, vinegar, and chipotle chiles. Bring to a boil over medium-high heat. Reduce heat to low and simmer until slightly thickened, 5 to 10 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove pork chops from brine and pat dry with paper towels. Cut pork into 4-cm cubes, trimming any large pieces of excess fat. Coat pork cubes liberally with spice rub.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Thread pork onto skewers, alternating with pineapple cubes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange coals on one side of the charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Grill skewers over direct heat until pork is well seared on all sides, about 3 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Move skewers to cool side of grill and brush with glaze all over. Cover grill and continue to cook until center of pork registers 140° to 63°C (60° to 63°C) on an instant-read thermometer, about 5 minutes longer. Transfer skewers to a serving tray and let rest for 5 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
