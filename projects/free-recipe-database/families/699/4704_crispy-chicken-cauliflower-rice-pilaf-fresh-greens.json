  "instructions": [
    {
      "id": 83581,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 83582,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n½ small bunch Italian (flat-leaf) parsley\n½ (142 g) pkg spring mix (mixed greens)\n½ lemon"
    },
    {
      "id": 83583,
      "primary_message": "Preheat a cast iron or oven-proof skillet (if available) over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 83584,
      "primary_message": "Meanwhile, pat the chicken dry with paper towel and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.57 kg chicken drumsticks\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 83585,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the chicken to the skillet and cook until skin is golden and crispy, about 4 minutes; flip and repeat on other side.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 83586,
      "primary_message": "Place skillet in the oven and continue cooking for 15 minutes, or until cooked through. If your skillet is not oven proof, transfer to a baking dish with a wire rack.",
      "secondary_message": null
    },
    {
      "id": 83587,
      "primary_message": "Remove the leaves from the cauliflower. Using a food processor or box grater, grate to rice-like texture. Transfer to a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 83588,
      "primary_message": "Place a medium saucepan over medium heat. Add butter, onion powder, garlic powder, paprika, turmeric, cayenne pepper, and salt.",
      "secondary_message": "2 tbsp butter, unsalted\n¼ tsp onion powder\n¼ tsp garlic powder\n¼ tsp paprika\n¼ tsp turmeric\n1 pinch cayenne pepper\n¼ tsp salt"
    },
    {
      "id": 83589,
      "primary_message": "Once the butter is fully melted, add the cauliflower and cook for 2 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 83590,
      "primary_message": "Add broth to the cauliflower and cook for another 5-7 minutes.",
      "secondary_message": "59 ml chicken or vegetable broth"
    },
    {
      "id": 83591,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Stir into the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 83592,
      "primary_message": "Cut lemon into wedges. Toss the mixed greens with oil and a squeeze of lemon.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 83593,
      "primary_message": "To serve, arrange chicken, cauliflower-rice, and greens on plates. Serve with lemon wedges, if desired, enjoy!",
      "secondary_message": null
    }
  ],
