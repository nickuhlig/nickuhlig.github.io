  "instructions": [
    {
      "id": 83607,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 83608,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ (142 g) pkg spring mix (mixed greens)\n1 ½ lemons"
    },
    {
      "id": 83609,
      "primary_message": "Preheat a cast iron or oven-proof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 83610,
      "primary_message": "Meanwhile, pat the chicken dry with paper towel and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.7 kg chicken drumsticks\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 83611,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the chicken to the skillet and cook until skin is golden and crispy, about 4 minutes; flip and repeat on the other side. Cook in batches is necessary.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 83612,
      "primary_message": "Transfer chicken to a baking dish with a wire rack and place in the oven and continue cooking for 15 minutes, or until cooked through.",
      "secondary_message": null
    },
    {
      "id": 83613,
      "primary_message": "Remove the leaves from the cauliflower. Using a food processor or box grater, grate to rice-like texture. Transfer to a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 83614,
      "primary_message": "Place a large pot over medium heat. Add butter, onion powder, garlic powder, paprika, turmeric, cayenne pepper, and salt.",
      "secondary_message": "⅓ cup butter, unsalted\n¾ tsp onion powder\n¾ tsp garlic powder\n¾ tsp paprika\n¾ tsp turmeric\n3 pinch cayenne pepper\n¾ tsp salt"
    },
    {
      "id": 83615,
      "primary_message": "Once the butter is fully melted, add the cauliflower and cook for 2 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 83616,
      "primary_message": "Add broth to the cauliflower and cook for another 5-7 minutes.",
      "secondary_message": "177 ml chicken or vegetable broth"
    },
    {
      "id": 83617,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Stir into the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 83618,
      "primary_message": "Cut lemons into wedges. Toss the mixed greens with oil and a squeeze of lemon.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 83619,
      "primary_message": "To serve, arrange chicken, cauliflower-rice, and greens on plates. Serve with lemon wedges, if desired, enjoy!",
      "secondary_message": null
    }
  ],
