  "instructions": [
    {
      "id": 132640,
      "primary_message": "Wash, peel, and trim off the ends of the carrots. Chop into 1-inch chunks and add to blender. ",
      "secondary_message": "2 medium carrots"
    },
    {
      "id": 132641,
      "primary_message": "Wash, dry, peel, and slice ginger; add to blender. (If you have a high powered blender, you can put the peeled chunk in whole). ",
      "secondary_message": "½ (2 ½ cm) piece ginger root"
    },
    {
      "id": 132642,
      "primary_message": "Peel bananas, break into chunks and add to blender. ",
      "secondary_message": "2 bananas"
    },
    {
      "id": 132643,
      "primary_message": "Add almond milk, yogurt, mango, walnuts, coconut, cinnamon, and 4 ice cubes to the blender.",
      "secondary_message": "296 ml almond milk, unsweetened\n½ cup plain Greek yogurt\n1 cup frozen mangoes\n¼ cup walnuts\n½ tsp cinnamon"
    },
    {
      "id": 132644,
      "primary_message": "Blend on high speed for several minutes until smooth. ",
      "secondary_message": null
    },
    {
      "id": 132645,
