  "instructions": [
    {
      "id": 132633,
      "primary_message": "This recipe will make about 12 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 132634,
      "primary_message": "Wash, peel, and trim off the ends of the carrots. Chop into 1-inch chunks and add to blender. ",
      "secondary_message": "6 medium carrots"
    },
    {
      "id": 132635,
      "primary_message": "Wash, dry, peel, and slice ginger; add to blender. (If you have a high powered blender, you can put the peeled chunk in whole). ",
      "secondary_message": "1 ½ (1 inch) pieces ginger root"
    },
    {
      "id": 132636,
      "primary_message": "Peel bananas, break into chunks and add to blender. ",
      "secondary_message": "6 bananas"
    },
    {
      "id": 132637,
      "primary_message": "Add almond milk, yogurt, mango, walnuts, coconut, cinnamon and 12 ice cubes to the blender.",
      "secondary_message": "30 fl oz (3 ¾ cups) almond milk, unsweetened\n1 ½ cups plain Greek yogurt\n3 cup frozen mangoes\n¾ cup walnuts\n1 ½ tsp cinnamon"
    },
    {
      "id": 132638,
      "primary_message": "Blend on high speed for several minutes until smooth. ",
      "secondary_message": null
    },
    {
      "id": 132639,
      "primary_message": "Pour the smoothie into glasses, sprinkle with shredded coconut and enjoy!",
      "secondary_message": "½ cup shredded unsweetened coconut"
    }
  ],
