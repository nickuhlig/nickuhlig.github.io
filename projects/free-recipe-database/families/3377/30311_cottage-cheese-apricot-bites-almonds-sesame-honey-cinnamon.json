  "instructions": [
    {
      "id": 483137,
      "primary_message": "Wash, dry, and halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Arrange on a baking sheet pan or platter, cut-side facing up.",
      "secondary_message": "12 apricots"
    },
    {
      "id": 483138,
      "primary_message": "Top each apricot half with 1 tablespoon of cottage cheese.",
      "secondary_message": "1 ⅓ cups cottage cheese"
    },
    {
      "id": 483139,
      "primary_message": "Roughly chop almonds. Sprinkle almonds and sesame seeds over the apricots.",
      "secondary_message": "⅔ cup almonds\n1 tsp sesame seeds"
    },
    {
      "id": 483140,
      "primary_message": "To serve, divide apricots between plates. Drizzle with honey and sprinkle with cinnamon. Enjoy!",
      "secondary_message": "3 tbsp honey\n½ tsp cinnamon, ground"
    }
  ],
