  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 375°F. Spread chips into 13- by 9-inch baking dish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in small saucepan over medium heat until shimmering. Add mushrooms, 1/2 teaspoon salt, 1/4 teaspoon pepper, and cook, stirring, until mushrooms are just beginning to soften, about 2 minutes; set aside. toss chopped spinach with remaining tablespoon olive oil and season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Scatter spinach over chips. Lay strips of brie over spinach and chips. Scatter mushrooms, blue cheese, and onion over the top. Bake until brie is just melted, about 20 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
