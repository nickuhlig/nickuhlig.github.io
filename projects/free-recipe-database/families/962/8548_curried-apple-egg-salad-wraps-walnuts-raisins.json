  "instructions": [
    {
      "id": 129620,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil over high heat. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "5 eggs"
    },
    {
      "id": 129621,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 Gala apple\n2 sticks celery\n1 bunch kale"
    },
    {
      "id": 129622,
      "primary_message": "Juice the lemon into a large bowl. Add mayo, Dijon, and spices; whisk dressing until well combined. ",
      "secondary_message": "¼ cup mayonnaise\n1 tbsp Dijon mustard\n½ tsp garlic powder\n½ tsp curry powder\n¼ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 129623,
      "primary_message": "Core and medium dice apple. Medium dice celery. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 129624,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the dressing.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 129625,
      "primary_message": "Peel and medium dice the eggs. Add eggs and raisins to the bowl and stir until well combined.",
      "secondary_message": "⅛ cup raisins"
    },
    {
      "id": 129626,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the thickest part of the stems. Lay leaves flat and fill with curried egg salad. Roll like a burrito and secure with a toothpick if needed. ",
      "secondary_message": null
    },
    {
      "id": 129627,
      "primary_message": "To serve, divide curried egg wraps between plates and enjoy! ",
      "secondary_message": null
    }
  ],
