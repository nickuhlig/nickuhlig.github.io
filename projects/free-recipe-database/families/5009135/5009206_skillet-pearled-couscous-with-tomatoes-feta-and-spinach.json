  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the shallot. Halve the grape tomatoes. Thinly slice the scallions.",
      "secondary_message": "1 small shallot\n473 ml grape tomatoes\n3 scallions, light green parts only"
    },
    {
      "id": 1,
      "primary_message": "Heat 1 tablespoon of olive oil in a 30-cm skillet over medium-high heat until shimmering. Add the shallots, the chili flakes, and a pinch of salt. Cook, stirring, until softened, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the couscous and broth to the pan and simmer, season lightly with salt and pepper, and cook until most of the liquid is absorbed, about 12 minutes. Off the heat, stir in the grape tomatoes, spinach, scallions, half of the cheese and the lemon juice and stir to combine and lightly wilt the spinach. Adjust the seasoning as needed and then top with the remaining cheese and basil. Serve immediately.",
      "secondary_message": null
    }
