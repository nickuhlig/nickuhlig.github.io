  "instructions": [
    {
      "id": 493871,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 493872,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch fresh dill\n6 grapefruits\n1 ½ avocados\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 493873,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with oil, vinegar, Dijon, sugar, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp brown sugar\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 493874,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493875,
      "primary_message": "While the pan heats up, cut the tofu planks in half crosswise and place on a plate; season with spices on both sides.",
      "secondary_message": "1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 493876,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add tofu and grill until golden and warmed through, 3-4 minutes per side. Return to the plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 493877,
      "primary_message": "Meanwhile, cut off skin and white pith from the grapefruits. Slice between membranes to release segments; roughly chop. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493878,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493879,
      "primary_message": "Add arugula to the bowl, along with feta, and toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 493880,
      "primary_message": "To serve, divide salad and tofu between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
