  "instructions": [
    {
      "id": 493901,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493902,
      "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 493903,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 493904,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch fresh dill\n6 grapefruits\n1 ½ avocados\n3 (142 g) pkgs baby arugula"
    },
    {
      "id": 493905,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with oil, vinegar, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 493906,
      "primary_message": "Cut off skin and white pith from the grapefruits. Slice between membranes to release segments; roughly chop. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493907,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493908,
      "primary_message": "Add arugula to the bowl, along with feta, and toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    },
    {
      "id": 493909,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 493910,
      "primary_message": "To serve, divide salad and chops between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
