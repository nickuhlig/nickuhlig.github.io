  "instructions": [
    {
      "id": 493911,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 493912,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small bunch fresh dill\n2 grapefruits\n½ avocado\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 493913,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with oil, vinegar, Dijon, sugar, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n1 tsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 493914,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493915,
      "primary_message": "While the pan heats up, cut the tofu planks in half crosswise and place on a plate; season with spices on both sides.",
      "secondary_message": "½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 493916,
      "primary_message": "Once the pan is hot, coat with oil. Add tofu and grill until golden and warmed through, 3-4 minutes per side. Return to the plate. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 493917,
      "primary_message": "Meanwhile, cut off skin and white pith from the grapefruits. Slice between membranes to release segments; roughly chop. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493918,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493919,
      "primary_message": "Add arugula to the bowl, along with feta, and toss to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 493920,
      "primary_message": "To serve, divide salad and tofu between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
