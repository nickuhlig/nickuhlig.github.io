  "instructions": [
    {
      "id": 493821,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493822,
      "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 pork chops, boneless\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 493823,
      "primary_message": "Once the pan is hot, coat with oil. Add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 493824,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small bunch fresh dill\n2 grapefruits\n½ avocado\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 493825,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with oil, vinegar, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 493826,
      "primary_message": "Cut off skin and white pith from the grapefruits. Slice between membranes to release segments; roughly chop. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493827,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493828,
      "primary_message": "Add arugula to the bowl, along with feta, and toss to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 493829,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 493830,
      "primary_message": "To serve, divide salad and chops between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
