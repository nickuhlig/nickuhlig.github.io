  "instructions": [
    {
      "id": 549763,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 549764,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 549765,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch fresh dill\n1 small pkg chives\n1 ½ English cucumbers\n3 medium carrots\n3 red bell peppers"
    },
    {
      "id": 549766,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 549767,
      "primary_message": "Shave dill leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 549768,
      "primary_message": "Roughly chop chives. Add to the blender along with yogurt, mayo, salt, and pepper. Blend on high until herby ranch dressing is smooth, then set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ cup mayonnaise\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 549769,
      "primary_message": "Place bread crumbs and spices in a small bowl. Stir to combine and set aside.",
      "secondary_message": "1 ½ cup panko bread crumbs\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 549770,
      "primary_message": "Cut the tofu into ½-inch thick planks and place in a large bowl. Wipe the baking sheet dry with paper towels and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 549771,
      "primary_message": "Add mayo to the bowl with the tofu and gently toss to coat. Add seasoned bread crumbs, then gently toss once more to coat, pressing with your fingers to adhere.",
      "secondary_message": "¾ cup mayonnaise"
    },
    {
      "id": 549772,
      "primary_message": "Divide tofu between the reserved baking sheet and another baking sheet. Place baking sheets in the oven and bake, turning halfway through, until the breading is golden brown and crispy, about 18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 549773,
      "primary_message": "Meanwhile, trim and quarter cucumbers lengthwise, then cut crosswise into 3-inch long pieces; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 549774,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long pieces. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 549775,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 549776,
      "primary_message": "Divide tofu and veggie sticks between plates. Drizzle tofu with hot sauce and serve with dressing for dipping. Enjoy!",
      "secondary_message": "⅓ cup hot sauce"
    }
  ],
