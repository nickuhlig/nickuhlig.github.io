  "instructions": [
    {
      "id": 549651,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 549652,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 549653,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch fresh dill\n½ small pkg chives\n½ English cucumber\n1 medium carrot\n1 red bell pepper"
    },
    {
      "id": 549654,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 549655,
      "primary_message": "Shave dill leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 549656,
      "primary_message": "Roughly chop chives. Add to the blender along with yogurt, mayo, salt, and pepper. Blend on high until herby ranch dressing is smooth, then set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n3 tbsp mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 549657,
      "primary_message": "Place bread crumbs and spices in a small bowl. Stir to combine and set aside.",
      "secondary_message": "½ cup panko bread crumbs\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 549658,
      "primary_message": "Cut the tofu into ½-inch thick planks and place in a medium bowl. Wipe the baking sheet dry with paper towels and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 549659,
      "primary_message": "Add mayo to the bowl with the tofu and gently toss to coat. Add seasoned bread crumbs, then gently toss once more to coat, pressing with your fingers to adhere.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "id": 549660,
      "primary_message": "Transfer tofu to the reserved baking sheet. Place tofu in the oven and bake, turning halfway through, until the breading is golden brown and crispy, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 549661,
      "primary_message": "Meanwhile, trim and quarter cucumber lengthwise, then cut crosswise into 3-inch long pieces; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 549662,
      "primary_message": "Peel, trim, and quarter carrot lengthwise, then cut crosswise into 3-inch long pieces. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 549663,
      "primary_message": "Trim, seed, and slice bell pepper into thin strips; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 549664,
      "primary_message": "Divide tofu and veggie sticks between plates. Drizzle tofu with hot sauce and serve with dressing for dipping. Enjoy!",
      "secondary_message": "2 tbsp hot sauce"
    }
  ],
