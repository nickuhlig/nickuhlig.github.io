  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Zest and juice the lemon. Melt the unsalted butter.",
      "secondary_message": "1 lemon\n4 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 190°C (375°F). Grease a 24 cup mini muffin tin.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, rub together lemon zest and sugar until zest has released some of its oils and aromatics. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium bowl, whisk together flour, baking powder, an salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add melted butter to bowl with sugar and zest and whisk 1 minute. Add egg and whisk until well combined. Stir in milk. Add dry ingredients and stir until just combined. Stir in lemon juice.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Fill each mini muffin cup 3/4 full with batter. Place one raspberry, open side down, in center of each cup. Bake until golden and a cake tester inserted into a muffin comes out clean, 12 to 15 minutes. Let cool 15 minutes then release from pan.",
      "secondary_message": null
    }
  ],
