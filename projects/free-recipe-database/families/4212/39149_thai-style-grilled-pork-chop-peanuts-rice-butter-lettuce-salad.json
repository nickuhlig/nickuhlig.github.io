  "instructions": [
    {
      "id": 608492,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "1 ½ cups jasmine rice\n710 ml chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 608493,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ oranges\n1 ½ English cucumbers\n1 small pkg fresh mint\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 608494,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 608495,
      "primary_message": "While the rice is cooking, zest and juice half of the limes into a small bowl. (Reserve remaining limes for later use.)",
      "secondary_message": null
    },
    {
      "id": 608496,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime along with sugar, chili-garlic sauce, fish sauce, salt, and pepper, then stir to combine the marinade.",
      "secondary_message": "3 cloves garlic\n2 tbsp brown sugar\n1 tbsp chili-garlic sauce\n1 ½ tsp fish sauce\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 608497,
      "primary_message": "Pat the pork chops dry with paper towels and place in a large bowl. Pour half of the marinade over the pork, turn to coat, and set aside to marinate, 10 minutes. (Reserve remaining marinade for serving.)",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 608498,
      "primary_message": "Meanwhile, juice reserved limes and oranges into another large bowl. Add oil, sugar, and salt, then whisk to combine the dressing. ",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 608499,
      "primary_message": "Peel, halve, and slice shallots lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 608500,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 608501,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 608502,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 608503,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add pork chops, discarding any excess marinade left in the bowl, and grill until golden and cooked through, 4-5 minutes per side. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 608504,
      "primary_message": "Meanwhile, roughly chop peanuts. Set aside for serving.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 608505,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 608506,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 608507,
      "primary_message": "To serve, divide rice, salad, and pork between plates or bowls. Drizzle reserved marinade over the pork, then sprinkle with peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
