  "instructions": [
    {
      "id": 608271,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "½ cup jasmine rice\n8 fl oz (1 cup) chicken or vegetable broth\n¼ tsp salt"
    },
    {
      "id": 608272,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ orange\n½ English cucumber\n½ small pkg fresh mint\n½ head butter (Boston) lettuce"
    },
    {
      "id": 608273,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 608274,
      "primary_message": "While the rice is cooking, zest and juice half of the lime into a small bowl. (Reserve remaining lime for later use.)",
      "secondary_message": null
    },
    {
      "id": 608275,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime along with sugar, chili-garlic sauce, fish sauce, salt, and pepper, then stir to combine the marinade.",
      "secondary_message": "1 clove garlic\n2 tsp brown sugar\n1 tsp chili-garlic sauce\n½ tsp fish sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 608276,
      "primary_message": "Pat the pork chops dry with paper towels and place in a medium bowl. Pour half of the marinade over the pork, turn to coat, and set aside to marinate, 10 minutes. (Reserve remaining marinade for serving.)",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 608277,
      "primary_message": "Meanwhile, juice reserved lime and orange into another medium bowl. Add oil, sugar, and salt, then whisk to combine the dressing. ",
      "secondary_message": "2 tsp neutral vegetable oil\n1 tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 608278,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 608279,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 608280,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 608281,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 608282,
      "primary_message": "Once the pan is hot, coat with oil. Add pork chops, discarding any excess marinade left in the bowl, and grill until golden and cooked through, 4-5 minutes per side. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tsp neutral vegetable oil"
    },
    {
      "id": 608283,
      "primary_message": "Meanwhile, roughly chop peanuts. Set aside for serving.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 608284,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 608285,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 608286,
      "primary_message": "To serve, divide rice, salad, and pork between plates or bowls. Drizzle reserved marinade over the pork, then sprinkle with peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
