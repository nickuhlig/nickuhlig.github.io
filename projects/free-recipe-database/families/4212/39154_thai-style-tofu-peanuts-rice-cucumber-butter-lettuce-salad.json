  "instructions": [
    {
      "id": 608569,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 608570,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "1 cup jasmine rice\n473 ml chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 608571,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 orange\n1 English cucumber\n1 small pkg fresh mint\n1 head butter (Boston) lettuce"
    },
    {
      "id": 608572,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 608573,
      "primary_message": "While the rice is cooking, zest and juice one lime into a small bowl. (Reserve remaining lime for later use.)",
      "secondary_message": null
    },
    {
      "id": 608574,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime along with sugar, chili-garlic sauce, soy sauce, salt, and pepper, then stir to combine the marinade.",
      "secondary_message": "2 cloves garlic\n4 tsp brown sugar\n2 tsp chili-garlic sauce\n1 tsp soy sauce\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 608575,
      "primary_message": "Medium dice tofu; place in a medium bowl. Pour half of the marinade over the tofu, turn to coat, and set aside to marinate, 10 minutes. (Reserve remaining marinade for serving.)",
      "secondary_message": null
    },
    {
      "id": 608576,
      "primary_message": "Juice reserved lime and orange into another medium bowl. Add oil, sugar, and salt, then whisk to combine the dressing.",
      "secondary_message": "4 tsp neutral vegetable oil\n2 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 608577,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 608578,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 608579,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 608580,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 608581,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, stirring occasionally, until golden brown, 5-7 minutes. Transfer to a plate and loosely cover with aluminum foil. ",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 608582,
      "primary_message": "Meanwhile, roughly chop peanuts. Set aside for serving.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 608583,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 608584,
      "primary_message": "To serve, divide rice, salad, and tofu between plates or bowls. Drizzle reserved marinade over the tofu, then sprinkle with peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
