  "instructions": [
    {
      "id": 608585,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 608586,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "1 ½ cups jasmine rice\n710 ml chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 608587,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ oranges\n1 ½ English cucumbers\n1 small pkg fresh mint\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 608588,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 608589,
      "primary_message": "While the rice is cooking, zest and juice half of the limes into a small bowl. (Reserve remaining limes for later use.)",
      "secondary_message": null
    },
    {
      "id": 608590,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime along with sugar, chili-garlic sauce, soy sauce, salt, and pepper, then stir to combine the marinade.",
      "secondary_message": "3 cloves garlic\n2 tbsp brown sugar\n1 tbsp chili-garlic sauce\n1 ½ tsp soy sauce\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 608591,
      "primary_message": "Medium dice tofu; place in a large bowl. Pour half of the marinade over the tofu, turn to coat, and set aside to marinate, 10 minutes. (Reserve remaining marinade for serving.)",
      "secondary_message": null
    },
    {
      "id": 608592,
      "primary_message": "Juice reserved limes and oranges into another large bowl. Add oil, sugar, and salt, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 608593,
      "primary_message": "Peel, halve, and slice shallots lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 608594,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 608595,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 608596,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 608597,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, stirring occasionally, until golden brown, 5-7 minutes. Transfer to a plate and loosely cover with aluminum foil. ",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 608598,
      "primary_message": "Meanwhile, roughly chop peanuts. Set aside for serving.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 608599,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 608600,
      "primary_message": "To serve, divide rice, salad, and tofu between plates or bowls. Drizzle reserved marinade over the tofu, then sprinkle with peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
