  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash kumquats and pick over for any that have soft spots.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using a sharp paring knife, trim off the stem end and cut the kumquats in half. Pop out any visible seeds with the tip of your paring knife.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place the halved kumquats in a small saucepan and cover with cold water. Bring to a boil and then turn off the heat. Let the kumquats sit for 5 minutes. Drain.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In the same saucepan, combine vinegar, sugar and salt.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Place spices in the center of a length of cheesecloth or in a tea infuser and put into the pot with the vinegar and sugar. Bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Once the liquid has come to a boil, add the softened kumquats. Simmer for 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Remove pot from heat and funnel kumquats and liquid into prepared jars.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "For shelf stable jars, wipe rims, apply lids and rings and process in a boiling water canner for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "If making as a refrigerator pickle, let jars cool thoroughly and then store in refrigerator. Let pickles rest for 24 hours before eating.",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "Refrigerator pickles will keep 4 to 6 weeks. Unopened processed pickles will keep up to one year on the shelf.",
      "secondary_message": null
    }
  ],
