  "instructions": [
    {
      "id": 465508,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 465509,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 465510,
      "primary_message": "Wash, dry, trim, and quarter cucumbers lengthwise. Using the flat side of a chef's knife, press down on the skin-side of each quarter until it starts to split; cut or tear into bite-sized pieces.",
      "secondary_message": "2 English cucumbers"
    },
    {
      "id": 465511,
      "primary_message": "Transfer cucumber pieces to a colander and sprinkle with salt. Place the colander in a bowl to catch the excess liquid and set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 465512,
      "primary_message": "Place soy sauce, chili-garlic sauce, oil, and sugar in a medium bowl. Whisk to combine the marinade.",
      "secondary_message": "¼ cup soy sauce\n2 tbsp chili-garlic sauce\n1 tbsp toasted sesame oil\n2 tsp brown sugar"
    },
    {
      "id": 465513,
      "primary_message": "Medium dice tofu, add to the bowl with the marinade, and gently stir to coat. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 465514,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until tofu is golden, 13-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 465515,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 465516,
      "primary_message": "While the water is heating, place tahini, water, soy sauce, chili-garlic sauce, and sugar in the reserved bowl. Whisk to combine the sauce. ",
      "secondary_message": "⅓ cup tahini\n⅓ cup water\n¼ cup soy sauce\n1 tbsp chili-garlic sauce\n2 tsp brown sugar"
    },
    {
      "id": 465517,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add half to the bowl with the sauce and set aside (reserve remaining for serving).",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 465518,
      "primary_message": "Transfer cucumber to a plate. (Reserve colander for the next step.)",
      "secondary_message": null
    },
    {
      "id": 465519,
      "primary_message": "Once the water in the pot is boiling, add noodles. Cook noodles according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water.",
      "secondary_message": "10 oz soba (buckwheat) noodles"
    },
    {
      "id": 465520,
      "primary_message": "Transfer drained noodles to the bowl with the sauce and stir to coat. Add additional water, a teaspoon at a time, if necessary, to coat the noodles in sauce.",
      "secondary_message": null
    },
    {
      "id": 465521,
      "primary_message": "To serve, divide noodles, tofu, and smashed cucumbers between bowls. Top with sesame seeds and reserved green onions. Enjoy!",
      "secondary_message": "¼ cup sesame seeds"
    }
  ],
