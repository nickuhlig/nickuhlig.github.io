  "instructions": [
    {
      "id": 233059,
      "primary_message": "Preheat oven to 205°C (400°F). ",
      "secondary_message": null
    },
    {
      "id": 233060,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 233061,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 233062,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 233063,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 233064,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 233065,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half rounds. Add to the baking sheets with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 233066,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the baking sheets, reserving a small amount for garnish.",
      "secondary_message": null
    },
    {
      "id": 233067,
      "primary_message": "Juice lemon over the veggies.",
      "secondary_message": null
    },
    {
      "id": 233068,
      "primary_message": "Peel and mince garlic. Add to the baking sheets along with shrimp and spices; toss to combine.",
      "secondary_message": "6 cloves garlic\n1 ½ tsp salt\n1 ½ tsp Italian seasoning\n¾ tsp onion powder\n½ tsp black pepper"
    },
    {
      "id": 233069,
      "primary_message": "Cut butter into small pieces. Sprinkle feta over the shrimp and veggies; dot with butter.",
      "secondary_message": "⅓ cup butter, unsalted\n3 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 233070,
      "primary_message": "Place baking sheets in the oven and bake until veggies are tender and shrimp is cooked through, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 233071,
      "primary_message": "To serve, divide rice, shrimp, and veggies between plates. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
