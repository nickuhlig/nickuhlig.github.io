  "instructions": [
    {
      "id": 233072,
      "primary_message": "Preheat oven to 205°C (400°F). ",
      "secondary_message": null
    },
    {
      "id": 233073,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 medium zucchini squash\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 233074,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 233075,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to a large baking dish.",
      "secondary_message": null
    },
    {
      "id": 233076,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half rounds. Add to the baking dish with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 233077,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the baking dish, reserving a small amount for garnish.",
      "secondary_message": null
    },
    {
      "id": 233078,
      "primary_message": "Peel and mince garlic. Add to the baking dish along with shrimp and spices; toss to combine.",
      "secondary_message": "1 clove garlic\n½ tsp salt\n½ tsp Italian seasoning\n¼ tsp onion powder\n⅛ tsp black pepper"
    },
    {
      "id": 233079,
      "primary_message": "Cut butter into small pieces. Sprinkle feta over the shrimp and veggies; dot with butter.",
      "secondary_message": "3 tbsp butter, unsalted\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 233080,
      "primary_message": "Place baking dish in the oven and bake until veggies are tender and shrimp is cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 233081,
      "primary_message": "To serve, divide shrimp and veggies between plates. Top with reserved parsley and pine nuts. Enjoy!",
      "secondary_message": "⅛ cup pine nuts"
    }
  ],
