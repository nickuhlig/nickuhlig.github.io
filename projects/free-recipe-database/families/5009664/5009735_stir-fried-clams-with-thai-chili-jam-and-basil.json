  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and mince the garlic. Clean the clams. Cut the red jalapeno peppers lengthwise diagonally.",
      "secondary_message": "2 large cloves garlic\n0.91 kg clams, small\n3 large red jalapeno peppers"
    },
    {
      "id": 1,
      "primary_message": "Heat the oil in a large sauté pan or a wok over medium-high heat. Add the minced garlic and fry until it’s fragrant and just starting to turn light brown.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in Nam Prik Pao; mix well.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the clams and sliced peppers to the pan; close the lid. Shake the clams around to make sure they open up and are cooked evenly. After about 2 minutes, open the lid. Pick out the clams that don’t open up and discard them.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Check for seasoning. Add fish sauce to taste.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Stir in the basil leaves. Once they’re wilted, remove the pan from heat. Serve over rice.",
      "secondary_message": null
    }
