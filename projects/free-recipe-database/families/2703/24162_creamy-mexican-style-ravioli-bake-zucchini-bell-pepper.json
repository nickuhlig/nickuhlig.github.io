  "instructions": [
    {
      "id": 420266,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 420267,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n765 g cheese ravioli, fresh or frozen"
    },
    {
      "id": 420268,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice zucchini. Place in a large bowl.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 420269,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Add to the bowl with the zucchini.",
      "secondary_message": "3 yellow bell peppers"
    },
    {
      "id": 420270,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 420271,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420272,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, taco seasoning, and salt; cook, stirring occasionally, until starting to soften, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ cup taco seasoning\n¾ tsp salt"
    },
    {
      "id": 420273,
      "primary_message": "Add cooked ravioli, tomato sauce, cream, and salsa to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook until sauce thickens slightly, about 6 minutes. Remove from heat.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n355 ml heavy whipping cream\n1 ½ cup salsa"
    },
    {
      "id": 420274,
      "primary_message": "Transfer to a large baking dish and top with cheese. Place in the oven and bake until cheese is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 420275,
      "primary_message": "To serve, divide ravioli bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
