  "instructions": [
    {
      "id": 420246,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 420247,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "½ tsp salt\n255 g cheese ravioli, fresh or frozen"
    },
    {
      "id": 420248,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice zucchini. Place in a small bowl.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 420249,
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice. Add to the bowl with the zucchini.",
      "secondary_message": "1 yellow bell pepper"
    },
    {
      "id": 420250,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420251,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Add to the bowl with the zucchini and bell pepper.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 420252,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, taco seasoning, and salt; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tbsp taco seasoning\n¼ tsp salt"
    },
    {
      "id": 420253,
      "primary_message": "Add cooked ravioli, tomato sauce, cream, and salsa to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook until sauce thickens slightly, about 5 minutes. Remove from heat.",
      "secondary_message": "1 (213 ml) can tomato sauce\n118 ml (½ cup) heavy whipping cream\n½ cup salsa"
    },
    {
      "id": 420254,
      "primary_message": "Top skillet with cheese and place in the oven. Bake until cheese is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": "½ cup shredded cheese, Mexican blend"
    },
    {
      "id": 420255,
      "primary_message": "To serve, divide ravioli bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
