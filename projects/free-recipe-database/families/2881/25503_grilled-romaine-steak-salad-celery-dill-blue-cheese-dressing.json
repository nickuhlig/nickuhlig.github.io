  "instructions": [
    {
      "id": 408872,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n3 heads romaine lettuce\n6 sticks celery"
    },
    {
      "id": 408873,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place half of the dill in a medium bowl. (Reserve remaining dill for serving.)",
      "secondary_message": null
    },
    {
      "id": 408874,
      "primary_message": "Peel and mince shallots. Add to the bowl with the dill along with yogurt, mayo, vinegar, Dijon, sugar, and spices. Whisk until smooth.",
      "secondary_message": "2 shallots\n1 cup plain Greek yogurt\n3 tbsp mayonnaise\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp brown sugar\n¾ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 408875,
      "primary_message": "Add blue cheese to the bowl and whisk to combine the dressing; set aside.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    },
    {
      "id": 408876,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 408877,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 408878,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 408879,
      "primary_message": "Meanwhile, trim and quarter romaine heads lengthwise into wedges. Rub cut sides with oil, then season with salt and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 408880,
      "primary_message": "Working in batches if necessary, place romaine quarters, cut-side down, on the pan. Cook, turning halfway through, until charred and leaves begin to wilt, 3-4 minutes. Transfer to another plate.",
      "secondary_message": null
    },
    {
      "id": 408881,
      "primary_message": "Meanwhile, trim and medium dice celery.",
      "secondary_message": null
    },
    {
      "id": 408882,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 408883,
      "primary_message": "To serve, divide romaine between plates, arranging it grilled-side up. Top with steak, dressing, celery, and reserved dill. Enjoy!",
      "secondary_message": null
    }
  ],
