  "instructions": [
    {
      "id": 514574,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 514575,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n½ small bunch Italian (flat-leaf) parsley\n½ small bunch cilantro\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 514576,
      "primary_message": "Peel and medium dice potatoes; place in a medium saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 514577,
      "primary_message": "Meanwhile, shave parsley and cilantro leaves off the stems; discard stems and mince the leaves. Place herbs in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 514578,
      "primary_message": "Peel and mince shallot and garlic. Add both to the bowl with the herbs along with oil, vinegar, and spices. Stir to combine the chimichurri and set aside.",
      "secondary_message": "½ shallot\n1 clove garlic\n1 ½ tbsp extra virgin olive oil\n2 tsp red wine vinegar\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 514579,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 514580,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in a medium bowl, along with half of the chimichurri, and stir to coat. (Reserve remaining chimichurri for serving.)",
      "secondary_message": null
    },
    {
      "id": 514581,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning every few minutes, until golden, about 10 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 514582,
      "primary_message": "Meanwhile, peel and mince additional garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 514583,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add garlic and cook, stirring constantly, until fragrant, 15-30 seconds.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 514584,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, then remove from the heat. Cover to keep warm.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 514585,
      "primary_message": "When the potatoes are tender, drain in a clean colander and return to the pan. Add milk, oil, salt, and pepper, then mash until smooth.",
      "secondary_message": "59 ml (¼ cup) almond milk, unsweetened\n2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 514586,
      "primary_message": "To serve, divide mashed potatoes between plates or bowls, then top with garlicky spinach and tofu. Drizzle with reserved chimichurri and enjoy!",
      "secondary_message": null
    }
  ],
