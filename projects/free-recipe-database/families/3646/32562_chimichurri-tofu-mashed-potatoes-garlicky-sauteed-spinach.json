  "instructions": [
    {
      "id": 514405,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 514406,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium yellow potatoes\n2 small bunches Italian (flat-leaf) parsley\n1 small bunch cilantro\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 514407,
      "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 514408,
      "primary_message": "Meanwhile, shave parsley and cilantro leaves off the stems; discard stems and mince the leaves. Place herbs in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 514409,
      "primary_message": "Peel and mince shallot and garlic. Add to the bowl with the herbs along with oil, vinegar, and spices. Stir to combine the chimichurri and set aside.",
      "secondary_message": "1 shallot\n3 cloves garlic\n¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n¾ tsp oregano, dried\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 514410,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 514411,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in a large bowl, along with half of the chimichurri, and stir to coat. (Reserve remaining chimichurri for serving.)",
      "secondary_message": null
    },
    {
      "id": 514412,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and pan-fry, turning every few minutes, until golden, about 10 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 514413,
      "primary_message": "Meanwhile, peel and mince additional garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 514414,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add garlic and cook, stirring constantly, until fragrant, 15-30 seconds.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 514415,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, then remove from the heat. Cover to keep warm.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 514416,
      "primary_message": "When the potatoes are tender, drain in a clean colander and return to the pot. Add milk, oil, salt, and pepper, then mash until smooth.",
      "secondary_message": "6 fl oz (¾ cup) whole milk\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 514417,
      "primary_message": "To serve, divide mashed potatoes between plates or bowls, then top with garlicky spinach and tofu. Drizzle with reserved chimichurri and enjoy!",
      "secondary_message": null
    }
  ],
