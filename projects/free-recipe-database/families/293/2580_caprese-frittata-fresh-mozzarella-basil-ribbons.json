  "instructions": [
    {
      "id": 25007,
      "primary_message": "Wash the fresh produce. Pick the basil leaves off the stems; discard the stems and slice the leaves crosswise into ribbons. Slice the tomatoes into rounds. Peel and mince the garlic.",
      "secondary_message": "1 small pkg fresh basil\r\n6 tomatoes\r\n4 cloves garlic"
    },
    {
      "id": 25008,
      "primary_message": "Slice the mozzarella into rounds.",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese\r\n"
    },
    {
      "id": 25009,
      "primary_message": "Preheat the broiler and position rack in the upper third of the oven.",
      "secondary_message": ""
    },
    {
      "id": 25010,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 25011,
      "primary_message": "Add olive oil to the skillet and swirl to coat bottom. Add garlic and cook until fragrant, 15-30 seconds. Reserve 5 or 6 tomato slices for later while adding the rest to the skillet. Cook until tomatoes begin to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n"
    },
    {
      "id": 25012,
      "primary_message": "Meanwhile, in a large bowl, whisk together the eggs, water, ½ of the basil ribbons (save the rest for garnishing), salt, and pepper.",
      "secondary_message": "12 eggs\r\n4 tbsp water\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25013,
      "primary_message": "Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm by the top is still runny, 5-7 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25014,
      "primary_message": "Top frittata with mozzarella and remaining tomato slices. Place skillet in the oven until the top is set, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25015,
      "primary_message": "To serve, cut frittata into wedges and garnish with remaining basil ribbons and freshly ground pepper. Enjoy!",
      "secondary_message": ""
    }
  ],
