  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine gin, tonic syrup, simple syrup, bitters, and lime juice in a resealable container. Seal and store in freezer at least 1 and up to 10 hours, then pour into blender.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add ice to blender and blend until smooth.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Split into two glasses, garnish, and serve immediately, or store in an airtight container in your freezer up to 1 hour before serving.",
      "secondary_message": null
    }
