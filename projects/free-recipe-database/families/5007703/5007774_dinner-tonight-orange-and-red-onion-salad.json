  "instructions": [
    {
      "id": 1,
      "primary_message": "Remove the peel of the oranges, along with as much of the pith as possible. Thinly slice the oranges into rounds, about 1/3 of inch thick. Place them on a plate.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place the thinly sliced red onion on top.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Sprinkle the salt on top, dress with olive oil, and crack some pepper to taste.",
      "secondary_message": null
    }
