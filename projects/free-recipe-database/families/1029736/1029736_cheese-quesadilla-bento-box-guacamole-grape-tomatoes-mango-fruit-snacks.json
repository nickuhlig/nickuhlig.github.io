  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide cheese between them, arranging on one half of each tortilla. Fold in half to close.",
      "secondary_message": "½ cup cheddar cheese, shredded"
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place assembled quesadillas in the skillet and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 2-3 minutes. Remove to a plate and set aside to cool completely, about 10 minutes.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and place grape tomatoes in the first small compartment of the bento box. Place fruit snacks in the second small compartment. ",
      "secondary_message": "⅓ cup grape tomatoes\n1 (0.7 oz) pouch fruit snacks"
    },
    {
      "primary_message": "Wash, dry, peel, and slice mango flesh away from the pit, starting with the flat sides; cut into bite-sized pieces. Place in the medium compartment of the bento box.",
      "secondary_message": "½ mango"
    },
    {
      "primary_message": "When the quesadillas are cool, cut into wedges. Place quesadillas and guacamole cup in the large compartment of the bento box. ",
      "secondary_message": "1 (2 oz) cup guacamole"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
