  "instructions": [
    {
      "primary_message": "Preheat oven to 350-degrees. Remove stems from mushrooms and chop (about 3/4 cup). Heat a medium nonstick skillet over medium heat. Add the olive oil and mushroom stems and cook, stirring often, for about 4 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, remove the casing from sausage and finely chop. Turn off the heat and stir chopped sausage, garlic and Rondelé cheese into the skillet with the mushroom mixture. Then stir in the panko and Parmesan. ",
      "secondary_message": null
    },
    {
      "primary_message": "Place mushrooms, open side up, in a 9 x 13-inch baking dish. Fill each mushroom with the sausage filling. Bake until mushrooms are soft (about 25-28 minutes). Garnish with fresh basil. Enjoy as an appetizer, side dish or entrée!",
      "secondary_message": null
    }
  ],
