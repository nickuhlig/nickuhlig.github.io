  "instructions": [
    {
      "id": 257993,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 medium zucchini squash\n0.68 kg cremini mushrooms\n3 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 257994,
      "primary_message": "Trim and medium dice eggplants and zucchini; place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 257995,
      "primary_message": "Thinly slice mushrooms. Roughly chop tomatoes; add both to the bowl with the eggplant and zucchini.",
      "secondary_message": null
    },
    {
      "id": 257996,
      "primary_message": "Peel, halve, and thinly slice onions lengthwise into strips. Peel and mince garlic.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 257997,
      "primary_message": "Preheat two large skillets over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257998,
      "primary_message": "Once the skillets are hot, divide oil between them and swirl to coat the bottoms. Divide onion and garlic between the skillets; cook, stirring often, until softened, 2-3 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 257999,
      "primary_message": "Divide veggies and spices between the skillets; reduce heat to medium and cover. Cook, stirring halfway through, until softened, about 10 minutes. ",
      "secondary_message": "1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 258000,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 258001,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; set aside.",
      "secondary_message": null
    },
    {
      "id": 258002,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 258003,
      "primary_message": "Split rolls in half and divide between two baking sheet pans, cut-side up. Drizzle with oil and sprinkle with garlic and spices. Working in batches, place in the oven and broil until toasted, 1-2 minutes; remove from oven.",
      "secondary_message": "6 whole grain buns or rolls\n1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 258004,
      "primary_message": "When the veggies are ready, divide basil between the skillets and stir to combine the ratatouille (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 258005,
      "primary_message": "Using a stirring spoon, make a well for each egg in the ratatouille skillets; crack an egg into each well. Cook until the egg whites are almost cooked through, 2-3 minutes. Cover each skillet with a lid and cook for 1 minute more.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 258006,
      "primary_message": "Divide ratatouille and eggs between plates or bowls; top with feta and reserved basil. Serve with garlic toast on the side and enjoy!",
      "secondary_message": "3 (113 g) pkg crumbled feta cheese"
    }
  ],
