  "instructions": [
    {
      "id": 257895,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n2 medium zucchini squash\n1 lb cremini mushrooms\n2 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 257896,
      "primary_message": "Drain and rinse the chickpeas in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 257897,
      "primary_message": "Trim and medium dice eggplants and zucchini; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 257898,
      "primary_message": "Thinly slice mushrooms. Roughly chop tomatoes; add both to the bowl with the eggplant and zucchini.",
      "secondary_message": null
    },
    {
      "id": 257899,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257900,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion lengthwise into strips. Peel and mince garlic.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 257901,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring often, until softened, about 3 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 257902,
      "primary_message": "Add veggies and spices to the skillet; reduce heat to medium and cover. Cook, stirring halfway through, until softened, about 10 minutes.",
      "secondary_message": "2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 257903,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 257904,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; set aside.",
      "secondary_message": null
    },
    {
      "id": 257905,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 257906,
      "primary_message": "Drizzle oil over the flatbreads, then sprinkle with garlic and spices; cut into 1½-inch wide strips and transfer to a baking sheet pan. Place in the oven and broil until toasted, 1-2 minutes; remove from oven.",
      "secondary_message": "2 flatbreads or naan\n2 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 257907,
      "primary_message": "When the veggies are ready, stir chickpeas and basil into the ratatouille (reserving a small handful of basil for garnish). Continue to cook, stirring often, until heated through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 257908,
      "primary_message": "Divide ratatouille between plates or bowls and top with reserved basil. Serve with breadsticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
