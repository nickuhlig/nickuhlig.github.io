  "instructions": [
    {
      "id": 257909,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 medium zucchini squash\n1 ½ lb cremini mushrooms\n3 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 257910,
      "primary_message": "Drain and rinse the chickpeas in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 257911,
      "primary_message": "Trim and medium dice eggplants and zucchini; place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 257912,
      "primary_message": "Thinly slice mushrooms. Roughly chop tomatoes; add both to the bowl with the eggplant and zucchini.",
      "secondary_message": null
    },
    {
      "id": 257913,
      "primary_message": "Peel, halve, and thinly slice onions lengthwise into strips. Peel and mince garlic.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 257914,
      "primary_message": "Preheat two large skillets over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257915,
      "primary_message": "Once the skillets are hot, divide oil between them and swirl to coat the bottoms. Divide onion and garlic between the skillets; cook, stirring often, until softened, 2-3 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 257916,
      "primary_message": "Divide veggies and spices between the skillets; reduce heat to medium and cover. Cook, stirring halfway through, until softened, about 10 minutes.",
      "secondary_message": "1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 257917,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 257918,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; set aside.",
      "secondary_message": null
    },
    {
      "id": 257919,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 257920,
      "primary_message": "Drizzle oil over the flatbreads, then sprinkle with garlic and spices; cut into 1½-inch wide strips and transfer to a large baking sheet pan. Place in the oven and broil until toasted, 1-2 minutes; remove from oven.",
      "secondary_message": "3 flatbreads or naan\n1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 257921,
      "primary_message": "When the veggies are ready, divide chickpeas and basil between the skillets (reserving a small handful of basil for garnish). Stir to combine the ratatouille. Continue to cook, stirring often, until heated through, about 4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 257922,
      "primary_message": "Divide ratatouille between plates or bowls and top with reserved basil. Serve with breadsticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
