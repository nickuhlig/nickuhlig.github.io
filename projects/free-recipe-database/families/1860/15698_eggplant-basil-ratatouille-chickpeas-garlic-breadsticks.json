  "instructions": [
    {
      "id": 258007,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n1 medium zucchini squash\n0.23 kg cremini mushrooms\n1 tomato\n½ small pkg fresh basil"
    },
    {
      "id": 258008,
      "primary_message": "Drain and rinse the chickpeas in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 258009,
      "primary_message": "Trim and medium dice eggplant and zucchini; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 258010,
      "primary_message": "Thinly slice mushrooms. Roughly chop tomato; add both to the bowl with the eggplant and zucchini.",
      "secondary_message": null
    },
    {
      "id": 258011,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258012,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion lengthwise into strips. Peel and mince garlic.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 258013,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring often, until softened, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 258014,
      "primary_message": "Add veggies and spices to the skillet; reduce heat to medium and cover. Cook, stirring halfway through, until softened, about 10 minutes.",
      "secondary_message": "1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 258015,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 258016,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; set aside.",
      "secondary_message": null
    },
    {
      "id": 258017,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 258018,
      "primary_message": "Drizzle oil over the flatbread, then sprinkle with garlic and spices; cut into 1½-inch wide strips and transfer to a baking sheet pan. Place in the oven and broil until toasted, 1-2 minutes; remove from oven.",
      "secondary_message": "1 flatbread or naan\n1 tsp extra virgin olive oil\n⅛ tsp Italian seasoning\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 258019,
      "primary_message": "When the veggies are ready, stir chickpeas and basil into the ratatouille (reserving a small handful of basil for garnish). Continue to cook, stirring often, until heated through, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 258020,
      "primary_message": "Divide ratatouille between plates or bowls and top with reserved basil. Serve with breadsticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
