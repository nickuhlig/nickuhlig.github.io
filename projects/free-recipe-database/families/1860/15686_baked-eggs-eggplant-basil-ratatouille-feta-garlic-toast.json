  "instructions": [
    {
      "id": 257839,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n1 medium zucchini squash\n½ lb cremini mushrooms\n1 tomato\n½ small pkg fresh basil"
    },
    {
      "id": 257840,
      "primary_message": "Trim and medium dice eggplant and zucchini; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 257841,
      "primary_message": "Thinly slice mushrooms. Roughly chop tomato; add both to the bowl with the eggplant and zucchini.",
      "secondary_message": null
    },
    {
      "id": 257842,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257843,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion lengthwise into strips. Peel and mince garlic.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 257844,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring often, until softened, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 257845,
      "primary_message": "Add veggies and spices to the skillet; reduce heat to medium and cover. Cook, stirring halfway through, until softened, about 10 minutes.",
      "secondary_message": "1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 257846,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 257847,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; set aside.",
      "secondary_message": null
    },
    {
      "id": 257848,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 257849,
      "primary_message": "Split rolls in half and place on a baking sheet pan, cut-side up. Drizzle with oil and sprinkle with garlic and spices. Place in the oven and broil until toasted, 1-2 minutes; remove from oven.",
      "secondary_message": "2 whole grain buns or rolls\n1 tsp extra virgin olive oil\n⅛ tsp Italian seasoning\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 257850,
      "primary_message": "When the veggies are ready, stir basil into the ratatouille (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 257851,
      "primary_message": "Using a stirring spoon, make a well for each egg in the ratatouille; crack an egg into each well. Cook until the egg whites are almost cooked through, 2-3 minutes. Cover skillet with a lid and cook for 1 minute more.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 257852,
      "primary_message": "Divide ratatouille and eggs between plates or bowls; top with feta and reserved basil. Serve with garlic toast on the side and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
