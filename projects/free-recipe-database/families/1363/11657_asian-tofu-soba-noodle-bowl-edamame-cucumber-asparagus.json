  "instructions": [
    {
      "id": 196831,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 196832,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 196833,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 small bunch asparagus\n1 small bunch green onions (scallions)\n1 English cucumber"
    },
    {
      "id": 196834,
      "primary_message": "Peel and mince or grate the ginger; transfer to a small bowl. Add vinegar, soy sauce, oil, sugar, and sesame seeds; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup rice vinegar\n¼ cup soy sauce\n2 tbsp extra virgin olive oil\n2 tsp brown sugar\n2 tsp sesame seeds"
    },
    {
      "id": 196835,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Add to the pot of boiling water and cook until tender, about 3 minutes. Remove with tongs to a colander and rinse with cold water. Set aside on a plate.",
      "secondary_message": null
    },
    {
      "id": 196836,
      "primary_message": "Return water to a boil and add the noodles and edamame; cook according to package directions, 5-6 minutes. Once done, drain and rinse thoroughly under cold water. Return to the pot and toss with 2 tbsp of the dressing. Set aside.",
      "secondary_message": "10 oz soba (buckwheat) noodles\n1 cup edamame"
    },
    {
      "id": 196837,
      "primary_message": "Large dice the tofu and gently toss in a medium bowl with corn starch.",
      "secondary_message": "¼ cup cornstarch"
    },
    {
      "id": 196838,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196839,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook until golden brown, 2-3 minutes per side.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 196840,
      "primary_message": "Meanwhile, trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the pot with the noodles and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 196841,
      "primary_message": "Medium dice the cucumber. ",
      "secondary_message": null
    },
    {
      "id": 196842,
      "primary_message": "To serve, divide noodles and edamame between bowls; top with asparagus, tofu, and cucumbers. Drizzle with remaining dressing and enjoy!",
      "secondary_message": null
    }
  ],
