  "instructions": [
    {
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n½ small bunch asparagus\n½ small bunch green onions (scallions)\n½ English cucumber"
    },
    {
      "primary_message": "Peel and mince or grate the ginger; transfer to a small bowl. Add vinegar, soy sauce, oil, sugar, and sesame seeds; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp rice vinegar\nextra virgin olive oil\n1 tsp brown sugar\n1 tsp sesame seeds"
    },
    {
      "primary_message": "Snap or cut off the woody ends of the asparagus. Add to the pot of boiling water and cook until tender, about 2 minutes. Remove with tongs to a colander and rinse with cold water. Set aside on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Return water to a boil and add the noodles and edamame; cook according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water. Return to the pot and toss with 1 tbsp of the dressing. Set aside.",
      "secondary_message": "142 g soba (buckwheat) noodles"
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, large dice the tofu and gently toss in a medium bowl with corn starch.",
      "secondary_message": "2 tbsp cornstarch"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook until golden brown, 2-3 minutes per side.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the pot with the noodles and toss to combine.",
      "secondary_message": null
    },
    {
      "primary_message": "Medium dice the cucumber. ",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide noodles and edamame between bowls; top with asparagus, tofu, and cucumbers. Drizzle with remaining dressing and enjoy!",
      "secondary_message": null
    }
  ],
