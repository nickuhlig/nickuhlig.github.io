  "instructions": [
    {
      "id": 196843,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 196844,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 196845,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ small bunches asparagus\n1 small bunch green onions (scallions)\n1 ½ English cucumbers"
    },
    {
      "id": 196846,
      "primary_message": "Peel and mince or grate the ginger; transfer to a small bowl. Add vinegar, soy sauce, oil, sugar, and sesame seeds; whisk to combine the dressing. ",
      "secondary_message": "½ cup rice vinegar\n⅓ cup soy sauce\n3 tbsp extra virgin olive oil\n1 tbsp brown sugar\n1 tbsp sesame seeds"
    },
    {
      "id": 196847,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Add to the pot of boiling water and cook until tender, 3-4 minutes. Remove with tongs to a colander and rinse with cold water. Set aside on a plate.",
      "secondary_message": null
    },
    {
      "id": 196848,
      "primary_message": "Return water to a boil and add the noodles and edamame; cook according to package directions, about 6 minutes. Once done, drain and rinse thoroughly under cold water. Return to the pot and toss with ¼ cup of the dressing. Set aside.",
      "secondary_message": "15 oz soba (buckwheat) noodles\n1 ½ cups edamame"
    },
    {
      "id": 196849,
      "primary_message": "Large dice the tofu and gently toss in a large bowl with corn starch.",
      "secondary_message": "⅓ cup cornstarch"
    },
    {
      "id": 196850,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196851,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook until golden brown, 2-3 minutes per side.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 196852,
      "primary_message": "Meanwhile, trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the pot with the noodles and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 196853,
      "primary_message": "Medium dice the cucumbers. ",
      "secondary_message": null
    },
    {
      "id": 196854,
      "primary_message": "To serve, divide noodles and edamame between bowls; top with asparagus, tofu, and cucumbers. Drizzle with remaining dressing and enjoy!",
      "secondary_message": null
    }
  ],
