  "instructions": [
    {
      "id": 193861,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and lay side by side on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 193862,
      "primary_message": "Wash and dry the fresh produce (skip the spinach if it came pre-washed).",
      "secondary_message": "2 limes\n4 (1 inch) pieces ginger root\n4 medium carrots\n2 red bell peppers\n2 small bunches green onions (scallions)\n1 small bunch cilantro\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 193863,
      "primary_message": "Juice half of the limes into a medium bowl. Grate the ginger and add to the bowl with the juice. Add maple syrup, fish sauce, soy sauce, and oil; whisk to combine.",
      "secondary_message": "3 tbsp pure maple syrup\n2 tbsp fish sauce\n2 tbsp soy sauce\n2 tsp toasted sesame oil"
    },
    {
      "id": 193864,
      "primary_message": "Cut the tofu into 1-inch squares. Place tofu in the bowl with the marinade and gently toss until well coated; set aside.",
      "secondary_message": null
    },
    {
      "id": 193865,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 193866,
      "primary_message": "Peel the carrots; run the peeler along the carrot to make long, noodle-like strips.",
      "secondary_message": null
    },
    {
      "id": 193867,
      "primary_message": "Remove pot from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse.",
      "secondary_message": "10 oz flat rice (pad thai) noodles"
    },
    {
      "id": 193868,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom. Use a slotted spoon to add the tofu to the skillet leaving the marinade in the bowl for later use. Cook until golden brown, 2-3 minutes per side.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 193869,
      "primary_message": "While the tofu cooks, seed and cut the bell peppers into thin sticks.",
      "secondary_message": null
    },
    {
      "id": 193870,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 193871,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 193872,
      "primary_message": "Once the tofu is cooked, transfer to a plate, returning the skillet to the heat. Add the remaining marinade, bell pepper, carrot, green onions, cilantro, and spinach to the hot skillet and stir-fry for 2-3 minutes. Add the noodles to the pan and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 193873,
      "primary_message": "Cut the remaining lime into wedges for serving. ",
      "secondary_message": null
    },
    {
      "id": 193874,
      "primary_message": "To serve, divide noodles between bowls and top with tofu. Garnish with cilantro, peanuts, and a squeeze of lime; enjoy!",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    }
  ],
