  "instructions": [
    {
      "id": 70821,
      "primary_message": "Heat the oven to 425°F (218°C) and position rack in the center.",
      "secondary_message": ""
    },
    {
      "id": 70820,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n9 tomatoes\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 70819,
      "primary_message": "Snap or cut off and discard the woody ends of the asparagus; transfer the spears to a baking sheet.",
      "secondary_message": ""
    },
    {
      "id": 70818,
      "primary_message": "Drizzle the asparagus with olive oil and season with salt and pepper; toss to coat, then spread out in a single layer. Set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 70817,
      "primary_message": "Peel and mince the garlic; transfer to a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 70816,
      "primary_message": "Medium dice the tomatoes; add to the garlic.",
      "secondary_message": ""
    },
    {
      "id": 70815,
      "primary_message": "Place the asparagus in the oven and roast until tender-crisp, 10 to 12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 70814,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 70813,
      "primary_message": "Peel and small dice the onion; transfer to a small bowl.",
      "secondary_message": "1 ½ medium yellow onion"
    },
    {
      "id": 70812,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 70811,
      "primary_message": "Add the onion and cook, stirring occasionally, until it softens and browns, 2 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 70810,
      "primary_message": "While the onion cooks, measure out the olives and capers and add to the bowl with the tomatoes and garlic.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n3 tbsp capers"
    },
    {
      "id": 70809,
      "primary_message": "Add more olive oil to the skillet, followed by the tomatoes, garlic, olives, and capers. Season with salt and pepper.",
      "secondary_message": "6 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 70808,
      "primary_message": "Place the fish in the skillet and sink into the sauce; cook until it is opaque and flakes easily, 4 to 5 minutes per side.",
      "secondary_message": "1.02 kg cod fillet"
    },
    {
      "id": 70807,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": ""
    },
    {
      "id": 70806,
      "primary_message": "Add most of the parsley to the skillet (save a little for garnishing) and stir into the sauce.",
      "secondary_message": ""
    },
    {
      "id": 70805,
      "primary_message": "To serve, divide the asparagus between plates and place the fish fillets on top. Spoon the tomato sauce over top and garnish with the remaining parsley. Enjoy!",
      "secondary_message": ""
    }
  ],
