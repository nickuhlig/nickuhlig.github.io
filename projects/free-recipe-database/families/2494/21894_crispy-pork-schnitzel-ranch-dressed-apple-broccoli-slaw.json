  "instructions": [
    {
      "id": 367862,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg chives\n1 ½ limes\n6 Granny Smith apples"
    },
    {
      "id": 367863,
      "primary_message": "Mince chives and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 367864,
      "primary_message": "Juice limes into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 367865,
      "primary_message": "Add yogurt, mayo, and spices to the bowl. Whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n¼ cup mayonnaise\n1 ½ tsp parsley flakes\n¾ tsp dill, dried\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 367866,
      "primary_message": "Quarter and core apples; cut into matchsticks or coarsely grate. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine. Set aside.",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 367867,
      "primary_message": "Crack eggs into a medium bowl and beat with a whisk or fork.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 367868,
      "primary_message": "Place bread crumbs on a large plate.",
      "secondary_message": "2 ¼ cup panko bread crumbs"
    },
    {
      "id": 367869,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chops in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 367870,
      "primary_message": "Dip the seasoned cutlets into the beaten egg (letting the excess drip off), then into the bread crumbs, pressing to adhere. Transfer to another large plate.",
      "secondary_message": null
    },
    {
      "id": 367871,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 367872,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add the breaded cutlets and cook until golden brown and cooked through, 2-3 minutes per side. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 367873,
      "primary_message": "To serve, divide pork schnitzel and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
