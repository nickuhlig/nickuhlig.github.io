  "instructions": [
    {
      "id": 367874,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg chives\n½ lime\n2 Granny Smith apples"
    },
    {
      "id": 367875,
      "primary_message": "Mince chives and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 367876,
      "primary_message": "Juice lime into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 367877,
      "primary_message": "Add yogurt, mayo, and spices to the bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 ½ tbsp mayonnaise\n½ tsp parsley flakes\n¼ tsp dill, dried\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 367878,
      "primary_message": "Quarter and core apples; cut into matchsticks or coarsely grate. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine. Set aside.",
      "secondary_message": "½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 367879,
      "primary_message": "Crack egg into another medium bowl and beat with a whisk or fork.",
      "secondary_message": "1 egg"
    },
    {
      "id": 367880,
      "primary_message": "Place bread crumbs on a plate.",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 367881,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chops in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 367882,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 367883,
      "primary_message": "While the skillet heats up, dip the seasoned cutlets into the beaten egg (letting the excess drip off), then into the bread crumbs, pressing to adhere. Transfer to another plate.",
      "secondary_message": null
    },
    {
      "id": 367884,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the breaded cutlets and cook until golden brown and cooked through, 2-3 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 367885,
      "primary_message": "To serve, divide pork schnitzel and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
