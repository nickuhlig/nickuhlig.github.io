  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat the oven to 190°C (375°F). Unroll puff pastry and cut into 12 rectangles about 4- by 13-cm. Divide the sausage into 12 equal balls. Shape each ball into a cylinder about 10 cm in length. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Spread each piece of puff pastry with mustard, then place a sausage on the mustard. Roll the puff pastry around the sausage and seal with a thin brush of egg. Repeat with remaining ingredients and place on a baking sheet.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Brush each sausage roll with egg. Bake until pastry has puffed and is browned, about 20 minutes. Serve hot with more mustard.",
      "secondary_message": null
    }
  ],
