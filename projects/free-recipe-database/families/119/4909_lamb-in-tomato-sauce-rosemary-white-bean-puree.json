  "instructions": [
    {
      "id": 59706,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 59705,
      "primary_message": "Season lamb with salt and pepper.",
      "secondary_message": "12 lamb loin chops\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 59704,
      "primary_message": "Coat bottom of pan with oil. Add lamb and cook until browned, 2-3 minutes per side.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 59703,
      "primary_message": "Wash rosemary. Pick leaves off the stems. Peel and mince garlic.",
      "secondary_message": "1 ½ small pkg fresh rosemary\n9 cloves garlic"
    },
    {
      "id": 59702,
      "primary_message": "Transfer lamb to a plate and return pan to stove. Add more oil and ½ of the rosemary and garlic (save the rest for the mash). Cook until fragrant, 15-30 seconds.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 59701,
      "primary_message": "Add tomatoes, broth, salt, and pepper; bring to a boil. Reduce heat to a simmer and cook for 2-3 minutes.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n6 fl oz (¾ cup) chicken or vegetable broth\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 59700,
      "primary_message": "Return lamb to pan and cook with the sauce until it is fully cooked through, 5-6 minutes.",
      "secondary_message": ""
    },
    {
      "id": 59699,
      "primary_message": "Heat a large saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 59698,
      "primary_message": "Grate 3 tsp of lemon zest. Drain and rinse beans; place on paper towels and pat dry.",
      "secondary_message": "1 ½ lemon\n3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 59697,
      "primary_message": "Coat bottom of saucepan with oil. Add lemon zest and remaining rosemary and garlic. Stir and cook for about 1 minute.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 59696,
      "primary_message": "Add beans and broth. Cook until heated through, 3-4 minutes.",
      "secondary_message": "6 fl oz (¾ cup) chicken or vegetable broth"
    },
    {
      "id": 59695,
      "primary_message": "Drizzle with juice from the lemon and season with salt and pepper. Mash until smooth.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 59694,
      "primary_message": "To serve, place lamb, tomato sauce, and bean mash on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
