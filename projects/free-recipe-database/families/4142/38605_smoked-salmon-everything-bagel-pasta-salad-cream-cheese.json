  "instructions": [
    {
      "id": 601958,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool.",
      "secondary_message": "½ tsp salt\n142 g macaroni (elbow) pasta"
    },
    {
      "id": 601959,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small pkg grape tomatoes\n½ English cucumber\n½ bunch radish\n½ small bunch fresh dill"
    },
    {
      "id": 601960,
      "primary_message": "Juice lemon into a medium bowl. Add honey, poppy seeds, sesame seeds, garlic powder, and salt, then whisk to combine the dressing.",
      "secondary_message": "1 tsp honey\n1 tsp poppy seeds\n1 tsp sesame seeds\n¼ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 601961,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 601962,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601963,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601964,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601965,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 601966,
      "primary_message": "Roughly chop capers. Add to the bowl.",
      "secondary_message": "1 tbsp capers"
    },
    {
      "id": 601967,
      "primary_message": "Medium dice cream cheese. Add to the bowl.",
      "secondary_message": "½ (227 g) block cream cheese"
    },
    {
      "id": 601968,
      "primary_message": "Chop or tear smoked salmon into bite-sized pieces. Add to the bowl, along with the cooled pasta, and stir to combine the pasta salad.",
      "secondary_message": "1 (113 g) pkg smoked salmon"
    },
    {
      "id": 601969,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
