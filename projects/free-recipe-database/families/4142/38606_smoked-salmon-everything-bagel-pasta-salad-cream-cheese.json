  "instructions": [
    {
      "id": 601970,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool.",
      "secondary_message": "1 tsp salt\n283 g macaroni (elbow) pasta"
    },
    {
      "id": 601971,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small pkg grape tomatoes\n1 English cucumber\n1 bunch radish\n1 small bunch fresh dill"
    },
    {
      "id": 601972,
      "primary_message": "Juice lemon into a large bowl. Add honey, poppy seeds, sesame seeds, garlic powder, and salt, then whisk to combine the dressing.",
      "secondary_message": "2 tsp honey\n2 tsp poppy seeds\n2 tsp sesame seeds\n½ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 601973,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 601974,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601975,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601976,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601977,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 601978,
      "primary_message": "Roughly chop capers. Add to the bowl.",
      "secondary_message": "2 tbsp capers"
    },
    {
      "id": 601979,
      "primary_message": "Medium dice cream cheese. Add to the bowl.",
      "secondary_message": "1 (227 g) block cream cheese"
    },
    {
      "id": 601980,
      "primary_message": "Chop or tear smoked salmon into bite-sized pieces. Add to the bowl, along with the cooled pasta, and stir to combine the pasta salad.",
      "secondary_message": "2 (113 g) pkgs smoked salmon"
    },
    {
      "id": 601981,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
