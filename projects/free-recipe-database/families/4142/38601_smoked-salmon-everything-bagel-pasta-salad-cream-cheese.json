  "instructions": [
    {
      "id": 601910,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool.",
      "secondary_message": "1 ½ tsp salt\n15 oz macaroni (elbow) pasta"
    },
    {
      "id": 601911,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 ½ bunches radish\n1 small bunch fresh dill"
    },
    {
      "id": 601912,
      "primary_message": "Juice lemons into a large bowl. Add honey, poppy seeds, sesame seeds, garlic powder, and salt, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp honey\n1 tbsp poppy seeds\n1 tbsp sesame seeds\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 601913,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 601914,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601915,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601916,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 601917,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 601918,
      "primary_message": "Roughly chop capers. Add to the bowl.",
      "secondary_message": "3 tbsp capers"
    },
    {
      "id": 601919,
      "primary_message": "Medium dice cream cheese. Add to the bowl.",
      "secondary_message": "1 ½ (8 oz) blocks cream cheese"
    },
    {
      "id": 601920,
      "primary_message": "Chop or tear smoked salmon into bite-sized pieces. Add to the bowl, along with the cooled pasta, and stir to combine the pasta salad.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 601921,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
