  "instructions": [
    {
      "id": 42662,
      "primary_message": "Wash and dry the asparagus.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 42663,
      "primary_message": "Drain and rinse the beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 42664,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 42665,
      "primary_message": "Finely grate 1 cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 42666,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 42667,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "4 tbsp butter, unsalted"
    },
    {
      "id": 42668,
      "primary_message": "Add the garlic to the saucepan; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 42669,
      "primary_message": "Add the beans and ½ of the broth to the saucepan; bring to a boil, then mash the beans with a hand blender or potato masher.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 42670,
      "primary_message": "Add the remaining broth, most of the Parmesan (save a little for garnishing), salt, and pepper to the bean purée; stir to combine. Remove the saucepan from the heat and cover to keep warm.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42671,
      "primary_message": "Add butter to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 42672,
      "primary_message": "Gently crack 4 of the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 3 to 4 minutes. Once done, separate the eggs and transfer to a plate. Repeat with the remaining 4 eggs.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 42673,
      "primary_message": "While the eggs cook, snap or cut off and discard the woody ends of the asparagus; cut the spears into 1-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 42674,
      "primary_message": "Once the eggs have been transferred, add more butter to the skillet.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 42675,
      "primary_message": "Add the asparagus to the skillet and season with salt and pepper; cook, tossing frequently, until the asparagus is bright green and just tender, 4 to 6 minutes. Once done, remove the skillet from the heat.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42676,
      "primary_message": "To serve, spoon the bean purée into a bowl, top with the asparagus and fried eggs, sprinkle with the remaining Parmesan, and season with additional salt and pepper if desired. Enjoy!",
      "secondary_message": ""
    }
  ],
