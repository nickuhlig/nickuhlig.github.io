  "instructions": [
    {
      "id": 27064,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 27065,
      "primary_message": "Add the bacon to the skillet and cook until crispy, 3-5 minutes per side.",
      "secondary_message": "6 slices bacon\r\n"
    },
    {
      "id": 27066,
      "primary_message": "Wash and dry the spinach. Wash the strawberries, trim the tops, and thinly slice.",
      "secondary_message": "1 (5 oz) pkg baby spinach\r\n½ (16 oz) pkg strawberries"
    },
    {
      "id": 27067,
      "primary_message": "In a small bowl, prepare the dressing by whisking together mayo, vinegar, honey, poppy seeds, salt, and pepper.",
      "secondary_message": "¼ cup mayonnaise\r\n1 tbsp apple cider vinegar\r\n1 tsp honey\r\n½ tsp poppy seeds\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 27068,
      "primary_message": "Measure out the almonds.",
      "secondary_message": "⅛ cup almonds, sliced\r\n"
    },
    {
      "id": 27069,
      "primary_message": "Once the bacon is cooked, crumble or chop into small pieces.",
      "secondary_message": ""
    },
    {
      "id": 27070,
      "primary_message": "Arrange a bed of spinach on a plate, top with the strawberries, bacon, feta, and almonds, and drizzle with the dressing. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
