  "instructions": [
    {
      "id": 67530,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 67529,
      "primary_message": "Add the bacon in batches to the skillet and cook until crispy, 3-5 minutes per side.",
      "secondary_message": "18 slices bacon"
    },
    {
      "id": 67528,
      "primary_message": "Wash and dry the spinach. Wash the strawberries, trim the tops, and thinly slice.",
      "secondary_message": "3 (5 oz) pkg baby spinach\n1 ½ (16 oz) pkg strawberries"
    },
    {
      "id": 67527,
      "primary_message": "In a small bowl, prepare the dressing by whisking together mayo, vinegar, honey, poppy seeds, salt, and pepper.",
      "secondary_message": "¾ cup avocado oil mayonnaise\n3 tbsp apple cider vinegar\n3 tsp honey\n1 ½ tsp poppy seeds\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 67526,
      "primary_message": "Measure out the almonds.",
      "secondary_message": "⅜ cup almonds, sliced"
    },
    {
      "id": 67525,
      "primary_message": "Once the bacon is cooked, crumble or chop into small pieces.",
      "secondary_message": ""
    },
    {
      "id": 67524,
      "primary_message": "Arrange a bed of spinach on a plate, top with the strawberries, bacon, feta, and almonds, and drizzle with the dressing. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    }
  ],
