  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim and thinly slice the fennel bulb. Trim and cut the asparagus into 1 1/2–inch lengths. Pick the tarragon leaves from the stems and mince them. Juice the lemon.",
      "secondary_message": "1 fennel bulb\n2 bunches asparagus\n1 small handful fresh tarragon leaves, plus more for serving\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Heat olive oil in a large saucepan over medium-low heat until shimmering. Add leek and fennel and a large pinch of salt. Cook, stirring frequently, until fully softened but not browned, about 5 minutes. Add flour and cook, stirring, until incorporated, about 30 seconds. Stir in stock and bring to a simmer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in asparagus and tarragon. Bring to a simmer and cook for 1 minute. Using a slotted spoon, remove a dozen asparagus tips from the pot, split them in half lengthwise, and set them aside for garnish. Continue simmering soup for 5 to 6 minutes longer. Stir in lemon juice.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Blend soup using a handheld immersion blender, or in batches using a countertop blender, until it's as smooth as you like. Season soup to taste with salt and pepper and serve, garnishing with reserved asparagus tips, crème fraîche (if using), more chopped tarragon, fennel fronds, and more extra-virgin olive oil.",
      "secondary_message": null
    }
  ],
