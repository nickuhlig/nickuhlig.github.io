  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the gluten-free corn tortillas to room temperature.",
      "secondary_message": "10 (15 cm) gluten-free corn tortillas"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven racks to the upper and lower middle positions and preheat oven to 205°C (400°F). In a small bowl, whisk together the olive oil, cumin, and chili powder. Using a pastry brush, lightly brush each tortilla on both sides with the oil. Using a chef’s knife or pizza wheel, cut each tortilla into strips about 2.5 cm thick. Cut strips into 2.5-cm pieces",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Divide the crackers between two baking sheets. Bake for 5 minutes. Remove the pan from the oven. Using a spatula, gently turn over the strips. Return to the oven and bake until crisp, about 3 more.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove from the oven and sprinkle with salt and pepper to taste. Cool and store in an air-tight container for about one week.",
      "secondary_message": null
    }
  ],
