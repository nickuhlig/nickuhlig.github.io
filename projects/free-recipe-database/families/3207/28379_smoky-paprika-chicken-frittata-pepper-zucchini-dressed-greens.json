  "instructions": [
    {
      "id": 598486,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 598487,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 598488,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, chicken, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 lb ground chicken\n1 ½ tsp smoked paprika\n1 tsp oregano, dried\n½ tsp crushed red pepper\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 598489,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 medium zucchini squash\n2 orange bell peppers\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 598490,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise ½-inch thick pieces. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 598491,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 598492,
      "primary_message": "Once the chicken is done, add veggies to the skillet. Continue to cook, stirring occasionally, until softened, 4-5 minutes more. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 598493,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 598494,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "⅔ (8 oz) block mozzarella cheese"
    },
    {
      "id": 598495,
      "primary_message": "Place eggs and salt in the reserved bowl, then whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt"
    },
    {
      "id": 598496,
      "primary_message": "When the veggies are done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 598497,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 598498,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, and salt in a clean medium bowl, then whisk to combine the dressing. Add mixed greens to the bowl and toss to coat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n½ tsp salt"
    },
    {
      "id": 598499,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with dressed greens on the side and enjoy!",
      "secondary_message": null
    }
  ],
