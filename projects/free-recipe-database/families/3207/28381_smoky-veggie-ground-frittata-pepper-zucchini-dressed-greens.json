  "instructions": [
    {
      "id": 598514,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 598515,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 598516,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n¾ tsp smoked paprika\n½ tsp oregano, dried\n¼ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 598517,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 medium zucchini squash\n1 orange bell pepper\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 598518,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into ½-inch thick pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 598519,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 598520,
      "primary_message": "Once the veggie ground is done, add vegetables to the skillet. Continue to cook, stirring occasionally, until softened, 4-5 minutes more. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 598521,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 598522,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 598523,
      "primary_message": "Place eggs and salt in the reserved bowl, then whisk to combine.",
      "secondary_message": "6 eggs\n¼ tsp salt"
    },
    {
      "id": 598524,
      "primary_message": "When the vegetables are done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 598525,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 598526,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, and salt in a clean medium bowl, then whisk to combine the dressing. Add mixed greens to the bowl and toss to coat. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt"
    },
    {
      "id": 598527,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with dressed greens on the side and enjoy!",
      "secondary_message": null
    }
  ],
