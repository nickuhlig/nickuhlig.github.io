  "instructions": [
    {
      "id": 598584,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 598585,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 598586,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, chicken, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n0.68 kg ground chicken\n2 tsp smoked paprika\n1 ½ tsp oregano, dried\n¾ tsp crushed red pepper\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 598587,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n3 orange bell peppers\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 598588,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise ½-inch thick pieces. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 598589,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 598590,
      "primary_message": "Once the chicken is done, add veggies to the skillet. Continue to cook, stirring occasionally, until softened, 5-6 minutes more. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 598591,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 598592,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 598593,
      "primary_message": "Place eggs and salt in the reserved bowl, then whisk to combine.",
      "secondary_message": "18 eggs\n¾ tsp salt"
    },
    {
      "id": 598594,
      "primary_message": "When the veggies are done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 598595,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 4-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 598596,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, and salt in a clean large bowl, then whisk to combine the dressing. Add mixed greens to the bowl and toss to coat. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt"
    },
    {
      "id": 598597,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with dressed greens on the side and enjoy!",
      "secondary_message": null
    }
  ],
