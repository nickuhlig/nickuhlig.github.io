  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and freshly grate the ginger. Soften the unsalted butter. Pick the herb leaves from the stems and mince them. Soften the unsalted butter.",
      "secondary_message": "¼ to ½ tsp ginger\n3 tbsp unsalted butter\n2 tbsp mixed fresh tender herbs\n3 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "For the Ginger-Curry Butter: In a small bowl, stir together crème fraîche, ginger, and curry powder until thoroughly combined. Using a silicone spatula, fold in the butter until well mixed. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Miso-Soy Butter: In a small bowl, stir together crème fraîche, miso, and soy sauce until thoroughly combined. Using a silicone spatula, fold in the butter until well mixed. Season lightly with salt, if needed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Fresh Herb Butter: In a small bowl, stir together crème fraîche and herbs until thoroughly combined. Using a silicone spatula, fold in the butter until well mixed. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "If compound butters are too soft after mixing, refrigerate until slighly more firm but still spreadable, 5-10 minutes. Serve butters with crisp fresh radishes.",
      "secondary_message": null
    }
  ],
