  "instructions": [
    {
      "id": 6888,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 15461,
      "primary_message": "Wash and quarter lettuce lengthwise. Rub cut sides with a little olive oil and season with salt and pepper.",
      "secondary_message": "1 head romaine lettuce\n1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 15462,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "0.34 kg ribeye steak\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 15463,
      "primary_message": "Coat grill or bottom of skillet with oil. Place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 15464,
      "primary_message": "Place romaine halves, cut side down, on grill/skillet. Cook until charred and leaves begin to wilt, 2-3 minutes. Transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 15465,
      "primary_message": "Wash and halve tomatoes. Wash and chop chives.",
      "secondary_message": "½ small pkg grape tomatoes\r\n½ small pkg chives"
    },
    {
      "id": 15466,
      "primary_message": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together garlic, yogurt, olive oil, lemon juice, Dijon, honey, dill, salt, and pepper. Add feta and mix.",
      "secondary_message": "1 clove garlic\n¼ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\njuice of ¼ lemon\n½ tsp Dijon mustard\n½ tsp honey\n⅛ tsp dill\n⅛ tsp salt\n⅛ tsp black pepper\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 15467,
      "primary_message": "Cut remaining lemon into wedges.",
      "secondary_message": "¼ lemon"
    },
    {
      "id": 15468,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": ""
    },
    {
      "id": 6898,
      "primary_message": "To serve, place romaine hearts cut side up on a plate and top with tomatoes and steak slices. Drizzle with dressing and garnish with chives and lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
