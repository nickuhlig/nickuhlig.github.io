  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely mince the garlic.",
      "secondary_message": "4 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Cut cucumber into roughly 4-inch lengths. Using a knife or mandoline, julienne the cucumber as finely as you can.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large mixing bowl, combine cucumber with garlic, water, soy sauce, and vinegar, stirring to distribute ingredients. Season with salt. Transfer to refrigerator if not serving right away.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When ready to serve, add ice cubes and season once more with salt, if needed. Sprinkle sesame seeds on top. Ladle into individual bowls, along with the ice cubes, and serve.",
      "secondary_message": null
    }
