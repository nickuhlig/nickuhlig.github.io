  "instructions": [
    {
      "id": 540909,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 small bunch green onions (scallions)\n3 green bell peppers\n3 yellow bell peppers\n3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 540910,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 540911,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to bowl with the green onions. ",
      "secondary_message": null
    },
    {
      "id": 540912,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 540913,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 540914,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 5-6 minutes. ",
      "secondary_message": "1 tbsp neutral vegetable oil\n1 tbsp garam masala\n1 tbsp curry powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 540915,
      "primary_message": "Meanwhile, rinse lentils in a colander or strainer.",
      "secondary_message": "1 ½ cups green lentils, dried"
    },
    {
      "id": 540916,
      "primary_message": "Once the veggies are done, add lentils, tomatoes, and broth to the pot; stir to combine the dahl and bring to a boil over high heat. Once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, 15-20 minutes.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n710 ml chicken or vegetable broth"
    },
    {
      "id": 540917,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 540918,
      "primary_message": "When the lentils are done, add cilantro to the pot and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 540919,
      "primary_message": "Toast naan if desired, then cut into wedges. ",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 540920,
      "primary_message": "Divide dahl between bowls, then sprinkle with reserved green onions. Serve with naan on the side and enjoy!",
      "secondary_message": null
    }
  ],
