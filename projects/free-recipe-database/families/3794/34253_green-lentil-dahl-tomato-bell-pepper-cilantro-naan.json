  "instructions": [
    {
      "id": 540897,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 small bunch green onions (scallions)\n2 green bell peppers\n2 yellow bell peppers\n2 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 540898,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 540899,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to bowl with the green onions. ",
      "secondary_message": null
    },
    {
      "id": 540900,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 540901,
      "primary_message": "While the pot heats up, peel and mince ginger and garlic. Add both to the bowl with the other veggies. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 540902,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "2 tsp neutral vegetable oil\n2 tsp garam masala\n2 tsp curry powder\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 540903,
      "primary_message": "Meanwhile, rinse lentils in a colander or strainer.",
      "secondary_message": "1 cup green lentils, dried"
    },
    {
      "id": 540904,
      "primary_message": "Once the veggies are done, add lentils, tomatoes, and broth to the pot; stir to combine the dahl and bring to a boil over high heat. Once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, 15-20 minutes.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n473 ml chicken or vegetable broth"
    },
    {
      "id": 540905,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 540906,
      "primary_message": "When the lentils are done, add cilantro to the pot and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 540907,
      "primary_message": "Toast naan if desired, then cut into wedges. ",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 540908,
      "primary_message": "Divide dahl between bowls, then sprinkle with reserved green onions. Serve with naan on the side and enjoy!",
      "secondary_message": null
    }
  ],
