  "instructions": [
    {
      "id": 540777,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "½ small bunch green onions (scallions)\n1 green bell pepper\n1 yellow bell pepper\n1 (1 inch) piece ginger root\n½ small bunch cilantro"
    },
    {
      "id": 540778,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 540779,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to bowl with the green onions. ",
      "secondary_message": null
    },
    {
      "id": 540780,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 540781,
      "primary_message": "While the pan heats up, peel and mince ginger and garlic. Add both to the bowl with the other veggies. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 540782,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "1 tsp neutral vegetable oil\n1 tsp garam masala\n1 tsp curry powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 540783,
      "primary_message": "Meanwhile, rinse lentils in a colander or strainer.",
      "secondary_message": "½ cup green lentils, dried"
    },
    {
      "id": 540784,
      "primary_message": "Once the veggies are done, add lentils, tomatoes, and broth to the pan; stir to combine the dahl and bring to a boil over high heat. Once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, 15-20 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 540785,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 540786,
      "primary_message": "When the lentils are done, add cilantro to the pan and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 540787,
      "primary_message": "Toast naan if desired, then cut into wedges. ",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 540788,
      "primary_message": "Divide dahl between bowls, then top with yogurt and reserved green onions. Serve with naan on the side and enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
