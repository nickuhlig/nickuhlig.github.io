  "instructions": [
    {
      "id": 262701,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n1 ½ lb cremini mushrooms\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 262702,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 262703,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 262704,
      "primary_message": "While the pot heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 262705,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer chops to a clean plate and loosely cover with aluminum foil. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 262706,
      "primary_message": "Meanwhile, thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 262707,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 262708,
      "primary_message": "Return pot to medium heat and add more oil. Add mushrooms and garlic to the pot and cook, stirring occasionally, until mushrooms begin to soften, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 262709,
      "primary_message": "While the mushrooms are cooking, cut cream cheese into small pieces.",
      "secondary_message": "1 ½ (8 oz) blocks cream cheese"
    },
    {
      "id": 262710,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 262711,
      "primary_message": "Add cream cheese, Parmesan, broth, and spices to the pot; stir until cheese is melted and combined. Bring to a simmer and continue to cook, stirring occasionally, until sauce thickens, 4-5 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n¾ tsp oregano, dried\n¾ tsp crushed red pepper\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 262712,
      "primary_message": "Add spinach and zucchini noodles to the pot in handfuls, waiting for them to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 262713,
      "primary_message": "Return pork chops to the pot and turn to coat in sauce.",
      "secondary_message": null
    },
    {
      "id": 262714,
      "primary_message": "To serve, divide saucy veggies and pork chops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
