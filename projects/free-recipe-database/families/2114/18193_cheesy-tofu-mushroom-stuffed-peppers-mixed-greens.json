  "instructions": [
    {
      "id": 295228,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 295229,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 295230,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 orange bell peppers\n0.68 kg cremini mushrooms\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 295231,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 295232,
      "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, about 8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 295233,
      "primary_message": "Meanwhile, thinly slice mushrooms and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 295234,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 295235,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 295236,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add mushrooms, onion, garlic, and spices. Cook, stirring occasionally, until veggies are tender, 6-7 minutes. (Reserve bowl for the salad.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 295237,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 295238,
      "primary_message": "When the veggies are done, crumble tofu with your fingers into the pot and continue to cook, stirring occasionally, until the tofu is heated through, about 3 minutes. Remove from heat, add half of the cheese, and stir to combine the filling. (Reserve remaining cheese for the next step.)",
      "secondary_message": null
    },
    {
      "id": 295239,
      "primary_message": "Divide tofu filling between pepper halves and top with reserved cheese. Return baking sheet to the oven and broil until cheese is golden, about 3 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 295240,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 295241,
      "primary_message": "Add mixed greens and pumpkin seeds to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "¾ cup pumpkin seeds"
    },
    {
      "id": 295242,
      "primary_message": "To serve, divide peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
