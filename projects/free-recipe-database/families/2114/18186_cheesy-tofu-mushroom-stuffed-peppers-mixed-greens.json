  "instructions": [
    {
      "id": 295120,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 295121,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 295122,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "4 orange bell peppers\n1 lb cremini mushrooms\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 295123,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 295124,
      "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 295125,
      "primary_message": "Meanwhile, thinly slice mushrooms and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 295126,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 295127,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 295128,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add mushrooms, onion, garlic, and spices. Cook, stirring occasionally, until veggies are tender, about 5 minutes. (Reserve bowl for the salad.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 295129,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 295130,
      "primary_message": "When the veggies are done, crumble tofu with your fingers into the skillet and continue to cook, stirring occasionally, until the tofu is heated through, 2-3 minutes. Remove from heat, add half of the cheese, and stir to combine the filling. (Reserve remaining cheese for the next step.)",
      "secondary_message": null
    },
    {
      "id": 295131,
      "primary_message": "Divide tofu filling between pepper halves and top with reserved cheese. Return baking sheet to the oven and broil until cheese is golden, 2-3 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 295132,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp white wine vinegar\n2 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 295133,
      "primary_message": "Add mixed greens and pumpkin seeds to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "½ cup pumpkin seeds"
    },
    {
      "id": 295134,
      "primary_message": "To serve, divide peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
