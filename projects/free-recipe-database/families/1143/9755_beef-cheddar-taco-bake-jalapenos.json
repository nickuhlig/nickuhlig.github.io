  "instructions": [
    {
      "id": 332573,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 332574,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 332575,
      "primary_message": "Peel and small dice onion. Seed and small dice bell pepper.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 332576,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332577,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 332578,
      "primary_message": "Add onion and bell pepper to the skillet; cook, stirring frequently, until veggies begin to soften, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 332579,
      "primary_message": "Add beef and spices to the skillet and, breaking apart with a spoon, cook until beef is browned and crumbly, 4-5 minutes. Remove from heat and let cool slightly.",
      "secondary_message": "⅓ kg lean ground beef\n1 tsp chili powder\n¾ tsp salt\n½ tsp cumin, ground\n½ tsp garlic powder\n½ tsp onion powder"
    },
    {
      "id": 332580,
      "primary_message": "Meanwhile, grate cheese.",
      "secondary_message": "⅓ (227 g) block cheddar cheese"
    },
    {
      "id": 332581,
      "primary_message": "Wash and thinly slice jalapeño. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 332582,
      "primary_message": "Whisk eggs in a large bowl.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 332583,
      "primary_message": "Add beef mixture to the bowl with the eggs and stir to combine. Spread mixture into an even layer in the bottom of a small baking dish. Top with cheese and jalapeño slices.",
      "secondary_message": null
    },
    {
      "id": 332584,
      "primary_message": "Place baking dish in the oven; cook until egg is set and cheese is melted and bubbly, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 332585,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 332586,
      "primary_message": "To serve, divide taco bake between plates and top with yogurt and cilantro. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
