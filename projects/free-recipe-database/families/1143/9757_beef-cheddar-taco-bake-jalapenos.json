  "instructions": [
    {
      "id": 332601,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 332602,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 332603,
      "primary_message": "Peel and small dice onions. Seed and small dice bell peppers.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 332604,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332605,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 332606,
      "primary_message": "Add onions and bell peppers to the pot; cook, stirring frequently, until veggies begin to soften, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 332607,
      "primary_message": "Add beef and spices to the pot and, breaking apart with a spoon, cook until beef is browned and crumbly, 6-7 minutes. Remove from heat and let cool slightly.",
      "secondary_message": "1.02 kg lean ground beef\n1 tbsp chili powder\n2 tsp salt\n1 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n1 ½ tsp onion powder"
    },
    {
      "id": 332608,
      "primary_message": "Meanwhile, grate cheese.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 332609,
      "primary_message": "Wash and thinly slice jalapeños. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 332610,
      "primary_message": "Whisk eggs in a large bowl.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 332611,
      "primary_message": "Add beef mixture to the bowl with the eggs and stir to combine. Spread mixture into an even layer in the bottom of a large baking dish. Top with cheese and jalapeño slices.",
      "secondary_message": null
    },
    {
      "id": 332612,
      "primary_message": "Place baking dish in the oven; cook until egg is set and cheese is melted and bubbly, about 22-24 minutes.",
      "secondary_message": null
    },
    {
      "id": 332613,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 332614,
      "primary_message": "To serve, divide taco bake between plates and top with yogurt and cilantro. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
