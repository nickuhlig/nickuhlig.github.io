  "instructions": [
    {
      "id": 195519,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 195520,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lb new potatoes\n1 small pkg fresh rosemary\n12 medium carrots"
    },
    {
      "id": 195521,
      "primary_message": "Thinly slice each potato, stopping ¼-inch before the bottom (be careful not to slice all the way through). Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 195522,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and roughly chop the leaves. Add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 195523,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 195524,
      "primary_message": "Peel and trim carrots. Slice in half crosswise, then lengthwise into ½-inch thick sticks. Add to the bowl along with oil and salt; toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 195525,
      "primary_message": "Divide veggies between two baking sheet pans and spread out in a single layer; arrange potatoes so the cut-side is facing up. Place in the oven and roast until fork-tender, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 195526,
      "primary_message": "Meanwhile, combine spices in a small bowl. ",
      "secondary_message": "¾ tsp salt\n½ tsp garlic powder\n½ tsp paprika\n½ tsp black pepper"
    },
    {
      "id": 195527,
      "primary_message": "Pat steak dry with paper towels and place on a plate; rub with spice mixture on both sides. Set aside.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 195528,
      "primary_message": "When the veggies have 15-20 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 195529,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Remove to a plate and let rest for 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 195530,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 195531,
      "primary_message": "To serve, divide potatoes, carrots, and steak between plates and enjoy!",
      "secondary_message": null
    }
  ],
