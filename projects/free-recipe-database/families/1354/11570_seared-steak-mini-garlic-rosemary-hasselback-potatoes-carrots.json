  "instructions": [
    {
      "id": 195545,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 195546,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.91 kg new potatoes\n1 small pkg fresh rosemary\n8 medium carrots"
    },
    {
      "id": 195547,
      "primary_message": "Thinly slice each potato, stopping ¼-inch before the bottom (be careful not to slice all the way through). Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 195548,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and roughly chop the leaves. Add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 195549,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 195550,
      "primary_message": "Peel and trim carrots. Slice in half crosswise, then lengthwise into ½-inch thick sticks. Add to the bowl along with oil and salt; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 195551,
      "primary_message": "Transfer veggies to a large baking sheet pan and spread out in a single layer; arrange potatoes so the cut-side is facing up. Place in the oven and roast until fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 195552,
      "primary_message": "Meanwhile, combine spices in a small bowl. ",
      "secondary_message": "½ tsp salt\n¼ tsp garlic powder\n¼ tsp paprika\n¼ tsp black pepper"
    },
    {
      "id": 195553,
      "primary_message": "Pat steak dry with paper towels and place on a plate; rub with spice mixture on both sides. Set aside.",
      "secondary_message": "0.68 kg striploin (New York strip) steak"
    },
    {
      "id": 195554,
      "primary_message": "When the veggies have about 15 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 195555,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Remove to a plate and let rest for 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 195556,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 195557,
      "primary_message": "To serve, divide potatoes, carrots, and steak between plates and enjoy!",
      "secondary_message": null
    }
  ],
