  "instructions": [
    {
      "id": 490007,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ tomatoes\n1 ½ avocados\n¾ small bunch cilantro"
    },
    {
      "id": 490008,
      "primary_message": "Small dice tomatoes. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 490009,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice lengthwise into thin half-moons. Add to the plate with the tomato.",
      "secondary_message": null
    },
    {
      "id": 490010,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 490011,
      "primary_message": "Place beef, chili powder, and salt in a medium bowl. Mix with your hands until well combined.",
      "secondary_message": "¾ lb lean ground beef\n1 ½ tsp chili powder\n½ tsp salt"
    },
    {
      "id": 490012,
      "primary_message": "Arrange tortillas on a flat surface, then divide the beef mixture between them. Using the back of a spoon (or your fingers), spread the beef mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 490013,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 490014,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos to the skillet, meat-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the beef is cooked through, about 3 minutes.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 490015,
      "primary_message": "Flip tacos, beef-side up, and sprinkle with cheese. Continue to cook until cheese is melted, 1 minute more. Transfer to another plate.",
      "secondary_message": "1 cup shredded cheese, Mexican blend"
    },
    {
      "id": 490016,
      "primary_message": "Meanwhile, peel and small dice shallot. Add to the plate with the other veggies.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 490017,
      "primary_message": "To serve, divide smash tacos between plates. Top with tomato, cilantro, shallot, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
