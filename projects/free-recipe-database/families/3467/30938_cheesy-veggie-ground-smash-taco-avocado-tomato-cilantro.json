  "instructions": [
    {
      "id": 490095,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n1 avocado\n½ small bunch cilantro"
    },
    {
      "id": 490096,
      "primary_message": "Small dice tomato. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 490097,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the tomato.",
      "secondary_message": null
    },
    {
      "id": 490098,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 490099,
      "primary_message": "Place veggie ground, chili powder, and salt in a medium bowl. Mix with your hands until well combined.",
      "secondary_message": "227 g veggie ground, plant based\n1 tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 490100,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 490101,
      "primary_message": "While the skillet heats up, arrange tortillas on a flat surface, then divide the veggie ground mixture between them. Using the back of a spoon (or your fingers), spread the mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "4 small corn tortillas"
    },
    {
      "id": 490102,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tacos to the skillet, veggie ground-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the veggie ground is cooked through, about 3 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 490103,
      "primary_message": "Flip tacos, veggie ground-side up, and sprinkle with cheese. Continue to cook until cheese is melted, 1 minute more. Transfer to another plate.",
      "secondary_message": "⅔ cup shredded cheese, Mexican blend"
    },
    {
      "id": 490104,
      "primary_message": "Meanwhile, peel and small dice shallot. Add to the plate with the other veggies.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 490105,
      "primary_message": "To serve, divide smash tacos between plates. Top with tomato, cilantro, shallot, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
