  "instructions": [
    {
      "id": 490051,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ tomato\n½ avocado\n¼ small bunch cilantro"
    },
    {
      "id": 490052,
      "primary_message": "Small dice tomato. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 490053,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice lengthwise into thin half-moons. Add to the plate with the tomato.",
      "secondary_message": null
    },
    {
      "id": 490054,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 490055,
      "primary_message": "Place beef, chili powder, and salt in a small bowl. Mix with your hands until well combined.",
      "secondary_message": "0.11 kg lean ground beef\n½ tsp chili powder\n⅛ tsp salt"
    },
    {
      "id": 490056,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 490057,
      "primary_message": "While the skillet heats up, arrange tortillas on a flat surface, then divide the beef mixture between them. Using the back of a spoon (or your fingers), spread the beef mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "2 small corn tortillas"
    },
    {
      "id": 490058,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tacos, meat-side down; cook, pressing down once with the bottom of a spatula halfway through cooking, until the beef is cooked through, about 3 minutes.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 490059,
      "primary_message": "Flip tacos, beef-side up, and sprinkle with cheese. Continue to cook until cheese is melted, 1 minute more. Remove from heat.",
      "secondary_message": "⅓ cup shredded cheese, Mexican blend"
    },
    {
      "id": 490060,
      "primary_message": "Meanwhile, peel and small dice shallot. Add to the plate with the other veggies.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 490061,
      "primary_message": "To serve, divide smash tacos between plates. Top with tomato, cilantro, shallot, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
