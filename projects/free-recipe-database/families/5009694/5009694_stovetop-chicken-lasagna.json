  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the onion. Mince the garlic. Break the no-boil lasagna noodles in half.",
      "secondary_message": "1 medium onion\n5 medium cloves garlic\n12 sheets no-boil lasagna noodles"
    },
    {
      "id": 1,
      "primary_message": "In medium bowl, combine chicken, ground fennel, 1/4 teaspoon red pepper flakes, and 1/2 teaspoon salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In another medium bowl, stir crushed tomatoes, tomato purée, chicken stock, 1 1/2 teaspoons salt, and 1/2 teaspoon black pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In 12-inch non-stick skillet with lid, heat oil over medium heat to shimmering. Add onion and cook until softened and golden, 6 to 8 minutes. Add garlic and cook until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add chicken mixture and cook until cooked through, stirring to break up into small pieces, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Scatter half of noodles into pan, tucking into meat mixture. Pour in half of tomato mixture and sprinkle with remaining 1/4 teaspoon pepper flakes. Evenly spoon half of ricotta and sprinkle half of mozzarella across mixture. Sprinkle with half of parsley into pan.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Scatter in remaining noodles and pour in remaining sauce. Tuck noodles in to cover with sauce. Bring to simmer. Cover and simmer until noodles are tender, about 20 minutes, reducing heat if necessary to keep at simmer.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Remove lid and spoon remaining ricotta evenly across mixture. Sprinkle with remaining mozzarella. Cover and cook until cheese is melted, about 1 minute. Sprinkle with remaining parsley and serve.",
      "secondary_message": null
    }
  ],
