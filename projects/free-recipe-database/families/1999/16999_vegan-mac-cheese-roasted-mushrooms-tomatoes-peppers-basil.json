  "instructions": [
    {
      "id": 276665,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 276666,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Remove from heat and drain in a colander. (Reserve pot for later use.)",
      "secondary_message": "1 ½ tsp salt\n15 oz macaroni (elbow) pasta"
    },
    {
      "id": 276667,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb cremini mushrooms\n3 green bell peppers\n3 pints grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 276668,
      "primary_message": "Thinly slice mushrooms and divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 276669,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 276670,
      "primary_message": "Add tomatoes to the baking sheets. Drizzle veggies with oil and season with spices; toss to combine, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 276671,
      "primary_message": "Place baking sheets in the oven and roast, tossing once, until veggies are tender and tomatoes start to burst, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 276672,
      "primary_message": "When the pasta is done, place almond milk, nutritional yeast, oil, arrowroot starch, Dijon, onion powder, and garlic powder in the reserved pot; whisk until smooth. Place the pot over medium heat and bring the sauce to a simmer, whisking occasionally.",
      "secondary_message": "18 fl oz (2 ¼ cups) almond milk, unsweetened\n1 cup nutritional yeast flakes\n⅓ cup extra virgin olive oil\n3 tbsp arrowroot starch/powder\n3 tbsp Dijon mustard\n¾ tsp onion powder\n¾ tsp garlic powder"
    },
    {
      "id": 276673,
      "primary_message": "Once the sauce is simmering, continue to cook, whisking constantly, until the sauce becomes thick and stretchy, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 276674,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 276675,
      "primary_message": "Return drained pasta to the pot with the cheese sauce, add half of the basil (reserving remainder for serving), and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 276676,
      "primary_message": "If needed, warm the mac & cheese over medium heat, stirring constantly, until heated through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 276677,
      "primary_message": "To serve, divide mac & cheese between plates or bowls; top with roasted veggies and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
