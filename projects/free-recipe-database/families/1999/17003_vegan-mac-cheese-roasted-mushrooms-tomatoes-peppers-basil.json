  "instructions": [
    {
      "id": 276717,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 276718,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Remove from heat and drain in a colander. (Reserve pan for later use.)",
      "secondary_message": "½ tsp salt\n142 g macaroni (elbow) pasta"
    },
    {
      "id": 276719,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.23 kg cremini mushrooms\n1 green bell pepper\n1 small pkg grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 276720,
      "primary_message": "Thinly slice mushrooms and transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 276721,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the baking sheet with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 276722,
      "primary_message": "Add tomatoes to the baking sheet. Drizzle veggies with oil and season with spices; toss to combine, then spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 276723,
      "primary_message": "Place baking sheet in the oven and roast, tossing once, until veggies are tender and tomatoes start to burst, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 276724,
      "primary_message": "When the pasta is done, place almond milk, nutritional yeast, oil, arrowroot starch, Dijon, onion powder, and garlic powder in the reserved saucepan; whisk until smooth. Place the pan over medium heat and bring the sauce to a simmer, whisking occasionally.",
      "secondary_message": "177 ml almond milk, unsweetened\n⅓ cup nutritional yeast flakes\n2 tbsp extra virgin olive oil\n1 tbsp arrowroot starch/powder\n1 tbsp Dijon mustard\n¼ tsp onion powder\n¼ tsp garlic powder"
    },
    {
      "id": 276725,
      "primary_message": "Once the sauce is simmering, continue to cook, whisking constantly, until the sauce becomes thick and stretchy, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 276726,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 276727,
      "primary_message": "Return drained pasta to the pan with the cheese sauce, add half of the basil (reserving the rest for serving), and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 276728,
      "primary_message": "If needed, warm the mac & cheese over medium heat, stirring constantly, until heated through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 276729,
      "primary_message": "To serve, divide mac & cheese between plates or bowls; top with roasted veggies and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
