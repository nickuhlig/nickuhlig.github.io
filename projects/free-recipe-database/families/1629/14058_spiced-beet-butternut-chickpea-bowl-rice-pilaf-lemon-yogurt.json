  "instructions": [
    {
      "id": 233804,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 233805,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium beets\n1 ½ small butternut squash\n1 ½ lemons\n1 small bunch cilantro"
    },
    {
      "id": 233806,
      "primary_message": "Trim, peel, and cut beets into ½-inch cubes. Divide between two baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 233807,
      "primary_message": "Trim and peel each butternut squash. Halve lengthwise, scrape out seeds, and cut flesh into ½-inch cubes; add to the baking sheets with the beets.",
      "secondary_message": null
    },
    {
      "id": 233808,
      "primary_message": "Drain and rinse chickpeas; add to the baking sheets. ",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 233809,
      "primary_message": "Drizzle veggies and chickpeas with oil and sprinkle with spices. Toss to coat and spread out in an even layer. Place in the oven and roast, stirring halfway through, until fork-tender, 25-30 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp paprika\n1 ½ tsp garlic powder\n¾ tsp coriander, ground\n¾ tsp salt"
    },
    {
      "id": 233810,
      "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and spices; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n1 ½ tsp turmeric, ground\n¾ tsp paprika\n¾ tsp salt"
    },
    {
      "id": 233811,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 233812,
      "primary_message": "While the rice cooks, juice lemons into a small bowl. Add yogurt, maple syrup, and spices to the bowl; whisk to combine the lemon yogurt.",
      "secondary_message": "1 cup plain Greek yogurt\n1 tbsp pure maple syrup\n1 ½ tsp garlic powder\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 233813,
      "primary_message": "Pick cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 233814,
      "primary_message": "Add almonds and half the cilantro to the cooked rice; stir to combine the pilaf. (Reserve remaining cilantro for garnish.)",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 233815,
      "primary_message": "To serve, divide rice pilaf, veggies, and chickpeas between bowls. Drizzle with lemon yogurt, sprinkle with reserved cilantro, and enjoy! ",
      "secondary_message": null
    }
  ],
