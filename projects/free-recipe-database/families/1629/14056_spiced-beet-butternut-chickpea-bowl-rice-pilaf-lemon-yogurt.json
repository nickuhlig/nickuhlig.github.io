  "instructions": [
    {
      "id": 233780,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 233781,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium beet\n½ small butternut squash\n½ lemon\n½ small bunch cilantro"
    },
    {
      "id": 233782,
      "primary_message": "Trim, peel, and cut beet into ½-inch cubes. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 233783,
      "primary_message": "Trim and peel butternut squash. Halve lengthwise, scrape out seeds, and cut flesh into ½-inch cubes; add to the baking sheet with the beet.",
      "secondary_message": null
    },
    {
      "id": 233784,
      "primary_message": "Drain and rinse chickpeas; add to the baking sheet. ",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 233785,
      "primary_message": "Drizzle veggies and chickpeas with oil and sprinkle with spices. Toss to coat and spread out in an even layer. Place in the oven and roast, stirring halfway through, until fork-tender, 20-25 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp paprika\n½ tsp garlic powder\n¼ tsp coriander, ground\n¼ tsp salt"
    },
    {
      "id": 233786,
      "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and spices; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n½ tsp turmeric, ground\n¼ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 233787,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 233788,
      "primary_message": "While the rice cooks, juice lemon into a small bowl. Add yogurt, maple syrup, and spices to the bowl; whisk to combine the lemon yogurt.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tsp pure maple syrup\n½ tsp garlic powder\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 233789,
      "primary_message": "Pick cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 233790,
      "primary_message": "Add almonds and half the cilantro to the cooked rice; stir to combine the pilaf. (Reserve remaining cilantro for garnish.)",
      "secondary_message": "⅛ cup almonds, sliced"
    },
    {
      "id": 233791,
      "primary_message": "To serve, divide rice pilaf, veggies, and chickpeas between bowls. Drizzle with lemon yogurt, sprinkle with reserved cilantro, and enjoy! ",
      "secondary_message": null
    }
  ],
