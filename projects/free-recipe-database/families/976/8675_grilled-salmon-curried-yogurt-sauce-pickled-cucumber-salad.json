  "instructions": [
    {
      "id": 177014,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 English cucumbers\n1 lemon\n1 small bunch cilantro"
    },
    {
      "id": 177015,
      "primary_message": "In a medium bowl, combine vinegar and salt; whisk to combine.",
      "secondary_message": "⅓ cup white wine vinegar\n½ tsp salt"
    },
    {
      "id": 177016,
      "primary_message": "Thinly slice the cucumber and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 177017,
      "primary_message": "Peel and thinly slice the red onion; add to the bowl with the cucumber and toss to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 177018,
      "primary_message": "Juice lemon into a small bowl. Add yogurt and spices; whisk to combine. ",
      "secondary_message": "1 cup plain Greek yogurt\n1 tsp curry powder\n½ tsp turmeric\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 177019,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 177020,
      "primary_message": "While the pan heats up, pat the salmon fillets dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg salmon fillet\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 177021,
      "primary_message": "Once the grill pan or skillet is hot, drizzle with oil and add fillets. Working in batches if necessary, grill until cooked through, 3-4 minutes per side. ",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 177022,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the cucumber salad; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 177023,
      "primary_message": "To serve, divide the salmon between dishes; arrange salad on the side and serve with curried yogurt sauce. Enjoy!",
      "secondary_message": null
    }
  ],
