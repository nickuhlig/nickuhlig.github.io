  "instructions": [
    {
      "id": 176914,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 176915,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 176916,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 English cucumbers\n1 lemon\n1 small bunch cilantro"
    },
    {
      "id": 176917,
      "primary_message": "In a medium bowl, combine vinegar, sugar, and salt; whisk to combine.",
      "secondary_message": "⅓ cup white wine vinegar\n2 tbsp brown sugar\n½ tsp salt"
    },
    {
      "id": 176918,
      "primary_message": "Thinly slice the cucumbers and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 176919,
      "primary_message": "Peel and thinly slice the red onion; add to the bowl with the cucumber and toss to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 176920,
      "primary_message": "Juice lemon into a small bowl. Add yogurt and spices; whisk to combine. ",
      "secondary_message": "1 cup plain Greek yogurt\n1 tsp curry powder\n½ tsp turmeric\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 176921,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 176922,
      "primary_message": "While the pan heats up, pat the salmon fillets dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb salmon fillet\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 176923,
      "primary_message": "When the grill pan or skillet is hot, drizzle with oil and add fillets. Working on batches if necessary, grill until cooked through, 3-4 minutes per side. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 176924,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the cucumber salad; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 176925,
      "primary_message": "To serve, divide rice, salmon, and cucumber salad between plates. Serve with curried yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
