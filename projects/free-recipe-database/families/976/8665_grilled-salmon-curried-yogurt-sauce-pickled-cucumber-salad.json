  "instructions": [
    {
      "id": 176902,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 176903,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 176904,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n½ lemon\n½ small bunch cilantro"
    },
    {
      "id": 176905,
      "primary_message": "In a medium bowl, combine vinegar, sugar, and salt; whisk to combine.",
      "secondary_message": "3 tbsp white wine vinegar\n1 tbsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 176906,
      "primary_message": "Thinly slice the cucumber and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 176907,
      "primary_message": "Peel and thinly slice the shallot; add to the bowl with the cucumber and toss to coat.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 176908,
      "primary_message": "Juice lemon into a small bowl. Add yogurt and spices; whisk to combine. ",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp curry powder\n¼ tsp turmeric\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 176909,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 176910,
      "primary_message": "While the skillet heats up, pat the salmon fillets dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb salmon fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 176911,
      "primary_message": "When the grill pan or skillet is hot, drizzle with oil and add fillets. Grill until cooked through, 3-4 minutes per side. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 176912,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the cucumber salad; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 176913,
      "primary_message": "To serve, divide rice, salmon, and cucumber salad between plates. Serve with curried yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
