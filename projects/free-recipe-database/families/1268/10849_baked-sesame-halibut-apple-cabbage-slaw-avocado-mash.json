  "instructions": [
    {
      "id": 178480,
      "primary_message": "Preheat oven to 425°F. Coat a baking sheet pan with a thin layer of oil. ",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 178481,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small head red cabbage\n1 Granny Smith apple\n1 bunch radish\n½ avocado\n½ lime"
    },
    {
      "id": 178482,
      "primary_message": "Pat the fish dry with paper towel.",
      "secondary_message": "¾ lb halibut fillet"
    },
    {
      "id": 178483,
      "primary_message": "Combine flour, salt, and pepper in a small bowl. In another small bowl, whisk the egg.",
      "secondary_message": "2 tbsp all-purpose flour\n½ tsp salt\n¼ tsp black pepper\n1 egg"
    },
    {
      "id": 178484,
      "primary_message": "Combine bread crumbs and sesame seeds in a third bowl.",
      "secondary_message": "¼ cup panko bread crumbs\n2 tbsp sesame seeds"
    },
    {
      "id": 178485,
      "primary_message": "Dredge fish in flour, shake off excess, then dip into the bowl with the egg. Let the excess drip off, then dredge fish in the bread crumbs, pressing to adhere. Place on the baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 178486,
      "primary_message": "Once oven temperature has been reached, place fish in the oven and bake until golden brown and cooked through, 10-12 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 178487,
      "primary_message": "Meanwhile, whisk together vinegar, oils, and spices in a medium bowl.",
      "secondary_message": "2 tbsp rice vinegar\n1 tbsp extra virgin olive oil\n1 tbsp toasted sesame oil\n1 tsp dill\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 178488,
      "primary_message": "Halve the cabbage lengthwise and cut out the core; thinly slice crosswise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 178489,
      "primary_message": "Core and julienne or coarsely grate the apple; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 178490,
      "primary_message": "Trim off and discard tops and root ends of radishes; halve and thinly slice. Add to the bowl and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 178491,
      "primary_message": "Halve and pit the avocado; cut the flesh into cubes while still in the skin and scoop out with a spoon into a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 178492,
      "primary_message": "Juice lime into the bowl, add oil and soy sauce. Mash with a fork until smooth.",
      "secondary_message": "1 tsp toasted sesame oil\n½ tsp soy sauce"
    },
    {
      "id": 178493,
      "primary_message": "To serve, divide slaw between plates, top with halibut and avocado mash. Enjoy!",
      "secondary_message": null
    }
  ],
