  "instructions": [
    {
      "id": 178508,
      "primary_message": "Preheat oven to 425°F. Coat a large baking sheet pan with a thin layer of oil. ",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 178509,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small heads red cabbage\n3 Granny Smith apples\n3 bunches radish\n1 ½ avocados\n1 ½ limes"
    },
    {
      "id": 178510,
      "primary_message": "Pat the fish dry with paper towel.",
      "secondary_message": "2 ¼ lb halibut fillet"
    },
    {
      "id": 178511,
      "primary_message": "Combine flour, salt, and pepper in a small bowl. In another small bowl, whisk the eggs.",
      "secondary_message": "⅓ cup all-purpose flour\n1 ½ tsp salt\n¾ tsp black pepper\n3 eggs"
    },
    {
      "id": 178512,
      "primary_message": "Combine bread crumbs and sesame seeds in a third bowl.",
      "secondary_message": "¾ cup panko bread crumbs\n⅓ cup sesame seeds"
    },
    {
      "id": 178513,
      "primary_message": "Dredge fish in flour, shake off excess, then dip into the bowl with the egg. Let the excess drip off, then dredge fish in the bread crumbs, pressing to adhere. Place on the baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 178514,
      "primary_message": "Once oven temperature has been reached, place fish in the oven and bake until golden brown and cooked through, 12-15 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 178515,
      "primary_message": "Meanwhile, whisk together vinegar, oils, and spices in a large bowl.",
      "secondary_message": "⅓ cup rice vinegar\n3 tbsp extra virgin olive oil\n3 tbsp toasted sesame oil\n1 tbsp dill\n1 ½ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 178516,
      "primary_message": "Halve the cabbages lengthwise and cut out the core; thinly slice crosswise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 178517,
      "primary_message": "Core and julienne or coarsely grate the apples; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 178518,
      "primary_message": "Trim off and discard tops and root ends of radishes; halve and thinly slice. Add to the bowl and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 178519,
      "primary_message": "Halve and pit the avocados; cut the flesh into cubes while still in the skin and scoop out with a spoon into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 178520,
      "primary_message": "Juice limes into the bowl, add oil and soy sauce. Mash with a fork until smooth.",
      "secondary_message": "1 tbsp toasted sesame oil\n1 ½ tsp soy sauce"
    },
    {
      "id": 178521,
      "primary_message": "To serve, divide slaw between plates, top with halibut and avocado mash. Enjoy!",
      "secondary_message": null
    }
  ],
