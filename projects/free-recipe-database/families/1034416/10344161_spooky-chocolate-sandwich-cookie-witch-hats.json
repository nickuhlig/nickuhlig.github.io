  "instructions": [
    {
      "primary_message": "Divide frosting between two small bowls. Add green food coloring to one bowl and stir well to combine the green frosting. Add red and yellow food coloring to the second bowl, then stir well to combine the orange frosting. Set both aside.\n\n",
      "secondary_message": "6 tbsp vanilla frosting\n1 drop green food coloring\n1 drop red food coloring\n4 drops yellow food coloring"
    },
    {
      "primary_message": "Unwrap the chocolate kisses. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spread about 1 ½ teaspoons of green frosting on the center of six sandwich cookies, leaving a narrow \"brim\" around the edge. Gently press a chocolate kiss into the center of the frosting, then sprinkle the visible frosting with sprinkles. Repeat with the remaining cookies, orange frosting, kisses, and sprinkles. \n\n",
      "secondary_message": "12 vanilla creme chocolate sandwich cookies\n1 tbsp candy sprinkles"
    },
    {
      "primary_message": "Arrange \"witch hat\" cookies on a platter and enjoy!",
      "secondary_message": null
    }
  ],
