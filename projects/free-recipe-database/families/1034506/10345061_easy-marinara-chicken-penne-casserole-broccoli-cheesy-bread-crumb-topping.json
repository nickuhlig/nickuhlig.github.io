  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Coat a large (3-quart) baking dish with cooking spray.\n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Pat chicken dry with paper towels and large dice. Transfer to the baking dish, then sprinkle with garlic & herb seasoning. \n\n",
      "secondary_message": "chicken or vegetable broth\n1 ½ tbsp garlic & herb seasoning"
    },
    {
      "primary_message": "Add marinara sauce, broth, pasta, broccoli florets, and salt to the baking dish, then carefully stir to combine. Cover tightly with aluminum foil, place in the preheated oven, and bake for 30 minutes. \n\n",
      "secondary_message": "1 (680 g) jar marinara sauce\nchicken or vegetable broth\n454 g penne pasta\n1 (397 g) bag frozen broccoli florets\n¼ tsp salt"
    },
    {
      "primary_message": "Remove casserole from the oven. Uncover, then sprinkle cheese and bread crumbs evenly over top. Return casserole to the oven and continue to bake until the pasta is tender, cheese is melted, and bread crumbs are golden, 15-20 minutes more. Remove from oven and let stand, 5 minutes.\n\n",
      "secondary_message": "3 cups shredded cheese, Italian blend\n1 cup panko bread crumbs"
    },
    {
      "primary_message": "To serve, divide chicken casserole between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
