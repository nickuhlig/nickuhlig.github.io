  "instructions": [
    {
      "id": 368030,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg sweet potato\n0.23 kg green beans\n1 medium zucchini squash\n½ lime"
    },
    {
      "id": 368031,
      "primary_message": "Peel and medium dice sweet potato.",
      "secondary_message": null
    },
    {
      "id": 368032,
      "primary_message": "Place water, coconut milk, and curry paste in a medium saucepan. Stir to combine the broth and bring to a simmer over medium-high heat. ",
      "secondary_message": "1 cup water\n½ (398 ml) can coconut milk\n2 tbsp Thai curry paste, red"
    },
    {
      "id": 368033,
      "primary_message": "Once the broth is simmering, add sweet potato and cook, stirring occasionally, until softened, 6-8 minutes. ",
      "secondary_message": null
    },
    {
      "id": 368034,
      "primary_message": "Meanwhile, trim and cut green beans crosswise into 1-inch pieces. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 368035,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the green beans. ",
      "secondary_message": null
    },
    {
      "id": 368036,
      "primary_message": "Drain and rinse lentils; add to the bowl with the veggies. ",
      "secondary_message": "1 (255 g) can lentils"
    },
    {
      "id": 368037,
      "primary_message": "When the sweet potato is tender, add veggies, lentils, salt, and pepper to the pan. Stir to combine the stew and return to a simmer.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 368038,
      "primary_message": "Once simmering, cover the stew with a lid and continue to cook, stirring occasionally, until veggies are fork-tender, 3-4 minutes more. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 368039,
      "primary_message": "Meanwhile, cut lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 368040,
      "primary_message": "Divide stew between bowls and top with yogurt. Serve with lime wedges on the side. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
