  "instructions": [
    {
      "id": 368041,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potato\n0.45 kg green beans\n2 medium zucchini squash\n1 lime"
    },
    {
      "id": 368042,
      "primary_message": "Peel and medium dice sweet potatoes.",
      "secondary_message": null
    },
    {
      "id": 368043,
      "primary_message": "Place water, coconut milk, and curry paste in a large pot. Stir to combine the broth and bring to a simmer over medium-high heat. ",
      "secondary_message": "2 cup water\n1 (398 ml) can coconut milk\n¼ cup Thai curry paste, red"
    },
    {
      "id": 368044,
      "primary_message": "Once the broth is simmering, add sweet potato and cook, stirring occasionally, until softened, 6-8 minutes. ",
      "secondary_message": null
    },
    {
      "id": 368045,
      "primary_message": "Meanwhile, trim and cut green beans crosswise into 1-inch pieces. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 368046,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the green beans. ",
      "secondary_message": null
    },
    {
      "id": 368047,
      "primary_message": "Drain and rinse lentils; add to the bowl with the veggies. ",
      "secondary_message": "2 (255 g) cans lentils"
    },
    {
      "id": 368048,
      "primary_message": "When the sweet potato is tender, add veggies, lentils, salt, and pepper to the pot. Stir to combine the stew and return to a simmer.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 368049,
      "primary_message": "Once simmering, cover the stew with a lid and continue to cook, stirring occasionally, until veggies are fork-tender, 3-4 minutes more. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 368050,
      "primary_message": "Meanwhile, cut lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 368051,
      "primary_message": "Divide stew between bowls and top with yogurt. Serve with lime wedges on the side. Enjoy!",
      "secondary_message": "1 cup plain Greek yogurt"
    }
  ],
