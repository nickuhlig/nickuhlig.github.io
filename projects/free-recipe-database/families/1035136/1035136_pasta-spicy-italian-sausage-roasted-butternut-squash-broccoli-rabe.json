  "instructions": [
    {
      "primary_message": "Preheat oven to 425F. ",
      "secondary_message": null
    },
    {
      "primary_message": "Blanch the broccoli rabe in a large pot of boiling, salted water for 2 minutes. Transfer to an ice bath to stop cooking. Drain and set aside (may be done a day ahead). ",
      "secondary_message": null
    },
    {
      "primary_message": "Toss the butternut squash with 1 tbsp olive oil, season with 1/4 tsp kosher salt and the black pepper. Transfer to rimmed baking sheet and roast for 25 minutes until golden and tender",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place a fresh pot of water on high heat for pasta. Heat 1 tbsp olive oil in a 12” skillet over high heat until shimmering. Add sausage, breaking up large chunks, and cook until browned on all sides.",
      "secondary_message": null
    },
    {
      "primary_message": "Remove sausage from the pan, add the onions, season with 1/4 tsp kosher salt and crushed red pepper, then reduce heat to medium and cook until onions soften and begin to brown (add a little stock if needed to deglaze the pan). ",
      "secondary_message": null
    },
    {
      "primary_message": "While onions cook, add remaining 1 tbsp kosher salt and the pasta to the boiling water and cook until al dente. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add sliced garlic to the browned onions and sauté until fragrant. Add the sausage and stock. Bring to a simmer. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once simmering, add pasta, stir to coat with the sauce, and adjust heat so sauce is simmering. Stir in the butternut squash and broccoli rabe, then simmer for 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "primary_message": "Off heat, stir in Parmesan, then taste and adjust seasonings as desired. Serve immediately, drizzled with remaining 2 tbsp extra virgin olive oil and a sprinkle of additional Parmesan.",
      "secondary_message": null
    }
  ],
