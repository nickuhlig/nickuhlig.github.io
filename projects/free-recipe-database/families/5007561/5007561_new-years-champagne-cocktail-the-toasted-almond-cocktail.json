  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Keep the Champagne cold until you use it.",
      "secondary_message": "Champagne"
    },
    {
      "id": 1,
      "primary_message": "Make the almond sugar by grinding the toasted almonds, sugar, and almond extract together in a mini food processor until the mixture is homogeneous.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Run a lemon slice around the rims of the champagne flutes. Pour the almond sugar onto a shallow dish, and dip the wet glass rims into the almond sugar.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Being careful to avoid wetting the sugared rim, pour the Amaretto into the bottom of each champagne flute. Top with champagne, being careful not to pour too fast, or the champagne will fizz over the glass, and ruin the sugar rim.",
      "secondary_message": null
    }
  ],
