  "instructions": [
    {
      "id": 230497,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 230498,
      "primary_message": "Drain and rinse chickpeas. Place on a clean towel or paper towels and pat dry, then transfer to a large bowl.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 230499,
      "primary_message": "Add oil, sesame seeds, and spices to the bowl with the chickpeas; stir to combine. ",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup sesame seeds\n1 ½ tsp paprika\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp salt"
    },
    {
      "id": 230500,
      "primary_message": "Transfer chickpeas to a large baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until slightly crispy, 15-20 minutes. (Reserve bowl for the salad.)",
      "secondary_message": null
    },
    {
      "id": 230501,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n1 ½ English cucumbers\n3 tomatoes\n1 ½ bunches radish\n3 heads romaine lettuce\n1 small bunch cilantro\n1 small bunch Italian (flat-leaf) parsley\n3 lemons"
    },
    {
      "id": 230502,
      "primary_message": "Peel, trim, and coarsely grate carrots; transfer to the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 230503,
      "primary_message": "Trim and medium dice cucumbers. Medium dice tomatoes; add both to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 230504,
      "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 230505,
      "primary_message": "Cut romaine crosswise into thin (shred-like) strips and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 230506,
      "primary_message": "Shave cilantro and parsley leaves off the stems; discard stems and mince the leaves. Add both to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 230507,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 230508,
      "primary_message": "Juice lemons into the bowl with the garlic. Add tahini, water, Dijon, sugar, and spices; whisk to combine the dressing.",
      "secondary_message": "¾ cup tahini\n½ cup water\n1 tbsp Dijon mustard\n1 ½ tsp brown sugar\n¾ tsp cumin, ground\n¾ tsp coriander, ground\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 230509,
      "primary_message": "To serve, divide salad between plates. Top with crispy chickpeas and drizzle with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
