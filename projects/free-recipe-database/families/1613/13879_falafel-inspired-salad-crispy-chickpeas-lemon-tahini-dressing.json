  "instructions": [
    {
      "id": 230471,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 230472,
      "primary_message": "Drain and rinse chickpeas. Place on a clean towel or paper towels and pat dry, then transfer to a large bowl.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 230473,
      "primary_message": "Add oil, sesame seeds, and spices to the bowl with the chickpeas; stir to combine. ",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp sesame seeds\n½ tsp paprika\n½ tsp cumin, ground\n½ tsp coriander, ground\n¼ tsp salt"
    },
    {
      "id": 230474,
      "primary_message": "Transfer chickpeas to a baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until slightly crispy, about 15 minutes. (Reserve bowl for the salad.)",
      "secondary_message": null
    },
    {
      "id": 230475,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n½ English cucumber\n1 tomato\n½ bunch radish\n1 head romaine lettuce\n½ small bunch cilantro\n½ small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 230476,
      "primary_message": "Peel, trim, and coarsely grate carrot; transfer to the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 230477,
      "primary_message": "Trim and medium dice cucumber. Medium dice tomato; add both to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 230478,
      "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 230479,
      "primary_message": "Cut romaine crosswise into thin (shred-like) strips and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 230480,
      "primary_message": "Shave cilantro and parsley leaves off the stems; discard stems and mince the leaves. Add both to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 230481,
      "primary_message": "Peel and mince garlic; place in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 230482,
      "primary_message": "Juice lemon into the bowl with the garlic. Add tahini, water, Dijon, sugar, and spices; whisk to combine the dressing.",
      "secondary_message": "¼ cup tahini\n3 tbsp water\n1 tsp Dijon mustard\n½ tsp brown sugar\n¼ tsp cumin, ground\n¼ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 230483,
      "primary_message": "To serve, divide salad between plates. Top with crispy chickpeas and drizzle with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
