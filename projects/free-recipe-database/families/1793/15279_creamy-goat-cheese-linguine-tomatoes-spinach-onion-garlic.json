  "instructions": [
    {
      "id": 251907,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve ¾-cup of pasta cooking water before draining.) ",
      "secondary_message": "2 tsp salt\n10 oz linguine pasta"
    },
    {
      "id": 251908,
      "primary_message": "Meanwhile, peel and mince garlic. Peel and small dice onions.",
      "secondary_message": "8 cloves garlic\n2 medium yellow onions"
    },
    {
      "id": 251909,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 251910,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the garlic and onion; cook, stirring occasionally, until the onion begins to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 251911,
      "primary_message": "Meanwhile, wash, dry, and small dice tomatoes.",
      "secondary_message": "6 tomatoes"
    },
    {
      "id": 251912,
      "primary_message": "Add tomatoes, salt, and pepper to the skillet; continue to cook, stirring often, until tomatoes begin to soften, 3-4 minutes.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 251913,
      "primary_message": "While the tomatoes are cooking, wash, dry, and roughly chop the spinach (skip washing if the spinach came pre-washed).",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 251914,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 251915,
      "primary_message": "Crumble goat cheese into the skillet; add cream and stir to combine. Reduce heat to low and continue to cook, stirring often, until the sauce is melted and combined, 3-4 minutes.",
      "secondary_message": "1 (4 oz) log goat cheese\n8 fl oz (1 cup) heavy whipping cream"
    },
    {
      "id": 251916,
      "primary_message": "Add drained pasta to the skillet and toss to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency.",
      "secondary_message": null
    },
    {
      "id": 251917,
      "primary_message": "To serve, divide pasta between bowls and enjoy!",
      "secondary_message": null
    }
  ],
