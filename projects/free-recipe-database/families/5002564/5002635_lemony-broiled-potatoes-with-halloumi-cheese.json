  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat broiler and set top oven rack about 15 cm from broiler element. Add olive oil to a 30-cm cast iron skillet and spread evenly all over.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add potatoes, shingling the slices around the pan in a single circular layer. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Broil until the potatoes have puffed up slightly, mostly cooked through, and browned on top, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour lemon juice all over potatoes and sprinkle zest on top. Add halloumi cheese in an even layer on top and broil until cheese is golden brown all over and potatoes are fully cooked through, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Sprinkle oregano on top and serve.",
      "secondary_message": null
    }
  ],
