  "instructions": [
    {
      "id": 310153,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 310154,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then place in a medium bowl. ",
      "secondary_message": "1 cup basmati rice"
    },
    {
      "id": 310155,
      "primary_message": "Drain and rinse chickpeas; add to the bowl with the rice and set aside. ",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 310156,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 yellow bell peppers\n2 small bunches asparagus\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 310157,
      "primary_message": "Trim, seed, and medium dice bell peppers. Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces. Place both in another medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 310158,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 310159,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion; peel and mince garlic. Add both to the bowl with the bell pepper and asparagus. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 310160,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggies and cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 310161,
      "primary_message": "Once the veggies are soft, add rice, chickpeas, broth, tomato sauce, and spices to the skillet; stir to combine and bring to a boil. Once boiling, cover the skillet with an ovenproof lid or aluminum foil.",
      "secondary_message": "473 ml chicken or vegetable broth\n2 (213 ml) cans tomato sauce\n4 tsp paprika\n2 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper\n½ tsp coriander, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 310162,
      "primary_message": "Place skillet in the oven and bake until rice has fully absorbed liquid and chickpeas are tender, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 310163,
      "primary_message": "Meanwhile, drain and roughly chop artichoke hearts.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 310164,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 310165,
      "primary_message": "Slice lemon into wedges. ",
      "secondary_message": null
    },
    {
      "id": 310166,
      "primary_message": "When the chickpeas and rice are done, add artichokes and half of the parsley to the skillet; stir to combine the \"paella.\" (Reserve remaining parsley for garnish.)",
      "secondary_message": null
    },
    {
      "id": 310167,
      "primary_message": "To serve, divide paella between plates or bowls; sprinkle with reserved parsley and squeeze lemon over top. Enjoy!",
      "secondary_message": null
    }
  ],
