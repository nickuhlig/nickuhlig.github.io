  "instructions": [
    {
      "id": 310029,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 310030,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "3 yellow bell peppers\n3 small bunches asparagus\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 310031,
      "primary_message": "Trim, seed, and medium dice bell peppers. Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces. Place both in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 310032,
      "primary_message": "Peel, halve, and thinly slice onions; peel and mince garlic. Add both to the bowl with the bell pepper and asparagus; set aside. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 310033,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 310034,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 310035,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add chicken and cook until golden, about 2 minutes per side. Once golden, transfer to a clean plate (the chicken will not be cooked all the way through). Reserve skillet with juices for later use.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 310036,
      "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water, then drain. ",
      "secondary_message": "1 ½ cups basmati rice"
    },
    {
      "id": 310037,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add veggies and rice; cook, stirring occasionally, until veggies start to soften, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 310038,
      "primary_message": "Once the veggies are soft, add broth, tomato sauce, and spices to the skillet; stir to combine and bring to a boil. Once boiling, transfer mixture to a large baking dish and add chicken (and any accumulated juices), nestling chicken into the veggies and rice. Cover with an ovenproof lid or foil.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n3 (8 oz) cans tomato sauce\n2 tbsp paprika\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp coriander, ground\n3 pinch cayenne pepper"
    },
    {
      "id": 310039,
      "primary_message": "Place baking dish in the oven and bake until rice has fully absorbed liquid and chicken is cooked through, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 310040,
      "primary_message": "Meanwhile, drain and roughly chop artichoke hearts.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 310041,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 310042,
      "primary_message": "Slice lemons into wedges. ",
      "secondary_message": null
    },
    {
      "id": 310043,
      "primary_message": "When the chicken and rice are done, add artichokes and half of the parsley to the baking dish; stir to combine the \"paella.\" (Reserve remaining parsley for garnish.)",
      "secondary_message": null
    },
    {
      "id": 310044,
      "primary_message": "To serve, divide paella between plates or bowls; sprinkle with reserved parsley and squeeze lemon over top. Enjoy!",
      "secondary_message": null
    }
  ],
