  "instructions": [
    {
      "id": 310075,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 310076,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then place in a medium bowl. ",
      "secondary_message": "1 ½ cups basmati rice"
    },
    {
      "id": 310077,
      "primary_message": "Drain and rinse chickpeas; add to the bowl with the rice and set aside. ",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 310078,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "3 yellow bell peppers\n3 small bunches asparagus\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 310079,
      "primary_message": "Trim, seed, and medium dice bell peppers. Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces. Place both in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 310080,
      "primary_message": "Peel, halve, and thinly slice onions; peel and mince garlic. Add both to the bowl with the bell pepper and asparagus. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 310081,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 310082,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggies and cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 310083,
      "primary_message": "Once the veggies are soft, add rice, chickpeas, broth, tomato sauce, and spices to the skillet; stir to combine and bring to a boil. Once boiling, transfer the mixture to a large baking dish and cover with an ovenproof lid or aluminum foil. ",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n3 (8 oz) cans tomato sauce\n2 tbsp paprika\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp coriander, ground\n3 pinch cayenne pepper"
    },
    {
      "id": 310084,
      "primary_message": "Place baking dish in the oven and bake until rice has fully absorbed liquid and chickpeas are tender, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 310085,
      "primary_message": "Meanwhile, drain and roughly chop artichoke hearts.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 310086,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 310087,
      "primary_message": "Slice lemons into wedges. ",
      "secondary_message": null
    },
    {
      "id": 310088,
      "primary_message": "When the chickpeas and rice are done, add artichokes and half of the parsley to the baking dish; stir to combine the \"paella.\" (Reserve remaining parsley for garnish.)",
      "secondary_message": null
    },
    {
      "id": 310089,
      "primary_message": "To serve, divide paella between plates or bowls; sprinkle with reserved parsley and squeeze lemon over top. Enjoy!",
      "secondary_message": null
    }
  ],
