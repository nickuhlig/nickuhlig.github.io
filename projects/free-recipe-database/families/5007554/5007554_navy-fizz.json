  "instructions": [
    {
      "id": 1,
      "primary_message": "In a cocktail shaker, muddle nectarine, simple syrup, and rosemary sprig. Add gin, Campari, and lemon juice, fill shaker with ice, and shake until well chilled (about 15 seconds.)",
