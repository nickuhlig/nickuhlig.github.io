  "instructions": [
    {
      "id": 83242,
      "primary_message": "Preheat oven to 425°F. Line a baking sheet with parchment paper (optional).",
      "secondary_message": null
    },
    {
      "id": 83243,
      "primary_message": "Wash and dry the fresh produce. Leave the lettuce intact while washing.",
      "secondary_message": "1 lemon\n1 head romaine lettuce"
    },
    {
      "id": 83244,
      "primary_message": "Peel and mince garlic and transfer to a small bowl for the dressing. Mince the anchovy fillets and add to the bowl. Add salt and stir to combine.",
      "secondary_message": "1 clove garlic\n3 anchovy fillets, packed in oil\n½ tsp salt"
    },
    {
      "id": 83245,
      "primary_message": "Juice the lemon and add to the dressing bowl. Add mustard, olive oil, and pepper; whisk together.",
      "secondary_message": "1 tsp Dijon mustard\n2 tbsp extra virgin olive oil\n¼ tsp black pepper"
    },
    {
      "id": 83246,
      "primary_message": "Pat the salmon dry with paper towels and place, on a sheet pan (that is also big enough to hold the lettuce). Rub the salmon with olive oil and season with salt and pepper.",
      "secondary_message": "¾ lb salmon fillet\n1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 83247,
      "primary_message": "Place the salmon in the oven and roast for 5 minutes while you prepare the lettuce.",
      "secondary_message": null
    },
    {
      "id": 83248,
      "primary_message": "Cut romaine lengthwise and rub with ¾ of the dressing. After the salmon has been cooking for 5 minutes, remove from the oven, and add the lettuce to the opposite end of the pan.",
      "secondary_message": null
    },
    {
      "id": 83249,
      "primary_message": "Return the sheet pan to the oven for an additional 7-10 minutes until the salmon is cooked through and the tops of the lettuce begin to char.",
      "secondary_message": null
    },
    {
      "id": 83250,
      "primary_message": "Finely grate ¼ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 83251,
      "primary_message": "Remove the pan from the oven. Sprinkle the lettuce with the Parmesan cheese. Chop the lettuce into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 83252,
      "primary_message": "To serve, arrange a bed of romaine on a plate, top with salmon and drizzle with remaining dressing. Serve immediately, enjoy!",
      "secondary_message": null
    }
  ],
