  "instructions": [
    {
      "id": 632762,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 English cucumber\n1 red bell pepper\n½ small bunch green onions (scallions)\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 632763,
      "primary_message": "Peel and mince ginger. Place in a medium bowl along with oil, soy sauce, vinegar, sugar, chili-garlic sauce, and pepper. Whisk to combine the marinade.",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp soy sauce\n1 tsp rice vinegar\n2 tsp brown sugar\n1 tsp chili-garlic sauce\n¾ tsp black pepper"
    },
    {
      "id": 632764,
      "primary_message": "Pat steak dry with paper towels and slice crosswise into thin strips. Add to the bowl with the marinade, toss to coat, and set aside. ",
      "secondary_message": "¾ lb flank steak"
    },
    {
      "id": 632765,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 632766,
      "primary_message": "While the skillet heats up, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 632767,
      "primary_message": "Once the skillet is hot, add sesame seeds and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool.",
      "secondary_message": "2 tbsp sesame seeds"
    },
    {
      "id": 632768,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "½ cup edamame, shelled"
    },
    {
      "id": 632769,
      "primary_message": "Using a clean cutting board, peel and mince garlic. Place in another medium bowl along with oil, soy sauce, vinegar, sugar, and chili-garlic sauce. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n1 tsp toasted sesame oil\n1 tsp soy sauce\n½ tsp rice vinegar\n½ tsp brown sugar\n½ tsp chili-garlic sauce"
    },
    {
      "id": 632770,
      "primary_message": "Trim and slice cucumber crosswise into ½-inch thick rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 632771,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 632772,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, along with drained edamame and toasted sesame seeds, reserving a small handful of sesame seeds for serving. Set bowl aside.",
      "secondary_message": null
    },
    {
      "id": 632773,
      "primary_message": "Transfer beef and marinade to a baking sheet pan and spread out in an even layer. Place baking sheet in the oven and broil until beef is caramelized and cooked until desired doneness, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 632774,
      "primary_message": "Meanwhile, juice lime into another small bowl.",
      "secondary_message": null
    },
    {
      "id": 632775,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice and stir to combine the sauce.",
      "secondary_message": null
    },
    {
      "id": 632776,
      "primary_message": "To serve, divide black pepper beef and salad between plates or bowl. Drizzle sauce over beef, sprinkle with reserved sesame seeds, and enjoy!",
      "secondary_message": null
    }
  ],
