  "instructions": [
    {
      "id": 632882,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 English cucumbers\n3 red bell peppers\n1 small bunch green onions (scallions)\n1 ½ limes\n1 small bunch cilantro"
    },
    {
      "id": 632883,
      "primary_message": "Peel and mince ginger. Place in a large bowl along with oil, soy sauce, vinegar, sugar, chili-garlic sauce, and pepper. Whisk to combine the marinade.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp soy sauce\n1 tbsp rice vinegar\n2 tbsp brown sugar\n1 tbsp chili-garlic sauce\n2 tsp black pepper"
    },
    {
      "id": 632884,
      "primary_message": "Pat steak dry with paper towels and slice crosswise into thin strips. Add to the bowl with the marinade, toss to coat, and set aside. ",
      "secondary_message": "1.02 kg flank steaks"
    },
    {
      "id": 632885,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 632886,
      "primary_message": "While the skillet heats up, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 632887,
      "primary_message": "Once the skillet is hot, add sesame seeds and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool.",
      "secondary_message": "⅓ cup sesame seeds"
    },
    {
      "id": 632888,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 632889,
      "primary_message": "Using a clean cutting board, peel and mince garlic. Place in a medium bowl along with oil, soy sauce, vinegar, sugar, and chili-garlic sauce. Whisk to combine the dressing.",
      "secondary_message": "6 cloves garlic\n1 tbsp toasted sesame oil\n1 tbsp soy sauce\n1 ½ tsp rice vinegar\n1 ½ tsp brown sugar\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 632890,
      "primary_message": "Trim and slice cucumbers crosswise into ½-inch thick rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 632891,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 632892,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, along with drained edamame and toasted sesame seeds, reserving a small handful of sesame seeds for serving. Set bowl aside.",
      "secondary_message": null
    },
    {
      "id": 632893,
      "primary_message": "Transfer beef and marinade to a large baking sheet pan and spread out in an even layer. Place baking sheet in the oven and broil until beef is caramelized and cooked until desired doneness, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 632894,
      "primary_message": "Meanwhile, juice limes into another small bowl.",
      "secondary_message": null
    },
    {
      "id": 632895,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice and stir to combine the sauce.",
      "secondary_message": null
    },
    {
      "id": 632896,
      "primary_message": "To serve, divide black pepper beef and salad between plates or bowl. Drizzle sauce over beef, sprinkle with reserved sesame seeds, and enjoy!",
      "secondary_message": null
    }
  ],
