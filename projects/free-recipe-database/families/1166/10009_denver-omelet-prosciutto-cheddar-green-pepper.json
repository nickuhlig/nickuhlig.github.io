  "instructions": [
    {
      "id": 159749,
      "primary_message": "Wash and dry bell peppers, then seed and small dice. Peel and small dice onions.",
      "secondary_message": "3 green bell peppers\n1 ½ medium yellow onions"
    },
    {
      "id": 159750,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 159751,
      "primary_message": "Roughly chop prosciutto into small pieces.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 159752,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 159753,
      "primary_message": "Add bell pepper and onion to the skillet and cook, stirring occasionally, until soft, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 159754,
      "primary_message": "Meanwhile, in a large bowl, whisk together eggs, salt, and pepper.",
      "secondary_message": "18 eggs\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 159755,
      "primary_message": "Coarsely grate the cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 159756,
      "primary_message": "Add prosciutto to the skillet with the peppers and cook, stirring occasionally, until prosciutto is crispy, 1 minute more. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 159757,
      "primary_message": "Preheat a second, smaller skillet over medium-low heat. Add more butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 159758,
      "primary_message": "Add ⅓ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing the uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet. ",
      "secondary_message": null
    },
    {
      "id": 159759,
      "primary_message": "Sprinkle ⅓ of the cheese and ⅓ of the prosciutto mixture over one side of the omelet. Fold the omelet in half and cook until warmed through, about 1 minute. Transfer omelet to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 159760,
      "primary_message": "Add more butter to the skillet (1 tbsp per omelet) and repeat twice more with remaining eggs, cheese, and prosciutto mixture.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 159761,
      "primary_message": "To serve, cut omelets in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
