  "instructions": [
    {
      "id": 159698,
      "primary_message": "Wash and dry bell peppers, then seed and small dice. Peel and small dice onion.",
      "secondary_message": "2 green bell peppers\n1 medium yellow onion"
    },
    {
      "id": 159699,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 159700,
      "primary_message": "Roughly chop prosciutto into small pieces.",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 159701,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 159702,
      "primary_message": "Add bell pepper and onion to the skillet and cook, stirring occasionally, until soft, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 159703,
      "primary_message": "Meanwhile, in a medium bowl, whisk together eggs, salt, and pepper.",
      "secondary_message": "12 eggs\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 159704,
      "primary_message": "Coarsely grate the cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 159705,
      "primary_message": "Add prosciutto to the skillet with the peppers and cook, stirring occasionally, until prosciutto is crispy, 1 minute more. Transfer veggies and meat to a plate and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 159706,
      "primary_message": "Wipe the skillet dry with paper towel and return to medium-low heat. Add more butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 159707,
      "primary_message": "Add ½ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing the uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 159708,
      "primary_message": "Sprinkle ½ of the cheese and ½ of the prosciutto mixture over one side of the omelet. Fold the omelet in half and cook until warmed through, about 1 minute. Transfer omelet to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 159709,
      "primary_message": "Add more butter to the skillet and repeat with remaining eggs, cheese, and prosciutto mixture.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 159710,
      "primary_message": "To serve, cut omelets in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
