  "instructions": [
    {
      "id": 159724,
      "primary_message": "Wash and dry bell pepper, then seed and small dice. Peel and small dice onion.",
      "secondary_message": "1 green bell pepper\n½ medium yellow onion"
    },
    {
      "id": 159725,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 159726,
      "primary_message": "Roughly chop prosciutto into small pieces.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 159727,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 159728,
      "primary_message": "Add bell pepper and onion to the skillet and cook, stirring occasionally, until soft, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 159729,
      "primary_message": "Meanwhile, in a large bowl, whisk together eggs, salt, and pepper.",
      "secondary_message": "6 eggs\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 159730,
      "primary_message": "Coarsely grate the cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 159731,
      "primary_message": "Add prosciutto to the skillet with the peppers and cook, stirring occasionally, until prosciutto is crispy, 1 minute more. Transfer veggies and meat to a plate and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 159732,
      "primary_message": "Wipe the skillet dry with paper towel and return to medium-low heat. Add more butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 159733,
      "primary_message": "Add eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing the uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 159734,
      "primary_message": "Sprinkle the cheese over one side of the omelet; layer prosciutto mixture on top. Fold the omelet in half and cook until cheese is melted, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 159735,
      "primary_message": "To serve, cut omelet in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
