  "instructions": [
    {
      "id": 404236,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 404237,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add riced cauliflower and cook, stirring often, until lightly golden and cooked through, 5-7 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 (12 oz) bags frozen, riced cauliflower"
    },
    {
      "id": 404238,
      "primary_message": "Transfer cooked cauliflower rice to a medium bowl. Add eggs, flour, and spices, then stir to combine the fritter mixture. (Reserve skillet for the next step.)",
      "secondary_message": "4 eggs\n1 cup all-purpose flour\n½ tsp dill, dried\n½ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 404239,
      "primary_message": "Return skillet to medium-high heat. Once the skillet is hot, add more oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 404240,
      "primary_message": "Working in batches if necessary, using a ¼-cup measure, scoop the cauliflower mixture into the skillet, spacing each scoop a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown and cooked through, 3-5 minutes. Transfer to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 404241,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip if they came pre-washed). Place in a large bowl along with pine nuts and vinaigrette. Toss to combine the salad and set aside.",
      "secondary_message": "2 (5 oz) pkgs spring mix (mixed greens)\n¼ cup pine nuts\n⅓ cup balsamic vinaigrette"
    },
    {
      "id": 404242,
      "primary_message": "Chop or tear salmon into bite-sized pieces. ",
      "secondary_message": "2 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 404243,
      "primary_message": "To serve, divide salad and fritters between plates; top fritters with tzatziki and salmon. Enjoy!",
      "secondary_message": "1 cup tzatziki sauce"
    }
  ],
