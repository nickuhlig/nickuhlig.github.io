  "instructions": [
    {
      "id": 404292,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 404293,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add riced cauliflower and cook, stirring often, until lightly golden and cooked through, 6-8 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 (340 g) bags frozen, riced cauliflower"
    },
    {
      "id": 404294,
      "primary_message": "Transfer cooked cauliflower rice to a large bowl. Add eggs, flour, and spices, then stir to combine the fritter mixture.",
      "secondary_message": "6 eggs\n1 ½ cup all-purpose flour\n¾ tsp dill, dried\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 404295,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 404296,
      "primary_message": "Working in batches, using a ¼-cup measure, scoop the cauliflower mixture into the skillet, spacing each scoop a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown and cooked through, 3-5 minutes. Transfer to a large paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 404297,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip if they came pre-washed). Place in a large bowl along with pine nuts and vinaigrette. Toss to combine the salad and set aside.",
      "secondary_message": "3 (142 g) pkg spring mix (mixed greens)\n⅓ cup pine nuts\n½ cup balsamic vinaigrette"
    },
    {
      "id": 404298,
      "primary_message": "Chop or tear salmon into bite-sized pieces. ",
      "secondary_message": "3 (113 g) pkg smoked salmon"
    },
    {
      "id": 404299,
      "primary_message": "To serve, divide salad and fritters between plates; top fritters with tzatziki and salmon. Enjoy!",
      "secondary_message": "1 ½ cups tzatziki sauce"
    }
  ],
