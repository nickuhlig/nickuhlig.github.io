  "instructions": [
    {
      "primary_message": "Wash, dry, and quarter peaches and plums lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into thin wedges and place in a medium saucepan along with vanilla and spices.",
      "secondary_message": "2 peaches\n2 plums\n½ tsp vanilla extract\n⅛ tsp cardamom, ground\n⅛ tsp nutmeg, ground\n1 pinch salt"
    },
    {
      "primary_message": "Set the pan over medium-high and cook, stirring occasionally, until fruit is tender and saucy, 5-7 minutes. Remove from heat and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide yogurt, almond butter, and peach-plum compote between bowls, then drizzle with honey. Enjoy!",
      "secondary_message": "1 ½ cups plain Greek yogurt\n¼ cup natural almond butter\n2 tsp honey"
    }
  ],
