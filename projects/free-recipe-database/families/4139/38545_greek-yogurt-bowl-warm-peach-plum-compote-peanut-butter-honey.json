  "instructions": [
    {
      "id": 601310,
      "primary_message": "Wash, dry, and quarter peaches and plums lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into thin wedges and place in a medium saucepan along with honey, vanilla, and spices. ",
      "secondary_message": "2 peaches\n2 plums\n2 tsp honey\n½ tsp vanilla extract\n⅛ tsp cardamom, ground\n⅛ tsp nutmeg, ground\n1 pinch salt"
    },
    {
      "id": 601311,
      "primary_message": "Set the pan over medium-high and cook, stirring occasionally, until fruit is tender and saucy, 5-7 minutes. Remove from heat and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 601312,
      "primary_message": "To serve, divide yogurt, peanut butter, and peach-plum compote between bowls. Drizzle with honey and enjoy!",
      "secondary_message": "1 ½ cups plain Greek yogurt\n¼ cup natural peanut butter\n2 tsp honey"
    }
  ],
