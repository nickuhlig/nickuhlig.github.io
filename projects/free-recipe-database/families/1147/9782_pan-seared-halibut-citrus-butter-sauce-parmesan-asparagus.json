  "instructions": [
    {
      "id": 156176,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 156177,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n½ lemon\n½ orange"
    },
    {
      "id": 156178,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Place on a baking sheet, drizzle with oil, and season with salt and pepper. Toss to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 156179,
      "primary_message": "Place asparagus in the oven (it doesn't have to be fully heated) and bake until tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 156180,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 156181,
      "primary_message": "While the skillet heats up, pat the halibut dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb halibut fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 156182,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 156183,
      "primary_message": "Add halibut and pan-fry, turning once, until lightly browned and just cooked through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 156184,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 156185,
      "primary_message": "Peel and mince shallot and garlic.",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 156186,
      "primary_message": "Juice lemon and orange into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 156187,
      "primary_message": "Remove asparagus from the oven and sprinkle with half of the Parmesan. Return to the oven and bake until cheese is melted and golden, 2-3 minutes. Remove and set aside.",
      "secondary_message": null
    },
    {
      "id": 156188,
      "primary_message": "Transfer the cooked halibut to a clean plate and cover with foil. Return skillet to medium heat.",
      "secondary_message": null
    },
    {
      "id": 156189,
      "primary_message": "Add shallot and garlic to the skillet and cook, stirring frequently, until starting to soften, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 156190,
      "primary_message": "Add citrus juice and butter to the skillet, scraping up any browned bits. Cook, stirring frequently, until sauce thickens slightly, about 3 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 156191,
      "primary_message": "To serve, divide asparagus, halibut, and citrus sauce between plates. Top with remaining Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
