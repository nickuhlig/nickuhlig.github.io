  "instructions": [
    {
      "id": 302456,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 302457,
      "primary_message": "Peel and small dice the onion. Peel and mince the garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 302458,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 302459,
      "primary_message": "Add the onion and garlic to the pan; cook, stirring frequently, until slightly softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 302460,
      "primary_message": "Use the tip of a knife to slice down the length of the sausages. Peel off the casings and discard. Add the pork to the pan and break apart with a spoon. Cook, stirring occasionally, until pork is browned and crumbly, 5-7 minutes.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 302461,
      "primary_message": "Coarsely grate the mozzarella. Finely grate the Parmesan.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese\n½ oz Parmesan cheese"
    },
    {
      "id": 302462,
      "primary_message": "Add gnocchi, diced tomatoes with their juices, water, Italian seasoning, and salt to the pan. Cover and cook on medium heat until gnocchi is cooked through, 3-5 minutes. Remove from heat.",
      "secondary_message": "½ (16 oz) pkg potato gnocchi\n1 (14.5 oz) can diced tomatoes\n¼ cup water\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 302463,
      "primary_message": "Wash and dry the spinach (Skip the spinach if it came pre-washed.) Add spinach to the pan; stir until wilted and the ingredients are combined, 1-2 minutes.",
      "secondary_message": "½ (5 oz) pkg baby spinach"
    },
    {
      "id": 302464,
      "primary_message": "Sprinkle both cheeses over the gnocchi and cover. Let sit for 3-5 minutes until cheese is melted.",
      "secondary_message": null
    },
    {
      "id": 302465,
      "primary_message": "To serve, divide gnocchi between bowls and enjoy!",
      "secondary_message": null
    }
  ],
