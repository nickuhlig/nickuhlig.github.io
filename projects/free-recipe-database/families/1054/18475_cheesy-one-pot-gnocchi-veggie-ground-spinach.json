  "instructions": [
    {
      "id": 302594,
      "primary_message": "Peel and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 302595,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 302596,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring frequently, until slightly softened, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 302597,
      "primary_message": "When the onion is soft, add veggie ground to the pot and cook, breaking it apart with a spoon, until crumbly and cooked through, 5-6 minutes.",
      "secondary_message": "24 oz veggie ground, plant based"
    },
    {
      "id": 302598,
      "primary_message": "Meanwhile, coarsely grate mozzarella; finely grate Parmesan.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese\n1 ½ oz Parmesan cheese"
    },
    {
      "id": 302599,
      "primary_message": "When the veggie ground is done, add gnocchi, tomatoes, water, Italian seasoning, and salt to the pot. Stir to combine, cover, and cook until the gnocchi is warmed through, about 5 minutes. Remove from heat.",
      "secondary_message": "1 ½ (16 oz) pkg potato gnocchi\n3 (14.5 oz) cans diced tomatoes\n¾ cup water\n1 ½ tsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 302600,
      "primary_message": "While the gnocchi is cooking, wash and dry the spinach (skip this step if the spinach came pre-washed).",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 302601,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful; stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 302602,
      "primary_message": "Sprinkle both cheeses over the gnocchi and cover. Let sit until cheese is melted, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 302603,
      "primary_message": "To serve, divide gnocchi between bowls and enjoy!",
      "secondary_message": null
    }
  ],
