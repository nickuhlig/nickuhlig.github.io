  "instructions": [
    {
      "id": 302624,
      "primary_message": "Peel and small dice the onions. Peel and mince the garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 302625,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 302626,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 302627,
      "primary_message": "Add the onion and garlic to the pot; cook, stirring frequently, until slightly softened, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 302628,
      "primary_message": "Use the tip of a knife to slice down the length of the sausages. Peel off the casings and discard. Add the pork to the skillet and break apart with a spoon. Cook, stirring occasionally, until pork is browned and crumbly, 7-9 minutes.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 302629,
      "primary_message": "Coarsely grate the mozzarella. Finely grate the Parmesan.",
      "secondary_message": "¾ (227 g) block mozzarella cheese\n43 g Parmesan cheese"
    },
    {
      "id": 302630,
      "primary_message": "Add gnocchi, diced tomatoes with their juices, water, Italian seasoning, and salt to the pot. Cover and cook on medium heat until gnocchi is cooked through, 5-7 minutes. Remove from heat.",
      "secondary_message": "1 ½ (454 g) pkgs potato gnocchi\n3 (398 ml) cans diced tomatoes\n¾ cup water\n1 ½ tsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 302631,
      "primary_message": "Wash and dry the spinach (Skip the spinach if it came pre-washed.) Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful, 1-2 minutes. Stir until well combined.",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 302632,
      "primary_message": "Sprinkle both cheeses over the gnocchi and cover. Let sit for 3-5 minutes until cheese is melted.",
      "secondary_message": null
    },
    {
      "id": 302633,
      "primary_message": "To serve, divide gnocchi between bowls and enjoy!",
      "secondary_message": null
    }
  ],
