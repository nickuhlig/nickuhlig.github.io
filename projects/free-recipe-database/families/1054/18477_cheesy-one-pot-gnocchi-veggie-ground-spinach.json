  "instructions": [
    {
      "id": 302647,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 302648,
      "primary_message": "Meanwhile, peel and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 302649,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring frequently, until slightly softened, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 302650,
      "primary_message": "When the onion is soft, add veggie ground to the pan and cook, breaking it apart with a spoon, until crumbly and cooked through, about 5 minutes.",
      "secondary_message": "227 g veggie ground, plant based"
    },
    {
      "id": 302651,
      "primary_message": "Meanwhile, coarsely grate mozzarella; finely grate Parmesan.",
      "secondary_message": "¼ (227 g) block mozzarella cheese\n14 g Parmesan cheese"
    },
    {
      "id": 302652,
      "primary_message": "When the veggie ground is done, add gnocchi, tomatoes, water, Italian seasoning, and salt to the pan. Stir to combine, cover, and cook until the gnocchi is warmed through, 3-5 minutes. Remove from heat.",
      "secondary_message": "½ (454 g) pkg potato gnocchi\n1 (398 ml) can diced tomatoes\n¼ cup water\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 302653,
      "primary_message": "While the gnocchi is cooking, wash and dry the spinach (skip this step if the spinach came pre-washed).",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 302654,
      "primary_message": "Add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful; stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 302655,
      "primary_message": "Sprinkle both cheeses over the gnocchi and cover. Let sit until cheese is melted, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 302656,
      "primary_message": "To serve, divide gnocchi between bowls and enjoy!",
      "secondary_message": null
    }
  ],
