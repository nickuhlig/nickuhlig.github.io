  "instructions": [
    {
      "id": 568303,
      "primary_message": "In a small saucepan, combine broth, quinoa, and salt; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup quinoa\n¼ tsp salt"
    },
    {
      "id": 568304,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 568305,
      "primary_message": "Once the skillet is hot, add prosciutto in a single layer and cook until crispy, 1-2 minutes per side. Remove to a paper towel-lined plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 568306,
      "primary_message": "Meanwhile, peel, halve, and slice shallot lengthwise into thin strips.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 568307,
      "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom. Add shallot and salt; cook, stirring occasionally, until golden and starting to crisp, 3-4 minutes. Add to the plate with the prosciutto and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 568308,
      "primary_message": "While the shallot is cooking, peel and mince garlic. Place in a medium bowl along with oil, honey, vinegar, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n2 tsp honey\n1 tsp apple cider vinegar\n½ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 568309,
      "primary_message": "Wash, dry, quarter, core, and thinly slice apple. Add to the bowl with the dressing and set aside.",
      "secondary_message": "1 Granny Smith apple"
    },
    {
      "id": 568310,
      "primary_message": "When the quinoa is done, transfer to a baking sheet pan. Spread out in an even layer and let cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 568311,
      "primary_message": "Meanwhile, crumble or chop prosciutto into bite-sized pieces. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 568312,
      "primary_message": "Using a peeler, shave Parmesan into curls. Set aside.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 568313,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl with the dressing, along with the cooled quinoa and pumpkin seeds, then toss to combine the salad.",
      "secondary_message": "1 (142 g) pkg baby arugula\n¼ cup pumpkin seeds"
    },
    {
      "id": 568314,
      "primary_message": "To serve, divide salad between plates or bowls, then top with crumbled prosciutto, crispy shallots, and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
