  "instructions": [
    {
      "id": 568315,
      "primary_message": "In a medium saucepan, combine broth, quinoa, and salt; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup quinoa\n½ tsp salt"
    },
    {
      "id": 568316,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 568317,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add prosciutto in a single layer and cook until crispy, 1-2 minutes per side. Remove to a paper towel-lined plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 568318,
      "primary_message": "Meanwhile, peel, halve, and slice shallots lengthwise into thin strips.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 568319,
      "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom. Add shallot and salt; cook, stirring occasionally, until golden and starting to crisp, 3-4 minutes. Add to the plate with the prosciutto and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 568320,
      "primary_message": "While the shallot is cooking, peel and mince garlic. Place in a large bowl along with oil, honey, vinegar, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n4 tsp honey\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 568321,
      "primary_message": "Wash, dry, quarter, core, and thinly slice apples. Add to the bowl with the dressing and set aside.",
      "secondary_message": "2 Granny Smith apples"
    },
    {
      "id": 568322,
      "primary_message": "When the quinoa is done, transfer to a large baking sheet pan. Spread out in an even layer and let cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 568323,
      "primary_message": "Meanwhile, crumble or chop prosciutto into bite-sized pieces. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 568324,
      "primary_message": "Using a peeler, shave Parmesan into curls. Set aside.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 568325,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl with the dressing, along with the cooled quinoa and pumpkin seeds, then toss to combine the salad.",
      "secondary_message": "2 (142 g) pkgs baby arugula\n½ cup pumpkin seeds"
    },
    {
      "id": 568326,
      "primary_message": "To serve, divide salad between plates or bowls, then top with crumbled prosciutto, crispy shallots, and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
