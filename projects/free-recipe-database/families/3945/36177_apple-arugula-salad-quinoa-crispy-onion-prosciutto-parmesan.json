  "instructions": [
    {
      "id": 568327,
      "primary_message": "In a medium saucepan, combine broth, quinoa, and salt; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups quinoa\n¾ tsp salt"
    },
    {
      "id": 568328,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 568329,
      "primary_message": "Once the skillet is hot, working in batches, add prosciutto in a single layer and cook until crispy, 1-2 minutes per side. Remove to a paper towel-lined plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 568330,
      "primary_message": "Meanwhile, peel, halve, and slice onion lengthwise into thin strips.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 568331,
      "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until golden and starting to crisp, 3-4 minutes. Add to the plate with the prosciutto and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 568332,
      "primary_message": "While the onion is cooking, peel and mince garlic. Place in a large bowl along with oil, honey, vinegar, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp honey\n1 tbsp apple cider vinegar\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 568333,
      "primary_message": "Wash, dry, quarter, core, and thinly slice apples. Add to the bowl with the dressing and set aside.",
      "secondary_message": "3 Granny Smith apples"
    },
    {
      "id": 568334,
      "primary_message": "When the quinoa is done, transfer to a large baking sheet pan. Spread out in an even layer and let cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 568335,
      "primary_message": "Meanwhile, crumble or chop prosciutto into bite-sized pieces. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 568336,
      "primary_message": "Using a peeler, shave Parmesan into curls. Set aside.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 568337,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl with the dressing, along with the cooled quinoa and pumpkin seeds, then toss to combine the salad.",
      "secondary_message": "3 (142 g) pkgs baby arugula\n¾ cup pumpkin seeds"
    },
    {
      "id": 568338,
      "primary_message": "To serve, divide salad between plates or bowls, then top with crumbled prosciutto, crispy onion, and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
