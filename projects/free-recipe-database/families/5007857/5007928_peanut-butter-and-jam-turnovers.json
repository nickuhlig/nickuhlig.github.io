  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thaw the puff pastry if frozen. Beat the egg.",
      "secondary_message": "0.45 kg puff pastry\n1 large egg"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cut puff pastry in half and roll one half into a 12- by 30-cm square. Cut square into thirds in both directions to yield 9 (4- by 10-cm) squares. Place each square on a lined baking sheet then place 1 teaspoon each of peanut butter and jam in the center of each. Brush the edges with beaten egg, then fold the pastry over then filling and pinch the edges to seal. Repeat with remaining ingredients, using a separate lined baking sheet.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When you’re ready to bake, brush all the turnovers with remaining beaten egg, then bake until the tops are golden brown, about 15 minutes. Allow to cool 10 minutes before serving.",
      "secondary_message": null
    }
  ],
