  "instructions": [
    {
      "id": 421862,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 421863,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 421864,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; medium dice. Divide between two large baking dishes.",
      "secondary_message": "3 yellow bell peppers"
    },
    {
      "id": 421865,
      "primary_message": "Peel, halve, and medium dice onions. Add to the baking dishes with the bell pepper along with mushrooms and edamame. Drizzle with oil, season with spices, and toss to combine.",
      "secondary_message": "1 ½ medium red onions\n3 (227g ) pkgs sliced white mushrooms\n3 cups edamame\n2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 421866,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake until veggies are just tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 421867,
      "primary_message": "When the pasta is done, drain in a colander and return to the pot. Cover and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 421868,
      "primary_message": "When the veggies are tender, remove from oven. Pour marinara sauce over the veggies, stir to combine, and spread out in an even layer. Sprinkle with cheese.",
      "secondary_message": "1 ½ (680 g) jars marinara sauce\n1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 421869,
      "primary_message": "Return baking dishes to the oven and continue to bake until sauce is warmed through and cheese is melted, 5-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 421870,
      "primary_message": "Add the veggie sauce to the pot with the pasta and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 421871,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
