  "instructions": [
    {
      "id": 421732,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 421733,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 421734,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; medium dice. Transfer to a large baking dish.",
      "secondary_message": "2 yellow bell peppers"
    },
    {
      "id": 421735,
      "primary_message": "Peel, halve, and medium dice onion. Add to the baking dish with the bell pepper along with mushrooms and edamame. Drizzle with oil, season with spices, and toss to combine.",
      "secondary_message": "1 medium red onion\n2 (8 oz) pkgs sliced white mushrooms\n2 cups edamame\n4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 421736,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until veggies are just tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 421737,
      "primary_message": "When the pasta is done, drain in a colander and return to the pot. Cover and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 421738,
      "primary_message": "When the veggies are tender, remove from oven. Pour marinara sauce over the veggies, stir to combine, and spread out in an even layer. Sprinkle with cheese.",
      "secondary_message": "1 (24 oz) jar marinara sauce\n1 cup shredded cheese, Italian blend"
    },
    {
      "id": 421739,
      "primary_message": "Return baking dish to the oven and continue to bake until sauce is warmed through and cheese is melted, about 5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 421740,
      "primary_message": "Add the veggie sauce to the pot with the pasta and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 421741,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
