  "instructions": [
    {
      "id": 587086,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 587087,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 587088,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 587089,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lime\n1 (6 oz) pkg blueberries\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 587090,
      "primary_message": "Zest and juice lime into a medium bowl. Add oil, honey, and spices, then whisk to combine the dressing. Set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tsp honey\n½ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 587091,
      "primary_message": "Using a clean cutting board, cut bread into 1-inch cubes.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 587092,
      "primary_message": "Return skillet (with drippings) to medium heat. Add bread cubes and spices; cook, stirring occasionally, until croutons are golden and toasted, 3-4 minutes. Remove from heat.",
      "secondary_message": "¼ tsp garlic powder\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 587093,
      "primary_message": "Meanwhile, roughly chop pecans and add to the bowl with the dressing. ",
      "secondary_message": "⅓ cup pecan halves"
    },
    {
      "id": 587094,
      "primary_message": "Add crispy bacon, croutons, blueberries, arugula, and feta to the bowl, then toss to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 587095,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
