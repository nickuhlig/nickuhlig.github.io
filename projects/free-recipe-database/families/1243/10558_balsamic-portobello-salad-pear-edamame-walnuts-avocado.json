  "instructions": [
    {
      "id": 169371,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 caps portobello mushrooms\n1 pear\n1 (142 g) pkg spring mix (mixed greens)\n1 avocado"
    },
    {
      "id": 169372,
      "primary_message": "Place frozen edamame in a medium bowl, cover with hot water (from the tap), and let sit 5 minutes. Drain in a colander; set aside to drain further.",
      "secondary_message": "1 cup edamame"
    },
    {
      "id": 169373,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 169374,
      "primary_message": "In a salad bowl, whisk together garlic, nutritional yeast, vinegar, oil, maple syrup, Dijon, salt, and pepper. ",
      "secondary_message": "⅛ cup nutritional yeast flakes\n3 tbsp apple cider vinegar\n1 ½ tbsp balsamic vinegar\n2 tbsp extra virgin olive oil\n1 tsp pure maple syrup\n1 tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 169375,
      "primary_message": "Remove the mushroom stems and carefully scrape out the gills. Transfer to the salad bowl and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 169376,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 169377,
      "primary_message": "Peel and slice the onion into rings; add to the bowl with the mushrooms and toss to coat. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 169378,
      "primary_message": "Using tongs, transfer the mushrooms and onions to the grill pan, leaving the excess marinade in the bowl. Cook until vegetables are tender, 3-5 minutes per side. Remove from heat and transfer mushrooms to a cutting board to cool slightly. ",
      "secondary_message": null
    },
    {
      "id": 169379,
      "primary_message": "Meanwhile, core and chop the pear; add to the salad bowl. ",
      "secondary_message": null
    },
    {
      "id": 169380,
      "primary_message": "Add mixed greens, edamame, and walnuts to the salad bowl. ",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 169381,
      "primary_message": "Halve and pit the avocado; slice crosswise and lengthwise while still in the skin and scoop out into the salad bowl. ",
      "secondary_message": null
    },
    {
      "id": 169382,
      "primary_message": "Add onions to the salad and toss. Slice mushrooms into long strips. ",
      "secondary_message": null
    },
    {
      "id": 169383,
      "primary_message": "To serve, divide the salad between plates and top with sliced mushrooms. Enjoy!",
      "secondary_message": null
    }
  ],
