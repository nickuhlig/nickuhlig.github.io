  "instructions": [
    {
      "id": 228958,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ oranges\n6 medium carrots\n3 (8 oz) pkg sugar snap peas\n1 small bunch green onions (scallions)"
    },
    {
      "id": 228959,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 228960,
      "primary_message": "While the pot heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 228961,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the pot; cook, turning once, until golden brown on each side, 6-7 minutes (chicken will not be cooked through all the way).",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 228962,
      "primary_message": "Meanwhile zest and juice oranges into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 228963,
      "primary_message": "Peel and mince garlic; add to the bowl with the orange juice.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 228964,
      "primary_message": "Add water, sugar, soy sauce, ketchup, vinegar, and spices to the bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "¾ cup water\n3 tbsp brown sugar\n3 tbsp soy sauce\n3 tbsp ketchup\n2 tbsp rice vinegar\n½ tsp cayenne pepper\n½ tsp cinnamon, ground\n½ tsp cloves, ground"
    },
    {
      "id": 228965,
      "primary_message": "Peel, trim, and thinly slice carrots. Add carrots and snap peas to the pot, along with any chicken thighs that may have been removed if cooked in batches.",
      "secondary_message": null
    },
    {
      "id": 228966,
      "primary_message": "Add sauce to the pot and bring to a boil over high heat (reserve bowl for later use). Reduce heat and simmer, turning thighs occasionally, until chicken is cooked through and veggies are tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 228967,
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 228968,
      "primary_message": "Trim green onions and cut into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 228969,
      "primary_message": "In the reserved bowl, make a slurry by whisking water with cornstarch until smooth. Add to the pot in a steady stream, while stirring constantly; continue to simmer, until sauce thickens, about 3 minutes. Remove from heat.",
      "secondary_message": "3 tbsp water\n2 tbsp cornstarch"
    },
    {
      "id": 228970,
      "primary_message": "To serve, divide chicken-vegetable sauté between plates or bowls. Top with peanuts and green onion. Enjoy!",
      "secondary_message": null
    }
  ],
