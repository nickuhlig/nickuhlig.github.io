  "instructions": [
    {
      "id": 228904,
      "primary_message": "In a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir; cover and let stand for 10 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 228905,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 orange\n4 medium carrots\n1 (8 oz) pkg sugar snap peas\n1 small bunch green onions (scallions)"
    },
    {
      "id": 228906,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 228907,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 228908,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet; cook, turning once, until golden brown on each side, 6-7 minutes (chicken will not be cooked through all the way).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 228909,
      "primary_message": "Meanwhile, zest and juice orange into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 228910,
      "primary_message": "Peel and mince garlic; add to the bowl with the orange juice.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 228911,
      "primary_message": "Add water, sugar, soy sauce, ketchup, vinegar, and spices to the bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "½ cup water\n3 tbsp brown sugar\n2 tbsp soy sauce\n2 tbsp ketchup\n4 tsp rice vinegar\n¼ tsp cayenne pepper\n¼ tsp cinnamon, ground\n¼ tsp cloves, ground"
    },
    {
      "id": 228912,
      "primary_message": "Peel, trim, and thinly slice carrots. Add carrots and snap peas to the skillet with the chicken.",
      "secondary_message": null
    },
    {
      "id": 228913,
      "primary_message": "Add sauce to the skillet and bring to a boil over high heat (reserve bowl for later use). Reduce heat and simmer, turning thighs occasionally, until chicken is cooked through and veggies are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 228914,
      "primary_message": "While the chicken cooks, roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 228915,
      "primary_message": "Trim green onions and cut into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 228916,
      "primary_message": "In the reserved bowl, make a slurry by whisking water with cornstarch until smooth. Add to the skillet in a steady stream, while stirring constantly; continue to simmer, until sauce thickens, 1-2 minutes. Remove from heat.",
      "secondary_message": "2 tbsp water\n4 tsp cornstarch"
    },
    {
      "id": 228917,
      "primary_message": "To serve, divide chicken-vegetable sauté and couscous between plates or bowls. Top with peanuts and green onion. Enjoy!",
      "secondary_message": null
    }
  ],
