  "instructions": [
    {
      "id": 228932,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ orange\n2 medium carrots\n1 (8 oz) pkg sugar snap peas\n½ small bunch green onions (scallions)"
    },
    {
      "id": 228933,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 228934,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 228935,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet; cook, turning once, until golden brown on each side, 6-7 minutes (chicken will not be cooked through all the way).",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 228936,
      "primary_message": "Meanwhile zest and juice orange into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 228937,
      "primary_message": "Peel and mince garlic; add to the bowl with the orange juice.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 228938,
      "primary_message": "Add water, sugar, soy sauce, ketchup, vinegar, and spices to the bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup water\n1 tbsp brown sugar\n1 tbsp soy sauce\n1 tbsp ketchup\n2 tsp rice vinegar\n⅛ tsp cayenne pepper\n⅛ tsp cinnamon, ground\n⅛ tsp clove, ground"
    },
    {
      "id": 228939,
      "primary_message": "Peel, trim, and thinly slice carrots. Add carrots and snap peas to the skillet with the chicken.",
      "secondary_message": null
    },
    {
      "id": 228940,
      "primary_message": "Add sauce to the skillet and bring to a boil over high heat (reserve bowl for later use). Reduce heat and simmer, turning thighs occasionally, until chicken is cooked through and veggies are tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 228941,
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 228942,
      "primary_message": "Trim green onions and cut into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 228943,
      "primary_message": "In the reserved bowl, make a slurry by whisking water with cornstarch until smooth. Add to the skillet in a steady stream, while stirring constantly; continue to simmer, until sauce thickens, about 1 minute. Remove from heat.",
      "secondary_message": "1 tbsp water\n2 tsp cornstarch"
    },
    {
      "id": 228944,
      "primary_message": "To serve, divide chicken-vegetable sauté between plates or bowls. Top with peanuts and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
