  "instructions": [
    {
      "id": 575617,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 fennel bulbs\n6 medium carrots\n6 sticks celery"
    },
    {
      "id": 575618,
      "primary_message": "Trim off root ends and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 575619,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 575620,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 575621,
      "primary_message": "Peel, halve, and small dice onions. Peel and thinly slice garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 575622,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 575623,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices; cook, stirring occasionally, until veggies are starting to soften 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 575624,
      "primary_message": "Meanwhile, drain and rinse chickpeas in a colander.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 575625,
      "primary_message": "When the veggies have started to soften, add chickpeas, broth, and tomatoes to the pot, then stir to combine the stew. Bring to a boil over high heat, then reduce heat and simmer until veggies and chickpeas are tender, about 5 minutes. Remove from heat.",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes"
    },
    {
      "id": 575626,
      "primary_message": "While the stew is cooking, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 575627,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "6 slices sourdough bread"
    },
    {
      "id": 575628,
      "primary_message": "Divide stew between bowls and serve with toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
