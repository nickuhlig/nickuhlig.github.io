  "instructions": [
    {
      "id": 575403,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 fennel bulbs\n2 medium carrots\n2 sticks celery"
    },
    {
      "id": 575404,
      "primary_message": "Trim off root ends and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 575405,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 575406,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 575407,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 575408,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Peel and thinly slice garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 575409,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices; cook, stirring occasionally, until veggies are starting to soften 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 575410,
      "primary_message": "Meanwhile, drain and rinse chickpeas in a colander.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 575411,
      "primary_message": "When the veggies have started to soften, add chickpeas, broth, and tomatoes to the pot, then stir to combine the stew. Bring to a boil over high heat, then reduce heat and simmer until veggies and chickpeas are tender, about 5 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 575412,
      "primary_message": "While the stew is cooking, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 575413,
      "primary_message": "Pat cod dry with paper towels and cut into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "1 ½ lb cod fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 575414,
      "primary_message": "When the veggies are tender, add cod to the stew. Continue to cook, stirring occasionally, until the cod is opaque and cooked through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 575415,
      "primary_message": "Meanwhile, arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 575416,
      "primary_message": "Divide stew between bowls and serve with toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
