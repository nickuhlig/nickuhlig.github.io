  "instructions": [
    {
      "id": 575389,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 fennel bulb\n1 medium carrot\n1 stick celery"
    },
    {
      "id": 575390,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 575391,
      "primary_message": "Peel, trim, and small dice carrot. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 575392,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 575393,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 575394,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and thinly slice garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 575395,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices; cook, stirring occasionally, until veggies are starting to soften 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 575396,
      "primary_message": "Meanwhile, drain and rinse chickpeas in a colander.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 575397,
      "primary_message": "When the veggies have started to soften, add chickpeas, broth, and tomatoes to the pan, then stir to combine the stew. Bring to a boil over high heat, then reduce heat and simmer until veggies and chickpeas are tender, about 5 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 575398,
      "primary_message": "While the stew is cooking, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 575399,
      "primary_message": "Pat cod dry with paper towels and cut into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "¾ lb cod fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 575400,
      "primary_message": "When the veggies are tender, add cod to the stew. Continue to cook, stirring occasionally, until the cod is opaque and cooked through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 575401,
      "primary_message": "Meanwhile, arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "2 slices sourdough bread"
    },
    {
      "id": 575402,
      "primary_message": "Divide stew between bowls and serve with toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
