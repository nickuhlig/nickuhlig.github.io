  "instructions": [
    {
      "id": 133475,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 133476,
      "primary_message": "Wash basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 133477,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 133478,
      "primary_message": "Crack the eggs into a medium bowl and season with crushed red pepper; whisk together. ",
      "secondary_message": "8 eggs\n⅛ tsp crushed red pepper"
    },
    {
      "id": 133479,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 133480,
      "primary_message": "Pour one-quarter of the egg mixture (or about ⅓ cup) into the skillet and swirl to make an omelet the size of a tortilla. Let cook, undisturbed, for 30 seconds. Before the egg fully sets, place a tortilla on top and press down gently with a spatula. ",
      "secondary_message": "1 large flour tortilla"
    },
    {
      "id": 133481,
      "primary_message": "When the egg is cooked, after about 1 minute, flip the tortilla. Working quickly, sprinkle one-quarter of the cheese and basil over the egg, followed by 2 slices prosciutto; let cook 30-60 seconds more. Transfer to a plate and roll tortilla tightly to close. Cover with aluminum foil until ready to serve. ",
      "secondary_message": "2 slices prosciutto"
    },
    {
      "id": 133482,
      "primary_message": "Add more oil (½ tsp per tortilla) to the skillet and repeat with remaining egg mixture, tortillas, cheese, basil, and prosciutto.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n3 large flour tortillas\n6 slices prosciutto"
    },
    {
      "id": 133483,
      "primary_message": "To serve, slice rolls in half and divide between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
