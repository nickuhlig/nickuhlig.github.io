  "instructions": [
    {
      "id": 133484,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 133485,
      "primary_message": "Wash basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 133486,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 133487,
      "primary_message": "Crack the eggs into a large bowl and season with crushed red pepper; whisk together. ",
      "secondary_message": "12 eggs\n¼ tsp crushed red pepper"
    },
    {
      "id": 133488,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 133489,
      "primary_message": "Pour one-sixth of the egg mixture (or about ⅓ cup) into the skillet and swirl to make an omelet the size of a tortilla. Let cook, undisturbed, for 30 seconds. Before the egg fully sets, place a tortilla on top and press down gently with a spatula. ",
      "secondary_message": "1 large flour tortilla"
    },
    {
      "id": 133490,
      "primary_message": "When the egg is cooked, after about 1 minute, flip the tortilla. Working quickly, sprinkle one-sixth of the cheese and basil over the egg, followed by 2 slices prosciutto; let cook 30-60 seconds more. Transfer to a plate and roll tortilla tightly to close. Cover with aluminum foil until ready to serve. ",
      "secondary_message": "2 slices prosciutto"
    },
    {
      "id": 133491,
      "primary_message": "Add more oil (½ tsp per tortilla) to the skillet and repeat with remaining egg mixture, tortillas, cheese, basil, and prosciutto.",
      "secondary_message": "2 ½ tsp extra virgin olive oil\n5 large flour tortillas\n10 slices prosciutto"
    },
    {
      "id": 133492,
      "primary_message": "To serve, slice rolls in half and divide between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
