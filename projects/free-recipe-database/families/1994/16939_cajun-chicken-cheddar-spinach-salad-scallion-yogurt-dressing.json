  "instructions": [
    {
      "id": 275641,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ small bunches green onions (scallions)\n1 ½ small pkgs grape tomatoes\n1 ½ avocados\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 275642,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 275643,
      "primary_message": "While the grill pan heats up, trim green onions and place on a large plate. Drizzle with oil and season with salt.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 275644,
      "primary_message": "Once the grill pan is hot, add the green onions. Cook, turning once, until tender and lightly charred, 5-7 minutes; return to the plate.",
      "secondary_message": null
    },
    {
      "id": 275645,
      "primary_message": "Meanwhile, place yogurt, oil, water, vinegar, and spices in a small bowl; whisk to combine the dressing and set aside. (Add additional water, 1 tablespoon at a time, if necessary, to reach a drizzling consistency.)",
      "secondary_message": "1 cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n1 tbsp water\n1 ½ tsp white wine vinegar\n½ tsp garlic powder\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 275646,
      "primary_message": "Place spices in another small bowl and stir to combine the spice mix.",
      "secondary_message": "2 ½ tsp garlic powder\n2 ½ tsp paprika\n1 ½ tsp oregano, dried\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper\n½ tsp cayenne pepper"
    },
    {
      "id": 275647,
      "primary_message": "Pat the chicken thighs dry with paper towels and place on another large plate; season with the spice mix on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 275648,
      "primary_message": "Once the green onions are done, return grill pan to medium-high heat and coat with oil. Working in batches if necessary, add chicken and grill, flipping once, until charred and cooked through, 8-10 minutes. Remove to a clean plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 275649,
      "primary_message": "Meanwhile, mince the grilled onions and add to the bowl with the dressing. Stir to combine and set aside. (Reserve plate for next step.)",
      "secondary_message": null
    },
    {
      "id": 275650,
      "primary_message": "Coarsely grate cheese and place on the reserved plate.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 275651,
      "primary_message": "Halve tomatoes and add to the plate with the cheese.",
      "secondary_message": null
    },
    {
      "id": 275652,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 275653,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 275654,
      "primary_message": "Divide spinach between plates or bowls; top with cheese, tomatoes, avocado, and chicken. Serve with dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
