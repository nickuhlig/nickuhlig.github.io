  "instructions": [
    {
      "id": 275585,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 275586,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n1 pint grape tomatoes\n2 avocados\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 275587,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 275588,
      "primary_message": "While the grill pan heats up, trim green onions and place on a plate. Drizzle with oil and season with salt.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 275589,
      "primary_message": "Once the grill pan is hot, add the green onions. Cook, turning once, until tender and lightly charred, about 5 minutes; return to the plate.",
      "secondary_message": null
    },
    {
      "id": 275590,
      "primary_message": "Meanwhile, place yogurt, oil, water, vinegar, and spices in a small bowl; whisk to combine the dressing and set aside. (Add additional water, a few teaspoons at a time, if necessary, to reach a drizzling consistency.)",
      "secondary_message": "⅔ cup plain Greek yogurt\n4 tsp extra virgin olive oil\n2 tsp water\n1 tsp white wine vinegar\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 275591,
      "primary_message": "Place spices in another small bowl and stir to combine the spice mix.",
      "secondary_message": "1 ½ tsp garlic powder\n1 ½ tsp paprika\n1 tsp oregano, dried\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 275592,
      "primary_message": "Cut the tofu planks in half, then cut each half into 2 triangles; place on another plate. Season with the spice mix on both sides.",
      "secondary_message": null
    },
    {
      "id": 275593,
      "primary_message": "Once the green onions are done, return grill pan to medium-high heat and coat with oil. Add tofu and grill, flipping once, until charred and warmed through, 5-7 minutes. Return to the plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 275594,
      "primary_message": "Meanwhile, mince the grilled onions add to the bowl with the dressing. Stir to combine and set aside. (Reserve plate for next step.)",
      "secondary_message": null
    },
    {
      "id": 275595,
      "primary_message": "Coarsely grate cheese and place on the reserved plate.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 275596,
      "primary_message": "Halve tomatoes and add to the plate with the cheese.",
      "secondary_message": null
    },
    {
      "id": 275597,
      "primary_message": "Halve and pit the avocados; scoop out with a spoon and medium dice the flesh. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 275598,
      "primary_message": "Divide spinach between plates or bowls; top with cheese, tomatoes, avocado, and tofu. Serve with dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
