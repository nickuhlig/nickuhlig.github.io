  "instructions": [
    {
      "id": 275627,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n1 small pkg grape tomatoes\n1 avocado\n2 (142 g) pkg baby spinach"
    },
    {
      "id": 275628,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 275629,
      "primary_message": "While the grill pan heats up, trim green onions and place on a plate. Drizzle with oil and season with salt.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 275630,
      "primary_message": "Once the grill pan is hot, add the green onions. Cook, turning once, until tender and lightly charred, about 5 minutes; return to the plate.",
      "secondary_message": null
    },
    {
      "id": 275631,
      "primary_message": "Meanwhile, place yogurt, oil, water, vinegar, and spices in a small bowl; whisk to combine the dressing and set aside. (Add additional water, a few teaspoons at a time, if necessary, to reach a drizzling consistency.)",
      "secondary_message": "⅔ cup plain Greek yogurt\n4 tsp extra virgin olive oil\n2 tsp water\n1 tsp white wine vinegar\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 275632,
      "primary_message": "Place spices in another small bowl and stir to combine the spice mix.",
      "secondary_message": "1 ½ tsp garlic powder\n1 ½ tsp paprika\n1 tsp oregano, dried\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 275633,
      "primary_message": "Pat the chicken thighs dry with paper towels and place on another plate; season with the spice mix on both sides.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 275634,
      "primary_message": "Once the green onions are done, return grill pan to medium-high heat and coat with oil. Add chicken and grill, flipping once, until charred and cooked through, 8-10 minutes. Remove to a clean plate. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 275635,
      "primary_message": "Meanwhile, mince the grilled onions and add to the bowl with the dressing. Stir to combine and set aside. (Reserve plate for next step.)",
      "secondary_message": null
    },
    {
      "id": 275636,
      "primary_message": "Coarsely grate cheese and place on the reserved plate.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 275637,
      "primary_message": "Halve tomatoes and add to the plate with the cheese.",
      "secondary_message": null
    },
    {
      "id": 275638,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 275639,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 275640,
      "primary_message": "Divide spinach between plates or bowls; top with cheese, tomatoes, avocado, and chicken. Serve with dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
