  "instructions": [
    {
      "id": 341510,
      "primary_message": "Preheat the oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 341511,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium beets\n½ English cucumber\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 341512,
      "primary_message": "Peel, trim, and medium dice beets; place in a small saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 341513,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with mayo and spices. Stir to combine the aioli. ",
      "secondary_message": "1 clove garlic\n¼ cup avocado oil mayonnaise\n1 tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 341514,
      "primary_message": "Once the water in the saucepan is boiling, reduce to a simmer and cook until beets are fork-tender, 12-14 minutes. ",
      "secondary_message": null
    },
    {
      "id": 341515,
      "primary_message": "While the beets are cooking, pat chicken dry with paper towels and transfer to a baking sheet pan. Remove half of the aioli and divide between the chicken, spreading evenly over each thigh; season with salt and pepper. (Reserve remaining aioli for serving.)",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 341516,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 341517,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp oregano, dried\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 341518,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 341519,
      "primary_message": "Trim and medium dice cucumber; add to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 341520,
      "primary_message": "When the beets are done, drain and run under cold water to cool; set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 341521,
      "primary_message": "Just before serving, add beets and feta to the bowl with the dressing; stir to combine the salad. ",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 341522,
      "primary_message": "To serve, divide chicken and salad between plates; top chicken with reserved aioli. Enjoy!",
      "secondary_message": null
    }
  ],
