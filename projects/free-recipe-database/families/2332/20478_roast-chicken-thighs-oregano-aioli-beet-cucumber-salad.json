  "instructions": [
    {
      "id": 341497,
      "primary_message": "Preheat the oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 341498,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium beets\n1 ½ English cucumbers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 341499,
      "primary_message": "Peel, trim, and medium dice beets; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 341500,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with mayo and spices. Stir to combine the aioli. ",
      "secondary_message": "3 cloves garlic\n¾ cup mayonnaise\n1 tbsp oregano, dried\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 341501,
      "primary_message": "Once the water in the pot is boiling, reduce to a simmer and cook until beets are fork-tender, 12-14 minutes. ",
      "secondary_message": null
    },
    {
      "id": 341502,
      "primary_message": "While the beets are cooking, pat chicken dry with paper towels and transfer to a large baking sheet pan. Remove half of the aioli and divide between the chicken, spreading evenly over each thigh; season with salt and pepper. (Reserve remaining aioli for serving.)",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 341503,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken is cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 341504,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp oregano, dried\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 341505,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 341506,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 341507,
      "primary_message": "When the beets are done, drain and run under cold water to cool; set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 341508,
      "primary_message": "Just before serving, add beets and feta to the bowl with the dressing; stir to combine the salad. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 341509,
      "primary_message": "To serve, divide chicken and salad between plates; top chicken with reserved aioli. Enjoy!",
      "secondary_message": null
    }
  ],
