  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 375[°]. In a mixing bowl combine flour, baking powder, salt, 1/2 cup shredded coconut and sugar and mix until combined then toss chocolate with dry ingredients until evenly distributed. In a separate bowl combine melted butter, milk, egg and vanilla and beat until well combined. Fold wet ingredients into dry ingredients with a rubber spatula, mixing until just combined (some lumps are ok).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Line muffin tin with 10 liners then divide batter between lined cups. Sprinkle each muffin with remaining shredded coconut and bake until muffins are puffed and coconut is brown, about 30 minutes. Remove from oven and allow to cool for 10 minutes before removing. Serve warm.",
      "secondary_message": null
    }
  ],
