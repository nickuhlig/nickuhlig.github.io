  "instructions": [
    {
      "id": 619023,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 619024,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n1 leek\n½ orange\n1 (1 inch) piece ginger root"
    },
    {
      "id": 619025,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 619026,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit, then slice crosswise into 1-inch pieces. Add to the baking sheet with the squash. ",
      "secondary_message": null
    },
    {
      "id": 619027,
      "primary_message": "Zest orange over the veggies, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer. Place baking sheet in the oven (it doesn't have to be fully heated) and roast until squash is golden and fork-tender, about 25 minutes. (Reserve orange for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 619028,
      "primary_message": "Meanwhile, peel and mince ginger. Place in a medium bowl, along with spices, then stir to combine the spice rub.",
      "secondary_message": "½ tsp turmeric, ground\n⅛ tsp cinnamon, ground\n1 pinch black pepper\n1 pinch salt"
    },
    {
      "id": 619029,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 619030,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels; holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half lengthwise into 1-inch thick strips. Add to the bowl with the spice rub and turn to coat.",
      "secondary_message": "1 (9 oz) pkg halloumi cheese"
    },
    {
      "id": 619031,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 619032,
      "primary_message": "Meanwhile, peel and mince garlic. Place in the reserved bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 619033,
      "primary_message": "Juice reserved orange into the bowl with the garlic, then add tahini, sugar, and crushed red pepper. Stir to combine the glaze and set aside",
      "secondary_message": "1 tbsp tahini\n½ tsp brown sugar\n⅛ tsp crushed red pepper"
    },
    {
      "id": 619034,
      "primary_message": "Roughly chop pecans. ",
      "secondary_message": "⅛ cup pecan halves"
    },
    {
      "id": 619035,
      "primary_message": "When the halloumi is done, transfer to the bowl with the glaze and gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 619036,
      "primary_message": "To serve, divide squash, leeks, and glazed halloumi between plates or bowls. Top with pecans and drizzle with any leftover glaze in the bowl. Enjoy!",
      "secondary_message": null
    }
  ],
