  "instructions": [
    {
      "id": 619051,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 619052,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small butternut squash\n3 leeks\n1 ½ oranges\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 619053,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 619054,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit, then slice crosswise into 1-inch pieces. Add to the baking sheets with the squash. ",
      "secondary_message": null
    },
    {
      "id": 619055,
      "primary_message": "Zest oranges over the veggies, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer. Place baking sheets in the oven (it doesn't have to be fully heated) and roast until squash is golden and fork-tender, 25-30 minutes. (Reserve oranges for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 619056,
      "primary_message": "Meanwhile, peel and mince ginger. Place in a large bowl, along with spices, then stir to combine the spice rub.",
      "secondary_message": "1 ½ tsp turmeric, ground\n¼ tsp cinnamon, ground\n⅛ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 619057,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 619058,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels; holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half lengthwise into 1-inch thick strips. Add to the bowl with the spice rub and turn to coat.",
      "secondary_message": "3 (9 oz) pkgs halloumi cheese"
    },
    {
      "id": 619059,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 619060,
      "primary_message": "Meanwhile, peel and mince garlic. Place in the reserved bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 619061,
      "primary_message": "Juice reserved oranges into the bowl with the garlic, then add tahini, sugar, and crushed red pepper. Stir to combine the glaze and set aside",
      "secondary_message": "3 tbsp tahini\n1 ½ tsp brown sugar\n¼ tsp crushed red pepper"
    },
    {
      "id": 619062,
      "primary_message": "Roughly chop pecans. ",
      "secondary_message": "⅓ cup pecan halves"
    },
    {
      "id": 619063,
      "primary_message": "When the halloumi is done, transfer to the bowl with the glaze and gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 619064,
      "primary_message": "To serve, divide squash, leeks, and glazed halloumi between plates or bowls. Top with pecans and drizzle with any leftover glaze in the bowl. Enjoy!",
      "secondary_message": null
    }
  ],
