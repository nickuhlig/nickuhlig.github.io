  "instructions": [
    {
      "id": 179884,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n¼ tsp salt"
    },
    {
      "id": 179885,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 179886,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg cremini mushrooms\n6 (2 ½ cm) pieces ginger root\n1 ½ small bunches green onions (scallions)\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 179887,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 179888,
      "primary_message": "Slice the mushrooms and set aside.",
      "secondary_message": null
    },
    {
      "id": 179889,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ground pork and cook, breaking the meat apart with a spoon, until the pork begins to brown, 5-6 minutes.",
      "secondary_message": "1 ½ tsp toasted sesame oil\n0.91 kg lean ground pork"
    },
    {
      "id": 179890,
      "primary_message": "Meanwhile, drain and dice tofu into ½-inch cubes; add to the pot with the pork.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 179891,
      "primary_message": "Peel and mince or grate ginger; peel and mince garlic. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 179892,
      "primary_message": "Add ginger and garlic to the pot; cook, stirring constantly, until fragrant, 30-60 seconds.",
      "secondary_message": null
    },
    {
      "id": 179893,
      "primary_message": "Add mushrooms, soy sauce, vinegar, and chili-garlic sauce to the pot; continue to cook, stirring often, until the mushrooms begin to soften, 5-6 minutes.",
      "secondary_message": "¼ cup soy sauce\n2 tbsp rice vinegar\n1 ½ tbsp chili-garlic sauce"
    },
    {
      "id": 179894,
      "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth. ",
      "secondary_message": "1 tbsp cornstarch\n3 tbsp water"
    },
    {
      "id": 179895,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces. Add most of the green onions to the pot (reserve a small amount for garnish).",
      "secondary_message": null
    },
    {
      "id": 179896,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 179897,
      "primary_message": "Add the cornstarch slurry to the pot in a steady stream while stirring quickly. Cook, stirring often, until the sauce thickens, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 179898,
      "primary_message": "To serve, divide rice and tofu-pork mixture between bowls or plates. Garnish with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
