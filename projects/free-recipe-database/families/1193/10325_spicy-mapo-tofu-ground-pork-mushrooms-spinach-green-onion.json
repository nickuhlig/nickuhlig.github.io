  "instructions": [
    {
      "id": 179689,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 179690,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 179691,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lb cremini mushrooms\n4 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 179692,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 179693,
      "primary_message": "Slice the mushrooms and set aside.",
      "secondary_message": null
    },
    {
      "id": 179694,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ground pork and cook, breaking the meat apart with a spoon, until the pork begins to brown, 4-5 minutes.",
      "secondary_message": "1 tsp toasted sesame oil\n1 ½ lb lean ground pork"
    },
    {
      "id": 179695,
      "primary_message": "Meanwhile, drain and dice tofu into ½-inch cubes; add to the skillet with the pork.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 179696,
      "primary_message": "Peel and mince or grate ginger; peel and mince garlic. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 179697,
      "primary_message": "Add ginger and garlic to the skillet; cook, stirring constantly, until fragrant, 30-60 seconds.",
      "secondary_message": null
    },
    {
      "id": 179698,
      "primary_message": "Add mushrooms, soy sauce, vinegar, and chili-garlic sauce to the skillet; continue to cook, stirring often, until the mushrooms begin to soften, 5-6 minutes.",
      "secondary_message": "3 tbsp soy sauce\n4 tsp rice vinegar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 179699,
      "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth. ",
      "secondary_message": "2 tsp cornstarch\n2 tbsp water"
    },
    {
      "id": 179700,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces. Add most of the green onions to the skillet (reserve a small amount for garnish).",
      "secondary_message": null
    },
    {
      "id": 179701,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 179702,
      "primary_message": "Add the cornstarch slurry to the skillet in a steady stream while stirring quickly. Cook, stirring often, until the sauce thickens, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 179703,
      "primary_message": "To serve, divide rice and tofu-pork mixture between bowls or plates. Garnish with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
