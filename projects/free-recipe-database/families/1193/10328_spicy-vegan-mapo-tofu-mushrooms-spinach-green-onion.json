  "instructions": [
    {
      "id": 179734,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 179735,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 179736,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 lb cremini mushrooms\n4 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 179737,
      "primary_message": "Slice mushrooms and set aside.",
      "secondary_message": null
    },
    {
      "id": 179738,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 179739,
      "primary_message": "Drain and dice tofu into ½-inch cubes.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 179740,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tofu and cook, stirring occasionally, until the tofu becomes lightly golden, 6-8 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 179741,
      "primary_message": "Meanwhile, peel and mince or grate ginger; peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 179742,
      "primary_message": "Add ginger and garlic to the skillet with the tofu; cook, stirring constantly, until fragrant, 30-60 seconds.",
      "secondary_message": null
    },
    {
      "id": 179743,
      "primary_message": "Add mushrooms, soy sauce, vinegar, and chili-garlic sauce to the skillet; continue to cook, stirring often, until the mushrooms begin to soften, 5-6 minutes.",
      "secondary_message": "3 tbsp soy sauce\n4 tsp rice vinegar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 179744,
      "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth; set aside.",
      "secondary_message": "4 tsp cornstarch\n¼ cup water"
    },
    {
      "id": 179745,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces. Add most of the green onions to the skillet (reserve a small amount for garnish).",
      "secondary_message": null
    },
    {
      "id": 179746,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 179747,
      "primary_message": "Add the cornstarch slurry to the skillet in a steady stream while stirring quickly. Cook, stirring often, until the sauce thickens, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 179748,
      "primary_message": "To serve, divide rice and tofu-mushroom mixture between bowls or plates. Garnish with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
