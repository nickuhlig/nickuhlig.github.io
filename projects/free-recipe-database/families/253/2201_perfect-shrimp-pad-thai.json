  "instructions": [
    {
      "id": 20963,
      "primary_message": "Fill a medium saucepan halfway with water and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Then drain in a colander and rinse.",
      "secondary_message": "8 oz flat rice (pad thai) noodles"
    },
    {
      "id": 20964,
      "primary_message": "If using frozen shrimp, place in a medium bowl, cover with cold water, and set aside to thaw. If using fresh shrimp, skip this step.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 20965,
      "primary_message": "Peel and mince garlic. Peel and mince or grate ginger.",
      "secondary_message": "4 cloves garlic\r\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 20966,
      "primary_message": "Wash carrots, green onions, and cilantro. Peel and julienne (cut into thin sticks) or coarsely grate carrots. Trim and discard root ends of green onions and chop diagonally. Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "6 medium carrots\r\n1 small bunch green onions (scallions)\r\n1 small bunch cilantro"
    },
    {
      "id": 20967,
      "primary_message": "In a medium bowl, whisk together lime juice, fish sauce, chili-garlic sauce, and sugar.",
      "secondary_message": "juice of 2 limes\r\n4 tbsp fish sauce\r\n1 tbsp chili-garlic sauce\r\n4 tbsp brown sugar"
    },
    {
      "id": 20968,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 20969,
      "primary_message": "Drain shrimp in a colander and rinse under cold water until there are no more ice chunks. Spread out on a clean towel and pat dry.",
      "secondary_message": ""
    },
    {
      "id": 20970,
      "primary_message": "Coat bottom of skillet with oil. Add ginger, garlic, white parts of onions, and shrimp. Stir fry until shrimp are pink, 2-3 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 20971,
      "primary_message": "Add carrots and stir fry for 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 20972,
      "primary_message": "Push ingredients to the sides of the skillet and crack eggs into the middle. Let it sit for a few seconds and then scramble.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 20973,
      "primary_message": "Add noodles and pour in sauce. Stir fry until noodles get sticky and are well coated. Then add remaining green onions and almost all the cilantro (save a little for garnishing). Remove from heat and toss with the noodles until well combined.",
      "secondary_message": ""
    },
    {
      "id": 20974,
      "primary_message": "Cut remaining 1 lime into wedges. Roughly chop peanuts.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 20975,
      "primary_message": "To serve, toss pad thai onto a plate and garnish with peanuts, cilantro, and lime wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
