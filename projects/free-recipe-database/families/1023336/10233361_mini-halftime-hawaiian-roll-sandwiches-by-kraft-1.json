  "instructions": [
    {
      "primary_message": "Cut rolls horizontally in half. Place bottom halves of rolls, cut-side up, in 13 x 9-inch pan sprayed with cooking spray; top with turkey, tomatoes and bacon.",
      "secondary_message": null
    },
    {
      "primary_message": "Mix remaining ingredients until blended; drizzle over sandwiches. Cover. Let stand 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Heat oven to 350ºF. Bake sandwiches (covered) for 20 minutes or until heated through.",
      "secondary_message": null
    },
    {
      "primary_message": "CHEF'S TIP: For added flavor, consider incorporating Kraft® Mayo with Olive Oil!",
      "secondary_message": null
    }
