  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, combine flour, cornmeal, baking powder, and salt. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk together eggs and sugar until pale in color, about 3 minutes. Add almond extract and milk and whisk to combine. Add dry ingredients and stir dough together with a spoon or spatula. Stir in white chocolate, cherries, and almonds. Cover dough in plastic wrap and place in refrigerator while oven preheats.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 160°C (325°F). Line a baking sheet with parchment paper. Take dough out of refrigerator and split into two equal pieces. Shape each half into a log about 6 cm wide and 28 cm long. Bake until golden on the edges, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Let logs cool slightly then cut on the bias with a serrated knife to create 2.5-cm cookies. Place cookies back on baking sheet and bake until dried and toasted, another 15-20 minutes. Let cool to the touch then transfer to a wire rack to finish cooling.",
      "secondary_message": null
    }
  ],
