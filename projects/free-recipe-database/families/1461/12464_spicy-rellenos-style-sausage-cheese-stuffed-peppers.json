  "instructions": [
    {
      "id": 209084,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 209085,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 green bell peppers\n2 tomatoes\n1 small bunch cilantro\n1 jalapeño pepper\n1 lime"
    },
    {
      "id": 209086,
      "primary_message": "Place bell peppers in a large ovenproof skillet and drizzle with oil. Place in the oven (it doesn't have to be fully heated) and broil, flipping halfway through, until tender and skins are slightly charred, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 209087,
      "primary_message": "While the peppers cook, large dice tomatoes and place in a blender. ",
      "secondary_message": null
    },
    {
      "id": 209088,
      "primary_message": "Shave cilantro leaves off the stems and discard stems. Transfer leaves to the blender with the tomato. ",
      "secondary_message": null
    },
    {
      "id": 209089,
      "primary_message": "Remove peppers from the oven, transfer to a plate, and set aside to cool. Set oven temperature to 425°F.",
      "secondary_message": null
    },
    {
      "id": 209090,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Add to the blender. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 209091,
      "primary_message": "Juice lime into the blender. ",
      "secondary_message": null
    },
    {
      "id": 209092,
      "primary_message": "Peel and roughly chop garlic and onion. Add to the blender, along with oil, cumin, and salt; blend on high for several minutes until smooth. Set aside.",
      "secondary_message": "4 cloves garlic\n½ medium red onion\n2 tbsp extra virgin olive oil\n½ tsp cumin\n½ tsp salt"
    },
    {
      "id": 209093,
      "primary_message": "Preheat the skillet, used for the peppers, over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 209094,
      "primary_message": "Meanwhile, use the tip of a knife to slice down the length of each sausage. Peel off casings and discard. Add sausage to the skillet and, breaking apart with a spoon, cook until browned and slightly crispy, 6-7 minutes. Remove from the heat. ",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 209095,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 209096,
      "primary_message": "Once the peppers are cool enough to handle, cut a 3-inch lengthwise opening in each pepper on one side, starting just below the stem. Use a spoon to scoop out the seeds.",
      "secondary_message": null
    },
    {
      "id": 209097,
      "primary_message": "Stuff peppers with cheese and sausage. ",
      "secondary_message": null
    },
    {
      "id": 209098,
      "primary_message": "Pour blended sauce into the skillet. Transfer stuffed peppers, seam-side up, to the skillet with the sauce. Place in the oven and bake until peppers are warmed through and cheese is melted, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 209099,
      "primary_message": "To serve, divide sauce and peppers between plates. Top with yogurt and enjoy! ",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
