  "instructions": [
    {
      "id": 209100,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 209101,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 green bell peppers\n3 tomatoes\n1 small bunch cilantro\n1 ½ jalapeño peppers\n1 ½ limes"
    },
    {
      "id": 209102,
      "primary_message": "Place bell peppers in a baking dish and drizzle with oil. Place in the oven (it doesn't have to be fully heated) and broil, flipping halfway through, until tender and skins are slightly charred, 3-4 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 209103,
      "primary_message": "While the peppers cook, large dice tomatoes and place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 209104,
      "primary_message": "Shave cilantro leaves off the stems and discard stems. Transfer leaves to the bowl with the tomato. ",
      "secondary_message": null
    },
    {
      "id": 209105,
      "primary_message": "Remove peppers from the oven and set aside to cool. Set oven temperature to 425°F.",
      "secondary_message": null
    },
    {
      "id": 209106,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 209107,
      "primary_message": "Juice limes into the bowl. ",
      "secondary_message": null
    },
    {
      "id": 209108,
      "primary_message": "Peel and roughly chop garlic and onion. Add to the bowl, along with oil, cumin, and salt. Using an immersion (hand) blender, purée the mixture until smooth. Alternatively, transfer the mixture, working in batches if necessary, to a blender and blend on high for several minutes until smooth. Set aside.",
      "secondary_message": "6 cloves garlic\n1 medium red onion\n3 tbsp extra virgin olive oil\n¾ tsp cumin\n¾ tsp salt"
    },
    {
      "id": 209109,
      "primary_message": "Use the tip of a knife to slice down the length of each sausage; peel off casings and discard.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 209110,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 209111,
      "primary_message": "Once the skillet is hot, add sausage and, breaking apart with a spoon, cook until browned and slightly crispy, 7-8 minutes. Remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 209112,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 209113,
      "primary_message": "Once the peppers are cool enough to handle, transfer to a clean cutting board. Cut a 3-inch lengthwise opening in each pepper on one side, starting just below the stem. Use a spoon to scoop out the seeds.",
      "secondary_message": null
    },
    {
      "id": 209114,
      "primary_message": "Stuff peppers with cheese and sausage. ",
      "secondary_message": null
    },
    {
      "id": 209115,
      "primary_message": "Pour blended sauce into the baking dish. Transfer stuffed peppers, seam-side up, to the baking dish with the sauce. Place in the oven and bake until peppers are warmed through and cheese is melted, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 209116,
      "primary_message": "To serve, divide sauce and peppers between plates. Top with yogurt and enjoy! ",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
