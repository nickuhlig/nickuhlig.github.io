  "instructions": [
    {
      "id": 411541,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 411542,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, 5-6 minutes (or cook sausages according to package instructions). Remove to a large plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 411543,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a large bowl along with shredded cabbage, flour, eggs, and spices; stir to combine.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n1 cup all-purpose flour\n6 eggs\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 411544,
      "primary_message": "Return skillet to medium-high heat, add oil, and swirl to coat the bottom.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 411545,
      "primary_message": "Working in batches, using a ¼-cup measure, scoop the cabbage mixture into the skillet, spacing each scoop a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Transfer to the plate with the sausages and re-cover with foil.",
      "secondary_message": null
    },
    {
      "id": 411546,
      "primary_message": "While the fritters are cooking, place yogurt, dressing, salt, and pepper in a small bowl. Stir to combine the sauce.",
      "secondary_message": "1 cup plain Greek yogurt\n⅓ cup honey mustard dressing\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 411547,
      "primary_message": "Divide fritters and sausages between plates. Serve with sauce on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
