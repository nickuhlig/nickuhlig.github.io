  "instructions": [
    {
      "id": 411529,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 411530,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n2 pre-cooked vegan sausage"
    },
    {
      "id": 411531,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a medium bowl along with shredded cabbage, flour, eggs, and spices; stir to combine.",
      "secondary_message": "½ small bunch green onions (scallions)\n½ (397 g) bag shredded cabbage (coleslaw mix)\n⅓ cup all-purpose flour\n2 eggs\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 411532,
      "primary_message": "Return skillet to medium-high heat, add oil, and swirl to coat the bottom. Using a ¼-cup measure, scoop the cabbage mixture into the skillet, spacing each scoop a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove from heat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 411533,
      "primary_message": "While the fritters are cooking, place yogurt, dressing, salt, and pepper in a small bowl. Stir to combine the sauce.",
      "secondary_message": "⅓ cup plain Greek yogurt\n2 tbsp honey mustard dressing\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 411534,
      "primary_message": "Divide fritters and sausages between plates. Serve with sauce on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
