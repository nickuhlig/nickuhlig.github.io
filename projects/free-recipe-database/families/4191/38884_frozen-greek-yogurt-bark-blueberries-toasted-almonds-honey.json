  "instructions": [
    {
      "id": 605364,
      "primary_message": "Line a large baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 605365,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 605366,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool.",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 605367,
      "primary_message": "Meanwhile, wash and dry blueberries. Set aside.",
      "secondary_message": "2 (6 oz) pkgs blueberries"
    },
    {
      "id": 605368,
      "primary_message": "Place yogurt, honey, and salt in a medium bowl, then whisk to combine.",
      "secondary_message": "2 cups plain Greek yogurt\n2 tbsp honey\n½ tsp salt"
    },
    {
      "id": 605369,
      "primary_message": "Pour yogurt into the prepared baking sheet and spread out in an even layer (about ¼-inch thick). Sprinkle with almonds and blueberries.",
      "secondary_message": null
    },
    {
      "id": 605370,
      "primary_message": "Place baking sheet in the freezer and let chill until the yogurt is completely frozen, about 2 hours.",
      "secondary_message": null
    },
    {
      "id": 605371,
      "primary_message": "Remove baking sheet from freezer and break the yogurt bark apart with your hands.",
      "secondary_message": null
    },
    {
      "id": 605372,
      "primary_message": "Divide bark between plates and serve immediately. Enjoy!",
      "secondary_message": null
    }
  ],
