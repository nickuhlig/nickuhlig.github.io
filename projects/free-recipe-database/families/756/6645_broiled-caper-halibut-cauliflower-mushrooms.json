  "instructions": [
    {
      "id": 164027,
      "primary_message": "Preheat oven to 230°C (450°F) and place racks in the medium and lower positions of the oven.",
      "secondary_message": null
    },
    {
      "id": 164028,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium heads cauliflower\n1.36 kg cremini mushrooms\n1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 164029,
      "primary_message": "Remove leaves from cauliflower; cut into bite-sized florets and place in a large mixing bowl.",
      "secondary_message": null
    },
    {
      "id": 164030,
      "primary_message": "Cut mushrooms into quarters and add to the bowl with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 164031,
      "primary_message": "Drizzle cauliflower and mushrooms with oil and season with thyme, salt, and pepper; toss to coat.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp thyme\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 164032,
      "primary_message": "Divide veggies between two parchment lined baking sheets. Place baking sheets in oven and bake until golden, 6-8 minutes, tossing halfway through.",
      "secondary_message": null
    },
    {
      "id": 164033,
      "primary_message": "Shave leaves from parsley stems; discard stems and mince the leaves. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 164034,
      "primary_message": "Cut lemons into wedges and set aside with parsley.",
      "secondary_message": null
    },
    {
      "id": 164035,
      "primary_message": "Drain and rinse capers.",
      "secondary_message": "6 tbsp capers"
    },
    {
      "id": 164036,
      "primary_message": "Spread the oil over the halibut using a spoon or your hands and season with salt and pepper.",
      "secondary_message": "1.02 kg halibut fillet\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 164037,
      "primary_message": "When cauliflower is golden, place fish on top and sprinkle with capers. Bake until the fish is opaque, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 164038,
      "primary_message": "When fish is cooked remove from oven and set oven to broil. Sprinkle fish with raisins and return to oven; broil until raisins are plump and hot, about 30 seconds per pan.",
      "secondary_message": "¾ cup raisins"
    },
    {
      "id": 164039,
      "primary_message": "Divide halibut and veggies between plates and drizzle with vinegar and any accumulated pan juices. Top with parsley and serve with lemon wedges. Enjoy!",
      "secondary_message": "3 tbsp white wine vinegar"
    }
  ],
