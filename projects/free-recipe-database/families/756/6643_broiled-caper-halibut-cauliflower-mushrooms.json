  "instructions": [
    {
      "id": 164001,
      "primary_message": "Preheat oven to broil on high and position rack about 6 inches under the broiler.",
      "secondary_message": null
    },
    {
      "id": 164002,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n0.45 kg cremini mushrooms\n½ small bunch Italian (flat-leaf) parsley\n½ lemon"
    },
    {
      "id": 164003,
      "primary_message": "Remove leaves from cauliflower; cut into bite-sized florets and place in a large mixing bowl.",
      "secondary_message": null
    },
    {
      "id": 164004,
      "primary_message": "Cut mushrooms into quarters and add to the bowl with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 164005,
      "primary_message": "Drizzle cauliflower and mushrooms with oil and season with thyme, salt, and pepper; toss to coat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp thyme\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 164006,
      "primary_message": "Place on a parchment lined baking sheet. Place baking sheet in oven and broil until golden, 6-8 minutes, tossing halfway through.",
      "secondary_message": null
    },
    {
      "id": 164007,
      "primary_message": "Shave leaves from parsley stems; discard stems and mince the leaves. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 164008,
      "primary_message": "Cut lemon into wedges and set aside with parsley.",
      "secondary_message": null
    },
    {
      "id": 164009,
      "primary_message": "Drain and rinse capers.",
      "secondary_message": "2 tbsp capers"
    },
    {
      "id": 164010,
      "primary_message": "Spread the oil over the halibut using a spoon or your hands and season with salt and pepper.",
      "secondary_message": "⅓ kg halibut fillet\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 164011,
      "primary_message": "When cauliflower is golden, place fish on top and sprinkle with capers. Broil until the fish is opaque, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 164012,
      "primary_message": "When fish is cooked, sprinkle with raisins and broil until raisins are plump and hot, about 30 seconds.",
      "secondary_message": "¼ cup raisins"
    },
    {
      "id": 164013,
      "primary_message": "Divide halibut and vegetables between plates and drizzle with vinegar and any accumulated pan juices. Top with parsley and serve with lemon wedges. Enjoy!",
      "secondary_message": "1 tbsp white wine vinegar"
    }
  ],
