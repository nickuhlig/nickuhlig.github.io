  "instructions": [
    {
      "id": 400340,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 400341,
      "primary_message": "Wash, dry, and quarter potatoes. Place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "0.68 kg new potatoes\n1 tsp salt"
    },
    {
      "id": 400342,
      "primary_message": "Meanwhile, divide cabbage between two large baking dishes. Drizzle with oil and vinegar, then sprinkle with sugar and spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 (397 g) bags shredded cabbage (coleslaw mix)\n2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp brown sugar\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 400343,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake until cabbage is starting to soften, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 400344,
      "primary_message": "While the cabbage is cooking, place dressing and Dijon in a small bowl, stir to combine.",
      "secondary_message": "¼ cup honey mustard dressing\n2 tsp Dijon mustard"
    },
    {
      "id": 400345,
      "primary_message": "Wash, dry, and chop chives into small pieces. Add to the bowl with the dressing and set aside.",
      "secondary_message": "1 small pkg chives"
    },
    {
      "id": 400346,
      "primary_message": "When the cabbage is starting to soften, remove from oven, stir, and spread back out in an even layer. Add sausages, nestling them into the cabbage, then drizzle with oil.",
      "secondary_message": "4 pre-cooked vegan sausage\n2 tsp extra virgin olive oil"
    },
    {
      "id": 400347,
      "primary_message": "Return baking dishes to the oven. Continue to bake until cabbage is tender and sausages are warmed through, 6-8 minutes more (or cook sausages according to package instructions). Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400348,
      "primary_message": "When the potatoes are done, drain and return to the pot. Add dressing and chives, then stir to coat. Cover and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 400349,
      "primary_message": "To serve, divide cabbage, potatoes, and sausages between plates. Enjoy!",
      "secondary_message": null
    }
  ],
