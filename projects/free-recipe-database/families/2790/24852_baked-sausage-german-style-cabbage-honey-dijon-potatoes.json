  "instructions": [
    {
      "id": 400321,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 400322,
      "primary_message": "Wash, dry, and quarter potatoes. Place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "1.02 kg new potatoes\n1 ½ tsp salt"
    },
    {
      "id": 400323,
      "primary_message": "Meanwhile, divide cabbage between two large baking sheet pans. Drizzle with oil and vinegar, then sprinkle with sugar and spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "3 (397 g) bags shredded cabbage (coleslaw mix)\n3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n1 ½ tbsp brown sugar\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 400324,
      "primary_message": "Nestle sausages into the cabbage and drizzle with more oil.",
      "secondary_message": "6 pork sausages\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 400325,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring cabbage and flipping sausages halfway through, until the cabbage is tender and sausages are cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400326,
      "primary_message": "While the cabbage and sausages are cooking, place dressing and Dijon in a small bowl; stir to combine.",
      "secondary_message": "⅓ cup honey mustard dressing\n1 tbsp Dijon mustard"
    },
    {
      "id": 400327,
      "primary_message": "Wash, dry, and chop chives into small pieces. Add to the bowl with the dressing and set aside.",
      "secondary_message": "1 small pkg chives"
    },
    {
      "id": 400328,
      "primary_message": "When the potatoes are done, drain and return to the pot. Add dressing and chives, then stir to coat. Cover and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 400329,
      "primary_message": "To serve, divide cabbage, potatoes, and sausages between plates. Enjoy!",
      "secondary_message": null
    }
  ],
