  "instructions": [
    {
      "id": 400303,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 400304,
      "primary_message": "Wash, dry, and quarter potatoes. Place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "⅓ kg new potatoes\n½ tsp salt"
    },
    {
      "id": 400305,
      "primary_message": "Meanwhile, transfer cabbage to a large baking dish. Drizzle with oil and vinegar, then sprinkle with sugar and spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "1 (397 g) bag shredded cabbage (coleslaw mix)\n1 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 ½ tsp brown sugar\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400306,
      "primary_message": "Nestle sausages into the cabbage and drizzle with more oil.",
      "secondary_message": "2 pork sausages\n1 tsp extra virgin olive oil"
    },
    {
      "id": 400307,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake, stirring cabbage and flipping sausages halfway through, until the cabbage is tender and sausages are cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400308,
      "primary_message": "While the cabbage and sausages are cooking, place dressing and Dijon in a small bowl; stir to combine.",
      "secondary_message": "2 tbsp honey mustard dressing\n1 tsp Dijon mustard"
    },
    {
      "id": 400309,
      "primary_message": "Wash, dry, and chop chives into small pieces. Add to the bowl with the dressing and set aside.",
      "secondary_message": "½ small pkg chives"
    },
    {
      "id": 400310,
      "primary_message": "When the potatoes are done, drain and return to the pan. Add dressing and chives, then stir to coat. Cover and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 400311,
      "primary_message": "To serve, divide cabbage, potatoes, and sausages between plates. Enjoy!",
      "secondary_message": null
    }
  ],
