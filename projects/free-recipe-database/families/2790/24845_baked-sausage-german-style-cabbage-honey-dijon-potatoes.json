  "instructions": [
    {
      "id": 400255,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 400256,
      "primary_message": "Wash, dry, and quarter potatoes. Place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "1 ½ lb new potatoes\n1 tsp salt"
    },
    {
      "id": 400257,
      "primary_message": "Meanwhile, divide cabbage between two large baking dishes. Drizzle with oil and vinegar, then sprinkle with sugar and spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 (14 oz) bags shredded cabbage (coleslaw mix)\n2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp brown sugar\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 400258,
      "primary_message": "Nestle sausages into the cabbage and drizzle with more oil.",
      "secondary_message": "4 pork sausages\n2 tsp extra virgin olive oil"
    },
    {
      "id": 400259,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake, stirring cabbage and flipping sausages halfway through, until the cabbage is tender and sausages are cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400260,
      "primary_message": "While the cabbage and sausages are cooking, place dressing and Dijon in a small bowl; stir to combine.",
      "secondary_message": "¼ cup honey mustard dressing\n2 tsp Dijon mustard"
    },
    {
      "id": 400261,
      "primary_message": "Wash, dry, and chop chives into small pieces. Add to the bowl with the dressing and set aside.",
      "secondary_message": "1 small pkg chives"
    },
    {
      "id": 400262,
      "primary_message": "When the potatoes are done, drain and return to the pot. Add dressing and chives, then stir to coat. Cover and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 400263,
      "primary_message": "To serve, divide cabbage, potatoes, and sausages between plates. Enjoy!",
      "secondary_message": null
    }
  ],
