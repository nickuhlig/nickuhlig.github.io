  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Lightly grease a shallow 2-quart baking dish. Scatter apples into dish and cover with foil. Bake until apples are just beginning to soften, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove foil and let cool slightly, about 10 minutes. Scatter oats and walnuts into dish. Whisk 1/3 cup plus 2 tablespoons brown sugar, salt, cinnamon, egg, milk, and melted butter in medium bowl to combine. Pour into baking dish. Using a spoon, gently press and stir oats into milk mixture to moisten and distribute apples evenly.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Scatter remaining 1 tablespoon brown sugar over top and bake until center is just set, about 30 minutes. Serve immediately, passing more brown sugar at the table.",
      "secondary_message": null
    }
  ],
