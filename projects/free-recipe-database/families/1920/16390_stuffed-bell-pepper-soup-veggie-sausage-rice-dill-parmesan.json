  "instructions": [
    {
      "id": 268027,
      "primary_message": "Small dice sausages.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 268028,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 268029,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until golden brown, 4-5 minutes (or cook sausages according to package instructions). Transfer sausage to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 268030,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 sticks celery\n3 medium carrots\n3 green bell peppers\n1 ½ (5 oz) pkgs baby spinach\n1 small bunch fresh dill"
    },
    {
      "id": 268031,
      "primary_message": "Trim and small dice celery; peel, trim, and small dice carrots. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 268032,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips, then cut crosswise into bite-sized pieces. Add to the bowl with the celery and carrot.",
      "secondary_message": null
    },
    {
      "id": 268033,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 268034,
      "primary_message": "Return the pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 268035,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add veggies and spices; sauté, stirring occasionally, until starting to soften, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 268036,
      "primary_message": "Return sausage to the pot along with broth, tomatoes, and rice; stir to combine and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until rice is soft and veggies are tender, 12-15 minutes.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes\n1 cup basmati rice"
    },
    {
      "id": 268037,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 268038,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 268039,
      "primary_message": "Finely grate Parmesan and set aside.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 268040,
      "primary_message": "When the soup is done, add spinach and dill to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 268041,
      "primary_message": "To serve, divide soup between bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
