  "instructions": [
    {
      "id": 267913,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267914,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add turkey, salt, and pepper to the pan; cook, breaking apart with a spoon, until browned and crumbly, 3-4 minutes. Transfer turkey to a plate and set aside. (Reserve saucepan for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¾ lb ground turkey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 267915,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 stick celery\n1 medium carrot\n1 green bell pepper\n½ (5 oz) pkg baby spinach\n½ small bunch fresh dill"
    },
    {
      "id": 267916,
      "primary_message": "Trim and small dice celery; peel, trim, and small dice carrot. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 267917,
      "primary_message": "Trim, seed, and slice bell pepper into thin strips, then cut crosswise into bite-sized pieces. Add to the bowl with the celery and carrot.",
      "secondary_message": null
    },
    {
      "id": 267918,
      "primary_message": "Peel, halve, and small dice onion; add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 267919,
      "primary_message": "Return the saucepan to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267920,
      "primary_message": "While the pan heats up, peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 267921,
      "primary_message": "Once the pan is hot, add more oil and swirl to coat the bottom. Add veggies and spices; sauté, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 267922,
      "primary_message": "Return turkey to the pan along with broth, tomatoes, and rice; stir to combine and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until rice is soft and veggies are tender, about 12 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n½ (14.5 oz) can diced tomatoes\n⅓ cup basmati rice"
    },
    {
      "id": 267923,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 267924,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 267925,
      "primary_message": "Finely grate Parmesan and set aside.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 267926,
      "primary_message": "When the soup is done, add spinach and dill to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 267927,
      "primary_message": "To serve, divide soup between bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
