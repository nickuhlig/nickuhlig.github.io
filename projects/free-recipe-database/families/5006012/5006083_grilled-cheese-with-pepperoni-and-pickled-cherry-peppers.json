  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the pepperoni. Cut the butter into 3 even pieces. Thinly slice the pickled cherry peppers.",
      "secondary_message": "28 g pepperoni\n2 tbsp butter\n¼ cup pickled cherry peppers"
    },
    {
      "id": 1,
      "primary_message": "Place pepperoni slices on a paper towel-lined microwave-safe plate. Microwave on high power until crispa and rendered, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Melt one third of butter in a large non-stick skillet over medium heat until foaming subsides. Add both bread slices and cook, swirling occasionally, until pale golden brown on bottom side, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to a cutting board toasted-side-up. Place one cheese slice on top of one slice of bread. Top with pepperoni, pickled peppers, and second cheese slice. Close sandwich, with both toasted sides facing inwards.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Melt one more piece of butter in the skillet and reduce heat to medium low. Add sandwich and cook, swirling occasionally, until deep, even golden brown, about 5 minutes. Remove sandwich using a flexible metal spatula. Add the remaining butter. Return sandwich to skillet cooked-side up. Season with salt. Cook, swirling occasionally, until second side is deep, even golden brown and cheese is thoroughly melted, about 5 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
