  "instructions": [
    {
      "id": 159958,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n12 oz rotini pasta"
    },
    {
      "id": 159959,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 159960,
      "primary_message": "While the skillet heats up, cut bread into ¾-inch cubes.",
      "secondary_message": "3 slices whole grain bread"
    },
    {
      "id": 159961,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 159962,
      "primary_message": "Add bread cubes to the skillet and sprinkle with spices. Toast the bread, tossing occasionally, until croutons are golden brown, 6-7 minutes. Remove from heat and set aside.",
      "secondary_message": "½ tsp salt\n½ tsp Italian seasoning\n½ tsp garlic powder"
    },
    {
      "id": 159963,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 heads romaine lettuce\n1 ½ pints grape tomatoes"
    },
    {
      "id": 159964,
      "primary_message": "Grate Parmesan into a large bowl.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 159965,
      "primary_message": "Peel and mince garlic; add to bowl with the Parmesan.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 159966,
      "primary_message": "Mince anchovy fillets and add to the bowl.",
      "secondary_message": "6 anchovy fillets, packed in oil"
    },
    {
      "id": 159967,
      "primary_message": "Juice lemons into the bowl and add mayonnaise, oil, Worcestershire, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¾ cup mayonnaise\n3 tbsp extra virgin olive oil\n1 ½ tsp Worcestershire sauce\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 159968,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 159969,
      "primary_message": "Halve tomatoes crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 159970,
      "primary_message": "Once the pasta is done, drain and rinse under cool water. Add pasta and croutons to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 159971,
      "primary_message": "To serve, divide the pasta salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
