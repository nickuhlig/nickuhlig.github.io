  "instructions": [
    {
      "id": 160028,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "2 tsp salt\n227 g rotini pasta"
    },
    {
      "id": 160029,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 160030,
      "primary_message": "While the skillet heats up, cut bread into ¾-inch cubes.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 160031,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 160032,
      "primary_message": "Add bread cubes to the skillet and sprinkle with spices. Toast the bread, tossing occasionally, until croutons are golden brown, 5-6 minutes. Remove from heat and set aside.",
      "secondary_message": "¼ tsp salt\n¼ tsp Italian seasoning\n¼ tsp garlic powder"
    },
    {
      "id": 160033,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 heads romaine lettuce\n1 small pkg grape tomatoes"
    },
    {
      "id": 160034,
      "primary_message": "Grate Parmesan into a large bowl.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 160035,
      "primary_message": "Peel and mince garlic; add to bowl with the Parmesan.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 160036,
      "primary_message": "Mince anchovy fillets and add to the bowl.",
      "secondary_message": "4 anchovy fillets, packed in oil"
    },
    {
      "id": 160037,
      "primary_message": "Juice lemon into the bowl and add mayonnaise, oil, Worcestershire, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ cup mayonnaise\n2 tbsp extra virgin olive oil\n1 tsp Worcestershire sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 160038,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 160039,
      "primary_message": "Halve tomatoes crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 160040,
      "primary_message": "Once the pasta is done, drain and rinse under cool water. Add pasta and croutons to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 160041,
      "primary_message": "To serve, divide the pasta salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
