  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Split the thighs and drumsticks of the bone-in skin-on chicken legs. Wash, trim, and quarter the cremini mushrooms. Thinly slice the yellow onion. Thinly slice the garlic. Drain and crush the peeled whole tomatoes by hand.",
      "secondary_message": "1.36 to 1.81 kg bone-in skin-on chicken legs\n0.45 kg cremini mushrooms\n2 medium yellow onion\n5 medium cloves garlic\n1 (795 g) can peeled whole tomatoes"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 175°C (350°F). Season chicken all over with salt and pepper. Pour a roughly 1.5-cm layer of flour into a wide, shallow bowl. Dredge each chicken piece in flour and tap off excess.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a Dutch oven or large straight-sided sauté pan, heat oil over medium-high heat until shimmering. Working in batches, add chicken and cook, turning occasionally, until browned all over, about 4 minutes per side. Transfer chicken to a platter as it finishes cooking and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add mushrooms to pan and cook, scraping up browned bits with a wooden spoon and stirring occasionally, until browned all over, about 8 minutes. Add onion and garlic and cook, stirring and scraping up any browned bits, until softened, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add wine and bring to a simmer. Add tomatoes and reserved juices, along with herb sprigs and bay leaf. Return to a simmer. Season with salt and pepper. Nestle chicken and any accumulated juices into liquid and vegetables.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer to oven and cook, uncovered, until chicken is fully cooked through and tender and sauce is slightly reduced and thickened, about 30 minutes. Discard herb sprigs and bay leaf. Serve right away, garnishing with minced parsley if desired.",
      "secondary_message": null
    }
  ],
