  "instructions": [
    {
      "id": 502905,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 502906,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ red chili peppers\n1 ½ limes\n1 ½ English cucumbers\n3 medium carrots\n1 ½ bunches radish\n1 small bunch green onions (scallions)"
    },
    {
      "id": 502907,
      "primary_message": "Peel and mince garlic and ginger; transfer to a small bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 502908,
      "primary_message": "Quarter chili peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the garlic and ginger. (Be careful, with chilies, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 502909,
      "primary_message": "Juice limes into the bowl with the garlic and ginger. Add vinegar, fish sauce, soy sauce, and sugar; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp rice vinegar\n3 tbsp fish sauce\n3 tbsp soy sauce\n3 tbsp brown sugar"
    },
    {
      "id": 502910,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 502911,
      "primary_message": "Meanwhile, pat pork chops dry with paper towels. Place in a baking dish and pour ⅓ of the dressing over the chops; turn to coat. ",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 502912,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 502913,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add pork chops and cook until golden brown and cooked through, 3-4 minutes per side. Discard marinade.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 502914,
      "primary_message": "Meanwhile, trim and halve cucumbers lengthwise, then slice crosswise into half-moons. Transfer to a large plate. ",
      "secondary_message": null
    },
    {
      "id": 502915,
      "primary_message": "Peel and coarsely grate carrots; transfer to the plate with the cucumber. ",
      "secondary_message": null
    },
    {
      "id": 502916,
      "primary_message": "Trim and thinly slice radishes; add to the plate. ",
      "secondary_message": null
    },
    {
      "id": 502917,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the plate. ",
      "secondary_message": null
    },
    {
      "id": 502918,
      "primary_message": "Thinly slice pork chops against the grain.",
      "secondary_message": null
    },
    {
      "id": 502919,
      "primary_message": "To serve, divide noodles, pork, and veggies between bowls. Drizzle with remaining dressing and enjoy!",
      "secondary_message": null
    }
  ],
