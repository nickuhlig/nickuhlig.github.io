  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 clove garlic"
    },
    {
      "primary_message": "Once the skillet is hot, add onion, garlic, beef, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 6-7 minutes. Remove from heat.",
      "secondary_message": "907 g lean ground beef\n3 tbsp chili powder\n2 tsp pumpkin spice mix\n1 tsp salt"
    },
    {
      "primary_message": "Transfer ground beef and any cooking juices to a 6-quart slow cooker insert. Add tomatoes, broth, beans (do not drain), cocoa powder, and Worcestershire, then stir to combine. Cover and cook until flavors have blended, LOW for 4-5 hours or HIGH for about 2 hours. (The chili will be soupy.)\n\n",
      "secondary_message": "2 (411 g) can diced tomatoes\n2 cups chicken or vegetable broth\n1 (266 g) can kidney beans\n2 tbsp cocoa powder\n2 tbsp Worcestershire sauce"
    },
    {
      "primary_message": "When the flavors have blended, break lasagna noodles into 2-inch pieces and add to the slow cooker. Stir to combine and continue to cook until noodles are tender, 1 hour more.",
      "secondary_message": "227 g no-boil lasagna noodles"
    },
    {
      "primary_message": "To serve, divide chili between bowls. Top with cheddar and enjoy!",
      "secondary_message": "2 cups cheddar cheese, shredded"
    }
  ],
