  "instructions": [
    {
      "id": 18168,
      "primary_message": "Rinse rice in a stainer until water runs clear and transfer to a small saucepan. Add water and salt. Bring to a boil. Reduce heat to low, stir, and cover. Cook until liquid is absorbed, 15-18 minutes. Remove from heat and uncover to cool.",
      "secondary_message": "2 cups water\r\n1 cup basmati rice\r\n½ tsp salt"
    },
    {
      "id": 18169,
      "primary_message": "If using frozen shrimp, place in a medium bowl, cover with cold water, and set aside to thaw. If using fresh shrimp, skip this step.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 18170,
      "primary_message": "Wash and dry bell peppers and green onions. Seed and small dice peppers. Trim and discard root ends and slice green onions diagonally into small pieces. Peel and thinly slice onion into half rings. Peel and mince garlic.",
      "secondary_message": "2 red bell peppers\r\n1 small bunch green onions (scallions)\r\n1 medium red onion\r\n4 cloves garlic"
    },
    {
      "id": 18171,
      "primary_message": "Cut skin off pineapple, core, and cut into bite-sized pieces.",
      "secondary_message": "1 small pineapple"
    },
    {
      "id": 18172,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 18173,
      "primary_message": "Drain shrimp and rinse under cold water until there are no more ice chunks. Place on paper towels and pat dry.",
      "secondary_message": ""
    },
    {
      "id": 18174,
      "primary_message": "Coat bottom of skillet with oil. Add shrimp and cook until pink, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 18175,
      "primary_message": "Return skillet to stove and add more oil. Add bell pepper and red onion and, stirring frequently, cook until softened, 2-3 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 18176,
      "primary_message": "Toss rice into a colander to drain off any excess water.",
      "secondary_message": ""
    },
    {
      "id": 18177,
      "primary_message": "Add garlic, ¾ of the green onions (save the rest for garnishing), and red pepper to skillet. Stir and cook until fragrant, 15-30 seconds.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 18178,
      "primary_message": "Stir in rice and fish sauce. Cook until heated through and well combined, 1-2 minutes.",
      "secondary_message": "2 tbsp fish sauce"
    },
    {
      "id": 18179,
      "primary_message": "Stir in shrimp and any juices, pineapple, cashews, and soy sauce.",
      "secondary_message": "½ cup cashews, roasted unsalted\n4 tbsp soy sauce"
    },
    {
      "id": 18180,
      "primary_message": "To serve, place rice on a plate or in a bowl and garnish with remaining green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
