  "instructions": [
    {
      "id": 435387,
      "primary_message": "Place coconut milk, almond milk, sugar, and cornstarch in a medium saucepan, then whisk until smooth. Set over medium heat and cook, whisking constantly, until thickened, 5-6 minutes.",
      "secondary_message": "1 ½ (13.5 fl oz) cans coconut milk\n12 fl oz (1 ½ cups) almond milk, unsweetened\n1 cup granulated sugar\n¼ cup cornstarch"
    },
    {
      "id": 435388,
      "primary_message": "Remove thickened coconut mixture from heat. Wash, dry, zest, and juice limes into the pan, then whisk to combine.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 435389,
      "primary_message": "Divide pudding between small bowls, cups, or jars and place in the refrigerator to chill until set, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 435390,
      "primary_message": "Meanwhile, place coconut in a skillet. Set over medium heat and toast, stirring frequently, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool.",
      "secondary_message": "⅓ cup shredded sweetened coconut"
    },
    {
      "id": 435391,
      "primary_message": "Wash, dry, peel, and slice mango flesh away from the pits, starting with the flat sides; small dice the flesh. Place in a bowl or container, cover, and store in the refrigerator until ready to serve.",
      "secondary_message": "3 mangoes"
    },
    {
      "id": 435392,
      "primary_message": "To serve, top pudding with mango and toasted coconut. Enjoy!",
      "secondary_message": null
    }
  ],
