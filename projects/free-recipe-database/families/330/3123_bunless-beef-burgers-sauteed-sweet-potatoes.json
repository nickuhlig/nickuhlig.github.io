  "instructions": [
    {
      "id": 31400,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lb sweet potatoes\n2 tomatoes\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 31401,
      "primary_message": "Preheat a grill pan or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 31402,
      "primary_message": "In a large bowl, combine the ground beef, Worcestershire, Dijon, garlic powder, salt, and black pepper; mix well.",
      "secondary_message": "1 ½ lb lean ground beef\n2 tsp Worcestershire sauce\n2 tsp Dijon mustard\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 31403,
      "primary_message": "Form the beef mixture into 8 patties.",
      "secondary_message": null
    },
    {
      "id": 31404,
      "primary_message": "Once the pan / skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 31405,
      "primary_message": "Add the beef patties to the pan / skillet; cook until they are cooked through, 3 to 5 minutes per side. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 31406,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 31407,
      "primary_message": "Peel and small dice the potatoes.",
      "secondary_message": ""
    },
    {
      "id": 31408,
      "primary_message": "Once the sauté pan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 31409,
      "primary_message": "Add the diced potatoes to the pan and season with salt and pepper. Cook, stirring occasionally, until tender and lightly browned, 6 to 8 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 31410,
      "primary_message": "Slice the tomatoes into rounds.",
      "secondary_message": ""
    },
    {
      "id": 31411,
      "primary_message": "To serve, arrange a bed of spinach on a plate and top with tomato slices, burger patties, and some mayo. Add the sweet potatoes on the side. Enjoy!",
      "secondary_message": "2 tbsp mayonnaise"
    }
  ],
