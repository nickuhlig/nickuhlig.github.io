  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely dice the ripe plum tomatoes. Finely chop the flat-leaf parsley leaves. Pick the mint leaves from the stems and finely chop them. Juice the lemon.",
      "secondary_message": "5 ripe plum tomatoes\n2 cups flat-leaf parsley leaves\n1 cup fresh mint\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Season tomatoes with 1 teaspoon salt and toss to combine. Transfer to a fine-mesh strainer or colander set in a bowl and allow to drain for 20 minutes. Reserve liquid.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Season parsley with remaining 1 teaspoon salt and toss to combine. Transfer to a large mixing bowl lined with paper towels and let stand for 20 minutes. Blot parsley with towels to remove excess moisture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bring 1/2 cup reserved tomato water to a boil, then pour over bulgur in a small heatproof bowl and let stand until bulgur is softened, about 1 hour (bulgur may still have a slight bite, but will continue to soften in the salad). Drain bulgur of any excess liquid and pat dry with paper towels.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a large mixing bowl, stir together tomatoes, parsley, mint, bulgur, scallions, olive oil, lemon juice, ground coriander seeds, and cinnamon until well combined. Season with salt and pepper. Serve tabbouleh with romaine leaves.",
      "secondary_message": null
    }
  ],
