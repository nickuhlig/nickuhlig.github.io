  "instructions": [
    {
      "id": 421244,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 small bunches asparagus\n1 ½ (454 g) pkgs strawberries\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 421245,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 421246,
      "primary_message": "While the skillet heats up, snap (or cut) off woody ends of the asparagus; cut spears into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 421247,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, peas, salt, and pepper; cook, stirring occasionally, until asparagus softens, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 cups frozen peas\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 421248,
      "primary_message": "Meanwhile, place eggs in a large bowl; whisk to combine and set aside.",
      "secondary_message": "18 eggs"
    },
    {
      "id": 421249,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 421250,
      "primary_message": "When the asparagus is soft, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 421251,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 4-5 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 421252,
      "primary_message": "Meanwhile, trim and thinly slice strawberries.",
      "secondary_message": null
    },
    {
      "id": 421253,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Add mixed greens to the plate, top with strawberries and almonds, then drizzle with vinaigrette. Enjoy!",
      "secondary_message": "⅓ cup almonds, sliced\n½ cup balsamic vinaigrette"
    }
  ],
