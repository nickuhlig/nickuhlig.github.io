  "instructions": [
    {
      "id": 11353,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 11354,
      "primary_message": "Wash potatoes and carrots. Large dice the potatoes. Halve carrots lengthwise, then cut crosswise into thirds. Transfer to a sheet pan.",
      "secondary_message": "1 ½ lb sweet potatoes\n6 medium carrots"
    },
    {
      "id": 11355,
      "primary_message": "Drizzle with oil and season with salt and pepper; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 11356,
      "primary_message": "Place in the oven and roast while you prepare the chicken, 5-10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11357,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 11358,
      "primary_message": "Season chicken with paprika, salt, and pepper.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\r\n¼ tsp paprika\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 11359,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until browned, 1-2 minutes per side.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 11360,
      "primary_message": "Remove sheet from oven and place chicken in the middle. Return to oven and roast until chicken is cooked through and vegetables are tender, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11361,
      "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
      "secondary_message": "½ small pkg fresh thyme"
    },
    {
      "id": 11362,
      "primary_message": "Remove sheet from oven and sprinkle with thyme; toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 11363,
      "primary_message": "To serve, place chicken and vegetables on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
