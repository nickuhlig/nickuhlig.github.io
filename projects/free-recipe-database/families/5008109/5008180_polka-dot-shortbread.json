  "ingredients": [
    {
      "ingredient_id": 115,
      "name": "unsalted butter, at room temperature",
      "quantity": "16 tbsp"
    },
    {
      "ingredient_id": 346,
      "name": "sugar",
      "quantity": "2 tbsp"
    },
