  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Grease a 23-cm springform pan with butter; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk flour, baking powder, and cinnamon to combine; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, whisk butter, sugar, and salt to combine. Add eggs, one at a time, followed by the yogurt and applesauce, whisking until smooth. Add flour and whisk until just combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Using a flexible spatula, scrape batter into prepared pan and smooth top. Working clockwise, fan apples out on top of batter in a single, even layer until batter is completely covered. Using a pastry brush, brush softened butter on top of apples. In a small bowl, whisk sugar and cinnamon to combine and sprinkle over apples.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake until edges are golden, apples have softened, and cake is just set, 40 to 45 minutes. Transfer cake to a wire rack. Let cool in pan for 20 minutes, then remove sides and let cool completely, about 45 minutes.",
      "secondary_message": null
    }
  ],
