  "instructions": [
    {
      "primary_message": "Wash and dry mandarins. Cut each mandarin (with skins on) into thin wedges and remove seeds (if present). Place in the bowl of a food processor. ",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry cranberries. Add to the food processor with the mandarin.  ",
      "secondary_message": "1 (340 g) pkg fresh cranberries"
    },
    {
      "primary_message": "Process the fruit until roughly chopped and combined, scraping down the sides of the bowl as needed. Transfer the relish to a medium bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add sugar to the bowl with the relish and stir to combine. Cover with plastic wrap and place in the fridge to allow flavors to blend, about 30 minutes. ",
      "secondary_message": "½ cup brown sugar"
    },
    {
      "primary_message": "Transfer to a serving dish and enjoy! ",
      "secondary_message": null
    }
