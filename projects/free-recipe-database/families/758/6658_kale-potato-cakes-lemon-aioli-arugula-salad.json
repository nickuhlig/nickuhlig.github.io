  "instructions": [
    {
      "id": 164494,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 medium yellow potatoes\n1 bunch kale\n1 small bunch green onions (scallions)\n2 (142 g) pkg baby arugula\n2 lemons\n1 small pkg grape tomatoes"
    },
    {
      "id": 164495,
      "primary_message": "Peel and chop the potatoes into 1-inch cubes; peel and smash the garlic (press firmly with the flat side of a knife or bottom of a pot).",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 164496,
      "primary_message": "Place the potatoes and garlic in a medium saucepan, season with salt, and cover with water. Cover with a lid and place on the stove at high heat; bring the water to a boil.",
      "secondary_message": "2 tsp salt"
    },
    {
      "id": 164497,
      "primary_message": "Fold leaves of kale in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 164498,
      "primary_message": "When the potato water comes to a boil, uncover, turn down to medium, and cook until potatoes are almost done, 8 minutes. Add kale to the pot and cook 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 164499,
      "primary_message": "Meanwhile, grate the zest from the lemons and transfer to a small bowl, then juice the lemons into a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 164500,
      "primary_message": "Grate cheese and set aside.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 164501,
      "primary_message": "Add oil, maple syrup, Dijon, salt, and pepper to the salad bowl with the lemon juice; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n4 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 164502,
      "primary_message": "Halve the grape tomatoes and add them to the bowl with the dressing. Chop green onions into ¼-inch pieces, set aside.",
      "secondary_message": null
    },
    {
      "id": 164503,
      "primary_message": "Once potatoes and kale are done, drain and return to the pot. Cook, shaking the pan occasionally, over medium-low heat until dry, about 2 minutes; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 164504,
      "primary_message": "Using a potato masher or fork, mash potato and kale until almost smooth, with a few small chunks remaining. Add bread crumbs, cheese, egg, green onions, Dijon, salt, and pepper; stir to combine.",
      "secondary_message": "½ cup panko bread crumbs\n2 eggs\n4 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 164505,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 164506,
      "primary_message": "Meanwhile, add mayonaise, garlic powder, and paprika to the small bowl with the lemon zest and mix to make the aioli.",
      "secondary_message": "½ cup mayonnaise\n1 tsp garlic powder\n½ tsp paprika"
    },
    {
      "id": 164507,
      "primary_message": "Once the skillet is hot add oil. Using a ⅓ measuring cup for each cake, drop potato mixture into the pan, pressing to make ½-inch thick rounds. Cook 3 minutes on each side, until crisp and golden; set aside. Cook in batches if necessary.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 164508,
      "primary_message": "Toss arugula with salad dressing and tomatoes.",
      "secondary_message": null
    },
    {
      "id": 164509,
      "primary_message": "To serve, divide potato cakes and salad between plates. Serve with aioli and enjoy!",
      "secondary_message": null
    }
  ],
