  "instructions": [
    {
      "id": 451500,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 fennel bulbs\n1 small bunch Italian (flat-leaf) parsley\n1 ½ medium heads napa cabbage"
    },
    {
      "id": 451501,
      "primary_message": "Trim off root end and dark green stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into ½-inch thick wedges. Place in a large bowl, drizzle with oil, then season with salt and pepper; gently toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 451502,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 451503,
      "primary_message": "Once the pan is hot, working in batches if necessary, add fennel and grill, flipping once, until charred and fork-tender, 5-6 minutes. Remove to a large plate and loosely cover with aluminum foil. (Reserve bowl for the next step and grill pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 451504,
      "primary_message": "Meanwhile, roughly chop apricots and place in the reserved bowl. Add hot water (from the tap) and set aside to soften.",
      "secondary_message": "30 dried apricots\n⅓ cup water"
    },
    {
      "id": 451505,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 451506,
      "primary_message": "Return the pan to medium-high heat and coat with oil. Working in batches if necessary, add chicken and grill, flipping once, until cooked through and golden, 8-10 minutes. Remove to the plate with the fennel.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 451507,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Add to the bowl with the apricots along with additional oil, vinegar, Dijon, salt, and pepper; stir to combine the dressing.",
      "secondary_message": "3 cloves garlic\n⅓ cup extra virgin olive oil\n¼ cup white wine vinegar\n3 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 451508,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 451509,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl, along with the almonds, and toss to combine the salad. ",
      "secondary_message": "¾ cup almonds"
    },
    {
      "id": 451510,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 451511,
      "primary_message": "To serve, divide cabbage salad, chicken, and fennel between plates. Enjoy!",
      "secondary_message": null
    }
  ],
