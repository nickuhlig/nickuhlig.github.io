  "instructions": [
    {
      "id": 451548,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 fennel bulb\n½ small bunch Italian (flat-leaf) parsley\n½ medium head napa cabbage"
    },
    {
      "id": 451549,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 451550,
      "primary_message": "While the pan heats up, trim off root end and dark green stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into ½-inch thick wedges. Place in a medium bowl, drizzle with oil, then season with salt and pepper; gently toss to coat.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 451551,
      "primary_message": "Once the pan is hot, add fennel and grill, flipping once, until charred and fork-tender, 5-6 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve bowl for the next step and grill pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 451552,
      "primary_message": "Meanwhile, roughly chop apricots and place in the reserved bowl. Add hot water (from the tap) and set aside to soften.",
      "secondary_message": "10 dried apricots\n2 tbsp water"
    },
    {
      "id": 451553,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 451554,
      "primary_message": "Return the pan to medium-high heat and coat with oil. Add chicken and grill, flipping once, until cooked through and golden, 8-10 minutes. Remove to the plate with the fennel.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 451555,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Add to the bowl with the apricots along with additional oil, vinegar, Dijon, salt, and pepper; stir to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n1 ½ tbsp white wine vinegar\n1 tbsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 451556,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 451557,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl, along with the almonds, and toss to combine the salad. ",
      "secondary_message": "¼ cup almonds"
    },
    {
      "id": 451558,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 451559,
      "primary_message": "To serve, divide cabbage salad, chicken, and fennel between plates. Enjoy!",
      "secondary_message": null
    }
  ],
