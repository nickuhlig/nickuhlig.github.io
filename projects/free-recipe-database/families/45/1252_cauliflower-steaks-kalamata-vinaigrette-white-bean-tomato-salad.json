  "instructions": [
    {
      "id": 10385,
      "primary_message": "Preheat oven to 500°F. Using a paper towel, lightly coat a sheet pan with oil.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 10386,
      "primary_message": "Wash cauliflower, cut off leaves, and trim stem. Slice lengthwise into ¾ inch steaks.",
      "secondary_message": "2 medium head cauliflower"
    },
    {
      "id": 10387,
      "primary_message": "Place steaks and loose florets on sheet. Rub with oil on each side and season with salt and pepper.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 10388,
      "primary_message": "Place in the oven and roast for 15 minutes. Flip and continue roasting until tender and browned, another 5-6 minutes. Then broil for 2-3 minutes to create a golden crust.",
      "secondary_message": ""
    },
    {
      "id": 10389,
      "primary_message": "Peel and mince garlic. Finely chop olives.",
      "secondary_message": "4 cloves garlic\r\n1 cup Kalamata olives, pitted"
    },
    {
      "id": 10390,
      "primary_message": "In a medium bowl, mix together garlic, olives, lemon juice, oil, and salt. Set aside.",
      "secondary_message": "1 lemon\r\n2 tbsp extra virgin olive oil\r\n⅛ tsp salt"
    },
    {
      "id": 10391,
      "primary_message": "In a large bowl, prepare salad dressing by whisking together oil, lemon juice, salt, and pepper.",
      "secondary_message": "6 tbsp extra virgin olive oil\r\n1 lemon\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 10392,
      "primary_message": "Drain and rinse beans; place on paper towels and pat dry. Add to bowl with dressing.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 10393,
      "primary_message": "Wash, quarter, and add tomatoes to bowl. Toss salad.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 10394,
      "primary_message": "To serve, place cauliflower steaks on a plate, drizzle with vinaigrette, and have with salad on side. Enjoy!",
      "secondary_message": ""
    }
  ],
