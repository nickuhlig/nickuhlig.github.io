  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat 2 tablespoons of oil in a wok over medium heat until shimmering. Add the garlic, scallions and let brown, stirring occasionally, 3 to 5 minutes. Add the chile pepper flakes if using and stir until aromatic, about 30 seconds. Transfer oil and aromatics to a large metal bowl. Wipe wok clean with paper towel.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add remaining oil to wok and heat to 375°F over medium heat. Meanwhile, combine egg and cornstarch in a medium bowl. Add shrimp and toss to coat. When the oil is ready, add half of the shrimp, dropping them into the oil one at a time. Cook, agitating and flipping shrimp frequently until crisp and just cooked through, 2 to 3 minutes total. Transfer shrimp to a paper towel-lined plate and repeat with remaining batch.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add drained fried shrimp to bowl with browned aromatics. Season to taste with salt, pepper, and optional additional seasonings. Serve immediately.",
      "secondary_message": null
    }
  ],
