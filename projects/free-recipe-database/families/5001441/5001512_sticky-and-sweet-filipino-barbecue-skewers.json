  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the onion. Juice the lemon. Mince the garlic cloves. Cut the boneless pork shoulder into 1-inch cubes.",
      "secondary_message": "1 medium onion\n1 lemon\n6 medium cloves garlic cloves\n1.81 kg boneless pork shoulder"
    },
    {
      "id": 1,
      "primary_message": "For the Marinade: In a medium saucepan, place all marinade ingredients and whisk to combine. Cook over low heat stirring occasionally, until just warm and sugar is dissolved, about 5 minutes. Remove from heat and let cool to room temperature, 1 to 1 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a 1-gallon zipper-lock bag, place chicken or pork cubes and pour marinade all over. Seal the bag, removing as much air as possible, and move meat until evenly coated. Refrigerate for 12 to 18 hours, turning bag and redistributing meat in marinade at least twice.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For a Charcoal Grill: Open bottom vent completely. Light large chimney starter filled with charcoal briquettes (6 quarts). When top coals are partially covered with ash, pour evenly over half of grill. Set cooking grate in place, cover, and open lid vent completely. Heat grill until hot, about 5 minutes.\nFor a Charcoal Grill: Open bottom vent completely. Light large chimney starter filled with charcoal briquettes (6 quarts). When top coals are partially covered with ash, pour evenly over half of grill. Set cooking grate in place, cover, and open lid vent completely. Heat grill until hot, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "While grill is heating, thread meat onto skewers. Each piece of meat should touch the next, but do not push tightly together.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Working in batches if needed, grill, (covered for a gas grill) turning occasionally, until each side is nicely browned and the meat is cooked through, 6 to 10 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
