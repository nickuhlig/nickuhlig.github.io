  "instructions": [
    {
      "id": 192331,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with vinegar, oil, maple syrup, Dijon, and spices. Whisk to combine the marinade.",
      "secondary_message": "1 clove garlic\n1 tbsp balsamic vinegar\n½ tsp extra virgin olive oil\n½ tsp pure maple syrup\n½ tsp Dijon mustard\n¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 192332,
      "primary_message": "Pat the steak dry with paper towels, then slice against the grain into ¼-inch thick strips. Add to the bowl with the marinade, turn to coat, and set aside. ",
      "secondary_message": "⅓ kg striploin (New York strip) steak"
    },
    {
      "id": 192333,
      "primary_message": "Meanwhile, preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 192334,
      "primary_message": "Peel and thinly slice onion into rings.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 192335,
      "primary_message": "Once the grill pan is hot, coat with oil. Transfer onions to the grill pan and cook until tender, 3-4 minutes per side.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 192336,
      "primary_message": "Meanwhile, wash and dry the mixed greens. (Skip if they came pre-washed.)",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 192337,
      "primary_message": "Wash and dry tomato. Using a clean cutting board, halve tomato and thinly slice into half-moons. Transfer to a plate and season with salt and pepper; set aside.",
      "secondary_message": "1 tomato\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 192338,
      "primary_message": "When the onions are done cooking, transfer to the plate with the tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 192339,
      "primary_message": "Place steak strips on the grill pan, and cook to desired doneness, about 1 minute per side for medium-rare. Transfer to the plate with the veggies.",
      "secondary_message": null
    },
    {
      "id": 192340,
      "primary_message": "Place tortillas on a flat surface. Divide steak, onions, mixed greens, tomatoes, and blue cheese between them. Roll tightly to close and cut in half.",
      "secondary_message": "2 large flour tortillas\n½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 192341,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
