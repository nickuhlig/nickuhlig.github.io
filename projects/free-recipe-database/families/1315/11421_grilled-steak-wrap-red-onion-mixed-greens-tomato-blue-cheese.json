  "instructions": [
    {
      "id": 192284,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with vinegar, oil, maple syrup, Dijon, and spices. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n3 tbsp balsamic vinegar\n1 ½ tsp extra virgin olive oil\n1 ½ tsp pure maple syrup\n1 ½ tsp Dijon mustard\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 192285,
      "primary_message": "Pat the steak dry with paper towels, then slice against the grain into ¼-inch thick strips. Add to the bowl with the marinade, turn to coat, and set aside. ",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 192286,
      "primary_message": "Meanwhile, preheat a grill pan or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 192287,
      "primary_message": "Peel and thinly slice onions into rings.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 192288,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, transfer onions to the grill pan and cook until tender, 3-4 minutes per side.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 192289,
      "primary_message": "Meanwhile, wash and dry the mixed greens. (Skip if they came pre-washed.)",
      "secondary_message": "1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 192290,
      "primary_message": "Wash and dry tomatoes. Using a clean cutting board, halve tomatoes and thinly slice into half-moons. Transfer to a platter and season with salt and pepper; set aside.",
      "secondary_message": "3 tomatoes\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 192291,
      "primary_message": "When the onions are done cooking, transfer to the platter with the tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 192292,
      "primary_message": "Working in batches if necessary, place steak strips on the grill pan, and cook to desired doneness, about 1 minute per side for medium-rare. Transfer to the platter with the veggies.",
      "secondary_message": null
    },
    {
      "id": 192293,
      "primary_message": "Place tortillas on a flat surface. Divide steak, onions, mixed greens, tomatoes, and blue cheese between them. Roll tightly to close and cut in half.",
      "secondary_message": "6 large flour tortillas\n1 ½ (4 oz) pkgs crumbled blue cheese"
    },
    {
      "id": 192294,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
