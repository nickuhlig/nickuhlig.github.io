  "instructions": [
    {
      "id": 192376,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "4 caps portobello mushrooms\n2 tomatoes\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 192377,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with vinegar, oil, maple syrup, Dijon, and spices. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n2 tbsp balsamic vinegar\n2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n1 tsp Dijon mustard\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 192378,
      "primary_message": "Remove mushroom stems and discard. Cut mushrooms into ½-inch thick slices; add to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 192379,
      "primary_message": "Meanwhile, preheat a grill pan or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 192380,
      "primary_message": "Peel and thinly slice onion into rings.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 192381,
      "primary_message": "Once the grill pan is hot, coat with oil. Transfer onions to the grill pan and cook until tender, 3-4 minutes per side.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 192382,
      "primary_message": "Meanwhile, halve tomatoes and thinly slice into half-moons. Transfer to a plate and season with salt and pepper; set aside.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 192383,
      "primary_message": "Roughly chop almonds and set aside.",
      "secondary_message": "1 cup almonds"
    },
    {
      "id": 192384,
      "primary_message": "When the onions are done cooking, transfer to the plate with the tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 192385,
      "primary_message": "Working in batches if necessary, place mushrooms on the grill pan and cook until tender, 2-3 minutes per side. Transfer to the plate with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 192386,
      "primary_message": "Place tortillas on a flat surface and spread with a thin layer of mayo. Divide mushrooms, onions, tomatoes, almonds, mixed greens, and blue cheese between them. Roll tightly to close and cut in half.",
      "secondary_message": "4 large flour tortillas\n2 tbsp mayonnaise\n1 (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 192387,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
