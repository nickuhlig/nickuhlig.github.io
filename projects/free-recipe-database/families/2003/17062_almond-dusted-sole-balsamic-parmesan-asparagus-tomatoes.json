  "instructions": [
    {
      "id": 326610,
      "primary_message": "Preheat oven to 230°C (450°F). Line two baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 326611,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n1 ½ small pkgs grape tomatoes\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 326612,
      "primary_message": "Snap or cut off woody ends of the asparagus and divide between the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 326613,
      "primary_message": "Add tomatoes to the baking sheets with the asparagus and spread veggies out in an even layer. ",
      "secondary_message": null
    },
    {
      "id": 326614,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies; drizzle with vinegar, then season with salt and pepper. ",
      "secondary_message": "3 tbsp butter, unsalted\n2 tbsp balsamic vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 326615,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 326616,
      "primary_message": "While the veggies are roasting, zest lemons into a medium bowl. (Reserve lemons for serving.)",
      "secondary_message": null
    },
    {
      "id": 326617,
      "primary_message": "Add almond meal, salt, and pepper to the bowl with the lemon zest; stir to combine.",
      "secondary_message": "1 ½ cup almond meal/flour\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 326618,
      "primary_message": "Working one by one, dredge fish fillets in the almond meal mixture, pressing lightly to adhere to both sides. Transfer fish to a large plate. ",
      "secondary_message": "1.02 kg sole fillets"
    },
    {
      "id": 326619,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 326620,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add the fish and pan-fry until golden brown and cooked through, 2-3 minutes per side. Remove to a clean plate.",
      "secondary_message": "½ cup butter, unsalted"
    },
    {
      "id": 326621,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 326622,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 326623,
      "primary_message": "When the veggies are done, remove from the oven and sprinkle with Parmesan and half of the parsley; toss to combine. (Reserve the rest of the parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 326624,
      "primary_message": "To serve, divide fish and veggies between plates. Juice reserved lemons over fish and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
