  "instructions": [
    {
      "id": 428629,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 428630,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ English cucumber\n½ yellow bell pepper\n1 pint grape tomatoes\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 428631,
      "primary_message": "Zest and juice lemon into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 428632,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon along with oil and spices. Whisk to combine the dressing. ",
      "secondary_message": "2 cloves garlic\n1 ½ tbsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 428633,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428634,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place chicken in another medium bowl along with ⅓ of the dressing; turn to coat. (Reserve bowl with remaining dressing for the salad.)",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 428635,
      "primary_message": "Once the skillet is hot, add the chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat and set aside. ",
      "secondary_message": null
    },
    {
      "id": 428636,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Add to the bowl with the remaining dressing. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 428637,
      "primary_message": "Trim and large dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428638,
      "primary_message": "Trim, seed, and large dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428639,
      "primary_message": "Halve tomatoes crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428640,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428641,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl, along with the feta, and stir to combine the pasta salad. ",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 428642,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 428643,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with sliced chicken. Enjoy!",
      "secondary_message": null
    }
  ],
