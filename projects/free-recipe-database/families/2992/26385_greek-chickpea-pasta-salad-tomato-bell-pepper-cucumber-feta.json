  "instructions": [
    {
      "id": 428698,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 428699,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n1 ½ yellow bell peppers\n3 pints grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 428700,
      "primary_message": "Zest and juice lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 428701,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon along with oil and spices. Whisk to combine the dressing. ",
      "secondary_message": "6 cloves garlic\n¼ cup extra virgin olive oil\n1 tbsp oregano, dried\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 428702,
      "primary_message": "Drain and rinse chickpeas in a colander. Place chickpeas in a medium bowl along with ⅓ of the dressing; stir to combine and set aside to marinate. (Reserve bowl with remaining dressing for the salad.)",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 428703,
      "primary_message": "Meanwhile, peel, halve, and mince onion. Add to the bowl with the remaining dressing. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 428704,
      "primary_message": "Trim and large dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428705,
      "primary_message": "Trim, seed, and large dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428706,
      "primary_message": "Halve tomatoes crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428707,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428708,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl, along with the feta, and stir to combine the pasta salad. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 428709,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with marinated chickpeas. Enjoy!",
      "secondary_message": null
    }
  ],
