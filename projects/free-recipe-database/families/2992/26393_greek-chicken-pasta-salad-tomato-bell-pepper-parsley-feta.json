  "instructions": [
    {
      "id": 428806,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g rotini pasta"
    },
    {
      "id": 428807,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 English cucumber\n1 yellow bell pepper\n2 small pkgs grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 428808,
      "primary_message": "Zest and juice lemon into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 428809,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon along with oil and spices. Whisk to combine the dressing. ",
      "secondary_message": "4 cloves garlic\n3 tbsp extra virgin olive oil\n2 tsp oregano, dried\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 428810,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428811,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place chicken in a medium bowl along with ⅓ of the dressing; turn to coat. (Reserve bowl with remaining dressing for the salad.)",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 428812,
      "primary_message": "Once the skillet is hot, add the chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat and set aside. ",
      "secondary_message": null
    },
    {
      "id": 428813,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallots. Add to the bowl with the remaining dressing. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 428814,
      "primary_message": "Trim and large dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428815,
      "primary_message": "Trim, seed, and large dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428816,
      "primary_message": "Halve tomatoes crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428817,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 428818,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl, along with the feta, and stir to combine the pasta salad. ",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 428819,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 428820,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with sliced chicken. Enjoy!",
      "secondary_message": null
    }
  ],
