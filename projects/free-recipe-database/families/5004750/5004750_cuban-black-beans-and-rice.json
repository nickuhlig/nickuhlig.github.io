  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the yellow onions. Chop the green bell peppers. Finely mince the garlic. Dice the white onions.",
      "secondary_message": "3 ½ cups yellow onions\n1 ½ cups green bell peppers\n2 tbsp garlic\n2 large white onions"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, cover the beans with at least 3 inches cold water. Cover and let stand overnight.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Drain the beans, reserving the water in which they soaked. Measure the water and add enough additional water to total 8 cups.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a Dutch oven, combine beans, 8 cups water, and ham hocks and bring to a boil over high heat. Reduce heat to low and cook, uncovered, stirring occasionally and skimming the surface as necessary to remove any foam, until beans are very tender, about 4 hours. Top up with boiling water as needed to keep the beans from going dry.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Meanwhile, in a large skillet, heat oil over medium heat until shimmering. Add chopped yellow onions and green peppers. Cook, stirring, until the mixture is wilted, about 5 minutes. Add the garlic and cook, stirring often, until fragrant, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "After the beans have cooked about 2 hours, add the onion mixture to the beans. Add the bay leaves, pepper flakes, and vinegar. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "When the beans are almost tender, add rum and cook, stirring and scraping bottom often, 30 minutes longer. The beans should have thickened nicely, being neither dry nor soupy.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Remove the ham hocks. When they are cool enough to handle, remove and discard the skin, fat, bones and gristle. Shred the meat and return it to the beans. Remove the bay leaves. Add the cayenne pepper and Tabasco. Serve with white rice and top with diced white onions, if desired.",
      "secondary_message": null
    }
  ],
