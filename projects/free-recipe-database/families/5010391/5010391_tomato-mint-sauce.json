  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the shallots. Pick the mint leaves from the stems and finely chop them. Pick the basil leaves from the stems and finely chop them. Juice the lemon.",
      "secondary_message": "¼ cup shallots\n⅓ cup fresh mint leaves\n¼ cup fresh basil leaves\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a medium saucepan over medium heat until shimmering. Add shallots and cook until softened, about 5 minutes. Stir in garlic and crushed red pepper and cook until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in tomatoes and bring to a boil. Reduce to low and simmer until sauce has slightly thickened, 15 to 20 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in mint, basil, and lemon juice. Season with salt and pepper to taste. Use immediately or transfer to an airtight container and store in refrigerator for up to a week.",
      "secondary_message": null
    }
  ],
