  "instructions": [
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until starting to soften, about 5 minutes.",
      "secondary_message": "salt"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n1 small bunch asparagus\n1 small bunch fresh dill"
    },
    {
      "primary_message": "Peel, trim, and halve carrots lengthwise, then cut crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Add to the bowl with the carrot, along with the peas.",
      "secondary_message": "2 cups frozen peas"
    },
    {
      "primary_message": "When the pasta is starting to soften, add veggies to the pot and stir for a few seconds. Continue to cook until pasta and veggies are fork-tender, 4-5 minutes more. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Crumble goat cheese into the bowl with the dill.",
      "secondary_message": "2 (4 oz) logs goat cheese"
    },
    {
      "primary_message": "When the pasta and veggies are done, drain in a colander and return to the pot. Add dill, goat cheese, oil, salt, and pepper, then set over medium heat. Cook, stirring constantly, until cheese is melted and sauce coats the pasta, about 30 seconds. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\nsalt\n½ tsp black pepper"
    },
    {
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
