  "instructions": [
    {
      "id": 505551,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until starting to soften, about 5 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g penne pasta"
    },
    {
      "id": 505552,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n1 ½ small bunches asparagus\n1 small bunch fresh dill"
    },
    {
      "id": 505553,
      "primary_message": "Peel, trim, and halve carrots lengthwise, then cut crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 505554,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Add to the bowl with the carrot, along with the peas.",
      "secondary_message": "3 cups frozen peas"
    },
    {
      "id": 505555,
      "primary_message": "When the pasta is starting to soften, add veggies to the pot and stir for a few seconds. Continue to cook until pasta and veggies are fork-tender, 5-7 minutes more. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 505556,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 505557,
      "primary_message": "Crumble goat cheese into the bowl with the dill.",
      "secondary_message": "3 (113 g) logs goat cheese"
    },
    {
      "id": 505558,
      "primary_message": "When the pasta and veggies are done, drain in a colander and return to the pot. Add dill, goat cheese, oil, and spices then set over medium heat. Cook, stirring constantly, until cheese is melted and sauce coats the pasta, about 1 minute. Remove from heat.",
      "secondary_message": "¼ cup extra virgin olive oil\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 505559,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
