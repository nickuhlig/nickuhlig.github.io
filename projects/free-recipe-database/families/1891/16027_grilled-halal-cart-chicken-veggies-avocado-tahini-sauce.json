  "instructions": [
    {
      "id": 263110,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 lemons\n1 ½ pints grape tomatoes\n1 ½ avocados\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 263111,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 263112,
      "primary_message": "Zest and juice half the lemons into the bowl with the garlic (reserve remaining lemons for later); add oil and spices. Whisk to combine the marinade.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 263113,
      "primary_message": "Add chicken to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 263114,
      "primary_message": "Juice remaining lemons into a small bowl; add yogurt, tahini, water, salt, and pepper. Whisk to combine the tahini sauce and set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp tahini\n3 tbsp water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 263115,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263116,
      "primary_message": "Once the pan is hot, working in batches if necessary, add chicken and grill, flipping occasionally, until golden and cooked through, 10-12 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 263117,
      "primary_message": "Meanwhile, halve tomatoes.",
      "secondary_message": null
    },
    {
      "id": 263118,
      "primary_message": "Halve and pit the avocados; slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 263119,
      "primary_message": "To serve, divide chicken, spinach, tomatoes, and avocado between plates; drizzle with tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
