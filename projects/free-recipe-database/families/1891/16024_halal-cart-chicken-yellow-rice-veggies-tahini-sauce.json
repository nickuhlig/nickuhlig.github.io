  "instructions": [
    {
      "id": 263077,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 lemons\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 263078,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 263079,
      "primary_message": "Zest and juice half the lemons into the bowl with the garlic (reserve remaining lemons for later); add oil and spices. Whisk to combine the marinade.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 263080,
      "primary_message": "Add chicken to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 263081,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263082,
      "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water.",
      "secondary_message": "1 ½ cups basmati rice"
    },
    {
      "id": 263083,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add rice and spices; cook, stirring frequently, until fragrant, 2-3 minutes. Add water and bring to a boil.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp turmeric, ground\n¾ tsp salt\n½ tsp black pepper\n3 cup water"
    },
    {
      "id": 263084,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 263085,
      "primary_message": "While the rice is cooking, juice remaining lemons into a small bowl; add yogurt, tahini, water, salt, and pepper. Whisk to combine the tahini sauce and set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp tahini\n3 tbsp water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 263086,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263087,
      "primary_message": "Once the pan is hot, working in batches if necessary, add chicken and grill, flipping occasionally, until golden and cooked through, 10-12 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 263088,
      "primary_message": "Meanwhile, halve tomatoes.",
      "secondary_message": null
    },
    {
      "id": 263089,
      "primary_message": "To serve, divide rice, chicken, tomatoes, and spinach between plates; drizzle with tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
