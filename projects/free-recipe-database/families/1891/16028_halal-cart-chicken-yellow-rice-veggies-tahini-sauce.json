  "instructions": [
    {
      "id": 263120,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n½ small pkg grape tomatoes\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 263121,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 263122,
      "primary_message": "Zest and juice half the lemon into the bowl with the garlic (reserve remaining lemon for later); add oil and spices. Whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n½ tsp coriander, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 263123,
      "primary_message": "Add chicken to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 263124,
      "primary_message": "Preheat a small saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263125,
      "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "id": 263126,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add rice and spices; cook, stirring frequently, until fragrant, about 2 minutes. Add water and bring to a boil.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp turmeric, ground\n¼ tsp salt\n⅛ tsp black pepper\n1 cup water"
    },
    {
      "id": 263127,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 263128,
      "primary_message": "While the rice is cooking, juice remaining lemon into a small bowl; add yogurt, tahini, water, salt, and pepper. Whisk to combine the tahini sauce and set aside.",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tbsp tahini\n1 tbsp water\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 263129,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263130,
      "primary_message": "Once the pan is hot, add chicken and grill, flipping occasionally, until golden and cooked through, 10-12 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 263131,
      "primary_message": "Meanwhile, halve tomatoes.",
      "secondary_message": null
    },
    {
      "id": 263132,
      "primary_message": "To serve, divide rice, chicken, tomatoes, and spinach between plates; drizzle with tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
