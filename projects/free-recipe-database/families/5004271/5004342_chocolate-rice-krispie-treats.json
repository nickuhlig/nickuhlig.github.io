  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the unsweetened chocolate. Finely chop the bittersweet chocolate.",
      "secondary_message": "85 g unsweetened chocolate\n142 g bittersweet chocolate"
    },
    {
      "id": 1,
      "primary_message": "Lightly grease an 8 by 20-cm or 9 by 23-cm square panpan with butter. In large saucepan over medium heat, melt butter. Add salt, marshmallows, unsweetened chocolate, and cocoa, and melt, stirring frequently. Stir in vanilla.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Fold in puffed rice cereal until completely coated (see note). Fold in bittersweet chocolate (see note). Immediately spread into pan. Gently smooth top with spatula and sprinkle evenly with salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Let sit until set, about 30 minutes. Cut into squares and serve.",
      "secondary_message": null
    }
  ],
