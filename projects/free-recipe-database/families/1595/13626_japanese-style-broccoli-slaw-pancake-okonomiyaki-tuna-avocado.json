  "instructions": [
    {
      "id": 226932,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ limes\n1 small bunch green onions (scallions)\n2 avocados"
    },
    {
      "id": 226933,
      "primary_message": "Drain tuna and transfer to a large bowl; flake with a fork.",
      "secondary_message": "3 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 226934,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the tuna.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 226935,
      "primary_message": "Add eggs and broth to the bowl with the tuna; whisk to combine.",
      "secondary_message": "6 eggs\n12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 226936,
      "primary_message": "Place flour, baking powder, and salt in another large bowl; whisk to combine. Gradually add the egg mixture to the bowl with the flour, whisking to create a smooth batter.",
      "secondary_message": "1 ½ cup all-purpose flour\n1 tbsp baking powder\n1 ½ tsp salt"
    },
    {
      "id": 226937,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 226938,
      "primary_message": "While the skillet heats up, add broccoli slaw to the bowl with the batter and stir until thoroughly combined.",
      "secondary_message": "3 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 226939,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add one-sixth of the pancake batter (1¼-cups per pancake) to the skillet and smooth out into a large, ½-inch thick pancake. Cook, flipping once, until golden brown and cooked through, 3-4 minutes per side. Remove to a plate and cover with aluminum foil.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 226940,
      "primary_message": "Meanwhile, juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 226941,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the lime, along with mayo and chili-garlic sauce; whisk to combine the spicy mayo and set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup mayonnaise\n1 ½ tbsp chili-garlic sauce"
    },
    {
      "id": 226942,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 226943,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate with the green onions.",
      "secondary_message": null
    },
    {
      "id": 226944,
      "primary_message": "Once the first pancake is done cooking, add more oil (about 1 teaspoon per pancake) to the skillet and repeat with remaining batter.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 226945,
      "primary_message": "To serve, place a pancake on each plate. Top with green onions and avocado; drizzle with spicy mayo and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
