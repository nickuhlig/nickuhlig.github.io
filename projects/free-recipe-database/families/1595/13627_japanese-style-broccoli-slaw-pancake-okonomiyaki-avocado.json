  "instructions": [
    {
      "id": 226946,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n½ lime\n½ small bunch green onions (scallions)\n1 avocado"
    },
    {
      "id": 226947,
      "primary_message": "Peel and mince ginger and garlic. Transfer both to a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 226948,
      "primary_message": "Add eggs and broth to the bowl with the ginger and garlic; whisk to combine.",
      "secondary_message": "2 eggs\n4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 226949,
      "primary_message": "Place flour, baking powder, and salt in another medium bowl; whisk to combine. Gradually add the egg mixture to the bowl with the flour, whisking to create a smooth batter.",
      "secondary_message": "½ cup all-purpose flour\n1 tsp baking powder\n½ tsp salt"
    },
    {
      "id": 226950,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 226951,
      "primary_message": "While the skillet heats up, add broccoli slaw to the bowl with the batter and stir until thoroughly combined.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 226952,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add half the pancake batter (1¼-cups per pancake) to the skillet and smooth out into a large, ½-inch thick pancake. Cook, flipping once, until golden brown and cooked through, 3-4 minutes per side. Remove to a plate and cover with aluminum foil.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 226953,
      "primary_message": "Meanwhile, juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 226954,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the lime, along with mayo and chili-garlic sauce; whisk to combine the spicy mayo and set aside.",
      "secondary_message": "1 clove garlic\n2 tbsp mayonnaise\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 226955,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 226956,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate with the green onions.",
      "secondary_message": null
    },
    {
      "id": 226957,
      "primary_message": "Once the first pancake is done cooking, add more oil to the skillet and repeat with remaining batter.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 226958,
      "primary_message": "To serve, place a pancake on each plate. Top with green onions and avocado; drizzle with spicy mayo and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
