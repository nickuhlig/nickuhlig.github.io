  "instructions": [
    {
      "id": 26158,
      "primary_message": "Preheat the oven to 500°F and position rack in the centre. Line a baking sheet with parchment paper.",
      "secondary_message": ""
    },
    {
      "id": 26159,
      "primary_message": "Place the chicken wings on the baking sheet. Drizzle with olive oil and season with salt and pepper; toss to coat. Spread out in a single layer.",
      "secondary_message": "1 lb chicken wings, split with tips removed\n½ tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 26160,
      "primary_message": "Place in the oven and bake, flipping halfway through cooking time, until cooked through, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 26161,
      "primary_message": "In a small bowl, prepare the ranch dip by mixing together lemon juice, mayo, onion powder, garlic powder, dill, salt, and pepper. Place in the fridge to chill.",
      "secondary_message": "½ lemon\n⅓ cup mayonnaise\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp dill\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 26162,
      "primary_message": "Wash and dry the carrots, celery, and cucumber. Peel carrots, trim ends, and cut into sticks. Trim ends and cut celery into sticks. Cut cucumber into sticks.",
      "secondary_message": "3 medium carrots\r\n3 sticks celery\r\n½ English cucumber"
    },
    {
      "id": 26163,
      "primary_message": "Peel and mince or grate the ginger.",
      "secondary_message": "1 (1 inch) piece ginger root\r\n"
    },
    {
      "id": 26164,
      "primary_message": "In a small saucepan, prepare the teriyaki sauce by combining water, soy sauce, honey, ginger, and garlic powder. Bring to a boil and allow to boil until the mixture has reduced and thickened, 5-7 minutes. Remove from heat.",
      "secondary_message": "½ cup water\r\n6 tbsp soy sauce\r\n2 tbsp honey\r\n1 tsp garlic powder"
    },
    {
      "id": 26165,
      "primary_message": "Once the wings are cooked, transfer them to a bowl and pour the teriyaki sauce over top; toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 26166,
      "primary_message": "Serve wings with veggie sticks and ranch dip. Enjoy!",
      "secondary_message": ""
    }
  ],
