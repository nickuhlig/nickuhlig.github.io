  "instructions": [
    {
      "id": 629738,
      "primary_message": "Place turkey, egg, bread crumbs, and spices in a medium bowl; mix with your hands until well combined. Form the turkey mixture into 2 equal-sized patties and place on a plate.",
      "secondary_message": "⅓ kg ground turkey\n1 egg\n¼ cup panko bread crumbs\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 629739,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 629740,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, for 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 629741,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "⅓ (227 g) block mozzarella cheese"
    },
    {
      "id": 629742,
      "primary_message": "When the patties are done on one side, flip, then top with cheese. Continue to cook until burgers are cooked through, 5-7 minutes more. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 629743,
      "primary_message": "While the burgers are cooking, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small pkg grape tomatoes\n½ head romaine lettuce"
    },
    {
      "id": 629744,
      "primary_message": "Juice lemon into a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 629745,
      "primary_message": "Peel and mince garlic; mince anchovy fillet. Add both to the bowl with the lemon juice, along with mayo, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 anchovy fillet, packed in oil\n1 tbsp mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 629746,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 629747,
      "primary_message": "Remove 1 whole lettuce leaf, cut in half, and set aside for the burgers. Chop (or tear) remaining lettuce into bite-sized pieces. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 629748,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 629749,
      "primary_message": "Spread mayo over the bottom half of each bun; top with burger patties and reserved lettuce. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": "1 tbsp mayonnaise"
    }
  ],
