  "instructions": [
    {
      "id": 629678,
      "primary_message": "Place turkey, eggs, bread crumbs, and spices in a medium bowl; mix with your hands until well combined. Form the turkey mixture into 4 equal-sized patties and place on a plate.",
      "secondary_message": "1 ½ lb ground turkey\n2 eggs\n½ cup panko bread crumbs\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 629679,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 629680,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, for 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 629681,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "⅔ (8 oz) block mozzarella cheese"
    },
    {
      "id": 629682,
      "primary_message": "When the patties are done on one side, flip, then top with cheese. Continue to cook until burgers are cooked through, 5-7 minutes more. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 629683,
      "primary_message": "While the burgers are cooking, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 pint grape tomatoes\n1 head romaine lettuce"
    },
    {
      "id": 629684,
      "primary_message": "Juice lemon into a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 629685,
      "primary_message": "Peel and mince garlic; mince anchovy fillets. Add both to the bowl with the lemon juice, along with mayo, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 anchovy fillets, packed in oil\n2 tbsp mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 629686,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 629687,
      "primary_message": "Remove 2 whole lettuce leaves, cut in half, and set aside for the burgers. Chop (or tear) remaining lettuce into bite-sized pieces. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 629688,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 629689,
      "primary_message": "Spread mayo over the bottom half of each bun; top with burger patties and reserved lettuce. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": "2 tbsp mayonnaise"
    }
  ],
