  "instructions": [
    {
      "id": 629798,
      "primary_message": "Place veggie ground, eggs, bread crumbs, and spices in a large bowl; mix with your hands until well combined. Form the veggie ground mixture into 6 equal-sized patties and place on a plate.",
      "secondary_message": "680 g veggie ground, plant based\n3 eggs\n¾ cup panko bread crumbs\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 629799,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 629800,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 629801,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 629802,
      "primary_message": "When the patties are done on one side, flip, then top with cheese. Continue to cook until burgers are cooked through, 5-7 minutes more. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 629803,
      "primary_message": "While the burgers are cooking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ small pkgs grape tomatoes\n1 ½ heads romaine lettuce"
    },
    {
      "id": 629804,
      "primary_message": "Juice lemons into a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 629805,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice, along with mayo, soy sauce, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp mayonnaise\n1 tbsp soy sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 629806,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 629807,
      "primary_message": "Remove 3 whole lettuce leaves, cut in half, and set aside for the burgers. Chop (or tear) remaining lettuce into bite-sized pieces. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 629808,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 629809,
      "primary_message": "Spread mayo over the bottom half of each bun; top with burger patties and reserved lettuce. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": "3 tbsp mayonnaise"
    }
  ],
