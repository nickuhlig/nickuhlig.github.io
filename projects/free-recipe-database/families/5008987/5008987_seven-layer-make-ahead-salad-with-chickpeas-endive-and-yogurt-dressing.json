  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine onion, vinegar, and sugar in a small bowl and turn to coat. Set aside for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, toss cucumbers with a large pinch of salt. Transfer to a strainer, set it back over the bowl, and set aside to drain for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine yogurt, lemon juice, chopped dill, chopped mint leaves, and olive oil in a medium bowl. When the cucumbers are drained, pour drained liquid into the yogurt mixture and stir to combine. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To construct the salad, place the chickpeas on the bottom of a large serving bowl. Add endive, spreading it into an even layer, followed by cucumber. Add onion, discarding any excess vinegar that isn't sticking to their surface. Add celery and radishes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spoon the yogurt mixture on top of the salad, spreading it with the back of a spoon or a small offset spatula into an even layer. Sprinkle with crumbled cheese. Salad can be made up to a day ahead. Wrap with plastic and store in the refrigerator until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "To serve, sprinkle with pomegranate and sunflower seeds. Garnish with mint leaves, dill sprigs, and celery leaves. Serve.",
      "secondary_message": null
    }
  ],
