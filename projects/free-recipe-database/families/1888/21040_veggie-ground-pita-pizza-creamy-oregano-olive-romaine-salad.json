  "instructions": [
    {
      "id": 352233,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 352234,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ red bell pepper\n½ English cucumber\n½ head romaine lettuce\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 352235,
      "primary_message": "Place mayo, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp mayonnaise\n1 tbsp red wine vinegar\n½ tsp oregano, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 352236,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 352237,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352238,
      "primary_message": "Halve olives lengthwise and add to the bowl; set aside.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 352239,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 352240,
      "primary_message": "While the skillet heats up, peel and mince shallot and garlic. ",
      "secondary_message": "½ shallot\n1 clove garlic"
    },
    {
      "id": 352241,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shallot, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp Italian seasoning\n¼ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 352242,
      "primary_message": "Meanwhile, coarsely grate mozzarella and set aside.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 352243,
      "primary_message": "Add tomato sauce to the skillet with the veggie ground and stir to combine. Remove from heat.",
      "secondary_message": "1 (213 ml) can tomato sauce"
    },
    {
      "id": 352244,
      "primary_message": "Arrange pitas on a baking sheet pan. Divide veggie ground mixture between the pitas and top with cheese. Place in the oven and bake until the cheese is melted, 4-5 minutes. Remove from oven and cut into wedges.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 352245,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 352246,
      "primary_message": "Shave parsley leaves off stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for the pizzas) and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 352247,
      "primary_message": "To serve, divide pizzas and salad between plates. Sprinkle pizzas with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
