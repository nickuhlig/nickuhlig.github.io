  "instructions": [
    {
      "id": 352263,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 352264,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ red bell peppers\n1 ½ English cucumbers\n1 ½ heads romaine lettuce\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 352265,
      "primary_message": "Place mayo, vinegar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n3 tbsp red wine vinegar\n1 ½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 352266,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 352267,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352268,
      "primary_message": "Halve olives lengthwise and add to the bowl; set aside.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 352269,
      "primary_message": "Peel and mince shallots and garlic. ",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 352270,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 352271,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shallot, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 352272,
      "primary_message": "Meanwhile, coarsely grate mozzarella and set aside.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 352273,
      "primary_message": "Add tomato sauce to the skillet with the veggie ground and stir to combine. Remove from heat.",
      "secondary_message": "3 (213 ml) cans tomato sauce"
    },
    {
      "id": 352274,
      "primary_message": "Divide pitas between two baking sheet pans. Divide veggie ground mixture between the pitas and top with cheese. Place in the oven and bake until the cheese is melted, 5-6 minutes. Remove from oven and cut into wedges.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 352275,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 352276,
      "primary_message": "Shave parsley leaves off stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for the pizzas) and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 352277,
      "primary_message": "To serve, divide pizzas and salad between plates. Sprinkle pizzas with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
