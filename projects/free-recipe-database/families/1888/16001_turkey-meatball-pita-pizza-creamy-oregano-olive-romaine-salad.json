  "instructions": [
    {
      "id": 352188,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 352189,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ red bell pepper\n½ English cucumber\n½ head romaine lettuce\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 352190,
      "primary_message": "Place mayo, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp mayonnaise\n1 tbsp red wine vinegar\n½ tsp oregano, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 352191,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 352192,
      "primary_message": "Trim, halve lengthwise, and cut cucumber crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352193,
      "primary_message": "Halve olives lengthwise and add to the bowl; set aside.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 352194,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 352195,
      "primary_message": "While the skillet heats up, peel and mince shallot and garlic. ",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 352196,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shallot, garlic, turkey, and spices; cook, breaking apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅓ kg ground turkey\n½ tsp Italian seasoning\n¼ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 352197,
      "primary_message": "Meanwhile, coarsely grate mozzarella and set aside.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 352198,
      "primary_message": "Add tomato sauce to the skillet with the turkey and stir to combine. Remove from heat.",
      "secondary_message": "1 (213 ml) can tomato sauce"
    },
    {
      "id": 352199,
      "primary_message": "Arrange pitas on a baking sheet pan. Divide turkey mixture between the pitas and top with cheese. Place in the oven and bake until the cheese is melted, 4-5 minutes. Remove from oven and cut into wedges.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 352200,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 352201,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add half to the bowl (reserving the rest for the pizzas) and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 352202,
      "primary_message": "To serve, divide pizzas and salad between plates. Sprinkle pizzas with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
