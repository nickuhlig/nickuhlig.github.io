  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim and split the Brussels sprouts in half. Thinly slice the shallots. Peel and cut the ginger into thin matchsticks. Drain and roughly chop the kimchi. Pick the mint leaves from the stems and chop them.",
      "secondary_message": "0.68 kg Brussels sprouts\n2 medium shallots\n1 (5 cm) knob ginger root\n1 cup kimchi\n¼ cup fresh mint"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to upper position, place a foil-lined rimmed baking sheet on it, and preheat oven to 260°C (500°F).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, toss Brussels sprouts, shallots, and ginger with olive oil and season to taste with salt and pepper. Remove baking sheet from oven and add Brussels sprout mixture. Shake pan to distribute evenly. Return to oven and roast until sprouts are tender and deeply browned and shallots and ginger are starting to char, about 20 minutes total, rotating pan halfway through cooking.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, add kimchi, honey, vinegar, fish sauce, and pepper flakes (if using) to now-empty bowl. When Brussels sprouts are roasted, add to bowl and toss to combine. Season to taste with more salt and pepper if necessary. Toss with mint and serve immediately.",
      "secondary_message": null
    }
  ],
