  "instructions": [
    {
      "id": 144639,
      "primary_message": "Peel and finely dice the onions. Peel and mince the garlic. ",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 144640,
      "primary_message": "Preheat two large skillets over medium heat. Once the skillets are hot divide butter between them and swirl to coat the bottom. ",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 144641,
      "primary_message": "Lay prosciutto in the skillets and cook until it browns slightly, about 1 minute per side. Transfer to a plate and set aside. ",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 144642,
      "primary_message": "Divide additional butter, onion, and garlic between the skillets. Cook, stirring occasionally, until softened, about 3 minutes. ",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 144643,
      "primary_message": "Meanwhile, wash, dry, and medium dice the zucchini. ",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 144644,
      "primary_message": "Divide the zucchini between the two skillets and cook, stirring occasionally, until tender, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 144645,
      "primary_message": "Wash and dry the spinach (skip if it came prewashed). Add spinach to the two skillets in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 144646,
      "primary_message": "Using a spatula, spread the greens out in an even layer. Make 3 wells in each skillet for the eggs. Crack an egg into each well. Cook until the egg whites are almost cooked through, 2-3 minutes. Then cover each skillet with a lid and cook for 1 minute more.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 144647,
      "primary_message": "Season with crushed red pepper and serve with prosciutto on the side. Enjoy!",
      "secondary_message": "⅜ tsp crushed red pepper"
    }
  ],
