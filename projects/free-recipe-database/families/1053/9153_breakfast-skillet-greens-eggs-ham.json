  "instructions": [
    {
      "id": 144657,
      "primary_message": "Peel and finely dice the onion. Peel and mince the garlic. ",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 144658,
      "primary_message": "Preheat a skillet over medium heat. Once the skillet is hot add butter and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 144659,
      "primary_message": "Working in batches if necessary, lay prosciutto in the skillet and cook until it browns slightly, about 1 minute per side. Transfer to a plate and set aside. ",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 144660,
      "primary_message": "Add more butter, onion, and garlic to the skillet. Cook, stirring occasionally, until softened, about 3 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 144661,
      "primary_message": "Meanwhile, wash, dry, and medium dice the zucchini. ",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 144662,
      "primary_message": "Add the zucchini to the skillet and cook, stirring occasionally, until tender, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 144663,
      "primary_message": "Wash and dry the spinach (skip if it came prewashed). Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 144664,
      "primary_message": "Using a spatula, make a well for each egg in the mixture of greens. Crack an egg into each well. Cook until the egg whites are almost cooked through, 2-3 minutes. Then cover the skillet with a lid and cook for 1 minute more. ",
      "secondary_message": "4 eggs"
    },
    {
      "id": 144665,
      "primary_message": "Season with crushed red pepper and serve with prosciutto on the side. Enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
