  "instructions": [
    {
      "id": 474593,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 474594,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 oranges\n3 (8 oz) pkgs sugar snap peas\n1 small pkg fresh mint"
    },
    {
      "id": 474595,
      "primary_message": "Zest and juice three oranges into a large bowl. (Reserve remaining oranges for later use.)",
      "secondary_message": null
    },
    {
      "id": 474596,
      "primary_message": "Peel and mince shallot. Add to the bowl with the orange along with oil, vinegar, Dijon, honey, and spices. Stir to combine the dressing. ",
      "secondary_message": "1 shallot\n¼ cup extra virgin olive oil\n¼ cup white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 474597,
      "primary_message": "Mince dates. Add to the bowl with the dressing, stir once more to combine, and set aside.",
      "secondary_message": "⅓ cup medjool dates, pitted"
    },
    {
      "id": 474598,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 474599,
      "primary_message": "While the skillet heats up, roughly chop almonds.",
      "secondary_message": "¾ cup almonds"
    },
    {
      "id": 474600,
      "primary_message": "Once the skillet is hot, add almonds and toast, stirring often, until golden and fragrant, about 3 minutes. Transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 474601,
      "primary_message": "Peel and separate remaining oranges into segments; cut segments crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 474602,
      "primary_message": "Cut snap peas into 1-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 474603,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 474604,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl, along with feta, and stir to combine the pasta salad. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 474605,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
