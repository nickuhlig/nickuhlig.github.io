  "instructions": [
    {
      "id": 48409,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 grapefruit\n1 avocado\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 48410,
      "primary_message": "Slice off a piece from both grapefruit ends, then place it flat on one of the ends and slice off the peel (from top to bottom), exposing the flesh. Working over a bowl to catch the juices, cut out the segments of flesh from between the membranes, then cut them into 1 ¼-cm pieces. Transfer the pieces (and any leftover juice) to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 48411,
      "primary_message": "Halve the avocado lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and medium dice the flesh into 1 ¼-cm cubes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 48412,
      "primary_message": "Quarter the jalapeño pepper lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the pepper and add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 48413,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 48414,
      "primary_message": "Trim off and discard the ends of the shallot; peel and mince the shallot. Add to the salsa bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 48415,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 48416,
      "primary_message": "Pat the fish dry with paper towels and place on a plate; rub with olive oil and season with salt and pepper on both sides.",
      "secondary_message": "0.34 kg tilapia fillet\n½ tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 48417,
      "primary_message": "Once the skillet is hot, add the fish and cook until opaque and cooked through, 2 to 3 minutes per side. Once done, transfer to a plate and flake with a fork.",
      "secondary_message": null
    },
    {
      "id": 48418,
      "primary_message": "Drizzle the salsa with olive oil and season with cumin, salt, and pepper.",
      "secondary_message": "½ tbsp extra virgin olive oil\n⅛ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 48419,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15 to 30 seconds.",
      "secondary_message": "8 small corn tortillas"
    },
    {
      "id": 48420,
      "primary_message": "To serve, divide the flaked tilapia among the tortillas and top with the salsa. Enjoy!",
      "secondary_message": null
    }
  ],
