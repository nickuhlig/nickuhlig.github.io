  "instructions": [
    {
      "id": 146758,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 146759,
      "primary_message": "Add the bacon to the skillet and cook until crispy, 3-5 minutes per side.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 146760,
      "primary_message": "Meanwhile, peel and small dice the onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 146761,
      "primary_message": "Once the bacon is cooked, transfer to a plate lined with paper towels; pat to remove excess oil. Crumble or chop into small pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 146762,
      "primary_message": "Return skillet (with bacon fat) to the stove over medium heat. Add the onion and cook, stirring occasionally until softened, 4-6 minutes. ",
      "secondary_message": null
    },
    {
      "id": 146763,
      "primary_message": "Wash, trim ends, and thinly slice Brussels sprouts.",
      "secondary_message": "0.91 kg brussels sprouts"
    },
    {
      "id": 146764,
      "primary_message": "Add the Brussels sprouts, vinegar, sugar, and salt to the skillet. Cook, stirring frequently, until lightly browned and tender, 4-6 minutes. Once done, transfer to a medium bowl; set aside.",
      "secondary_message": "2 tbsp red wine vinegar\n4 tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 146765,
      "primary_message": "Return skillet to medium-high heat and add the butter.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 146766,
      "primary_message": "Pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg sea scallops\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 146767,
      "primary_message": "Carefully add scallops to the skillet in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a clean plate. Work in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 146768,
      "primary_message": "To serve, divide the Brussels sprouts between plates. Top with the scallops and crumbled bacon. Enjoy!",
      "secondary_message": null
    }
  ],
