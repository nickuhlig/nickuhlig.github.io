  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely dice the shallot. Pit, stem, and halve the Bing cherries.",
      "secondary_message": "1 small shallot\n198 g Bing cherries"
    },
    {
      "id": 1,
      "primary_message": "Take duck breasts out of the fridge 15 minutes before cooking. Preheat the oven to 205°C (400°F). Score skin on top of the breasts in a crosshatch fashion, being careful to score only the fat and not the flesh beneath it. Season duck on all sides with salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat an ovenproof nonstick skillet on medium heat. Place the duck, skin-side-down, in the hot pan and leave it alone for 10 to 12 minutes, until the skin is golden brown and the fat has rendered.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Take the pan off the heat, and turn the duck breasts over so the bottom of the breasts are coated in the rendered duck fat. Pour the excess fat into a heat-proof container, and keep for frying potatoes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Turn the breasts skin-side-up, transfer pan to the oven, and cook for 10 minutes. The internal temperature will be about 57°C (135°F). Let the duck breasts rest on a cutting board for 10 minutes before slicing.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "To make the cherry sauce, heat a small nonstick skillet over medium-low heat. Add olive oil and the shallot. Cook for 1 minute, just to soften the shallot. Add wine, stock, and cherries. Bring mixture to a boil. Add balsamic vinegar, salt to taste, and pepper. Reduce the heat to medium-low, and simmer for 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Remove a 1/4 cup combination of liquid and cherries and purée in a mini food processor. Return the puréed mixture to pan with the rest of the sauce, and stir in honey and cold butter.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Slice the duck. Pour the sauce onto a serving plate, and arrange the slices of duck on top. Finish with salt and pepper to taste. Serve with tender greens lightly dressed with lemon juice and olive oil, or rich and creamy puréed potatoes.",
      "secondary_message": null
    }
  ],
