  "instructions": [
    {
      "id": 244884,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 244885,
      "primary_message": "Wash, dry, seed, and medium dice bell pepper. Place in a medium bowl.",
      "secondary_message": "1 yellow bell pepper"
    },
    {
      "id": 244886,
      "primary_message": "Wash, dry, and halve tomatoes. Add to the bowl with the pepper.",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 244887,
      "primary_message": "Peel and medium dice onion. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 244888,
      "primary_message": "Add gnocchi, oil, sugar, and spices to the bowl; toss to combine.",
      "secondary_message": "1 (454 g) pkg potato gnocchi\n2 tsp extra virgin olive oil\n¾ tsp brown sugar\n½ tsp salt\n¼ tsp sage, dried\n⅛ tsp black pepper"
    },
    {
      "id": 244889,
      "primary_message": "Transfer veggies and gnocchi to a baking sheet pan and spread out in a single layer. Add sausages to the baking sheet, nestling them into the veggies and gnocchi. ",
      "secondary_message": null
    },
    {
      "id": 244890,
      "primary_message": "Place baking sheet in the oven and roast until sausages are cooked through and gnocchi is golden brown, 20-25 minutes.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 244891,
      "primary_message": "Remove baking sheet from the oven. Transfer sausages to a cutting board and slice crosswise into 1-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 244892,
      "primary_message": "To serve, divide gnocchi, veggies, and sausage between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
