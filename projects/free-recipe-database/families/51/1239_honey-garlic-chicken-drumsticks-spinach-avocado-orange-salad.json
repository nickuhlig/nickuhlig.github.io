  "instructions": [
    {
      "id": 10188,
      "primary_message": "Preheat oven to 230°C (450°F). Using a paper towel, lightly coat a small baking dish with oil.",
      "secondary_message": "about ½ tsp extra virgin olive oil"
    },
    {
      "id": 10189,
      "primary_message": "Add chicken to the dish, place in the oven, and bake for 10 minutes.",
      "secondary_message": "0.570 kg chicken drumsticks"
    },
    {
      "id": 10190,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare sauce by mixing together ⅔ of the garlic (save the rest for dressing), coconut aminos, honey, and parsley flakes. Set aside.",
      "secondary_message": "3 cloves garlic\r\n1 tbsp coconut aminos\r\n2 tbsp honey\r\n½ tsp parsley flakes"
    },
    {
      "id": 10191,
      "primary_message": "Wash, dry and transfer spinach to a large bowl. Halve and pit avocado; scoop out, medium dice, and add to bowl. Wash, peel, and quarter orange. Slice 3 of the quarters (save 1 for the dressing) into wedges and add to bowl. Toss salad.",
      "secondary_message": "½ (142 g) pkg baby spinach\r\n1 avocado\r\n1 orange"
    },
    {
      "id": 10192,
      "primary_message": "Remove dish from oven, pour honey garlic sauce over drumsticks and turn to coat. Place back in the oven and bake until cooked through, another 20-25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 10193,
      "primary_message": "In a small bowl, prepare dressing by whisking together juice of remaining orange, remaining garlic, oil, salt, and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 10194,
      "primary_message": "To serve, place drumsticks on a plate, add salad on the side, and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
