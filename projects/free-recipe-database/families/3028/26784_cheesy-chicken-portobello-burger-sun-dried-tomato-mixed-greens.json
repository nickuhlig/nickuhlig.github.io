  "instructions": [
    {
      "id": 479377,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with the chicken, bread crumbs, mayo, Worcestershire, and spices. Mix with your hands until well combined; set aside.",
      "secondary_message": "3 cloves garlic\n1 ½ lb ground chicken\n¾ cup panko bread crumbs\n2 tbsp mayonnaise\n1 tbsp Worcestershire sauce\n1 tbsp Italian seasoning\n¾ tsp rosemary, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 479378,
      "primary_message": "Wash and dry portobello mushrooms. Remove stems and carefully scrape out the gills. Rub with oil, then season with salt and pepper; place cap-side down on a large plate.",
      "secondary_message": "6 caps portobello mushrooms\n1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 479379,
      "primary_message": "Using your hands, divide chicken mixture between the insides of mushrooms, spreading evenly to the edges. Gently press to adhere.",
      "secondary_message": null
    },
    {
      "id": 479380,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479381,
      "primary_message": "While the pan heats up, thinly slice cheese.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 479382,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add burger patties, chicken-side down and cook, undisturbed, until the chicken is golden brown and cooked through, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 479383,
      "primary_message": "Flip patties, top with cheese, and cook until mushrooms are golden brown and fork-tender, 6-8 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 479384,
      "primary_message": "Meanwhile, peel, halve, and mince onion. Place in a clean large bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 479385,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the onion along with oil, vinegar, honey, Dijon, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "18 sun-dried tomatoes, oil-packed\n3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tbsp honey\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 479386,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": "1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 479387,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 479388,
      "primary_message": "Spread mayo over the bottom half of each bun; top with cheesy burger patties and a small handful of salad. Close with the top half of each bun. Serve with remaining salad on the side and enjoy!",
      "secondary_message": "3 tbsp mayonnaise"
    }
  ],
