  "instructions": [
    {
      "id": 479485,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with the chicken, bread crumbs, mayo, Worcestershire, and spices. Mix with your hands until well combined; set aside.",
      "secondary_message": "1 clove garlic\n0.23 kg ground chicken\n¼ cup panko bread crumbs\n2 tsp mayonnaise\n1 tsp Worcestershire sauce\n1 tsp Italian seasoning\n¼ tsp rosemary, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 479486,
      "primary_message": "Wash and dry portobello mushrooms. Remove stems and carefully scrape out the gills. Rub with oil, then season with salt and pepper; place cap-side down on a plate.",
      "secondary_message": "2 caps portobello mushrooms\n1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 479487,
      "primary_message": "Using your hands, divide chicken mixture between the insides of mushrooms, spreading evenly to the edges. Gently press to adhere.",
      "secondary_message": null
    },
    {
      "id": 479488,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479489,
      "primary_message": "While the pan heats up, thinly slice cheese.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 479490,
      "primary_message": "Once the pan is hot, coat with oil. Add burger patties, chicken-side down and cook, undisturbed, until the chicken is golden brown and cooked through, 4-5 minutes. Flip patties, top with cheese, and cook until mushrooms are golden brown and fork-tender, 6-8 minutes more. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 479491,
      "primary_message": "Meanwhile, peel, halve, and slice shallot crosswise into thin half-moons. Place in a clean medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 479492,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the shallot along with oil, vinegar, honey, Dijon, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "6 sun-dried tomatoes, oil-packed\n1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp honey\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 479493,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 479494,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 479495,
      "primary_message": "Spread mayo over the bottom half of each bun; top with cheesy burger patties and a small handful of salad. Close with the top half of each bun. Serve with remaining salad on the side and enjoy!",
      "secondary_message": "1 tbsp mayonnaise"
    }
  ],
