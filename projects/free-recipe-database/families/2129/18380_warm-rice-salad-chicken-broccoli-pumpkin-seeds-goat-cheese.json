  "instructions": [
    {
      "id": 301101,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water, chicken, salt, and pepper; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 301102,
      "primary_message": "Once the liquid comes to a boil, cover the saucepan and reduce heat to low. Cook until liquid is fully absorbed and chicken is cooked through, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 301103,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ bunch radish\n½ small bunch Italian (flat-leaf) parsley\n1 crown broccoli"
    },
    {
      "id": 301104,
      "primary_message": "Zest and juice lemon into a medium bowl; add oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 301105,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 301106,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 301107,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 301108,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium red onion\n2 cloves garlic"
    },
    {
      "id": 301109,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring occasionally, until the onion starts to soften, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 301110,
      "primary_message": "Meanwhile, roughly chop broccoli into small pieces.",
      "secondary_message": null
    },
    {
      "id": 301111,
      "primary_message": "Once the onion is soft, add broccoli to the skillet and continue to cook, stirring occasionally, until the broccoli is tender, about 5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 301112,
      "primary_message": "Add cooked veggies and pumpkin seeds to the bowl with the dressing, radish, and parsley.",
      "secondary_message": "¼ cup pumpkin seeds"
    },
    {
      "id": 301113,
      "primary_message": "Using tongs, transfer the cooked chicken to a cutting board. Shred the chicken using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat.",
      "secondary_message": null
    },
    {
      "id": 301114,
      "primary_message": "Add shredded chicken and warm rice to the bowl with the dressing and veggies; stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 301115,
      "primary_message": "To serve, divide salad between bowls and crumble goat cheese over top. Enjoy!",
      "secondary_message": "½ (4 oz) log goat cheese"
    }
  ],
