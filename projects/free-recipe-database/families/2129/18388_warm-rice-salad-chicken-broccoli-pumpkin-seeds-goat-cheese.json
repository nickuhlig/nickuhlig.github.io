  "instructions": [
    {
      "id": 301221,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large pot. Add water, chicken, salt, and pepper; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 301222,
      "primary_message": "Once the liquid comes to a boil, cover the pot and reduce heat to low. Cook until liquid is fully absorbed and chicken is cooked through, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 301223,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ bunches radish\n2 small bunches Italian (flat-leaf) parsley\n3 crowns broccoli"
    },
    {
      "id": 301224,
      "primary_message": "Zest and juice lemons into a large bowl; add oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 301225,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 301226,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 301227,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium red onions\n6 cloves garlic"
    },
    {
      "id": 301228,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 301229,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring occasionally, until the onion starts to soften, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 301230,
      "primary_message": "Meanwhile, roughly chop broccoli into small pieces.",
      "secondary_message": null
    },
    {
      "id": 301231,
      "primary_message": "Once the onion is soft, add broccoli to the skillet and continue to cook, stirring occasionally, until the broccoli is tender, 6-7 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 301232,
      "primary_message": "Add cooked veggies and pumpkin seeds to the bowl with the dressing, radish, and parsley.",
      "secondary_message": "¾ cup pumpkin seeds"
    },
    {
      "id": 301233,
      "primary_message": "Using tongs, transfer the cooked chicken to a cutting board. Shred the chicken using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat.",
      "secondary_message": null
    },
    {
      "id": 301234,
      "primary_message": "Add shredded chicken and warm rice to the bowl with the dressing and veggies; stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 301235,
      "primary_message": "To serve, divide salad between bowls and crumble goat cheese over top. Enjoy!",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    }
  ],
