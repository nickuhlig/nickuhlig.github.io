  "instructions": [
    {
      "id": 382278,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 382279,
      "primary_message": "Place cauliflower on a large baking sheet pan, drizzle with oil, then sprinkle with Cajun seasoning and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 (283 g) bags cauliflower florets\n2 tbsp extra virgin olive oil\n1 tbsp Cajun seasoning\n3 pinch salt"
    },
    {
      "id": 382280,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is golden and fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 382281,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 382282,
      "primary_message": "Once the skillet is hot, add beef, salt, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "1.02 kg lean ground beef\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 382283,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 382284,
      "primary_message": "When the beef is done, add barbecue sauce and stir to combine. Continue to cook until heated through and slightly thickened, 2 minutes more. Cover with a lid and remove from heat.",
      "secondary_message": "1 ½ cup barbecue sauce"
    },
    {
      "id": 382285,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 382286,
      "primary_message": "When the cauliflower is done, remove from the oven, add parsley, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 382287,
      "primary_message": "Place bottom half of each bun on a plate. Top with barbecue beef, then close with the top half of the buns. Serve roasted cauliflower on the side. Enjoy!",
      "secondary_message": null
    }
  ],
