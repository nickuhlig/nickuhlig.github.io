  "instructions": [
    {
      "id": 183799,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover, and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 183800,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n2 limes\n2 medium carrots\n2 tomatoes\n1 small head red cabbage\n1 small bunch cilantro\n1 small pkg fresh mint"
    },
    {
      "id": 183801,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 183802,
      "primary_message": "Thinly slice the jalapeño into rounds; remove seeds and add to the bowl with the garlic. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 183803,
      "primary_message": "Juice limes into the bowl. Add soy sauce, sugar, and oil; whisk to combine the dressing and set aside.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp brown sugar\n2 tbsp toasted sesame oil"
    },
    {
      "id": 183804,
      "primary_message": "Once the water in the pot is boiling, add edamame, return to a boil, and cook until tender, about 2 minutes. Remove pot from the heat and add rice noodles. Let noodles soak for 10 minutes, or according to package directions, then drain noodles and edamame in a colander and rinse under cold water.",
      "secondary_message": "2 cups edamame\n283 g flat rice (pad thai) noodles"
    },
    {
      "id": 183805,
      "primary_message": "Meanwhile, peel, trim, and julienne or coarsely grate the carrots. Transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 183806,
      "primary_message": "Cut tomatoes into thin wedges and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 183807,
      "primary_message": "Halve the cabbage lengthwise and cut out the core; thinly slice crosswise and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 183808,
      "primary_message": "Shave cilantro leaves off the stems. Pick mint leaves off the stems. Roughly chop leaves and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 183809,
      "primary_message": "Add drained noodles and edamame to the bowl, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 183810,
      "primary_message": "To serve, divide noodle salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
