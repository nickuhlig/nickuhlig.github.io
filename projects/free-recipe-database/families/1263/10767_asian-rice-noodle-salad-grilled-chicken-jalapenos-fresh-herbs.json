  "instructions": [
    {
      "id": 183610,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 183611,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n3 limes\n3 medium carrots\n1 ½ English cucumbers\n1 ½ small heads red cabbage\n1 small bunch cilantro\n1 small pkg fresh mint"
    },
    {
      "id": 183612,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 183613,
      "primary_message": "Thinly slice the jalapeño into rounds; remove seeds and add to the bowl with the garlic. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 183614,
      "primary_message": "Juice limes into the bowl. Add soy sauce, sugar, fish sauce, and oil; whisk to combine the dressing and set aside.",
      "secondary_message": "⅓ cup soy sauce\n¼ cup brown sugar\n3 tbsp fish sauce\n1 tbsp toasted sesame oil"
    },
    {
      "id": 183615,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 183616,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 183617,
      "primary_message": "While the grill pan heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 183618,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add chicken and grill, flipping once, until golden and cooked through, 8-10 minutes. Transfer to a clean plate.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 183619,
      "primary_message": "Meanwhile, peel, trim, and julienne or coarsely grate the carrots. Transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 183620,
      "primary_message": "Trim and halve the cucumbers lengthwise, then slice crosswise into ¼-inch-thick pieces at an angle. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 183621,
      "primary_message": "Halve each cabbage lengthwise and cut out the core; thinly slice crosswise and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 183622,
      "primary_message": "Shave cilantro leaves off the stems. Pick mint leaves off the stems. Roughly chop leaves and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 183623,
      "primary_message": "Slice the chicken crosswise into strips. Add to the bowl along with the noodles and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 183624,
      "primary_message": "To serve, divide noodle salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
