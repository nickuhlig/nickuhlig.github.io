  "instructions": [
    {
      "id": 183742,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 183743,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ jalapeño pepper\n1 lime\n1 medium carrot\n½ English cucumber\n½ small head red cabbage\n½ small bunch cilantro\n½ small pkg fresh mint"
    },
    {
      "id": 183744,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 183745,
      "primary_message": "Thinly slice the jalapeño into rounds; remove seeds and add to the bowl with the garlic. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 183746,
      "primary_message": "Juice lime into the bowl. Add soy sauce, sugar, fish sauce, and oil; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp soy sauce\n1 ½ tbsp brown sugar\n1 tbsp fish sauce\n1 tsp toasted sesame oil"
    },
    {
      "id": 183747,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water.",
      "secondary_message": "142 g flat rice (pad thai) noodles"
    },
    {
      "id": 183748,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 183749,
      "primary_message": "While the grill pan heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 183750,
      "primary_message": "Once the grill pan is hot, coat with oil. Add chicken and grill, flipping once, until golden and cooked through, 8-10 minutes. Transfer to a clean plate.",
      "secondary_message": "½ tsp toasted sesame oil"
    },
    {
      "id": 183751,
      "primary_message": "Meanwhile, peel, trim, and julienne or coarsely grate the carrot. Transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 183752,
      "primary_message": "Trim and halve the cucumber lengthwise, then slice crosswise into ¼-inch-thick pieces at an angle. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 183753,
      "primary_message": "Halve the cabbage lengthwise and cut out the core; thinly slice crosswise and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 183754,
      "primary_message": "Shave cilantro leaves off the stems. Pick mint leaves off the stems. Roughly chop leaves and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 183755,
      "primary_message": "Slice the chicken crosswise into strips. Add to the bowl along with the noodles and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 183756,
      "primary_message": "To serve, divide noodle salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
