  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat a grill pan over medium-high heat. Brush salmon with olive oil and season both sides with salt and pepper. Grill salmon until just cooked through, about 4 minutes per side depending on thickness. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place lettuce, eggs, bacon, avocados, cherry tomatoes, and goat cheese in a large bowl. Toss to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium bowl, whisk together all ingredients for dressing. Season with salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour dressing over lettuce mixture and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cut salmon into 4 pieces. Divide salad between 4 bowls, topping each bowl with a piece of salmon.",
      "secondary_message": null
    }
