  "instructions": [
    {
      "id": 3339,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "about 7 cups water\n1 tbsp salt\n142 g (1 quarter coin = 56 g) spaghetti pasta"
    },
    {
      "id": 3340,
      "primary_message": "Wash and dry carrot, celery, and basil. Small dice carrot and celery. Pick basil leaves off the stems and thinly slice into ribbons. Transfer to a plate.",
      "secondary_message": "1 carrot\r\n1 stick celery\r\n½ small pkg fresh basil"
    },
    {
      "id": 3341,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 3342,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "½ medium yellow onion\r\n2 cloves garlic"
    },
    {
      "id": 3343,
      "primary_message": "Coat bottom of pan with oil. Add onion, garlic, carrot, celery, and crushed red pepper. Stirring frequently, cook until softened, 5-6 minutes.",
      "secondary_message": "½ tbsp extra virgin olive oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 3344,
      "primary_message": "Increase heat to medium-high and add beef. Breaking apart with a spoon, cook until browned and crumbly, 3-4 minutes.",
      "secondary_message": "0.34 kg lean ground beef"
    },
    {
      "id": 3346,
      "primary_message": "Add tomatoes, ½ of the basil (save the rest for garnishing), Italian seasoning, salt, and pepper. Stir and bring to a boil. Reduce heat, cover, and simmer, stirring occasionally, for 10 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\r\n½ tsp Italian seasoning\r\n¼ tsp salt\r\n⅛ tsp pepper"
    },
    {
      "id": 3347,
      "primary_message": "Grate or shave ⅛ cup of Parmesan.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 3348,
      "primary_message": "Drain pasta, return to saucepan, and drizzle with a little olive oil to prevent sticking.",
      "secondary_message": ""
    },
    {
      "id": 3349,
      "primary_message": "To serve, place pasta in a shallow bowl or plate and top with bolognese sauce. Sprinkle with Parmesan and garnish with remaining basil. Enjoy!",
      "secondary_message": ""
    }
  ],
