  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Crush the garlic. Finely chop the fresh red chile. Zest the lime. Cut the eggplants into 3/4-inch dice. Chop the cilantro leaves. Very thinly slice the red onion.",
      "secondary_message": "2 cloves garlic\n½ fresh red chile\n1 lime\n2 eggplants\n2 ½ cups cilantro leaves\n½ red onion"
    },
    {
      "id": 1,
      "primary_message": "In a small saucepan gently warm the vinegar, sugar and salt for up to 1 minute, just until the sugar dissolves. Remove from the heat and add the garlic, chile, and sesame oil. Allow to cool, then add the lime zest and juice.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat up the sunflower oil in a large pan and shallow-fry the eggplant in three or four batches. Once golden brown remove to a colander, sprinkle liberally with salt and leave there to drain.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cook the noodles in plenty of boiling salted water, stirring occasionally. They should take 5 to 8 minutes to become tender but still al dente. Drain and rinse well under running cold water. Shake off as much of the excess water as possible, then leave to dry on a dish towel.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a mixing bowl toss the noodles with the dressing, mango, eggplant, half of the herbs and the onion. You can now leave this aside for 1 to 2 hours. When ready to serve add the rest of the herbs and mix well, then pile on a plate or in a bowl.",
      "secondary_message": null
    }
  ],
