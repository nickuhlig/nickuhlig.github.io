  "instructions": [
    {
      "id": 437082,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 437083,
      "primary_message": "Drain and rinse chickpeas. Place on a clean towel or paper towels and pat dry; transfer to a small bowl.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 437084,
      "primary_message": "Add nutritional yeast, oil, and spices to the bowl with the chickpeas; stir to combine. Transfer to a baking sheet pan and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": "⅛ cup nutritional yeast flakes\n1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n1 tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 437085,
      "primary_message": "Place chickpeas in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until golden and crispy, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 437086,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 437087,
      "primary_message": "While the skillet heats up, place yogurt, tahini, vinegar, and salt in the reserved bowl. Stir to combine and set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp tahini\n1 tbsp white wine vinegar\n⅛ tsp salt"
    },
    {
      "id": 437088,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until golden and toasted, 4-5 minutes. Transfer to a plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "id": 437089,
      "primary_message": "Wash, dry, and trim green beans; place in a medium bowl.",
      "secondary_message": "0.23 kg green beans"
    },
    {
      "id": 437090,
      "primary_message": "Wash, dry, trim, and seed bell pepper, then slice lengthwise into thin strips. Add to the bowl with the green beans.",
      "secondary_message": "1 orange bell pepper"
    },
    {
      "id": 437091,
      "primary_message": "Return the skillet to high heat, add oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until blistered and tender, about 5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 437092,
      "primary_message": "To serve, divide yogurt between plates; top with veggies, chickpeas, and almonds. Enjoy!",
      "secondary_message": null
    }
  ],
