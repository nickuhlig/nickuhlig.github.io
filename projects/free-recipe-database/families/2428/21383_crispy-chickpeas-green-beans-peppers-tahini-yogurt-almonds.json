  "instructions": [
    {
      "id": 437093,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 437094,
      "primary_message": "Drain and rinse chickpeas. Place on a clean towel or paper towels and pat dry; transfer to a medium bowl.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 437095,
      "primary_message": "Add nutritional yeast, oil, and spices to the bowl with the chickpeas; stir to combine. Transfer to a large baking sheet pan and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": "¼ cup nutritional yeast flakes\n2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n2 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 437096,
      "primary_message": "Place chickpeas in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until golden and crispy, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 437097,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 437098,
      "primary_message": "While the skillet heats up, place yogurt, tahini, vinegar, and salt in the reserved bowl. Stir to combine and set aside. ",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup tahini\n2 tbsp white wine vinegar\n¼ tsp salt"
    },
    {
      "id": 437099,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until golden and toasted, 4-5 minutes. Transfer to a plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 437100,
      "primary_message": "Wash, dry, and trim green beans; place in another medium bowl.",
      "secondary_message": "0.45 kg green beans"
    },
    {
      "id": 437101,
      "primary_message": "Wash, dry, trim, and seed bell peppers, then slice lengthwise into thin strips. Add to the bowl with the green beans.",
      "secondary_message": "2 orange bell peppers"
    },
    {
      "id": 437102,
      "primary_message": "Return the skillet to high heat, add oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until blistered and tender, about 5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 437103,
      "primary_message": "To serve, divide yogurt between plates; top with veggies, chickpeas, and almonds. Enjoy!",
      "secondary_message": null
    }
  ],
