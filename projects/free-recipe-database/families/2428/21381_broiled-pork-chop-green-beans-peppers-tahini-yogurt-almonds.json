  "instructions": [
    {
      "id": 437072,
      "primary_message": "Preheat the broiler to high and position rack about 6 inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 437073,
      "primary_message": "Place pork chops on a broiler pan and season both sides with salt and pepper.",
      "secondary_message": "6 pork chops, bone-in\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 437074,
      "primary_message": "Place pan in the oven. Broil, flipping halfway through, until chops are no longer pink in the center and are browned at the edges, 12-14 minutes. Remove from oven and let rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 437075,
      "primary_message": "Meanwhile, preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 437076,
      "primary_message": "While the pot heats up, place yogurt, tahini, vinegar, and salt in a small bowl. Stir to combine and set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n⅓ cup tahini\n3 tbsp white wine vinegar\n½ tsp salt"
    },
    {
      "id": 437077,
      "primary_message": "Once the pot is hot, add almonds and cook, stirring frequently, until golden and toasted, about 5 minutes. Transfer to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "¾ cup almonds, sliced"
    },
    {
      "id": 437078,
      "primary_message": "Wash, dry, and trim green beans; place in a large bowl.",
      "secondary_message": "0.68 kg green beans"
    },
    {
      "id": 437079,
      "primary_message": "Wash, dry, trim, and seed bell peppers, then slice lengthwise into thin strips. Add to the bowl with the green beans. ",
      "secondary_message": "3 orange bell peppers"
    },
    {
      "id": 437080,
      "primary_message": "Return the pot to high heat, add oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until blistered and tender, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 437081,
      "primary_message": "To serve, divide chops and tahini yogurt between plates; top yogurt with veggies and almonds. Enjoy!",
      "secondary_message": null
    }
  ],
