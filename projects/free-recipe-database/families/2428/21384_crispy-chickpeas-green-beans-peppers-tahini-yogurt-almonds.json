  "instructions": [
    {
      "id": 437104,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 437105,
      "primary_message": "Drain and rinse chickpeas. Place on a clean towel or paper towels and pat dry; transfer to a medium bowl.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 437106,
      "primary_message": "Add nutritional yeast, oil, and spices to the bowl with the chickpeas; stir to combine. Transfer to a large baking sheet pan and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": "⅓ cup nutritional yeast flakes\n3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 tbsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 437107,
      "primary_message": "Place chickpeas in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until golden and crispy, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 437108,
      "primary_message": "Meanwhile, preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 437109,
      "primary_message": "While the pot heats up, place yogurt, tahini, vinegar, and salt in the reserved bowl. Stir to combine and set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n⅓ cup tahini\n3 tbsp white wine vinegar\n½ tsp salt"
    },
    {
      "id": 437110,
      "primary_message": "Once the pot is hot, add almonds and cook, stirring frequently, until golden and toasted, about 5 minutes. Transfer to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "¾ cup almonds, sliced"
    },
    {
      "id": 437111,
      "primary_message": "Wash, dry, and trim green beans; place in a large bowl.",
      "secondary_message": "0.68 kg green beans"
    },
    {
      "id": 437112,
      "primary_message": "Wash, dry, trim, and seed bell peppers, then slice lengthwise into thin strips. Add to the bowl with the green beans.",
      "secondary_message": "3 orange bell peppers"
    },
    {
      "id": 437113,
      "primary_message": "Return the pot to high heat, add oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until blistered and tender, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 437114,
      "primary_message": "To serve, divide yogurt between plates; top with veggies, chickpeas, and almonds. Enjoy!",
      "secondary_message": null
    }
  ],
