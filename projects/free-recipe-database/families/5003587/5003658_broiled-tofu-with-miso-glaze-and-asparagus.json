  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat miso, gochujang, apple cider vinegar, honey, ginger, garlic, and water in a medium saucepan over medium-low heat. Stir occasionally and cook until mixture reduces to a thick glaze, 10 to 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring a large pot of salted water to a boil. Meanwhile, dry tofu, wrap in paper towels, and weigh down with a plate. After 10 minutes, discard paper towels, cut tofu into 5-cm by 2.5-cm pieces. Toss with canola oil on a foil lined baking sheet.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Arrange top oven rack to 15 cm below the heating element and preheat broiler to high. Set the baking sheet under the broiler and cook until tofu pieces are lightly browned on top, 3 to 4 minutes. Flip the pieces and brown lightly on the other side, another 3 to 4 minutes. Remove baking sheet from the oven.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Brush the tofu pieces on both sides with the miso glaze. Set back underneath the broiler and cook until glaze has browned, 2 to 3 minutes a side.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add asparagus to the boiling water and cook until bright green and tender, about 3 minutes. Drain asparagus.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Divide the tofu and asparagus between four plates. Drizzle any extra of the glaze over the asparagus. Sprinkle with sesame seeds and serve.",
      "secondary_message": null
    }
  ],
