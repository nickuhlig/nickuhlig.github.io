  "instructions": [
    {
      "id": 272235,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 ½ avocados"
    },
    {
      "id": 272236,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 272237,
      "primary_message": "Peel and mince shallots; add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 272238,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 272239,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 272240,
      "primary_message": "Trim and halve cucumbers lengthwise, then thinly slice crosswise into half-moons. Add to the bowl and toss to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 272241,
      "primary_message": "Preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 272242,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 272243,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n12 eggs\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 272244,
      "primary_message": "While the eggs are cooking, thinly slice cheddar.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 272245,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil until bread is toasted on one side, 1-2 minutes.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 272246,
      "primary_message": "Remove baking sheets from the oven, flip bread, and arrange cheese over half of the slices. Working in batches, return baking sheets to the oven and continue to broil until bread is toasted and cheese is melted, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 272247,
      "primary_message": "Meanwhile, halve and pit the avocados. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 272248,
      "primary_message": "Layer each cheesy toast slice with two fried eggs and avocado. Spread mayo over remaining toast slices and place on top to close sandwiches.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 272249,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
