  "instructions": [
    {
      "id": 272310,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 small pkg grape tomatoes\n1 English cucumber\n1 avocado"
    },
    {
      "id": 272311,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 272312,
      "primary_message": "Peel and mince shallot; add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 272313,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 272314,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 272315,
      "primary_message": "Trim and halve cucumber lengthwise, then thinly slice crosswise into half-moons. Add to the bowl and toss to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 272316,
      "primary_message": "Preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 272317,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 272318,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n8 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 272319,
      "primary_message": "While the eggs are cooking, thinly slice cheddar.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 272320,
      "primary_message": "Place bread on a large baking sheet pan; place in the oven and broil until bread is toasted on one side, 1-2 minutes.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 272321,
      "primary_message": "Remove baking sheet from the oven, flip bread, and arrange cheese over half of the slices. Return baking sheet to the oven and continue to broil until bread is toasted and cheese is melted, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 272322,
      "primary_message": "Meanwhile, halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 272323,
      "primary_message": "Layer each cheesy toast slice with two fried eggs and avocado. Spread mayo over remaining toast slices and place on top to close sandwiches.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "id": 272324,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
