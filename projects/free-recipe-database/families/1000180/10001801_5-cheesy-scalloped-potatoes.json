  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Coat a large (9 x 13-inch) baking dish with butter.  ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "primary_message": "Peel and roughly chop garlic; place in a medium saucepan.  ",
      "secondary_message": "6 clove garlic"
    },
    {
      "primary_message": "Wash and dry rosemary. Slide leaves off stems; discard stems. Add leaves to the pan with the garlic along with milk, cream, and spices; stir to combine.  ",
      "secondary_message": "1 small pkg fresh rosemary\n473 ml whole milk\n237 ml heavy whipping cream\n1 tsp nutmeg, ground\n1 tsp thyme, dried\n1 tsp salt"
    },
    {
      "primary_message": "Place saucepan over medium-high heat and bring to a simmer. Once simmering, remove from heat and let infuse as you prepare the potatoes.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and peel potatoes. Cut crosswise into very thin slices (about the thickness of a quarter). Alternatively, you can use a mandoline slicer. ",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange potato slices in the baking dish, overlapping them in rows, until they cover the dish in layers. Season each layer with salt and pepper. ",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Strain the infused liquid over the potatoes; discard garlic and rosemary. (The liquid should just cover the potatoes – you may not need to use all of it.) ",
      "secondary_message": null
    },
    {
      "primary_message": "Dot the top of the potatoes with additional butter, then tightly cover the baking dish with aluminum foil.  ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "primary_message": "Place baking dish in the oven and bake until potatoes are very tender when pierced with the tip of a knife, 45-50 minutes.  ",
      "secondary_message": null
    },
    {
      "primary_message": "When the potatoes are almost done, coarsely grate cheese. ",
      "secondary_message": "1 (227 g) block white cheddar cheese"
    },
    {
      "primary_message": "When the potatoes are done, remove from the oven and discard the foil. Sprinkle cheese over the potatoes.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Return baking dish to the oven (uncovered) and continue to bake until cheese is golden and bubbling, 10-15 minutes.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from oven and let stand 10 minutes before serving. ",
      "secondary_message": null
    }
  ],
