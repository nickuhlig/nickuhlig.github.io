  "instructions": [
    {
      "primary_message": "Preheat oven to 450 degrees F with oven rack in the upper third of the oven. Line a large-rimmed baking pan with foil or parchment paper if desired. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove outer leaves from the cauliflower head then cut vertically through the core into 4 steaks (about 1-inch thick each). Place steaks on prepared baking sheet. ",
      "secondary_message": null
    },
    {
      "primary_message": "Brush the tops of the steaks evenly with oil, then sprinkle each with garlic & herb seasoning and seasoning salt.",
      "secondary_message": null
    },
    {
      "primary_message": "Place cauliflower in the oven and roast until golden brown, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Set oven to broil on high.",
      "secondary_message": null
    },
    {
      "primary_message": "Spoon a few tablespoons of marinara sauce over each cauliflower steak, then sprinkle with cheeses and toppings as desired. Broil, watching carefully, until the cheese is melted and toppings are sizzling, about 2-4 minutes. Remove from oven.",
      "secondary_message": null
    }
  ],
