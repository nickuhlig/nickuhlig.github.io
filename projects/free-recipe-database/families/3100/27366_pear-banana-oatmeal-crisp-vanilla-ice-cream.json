  "instructions": [
    {
      "id": 440682,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 440683,
      "primary_message": "Wash, dry, quarter, and core pears; medium dice.",
      "secondary_message": "6 pears"
    },
    {
      "id": 440684,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 440685,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pears, water, sugar, cinnamon, and nutmeg. Cook, stirring occasionally, until the pears are golden and starting to soften, about 8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp virgin coconut oil\n3 fl oz (⅜ cup) water\n2 tbsp brown sugar\n¾ tsp cinnamon, ground\n3 pinch nutmeg, ground"
    },
    {
      "id": 440686,
      "primary_message": "Meanwhile, place oats, additional oil, flour, and sugar in a medium bowl. Using two hands, combine the topping by rubbing the mixture between your thumbs and fingers until it looks crumbly. Set aside.",
      "secondary_message": "¾ cup oats, quick cooking\n½ cup virgin coconut oil\n⅓ cup all-purpose flour\n¼ cup brown sugar"
    },
    {
      "id": 440687,
      "primary_message": "Peel and thinly slice bananas.",
      "secondary_message": "3 bananas"
    },
    {
      "id": 440688,
      "primary_message": "Transfer pears to a large baking dish and spread out in an even layer. Arrange banana slices on top, then sprinkle evenly with topping.",
      "secondary_message": null
    },
    {
      "id": 440689,
      "primary_message": "Place baking dish in the oven and bake until fruit is soft and topping is golden, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 440690,
      "primary_message": "To serve, divide crisp and ice cream between bowls. Enjoy!",
      "secondary_message": "36 fl oz (4 ½ cups) vanilla ice cream, vegan"
    }
  ],
