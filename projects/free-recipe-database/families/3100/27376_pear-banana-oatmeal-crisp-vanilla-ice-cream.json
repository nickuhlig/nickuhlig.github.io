  "instructions": [
    {
      "id": 440772,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 440773,
      "primary_message": "Wash, dry, quarter, and core pears; medium dice.",
      "secondary_message": "2 pears"
    },
    {
      "id": 440774,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 440775,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pears, water, sugar, cinnamon, and nutmeg. Cook, stirring occasionally, until the pears are golden and starting to soften, 6-8 minutes. Remove from heat.",
      "secondary_message": "2 tsp virgin coconut oil\n2 tbsp water\n2 tsp brown sugar\n¼ tsp cinnamon, ground\n1 pinch nutmeg, ground"
    },
    {
      "id": 440776,
      "primary_message": "Meanwhile, place oats, additional oil, flour, and sugar in a small bowl. Using two hands, combine the topping by rubbing the mixture between your thumbs and fingers until it looks crumbly. Set aside.",
      "secondary_message": "¼ cup oats, quick cooking\n3 tbsp virgin coconut oil\n2 tbsp all-purpose flour\n1 ½ tbsp brown sugar"
    },
    {
      "id": 440777,
      "primary_message": "Peel and thinly slice banana.",
      "secondary_message": "1 banana"
    },
    {
      "id": 440778,
      "primary_message": "Transfer pears to a small baking dish and spread out in an even layer. Arrange banana slices on top, then sprinkle evenly with topping.",
      "secondary_message": null
    },
    {
      "id": 440779,
      "primary_message": "Place baking dish in the oven and bake until fruit is soft and topping is golden, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 440780,
      "primary_message": "To serve, divide crisp and ice cream between bowls. Enjoy!",
      "secondary_message": "355 ml vanilla ice cream, vegan"
    }
  ],
