  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. Coat a large baking sheet pan with a thin layer of oil.\n\n",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "primary_message": "Place chicken, cheese, and spices in a medium bowl; mix with your hands until well combined.\n\n",
      "secondary_message": "1 lb ground chicken\n1 cup cheddar cheese, shredded\n¾ tsp salt\n½ tsp garlic powder\n½ tsp chili powder"
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat. Once the skillet is hot, working in batches, add tortillas and cook, flipping once, until softened, 2-3 minutes. Remove to a flat surface.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide the chicken mixture between softened tortillas. Tightly roll tortillas to close, then arrange taquitos, seam-side down, on the baking sheet. Space them about 1-inch apart so they cook evenly, then drizzle with oil.\n\n\n\n",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Place baking sheet in the oven and bake, turning taquitos halfway through, until golden on the edges and chicken is cooked through, about 15 minutes. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cut taquitos in half and divide between plates. Serve with sour cream for dipping and enjoy!\n\n\n\n",
      "secondary_message": "1 cup sour cream"
    }
  ],
