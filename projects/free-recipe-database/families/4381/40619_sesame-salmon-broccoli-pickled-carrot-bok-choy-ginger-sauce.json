  "instructions": [
    {
      "id": 627954,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 627955,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n6 baby bok choy\n3 medium carrots\n1 small bunch green onions (scallions)\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 627956,
      "primary_message": "Separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 627957,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until broccoli is golden brown and tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 627958,
      "primary_message": "Meanwhile, place vinegar, honey, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "½ cup rice vinegar\n2 tbsp honey\n1 tbsp salt"
    },
    {
      "id": 627959,
      "primary_message": "Trim and slice bok choy crosswise into thin (shred-like) strips. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 627960,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 627961,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, stir to combine the pickled veggies, and set aside.",
      "secondary_message": null
    },
    {
      "id": 627962,
      "primary_message": "Peel and mince ginger. Place in a small bowl along with soy sauce, vinegar, honey, and chili-garlic sauce, then whisk to combine the marinade.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp rice vinegar\n3 tbsp honey\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 627963,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end (or corner) firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin.",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 627964,
      "primary_message": "Cut the salmon into 1-inch cubes. Place in a large bowl, along with half of the marinade, and stir to coat. (Reserve remaining marinade for the sauce.)",
      "secondary_message": null
    },
    {
      "id": 627965,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 627966,
      "primary_message": "While the skillet heats up, add sesame seeds to the bowl with the salmon, and stir once more to coat.",
      "secondary_message": "¾ cup sesame seeds"
    },
    {
      "id": 627967,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon (leaving any excess marinade in the bowl) and cook, turning occasionally, until cooked through, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 627968,
      "primary_message": "Meanwhile, add mayo to the bowl with the reserved marinade and whisk to combine the ginger sauce.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 627969,
      "primary_message": "To serve, divide broccoli, pickled veggies, and salmon between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
