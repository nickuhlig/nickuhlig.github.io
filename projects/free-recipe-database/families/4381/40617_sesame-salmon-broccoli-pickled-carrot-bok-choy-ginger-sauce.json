  "instructions": [
    {
      "id": 627922,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 627923,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n2 baby bok choy\n1 medium carrot\n½ small bunch green onions (scallions)\n1 (1 inch) piece ginger root"
    },
    {
      "id": 627924,
      "primary_message": "Separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 627925,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until broccoli is golden brown and tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 627926,
      "primary_message": "Meanwhile, place vinegar, honey, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "3 tbsp rice vinegar\n2 tsp honey\n1 tsp salt"
    },
    {
      "id": 627927,
      "primary_message": "Trim and slice bok choy crosswise into thin (shred-like) strips. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 627928,
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 627929,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, stir to combine the pickled veggies, and set aside.",
      "secondary_message": null
    },
    {
      "id": 627930,
      "primary_message": "Peel and mince ginger. Place in a small bowl along with soy sauce, vinegar, honey, and chili-garlic sauce, then whisk to combine the marinade.",
      "secondary_message": "1 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp honey\n1 tsp chili-garlic sauce"
    },
    {
      "id": 627931,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end (or corner) firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin.",
      "secondary_message": "¾ lb salmon fillet"
    },
    {
      "id": 627932,
      "primary_message": "Cut the salmon into 1-inch cubes. Place in another medium bowl, along with half of the marinade, and stir to coat. (Reserve remaining marinade for the sauce.)",
      "secondary_message": null
    },
    {
      "id": 627933,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 627934,
      "primary_message": "While the skillet heats up, add sesame seeds to the bowl with the salmon, and stir once more to coat.",
      "secondary_message": "¼ cup sesame seeds"
    },
    {
      "id": 627935,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon (leaving any excess marinade in the bowl) and cook, turning occasionally, until cooked through, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 627936,
      "primary_message": "Meanwhile, add mayo to the bowl with the reserved marinade and whisk to combine the ginger sauce.",
      "secondary_message": "2 tbsp mayonnaise"
    },
    {
      "id": 627937,
      "primary_message": "To serve, divide broccoli, pickled veggies, and salmon between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
