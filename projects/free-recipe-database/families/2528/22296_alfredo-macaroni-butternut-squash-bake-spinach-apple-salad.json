  "instructions": [
    {
      "id": 373160,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 373161,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add butternut squash, pasta, and salt; stir for a few seconds. Cook until pasta reaches desired firmness, 8-10 minutes.",
      "secondary_message": "6 cup frozen butternut squash, pieces\n15 oz macaroni (elbow) pasta\n1 ½ tsp salt"
    },
    {
      "id": 373162,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 Gala apples\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 373163,
      "primary_message": "Quarter, core, and thinly slice apples. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 373164,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the apple and set aside. ",
      "secondary_message": null
    },
    {
      "id": 373165,
      "primary_message": "When the pasta and butternut squash are done, drain and divide between two large baking dishes. ",
      "secondary_message": null
    },
    {
      "id": 373166,
      "primary_message": "Add Alfredo sauce and spices to the baking dishes with the pasta and butternut squash. Stir to combine. ",
      "secondary_message": "1 ½ (16 oz) jars alfredo sauce\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 373167,
      "primary_message": "Place dishes in the oven and bake until sauce is warmed through and tops are golden, 10-12 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 373168,
      "primary_message": "Just before serving, add spinach, pumpkin seeds, and vinaigrette to the bowl with the apple and cucumber. Toss to combine the salad. ",
      "secondary_message": "⅓ cup pumpkin seeds\n⅓ cup French vinaigrette"
    },
    {
      "id": 373169,
      "primary_message": "To serve, divide pasta bake and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
