  "instructions": [
    {
      "id": 373140,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 373141,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add butternut squash, pasta, and salt; stir for a few seconds. Cook until pasta reaches desired firmness, 8-10 minutes.",
      "secondary_message": "2 cup frozen butternut squash, pieces\n5 oz macaroni (elbow) pasta\n½ tsp salt"
    },
    {
      "id": 373142,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 Gala apple\n½ English cucumber\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 373143,
      "primary_message": "Quarter, core, and thinly slice apple. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 373144,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the apple and set aside. ",
      "secondary_message": null
    },
    {
      "id": 373145,
      "primary_message": "When the pasta and butternut squash are done, drain and transfer to a baking dish. ",
      "secondary_message": null
    },
    {
      "id": 373146,
      "primary_message": "Add Alfredo sauce and spices to the baking dish with the pasta and butternut squash. Stir to combine. ",
      "secondary_message": "½ (16 oz) jar alfredo sauce\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 373147,
      "primary_message": "Place dish in the oven and bake until sauce is warmed through and the top is golden, about 10 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 373148,
      "primary_message": "Just before serving, add spinach, pumpkin seeds, and vinaigrette to the bowl with the apple and cucumber. Toss to combine the salad. ",
      "secondary_message": "⅛ cup pumpkin seeds\n2 tbsp French vinaigrette"
    },
    {
      "id": 373149,
      "primary_message": "To serve, divide pasta bake and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
