  "instructions": [
    {
      "id": 426622,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 426623,
      "primary_message": "Wash, dry, and trim squash, then halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 medium spaghetti squash\n1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 426624,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 426625,
      "primary_message": "Meanwhile, place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and place in a small baking dish. ",
      "secondary_message": "½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 426626,
      "primary_message": "Wash and dry basil. Using a clean cutting board, pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add half to the baking dish with the chicken. (Reserve remaining basil for serving.)",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 426627,
      "primary_message": "Pour marinara sauce over the chicken, season with garlic powder, then stir to combine.",
      "secondary_message": "½ (24 oz) jar marinara sauce\n¼ tsp garlic powder"
    },
    {
      "id": 426628,
      "primary_message": "Add baking dish to the oven and bake until chicken and sauce are warmed through, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 426629,
      "primary_message": "When the squash is done, remove from oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 426630,
      "primary_message": "While the squash cools, remove chicken from the oven and sprinkle with cheese. Return baking dish to the oven and continue to bake until cheese is melted, about 5 minutes. Remove from oven.",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    },
    {
      "id": 426631,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 426632,
      "primary_message": "To serve, divide squash and \"chicken Parmesan\" between plates or bowls; top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
