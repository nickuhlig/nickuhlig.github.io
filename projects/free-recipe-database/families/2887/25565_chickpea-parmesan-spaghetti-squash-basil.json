  "instructions": [
    {
      "id": 426666,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 426667,
      "primary_message": "Wash, dry, and trim each squash, then halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "2 medium spaghetti squash\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426668,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 426669,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Transfer to a baking dish. ",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 426670,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add half to the baking dish with the chickpeas. (Reserve remaining basil for serving.)",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 426671,
      "primary_message": "Pour marinara sauce over the chickpeas, season with garlic powder, then stir to combine. ",
      "secondary_message": "1 (24 oz) jar marinara sauce\n½ tsp garlic powder"
    },
    {
      "id": 426672,
      "primary_message": "Add baking dish to the oven and bake until chickpeas are tender and sauce is warmed through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 426673,
      "primary_message": "When the squash is done, remove from oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 426674,
      "primary_message": "While the squash cools, remove chickpeas from the oven and sprinkle with cheese. Return baking dish to the oven and continue to bake until cheese is melted, about 5 minutes. Remove from oven.",
      "secondary_message": "1 cup Parmesan cheese, shredded"
    },
    {
      "id": 426675,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 426676,
      "primary_message": "To serve, divide squash and \"chickpea Parmesan\" between plates or bowls; top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
