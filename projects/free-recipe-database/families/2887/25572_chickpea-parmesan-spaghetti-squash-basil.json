  "instructions": [
    {
      "id": 426743,
      "primary_message": "Preheat oven to 260°C (500°F) and place oven racks in the upper, middle, and lower positions. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 426744,
      "primary_message": "Wash, dry, and trim each squash, then halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "3 medium spaghetti squash\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 426745,
      "primary_message": "Place baking sheets in the upper and middle racks of the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 426746,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Transfer to a large baking dish. ",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 426747,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add half to the baking dish with the chickpeas. (Reserve remaining basil for serving.)",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 426748,
      "primary_message": "Pour marinara sauce over the chickpeas, season with garlic powder, then stir to combine. ",
      "secondary_message": "1 ½ (680 g) jars marinara sauce\n¾ tsp garlic powder"
    },
    {
      "id": 426749,
      "primary_message": "Place baking dish on the lower rack of the oven and bake until chickpeas are tender and sauce is warmed through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 426750,
      "primary_message": "When the squash is done, remove from oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 426751,
      "primary_message": "While the squash cools, remove chickpeas from the oven and sprinkle with cheese. Return baking dish to the oven and continue to bake until cheese is melted, 6-7 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups Parmesan cheese, shredded"
    },
    {
      "id": 426752,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 426753,
      "primary_message": "To serve, divide squash and \"chickpea Parmesan\" between plates or bowls; top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
