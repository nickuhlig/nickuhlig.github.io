  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and halve strawberries. Place in the medium compartment of the bento box.",
      "secondary_message": "¼ (16 oz) pkg strawberries"
    },
    {
      "primary_message": "Place pretzels and hummus each in their own small compartments of the bento box.",
      "secondary_message": "1 oz mini pretzel\n3 tbsp hummus"
    },
    {
      "primary_message": "Wash, dry, and chop chives into small pieces. Place in a small bowl.",
      "secondary_message": "¼ small pkg chives"
    },
    {
      "primary_message": "Roughly chop eggs. Add to the bowl along with mayo, relish, Dijon, salt, and pepper. Using a fork, mash and combine the egg salad. ",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp sweet pickle relish\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Spread egg salad over one slice of bread. Wash, dry, and layer lettuce over the egg salad. Close with the second slice of bread, then cut in half. Place sandwich in the large compartment of the bento box.",
      "secondary_message": "2 slice white bread\n1 oz baby red butter lettuce"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
