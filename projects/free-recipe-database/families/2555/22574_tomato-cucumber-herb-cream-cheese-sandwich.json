  "instructions": [
    {
      "id": 375292,
      "primary_message": "Cut cream cheese into small pieces. Place in a small bowl.",
      "secondary_message": "⅔ (227 g) block cream cheese"
    },
    {
      "id": 375293,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg chives\n1 English cucumber\n2 tomatoes"
    },
    {
      "id": 375294,
      "primary_message": "Chop chives into small pieces. Add to the bowl with the cream cheese along with dill and pepper. Using the back of a spoon, mash and combine the herb cream cheese. Set aside.",
      "secondary_message": "¼ tsp dill, dried\n⅛ tsp black pepper"
    },
    {
      "id": 375295,
      "primary_message": "Trim, peel, and slice cucumber crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 375296,
      "primary_message": "Slice tomatoes into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 375297,
      "primary_message": "Place bread on a flat surface. Divide the herb cream cheese between the slices and spread out in an even layer. Layer half of the slices with cucumber and tomato, then season with salt. Close sandwiches with remaining slices of bread.",
      "secondary_message": "8 slices whole grain bread\n⅛ tsp salt"
    },
    {
      "id": 375298,
      "primary_message": "To serve, slice sandwiches in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
