  "instructions": [
    {
      "id": 624293,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n1 ½ limes\n1 ½ small pkgs grape tomatoes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 624294,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 624295,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 624296,
      "primary_message": "While the skillet heats up, drain and rinse beans. Add to the bowl with the bell pepper.",
      "secondary_message": "3 (398 ml) cans pinto beans"
    },
    {
      "id": 624297,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, beans, and spices; cook, stirring occasionally, until bell pepper is tender and beans are warmed through, 5-6 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp chili powder\n¾ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 624298,
      "primary_message": "Meanwhile, juice limes into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 624299,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with yogurt, maple syrup, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup plain Greek yogurt\n1 tbsp pure maple syrup\n1 tbsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 624300,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 624301,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide bell pepper-bean filling between them, arranging on one half of each tortilla. Top with cheese and fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 624302,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 624303,
      "primary_message": "Meanwhile, halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 624304,
      "primary_message": "Cut or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 624305,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
