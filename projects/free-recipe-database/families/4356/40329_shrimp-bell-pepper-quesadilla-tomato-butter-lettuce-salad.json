  "instructions": [
    {
      "id": 624225,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n½ lime\n½ small pkg grape tomatoes\n½ head butter (Boston) lettuce"
    },
    {
      "id": 624226,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 624227,
      "primary_message": "Roughly chop shrimp and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 624228,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 624229,
      "primary_message": "While the skillet heats up, using a clean cutting board, trim, seed, and small dice bell pepper. Add to the bowl with the shrimp.",
      "secondary_message": null
    },
    {
      "id": 624230,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, bell pepper, and spices; cook, stirring occasionally, until bell pepper is tender and shrimp are cooked through, 3-4 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp chili powder\n¼ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 624231,
      "primary_message": "Meanwhile, juice lime into a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 624232,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with yogurt, maple syrup, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n⅛ cup plain Greek yogurt\n1 tsp pure maple syrup\n1 tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 624233,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 624234,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide shrimp-bell pepper filling between them, arranging on one half of each tortilla. Top with cheese and fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 624235,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Place assembled quesadillas in the skillet and cook, flipping halfway through, until tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 624236,
      "primary_message": "Meanwhile, halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 624237,
      "primary_message": "Cut or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 624238,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
