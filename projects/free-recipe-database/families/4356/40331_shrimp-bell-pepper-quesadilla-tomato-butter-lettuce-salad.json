  "instructions": [
    {
      "id": 624253,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n1 ½ limes\n1 ½ small pkgs grape tomatoes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 624254,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 624255,
      "primary_message": "Roughly chop shrimp and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 624256,
      "primary_message": "Using a clean cutting board, trim, seed, and small dice bell peppers. Add to the bowl with the shrimp.",
      "secondary_message": null
    },
    {
      "id": 624257,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 624258,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, bell pepper, and spices; cook, stirring occasionally, until bell pepper is tender and shrimp are cooked through, 5-6 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp chili powder\n¾ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 624259,
      "primary_message": "Meanwhile, juice limes into a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 624260,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with yogurt, maple syrup, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup plain Greek yogurt\n1 tbsp pure maple syrup\n1 tbsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 624261,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 624262,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide shrimp-bell pepper filling between them, arranging on one half of each tortilla. Top with cheese and fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 624263,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 624264,
      "primary_message": "Meanwhile, halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 624265,
      "primary_message": "Cut or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 624266,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
