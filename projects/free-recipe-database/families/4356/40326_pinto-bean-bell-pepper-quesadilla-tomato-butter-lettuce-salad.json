  "instructions": [
    {
      "id": 624186,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n½ lime\n½ pint grape tomatoes\n½ head butter (Boston) lettuce"
    },
    {
      "id": 624187,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 624188,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 624189,
      "primary_message": "While the skillet heats up, drain and rinse beans. Add to the bowl with the bell pepper.",
      "secondary_message": "1 (15 oz) can pinto beans"
    },
    {
      "id": 624190,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, beans, and spices; cook, stirring occasionally, until bell pepper is tender and beans are warmed through, 3-4 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp chili powder\n¼ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 624191,
      "primary_message": "Meanwhile, juice lime into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 624192,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with yogurt, maple syrup, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n⅛ cup plain Greek yogurt\n1 tsp pure maple syrup\n1 tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 624193,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 624194,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide bell pepper-bean filling between them, arranging on one half of each tortilla. Top with cheese and fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 624195,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Place assembled quesadillas in the skillet and cook, flipping halfway through, until tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 624196,
      "primary_message": "Meanwhile, halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 624197,
      "primary_message": "Cut or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 624198,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
