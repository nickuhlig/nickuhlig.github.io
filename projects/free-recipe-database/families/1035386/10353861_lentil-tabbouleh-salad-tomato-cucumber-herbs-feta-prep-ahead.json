  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "1 English cucumber\n1 small pkg fresh mint\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "Juice lemons into a large bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince shallots. Add to the bowl with the lemon juice, along with oil and spices, then whisk to combine the dressing.\n\n",
      "secondary_message": "¼ cup extra virgin olive oil\n½ tsp garlic powder\n½ tsp cumin, ground\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Small dice tomatoes. Trim and small dice cucumber. Add both to the bowl with the dressing.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Pick mint and parsley leaves off the stems; discard stems and roughly chop the leaves. Add herbs to the bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Drain and rinse lentils. Add to the bowl, along with feta, and stir to combine the salad.\n\n",
      "secondary_message": "3 (255 g) can lentils\n2 (113 g) pkg crumbled feta cheese"
    },
    {
      "primary_message": "Divide salad between containers, cover, and refrigerate until ready to eat. Enjoy cold or at room temperature.",
      "secondary_message": null
    }
  ],
