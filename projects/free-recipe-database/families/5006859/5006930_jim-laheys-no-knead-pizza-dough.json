  "ingredients": [
    {
      "ingredient_id": 116,
      "name": "all-purpose flour, plus more for shaping the dough",
      "quantity": "500 g"
    },
    {
      "ingredient_id": 1125,
      "name": "active dry yeast",
      "quantity": "1 g"
    },
    {
      "ingredient_id": 1508,
      "name": "fine sea salt",
      "quantity": "16 g"
    },
    {
      "ingredient_id": 359,
      "name": "water",
      "quantity": "350 g"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, thoroughly blend flour, yeast, and salt. Add water and, with a wooden spoon or your hands, mix thoroughly.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cover bowl with plastic wrap or a kitchen towel and allow it to rise at room temperature (about 22°C/22°C) for 18 hours or until it has more than doubled. It will take longer in a chilly room and less time in a very warm one.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Flour a work surface and scrape out the dough. Divide it into 4 equal parts and shape them: For each portion, start with the right side of the dough and pull it toward the center; then do the same with the left, then the top, then the bottom. (The order doesn’t actually matter; what you want is four folds.) Shape each portion into a round and turn seam side down. Mold dough into a neat circular mound. The mounds should not be sticky; if they are, dust with more flour.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "If you don’t intend to use the dough right away, wrap the balls individually in plastic and refrigerate for up to 3 days. Return to room temperature by leaving them out on the counter, covered in a damp cloth, for 2 to 3 hours before needed.",
      "secondary_message": null
    }
  ],
