  "instructions": [
    {
      "id": 44872,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb sweet potatoes\n½ lb green beans"
    },
    {
      "id": 44879,
      "primary_message": "Peel and cut the sweet potatoes into 1-inch cubes; transfer to a small saucepan.",
      "secondary_message": null
    },
    {
      "id": 44880,
      "primary_message": "Add water to the saucepan, covering the potatoes, and bring to a boil. Cook until they are tender when pierced with a fork, 8 to 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 44877,
      "primary_message": "Trim and discard the ends of the green beans; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 44878,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 44873,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 44874,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "¾ lb ribeye steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 44875,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 44876,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 44884,
      "primary_message": "Once the steak has been transferred, add the green beans to the skillet and season with salt and pepper. Cook, tossing frequently, until they are bright green and tender-crisp, 3 to 4 minutes. Once done, remove the skillet from the heat.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 45253,
      "primary_message": "Once the potatoes are tender, scoop out ¼ cup of the water and set aside, then drain the potatoes in a colander and return them back to the saucepan.",
      "secondary_message": null
    },
    {
      "id": 44882,
      "primary_message": "Add the reserved cooking water, minced garlic, butter, salt, and pepper to the potatoes; mash with a potato masher (or a fork) until smooth.",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 44883,
      "primary_message": "To serve, divide the steak, sweet potato mash, and green beans between plates. Enjoy!",
      "secondary_message": null
    }
  ],
