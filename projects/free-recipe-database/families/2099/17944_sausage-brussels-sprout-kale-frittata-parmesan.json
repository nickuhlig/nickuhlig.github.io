  "instructions": [
    {
      "id": 299783,
      "primary_message": "Wash, dry, trim, and thinly slice Brussels sprouts; place in a large bowl.",
      "secondary_message": "0.68 kg Brussels sprouts"
    },
    {
      "id": 299784,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 299785,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add sausage and cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n0.68 kg ground pork sausage"
    },
    {
      "id": 299786,
      "primary_message": "Meanwhile, peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the Brussels sprouts.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 299787,
      "primary_message": "Add veggies and spices to the skillet. Cook, stirring occasionally, until the sprouts are tender and sausage is cooked through, about 5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 ½ tsp sage, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp thyme, dried\n¾ tsp cinnamon, ground"
    },
    {
      "id": 299788,
      "primary_message": "While the sprouts are cooking, wash and dry kale; fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces. ",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 299789,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until the kale is tender, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 299790,
      "primary_message": "While the kale is cooking, place eggs, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "18 eggs\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 299791,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 299792,
      "primary_message": "Reduce heat to medium-low and pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 7-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 299793,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 299794,
      "primary_message": "Sprinkle Parmesan over the frittata. Place in the oven and broil until top is set and cheese is melted, about 4 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 299795,
      "primary_message": "To serve, cut frittata into wedges, divide between plates, and enjoy!",
      "secondary_message": null
    }
  ],
