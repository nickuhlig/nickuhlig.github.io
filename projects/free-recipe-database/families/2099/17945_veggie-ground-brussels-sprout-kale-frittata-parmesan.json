  "instructions": [
    {
      "id": 299796,
      "primary_message": "Wash, dry, trim, and thinly slice Brussels sprouts; place in a medium bowl.",
      "secondary_message": "0.23 kg Brussels sprouts"
    },
    {
      "id": 299797,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 299798,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n227 g veggie ground, plant based"
    },
    {
      "id": 299799,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the Brussels sprouts.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 299800,
      "primary_message": "Add veggies and spices to the skillet. Cook, stirring occasionally, until the sprouts are tender and veggie ground is warmed through, about 4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "½ tsp sage, dried\n½ tsp salt\n¼ tsp black pepper\n¼ tsp thyme, dried\n¼ tsp cinnamon, ground"
    },
    {
      "id": 299801,
      "primary_message": "While the sprouts are cooking, wash and dry kale; fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces. ",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 299802,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until the kale is tender, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 299803,
      "primary_message": "While the kale is cooking, place eggs, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "6 eggs\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 299804,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 299805,
      "primary_message": "Reduce heat to medium-low and pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 299806,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 299807,
      "primary_message": "Sprinkle Parmesan over the frittata. Place in the oven and broil until top is set and cheese is melted, 3-4 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 299808,
      "primary_message": "To serve, cut frittata into wedges, divide between plates, and enjoy!",
      "secondary_message": null
    }
  ],
