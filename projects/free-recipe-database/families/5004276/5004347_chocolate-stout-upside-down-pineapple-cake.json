  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Melt the unsalted butter. Bring the buttermilk to room temperature. Lightly beat the eggs and bring them to room temperature.",
      "secondary_message": "113 g unsalted butter\n½ cup buttermilk\n3 large eggs"
    },
    {
      "id": 1,
      "primary_message": "For the Pineapple Layer: Adjust oven rack to middle position and preheat oven to 175°C (350°F). Trim pineapple into 18 spears, 4- by 1.5-cm. If using fresh pineapple spears, trim them to approximately that size.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour melted butter into a 13- by 23-cm baking pan tilting to distribute evenly. With pastry brush, grease sides of pan with some of the butter. Sprinkle butter evenly with brown sugar, then, arrange pineapple spears in 2 parallel rows.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Chocolate-Stout Cake: Bring stout to boil in small saucepan over medium-high heat, stirring occasionally to prevent bubbling over. Cook until reduced to 1 cup, 10 to 12 minutes. Reduce heat to medium and stir in butter and cocoa powder. Cook, stirring, until mixture is homogenous.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Whisk flour, brown sugar, baking powder, and salt together in large bowl. Whisk stout mixture into flour mixture.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Stir baking soda into buttermilk until completely dissolved and whisk into batter. Whisk in eggs and vanilla. Scrape batter into prepared pan, spreading evenly over pineapple. Bake until tester inserted in center of cake comes out clean, about 35 to 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Transfer cake to cooling rack and cool 10 minutes, then, invert directly onto rack and cool to room temperature, about 1 hour. Serve.",
      "secondary_message": null
    }
  ],
