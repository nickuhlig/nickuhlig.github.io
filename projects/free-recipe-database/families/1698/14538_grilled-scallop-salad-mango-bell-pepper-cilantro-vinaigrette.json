  "instructions": [
    {
      "id": 240860,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 240861,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch cilantro\n1 mango\n1 red bell pepper\n1 head butter (Boston) lettuce\n½ avocado"
    },
    {
      "id": 240862,
      "primary_message": "Juice lime into a blender.",
      "secondary_message": null
    },
    {
      "id": 240863,
      "primary_message": "Shave cilantro leaves off the stems; discard stems. Add leaves to the blender with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 240864,
      "primary_message": "Peel and roughly chop garlic. Add to the blender along with oil, honey, salt, and pepper. Blend on high until smooth; set dressing aside.",
      "secondary_message": "1 clove garlic\n1 ½ tbsp extra virgin olive oil\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 240865,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 240866,
      "primary_message": "Trim, seed, and cut bell pepper into thin matchsticks. Add to the bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 240867,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 240868,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 240869,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 240870,
      "primary_message": "Meanwhile, pat scallops dry with paper towels and thread onto the skewers so that they lie flat; place on a plate. Drizzle with oil and season with salt and pepper on both sides. (Alternatively, you can cook the scallops directly on the grill pan without using skewers.)",
      "secondary_message": "⅓ kg sea scallops\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 240871,
      "primary_message": "Once the grill pan is hot, add skewers and cook, flipping once, until scallops are lightly charred and cooked through, about 5 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 240872,
      "primary_message": "To serve, divide salad between plates; top with cashews and grilled scallops. Drizzle with dressing and enjoy!",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    }
  ],
