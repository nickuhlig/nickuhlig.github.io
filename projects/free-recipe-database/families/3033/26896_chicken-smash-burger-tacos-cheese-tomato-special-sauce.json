  "instructions": [
    {
      "id": 465740,
      "primary_message": "Place mayo, ketchup, Dijon, and cayenne in a small bowl. Stir to combine the special sauce and set aside.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp ketchup\n1 tsp Dijon mustard\n1 pinch cayenne pepper"
    },
    {
      "id": 465741,
      "primary_message": "Place vinegar, oil, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp red wine vinegar\n1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 465742,
      "primary_message": "Peel and slice shallot crosswise into thin rounds. Add to the bowl with the dressing, stir to combine, and set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 465743,
      "primary_message": "Place chicken in another medium bowl along with oil, Worcestershire, and spices. Mix with your hands until well combined.",
      "secondary_message": "½ lb ground chicken\n1 tsp extra virgin olive oil\n1 tsp Worcestershire sauce\n1 tsp garlic powder\n½ tsp paprika\n¼ tsp oregano, dried\n¼ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 465744,
      "primary_message": "Arrange tortillas on a flat surface, then divide the chicken mixture between them (about 1 ½ tablespoons per tortilla). Using your hands, spread the chicken mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 465745,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 465746,
      "primary_message": "While the skillet heats up, coarsely grate cheese.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 465747,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tacos, meat-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the chicken is cooked through, about 2 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 465748,
      "primary_message": "Flip tacos, chicken-side up, and sprinkle with cheese. Continue to cook until cheese has melted, 1 minute more. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 465749,
      "primary_message": "Meanwhile, wash, dry, and medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 465750,
      "primary_message": "Wash, dry, and halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl and toss to combine the salad.",
      "secondary_message": "½ head romaine lettuce"
    },
    {
      "id": 465751,
      "primary_message": "Divide tacos between plates. Top each with a small handful of salad and drizzle with special sauce. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
