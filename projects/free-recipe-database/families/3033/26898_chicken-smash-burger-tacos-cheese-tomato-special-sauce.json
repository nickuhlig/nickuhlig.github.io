  "instructions": [
    {
      "id": 465764,
      "primary_message": "Place mayo, ketchup, Dijon, and cayenne in a small bowl. Stir to combine the special sauce and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp ketchup\n1 tbsp Dijon mustard\n3 pinch cayenne pepper"
    },
    {
      "id": 465765,
      "primary_message": "Place vinegar, oil, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp red wine vinegar\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 465766,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the dressing, stir to combine, and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 465767,
      "primary_message": "Place chicken in another large bowl along with oil, Worcestershire, and spices. Mix with your hands until well combined.",
      "secondary_message": "1 ½ lb ground chicken\n1 tbsp extra virgin olive oil\n1 tbsp Worcestershire sauce\n1 tbsp garlic powder\n1 ½ tsp paprika\n¾ tsp oregano, dried\n¾ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 465768,
      "primary_message": "Arrange tortillas on a flat surface, then divide the chicken mixture between them (about 1 ½ tablespoons per tortilla). Using your hands, spread the chicken mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 465769,
      "primary_message": "Preheat two large skillets over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 465770,
      "primary_message": "While the skillets heat up, coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 465771,
      "primary_message": "Once the skillets are hot, add oil and swirl to coat the bottom. Working in batches, add tacos, meat-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the chicken is cooked through, about 2 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 465772,
      "primary_message": "Flip tacos, chicken-side up, and sprinkle with cheese. Continue to cook until cheese has melted, 1 minute more. Transfer to a platter. ",
      "secondary_message": null
    },
    {
      "id": 465773,
      "primary_message": "Meanwhile, wash, dry, and medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": "6 tomatoes"
    },
    {
      "id": 465774,
      "primary_message": "Wash, dry, and halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl and toss to combine the salad.",
      "secondary_message": "1 ½ heads romaine lettuce"
    },
    {
      "id": 465775,
      "primary_message": "Divide tacos between plates. Top each with a small handful of salad and drizzle with special sauce. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
