  "instructions": [
    {
      "id": 425926,
      "primary_message": "Medium dice polenta; place in a medium saucepan along with broth, salt, and pepper. Bring to a simmer over medium-high heat.",
      "secondary_message": "1 (18 oz) tube polenta, pre-cooked\n8 fl oz (1 cup) chicken or vegetable broth\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 425927,
      "primary_message": "Once the broth is simmering, reduce heat to medium. Using a potato masher, mash the polenta until smooth; continue to cook, stirring occasionally, until heated through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 425928,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell pepper; small dice. Place in a medium bowl.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 425929,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Add to the bowl with the bell pepper.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 425930,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl along with the carrots.",
      "secondary_message": "½ medium yellow onion\n½ (10 oz) bag shredded carrots"
    },
    {
      "id": 425931,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 425932,
      "primary_message": "While the skillet heats up, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 425933,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, beans, and spices to the skillet; cook, stirring occasionally, until veggies soften and beans are tender, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 425934,
      "primary_message": "Meanwhile, add Parmesan to the pan with the polenta and stir to combine.",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    },
    {
      "id": 425935,
      "primary_message": "To serve, divide polenta between plates or bowls; top with bean and veggie skillet. Enjoy!",
      "secondary_message": null
    }
  ],
