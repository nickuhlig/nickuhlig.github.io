  "instructions": [
    {
      "id": 425916,
      "primary_message": "Medium dice polenta; place in a large pot along with broth, salt, and pepper. Bring to a simmer over medium-high heat.",
      "secondary_message": "3 (18 oz) tubes polenta, pre-cooked\n24 fl oz (3 cups) chicken or vegetable broth\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 425917,
      "primary_message": "Once the broth is simmering, reduce heat to medium. Using a potato masher, mash the polenta until smooth; continue to cook, stirring occasionally, until heated through, 3-4 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 425918,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; small dice. Place in a large bowl.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 425919,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Add to the bowl with the bell peppers.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 425920,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl along with the carrots.",
      "secondary_message": "1 ½ medium yellow onions\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 425921,
      "primary_message": "Medium dice ham. Add to the bowl.",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 425922,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 425923,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, ham, and spices to the skillet; cook, stirring occasionally, until veggies soften and ham is warmed through, 5-6 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 425924,
      "primary_message": "Meanwhile, add Parmesan to the pot with the polenta and stir to combine.",
      "secondary_message": "1 ½ cups Parmesan cheese, shredded"
    },
    {
      "id": 425925,
      "primary_message": "To serve, divide polenta between plates or bowls; top with ham and veggie skillet. Enjoy!",
      "secondary_message": null
    }
  ],
