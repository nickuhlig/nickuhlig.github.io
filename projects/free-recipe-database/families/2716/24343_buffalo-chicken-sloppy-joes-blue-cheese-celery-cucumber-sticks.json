  "instructions": [
    {
      "id": 394803,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 394804,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 394805,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, chicken, carrots, and salt; cook, breaking the meat apart with a spoon, until the carrots are softened and chicken is browned and crumbly, 5-6 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n0.23 kg ground chicken\n½ (283 g) bag shredded carrots\n¼ tsp salt"
    },
    {
      "id": 394806,
      "primary_message": "Meanwhile, wash, dry, trim, and halve celery lengthwise; cut crosswise into 3-inch long pieces. Place on a plate.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 394807,
      "primary_message": "Wash, dry, trim, and quarter cucumber lengthwise; cut crosswise into 3-inch long pieces. Add to the plate with the celery and set aside.",
      "secondary_message": "½ English cucumber"
    },
    {
      "id": 394808,
      "primary_message": "When the chicken is done, add tomato sauce and hot sauce to the skillet. Stir to combine and continue to cook until heated through, about 1 minute. Remove from heat.",
      "secondary_message": "1 (213 ml) can tomato sauce\n2 tbsp hot sauce"
    },
    {
      "id": 394809,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 394810,
      "primary_message": "Place bottom half of each bun on a plate. Top with saucy chicken and blue cheese, then close with the top half of each bun. Serve with veggies and dressing on the side. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese\n3 tbsp blue cheese dressing"
    }
  ],
