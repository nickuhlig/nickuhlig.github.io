  "instructions": [
    {
      "id": 394819,
      "primary_message": "Peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 394820,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 394821,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, chicken, carrots, and salt; cook, breaking the meat apart with a spoon, until the carrots are softened and chicken is browned and crumbly, 6-7 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n0.68 kg ground chicken\n1 ½ (283 g) bags shredded carrots\n¾ tsp salt"
    },
    {
      "id": 394822,
      "primary_message": "Meanwhile, wash, dry, trim, and halve celery lengthwise; cut crosswise into 3-inch long pieces. Place on a large plate.",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 394823,
      "primary_message": "Wash, dry, trim, and quarter cucumbers lengthwise; cut crosswise into 3-inch long pieces. Add to the plate with the celery and set aside.",
      "secondary_message": "1 ½ English cucumbers"
    },
    {
      "id": 394824,
      "primary_message": "When the chicken is done, add tomato sauce and hot sauce to the skillet. Stir to combine and continue to cook until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n⅓ cup hot sauce"
    },
    {
      "id": 394825,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 394826,
      "primary_message": "Place bottom half of each bun on a plate. Top with saucy chicken and blue cheese, then close with the top half of each bun. Serve with veggies and dressing on the side. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese\n½ cup blue cheese dressing"
    }
  ],
