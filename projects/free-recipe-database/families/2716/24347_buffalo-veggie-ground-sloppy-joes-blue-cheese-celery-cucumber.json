  "instructions": [
    {
      "id": 394835,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 394836,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 394837,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, carrots, and salt; cook, breaking the veggie ground apart with a spoon, until the carrots are softened and veggie ground is browned and crumbly, 5-6 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n1 (283 g) bag shredded carrots\n½ tsp salt"
    },
    {
      "id": 394838,
      "primary_message": "Meanwhile, wash, dry, trim, and halve celery lengthwise; cut crosswise into 3-inch long pieces. Place on a plate.",
      "secondary_message": "4 sticks celery"
    },
    {
      "id": 394839,
      "primary_message": "Wash, dry, trim, and quarter cucumber lengthwise; cut crosswise into 3-inch long pieces. Add to the plate with the celery and set aside.",
      "secondary_message": "1 English cucumber"
    },
    {
      "id": 394840,
      "primary_message": "When the veggie ground is done, add tomato sauce and hot sauce to the skillet. Stir to combine and continue to cook until heated through, about 1 minute. Remove from heat.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n¼ cup hot sauce"
    },
    {
      "id": 394841,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 394842,
      "primary_message": "Place bottom half of each bun on a plate. Top with saucy veggie ground and blue cheese, then close with the top half of each bun. Serve with veggies and dressing on the side. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled blue cheese\n⅓ cup blue cheese dressing"
    }
  ],
