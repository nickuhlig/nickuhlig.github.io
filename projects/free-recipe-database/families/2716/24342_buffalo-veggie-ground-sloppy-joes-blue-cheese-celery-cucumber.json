  "instructions": [
    {
      "id": 394795,
      "primary_message": "Peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 394796,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 394797,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, carrots, and salt; cook, breaking the veggie ground apart with a spoon, until the carrots are softened and veggie ground is browned and crumbly, 6-7 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 ½ (10 oz) bags shredded carrots\n¾ tsp salt"
    },
    {
      "id": 394798,
      "primary_message": "Meanwhile, wash, dry, trim, and halve celery lengthwise; cut crosswise into 3-inch long pieces. Place on a large plate.",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 394799,
      "primary_message": "Wash, dry, trim, and quarter cucumbers lengthwise; cut crosswise into 3-inch long pieces. Add to the plate with the celery and set aside.",
      "secondary_message": "1 ½ English cucumbers"
    },
    {
      "id": 394800,
      "primary_message": "When the veggie ground is done, add tomato sauce and hot sauce to the skillet. Stir to combine and continue to cook until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n⅓ cup hot sauce"
    },
    {
      "id": 394801,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 394802,
      "primary_message": "Place bottom half of each bun on a plate. Top with saucy veggie ground and blue cheese, then close with the top half of each bun. Serve with veggies and dressing on the side. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese\n½ cup blue cheese dressing"
    }
  ],
