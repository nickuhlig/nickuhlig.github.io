  "instructions": [
    {
      "id": 118717,
      "primary_message": "Wash and dry all of the mushrooms. ",
      "secondary_message": "0.68 kg white mushrooms\n0.68 kg cremini mushrooms\n3 caps portobello mushrooms"
    },
    {
      "id": 118718,
      "primary_message": "Remove the stems of the portobello mushrooms; scrape out the gills using a spoon. Dice into 1-inch cubes. ",
      "secondary_message": null
    },
    {
      "id": 118719,
      "primary_message": "Slice remaining mushrooms and set them aside with the portobello mushrooms.",
      "secondary_message": null
    },
    {
      "id": 118720,
      "primary_message": "Heat olive oil in a large pot over medium heat. Trim, peel, and finely dice the shallot. Add to the pot, stirring regularly and cook until the shallots soften, 2-3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 shallots"
    },
    {
      "id": 118721,
      "primary_message": "Once shallots are soft add mushrooms to pot and continue to stir.",
      "secondary_message": null
    },
    {
      "id": 118722,
      "primary_message": "Peel and mince garlic. Add to the pot. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 118723,
      "primary_message": "Season mushroom mixture with thyme, rosemary, salt, and pepper. Cook, stirring occasionally, until mushrooms are tender and shallots are translucent, 5-6 minutes. ",
      "secondary_message": "½ tsp thyme\n1 ½ tsp rosemary\n1 tbsp salt\n½ tsp black pepper"
    },
    {
      "id": 118724,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to pot. Add broth and bring mixture to a boil.",
      "secondary_message": "3 cups basmati rice\n1065 ml chicken or vegetable broth"
    },
    {
      "id": 118725,
      "primary_message": "Lower heat to medium-low. Cover with a tight-fitting lid and cook without disturbing for 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 118726,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 118727,
      "primary_message": "When rice is cooked, stir in butter and Parmesan cheese until melted. Top with prepared parsley. Serve warm, enjoy!",
      "secondary_message": "170 g Parmesan cheese\n⅓ cup butter, unsalted"
    }
  ],
