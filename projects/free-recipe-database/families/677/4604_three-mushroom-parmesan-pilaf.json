  "instructions": [
    {
      "id": 118692,
      "primary_message": "Heat olive oil in skillet over medium heat. Trim off and discard the ends of the shallots; peel and finely dice the shallot. Add to the skillet, stirring regularly.",
      "secondary_message": "2 shallots\n2 tsp extra virgin olive oil"
    },
    {
      "id": 118693,
      "primary_message": "Wash and dry all of the mushrooms. ",
      "secondary_message": "0.45 kg white mushrooms\n0.45 kg cremini mushrooms\n2 caps portobello mushrooms"
    },
    {
      "id": 118694,
      "primary_message": "Remove the stems of the portobello mushrooms; scrape out the gills using a spoon. Dice into 1-inch cubes and add to the skillet. ",
      "secondary_message": null
    },
    {
      "id": 118695,
      "primary_message": "Slice the remaining mushrooms and add to the skillet.",
      "secondary_message": null
    },
    {
      "id": 118696,
      "primary_message": "Peel and mince garlic. Add to the skillet. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 118697,
      "primary_message": "Season mushroom mixture with thyme, rosemary, salt, and pepper. Cook, stirring occasionally, until mushrooms are tender and shallots are translucent, 5-6 minutes. ",
      "secondary_message": "⅛ tsp thyme\n2 tsp salt\n⅛ tsp black pepper\n1 tsp rosemary"
    },
    {
      "id": 118698,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to skillet. Add broth and bring mixture to a boil.",
      "secondary_message": "2 cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 118699,
      "primary_message": "Lower heat to medium-low. Cover with a tight-fitting lid and cook without disturbing for 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 118700,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 118701,
      "primary_message": "When rice is cooked, stir in butter and Parmesan cheese until melted. Top with prepared parsley. Serve warm, enjoy!",
      "secondary_message": "113 g Parmesan cheese\n¼ cup butter, unsalted"
    }
  ],
