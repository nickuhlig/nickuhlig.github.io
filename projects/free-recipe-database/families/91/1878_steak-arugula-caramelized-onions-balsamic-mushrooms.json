  "instructions": [
    {
      "id": 17267,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 17268,
      "primary_message": "Peel and thinly slice onion into half rings.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 17269,
      "primary_message": "Coat bottom of pan with oil. Add onions and, stirring frequently, cook until softened and starting to brown, about 10 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 17270,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 17271,
      "primary_message": "Wash and slice mushrooms.",
      "secondary_message": "1 lb cremini mushrooms"
    },
    {
      "id": 17272,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "1 ½ lb ribeye steak\nabout ¼ tsp salt\nabout ¼ tsp black pepper"
    },
    {
      "id": 17273,
      "primary_message": "Coat bottom of skillet with oil. Place steak in the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 17274,
      "primary_message": "Add mushrooms to pan with onion. Season with salt and pepper. Stirring occasionally, cook until tender, 5-6 minutes.",
      "secondary_message": "½ tsp salt\r\n¼ tsp black pepper "
    },
    {
      "id": 17275,
      "primary_message": "Wash and dry arugula.",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 17276,
      "primary_message": "Add vinegar to onion and mushrooms. Scrape up browned bits from the bottom of the pan and stir until liquid thickens, 2-3 minutes.",
      "secondary_message": "4 tbsp balsamic vinegar"
    },
    {
      "id": 17277,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": ""
    },
    {
      "id": 17278,
      "primary_message": "To serve, arrange a bed of arugula on a plate, add onion and mushrooms, and top with steak slices. Enjoy!",
      "secondary_message": ""
    }
  ],
