    {
      "primary_message": "Divide Quaker® Oats, milk, and vanilla between your containers of choice.",
      "secondary_message": null
    },
    {
      "primary_message": "Add a layer of blueberries and then a layer of banana slices.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Top with a drizzle of honey and, if desired, chia seeds.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place in refrigerator (40°F or colder) and let steep for at least 8 hours.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Enjoy in the morning (best eaten within 24 hours).\n",
      "secondary_message": null
    }
