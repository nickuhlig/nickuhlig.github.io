  "instructions": [
    {
      "id": 424158,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 424159,
      "primary_message": "Wash, dry, and trim zucchini; use a julienne (or regular) peeler, make noodles. Transfer noodles and mushrooms to a baking sheet pan. Drizzle with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "4 medium zucchini squash\n1 (8 oz) pkg sliced white mushrooms\n1 ½ tbsp extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 424160,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tender, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 424161,
      "primary_message": "Meanwhile, place marinara sauce and cream in a small saucepan. Bring to a simmer over medium heat, stirring occasionally. Once simmering, remove from heat and cover to keep warm.",
      "secondary_message": "½ (24 oz) jar marinara sauce\n4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 424162,
      "primary_message": "To serve, divide zucchini noodles and mushrooms between plates or bowls; top with sauce and Parmesan. Enjoy!",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
