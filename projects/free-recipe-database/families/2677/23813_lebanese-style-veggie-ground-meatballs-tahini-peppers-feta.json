  "instructions": [
    {
      "id": 452720,
      "primary_message": "Preheat oven to 220°C (425°F). ",
      "secondary_message": null
    },
    {
      "id": 452721,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 orange bell peppers\n2 small pkgs fresh mint\n2 lemons"
    },
    {
      "id": 452722,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 452723,
      "primary_message": "Peel, halve, and slice onions lengthwise into thin strips; add to the baking sheet with the peppers. Drizzle veggies with oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "2 medium red onions\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 452724,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are starting to soften, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 452725,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve the other half for serving.)",
      "secondary_message": null
    },
    {
      "id": 452726,
      "primary_message": "Add veggie ground, bread crumbs, and spices to the bowl with the mint; use your hands to combine the veggie ground mixture. Using a tablespoon, form the mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": "454 g veggie ground, plant based\n½ cup panko bread crumbs\n2 tbsp water\n1 ½ tsp cumin, ground\n1 tsp cinnamon, ground\n½ tsp black pepper\n¼ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 452727,
      "primary_message": "When the veggies are soft, remove from the oven. Add meatballs to the baking sheet, nestling them into the veggies. ",
      "secondary_message": null
    },
    {
      "id": 452728,
      "primary_message": "Return baking sheet to the oven and continue to roast until the veggies are golden brown and meatballs are cooked through, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 452729,
      "primary_message": "Meanwhile, juice one lemon into a small bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 452730,
      "primary_message": "Add tahini, water, pepper, and salt to the bowl with the lemon juice. Whisk to combine the sauce.",
      "secondary_message": "¼ cup tahini\n3 tbsp water\n½ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 452731,
      "primary_message": "Divide veggies and meatballs between plates; drizzle meatballs with tahini sauce and top veggies with feta and reserved mint. Serve with lemon wedges for squeezing. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
