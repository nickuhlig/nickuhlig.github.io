  "instructions": [
    {
      "id": 452624,
      "primary_message": "Preheat oven to 425°F. ",
      "secondary_message": null
    },
    {
      "id": 452625,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 orange bell peppers\n3 small pkgs fresh mint\n3 lemons"
    },
    {
      "id": 452626,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 452627,
      "primary_message": "Peel, halve, and slice onions lengthwise into thin strips; add to the baking sheets with the peppers. Drizzle veggies with oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "3 medium red onions\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 452628,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until veggies are starting to soften, 12-14 minutes. ",
      "secondary_message": null
    },
    {
      "id": 452629,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place half in a large bowl. (Reserve the other half for serving.)",
      "secondary_message": null
    },
    {
      "id": 452630,
      "primary_message": "Add beef, bread crumbs, eggs, and spices to the bowl with the mint; use your hands to combine the beef mixture. Using a tablespoon, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "2 ¼ lb lean ground beef\n2 ¼ cup panko bread crumbs\n3 eggs\n2 ½ tsp cumin, ground\n1 ½ tsp cinnamon, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cayenne pepper"
    },
    {
      "id": 452631,
      "primary_message": "When the veggies are soft, remove from the oven. Add meatballs to the baking sheets, nestling them into the veggies. ",
      "secondary_message": null
    },
    {
      "id": 452632,
      "primary_message": "Return baking sheets to the oven and continue to roast until the veggies are golden brown and meatballs are cooked through, 12-14 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 452633,
      "primary_message": "Meanwhile, juice half of the lemons into a small bowl. Cut remaining lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 452634,
      "primary_message": "Add tahini, water, pepper, and salt to the bowl with the lemon juice. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup tahini\n⅓ cup water\n¾ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 452635,
      "primary_message": "Divide veggies and meatballs between plates; drizzle meatballs with tahini sauce and sprinkle veggies with reserved mint. Serve with lemon wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
