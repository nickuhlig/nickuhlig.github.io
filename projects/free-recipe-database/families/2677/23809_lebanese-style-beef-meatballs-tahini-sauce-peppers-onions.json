  "instructions": [
    {
      "id": 452672,
      "primary_message": "Preheat oven to 220°C (425°F). ",
      "secondary_message": null
    },
    {
      "id": 452673,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 orange bell pepper\n1 small pkg fresh mint\n1 lemon"
    },
    {
      "id": 452674,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 452675,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin strips; add to the baking sheet with the peppers. Drizzle veggies with oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 452676,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are starting to soften, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 452677,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve the other half for serving.)",
      "secondary_message": null
    },
    {
      "id": 452678,
      "primary_message": "Add beef, bread crumbs, egg, and spices to the bowl with the mint; use your hands to combine the beef mixture. Using a tablespoon, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "⅓ kg lean ground beef\n¾ cup panko bread crumbs\n1 egg\n¾ tsp cumin, ground\n½ tsp cinnamon, ground\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 452679,
      "primary_message": "When the veggies are soft, remove from the oven. Add meatballs to the baking sheet, nestling them into the veggies. ",
      "secondary_message": null
    },
    {
      "id": 452680,
      "primary_message": "Return baking sheet to the oven and continue to roast until the veggies are golden brown and meatballs are cooked through, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 452681,
      "primary_message": "Meanwhile, juice half of the lemon into a small bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 452682,
      "primary_message": "Add tahini, water, pepper, and salt to the bowl with the lemon juice. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp tahini\n2 tbsp water\n¼ tsp black pepper\n1 pinch salt"
    },
    {
      "id": 452683,
      "primary_message": "Divide veggies and meatballs between plates; drizzle meatballs with tahini sauce and sprinkle veggies with reserved mint. Serve with lemon wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
