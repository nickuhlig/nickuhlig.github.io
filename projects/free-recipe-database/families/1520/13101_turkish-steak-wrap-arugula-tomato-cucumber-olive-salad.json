  "instructions": [
    {
      "id": 219652,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219653,
      "primary_message": "Pat the steak dry with paper towels and place on a large plate; season with spices on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp cumin\n¾ tsp coriander\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 219654,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add steak and cook, flipping once, until desired doneness, 4-5 minutes for medium-rare. Transfer to a clean plate and cover loosely with aluminum foil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 219655,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 tomatoes\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 219656,
      "primary_message": "Peel, quarter, and thinly slice onion. Peel and mince garlic. Place both in a large bowl along with oil, vinegar, dill, and salt.",
      "secondary_message": "½ medium red onion\n3 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n¾ tsp dill\n3 pinch salt"
    },
    {
      "id": 219657,
      "primary_message": "Small dice tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 219658,
      "primary_message": "Trim cucumbers, quarter lengthwise, then slice crosswise into ¼-inch thick pieces; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 219659,
      "primary_message": "Halve olives and add to bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 219660,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 219661,
      "primary_message": "Return the grill pan to medium-high heat. Working in batches, place tortillas in the pan and warm, flipping occasionally, until lightly charred, about 1 minute. Remove from heat.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 219662,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 219663,
      "primary_message": "Place tortillas on a flat surface and spread evenly with yogurt. Divide steak and ⅓ of the salad between them; roll tightly to close and cut in half. ",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 219664,
      "primary_message": "Divide wraps between plates; serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
