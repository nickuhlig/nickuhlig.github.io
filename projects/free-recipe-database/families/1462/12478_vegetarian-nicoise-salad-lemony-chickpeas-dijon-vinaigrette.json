  "instructions": [
    {
      "id": 209745,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "0.23 kg new potatoes\n1 lemon\n½ small pkg grape tomatoes\n0.23 kg green beans\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 209746,
      "primary_message": "Halve potatoes and transfer to a medium saucepan. Cover with hot water (from the tap), season with salt, cover, and bring to a boil over high heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 209747,
      "primary_message": "Meanwhile, drain and rinse chickpeas; transfer to a small bowl.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 209748,
      "primary_message": "Juice lemon into the bowl with the chickpeas; add turmeric and salt. Stir to combine and set aside to marinate.",
      "secondary_message": "¼ tsp turmeric\n¼ tsp salt"
    },
    {
      "id": 209749,
      "primary_message": "Once the water in the saucepan is boiling, reduce heat to medium and cook until the potatoes are almost tender, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 209750,
      "primary_message": "While the potatoes are cooking, peel and mince garlic; place in a medium bowl along with oil, vinegar, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 ½ tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n2 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 209751,
      "primary_message": "Halve tomatoes and thinly slice olives; transfer both to the bowl with the dressing and set aside.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 209752,
      "primary_message": "Trim and halve the green beans.",
      "secondary_message": null
    },
    {
      "id": 209753,
      "primary_message": "When the potatoes are almost done, add green beans and edamame; continue to cook, until veggies are fork-tender, about 4 minutes. Drain and rinse with cold water.",
      "secondary_message": "¾ cup edamame"
    },
    {
      "id": 209754,
      "primary_message": "Transfer green beans, edamame, potatoes, and marinated chickpeas to the bowl with the dressing. Add mixed greens and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 209755,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy.",
      "secondary_message": null
    }
  ],
