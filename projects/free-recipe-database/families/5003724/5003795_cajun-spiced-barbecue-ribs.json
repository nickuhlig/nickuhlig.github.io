  "instructions": [
    {
      "id": 1,
      "primary_message": "To make the rub, in a small bowl, mix together paprika, salt, sugar, garlic powder, onion powder, thyme, oregano, cumin, black pepper, white pepper, and cayenne pepper. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To make the liquid seasoning, in a medium bowl, whisk together beer, butter, Worcestershire sauce, liquid crab boil, and Louisiana-style hot sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove membrane from back of each rack of ribs and trim meat of excess fat. Season ribs liberally with rub all over.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Fire up smoker or grill to 105°C, adding chunks of smoking wood when at temperature. When wood is ignited and producing smoke, place ribs in smoker or grill, meat side up. Smoke until ribs darken to a deep rusty red color, about 3 hours.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Lay each rack of ribs on top of a sheet of extra-large heavy duty aluminum foil; tilt foil edges upward. Pour half of liquid seasoning over each rack of ribs, then seal ribs in foil and place back on smoker or grill for 1 hour.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Open one end of foil and pour liquid seasoning into a small bowl and reserve. Remove ribs from foil and place back in smoker and continue to cook until ribs have a slight bend when lifted from one end, 1-2 hours more.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Remove ribs from smoker, brush with reserved liquid seasoning. Serve immediately.",
      "secondary_message": null
    }
  ],
