  "instructions": [
    {
      "id": 195849,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 lemons\n1 small pkg chives"
    },
    {
      "id": 195850,
      "primary_message": "Use a spiralizer, julienne (or regular) peeler to make zucchini noodles; set aside.",
      "secondary_message": null
    },
    {
      "id": 195851,
      "primary_message": "Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets. Season with spices on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n2 tbsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 195852,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 195853,
      "primary_message": "When the pot is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chicken and cook until golden brown and cooked through, 2-3 minutes per side.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 195854,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 195855,
      "primary_message": "Zest and juice two of the lemons into a small bowl. Cut remaining lemon into slices and set aside.",
      "secondary_message": null
    },
    {
      "id": 195856,
      "primary_message": "Finely grate Parmesan. Mince chives.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 195857,
      "primary_message": "Remove chicken from the pot, set aside on a plate, and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 195858,
      "primary_message": "Return pot to the stove over medium heat. Add additional butter and swirl to coat.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 195859,
      "primary_message": "Add garlic, broth, cream, lemon zest and juice, Parmesan, and chives to the skillet. Simmer for 4-5 minutes, stirring occasionally.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n12 fl oz (1 ½ cups) heavy cream"
    },
    {
      "id": 195860,
      "primary_message": "Add zucchini noodles and cook, stirring occasionally, until noodles are tender and sauce has thickened, 4-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 195861,
      "primary_message": "To serve, divide zucchini noodles between bowls. Top with chicken, sauce, and lemon slices. Enjoy!",
      "secondary_message": null
    }
  ],
