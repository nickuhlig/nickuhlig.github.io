  "instructions": [
    {
      "id": 195823,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 lemon\n½ small pkg chives"
    },
    {
      "id": 195824,
      "primary_message": "Use a spiralizer, julienne (or regular) peeler to make zucchini noodles; set aside.",
      "secondary_message": null
    },
    {
      "id": 195825,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 195826,
      "primary_message": "Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets. Season with spices on both sides.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n2 tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 195827,
      "primary_message": "When the skillet is hot, add butter and swirl to coat the bottom. Add chicken and cook until golden brown and cooked through, 2-3 minutes per side.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 195828,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 195829,
      "primary_message": "Zest and juice half the lemon into a small bowl. Cut remaining lemon into slices and set aside.",
      "secondary_message": null
    },
    {
      "id": 195830,
      "primary_message": "Finely grate Parmesan. Mince chives.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 195831,
      "primary_message": "Remove chicken from the skillet, set aside on a plate, and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 195832,
      "primary_message": "Return skillet to the stove over medium heat. Add additional butter and swirl to coat.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 195833,
      "primary_message": "Add garlic, broth, cream, lemon zest and juice, Parmesan, and chives to the skillet. Simmer for 2-3 minutes, stirring occasionally.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n4 fl oz (½ cup) heavy cream"
    },
    {
      "id": 195834,
      "primary_message": "Add zucchini noodles and cook, stirring occasionally, until noodles are tender and sauce has thickened, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 195835,
      "primary_message": "To serve, divide zucchini noodles between bowls. Top with chicken, sauce, and lemon slices. Enjoy!",
      "secondary_message": null
    }
  ],
