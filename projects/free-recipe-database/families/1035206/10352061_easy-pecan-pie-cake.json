  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Coat a 9 x 13-inch baking dish with cooking spray. ",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place butter in a small microwave-safe bowl, then place in the microwave and heat in 30-second increments until melted, about 1 minute. Remove from microwave.\n\n",
      "secondary_message": "1 cup butter, unsalted"
    },
    {
      "primary_message": "Transfer half of the melted butter (½-cup) to a medium bowl along with sugar, corn syrup, eggs, vanilla, and salt, then whisk to combine. Add pecans, stir to combine, then transfer to the baking dish, spreading it out in an even layer. (Reserve remaining butter for the next step.) \n\n",
      "secondary_message": "1 ¼ cups brown sugar\n¾ cup light corn syrup\n1 ½ tsp vanilla extract\n¼ tsp salt\n1 cup pecan pieces"
    },
    {
      "primary_message": "Sprinkle cake mix and cinnamon evenly over the baking dish, then drizzle with the remaining butter. Sprinkle additional pecans over top. \n\n",
      "secondary_message": "1 (432 g) box yellow cake mix\n½ tsp cinnamon, ground\n1 cup pecan pieces"
    },
    {
      "primary_message": "Place cake in the oven (it doesn't have to be fully heated) and bake until golden and set in the center, about 45 minutes. Remove from oven and set aside to cool slightly, about 5 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide cake between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
