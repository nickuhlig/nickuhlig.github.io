  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon. Melt the unsalted butter.",
      "secondary_message": "1 lemon\n10 tbsp unsalted butter, plus more for greasing"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat the oven to 350°F. Grease an 8-inch square or 9-inch round cake pan with cooking spray.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the filling: In a large bowl, combine peaches, honey, lemon juice, soaked saffron and its water, cinnamon, and salt. Transfer to prepared pan.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the topping: In a large bowl, whisk together flour, sugar, baking powder, and salt. Add melted butter and use rubber spatula to mix with dry ingredients. Add milk and stir until a uniform dough comes together.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Drop spoonfuls of biscuit topping all over peaches, smoothing with a spatula to avoid any overly thick sections and mostly covering the fruit (though a few gaps and cracks are fine). Leave a small opening in the center.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake until peaches are tender and the topping is light golden brown, fully cooked through, and feels springy to the touch (a cake tester should come out clean when inserted into a biscuit near the center of the baking dish), 40 to 45 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Let cobbler rest on a wire rack at least 30 minutes or up to 6 hours. Serve warm or at room temperature with ice cream or whipped cream.",
      "secondary_message": null
    }
  ],
