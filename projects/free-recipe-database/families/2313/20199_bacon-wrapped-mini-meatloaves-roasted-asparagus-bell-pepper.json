  "instructions": [
    {
      "id": 337190,
      "primary_message": "Preheat oven to 400°F. Arrange racks in the upper and middle positions.",
      "secondary_message": null
    },
    {
      "id": 337191,
      "primary_message": "Cut bacon in half crosswise and place on a plate.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 337192,
      "primary_message": "Using a clean cutting board, peel and mince garlic; place in a medium bowl along with beef, Dijon, and spices. Using your hands, mix well to combine.",
      "secondary_message": "2 cloves garlic\n1 ½ lb lean ground beef\n2 tsp Dijon mustard\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 337193,
      "primary_message": "Using 2 generous tablespoons per meatloaf, form the beef mixture into 16 short, sausage-like shapes, approximately 3-inches long. Wrap each meatloaf with bacon and transfer, seam-side down, to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 337194,
      "primary_message": "Place baking sheet on the top rack of the oven (it doesn't have to be fully heated) and roast until meatloaves are just cooked through, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 337195,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; transfer spears to a large baking sheet.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 337196,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips and add to the baking sheet with the asparagus. Drizzle veggies with oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "2 red bell peppers\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 337197,
      "primary_message": "Place baking sheet on the lower rack of the oven and roast, tossing halfway through, until veggies are tender, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 337198,
      "primary_message": "When the meatloaves are done, change oven to broil on high; broil until bacon is crisp, about 2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 337199,
      "primary_message": "To serve, divide meatloaves and veggies between plates; enjoy!",
      "secondary_message": null
    }
  ],
