  "instructions": [
    {
      "id": 313693,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 313694,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg cremini mushrooms\n½ medium head napa cabbage\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 313695,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 313696,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 313697,
      "primary_message": "While the skillet heats up, quarter mushrooms; add to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 313698,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 2-3 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 313699,
      "primary_message": "Add flour to the skillet and continue to cook, stirring frequently, until fragrant, 1 minute more.",
      "secondary_message": "1 tbsp all-purpose flour"
    },
    {
      "id": 313700,
      "primary_message": "Add tomatoes, broth, and spices to the skillet; stir to combine, then bring to a simmer.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n118 ml (½ cup) chicken or vegetable broth\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 313701,
      "primary_message": "Once simmering, nestle sausages into the veggies and place skillet in the oven (it doesn't have to be fully heated). Bake, flipping sausages once, until golden and warmed through, 10-15 minutes. Remove from oven.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 313702,
      "primary_message": "Meanwhile, trim off and discard root end of the cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. ",
      "secondary_message": null
    },
    {
      "id": 313703,
      "primary_message": "Preheat another skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 313704,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add cabbage and spices; cook, stirring occasionally, until tender, 3-4 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 313705,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 313706,
      "primary_message": "Once the cabbage is done, add pine nuts and parsley to the skillet; stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 313707,
      "primary_message": "To serve, divide veggie skillet and sautéed cabbage between plates or bowls; top with sausages and enjoy!",
      "secondary_message": null
    }
  ],
