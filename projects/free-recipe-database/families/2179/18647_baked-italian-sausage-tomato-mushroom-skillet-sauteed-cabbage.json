  "instructions": [
    {
      "id": 313333,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 313334,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb cremini mushrooms\n½ medium head napa cabbage\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 313335,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 313336,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 313337,
      "primary_message": "While the skillet heats up, quarter mushrooms; add to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 313338,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 2-3 minutes. ",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 313339,
      "primary_message": "Add flour to the skillet and continue to cook, stirring frequently, until fragrant, 1 minute more.",
      "secondary_message": "1 tbsp all-purpose flour"
    },
    {
      "id": 313340,
      "primary_message": "Add tomatoes, broth, and spices to the skillet; stir to combine, then bring to a simmer.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n4 fl oz (½ cup) chicken or vegetable broth\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 313341,
      "primary_message": "Once simmering, nestle sausages into the veggies and place skillet in the oven (it doesn't have to be fully heated). Bake, flipping sausages once, until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 313342,
      "primary_message": "Meanwhile, trim off and discard root end of the cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. ",
      "secondary_message": null
    },
    {
      "id": 313343,
      "primary_message": "Preheat another skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 313344,
      "primary_message": "Once the skillet is hot, add more butter and swirl to coat the bottom. Add cabbage and spices; cook, stirring occasionally, until tender, 3-4 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 313345,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 313346,
      "primary_message": "Once the cabbage is done, add pine nuts and parsley to the skillet; stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 313347,
      "primary_message": "To serve, divide veggie skillet and sautéed cabbage between plates or bowls; top with sausages and enjoy!",
      "secondary_message": null
    }
  ],
