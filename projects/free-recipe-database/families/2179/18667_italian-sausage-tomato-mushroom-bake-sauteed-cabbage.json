  "instructions": [
    {
      "id": 313633,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 313634,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n1 ½ medium heads napa cabbage\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 313635,
      "primary_message": "Peel, halve, and slice onions into thin half-moons; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 313636,
      "primary_message": "Quarter mushrooms; add to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 313637,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 313638,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 313639,
      "primary_message": "Add flour to the skillet and continue to cook, stirring frequently, until fragrant, 1-2 minutes more.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 313640,
      "primary_message": "Add tomatoes, broth, and spices to the skillet; stir to combine, then bring to a simmer.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n355 ml chicken or vegetable broth\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 313641,
      "primary_message": "Once simmering, transfer veggie skillet to a large baking dish; nestle sausages into the veggies. Place baking dish in the oven (it doesn't have to be fully heated) and bake, flipping sausages once, until golden and cooked through, 18-20 minutes. Remove from oven. (Reserve skillet for later use.)",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 313642,
      "primary_message": "Meanwhile, trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. ",
      "secondary_message": null
    },
    {
      "id": 313643,
      "primary_message": "Wipe reserved skillet clean with paper towels, then return to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 313644,
      "primary_message": "Once the skillet is hot, add more butter and swirl to coat the bottom. Add cabbage and spices; cook, stirring occasionally, until tender, 4-5 minutes. ",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 313645,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 313646,
      "primary_message": "Once the cabbage is done, add pine nuts and parsley to the skillet; stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 313647,
      "primary_message": "To serve, divide veggie bake and sautéed cabbage between plates or bowls; top with sausages and enjoy!",
      "secondary_message": null
    }
  ],
