  "instructions": [
    {
      "id": 519576,
      "primary_message": "Preheat oven to 425°F. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 519577,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n1 ½ lb cremini mushrooms\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 519578,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch thick pieces. Transfer to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 519579,
      "primary_message": "Thinly slice mushrooms. Add to the baking sheet with the leeks. Drizzle veggies with oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 519580,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 519581,
      "primary_message": "Meanwhile, zest lemon into a small bowl. (Reserve lemon for later use.)",
      "secondary_message": null
    },
    {
      "id": 519582,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon zest.",
      "secondary_message": null
    },
    {
      "id": 519583,
      "primary_message": "Peel and mince garlic. Add to the bowl, along with salt, and stir to combine the gremolata. Set aside.",
      "secondary_message": "2 cloves garlic\n⅛ tsp salt"
    },
    {
      "id": 519584,
      "primary_message": "Place ricotta, salt, and pepper in another small bowl. Stir to combine and set aside.",
      "secondary_message": "1 (15 oz) pkg ricotta cheese\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 519585,
      "primary_message": "Carefully remove cooked veggies from the baking sheet by lifting the corners of the foil and transferring the whole sheet to a flat surface. (Reserve baking sheet for later use.)",
      "secondary_message": null
    },
    {
      "id": 519586,
      "primary_message": "Change oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 519587,
      "primary_message": "Arrange flatbreads on the reserved baking sheet. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 519588,
      "primary_message": "Meanwhile, juice lemon over veggies and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 519589,
      "primary_message": "When the flatbreads are done, spread the ricotta over each flatbread, then top with roasted veggies and gremolata.",
      "secondary_message": null
    },
    {
      "id": 519590,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
