  "instructions": [
    {
      "id": 519591,
      "primary_message": "Preheat oven to 425°F. Line two baking sheet pans with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 519592,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 leeks\n2 ¼ lb cremini mushrooms\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 519593,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch thick pieces. Divide between the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 519594,
      "primary_message": "Thinly slice mushrooms. Add to the baking sheets with the leeks. Drizzle veggies with oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 519595,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 519596,
      "primary_message": "Meanwhile, zest lemons into a small bowl. (Reserve lemons for later use.)",
      "secondary_message": null
    },
    {
      "id": 519597,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon zest.",
      "secondary_message": null
    },
    {
      "id": 519598,
      "primary_message": "Peel and mince garlic. Add to the bowl, along with salt, and stir to combine the gremolata. Set aside.",
      "secondary_message": "3 cloves garlic\n3 pinch salt"
    },
    {
      "id": 519599,
      "primary_message": "Place ricotta, salt, and pepper in a medium bowl. Stir to combine and set aside.",
      "secondary_message": "1 ½ (15 oz) pkgs ricotta cheese\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 519600,
      "primary_message": "Carefully remove cooked veggies from the baking sheets by lifting the corners of the foil and transferring the whole sheets to a flat surface. (Reserve baking sheets for later use.)",
      "secondary_message": null
    },
    {
      "id": 519601,
      "primary_message": "Change oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 519602,
      "primary_message": "Arrange flatbreads on the reserved baking sheets. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 519603,
      "primary_message": "Meanwhile, juice lemons over veggies and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 519604,
      "primary_message": "When the flatbreads are done, spread the ricotta over each flatbread, then top with roasted veggies and gremolata.",
      "secondary_message": null
    },
    {
      "id": 519605,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
