  "instructions": [
    {
      "id": 309238,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 medium head napa cabbage\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 309239,
      "primary_message": "Peel, trim, and julienne or coarsely grate carrots; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 309240,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the carrot and set aside.",
      "secondary_message": null
    },
    {
      "id": 309241,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 309242,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 309243,
      "primary_message": "Add veggie ground to the skillet and cook, breaking it apart with a spoon, until crumbly and cooked through, about 5 minutes.",
      "secondary_message": "16 oz veggie ground, plant based"
    },
    {
      "id": 309244,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; peel, halve, and small dice onion. Add all three to the skillet and continue to cook, stirring often, until fragrant, about 1 minute.",
      "secondary_message": "4 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 309245,
      "primary_message": "Add carrot, cabbage, soy sauce, and crushed red pepper to the skillet; cook, stirring occasionally, until veggies have softened, 4-5 minutes.",
      "secondary_message": "¼ cup soy sauce\n⅛ tsp crushed red pepper"
    },
    {
      "id": 309246,
      "primary_message": "While the veggies are cooking, trim and cut green onions crosswise into ¼-inch pieces; set aside.",
      "secondary_message": null
    },
    {
      "id": 309247,
      "primary_message": "When veggies are done, carefully drain off any excess liquid; return to the stove and reduce heat to low. Make a well in the center of the skillet and add the eggs; scramble until no longer runny, 1-2 minutes, then stir to combine the egg roll mixture.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 309248,
      "primary_message": "Place mayo, chili-garlic sauce, and salt in a small bowl; stir to combine the spicy mayo.",
      "secondary_message": "¼ cup mayonnaise\n2 tsp chili-garlic sauce\n⅛ tsp salt"
    },
    {
      "id": 309249,
      "primary_message": "To serve, divide egg roll mixture between bowls; top with green onions, sesame seeds, and spicy mayo. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
