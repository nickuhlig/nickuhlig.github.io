  "instructions": [
    {
      "id": 309397,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n1 ½ medium heads napa cabbage\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 309398,
      "primary_message": "Peel, trim, and julienne or coarsely grate carrots; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 309399,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the carrot and set aside.",
      "secondary_message": null
    },
    {
      "id": 309400,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 309401,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 309402,
      "primary_message": "Add veggie ground to the pot and cook, breaking it apart with a spoon, until crumbly and cooked through, 6-7 minutes.",
      "secondary_message": "680 g veggie ground, plant based"
    },
    {
      "id": 309403,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; peel, halve, and small dice onions. Add all three to the pot and continue to cook, stirring often, until fragrant, 1-2 minutes.",
      "secondary_message": "6 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 309404,
      "primary_message": "Add carrot, cabbage, soy sauce, and crushed red pepper to the pot; cook, stirring occasionally, until veggies have softened, 5-6 minutes.",
      "secondary_message": "⅓ cup soy sauce\n3 pinch crushed red pepper"
    },
    {
      "id": 309405,
      "primary_message": "While the veggies are cooking, trim and cut green onions crosswise into ¼-inch pieces; set aside.",
      "secondary_message": null
    },
    {
      "id": 309406,
      "primary_message": "When veggies are done, carefully drain off any excess liquid; return to the stove and reduce heat to low. Make a well in the center of the pot and add the eggs; scramble until no longer runny, about 2 minutes, then stir to combine the egg roll mixture.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 309407,
      "primary_message": "Place mayo, chili-garlic sauce, and salt in a small bowl; stir to combine the spicy mayo.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp chili-garlic sauce\n3 pinch salt"
    },
    {
      "id": 309408,
      "primary_message": "To serve, divide egg roll mixture between bowls; top with green onions, sesame seeds, and spicy mayo. Enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
