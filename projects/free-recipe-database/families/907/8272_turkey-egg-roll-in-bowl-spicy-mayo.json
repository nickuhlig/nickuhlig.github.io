  "instructions": [
    {
      "id": 309151,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 309152,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 medium carrot\n½ medium head napa cabbage\n½ small bunch green onions (scallions)"
    },
    {
      "id": 309153,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 309154,
      "primary_message": "Add the ground turkey to the skillet; cook, breaking apart with a spoon until nearly cooked through, 3-4 minutes.",
      "secondary_message": "¾ lb ground turkey"
    },
    {
      "id": 309155,
      "primary_message": "Peel and mince garlic. Peel and small dice onion. Add both to the skillet. ",
      "secondary_message": "2 cloves garlic\n½ medium yellow onion"
    },
    {
      "id": 309156,
      "primary_message": "Peel and mince or grate the ginger. Add to the skillet with the turkey and sauté for 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 309157,
      "primary_message": "Peel the carrots and trim off the ends, then julienne or coarsely grate. Add to the skillet.",
      "secondary_message": null
    },
    {
      "id": 309158,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise into shreds and add to the skillet. ",
      "secondary_message": null
    },
    {
      "id": 309159,
      "primary_message": "Season veggies and turkey with soy sauce and crushed red pepper; stir to combine. Cook, stirring occasionally, until cabbage and carrots have softened, 4-5 minutes.",
      "secondary_message": "2 tbsp tamari soy sauce\n1 pinch crushed red pepper"
    },
    {
      "id": 309160,
      "primary_message": "Meanwhile, trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle, set aside.",
      "secondary_message": null
    },
    {
      "id": 309161,
      "primary_message": "When cabbage is cooked, drain off excess liquid, and turn the heat down to low. Make a well in the center of the skillet and crack the egg into it. Scramble until no longer runny, 1-2 minutes, then stir to combine.",
      "secondary_message": "1 egg"
    },
    {
      "id": 309162,
      "primary_message": "In a small bowl mix together chili-garlic sauce, salt, and mayo.",
      "secondary_message": "1 tsp chili-garlic sauce\n1 pinch salt\n2 tbsp mayonnaise"
    },
    {
      "id": 309163,
      "primary_message": "To serve divide egg roll mixture between bowls, top with green onions, sesame seeds and spicy mayo. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
