  "instructions": [
    {
      "id": 530470,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium beets\n½ lemon\n1 small bunch Italian (flat-leaf) parsley\n1 (1 inch) piece ginger root\n½ orange\n½ small pkg fresh mint"
    },
    {
      "id": 530471,
      "primary_message": "Peel, trim, and large dice beets; place in a small saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 530472,
      "primary_message": "Meanwhile, peel and mince garlic. Divide between a small and medium bowl. Set the medium bowl aside for the meatballs.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 530473,
      "primary_message": "Juice lemon into the small bowl with the garlic. Add yogurt, salt, and pepper, then whisk to combine the yogurt sauce. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 530474,
      "primary_message": "Once the water in the saucepan is boiling, reduce to a simmer and cook until beets are fork-tender, 12-15 minutes. Remove from heat, drain, and run under cold water to cool; set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 530475,
      "primary_message": "While the beets are cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the medium bowl with the garlic. (Set remaining parsley aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 530476,
      "primary_message": "Peel and mince ginger. Add to the bowl along with veggie ground, bread crumbs, egg, sugar, and spices. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the veggie ground mixture into \"meatballs.\" Place on a plate.",
      "secondary_message": "8 oz veggie ground, plant based\n¼ cup panko bread crumbs\n1 egg\n2 tsp brown sugar\n½ tsp paprika\n¼ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 530477,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 530478,
      "primary_message": "Once the pan is hot, coat with oil. Add meatballs and grill, turning occasionally with a fork or tongs, until golden brown and cooked through, 6-8 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 530479,
      "primary_message": "Meanwhile, zest and juice orange into a clean medium bowl. Add reserved parsley, oil, cumin, and salt, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 530480,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 530481,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl, along with cooled beets, and stir to combine the salad.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 530482,
      "primary_message": "To serve, divide yogurt sauce and salad between plates; top yogurt with meatballs. Enjoy!",
      "secondary_message": null
    }
  ],
