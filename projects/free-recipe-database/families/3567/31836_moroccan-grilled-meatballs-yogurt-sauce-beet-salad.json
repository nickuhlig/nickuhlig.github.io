  "instructions": [
    {
      "id": 530652,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium beets\n1 ½ lemons\n3 small bunches Italian (flat-leaf) parsley\n3 (2 ½ cm) pieces ginger root\n1 ½ oranges\n1 small pkg fresh mint"
    },
    {
      "id": 530653,
      "primary_message": "Peel, trim, and large dice beets; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 530654,
      "primary_message": "Meanwhile, peel and mince garlic. Divide between a medium and large bowl. Set the large bowl aside for the meatballs.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 530655,
      "primary_message": "Juice lemons into the medium bowl with the garlic. Add yogurt, salt, and pepper, then whisk to combine the yogurt sauce. Set aside.",
      "secondary_message": "2 ¼ cups plain Greek yogurt\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 530656,
      "primary_message": "Once the water in the pot is boiling, reduce to a simmer and cook until beets are fork-tender, 12-15 minutes. Remove from heat, drain, and run under cold water to cool; set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 530657,
      "primary_message": "While the beets are cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the large bowl with the garlic. (Set remaining parsley aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 530658,
      "primary_message": "Peel and mince ginger. Add to the bowl along with veggie ground, bread crumbs, eggs, sugar, and spices. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the veggie ground mixture into \"meatballs.\" Place on a plate.",
      "secondary_message": "680 g veggie ground, plant based\n¾ cup panko bread crumbs\n3 eggs\n2 tbsp brown sugar\n1 ½ tsp paprika\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper\n¼ tsp cinnamon, ground"
    },
    {
      "id": 530659,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 530660,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add meatballs and grill, turning occasionally with a fork or tongs, until golden brown and cooked through, 6-8 minutes. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 530661,
      "primary_message": "Meanwhile, zest and juice oranges into a clean large bowl. Add reserved parsley, oil, cumin, and salt, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 530662,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 530663,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl, along with cooled beets, and stir to combine the salad.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 530664,
      "primary_message": "To serve, divide yogurt sauce and salad between plates; top yogurt with meatballs. Enjoy!",
      "secondary_message": null
    }
  ],
