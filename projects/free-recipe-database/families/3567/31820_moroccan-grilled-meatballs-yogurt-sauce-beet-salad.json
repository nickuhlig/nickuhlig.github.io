  "instructions": [
    {
      "id": 530444,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium beets\n1 lemon\n2 small bunches Italian (flat-leaf) parsley\n2 (1 inch) pieces ginger root\n1 orange\n1 small pkg fresh mint"
    },
    {
      "id": 530445,
      "primary_message": "Peel, trim, and large dice beets; place in a medium saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 530446,
      "primary_message": "Meanwhile, peel and mince garlic. Divide between a small and medium bowl. Set the medium bowl aside for the meatballs.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 530447,
      "primary_message": "Juice lemon into the small bowl with the garlic. Add yogurt, salt, and pepper, then whisk to combine the yogurt sauce. Set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 530448,
      "primary_message": "Once the water in the saucepan is boiling, reduce to a simmer and cook until beets are fork-tender, 12-15 minutes. Remove from heat, drain, and run under cold water to cool; set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 530449,
      "primary_message": "While the beets are cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the medium bowl with the garlic. (Set remaining parsley aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 530450,
      "primary_message": "Peel and mince ginger. Add to the bowl along with beef, bread crumbs, eggs, sugar, and spices. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the beef mixture into rounded meatballs. Place on a plate.",
      "secondary_message": "1 ½ lb lean ground beef\n½ cup panko bread crumbs\n2 eggs\n4 tsp brown sugar\n1 tsp paprika\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cinnamon, ground"
    },
    {
      "id": 530451,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 530452,
      "primary_message": "Once the pan is hot, coat with oil. Add meatballs and grill, turning occasionally with a fork or tongs, until golden brown and cooked through, 6-8 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 530453,
      "primary_message": "Meanwhile, zest and juice orange into a clean medium bowl. Add reserved parsley, oil, cumin, and salt, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 530454,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 530455,
      "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl, along with cooled beets, and stir to combine the salad.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 530456,
      "primary_message": "To serve, divide yogurt sauce and salad between plates; top yogurt with meatballs. Enjoy!",
      "secondary_message": null
    }
  ],
