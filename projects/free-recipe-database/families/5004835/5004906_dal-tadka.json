  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Daal: Wash and drain tuvar daal in a large fine mesh strainer. Heat ghee in pressure cooker over high heat until shimmering. Add asafoetida, turmeric, and washed daal. Cook, stirring frequently till the ghee coats the daal, about 20 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add water and salt to taste. Close pressure cooker, increase heat to high, and heat until pressure cooker is pressurized to high pressure. Reduce heat to low and cook ten minutes. Remove from heat and allow pressure to dissipate.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Open pressure cooker and break up daal with a whisk. Set aside while you make the tadka.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For the Tadka: Heat ghee in a skillet over high heat until lightly smoking. Reduce heat to medium.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add mundu chiles, mustard seeds, and whole cumin seed (stand away from skillet as the seeds pop). Wait until seeds sizzle, about 10 seconds, then add curry leaves and stir. Cook until the curry leaves sizzle, about 10 seconds longer, then add asafoetida, red chile and roasted cumin powder. Stir vigorously and immediately transfer all contents to the daal and lightly stir. Do not mix thoroughly. Some of the ghee should float on top. Serve immediately with white rice, Indian bread (roti), or as an accompaniment to any Indian meal.",
      "secondary_message": null
    }
  ],
