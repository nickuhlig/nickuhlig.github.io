  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large mixing bowl, whisk flour and salt to combine.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small saucepan, combine lard or suet and water. Bring to a simmer over medium-high heat; when fat has melted completely, immediately pour it over dry ingredients. Using a flexible spatula, stir mixture until it forms a shaggy dough.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When dough is cool enough to handle, use your hands to shape it into a mass. Flip dough onto a lightly-floured surface and knead until it becomes a smooth dough, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Use dough immediately in any recipe calling for a hot water crust. To roll dough, place it between two 13-by-46-cm pieces of parchment and roll to desired thickness.",
      "secondary_message": null
    }
  ],
