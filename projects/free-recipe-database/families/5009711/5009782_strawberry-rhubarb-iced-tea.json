  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the rhubarb.",
      "secondary_message": "3 cups rhubarb"
    },
    {
      "id": 1,
      "primary_message": "To make the rhubarb syrup, combine chopped rhubarb, water, and sugar in a heavy-bottomed pot. Cook over medium-low heat, stirring often, until rhubarb has broken into shreds. Let cool, strain, and refrigerate in a sealed container.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring 2 quarts water close to a boil, then pour over tea bags in a very large pitcher. Let brew for 5 minutes, then remove tea bags. Cool and refrigerate until chilled.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To serve, add all the rhubarb syrup to chilled tea and stir. Slice strawberries and layer with ice in serving glasses, then top with tea.",
      "secondary_message": null
    }
  ],
