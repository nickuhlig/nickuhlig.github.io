  "instructions": [
    {
      "id": 63997,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 63989,
      "primary_message": "In a small bowl, prepare dressing by whisking together olive oil, lime juice, honey, salt, and pepper.",
      "secondary_message": "4 ½ tbsp extra virgin olive oil\njuice of 1 ½ limes\n1 ½ tsp honey\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 63996,
      "primary_message": "Season steak with salt and pepper.",
      "secondary_message": "2 ¼ lb ribeye steak\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 63995,
      "primary_message": "Coat grill or bottom of skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 63994,
      "primary_message": "Wash mangoes and jalapeños. Peel the mangoes, slice flesh away from the pit, small dice, and transfer to a medium bowl. Seed, mince, and add jalapeños to bowl. Peel, small dice, and add onion to bowl.",
      "secondary_message": "3 mangoes\n3 jalapeño peppers\n1 ½ medium red onion"
    },
    {
      "id": 63993,
      "primary_message": "Add lime juice, honey, and salt to salsa; mix to combine.",
      "secondary_message": "juice of 1 ½ limes\n¾ tsp honey\n⅜ tsp salt"
    },
    {
      "id": 63992,
      "primary_message": "Wash and dry spinach. Transfer to a medium bowl.",
      "secondary_message": "1 ½ (5 oz) pkg baby spinach"
    },
    {
      "id": 63991,
      "primary_message": "Wash and halve tomatoes. Add to bowl with spinach.",
      "secondary_message": "1 ½ pint grape tomatoes"
    },
    {
      "id": 63990,
      "primary_message": "Place steak on a plate and top with mango salsa. Add salad on the side and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
