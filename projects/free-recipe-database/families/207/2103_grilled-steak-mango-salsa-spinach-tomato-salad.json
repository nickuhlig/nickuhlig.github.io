  "instructions": [
    {
      "id": 19877,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 19878,
      "primary_message": "In a small bowl, prepare dressing by whisking together olive oil, lime juice, honey, salt, and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\njuice of ½ lime\n½ tsp honey\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 19879,
      "primary_message": "Season steak with salt and pepper.",
      "secondary_message": "0.34 kg ribeye steak\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 19880,
      "primary_message": "Coat grill or bottom of skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 19881,
      "primary_message": "Wash mango and jalapeño. Peel the mango, slice flesh away from the pit, small dice, and transfer to a medium bowl. Seed, mince, and add jalapeño to bowl. Peel, small dice, and add onion to bowl.",
      "secondary_message": "1 mango\r\n1 jalapeño pepper\r\n½ medium red onion"
    },
    {
      "id": 19882,
      "primary_message": "Add lime juice, honey, and salt to salsa; mix to combine.",
      "secondary_message": "juice of ½ lime\r\n¼ tsp honey\r\n⅛ tsp salt"
    },
    {
      "id": 19883,
      "primary_message": "Wash and dry spinach. Transfer to a medium bowl.",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 19884,
      "primary_message": "Wash and halve tomatoes. Add to bowl with spinach.",
      "secondary_message": "½ small pkg grape tomatoes"
    },
    {
      "id": 19885,
      "primary_message": "Place steak on a plate and top with mango salsa. Add salad on the side and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
