  "instructions": [
    {
      "id": 410470,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 410471,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. When the rice is done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410472,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410473,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 410474,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 410475,
      "primary_message": "Meanwhile, wash and dry Brussels sprouts; using a clean cutting board, trim and thinly slice. Place in a large bowl.",
      "secondary_message": "0.45 kg Brussels sprouts"
    },
    {
      "id": 410476,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the Brussels sprouts along with the carrots.",
      "secondary_message": "1 medium yellow onion\n1 (283 g) bag shredded carrots"
    },
    {
      "id": 410477,
      "primary_message": "Return skillet (with drippings) to medium heat, then add veggies, salt, and pepper. Cook, stirring frequently, until veggies are fork-tender, 4-6 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 410478,
      "primary_message": "When the veggies are done, push to the sides of the skillet and crack eggs into the middle. Let sit for a few seconds and then cook, stirring constantly, until set and no longer runny. Remove from heat.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 410479,
      "primary_message": "When the rice is done, add to the skillet, along with the bacon, and increase to medium-high heat. Add stir-fry sauce, stir to combine, and cook until warmed through, about 1 minute. Remove from heat.",
      "secondary_message": "⅔ cup stir-fry sauce"
    },
    {
      "id": 410480,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
