  "instructions": [
    {
      "id": 410449,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 410450,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. When the rice is done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410451,
      "primary_message": "Meanwhile, place eggs in a large bowl. Whisk to combine.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 410452,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410453,
      "primary_message": "Pour the egg mixture into the pot. Scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pot. Cook until the eggs are no longer runny. Transfer to a large plate and set aside. (Reserve pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 410454,
      "primary_message": "Wash, dry, trim, and thinly slice Brussels sprouts. Place in a clean large bowl.",
      "secondary_message": "1 ½ lb Brussels sprouts"
    },
    {
      "id": 410455,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl with the Brussels sprouts along with the mushrooms and carrots.",
      "secondary_message": "1 ½ medium yellow onions\n3 (8 oz) pkg sliced white mushrooms\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 410456,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and cook, stirring frequently, until lightly browned and tender, 5-7 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 410457,
      "primary_message": "When the veggies are done, add scrambled egg, stir-fry sauce, and cooked rice to the pot; stir to combine. Continue to cook until warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 cup stir-fry sauce"
    },
    {
      "id": 410458,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
