  "instructions": [
    {
      "id": 410492,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 410493,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. When the rice is done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410494,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410495,
      "primary_message": "While the skillet heats up, place eggs in a medium bowl. Whisk to combine.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 410496,
      "primary_message": "Pour the egg mixture into the skillet. Scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the skillet. Cook until the eggs are no longer runny. Transfer to a plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 410497,
      "primary_message": "Wash, dry, trim, and thinly slice Brussels sprouts. Place in a clean medium bowl.",
      "secondary_message": "0.23 kg Brussels sprouts"
    },
    {
      "id": 410498,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the Brussels sprouts along with the mushrooms and carrots.",
      "secondary_message": "½ medium yellow onion\n1 (227g ) pkg sliced white mushrooms\n½ (283 g) bag shredded carrots"
    },
    {
      "id": 410499,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and cook, stirring frequently, until lightly browned and tender, 4-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 410500,
      "primary_message": "When the veggies are done, add scrambled egg, stir-fry sauce, and cooked rice to the skillet; stir to combine. Continue to cook until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "⅓ cup stir-fry sauce"
    },
    {
      "id": 410501,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
