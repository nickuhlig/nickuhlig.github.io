  "instructions": [
    {
      "id": 410481,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 410482,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. When the rice is done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410483,
      "primary_message": "Meanwhile, small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 410484,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410485,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve pot with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 410486,
      "primary_message": "Meanwhile, wash and dry Brussels sprouts; using a clean cutting board, trim and thinly slice. Place in a large bowl.",
      "secondary_message": "0.68 kg Brussels sprouts"
    },
    {
      "id": 410487,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl with the Brussels sprouts along with the carrots.",
      "secondary_message": "1 ½ medium yellow onions\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 410488,
      "primary_message": "Return pot (with drippings) to medium heat, then add veggies, salt, and pepper. Cook, stirring frequently, until veggies are fork-tender, 5-7 minutes.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 410489,
      "primary_message": "When the veggies are done, push to the sides of the pot and crack eggs into the middle. Let sit for a few seconds and then cook, stirring constantly, until set and no longer runny. Remove from heat.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 410490,
      "primary_message": "When the rice is done, add to the pot, along with the bacon, and increase to medium-high heat. Add stir-fry sauce, stir to combine, and cook until warmed through, 1-2 minutes. Remove from heat.",
      "secondary_message": "1 cup stir-fry sauce"
    },
    {
      "id": 410491,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
