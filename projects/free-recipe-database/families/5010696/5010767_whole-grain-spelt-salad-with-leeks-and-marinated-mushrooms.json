  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the cremini mushrooms. Dice the leek. Thinly slice the garlic. Pick the thyme leaves from the stems and mince them. Pick the parsley leaves from the stems and mince them. Mince the chives.",
      "secondary_message": "0.45 kg cremini mushrooms\n4 leek\n2 medium cloves garlic\n1 tsp thyme leaves\n½ cup flat-leaf parsley\n¼ cup chives"
    },
    {
      "id": 1,
      "primary_message": "In a large skillet, heat 3 tablespoons oil over medium-high heat until shimmering. Add mushrooms and cook, stirring, until tender and their water has evaporated, about 5 minutes. Add leek, garlic, and thyme, season with salt and pepper, and cook until leak is tender, about 4 minutes. Transfer to large bowl and stir in 1/4 cup cider vinegar. Let stand 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, stir together spelt, cucumbers, and mushroom-leek mixture. Stir in remaining 6 tablespoons olive oil, 2 tablespoons cider vinegar, parley, and chives, and season with salt and pepper. Spoon salad into bowls and sprinkle with espelette pepper, if using.",
      "secondary_message": null
    }
  ],
