  "instructions": [
    {
      "id": 620181,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 620182,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n4 baby bok choy\n½ lime"
    },
    {
      "id": 620183,
      "primary_message": "Peel and mince ginger. Place in a medium bowl, along with soy sauce, oil, chili-garlic sauce, and spices, then whisk to combine the marinade. (If coconut oil is solid, melt in a small saucepan over low heat.)",
      "secondary_message": "2 tbsp soy sauce\n1 ½ tbsp virgin coconut oil\n2 tsp chili-garlic sauce\n½ tsp cumin, ground\n½ tsp coriander, ground\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 620184,
      "primary_message": "Trim and cut bok choy lengthwise into quarters. Transfer to a baking sheet pan, drizzle with half of the marinade, and turn to coat. Spread bok choy out in an even layer. (Reserve remaining marinade for later use.)",
      "secondary_message": null
    },
    {
      "id": 620185,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until bok choy is tender and starting to brown, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 620186,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620187,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels, add to the bowl with the reserved marinade, and turn to coat. ",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 620188,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken (shaking off any excess marinade) and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 620189,
      "primary_message": "While the chicken is cooking, zest and juice lime into a small bowl. Add peanut butter, chili-garlic sauce, and salt, then whisk to combine the sauce. If needed, add water, 1 teaspoon at a time, to reach a drizzling consistency.",
      "secondary_message": "2 tbsp natural peanut butter\n1 tsp chili-garlic sauce\n⅛ tsp salt"
    },
    {
      "id": 620190,
      "primary_message": "To serve, divide bok choy and chicken between plates or bowls. Drizzle with peanut sauce, sprinkle with sesame seeds, and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
