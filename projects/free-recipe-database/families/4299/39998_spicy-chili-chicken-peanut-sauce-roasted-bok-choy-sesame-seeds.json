  "instructions": [
    {
      "id": 620321,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 620322,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n12 baby bok choy\n1 ½ limes"
    },
    {
      "id": 620323,
      "primary_message": "Peel and mince ginger. Place in a large bowl, along with coconut aminos, oil, chili-garlic sauce, and spices, then whisk to combine the marinade. (If coconut oil is solid, melt in a small saucepan over low heat.)",
      "secondary_message": "⅓ cup coconut aminos\n¼ cup virgin coconut oil\n2 tbsp chili-garlic sauce\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 620324,
      "primary_message": "Trim and cut bok choy lengthwise into quarters. Divide between two large baking sheet pans, drizzle with half of the marinade, and turn to coat. Spread bok choy out in an even layer. (Reserve remaining marinade for later use.)",
      "secondary_message": null
    },
    {
      "id": 620325,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until bok choy is tender and starting to brown, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 620326,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620327,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels, add to the bowl with the reserved marinade, and turn to coat. ",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 620328,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken (shaking off any excess marinade) and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 620329,
      "primary_message": "While the chicken is cooking, zest and juice limes into a small bowl. Add peanut butter, chili-garlic sauce, and salt, then whisk to combine the sauce. If needed, add water, a few teaspoons at a time, to reach a drizzling consistency. ",
      "secondary_message": "⅓ cup natural peanut butter\n1 tbsp chili-garlic sauce\n¼ tsp salt"
    },
    {
      "id": 620330,
      "primary_message": "To serve, divide bok choy and chicken between plates or bowls. Drizzle with peanut sauce, sprinkle with sesame seeds, and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
