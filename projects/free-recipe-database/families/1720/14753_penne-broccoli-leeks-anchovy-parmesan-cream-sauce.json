  "instructions": [
    {
      "id": 276079,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "1 tbsp salt\n15 oz penne pasta"
    },
    {
      "id": 276080,
      "primary_message": "Trim off the root ends and the dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick half-moons.",
      "secondary_message": "6 leeks"
    },
    {
      "id": 276081,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 276082,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leeks, salt, and pepper; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 276083,
      "primary_message": "Meanwhile, wash, dry, and finely chop broccoli. Add to the pot with the leeks and continue to cook, stirring occasionally, until tender, about 5 minutes.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 276084,
      "primary_message": "While the veggies are cooking, peel and mince garlic. Mince anchovy fillets.",
      "secondary_message": "6 cloves garlic\n12 anchovy fillets, packed in oil"
    },
    {
      "id": 276085,
      "primary_message": "Add garlic and anchovy to the pot. Continue to cook, stirring occasionally, until fragrant and lightly caramelized, 6 minutes more.",
      "secondary_message": null
    },
    {
      "id": 276086,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 276087,
      "primary_message": "Add Parmesan (reserving a small handful for garnish) and cream to the pot. Cook, stirring until the mixture is well combined, 2-3 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 276088,
      "primary_message": "Add drained pasta to the pot and stir to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency.",
      "secondary_message": null
    },
    {
      "id": 276089,
      "primary_message": "To serve, divide pasta between bowls and top with reserved Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
