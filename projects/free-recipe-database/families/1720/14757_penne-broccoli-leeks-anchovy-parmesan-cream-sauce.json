  "instructions": [
    {
      "id": 276123,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ½-cup of pasta cooking water before draining.)",
      "secondary_message": "1 tsp salt\n142 g penne pasta"
    },
    {
      "id": 276124,
      "primary_message": "Trim off the root ends and the dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick half-moons.",
      "secondary_message": "2 leeks"
    },
    {
      "id": 276125,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 276126,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add leeks, salt, and pepper; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 276127,
      "primary_message": "Meanwhile, wash, dry, and finely chop broccoli. Add to the skillet with the leeks and continue to cook, stirring occasionally, until tender, about 4 minutes.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 276128,
      "primary_message": "While the veggies are cooking, peel and mince garlic. Mince anchovy fillets.",
      "secondary_message": "2 cloves garlic\n4 anchovy fillets, packed in oil"
    },
    {
      "id": 276129,
      "primary_message": "Add garlic and anchovy to the skillet. Continue to cook, stirring occasionally, until fragrant and lightly caramelized, 5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 276130,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 276131,
      "primary_message": "Add Parmesan (reserving a small handful for garnish) and cream to the skillet. Cook, stirring until the mixture is well combined, 1-2 minutes.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 276132,
      "primary_message": "Add drained pasta to the skillet and stir to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency.",
      "secondary_message": null
    },
    {
      "id": 276133,
      "primary_message": "To serve, divide pasta between bowls and top with reserved Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
