  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring milk to boil on stovetop in small saucepan or in microwave-safe bowl in microwave.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large, heavy-bottomed saucepan whisk together sugar, cornstarch, egg yolks, and salt. While vigorously whisking, add 1/4 cup hot milk to temper, then continue whisking and add remaining milk in a slow, steady stream.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add cinnamon stick and bring the mixture to boil over medium heat, whisking constantly; mixture will thicken to the consistency of yogurt. Continue to boil for 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove from heat and stir in butter and vanilla extract. Remove and discard cinnamon stick.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Strain custard into large bowl and serve warm with a dusting of ground cinnamon. Alternatively, press a piece of plastic wrap directly onto the atolillo’s surface and refrigerate until cold, then serve chilled.",
      "secondary_message": null
    }
  ],
