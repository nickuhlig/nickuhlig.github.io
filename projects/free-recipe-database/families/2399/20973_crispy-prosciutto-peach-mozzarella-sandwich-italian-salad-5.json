  "instructions": [
    {
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 peaches\n3 tomatoes\n3 hearts romaine hearts"
    },
    {
      "primary_message": "Divide prosciutto between two large baking sheet pans and arrange in an single layer. Working in batches, place in the oven and broil until crispy, 2-3 minutes. Remove from oven.",
      "secondary_message": "24 slices prosciutto"
    },
    {
      "primary_message": "Meanwhile, quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Cut each quarter into thin wedges and place on a large plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Thinly slice tomatoes, then season with salt and pepper; add to the plate with the peach.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "primary_message": "Thinly slice mozzarella into rounds; add to the plate.",
      "secondary_message": "1 ½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "primary_message": "Add one lettuce leaf per sandwich to the plate and set aside. Chop or tear remaining lettuce into bite-sized pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the lettuce and set aside.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated"
    },
    {
      "primary_message": "Toast bread if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "Spread mayo over each bread slice. Layer half of the slices with lettuce, tomato, mozzarella, peach, and crispy prosciutto. Close with remaining bread slices.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "primary_message": "Add dressing to the bowl with the lettuce and artichokes; toss to combine the salad.",
      "secondary_message": "⅓ cup Italian salad dressing"
    },
    {
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
