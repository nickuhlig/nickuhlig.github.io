  "instructions": [
    {
      "id": 350942,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 peaches\n3 tomatoes\n3 hearts romaine hearts"
    },
    {
      "id": 350943,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Cut each quarter into thin wedges and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 350944,
      "primary_message": "Thinly slice tomatoes, then season with salt and pepper; add to the plate with the peach.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 350945,
      "primary_message": "Thinly slice mozzarella into rounds; add to the plate.",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 350946,
      "primary_message": "Add one lettuce leaf per sandwich to the plate and set aside. Chop or tear remaining lettuce into bite-sized pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 350947,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the lettuce and set aside.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 350948,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 350949,
      "primary_message": "Spread mayo over each bread slice. Layer half of the slices with lettuce, tomato, mozzarella, and peach. Close with remaining bread slices.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 350950,
      "primary_message": "Add dressing to the bowl with the lettuce and artichokes; toss to combine the salad.",
      "secondary_message": "⅓ cup Italian salad dressing"
    },
    {
      "id": 350951,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
