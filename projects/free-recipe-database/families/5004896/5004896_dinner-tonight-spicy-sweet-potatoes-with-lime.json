  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Scrub the sweet potatoes. Chop the cilantro.",
      "secondary_message": "1 ¼ lb sweet potatoes\n3 tbsp cilantro"
    },
    {
      "id": 1,
      "primary_message": "For the Sweet Potatoes: Preheat the oven to 400°F. Set a baking sheet in the oven while warming.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Halve the potatoes length-wise, and cut each piece into three wedges.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Mix together the cumin, paprika and ground ginger. Coat the potato wedges quickly with the oil, and then toss with the spices and season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place the potatoes on the preheated baking sheet, in one layer. Set in the oven and cook for 15 minutes. Flip the wedges with a spatula and cook for another 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "For the Sauce: Meanwhile, mix together the yogurt, cilantro, lime juice, and cumin to make the yogurt dipping sauce.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "To Serve: When the potatoes are done, remove from oven and serve with the sauce.",
      "secondary_message": null
    }
  ],
