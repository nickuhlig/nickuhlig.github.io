  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Clean and quarter the white button mushrooms. Mince the garlic cloves. Thinly slice the Thai bird chile pepper.",
      "secondary_message": "1 lb white button mushrooms\n2 medium garlic cloves\n1 Thai bird chile pepper"
    },
    {
      "id": 1,
      "primary_message": "Heat the oil in a large wok over high heat until shimmering. Add the mushrooms and the salt and stir-fry until the mushrooms become tender and begin to release some liquid, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir the garlic, lemongrass, and chilies into the pan and cook until the garlic just begins to brown, about 1 minute. Add the lime juice and fish sauce, and season with the black pepper, continuing to toss and stir-fry the contents in the wok.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove the wok from the heat, then add the cilantro and toss to combine. Season to taste with more salt if desired. Transfer the mushrooms to a serving dish and serve with cocktail forks or toothpicks.",
      "secondary_message": null
    }
  ],
