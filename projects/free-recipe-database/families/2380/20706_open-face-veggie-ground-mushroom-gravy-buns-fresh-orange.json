  "instructions": [
    {
      "id": 347302,
      "primary_message": "Wash, dry, and thinly slice mushrooms.",
      "secondary_message": "0.68 kg cremini mushrooms"
    },
    {
      "id": 347303,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347304,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add mushrooms, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 347305,
      "primary_message": "Sprinkle flour into the skillet; continue to cook, stirring constantly, until lightly golden, 1-2 minutes.",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 347306,
      "primary_message": "Add milk and soy sauce to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until gravy has thickened, 3-4 minutes more. Remove from heat. ",
      "secondary_message": "710 ml almond milk, unsweetened\n1 tbsp soy sauce"
    },
    {
      "id": 347307,
      "primary_message": "Meanwhile, wash and dry the oranges, then cut into wedges.",
      "secondary_message": "3 oranges"
    },
    {
      "id": 347308,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 347309,
      "primary_message": "Divide buns between plates and top with gravy; serve with orange wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
