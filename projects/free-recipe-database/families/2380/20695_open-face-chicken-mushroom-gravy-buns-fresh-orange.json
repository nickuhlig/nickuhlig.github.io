  "instructions": [
    {
      "id": 347214,
      "primary_message": "Wash, dry, and thinly slice mushrooms.",
      "secondary_message": "½ lb cremini mushrooms"
    },
    {
      "id": 347215,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347216,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add mushrooms, chicken, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, about 5 minutes.",
      "secondary_message": "1 ½ tsp butter, unsalted\n½ lb ground chicken\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 347217,
      "primary_message": "Sprinkle flour into the skillet; continue to cook, stirring constantly, until lightly golden, about 1 minute.",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 347218,
      "primary_message": "Add milk and Worcestershire to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until gravy has thickened, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "8 fl oz (1 cup) whole milk\n1 tsp Worcestershire sauce"
    },
    {
      "id": 347219,
      "primary_message": "Meanwhile, wash and dry the orange, then cut into wedges.",
      "secondary_message": "1 orange"
    },
    {
      "id": 347220,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 347221,
      "primary_message": "Divide buns between plates and top with gravy; serve with orange wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
