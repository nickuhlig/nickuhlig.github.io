  "instructions": [
    {
      "id": 347294,
      "primary_message": "Wash, dry, and thinly slice mushrooms.",
      "secondary_message": "0.45 kg cremini mushrooms"
    },
    {
      "id": 347295,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347296,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add mushrooms, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, about 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 347297,
      "primary_message": "Sprinkle flour into the skillet; continue to cook, stirring constantly, until lightly golden, about 1 minute.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 347298,
      "primary_message": "Add milk and soy sauce to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until gravy has thickened, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "473 ml almond milk, unsweetened\n2 tsp soy sauce"
    },
    {
      "id": 347299,
      "primary_message": "Meanwhile, wash and dry the oranges, then cut into wedges.",
      "secondary_message": "2 oranges"
    },
    {
      "id": 347300,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 347301,
      "primary_message": "Divide buns between plates and top with gravy; serve with orange wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
