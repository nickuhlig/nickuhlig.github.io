  "instructions": [
    {
      "id": 329789,
      "primary_message": "Measure spices into a small bowl and set aside.",
      "secondary_message": "1 tsp garlic powder\n¾ tsp salt\n¾ tsp thyme, dried\n¾ tsp paprika\n½ tsp basil, dried\n½ tsp oregano, dried"
    },
    {
      "id": 329790,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 yellow bell pepper\n1 small bunch green onions (scallions)\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 329791,
      "primary_message": "Trim and small dice celery; trim, seed, and small dice bell pepper. Add both to the bowl with the spices.",
      "secondary_message": null
    },
    {
      "id": 329792,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329793,
      "primary_message": "Add half of the green onions and parsley to the bowl with the spices, celery, and pepper. (Place remaining green onions and parsley in another small bowl and set aside for garnish.)",
      "secondary_message": null
    },
    {
      "id": 329794,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329795,
      "primary_message": "While the pan heats up, slice sausages into thin rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 329796,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add veggies, spices, and sausage to the pan. Cook, stirring often, until veggies begin to soften, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 329797,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "½ (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 329798,
      "primary_message": "Add tomato paste to the pan and stir to combine.",
      "secondary_message": "1 tbsp tomato paste"
    },
    {
      "id": 329799,
      "primary_message": "Add beans, rice, RO-TEL, and broth to the pan; stir to combine the jambalaya and bring to a boil over high heat. ",
      "secondary_message": "½ cup jasmine rice\n1 (10 oz) can RO-TEL diced tomatoes & green chilies\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 329800,
      "primary_message": "Once boiling, stir the jambalaya, cover, and reduce heat to low. Cook until rice is tender and liquid is almost absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 329801,
      "primary_message": "To serve, divide jambalaya between bowls; garnish with reserved green onions and parsley. Enjoy!",
      "secondary_message": null
    }
  ],
