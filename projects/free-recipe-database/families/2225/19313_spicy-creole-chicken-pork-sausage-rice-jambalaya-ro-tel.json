  "instructions": [
    {
      "id": 329747,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329748,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the sausage and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Remove to a plate. (Reserve pan with cooking juices for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil\n1 pork sausage"
    },
    {
      "id": 329749,
      "primary_message": "Meanwhile, measure spices into a small bowl and set aside.",
      "secondary_message": "1 tsp garlic powder\n¾ tsp paprika\n¾ tsp thyme, dried\n½ tsp basil, dried\n½ tsp oregano, dried\n½ tsp salt"
    },
    {
      "id": 329750,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 yellow bell pepper\n1 small bunch green onions (scallions)\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 329751,
      "primary_message": "Trim and small dice celery; trim, seed, and small dice bell pepper. Add both to the bowl with the spices.",
      "secondary_message": null
    },
    {
      "id": 329752,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329753,
      "primary_message": "Add half of the green onions and parsley to the bowl with the spices, celery, and pepper. (Place remaining green onions and parsley in another small bowl and set aside for garnish.)",
      "secondary_message": null
    },
    {
      "id": 329754,
      "primary_message": "Return pan (with cooking juices) to medium-high heat. Once the pan is hot, add more oil and swirl to coat the bottom; add veggies and spices. Cook, stirring often, until veggies begin to soften, 2-3 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 329755,
      "primary_message": "Meanwhile, medium dice chicken. Add chicken and additional salt to the pan with the veggies and continue to cook, stirring often, until chicken starts to brown, about 3 minutes.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt"
    },
    {
      "id": 329756,
      "primary_message": "Add tomato paste to the pan and stir to combine.",
      "secondary_message": "1 tbsp tomato paste"
    },
    {
      "id": 329757,
      "primary_message": "Add rice, RO-TEL, and broth to the pan; stir to combine the jambalaya and bring to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 (10 oz) can RO-TEL diced tomatoes & green chilies\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 329758,
      "primary_message": "While the jambalaya is heating, using a clean cutting board, slice the cooked sausage into thin rounds; add to the pan.",
      "secondary_message": null
    },
    {
      "id": 329759,
      "primary_message": "Once boiling, stir the jambalaya, cover, and reduce heat to low. Cook until rice is tender and liquid is mostly absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 329760,
      "primary_message": "To serve, divide jambalaya between bowls; garnish with reserved green onions and parsley. Enjoy!",
      "secondary_message": null
    }
  ],
