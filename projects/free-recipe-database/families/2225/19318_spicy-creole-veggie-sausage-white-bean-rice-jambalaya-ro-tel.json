  "instructions": [
    {
      "id": 329815,
      "primary_message": "Measure spices into a medium bowl and set aside.",
      "secondary_message": "1 tbsp garlic powder\n2 ½ tsp paprika\n2 tsp salt\n2 tsp thyme, dried\n1 ½ tsp basil, dried\n1 ½ tsp oregano, dried"
    },
    {
      "id": 329816,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n3 yellow bell peppers\n3 small bunches green onions (scallions)\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 329817,
      "primary_message": "Trim and small dice celery; trim, seed, and small dice bell peppers. Add both to the bowl with the spices.",
      "secondary_message": null
    },
    {
      "id": 329818,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329819,
      "primary_message": "Add half of the green onions and parsley to the bowl with the spices, celery, and pepper. (Place remaining green onions and parsley in a small bowl and set aside for garnish.)",
      "secondary_message": null
    },
    {
      "id": 329820,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329821,
      "primary_message": "While the pot heats up, slice sausages into thin rounds.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 329822,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies, spices, and sausage slices to the pot. Cook, stirring often, until veggies begin to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 329823,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 329824,
      "primary_message": "Add tomato paste to the pot and stir to combine.",
      "secondary_message": "3 tbsp tomato paste"
    },
    {
      "id": 329825,
      "primary_message": "Add beans, rice, RO-TEL, and broth to the pot; stir to combine the jambalaya and bring to a boil over high heat. ",
      "secondary_message": "1 ½ cups jasmine rice\n3 (10 oz) cans RO-TEL diced tomatoes & green chilies\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 329826,
      "primary_message": "Once boiling, stir the jambalaya, cover, and reduce heat to low. Cook until rice is tender and liquid is almost absorbed, 18-20 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 329827,
      "primary_message": "To serve, divide jambalaya between bowls; garnish with reserved green onions and parsley. Enjoy!",
      "secondary_message": null
    }
  ],
