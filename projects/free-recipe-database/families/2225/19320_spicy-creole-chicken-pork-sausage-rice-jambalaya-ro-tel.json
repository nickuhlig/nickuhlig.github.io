  "instructions": [
    {
      "id": 329842,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329843,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the sausages and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Remove to a plate. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n2 pork sausages"
    },
    {
      "id": 329844,
      "primary_message": "Meanwhile, measure spices into a medium bowl and set aside.",
      "secondary_message": "2 tsp garlic powder\n1 ½ tsp paprika\n1 ½ tsp thyme, dried\n1 tsp basil, dried\n1 tsp oregano, dried\n1 tsp salt"
    },
    {
      "id": 329845,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 sticks celery\n2 yellow bell peppers\n2 small bunches green onions (scallions)\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 329846,
      "primary_message": "Trim and small dice celery; trim, seed, and small dice bell peppers. Add both to the bowl with the spices.",
      "secondary_message": null
    },
    {
      "id": 329847,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329848,
      "primary_message": "Add half of the green onions and parsley to the bowl with the spices, celery, and pepper. (Place remaining green onions and parsley in a small bowl and set aside for garnish.)",
      "secondary_message": null
    },
    {
      "id": 329849,
      "primary_message": "Return pot (with cooking juices) to medium-high heat. Once the pot is hot, add more oil and swirl to coat the bottom; add veggies and spices. Cook, stirring often, until veggies begin to soften, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 329850,
      "primary_message": "Meanwhile, medium dice chicken. Add chicken and additional salt to the pot with the veggies and continue to cook, stirring often, until chicken starts to brown, about 3 minutes.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt"
    },
    {
      "id": 329851,
      "primary_message": "Add tomato paste to the pot and stir to combine.",
      "secondary_message": "2 tbsp tomato paste"
    },
    {
      "id": 329852,
      "primary_message": "Add rice, RO-TEL, and broth to the pot; stir to combine the jambalaya and bring to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 (284 ml) cans RO-TEL diced tomatoes & green chilies\n473 ml chicken or vegetable broth"
    },
    {
      "id": 329853,
      "primary_message": "While the jambalaya is heating, using a clean cutting board, slice the cooked sausages into thin rounds; add to the pot.",
      "secondary_message": null
    },
    {
      "id": 329854,
      "primary_message": "Once boiling, stir the jambalaya, cover, and reduce heat to low. Cook until rice is tender and liquid is mostly absorbed, about 18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 329855,
      "primary_message": "To serve, divide jambalaya between bowls; garnish with reserved green onions and parsley. Enjoy!",
      "secondary_message": null
    }
  ],
