  "instructions": [
    {
      "id": 329883,
      "primary_message": "Measure spices into a medium bowl and set aside.",
      "secondary_message": "2 tsp garlic powder\n1 ½ tsp salt\n1 ½ tsp thyme, dried\n1 ½ tsp paprika\n1 tsp basil, dried\n1 tsp oregano, dried"
    },
    {
      "id": 329884,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 sticks celery\n2 yellow bell peppers\n2 small bunches green onions (scallions)\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 329885,
      "primary_message": "Trim and small dice celery; trim, seed, and small dice bell peppers. Add both to the bowl with the spices.",
      "secondary_message": null
    },
    {
      "id": 329886,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329887,
      "primary_message": "Add half of the green onions and parsley to the bowl with the spices, celery, and pepper. (Place remaining green onions and parsley in a small bowl and set aside for garnish.)",
      "secondary_message": null
    },
    {
      "id": 329888,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329889,
      "primary_message": "While the pot heats up, slice sausages into thin rounds.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 329890,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies, spices, and sausage slices to the pot. Cook, stirring often, until veggies begin to soften, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 329891,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 329892,
      "primary_message": "Add tomato paste to the pot and stir to combine.",
      "secondary_message": "2 tbsp tomato paste"
    },
    {
      "id": 329893,
      "primary_message": "Add beans, rice, RO-TEL, and broth to the pot; stir to combine the jambalaya and bring to a boil over high heat. ",
      "secondary_message": "1 cup jasmine rice\n2 (284 ml) cans RO-TEL diced tomatoes & green chilies\n473 ml chicken or vegetable broth"
    },
    {
      "id": 329894,
      "primary_message": "Once boiling, stir the jambalaya, cover, and reduce heat to low. Cook until rice is tender and liquid is almost absorbed, about 18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 329895,
      "primary_message": "To serve, divide jambalaya between bowls; garnish with reserved green onions and parsley. Enjoy!",
      "secondary_message": null
    }
  ],
