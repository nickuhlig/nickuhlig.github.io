  "instructions": [
    {
      "id": 365858,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a large bowl.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 365859,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl with the kale and set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 365860,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Place half in a medium bowl. (Set remaining basil aside for serving.)",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 365861,
      "primary_message": "Add tomato sauce, Italian seasoning, and crushed red pepper to the bowl with the basil. Stir to combine the sauce and set aside.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper"
    },
    {
      "id": 365862,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 365863,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365864,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken cutlets and pan-fry until golden and cooked through, 3-4 minutes per side.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 365865,
      "primary_message": "While the cutlets are cooking, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 365866,
      "primary_message": "Coarsely grate cheeses into another medium bowl and stir to combine.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese\n128 g Parmesan cheese"
    },
    {
      "id": 365867,
      "primary_message": "When the cutlets are done, divide between two large baking dishes. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 365868,
      "primary_message": "Return skillet to medium-high heat and add prepared tomato sauce. Cook, stirring occasionally, until warmed through, 1-2 minutes. Pour sauce over chicken and top with cheeses. ",
      "secondary_message": null
    },
    {
      "id": 365869,
      "primary_message": "Working in batches, place baking dishes in the oven and broil until cheese is melted, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 365870,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365871,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic and kale to the pot in handfuls, waiting for kale to wilt slightly before adding the next handful. Season with crushed red pepper and salt. Continue to cook, stirring frequently, until the kale is tender, 1-2 minutes more.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 365872,
      "primary_message": "Remove pot from the heat, add vinegar, and stir to combine.",
      "secondary_message": "1 tbsp balsamic vinegar"
    },
    {
      "id": 365873,
      "primary_message": "To serve, divide the chicken, sauce, and kale between plates. Top chicken with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
