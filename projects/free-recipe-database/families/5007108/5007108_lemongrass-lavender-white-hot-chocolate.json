  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the lemongrass. Tear the makrut lime leaf in half. Finely chop the white chocolate.",
      "secondary_message": "1 small stalk lemongrass\n1 makrut lime leaf\n3 oz white chocolate"
    },
    {
      "id": 1,
      "primary_message": "In small saucepan over medium heat, heat milk, lemongrass, lavender, lime leaf, and zest, stirring occasionally, until bubbles form around edges. Remove from heat and let steep 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain milk, then return to empty saucepan. Add chocolate and gently heat over medium heat, stirring, until chocolate is melted and mixture is hot. Serve immediately.",
      "secondary_message": null
    }
