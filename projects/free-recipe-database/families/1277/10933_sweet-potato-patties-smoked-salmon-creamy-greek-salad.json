  "instructions": [
    {
      "id": 180124,
      "primary_message": "In a medium bowl, whisk the egg.",
      "secondary_message": "1 egg"
    },
    {
      "id": 180125,
      "primary_message": "Wash, peel, and coarsely grate the sweet potatoes. Use a paper towel or a clean cloth to squeeze out the excess moisture and add to the bowl with the egg. ",
      "secondary_message": "1 lb sweet potato"
    },
    {
      "id": 180126,
      "primary_message": "Peel and mince shallot. Add to the bowl along with flour, salt, and pepper; stir to combine.",
      "secondary_message": "1 shallot\n1 tbsp all-purpose flour\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 180127,
      "primary_message": "Heat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 180128,
      "primary_message": "Using a ¼ cup measure, form the potato mixture into patties. Working in batches if necessary, add patties to the skillet and flatten into ½-thick circles using the back of a spatula. Cook, flipping once, until golden and cooked through, 6-8 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 180129,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch fresh dill\n½ pint grape tomatoes\n1 English cucumber"
    },
    {
      "id": 180130,
      "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 180131,
      "primary_message": "Add yogurt, feta, vinegar, capers, and honey to the bowl with the dill; whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n½ (4 oz) pkg crumbled feta cheese\n1 tbsp apple cider vinegar\n½ tbsp capers\n2 tsp honey"
    },
    {
      "id": 180132,
      "primary_message": "Halve olives and add to the bowl with the dressing.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 180133,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 180134,
      "primary_message": "Trim cucumber; quarter lengthwise, then slice crosswise into ¼-inch thick pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 180135,
      "primary_message": "To serve, divide patties, salmon, and salad between plates. Enjoy! ",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    }
  ],
