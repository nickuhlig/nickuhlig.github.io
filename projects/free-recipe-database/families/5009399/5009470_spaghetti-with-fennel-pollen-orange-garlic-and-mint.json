  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring 3 quarts of water to boil in a large pot with 1/4 cup kosher salt and cook spaghetti until tender but still firm. Stir occasionally, especially when first adding spaghetti.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While spaghetti boils, melt butter over medium-low heat in a wide skillet. When butter is melted, add garlic and cook for one minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When spaghetti is done, strain from pot and add to skillet along with olive oil, orange zest, mint, and fennel pollen. Stir until pasta is thoroughly coated with oil and is highly fragrant. Add salt to taste and lemon juice, if desired. Serve immediately.",
      "secondary_message": null
    }
  ],
