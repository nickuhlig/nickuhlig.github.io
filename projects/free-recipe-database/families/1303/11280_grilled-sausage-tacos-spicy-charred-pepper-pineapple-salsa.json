  "instructions": [
    {
      "id": 187958,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 jalapeño peppers\n3 small bunches green onions (scallions)\n1 ½ small pineapples\n1 small bunch cilantro\n3 limes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 187959,
      "primary_message": "Cut the bell peppers into quarters lengthwise; remove and discard the seeds. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 187960,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 187961,
      "primary_message": "Heat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 187962,
      "primary_message": "Trim off and discard ends of the green onions; add to the bowl. Drizzle with oil and season with spices. Toss to coat. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n1 ½ tsp cumin\n3 pinch chili powder"
    },
    {
      "id": 187963,
      "primary_message": "Working in batches if necessary, place veggies on the grill. Cook until tender and charred, 2-3 minutes per side. Return grilled veggies to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 187964,
      "primary_message": "Place sausages on the grill and reduce heat to medium. Cook, turning occasionally, until sausages are cooked through, 12-15 minutes. Once done, transfer to a plate and loosely cover with foil.",
      "secondary_message": "9 pork sausages"
    },
    {
      "id": 187965,
      "primary_message": "Meanwhile, small dice grilled bell peppers, jalapeños, and half of the green onions (set aside the other half for garnish). Return chopped veggies to the bowl.",
      "secondary_message": null
    },
    {
      "id": 187966,
      "primary_message": "Cut off skin from the pineapples, core, and small dice. Add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 187967,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 187968,
      "primary_message": "Juice two limes into the bowl and stir to combine the salsa. Cut remaining lime into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 187969,
      "primary_message": "Meanwhile, slice sausages into ½-inch thick rounds, at an angle.",
      "secondary_message": null
    },
    {
      "id": 187970,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. ",
      "secondary_message": null
    },
    {
      "id": 187971,
      "primary_message": "To serve, fill lettuce with sausage, salsa, and whole grilled green onion. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
