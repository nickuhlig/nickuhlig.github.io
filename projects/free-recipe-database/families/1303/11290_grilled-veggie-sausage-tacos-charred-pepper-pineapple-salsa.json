  "instructions": [
    {
      "id": 188098,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 jalapeño pepper\n1 small bunch green onions (scallions)\n½ small pineapple\n½ small bunch cilantro\n1 lime"
    },
    {
      "id": 188099,
      "primary_message": "Cut the bell pepper into quarters lengthwise; remove and discard the seeds. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 188100,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 188101,
      "primary_message": "Heat a grill pan, outdoor grill or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188102,
      "primary_message": "Trim off and discard ends of the green onions; add to the bowl. Drizzle with oil and season with spices. Toss to coat. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp cumin\n1 pinch chili powder"
    },
    {
      "id": 188103,
      "primary_message": "Working in batches if necessary, place veggies on the grill. Cook until tender and charred, 2-3 minutes per side. Return grilled veggies to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 188104,
      "primary_message": "Place sausages on the grill and reduce heat to medium. Cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate and cover with foil.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 188105,
      "primary_message": "Meanwhile, small dice grilled bell pepper, jalapeño, and half of the green onions (set aside the other half for garnish). Return chopped veggies to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 188106,
      "primary_message": "Cut off skin from pineapple, core, and small dice. Add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 188107,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 188108,
      "primary_message": "Juice half the lime into the bowl and stir to combine the salsa. Cut remaining lime into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 188109,
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional), 15-30 seconds. ",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 188110,
      "primary_message": "Meanwhile, slice sausages into ½-inch thick rounds, at an angle.",
      "secondary_message": null
    },
    {
      "id": 188111,
      "primary_message": "To serve, fill tortillas with sausage, salsa, and whole grilled green onion. Divide tacos and lime wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
