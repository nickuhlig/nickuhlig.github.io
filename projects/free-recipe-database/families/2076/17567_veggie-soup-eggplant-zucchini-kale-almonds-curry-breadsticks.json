  "instructions": [
    {
      "id": 284948,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 284949,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 eggplant\n1 medium zucchini squash\n½ bunch kale\n½ small bunch cilantro"
    },
    {
      "id": 284950,
      "primary_message": "Peel and mince ginger and garlic; place both in a small bowl, along with the spices, and set aside.",
      "secondary_message": "2 cloves garlic\n½ tsp coriander, ground\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp cinnamon, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 284951,
      "primary_message": "Trim and medium dice eggplant and zucchini; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 284952,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 284953,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add eggplant and zucchini; cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 284954,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in the reserved bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 284955,
      "primary_message": "Once the veggies start to soften, add ginger, garlic, and spices to the pan. Cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 284956,
      "primary_message": "Add broth to the pan and stir to combine the soup; cover and bring to a boil. Once boiling, reduce heat to medium, and simmer, stirring occasionally, until veggies are soft, 4-5 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 284957,
      "primary_message": "While the soup is cooking, drizzle oil over the flatbread and season with spices; cut into 1½-inch wide strips and transfer to a baking sheet pan. Place in the oven and bake until crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 flatbread or naan\n⅛ tsp curry powder\n1 pinch salt\n1 pinch cayenne pepper"
    },
    {
      "id": 284958,
      "primary_message": "When the veggies are soft, add kale to the pan in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until the kale is tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 284959,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the soup, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 284960,
      "primary_message": "Divide soup between bowls and top with almonds. Serve with breadsticks on the side and enjoy!",
      "secondary_message": "¼ cup almonds, sliced"
    }
  ],
