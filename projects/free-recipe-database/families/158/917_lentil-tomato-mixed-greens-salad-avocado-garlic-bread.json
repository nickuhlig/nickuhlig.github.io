  "instructions": [
    {
      "id": 12903,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": ""
    },
    {
      "id": 12904,
      "primary_message": "Rinse lentils under cold water and transfer to a small saucepan. Add water and salt; bring to a boil. Reduce heat to a simmer and cook until tender 15-20 minutes.",
      "secondary_message": "½ cup brown lentils\r\n1 cup water\r\n⅛ tsp salt"
    },
    {
      "id": 12905,
      "primary_message": "Peel and mince garlic. In a small bowl, mix together ¾ of the garlic (save the rest for the salad), oil, and Italian seasoning.",
      "secondary_message": "4 cloves garlic\n2 tbsp extra virgin olive oil\n1 tsp Italian seasoning"
    },
    {
      "id": 12906,
      "primary_message": "Place buns or rolls cut side up in a small baking dish. Spoon olive oil and garlic mixture on the bread.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 12907,
      "primary_message": "Place in the oven and bake until bread is crusty, 10-12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 12908,
      "primary_message": "In a small bowl, prepare dressing by whisking together remaining garlic, oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\r\n1 tbsp balsamic vinegar\r\n¼ tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 12909,
      "primary_message": "Wash and dry greens. Wash, dry, and cut tomato into wedges. Halve and pit avocado; scoop out and medium dice. Wash, trim root ends, and chop green onions. Transfer everything to a large bowl.",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)\n1 tomato\n1 avocado\n½ small bunch green onions"
    },
    {
      "id": 12910,
      "primary_message": "Drain lentils and add to bowl. Toss salad.",
      "secondary_message": ""
    },
    {
      "id": 12911,
      "primary_message": "To serve, place salad on a plate, drizzle with dressing, and have with garlic bread on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
