  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil and coat with a thin layer of oil; set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.\n\n\n",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "primary_message": "Using a box grater, coarsely grate cheddar and cream cheese into the bowl with the cilantro. Add spices, then mash with a fork (or the back of a spoon) to combine the filling. Set aside.\n\n",
      "secondary_message": "1 (227 g) block cheddar cheese\n1 (227 g) block cream cheese\n1 tsp cumin, ground\n½ tsp garlic powder\n¼ tsp black pepper"
    },
    {
      "primary_message": "Wash, dry, and halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Using a tablespoon measure, fill each jalapeño half with cheese filling. Wrap one slice of prosciutto around each jalapeño half and arrange on the baking sheet, cheese-side facing up.\n",
      "secondary_message": "24 slice prosciutto"
    },
    {
      "primary_message": "Place jalapeño poppers in the oven. Bake until jalapeños are tender and prosciutto is crispy, 15-18 minutes. Remove from oven.\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange jalapeño poppers on a serving platter. Enjoy warm!",
      "secondary_message": null
    }
  ],
