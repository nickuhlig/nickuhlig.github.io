  "instructions": [
    {
      "id": 491662,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n3 tomatoes\n1 ½ English cucumbers\n3 avocados"
    },
    {
      "id": 491663,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 491664,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 491665,
      "primary_message": "While the skillet heats up, roughly chop shrimp.",
      "secondary_message": null
    },
    {
      "id": 491666,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper; cook, stirring occasionally, until just cooked through, about 2 minutes. Remove from heat and set aside to cool, 5 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 491667,
      "primary_message": "Meanwhile, using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with ranch, ketchup, hot sauce, and spices. Stir to combine the dressing.",
      "secondary_message": "¼ cup ranch dressing\n3 tbsp ketchup\n1 ½ tbsp hot sauce\n½ tsp garlic powder\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 491668,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 491669,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 491670,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 491671,
      "primary_message": "When the shrimp are cool, add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 491672,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
