  "instructions": [
    {
      "id": 616116,
      "primary_message": "Wash and dry mangoes. Peel and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Place in a large pot.",
      "secondary_message": "3 mangoes"
    },
    {
      "id": 616117,
      "primary_message": "Wash, dry, zest, and juice limes into the pot with the mango. Add sugar, water, vanilla, and salt, then stir to combine. Set pot over medium heat and cook, stirring frequently, until mango is very soft, 4-5 minutes.",
      "secondary_message": "1 ½ limes\n3 tbsp brown sugar\n44 ml water\n1 ½ tsp vanilla extract\n¼ tsp salt"
    },
    {
      "id": 616118,
      "primary_message": "Meanwhile, place additional water and cornstarch in a small bowl. Whisk to combine the slurry and set aside.",
      "secondary_message": "1 tbsp cornstarch\n44 ml water"
    },
    {
      "id": 616119,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 616120,
      "primary_message": "Once the skillet is hot, add coconut and cook, stirring often, until golden and fragrant, 1-2 minutes. Transfer to another small bowl.",
      "secondary_message": "⅓ cup shredded unsweetened coconut"
    },
    {
      "id": 616121,
      "primary_message": "When the mango is softened, add cornstarch slurry to the pot. Continue to cook, stirring constantly, until the compote thickens, 2-3 minutes more. Remove from heat and let cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 616122,
      "primary_message": "To serve, divide ice cream and mango compote between bowls. Sprinkle with toasted coconut and enjoy!",
      "secondary_message": "1065 ml vanilla ice cream, vegan"
    }
  ],
