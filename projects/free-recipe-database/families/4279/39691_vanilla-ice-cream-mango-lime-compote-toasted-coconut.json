  "instructions": [
    {
      "id": 616046,
      "primary_message": "Wash and dry mangoes. Peel and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Place in a medium saucepan.",
      "secondary_message": "2 mangoes"
    },
    {
      "id": 616047,
      "primary_message": "Wash, dry, zest, and juice lime into the pan with the mango. Add sugar, water, vanilla, and salt, then stir to combine. Set pan over medium heat and cook, stirring frequently, until mango is very soft, 4-5 minutes.",
      "secondary_message": "1 lime\n2 tbsp brown sugar\n1 fl oz (⅛ cup) water\n1 tsp vanilla extract\n⅛ tsp salt"
    },
    {
      "id": 616048,
      "primary_message": "Meanwhile, place additional water and cornstarch in a small bowl. Whisk to combine the slurry and set aside.",
      "secondary_message": "2 tsp cornstarch\n1 fl oz (⅛ cup) water"
    },
    {
      "id": 616049,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 616050,
      "primary_message": "Once the skillet is hot, add coconut and cook, stirring often, until golden and fragrant, 1-2 minutes. Transfer to another small bowl.",
      "secondary_message": "¼ cup shredded unsweetened coconut"
    },
    {
      "id": 616051,
      "primary_message": "When the mango is softened, add cornstarch slurry to the pan. Continue to cook, stirring constantly, until the compote thickens, 1-2 minutes more. Remove from heat and let cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 616052,
      "primary_message": "To serve, divide ice cream and mango compote between bowls. Sprinkle with toasted coconut and enjoy!",
      "secondary_message": "24 fl oz (3 cups) vanilla ice cream"
    }
  ],
