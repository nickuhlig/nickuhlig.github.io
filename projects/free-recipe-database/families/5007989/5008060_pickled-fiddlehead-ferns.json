  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Smash the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 1,
      "primary_message": "Place fiddlehead ferns in a large bowl of cold water and wash well. Rub away any brown chaff and trim cut ends.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add 2 tablespoons salt to 2 quarts of water in a medium saucepan and bring to a boil over high heat. Add fiddlehead ferns and cook for 10 minutes. Drain and rinse with cold water.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine vinegar, 1/2 cup water, and 1 teaspoon salt in a small saucepan and bring to a boil. Place spices and garlic cloves into the bottom of a prepared pint jar. Pack fiddlehead ferns into the jar and add hot pickling liquid to cover.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Wipe rim, apply lid and ring and process in a small boiling water bath canner for 10 minutes. Remove jar from canner and let cool on a folded kitchen towel. When jar is cool enough to handle, remove ring and check seal.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Sealed jars can be stored in the pantry for up to one year. Unsealed jars should be refrigerated and used promptly. Let these pickles age for at least a week before eating.",
      "secondary_message": null
    }
  ],
