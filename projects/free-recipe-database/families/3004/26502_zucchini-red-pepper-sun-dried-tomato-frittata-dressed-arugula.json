  "instructions": [
    {
      "id": 429951,
      "primary_message": "Wash, dry, trim and medium dice zucchini. Place in large bowl.",
      "secondary_message": "9 medium zucchini squash"
    },
    {
      "id": 429952,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 429953,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini and spices; cook, stirring occasionally, until softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 429954,
      "primary_message": "Meanwhile, place eggs, pesto, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "18 eggs\n1 cup sun-dried tomato pesto\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 429955,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 429956,
      "primary_message": "When the zucchini is done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 429957,
      "primary_message": "While the egg is cooking, drain and roughly chop roasted peppers. ",
      "secondary_message": "1 ½ (12 oz) jars roasted red bell peppers"
    },
    {
      "id": 429958,
      "primary_message": "Sprinkle peppers and cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 4-5 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 429959,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 429960,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Add arugula to the plate and drizzle with dressing. Enjoy!",
      "secondary_message": "⅓ cup Italian salad dressing"
    }
  ],
