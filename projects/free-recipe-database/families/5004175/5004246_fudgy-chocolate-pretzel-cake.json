  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the bittersweet chocolate. Soften the unsalted butter. Melt the bittersweet chocolate and let it cool slightly. Crush the pretzel knots.",
      "secondary_message": "113 g bittersweet chocolate\n13 tbsp (6 ½ oz) unsalted butter\n142 g bittersweet chocolate\n85 g pretzel knots, divided"
    },
    {
      "id": 1,
      "primary_message": "For the cake: Adjust oven rack to middle position and preheat oven to 175°C (350°F). Grease two 23-cm cake pans and line with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place chocolate in a large bowl and pour coffee over. Whisk until melted and then cool briefly. Whisk in brown sugar, granulated sugar, salt, eggs, oil, sour cream, and vanilla until combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk flour, cocoa, baking soda, and baking power in a medium bowl. Whisk into wet mixture until smooth. Evenly divide batter between pans and bake until just set and a toothpick inserted into the center comes out with moist crumbs, 35 to 40 minutes. Let cakes cool in pans for 30 minutes, then invert onto wire racks to cool completely.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For the frosting: Mix butter, chocolate, sour cream, cocoa, and vanilla in mixer with paddle on low speed until combined. Add sugar and mix until just combined. Increase speed to medium and beat until creamy, about 1 minute. If frosting is too soft to spread onto cake, chill briefly until thickened.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Place one cake on serving plate and spread with about 2/3 cup frosting. Sprinkle almost half of the crushed pretzels on the frosting and then place the second cake on top (rounded side up). Use remaining frosting to ice top and sides of cake. Sprinkle remaining pretzels on top.",
      "secondary_message": null
    }
  ],
