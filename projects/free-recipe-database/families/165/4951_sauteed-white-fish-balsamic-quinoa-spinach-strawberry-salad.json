  "instructions": [
    {
      "id": 60158,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 60157,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 60156,
      "primary_message": "Season fish with dill, salt, and pepper. Dust both sides with flour.",
      "secondary_message": "1 ½ tsp dill\n⅜ tsp salt\n⅜ tsp black pepper\n3 tbsp all-purpose flour"
    },
    {
      "id": 60155,
      "primary_message": "Coat bottom of skillet with oil. Add fish and cook until golden, 2-3 minutes per side.",
      "secondary_message": "about 3 tbsp extra virgin olive oil"
    },
    {
      "id": 60154,
      "primary_message": "In a large bowl, prepare salad dressing by whisking together oil, vinegar, basil, salt, and pepper.",
      "secondary_message": "4 ½ tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n1 ½ tsp basil\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60153,
      "primary_message": "Wash and dry spinach. Thinly slice leaves crosswise into ribbons and add to bowl with dressing.",
      "secondary_message": "1 ½ (5 oz) pkg baby spinach"
    },
    {
      "id": 60152,
      "primary_message": "Wash strawberries, trim tops, and medium dice. Add to bowl.",
      "secondary_message": "1 ½ (16 oz) pkg strawberries"
    },
    {
      "id": 60151,
      "primary_message": "Uncover quinoa and fluff with a fork. Add to bowl and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 60150,
      "primary_message": "To serve, place fish and salad on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
