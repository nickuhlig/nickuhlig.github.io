  "instructions": [
    {
      "id": 382564,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 382565,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a small bowl along with stir-fry sauce, water, hoisin sauce, chili-garlic sauce, and garlic powder. Stir to combine the sauce and set aside.",
      "secondary_message": "1 (1 inch) piece ginger root\n⅓ cup stir-fry sauce\n2 tbsp water\n2 tbsp hoisin sauce\n2 tsp chili-garlic sauce\n¼ tsp garlic powder"
    },
    {
      "id": 382566,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 382567,
      "primary_message": "When the rice is done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 382568,
      "primary_message": "While the rice is resting, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 382569,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n½ (18 oz) bag broccoli florets"
    },
    {
      "id": 382570,
      "primary_message": "Add cabbage, edamame, and sauce to the skillet. Continue to cook, stirring occasionally, until cabbage is wilted and edamame is warmed through, about 2 minutes.",
      "secondary_message": "½ (14 oz) bag shredded cabbage (coleslaw mix)\n1 ½ cups edamame"
    },
    {
      "id": 382571,
      "primary_message": "Add rice to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 382572,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
