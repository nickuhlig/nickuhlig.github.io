  "instructions": [
    {
      "id": 382554,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 382555,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a small bowl along with stir-fry sauce, water, hoisin sauce, chili-garlic sauce, and garlic powder. Stir to combine the sauce and set aside.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 cup stir-fry sauce\n⅓ cup water\n⅓ cup hoisin sauce\n2 tbsp chili-garlic sauce\n¾ tsp garlic powder"
    },
    {
      "id": 382556,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 382557,
      "primary_message": "When the rice is done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 382558,
      "primary_message": "While the rice is resting, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 382559,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add broccoli and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil\n1 ½ (18 oz) bags broccoli florets"
    },
    {
      "id": 382560,
      "primary_message": "Meanwhile, medium dice ham.",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 382561,
      "primary_message": "When the broccoli is soft, add ham, cabbage, and sauce to the pot. Continue to cook, stirring occasionally, until cabbage is wilted and warmed through, about 3 minutes.",
      "secondary_message": "1 ½ (14 oz) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 382562,
      "primary_message": "Add rice to the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 382563,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
