  "instructions": [
    {
      "id": 217894,
      "primary_message": "Preheat oven to 400°F. Line two baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 217895,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lb sweet potatoes\n3 crowns broccoli\n1 ½ red bell peppers\n1 small pkg chives"
    },
    {
      "id": 217896,
      "primary_message": "Peel and small dice sweet potatoes; divide between baking sheets.",
      "secondary_message": null
    },
    {
      "id": 217897,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; divide between baking sheets.",
      "secondary_message": null
    },
    {
      "id": 217898,
      "primary_message": "Peel and medium dice onions; divide between baking sheets.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 217899,
      "primary_message": "Drizzle oil over veggies and season with salt and pepper; toss to coat, then spread out in an even layer. Place in the oven and bake until veggies are fork-tender, 25 -30 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 217900,
      "primary_message": "Pour broth into a medium saucepan, cover, and bring to a boil over high heat.",
      "secondary_message": "60 fl oz (7 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 217901,
      "primary_message": "Meanwhile, trim, seed, and mince bell peppers; add to the pan with the boiling broth.",
      "secondary_message": null
    },
    {
      "id": 217902,
      "primary_message": "Reduce heat to low and gradually add polenta to the pan in a thin steady stream, while whisking constantly, until the polenta is incorporated into the broth. Cook, stirring occasionally, until grains are soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "1 ½ cups polenta (cornmeal)"
    },
    {
      "id": 217903,
      "primary_message": "Meanwhile, crumble goat cheese into a small bowl.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 217904,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 217905,
      "primary_message": "When the polenta is done, add oil, goat cheese, and half of the chives to the pan and stir until smooth.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 217906,
      "primary_message": "To serve, divide polenta and veggies between bowls. Top with remaining chives and enjoy!",
      "secondary_message": null
    }
  ],
