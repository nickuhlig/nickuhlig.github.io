  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large cast iron or nonstick skillet, heat butter over medium heat until melted. Add eggs and cook until whites are mostly set, about 3 minutes. Cover and cook until whites are set on top, about 1 minute; be careful not to keep covered too long, or top of yolk will begin to cook. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer 1 egg to top of each sandwich and serve right away.",
      "secondary_message": null
