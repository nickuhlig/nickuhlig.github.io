  "instructions": [
    {
      "id": 492317,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 492318,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 492319,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "3 limes\n1 small bunch green onions (scallions)\n6 plums\n1 ½ small pkgs grape tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 492320,
      "primary_message": "Zest half of the limes into a large bowl (reserve zested limes for later use). Cut remaining limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 492321,
      "primary_message": "Add mayo and spices to the bowl with the lime zest, then whisk to combine the marinade.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tsp garlic powder\n1 ½ tsp cumin, ground\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 492322,
      "primary_message": "Large dice tofu. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": null
    },
    {
      "id": 492323,
      "primary_message": "Thread tofu onto skewers and place on a plate. (Alternatively, you can cook the tofu pieces directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 492324,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 492325,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches, add skewers and grill, turning occasionally, until the tofu is warmed through and charred in spots, about 8 minutes. Return to the plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 492326,
      "primary_message": "Meanwhile, juice reserved limes into a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 492327,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the lime juice along with oil, honey, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp honey\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 492328,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl with the dressing.",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 492329,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492330,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492331,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add the leaves to the bowl along with feta. Gently stir to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    },
    {
      "id": 492332,
      "primary_message": "Divide skewers and salad between plates. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
