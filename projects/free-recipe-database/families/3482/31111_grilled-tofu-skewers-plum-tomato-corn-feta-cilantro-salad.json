  "instructions": [
    {
      "id": 492285,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 492286,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 492287,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 lime\n½ small bunch green onions (scallions)\n2 plums\n½ small pkg grape tomatoes\n½ small bunch cilantro"
    },
    {
      "id": 492288,
      "primary_message": "Zest half of the lime into a medium bowl (reserve zested half for later use). Cut remaining lime half into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 492289,
      "primary_message": "Add mayo and spices to the bowl with the lime zest, then whisk to combine the marinade.",
      "secondary_message": "2 tbsp mayonnaise\n½ tsp garlic powder\n½ tsp cumin, ground\n¼ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 492290,
      "primary_message": "Large dice tofu. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": null
    },
    {
      "id": 492291,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 492292,
      "primary_message": "While the pan heats up, thread tofu onto skewers and place on a plate. (Alternatively, you can cook the tofu pieces directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 492293,
      "primary_message": "Once the pan is hot, coat with oil. Add skewers and grill, turning occasionally, until the tofu is warmed through and charred in spots, about 8 minutes. Return to the plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 492294,
      "primary_message": "Meanwhile, juice reserved lime into a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 492295,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the lime juice along with oil, honey, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 492296,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl with the dressing.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 492297,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492298,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492299,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add the leaves to the bowl along with feta. Gently stir to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 492300,
      "primary_message": "Divide skewers and salad between plates. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
