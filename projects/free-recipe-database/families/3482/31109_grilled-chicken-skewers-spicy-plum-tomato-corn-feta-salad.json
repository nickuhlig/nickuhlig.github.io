  "instructions": [
    {
      "id": 492255,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 492256,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 limes\n1 small bunch green onions (scallions)\n4 plums\n1 small pkg grape tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 492257,
      "primary_message": "Zest one of the limes into a medium bowl (reserve zested lime for later use). Cut remaining lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 492258,
      "primary_message": "Add mayo and spices to the bowl with the lime zest, then whisk to combine the marinade.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp garlic powder\n1 tsp cumin, ground\n½ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 492259,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 492260,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 492261,
      "primary_message": "While the pan heats up, thread chicken onto skewers and place on a plate. (Alternatively, you can cook the chicken pieces directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 492262,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 492263,
      "primary_message": "Meanwhile, juice reserved lime into a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 492264,
      "primary_message": "Using a clean cutting board, trim and cut green onions crosswise into thin pieces. Add to the bowl with the lime juice along with oil, honey, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tsp honey\n½ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 492265,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl with the dressing.",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 492266,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492267,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492268,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add the leaves to the bowl along with feta. Gently stir to combine the salad.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 492269,
      "primary_message": "Divide skewers and salad between plates. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
