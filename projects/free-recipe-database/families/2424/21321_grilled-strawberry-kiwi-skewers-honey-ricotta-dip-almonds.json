  "instructions": [
    {
      "id": 358150,
      "primary_message": "If using wooden skewers, place 6-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 358151,
      "primary_message": "Wash, dry, and trim strawberries. ",
      "secondary_message": "1 ½ (16 oz) pkg strawberries"
    },
    {
      "id": 358152,
      "primary_message": "Wash, dry, trim, and peel kiwis. Large dice the flesh.",
      "secondary_message": "6 kiwifruit"
    },
    {
      "id": 358153,
      "primary_message": "Thread strawberries and kiwi onto skewers, alternating ingredients. Place on a large plate and drizzle with oil. (If you don't have skewers, you can cook the fruit directly on the grill pan.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 358154,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 358155,
      "primary_message": "Once the pan is hot, working in batches if necessary, add the skewers and grill, turning occasionally, until fruit is lightly charred, 5-7 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 358156,
      "primary_message": "Meanwhile, place ricotta, honey, and vanilla in a medium bowl. Whisk until light, fluffy, and combined.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n3 tbsp honey\n1 ½ tsp vanilla extract"
    },
    {
      "id": 358157,
      "primary_message": "To serve, divide skewers and whipped ricotta dip between plates. Drizzle skewers with additional honey and sprinkle with almonds. Enjoy!",
      "secondary_message": "2 tbsp honey\n⅓ cup almonds, sliced"
    }
  ],
