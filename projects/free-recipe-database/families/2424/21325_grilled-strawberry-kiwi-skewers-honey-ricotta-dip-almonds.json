  "instructions": [
    {
      "id": 358182,
      "primary_message": "If using wooden skewers, place 2-4 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 358183,
      "primary_message": "Wash, dry, and trim strawberries. ",
      "secondary_message": "½ (454 g) pkg strawberries"
    },
    {
      "id": 358184,
      "primary_message": "Wash, dry, trim, and peel kiwis. Large dice the flesh.",
      "secondary_message": "2 kiwifruit"
    },
    {
      "id": 358185,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 358186,
      "primary_message": "While the pan heats up, thread strawberries and kiwi onto skewers, alternating ingredients. Place on a plate and drizzle with oil. (If you don't have skewers, you can cook the fruit directly on the grill pan.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 358187,
      "primary_message": "Once the pan is hot, add the skewers and grill, turning occasionally, until fruit is lightly charred, 5-7 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 358188,
      "primary_message": "Meanwhile, place ricotta, honey, and vanilla in a small bowl. Whisk until light, fluffy, and combined.",
      "secondary_message": "½ (425 g) pkg ricotta cheese\n1 tbsp honey\n½ tsp vanilla extract"
    },
    {
      "id": 358189,
      "primary_message": "To serve, divide skewers and whipped ricotta dip between plates. Drizzle skewers with additional honey and sprinkle with almonds. Enjoy!",
      "secondary_message": "2 tsp honey\n⅛ cup almonds, sliced"
    }
  ],
