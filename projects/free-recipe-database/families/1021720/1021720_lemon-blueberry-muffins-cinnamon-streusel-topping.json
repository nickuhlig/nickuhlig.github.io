  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. Line a 12-cup muffin pan with paper liners and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place butter in a small saucepan and melt over medium heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "primary_message": "Meanwhile, place flour, sugar, and cinnamon in a small bowl. Add melted butter and stir until combined and crumbly. Set streusel topping aside.",
      "secondary_message": "⅓ cup all-purpose flour\ngranulated sugar\n½ tsp cinnamon, ground"
    },
    {
      "primary_message": "Place additional flour, baking powder, baking soda, and salt in large bowl; whisk to combine the dry ingredients and set aside.",
      "secondary_message": "all-purpose flour\n1 tbsp baking powder\n1 tsp baking soda\n¼ tsp salt"
    },
    {
      "primary_message": "Wash, dry, zest, and juice lemon into a medium bowl. Add sugar, oil, and eggs, then whisk to combine.",
      "secondary_message": "½ lemon\n⅔ cup granulated sugar\n½ cup neutral vegetable oil"
    },
    {
      "primary_message": "Add buttermilk and vanilla to the bowl with the egg mixture and whisk once more to combine the wet ingredients. Set aside.",
      "secondary_message": "1 tsp vanilla extract"
    },
    {
      "primary_message": " Place frozen blueberries in another small bowl. Add flour, stir to coat, and set aside.",
      "secondary_message": "2 cups frozen blueberries\nall-purpose flour"
    },
    {
      "primary_message": "Add wet ingredients to the bowl with the dry ingredients and gently stir until batter is just combined.",
      "secondary_message": null
    },
    {
      "primary_message": "Add floured blueberries to the bowl and stir to incorporate (take care not to over-mix the batter).",
      "secondary_message": null
    },
    {
      "primary_message": "Fill the muffin liners three-quarters full with batter, then sprinkle with streusel topping. Place muffin pan in the oven and bake until a toothpick inserted into the center of a muffin comes out clean, 20-25 minutes. Remove from oven and allow to cool slightly, about 10 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange cooled muffins on a platter and enjoy!",
      "secondary_message": null
    }
  ],
