  "instructions": [
    {
      "id": 503880,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium parsnips\n2 medium carrots\n1 (1 inch) piece ginger root\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 503881,
      "primary_message": "Peel, trim, and medium dice parsnips and carrots. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 503882,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503883,
      "primary_message": "While the pan heats up, peel, halve, and medium dice onion. Add to the bowl with the other veggies.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 503884,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp neutral vegetable oil\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 503885,
      "primary_message": "Meanwhile, using a strainer or colander, rinse lentils under cold water; drain and set aside.",
      "secondary_message": "½ cup red lentils, dried"
    },
    {
      "id": 503886,
      "primary_message": "Peel and mince ginger and garlic. Place both in the reserved bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 503887,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the ginger and garlic. (Set remaining cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 503888,
      "primary_message": "When the veggies are soft, add ginger, garlic, and cilantro to the pan. Cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 503889,
      "primary_message": "Add lentils and broth to the pan; stir to combine and bring to a boil over high heat. Once boiling, reduce heat to a simmer, cover, and cook, stirring occasionally, until veggies and lentils are tender, 10-12 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth"
    },
    {
      "id": 503890,
      "primary_message": "Using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.)",
      "secondary_message": null
    },
    {
      "id": 503891,
      "primary_message": "Juice lime into the pan, add coconut milk, and stir to combine. Continue to cook, stirring occasionally, until heated through, about 1 minute. Remove from heat.",
      "secondary_message": "½ (13.5 fl oz) can coconut milk"
    },
    {
      "id": 503892,
      "primary_message": "To serve, divide soup between bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
