  "instructions": [
    {
      "id": 503854,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium parsnips\n4 medium carrots\n2 (1 inch) pieces ginger root\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 503855,
      "primary_message": "Peel, trim, and medium dice parsnips and carrots. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 503856,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503857,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onion. Add to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 503858,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp neutral vegetable oil\n1 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 503859,
      "primary_message": "Meanwhile, using a strainer or colander, rinse lentils under cold water; drain and set aside.",
      "secondary_message": "1 cup red lentils, dried"
    },
    {
      "id": 503860,
      "primary_message": "Peel and mince ginger and garlic. Place both in the reserved bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 503861,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the ginger and garlic. (Set remaining cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 503862,
      "primary_message": "When the veggies are soft, add ginger, garlic, and cilantro to the pot. Cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 503863,
      "primary_message": "Add lentils and broth to the pot; stir to combine and bring to a boil over high heat. Once boiling, reduce heat to a simmer, cover, and cook, stirring occasionally, until veggies and lentils are tender, 10-12 minutes.",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth"
    },
    {
      "id": 503864,
      "primary_message": "Using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.)",
      "secondary_message": null
    },
    {
      "id": 503865,
      "primary_message": "Juice lime into the pot, add cream, and stir to combine. Continue to cook, stirring occasionally, until heated through, about 1 minute. Remove from heat.",
      "secondary_message": "8 fl oz (1 cup) heavy whipping cream"
    },
    {
      "id": 503866,
      "primary_message": "To serve, divide soup between bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
