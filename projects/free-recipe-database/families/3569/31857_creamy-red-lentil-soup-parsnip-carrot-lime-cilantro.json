  "instructions": [
    {
      "id": 503867,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium parsnips\n6 medium carrots\n3 (1 inch) pieces ginger root\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 503868,
      "primary_message": "Peel, trim, and medium dice parsnips and carrots. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 503869,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503870,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onions. Add to the bowl with the other veggies.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 503871,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 503872,
      "primary_message": "Meanwhile, using a strainer or colander, rinse lentils under cold water; drain and set aside.",
      "secondary_message": "1 ½ cup red lentils, dried"
    },
    {
      "id": 503873,
      "primary_message": "Peel and mince ginger and garlic. Place both in the reserved bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 503874,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the ginger and garlic. (Set remaining cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 503875,
      "primary_message": "When the veggies are soft, add ginger, garlic, and cilantro to the pot. Cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 503876,
      "primary_message": "Add lentils and broth to the pot; stir to combine and bring to a boil over high heat. Once boiling, reduce heat to a simmer, cover, and cook, stirring occasionally, until veggies and lentils are tender, 10-12 minutes.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth"
    },
    {
      "id": 503877,
      "primary_message": "Using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.)",
      "secondary_message": null
    },
    {
      "id": 503878,
      "primary_message": "Juice limes into the pot, add cream, and stir to combine. Continue to cook, stirring occasionally, until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 503879,
      "primary_message": "To serve, divide soup between bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
