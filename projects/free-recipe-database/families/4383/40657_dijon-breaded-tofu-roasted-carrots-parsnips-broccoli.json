  "instructions": [
    {
      "id": 628605,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 628606,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 628607,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n4 medium parsnips\n2 crowns broccoli"
    },
    {
      "id": 628608,
      "primary_message": "Peel, trim, and medium dice carrots and parsnips. Transfer both to a large baking sheet.",
      "secondary_message": null
    },
    {
      "id": 628609,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the baking sheet with the other veggies, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 628610,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 628611,
      "primary_message": "Meanwhile, place mayo, Dijon, and spices in a small bowl. Stir to combine.",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp Dijon mustard\n2 tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 628612,
      "primary_message": "Cut the tofu planks in half crosswise and place on a plate. Spread half of the Dijon mayo over the top side of the tofu and sprinkle with half of the bread crumbs (pressing gently to adhere). Carefully flip tofu and repeat with remaining mayo and bread crumbs.",
      "secondary_message": "1 cup panko bread crumbs"
    },
    {
      "id": 628613,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 628614,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry until golden brown and warmed through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 628615,
      "primary_message": "To serve, divide veggies and tofu between plates. Enjoy!",
      "secondary_message": null
    }
  ],
