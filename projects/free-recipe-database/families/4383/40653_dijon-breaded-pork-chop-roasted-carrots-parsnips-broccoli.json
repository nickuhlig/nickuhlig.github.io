  "instructions": [
    {
      "id": 628564,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 628565,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 medium parsnips\n1 crown broccoli"
    },
    {
      "id": 628566,
      "primary_message": "Peel, trim, and medium dice carrots and parsnips. Transfer both to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 628567,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the baking sheet with the other veggies, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 628568,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 628569,
      "primary_message": "Meanwhile, place mayo, Dijon, and spices in a small bowl. Stir to combine.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp Dijon mustard\n1 tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 628570,
      "primary_message": "Pat pork chops dry with paper towels and place on a plate. Spread half of the Dijon mayo over the top side of the chops and sprinkle with half of the bread crumbs (pressing gently to adhere). Carefully flip chops and repeat with remaining mayo and bread crumbs.",
      "secondary_message": "2 pork chops, boneless\n½ cup panko bread crumbs"
    },
    {
      "id": 628571,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 628572,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 628573,
      "primary_message": "To serve, divide veggies and pork chops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
