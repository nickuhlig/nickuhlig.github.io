  "instructions": [
    {
      "id": 447501,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp white wine vinegar\n¾ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 447502,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 447503,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg cremini mushrooms\n1 jalapeño pepper\n½ lime\n½ small bunch cilantro\n1 avocado"
    },
    {
      "id": 447504,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 447505,
      "primary_message": "While the skillet heats up, thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 447506,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until golden brown and tender, 8-10 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 447507,
      "primary_message": "Meanwhile, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and place in another small bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 447508,
      "primary_message": "Juice lime into the bowl with the jalapeño.",
      "secondary_message": null
    },
    {
      "id": 447509,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince half of the leaves. Add to the bowl. (Reserve remaining whole leaves for serving.)",
      "secondary_message": null
    },
    {
      "id": 447510,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh. Add to the bowl, along with salt, and mash with a fork until semi-smooth. Set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 447511,
      "primary_message": "Crack eggs into a medium bowl, then season with salt. Whisk until smooth.",
      "secondary_message": "4 eggs\n⅛ tsp salt"
    },
    {
      "id": 447512,
      "primary_message": "When the mushrooms are done, add vinegar to the skillet, and stir to combine.",
      "secondary_message": "½ tsp white wine vinegar"
    },
    {
      "id": 447513,
      "primary_message": "Pour egg mixture into the skillet with the mushrooms and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove from heat, add feta, and stir to combine.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 447514,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 447515,
      "primary_message": "To serve, divide tortillas between plates; fill with mashed avocado, mushroom scramble, and pickled onion. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
