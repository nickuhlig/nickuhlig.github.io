  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine soy sauce, honey, pepper, ginger, and red pepper flakes in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place the rehydrated beancurd sticks in a pot and cover with water. Simmer until tender, about 10 minutes. Remove from the water and let cool.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When you are ready to serve, pat beancurd sticks dry and cut into 5-cm segments. Place them on a rimmed baking sheet lined with foil. Brush glaze onto beancurd sticks. Place them under the broiler and cook until the tops are a little crisp, 3 to 5 minutes. Check during the last minute to prevent scorching. Serve immediately.",
      "secondary_message": null
    }
  ],
