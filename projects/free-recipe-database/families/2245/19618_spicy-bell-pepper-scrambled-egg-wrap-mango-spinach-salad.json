  "instructions": [
    {
      "id": 326451,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ limes\n3 mangoes\n3 red bell peppers\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 326452,
      "primary_message": "Peel and mince shallots and garlic; place both in a large bowl.",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 326453,
      "primary_message": "Juice limes into the bowl with the shallot and garlic, then add oil and spices; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 326454,
      "primary_message": "Peel mangos and slice flesh away from the pits, starting with the flat sides; medium dice and add to the bowl with the dressing. Set aside.",
      "secondary_message": null
    },
    {
      "id": 326455,
      "primary_message": "Trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 326456,
      "primary_message": "Crack eggs into another large bowl and whisk until smooth.",
      "secondary_message": "18 eggs"
    },
    {
      "id": 326457,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 326458,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper and spices. Cook, stirring occasionally, until tender, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 326459,
      "primary_message": "When the bell pepper is done, pour the eggs into the skillet. Scramble the eggs using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 326460,
      "primary_message": "While the eggs are cooking, add spinach to the bowl with the dressing and mango; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 326461,
      "primary_message": "Place tortillas on a flat surface and divide scrambled eggs between them; roll tightly to close.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 326462,
      "primary_message": "Cut wraps in half and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
