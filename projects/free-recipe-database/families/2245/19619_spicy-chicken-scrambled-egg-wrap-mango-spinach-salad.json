  "instructions": [
    {
      "id": 326463,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lime\n1 mango\n½ red bell pepper\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 326464,
      "primary_message": "Peel and mince shallot and garlic; place both in a medium bowl.",
      "secondary_message": "½ shallot\n1 clove garlic"
    },
    {
      "id": 326465,
      "primary_message": "Juice lime into the bowl with the shallot and garlic, then add oil and spices; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 326466,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice and add to the bowl with the dressing. Set aside.",
      "secondary_message": null
    },
    {
      "id": 326467,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 326468,
      "primary_message": "While the skillet heats up, trim, seed, and small dice bell pepper.",
      "secondary_message": null
    },
    {
      "id": 326469,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper, chicken, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n0.23 kg ground chicken\n1 tsp chili powder\n½ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 326470,
      "primary_message": "Meanwhile, crack eggs into a small bowl and whisk until smooth.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 326471,
      "primary_message": "When the chicken is done, pour eggs into the skillet. Scramble the eggs using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 326472,
      "primary_message": "While the eggs are cooking, add spinach to the bowl with the dressing and mango; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 326473,
      "primary_message": "Place tortillas on a flat surface and divide chicken-egg scramble between them; roll tightly to close.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 326474,
      "primary_message": "Cut wraps in half and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
