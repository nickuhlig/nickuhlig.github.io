  "instructions": [
    {
      "id": 326439,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lime\n2 mangoes\n2 red bell peppers\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 326440,
      "primary_message": "Peel and mince shallot and garlic; place both in a medium bowl.",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 326441,
      "primary_message": "Juice lime into the bowl with the shallot and garlic, then add oil and spices; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 326442,
      "primary_message": "Peel mangos and slice flesh away from the pits, starting with the flat sides; medium dice and add to the bowl with the dressing. Set aside.",
      "secondary_message": null
    },
    {
      "id": 326443,
      "primary_message": "Trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 326444,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 326445,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper and spices. Cook, stirring occasionally, until tender, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp chili powder\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 326446,
      "primary_message": "Meanwhile, crack eggs into another medium bowl and whisk until smooth.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 326447,
      "primary_message": "When the bell pepper is done, pour the eggs into the skillet. Scramble the eggs using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 326448,
      "primary_message": "While the eggs are cooking, add spinach to the bowl with the dressing and mango; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 326449,
      "primary_message": "Place tortillas on a flat surface and divide scrambled eggs between them; roll tightly to close.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 326450,
      "primary_message": "Cut wraps in half and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
