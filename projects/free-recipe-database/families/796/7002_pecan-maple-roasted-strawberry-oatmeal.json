  "instructions": [
    {
      "id": 101254,
      "primary_message": "Preheat oven to 400°F. Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 101255,
      "primary_message": "Wash and dry strawberries; trim stem ends and slice.",
      "secondary_message": "1 (16 oz) pkg strawberries"
    },
    {
      "id": 101256,
      "primary_message": "Transfer strawberries to baking sheet, drizzle with maple syrup, and spread out in a single layer. Roast until softened, 10-13 minutes.",
      "secondary_message": "2 tbsp pure maple syrup"
    },
    {
      "id": 101257,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 101258,
      "primary_message": "Add salt and water to a medium saucepan and bring to a boil over high heat. Once boiling, stir in oats and reduce heat to medium. Cover and let simmer for 3-5 minutes or until oats reach desired consistency.",
      "secondary_message": "1 pinch salt\n1 ¾ cup water\n1 cup oats, quick cooking"
    },
    {
      "id": 101259,
      "primary_message": "To serve, divide oats between bowls and top with strawberries, pecans, and almond milk. Enjoy!",
      "secondary_message": "4 fl oz (½ cup) almond milk, unsweetened"
    }
  ],
