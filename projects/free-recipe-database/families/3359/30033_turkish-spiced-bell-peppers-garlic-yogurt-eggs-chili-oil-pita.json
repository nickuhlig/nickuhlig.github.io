  "instructions": [
    {
      "id": 477945,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 477946,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 red bell peppers\n3 yellow bell peppers\n3 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 477947,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 477948,
      "primary_message": "Peel, halve, and slice onions crosswise into ¼-inch thick half-moons. Add to the baking sheets with the peppers. Drizzle veggies with oil and season with salt; stir to coat and spread out in an even layer.",
      "secondary_message": "3 medium red onions\n3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 477949,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are browned and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 477950,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 477951,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom. Add spices and cook, stirring frequently, until fragrant, about 30 seconds. Carefully transfer hot oil to a small bowl and set aside. (Reserve skillet for later use.)",
      "secondary_message": "¼ cup extra virgin olive oil\n¾ tsp smoked paprika\n¾ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 477952,
      "primary_message": "Zest and juice half of the lemons into a medium bowl. (Reserve remaining lemons for later use.)",
      "secondary_message": null
    },
    {
      "id": 477953,
      "primary_message": "Add yogurt, garlic powder, and salt to the bowl with the lemon. Whisk to combine the garlicky yogurt and set aside.",
      "secondary_message": "2 ¼ cups plain Greek yogurt\n1 ½ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 477954,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477955,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tbsp extra virgin olive oil\n12 eggs\n3 pinch salt"
    },
    {
      "id": 477956,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 477957,
      "primary_message": "Add mint to the baking sheets with the roasted veggies, then squeeze reserved lemons over top and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 477958,
      "primary_message": "Toast pita breads (if desired), then cut into wedges.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 477959,
      "primary_message": "Divide garlicky yogurt between plates or bowls. Top with roasted veggies and eggs, then drizzle with chili oil. Serve with pita on the side and enjoy!",
      "secondary_message": null
    }
  ],
