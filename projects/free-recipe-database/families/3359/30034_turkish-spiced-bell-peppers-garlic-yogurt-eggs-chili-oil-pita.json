  "instructions": [
    {
      "id": 477960,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 477961,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 yellow bell pepper\n1 lemon\n½ small pkg fresh mint"
    },
    {
      "id": 477962,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 477963,
      "primary_message": "Peel, halve, and slice onion crosswise into ¼-inch thick half-moons. Add to the baking sheet with the peppers. Drizzle veggies with oil and season with salt; stir to coat and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 477964,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are browned and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 477965,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 477966,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add spices and cook, stirring frequently, until fragrant, about 30 seconds. Carefully transfer hot oil to a small bowl and set aside. (Reserve skillet for later use.)",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp smoked paprika\n¼ tsp crushed red pepper\n⅛ tsp salt"
    },
    {
      "id": 477967,
      "primary_message": "Zest and juice half of the lemon into another small bowl. (Reserve remaining lemon for later use.)",
      "secondary_message": null
    },
    {
      "id": 477968,
      "primary_message": "Add yogurt, garlic powder, and salt to the bowl with the lemon. Whisk to combine the garlicky yogurt and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 477969,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477970,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs\n1 pinch salt"
    },
    {
      "id": 477971,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 477972,
      "primary_message": "Add mint to the baking sheet with the roasted veggies, then squeeze reserved lemon over top and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 477973,
      "primary_message": "Toast pita breads (if desired), then cut into wedges.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 477974,
      "primary_message": "Divide garlicky yogurt between plates or bowls. Top with roasted veggies and eggs, then drizzle with chili oil. Serve with pita on the side and enjoy!",
      "secondary_message": null
    }
  ],
