  "instructions": [
    {
      "id": 197188,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 197189,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 lb sweet potato\n1 English cucumber\n½ small bunch cilantro"
    },
    {
      "id": 197190,
      "primary_message": "Zest lemon into a small bowl, add yogurt, and whisk to combine. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt"
    },
    {
      "id": 197191,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 197192,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, honey, and spices; whisk to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp honey\n1 tsp thyme\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 197193,
      "primary_message": "Peel, halve, and thinly slice the sweet potatoes into half rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197194,
      "primary_message": "Peel, trim, and cut the onion into thick wedges; add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 197195,
      "primary_message": "Cut the chicken into small bite-sized pieces; add to the bowl with the veggies and toss to coat.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 197196,
      "primary_message": "Transfer chicken and veggies to a large baking sheet pan and arrange in a single layer. Place in the oven and bake, tossing once, until the chicken is cooked through and veggies are fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 197197,
      "primary_message": "Meanwhile, trim and thinly slice the cucumber; place in a medium bowl along with the salt and pepper.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 197198,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the cucumber and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 197199,
      "primary_message": "To serve, divide chicken, roasted veggies, and cucumber salad between plates. Serve with lemon yogurt on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
