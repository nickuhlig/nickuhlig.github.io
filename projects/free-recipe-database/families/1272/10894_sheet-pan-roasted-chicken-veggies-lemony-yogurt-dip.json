  "instructions": [
    {
      "id": 197251,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 197252,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n0.23 kg sweet potato\n½ English cucumber\n½ small bunch cilantro"
    },
    {
      "id": 197253,
      "primary_message": "Zest lemon into a small bowl, add yogurt, and whisk to combine. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 197254,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 197255,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, honey, and spices; whisk to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp honey\n½ tsp thyme\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 197256,
      "primary_message": "Peel, halve, and thinly slice the sweet potato into half rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197257,
      "primary_message": "Peel, trim, and cut the onion into thick wedges; add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 197258,
      "primary_message": "Cut the chicken into small bite-sized pieces; add to the bowl with the veggies and toss to coat.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 197259,
      "primary_message": "Transfer chicken and veggies to a baking sheet pan and arrange in a single layer. Place in the oven and bake, tossing once, until the chicken is cooked through and veggies are fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 197260,
      "primary_message": "Meanwhile, using a clean cutting board, trim and thinly slice the cucumber; place in a medium bowl along with the salt and pepper.",
      "secondary_message": "⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 197261,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the cucumber and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 197262,
      "primary_message": "To serve, divide chicken, roasted veggies, and cucumber salad between plates. Serve with lemon yogurt on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
