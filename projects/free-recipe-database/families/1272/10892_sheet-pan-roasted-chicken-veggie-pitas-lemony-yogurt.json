  "instructions": [
    {
      "id": 197225,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 197226,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n0.45 kg sweet potato\n1 English cucumber\n1 small bunch cilantro"
    },
    {
      "id": 197227,
      "primary_message": "Zest lemons into a small bowl, add yogurt, and whisk to combine. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt"
    },
    {
      "id": 197228,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 197229,
      "primary_message": "Juice lemons into the bowl with the garlic. Add oil, honey, and spices; whisk to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp thyme\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 197230,
      "primary_message": "Cut the chicken into small bite-sized pieces and add to the bowl.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 197231,
      "primary_message": "Peel, halve, and thinly slice the sweet potatoes into half rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197232,
      "primary_message": "Peel, trim, and cut the onion into thick wedges; add to the bowl and toss to coat.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 197233,
      "primary_message": "Transfer chicken and veggies to a large baking sheet pan and arrange in a single layer. Place in the oven and bake, tossing once, until the chicken is cooked through and veggies are fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 197234,
      "primary_message": "Meanwhile, trim and thinly slice the cucumber; place in a medium bowl along with the salt and pepper.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 197235,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add half to the bowl with the cucumber and toss to combine; reserve the other half for garnish.",
      "secondary_message": null
    },
    {
      "id": 197236,
      "primary_message": "Toast pitas if desired.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 197237,
      "primary_message": "To serve, divide pitas between plates and spread with lemon yogurt. Top with chicken, veggies, cucumbers, and remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
