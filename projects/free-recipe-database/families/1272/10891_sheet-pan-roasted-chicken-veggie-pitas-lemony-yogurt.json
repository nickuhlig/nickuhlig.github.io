  "instructions": [
    {
      "id": 197212,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 197213,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n0.23 kg sweet potato\n½ English cucumber\n½ small bunch cilantro"
    },
    {
      "id": 197214,
      "primary_message": "Zest lemon into a small bowl, add yogurt, and whisk to combine. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 197215,
      "primary_message": "Peel and mince garlic; place a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 197216,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, honey, and spices; whisk to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp honey\n½ tsp thyme\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 197217,
      "primary_message": "Cut the chicken into small bite-sized pieces and add to the bowl.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 197218,
      "primary_message": "Peel, halve, and thinly slice the sweet potato into half rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197219,
      "primary_message": "Peel, trim, and cut the onion into thick wedges; add to the bowl and toss to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 197220,
      "primary_message": "Transfer chicken and veggies to a baking sheet pan and arrange in a single layer. Place in the oven and bake, tossing once, until the chicken is cooked through and veggies are fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 197221,
      "primary_message": "Meanwhile, trim and thinly slice the cucumber; place in another medium bowl along with the salt and pepper.",
      "secondary_message": "⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 197222,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add half to the bowl with the cucumber and toss to combine; reserve the other half for garnish.",
      "secondary_message": null
    },
    {
      "id": 197223,
      "primary_message": "Toast pitas if desired.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 197224,
      "primary_message": "To serve, divide pitas between plates and spread with lemon yogurt. Top with chicken, veggies, cucumbers, and remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
