  "instructions": [
    {
      "id": 197200,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 197201,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ lb sweet potatoes\n1 ½ English cucumbers\n1 small bunch cilantro"
    },
    {
      "id": 197202,
      "primary_message": "Zest lemons into a small bowl, add yogurt, and whisk to combine. Set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt"
    },
    {
      "id": 197203,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 197204,
      "primary_message": "Juice lemons into the bowl with the garlic. Add oil, honey, and spices; whisk to combine.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp honey\n1 ½ tsp thyme\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 197205,
      "primary_message": "Peel, halve, and thinly slice the sweet potatoes into half rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197206,
      "primary_message": "Peel, trim, and cut the onions into thick wedges; add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 197207,
      "primary_message": "Cut the chicken into small bite-sized pieces; add to the bowl with the veggies and toss to coat.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 197208,
      "primary_message": "Divide chicken and veggies between two baking sheet pans and arrange in a single layer. Place in the oven and bake, tossing once, until the chicken is cooked through and veggies are fork-tender, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 197209,
      "primary_message": "Meanwhile, trim and thinly slice the cucumber; place in a medium bowl along with the salt and pepper.",
      "secondary_message": "⅜ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 197210,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the cucumber and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 197211,
      "primary_message": "To serve, divide chicken, roasted veggies, and cucumber salad between plates. Serve with lemon yogurt on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
