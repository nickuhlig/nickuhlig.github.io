  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to center position and preheat oven to 325°F. Line rimmed baking sheet with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In small pot over medium-low heat, melt butter. Stir occasionally. After foam subsides, watch butter until milk solids turn golden brown, about five minutes. Remove pot from heat and allow butter to cool. While butter cools, whisk together white rice flour, sweet rice flour, cornstarch, baking soda, and baking powder in medium bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In bowl of stand mixer fitted with paddle attachment, combine brown sugar, golden syrup, and cooled brown butter. Mix on medium speed to combine. Stop mixer. Add dry ingredients. Turn mixer on to medium. Blend until a thick dough forms. Dough will be dry. Add egg yolks. Blend until smooth dough forms. Stop mixer. Add chocolate chips. Turn mixer to low. Mix until chocolate chips are incorporated.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Drop dough, about one tablespoon each, onto prepared baking sheet. Space dough about two inches apart. Bake until edges are just set and cookies are faintly golden brown, about 13 minutes. (For softer and chewier cookies, bake until cookies are just set.) Remove cookies and allow to cool on baking sheet for two minutes. Transfer cookies to wire rack to cool completely. Repeat with remaining dough.",
      "secondary_message": null
    }
  ],
