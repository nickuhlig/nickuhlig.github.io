  "instructions": [
    {
      "id": 379836,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 379837,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 leeks\n3 oranges\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 379838,
      "primary_message": "Trim off root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 379839,
      "primary_message": "Add butternut squash to the baking sheets with the leek. Drizzle veggies with oil and vinegar, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "6 cup frozen butternut squash, pieces\n3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 379840,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 379841,
      "primary_message": "Meanwhile, drain and rinse lentils. Set aside to drain further. ",
      "secondary_message": "3 (255 g) cans lentils"
    },
    {
      "id": 379842,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Place in a large bowl along with spinach and pumpkin seeds. Set aside. ",
      "secondary_message": "⅓ cup pumpkin seeds"
    },
    {
      "id": 379843,
      "primary_message": "When the veggies are done, remove from oven and let cool slightly, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 379844,
      "primary_message": "Add warm veggies, lentils, and dressing to the bowl with the orange and spinach. Toss to combine the salad. ",
      "secondary_message": "¾ cup Italian salad dressing"
    },
    {
      "id": 379845,
      "primary_message": "To serve, divide salad between plates or bowls and crumble goat cheese over top. Enjoy!",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    }
  ],
