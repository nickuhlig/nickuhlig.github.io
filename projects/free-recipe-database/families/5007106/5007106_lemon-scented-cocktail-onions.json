  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine coriander seed, juniper berries, white peppercorns, thyme, lemon zest, lime zest, vinegar, water, sugar, and salt in a medium saucepan. Heat over low heat and stir until salt and sugar dissolve, about five minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add onions. Bring to a boil; allow to boil for just one minute, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cool to room temperature. Add vermouth and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove onions and pickling liquid to a jar. Leave at room temperature for 1 hour, and refrigerate overnight before using.",
      "secondary_message": null
    }
  ],
