  "instructions": [
    {
      "id": 356066,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 356067,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 356068,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 yellow bell pepper\n2 medium carrots\n½ small bunch green onions (scallions)"
    },
    {
      "id": 356069,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 356070,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 356071,
      "primary_message": "Peel, trim, and halve carrots lengthwise, then cut crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 356072,
      "primary_message": "Trim green onions and mince the white parts; add to the bowl. Cut green parts crosswise into ¼-inch pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 356073,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 356074,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add sausage and cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Using a slotted spoon, transfer sausage to a plate (leaving drippings in the skillet) and loosely cover with aluminum foil.",
      "secondary_message": "1 tsp extra virgin olive oil\n½ lb ground pork sausage"
    },
    {
      "id": 356075,
      "primary_message": "Meanwhile, place ketchup, vinegar, sugar, Worcestershire, and salt in a small bowl; whisk to combine the sauce.",
      "secondary_message": "⅓ cup ketchup\n¼ cup rice vinegar\n1 tbsp brown sugar\n1 tsp Worcestershire sauce\n½ tsp salt"
    },
    {
      "id": 356076,
      "primary_message": "Once the sausage is done, return the skillet (with drippings) to medium-high heat; add veggies and cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 356077,
      "primary_message": "When the veggies are done, return cooked sausage to the skillet; add sauce, stir to combine, and cook until sauce is warmed through and sausage is coated, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 356078,
      "primary_message": "To serve, divide rice, sweet 'n' sour pork, and veggies between plates or bowls; top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
