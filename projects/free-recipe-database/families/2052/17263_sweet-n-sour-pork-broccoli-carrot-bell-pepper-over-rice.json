  "instructions": [
    {
      "id": 356131,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 356132,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 356133,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 yellow bell peppers\n6 medium carrots\n1 small bunch green onions (scallions)"
    },
    {
      "id": 356134,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 356135,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 356136,
      "primary_message": "Peel, trim, and halve carrots lengthwise, then cut crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 356137,
      "primary_message": "Trim green onions and mince the white parts; add to the bowl. Cut green parts crosswise into ¼-inch pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 356138,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 356139,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add sausage and cook, breaking the meat apart with a spoon, until browned and crumbly, 6-7 minutes. Using a slotted spoon, transfer sausage to a plate (leaving drippings in the pot) and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil\n0.68 kg ground pork sausage"
    },
    {
      "id": 356140,
      "primary_message": "Meanwhile, place ketchup, vinegar, sugar, Worcestershire, and salt in a small bowl; whisk to combine the sauce.",
      "secondary_message": "1 cup ketchup\n¾ cup rice vinegar\n3 tbsp brown sugar\n1 tbsp Worcestershire sauce\n1 ½ tsp salt"
    },
    {
      "id": 356141,
      "primary_message": "Once the sausage is done, return the pot (with drippings) to medium-high heat; add veggies and cook, stirring occasionally, until softened, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 356142,
      "primary_message": "When the veggies are done, return cooked sausage to the pot; add sauce, stir to combine, and cook until sauce is warmed through and sausage is coated, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 356143,
      "primary_message": "To serve, divide rice, sweet 'n' sour pork, and veggies between plates or bowls; top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
