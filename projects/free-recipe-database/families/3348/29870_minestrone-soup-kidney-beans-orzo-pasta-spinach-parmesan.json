  "instructions": [
    {
      "id": 475644,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 (142 g) pkg baby spinach\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 475645,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 475646,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 475647,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the carrot and celery.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 475648,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 475649,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (398 ml) cans kidney beans"
    },
    {
      "id": 475650,
      "primary_message": "When the veggies are soft, add beans, broth, tomatoes, and orzo to the pot. Stir to combine and bring to a boil over high heat. Once the soup is boiling, reduce heat and simmer until the orzo is tender, 8-10 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n2 (398 ml) cans diced tomatoes\n170 g orzo pasta"
    },
    {
      "id": 475651,
      "primary_message": "While the soup is cooking, roughly chop spinach. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 475652,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 475653,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 475654,
      "primary_message": "When the orzo is tender, add spinach and parsley to the pot in handfuls, waiting for the greens to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 475655,
      "primary_message": "To serve, divide soup between bowls, then drizzle with vinegar and top with Parmesan. Enjoy!",
      "secondary_message": "4 tsp balsamic vinegar"
    }
  ],
