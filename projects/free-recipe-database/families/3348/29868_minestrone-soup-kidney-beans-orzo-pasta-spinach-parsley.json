  "instructions": [
    {
      "id": 475621,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium carrots\n3 sticks celery\n1 ½ (5 oz) pkgs baby spinach\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 475622,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 475623,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl with the carrot and celery.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 475624,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 475625,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 475626,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (15 oz) cans kidney beans"
    },
    {
      "id": 475627,
      "primary_message": "When the veggies are soft, add beans, broth, tomatoes, and orzo to the pot. Stir to combine and bring to a boil over high heat. Once the soup is boiling, reduce heat and simmer until the orzo is tender, 8-10 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes\n9 oz orzo pasta"
    },
    {
      "id": 475628,
      "primary_message": "While the soup is cooking, roughly chop spinach. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 475629,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 475630,
      "primary_message": "When the orzo is tender, add spinach and parsley to the pot in handfuls, waiting for the greens to wilt slightly before adding the next handful. Add nutritional yeast, stir to combine, and remove from heat.",
      "secondary_message": "⅓ cup nutritional yeast flakes"
    },
    {
      "id": 475631,
      "primary_message": "To serve, divide soup between bowls and drizzle with vinegar. Enjoy!",
      "secondary_message": "2 tbsp balsamic vinegar"
    }
  ],
