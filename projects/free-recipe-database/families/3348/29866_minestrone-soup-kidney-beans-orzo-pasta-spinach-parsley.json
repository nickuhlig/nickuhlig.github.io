  "instructions": [
    {
      "id": 475599,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium carrot\n1 stick celery\n½ (5 oz) pkg baby spinach\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 475600,
      "primary_message": "Peel, trim, and small dice carrot. Trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 475601,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 475602,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the carrot and celery.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 475603,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 475604,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can kidney beans"
    },
    {
      "id": 475605,
      "primary_message": "When the veggies are soft, add beans, broth, tomatoes, and orzo to the pan. Stir to combine and bring to a boil over high heat. Once the soup is boiling, reduce heat and simmer until the orzo is tender, 8-10 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes\n3 oz orzo pasta"
    },
    {
      "id": 475606,
      "primary_message": "While the soup is cooking, roughly chop spinach. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 475607,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 475608,
      "primary_message": "When the orzo is tender, add spinach and parsley to the pan in handfuls, waiting for the greens to wilt slightly before adding the next handful. Add nutritional yeast, stir to combine, and remove from heat.",
      "secondary_message": "⅛ cup nutritional yeast flakes"
    },
    {
      "id": 475609,
      "primary_message": "To serve, divide soup between bowls and drizzle with vinegar. Enjoy!",
      "secondary_message": "2 tsp balsamic vinegar"
    }
  ],
