  "instructions": [
    {
      "id": 25741,
      "primary_message": "Wash the zucchini and mushrooms. Trim the zucchini ends and using a julienne peeler (or regular peeler) peel into noodle-like sticks; transfer to a large bowl. Thinly slice the mushrooms; transfer to a small bowl. Peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "2 medium zucchini squash\r\n0.113 kg white mushrooms\r\n3 cloves garlic"
    },
    {
      "id": 25742,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 25743,
      "primary_message": "Slice the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.227 kg chicken breasts, boneless skinless\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 25744,
      "primary_message": "Melt butter in the sauté pan and swirl to coat bottom. Add chicken and cook until golden brown and cooked through, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "½ tbsp butter, unsalted\r\n"
    },
    {
      "id": 25745,
      "primary_message": "Coarsely grate ½ cup of Parmesan.",
      "secondary_message": "56 g Parmesan cheese\r\n"
    },
    {
      "id": 25746,
      "primary_message": "Once the chicken has been removed, melt remaining butter in the sauté pan. Add the garlic and cook until fragrant, 15-30 seconds.",
      "secondary_message": "2 tbsp butter, unsalted\r\n"
    },
    {
      "id": 25747,
      "primary_message": "Add the sliced mushrooms and cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25748,
      "primary_message": "Add the cream and bring to a simmer. Stir in the cheese, salt, and pepper.",
      "secondary_message": "118 ml (½ cup) heavy cream\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 25749,
      "primary_message": "Add the zucchini noodles to the sauce and gently toss until well coated.",
      "secondary_message": ""
    },
    {
      "id": 25750,
      "primary_message": "Slice the chicken crosswise on an angle.",
      "secondary_message": ""
    },
    {
      "id": 25751,
      "primary_message": "To serve, place fettuccine alfredo in a bowl or on a plate, top with chicken, and garnish with freshly ground pepper. Enjoy!",
      "secondary_message": ""
    }
  ],
