  "instructions": [
    {
      "id": 374966,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n1 ½ bunches kale\n3 leeks"
    },
    {
      "id": 374967,
      "primary_message": "Peel and medium dice potatoes. Place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 374968,
      "primary_message": "Meanwhile fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 374969,
      "primary_message": "Trim off root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 374970,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 374971,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 374972,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add leek, garlic, and salt; cook, stirring frequently, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt"
    },
    {
      "id": 374973,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until tender, 2-3 minutes more. Return sautéed veggies to the bowl. (Reserve the skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 374974,
      "primary_message": "Return the skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "1 tbsp butter, unsalted\n6 pork sausages"
    },
    {
      "id": 374975,
      "primary_message": "When the potatoes are done, drain in a colander and return to the pot. Add milk, butter, and spices; using a potato masher, mash until smooth.",
      "secondary_message": "177 ml whole milk\n2 tbsp butter, unsalted\n¾ tsp salt\n½ tsp black pepper\n½ tsp nutmeg, ground"
    },
    {
      "id": 374976,
      "primary_message": "Add sautéed veggies to the pot with the mashed potatoes and stir to combine. Cover to keep warm and set aside.",
      "secondary_message": null
    },
    {
      "id": 374977,
      "primary_message": "Place yogurt, Dijon, vinegar, honey, salt, and pepper in a small bowl. Stir to combine the sauce.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp Dijon mustard\n2 tbsp white wine vinegar\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 374978,
      "primary_message": "To serve, divide sausages and potato-kale mash between plates. Drizzle with Dijon yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
