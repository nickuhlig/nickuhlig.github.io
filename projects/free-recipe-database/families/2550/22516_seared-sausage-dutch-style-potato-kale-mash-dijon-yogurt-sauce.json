  "instructions": [
    {
      "id": 374862,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n½ bunch kale\n1 leek"
    },
    {
      "id": 374863,
      "primary_message": "Peel and medium dice potatoes. Place in a medium saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 374864,
      "primary_message": "Meanwhile fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 374865,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 374866,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 374867,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 374868,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add leek, garlic, and salt; cook, stirring frequently, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n⅛ tsp salt"
    },
    {
      "id": 374869,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until tender, 1-2 minutes more. Return sautéed veggies to the bowl. (Reserve the skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 374870,
      "primary_message": "Return the skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "1 tsp butter, unsalted\n2 pork sausages"
    },
    {
      "id": 374871,
      "primary_message": "When the potatoes are done, drain in a colander and return to the saucepan. Add milk, butter, and spices; using a potato masher, mash until smooth.",
      "secondary_message": "2 fl oz (¼ cup) whole milk\n2 tsp butter, unsalted\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp nutmeg, ground"
    },
    {
      "id": 374872,
      "primary_message": "Add sautéed veggies to the pan with the mashed potatoes and stir to combine. Cover to keep warm and set aside.",
      "secondary_message": null
    },
    {
      "id": 374873,
      "primary_message": "Place yogurt, Dijon, vinegar, honey, salt, and pepper in a small bowl. Stir to combine the sauce.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp Dijon mustard\n2 tsp white wine vinegar\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 374874,
      "primary_message": "To serve, divide sausages and potato-kale mash between plates. Drizzle with Dijon yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
