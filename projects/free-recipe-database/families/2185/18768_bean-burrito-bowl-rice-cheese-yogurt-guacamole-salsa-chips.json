  "instructions": [
    {
      "id": 417639,
      "primary_message": "Drain and rinse beans; transfer to a medium saucepan.",
      "secondary_message": "2 (398 ml) cans pinto beans"
    },
    {
      "id": 417640,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and add to the pan with the beans. Add water and taco seasoning; bring the mixture to a boil over high heat.",
      "secondary_message": "⅔ cup basmati rice\n1 ⅓ cup water\n3 tbsp taco seasoning"
    },
    {
      "id": 417641,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook until liquid is fully absorbed, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 417642,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 hearts romaine hearts\n1 small pkg grape tomatoes\n1 bunch radish\n1 lime"
    },
    {
      "id": 417643,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 417644,
      "primary_message": "Halve tomatoes and add to the bowl with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 417645,
      "primary_message": "Trim and thinly slice radishes; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 417646,
      "primary_message": "Slice lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 417647,
      "primary_message": "Divide rice and beans, salad, chips, cheese, yogurt, and lime wedges between bowls; serve with guacamole and salsa on the side. Enjoy!",
      "secondary_message": "113 g tortilla chips\n1 cup shredded cheese, Mexican blend\n⅔ cup plain Greek yogurt\n1 cup guacamole\n⅔ cup salsa"
    }
  ],
