  "instructions": [
    {
      "id": 144485,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 144486,
      "primary_message": "Once the skillet is hot, add bacon and cook until crispy, 4-5 minutes per side. Cook in batches if necessary.",
      "secondary_message": "9 slices bacon"
    },
    {
      "id": 144487,
      "primary_message": "Meanwhile, toast bread if desired, cut in half, and spread with mayonnaise.",
      "secondary_message": "6 slices whole grain bread\n2 tbsp mayonnaise"
    },
    {
      "id": 144488,
      "primary_message": "Remove bacon from pan and set aside on a plate lined with paper towel.",
      "secondary_message": null
    },
    {
      "id": 144489,
      "primary_message": "Pour off all but 2 tbsp of bacon fat and reduce heat to medium. Gently crack eggs into the skillet; cook, flipping once, until medium-firm, 3-4 minutes. Cook in batches if necessary. ",
      "secondary_message": "6 eggs"
    },
    {
      "id": 144490,
      "primary_message": "Slice cheddar.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 144491,
      "primary_message": "To serve, top half of the bread slices with bacon, cheddar, and egg; season with salt and pepper. Close sandwiches and divide between plates. Enjoy!",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    }
  ],
