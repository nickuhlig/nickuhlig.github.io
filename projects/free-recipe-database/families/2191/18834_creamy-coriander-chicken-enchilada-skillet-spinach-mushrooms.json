  "instructions": [
    {
      "id": 310198,
      "primary_message": "Preheat a small saucepan over medium-high heat. Once the pan is hot, add butter and swirl to coat the bottom; add flour and cook, whisking constantly, until lightly golden, about 1 minute.",
      "secondary_message": "3 tbsp butter, unsalted\n3 tbsp all-purpose flour"
    },
    {
      "id": 310199,
      "primary_message": "Slowly whisk in broth, salt, and coriander. Bring to a boil, then reduce heat and simmer until thickened, 3-4 minutes. Remove sauce from heat and set aside.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 tsp salt\n1 tsp coriander, ground"
    },
    {
      "id": 310200,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 tomatoes\n1 lb cremini mushrooms\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 310201,
      "primary_message": "Medium dice tomatoes; thinly slice mushrooms. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 310202,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the veggies and set aside.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 310203,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310204,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 310205,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add veggies, chicken, and spices. Cook, stirring occasionally, until veggies have softened and chicken is cooked through, 6-7 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n2 tsp chili powder\n1 ½ tsp salt\n1 tsp cumin, ground\n¼ tsp black pepper"
    },
    {
      "id": 310206,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 310207,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 310208,
      "primary_message": "Add yogurt to the pan with the sauce and whisk until smooth.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 310209,
      "primary_message": "Using a clean cutting board, slice tortillas into 2-inch long strips. When the chicken is done, add tortillas and sauce to the skillet; stir to combine.",
      "secondary_message": "4 small flour tortillas"
    },
    {
      "id": 310210,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 310211,
      "primary_message": "Top skillet with cheese and place in the oven; broil until the cheese is melted and bubbly, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 310212,
      "primary_message": "To serve, divide \"enchilada\" skillet between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
