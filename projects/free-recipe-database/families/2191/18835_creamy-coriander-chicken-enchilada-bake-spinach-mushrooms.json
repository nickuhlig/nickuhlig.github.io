  "instructions": [
    {
      "id": 310213,
      "primary_message": "Preheat a medium saucepan over medium-high heat. Once the pan is hot, add butter and swirl to coat the bottom; add flour and cook, whisking constantly, until lightly golden, about 1 minute.",
      "secondary_message": "¼ cup butter, unsalted\n¼ cup all-purpose flour"
    },
    {
      "id": 310214,
      "primary_message": "Slowly whisk in broth, salt, and coriander. Bring to a boil, then reduce heat and simmer until thickened, 3-4 minutes. Remove sauce from heat and set aside.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ tsp salt\n1 ½ tsp coriander, ground"
    },
    {
      "id": 310215,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 tomatoes\n1 ½ lb cremini mushrooms\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 310216,
      "primary_message": "Medium dice tomatoes; thinly slice mushrooms. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 310217,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the veggies and set aside.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 310218,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310219,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 310220,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom; add veggies, chicken, and spices. Cook, stirring occasionally, until veggies have softened and chicken is cooked through, 7-8 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 tbsp chili powder\n2 tsp salt\n1 ½ tsp cumin, ground\n½ tsp black pepper"
    },
    {
      "id": 310221,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 310222,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 310223,
      "primary_message": "Add yogurt to the pan with the sauce and whisk until smooth.",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 310224,
      "primary_message": "Using a clean cutting board, slice tortillas into 2-inch long strips. When the chicken is done, add tortillas and sauce to the pot; stir to combine.",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 310225,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 310226,
      "primary_message": "Transfer mixture to a large baking dish and top with cheese. Place in the oven and broil until the cheese is melted and bubbly, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 310227,
      "primary_message": "To serve, divide \"enchilada\" bake between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
