  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Drain the firm tofu. Discard the stems from the button mushrooms, then thickly slice them. Mince the garlic. Stem and thinly slice the fresh red chiles. Chop the scallions. Chop the baby spinach.",
      "secondary_message": "1 block firm tofu\n113 g button mushrooms\n3 medium cloves garlic\n2 fresh red chiles\n3 scallions\n57 g baby spinach"
    },
    {
      "id": 1,
      "primary_message": "Dry the tofu slices with paper towels, and then cut into 1.5-cm thick rectangular slabs. Heat oil in a large wok over high heat until just starting to smoke. Add the tofu slices with a pair of tongs. Cook until golden, flipping occasionally, about 3 minutes. Transfer tofu to paper towel-lined plate to drain.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Return the wok to high heat and add the mushrooms. Cook, stirring and tossing occasionally, until mushrooms release their liquid and start to brown, about 4 minutes. Add the garlic and chiles and cook, stirring constantly, until fragrant, about 15 seconds. Add the fermented black beans, and stir-fry until they are hot, about 30 seconds. Add the broth and soy sauce.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When mixture comes to a simmer, reduce heat to medium, add the spinach, and cook until it wilts, about 15 seconds. Return the tofu to the pan and season to taste with salt, if necessary. Stir in the cornstarch and water mixture, and cook until the liquid thickens. Add the scallions, stir well, and then remove from heat. Add the chile oil. Serve immediately with rice.",
      "secondary_message": null
    }
  ],
