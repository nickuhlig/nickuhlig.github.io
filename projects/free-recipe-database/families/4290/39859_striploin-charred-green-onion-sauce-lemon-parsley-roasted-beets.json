  "instructions": [
    {
      "id": 618207,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 618208,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "8 medium beets\n2 small bunches green onions (scallions)\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 618209,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice crosswise into ¼-inch thick half-moons. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 618210,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until beets are fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 618211,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 618212,
      "primary_message": "While the pan heats up, trim green onions. Place on a plate, drizzle with oil, and season with salt. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 618213,
      "primary_message": "Once the pan is hot, working in batches if necessary, add green onions. Grill until tender and charred, 2-3 minutes per side; return to the plate. (Reserve grill pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 618214,
      "primary_message": "Meanwhile, pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 618215,
      "primary_message": "Return the pan to medium-high heat and coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Add to the plate with the green onions, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 618216,
      "primary_message": "Meanwhile, place yogurt, mayo, water, and spices in a small bowl, then whisk to combine the sauce.",
      "secondary_message": "1 cup plain Greek yogurt\n2 tbsp avocado oil mayonnaise\n2 tbsp water\n1 tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 618217,
      "primary_message": "Mince grilled green onions. Add to the bowl with the yogurt sauce and whisk once more to combine. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 618218,
      "primary_message": "Juice lemon into another small bowl. Add oil, Dijon, and salt, then whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n¼ tsp salt"
    },
    {
      "id": 618219,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 618220,
      "primary_message": "Thinly slice steak against the grain. ",
      "secondary_message": null
    },
    {
      "id": 618221,
      "primary_message": "To serve, divide green onion yogurt and beets between plates; top yogurt with steak and drizzle beets with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
