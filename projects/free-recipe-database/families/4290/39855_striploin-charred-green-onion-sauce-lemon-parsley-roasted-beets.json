  "instructions": [
    {
      "id": 618147,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 618148,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium beets\n1 small bunch green onions (scallions)\n½ lemon\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 618149,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice crosswise into ¼-inch thick half-moons. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 618150,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until beets are fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 618151,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 618152,
      "primary_message": "While the pan heats up, trim green onions. Place on a plate, drizzle with oil, and season with salt. ",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 618153,
      "primary_message": "Once the pan is hot, add green onions. Grill until tender and charred, 2-3 minutes per side; return to the plate. (Reserve grill pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 618154,
      "primary_message": "Meanwhile, pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 618155,
      "primary_message": "Return the pan to medium-high heat and coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Add to the plate with the green onions, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 618156,
      "primary_message": "Meanwhile, place yogurt, mayo, water, and spices in a small bowl, then whisk to combine the sauce.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 tbsp water\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 618157,
      "primary_message": "Mince grilled green onions. Add to the bowl with the yogurt sauce and whisk once more to combine. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 618158,
      "primary_message": "Juice lemon into another small bowl. Add oil, honey, Dijon, and salt, then whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp honey\n1 tsp Dijon mustard\n⅛ tsp salt"
    },
    {
      "id": 618159,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 618160,
      "primary_message": "Thinly slice steak against the grain. ",
      "secondary_message": null
    },
    {
      "id": 618161,
      "primary_message": "To serve, divide green onion yogurt and beets between plates; top yogurt with steak and drizzle beets with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
