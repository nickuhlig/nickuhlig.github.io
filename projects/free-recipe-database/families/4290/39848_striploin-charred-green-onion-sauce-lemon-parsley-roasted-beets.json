  "instructions": [
    {
      "id": 618045,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 618046,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "12 medium beets\n3 small bunches green onions (scallions)\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 618047,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice crosswise into ¼-inch thick half-moons. Divide between two baking sheet pans, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 618048,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until beets are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 618049,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 618050,
      "primary_message": "While the pan heats up, trim green onions. Place on a plate, drizzle with oil, and season with salt. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 618051,
      "primary_message": "Once the pan is hot, working in batches, add green onions. Grill until tender and charred, 2-3 minutes per side; return to the plate. (Reserve grill pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 618052,
      "primary_message": "Meanwhile, pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 618053,
      "primary_message": "Return the pan to medium-high heat and coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Add to the plate with the green onions, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 618054,
      "primary_message": "Meanwhile, place yogurt, mayo, water, and spices in a medium bowl, then whisk to combine the sauce.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp mayonnaise\n3 tbsp water\n1 ½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 618055,
      "primary_message": "Mince grilled green onions. Add to the bowl with the yogurt sauce and whisk once more to combine. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 618056,
      "primary_message": "Juice lemons into a small bowl. Add oil, honey, Dijon, and salt, then whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp honey\n1 tbsp Dijon mustard\n½ tsp salt"
    },
    {
      "id": 618057,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 618058,
      "primary_message": "Thinly slice steak against the grain. ",
      "secondary_message": null
    },
    {
      "id": 618059,
      "primary_message": "To serve, divide green onion yogurt and beets between plates; top yogurt with steak and drizzle beets with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
