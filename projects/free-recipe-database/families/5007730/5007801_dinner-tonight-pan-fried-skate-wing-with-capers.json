  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the sweet red peppers. Drain the capers. Finely chop the shallots.",
      "secondary_message": "¼ cup sweet red peppers\n2 ½ tbsp capers\n1 tbsp shallots"
    },
    {
      "id": 1,
      "primary_message": "Pour the milk into a medium sized bowl, along with a pinch of salt and pepper. Add the flour to a plate. Pour the oil into a non-stick skillet set over medium-high heat. Place the skate wings in the milk, dredge them evenly in the flour, and then place them in the skillet. Cook for 3 minutes per side. Set aside on a clean plate when done.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Wipe out the skillet, and then add the butter and turn the heat to medium-high. When melted, add the red pepper. Cook for 30 seconds to 1 minute, or until the butter turns a light brown. Add the capers and cook for another 30 seconds or so. Finally, add the shallots and the vinegar. Cook for 30 seconds, stir well, and then pour the sauce over each skate wing.",
      "secondary_message": null
    }
  ],
