  "instructions": [
    {
      "id": 463904,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 463905,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 acorn squash\n1 yellow bell pepper\n2 sticks celery\n1 small bunch green onions (scallions)"
    },
    {
      "id": 463906,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, and scrape out the seeds. Rub the inside of each half with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 463907,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 463908,
      "primary_message": "Meanwhile, trim, seed, and small dice bell pepper. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 463909,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 463910,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 463911,
      "primary_message": "While the pot heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 463912,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, celery, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n4 tsp chili powder\n1 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 463913,
      "primary_message": "Add tomato sauce and water to the pot. Stir to combine the chili and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until slightly thickened, 8-10 minutes. Remove from heat.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n½ cup water"
    },
    {
      "id": 463914,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 463915,
      "primary_message": "To serve, divide squash halves between plates and fill with the chili; top with cheese and reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
