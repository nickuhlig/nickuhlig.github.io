  "instructions": [
    {
      "id": 463787,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 463788,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 acorn squash\n½ yellow bell pepper\n1 stick celery\n½ small bunch green onions (scallions)"
    },
    {
      "id": 463789,
      "primary_message": "Halve acorn squash lengthwise, trim ends, and scrape out the seeds. Rub the inside of each half with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 463790,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 463791,
      "primary_message": "Meanwhile, trim, seed, and small dice bell pepper. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 463792,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 463793,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 463794,
      "primary_message": "While the pan heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 463795,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add bell pepper, celery, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n2 tsp chili powder\n½ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 463796,
      "primary_message": "Add tomato sauce and water to the pan. Stir to combine the chili and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until slightly thickened, 8-10 minutes. Remove from heat.",
      "secondary_message": "1 (8 oz) can tomato sauce\n¼ cup water"
    },
    {
      "id": 463797,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 463798,
      "primary_message": "To serve, divide squash halves between plates and fill with the chili; top with cheese and reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
