  "instructions": [
    {
      "id": 463811,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 463812,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 acorn squash\n1 ½ yellow bell peppers\n3 sticks celery\n1 small bunch green onions (scallions)"
    },
    {
      "id": 463813,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, and scrape out the seeds. Rub the inside of each half with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 463814,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 463815,
      "primary_message": "Meanwhile, trim, seed, and small dice bell peppers. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 463816,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 463817,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 463818,
      "primary_message": "While the pot heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 463819,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, celery, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n2 tbsp chili powder\n1 ½ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 463820,
      "primary_message": "Add tomato sauce and water to the pot. Stir to combine the chili and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until slightly thickened, 8-10 minutes. Remove from heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n¾ cup water"
    },
    {
      "id": 463821,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 463822,
      "primary_message": "To serve, divide squash halves between plates and fill with the chili; top with cheese and reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
