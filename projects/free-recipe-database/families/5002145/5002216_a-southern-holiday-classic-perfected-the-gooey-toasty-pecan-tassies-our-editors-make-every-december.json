  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Melt the unsalted butter. Zest the orange. Soften the unsalted butter. Soften the cream cheese.",
      "secondary_message": "28 g unsalted butter\n1 orange\n113 g unsalted butter\n85 g cream cheese"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F) (175ºC). On a 13- by 46-cm rimmed baking sheet, spread pecan halves in a single layer. Select 24 perfect, unbroken pecan halves; transfer to a small bowl and set aside for topping. Bake remaining pecan halves in preheated oven until fragrant and toasted, 7 to 8 minutes. Let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Measure out 1/4 cup toasted pecans. Transfer to a food processor. Process until finely ground, 10 to 20 seconds. Set ground pecans aside for dough. Chop remaining pecans; set aside for filling.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Prepare the Dough: In a large bowl, beat together softened butter and cream cheese with a flexible spatula until smooth and creamy. Add flour, salt, and reserved ground pecans. Stir together until a cohesive dough forms. Divide dough into 24 one-inch balls, about 14g or 14 g each.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Press 1 dough ball into each cup of a nonstick 24-cup mini muffin pan. Gently and evenly press dough into the bottom and up the sides of each cup. Transfer pan to freezer; chill until firmed, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Meanwhile, prepare the filling: In a medium bowl, whisk brown sugar, maple syrup, butter, bourbon, vanilla, egg, zest, and salt together until smooth.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Remove muffin pan from freezer. Spoon about 1 teaspoon reserved chopped pecans into each cup. Pour 2 teaspoons filling into each cup. Top each cup with 1 reserved untoasted pecan half.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Bake until crust is lightly golden and filling is bubbling, 25 to 28 minutes. Let cool slightly, about 5 minutes. Invert tassies onto a wire rack, then turn them right-side-up, and let cool completely on wire rack, about 30 minutes.",
      "secondary_message": null
    }
  ],
