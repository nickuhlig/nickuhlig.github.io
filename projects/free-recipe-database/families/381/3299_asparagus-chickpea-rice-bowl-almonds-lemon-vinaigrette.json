  "instructions": [
    {
      "id": 34106,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n⅛ tsp salt "
    },
    {
      "id": 34107,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n½ small bunch green onions (scallions)\n½ lemon"
    },
    {
      "id": 34108,
      "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears on an angle into 5-cm pieces. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 34109,
      "primary_message": "Once the water is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 15 to 18 minutes. Remove from the heat and let the rice stand, covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 34110,
      "primary_message": "Peel and halve the shallot lengthwise; thinly slice crosswise.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 34111,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 34112,
      "primary_message": "Drain and rinse the chickpeas.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 34113,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 34114,
      "primary_message": "Add the shallot and chickpeas to the skillet and stir to coat in the oil; cook, stirring occasionally, until the chickpeas are lightly browned and the shallot is softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 34115,
      "primary_message": "Meanwhile, trim and discard the ends of the green onions; cut the onions on an angle into 6-mm pieces.",
      "secondary_message": null
    },
    {
      "id": 34116,
      "primary_message": "Add the asparagus and ½ of the onions (save the rest for garnishing) to the skillet; season with salt and pepper. Cook, stirring occasionally, until the asparagus is bright green and tender, 3 to 4 minutes. Once done, remove from the heat.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 34117,
      "primary_message": "Meanwhile, peel and mince the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 34118,
      "primary_message": "Juice the lemon into a small bowl. Add the minced garlic, olive oil, Dijon, salt, and pepper; whisk together.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 34119,
      "primary_message": "Measure out the almonds.",
      "secondary_message": "⅛ cup almonds, sliced"
    },
    {
      "id": 34120,
      "primary_message": "Divide the rice between bowls and top with the asparagus and chickpea mixture. Sprinkle with the almonds and remaining green onions and drizzle with the dressing. Enjoy!",
      "secondary_message": null
    }
  ],
