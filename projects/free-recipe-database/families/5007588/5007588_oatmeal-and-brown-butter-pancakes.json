  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oats in a medium skillet over medium heat, tossing and stirring frequently, until toasted and nutty, about 4 minutes. Transfer to a bowl and allow to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add butter to now-empty skillet, place over low heat, and cook, swirling constantly, until solids turn a golden brown and butter smells nutty, about 2 minutes. Transfer to a second bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer oats to the jar of a blender and blend on high speed until completely powdered, about 1 minute. Return to bowl. Add flour, baking powder, baking soda, salt, and sugar, and whisk to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Preheat a griddle or a large pan over medium heat. Rub with a paper towel dipped in oil.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add eggs and buttermilk to bowl with browned butter and whisk to combine. Dump dry ingredients into wet ingredients and whisk until just incorporated and no dry pockets or streaks of flour remain but batter is still lumpy.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Add batter in 1/3-cup ladles and spread gently with the bottom of the ladle into 4-inch disks. Cook without disturbing until bubbles form on the top surface and bottom is a deep golden brown (peek underneath with a spatula). Carefully flip pancakes and continue cooking until second side is golden brown.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Transfer cooked pancakes to a wire rack set in a rimmed baking sheet and store in a warm oven while you cook the remaining pancakes. Serve pancakes immediately with warm maple syrup.",
      "secondary_message": null
    }
  ],
