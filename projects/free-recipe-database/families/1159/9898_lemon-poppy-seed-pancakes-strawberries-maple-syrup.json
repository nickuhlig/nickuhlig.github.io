  "instructions": [
    {
      "id": 157892,
      "primary_message": "Wash, trim, and thinly slice strawberries; set aside.",
      "secondary_message": "1 ½ (16 oz) pkg strawberries"
    },
    {
      "id": 157893,
      "primary_message": "Place flour, sugar, poppy seeds, baking powder, and salt in a large bowl; whisk to combine.",
      "secondary_message": "2 ¼ cup all-purpose flour\n¼ cup brown sugar\n1 tbsp poppy seeds\n1 tbsp baking powder\n¾ tsp salt"
    },
    {
      "id": 157894,
      "primary_message": "Melt butter in a large nonstick skillet over low heat; transfer to a medium bowl.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 157895,
      "primary_message": "Add eggs and milk to the bowl with the melted butter and whisk quickly to combine.",
      "secondary_message": "3 eggs\n12 fl oz (1 ½ cups) whole milk"
    },
    {
      "id": 157896,
      "primary_message": "Create a well in the center of the flour mixture. Add the egg mixture and whisk to make a smooth batter.",
      "secondary_message": null
    },
    {
      "id": 157897,
      "primary_message": "Wash and dry lemons. Zest and juice into the pancake batter; whisk to combine, being careful not to over-mix the batter.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 157898,
      "primary_message": "Return skillet to medium-high heat. Add more butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 157899,
      "primary_message": "Working in batches, use a ¼-cup measure to pour the batter into the skillet. Cook for 1-2 minutes on each side, until golden and cooked through.",
      "secondary_message": null
    },
    {
      "id": 157900,
      "primary_message": "To serve, divide pancakes between plates. Top with more butter, strawberries, and maple syrup. Enjoy!",
      "secondary_message": "2 tbsp butter, unsalted\n3 tbsp pure maple syrup"
    }
  ],
