  "instructions": [
    {
      "id": 627150,
      "primary_message": "Place water, maple syrup, and salt in a medium saucepan, cover, and bring to a boil over high heat.",
      "secondary_message": "828 ml water\n2 tsp pure maple syrup\n¼ tsp salt"
    },
    {
      "id": 627151,
      "primary_message": "Once boiling, stir in oats. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency. Remove from heat.",
      "secondary_message": "2 cup oats, quick cooking"
    },
    {
      "id": 627152,
      "primary_message": "Meanwhile, wash and dry raspberries. Place in a small bowl.",
      "secondary_message": "1 (170 g) pkg raspberries"
    },
    {
      "id": 627153,
      "primary_message": "Roughly chop apricots and cashews. Add both to the bowl with the raspberries, stir to combine, and set aside.",
      "secondary_message": "16 dried apricots\n½ cup cashews, roasted unsalted"
    },
    {
      "id": 627154,
      "primary_message": "Place additional maple syrup and spices in another small bowl. Stir to combine.",
      "secondary_message": "¼ cup pure maple syrup\n¼ tsp cinnamon, ground\n¼ tsp cardamom, ground\n⅛ tsp cloves, ground"
    },
    {
      "id": 627155,
      "primary_message": "To serve, divide oatmeal between bowls, top with fruit and nuts, then drizzle with spiced maple syrup. Enjoy!",
      "secondary_message": null
    }
  ],
