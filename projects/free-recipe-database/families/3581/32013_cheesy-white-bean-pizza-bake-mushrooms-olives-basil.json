  "instructions": [
    {
      "id": 506033,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lb white mushrooms\n3 medium carrots\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 506034,
      "primary_message": "Thinly slice mushrooms. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 506035,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 506036,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 506037,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 506038,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 506039,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 506040,
      "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 506041,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 506042,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in the reserved bowl along with the spinach (setting aside a small handful of basil for serving).",
      "secondary_message": null
    },
    {
      "id": 506043,
      "primary_message": "When the veggies are soft, add basil and spinach to the pot in handfuls, waiting for the greens to wilt slightly before adding the next handful. Add beans, olives, and tomatoes, then stir to combine and bring to a simmer.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 506044,
      "primary_message": "Once simmering, reduce heat to medium. Cook, stirring occasionally, until the sauce is thickened slightly and beans are tender, 4-5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 506045,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 506046,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 506047,
      "primary_message": "When the beans are tender, transfer \"pizza\" mixture to a large baking dish, then sprinkle cheese over top. Place in the oven and broil until cheese is melted and golden, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 506048,
      "primary_message": "To serve, divide pizza bake between plates or bowls. Sprinkle with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
