  "instructions": [
    {
      "id": 506065,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.45 kg white mushrooms\n2 medium carrots\n1 small pkg fresh basil\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 506066,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 506067,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 506068,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 506069,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 506070,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 506071,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 506072,
      "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 506073,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 506074,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in the reserved bowl along with the spinach (setting aside a small handful of basil for serving).",
      "secondary_message": null
    },
    {
      "id": 506075,
      "primary_message": "When the veggies are soft, add basil and spinach to the skillet in handfuls, waiting for the greens to wilt slightly before adding the next handful. Add beans, olives, and tomatoes, then stir to combine the skillet and bring to a simmer.",
      "secondary_message": "2 (398 ml) cans diced tomatoes"
    },
    {
      "id": 506076,
      "primary_message": "Once simmering, reduce heat to medium. Cook, stirring occasionally, until the sauce is thickened slightly and beans are tender, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 506077,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 506078,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 506079,
      "primary_message": "When the beans are tender, sprinkle cheese over top. Place skillet in the oven and broil until cheese is melted and golden, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 506080,
      "primary_message": "To serve, divide pizza skillet between plates or bowls. Sprinkle with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
