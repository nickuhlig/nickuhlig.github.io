  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. and spray a large 10-inch cast-iron skillet or oven-safe skillet with cooking spray. Set aside.\t\t\t\t\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add the eggs, milk, oil and vanilla to a medium bowl and whisk to combine. Add in the Pearl Milling Company® Original pancake mix, then whisk to combine.\t\t\t\t\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add the apples to the batter and stir to combine.\t\t\t\t\n",
      "secondary_message": null
    },
    {
      "primary_message": "Pour the batter into the prepared skillet. Sprinkle the cranberries on the batter.\t\t\t\t\n",
      "secondary_message": null
    },
    {
      "primary_message": "Bake for 25-30 minutes, or until brown and cooked through. \t\t\t\t\n",
      "secondary_message": null
    },
    {
      "primary_message": "Allow to cool for 5-10 minutes before slicing into 8 slices. Drizzle each slice with 1 tablespoon of Nutella®. Serve and enjoy!\t\t\t\t\n",
      "secondary_message": null
    }
  ],
