  "instructions": [
    {
      "id": 424837,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 caps portobello mushrooms\n2 (1 inch) pieces ginger root\n2 medium zucchini squash"
    },
    {
      "id": 424838,
      "primary_message": "Remove stems and scrape out the gills of the mushrooms; small dice, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 424839,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 424840,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n1 ½ lb lean ground pork\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 424841,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add both to the bowl with the mushrooms.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 424842,
      "primary_message": "When the pork is done, add mushrooms, ginger, and garlic to the pot. Cook, stirring occasionally, until veggies are soft and fragrant, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 424843,
      "primary_message": "Add broth and coconut aminos to the pot; stir to combine, cover, and bring the soup to a boil over high heat. Once boiling, reduce heat to medium-low and simmer until flavors blend, about 5 minutes.",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n1 tbsp coconut aminos"
    },
    {
      "id": 424844,
      "primary_message": "Meanwhile, trim zucchini and use a julienne (or regular) peeler to make noodles.",
      "secondary_message": null
    },
    {
      "id": 424845,
      "primary_message": "When the soup is done, add zucchini noodles to the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 424846,
      "primary_message": "To serve, divide soup between bowls, drizzle with oil, and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "4 tsp toasted sesame oil\n1 tbsp sesame seeds"
    }
  ],
