  "instructions": [
    {
      "id": 424764,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 caps portobello mushrooms\n1 (1 inch) piece ginger root\n1 medium zucchini squash"
    },
    {
      "id": 424765,
      "primary_message": "Remove stems and scrape out the gills of the mushrooms; small dice, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 424766,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 424767,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add pork, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp toasted sesame oil\n¾ lb lean ground pork\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 424768,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add both to the bowl with the mushrooms.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 424769,
      "primary_message": "When the pork is done, add mushrooms, ginger, and garlic to the pan. Cook, stirring occasionally, until veggies are soft and fragrant, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 424770,
      "primary_message": "Add broth and soy sauce to the pan; stir to combine, cover, and bring the soup to a boil over high heat. Once boiling, reduce heat to medium-low and simmer until flavors blend, about 5 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 tbsp soy sauce"
    },
    {
      "id": 424771,
      "primary_message": "Meanwhile, trim zucchini and use a julienne (or regular) peeler to make noodles.",
      "secondary_message": null
    },
    {
      "id": 424772,
      "primary_message": "When the soup is done, add zucchini noodles to the pan, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 424773,
      "primary_message": "To serve, divide soup between bowls, drizzle with oil, and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp sesame seeds"
    }
  ],
