  "instructions": [
    {
      "id": 424950,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 caps portobello mushrooms\n1 medium carrot\n1 (2 ½ cm) piece ginger root\n1 medium zucchini squash"
    },
    {
      "id": 424951,
      "primary_message": "Remove stems and scrape out the gills of the mushrooms; small dice, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 424952,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl with the mushrooms and set aside.",
      "secondary_message": null
    },
    {
      "id": 424953,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 424954,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until browned and crumbly, about 5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n227 g veggie ground, plant based\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 424955,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add both to the bowl with the other veggies.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 424956,
      "primary_message": "When the veggie ground is done, add mushrooms, carrot, ginger, and garlic to the pan. Cook, stirring occasionally, until veggies are soft and fragrant, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 424957,
      "primary_message": "Add broth, edamame, and soy sauce to the pan; stir to combine, cover, and bring the soup to a boil over high heat. Once boiling, reduce heat to medium-low and simmer until flavors blend, about 5 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n½ cup edamame, shelled\n1 tbsp soy sauce"
    },
    {
      "id": 424958,
      "primary_message": "Meanwhile, trim zucchini and use a julienne (or regular) peeler to make noodles.",
      "secondary_message": null
    },
    {
      "id": 424959,
      "primary_message": "When the soup is done, add zucchini noodles to the pan, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 424960,
      "primary_message": "To serve, divide soup between bowls, drizzle with oil, and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp sesame seeds"
    }
  ],
