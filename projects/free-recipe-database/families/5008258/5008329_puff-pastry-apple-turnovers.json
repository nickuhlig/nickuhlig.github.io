  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Beat the egg.",
      "secondary_message": "1 large egg"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 205°C (400°F). Line baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large saucepan, combine apples, 1 1/2 tablespoons sugar, 1/4 teaspoon cinnamon, and 6 tablespoons water and cook over medium heat, stirring occasionally, until apples have softened but still hold their shape, 8 to 10 minutes; add more water, 1 tablespoon at a time, if apples becomes too dry. Stir in lemon juice and salt. Set aside to cool completely.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, stir together remaining 4 tablespoons sugar and 1/2 teaspoon cinnamon in small bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Roll puff pastry into a 5 1/2- by 53-cm rectangle that is about 0.5-cm thick. Trim edges and cut into four rectangles. Place puff pastry squares on prepared baking sheet.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Lightly brush edges of pastry with egg wash. Place apple filling in center of squares. Fold over puff pastry to create a triangle and gently press edges together. Using a fork, press edges to seal (see note). Brush with eggwash and sprinkle tops with cinnamon sugar.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Prick tops of turnovers a few times with fork. Bake until pastry is crisp and golden, about 20 minutes. Let stand for 5 minutes, then transfer to wire rack to cool. Serve warm or at room temperature.",
      "secondary_message": null
    }
  ],
