  "instructions": [
    {
      "id": 1,
      "primary_message": "Whisk the sugar and pectin a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine the rhubarb and 1/2 cup water in a large saucepan. Bring to a boil, then reduce the heat, cover, and simmer just until the rhubarb breaks down, 10 to 12 minutes. Meanwhile, puree the strawberries in a food processor or blender. You should have 2 cups.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Measure the stewed rhubarb. You should have about 2 cups. Return the rhubarb and the pureed strawberries to the saucepan. Add lemon zest and juice, calcium water, and cinnamon stick and bring to a boil over medium-high heat. Add the sugar-pectin mixture and the honey and return the fruit mixture to a boil, stirring constantly. Boil hard for one minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove the pot from the heat and skim any foam from the surface of the jam with a cold metal spoon. Remove and discard the cinnamon stick. Ladle the jam into hot sterilized jars and process them in a hot water bath for 10 minutes.",
      "secondary_message": null
    }
  ],
