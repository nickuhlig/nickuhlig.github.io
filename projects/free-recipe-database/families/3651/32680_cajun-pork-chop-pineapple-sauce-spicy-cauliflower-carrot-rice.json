  "instructions": [
    {
      "id": 515891,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 515892,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 jalapeño pepper\n2 medium carrots\n½ small pineapple"
    },
    {
      "id": 515893,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 515894,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the cauliflower. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 515895,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl along with oil, salt, and pepper, then stir to combine. Transfer to a baking sheet pan and spread out in an even layer.",
      "secondary_message": "1 tbsp neutral vegetable oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 515896,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower and carrots are tender and golden, 18-20 minutes. Remove from oven. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 515897,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 515898,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate. Sprinkle with Cajun seasoning on both sides.",
      "secondary_message": "2 pork chops, boneless\n1 tsp Cajun seasoning"
    },
    {
      "id": 515899,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden and cooked through, 4-5 minutes per side. Remove to a clean plate, cover with aluminum foil, and set aside. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 515900,
      "primary_message": "Meanwhile, peel and mince garlic. Place in the reserved bowl along with water, soy sauce, maple syrup, cornstarch, Dijon, Cajun seasoning, and salt. Whisk to combine the sauce.",
      "secondary_message": "2 cloves garlic\n¼ cup water\n1 tbsp soy sauce\n1 tbsp pure maple syrup\n1 tbsp cornstarch\n2 tsp Dijon mustard\n½ tsp Cajun seasoning\n¼ tsp salt"
    },
    {
      "id": 515901,
      "primary_message": "Cut off skin from pineapple; quarter, core, and small dice the flesh. Add to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 515902,
      "primary_message": "When the pork chops are done, return skillet to medium-low heat. Add pineapple and sauce; cook, stirring occasionally, until thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 515903,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 515904,
      "primary_message": "To serve, divide cauliflower rice and pineapple sauce between plates. Top sauce with pork and enjoy!",
      "secondary_message": null
    }
  ],
