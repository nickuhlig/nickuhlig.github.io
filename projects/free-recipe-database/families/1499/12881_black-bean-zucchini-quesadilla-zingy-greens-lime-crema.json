  "instructions": [
    {
      "id": 217060,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 medium zucchini squash\n1 lime\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 217061,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 217062,
      "primary_message": "While the skillet heats up, peel and thinly slice onion into half moons.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 217063,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, chili powder, and salt; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 217064,
      "primary_message": "Meanwhile, drain and rinse beans in a colander.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 217065,
      "primary_message": "Add beans and tomato sauce to the skillet, stir to combine, and bring to a simmer. Reduce heat to medium-low and cook until the beans are warm and the sauce has reduced, 4-5 minutes. Transfer to a medium bowl and wipe the skillet clean with paper towels.",
      "secondary_message": "1 (213 ml) can tomato sauce"
    },
    {
      "id": 217066,
      "primary_message": "Meanwhile, trim and coarsely grate zucchini. Transfer to the colander and sprinkle with salt. Set the colander in a bowl to catch the excess moisture.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 217067,
      "primary_message": "Zest and juice lime into a small bowl; add yogurt, salt, and pepper. Whisk to combine the crema and set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 217068,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 217069,
      "primary_message": "Place grated zucchini in the middle of a clean towel, bring the corners together, and squeeze out excess moisture.",
      "secondary_message": null
    },
    {
      "id": 217070,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide beans, zucchini, and cheese between them, arranging it on one half of the tortilla; fold in half to close.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 217071,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 217072,
      "primary_message": "Working in batches, drizzle the skillet with oil, and lay the assembled quesadillas in the pan. Cook until golden on both sides, 5-6 minutes, turning halfway through. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 217073,
      "primary_message": "Meanwhile, combine oil, vinegar, and spices in another medium bowl; whisk to combine the dressing. Add mixed greens and toss to combine the salad.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n½ tsp cumin\n¼ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 217074,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salad and crema on the side. Enjoy!",
      "secondary_message": null
    }
  ],
