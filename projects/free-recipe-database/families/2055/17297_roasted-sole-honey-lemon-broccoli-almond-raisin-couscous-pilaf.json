  "instructions": [
    {
      "id": 280945,
      "primary_message": "Preheat oven to 220°C (425°F). Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 280946,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 crown broccoli\n½ lemon"
    },
    {
      "id": 280947,
      "primary_message": "Peel, trim, and grate carrot; place in a small saucepan.",
      "secondary_message": null
    },
    {
      "id": 280948,
      "primary_message": "Add broth to the pan with the carrot, cover, and bring to a boil over high heat.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 280949,
      "primary_message": "Once boiling, remove broth from the heat, add couscous and garlic powder, and stir to combine. Cover and let stand for 10 minutes.",
      "secondary_message": "½ cup whole wheat couscous\n½ tsp garlic powder"
    },
    {
      "id": 280950,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, and season with spices; toss to combine, then spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp coriander, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 280951,
      "primary_message": "Place baking sheet on lower rack of the oven (it doesn't have to be fully heated) and roast until broccoli is lightly charred and fork-tender, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 280952,
      "primary_message": "While the broccoli is roasting, place spices in a small bowl and stir to combine.",
      "secondary_message": "½ tsp cumin, ground\n¼ tsp coriander, ground\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 280953,
      "primary_message": "Pat the fish dry with paper towels and place on another baking sheet; season with spice mix on both sides and drizzle with oil. (Reserve bowl for later use.)",
      "secondary_message": "⅓ kg sole fillets\n2 tsp extra virgin olive oil"
    },
    {
      "id": 280954,
      "primary_message": "Place baking sheet on upper rack of the oven and roast fish until flakey and cooked through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 280955,
      "primary_message": "Meanwhile, juice lemon into the reserved bowl; add honey and oil. Whisk to combine the honey-lemon sauce.",
      "secondary_message": "1 ½ tsp honey\n1 tsp extra virgin olive oil"
    },
    {
      "id": 280956,
      "primary_message": "When the broccoli is done, drizzle the honey-lemon sauce over top and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 280957,
      "primary_message": "Fluff couscous with a fork, then add almonds and raisins; gently stir to combine.",
      "secondary_message": "¼ cup almonds, sliced\n¼ cup raisins"
    },
    {
      "id": 280958,
      "primary_message": "To serve, divide fish, couscous, and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
