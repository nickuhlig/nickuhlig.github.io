  "instructions": [
    {
      "id": 280931,
      "primary_message": "Preheat oven to 425°F. Position racks in the upper, center, and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 280932,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 crowns broccoli\n1 ½ lemons"
    },
    {
      "id": 280933,
      "primary_message": "Peel, trim, and grate carrots; place in a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 280934,
      "primary_message": "Add broth to the pan with the carrot, cover, and bring to a boil over high heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 280935,
      "primary_message": "Once boiling, remove broth from the heat, add couscous and garlic powder, and stir to combine. Cover and let stand for 10 minutes.",
      "secondary_message": "1 ½ cups whole wheat couscous\n1 ½ tsp garlic powder"
    },
    {
      "id": 280936,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Divide between two baking sheet pans, drizzle with oil, and season with spices; toss to combine, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 280937,
      "primary_message": "Place baking sheets on lower racks of the oven (it doesn't have to be fully heated) and roast until broccoli is lightly charred and fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 280938,
      "primary_message": "While the broccoli is roasting, place spices in a small bowl and stir to combine.",
      "secondary_message": "1 ½ tsp cumin, ground\n¾ tsp coriander, ground\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 280939,
      "primary_message": "Pat the fish dry with paper towels and place on a large baking sheet; season with spice mix on both sides and drizzle with oil. (Reserve bowl for later use.)",
      "secondary_message": "2 ¼ lb sole fillets\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 280940,
      "primary_message": "Place baking sheet on upper rack of the oven and roast fish until flakey and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 280941,
      "primary_message": "Meanwhile, juice lemons into the reserved bowl; add honey and oil. Whisk to combine the honey-lemon sauce.",
      "secondary_message": "1 ½ tbsp honey\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 280942,
      "primary_message": "When the broccoli is done, drizzle the honey-lemon sauce over top and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 280943,
      "primary_message": "Fluff couscous with a fork, then add almonds and raisins; gently stir to combine.",
      "secondary_message": "¾ cup almonds, sliced\n¾ cup raisins"
    },
    {
      "id": 280944,
      "primary_message": "To serve, divide fish, couscous, and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
