  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 mini red seedless watermelon\n1 small pkg fresh mint"
    },
    {
      "primary_message": "Zest and juice lemon into a large bowl. Add oil, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Quarter watermelon lengthwise; cut off rind, then large dice the flesh. Add to the bowl with the dressing and stir to combine the salad. Set aside.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Pick mint leaves off the stems, roll up crosswise, and thinly slice into ribbons.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer salad to a serving dish; top with feta and mint. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
