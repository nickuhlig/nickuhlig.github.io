  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Make Cinnamon Simple Syrup: Place water and sugar in a small saucepan over medium heat. Stir frequently. When sugar has dissolved, add cinnamon stick and ground cinnamon. Bring to a boil, stirring, then reduce heat to a low simmer and let cook for 5 minutes. Pour through a fine-mesh strainer and let cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To Make Cocktail: Put apple, lemon juice, vodka, and simple syrup in a food processor and pulse until smoothly puréed, about 20 pulses. Pour apple mixture into a cocktail shaker. Fill with ice. Shake for 10 seconds. Strain into a martini glass. Garnish with a thin slice of apple, if desired.",
      "secondary_message": null
    }
  ],
