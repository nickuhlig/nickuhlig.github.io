  "instructions": [
    {
      "id": 152154,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152155,
      "primary_message": "Pat chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 152156,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken in a single layer and cook, flipping once, until golden brown (the chicken will not be cooked all the way through), about 4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 152157,
      "primary_message": "Meanwhile, peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 152158,
      "primary_message": "Transfer the chicken to a clean plate and set aside. Add more oil to the pot, along with onions and garlic. Cook, stirring often, until softened, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 152159,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n6 medium zucchini squash\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 152160,
      "primary_message": "Peel carrots, trim ends, and cut crosswise into ¼-inch rounds. Cut celery crosswise into ¼-inch pieces. Add both to the pot with the onions; continue to cook until fragrant, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 152161,
      "primary_message": "Add chicken back to the pot, along with broth and spices. Cover and bring to a boil; reduce heat and let simmer until the chicken is cooked through, about 8 minutes.",
      "secondary_message": "2839 ml chicken or vegetable broth\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper\n¼ tsp thyme"
    },
    {
      "id": 152162,
      "primary_message": "Meanwhile, trim ends of zucchini, and use a julienne (or regular) peeler to make 2-inch long noodles; set aside.",
      "secondary_message": null
    },
    {
      "id": 152163,
      "primary_message": "Slice lemon into wedges and set aside.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 152164,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 152165,
      "primary_message": "Remove chicken from the pot using tongs and transfer to a clean plate or cutting board. Shred chicken using two forks. Use one fork to hold the chicken and the other fork to pull and shred the meat.",
      "secondary_message": null
    },
    {
      "id": 152166,
      "primary_message": "Add zucchini noodles and shredded chicken back to the pot and stir to combine. Cook until warmed through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 152167,
      "primary_message": "To serve, divide soup between bowls. Sprinkle parsley over top and garnish with lemon wedges. Enjoy!",
      "secondary_message": null
    }
  ],
