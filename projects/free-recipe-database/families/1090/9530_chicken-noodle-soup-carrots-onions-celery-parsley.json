  "instructions": [
    {
      "id": 152087,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152088,
      "primary_message": "Pat chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 152089,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add chicken in a single layer and cook, flipping once, until golden brown (the chicken will not be cooked all the way through), about 4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 152090,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 152091,
      "primary_message": "Transfer the chicken to a clean plate and set aside. Add more oil to the pan, along with onion and garlic. Cook, stirring often, until softened, about 3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 152092,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n½ lemon\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 152093,
      "primary_message": "Peel carrots, trim ends, and cut crosswise into ¼-inch rounds. Cut celery crosswise into ¼-inch pieces. Add both to the pan with the onions; continue to cook until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 152094,
      "primary_message": "Add chicken back to the pan, along with broth, pasta, and spices. Cover and bring to a boil; reduce heat and let simmer until pasta and chicken are cooked through, about 8 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n57 g rotini pasta\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp thyme"
    },
    {
      "id": 152095,
      "primary_message": "Meanwhile, slice lemon into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 152096,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 152097,
      "primary_message": "Remove chicken from the pan using tongs and transfer to a clean plate or cutting board.",
      "secondary_message": null
    },
    {
      "id": 152098,
      "primary_message": "Shred chicken using two forks. Use one fork to hold the chicken and the other fork to pull and shred the meat. Add shredded chicken back to the pan and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 152099,
      "primary_message": "To serve, divide soup between bowls. Sprinkle parsley over top and garnish with lemon wedges. Enjoy!",
      "secondary_message": null
    }
  ],
