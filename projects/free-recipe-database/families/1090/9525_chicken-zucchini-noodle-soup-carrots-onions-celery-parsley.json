  "instructions": [
    {
      "id": 152020,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152021,
      "primary_message": "Pat chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 152022,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken in a single layer and cook, flipping once, until golden brown (the chicken will not be cooked all the way through), about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 152023,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 152024,
      "primary_message": "Transfer the chicken to a clean plate and set aside. Add more oil to the pot, along with onion and garlic. Cook, stirring often, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 152025,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n4 sticks celery\n4 medium zucchini squash\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 152026,
      "primary_message": "Peel carrots, trim ends, and cut crosswise into ¼-inch rounds. Cut celery crosswise into ¼-inch pieces. Add both to the pot with the onions; continue to cook until fragrant, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 152027,
      "primary_message": "Add chicken back to the pot, along with broth and spices. Cover and bring to a boil; reduce heat and let simmer until the chicken is cooked through, about 8 minutes.",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper\n¼ tsp thyme"
    },
    {
      "id": 152028,
      "primary_message": "Meanwhile, trim ends of zucchini, and use a julienne (or regular) peeler to make 2-inch long noodles; set aside.",
      "secondary_message": null
    },
    {
      "id": 152029,
      "primary_message": "Slice lemon into wedges and set aside.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 152030,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 152031,
      "primary_message": "Remove chicken from the pot using tongs and transfer to a clean plate or cutting board. Shred chicken using two forks. Use one fork to hold the chicken and the other fork to pull and shred the meat.",
      "secondary_message": null
    },
    {
      "id": 152032,
      "primary_message": "Add zucchini noodles and shredded chicken back to the pot and stir to combine. Cook until warmed through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 152033,
      "primary_message": "To serve, divide soup between bowls. Sprinkle parsley over top and garnish with lemon wedges. Enjoy!",
      "secondary_message": null
    }
  ],
