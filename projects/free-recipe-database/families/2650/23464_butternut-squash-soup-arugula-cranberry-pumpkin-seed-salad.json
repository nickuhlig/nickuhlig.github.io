  "instructions": [
    {
      "id": 424359,
      "primary_message": "Place butternut squash, broth, coconut milk, paprika, and salt in a medium saucepan. Stir to combine the soup. ",
      "secondary_message": "3 cup frozen butternut squash, pieces\n473 ml chicken or vegetable broth\n½ (398 ml) can coconut milk\n½ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 424360,
      "primary_message": "Bring the soup to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until squash is very soft, 8-10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 424361,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Place in a medium bowl. ",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 424362,
      "primary_message": "Add carrots, cranberries, pumpkin seeds, and nutritional yeast to the bowl with the arugula. Set aside. ",
      "secondary_message": "½ (283 g) bag shredded carrots\n¼ cup dried cranberries\n⅛ cup pumpkin seeds\n⅛ cup nutritional yeast flakes"
    },
    {
      "id": 424363,
      "primary_message": "When the soup is done, remove from the heat. Purée soup with an immersion or regular blender (return soup to the pan). ",
      "secondary_message": null
    },
    {
      "id": 424364,
      "primary_message": "Add vinaigrette to the bowl with the arugula and toss to combine the salad. ",
      "secondary_message": "2 tbsp French vinaigrette"
    },
    {
      "id": 424365,
      "primary_message": "Divide soup between bowls and sprinkle with additional pumpkin seeds; serve with salad on the side. Enjoy!",
      "secondary_message": "⅛ cup pumpkin seeds"
    }
  ],
