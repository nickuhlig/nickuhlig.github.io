  "instructions": [
    {
      "id": 424331,
      "primary_message": "Place butternut squash, broth, coconut milk, paprika, and salt in a large pot. Stir to combine the soup. ",
      "secondary_message": "9 cup frozen butternut squash, pieces\n48 fl oz (6 cups) chicken or vegetable broth\n1 ½ (13.5 fl oz) cans coconut milk\n1 ½ tsp paprika\n¾ tsp salt"
    },
    {
      "id": 424332,
      "primary_message": "Bring the soup to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until squash is very soft, 8-10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 424333,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Place in a large bowl. ",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 424334,
      "primary_message": "Add carrots, cranberries, pumpkin seeds, and nutritional yeast to the bowl with the arugula. Set aside. ",
      "secondary_message": "1 ½ (10 oz) bags shredded carrots\n¾ cup dried cranberries\n⅓ cup pumpkin seeds\n⅓ cup nutritional yeast flakes"
    },
    {
      "id": 424335,
      "primary_message": "When the soup is done, remove from the heat. Purée soup with an immersion or regular blender (return soup to the pan). ",
      "secondary_message": null
    },
    {
      "id": 424336,
      "primary_message": "Add vinaigrette to the bowl with the arugula and toss to combine the salad. ",
      "secondary_message": "⅓ cup French vinaigrette"
    },
    {
      "id": 424337,
      "primary_message": "Divide soup between bowls and sprinkle with additional pumpkin seeds; serve with salad on the side. Enjoy!",
      "secondary_message": "⅓ cup pumpkin seeds"
    }
  ],
