  "instructions": [
    {
      "id": 440082,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp red wine vinegar\n¾ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 440083,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 440084,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 440085,
      "primary_message": "While the skillet heats up, roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 440086,
      "primary_message": "Once the skillet is hot, add walnuts and cook, stirring frequently, until lightly browned, 2-3 minutes. Transfer to another small bowl. ",
      "secondary_message": null
    },
    {
      "id": 440087,
      "primary_message": "Wash, dry, and shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with oil, vinegar, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "½ small bunch fresh dill\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 440088,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the dressing.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 440089,
      "primary_message": "Halve olives lengthwise and add to the bowl.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 440090,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Add to the bowl along with cooled walnuts, feta, and pickled onion. Gently toss to combine the salad.",
      "secondary_message": "1 (5 oz) pkg baby spinach\n½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 440091,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
