  "instructions": [
    {
      "id": 440043,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 440044,
      "primary_message": "While the skillet heats up, roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 440045,
      "primary_message": "Once the skillet is hot, add walnuts and cook, stirring frequently, until lightly browned, 2-3 minutes. Transfer to a small bowl. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 440046,
      "primary_message": "Place vinegar, sugar, and salt in another small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp red wine vinegar\n¾ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 440047,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 440048,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 440049,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 440050,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken cutlets and pan-fry until golden and cooked through, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 440051,
      "primary_message": "Meanwhile, wash, dry, and, using a clean cutting board, shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with oil, vinegar, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "½ small bunch fresh dill\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 440052,
      "primary_message": "Halve olives lengthwise. Add to the bowl with the dressing.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 440053,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Add to the bowl along with cooled walnuts, feta, and pickled onion. Gently toss to combine the salad.",
      "secondary_message": "1 (5 oz) pkg baby spinach\n½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 440054,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 440055,
      "primary_message": "To serve, divide salad between plates or bowls and top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
