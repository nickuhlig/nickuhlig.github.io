  "instructions": [
    {
      "id": 440102,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup red wine vinegar\n2 tsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 440103,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 440104,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 440105,
      "primary_message": "While the skillet heats up, roughly chop walnuts.",
      "secondary_message": "1 ½ cups walnuts"
    },
    {
      "id": 440106,
      "primary_message": "Once the skillet is hot, add walnuts and cook, stirring frequently, until lightly browned, 3-4 minutes. Transfer to a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 440107,
      "primary_message": "Wash, dry, and shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with oil, vinegar, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "1 small bunch fresh dill\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 440108,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the dressing.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 440109,
      "primary_message": "Halve olives lengthwise and add to the bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 440110,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Add to the bowl along with cooled walnuts, feta, and pickled onion. Gently toss to combine the salad.",
      "secondary_message": "3 (5 oz) pkgs baby spinach\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 440111,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
