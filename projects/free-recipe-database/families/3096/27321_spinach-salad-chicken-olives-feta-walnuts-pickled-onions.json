  "instructions": [
    {
      "id": 440138,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 440139,
      "primary_message": "While the skillet heats up, roughly chop walnuts.",
      "secondary_message": "1 ½ cups walnuts"
    },
    {
      "id": 440140,
      "primary_message": "Once the skillet is hot, add walnuts and cook, stirring frequently, until lightly browned, 3-4 minutes. Transfer to a small bowl. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 440141,
      "primary_message": "Place vinegar and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup red wine vinegar\n1 ½ tsp salt"
    },
    {
      "id": 440142,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 440143,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 440144,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 440145,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden and cooked through, 3-4 minutes per side. Remove to a plate and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 440146,
      "primary_message": "Meanwhile, wash, dry, and, using a clean cutting board, shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with oil, vinegar, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "1 small bunch fresh dill\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 440147,
      "primary_message": "Halve olives lengthwise. Add to the bowl with the dressing.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 440148,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Add to the bowl along with cooled walnuts, feta, and pickled onion. Gently toss to combine the salad.",
      "secondary_message": "3 (5 oz) pkgs baby spinach\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 440149,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 440150,
      "primary_message": "To serve, divide salad between plates or bowls and top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
