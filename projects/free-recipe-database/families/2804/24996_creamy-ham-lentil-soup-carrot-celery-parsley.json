  "instructions": [
    {
      "id": 402048,
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a medium bowl along with the carrots.",
      "secondary_message": "6 sticks celery\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 402049,
      "primary_message": "Small dice ham. Add to the bowl with the celery and carrots. ",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 402050,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 402051,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add celery, carrots, ham, and spices; cook, stirring occasionally, until veggies start to soften, 4-5 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp onion powder\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 402052,
      "primary_message": "While the veggies are cooking, drain and rinse lentils. ",
      "secondary_message": "3 (15 oz) cans lentils"
    },
    {
      "id": 402053,
      "primary_message": "Once the veggies are soft, add lentils, broth, and cream to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until veggies and lentils are tender, about 5 minutes. ",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 402054,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 402055,
      "primary_message": "When the soup is done, remove from heat, add parsley, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 402056,
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
