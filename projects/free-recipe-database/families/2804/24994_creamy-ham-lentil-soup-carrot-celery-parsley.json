  "instructions": [
    {
      "id": 402030,
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a medium bowl along with the carrots.",
      "secondary_message": "2 sticks celery\n½ (10 oz) bag shredded carrots"
    },
    {
      "id": 402031,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 402032,
      "primary_message": "While the pan heats up, small dice ham. Add to the bowl with the celery and carrots. ",
      "secondary_message": "8 oz ham steak, boneless"
    },
    {
      "id": 402033,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add celery, carrots, ham, and spices; cook, stirring occasionally, until veggies start to soften, 3-4 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 402034,
      "primary_message": "While the veggies are cooking, drain and rinse lentils. ",
      "secondary_message": "1 (15 oz) can lentils"
    },
    {
      "id": 402035,
      "primary_message": "Once the veggies are soft, add lentils, broth, and cream to the pan; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until veggies and lentils are tender, about 5 minutes. ",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 402036,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 402037,
      "primary_message": "When the soup is done, remove from heat, add parsley, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 402038,
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
