  "instructions": [
    {
      "id": 369220,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n6 tomatoes\n1 ½ jalapeño peppers\n1 ½ limes\n3 green bell peppers"
    },
    {
      "id": 369221,
      "primary_message": "Peel, halve, and mince onions; place half in a medium bowl. Set remaining onion aside for later use.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 369222,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 369223,
      "primary_message": "Small dice tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369224,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 369225,
      "primary_message": "Juice limes into the bowl, then add salt and pepper. Stir to combine the pico de gallo and set aside.",
      "secondary_message": "½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 369226,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 369227,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 369228,
      "primary_message": "Once the skillet is hot, add reserved onion, garlic, ground beef, and spices to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tbsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 369229,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 369230,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the skillet and continue to cook until the pepper starts to soften, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 369231,
      "primary_message": "While the bell pepper is cooking, place eggs, salt, and pepper in a large bowl; whisk to combine.",
      "secondary_message": "18 eggs\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 369232,
      "primary_message": "When the bell pepper is tender, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 369233,
      "primary_message": "Meanwhile, coarsely grate mozzarella.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 369234,
      "primary_message": "Sprinkle mozzarella over the frittata. Place skillet in the oven and broil until top of the frittata is set and cheese is melted, about 4 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 369235,
      "primary_message": "To serve, cut frittata into wedges and divide between plates; top with pico de gallo. Enjoy!",
      "secondary_message": null
    }
  ],
