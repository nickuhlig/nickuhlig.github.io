  "instructions": [
    {
      "id": 369188,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch cilantro\n2 tomatoes\n½ jalapeño pepper\n½ lime\n1 green bell pepper"
    },
    {
      "id": 369189,
      "primary_message": "Peel, halve, and mince onion; place half in a small bowl. Set remaining onion aside for later use.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 369190,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 369191,
      "primary_message": "Small dice tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369192,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 369193,
      "primary_message": "Juice lime into the bowl, then add salt and pepper. Stir to combine the pico de gallo and set aside.",
      "secondary_message": "⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 369194,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 369195,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 369196,
      "primary_message": "Once the skillet is hot, add reserved onion, garlic, ground beef, and spices to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "⅓ kg lean ground beef\n1 ½ tsp chili powder\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 369197,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 369198,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the skillet and continue to cook until the pepper starts to soften, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 369199,
      "primary_message": "While the bell pepper is cooking, place eggs, salt, and pepper in a medium bowl; whisk to combine.",
      "secondary_message": "6 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 369200,
      "primary_message": "When the bell pepper is tender, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 369201,
      "primary_message": "Meanwhile, coarsely grate mozzarella.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 369202,
      "primary_message": "Sprinkle mozzarella over the frittata. Place skillet in the oven and broil until top of the frittata is set and cheese is melted, 3-4 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 369203,
      "primary_message": "To serve, cut frittata into wedges and divide between plates; top with pico de gallo. Enjoy!",
      "secondary_message": null
    }
  ],
