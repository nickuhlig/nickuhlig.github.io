  "instructions": [
    {
      "id": 300573,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.23 kg Brussels sprouts\n½ lemon\n1 medium beet\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 300574,
      "primary_message": "Trim and thinly slice Brussels sprouts; place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 300575,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300576,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 300577,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add garlic, veggie ground, and spices. Cook, breaking apart with a spoon, until crumbly and cooked through, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp sage, dried\n½ tsp thyme, dried\n½ tsp cinnamon, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 300578,
      "primary_message": "Once the veggie ground is done, add Brussels sprouts and cranberries to the skillet; cook, stirring occasionally, until the sprouts are just tender, about 3 minutes. Remove from heat. (Reserve bowl for the salad.)",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 300579,
      "primary_message": "Meanwhile, zest lemon into a small bowl and set aside. (Reserve lemon for the next step.)",
      "secondary_message": null
    },
    {
      "id": 300580,
      "primary_message": "Juice lemon into the reserved bowl; add mayo, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tsp mayonnaise\n1 tsp Dijon mustard\n½ tsp pure maple syrup\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 300581,
      "primary_message": "Trim, peel, and coarsely grate beet; add to the bowl with the dressing, along with the arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 300582,
      "primary_message": "When the sprouts are done, crumble goat cheese into the skillet, add lemon zest, and stir to combine the veggie ground filling.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 300583,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with veggie ground filling.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 300584,
      "primary_message": "To serve, divide pita pockets and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
