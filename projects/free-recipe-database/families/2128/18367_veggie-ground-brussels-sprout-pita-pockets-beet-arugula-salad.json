  "instructions": [
    {
      "id": 300525,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lb Brussels sprouts\n1 ½ lemons\n3 medium beets\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 300526,
      "primary_message": "Trim and thinly slice Brussels sprouts; place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 300527,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300528,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 300529,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add garlic, veggie ground, and spices. Cook, breaking apart with a spoon, until crumbly and cooked through, 5-6 minutes (or cook according to package instructions).",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 ½ tsp sage, dried\n1 ½ tsp thyme, dried\n1 ½ tsp cinnamon, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 300530,
      "primary_message": "Once the veggie ground is done, add Brussels sprouts and cranberries to the pot; cook, stirring occasionally, until the sprouts are just tender, 4-5 minutes. Remove from heat. (Reserve bowl for the salad.)",
      "secondary_message": "¾ cup dried cranberries"
    },
    {
      "id": 300531,
      "primary_message": "Meanwhile, zest lemons into a small bowl and set aside. (Reserve lemons for the next step.)",
      "secondary_message": null
    },
    {
      "id": 300532,
      "primary_message": "Juice lemons into the reserved bowl; add mayo, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp pure maple syrup\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 300533,
      "primary_message": "Trim, peel, and coarsely grate beets; add to the bowl with the dressing, along with the arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 300534,
      "primary_message": "When the sprouts are done, crumble goat cheese into the pot, add lemon zest, and stir to combine the veggie ground filling.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 300535,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with veggie ground filling.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 300536,
      "primary_message": "To serve, divide pita pockets and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
