  "instructions": [
    {
      "id": 300537,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.23 kg Brussels sprouts\n½ lemon\n1 medium beet\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 300538,
      "primary_message": "Trim and thinly slice Brussels sprouts; place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 300539,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300540,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 300541,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add garlic, turkey, and spices. Cook, breaking the turkey apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n⅓ kg ground turkey\n½ tsp sage, dried\n½ tsp thyme, dried\n½ tsp cinnamon, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 300542,
      "primary_message": "Once the turkey is done, add Brussels sprouts and cranberries to the skillet; cook, stirring occasionally, until the sprouts are just tender, about 3 minutes. Remove from heat. (Reserve bowl for the salad.)",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 300543,
      "primary_message": "Meanwhile, zest lemon into a small bowl and set aside. (Reserve lemon for the next step.)",
      "secondary_message": null
    },
    {
      "id": 300544,
      "primary_message": "Juice lemon into the reserved bowl; add mayo, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tsp mayonnaise\n1 tsp Dijon mustard\n½ tsp pure maple syrup\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 300545,
      "primary_message": "Trim, peel, and coarsely grate beet; add to the bowl with the dressing, along with the arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 300546,
      "primary_message": "When the sprouts are done, crumble goat cheese into the skillet, add lemon zest, and stir to combine the turkey filling.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 300547,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with turkey filling.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 300548,
      "primary_message": "To serve, divide pita pockets and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
