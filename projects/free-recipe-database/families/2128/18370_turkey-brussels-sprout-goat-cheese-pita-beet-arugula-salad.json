  "instructions": [
    {
      "id": 300561,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.68 kg Brussels sprouts\n1 ½ lemons\n3 medium beets\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 300562,
      "primary_message": "Trim and thinly slice Brussels sprouts; place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 300563,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300564,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 300565,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add garlic, turkey, and spices. Cook, breaking the turkey apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg ground turkey\n1 ½ tsp sage, dried\n1 ½ tsp thyme, dried\n1 ½ tsp cinnamon, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 300566,
      "primary_message": "Once the turkey is done, add Brussels sprouts and cranberries to the pot; cook, stirring occasionally, until the sprouts are just tender, 4-5 minutes. Remove from heat. (Reserve bowl for the salad.)",
      "secondary_message": "¾ cup dried cranberries"
    },
    {
      "id": 300567,
      "primary_message": "Meanwhile, zest lemons into a small bowl and set aside. (Reserve lemons for the next step.)",
      "secondary_message": null
    },
    {
      "id": 300568,
      "primary_message": "Juice lemons into the reserved bowl; add mayo, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp pure maple syrup\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 300569,
      "primary_message": "Trim, peel, and coarsely grate beets; add to the bowl with the dressing, along with the arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 300570,
      "primary_message": "When the sprouts are done, crumble goat cheese into the pot, add lemon zest, and stir to combine the turkey filling.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 300571,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with turkey filling.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 300572,
      "primary_message": "To serve, divide pita pockets and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
