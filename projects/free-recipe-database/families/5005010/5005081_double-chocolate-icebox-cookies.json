  "ingredients": [
    {
      "ingredient_id": 293,
      "name": "packed light brown sugar",
      "quantity": "1 cup (7 oz)"
    },
    {
      "ingredient_id": 115,
      "name": "unsalted butter, softened",
      "quantity": "12 tbsp (6 oz)"
    },
    {
      "ingredient_id": 88,
      "name": "salt",
      "quantity": "¼ tsp"
    },
    {
      "ingredient_id": 121,
      "name": "egg",
      "quantity": "1 large"
    },
    {
      "ingredient_id": 353,
      "name": "vanilla extract",
      "quantity": "2 tsp"
    },
    {
      "ingredient_id": 116,
      "name": "all-purpose flour",
      "quantity": "1 ½ cups (7 ½ oz)"
    },
    {
