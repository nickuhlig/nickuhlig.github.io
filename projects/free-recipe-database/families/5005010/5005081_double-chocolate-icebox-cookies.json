  "instructions": [
    {
      "id": 1,
      "primary_message": "Place sugar, butter, and salt in bowl of standing mixer fitted with paddle attachment. Beat on medium speed until creamy, about 1 minute. Mix in egg and vanilla until combined.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk flour with cocoa and baking powder in a small bowl. Reduce mixer speed to low and mix in dry mixture until completely combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place dough onto a 10- by 25-cm sheet of parchment paper and roll up into a cylinder approximately 20-cm long and 5-cm diameter. Twist ends to secure and chill until firm, about 2 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Adjust oven rack to upper-middle and lower-middle positions and preheat oven to 175°C (350°F). Line two baking sheets with parchment. Cut dough into 0.5-cm slices and space evenly onto pans, about 12 per pan. Sprinkle chips onto cookies and press to adhere.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake until cookies are just set, about 12 minutes, rotating pans from top to bottom and from front to back halfway through baking. Let cookies cool on pan 5 minutes, then transfer to cooling rack to cool completely.",
      "secondary_message": null
    }
  ],
