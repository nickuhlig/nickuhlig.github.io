    {
      "ingredient_id": 293,
      "name": "packed light brown sugar",
      "quantity": "1 cup (7 oz)"
    },
    {
      "ingredient_id": 115,
      "name": "unsalted butter, softened",
      "quantity": "12 tbsp (6 oz)"
    },
    {
