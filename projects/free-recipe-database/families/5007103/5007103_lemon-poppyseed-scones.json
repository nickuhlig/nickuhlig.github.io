  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the chilled unsalted butter into small pieces. Beat the egg. Juice the lemon.",
      "secondary_message": "10 tbsp chilled unsalted butter\n1 large egg\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to medium position and preheat to 375°F. Prepare a baking dish by lining it with foil, or using baking spray. In a large bowl combine flour, sugar, poppy seeds, baking powder, and salt, and whisk to combine. Using two butter knives or a pastry cutter, cut butter into dry ingredients until the mixture resembles a coarse meal.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a separate bowl, combine egg, lemon juice and milk, and whisk to combine. Pour wet ingredients over dry ingredients and, using a wooden spoon or your hands, mix until a dough forms, but take care to not over-mix.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "On a lightly floured surface, pat dough into a 10- by 6 1/2-inch rectangle, then cut that rectangle into 6 equal squares; then divide each square diagonally through the center to create 12 triangular scones.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place scones on prepared baking dish and bake for 18 minutes, or until scones have browned.",
      "secondary_message": null
    }
  ],
