  "instructions": [
    {
      "id": 404214,
      "primary_message": "Place oil, miso paste, soy sauce, and pepper in a large bowl. Stir to combine the sauce.",
      "secondary_message": "¼ cup toasted sesame oil\n¼ cup miso paste, white\n2 tbsp soy sauce\n½ tsp black pepper"
    },
    {
      "id": 404215,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the sauce. ",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 404216,
      "primary_message": "Wash and dry mushrooms. Add to the bowl, then stir to coat the chicken and mushrooms.",
      "secondary_message": "0.45 kg cremini mushrooms"
    },
    {
      "id": 404217,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 404218,
      "primary_message": "Once the pan is hot, working in batches if necessary, add chicken and mushrooms. Grill, turning occasionally, until the chicken is cooked through and mushrooms are tender, 6-8 minutes. Remove to a plate.",
      "secondary_message": null
    },
    {
      "id": 404219,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a medium bowl along with broccoli slaw and peanut sauce. Stir to combine.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 (340 g) pkg broccoli slaw\n⅓ cup peanut sauce"
    },
    {
      "id": 404220,
      "primary_message": "To serve, divide chicken, mushrooms, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
