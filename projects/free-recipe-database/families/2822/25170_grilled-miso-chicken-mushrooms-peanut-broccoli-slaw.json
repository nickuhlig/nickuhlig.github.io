  "instructions": [
    {
      "id": 404200,
      "primary_message": "Place oil, miso paste, soy sauce, and pepper in a large bowl. Stir to combine the sauce.",
      "secondary_message": "⅓ cup toasted sesame oil\n⅓ cup miso paste, white\n3 tbsp soy sauce\n¾ tsp black pepper"
    },
    {
      "id": 404201,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the sauce. ",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 404202,
      "primary_message": "Wash and dry mushrooms. Add to the bowl, then stir to coat the chicken and mushrooms.",
      "secondary_message": "1 ½ lb cremini mushrooms"
    },
    {
      "id": 404203,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 404204,
      "primary_message": "Once the pan is hot, working in batches if necessary, add chicken and mushrooms. Grill, turning occasionally, until the chicken is cooked through and mushrooms are tender, 6-8 minutes. Remove to a large plate.",
      "secondary_message": null
    },
    {
      "id": 404205,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a clean large bowl along with broccoli slaw and peanut sauce. Stir to combine.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ (12 oz) pkg broccoli slaw\n½ cup peanut sauce"
    },
    {
      "id": 404206,
      "primary_message": "To serve, divide chicken, mushrooms, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
