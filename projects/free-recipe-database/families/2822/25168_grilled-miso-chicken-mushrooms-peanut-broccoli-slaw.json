  "instructions": [
    {
      "id": 404186,
      "primary_message": "Place oil, miso paste, soy sauce, and pepper in a medium bowl. Stir to combine the sauce.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp miso paste, white\n1 tbsp soy sauce\n¼ tsp black pepper"
    },
    {
      "id": 404187,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the sauce. ",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 404188,
      "primary_message": "Wash and dry mushrooms. Add to the bowl, then stir to coat the chicken and mushrooms.",
      "secondary_message": "½ lb cremini mushrooms"
    },
    {
      "id": 404189,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 404190,
      "primary_message": "Once the pan is hot, add chicken and mushrooms. Grill, turning occasionally, until the chicken is cooked through and mushrooms are tender, 6-8 minutes. Remove to a plate.",
      "secondary_message": null
    },
    {
      "id": 404191,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a clean medium bowl along with broccoli slaw and peanut sauce. Stir to combine.",
      "secondary_message": "½ small bunch green onions (scallions)\n½ (12 oz) pkg broccoli slaw\n3 tbsp peanut sauce"
    },
    {
      "id": 404192,
      "primary_message": "To serve, divide chicken, mushrooms, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
