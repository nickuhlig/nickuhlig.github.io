  "instructions": [
    {
      "id": 397305,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 397306,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 pints grape tomatoes\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 397307,
      "primary_message": "Divide tomatoes between two baking sheet pans. Drizzle with oil and sprinkle with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 397308,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring tomatoes halfway through, until they start to burst, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 397309,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 397310,
      "primary_message": "Zest and juice lemons into the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 397311,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with additional oil and salt; stir to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 397312,
      "primary_message": "Roughly chop olives. Add to the bowl with the dressing. ",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 397313,
      "primary_message": "Drain and rinse beans. Add to the bowl along with the feta. Set aside.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 397314,
      "primary_message": "When the tomatoes are done, remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 397315,
      "primary_message": "Transfer cooled tomatoes to the bowl along with the spinach. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 397316,
      "primary_message": "To serve, divide salad between plates or bowls and top with pine nuts. Enjoy!",
      "secondary_message": "1 cup pine nuts"
    }
  ],
