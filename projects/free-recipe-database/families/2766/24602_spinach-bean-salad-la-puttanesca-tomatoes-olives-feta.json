  "instructions": [
    {
      "id": 397368,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 397369,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 small pkgs grape tomatoes\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 397370,
      "primary_message": "Transfer tomatoes to a large baking sheet pan. Drizzle with oil and sprinkle with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 397371,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring tomatoes halfway through, until they start to burst, 13-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 397372,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 397373,
      "primary_message": "Zest and juice lemon into the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 397374,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with additional oil and salt; stir to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 397375,
      "primary_message": "Roughly chop olives. Add to the bowl with the dressing.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 397376,
      "primary_message": "Drain and rinse beans. Add to the bowl along with the feta. Set aside.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 397377,
      "primary_message": "When the tomatoes are done, remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 397378,
      "primary_message": "Transfer cooled tomatoes to the bowl along with the spinach. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 397379,
      "primary_message": "To serve, divide salad between plates or bowls and top with pine nuts. Enjoy!",
      "secondary_message": "⅔ cup pine nuts"
    }
  ],
