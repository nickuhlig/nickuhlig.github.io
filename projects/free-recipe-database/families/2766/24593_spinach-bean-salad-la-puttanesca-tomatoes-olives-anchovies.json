  "instructions": [
    {
      "id": 397255,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 397256,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 pints grape tomatoes\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 397257,
      "primary_message": "Transfer tomatoes to a large baking sheet pan. Drizzle with oil and sprinkle with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 397258,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring tomatoes halfway through, until they start to burst, 13-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 397259,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 397260,
      "primary_message": "Zest and juice lemon into the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 397261,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 397262,
      "primary_message": "Mince anchovy fillets. Add to the bowl along with additional oil and salt. Stir to combine the dressing.",
      "secondary_message": "6 anchovy fillets, packed in oil\n2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 397263,
      "primary_message": "Roughly chop olives. Add to the bowl with the dressing.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 397264,
      "primary_message": "Drain and rinse beans. Add to the bowl along with the feta. Set aside.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans\n1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 397265,
      "primary_message": "When the tomatoes are done, remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 397266,
      "primary_message": "Transfer cooled tomatoes to the bowl along with the spinach. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 397267,
      "primary_message": "To serve, divide white bean-tomato salad between plates or bowls; top with pine nuts. Enjoy!",
      "secondary_message": "⅔ cup pine nuts"
    }
  ],
