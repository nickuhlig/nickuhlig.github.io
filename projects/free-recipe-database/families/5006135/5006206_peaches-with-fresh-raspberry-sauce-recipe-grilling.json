  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon. Halve and pit the ripe but firm peaches.",
      "secondary_message": "½ lemon\n6 medium ripe but firm peaches"
    },
    {
      "id": 1,
      "primary_message": "Purée the raspberries and water in a food processor until smooth. Strain raspberry purée through fine-mesh strainer, pressing on solids to release as much liquid as possible; discard solids in strainer. Stir in 3 tablespoons sugar and 1 tablespoon fresh lemon juice until blended.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly over the charcoal grate.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While the charcoal is lighting, melt butter with brown sugar in a small skillet over medium heat. Remove skillet from heat. Brush peach halves all over with melted butter mixture.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Grill peaches until tender, about eight minutes, turning occasionally. Remove the from the grill and top with the sauce and vanilla ice cream or whipped cream. Serve immediately.",
      "secondary_message": null
    }
  ],
