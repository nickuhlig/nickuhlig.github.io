  "instructions": [
    {
      "id": 359096,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ red bell peppers\n1 ½ English cucumbers\n3 heads butter (Boston) lettuce\n3 tomatoes"
    },
    {
      "id": 359097,
      "primary_message": "Trim, seed, and roughly chop bell peppers; place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 359098,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into thin pieces. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 359099,
      "primary_message": "Separate lettuce leaves; set aside two leaves per sandwich and chop or tear remaining leaves into bite-sized pieces. Add chopped lettuce to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 359100,
      "primary_message": "Thinly slice tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 359101,
      "primary_message": "Toast bread if desired. ",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 359102,
      "primary_message": "Place pesto and mayo in a small bowl; stir to combine the aioli. ",
      "secondary_message": "¾ cup sun-dried tomato pesto\n⅓ cup mayonnaise"
    },
    {
      "id": 359103,
      "primary_message": "Spread aioli over each bread slice; layer half of the slices with lettuce, tomato, and turkey. Close sandwiches with remaining bread slices, then slice in half.",
      "secondary_message": "24 oz oven roasted turkey breast, sliced"
    },
    {
      "id": 359104,
      "primary_message": "Add vinaigrette to the bowl with the veggies and toss to combine the salad. ",
      "secondary_message": "¾ cup balsamic vinaigrette"
    },
    {
      "id": 359105,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
