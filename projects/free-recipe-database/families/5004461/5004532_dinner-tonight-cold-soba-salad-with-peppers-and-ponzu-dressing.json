  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring two quarts of water to a boil in a large pot. Add the noodles, stir well, and cook until al dente, about five minutes. Drain in a colander, and then rinse under cold water. Drain again.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk together the ponzu, soy sauce, lime juice, and honey in a medium-sized bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine the noodles, sauce, diced bell peppers, and scallions in a large bowl. Sprinkle with sesame seeds and some togarashi (optional).",
      "secondary_message": null
    }
  ],
