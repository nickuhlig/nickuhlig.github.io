  "instructions": [
    {
      "id": 400024,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 400025,
      "primary_message": "Cut tofu into ¾-inch thick planks along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 400026,
      "primary_message": "Cut butter into small pieces, place in a small bowl, and set aside to soften.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 400027,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 400028,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 400029,
      "primary_message": "Add miso paste, salt, and pepper to the bowl with the butter. Using the back of a spoon, mash and combine the miso butter until smooth.",
      "secondary_message": "2 tsp miso paste, red\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400030,
      "primary_message": "Spread ⅔ of the miso butter over the top-side of the tofu planks (reserve remaining miso butter for the rice).",
      "secondary_message": null
    },
    {
      "id": 400031,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until tofu is golden brown, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400032,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small pkg chives\n½ English cucumber\n1 Gala apple"
    },
    {
      "id": 400033,
      "primary_message": "Cut chives into small pieces. Place in a medium bowl along with the dressing and salt, then stir to combine. ",
      "secondary_message": "2 tbsp ranch dressing\n1 pinch salt"
    },
    {
      "id": 400034,
      "primary_message": "Trim and quarter cucumber lengthwise, then slice crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 400035,
      "primary_message": "Quarter, core, and small dice apple. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 400036,
      "primary_message": "When the rice is done, add remaining miso butter to the pan. Stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 400037,
      "primary_message": "To serve, divide tofu, salad, and rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
