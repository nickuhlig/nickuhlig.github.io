  "instructions": [
    {
      "id": 400011,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 400012,
      "primary_message": "Cut butter into small pieces, place in a small bowl, and set aside to soften.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 400013,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 400014,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 400015,
      "primary_message": "Add miso paste, salt, and pepper to the bowl with the butter. Using the back of a spoon, mash and combine the miso butter until smooth.",
      "secondary_message": "2 tbsp miso paste, red\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400016,
      "primary_message": "Pat the fish dry with paper towels and place, skin-side down, on a large baking sheet pan. Spread ⅔ of the miso butter over the top-side of the salmon (reserve remaining miso butter for the rice).",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 400017,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until salmon is golden and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400018,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small pkg chives\n1 ½ English cucumbers\n3 Gala apples"
    },
    {
      "id": 400019,
      "primary_message": "Cut chives into small pieces. Place in a medium bowl along with the dressing and salt, then stir to combine. ",
      "secondary_message": "⅓ cup ranch dressing\n3 pinch salt"
    },
    {
      "id": 400020,
      "primary_message": "Trim and quarter cucumbers lengthwise, then slice crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 400021,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 400022,
      "primary_message": "When the rice is done, add remaining miso butter to the pan. Stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 400023,
      "primary_message": "To serve, divide salmon, salad, and rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
