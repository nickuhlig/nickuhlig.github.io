  "instructions": [
    {
      "id": 297965,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 297966,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large pot. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 297967,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, add the sausages, cover the pot, and reduce the heat to low. Cook the rice until sausages are warmed through and the liquid is fully absorbed, 15-18 minutes. Once done, remove from the heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 297968,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n2 ¼ lb Brussels sprouts\n1 ½ limes"
    },
    {
      "id": 297969,
      "primary_message": "Peel, trim, and cut carrots lengthwise into quarters, then crosswise into 2-inch long pieces; divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 297970,
      "primary_message": "Trim and halve Brussels sprouts; add to the baking sheets with the carrots. Drizzle with oil, season with spices, and toss to combine; spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 297971,
      "primary_message": "Place baking sheets in the oven and roast, tossing once, until veggies are fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297972,
      "primary_message": "Meanwhile, juice limes into a small bowl; add maple syrup and chili-garlic sauce. Whisk to combine the maple-chili glaze.",
      "secondary_message": "3 tbsp pure maple syrup\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 297973,
      "primary_message": "When the veggies are done, drizzle with the glaze and toss to combine. Return to the oven and continue to roast until caramelized, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297974,
      "primary_message": "When the rice is done, carefully transfer the sausages to a cutting board and allow them to cool slightly. Cut in half lengthwise, then slice crosswise into ½-inch thick half-moons.",
      "secondary_message": null
    },
    {
      "id": 297975,
      "primary_message": "To serve, divide rice, veggies, and sausage between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
