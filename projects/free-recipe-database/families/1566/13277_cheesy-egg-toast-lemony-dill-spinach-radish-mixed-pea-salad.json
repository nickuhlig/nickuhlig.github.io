  "instructions": [
    {
      "id": 222058,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 222059,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 bunch radish\n4 sticks celery\n1 (227 g) pkg sugar snap peas\n1 small bunch fresh dill\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 222060,
      "primary_message": "Place peas in a colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 222061,
      "primary_message": "Juice lemon into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 222062,
      "primary_message": "Peel and mince garlic and shallot. Add both to the bowl with the lemon, along with oil, honey, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n1 shallot\n2 tbsp extra virgin olive oil\n2 tsp honey\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 222063,
      "primary_message": "Trim and thinly slice radishes and celery; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 222064,
      "primary_message": "Cut sugar snap peas crosswise into ½-inch pieces; add to the bowl, toss to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 222065,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 222066,
      "primary_message": "Peel and mince additional garlic; place in a medium bowl along with mayo, salt, and pepper. Stir to combine.",
      "secondary_message": "2 cloves garlic\n¼ cup mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 222067,
      "primary_message": "Peel and coarsely grate eggs. Coarsely grate cheese; add both to the bowl with the mayo and stir to combine.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 222068,
      "primary_message": "Split rolls in half and arrange, cut-side up, on a large baking sheet pan. Place in the oven and broil until lightly toasted, 1-2 minutes. ",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 222069,
      "primary_message": "Remove toasted rolls from the oven and spread with cheesy egg mixture. Return to the oven and broil until warmed through and cheese is melted, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 222070,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the veggies, along with thawed peas and spinach; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 222071,
      "primary_message": "To serve, divide cheesy egg toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
