  "instructions": [
    {
      "id": 222072,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "9 eggs"
    },
    {
      "id": 222073,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ bunches radish\n6 sticks celery\n1 ½ (227 g) pkg sugar snap peas\n1 small bunch fresh dill\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 222074,
      "primary_message": "Place peas in a colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 222075,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 222076,
      "primary_message": "Peel and mince garlic and shallots. Add both to the bowl with the lemon, along with oil, honey, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n2 shallots\n3 tbsp extra virgin olive oil\n1 tbsp honey\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 222077,
      "primary_message": "Trim and thinly slice radishes and celery; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 222078,
      "primary_message": "Cut sugar snap peas crosswise into ½-inch pieces; add to the bowl, toss to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 222079,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 222080,
      "primary_message": "Peel and mince additional garlic; place in a medium bowl along with mayo, salt, and pepper. Stir to combine.",
      "secondary_message": "3 cloves garlic\n⅓ cup mayonnaise\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 222081,
      "primary_message": "Peel and coarsely grate eggs. Coarsely grate cheese; add both to the bowl with the mayo and stir to combine.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 222082,
      "primary_message": "Split rolls in half and divide between two baking sheet pans; arrange cut-side up. Working in batches, place in the oven and broil until lightly toasted, 1-2 minutes. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 222083,
      "primary_message": "Remove toasted rolls from the oven and spread with cheesy egg mixture. Working in batches, return to the oven and broil until warmed through and cheese is melted, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 222084,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the veggies, along with thawed peas and spinach; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 222085,
      "primary_message": "To serve, divide cheesy egg toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
