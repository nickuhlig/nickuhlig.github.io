  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, combine the butter, lemon juice, paprika, harissa, garlic, honey, and salt. Season to taste with more salt or harissa.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Open bottom vent completely. Light large chimney starter filled 3/4 with charcoal briquettes (4 quarts). When top coals are partially covered with ash, pour evenly over bottom of grill. Set cooking grate in place, cover, and open lid vent completely. Heat grill until hot, about 5 minutes.\nTurn all burners to high; cover; and heat grill until hot, about 15 minutes. Leave all burners on high.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Clean and oil cooking grate. Grill corn, turning frequently, until charred and tender on all sides, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Immediately slather corn with prepared harissa butter. Sprinkle with parsley and serve.",
      "secondary_message": null
    }
  ],
