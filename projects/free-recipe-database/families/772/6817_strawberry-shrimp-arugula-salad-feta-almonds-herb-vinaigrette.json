  "instructions": [
    {
      "id": 89898,
      "primary_message": "Drain shrimp in a colander and rinse under cold water until there are no more ice chunks. Spread out on a clean towel and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 89899,
      "primary_message": "Wash and dry the fresh produce (skip the arugula if it came pre-washed).",
      "secondary_message": "2 (142 g) pkg baby arugula\n2 (454 g) pkgs strawberries\n1 small bunch green onions (scallions)\n2 lemons"
    },
    {
      "id": 89900,
      "primary_message": "Trim off the stem ends and slice the strawberries; add to a large salad bowl along with the arugula.",
      "secondary_message": null
    },
    {
      "id": 89901,
      "primary_message": "Trim off and discard the ends of the green onions and cut crosswise into ¼-inch pieces at an angle; add to the bowl with the strawberries and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 89902,
      "primary_message": "Juice lemon into a small bowl; add oil, Dijon, vinegar, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n4 tsp Dijon mustard\n4 tsp red wine vinegar\n4 tsp pure maple syrup\n½ tsp dill\n½ tsp basil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 89903,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 89904,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 89905,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 89906,
      "primary_message": "Add the shrimp and garlic to the skillet; cook until shrimp are opaque, 1-2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 89907,
      "primary_message": "To serve, divide the salad between the plates, top with feta, sliced almonds, and shrimp. Drizzle with dressing and enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n½ cup almonds, sliced"
    }
  ],
