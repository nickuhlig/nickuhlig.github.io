  "instructions": [
    {
      "id": 469934,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 469935,
      "primary_message": "Place flour, baking powder, and spices in a small bowl; stir to combine.",
      "secondary_message": "¼ cup all-purpose flour\n2 tsp baking powder\n1 tbsp chili powder\n1 tsp cumin, ground\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 469936,
      "primary_message": "Pat chicken dry with paper towels and place in a medium bowl. Drizzle with oil and toss to coat.",
      "secondary_message": "1 ⅛ kg chicken drumsticks\n2 tbsp neutral vegetable oil"
    },
    {
      "id": 469937,
      "primary_message": "Add seasoned flour to the bowl with the chicken, toss to coat, then press to adhere coating. Transfer chicken to the baking sheet, spreading it out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 469938,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until coating is crispy and chicken is cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 469939,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a clean medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp neutral vegetable oil\n2 tbsp white wine vinegar\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 469940,
      "primary_message": "Wash, dry, and quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Thinly slice lengthwise and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": "2 jalapeño peppers"
    },
    {
      "id": 469941,
      "primary_message": "Wash, dry, trim, and halve radishes, then slice crosswise into thin half-moons. Add to the bowl, along with broccoli slaw, and toss to combine.",
      "secondary_message": "1 bunch radish\n1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 469942,
      "primary_message": "To serve, divide chicken and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
