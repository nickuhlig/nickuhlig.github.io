  "instructions": [
    {
      "id": 469889,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 469890,
      "primary_message": "Place flour, baking powder, and spices in a small bowl; stir to combine.",
      "secondary_message": "⅓ cup all-purpose flour\n1 tbsp baking powder\n1 ½ tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 469891,
      "primary_message": "Pat chicken dry with paper towels and place in a large bowl. Drizzle with oil and toss to coat.",
      "secondary_message": "3 ¾ lb chicken drumsticks\n3 tbsp neutral vegetable oil"
    },
    {
      "id": 469892,
      "primary_message": "Add seasoned flour to the bowl with the chicken, toss to coat, then press to adhere coating. Transfer chicken to the baking sheet, spreading it out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 469893,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until coating is crispy and chicken is cooked through, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 469894,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a clean large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp neutral vegetable oil\n3 tbsp white wine vinegar\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 469895,
      "primary_message": "Wash, dry, and quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Thinly slice lengthwise and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": "3 jalapeño peppers"
    },
    {
      "id": 469896,
      "primary_message": "Wash, dry, trim, and halve radishes, then slice crosswise into thin half-moons. Add to the bowl, along with broccoli slaw, and toss to combine.",
      "secondary_message": "1 ½ bunches radish\n1 ½ (12 oz) pkgs broccoli slaw"
    },
    {
      "id": 469897,
      "primary_message": "To serve, divide chicken and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
