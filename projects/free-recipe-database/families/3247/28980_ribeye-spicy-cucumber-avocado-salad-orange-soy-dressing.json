  "instructions": [
    {
      "id": 462460,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462461,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 462462,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes. ",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 462463,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ oranges\n3 jalapeño peppers\n1 ½ English cucumbers\n1 ½ bunches radish\n1 ½ avocados\n1 small bunch cilantro"
    },
    {
      "id": 462464,
      "primary_message": "Zest and juice oranges into a large bowl. Add oil, soy sauce, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp neutral vegetable oil\n3 tbsp soy sauce\n2 tbsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 462465,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl with the dressing and stir to combine.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 462466,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Slice crosswise into thin half-moons and add to the bowl.  (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 462467,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 462468,
      "primary_message": "Trim and slice radishes into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 462469,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 462470,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 462471,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 462472,
      "primary_message": "To serve, divide salad between plates and top with steak. Enjoy! ",
      "secondary_message": null
    }
  ],
