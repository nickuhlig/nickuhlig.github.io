  "instructions": [
    {
      "id": 462369,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462370,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 462371,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes. ",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 462372,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 orange\n2 jalapeño peppers\n1 English cucumber\n1 bunch radish\n1 avocado\n1 small bunch cilantro"
    },
    {
      "id": 462373,
      "primary_message": "Zest and juice orange into a medium bowl. Add oil, soy sauce, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp neutral vegetable oil\n2 tbsp soy sauce\n4 tsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 462374,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl with the dressing and stir to combine.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 462375,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Slice crosswise into thin half-moons and add to the bowl.  (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 462376,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 462377,
      "primary_message": "Trim and slice radishes into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 462378,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 462379,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 462380,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 462381,
      "primary_message": "To serve, divide salad between plates and top with steak. Enjoy! ",
      "secondary_message": null
    }
  ],
