  "instructions": [
    {
      "id": 148755,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 English cucumber\n1 small pkg grape tomatoes\n1 yellow bell pepper"
    },
    {
      "id": 148756,
      "primary_message": "Shave leaves off the stems of the parsley; discard the stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 148757,
      "primary_message": "Finely chop the olives and sun-dried tomatoes; add to the bowl with the parsley.",
      "secondary_message": "½ cup Kalamata olives, pitted\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 148758,
      "primary_message": "Peel and mince garlic; add to the bowl with the olives along with oil and spices. Stir to combine the tapenade.",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 148759,
      "primary_message": "Add vinegar, oil, maple syrup, salt, and pepper to a medium bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp red wine vinegar\n2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 148760,
      "primary_message": "Trim off the ends of the cucumber; slice crosswise into thin rounds. Add to the salad bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 148761,
      "primary_message": "Halve the tomatoes and add to the salad bowl; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 148762,
      "primary_message": "Trim and thinly slice the bell pepper into rounds.",
      "secondary_message": null
    },
    {
      "id": 148763,
      "primary_message": "Thinly slice cheese.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 148764,
      "primary_message": "In a small bowl combine mayonnaise and vinegar; stir to combine.",
      "secondary_message": "¼ cup mayonnaise\n2 tsp red wine vinegar"
    },
    {
      "id": 148765,
      "primary_message": "Spread mayo over the bread and layer with cheese, prosciutto, bell pepper, and tapenade.",
      "secondary_message": "8 slices whole grain bread\n16 slices prosciutto"
    },
    {
      "id": 148766,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
