  "instructions": [
    {
      "id": 11560,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 11561,
      "primary_message": "Peel and small dice onion. Peel and mince garlic. Wash, dry, and small dice mushrooms.",
      "secondary_message": "1 medium yellow onion\r\n2 cloves garlic\r\n0.227 kg white mushrooms"
    },
    {
      "id": 11562,
      "primary_message": "Coat bottom of skillet with oil. Add onion, garlic, and mushrooms. Stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 11563,
      "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
      "secondary_message": "1 small pkg fresh thyme"
    },
    {
      "id": 11564,
      "primary_message": "Add ½ of the thyme, salt, and pepper to skillet. Stir and remove from heat. Transfer remaining thyme to a plate.",
      "secondary_message": "¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 11565,
      "primary_message": "Heat a small saucepan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 11566,
      "primary_message": "Wash, peel, and small dice carrots.",
      "secondary_message": "4 medium carrots"
    },
    {
      "id": 11567,
      "primary_message": "Coat bottom of saucepan with oil. Add carrots and cook until tender, 3-4 minutes. Transfer to plate with thyme.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 11568,
      "primary_message": "In the same small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "472 ml (2 cups) chicken or vegetable broth\n1 ⅓ cup whole wheat couscous"
    },
    {
      "id": 11569,
      "primary_message": "Cut a pocket in each pork chop. Season with salt and pepper, then fill with the mushroom and onion mixture. Transfer any remaining mixture to a plate.",
      "secondary_message": "4 pork chops, bone-in\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 11570,
      "primary_message": "Heat the skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 11571,
      "primary_message": "Coat bottom of skillet with oil. Add pork and cook until cooked through, 3-5 minutes per side.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 11572,
      "primary_message": "Uncover couscous and fluff with a fork. Add carrots and remaining thyme; mix well.",
      "secondary_message": ""
    },
    {
      "id": 11573,
      "primary_message": "To serve, place pork chops on a plate and couscous on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
