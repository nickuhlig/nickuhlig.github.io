  "instructions": [
    {
      "id": 83162,
      "primary_message": "Preheat oven to 425°F. Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 83163,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 oranges\n1.36 kg brussels sprouts\n0.68 kg sweet potato"
    },
    {
      "id": 83164,
      "primary_message": "Grate zest from the oranges. (Reserve oranges for later use.)",
      "secondary_message": null
    },
    {
      "id": 83165,
      "primary_message": "Measure out and roughly chop the cranberries.",
      "secondary_message": "¾ cup dried cranberries"
    },
    {
      "id": 83166,
      "primary_message": "In a large bowl, combine vinegar, honey, olive oil, salt, pepper, cranberries, and half of the orange zest.",
      "secondary_message": "2 tbsp balsamic vinegar\n2 tbsp honey\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 83167,
      "primary_message": "Remove the outer layer of leaves from the brussels sprouts, then trim off and discard the stem ends. Halve the sprouts lengthwise and add to vinegar mixture; toss until well coated.",
      "secondary_message": null
    },
    {
      "id": 83168,
      "primary_message": "Transfer Brussels sprouts to a large baking sheet pan and spread out in an even layer. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 83169,
      "primary_message": "Peel and cut the sweet potatoes into ½-inch cubes; place in the reserved bowl. Toss with olive oil, salt, and pepper. Transfer to another large baking sheet and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 434456,
      "primary_message": "Place baking sheets on the lower racks in the oven and roast, tossing halfway through, until veggies are tender, 20-25 minutes. Remove from oven.",
      "secondary_message": ""
    },
    {
      "id": 83170,
      "primary_message": "Meanwhile, halve the oranges. Juice 1 ½ oranges and slice the other 1 ½ into rings.",
      "secondary_message": null
    },
    {
      "id": 83171,
      "primary_message": "Combine orange juice with remaining zest, honey, salt, and pepper.",
      "secondary_message": "2 tbsp honey\n3 pinch salt"
    },
    {
      "id": 83172,
      "primary_message": "Line a third sheet pan with aluminum foil. Place the salmon fillets, skin-side down, in the middle of the sheet pan. Drizzle the orange juice mixture over the salmon and top with slices of orange. Place in the oven and bake until salmon is cooked through, 12-14 minutes.",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 83173,
      "primary_message": "To serve, divide salmon and roasted veggies between plates, spoon warm orange sauce over top. Enjoy!",
      "secondary_message": null
    }
  ],
