  "instructions": [
    {
      "id": 471173,
      "primary_message": "Preheat oven to 190°C (375°F). Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 471174,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ (454 g) pkgs strawberries\n1 ½ lemons\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 471175,
      "primary_message": "Trim and quarter strawberries lengthwise. Transfer to a large baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 471176,
      "primary_message": "Place baking dish on the upper rack of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until strawberries are soft, about 25 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 471177,
      "primary_message": "Meanwhile, zest lemons into a medium bowl. Add ricotta, salt, and pepper, then stir to combine; set aside. (Reserve lemons for later use.)",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471178,
      "primary_message": "When the strawberries have about 10 minutes left, divide flatbreads between two baking sheet pans. Place on the middle and lower racks and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven and set aside.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 471179,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a large bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 471180,
      "primary_message": "Juice reserved lemons into the bowl with the shallot. Add oil, salt, and pepper, then whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471181,
      "primary_message": "Add arugula to the bowl with the dressing and toss to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 471182,
      "primary_message": "Chop (or tear) prosciutto into bite-sized pieces. ",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 471183,
      "primary_message": "Spread the lemon ricotta over each flatbread, then top with roasted strawberries and prosciutto. Cut flatbreads into wedges.",
      "secondary_message": null
    },
    {
      "id": 471184,
      "primary_message": "To serve, divide flatbreads and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
