  "instructions": [
    {
      "id": 471125,
      "primary_message": "Preheat oven to 375°F. Place oven racks in the upper and middle positions.",
      "secondary_message": null
    },
    {
      "id": 471126,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 (16 oz) pkg strawberries\n1 lemon\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 471127,
      "primary_message": "Trim and quarter strawberries lengthwise. Transfer to a baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 471128,
      "primary_message": "Place baking dish on the upper rack of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until strawberries are soft, 20-25 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 471129,
      "primary_message": "Meanwhile, zest lemon into a small bowl. Add ricotta, salt, and pepper, then stir to combine; set aside. (Reserve lemon for later use.)",
      "secondary_message": "1 (15 oz) pkg ricotta cheese\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 471130,
      "primary_message": "When the strawberries have about 10 minutes left, arrange flatbreads on a large baking sheet pan. Place on the lower rack and bake, flipping halfway through, until flatbreads are slightly crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 471131,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 471132,
      "primary_message": "Juice reserved lemon into the bowl with the shallot. Add oil, salt, and pepper, then whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 471133,
      "primary_message": "Add arugula to the bowl with the dressing and toss to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 471134,
      "primary_message": "Chop (or tear) prosciutto into bite-sized pieces. ",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 471135,
      "primary_message": "Spread the lemon ricotta over each flatbread, then top with roasted strawberries and prosciutto. Cut flatbreads into wedges.",
      "secondary_message": null
    },
    {
      "id": 471136,
      "primary_message": "To serve, divide flatbreads and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
