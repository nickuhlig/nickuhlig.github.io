  "instructions": [
    {
      "id": 48932,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 Gala apples"
    },
    {
      "id": 48933,
      "primary_message": "Quarter the apples lengthwise, then cut out the core and stem from each section. Cut 2 of the quarters lengthwise into thin wedges and transfer to a small bowl. Medium dice the other 2 quarters and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 48934,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and add to the bowl with the apples.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 48935,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 48936,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the apples and onion.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 48937,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 48938,
      "primary_message": "Add the apples, onion, and garlic to the saucepan; season with oregano, salt, and pepper. Cook, stirring frequently, until the apples and onion are softened, 4 to 6 minutes.",
      "secondary_message": "1 tsp dried oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 48939,
      "primary_message": "Coarsely grate 2 cups of cheddar.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 48940,
      "primary_message": "Add the diced tomatoes and broth to the saucepan; season with additional salt and pepper. Bring the mixture to a boil, then reduce the heat to a simmer and cook for 8 to 10 minutes.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n473 ml (2 cups) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 48941,
      "primary_message": "Add butter to a nonstick skillet and heat over medium-low heat.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 48942,
      "primary_message": "Place the bread slices on a clean, dry work surface. Divide the apple slices and cheese between 4 of the bread slices, then top with the remaining bread slices.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 48943,
      "primary_message": "Once melted, spread the butter around the skillet, then season the bottom of the skillet with salt.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 48944,
      "primary_message": "Place the sandwiches in the skillet and cook until golden brown and crispy on the first side, 3 to 4 minutes. Then, add more butter and salt, and carefully flip the sandwiches; cook until golden brown on the other side and the cheese has melted, 3 to 4 minutes. Once done, transfer to a cutting board. Cook in batches if necessary.",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 48945,
      "primary_message": "Using a hand blender, purée the soup until smooth. Alternatively, use a potato masher to mash the tomatoes and apples (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 48946,
      "primary_message": "Cut the grilled cheese sandwiches in half diagonally.",
      "secondary_message": null
    },
    {
      "id": 48947,
      "primary_message": "To serve, divide the soup between small bowls and serve with the grilled cheese on the side. Enjoy!",
      "secondary_message": null
    }
  ],
