  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Place each jam in a small bowl and set aside. \n\n",
      "secondary_message": "¼ cup strawberry jam\n¼ cup apricot jam"
    },
    {
      "primary_message": "Peel and thinly slice banana. Place on a plate, along with raisins, and set aside.\n\n",
      "secondary_message": "1 banana\n¼ cup raisins"
    },
    {
      "primary_message": "Remove packaging from string cheese. Divide cheese between 6 serving plates, placing it in the center to create the \"body\" of the butterfly.\n\n",
      "secondary_message": "6 stick string cheese"
    },
    {
      "primary_message": "Split and toast muffins (if desired). Spread with cream cheese and cut in half. Add 4 pieces to each plate with the cheese, arranging them to create \"wings.\" \n\n",
      "secondary_message": "1 (12 oz) pkg whipped cream cheese spread"
    },
    {
      "primary_message": "Have fun decorating your butterflies with jam, bananas, and raisins. Show off your creations and enjoy!",
      "secondary_message": null
    }
  ],
