  "instructions": [
    {
      "id": 23367,
      "primary_message": "Peel and mince or grate ginger. In a medium bowl, prepare marinade by whisking together the minced ginger, water, soy sauce, vinegar, cornstarch, and pepper.",
      "secondary_message": "2 (1 inch) pieces ginger root\r\n½ cup water\r\n6 tbsp soy sauce\r\n2 tbsp rice vinegar\r\n1 tbsp cornstarch\r\n¼ tsp black pepper"
    },
    {
      "id": 23368,
      "primary_message": "Thinly slice steak and place in marinade; toss to coat and set aside.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\r\n"
    },
    {
      "id": 23369,
      "primary_message": "Wash and remove leaves from cauliflower. Using a food processor or grater, grate to rice-like texture.",
      "secondary_message": "2 medium heads cauliflower\r\n"
    },
    {
      "id": 23370,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 23371,
      "primary_message": "Add oil to skillet and swirl to coat bottom. Add cauliflower and cook, stirring frequently, until warmed through and slightly tender, 5-6 minutes. Season with salt and pepper. Transfer to a bowl and cover with foil to keep warm.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23372,
      "primary_message": "Wash mushrooms and green onions. Thinly slice mushrooms. Trim ends and thinly slice onions on the diagonal. Peel and mince garlic.",
      "secondary_message": "1 lb cremini mushrooms\r\n1 small bunch green onions (scallions)\r\n4 cloves garlic"
    },
    {
      "id": 23373,
      "primary_message": "Once cauliflower rice has been transferred, add more oil to skillet. Remove steak slices from marinade, reserving the marinade in the bowl, and add to skillet. Cook until browned, 1-2 minutes per side. Transfer to a plate.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 23374,
      "primary_message": "Add garlic, mushrooms, ½ of the green onions (save the rest for garnishing), and reserved marinade to skillet. Cook, stirring frequently, until mushrooms are tender and sauce has thickened.",
      "secondary_message": ""
    },
    {
      "id": 23375,
      "primary_message": "Wash and dry spinach.",
      "secondary_message": "1 (5 oz) pkg baby spinach\r\n"
    },
    {
      "id": 23376,
      "primary_message": "Return steak and add spinach to skillet. Stir until spinach is wilted and ingredients are well combined.",
      "secondary_message": ""
    },
    {
      "id": 23377,
      "primary_message": "Serve stir fry over cauliflower rice and garnish with remaining green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
