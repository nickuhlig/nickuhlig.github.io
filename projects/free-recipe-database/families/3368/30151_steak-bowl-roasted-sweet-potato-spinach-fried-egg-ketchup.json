  "instructions": [
    {
      "id": 479223,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 479224,
      "primary_message": "Wash, dry, peel, and medium dice sweet potato. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "¾ lb sweet potato\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 479225,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 479226,
      "primary_message": "When the sweet potatoes have about 10 minutes left, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479227,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 479228,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and stir-fry until almost cooked through, 2-3 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 479229,
      "primary_message": "Meanwhile, wash and dry spinach (skip if it came pre-washed).",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 479230,
      "primary_message": "When the steak is almost done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Transfer steak and spinach to a plate; cover with aluminum foil to keep warm. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 479231,
      "primary_message": "Wipe skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479232,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 eggs\n1 pinch salt"
    },
    {
      "id": 479233,
      "primary_message": "To serve, divide potatoes, steak, spinach, and eggs between plates or bowls. Drizzle with ketchup and enjoy!",
      "secondary_message": "2 tbsp ketchup"
    }
  ],
