  "instructions": [
    {
      "id": 479245,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 479246,
      "primary_message": "Wash, dry, peel, and medium dice sweet potatoes. Divide between two baking sheet pans, drizzle with oil, and season with salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 ¼ lb sweet potatoes\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 479247,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 479248,
      "primary_message": "When the sweet potatoes have about 15 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479249,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 479250,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and stir-fry until cooked through, 3-4 minutes. Transfer to a plate. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 479251,
      "primary_message": "Meanwhile, wash and dry spinach (skip if it came pre-washed).",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 479252,
      "primary_message": "When the steak is done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Transfer spinach to the plate with the steak; cover with aluminum foil to keep warm. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 479253,
      "primary_message": "Wipe skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479254,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 eggs\n3 pinch salt"
    },
    {
      "id": 479255,
      "primary_message": "To serve, divide potatoes, steak, spinach, and eggs between plates or bowls. Drizzle with ketchup and enjoy!",
      "secondary_message": "⅓ cup ketchup"
    }
  ],
