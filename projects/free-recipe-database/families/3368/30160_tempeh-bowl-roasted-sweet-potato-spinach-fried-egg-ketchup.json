  "instructions": [
    {
      "id": 479322,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 479323,
      "primary_message": "Wash, dry, peel, and medium dice sweet potato. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "⅓ kg sweet potato\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 479324,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 479325,
      "primary_message": "When the sweet potatoes have about 10 minutes left, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479326,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into thin strips. Place in a small bowl along with oil and spices. Gently toss to coat.",
      "secondary_message": "1 (227g ) pkg tempeh\n2 tsp extra virgin olive oil\n¼ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 479327,
      "primary_message": "Once the skillet is hot, add tempeh in a single layer and cook, flipping once, until browned and warmed through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 479328,
      "primary_message": "Meanwhile, wash and dry spinach (skip if it came pre-washed). ",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 479329,
      "primary_message": "When the tempeh is done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Transfer tempeh and spinach to a plate; cover with aluminum foil to keep warm. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 479330,
      "primary_message": "Wipe skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 479331,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 eggs\n1 pinch salt"
    },
    {
      "id": 479332,
      "primary_message": "To serve, divide potatoes, tempeh, spinach, and eggs between plates or bowls. Drizzle with ketchup and enjoy!",
      "secondary_message": "2 tbsp ketchup"
    }
  ],
