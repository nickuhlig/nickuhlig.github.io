  "instructions": [
    {
      "id": 385756,
      "primary_message": "Preheat oven to 220°C (425°F). Arrange racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 385757,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 yellow bell peppers\n3 tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 385758,
      "primary_message": "Pat salmon dry with paper towels. Place on a baking sheet pan, drizzle with oil, then season with salt and Italian seasoning.",
      "secondary_message": "1.02 kg salmon fillet\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp Italian seasoning"
    },
    {
      "id": 385759,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise; arrange on a large baking sheet. Drizzle with additional oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 385760,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until peppers are fork-tender and salmon is cooked through, 12-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 385761,
      "primary_message": "Meanwhile, small dice tomatoes. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 385762,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomato along with feta. Stir to combine and set aside.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 385763,
      "primary_message": "When the salmon and peppers are done, remove baking sheets from the oven. Loosely cover salmon with aluminum foil and set aside.",
      "secondary_message": null
    },
    {
      "id": 385764,
      "primary_message": "Change oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 385765,
      "primary_message": "Divide hummus between pepper halves and top with the tomato-feta mixture. Return baking sheet to the upper rack of the oven and broil until cheese is soft and starting to brown, 2-3 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups hummus"
    },
    {
      "id": 385766,
      "primary_message": "To serve, divide stuffed peppers and salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
