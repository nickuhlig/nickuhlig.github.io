  "instructions": [
    {
      "id": 385734,
      "primary_message": "Preheat oven to 220°C (425°F). Arrange rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 385735,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 yellow bell peppers\n1 tomato\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 385736,
      "primary_message": "Pat salmon dry with paper towels. Place on one half of a baking sheet pan. Drizzle with oil, then season with salt and Italian seasoning.",
      "secondary_message": "⅓ kg salmon fillet\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp Italian seasoning"
    },
    {
      "id": 385737,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise; add to the other half of the baking sheet. Drizzle with additional oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 385738,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until peppers are fork-tender and salmon is cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 385739,
      "primary_message": "Meanwhile, small dice tomato. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 385740,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomato along with feta. Stir to combine and set aside.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 385741,
      "primary_message": "When the salmon is done, remove baking sheet from the oven. Transfer the salmon to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": null
    },
    {
      "id": 385742,
      "primary_message": "Change oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 385743,
      "primary_message": "Divide hummus between pepper halves and top with the tomato-feta mixture. Return baking sheet to the oven and broil until cheese is soft and starting to brown, 2-3 minutes. Remove from oven.",
      "secondary_message": "½ cup hummus"
    },
    {
      "id": 385744,
      "primary_message": "To serve, divide stuffed peppers and salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
