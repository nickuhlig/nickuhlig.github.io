  "instructions": [
    {
      "primary_message": "In a mixing bowl, whisk together Chobani® vanilla blended Greek yogurt, butter, eggs, milk, dark brown sugar, and molasses.\n",
      "secondary_message": null
    },
    {
      "primary_message": "In a separate bowl, combine flour, baking powder, baking soda, salt, cinnamon, ginger, nutmeg, and cloves.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Fold dry ingredients into wet, being careful not to overmix.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Heat a sauté pan over medium heat and coat with nonstick cooking spray. Ladle 1/3-cup of batter into pan.\n",
      "secondary_message": null
    },
    {
      "primary_message": "In batches, cook pancakes on one side until they start to bubble and firm halfway through, about 2-3 minutes. Using a rubber spatula, flip the pancakes and cook for 30 seconds, or until done.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove pancakes and cover with foil to keep warm until ready to serve. Repeat process with remaining batter. Serve warm with maple syrup.",
      "secondary_message": null
    }
  ],
