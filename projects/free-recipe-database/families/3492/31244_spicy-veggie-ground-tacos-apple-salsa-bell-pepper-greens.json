  "instructions": [
    {
      "id": 494101,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 limes\n1 jalapeño pepper\n4 Gala apples\n1 small bunch cilantro\n1 yellow bell pepper\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 494102,
      "primary_message": "Juice one lime into a medium bowl. (Cut remaining lime into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 494103,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl with the lime juice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 494104,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494105,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with salt and pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 494106,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 494107,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 494108,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, veggie ground, and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n16 oz veggie ground, plant based\n1 tbsp chili powder\n1 tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 494109,
      "primary_message": "Meanwhile, place oil, vinegar, salt, and pepper in another medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 494110,
      "primary_message": "Trim, seed, and cut bell pepper into bite-sized pieces. Add to the bowl with the dressing, along with the mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 494111,
      "primary_message": "When the veggie ground is done, add hot sauce to the skillet, stir to combine, and remove from heat.",
      "secondary_message": "¼ cup hot sauce"
    },
    {
      "id": 494112,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 494113,
      "primary_message": "Divide tortillas between plates, then fill with spicy veggie ground and apple salsa. Serve with salad on the side and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
