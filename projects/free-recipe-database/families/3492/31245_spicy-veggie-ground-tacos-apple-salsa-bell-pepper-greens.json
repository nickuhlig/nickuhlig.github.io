  "instructions": [
    {
      "id": 494114,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 limes\n1 ½ jalapeño peppers\n6 Gala apples\n1 small bunch cilantro\n1 ½ yellow bell peppers\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 494115,
      "primary_message": "Juice half of the limes into a medium bowl. (Cut remaining limes into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 494116,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl with the lime juice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 494117,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494118,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with salt and pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 494119,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 494120,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 494121,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, veggie ground, and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 ½ tbsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 494122,
      "primary_message": "Meanwhile, place oil, vinegar, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 494123,
      "primary_message": "Trim, seed, and cut bell peppers into bite-sized pieces. Add to the bowl with the dressing, along with the mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 494124,
      "primary_message": "When the veggie ground is done, add hot sauce to the skillet, stir to combine, and remove from heat.",
      "secondary_message": "⅓ cup hot sauce"
    },
    {
      "id": 494125,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 494126,
      "primary_message": "Divide tortillas between plates, then fill with spicy veggie ground and apple salsa. Serve with salad on the side and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
