  "instructions": [
    {
      "id": 344031,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 344032,
      "primary_message": "Break spaghetti into thirds.",
      "secondary_message": "142 g spaghetti pasta"
    },
    {
      "id": 344033,
      "primary_message": "Once the water is boiling, uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain in a colander and set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 344034,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ small pkg fresh basil\n1 (142 g) pkg baby spinach\n½ lime"
    },
    {
      "id": 344035,
      "primary_message": "Peel and mince ginger and garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 344036,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 344037,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add ginger, garlic, and veggie ground. Cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp virgin coconut oil\n227 g veggie ground, plant based"
    },
    {
      "id": 344038,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 344039,
      "primary_message": "When the veggie ground is done, reduce heat to low. Add spinach and half of the basil to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 344040,
      "primary_message": "Juice lime into the skillet, then add the pasta, soy sauce, salt, and pepper. Continue to cook, stirring constantly, until warmed through, 1-2 minutes more. ",
      "secondary_message": "1 tbsp soy sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 344041,
      "primary_message": "To serve, divide the noodles and sauce between bowls; garnish with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
