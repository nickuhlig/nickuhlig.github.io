  "instructions": [
    {
      "id": 344053,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 344054,
      "primary_message": "Break spaghetti into thirds.",
      "secondary_message": "425 g spaghetti pasta"
    },
    {
      "id": 344055,
      "primary_message": "Once the water is boiling, uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain in a colander and set aside.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 344056,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 small pkg fresh basil\n3 (142 g) pkg baby spinach\n1 ½ limes"
    },
    {
      "id": 344057,
      "primary_message": "Peel and mince ginger and garlic. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 344058,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 344059,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add ginger, garlic, and veggie ground. Cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n680 g veggie ground, plant based"
    },
    {
      "id": 344060,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 344061,
      "primary_message": "When the veggie ground is done, reduce heat to low. Add spinach and half of the basil to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 344062,
      "primary_message": "Juice limes into the pot, then add the pasta, soy sauce, salt, and pepper. Continue to cook, stirring constantly, until warmed through, 2-3 minutes more. ",
      "secondary_message": "3 tbsp soy sauce\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 344063,
      "primary_message": "To serve, divide the noodles and sauce between bowls; garnish with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
