  "instructions": [
    {
      "id": 426556,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 426557,
      "primary_message": "Wash and dry squash; trim, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 medium spaghetti squash\n1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 426558,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 426559,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice celery.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 426560,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 426561,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 426562,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add celery, onion, and sausage; cook, breaking the meat apart with a spoon, until browned and crumbly, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n0.23 kg ground pork sausage"
    },
    {
      "id": 426563,
      "primary_message": "Add marinara, water, salt, and pepper to the pan; stir to combine the ragù. Continue to cook, stirring occasionally, until thickened, about 5 minutes. Remove from heat and cover to keep warm. ",
      "secondary_message": "½ (680 g) jar marinara sauce\n¼ cup water\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 426564,
      "primary_message": "When the squash is done, remove from oven and allow to cool slightly, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 426565,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 426566,
      "primary_message": "To serve, divide squash and ragù between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": "⅛ cup Parmesan cheese, shredded"
    }
  ],
