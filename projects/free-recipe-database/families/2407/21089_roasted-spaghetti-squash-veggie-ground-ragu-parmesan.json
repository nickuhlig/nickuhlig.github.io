  "instructions": [
    {
      "id": 426534,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 426535,
      "primary_message": "Wash and dry each squash; trim, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "2 medium spaghetti squash\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426536,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 426537,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice celery.",
      "secondary_message": "4 sticks celery"
    },
    {
      "id": 426538,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 426539,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 426540,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add celery, onion, and veggie ground; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, about 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based"
    },
    {
      "id": 426541,
      "primary_message": "Add marinara, water, and spices the pot; stir to combine the ragù. Continue to cook, stirring occasionally, until thickened, about 5 minutes. Remove from heat and cover to keep warm. ",
      "secondary_message": "1 (24 oz) jar marinara sauce\n⅔ cup water\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 426542,
      "primary_message": "When the squash is done, remove from oven and allow to cool slightly, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 426543,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 426544,
      "primary_message": "To serve, divide squash and ragù between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    }
  ],
