  "instructions": [
    {
      "id": 426512,
      "primary_message": "Preheat oven to 500°F and place racks in the upper and center positions. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 426513,
      "primary_message": "Wash and dry each squash; trim, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange halves, cut-side down, on the baking sheets.",
      "secondary_message": "3 medium spaghetti squash\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 426514,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 426515,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice celery. Place in a medium bowl. ",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 426516,
      "primary_message": "Peel, halve, and small dice onions; add to the bowl with the celery. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 426517,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 426518,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add celery, onion, and sausage; cook, breaking the meat apart with a spoon, until browned and crumbly, 6-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ lb ground pork sausage"
    },
    {
      "id": 426519,
      "primary_message": "Add marinara, water, salt, and pepper to the pot; stir to combine the ragù. Continue to cook, stirring occasionally, until thickened, 6-7 minutes. Remove from heat and cover to keep warm. ",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce\n¾ cup water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426520,
      "primary_message": "When the squash is done, remove from oven and allow to cool slightly, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 426521,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 426522,
      "primary_message": "To serve, divide squash and ragù between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": "⅓ cup Parmesan cheese, shredded"
    }
  ],
