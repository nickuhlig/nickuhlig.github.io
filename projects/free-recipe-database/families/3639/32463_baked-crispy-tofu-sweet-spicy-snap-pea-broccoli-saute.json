  "instructions": [
    {
      "id": 557692,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 557693,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 557694,
      "primary_message": "Finely grate Parmesan. Place in a medium bowl, along with bread crumbs and pepper, then stir to combine. Set aside.",
      "secondary_message": "6 oz Parmesan cheese\n¾ cup panko bread crumbs\n¾ tsp black pepper"
    },
    {
      "id": 557695,
      "primary_message": "Cut the tofu planks in half crosswise. Wipe baking sheet dry with paper towels, then divide tofu between the reserved baking sheet and another baking sheet.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 557696,
      "primary_message": "Spread half of the mayo over the top side of the tofu, sprinkle with half of the bread crumbs (pressing gently to adhere), and drizzle with half of the oil. Carefully flip tofu and repeat with remaining mayo, bread crumbs, and oil. (Reserve bowl for later use.)",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp toasted sesame oil"
    },
    {
      "id": 557697,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until the breading is crispy and golden brown, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 557698,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 red bell peppers\n3 crowns broccoli\n1 ½ (8 oz) pkgs sugar snap peas\n1 small bunch green onions (scallions)"
    },
    {
      "id": 557699,
      "primary_message": "Peel and mince ginger and garlic. Place both in the reserved bowl along with soy sauce, vinegar, honey, oil, chili-garlic sauce, and cornstarch. Whisk to combine the sauce and set aside.",
      "secondary_message": "3 cloves garlic\n¾ cup soy sauce\n¼ cup rice vinegar\n3 tbsp honey\n2 tbsp toasted sesame oil\n1 tbsp chili-garlic sauce\n1 tbsp cornstarch"
    },
    {
      "id": 557700,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 557701,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper along with snap peas.",
      "secondary_message": null
    },
    {
      "id": 557702,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 557703,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and stir-fry until just tender, 4-5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 557704,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. ",
      "secondary_message": null
    },
    {
      "id": 557705,
      "primary_message": "When the veggies are just tender, add sauce and half of the green onions to the pot. Continue to cook, stirring occasionally, until the sauce is thickened slightly, 2-3 minutes more. Remove from heat. (Reserve remaining green onions for serving.) ",
      "secondary_message": null
    },
    {
      "id": 557706,
      "primary_message": "To serve, divide the veggies and sauce between plates or bowls. Top with tofu and sprinkle with reserved green onions. Enjoy! ",
      "secondary_message": null
    }
  ],
