  "instructions": [
    {
      "id": 557797,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional) and coat with a thin layer of oil.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 557798,
      "primary_message": "Finely grate Parmesan. Place in a medium bowl, along with bread crumbs and pepper, then stir to combine. Set aside.",
      "secondary_message": "57 g Parmesan cheese\n¼ cup panko bread crumbs\n¼ tsp black pepper"
    },
    {
      "id": 557799,
      "primary_message": "Place egg in another medium bowl and beat with a whisk or fork until smooth.",
      "secondary_message": "1 egg"
    },
    {
      "id": 557800,
      "primary_message": "Cut the chicken into bite-sized pieces, add to the bowl with the egg, and stir to coat.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 557801,
      "primary_message": "Working in batches, use a slotted spoon to allow excess egg to drip off the chicken before transferring to the bowl with the bread crumb mixture. Turn to coat, pressing gently to adhere. Transfer breaded chicken to the baking sheet and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 557802,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until popcorn chicken is golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 557803,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 red bell pepper\n1 crown broccoli\n½ (227 g) pkg sugar snap peas\n½ small bunch green onions (scallions)"
    },
    {
      "id": 557804,
      "primary_message": "Using a clean cutting board, peel and mince ginger and garlic. Place both in a small bowl along with soy sauce, vinegar, honey, oil, chili-garlic sauce, and cornstarch. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 clove garlic\n¼ cup soy sauce\n1 ½ tbsp rice vinegar\n1 tbsp honey\n2 tsp toasted sesame oil\n1 tsp chili-garlic sauce\n1 tsp cornstarch"
    },
    {
      "id": 557805,
      "primary_message": "Trim, seed, and medium dice bell pepper. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 557806,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 557807,
      "primary_message": "While the skillet heats up, separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper along with snap peas.",
      "secondary_message": null
    },
    {
      "id": 557808,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and stir-fry until just tender, 3-4 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 557809,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. ",
      "secondary_message": null
    },
    {
      "id": 557810,
      "primary_message": "When the veggies are just tender, add sauce and half of the green onions to the skillet. Continue to cook, stirring occasionally, until the sauce is thickened slightly, 1-2 minutes more. Remove from heat. (Reserve remaining green onions for serving.) ",
      "secondary_message": null
    },
    {
      "id": 557811,
      "primary_message": "To serve, divide the veggies and sauce between plates or bowls. Top with popcorn chicken and sprinkle with reserved green onions. Enjoy! ",
      "secondary_message": null
    }
  ],
