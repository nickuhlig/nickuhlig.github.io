  "instructions": [
    {
      "id": 557842,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 557843,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 557844,
      "primary_message": "Finely grate Parmesan. Place in a small bowl, along with bread crumbs and pepper, then stir to combine. Set aside.",
      "secondary_message": "57 g Parmesan cheese\n¼ cup panko bread crumbs\n¼ tsp black pepper"
    },
    {
      "id": 557845,
      "primary_message": "Cut the tofu planks in half crosswise. Wipe baking sheet dry with paper towels, coat with a thin layer of oil, then return tofu to the baking sheet.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 557846,
      "primary_message": "Spread half of the mayo over the top side of the tofu, sprinkle with half of the bread crumbs (pressing gently to adhere), and drizzle with half of the oil. Carefully flip tofu and repeat with remaining mayo, bread crumbs, and oil. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp toasted sesame oil"
    },
    {
      "id": 557847,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until the breading is crispy and golden brown, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 557848,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 red bell pepper\n1 crown broccoli\n½ (227 g) pkg sugar snap peas\n½ small bunch green onions (scallions)"
    },
    {
      "id": 557849,
      "primary_message": "Peel and mince ginger and garlic. Place both in the reserved bowl along with soy sauce, vinegar, honey, oil, chili-garlic sauce, and cornstarch. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 clove garlic\n¼ cup soy sauce\n1 ½ tbsp rice vinegar\n1 tbsp honey\n2 tsp toasted sesame oil\n1 tsp chili-garlic sauce\n1 tsp cornstarch"
    },
    {
      "id": 557850,
      "primary_message": "Trim, seed, and medium dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 557851,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 557852,
      "primary_message": "While the skillet heats up, separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper along with snap peas.",
      "secondary_message": null
    },
    {
      "id": 557853,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and stir-fry until just tender, 3-4 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 557854,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. ",
      "secondary_message": null
    },
    {
      "id": 557855,
      "primary_message": "When the veggies are just tender, add sauce and half of the green onions to the skillet. Continue to cook, stirring occasionally, until the sauce is thickened slightly, 1-2 minutes more. Remove from heat. (Reserve remaining green onions for serving.) ",
      "secondary_message": null
    },
    {
      "id": 557856,
      "primary_message": "To serve, divide the veggies and sauce between plates or bowls. Top with tofu and sprinkle with reserved green onions. Enjoy! ",
      "secondary_message": null
    }
  ],
