  "instructions": [
    {
      "id": 557647,
      "primary_message": "Preheat oven to 450°F. Line two baking sheet pans with aluminum foil to make cleanup easier (optional) and coat with a thin layer of oil.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 557648,
      "primary_message": "Finely grate Parmesan. Place in a large bowl, along with bread crumbs and pepper, then stir to combine. Set aside.",
      "secondary_message": "6 oz Parmesan cheese\n¾ cup panko bread crumbs\n¾ tsp black pepper"
    },
    {
      "id": 557649,
      "primary_message": "Place eggs in another large bowl and beat with a whisk or fork until smooth.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 557650,
      "primary_message": "Cut the chicken into bite-sized pieces, add to the bowl with the egg, and stir to coat.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 557651,
      "primary_message": "Working in batches, use a slotted spoon to allow excess egg to drip off the chicken before transferring to the bowl with the bread crumb mixture. Turn to coat, pressing gently to adhere. Divide breaded chicken between the baking sheets and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 557652,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until popcorn chicken is golden and cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 557653,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 red bell peppers\n3 crowns broccoli\n1 ½ (8 oz) pkgs sugar snap peas\n1 small bunch green onions (scallions)"
    },
    {
      "id": 557654,
      "primary_message": "Using a clean cutting board, peel and mince ginger and garlic. Place both in a small bowl along with soy sauce, vinegar, honey, oil, chili-garlic sauce, and cornstarch. Whisk to combine the sauce and set aside.",
      "secondary_message": "3 cloves garlic\n¾ cup soy sauce\n¼ cup rice vinegar\n3 tbsp honey\n2 tbsp toasted sesame oil\n1 tbsp chili-garlic sauce\n1 tbsp cornstarch"
    },
    {
      "id": 557655,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 557656,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper along with snap peas.",
      "secondary_message": null
    },
    {
      "id": 557657,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 557658,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and stir-fry until just tender, 4-5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 557659,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. ",
      "secondary_message": null
    },
    {
      "id": 557660,
      "primary_message": "When the veggies are just tender, add sauce and half of the green onions to the pot. Continue to cook, stirring occasionally, until the sauce is thickened slightly, 2-3 minutes more. Remove from heat. (Reserve remaining green onions for serving.) ",
      "secondary_message": null
    },
    {
      "id": 557661,
      "primary_message": "To serve, divide the veggies and sauce between plates or bowls. Top with popcorn chicken and sprinkle with reserved green onions. Enjoy! ",
      "secondary_message": null
    }
  ],
