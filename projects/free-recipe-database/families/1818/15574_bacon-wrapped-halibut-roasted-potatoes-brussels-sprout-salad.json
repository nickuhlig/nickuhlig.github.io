  "instructions": [
    {
      "id": 279720,
      "primary_message": "Preheat oven to 205°C (400°F). Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 279721,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n1 ½ lemons\n0.68 kg Brussels sprouts"
    },
    {
      "id": 279722,
      "primary_message": "Quarter potatoes and transfer to a large baking sheet pan. Drizzle with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 279723,
      "primary_message": "Place baking sheet on lower rack of the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until potatoes are fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 279724,
      "primary_message": "Meanwhile, juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 279725,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice, along with oil, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 279726,
      "primary_message": "Pat halibut dry with paper towels, cut into portions (if necessary), and transfer to another large baking sheet. Season with spices, then wrap 2 slices of bacon around each portion; drizzle with oil.",
      "secondary_message": "1.02 kg halibut fillet\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper\n12 slices bacon\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 279727,
      "primary_message": "Place baking sheet on upper rack of the oven and roast until the fish is almost cooked through, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 279728,
      "primary_message": "Meanwhile, thinly slice Brussels sprouts crosswise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 279729,
      "primary_message": "Finely grate Parmesan and add to the bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 279730,
      "primary_message": "Add almonds to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "⅓ cup almonds, sliced"
    },
    {
      "id": 279731,
      "primary_message": "When the fish is almost cooked through, change oven setting to broil on high, and continue to cook until the bacon is crisp and fish is cooked through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 279732,
      "primary_message": "To serve, divide halibut, potatoes, and Brussels sprout salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
