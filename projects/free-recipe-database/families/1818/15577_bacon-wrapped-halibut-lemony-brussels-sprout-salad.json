  "instructions": [
    {
      "id": 279753,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 279754,
      "primary_message": "Wash, dry, and juice lemons into a large bowl.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 279755,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice, along with oil, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 279756,
      "primary_message": "Pat halibut dry with paper towels, cut into portions (if necessary), and transfer to a large baking sheet pan. Season with spices, then wrap 2 slices of bacon around each portion; drizzle with oil.",
      "secondary_message": "1.02 kg halibut fillet\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper\n12 slices bacon\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 279757,
      "primary_message": "Place baking sheet in the oven and roast until the fish is almost cooked through, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 279758,
      "primary_message": "Meanwhile, wash, dry, and thinly slice Brussels sprouts crosswise; add to the bowl with the dressing.",
      "secondary_message": "0.68 kg Brussels sprouts"
    },
    {
      "id": 279759,
      "primary_message": "Finely grate Parmesan and add to the bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 279760,
      "primary_message": "Add almonds to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "⅓ cup almonds, sliced"
    },
    {
      "id": 279761,
      "primary_message": "When the fish is almost cooked through, change oven setting to broil on high, and continue to cook until the bacon is crisp and fish is cooked through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 279762,
      "primary_message": "To serve, divide halibut and Brussels sprout salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
