  "instructions": [
    {
      "id": 279707,
      "primary_message": "Preheat oven to 205°C (400°F). Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 279708,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg new potatoes\n1 lemon\n0.45 kg Brussels sprouts"
    },
    {
      "id": 279709,
      "primary_message": "Quarter potatoes and transfer to a baking sheet pan. Drizzle with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 279710,
      "primary_message": "Place baking sheet on lower rack of the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until potatoes are fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 279711,
      "primary_message": "Meanwhile, juice lemon into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 279712,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice, along with oil, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 279713,
      "primary_message": "Pat halibut dry with paper towels, cut into portions (if necessary), and transfer to another baking sheet. Season with spices, then wrap 2 slices of bacon around each portion; drizzle with oil.",
      "secondary_message": "0.68 kg halibut fillet\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper\n8 slices bacon\n2 tsp extra virgin olive oil"
    },
    {
      "id": 279714,
      "primary_message": "Place baking sheet on upper rack of the oven and roast until the fish is almost cooked through, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 279715,
      "primary_message": "Meanwhile, thinly slice Brussels sprouts crosswise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 279716,
      "primary_message": "Finely grate Parmesan and add to the bowl.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 279717,
      "primary_message": "Add almonds to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "id": 279718,
      "primary_message": "When the fish is almost cooked through, change oven setting to broil on high, and continue to cook until the bacon is crisp and fish is cooked through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 279719,
      "primary_message": "To serve, divide halibut, potatoes, and Brussels sprout salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
