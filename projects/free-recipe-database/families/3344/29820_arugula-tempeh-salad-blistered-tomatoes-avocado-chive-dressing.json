  "instructions": [
    {
      "id": 475055,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 475056,
      "primary_message": "While the skillet heats up, medium dice tempeh. Place in a large bowl, drizzle with soy sauce, and stir to coat.",
      "secondary_message": "3 (227g ) pkgs tempeh\n2 tbsp soy sauce"
    },
    {
      "id": 475057,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh and salt; cook, stirring occasionally, until golden, 5-7 minutes. Transfer tempeh to a plate and set aside. (Reserve skillet and bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 475058,
      "primary_message": "While the tempeh is cooking, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 ½ lemons\n1 small pkg chives\n1 ½ (142 g) pkgs baby arugula\n3 avocados"
    },
    {
      "id": 475059,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add tomatoes and salt; cook, stirring occasionally, until starting to brown and burst, about 5 minutes. Remove from heat and set aside to cool, 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 475060,
      "primary_message": "Meanwhile, juice lemons into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 475061,
      "primary_message": "Chop chives into small pieces. Add half to the bowl with the lemon juice along with mayo, oil, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing. (Reserve remaining chives for serving.)",
      "secondary_message": "½ cup vegan mayonnaise\n1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 475062,
      "primary_message": "Add arugula and cooled tomatoes to the bowl with the dressing. Gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 475063,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and large dice. Season with salt.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 475064,
      "primary_message": "To serve, divide salad between plates or bowls. Top with avocado, tempeh, and reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
