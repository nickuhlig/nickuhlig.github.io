  "instructions": [
    {
      "id": 475005,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 475006,
      "primary_message": "While the skillet heats up, medium dice tempeh. Place in a medium bowl, drizzle with soy sauce, and stir to coat.",
      "secondary_message": "1 (227g ) pkg tempeh\n2 tsp soy sauce"
    },
    {
      "id": 475007,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh and salt; cook, stirring occasionally, until golden, 5-7 minutes. Transfer tempeh to a plate and set aside. (Reserve skillet and bowl for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 475008,
      "primary_message": "While the tempeh is cooking, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small pkg grape tomatoes\n½ lemon\n½ small pkg chives\n½ (142 g) pkg baby arugula\n1 avocado"
    },
    {
      "id": 475009,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add tomatoes and salt; cook, stirring occasionally, until starting to brown and burst, 3-5 minutes. Remove from heat and set aside to cool, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 475010,
      "primary_message": "Meanwhile, juice lemon into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 475011,
      "primary_message": "Chop chives into small pieces. Add half to the bowl with the lemon juice along with mayo, oil, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing. (Reserve remaining chives for serving.)",
      "secondary_message": "3 tbsp mayonnaise\n1 tsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 475012,
      "primary_message": "Add arugula and cooled tomatoes to the bowl with the dressing. Gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 475013,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and large dice. Season with salt.",
      "secondary_message": "1 pinch salt"
    },
    {
      "id": 475014,
      "primary_message": "To serve, divide salad between plates or bowls. Top with avocado, tempeh, and reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
