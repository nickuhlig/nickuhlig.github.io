  "instructions": [
    {
      "id": 297852,
      "primary_message": "Preheat oven to 245°C (475°F). Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 297853,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 297854,
      "primary_message": "Pat chicken wings dry with paper towels and transfer to the baking sheet. Drizzle with oil, sprinkle with garlic, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed\n4 tsp extra virgin olive oil\n1 tsp basil, dried\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 297855,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297856,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 tomatoes\n2 orange bell peppers"
    },
    {
      "id": 297857,
      "primary_message": "Peel and mince additional garlic; place in a medium bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 297858,
      "primary_message": "Peel and slice shallots into thin rings; add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 297859,
      "primary_message": "Trim and medium dice cucumber; medium dice tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297860,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297861,
      "primary_message": "Add olives and feta to the bowl; stir to combine the salad and set aside.",
      "secondary_message": "⅔ cup Kalamata olives, pitted\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 297862,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
