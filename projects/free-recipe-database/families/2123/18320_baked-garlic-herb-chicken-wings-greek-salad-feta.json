  "instructions": [
    {
      "id": 297841,
      "primary_message": "Preheat oven to 245°C (475°F). Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 297842,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 297843,
      "primary_message": "Pat chicken wings dry with paper towels and transfer to the baking sheet. Drizzle with oil, sprinkle with garlic, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken wings, split with tips removed\n2 tsp extra virgin olive oil\n½ tsp basil, dried\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 297844,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297845,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 tomato\n1 orange bell pepper"
    },
    {
      "id": 297846,
      "primary_message": "Peel and mince additional garlic; place in a medium bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 297847,
      "primary_message": "Peel and slice shallot into thin rings; add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 297848,
      "primary_message": "Trim and medium dice cucumber; medium dice tomato. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297849,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297850,
      "primary_message": "Add olives and feta to the bowl; stir to combine the salad and set aside.",
      "secondary_message": "⅓ cup Kalamata olives, pitted\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 297851,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
