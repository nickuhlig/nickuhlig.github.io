  "instructions": [
    {
      "id": 297863,
      "primary_message": "Preheat oven to 245°C (475°F). Line two baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 297864,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 297865,
      "primary_message": "Pat chicken wings dry with paper towels and divide between the baking sheets. Drizzle with oil, sprinkle with garlic, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed\n2 tbsp extra virgin olive oil\n1 ½ tsp basil, dried\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 297866,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 297867,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 tomatoes\n3 orange bell peppers"
    },
    {
      "id": 297868,
      "primary_message": "Peel and mince additional garlic; place in a large bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 297869,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 297870,
      "primary_message": "Trim and medium dice cucumbers; medium dice tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297871,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 297872,
      "primary_message": "Add olives and feta to the bowl; stir to combine the salad and set aside.",
      "secondary_message": "1 cup Kalamata olives, pitted\n1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 297873,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
