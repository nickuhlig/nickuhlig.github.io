  "instructions": [
    {
      "id": 233660,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 233661,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 233662,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms; transfer to a medium bowl and set aside.",
      "secondary_message": "0.68 kg cremini mushrooms"
    },
    {
      "id": 233663,
      "primary_message": "Pat the pork chops dry with paper towels and place on a cutting board; thinly slice crosswise into bite-sized strips and season with salt and pepper.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 233664,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 233665,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork strips and stir-fry until browned and cooked through, 5-6 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 233666,
      "primary_message": "Meanwhile, peel and mince garlic; place in another medium bowl along with soy sauce, cornstarch, peanut butter, chili-garlic sauce, oil, vinegar, honey, and spices. Whisk to combine the sauce and set aside.",
      "secondary_message": "6 cloves garlic\n⅓ cup soy sauce\n3 tbsp cornstarch\n2 tbsp natural peanut butter\n1 tbsp chili-garlic sauce\n1 tbsp toasted sesame oil\n1 tbsp rice vinegar\n1 ½ tsp honey\n¼ tsp cinnamon, ground\n3 pinch clove, ground\n3 pinch black pepper"
    },
    {
      "id": 233667,
      "primary_message": "When the pork is done, use a slotted spoon to transfer the strips to a large plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 233668,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until they start to soften, about 5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 233669,
      "primary_message": "Add broccoli slaw and sauce to the pot; continue to cook, stirring occasionally, until the veggies are tender-crisp and sauce thickens, 3-4 minutes.",
      "secondary_message": "3 (340 g) pkgs broccoli slaw"
    },
    {
      "id": 233670,
      "primary_message": "Return pork to the pot, along with any accumulated juices; stir to combine and cook until heated through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 233671,
      "primary_message": "To serve, divide rice and pork stir-fry between plates. Enjoy!",
      "secondary_message": null
    }
  ],
