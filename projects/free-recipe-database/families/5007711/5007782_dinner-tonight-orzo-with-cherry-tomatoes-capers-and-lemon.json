  "instructions": [
    {
      "id": 1,
      "primary_message": "Pour the olive oil into a large skillet set over medium heat. Dump in the tomatoes and the garlic and cook, stirring often, until the tomatoes become a little soft, about 3 minutes. Turn off the heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour the chicken stock and orzo into a large pot. Turn the heat to high and bring to a boil. Reduce the heat to a gentle simmer, cover, and cook for 7 minutes. Turn off the and let the pot sit, covered, for an additional 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in the thyme, capers, pine nuts, cheese, lemon zest, and the cooked tomatoes and garlic. Season with salt and pepper to taste.",
      "secondary_message": null
    }
  ],
