  "instructions": [
    {
      "id": 49542,
      "primary_message": "Preheat the oven to 232°C (450°F) and place the rack in the centre position.",
      "secondary_message": null
    },
    {
      "id": 49543,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n1 (227 g) pkg sugar snap peas"
    },
    {
      "id": 49544,
      "primary_message": "Quarter the potatoes and transfer to a baking sheet.",
      "secondary_message": null
    },
    {
      "id": 49545,
      "primary_message": "Drizzle the potatoes with olive oil and season with salt and pepper; toss to coat then spread out in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 49546,
      "primary_message": "Place the potatoes in the oven and roast, tossing halfway through cooking time, until they are tender and browned, 20 to 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 49547,
      "primary_message": "Halve the snap peas and transfer to a bowl. Add to the baking sheet with the potatoes halfway through cooking time.",
      "secondary_message": null
    },
    {
      "id": 49548,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 49549,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "0.68 kg ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 49550,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 49551,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 49552,
      "primary_message": "To serve, divide the steak and roasted vegetables between plates. Enjoy!",
      "secondary_message": null
    }
  ],
