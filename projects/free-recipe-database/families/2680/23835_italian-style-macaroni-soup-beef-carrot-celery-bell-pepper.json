  "instructions": [
    {
      "id": 388513,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388514,
      "primary_message": "Once the pot is hot, add oil and swirl to coat. Add the beef and spices; cook, breaking the meat apart with a spoon, until browned and cooked through, about 6 minutes. Using a slotted spoon, transfer beef to a plate and set aside. (Reserve pot with drippings for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 ¼ lb lean ground beef\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 388515,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 medium carrots\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 388516,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 388517,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 388518,
      "primary_message": "Trim and small dice celery. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388519,
      "primary_message": "Peel, halve, and medium dice onions. Peel and mince garlic. Add both to the bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 388520,
      "primary_message": "Return the pot (with drippings) to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388521,
      "primary_message": "Once the pot is hot, add the veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 388522,
      "primary_message": "Return beef to the pot along with broth, tomatoes, pasta, and Worcestershire. Stir to combine the soup, cover, and bring to a boil. Once boiling, reduce heat to medium and simmer until pasta is cooked through, 8-10 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes\n9 oz macaroni (elbow) pasta\n2 tbsp Worcestershire sauce"
    },
    {
      "id": 388523,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 388524,
      "primary_message": "Once the pasta is done, add half of the parsley to the soup and stir to combine. Remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 388525,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
