  "instructions": [
    {
      "id": 388500,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388501,
      "primary_message": "Once the pot is hot, add oil and swirl to coat. Add the beef and spices; cook, breaking the meat apart with a spoon, until browned and cooked through, about 5 minutes. Using a slotted spoon, transfer beef to a plate and set aside. (Reserve pot with drippings for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ lb lean ground beef\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 388502,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 medium carrots\n2 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 388503,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 388504,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 388505,
      "primary_message": "Trim and small dice celery. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388506,
      "primary_message": "Peel, halve, and medium dice onion. Peel and mince garlic. Add both to the bowl. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 388507,
      "primary_message": "Return the pot (with drippings) to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388508,
      "primary_message": "Once the pot is hot, add the veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 388509,
      "primary_message": "Return beef to the pot along with broth, tomatoes, pasta, and Worcestershire. Stir to combine the soup, cover, and bring to a boil. Once boiling, reduce heat to medium and simmer until pasta is cooked through, about 8 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes\n6 oz macaroni (elbow) pasta\n4 tsp Worcestershire sauce"
    },
    {
      "id": 388510,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 388511,
      "primary_message": "Once the pasta is done, add half of the parsley to the soup and stir to combine. Remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 388512,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
