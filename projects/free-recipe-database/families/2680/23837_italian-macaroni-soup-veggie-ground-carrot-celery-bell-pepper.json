  "instructions": [
    {
      "id": 388539,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388540,
      "primary_message": "Once the pot is hot, add oil and swirl to coat. Add the veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Transfer veggie ground to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 388541,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 medium carrots\n2 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 388542,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 388543,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 388544,
      "primary_message": "Trim and small dice celery. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388545,
      "primary_message": "Peel, halve, and medium dice onion. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 388546,
      "primary_message": "Return the pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388547,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 388548,
      "primary_message": "Return veggie ground to the pot along with broth, tomatoes, pasta, and vinegar. Stir to combine the soup, cover, and bring to a boil. Once boiling, reduce heat to medium and simmer until pasta is cooked through, about 8 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes\n6 oz macaroni (elbow) pasta\n2 tbsp balsamic vinegar"
    },
    {
      "id": 388549,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 388550,
      "primary_message": "Once the pasta is done, add half of the parsley to the soup and stir to combine. Remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 388551,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
