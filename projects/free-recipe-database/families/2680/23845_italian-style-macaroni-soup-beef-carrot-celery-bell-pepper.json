  "instructions": [
    {
      "id": 388643,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388644,
      "primary_message": "Once the pan is hot, add oil and swirl to coat. Add the beef and spices; cook, breaking the meat apart with a spoon, until browned and cooked through, about 5 minutes. Using a slotted spoon, transfer beef to a plate and set aside. (Reserve saucepan with drippings for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil\n⅓ kg lean ground beef\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 388645,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 medium carrot\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 388646,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 388647,
      "primary_message": "Peel, trim, and small dice carrot. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 388648,
      "primary_message": "Trim and small dice celery. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388649,
      "primary_message": "Return the saucepan (with drippings) to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388650,
      "primary_message": "While the pan is heating, peel, halve, and medium dice onion. Peel and mince garlic. Add both to the bowl. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 388651,
      "primary_message": "Once the pan is hot, add the veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 388652,
      "primary_message": "Return beef to the pan along with broth, tomatoes, pasta, and Worcestershire. Stir to combine the soup, cover, and bring to a boil. Once boiling, reduce heat to medium and simmer until pasta is cooked through, about 8 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n85 g macaroni (elbow) pasta\n2 tsp Worcestershire sauce"
    },
    {
      "id": 388653,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 388654,
      "primary_message": "Once the pasta is done, add half of the parsley to the soup and stir to combine. Remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 388655,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
