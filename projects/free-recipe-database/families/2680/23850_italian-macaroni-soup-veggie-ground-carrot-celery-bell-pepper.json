  "instructions": [
    {
      "id": 388708,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388709,
      "primary_message": "Once the pot is hot, add oil and swirl to coat. Add the veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Transfer veggie ground to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 388710,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 medium carrots\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 388711,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 388712,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 388713,
      "primary_message": "Trim and small dice celery. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388714,
      "primary_message": "Peel, halve, and medium dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 388715,
      "primary_message": "Return the pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 388716,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 388717,
      "primary_message": "Return veggie ground to the pot along with broth, tomatoes, pasta, and vinegar. Stir to combine the soup, cover, and bring to a boil. Once boiling, reduce heat to medium and simmer until pasta is cooked through, 8-10 minutes.",
      "secondary_message": "2129 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes\n255 g macaroni (elbow) pasta\n3 tbsp balsamic vinegar"
    },
    {
      "id": 388718,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 388719,
      "primary_message": "Once the pasta is done, add half of the parsley to the soup and stir to combine. Remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 388720,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
