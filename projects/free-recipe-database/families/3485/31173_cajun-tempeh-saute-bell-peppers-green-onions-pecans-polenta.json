  "instructions": [
    {
      "id": 493143,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, reduce heat to low and gradually add polenta to the pan in a thin steady stream, whisking continuously, until incorporated. Cover and cook, stirring occasionally, until polenta is soft and creamy, 15-25 minutes.",
      "secondary_message": "1065 ml chicken or vegetable broth\n1 ½ cups polenta (cornmeal)"
    },
    {
      "id": 493144,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 red bell peppers\n3 green bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 493145,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 493146,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl with the bell peppers. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 493147,
      "primary_message": "Peel and mince garlic. Add to the bowl and set aside.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 493148,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493149,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, and garlic to the pot. Cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 493150,
      "primary_message": "While the veggies are cooking, large dice tempeh. Add tempeh and spices to the pot. Continue to cook, stirring occasionally, until tempeh is browned and warmed through, 4-5 minutes more. ",
      "secondary_message": "3 (227g ) pkgs tempeh\n2 tbsp Cajun seasoning\n¾ tsp salt\n¾ tsp black pepper\n½ tsp cayenne pepper"
    },
    {
      "id": 493151,
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "¾ cup pecan halves"
    },
    {
      "id": 493152,
      "primary_message": "When the tempeh is done, add pecans to the pot and stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 493153,
      "primary_message": "When the polenta is done, add oil, salt, and pepper to the pan, then stir to combine. If the polenta is too firm, add hot water, a few tablespoons at a time, until you reach a desired consistency. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 493154,
      "primary_message": "To serve, divide polenta between plates or bowls; top with tempeh sauté and reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
