  "instructions": [
    {
      "id": 493044,
      "primary_message": "In a small saucepan, bring broth to a boil over high heat. Once boiling, reduce heat to low and gradually add polenta to the pan in a thin steady stream, whisking continuously, until incorporated. Cover and cook, stirring occasionally, until polenta is soft and creamy, 15-25 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n½ cup polenta (cornmeal)"
    },
    {
      "id": 493045,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 green bell pepper\n½ small bunch green onions (scallions)"
    },
    {
      "id": 493046,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 493047,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl with the bell peppers. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 493048,
      "primary_message": "Peel and mince garlic. Add to the bowl and set aside.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 493049,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493050,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, and garlic to the skillet. Cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 493051,
      "primary_message": "While the veggies are cooking, large dice tempeh. Add tempeh and spices to the skillet. Continue to cook, stirring occasionally, until tempeh is browned and warmed through, 3-4 minutes more. ",
      "secondary_message": "1 (8 oz) package tempeh\n2 tsp Cajun seasoning\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 493052,
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "¼ cup pecan halves"
    },
    {
      "id": 493053,
      "primary_message": "When the tempeh is done, add pecans to the skillet and stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 493054,
      "primary_message": "When the polenta is done, add oil, salt, and pepper to the pan, then stir to combine. If the polenta is too firm, add hot water, 1 tablespoon at a time, until you reach a desired consistency. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 493055,
      "primary_message": "To serve, divide polenta between plates or bowls; top with tempeh sauté and reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
