  "instructions": [
    {
      "id": 493018,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, reduce heat to low and gradually add polenta to the pan in a thin steady stream, whisking continuously, until incorporated. Cover and cook, stirring occasionally, until polenta is soft and creamy, 15-25 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 cup polenta (cornmeal)"
    },
    {
      "id": 493019,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 red bell peppers\n2 green bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 493020,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 493021,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl with the bell peppers. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 493022,
      "primary_message": "Peel and mince garlic. Add to the bowl and set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 493023,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 493024,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493025,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, and garlic to the skillet. Cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 493026,
      "primary_message": "Add shrimp and spices to the skillet. Continue to cook, stirring occasionally, until shrimp are just opaque and starting to color, 2-3 minutes more. ",
      "secondary_message": "4 tsp Cajun seasoning\n½ tsp salt\n½ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 493027,
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "⅔ cup pecan halves"
    },
    {
      "id": 493028,
      "primary_message": "When the shrimp are done, add pecans to the skillet and stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 493029,
      "primary_message": "When the polenta is done, add oil, salt, and pepper to the pan, then stir to combine. If the polenta is too firm, add hot water, 1 tablespoon at a time, until you reach a desired consistency. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 493030,
      "primary_message": "To serve, divide polenta between plates or bowls; top with shrimp sauté and reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
