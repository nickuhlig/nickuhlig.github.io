  "instructions": [
    {
      "id": 388460,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch green onions (scallions)\n½ English cucumber\n½ orange bell pepper\n1 heart romaine hearts"
    },
    {
      "id": 388461,
      "primary_message": "Juice half of the lime into a medium bowl. Cut remaining lime into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 388462,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the lime juice along with hoisin sauce and black pepper. Stir to combine the dressing. ",
      "secondary_message": "¼ cup hoisin sauce\n1 pinch black pepper"
    },
    {
      "id": 388463,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 388464,
      "primary_message": "Trim, seed, and halve bell pepper crosswise, then slice into thin strips. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388465,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388466,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, add to the bowl, and toss to combine the salad. ",
      "secondary_message": "½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 388467,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 388468,
      "primary_message": "Divide tortillas between plates, fill with chicken salad, and sprinkle with sesame seeds. Serve with lime wedges for squeezing and additional hoisin sauce for dipping. Enjoy!",
      "secondary_message": "1 tsp sesame seeds\n2 tbsp hoisin sauce"
    }
  ],
