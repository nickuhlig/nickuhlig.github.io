  "instructions": [
    {
      "id": 388451,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small bunch green onions (scallions)\n1 ½ English cucumbers\n1 ½ orange bell peppers\n3 hearts romaine hearts"
    },
    {
      "id": 388452,
      "primary_message": "Juice half of the limes into a large bowl. Cut remaining limes into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 388453,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the lime juice along with hoisin sauce and black pepper. Stir to combine the dressing. ",
      "secondary_message": "¾ cup hoisin sauce\n3 pinch black pepper"
    },
    {
      "id": 388454,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 388455,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388456,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 388457,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, add to the bowl, and toss to combine the salad. ",
      "secondary_message": "1 ½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 388458,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 388459,
      "primary_message": "Divide tortillas between plates, fill with chicken salad, and sprinkle with sesame seeds. Serve with lime wedges for squeezing and additional hoisin sauce for dipping. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds\n⅓ cup hoisin sauce"
    }
  ],
