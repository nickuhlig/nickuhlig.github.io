  "instructions": [
    {
      "id": 487485,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 487486,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.45 kg green beans\n1 lemon\n1 bunch radish\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 487487,
      "primary_message": "Trim and halve green beans crosswise.",
      "secondary_message": null
    },
    {
      "id": 487488,
      "primary_message": "Once the water is boiling, uncover, add beans, and stir for a few seconds; cook until fork-tender, 2-3 minutes. Using a slotted spoon, transfer beans to the colander, rinse with cold water, and set aside to drain (reserve pot with boiling water for later use).",
      "secondary_message": null
    },
    {
      "id": 487489,
      "primary_message": "While the beans are cooking, peel and mince garlic. Place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 487490,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, Dijon, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 487491,
      "primary_message": "Carefully add eggs to the pot of hot water and return to a boil over high heat. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 487492,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 487493,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 487494,
      "primary_message": "Once the pan is hot, coat with oil. Add steak and grill until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 487495,
      "primary_message": "Meanwhile, trim and slice radishes crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 487496,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl along with the cooled green beans and arugula. Toss to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 487497,
      "primary_message": "Peel and quarter eggs, then season with salt and pepper.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 487498,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 487499,
      "primary_message": "To serve, divide salad, steak, and eggs between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
