  "instructions": [
    {
      "primary_message": "Divide salsa, bouillon cubes, and cumin between two (quart-sized) jars. (Make sure to add the correct amount of bouillon; each jar should have enough to make 3 cups of broth.) ",
      "secondary_message": "⅔ cup salsa\n¼ tsp cumin, ground"
    },
    {
      "primary_message": "Add green beans and corn to the jars with the salsa mixture.",
      "secondary_message": "1 cup frozen green beans, pieces\n1 cup frozen corn"
    },
    {
      "primary_message": "Stack beef slices one on top of another, then medium dice and add to the jars.",
      "secondary_message": "170 g deli roast beef"
    },
    {
      "primary_message": "Wash, dry, trim, and halve radishes, then slice crosswise into thin half-moons. Add to the jars.",
      "secondary_message": "½ bunch radish"
    },
    {
      "primary_message": "Wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the jars.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "primary_message": "Roughly crush tortilla chips and add to the jars, packing gently if necessary.",
      "secondary_message": "57 g tortilla chips"
    },
    {
      "primary_message": "Screw lids onto jars and store in the fridge until needed. (Best if used within 2-3 days.)",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, empty jar into a microwave safe bowl. Fill now-empty jar ⅔ full with water and add to the bowl. Microwave on high until veggies and beef are warmed through, about 6 minutes. Let sit 1 minute, then carefully remove from the microwave. (Alternatively, place jar contents and water in a medium saucepan, then stir to combine. Bring to a simmer over medium-high and cook, stirring occasionally, until veggies are soft, 3-4 minutes.) Enjoy!",
      "secondary_message": null
    }
  ],
