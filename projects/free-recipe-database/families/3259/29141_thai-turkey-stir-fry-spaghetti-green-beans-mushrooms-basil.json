  "instructions": [
    {
      "id": 575090,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
    },
    {
      "id": 575091,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lb white mushrooms\n1 lb green beans\n1 small pkg fresh basil"
    },
    {
      "id": 575092,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 575093,
      "primary_message": "Trim and halve green beans. Add to the bowl with the mushrooms and set aside.",
      "secondary_message": null
    },
    {
      "id": 575094,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 575095,
      "primary_message": "While the skillet heats up, peel and mince shallots and garlic.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 575096,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shallot and garlic; cook stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 575097,
      "primary_message": "Add veggies and turkey to the skillet. Cook, breaking the meat apart with a spoon, until turkey is crumbly and veggies are tender, 5-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ lb ground turkey"
    },
    {
      "id": 575098,
      "primary_message": "Meanwhile, place soy sauce, fish sauce, chili-garlic sauce, sugar, and cornstarch in the reserved bowl. Whisk to combine the stir-fry sauce.",
      "secondary_message": "5 tbsp soy sauce\n1 tbsp fish sauce\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n1 tbsp cornstarch"
    },
    {
      "id": 575099,
      "primary_message": "When the turkey and veggies are done, add sauce to the skillet. Continue to cook, stirring occasionally, until sauce has thickened, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 575100,
      "primary_message": "Add drained pasta to the skillet. Continue to cook, tossing occasionally, until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 575101,
      "primary_message": "While the pasta is heating, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the skillet and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 575102,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
