  "instructions": [
    {
      "id": 575103,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n15 oz spaghetti pasta"
    },
    {
      "id": 575104,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb white mushrooms\n1 ½ lb green beans\n1 small pkg fresh basil"
    },
    {
      "id": 575105,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 575106,
      "primary_message": "Trim and halve green beans. Add to the bowl with the mushrooms and set aside.",
      "secondary_message": null
    },
    {
      "id": 575107,
      "primary_message": "Peel, halve, and mince onion. Peel and mince garlic. ",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 575108,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 575109,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 575110,
      "primary_message": "Add veggies and turkey to the pot. Cook, breaking the meat apart with a spoon, until turkey is crumbly and veggies are tender, 7-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 ¼ lb ground turkey"
    },
    {
      "id": 575111,
      "primary_message": "Meanwhile, place soy sauce, fish sauce, chili-garlic sauce, sugar, and cornstarch in the reserved bowl. Whisk to combine the stir-fry sauce.",
      "secondary_message": "½ cup soy sauce\n1 ½ tbsp fish sauce\n1 ½ tbsp chili-garlic sauce\n1 ½ tbsp brown sugar\n1 ½ tbsp cornstarch"
    },
    {
      "id": 575112,
      "primary_message": "When the turkey and veggies are done, add sauce to the pot. Continue to cook, stirring occasionally, until sauce has thickened, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 575113,
      "primary_message": "Add drained pasta to the pot. Continue to cook, tossing occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 575114,
      "primary_message": "While the pasta is heating, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the pot and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 575115,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
