  "instructions": [
    {
      "id": 575129,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
    },
    {
      "id": 575130,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lb white mushrooms\n1 lb green beans\n1 small pkg fresh basil"
    },
    {
      "id": 575131,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 575132,
      "primary_message": "Trim and halve green beans. Add to the bowl with the mushrooms and set aside.",
      "secondary_message": null
    },
    {
      "id": 575133,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 575134,
      "primary_message": "While the skillet heats up, peel and mince shallots and garlic.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 575135,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shallot and garlic; cook stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 575136,
      "primary_message": "Add vegetables and veggie ground to the skillet. Cook, breaking the veggie ground apart with a spoon, until crumbly and vegetables are tender, 5-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "16 oz veggie ground, plant based"
    },
    {
      "id": 575137,
      "primary_message": "Meanwhile, place soy sauce, chili-garlic sauce, sugar, and cornstarch in the reserved bowl. Whisk to combine the stir-fry sauce.",
      "secondary_message": "5 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n1 tbsp cornstarch"
    },
    {
      "id": 575138,
      "primary_message": "When the veggie ground and vegetables are done, add sauce to the skillet. Continue to cook, stirring occasionally, until sauce has thickened, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 575139,
      "primary_message": "Add drained pasta to the skillet. Continue to cook, tossing occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 575140,
      "primary_message": "While the pasta is heating, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the skillet and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 575141,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
