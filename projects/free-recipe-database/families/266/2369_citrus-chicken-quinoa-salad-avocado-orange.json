  "instructions": [
    {
      "id": 22773,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 22774,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 22775,
      "primary_message": "Cube chicken into 1 inch pieces. Season with paprika, salt, and pepper; toss to coat.",
      "secondary_message": "1 lb chicken breasts, boneless skinless\r\n½ tsp paprika\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 22776,
      "primary_message": "Coat bottom of skillet with oil. Add chicken pieces and cook until browned and cooked through, 2-3 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n"
    },
    {
      "id": 22777,
      "primary_message": "Halve and pit avocados. Scoop out the flesh, medium dice, and transfer to a salad bowl.",
      "secondary_message": "2 avocados\r\n"
    },
    {
      "id": 22778,
      "primary_message": "Slice off top and bottom from oranges, then cut off the skin and white pith from the sides so you can see the orange flesh. Cut in between the thin membranes to release the segments and add to salad bowl.",
      "secondary_message": "2 oranges\r\n"
    },
    {
      "id": 22779,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Add to salad bowl.",
      "secondary_message": "1 small bunch cilantro.\r\n"
    },
    {
      "id": 22780,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lime juice, olive oil, honey, salt, and pepper.",
      "secondary_message": "4 cloves garlic\r\njuice of 2 limes\r\n2 tbsp extra virgin olive oil\r\n2 tsp honey\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 22781,
      "primary_message": "Rinse quinoa in a stainer if there is excess water and add to salad bowl. Add chicken and pour dressing over top. Toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 22782,
      "primary_message": "Serve in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
