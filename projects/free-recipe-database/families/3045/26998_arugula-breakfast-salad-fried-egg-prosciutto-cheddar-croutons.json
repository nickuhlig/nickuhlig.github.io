  "instructions": [
    {
      "id": 435789,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 435790,
      "primary_message": "While the skillet heats up, cut bread into 1-inch cubes. Place in a medium bowl, drizzle with oil, and season with spices; toss to coat.",
      "secondary_message": "2 slices whole grain bread\n2 tsp extra virgin olive oil\n1 pinch garlic powder\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 435791,
      "primary_message": "Once the skillet is hot, add bread cubes and cook, stirring occasionally, until the croutons are golden and toasted, 3-4 minutes. Return to the bowl. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 435792,
      "primary_message": "Meanwhile, place additional oil, vinegar, honey, salt, and pepper in another medium bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n½ tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 435793,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 435794,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 435795,
      "primary_message": "While the eggs are cooking, wash, dry, trim, and thinly slice radishes. Add to the bowl with the dressing.",
      "secondary_message": "½ bunch radish"
    },
    {
      "id": 435796,
      "primary_message": "Wash and dry arugula (skip if it came pre-washed). Add to the bowl.",
      "secondary_message": "½ (5 oz) pkg baby arugula"
    },
    {
      "id": 435797,
      "primary_message": "Small dice cheese. Add to the bowl, along with the croutons, and toss to combine the salad. ",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 435798,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces.",
      "secondary_message": "2 slices prosciutto"
    },
    {
      "id": 435799,
      "primary_message": "To serve, divide salad between plates or bowls; top with prosciutto and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
