  "instructions": [
    {
      "id": 435972,
      "primary_message": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder"
    },
    {
      "id": 435973,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 435974,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 435975,
      "primary_message": "Meanwhile, wash, dry, trim, and thinly slice radishes. Add to the bowl with the dressing.",
      "secondary_message": "½ bunch radish"
    },
    {
      "id": 435976,
      "primary_message": "Wash and dry arugula (skip if it came pre-washed). Add to the bowl.",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 435977,
      "primary_message": "Small dice cheese and add to the bowl. Toss to combine the salad.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 435978,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 435979,
      "primary_message": "To serve, divide salad between plates or bowls; top with prosciutto and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
