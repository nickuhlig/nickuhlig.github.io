  "instructions": [
    {
      "id": 575007,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 575008,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 575009,
      "primary_message": "Place flour, oats, sugar, and salt in another medium bowl. Whisk to combine.",
      "secondary_message": "1 cup all-purpose flour\n½ cup oats, quick cooking\n½ cup brown sugar\n½ tsp salt"
    },
    {
      "id": 575010,
      "primary_message": "Cut butter into small pieces. Place in a medium saucepan and melt over medium heat, stirring occasionally. Add melted butter to the bowl with flour mixture and stir to combine; transfer to a baking sheet pan and spread out in an even layer. (Wipe pan clean and reserve for later use.)",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 575011,
      "primary_message": "Place baking sheet in oven (it doesn't have to be fully heated) and bake, stirring halfway through, until the streusel is golden brown and crisp, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 575012,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 (454 g) pkg strawberries\n1 small pkg fresh basil"
    },
    {
      "id": 575013,
      "primary_message": "Juice lemon into the reserved pan. Trim and roughly chop strawberries, then add to the pan along with sugar. Stir to combine.",
      "secondary_message": "2 tbsp brown sugar"
    },
    {
      "id": 575014,
      "primary_message": "Set pan over medium heat and cook, stirring frequently, until strawberries are very soft and release their juices, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 575015,
      "primary_message": "While the strawberries are cooking, place cornstarch and water in a small bowl. Whisk to combine the slurry.",
      "secondary_message": "2 tsp cornstarch\n118 ml (½ cup) water"
    },
    {
      "id": 575016,
      "primary_message": "When the strawberries are very soft, add slurry to the pan. Continue to cook, stirring constantly, until the compote thickens, 2-3 minutes more. Transfer to a clean medium bowl and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 575017,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 575018,
      "primary_message": "When the compote is cool, add basil to the bowl and stir to combine. Set aside.",
      "secondary_message": null
    },
    {
      "id": 575019,
      "primary_message": "Remove bowl from freezer. Pour cream and vanilla into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "237 ml heavy whipping cream\n1 tsp vanilla extract"
    },
    {
      "id": 575020,
      "primary_message": "To serve, divide streusel, compote, and whipped cream between small bowls, cups, or jars, alternating ingredients to create layers. Enjoy!",
      "secondary_message": null
    }
  ],
