  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Lightly coat an 8 1/2- by 4 1/2-inch loaf pan with nonstick cooking spray. Line pan with parchment paper, leaving a 2-inch overhang on 2 opposite sides. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk brown sugar and eggs until sugar is dissolved and mixture is slightly thickened, about 1 minute. Add applesauce, oil, and vanilla and whisk until well combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add flour, baking powder, cinnamon, ginger, kosher salt, baking soda, and nutmeg; gently whisk just until no dry flour remains. Using a flexible spatula, fold in apple and crystallized ginger, if using, until evenly distributed.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Scrape batter into prepared pan and spread into an even layer. Sprinkle evenly with turbinado sugar. Bake until cake is lightly browned, and a toothpick inserted into the center comes out with a few moist crumbs attached, about 55 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Let loaf cool in pan on a wire rack for 20 minutes. Using parchment overhang as handles, lift cake from pan and transfer to wire rack. Let cool completely, about 1 hour. Slice and serve.",
      "secondary_message": null
    }
  ],
