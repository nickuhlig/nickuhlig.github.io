  "instructions": [
    {
      "id": 495347,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 495348,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 lemons\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs spring mix (mixed greens)\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 495349,
      "primary_message": "Juice half of the lemons into a blender (reserve remaining lemons for later use). ",
      "secondary_message": null
    },
    {
      "id": 495350,
      "primary_message": "Drain and rinse beans; add to the blender.",
      "secondary_message": "3 (15 oz) cans pinto beans"
    },
    {
      "id": 495351,
      "primary_message": "Peel garlic. Add to the blender along with tahini, water, oil, and spices. Blend the mixture on high for several minutes until smooth, scraping down the sides of the blender as needed. Add additional water, 1 tablespoon at a time, if needed, to reach a smooth consistency. Set the hummus aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup tahini\n⅓ cup water\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 495352,
      "primary_message": "Juice remaining lemons into a large bowl. Add oil, maple syrup, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp pure maple syrup\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 495353,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing, along with mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 495354,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 495355,
      "primary_message": "Spread toasted bread with hummus, then top with sprouts. ",
      "secondary_message": null
    },
    {
      "id": 495356,
      "primary_message": "To serve, divide toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
