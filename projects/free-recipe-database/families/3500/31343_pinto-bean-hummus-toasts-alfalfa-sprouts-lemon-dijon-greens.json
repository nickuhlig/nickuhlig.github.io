  "instructions": [
    {
      "id": 495337,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 495338,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 lemons\n1 pint grape tomatoes\n1 (5 oz) pkg spring mix (mixed greens)\n1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 495339,
      "primary_message": "Juice one lemon into a blender (reserve remaining lemon for later use). ",
      "secondary_message": null
    },
    {
      "id": 495340,
      "primary_message": "Drain and rinse beans; add to the blender.",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "id": 495341,
      "primary_message": "Peel garlic. Add to the blender along with tahini, water, oil, and spices. Blend the mixture on high for several minutes until smooth, scraping down the sides of the blender as needed. Add additional water, 1 tablespoon at a time, if needed, to reach a smooth consistency. Set the hummus aside.",
      "secondary_message": "2 cloves garlic\n¼ cup tahini\n¼ cup water\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 495342,
      "primary_message": "Juice remaining lemon into a medium bowl. Add oil, maple syrup, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp pure maple syrup\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495343,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing, along with mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 495344,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices sourdough bread"
    },
    {
      "id": 495345,
      "primary_message": "Spread toasted bread with hummus, then top with sprouts. ",
      "secondary_message": null
    },
    {
      "id": 495346,
      "primary_message": "To serve, divide toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
