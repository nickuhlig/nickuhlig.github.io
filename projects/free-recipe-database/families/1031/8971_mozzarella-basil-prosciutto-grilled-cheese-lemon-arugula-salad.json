  "instructions": [
    {
      "id": 139719,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 small pkgs fresh basil\n3 lemons\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 139720,
      "primary_message": "Thinly slice the mozzarella. ",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 139721,
      "primary_message": "Pick basil leaves off the stems.",
      "secondary_message": null
    },
    {
      "id": 139722,
      "primary_message": "Preheat a grill pan or nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 139723,
      "primary_message": "Place the bread slices on a flat surface. Evenly top half of the slices with the prosciutto, basil leaves, and sliced mozzarella. Cover the sandwiches with the remaining bread slices.",
      "secondary_message": "12 slices whole grain bread\n18 slices prosciutto"
    },
    {
      "id": 139724,
      "primary_message": "Coat the grill pan or skillet with butter.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 139725,
      "primary_message": "Cooking in batches if necessary, place the sandwiches in the pan and cook until the bottom is golden brown, 2-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 139726,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the pan; return the sandwiches to the pan, browned-side-up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes. Once done, transfer to a cutting board.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 139727,
      "primary_message": "While the sandwiches toast, juice the lemons into a large bowl. Whisk in the vinegar, oil, salt, and honey. ",
      "secondary_message": "⅓ cup white wine vinegar\n⅓ cup extra virgin olive oil\n¾ tsp salt\n1 tbsp honey"
    },
    {
      "id": 139728,
      "primary_message": "Use a vegetable peeler to shave the Parmesan into strips. ",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 139729,
      "primary_message": "Add the arugula and shaved Parmesan to the bowl with the dressing and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 139730,
      "primary_message": "Cut the sandwiches in half on the diagonal.",
      "secondary_message": null
    },
    {
      "id": 139731,
      "primary_message": "To serve, divide the salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
