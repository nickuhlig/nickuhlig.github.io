  "instructions": [
    {
      "id": 43786,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 ears corn\n2 pints grape tomatoes\n1 lime\n1 small bunch green onions (scallions)"
    },
    {
      "id": 43787,
      "primary_message": "Remove the husks and silks from the corn. Working one ear at a time, hold the corn vertically inside a large bowl and slice the kernels away from the cob; discard the cob. Set the bowl aside.",
      "secondary_message": ""
    },
    {
      "id": 43788,
      "primary_message": "Halve the grape tomatoes crosswise and transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43789,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43790,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 43791,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season the cutlets with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 43792,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 43793,
      "primary_message": "Place the chicken cutlets in the skillet; cook until they are golden brown on the outside and cooked through in the center, 2 to 4 minutes per side. Once done, transfer to a plate and cover with foil to keep warm. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 43794,
      "primary_message": "Once the chicken has been transferred, add the corn kernels to the skillet; cook, stirring frequently, until tender and lightly browned, 3 to 4 minutes. Once done, add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43795,
      "primary_message": "Add the feta to the salad bowl.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 43796,
      "primary_message": "Juice the lime and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 43797,
      "primary_message": "Drizzle the salad with olive oil and season with salt and pepper; toss to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 43798,
      "primary_message": "To serve, divide the chicken cutlets and salad between plates; season the salad with additional salt and pepper if desired. Enjoy!",
      "secondary_message": null
    }
  ],
