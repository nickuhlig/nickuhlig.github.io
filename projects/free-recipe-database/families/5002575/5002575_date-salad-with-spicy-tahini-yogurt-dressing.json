  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Dates: In a small bowl, combine dates, lemon juice, and orange blossom water, if using. Toss well and let stand at room temperature until softened, at least 15 minutes. (Continue to step 2 while dates soak.)",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Dressing: In a medium bowl, whisk together tahini, yogurt, apple cider vinegar, lemon juice, gochunjang, sriracha, or harissa, sugar, garlic, salt, and water. Whisk until dressing is smooth and pourable, adjusting with more water, 1 teaspoon at a time, as needed. Taste and adjust with additional salt as needed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Salad: In a large bowl, combine lettuce, cucumbers, radishes, mint, salt, and reserved dates. Drizzle with about three-quarters of the dressing and toss gently until evenly coated. Add more dressing as desired, saving any leftover dressing for another use. Season to taste with salt if needed. Transfer to a large serving platter, top with sesame seeds, and serve immediately.",
      "secondary_message": null
    }
  ],
