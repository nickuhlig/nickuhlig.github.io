  "instructions": [
    {
      "id": 229556,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 229557,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg Brussels sprouts\n1 lemon\n1 bunch kale\n1 Gala apple\n½ small bunch green onions (scallions)"
    },
    {
      "id": 229558,
      "primary_message": "Trim ends and halve Brussels sprouts. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 229559,
      "primary_message": "Add oil and salt to the bowl and toss to coat. Transfer Brussels sprouts to a baking sheet pan in a single layer and place in the oven. Roast, tossing once, until fork-tender, 20-25 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 229560,
      "primary_message": "Meanwhile, juice lemon into the bowl used for the Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 229561,
      "primary_message": "Peel and mince garlic, then add to the bowl with the lemon juice. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 229562,
      "primary_message": "Add mayo, oil, Dijon, honey, salt, and pepper to the bowl and whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229563,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl. Using your hands, massage the dressing into the kale.",
      "secondary_message": null
    },
    {
      "id": 229564,
      "primary_message": "Core and small dice apple, then add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 229565,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 229566,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 229567,
      "primary_message": "When the Brussels sprouts are done, remove from oven and sprinkle with Parmesan. Set aside to cool slightly and allow cheese to melt, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 229568,
      "primary_message": "Add cranberries, pumpkin seeds, and Brussels sprouts to the bowl and toss to combine the salad.",
      "secondary_message": "⅛ cup dried cranberries\n⅛ cup pumpkin seeds"
    },
    {
      "id": 229569,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
