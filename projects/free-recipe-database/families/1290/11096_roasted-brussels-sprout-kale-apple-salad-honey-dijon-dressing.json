  "instructions": [
    {
      "id": 229528,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 229529,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lb Brussels sprouts\n2 lemons\n2 bunches kale\n2 Gala apples\n1 small bunch green onions (scallions)"
    },
    {
      "id": 229530,
      "primary_message": "Trim ends and halve Brussels sprouts. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 229531,
      "primary_message": "Add oil and salt to the bowl and toss to coat. Transfer Brussels sprouts to a large baking sheet pan in a single layer and place in the oven. Roast, tossing once, until fork-tender, 20-25 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp salt"
    },
    {
      "id": 229532,
      "primary_message": "Meanwhile, juice lemons into the bowl used for the Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 229533,
      "primary_message": "Peel and mince garlic, then add to the bowl with the lemon juice. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 229534,
      "primary_message": "Add mayo, oil, Dijon, honey, salt, and pepper to the bowl and whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n4 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229535,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl. Using your hands, massage the dressing into the kale.",
      "secondary_message": null
    },
    {
      "id": 229536,
      "primary_message": "Core and small dice apples, then add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 229537,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 229538,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 229539,
      "primary_message": "When the Brussels sprouts are done, remove from oven and sprinkle with Parmesan. Set aside to cool slightly and allow cheese to melt, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 229540,
      "primary_message": "Add cranberries, pumpkin seeds, and Brussels sprouts to the bowl and toss to combine the salad.",
      "secondary_message": "¼ cup dried cranberries\n¼ cup pumpkin seeds"
    },
    {
      "id": 229541,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
