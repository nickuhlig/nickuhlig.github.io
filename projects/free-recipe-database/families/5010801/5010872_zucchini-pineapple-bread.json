  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 175°C (350°F). Butter an 8- by 10-cm loaf pan and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl whisk together flour, baking soda, baking powder, cinnamon and sugar. In a separate bowl combine vegetable oil, vanilla extract, zucchini and pineapple and mix with a wooded spoon until well combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Mix together wet and dry ingredients and scrape into prepared loaf pan. Bake until thin knife inserted into center of bread comes out clean, about 1 hour. Allow to cool for 10 minutes in loaf pan, then remove from pan and place on a rack to cool completely. Slice and serve.",
      "secondary_message": null
    }
  ],
