  "instructions": [
    {
      "id": 331016,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 331017,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 331018,
      "primary_message": "Meanwhile, remove husks and silks from corn; set aside.",
      "secondary_message": "2 ears corn"
    },
    {
      "id": 331019,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 331020,
      "primary_message": "While the grill pan heats up, season both sides of the tofu with salt and pepper, then coat with BBQ sauce. ",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper\n1 ½ tbsp barbecue sauce"
    },
    {
      "id": 331021,
      "primary_message": "Once the grill pan is hot, coat with butter; add tofu and grill until golden and warmed through, 4-5 minutes per side. Return to the baking sheet and coat with additional BBQ sauce.",
      "secondary_message": "2 tsp butter, unsalted\n2 tbsp barbecue sauce"
    },
    {
      "id": 331022,
      "primary_message": "Once the water is boiling, uncover the pot and reduce heat to medium; use tongs to lower the corn into the water and cook until just tender, about 5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 331023,
      "primary_message": "Meanwhile, wash and dry parsley, then shave leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with dressing and mayo; whisk to combine.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n1 ½ tbsp italian salad dressing\n1 tbsp mayonnaise"
    },
    {
      "id": 331024,
      "primary_message": "Wash, dry, halve, and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine.",
      "secondary_message": "½ avocado\n½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 331025,
      "primary_message": "To serve, divide tofu, corn, and slaw between plates; spread corn with butter and sprinkle with salt. Enjoy!",
      "secondary_message": "2 tsp butter, unsalted\n⅛ tsp salt"
    }
  ],
