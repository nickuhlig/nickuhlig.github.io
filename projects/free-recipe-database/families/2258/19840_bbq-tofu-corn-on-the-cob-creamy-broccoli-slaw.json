  "instructions": [
    {
      "id": 331153,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 331154,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 331155,
      "primary_message": "Meanwhile, remove husks and silks from corn; set aside.",
      "secondary_message": "6 ears corn"
    },
    {
      "id": 331156,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 331157,
      "primary_message": "While the grill pan heats up, season both sides of the tofu with salt and pepper, then coat with BBQ sauce. ",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper\n¼ cup barbecue sauce"
    },
    {
      "id": 331158,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add tofu and grill until golden and warmed through, 4-5 minutes per side. Return to the baking sheet and coat with additional BBQ sauce.",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅓ cup barbecue sauce"
    },
    {
      "id": 331159,
      "primary_message": "Once the water is boiling, uncover the pot and reduce heat to medium; use tongs to lower the corn into the water and cook until just tender, 6-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 331160,
      "primary_message": "Meanwhile, wash and dry parsley, then shave leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with dressing and mayo; whisk to combine.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n¼ cup italian salad dressing\n3 tbsp vegan mayonnaise"
    },
    {
      "id": 331161,
      "primary_message": "Wash, dry, halve, and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine.",
      "secondary_message": "1 ½ avocados\n1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 331162,
      "primary_message": "To serve, divide tofu, corn, and slaw between plates; drizzle corn with oil and sprinkle with salt. Enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    }
  ],
