  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and devein the shrimp.",
      "secondary_message": "1 lb shrimp, large"
    },
    {
      "id": 1,
      "primary_message": "For the brine: Combine the 1 cup of beer with the salt, sugar, and hot sauce in a medium bowl and stir to dissolve the salt and sugar. Add the shrimp to the brine and place in the refrigerator for 30 minutes. Drain the shrimp from the brine and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the batter: Whisk together the cornmeal, flour, black pepper, salt, and cayenne in a large bowl. Add the beer and the milk to the cornmeal mixture and stir until a homogenous batter is formed. Stir in the cheddar cheese.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour enough oil into a large heavy skillet to reach a depth of 1 inch. Heat the oil over moderately high heat until it reaches a temperature of 350°F on a deep-fry thermometer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place the cornstarch in a shallow dish. Dredge the shrimp in the cornstarch, making sure to shake off any excess cornstarch from the shrimp. Dip the coated shrimp into the batter, allowing any excess batter to drip from the shrimp. Place the battered shrimp in the hot oil and fry, turning occasionally, until golden and crisp, 1 to 2 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Drain the fried shrimp on a paper towel-lined platter. Grate some additional cheese over the hot shrimp. Serve the shrimp with lemon wedges and/or additional hot sauce.",
      "secondary_message": null
    }
  ],
