  "instructions": [
    {
      "id": 388851,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 388852,
      "primary_message": "Peel, halve, and small dice onions. ",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 388853,
      "primary_message": "Preheat a large pot over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 388854,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, coriander, and salt; cook, stirring occasionally, until golden, about 10 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp coriander, ground\n1 tsp salt"
    },
    {
      "id": 388855,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Transfer to a large baking sheet pan and pat dry with paper towels.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 388856,
      "primary_message": "Add whole (unpeeled) garlic cloves to the baking sheet with the chickpeas. Drizzle with oil, then season with additional coriander and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp coriander, ground\n½ tsp salt"
    },
    {
      "id": 388857,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 388858,
      "primary_message": "While the chickpeas are roasting, wash, dry, peel, and mince ginger. ",
      "secondary_message": "4 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 388859,
      "primary_message": "When the onions are golden, add ginger, tomatoes, water, and coconut milk; bring to a simmer over medium-high heat. Once simmering, reduce heat to medium and continue to cook, stirring occasionally, until slightly thickened, about 10 minutes.",
      "secondary_message": "4 (398 ml) cans diced tomatoes\n2 cup water\n1 (398 ml) can coconut milk"
    },
    {
      "id": 388860,
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Place in a small bowl.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 388861,
      "primary_message": "When the chickpeas and garlic are done, remove from oven. Carefully transfer roasted garlic to the cutting board. Using the back of a spoon, press on the cloves to remove the skins. Set aside the crispy chickpeas.",
      "secondary_message": null
    },
    {
      "id": 388862,
      "primary_message": "Add roasted garlic and half of the cilantro to the soup, stir to combine, and remove from heat. Use a hand blender to purée the soup until smooth. Alternatively, use a potato masher to crush the veggies (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 388863,
      "primary_message": "To serve, divide soup between bowls; top with yogurt, crispy chickpeas, and remaining cilantro. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
