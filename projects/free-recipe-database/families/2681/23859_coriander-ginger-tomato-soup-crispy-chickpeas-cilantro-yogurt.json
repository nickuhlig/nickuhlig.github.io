  "instructions": [
    {
      "id": 388825,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 388826,
      "primary_message": "Peel, halve, and small dice onions. ",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 388827,
      "primary_message": "Preheat a large pot over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 388828,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, coriander, and salt; cook, stirring occasionally, until golden, 10-15 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tbsp coriander, ground\n1 ½ tsp salt"
    },
    {
      "id": 388829,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Divide between two baking sheet pans and pat dry with paper towels.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 388830,
      "primary_message": "Add whole (unpeeled) garlic cloves to the baking sheets with the chickpeas. Drizzle with oil, then season with additional coriander and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "9 cloves garlic\n3 tbsp extra virgin olive oil\n1 ½ tbsp coriander, ground\n¾ tsp salt"
    },
    {
      "id": 388831,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 388832,
      "primary_message": "While the chickpeas are roasting, wash, dry, peel, and mince ginger. ",
      "secondary_message": "6 (1 inch) pieces ginger root"
    },
    {
      "id": 388833,
      "primary_message": "When the onions are golden, add ginger, tomatoes, water, and coconut milk; bring to a simmer over medium-high heat. Once simmering, reduce heat to medium and continue to cook, stirring occasionally, until slightly thickened, about 10 minutes.",
      "secondary_message": "6 (14.5 oz) cans diced tomatoes\n3 cup water\n1 ½ (13.5 fl oz) cans coconut milk"
    },
    {
      "id": 388834,
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Place in a small bowl.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 388835,
      "primary_message": "When the chickpeas and garlic are done, remove from oven. Carefully transfer roasted garlic to the cutting board. Using the back of a spoon, press on the cloves to remove the skins. Set aside the crispy chickpeas.",
      "secondary_message": null
    },
    {
      "id": 388836,
      "primary_message": "Add roasted garlic and half of the cilantro to the soup, stir to combine, and remove from heat. Use a hand blender to purée the soup until smooth. Alternatively, use a potato masher to crush the veggies (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 388837,
      "primary_message": "To serve, divide soup between bowls; top with yogurt, crispy chickpeas, and remaining cilantro. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
