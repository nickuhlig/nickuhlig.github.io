  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bruise the makrut lime leaves slightly. Thinly slice the ginger.",
      "secondary_message": "20 makrut lime leaves\n5 cm ginger root"
    },
    {
      "id": 1,
      "primary_message": "In a medium saucepan, combine half and half, lime leaves, and ginger over medium-high heat. Bring to a boil, then simmer for 20 minutes, stirring occasionally. Using a strainer, fish out lime leaves and ginger slices.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk egg yolks and sugar together until light in color and slightly thickened. Ladle 1/2 cup half and half into bowl, whisking constantly, then transfer yolk mixture to saucepan. Cook on low heat, stirring frequently, until base coats the back of a spoon but a finger swipe leaves a clean line.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Strain into an airtight container, then stir in gin and rosewater. Add salt to taste, then chill in refrigerator overnight. The next day, churn according to manufacturer's instructions.",
      "secondary_message": null
    }
  ],
