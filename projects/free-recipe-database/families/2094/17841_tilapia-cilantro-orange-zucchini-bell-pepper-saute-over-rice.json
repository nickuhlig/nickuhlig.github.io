  "instructions": [
    {
      "id": 323706,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 323707,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 323708,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 red bell pepper\n1 orange\n1 small bunch cilantro"
    },
    {
      "id": 323709,
      "primary_message": "Trim and large dice zucchini; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 323710,
      "primary_message": "Trim, seed, and large dice bell pepper; add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 323711,
      "primary_message": "Peel, halve, and large dice onion; add to the bowl and set aside.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 323712,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323713,
      "primary_message": "While the skillet heats up, pat the tilapia dry with paper towels and place on a plate; sprinkle cornstarch, salt, and pepper over both sides, pressing gently to adhere.",
      "secondary_message": "1 ½ lb tilapia fillet\n¼ cup cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 323714,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tilapia and cook, flipping once, until crispy and easily flakes with a fork, about 6 minutes. Remove to a clean plate and loosely cover with aluminum foil; set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 323715,
      "primary_message": "Meanwhile, zest and juice orange into a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 323716,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the orange juice, along with broth, soy sauce, additional cornstarch, and spices. Whisk to combine the sauce.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp soy sauce\n4 tsp cornstarch\n1 tsp cumin, ground\n1 tsp garlic powder\n½ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 323717,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323718,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies and sauté until fork-tender, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 323719,
      "primary_message": "Add sauce to the skillet with the veggies; continue to cook, stirring often, until sauce is thickened, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 323720,
      "primary_message": "To serve, divide rice, tilapia, veggies, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
