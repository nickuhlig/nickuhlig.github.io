  "instructions": [
    {
      "id": 323721,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 323722,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 323723,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 ½ red bell peppers\n1 ½ oranges\n1 small bunch cilantro"
    },
    {
      "id": 323724,
      "primary_message": "Trim and large dice zucchini; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 323725,
      "primary_message": "Trim, seed, and large dice bell peppers; add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "id": 323726,
      "primary_message": "Peel, halve, and large dice onions; add to the bowl and set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 323727,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323728,
      "primary_message": "While the pot heats up, pat the tilapia dry with paper towels and place on a plate; sprinkle cornstarch, salt, and pepper over both sides, pressing gently to adhere.",
      "secondary_message": "2 ¼ lb tilapia fillet\n⅓ cup cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 323729,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tilapia and cook, flipping once, until crispy and easily flakes with a fork, about 6 minutes. Remove to a clean plate and loosely cover with aluminum foil; set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 323730,
      "primary_message": "Meanwhile, zest and juice oranges into a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 323731,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the orange juice, along with broth, soy sauce, additional cornstarch, and spices. Whisk to combine the sauce.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n3 tbsp soy sauce\n2 tbsp cornstarch\n1 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 323732,
      "primary_message": "Return pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323733,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add veggies and sauté until fork-tender, 7-8 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 323734,
      "primary_message": "Add sauce to the pot with the veggies; continue to cook, stirring often, until sauce is thickened, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 323735,
      "primary_message": "To serve, divide rice, tilapia, veggies, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
