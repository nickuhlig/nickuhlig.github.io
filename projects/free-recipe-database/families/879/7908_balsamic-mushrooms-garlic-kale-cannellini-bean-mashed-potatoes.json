  "instructions": [
    {
      "id": 268476,
      "primary_message": "Preheat the oven to 230°C (450°F). Line a baking sheet with aluminum foil (for easy clean-up). ",
      "secondary_message": null
    },
    {
      "id": 268477,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg cremini mushrooms\n⅓ kg new potatoes\n½ bunch kale\n½ small bunch Italian (flat-leaf) parsley\n½ small bunch green onions (scallions)"
    },
    {
      "id": 268478,
      "primary_message": "Peel the garlic. Mince 1 clove and add to a small bowl; set the other cloves aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 268479,
      "primary_message": "Add oil, vinegar, maple syrup, soy sauce, and spices to the bowl with the garlic; whisk to combine the sauce.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tbsp pure maple syrup\n1 tbsp soy sauce\n¼ tsp thyme, dried\n¼ tsp salt"
    },
    {
      "id": 268480,
      "primary_message": "Quarter mushrooms and place on the baking sheet. Drizzle with sauce and stir to coat, then spread out in an even layer. Place in the oven and bake, stirring halfway through, until tender, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 268481,
      "primary_message": "Large dice the potatoes. Transfer potatoes and remaining garlic cloves to a medium saucepan, cover with water, put on the lid, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "id": 268482,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 268483,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems, then thinly slice crosswise into shreds.",
      "secondary_message": null
    },
    {
      "id": 268484,
      "primary_message": "Once the water in the saucepan is boiling, remove the lid and cook until the potatoes are almost done, about 8 minutes. Add beans and kale to the pan and cook 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 268485,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 268486,
      "primary_message": "Once potato mixture is done, drain and return to the saucepan. ",
      "secondary_message": null
    },
    {
      "id": 268487,
      "primary_message": "Add oil, almond milk, parsley, and spices to the saucepan with the potatoes and mash until almost smooth. ",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n59 ml (¼ cup) almond milk, unsweetened\n¼ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 268488,
      "primary_message": "Trim off the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 268489,
      "primary_message": "To serve, divide mashed potatoes between bowls. Spoon mushrooms and their cooking juices over the potatoes and sprinkle with green onion. Enjoy!",
      "secondary_message": null
    }
  ],
