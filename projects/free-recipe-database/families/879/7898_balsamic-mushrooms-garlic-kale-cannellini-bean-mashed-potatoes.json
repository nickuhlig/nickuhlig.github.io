  "instructions": [
    {
      "id": 268330,
      "primary_message": "Preheat the oven to 450°F. Line a large baking sheet with aluminum foil (for easy clean-up). ",
      "secondary_message": null
    },
    {
      "id": 268331,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lb cremini mushrooms\n2 ¼ lb new potatoes\n1 ½ bunches kale\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch green onions (scallions)"
    },
    {
      "id": 268332,
      "primary_message": "Peel the garlic. Mince 3 cloves and add to a medium bowl; set the other cloves aside.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 268333,
      "primary_message": "Add oil, vinegar, maple syrup, soy sauce, and spices to the bowl with the garlic; whisk to combine the sauce.",
      "secondary_message": "3 tbsp extra virgin olive oil\n⅓ cup balsamic vinegar\n3 tbsp pure maple syrup\n3 tbsp soy sauce\n¾ tsp thyme, dried\n¾ tsp salt"
    },
    {
      "id": 268334,
      "primary_message": "Quarter mushrooms and place on the baking sheet. Drizzle with sauce and stir to coat, then spread out in an even layer. Place in the oven and bake, stirring halfway through, until tender, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 268335,
      "primary_message": "Large dice the potatoes. Transfer potatoes and remaining garlic cloves to a large pot, cover with water, put on the lid, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "id": 268336,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 268337,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems, then thinly slice crosswise into shreds.",
      "secondary_message": null
    },
    {
      "id": 268338,
      "primary_message": "Once the water in the pot is boiling, remove the lid and cook until the potatoes are almost done, about 8 minutes. Add beans and kale to the pot and cook 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 268339,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 268340,
      "primary_message": "Once potato mixture is done, drain and return to the pot. ",
      "secondary_message": null
    },
    {
      "id": 268341,
      "primary_message": "Add oil, almond milk, parsley, and spices to the pot with the potatoes and mash until almost smooth. ",
      "secondary_message": "¼ cup extra virgin olive oil\n6 fl oz (¾ cup) almond milk, unsweetened\n¾ tsp onion powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 268342,
      "primary_message": "Trim off the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 268343,
      "primary_message": "To serve, divide mashed potatoes between bowls. Spoon mushrooms and their cooking juices over the potatoes and sprinkle with green onion. Enjoy!",
      "secondary_message": null
    }
  ],
