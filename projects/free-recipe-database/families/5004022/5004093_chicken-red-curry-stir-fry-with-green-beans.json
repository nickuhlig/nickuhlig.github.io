  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim the green beans diagonally into 1-inch slices. Cut the boneless skinless chicken breasts against the grain into thin slices.",
      "secondary_message": "0.11 kg green beans\n0.23 kg boneless skinless chicken breasts"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a 25-cm wok or skillet over medium-high heat until shimmering. Add curry paste and cook, stirring constantly and pressing curry paste against bottom of pan until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add green beans and increase heat to high. Cook, stirring and tossing constantly until beans are just beginning to turn tender-crisp, about 1 minute. Add chicken, 2 teaspoons fish sauce, sugar, and oyster sauce. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cook until beans are tender-crisp and chicken is barely cooked through, about 1 minute longer. Taste sauce and add more fish sauce if desired. Thin with water until sauce barely coats all the meat and vegetables but is not soupy. Transfer to a serving platter and serve.",
      "secondary_message": null
    }
  ],
