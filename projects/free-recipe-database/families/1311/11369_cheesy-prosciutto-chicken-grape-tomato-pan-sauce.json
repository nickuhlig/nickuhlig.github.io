  "instructions": [
    {
      "id": 190902,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 190903,
      "primary_message": "Finely grate Parmesan. Place in a medium bowl along with almond meal and Italian seasoning; stir to combine.",
      "secondary_message": "57 g Parmesan cheese\n½ cup almond meal/flour\n1 tsp Italian seasoning"
    },
    {
      "id": 190904,
      "primary_message": "Pat the chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. ",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 190905,
      "primary_message": "Spread mayo over both sides of each cutlet, then dredge in the parmesan mixture, pressing to adhere. Transfer to the baking sheet.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "id": 190906,
      "primary_message": "Place chicken in the oven and bake until golden brown and cooked through, 10-12 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 190907,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 190908,
      "primary_message": "Place garlic, broth, tomato paste, oil, and spices in a large ovenproof skillet. Whisk to combine the sauce and bring to a simmer over medium-high heat.",
      "secondary_message": "473 ml chicken or vegetable broth\n6 tbsp tomato paste\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 190909,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes. ",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 190910,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; discard stems and roughly chop the leaves (reserving a few whole leaves for garnish).",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 190911,
      "primary_message": "Chop prosciutto and mozzarella into bite-sized pieces.",
      "secondary_message": "4 slices prosciutto\n½ (227 g) block mozzarella cheese"
    },
    {
      "id": 190912,
      "primary_message": "Preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 190913,
      "primary_message": "Once the sauce is simmering, add the tomatoes and basil, then stir to combine. Place chicken on top of the tomato mixture and sprinkle with prosciutto and mozzarella. ",
      "secondary_message": null
    },
    {
      "id": 190914,
      "primary_message": "Place the skillet in the oven and broil until cheese is bubbly and slightly golden, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 190915,
      "primary_message": "To serve, divide chicken and pan sauce between plates and garnish with reserved basil leaves. Enjoy! ",
      "secondary_message": null
    }
  ],
