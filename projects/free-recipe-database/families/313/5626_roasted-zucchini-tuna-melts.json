  "instructions": [
    {
      "id": 67229,
      "primary_message": "Preheat the oven to 450°F and position rack in the centre.",
      "secondary_message": ""
    },
    {
      "id": 67228,
      "primary_message": "Wash and dry the zucchini. Halve lengthwise and, using a spoon, scrape out the centre and reserve for later. Place the halves cut-side up on the baking sheet. Rub with olive oil and season with salt and pepper.",
      "secondary_message": "6 medium zucchini squash\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 67227,
      "primary_message": "Place in the oven and bake until just tender when pierced with a fork, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 67226,
      "primary_message": "Small dice the reserved zucchini flesh; transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 67225,
      "primary_message": "Wash the celery, trim ends, and small dice; add to the bowl with the zucchini. Peel and mince the garlic; add to the bowl.",
      "secondary_message": "6 sticks celery\n3 cloves garlic"
    },
    {
      "id": 67219,
      "primary_message": "Add tuna, lemon juice, olive oil, dill, salt, and pepper to the bowl with vegetables and mix together.",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water\njuice of ¾ lemon\n6 tbsp extra virgin olive oil\n3 tsp dill\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 67224,
      "primary_message": "Finely grate 1½ cup of Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 67223,
      "primary_message": "Once the zucchini is done, take it out of the oven. Turn on the broiler and position rack in the upper third of the oven.",
      "secondary_message": ""
    },
    {
      "id": 67222,
      "primary_message": "Fill the zucchini halves with the tuna mixture and sprinkle with the grated Parmesan. Return to the oven and broil until the cheese has browned, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 67221,
      "primary_message": "Cut the remaining lemon into wedges for serving.",
      "secondary_message": ""
    },
    {
      "id": 67220,
      "primary_message": "To serve, place the zucchini tuna melts on a plate and garnish with lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
