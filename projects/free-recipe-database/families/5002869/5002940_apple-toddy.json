  "instructions": [
    {
      "id": 1,
      "primary_message": "Peel and core the apple and wrap in parchment paper to keep it from falling apart. Place in a baking pan and bake at 350 for 30 - 45 minutes, until very soft.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Rinse two mugs with boiling water to pre-heat, then put 1 tablespoon sugar or syrup in each. Add a splash of boiling water and stir until sugar is dissolved..",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add 57 g of apple brandy to each of the mugs. Cut the apple in half and place each half in one of the mugs. Using a muddler or a wooden spoon, crush the apple to a pulp.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add one or two ounces of boiling water, to taste, and stir until apple has completely fallen apart. Strain into a fresh warm mug (optional), and grate nutmeg over the top of the drink.",
      "secondary_message": null
    }
  ],
