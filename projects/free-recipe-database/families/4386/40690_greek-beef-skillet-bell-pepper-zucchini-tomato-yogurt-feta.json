  "instructions": [
    {
      "id": 628970,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 628971,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beef, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Transfer to a plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n0.68 kg lean ground beef\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 628972,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "2 red bell peppers\n4 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg grape tomatoes"
    },
    {
      "id": 628973,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 628974,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 628975,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserve remaining parsley for serving).",
      "secondary_message": null
    },
    {
      "id": 628976,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 628977,
      "primary_message": "Return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies, parsley, and spices; cook, stirring occasionally, until browned and softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp oregano, dried\n1 tsp salt\n½ tsp crushed red pepper\n½ tsp paprika"
    },
    {
      "id": 628978,
      "primary_message": "Halve grape tomatoes. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 628979,
      "primary_message": "Halve olives lengthwise. Add to the bowl with the tomatoes.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 628980,
      "primary_message": "When the veggies are done, add beef, tomatoes, and olives to the skillet. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 628981,
      "primary_message": "To serve, divide beef and veggies between plates or bowls. Top with feta, yogurt, and reserved parsley. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n½ cup plain Greek yogurt"
    }
  ],
