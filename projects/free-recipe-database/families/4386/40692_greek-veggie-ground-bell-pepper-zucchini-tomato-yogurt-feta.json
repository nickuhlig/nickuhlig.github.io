  "instructions": [
    {
      "id": 628994,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 628995,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 628996,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 red bell pepper\n2 medium zucchini squash\n½ small bunch Italian (flat-leaf) parsley\n½ small pkg grape tomatoes"
    },
    {
      "id": 628997,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 628998,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 628999,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserve remaining parsley for serving).",
      "secondary_message": null
    },
    {
      "id": 629000,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 629001,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add vegetables, parsley, and spices; cook, stirring occasionally, until browned and softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp crushed red pepper\n¼ tsp paprika"
    },
    {
      "id": 629002,
      "primary_message": "Halve grape tomatoes. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 629003,
      "primary_message": "Halve olives lengthwise. Add to the bowl with the tomatoes.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 629004,
      "primary_message": "When the vegetables are done, add veggie ground, tomatoes, and olives to the skillet. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 629005,
      "primary_message": "To serve, divide veggie ground and vegetables between plates or bowls. Top with feta, yogurt, and reserved parsley. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n¼ cup plain Greek yogurt"
    }
  ],
