  "instructions": [
    {
      "id": 628982,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 628983,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add beef, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Transfer to a plate. (Reserve pot with drippings for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1.02 kg lean ground beef\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 628984,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 red bell peppers\n6 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 628985,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 628986,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 628987,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserve remaining parsley for serving).",
      "secondary_message": null
    },
    {
      "id": 628988,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 628989,
      "primary_message": "Return pot (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies, parsley, and spices; cook, stirring occasionally, until browned and softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp crushed red pepper\n¾ tsp paprika"
    },
    {
      "id": 628990,
      "primary_message": "Halve grape tomatoes. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 628991,
      "primary_message": "Halve olives lengthwise. Add to the bowl with the tomatoes.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 628992,
      "primary_message": "When the veggies are done, add beef, tomatoes, and olives to the pot. Continue to cook, stirring occasionally, until warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 628993,
      "primary_message": "To serve, divide beef and veggies between plates or bowls. Top with feta, yogurt, and reserved parsley. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese\n¾ cup plain Greek yogurt"
    }
  ],
