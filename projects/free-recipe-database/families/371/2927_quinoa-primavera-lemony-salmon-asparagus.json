  "instructions": [
    {
      "id": 28459,
      "primary_message": "In a small saucepan, combine the quinoa and broth; bring to a boil.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 28460,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n2 lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 28461,
      "primary_message": "Once the water is boiling, reduce the heat to a simmer and cover; cook for 15 minutes. Once cooked, remove from the heat and let it stand, covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 28462,
      "primary_message": "Juice one of the lemons into a small bowl and cut the other lemon into eight wedges for serving.",
      "secondary_message": ""
    },
    {
      "id": 28463,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 28464,
      "primary_message": "Place the salmon on a plate, drizzle with half of the lemon juice and season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb salmon fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 28465,
      "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 28466,
      "primary_message": "Place the salmon skin-side-down in the skillet; cook until the flesh is opaque, 2 to 4 minutes per side. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 28467,
      "primary_message": "Peel and mince the shallots; transfer to a small bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 28468,
      "primary_message": "Snap (or cut) off and discard the woody ends of the asparagus; cut the spears on an angle into 2-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 28469,
      "primary_message": "Once the salmon has been transferred, add more butter to the skillet, then add the shallots. Cook, stirring frequently, until the shallots are softened, 2 to 3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 28470,
      "primary_message": "Add the asparagus and season with salt and pepper; cook, stirring occasionally, until just tender, 5 to 7 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 28471,
      "primary_message": "While the asparagus cooks, shave the parsley leaves off the stems; discard the stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 28472,
      "primary_message": "Once cooked, remove the asparagus from the heat; stir in most of the parsley (save a little for garnishing) and drizzle with the remaining lemon juice.",
      "secondary_message": ""
    },
    {
      "id": 28473,
      "primary_message": "Uncover the quinoa and fluff with a fork; add to the asparagus and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 28474,
      "primary_message": "Divide the quinoa and asparagus mixture between four plates (or two plates and two lunch containers), top with the salmon, and garnish with the remaining parsley. Serve with lemon wedges for squeezing over top. Enjoy!",
      "secondary_message": null
    }
  ],
