  "instructions": [
    {
      "id": 250696,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 medium carrots\n1 English cucumber\n1 small pkg grape tomatoes\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 250697,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 250698,
      "primary_message": "Peel, halve, and slice shallots into thin half-moons. Add to the bowl with the dressing, toss to combine, and set aside.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 250699,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with spices on both sides. ",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper\n½ tsp oregano, dried"
    },
    {
      "id": 250700,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250701,
      "primary_message": "While the skillet heats up, sprinkle cornstarch over both sides of each fillet and press gently to adhere. ",
      "secondary_message": "2 tbsp cornstarch"
    },
    {
      "id": 250702,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 250703,
      "primary_message": "Meanwhile, using a clean cutting board, peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 250704,
      "primary_message": "Trim and halve cucumber lengthwise; slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 250705,
      "primary_message": "Halve tomatoes and add to the bowl; set aside. ",
      "secondary_message": null
    },
    {
      "id": 250706,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 250707,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 250708,
      "primary_message": "Arrange bread slices on a baking sheet pan and drizzle with oil; sprinkle with garlic and salt. Place in the oven and broil until toasted, 1-2 minutes. Remove from oven and cut toasts in half on the diagonal.",
      "secondary_message": "4 slices whole grain bread\n4 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 250709,
      "primary_message": "Meanwhile, mince olives and capers; divide between chicken fillets and spread out in an even layer. ",
      "secondary_message": "⅔ cup Kalamata olives, pitted\n4 tbsp capers"
    },
    {
      "id": 250710,
      "primary_message": "Add spring mix to the bowl with the veggies and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 250711,
      "primary_message": "To serve, divide salad and chicken between plates. Serve with toasts on the side and enjoy! ",
      "secondary_message": null
    }
  ],
