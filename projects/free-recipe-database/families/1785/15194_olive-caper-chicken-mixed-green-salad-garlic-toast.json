  "instructions": [
    {
      "id": 250616,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 medium carrots\n1 ½ English cucumbers\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 250617,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 250618,
      "primary_message": "Peel, halve, and slice onion into thin half-moons. Add to the bowl with the dressing, toss to combine, and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 250619,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with spices on both sides. ",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp oregano, dried"
    },
    {
      "id": 250620,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250621,
      "primary_message": "While the skillet heats up, sprinkle cornstarch over both sides of each fillet and press gently to adhere. ",
      "secondary_message": "3 tbsp cornstarch"
    },
    {
      "id": 250622,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the skillet and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat and set aside. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 250623,
      "primary_message": "Meanwhile, using a clean cutting board, peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 250624,
      "primary_message": "Trim and halve cucumbers lengthwise; slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 250625,
      "primary_message": "Halve tomatoes and add to the bowl; set aside. ",
      "secondary_message": null
    },
    {
      "id": 250626,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 250627,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 250628,
      "primary_message": "Arrange bread slices on a large baking sheet pan and drizzle with oil; sprinkle with garlic and salt. Place in the oven and broil until toasted, 1-2 minutes. Remove from oven and cut toasts in half on the diagonal.",
      "secondary_message": "6 slices whole grain bread\n2 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 250629,
      "primary_message": "Meanwhile, mince olives and capers; divide between chicken fillets and spread out in an even layer. ",
      "secondary_message": "1 cup Kalamata olives, pitted\n6 tbsp capers"
    },
    {
      "id": 250630,
      "primary_message": "Add spring mix to the bowl with the veggies and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 250631,
      "primary_message": "To serve, divide salad and chicken between plates. Serve with toasts on the side and enjoy! ",
      "secondary_message": null
    }
  ],
