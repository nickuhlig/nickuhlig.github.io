  "instructions": [
    {
      "id": 107112,
      "primary_message": "Preheat the oven to 230°C (450°F) and place the rack in the center position. Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 107113,
      "primary_message": "Wash and dry, then halve the peaches. Twist to open, and remove pits. Slice each half into 4 wedges, and transfer to the baking sheet pan.",
      "secondary_message": "6 peaches"
    },
    {
      "id": 107114,
      "primary_message": "Drizzle maple syrup and cinnamon over the peaches, and spread out in an even layer.",
      "secondary_message": "¾ tsp cinnamon\n¼ cup pure maple syrup"
    },
    {
      "id": 107115,
      "primary_message": "Dot the peaches with coconut oil, and place in the oven (it doesn't have to be fully heated). Cook for 5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 107116,
      "primary_message": "Remove baking sheet from the oven, sprinkle cashews and salt over the peaches, and stir to combine. Return to the oven and bake for another 5 minutes, or until peaches begin to swell and juices are bubbling.",
      "secondary_message": "1 ½ cups cashews, roasted unsalted\n3 pinch salt"
    },
    {
      "id": 107117,
      "primary_message": "To serve, divide yogurt between bowls and top with warm peaches and cashews; drizzle pan juices over the top. Enjoy!",
      "secondary_message": "6 cups plain Greek yogurt"
    }
  ],
