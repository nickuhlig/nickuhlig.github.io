  "instructions": [
    {
      "id": 132568,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 132569,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Add to a large bowl along with the oil and spices. Stir to combine and set aside. ",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n⅜ tsp salt"
    },
    {
      "id": 132570,
      "primary_message": "Wash and dry the spinach (skip if it came pre-washed). ",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 132571,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 132572,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 132573,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 132574,
      "primary_message": "Add garlic and spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful; cook until the spinach is fully wilted, 2-3 minutes. Remove from heat and set aside. ",
      "secondary_message": null
    },
    {
      "id": 132575,
      "primary_message": "Coarsely grate the mozzarella. ",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 132576,
      "primary_message": "Coat the bottom of a large baking dish with oil. Place chicken fillets in the dish. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 132577,
      "primary_message": "Spread ricotta over the top of each chicken fillet. Top each with spinach and mozzarella. Place the baking dish in the oven and cook until the cheese is melted and the chicken is cooked through, 20-25 minutes. ",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese"
    },
    {
      "id": 132578,
      "primary_message": "Meanwhile, wash and medium dice the zucchini; place in a medium bowl. Add the oil, Italian seasoning, and salt; stir to combine. ",
      "secondary_message": "6 medium zucchini squash\n1 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 132579,
      "primary_message": "Spread the zucchini in a single layer on two baking sheets and place in the oven. Cook until zucchini is fork-tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 132580,
      "primary_message": "To serve, divide the chicken and zucchini between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
