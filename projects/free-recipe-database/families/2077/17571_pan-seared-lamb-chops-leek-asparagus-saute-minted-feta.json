  "instructions": [
    {
      "id": 323225,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "4 leeks\n2 small bunches asparagus\n1 small pkg fresh mint\n1 lemon"
    },
    {
      "id": 323226,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 323227,
      "primary_message": "Snap or cut off woody ends of the asparagus; cut into 1-inch pieces. Add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 323228,
      "primary_message": "Peel and mince garlic; add to the bowl and set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 323229,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323230,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "8 lamb loin chops\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 323231,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add lamb chops and pan-sear, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 323232,
      "primary_message": "Return the skillet (with cooking juices) to medium-high heat, add more butter, and swirl to coat the bottom. Add the veggies and spices; sauté until fork-tender, 5-7 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp butter, unsalted\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 323233,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 323234,
      "primary_message": "Zest lemon into the bowl with the mint; add feta and stir to combine. (Reserve lemon for serving.)",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 323235,
      "primary_message": "To serve, divide chops and veggies between plates; juice lemon over the veggies and top with minted feta. Enjoy!",
      "secondary_message": null
    }
  ],
