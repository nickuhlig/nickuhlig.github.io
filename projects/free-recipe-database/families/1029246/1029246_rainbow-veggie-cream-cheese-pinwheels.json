  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.) ",
      "secondary_message": "1 medium carrot\n½ red bell pepper\n1 cup baby spinach"
    },
    {
      "primary_message": "Peel, trim, and coarsely grate carrot. Place on a plate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Trim, seed, and cut bell pepper into thin matchsticks. Add to the plate with the carrot.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spread cream cheese evenly over each tortilla, then season with salt and pepper. Arrange carrot, bell pepper, spinach, and shredded cabbage in lines on top of the cream cheese (creating a rainbow), then roll tightly to close.\n\n",
      "secondary_message": "½ (8 oz) block cream cheese\n1 cup red cabbage, shredded\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Cut each tortilla roll-up crosswise into 1-inch \"pinwheels.\"\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Share and enjoy!",
      "secondary_message": null
    }
  ],
