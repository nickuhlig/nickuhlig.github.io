  "instructions": [
    {
      "id": 246803,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 246804,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 eggplants\n1 ½ lemons\n1 ½ (142 g) pkg baby arugula\n1 small pkg fresh basil"
    },
    {
      "id": 246805,
      "primary_message": "Trim and cut eggplants into ¾-inch cubes; transfer to a large baking sheet pan. Drizzle with oil and season with spices; toss to coat, then spread out in a single layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 246806,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until eggplant is soft and browned, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 246807,
      "primary_message": "Meanwhile, divide flatbreads between two additional baking sheets. Place in the oven and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven and set aside.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 246808,
      "primary_message": "While the flatbreads are toasting, juice lemons into a large bowl. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n1 ½ tsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 246809,
      "primary_message": "Place tomato sauce and spices in a small bowl; whisk to combine and set aside.",
      "secondary_message": "1 ½ (213 ml) cans tomato sauce\n¾ tsp Italian seasoning\n3 pinch onion powder\n3 pinch garlic powder\n3 pinch crushed red pepper\n3 pinch salt"
    },
    {
      "id": 246810,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 246811,
      "primary_message": "When the eggplant is done, prepare the flatbreads. Spread tomato sauce over each flatbread; top with mozzarella and eggplant. ",
      "secondary_message": null
    },
    {
      "id": 246812,
      "primary_message": "Return flatbreads to the oven and bake until warmed through and cheese is melted, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 246813,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 246814,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 246815,
      "primary_message": "Slice flatbreads, divide between plates, and sprinkle with basil. Serve with lemony arugula on the side and enjoy!",
      "secondary_message": null
    }
  ],
