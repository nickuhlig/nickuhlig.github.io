  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Zest the lemon. Juice the lemon. Grate the parmesan.",
      "secondary_message": "1 lemon\n½ lemon\n½ cup parmesan, divided"
    },
    {
      "id": 1,
      "primary_message": "Bring a large pot of water to a boil, and salt it.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cook the pasta until al dente. Drain, but reserve at least 1 cup of pasta water.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While the pasta is cooking, combine all ingredients but the Parmesan and spaghetti in a food processor, and blend until smooth like a pesto.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "While the pasta continues to cook, make the herbes de Provence crumbs and the shrimp (recipes follow). Both are optional. The traditional presentation is just spaghetti pistou.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Toss the spaghetti with the shrimp and the red pistou. Moisten with reserved pasta water as needed. Top with the herbed crumbs.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "To Make the Herbes de Provence Crumbs: Heat the oil on medium heat in a nonstick skillet. Add the baguette crumbs, herbes de Provence, and salt. Toast until dry and crisp, stirring often.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "To Sear the Shrimp: Heat the olive oil in a sauté pan over medium-high heat. Cook the shrimp 2 minutes per side.",
      "secondary_message": null
    }
  ],
