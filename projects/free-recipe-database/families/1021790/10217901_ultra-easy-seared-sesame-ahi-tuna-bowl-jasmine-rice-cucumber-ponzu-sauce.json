  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium-high heat. Pat tuna steaks dry with paper towels, rub with oil, then season with salt and pepper on both sides. Sprinkle sesame seeds over each side of the tuna, pressing gently to adhere. ",
      "secondary_message": "2 (170 g) steak ahi (yellowfin) tuna\nneutral vegetable oil\n¼ tsp salt\n¼ tsp black pepper\n¼ cup sesame seeds"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tuna and cook, turning once, until desired doneness, 1-2 minutes per side for medium-rare. Finish tuna by searing each edge for about 30 seconds. Remove to a plate and set aside to rest, 5 min. Thinly slice right before serving.",
      "secondary_message": "neutral vegetable oil"
    },
    {
      "primary_message": "Place rice pouch in the microwave, seam-side up. Heat on high for 3-4 minutes (until pouch balloons up with steam for 30 seconds). Allow steam to vent before opening pouch. (Alternatively, rice can be heated in a saucepan according to package instructions.)",
      "secondary_message": "1 (283 g) pouch frozen Jasmine rice, pre-cooked"
    },
    {
      "primary_message": "While the rice is cooking, wash and dry cucumber. Trim and slice crosswise into thin rounds.",
      "secondary_message": "1 English cucumber"
    },
    {
      "primary_message": "To serve, divide rice, cucumber, and sliced tuna between plates or bowls. Drizzle with ponzu sauce and enjoy!",
      "secondary_message": "¼ cup ponzu (citrus seasoned soy sauce)"
    }
  ],
