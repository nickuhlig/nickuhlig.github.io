  "instructions": [
    {
      "id": 44987,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb brussels sprouts\n2 (6 oz) pkg blueberries\n1 lemon"
    },
    {
      "id": 44988,
      "primary_message": "Remove the outer layer of leaves from the Brussels sprouts, then trim off and discard the stem ends; halve the sprouts lengthwise, then thinly slice each half crosswise. Transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 44989,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 44990,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, bone-in\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 44991,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 44992,
      "primary_message": "Place the pork chops in the skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
      "secondary_message": null
    },
    {
      "id": 44993,
      "primary_message": "Trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 44994,
      "primary_message": "Once the pork chops have been transferred, add the shallot to the skillet; cook, stirring frequently, until softened, 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 44995,
      "primary_message": "Add the Brussels sprouts to the skillet and season with salt and pepper; cook, stirring frequently, until bright green and just tender, 2 to 3 minutes. Once done, return back to the salad bowl.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 44996,
      "primary_message": "Shave or coarsely grate about ½ cup of Parmesan. Transfer to a small bowl.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 44997,
      "primary_message": "Add the blueberries to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 44998,
      "primary_message": "Juice the lemon and add to the salad bowl; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 44999,
      "primary_message": "To serve, divide the pork chops and salad between plates; top the salad with the Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
