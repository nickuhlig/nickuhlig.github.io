  "instructions": [
    {
      "id": 459669,
      "primary_message": "Preheat oven to 400°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 459670,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n2 lemons\n1 small bunch green onions (scallions)"
    },
    {
      "id": 459671,
      "primary_message": "Trim and coarsely grate zucchini. Transfer to a colander and sprinkle with salt. Place the colander in a bowl to catch the excess moisture and set aside.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 459672,
      "primary_message": "Meanwhile, zest and juice one lemon into a small bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 459673,
      "primary_message": "Add yogurt to the bowl with the lemon, along with spices, and stir to combine the sauce. Add water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set aside. ",
      "secondary_message": "1 cup plain Greek yogurt\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 459674,
      "primary_message": "Mince pistachios. Place in another small bowl along with bread crumbs, oil, and salt; stir to combine the coating.",
      "secondary_message": "½ cup pistachios, unsalted\n⅓ cup panko bread crumbs\n4 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 459675,
      "primary_message": "Pat halibut dry with paper towels and place, skin-side down, on the baking sheet; season the top side with salt and pepper. Spread the fish with mayo, then sprinkle evenly with the coating, pressing gently to adhere.",
      "secondary_message": "1 ½ lb halibut fillet\n½ tsp salt\n¼ tsp black pepper\n3 tbsp mayonnaise"
    },
    {
      "id": 459676,
      "primary_message": "Place baking sheet in the oven and roast until halibut is cooked through, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 459677,
      "primary_message": "Meanwhile, use paper towels or a clean cloth to squeeze excess moisture out of the grated zucchini, then transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 459678,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the zucchini along with eggs, flour, baking powder, pepper, and salt. Stir to combine the batter.",
      "secondary_message": "2 eggs\n⅔ cup all-purpose flour\n1 tsp baking powder\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 459679,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 459680,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 459681,
      "primary_message": "Working in batches if necessary, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 459682,
      "primary_message": "Divide fish and fritters between plates; drizzle yogurt sauce over fritters. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
