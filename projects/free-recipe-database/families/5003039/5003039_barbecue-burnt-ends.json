  "instructions": [
    {
      "id": 1,
      "primary_message": "Cut smoked brisket point into 1/2-inch cubes and place in a large disposable tray. Add in 1 cup of barbecue and brisket drippings, if reserved, and toss to thoroughly coat brisket pieces.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place tray back in smoker and smoke at 225 degrees until brisket pieces darken and become crisp around the edges, 2 to 4 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove from smoker, let cool for 10 minutes, then serve, with additional barbecue sauce, if desired.",
      "secondary_message": null
    }
