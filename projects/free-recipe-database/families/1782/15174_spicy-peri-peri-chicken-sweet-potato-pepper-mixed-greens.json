  "instructions": [
    {
      "id": 250326,
      "primary_message": "Preheat the oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 250327,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 red bell pepper\n0.45 kg sweet potato\n½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 250328,
      "primary_message": "Trim, seed, and medium dice bell pepper. Peel and small dice sweet potato; transfer both to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 250329,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 250330,
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 250331,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil and spices; whisk to combine the marinade. ",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n2 tsp paprika\n½ tsp salt\n½ tsp oregano, dried\n¼ tsp crushed red pepper\n¼ tsp black pepper"
    },
    {
      "id": 250332,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 250333,
      "primary_message": "Add cutlets to the bowl with the marinade and turn to coat. Transfer cutlets to the baking sheet, nestling them in the veggies.",
      "secondary_message": null
    },
    {
      "id": 250334,
      "primary_message": "Place baking sheet in the oven and roast, flipping chicken halfway through, until veggies are tender and chicken is cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 250335,
      "primary_message": "Meanwhile, using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Place in another medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 250336,
      "primary_message": "Add yogurt, water, mayo, vinegar, and salt to the bowl with the parsley. Whisk to combine the dressing. ",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tsp water\n1 tsp mayonnaise\n1 tsp apple cider vinegar\n1 pinch salt"
    },
    {
      "id": 250337,
      "primary_message": "Roughly chop walnuts. Add mixed greens, walnuts, and cranberries to the bowl with the dressing; toss to combine the salad. ",
      "secondary_message": "⅛ cup walnuts\n⅛ cup dried cranberries"
    },
    {
      "id": 250338,
      "primary_message": "To serve, divide chicken, veggies, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
