  "instructions": [
    {
      "id": 250365,
      "primary_message": "Preheat the oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 250366,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 medium zucchini squash\n½ lemon\n½ avocado\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 250367,
      "primary_message": "Trim and halve zucchini lengthwise; cut crosswise into ½-inch thick half-moons. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 250368,
      "primary_message": "Drizzle zucchini with oil and season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 250369,
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 250370,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil and spices; whisk to combine the marinade. ",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n2 tsp paprika\n½ tsp salt\n½ tsp oregano, dried\n¼ tsp crushed red pepper\n¼ tsp black pepper"
    },
    {
      "id": 250371,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 250372,
      "primary_message": "Add cutlets to the bowl with the marinade and turn to coat. Transfer cutlets to the baking sheet, nestling them in the zucchini.",
      "secondary_message": null
    },
    {
      "id": 250373,
      "primary_message": "Place baking sheet in the oven and roast, flipping chicken halfway through, until zucchini is tender and chicken is cooked through, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 250374,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, and salt in another medium bowl. Whisk to combine the dressing.",
      "secondary_message": "⅛ cup plain Greek yogurt\n2 tsp avocado oil mayonnaise\n1 tsp apple cider vinegar\n1 pinch salt"
    },
    {
      "id": 250375,
      "primary_message": "Halve and pit the avocado; scoop out flesh with a spoon and medium dice. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 250376,
      "primary_message": "Roughly chop walnuts. Add mixed greens, walnuts, and feta to the bowl with the dressing; toss to combine the salad. ",
      "secondary_message": "⅛ cup walnuts\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 250377,
      "primary_message": "To serve, divide chicken, zucchini, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
