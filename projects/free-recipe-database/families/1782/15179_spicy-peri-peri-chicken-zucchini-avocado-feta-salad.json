  "instructions": [
    {
      "id": 250391,
      "primary_message": "Preheat the oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 250392,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n1 ½ lemons\n1 ½ avocados\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 250393,
      "primary_message": "Trim and halve zucchini lengthwise; cut crosswise into ½-inch thick half-moons. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 250394,
      "primary_message": "Drizzle zucchini with oil and season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 250395,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 250396,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil and spices; whisk to combine the marinade. ",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp paprika\n1 ½ tsp salt\n1 ½ tsp oregano, dried\n¾ tsp crushed red pepper\n¾ tsp black pepper"
    },
    {
      "id": 250397,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 250398,
      "primary_message": "Add cutlets to the bowl with the marinade and turn to coat. Divide cutlets between the baking sheets, nestling them in the zucchini.",
      "secondary_message": null
    },
    {
      "id": 250399,
      "primary_message": "Place baking sheets in the oven and roast, flipping chicken halfway through, until zucchini is tender and chicken is cooked through, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 250400,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, and salt in another large bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup plain Greek yogurt\n2 tbsp avocado oil mayonnaise\n1 tbsp apple cider vinegar\n3 pinch salt"
    },
    {
      "id": 250401,
      "primary_message": "Halve and pit the avocados; scoop out flesh with a spoon and medium dice. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 250402,
      "primary_message": "Roughly chop walnuts. Add mixed greens, walnuts, and feta to the bowl with the dressing; toss to combine the salad. ",
      "secondary_message": "⅓ cup walnuts\n1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 250403,
      "primary_message": "To serve, divide chicken, zucchini, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
