  "instructions": [
    {
      "id": 250274,
      "primary_message": "Preheat the oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 250275,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 red bell peppers\n3 lb sweet potatoes\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 250276,
      "primary_message": "Trim, seed, and medium dice bell peppers. Peel and small dice sweet potatoes; divide both between two baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 250277,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 250278,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 250279,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil and spices; whisk to combine the marinade. ",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp paprika\n1 ½ tsp salt\n1 ½ tsp oregano, dried\n¾ tsp crushed red pepper\n¾ tsp black pepper"
    },
    {
      "id": 250280,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 250281,
      "primary_message": "Add cutlets to the bowl with the marinade and turn to coat. Divide cutlets between the baking sheets, nestling them in the veggies.",
      "secondary_message": null
    },
    {
      "id": 250282,
      "primary_message": "Place baking sheets in the oven and roast, flipping chicken halfway through, until veggies are tender and chicken is cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 250283,
      "primary_message": "Meanwhile, using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Place in another large bowl. ",
      "secondary_message": null
    },
    {
      "id": 250284,
      "primary_message": "Add yogurt, water, mayo, vinegar, and salt to the bowl with the parsley. Whisk to combine the dressing. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp water\n1 tbsp mayonnaise\n1 tbsp apple cider vinegar\n3 pinch salt"
    },
    {
      "id": 250285,
      "primary_message": "Roughly chop walnuts. Add mixed greens, walnuts, and cranberries to the bowl with the dressing; toss to combine the salad. ",
      "secondary_message": "½ cup walnuts\n¼ cup dried cranberries"
    },
    {
      "id": 250286,
      "primary_message": "To serve, divide chicken, veggies, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
