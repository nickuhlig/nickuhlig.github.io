  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 350°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "½ lemon\n½ (16 oz) pkg strawberries\n1 (6 oz) pkg blueberries"
    },
    {
      "primary_message": "Zest lemon into a medium bowl. Add sugar and use your hands to rub the lemon zest and sugar together. (Reserve lemon for another use.)\n\n",
      "secondary_message": "½ cup granulated sugar"
    },
    {
      "primary_message": "Add flour, baking powder, and salt to the bowl with the lemon sugar, then whisk to combine. Add milk and vanilla, then whisk once more until just combined. Set batter aside. ",
      "secondary_message": "¾ cup all-purpose flour\n1 ½ tsp baking powder\n¼ tsp salt\n⅔ cup whole milk\n1 tsp vanilla extract"
    },
    {
      "primary_message": "Trim and quarter strawberries lengthwise. Set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Melt butter in the microwave or a small saucepan, then transfer to an 8-inch square baking dish. Tilt the dish to coat the bottom, then pour in the batter, spreading it out in an even layer. Sprinkle berries over top. \n\n",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "primary_message": "Place baking dish in the preheated oven and bake until cobbler is golden and cooked through, 45-55 minutes. Remove from oven and set aside to cool slightly, about 10 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide cobbler and ice cream between bowls. Enjoy!\n\n",
      "secondary_message": "3 cups vanilla ice cream"
    }
  ],
