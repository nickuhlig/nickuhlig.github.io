  "instructions": [
    {
      "id": 578083,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 578084,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 578085,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until golden and toasted, 3-4 minutes. Transfer almonds to a small bowl and set aside. (Reserve skillet for later use.)",
      "secondary_message": "¾ cup almonds, sliced"
    },
    {
      "id": 578086,
      "primary_message": "Pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 578087,
      "primary_message": "Return skillet to medium-high heat, add oil, and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden and cooked through, 3-4 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 578088,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 oranges\n1 ½ English cucumbers\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 578089,
      "primary_message": "Using a clean cutting board, peel and mince garlic. Place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 578090,
      "primary_message": "Juice lemons and half of the oranges into the bowl with the garlic. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. (Reserve remaining oranges for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 578091,
      "primary_message": "Cut off skin and white pith from reserved oranges; slice between the membranes to release segments. Cut flesh into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 578092,
      "primary_message": "Peel, halve, and slice shallots lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 578093,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578094,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl, along with chickpeas, almonds, and feta, then gently toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 578095,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 578096,
      "primary_message": "To serve, divide salad between plates or bowls. Top with chicken and enjoy!",
      "secondary_message": null
    }
  ],
