  "instructions": [
    {
      "id": 578097,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 578098,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 578099,
      "primary_message": "Once the skillet is hot, add almonds and coconut; cook, stirring frequently, until golden and toasted, 3-4 minutes. Remove from heat.",
      "secondary_message": "⅓ cup almonds, sliced\n⅓ cup shredded unsweetened coconut"
    },
    {
      "id": 578100,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "½ lemon\n1 orange\n½ English cucumber\n1 head butter (Boston) lettuce"
    },
    {
      "id": 578101,
      "primary_message": "Peel and mince garlic. Place in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 578102,
      "primary_message": "Juice lemon and half of the orange into the bowl with the garlic. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. (Reserve remaining orange for the next step.)",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 578103,
      "primary_message": "Cut off skin and white pith from reserved orange; slice between the membranes to release segments. Cut flesh into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 578104,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 578105,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578106,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl, along with chickpeas, almonds, coconut, and feta, then gently toss to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 578107,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
