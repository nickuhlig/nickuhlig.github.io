  "instructions": [
    {
      "id": 578130,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 578131,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 578132,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until golden and toasted, 3-4 minutes. Transfer almonds to a small bowl and set aside. (Reserve skillet for later use.)",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "id": 578133,
      "primary_message": "Pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 578134,
      "primary_message": "Return skillet to medium-high heat, add oil, and swirl to coat the bottom. Add chicken and pan-fry until golden and cooked through, 3-4 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 578135,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 orange\n½ English cucumber\n1 head butter (Boston) lettuce"
    },
    {
      "id": 578136,
      "primary_message": "Using a clean cutting board, peel and mince garlic. Place in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 578137,
      "primary_message": "Juice lemon and half of the orange into the bowl with the garlic. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. (Reserve remaining orange for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 578138,
      "primary_message": "Cut off skin and white pith from reserved orange; slice between the membranes to release segments. Cut flesh into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 578139,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 578140,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578141,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl, along with chickpeas, almonds, and feta, then gently toss to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 578142,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 578143,
      "primary_message": "To serve, divide salad between plates or bowls. Top with chicken and enjoy!",
      "secondary_message": null
    }
  ],
