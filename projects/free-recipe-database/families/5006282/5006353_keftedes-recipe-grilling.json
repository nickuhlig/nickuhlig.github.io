  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the onion. Finely chop the fresh oregano. Pick the mint leaves from the stems and finely chop them. Mince the garlic. Beat the eggs.",
      "secondary_message": "1 medium onion\n⅓ cup fresh oregano\n3 tbsp fresh mint\n4 cloves garlic\n2 eggs"
    },
    {
      "id": 1,
      "primary_message": "Place the milk in a swallow bowl and dunk each piece of bread in and then squeeze the excess liquid out. Tear bread into chunks and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the beef, onions, oregano, mint, garlic, eggs, salt and pepper in the bowl with the bread and then mix with your hands until thoroughly combined. Roll out meat mixture into balls 4 cm in diameter.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over the charcoal grate. Clean and oil the grilling grate. Place the meatballs on the grill and cook until well browned all over and cooked through, about 8 minutes total, 2 minutes per side. Remove from the grill and serve with tzatziki and lemon wedges.",
      "secondary_message": null
    }
  ],
