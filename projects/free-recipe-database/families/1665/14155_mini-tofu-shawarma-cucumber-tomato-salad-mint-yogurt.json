  "instructions": [
    {
      "id": 235163,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 235164,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 235165,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n½ English cucumber\n½ small pkg fresh mint"
    },
    {
      "id": 235166,
      "primary_message": "Place oil and spices in a medium bowl; stir to combine the spice paste. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cinnamon, ground\n⅛ tsp cardamom, ground\n⅛ tsp nutmeg, ground\n⅛ tsp clove, ground\n⅛ tsp turmeric, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 235167,
      "primary_message": "Medium dice tofu, add to the bowl with the spice paste, and gently toss to coat. Transfer tofu to a baking sheet and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 235168,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235169,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp red wine vinegar\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 235170,
      "primary_message": "Peel, halve, and thinly slice shallot; add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 235171,
      "primary_message": "Small dice tomato. Peel, trim, and small dice cucumber. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 235172,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 235173,
      "primary_message": "Peel and mince garlic. Add to the bowl with the mint, along with yogurt, salt, and pepper; stir to combine the yogurt sauce.",
      "secondary_message": "1 clove garlic\n¾ cup plain Greek yogurt\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 235174,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 235175,
      "primary_message": "To serve, fill tortillas with tofu, cucumber-tomato salad, and mint yogurt. Divide between plates and enjoy!",
      "secondary_message": null
    }
  ],
