  "instructions": [
    {
      "id": 235111,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 235112,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 235113,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n1 ½ English cucumbers\n1 small pkg fresh mint"
    },
    {
      "id": 235114,
      "primary_message": "Place oil and spices in a large bowl; stir to combine the spice paste. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cinnamon, ground\n½ tsp cardamom, ground\n½ tsp nutmeg, ground\n½ tsp cloves, ground\n½ tsp turmeric, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 235115,
      "primary_message": "Medium dice tofu, add to the bowl with the spice paste, and gently toss to coat. Divide tofu between two baking sheets and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 235116,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235117,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp red wine vinegar\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 235118,
      "primary_message": "Peel, halve, and thinly slice onion; add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 235119,
      "primary_message": "Small dice tomatoes. Peel, trim, and small dice cucumbers. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 235120,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 235121,
      "primary_message": "Peel and mince garlic. Add to the bowl with the mint, along with yogurt, salt, and pepper; stir to combine the yogurt sauce.",
      "secondary_message": "3 cloves garlic\n2 ¼ cups plain Greek yogurt\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 235122,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 235123,
      "primary_message": "To serve, fill tortillas with tofu, cucumber-tomato salad, and mint yogurt. Divide between plates and enjoy!",
      "secondary_message": null
    }
  ],
