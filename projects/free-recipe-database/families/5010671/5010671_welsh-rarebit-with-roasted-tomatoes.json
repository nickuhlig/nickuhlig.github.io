  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice off the tops of the tomatoes. Toast the sourdough bread.",
      "secondary_message": "4 small tomatoes\n4 slices sourdough bread"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 375°F. Place tomatoes in a baking dish and sprinkle with salt and pepper. Place in the oven and roast until tomatoes are soft, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, place beer in a 1 quart microwavable dish and microwave on high until just simmering, about 2 minutes. Toss the shredded cheese with flour, mustard, and cayenne pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add half of the cheese mixture to the beer and stir to combine. Return to microwave and cook on high for 1 minute; remove from heat, add the rest of the cheese and mix well. Return to microwave for 1 minute, then remove and add Worcestershire and season to taste with salt and pepper. Sauce should be smooth and thick.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat oil in a large nonstick skillet over medium-high heat until lightly smoking, then crack eggs into pan. Season to taste and fry until the whites are just set but the yolks are still runny.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Place each slice of toast on a separate plate, place a roasted tomato next to the bread, then top each slice of bread with 1/2 cup of cheese sauce and top with a fried egg. Garnish with parsley and cracked pepper, if desired.",
      "secondary_message": null
    }
  ],
