  "instructions": [
    {
      "id": 623554,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623555,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 623556,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 623557,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ English cucumbers\n1 small bunch fresh dill\n3 (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 623558,
      "primary_message": "Place oil, vinegar, honey, Dijon, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tbsp honey\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 623559,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 623560,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 623561,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 623562,
      "primary_message": "Roughly chop dates and pistachios. Add both to the bowl, along with mixed greens and feta, then toss to combine the salad.",
      "secondary_message": "⅓ cup medjool dates, pitted\n⅓ cup pistachios, unsalted\n1 ½ (113 g) pkgs crumbled feta cheese"
    },
    {
      "id": 623563,
      "primary_message": "Thinly slice steak into strips.",
      "secondary_message": null
    },
    {
      "id": 623564,
      "primary_message": "To serve, divide salad and steak between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
