  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "680 g striploin (New York strip) steak\nsalt\nblack pepper\n½ tsp garlic powder"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 English cucumber\n1 small bunch fresh dill\n2 (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "primary_message": "Place oil, vinegar, honey, Dijon, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "extra virgin olive oil\n4 tsp balsamic vinegar\n2 tsp honey\n1 tsp Dijon mustard\nsalt\nblack pepper"
    },
    {
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "primary_message": "Roughly chop dates. Add to the bowl, along with mixed greens and feta, then toss to combine the salad.",
      "secondary_message": "¼ cup medjool dates, pitted\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "primary_message": "Thinly slice steak into strips.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide salad and steak between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
