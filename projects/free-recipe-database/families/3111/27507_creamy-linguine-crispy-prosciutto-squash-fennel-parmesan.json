  "instructions": [
    {
      "id": 442191,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n3 fennel bulbs\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 442192,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice.",
      "secondary_message": null
    },
    {
      "id": 442193,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt, squash, and pasta, then stir for a few seconds. Cook until squash is tender and pasta is desired firmness, 8-10 minutes. (Reserve ¾-cup of cooking water before draining and set aside.)",
      "secondary_message": "¾ tsp salt\n15 oz linguine pasta"
    },
    {
      "id": 442194,
      "primary_message": "Meanwhile, preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 442195,
      "primary_message": "Once the pot is hot, working in batches, add prosciutto and cook until crispy, about 1 minute per side. Remove to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 442196,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 442197,
      "primary_message": "Return pot to medium heat. Once the pot is hot, add oil and swirl to coat the bottom. Add fennel and spices; cook, stirring occasionally, until soft and starting to brown, 6-7 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp onion powder\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 442198,
      "primary_message": "While the fennel is cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 442199,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the parsley.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 442200,
      "primary_message": "When the fennel is done, add cooked squash, pasta, reserved pasta water, parsley, Parmesan, and cream to the pot. Continue to cook, stirring occasionally, until water has evaporated and Parmesan has melted, 2-3 minutes. Remove from heat.",
      "secondary_message": "6 fl oz (¾ cup) heavy whipping cream"
    },
    {
      "id": 442201,
      "primary_message": "Meanwhile, crumble or chop prosciutto into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 442202,
      "primary_message": "To serve, divide pasta between plates or bowls and top with crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
