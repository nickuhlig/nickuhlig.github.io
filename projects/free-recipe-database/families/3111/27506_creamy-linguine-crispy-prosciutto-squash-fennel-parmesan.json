  "instructions": [
    {
      "id": 442179,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n2 fennel bulbs\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 442180,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice.",
      "secondary_message": null
    },
    {
      "id": 442181,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt, squash, and pasta, then stir for a few seconds. Cook until squash is tender and pasta is desired firmness, 8-10 minutes. (Reserve a ½-cup cooking water before draining and set aside.)",
      "secondary_message": "½ tsp salt\n10 oz linguine pasta"
    },
    {
      "id": 442182,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 442183,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add prosciutto and cook until crispy, about 1 minute per side. Remove to a plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 442184,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 442185,
      "primary_message": "Return skillet to medium heat. Once the skillet is hot, add oil and swirl to coat the bottom. Add fennel and spices; cook, stirring occasionally, until soft and starting to brown, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp onion powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 442186,
      "primary_message": "While the fennel is cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 442187,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the parsley.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 442188,
      "primary_message": "When the fennel is done, add cooked squash, pasta, reserved pasta water, parsley, Parmesan, and cream to the skillet. Continue to cook, stirring occasionally, until water has evaporated and Parmesan has melted, about 2 minutes. Remove from heat.",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 442189,
      "primary_message": "Meanwhile, crumble or chop prosciutto into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 442190,
      "primary_message": "To serve, divide pasta between plates or bowls and top with crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
