  "instructions": [
    {
      "id": 175482,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool; peel and halve. ",
      "secondary_message": "4 eggs"
    },
    {
      "id": 175483,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 red bell pepper\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 175484,
      "primary_message": "Seed and small dice the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 175485,
      "primary_message": "Peel and mince garlic, then set aside ⅓ of the garlic for the naan. Peel and small dice shallot. ",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 175486,
      "primary_message": "Heat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 175487,
      "primary_message": "Add bell pepper, garlic, and shallot. Season with spices and cook, stirring frequently, until vegetables have softened, 3-4 minutes.",
      "secondary_message": "1 tsp cumin\n1 tsp curry powder\n½ tsp salt\n½ tsp coriander\n¼ tsp chili powder"
    },
    {
      "id": 175488,
      "primary_message": "Add tomato sauce to the skillet and bring to a simmer. Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful; simmer 2-3 minutes, stirring frequently. Remove from heat. ",
      "secondary_message": "1 (213 ml) can tomato sauce"
    },
    {
      "id": 175489,
      "primary_message": "Let the skillet sit for 5 minutes, then stir in yogurt. ",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 175490,
      "primary_message": "Meanwhile, quarter and toast the naan. Drizzle with oil and spread with reserved garlic. ",
      "secondary_message": "1 flatbread or naan\n1 tsp extra virgin olive oil"
    },
    {
      "id": 175491,
      "primary_message": "To serve, divide masala, eggs, and naan between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
