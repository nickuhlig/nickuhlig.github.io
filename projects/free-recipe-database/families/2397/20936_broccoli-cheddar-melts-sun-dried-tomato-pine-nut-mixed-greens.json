  "instructions": [
    {
      "id": 350439,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 crowns broccoli\n1 lemon\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 350440,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 350441,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 350442,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 350443,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 350444,
      "primary_message": "When onion is soft, add broccoli, salt, and pepper to the skillet. Cook, stirring occasionally, until broccoli starts to soften, 3-4 minutes. ",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 350445,
      "primary_message": "Reduce heat to medium and add water to the skillet; continue to cook until the water is evaporated and broccoli is tender, 2-3 minutes more. Remove from heat.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 350446,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 350447,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 350448,
      "primary_message": "Add mayo, vinegar, and half of the cheese to the skillet with the broccoli; stir to combine. (Reserve remaining cheese for later use.)",
      "secondary_message": "¼ cup mayonnaise\n4 tsp white wine vinegar"
    },
    {
      "id": 350449,
      "primary_message": "Split rolls in half and place, cut-side facing up, on a large baking sheet pan. Place in the oven and broil until lightly toasted, about 1 minute. ",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 350450,
      "primary_message": "Remove baking sheet from the oven and divide broccoli mixture between toasted rolls; top with reserved cheese. Return to the oven and broil until cheese melts, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 350451,
      "primary_message": "Meanwhile, juice lemon into a medium bowl. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 350452,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the dressing along with pine nuts and mixed greens; toss to combine the salad. ",
      "secondary_message": "8 sun-dried tomatoes, oil-packed\n¼ cup pine nuts"
    },
    {
      "id": 350453,
      "primary_message": "To serve, divide broccoli-cheddar melts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
