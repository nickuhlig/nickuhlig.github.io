  "instructions": [
    {
      "id": 350454,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 crowns broccoli\n1 ½ lemons\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 350455,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 350456,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 350457,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 350458,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 350459,
      "primary_message": "When onion is soft, add broccoli, salt, and pepper to the skillet. Cook, stirring occasionally, until broccoli starts to soften, about 5 minutes. ",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 350460,
      "primary_message": "Reduce heat to medium and add water to the skillet; continue to cook until the water is evaporated and broccoli is tender, 3-4 minutes more. Remove from heat.",
      "secondary_message": "¾ cup water"
    },
    {
      "id": 350461,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 350462,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 ½ (8 oz) blocks cheddar cheese"
    },
    {
      "id": 350463,
      "primary_message": "Add mayo, vinegar, and half of the cheese to the skillet with the broccoli; stir to combine. (Reserve remaining cheese for later use.)",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp white wine vinegar"
    },
    {
      "id": 350464,
      "primary_message": "Split rolls in half and place, cut-side facing up, on a large baking sheet pan. Place in the oven and broil until lightly toasted, about 1 minute. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 350465,
      "primary_message": "Remove baking sheet from the oven and divide broccoli mixture between toasted rolls; top with reserved cheese. Return to the oven and broil until cheese melts, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 350466,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 350467,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the dressing along with pine nuts and mixed greens; toss to combine the salad. ",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n⅓ cup pine nuts"
    },
    {
      "id": 350468,
      "primary_message": "To serve, divide broccoli-cheddar melts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
