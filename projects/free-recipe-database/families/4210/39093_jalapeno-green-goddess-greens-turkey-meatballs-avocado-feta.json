  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh basil\n½ small pkg chives\n½ jalapeño pepper\n½ English cucumber\n½ bunch radish\n½ avocado\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "primary_message": "Peel and mince garlic. Divide between a blender and a medium bowl. (Set bowl aside for later use.)",
      "secondary_message": "1 clove garlic"
    },
    {
      "primary_message": "Pick basil leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop chives. Add to the blender.",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Add to the blender along with mayo, oil, honey, salt, and pepper. Blend on high, adding water 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "2 tbsp mayonnaise\nextra virgin olive oil\n1 tsp honey\nsalt\nblack pepper"
    },
    {
      "primary_message": "Add turkey, bread crumbs, and spices to the reserved bowl with the garlic; using your hands, mix well to combine. Using a rounded tablespoon measure, form the turkey mixture into meatballs and place on a plate.",
      "secondary_message": "¾ lb ground turkey\n½ tsp paprika\nsalt\nblack pepper"
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Transfer to a clean plate.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the bowl, along with mixed greens and feta, then toss to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "primary_message": "To serve, divide salad and meatballs between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
