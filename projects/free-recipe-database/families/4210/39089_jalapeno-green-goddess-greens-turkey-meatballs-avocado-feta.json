  "instructions": [
    {
      "id": 607719,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small pkgs fresh basil\n1 small pkg chives\n1 ½ jalapeño peppers\n1 ½ English cucumbers\n1 ½ bunches radish\n1 ½ avocados\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 607720,
      "primary_message": "Peel and mince garlic. Divide between a blender and a large bowl. (Set bowl aside for later use.)",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 607721,
      "primary_message": "Pick basil leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 607722,
      "primary_message": "Roughly chop chives. Add to the blender.",
      "secondary_message": null
    },
    {
      "id": 607723,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Add to the blender along with mayo, oil, honey, salt, and pepper. Blend on high, adding water a few tablespoons at a time, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp extra virgin olive oil\n1 tbsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 607724,
      "primary_message": "Add turkey, bread crumbs, and spices to the reserved bowl with the garlic; using your hands, mix well to combine. Using a rounded tablespoon measure, form the turkey mixture into meatballs and place on a plate.",
      "secondary_message": "2 ¼ lb ground turkey\n⅓ cup panko bread crumbs\n1 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 607725,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 607726,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 607727,
      "primary_message": "Meanwhile, trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 607728,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 607729,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the bowl, along with mixed greens and feta, then toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 607730,
      "primary_message": "To serve, divide salad and meatballs between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
