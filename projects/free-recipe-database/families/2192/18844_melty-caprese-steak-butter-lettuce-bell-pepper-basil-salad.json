  "instructions": [
    {
      "id": 310338,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 310339,
      "primary_message": "Add oil, vinegar, and spices to the bowl with the garlic; whisk to combine the dressing. Pour half into a large baking dish, then set the bowl aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 310340,
      "primary_message": "Cut steak into portions, pat dry with paper towels, and add to the baking dish; turn to coat and set aside to marinate.",
      "secondary_message": "1.02 kg striploin (New York strip) steak"
    },
    {
      "id": 310341,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n3 tomatoes\n1 small pkg fresh basil\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 310342,
      "primary_message": "Using a clean cutting board, trim, seed, and medium dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 310343,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310344,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper, salt, and pepper. Cook, stirring occasionally, until fork-tender, 4-5 minutes. Remove to a plate, loosely cover with aluminum foil, and set aside. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 310345,
      "primary_message": "When the peppers are done, return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 310346,
      "primary_message": "Meanwhile, thinly slice tomatoes and mozzarella crosswise into rounds.",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 310347,
      "primary_message": "When the steak is done, remove skillet from heat; top with tomatoes and mozzarella. Cover with a lid and let sit until cheese starts to melt, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 310348,
      "primary_message": "While the cheese melts, pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add half to the bowl with the dressing. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 310349,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces; add to the bowl, along with the cooked peppers, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 310350,
      "primary_message": "To serve, divide salad and steaks between plates. Top steaks with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
