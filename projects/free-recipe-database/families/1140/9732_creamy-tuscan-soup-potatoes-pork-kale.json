  "instructions": [
    {
      "id": 155534,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 155535,
      "primary_message": "Use the tip of a knife to slice down the length of the sausages. Peel off the casing and discard.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 155536,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork and break apart with a spoon. Cook, stirring occasionally, until browned and crumbly, 6-8 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 155537,
      "primary_message": "Meanwhile, peel and mince garlic. Peel and small dice onion.",
      "secondary_message": "4 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 155538,
      "primary_message": "Add garlic and onion to the pot and cook, stirring frequently, until softened, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 155539,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 155540,
      "primary_message": "Add beans, broth, and spices to the pot. Cover and bring to a simmer.",
      "secondary_message": "1420 ml chicken or vegetable broth\n½ tsp paprika\n½ tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 155541,
      "primary_message": "Meanwhile, wash potatoes. Cut into quarters, then thinly slice into ⅛-inch pieces. Add to the pot.",
      "secondary_message": "2 medium red potatoes"
    },
    {
      "id": 155542,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the pot.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 155543,
      "primary_message": "Let the soup simmer, covered, until potatoes are fork tender, 10-15 minutes. Add cream and stir to combine.",
      "secondary_message": "118 ml (½ cup) heavy cream"
    },
    {
      "id": 155544,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
