  "instructions": [
    {
      "id": 281155,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 281156,
      "primary_message": "Wash and dry bell pepper, then trim, seed, and small dice. Place in a small bowl.",
      "secondary_message": "1 yellow bell pepper"
    },
    {
      "id": 281157,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 281158,
      "primary_message": "Mince sun-dried tomatoes and add to the bowl.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 281159,
      "primary_message": "Preheat a medium saucepan over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 281160,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies to the pan; cook, stirring frequently, until softened, 4-5 minutes. (Reserve bowl for next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 281161,
      "primary_message": "Meanwhile, place water and cornstarch in the reserved bowl; whisk to combine the slurry.",
      "secondary_message": "1 tbsp water\n2 tsp cornstarch"
    },
    {
      "id": 281162,
      "primary_message": "When the veggies are soft, add cornstarch slurry, almond milk, nutritional yeast, salt, and pepper to the pan; stir to combine and bring to a simmer. Once simmering, cook, stirring occasionally, until sauce thickens, 3-4 minutes.",
      "secondary_message": "8 fl oz (1 cup) almond milk, unsweetened\n⅛ cup nutritional yeast flakes\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 281163,
      "primary_message": "While the sauce simmers, wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 281164,
      "primary_message": "Add beans, gnocchi, peas, and half of the basil to the pan (reserve remaining basil for garnish). Continue to cook, stirring occasionally, until warmed through, 4-5 minutes more.",
      "secondary_message": "1 (16 oz) pkg potato gnocchi\n1 cup frozen peas"
    },
    {
      "id": 281165,
      "primary_message": "To serve, divide creamy gnocchi between bowls. Top with remaining basil and enjoy!",
      "secondary_message": null
    }
  ],
