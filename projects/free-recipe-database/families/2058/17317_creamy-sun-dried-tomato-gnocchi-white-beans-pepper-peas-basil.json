  "instructions": [
    {
      "id": 281210,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 281211,
      "primary_message": "Wash and dry bell peppers, then trim, seed, and small dice. Place in a medium bowl.",
      "secondary_message": "3 yellow bell peppers"
    },
    {
      "id": 281212,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 281213,
      "primary_message": "Mince sun-dried tomatoes and add to the bowl.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 281214,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 281215,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies to the pot; cook, stirring frequently, until softened, 5-6 minutes. (Reserve bowl for next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 281216,
      "primary_message": "Meanwhile, place water and cornstarch in the reserved bowl; whisk to combine the slurry.",
      "secondary_message": "3 tbsp water\n2 tbsp cornstarch"
    },
    {
      "id": 281217,
      "primary_message": "When the veggies are soft, add cornstarch slurry, almond milk, nutritional yeast, salt, and pepper to the pot; stir to combine and bring to a simmer. Once simmering, cook, stirring occasionally, until sauce thickens, 4-5 minutes.",
      "secondary_message": "710 ml almond milk, unsweetened\n½ cup nutritional yeast flakes\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 281218,
      "primary_message": "While the sauce simmers, wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "3 small pkgs fresh basil"
    },
    {
      "id": 281219,
      "primary_message": "Add beans, gnocchi, peas, and half of the basil to the pot (reserve remaining basil for garnish). Continue to cook, stirring occasionally, until warmed through, 5-6 minutes more.",
      "secondary_message": "3 (454 g) pkgs potato gnocchi\n3 cups frozen peas"
    },
    {
      "id": 281220,
      "primary_message": "To serve, divide creamy gnocchi between bowls. Top with remaining basil and enjoy!",
      "secondary_message": null
    }
  ],
