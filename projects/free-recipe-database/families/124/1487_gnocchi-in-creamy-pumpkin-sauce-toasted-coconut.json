  "instructions": [
    {
      "id": 13203,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 13204,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 13205,
      "primary_message": "Coat bottom of pan with oil. Add coconut and stirring constantly, cook until browned, 1-2 minutes. Transfer to a small bowl.",
      "secondary_message": "1 tsp virgin coconut oil\n⅛ cup shredded unsweetened coconut"
    },
    {
      "id": 13206,
      "primary_message": "Return pan to stove and add more oil and garlic. Cook until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 13207,
      "primary_message": "Add gnocchi and, stirring occasionally, cook until lightly browned, 5-6 minutes. Transfer to a plate.",
      "secondary_message": "1 (13.5 oz) pkg potato gnocchi"
    },
    {
      "id": 13208,
      "primary_message": "Return pan to stove. Add pumpkin and coconut milk. Stir until well combined. Add maple syrup, salt, and pepper. Stirring occasionally, cook for about 5 minutes.",
      "secondary_message": "½ (15 oz) can pure pumpkin purée\n½ (13.5 fl oz) can coconut milk\n1 tsp pure maple syrup\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 13209,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 13210,
      "primary_message": "To serve, place sauce in a bowl, top with gnocchi, and garnish with toasted coconut and parsley. Enjoy!",
      "secondary_message": ""
    }
  ],
