  "instructions": [
    {
      "id": 401280,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 401281,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 401282,
      "primary_message": "Place curry paste, water, vinegar, and oil in a large bowl. Stir to combine the sauce and set aside.",
      "secondary_message": "¼ cup Thai curry paste, green\n2 tbsp water\n1 tbsp rice vinegar\n1 tbsp toasted sesame oil"
    },
    {
      "id": 401283,
      "primary_message": "Large dice tofu. Place in another large bowl, then sprinkle with cornstarch, salt, and pepper; toss to coat. (Wipe baking sheet dry with paper towels.)",
      "secondary_message": "2 tbsp cornstarch\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 401284,
      "primary_message": "Divide tofu between two baking sheets and spread out in an even layer; drizzle with oil. (Wipe bowl clean with paper towels and set aside for later use.)",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 401285,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing once, until tofu is golden and warmed through, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 401286,
      "primary_message": "Meanwhile, wash, dry, trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": "1 ½ English cucumbers"
    },
    {
      "id": 401287,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the cucumber.",
      "secondary_message": "3 hearts romaine hearts"
    },
    {
      "id": 401288,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; add to the bowl with the salad, along with the peanuts, and set aside.",
      "secondary_message": "2 cups edamame\n1 cup peanuts, roasted unsalted"
    },
    {
      "id": 401289,
      "primary_message": "When the tofu is done, remove from oven and add to the bowl with the sauce. Gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 401290,
      "primary_message": "Add peanut sauce to the bowl with the salad and toss to combine.",
      "secondary_message": "¾ cup peanut sauce"
    },
    {
      "id": 401291,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
