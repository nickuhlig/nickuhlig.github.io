  "instructions": [
    {
      "id": 401194,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 401195,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 401196,
      "primary_message": "Place curry paste, water, vinegar, and oil in a medium bowl. Stir to combine the sauce and set aside.",
      "secondary_message": "1 ½ tbsp Thai curry paste, green\n2 tsp water\n1 tsp rice vinegar\n1 tsp toasted sesame oil"
    },
    {
      "id": 401197,
      "primary_message": "Large dice tofu. Place in another medium bowl, then sprinkle with cornstarch, salt, and pepper; toss to coat. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet and spread out in an even layer; drizzle with oil. (Wipe bowl clean with paper towels and set aside for later use.)",
      "secondary_message": "2 tsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper\n1 tbsp toasted sesame oil"
    },
    {
      "id": 401198,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing once, until tofu is golden and warmed through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 401199,
      "primary_message": "Meanwhile, wash, dry, trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": "½ English cucumber"
    },
    {
      "id": 401200,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the cucumber.",
      "secondary_message": "1 heart romaine hearts"
    },
    {
      "id": 401201,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; add to the bowl with the salad, along with the peanuts, and set aside.",
      "secondary_message": "⅔ cup edamame, shelled\n⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 401202,
      "primary_message": "When the tofu is done, remove from oven and add to the bowl with the sauce. Gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 401203,
      "primary_message": "Add peanut sauce to the bowl with the salad and toss to combine.",
      "secondary_message": "¼ cup peanut sauce"
    },
    {
      "id": 401204,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
