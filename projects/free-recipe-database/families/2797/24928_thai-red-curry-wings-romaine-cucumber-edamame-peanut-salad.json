  "instructions": [
    {
      "id": 401228,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 401229,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken wings, split with tips removed\n2 tsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 401230,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until wings are cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 401231,
      "primary_message": "Meanwhile, place curry paste, water, vinegar, and oil in a clean medium bowl. Stir to combine the wing sauce and set aside.",
      "secondary_message": "1 ½ tbsp Thai curry paste, red\n2 tsp water\n1 tsp rice vinegar\n1 tsp toasted sesame oil"
    },
    {
      "id": 401232,
      "primary_message": "Wash, dry, trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Place in another clean medium bowl.",
      "secondary_message": "½ English cucumber"
    },
    {
      "id": 401233,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the cucumber.",
      "secondary_message": "1 heart romaine hearts"
    },
    {
      "id": 401234,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; add to the bowl with the salad, along with the peanuts, and set aside.",
      "secondary_message": "⅔ cup edamame, shelled\n¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 401235,
      "primary_message": "When the wings are done, remove from oven and add to the bowl with the wing sauce. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 401236,
      "primary_message": "Add peanut sauce to the bowl with the salad and toss to combine.",
      "secondary_message": "¼ cup peanut sauce"
    },
    {
      "id": 401237,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
