  "instructions": [
    {
      "id": 627410,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 627411,
      "primary_message": "Place broth and orzo in a large pot. Bring to a simmer over medium-high heat. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n15 oz orzo pasta"
    },
    {
      "id": 627412,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n1 small pkg chives\n1 ½ lemons"
    },
    {
      "id": 627413,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut into 1-inch pieces. Divide between two baking sheet pans, drizzle with oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 627414,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces. Sprinkle over the asparagus.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 627415,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until asparagus is tender and prosciutto is crispy, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 627416,
      "primary_message": "Meanwhile, crumble goat cheese into a small bowl.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 627417,
      "primary_message": "Chop chives into small pieces. Add to the bowl with the goat cheese.",
      "secondary_message": null
    },
    {
      "id": 627418,
      "primary_message": "When the orzo is done, juice lemons into the pot, then add roasted asparagus, prosciutto, goat cheese, and chives. Continue to cook, stirring frequently, until goat cheese is melted and orzo is combined, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 627419,
      "primary_message": "To serve, divide orzo between plates or bowls, then sprinkle with pine nuts and crushed red pepper. Enjoy!",
      "secondary_message": "⅓ cup pine nuts\n¾ tsp crushed red pepper"
    }
  ],
