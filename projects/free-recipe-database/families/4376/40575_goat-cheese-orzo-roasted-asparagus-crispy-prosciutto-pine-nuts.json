  "instructions": [
    {
      "id": 627390,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 627391,
      "primary_message": "Place broth and orzo in a medium saucepan. Bring to a simmer over medium-high heat. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n5 oz orzo pasta"
    },
    {
      "id": 627392,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n½ small pkg chives\n½ lemon"
    },
    {
      "id": 627393,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut into 1-inch pieces. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 627394,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces. Sprinkle over the asparagus.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 627395,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until asparagus is tender and prosciutto is crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 627396,
      "primary_message": "Meanwhile, crumble goat cheese into a small bowl.",
      "secondary_message": "½ (4 oz) log goat cheese"
    },
    {
      "id": 627397,
      "primary_message": "Chop chives into small pieces. Add to the bowl with the goat cheese.",
      "secondary_message": null
    },
    {
      "id": 627398,
      "primary_message": "When the orzo is done, juice lemon into the pan, then add roasted asparagus, prosciutto, goat cheese, and chives. Continue to cook, stirring frequently, until goat cheese is melted and orzo is combined, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 627399,
      "primary_message": "To serve, divide orzo between plates or bowls, then sprinkle with pine nuts and crushed red pepper. Enjoy!",
      "secondary_message": "⅛ cup pine nuts\n¼ tsp crushed red pepper"
    }
  ],
