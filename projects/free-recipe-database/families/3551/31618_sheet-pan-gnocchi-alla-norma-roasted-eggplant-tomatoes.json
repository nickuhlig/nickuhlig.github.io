  "instructions": [
    {
      "id": 499668,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 499669,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n1 small pkg grape tomatoes\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 499670,
      "primary_message": "Trim and medium dice eggplant. Transfer to a baking sheet pan along with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 499671,
      "primary_message": "Peel and thinly slice garlic. Add to the baking sheet with the veggies along with gnocchi. Drizzle with oil and season with spices; stir to combine and spread out in an even layer.",
      "secondary_message": "2 cloves garlic\n1 (454 g) pkg potato gnocchi\n1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp oregano, dried\n¼ tsp crushed red pepper"
    },
    {
      "id": 499672,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and gnocchi is golden, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 499673,
      "primary_message": "When the gnocchi and veggies are almost done, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 499674,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 499675,
      "primary_message": "Add Parmesan and parsley to the baking sheet. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 499676,
      "primary_message": "To serve, divide gnocchi and veggies between plates or bowls. Drizzle with oil and enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
