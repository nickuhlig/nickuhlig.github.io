  "instructions": [
    {
      "id": 499659,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 499660,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 pints grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 499661,
      "primary_message": "Trim and medium dice eggplants. Divide between two large baking sheet pans along with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 499662,
      "primary_message": "Peel and thinly slice garlic. Add to the baking sheets with the veggies along with gnocchi. Drizzle with oil and season with spices; stir to combine and spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n3 (16 oz) pkgs potato gnocchi\n¼ cup extra virgin olive oil\n2 ½ tsp salt\n1 ½ tsp oregano, dried\n¾ tsp crushed red pepper"
    },
    {
      "id": 499663,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and gnocchi is golden, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 499664,
      "primary_message": "When the gnocchi and veggies are almost done, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 499665,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 499666,
      "primary_message": "Add Parmesan and parsley to the baking sheets. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 499667,
      "primary_message": "To serve, divide gnocchi and veggies between plates or bowls. Drizzle with oil and enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil"
    }
  ],
