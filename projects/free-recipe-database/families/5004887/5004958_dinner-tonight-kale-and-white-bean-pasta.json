  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the onion. Mince the garlic. Chop the kale into 1-inch pieces. Chop the canned tomatoes. Rinse the canned white cannellini beans.",
      "secondary_message": "½ cup onion\n1 clove garlic\n3 bunches kale\n1 cup canned tomatoes\n1 cup canned white cannellini beans"
    },
    {
      "id": 1,
      "primary_message": "Pour the oil into a skillet set over medium-high heat. Add the onion and cook, stirring occasionally, until soft. Then add the garlic, pepper flakes, and half of the kale. Cook for an additional 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Dump in the tomatoes and the rest of the kale. Season with a pinch of salt. Cover the skillet and bring to a boil. Reduce heat to medium, and cook for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the beans and cook until warmed.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Meanwhile, bring a large pot of water to a boil. Add the pasta and cook for one minute less than the directions on the packaging. When done, drain the pasta and toss it into the pan with the kale. Turn the heat to high and cook for an additional minute.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Season with salt and pepper to taste, sprinkle with Parmesan if using, and serve.",
      "secondary_message": null
    }
  ],
