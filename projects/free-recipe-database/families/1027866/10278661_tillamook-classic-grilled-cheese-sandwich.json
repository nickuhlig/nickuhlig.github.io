  "instructions": [
    {
      "primary_message": "Heat oven to 300°F. Place a cookie sheet pan in the oven.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place 4 slices of bread on a cutting board. Place 4 slices of Tillamook® sharp cheddar cheese on each slice of bread.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cover with the other slice of bread. Spread softened Tillamook® unsalted extra creamy butter on the top and bottom of the finished sandwich with pastry brush or butter knife.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Heat a sauté pan on the stove over medium heat. Place each sandwich in sauté pan and toast evenly on each side. Then place one by one in the oven on the cookie sheet until they are all melted.\n",
      "secondary_message": null
    }
  ],
