  "instructions": [
    {
      "id": 285467,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 285468,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 285469,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n2 (2 ½ cm) pieces ginger root\n1 lime\n2 (142 g) pkg baby spinach\n1 small pkg grape tomatoes"
    },
    {
      "id": 285470,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 285471,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the cilantro.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 285472,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on the cutting board. Holding the tail end firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin). Discard the skin.",
      "secondary_message": "0.68 kg salmon fillet"
    },
    {
      "id": 285473,
      "primary_message": "Cut salmon into 1-inch pieces, season with salt and pepper, and set aside.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 285474,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 285475,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, cilantro, curry powder, and turmeric; cook, stirring constantly, until fragrant, about 1 minute. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp curry powder\n½ tsp turmeric, ground"
    },
    {
      "id": 285476,
      "primary_message": "Add coconut milk, broth, chili-garlic sauce, fish sauce, sugar, salt, and pepper to the skillet; stir to combine.",
      "secondary_message": "1 (398 ml) can coconut milk\n237 ml chicken or vegetable broth\n2 tsp chili-garlic sauce\n2 tsp fish sauce\n2 tsp brown sugar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 285477,
      "primary_message": "Juice lime into the skillet, add salmon, and stir to combine the curry. Bring to a simmer; once simmering, reduce heat to low and cook, stirring occasionally, until the salmon is cooked through and flakey, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 285478,
      "primary_message": "While the salmon is cooking, using a clean cutting board, roughly chop spinach; halve tomatoes. Place both in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 285479,
      "primary_message": "Add spinach and tomatoes to the skillet in handfuls, waiting for the veggies to wilt slightly before adding the next handful. Continue to cook until heated through, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 285480,
      "primary_message": "To serve, divide rice and salmon curry between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
