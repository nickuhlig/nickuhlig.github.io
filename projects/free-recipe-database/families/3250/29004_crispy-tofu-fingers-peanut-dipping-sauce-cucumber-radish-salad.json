  "instructions": [
    {
      "id": 463363,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 463364,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 463365,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ limes\n1 ½ bunches radish\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 463366,
      "primary_message": "Juice limes into a small bowl; add peanut butter, soy sauce, maple syrup, water, turmeric, and curry powder. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "⅓ cup natural peanut butter\n2 tbsp soy sauce\n1 ½ tbsp pure maple syrup\n1 tbsp water\n½ tsp turmeric, ground\n3 pinch curry powder"
    },
    {
      "id": 463367,
      "primary_message": "Place mayo, soy sauce, salt, and pepper in a large bowl. Whisk to combine.",
      "secondary_message": "⅓ cup vegan mayonnaise\n1 tbsp soy sauce\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 463368,
      "primary_message": "Cut tofu crosswise into 1-inch wide fingers. Add to the bowl with the mayo mixture and gently toss to coat. (Wipe baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 463369,
      "primary_message": "Add bread crumbs to the bowl with the tofu and gently toss once more to coat. Divide between reserved baking sheet and an additional baking sheet, then arrange in a single layer and drizzle with oil.",
      "secondary_message": "1 ½ cup panko bread crumbs\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 463370,
      "primary_message": "Place tofu in the oven and bake, flipping halfway, until golden and warmed through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 463371,
      "primary_message": "Meanwhile, place mayo, soy sauce, oil, salt, and pepper in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n1 tbsp soy sauce\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 463372,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 463373,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 463374,
      "primary_message": "When the tofu is almost done, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 463375,
      "primary_message": "To serve, divide tofu fingers, peanut sauce, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
