  "instructions": [
    {
      "id": 463526,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 463527,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 463528,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lime\n½ bunch radish\n½ English cucumber\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 463529,
      "primary_message": "Juice lime into a small bowl; add peanut butter, soy sauce, maple syrup, water, turmeric, and curry powder. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "2 tbsp natural peanut butter\n2 tsp soy sauce\n1 ½ tsp pure maple syrup\n1 tsp water\n⅛ tsp turmeric, ground\n1 pinch curry powder"
    },
    {
      "id": 463530,
      "primary_message": "Place mayo, soy sauce, salt, and pepper in a medium bowl. Whisk to combine.",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp soy sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 463531,
      "primary_message": "Cut tofu crosswise into 1-inch wide fingers. Add to the bowl with the mayo mixture and gently toss to coat. (Wipe baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 463532,
      "primary_message": "Add bread crumbs to the bowl with the tofu and gently toss once more to coat. Arrange on the reserved baking sheet in a single layer and drizzle with oil.",
      "secondary_message": "½ cup panko bread crumbs\n2 tsp extra virgin olive oil"
    },
    {
      "id": 463533,
      "primary_message": "Place tofu in the oven and bake, flipping halfway, until golden and warmed through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 463534,
      "primary_message": "Meanwhile, place mayo, soy sauce, oil, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp mayonnaise\n1 tsp soy sauce\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 463535,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 463536,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 463537,
      "primary_message": "When the tofu is almost done, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 463538,
      "primary_message": "To serve, divide tofu fingers, peanut sauce, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
