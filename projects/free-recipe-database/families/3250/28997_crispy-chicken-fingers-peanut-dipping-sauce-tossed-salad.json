  "instructions": [
    {
      "id": 463274,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 463275,
      "primary_message": "Place mayo, soy sauce, salt, and pepper in a medium bowl. Whisk to combine.",
      "secondary_message": "¼ cup mayonnaise\n2 tsp soy sauce\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 463276,
      "primary_message": "Pat chicken dry with paper towels, then slice into ¾-inch strips. Add to the bowl with the mayo mixture and toss to coat.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 463277,
      "primary_message": "Add bread crumbs to the bowl with the chicken and gently toss once more to coat. Arrange on a large baking sheet pan in a single layer and drizzle with oil.",
      "secondary_message": "1 cup panko bread crumbs\n4 tsp extra virgin olive oil"
    },
    {
      "id": 463278,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 463279,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lime\n1 bunch radish\n1 English cucumber\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 463280,
      "primary_message": "Juice lime into a small bowl; add peanut butter, soy sauce, maple syrup, water, turmeric, and curry powder. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "¼ cup natural peanut butter\n4 tsp soy sauce\n1 tbsp pure maple syrup\n2 tsp water\n¼ tsp turmeric, ground\n⅛ tsp curry powder"
    },
    {
      "id": 463281,
      "primary_message": "Place mayo, soy sauce, oil, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp soy sauce\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 463282,
      "primary_message": "Using a clean cutting board, trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 463283,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 463284,
      "primary_message": "When the chicken is almost done, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 463285,
      "primary_message": "To serve, divide chicken fingers, peanut sauce, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
