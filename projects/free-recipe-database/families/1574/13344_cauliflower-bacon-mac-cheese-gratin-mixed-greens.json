  "instructions": [
    {
      "id": 222952,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); add salt, cover, and bring to a boil over high heat.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 222953,
      "primary_message": "Meanwhile, wash, dry, and cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 222954,
      "primary_message": "Once the water is boiling, add cauliflower and cook until tender-crisp, 8-10 minutes. Drain in a colander and set aside.",
      "secondary_message": null
    },
    {
      "id": 222955,
      "primary_message": "While the cauliflower is cooking, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 222956,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add bacon and cook until crispy, 3-5 minutes per side. Transfer to a plate lined with paper towels, crumble or chop into small pieces, and set aside.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 222957,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 222958,
      "primary_message": "Cut cream cheese into small pieces. Coarsely grate cheddar; set both aside.",
      "secondary_message": "1 (8 oz) block cream cheese\n1 (8 oz) block cheddar cheese"
    },
    {
      "id": 222959,
      "primary_message": "Return skillet (with bacon fat) to medium heat.",
      "secondary_message": null
    },
    {
      "id": 222960,
      "primary_message": "Once the skillet is hot, add milk and spices; whisk to combine and bring to a simmer. Once simmering, add cream cheese, a few pieces at a time, whisking until melted and combined, 2-3 minutes. Remove from the heat. ",
      "secondary_message": "12 fl oz (1 ½ cups) whole milk\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp paprika\n3 pinch black pepper"
    },
    {
      "id": 222961,
      "primary_message": "Add half the cheddar to the skillet and whisk until melted. ",
      "secondary_message": null
    },
    {
      "id": 222962,
      "primary_message": "Transfer cooked cauliflower to a large baking dish and spread out in an even layer. Pour the cheese sauce over the cauliflower and sprinkle with remaining cheddar. Place in the oven and broil until the top is golden and bubbly, 2-3 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 222963,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 222964,
      "primary_message": "Wash and dry the spring mix (skip this step if it came pre-washed). Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": "1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 222965,
      "primary_message": "Divide cauliflower between plates and sprinkle with bacon. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
