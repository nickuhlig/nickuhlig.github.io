  "instructions": [
    {
      "id": 1,
      "primary_message": "Place oil, garlic, and red pepper flakes in a small sauce pan over low heat. Cook until garlic starts to brown and pepper darkens, but doesn’t blacken, about 5 minutes. Remove from heat and let cool to room temperature, 1 to 2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain oil through a fine mesh strainer into a glass jar. Use immediately or store in refrigerator for up to 10 days, allowing to come to room temperature before use.",
      "secondary_message": null
    }
  ],
