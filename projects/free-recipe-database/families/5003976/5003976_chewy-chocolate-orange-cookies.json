  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Zest the orange.",
      "secondary_message": "8 tbsp unsalted butter\n1 orange"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together flour, baking powder, salt, and cocoa powder. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In the bowl of a stand mixer fitted with a paddle attachment, beat butter and sugar until light and fluffy, about 3 minutes. Beat in egg and vanilla. Add dry ingredients and mix until just combined. Mix in orange juice and zest. Wrap dough in plastic wrap and chill in refrigerator for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat oven to 350°F. Line two baking sheets with parchment paper. Drop dough by the rounded tablespoon onto prepared baking sheets. Bake until dry on top, about 12 minutes. Let cool 5 minutes, then transfer to a wire rack to finish cooling.",
      "secondary_message": null
    }
  ],
