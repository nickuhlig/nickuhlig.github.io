  "instructions": [
    {
      "id": 1,
      "primary_message": "Line a rimmed baking sheet with parchment paper. Cut a second sheet of parchment to roughly the same size and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a 12-inch skillet, toast sesame seeds and/or sesame seeds and nuts over medium heat, stirring frequently, until lightly golden and fragrant, 4 to 7 minutes. Transfer to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add honey to now-empty skillet and cook over medium-low heat until bubbling steadily, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add toasted sesame seeds and/or sesame seeds and nuts and cook, stirring frequently, until mixture is fragrant, thickened, and no loose pockets of honey remain, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Immediately transfer mixture to prepared sheet and place reserved sheet of parchment on top. Using a rolling pin, bench scraper, or bottom of a small plate, press mixture into an even layer about 1/8- to 1/4-inch thick. Let cool completely at room temperature, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Once cooled, remove top sheet of parchment. Transfer pasteli, still on bottom sheet of parchment, to a cutting board and cut into 14 to 18 pieces. Serve. Store in an airtight container at room temperature with parchment between layers to prevent sticking.",
      "secondary_message": null
    }
  ],
