  "instructions": [
    {
      "id": 626340,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Place on a plate.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 626341,
      "primary_message": "Wash and dry alfalfa sprouts. Wash, dry, and halve tomatoes lengthwise, then slice crosswise into thin half-moons. Add both to the plate with the shallot and set aside.",
      "secondary_message": "1 (3 oz) pkg alfalfa sprouts\n2 tomatoes"
    },
    {
      "id": 626342,
      "primary_message": "Small dice cream cheese. Place in a small bowl.",
      "secondary_message": "1 (227 g) block cream cheese"
    },
    {
      "id": 626343,
      "primary_message": "Mince capers. Add to the bowl with the cream cheese, along with spices, then mash with the back of a spoon to combine.",
      "secondary_message": "2 tbsp capers\n1 tsp dill, dried\n½ tsp onion powder\n⅛ tsp black pepper"
    },
    {
      "id": 626344,
      "primary_message": "Place tortillas on a flat surface and spread with herbed cream cheese. Top cream cheese with smoked salmon, shallot, alfalfa sprouts, and tomato. Fold in sides of tortillas and roll tightly to close the wraps.",
      "secondary_message": "4 large flour tortillas\n2 (113 g) pkgs smoked salmon"
    },
    {
      "id": 626345,
      "primary_message": "To serve, cut wraps in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
