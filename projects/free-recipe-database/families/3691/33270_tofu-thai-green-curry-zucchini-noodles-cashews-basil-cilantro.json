  "instructions": [
    {
      "id": 525893,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 525894,
      "primary_message": "Roughly chop cashews. Place in a small bowl and set aside.",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 525895,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n3 (2 ½ cm) pieces ginger root\n3 jalapeño peppers\n1 ½ limes\n1 small bunch cilantro\n1 small pkg fresh basil"
    },
    {
      "id": 525896,
      "primary_message": "Trim zucchini; run a vegetable peeler along the length of the zucchini to make ribbons. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 525897,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 525898,
      "primary_message": "While the pot heats up, medium dice tofu. Place in another large bowl, sprinkle with cornstarch and salt, then gently toss to coat.",
      "secondary_message": "⅓ cup cornstarch\n¾ tsp salt"
    },
    {
      "id": 525899,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches, add the tofu and cook, turning every few minutes, until golden brown and crispy, about 10 minutes. Remove to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 525900,
      "primary_message": "Meanwhile, peel and mince ginger, shallots, and garlic. Place all three in another small bowl.",
      "secondary_message": "2 shallots\n6 cloves garlic"
    },
    {
      "id": 525901,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level, then roughly chop. Add to the bowl with the ginger, shallot, and garlic. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 525902,
      "primary_message": "Zest limes into the bowl. (Reserve limes for later use).",
      "secondary_message": null
    },
    {
      "id": 525903,
      "primary_message": "When the tofu is done, add more oil to the pot and swirl to coat the bottom. Add ginger-jalapeño mixture, chili-garlic sauce, sugar, and spices to the pot. Cook, stirring frequently until fragrant, about 3 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n1 tbsp cumin, ground\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 525904,
      "primary_message": "Add broth and coconut milk to the pot, stir to combine, and bring to a simmer. Once simmering, reduce heat to low, and continue to cook, stirring occasionally, until slightly thickened, 5-6 minutes more.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk"
    },
    {
      "id": 525905,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems, then pick basil leaves off the stems. Discard stems and mince the leaves. Add herbs to the pot (reserving a small handful of each for serving), then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 525906,
      "primary_message": "Using a hand blender, purée the curry until smooth. (If using a regular blender, work in batches as needed, then return curry to the pot.)",
      "secondary_message": null
    },
    {
      "id": 525907,
      "primary_message": "Juice reserved limes into the pot, then add the zucchini noodles and soy sauce. Gently toss the noodles to coat with the curry, and continue to cook, until zucchini noodles are soft, 3-4 minutes more. Remove from heat.",
      "secondary_message": "2 tbsp soy sauce"
    },
    {
      "id": 525908,
      "primary_message": "To serve, divide green curry, zucchini noodles, and crispy tofu between bowls. Top with reserved herbs and cashews. Enjoy!",
      "secondary_message": null
    }
  ],
