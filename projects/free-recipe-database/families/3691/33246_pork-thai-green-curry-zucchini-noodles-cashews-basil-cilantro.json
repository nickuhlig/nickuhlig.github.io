  "instructions": [
    {
      "id": 525525,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n3 (1 inch) pieces ginger root\n3 jalapeño peppers\n1 ½ limes\n1 small bunch cilantro\n1 small pkg fresh basil"
    },
    {
      "id": 525526,
      "primary_message": "Trim zucchini, then run a vegetable peeler along the length of the zucchini to make ribbons. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 525527,
      "primary_message": "Peel and mince ginger, shallots, and garlic. Place all three in a small bowl.",
      "secondary_message": "2 shallots\n6 cloves garlic"
    },
    {
      "id": 525528,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level, then small dice. Add to the bowl with the ginger, shallot, and garlic. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 525529,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 525530,
      "primary_message": "While the pot heats up, zest limes into the small bowl. (Reserve limes for later use).",
      "secondary_message": null
    },
    {
      "id": 525531,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger-jalapeño mixture, chili-garlic sauce, sugar, and spices. Cook, stirring frequently until fragrant, about 3 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n1 tbsp cumin, ground\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 525532,
      "primary_message": "Add broth and coconut milk to the pot, stir to combine, and bring to a simmer. Once simmering, reduce heat to low, and continue to cook, stirring occasionally, until slightly thickened, 5-6 minutes more.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ (13.5 fl oz) cans coconut milk"
    },
    {
      "id": 525533,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems, then pick basil leaves off the stems. Discard stems and mince the leaves. Add herbs to the pot (reserving a small handful of each for serving), then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 525534,
      "primary_message": "Using a hand blender, purée the curry until smooth. (If using a regular blender, work in batches as needed, then return curry to the pot.)",
      "secondary_message": null
    },
    {
      "id": 525535,
      "primary_message": "Slice pork chops crosswise into thin strips. Add to the pot with the curry, and continue to cook, stirring occasionally, until pork is cooked through, 7-8 minutes more.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 525536,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop cashews. Set aside.",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 525537,
      "primary_message": "When the pork is done, add the zucchini noodles to the pot. Gently toss the noodles to coat with the curry, and continue to cook, until zucchini noodles are soft, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 525538,
      "primary_message": "Juice reserved limes into the pot, then add fish sauce and stir to combine. Remove from heat.",
      "secondary_message": "2 tbsp fish sauce"
    },
    {
      "id": 525539,
      "primary_message": "To serve, divide pork green curry and zucchini noodles between bowls. Top with reserved herbs and cashews. Enjoy!",
      "secondary_message": null
    }
  ],
