  "instructions": [
    {
      "id": 525774,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 (2 ½ cm) piece ginger root\n1 jalapeño pepper\n½ lime\n½ small bunch cilantro\n½ small pkg fresh basil"
    },
    {
      "id": 525775,
      "primary_message": "Trim zucchini, then run a vegetable peeler along the length of the zucchini to make ribbons. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 525776,
      "primary_message": "Peel and mince ginger, shallot, and garlic. Place all three in a small bowl.",
      "secondary_message": "½ shallot\n2 cloves garlic"
    },
    {
      "id": 525777,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level, then small dice. Add to the bowl with the ginger, shallot, and garlic. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 525778,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 525779,
      "primary_message": "While the pot heats up, zest lime into the small bowl. (Reserve lime for later use).",
      "secondary_message": null
    },
    {
      "id": 525780,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger-jalapeño mixture, chili-garlic sauce, sugar, and spices. Cook, stirring frequently until fragrant, about 2 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil\n1 tsp chili-garlic sauce\n1 tsp brown sugar\n1 tsp cumin, ground\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 525781,
      "primary_message": "Add broth and coconut milk to the pot, stir to combine, and bring to a simmer. Once simmering, reduce heat to low, and continue to cook, stirring occasionally, until slightly thickened, 3-4 minutes more.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ (398 ml) can coconut milk"
    },
    {
      "id": 525782,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems, then pick basil leaves off the stems. Discard stems and mince the leaves. Add herbs to the pot (reserving a small handful of each for serving), then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 525783,
      "primary_message": "Using a hand blender, purée the curry until smooth. (If using a regular blender, work in batches as needed, then return curry to the pot.)",
      "secondary_message": null
    },
    {
      "id": 525784,
      "primary_message": "Slice pork chops crosswise into thin strips. Add to the pot with the curry, and continue to cook, stirring occasionally, until pork is cooked through, 5-6 minutes more.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 525785,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop cashews. Set aside.",
      "secondary_message": "⅛ cup cashews, roasted unsalted"
    },
    {
      "id": 525786,
      "primary_message": "When the pork is done, add the zucchini noodles to the pot. Gently toss the noodles to coat with the curry, and continue to cook, until zucchini noodles are soft, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 525787,
      "primary_message": "Juice reserved lime into the pot, then add fish sauce and stir to combine. Remove from heat.",
      "secondary_message": "2 tsp fish sauce"
    },
    {
      "id": 525788,
      "primary_message": "To serve, divide pork green curry and zucchini noodles between bowls. Top with reserved herbs and cashews. Enjoy!",
      "secondary_message": null
    }
  ],
