  "instructions": [
    {
      "id": 198063,
      "primary_message": "Preheat the oven to 230°C (450°F) and place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 198064,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 acorn squash\n3 Gala apples"
    },
    {
      "id": 198065,
      "primary_message": "Cut squash in half lengthwise. Scoop out seeds; discard. Slice a small piece off the bottom of each squash half just enough so that they will sit level.",
      "secondary_message": null
    },
    {
      "id": 198066,
      "primary_message": "Drizzle cut-side with olive oil and season with salt and pepper. Flip squash halves, scooped sides down, on a baking sheet pan. Bake until golden and fork-tender, 30-35 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 198067,
      "primary_message": "Meanwhile, heat a nonstick skillet to medium-high heat. Chop bacon into ¼-inch pieces and cook until almost crispy. Drain most of the fat. ",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 198068,
      "primary_message": "Peel and dice onions. Add to pan, stirring to combine. Sprinkle with thyme and sage. Cook together until onion is soft and caramelized.",
      "secondary_message": "1 ½ medium yellow onions\n1 tbsp sage\n⅜ tsp thyme"
    },
    {
      "id": 198069,
      "primary_message": "Core, peel, and medium dice the apples. Add to pan, drizzle with maple syrup and salt. Cook 2-3 minutes until apple just starts to soften.",
      "secondary_message": "3 tbsp pure maple syrup\n3 pinch salt"
    },
    {
      "id": 198070,
      "primary_message": "Add pine nuts and cook for 1 minute.",
      "secondary_message": "1 cup pine nuts"
    },
    {
      "id": 198071,
      "primary_message": "Remove the squash from the oven. Stuff each half with the bacon mixture. ",
      "secondary_message": null
    },
    {
      "id": 198072,
      "primary_message": "To serve, divide squash halves between plates. Enjoy!",
      "secondary_message": null
    }
  ],
