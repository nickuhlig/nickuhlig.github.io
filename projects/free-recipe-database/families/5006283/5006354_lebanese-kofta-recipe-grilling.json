  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Wash and coarsely chop the parsley. Coarsely chop the red onion.",
      "secondary_message": "1 bunch parsley\n1 large red onion"
    },
    {
      "id": 1,
      "primary_message": "Soak bamboo skewers in water for at least 30 minutes prior to use.\nPulse onion and parsley in a food processor until finely chopped. Transfer to a large bowl and add the ground lamb, cinnamon, cloves, nutmeg, salt, and pepper and mix with your hands until thoroughly combined.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Form lamb mixture into 1 1/2\" meat balls. Thread one meatball on a skewer, then form meat into a log shape around the skewer. Repeat until all lamb is used.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly over the charcoal grate. Clean and oil your grilling grate.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Grill skewers over high heat until browned on all sides and cooked through, about 2 minutes per side. Remove from the grill and serve.",
      "secondary_message": null
    }
  ],
