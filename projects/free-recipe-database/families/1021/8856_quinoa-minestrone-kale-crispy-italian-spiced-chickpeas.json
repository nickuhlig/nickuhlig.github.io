  "instructions": [
    {
      "id": 144266,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 144267,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry; transfer to a medium bowl. Add oil and spices to the bowl and toss to combine. ",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 144268,
      "primary_message": "Transfer chickpeas to a large baking sheet and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until crispy, about 20 minutes. Reserve bowl for later use.",
      "secondary_message": null
    },
    {
      "id": 144269,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n4 medium carrots\n4 sticks celery\n1 bunch kale\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 144270,
      "primary_message": "Trim off the root ends and the dark green top of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch half-moons; transfer to the medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 144271,
      "primary_message": "Peel, trim, and slice carrots into ¼-inch rounds. Trim celery and slice crosswise into ¼-inch pieces. Transfer both to the bowl with the leeks. ",
      "secondary_message": null
    },
    {
      "id": 144272,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 144273,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leeks, carrots, celery, and spices to the pot; cook, stirring occasionally, until vegetables begin to soften slightly, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 144274,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 144275,
      "primary_message": "Add garlic, broth, tomatoes, and quinoa to the pot and stir to combine; increase the heat to high and bring the liquid to a simmer. Once simmering, reduce the heat to medium-low, cover the pot with a lid, and cook for 7 minutes.",
      "secondary_message": "1893 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n1 cup quinoa"
    },
    {
      "id": 144276,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces. Add kale to the pot and cook until kale is soft and quinoa is cooked through, about 7 more minutes. ",
      "secondary_message": null
    },
    {
      "id": 144277,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 144278,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 144279,
      "primary_message": "To serve, divide the soup between bowls. Top each bowl with a pile of crispy chickpeas; garnish with parsley, Parmesan, and crushed red pepper. Enjoy!",
      "secondary_message": "1 tsp crushed red pepper"
    }
  ],
