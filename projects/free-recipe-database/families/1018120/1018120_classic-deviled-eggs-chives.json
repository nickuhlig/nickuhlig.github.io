  "instructions": [
    {
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and chop chives into small pieces. Place in a small bowl and set aside.",
      "secondary_message": "½ small pkg chives"
    },
    {
      "primary_message": "When the eggs are cool enough to handle, peel and halve lengthwise.",
      "secondary_message": null
    },
    {
      "primary_message": "Scoop out the egg yolks and place in another small bowl along with mayo, Dijon, salt, and pepper. Using a fork, mash to combine, creating a smooth paste.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Spoon the yolk mixture back into the eggs, then sprinkle with chives and paprika.",
      "secondary_message": "¼ tsp paprika"
    },
    {
      "primary_message": "Arrange eggs on a serving platter and enjoy!",
      "secondary_message": null
    }
  ],
