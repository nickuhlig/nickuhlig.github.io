  "instructions": [
    {
      "id": 477470,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, about 8 minutes. Drain and rinse under cold water to cool, then set aside to drain further.",
      "secondary_message": "1 ½ tsp salt\n255 g orzo pasta"
    },
    {
      "id": 477471,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n¼ cup extra virgin olive oil\n¼ cup balsamic vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 477472,
      "primary_message": "Roughly chop sun-dried tomatoes and olives. Add both to the bowl with the dressing.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed\n¾ cup Kalamata olives, pitted"
    },
    {
      "id": 477473,
      "primary_message": "Drain and roughly chop artichokes. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 477474,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477475,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 477476,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 477477,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 yellow bell peppers\n1 small pkg fresh basil\n3 (142 g) pkgs baby spinach"
    },
    {
      "id": 477478,
      "primary_message": "Using a clean cutting board, trim, seed, and medium dice bell peppers. Add to the bowl with the dressing and marinated veggies.",
      "secondary_message": null
    },
    {
      "id": 477479,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477480,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl, along with the orzo and spinach, then toss to combine the salad.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 477481,
      "primary_message": "Slice chicken into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 477482,
      "primary_message": "To serve, divide salad between plates or bowls. Top with chicken and enjoy!",
      "secondary_message": null
    }
  ],
