  "instructions": [
    {
      "id": 477420,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, about 8 minutes. Drain and rinse under cold water to cool, then set aside to drain further.",
      "secondary_message": "1 tsp salt\n6 oz orzo pasta"
    },
    {
      "id": 477421,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 477422,
      "primary_message": "Roughly chop sun-dried tomatoes and olives. Add both to the bowl with the dressing.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n½ cup Kalamata olives, pitted"
    },
    {
      "id": 477423,
      "primary_message": "Drain and roughly chop artichokes. Add to the bowl, stir to combine, and set aside. ",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 477424,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477425,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into thin strips and place in a medium bowl. Add soy sauce and pepper, then stir to coat.",
      "secondary_message": "2 (8 oz) packages tempeh\n4 tsp soy sauce\n¼ tsp black pepper"
    },
    {
      "id": 477426,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh and pan-fry, stirring occasionally, until golden brown and crispy, 5-7 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 477427,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 yellow bell peppers\n1 small pkg fresh basil\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 477428,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the dressing and marinated veggies.",
      "secondary_message": null
    },
    {
      "id": 477429,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477430,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl, along with the orzo and spinach, then toss to combine the salad.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 477431,
      "primary_message": "To serve, divide salad between plates or bowls. Top with tempeh and enjoy!",
      "secondary_message": null
    }
  ],
