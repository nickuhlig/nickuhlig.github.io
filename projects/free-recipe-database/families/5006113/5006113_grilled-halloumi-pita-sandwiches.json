  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the Halloumi cheese 1/4 inch thick. Slice the plum tomatoes crosswise 1/4 inch thick. Thinly slice the red onion. Rinse and dry the red leaf lettuce.",
      "secondary_message": "1 lb Halloumi cheese\n2 plum tomatoes\n1 small red onion\n1 small head red leaf lettuce"
    },
    {
      "id": 1,
      "primary_message": "Light one chimney full of charcoal. When all charcoal is lit and covered with gray ash, pour out and spread the coals evenly over entire surface of coal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Place pita on grill and cook until warm and pliable, about 30 seconds per side. Remove pita from grill.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Grill cheese until well browned on both sides, 1-2 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer cheese to warmed pita and top with tomato slices, red onion, lettuce, and tzatziki. Serve immediately.",
      "secondary_message": null
    }
  ],
