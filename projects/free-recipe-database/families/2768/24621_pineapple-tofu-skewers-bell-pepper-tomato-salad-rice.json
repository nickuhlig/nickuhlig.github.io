  "instructions": [
    {
      "id": 397805,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 397806,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 397807,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 397808,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pineapples\n1 small bunch cilantro\n3 limes\n3 orange bell peppers\n3 tomatoes"
    },
    {
      "id": 397809,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 397810,
      "primary_message": "While the rice is cooking, cut off skin from each pineapple; quarter, core, and large dice the flesh. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 397811,
      "primary_message": "Large dice tofu. Add to the bowl with the pineapple along with oil and spices; stir to coat. ",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 397812,
      "primary_message": "Thread pineapple and tofu onto skewers, alternating ingredients; place on a plate. Alternatively, you can cook the tofu and pineapple pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 397813,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 397814,
      "primary_message": "Once the pan is hot, working in batches, add the skewers and grill, turning occasionally, until pineapple and tofu are golden, 8-10 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 397815,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 397816,
      "primary_message": "Juice half of the limes into the bowl with the cilantro. (Cut remaining limes into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 397817,
      "primary_message": "Peel and mince shallots. Add to the bowl along with oil, maple syrup, and spices. Whisk to combine the dressing. ",
      "secondary_message": "2 shallots\n2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 397818,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 397819,
      "primary_message": "Small dice tomatoes. Add to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 397820,
      "primary_message": "Divide rice, salad, and skewers between plates. Serve with lime wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
