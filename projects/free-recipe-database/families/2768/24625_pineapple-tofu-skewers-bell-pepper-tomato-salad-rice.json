  "instructions": [
    {
      "id": 397866,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 397867,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 397868,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 397869,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small pineapple\n½ small bunch cilantro\n1 lime\n1 orange bell pepper\n1 tomato"
    },
    {
      "id": 397870,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 397871,
      "primary_message": "While the rice is cooking, cut off skin from pineapple; quarter, core, and large dice the flesh. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 397872,
      "primary_message": "Large dice tofu. Add to the bowl with the pineapple along with oil and spices; stir to coat. ",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 397873,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 397874,
      "primary_message": "While the pan heats up, thread pineapple and tofu onto skewers, alternating ingredients; place on a plate. Alternatively, you can cook the tofu and pineapple pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 397875,
      "primary_message": "Once the pan is hot, add the skewers and grill, turning occasionally, until pineapple and tofu are golden, 8-10 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 397876,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 397877,
      "primary_message": "Juice half of the lime into the bowl with the cilantro. (Cut remaining lime into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 397878,
      "primary_message": "Peel and mince shallot. Add to the bowl along with oil, maple syrup, and spices. Whisk to combine the dressing. ",
      "secondary_message": "½ shallot\n2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n¼ tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 397879,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 397880,
      "primary_message": "Small dice tomato. Add to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 397881,
      "primary_message": "Divide rice, salad, and skewers between plates. Serve with lime wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
