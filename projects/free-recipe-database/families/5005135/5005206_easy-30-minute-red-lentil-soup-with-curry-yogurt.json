  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and roughly chop the carrot. Roughly chop the celery. Roughly chop the scallions. Split the garlic in half. Peel and roughly chop the ginger. Roughly chop the jalapeño chile.",
      "secondary_message": "1 small carrot\n1 stalk celery\n6 scallions, white parts only\n2 cloves garlic\n1 (2 ½ cm) knob ginger\n1 jalapeño chile"
    },
    {
      "id": 1,
      "primary_message": "Combine carrots, celery, scallions, garlic, ginger, and chile in the bowl of a food processor. Pulse until very finely chopped, about 15 short pulses, scraping down bowl as necessary.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat 2 tablespoons olive oil in a large saucepan over medium-high heat until shimmering. Add chopped vegetables and cook, stirring frequently, until softened and aromatic but not browned, about 4 minutes. Add lentils, chicken stock, and bay leaves. Simmer, stirring occasionally until lentils are fully tender, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While lentils cook, combine yogurt, cilantro, and curry powder in a small bowl and whisk to combine. Season to taste with salt and pepper. Transfer to a small serving bowl.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When lentils are cooked, remove and discard bay leaves. Working in two batches, purée soup in a blender, drizzling in remaining extra virgin olive oil while blender runs. Return soup to a pot, whisk in lemon juice, thin to desired consistency with water or stock, season to taste with salt and pepper, and serve immediately, passing the curry yogurt and extra-virgin olive oil on the side.",
      "secondary_message": null
    }
  ],
