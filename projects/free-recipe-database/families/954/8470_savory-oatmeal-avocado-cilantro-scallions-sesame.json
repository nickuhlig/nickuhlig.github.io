  "instructions": [
    {
      "id": 129452,
      "primary_message": "Add salt and broth to a small saucepan, cover, and bring to a boil over high heat. Once boiling, stir in oats and reduce heat to medium-low. Cover and let simmer for 3-5 minutes or until oats reach desired consistency. ",
      "secondary_message": "1 pinch salt\n473 ml chicken or vegetable broth\n1 cup oats, quick cooking"
    },
    {
      "id": 129453,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n¼ small bunch cilantro\n1 avocado"
    },
    {
      "id": 129454,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 129455,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 129456,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out. ",
      "secondary_message": null
    },
    {
      "id": 129457,
      "primary_message": "To serve, divide the oatmeal between bowls and top with avocado, green onions, and cilantro. Garnish with sesame oil, sesame seeds, salt, and pepper. Enjoy! ",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp sesame seeds\n1 pinch salt\n1 pinch black pepper"
    }
  ],
