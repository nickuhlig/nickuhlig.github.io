  "instructions": [
    {
      "id": 129422,
      "primary_message": "Add salt and broth to a medium saucepan, cover, and bring to a boil over high heat. Once boiling, stir in oats and reduce heat to medium-low. Cover and let simmer for 3-5 minutes or until oats reach desired consistency. ",
      "secondary_message": "3 pinch salt\n48 fl oz (6 cups) chicken or vegetable broth\n3 cup oats, quick cooking"
    },
    {
      "id": 129423,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 small bunch cilantro\n3 avocados"
    },
    {
      "id": 129424,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 129425,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 129426,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out. ",
      "secondary_message": null
    },
    {
      "id": 129427,
      "primary_message": "To serve, divide the oatmeal between bowls and top with avocado, green onions, and cilantro. Garnish with sesame oil, sesame seeds, salt, and pepper. Enjoy! ",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp sesame seeds\n3 pinch salt\n3 pinch black pepper"
    }
  ],
