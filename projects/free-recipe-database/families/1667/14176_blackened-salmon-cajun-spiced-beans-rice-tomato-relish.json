  "instructions": [
    {
      "id": 235436,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 235437,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 235438,
      "primary_message": "Meanwhile, place spices in a small bowl and stir to combine the spice mix. ",
      "secondary_message": "½ tsp onion powder\n½ tsp garlic powder\n½ tsp paprika\n½ tsp salt\n¼ tsp thyme, dried\n¼ tsp oregano, dried\n⅛ tsp cayenne pepper"
    },
    {
      "id": 235439,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 235440,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place on a plate; season salmon with half of the spice mix on both sides. (Reserve remaining spice mix for the beans.)",
      "secondary_message": "⅓ kg salmon fillet"
    },
    {
      "id": 235441,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place the salmon, skin-side-down, in the skillet; cook until the flesh is opaque and flaky, 3-4 minutes per side (depending on thickness). Once done, transfer to a plate and cover loosely with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 235442,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n1 green bell pepper\n1 tomato"
    },
    {
      "id": 235443,
      "primary_message": "Peel and mince garlic and onion. Place in a medium bowl. ",
      "secondary_message": "2 cloves garlic\n½ medium yellow onion"
    },
    {
      "id": 235444,
      "primary_message": "Trim and small dice celery. Trim, seed, and small dice bell pepper; add both to the bowl with the garlic and onion. ",
      "secondary_message": null
    },
    {
      "id": 235445,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can pinto beans"
    },
    {
      "id": 235446,
      "primary_message": "Return the skillet to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 235447,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies and remaining spice mix; sauté until soft, 6-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 235448,
      "primary_message": "Meanwhile, small dice tomato and transfer to the reserved bowl. Add oil, vinegar, salt, and pepper; stir to combine the relish and set aside.",
      "secondary_message": "¼ tsp extra virgin olive oil\n¼ tsp apple cider vinegar\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 235449,
      "primary_message": "Add water and tomato paste to the skillet, stir to combine, and bring to a simmer. Once simmering, add beans and continue to cook, stirring occasionally, until heated through, 2-3 minutes. ",
      "secondary_message": "½ cup water\n1 tbsp tomato paste"
    },
    {
      "id": 235450,
      "primary_message": "To serve, divide rice and beans between plates; top with blackened salmon and tomato relish. Enjoy! ",
      "secondary_message": null
    }
  ],
