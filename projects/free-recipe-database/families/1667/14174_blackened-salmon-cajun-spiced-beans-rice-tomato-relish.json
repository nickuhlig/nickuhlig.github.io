  "instructions": [
    {
      "id": 235406,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 235407,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 235408,
      "primary_message": "Meanwhile, place spices in a small bowl and stir to combine the spice mix. ",
      "secondary_message": "1 tsp onion powder\n1 tsp garlic powder\n1 tsp paprika\n1 tsp salt\n½ tsp thyme, dried\n½ tsp oregano, dried\n¼ tsp cayenne pepper"
    },
    {
      "id": 235409,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 235410,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place on a plate; season salmon with half of the spice mix on both sides. (Reserve remaining spice mix for the beans.)",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "id": 235411,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place the salmon, skin-side-down, in the skillet; cook until the flesh is opaque and flaky, 3-4 minutes per side (depending on thickness). Once done, transfer to a plate and cover loosely with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 235412,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n2 green bell peppers\n2 tomatoes"
    },
    {
      "id": 235413,
      "primary_message": "Peel and mince garlic and onion. Place in a medium bowl. ",
      "secondary_message": "4 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 235414,
      "primary_message": "Trim and small dice celery. Trim, seed, and small dice bell peppers; add both to the bowl with the garlic and onion. ",
      "secondary_message": null
    },
    {
      "id": 235415,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "id": 235416,
      "primary_message": "Return the skillet to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 235417,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies and remaining spice mix; sauté until soft, 6-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 235418,
      "primary_message": "Meanwhile, small dice tomatoes and transfer to the reserved bowl. Add oil, vinegar, salt, and pepper; stir to combine the relish and set aside.",
      "secondary_message": "½ tsp extra virgin olive oil\n½ tsp apple cider vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 235419,
      "primary_message": "Add water and tomato paste to the skillet, stir to combine, and bring to a simmer. Once simmering, add beans and continue to cook, stirring occasionally, until heated through, 2-3 minutes. ",
      "secondary_message": "1 cup water\n2 tbsp tomato paste"
    },
    {
      "id": 235420,
      "primary_message": "To serve, divide rice and beans between plates; top with blackened salmon and tomato relish. Enjoy! ",
      "secondary_message": null
    }
  ],
