  "instructions": [
    {
      "id": 545091,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 545092,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n1 small bunch cilantro"
    },
    {
      "id": 545093,
      "primary_message": "Peel, trim, and small dice carrots. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 545094,
      "primary_message": "Trim and small dice celery. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 545095,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 545096,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 545097,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices; cook, stirring occasionally, until tender, 7-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper\n½ tsp cumin, ground"
    },
    {
      "id": 545098,
      "primary_message": "Meanwhile, place cornstarch, soy sauce, maple syrup, smoked paprika, and salt in the reserved bowl. Whisk to combine the marinade.",
      "secondary_message": "3 tbsp cornstarch\n2 tbsp soy sauce\n1 tbsp pure maple syrup\n1 tbsp smoked paprika\n¾ tsp salt"
    },
    {
      "id": 545099,
      "primary_message": "Large dice tofu. Add to bowl with marinade and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 545100,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 545101,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu (leaving any excess marinade in the bowl) and pan-fry, turning occasionally, until browned and crispy, 7-8 minutes. Wipe bowl clean with paper towels, then return cooked tofu to the bowl.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 545102,
      "primary_message": "While the tofu is cooking, add broth and peas to the pot with the veggies; stir to combine the soup and bring to a simmer. Once simmering, reduce heat to medium and continue to cook, stirring occasionally, until veggies are very tender, 6-7 minutes.",
      "secondary_message": "4 ½ cups frozen peas\n72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 545103,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 545104,
      "primary_message": "When the soup is done, use a potato masher to crush the veggies. Alternatively, use a blender if you prefer a smoother soup. Add cilantro (reserving a small handful for serving), cream, and soy sauce, then stir to combine. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n3 tbsp soy sauce"
    },
    {
      "id": 545105,
      "primary_message": "To serve, divide soup between bowls; top with the smoky tofu and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
