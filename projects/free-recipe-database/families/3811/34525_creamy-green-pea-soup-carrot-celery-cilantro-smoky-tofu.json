  "instructions": [
    {
      "id": 545061,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 545062,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n½ small bunch cilantro"
    },
    {
      "id": 545063,
      "primary_message": "Peel, trim, and small dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 545064,
      "primary_message": "Trim and small dice celery. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 545065,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 545066,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 545067,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices; cook, stirring occasionally, until tender, 5-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cumin, ground"
    },
    {
      "id": 545068,
      "primary_message": "Meanwhile, place cornstarch, soy sauce, maple syrup, smoked paprika, and salt in the reserved bowl. Whisk to combine the marinade.",
      "secondary_message": "1 tbsp cornstarch\n2 tsp soy sauce\n1 tsp pure maple syrup\n1 tsp smoked paprika\n¼ tsp salt"
    },
    {
      "id": 545069,
      "primary_message": "Large dice tofu. Add to bowl with marinade and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 545070,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 545071,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu (leaving any excess marinade in the bowl) and pan-fry, turning occasionally, until browned and crispy, 7-8 minutes. Wipe bowl clean with paper towels, then return cooked tofu to the bowl.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 545072,
      "primary_message": "While the tofu is cooking, add broth and peas to the pan with the veggies; stir to combine the soup and bring to a simmer. Once simmering, reduce heat to medium and continue to cook, stirring occasionally, until veggies are very tender, about 5 minutes.",
      "secondary_message": "1 ½ cups frozen peas\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 545073,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 545074,
      "primary_message": "When the soup is done, use a potato masher to crush the veggies. Alternatively, use a blender if you prefer a smoother soup. Add cilantro (reserving a small handful for serving), cream, and soy sauce, then stir to combine. Remove from heat.",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream\n1 tbsp soy sauce"
    },
    {
      "id": 545075,
      "primary_message": "To serve, divide soup between bowls; top with the smoky tofu and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
