  "instructions": [
    {
      "id": 605839,
      "primary_message": "This recipe will make about 9 cups of smoothie. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 605840,
      "primary_message": "Wash, dry, and quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Roughly chop the flesh and place in a blender. ",
      "secondary_message": "6 peaches"
    },
    {
      "id": 605841,
      "primary_message": "Add yogurt, milk, almond butter, honey, vanilla, and cardamom to the blender, then blend on high speed until smooth, 1-2 minutes.",
      "secondary_message": "3 cups plain Greek yogurt\n9 fl oz (1 ⅛ cups) whole milk\n3 tbsp natural almond butter\n3 tbsp honey\n¾ tsp vanilla extract\n½ tsp cardamom, ground"
    },
    {
      "id": 605842,
      "primary_message": "Meanwhile, wash and dry raspberries.",
      "secondary_message": "3 (6 oz) pkgs raspberries"
    },
    {
      "id": 605843,
      "primary_message": "To serve, divide smoothie between bowls, then top with granola and raspberries. Enjoy!",
      "secondary_message": "2 cup granola"
    }
  ],
