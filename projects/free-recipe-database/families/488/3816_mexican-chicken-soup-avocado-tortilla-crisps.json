  "instructions": [
    {
      "id": 42154,
      "primary_message": "Preheat the oven to 450°F (232°C) and place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 42155,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 avocados\n2 limes\n1 small bunch cilantro"
    },
    {
      "id": 42156,
      "primary_message": "Juice the limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 42157,
      "primary_message": "Stack the tortillas; cut in half, then cut crosswise into 1 ¼-cm-wide strips and transfer to a baking sheet.",
      "secondary_message": "4 small corn tortillas"
    },
    {
      "id": 42158,
      "primary_message": "Drizzle the tortilla strips with olive oil and season with salt; toss to coat then spread out in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 42159,
      "primary_message": "Place the tortilla strips in the oven and bake until golden brown and crispy, 6 to 8 minutes. Once done, remove from the oven and transfer to a paper towel lined plate.",
      "secondary_message": null
    },
    {
      "id": 42160,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 42161,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels; holding a knife parallel to the cutting board, halve the breasts horizontally to form thin fillets. Season the chicken with salt and pepper on both sides.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 42162,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 42163,
      "primary_message": "Add the chicken to the skillet; cook until golden brown and cooked through, 3 to 4 minutes per side. Once done, transfer to a plate to cool. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 42164,
      "primary_message": "While the chicken cooks, preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 42165,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces).",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 42166,
      "primary_message": "Once the saucepan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 42167,
      "primary_message": "Add the onion to the saucepan; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 42168,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 42169,
      "primary_message": "Add the garlic, cumin, salt, and pepper to the onion; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "1 tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42170,
      "primary_message": "Add the broth, tomatoes, and lime juice to the saucepan. Bring the mixture to a boil, then reduce the heat to a simmer and cook for 8 to 10 minutes.",
      "secondary_message": "946 ml (4 cups) chicken or vegetable broth\n2 (398 ml) cans diced tomaotes"
    },
    {
      "id": 42171,
      "primary_message": "Using two forks, shred the chicken into bite-sized pieces and add to the soup immediately.",
      "secondary_message": null
    },
    {
      "id": 42172,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and medium dice the flesh. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 42173,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Stir the cilantro into the soup.",
      "secondary_message": null
    },
    {
      "id": 42174,
      "primary_message": "To serve, divide the soup between bowls, then top with the avocado and tortilla crisps. Enjoy!",
      "secondary_message": null
    }
  ],
