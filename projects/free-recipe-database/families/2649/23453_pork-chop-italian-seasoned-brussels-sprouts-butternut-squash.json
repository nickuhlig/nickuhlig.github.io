  "instructions": [
    {
      "id": 384711,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 384712,
      "primary_message": "Wash, dry, trim, and halve Brussels sprouts lengthwise. Transfer to a large baking sheet pan along with the butternut squash. Drizzle veggies with dressing and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "0.68 kg Brussels sprouts\n4 cup frozen butternut squash, pieces\n¼ cup Italian salad dressing\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 384713,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 384714,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384715,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, bone-in\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 384716,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 384717,
      "primary_message": "To serve, divide veggies and chops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
