  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and slice the ginger.",
      "secondary_message": "1 (2 ½ cm) knob fresh ginger"
    },
    {
      "id": 1,
      "primary_message": "In a large zipper-lock bag, combine beer, oil, lemongrass, lemon zest, ginger, coriander seed, thyme, and salt. Swish until salt is dissolved.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add steak to bag, press out air, and seal. Refrigerate for at least 1 hour and up to 12 hours. When ready to cook, remove steak from marinade, blot dry with paper towels, and grill as desired.",
      "secondary_message": null
    }
  ],
