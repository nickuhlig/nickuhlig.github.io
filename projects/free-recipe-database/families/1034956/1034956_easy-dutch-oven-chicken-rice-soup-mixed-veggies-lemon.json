  "instructions": [
    {
      "primary_message": "Preheat a Dutch oven over medium-high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the Dutch oven heats up, pat chicken dry with paper towels and cut into bite-sized pieces.\n\n",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "primary_message": "Once the Dutch oven is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper; cook, stirring occasionally, until browned, 3-4 minutes (the chicken will not be cooked all the way through).\n\n",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water.\n\n",
      "secondary_message": "¾ cup basmati rice"
    },
    {
      "primary_message": "When the chicken is done, add garlic to the Dutch oven; continue to cook, while stirring, until fragrant, about 1 minute. Add rice, broth, veggies, and spices, then stir to combine the soup. Bring to a boil over high heat. \n\n",
      "secondary_message": "1 tbsp minced garlic\n7 cups chicken or vegetable broth\n3 cups frozen mixed vegetables (carrots, corn, green beans, peas)\n1 ½ tsp Italian seasoning\n¾ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Once the soup is boiling, reduce heat to medium-low, cover, and simmer until the chicken is cooked through and rice is tender, about 12 minutes. Remove from heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the soup is done, wash and dry the parsley. Using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Add to the Dutch oven.\n\n",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "Wash, dry, and juice lemon into the Dutch oven, then stir to combine the soup.\n\n",
      "secondary_message": "1 lemon"
    },
    {
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
