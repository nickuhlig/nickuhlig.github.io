  "instructions": [
    {
      "id": 631523,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 ½ lemons\n3 mangoes\n1 ½ jalapeño peppers\n6 red bell peppers\n1 small pkg fresh mint"
    },
    {
      "id": 631524,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between two large bowls. (Set one bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 631525,
      "primary_message": "Add cottage cheese, eggs, flour, bread crumbs, and spices to the remaining bowl with the cilantro. Stir to combine the batter. ",
      "secondary_message": "3 cups cottage cheese\n6 eggs\n1 ½ cup all-purpose flour\n¾ cup panko bread crumbs\n1 tbsp curry powder\n1 ½ tsp garam masala\n¾ tsp salt"
    },
    {
      "id": 631526,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 631527,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 631528,
      "primary_message": "Meanwhile, juice lemons into a small bowl. Pour half of the juice into the large bowl for the salad. (Set the small bowl aside for the raita.)",
      "secondary_message": null
    },
    {
      "id": 631529,
      "primary_message": "Add oil, salt, and pepper to the bowl with the cilantro and lemon juice. Stir to combine the salad dressing.",
      "secondary_message": "2 tbsp neutral vegetable oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 631530,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; roughly chop the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 631531,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level, then small dice. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 631532,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 631533,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the small bowl with the lemon juice along with yogurt and spices. Stir to combine the raita.",
      "secondary_message": "2 cups plain Greek yogurt\n¾ tsp cumin, ground\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 631534,
      "primary_message": "Divide fritters and salad between plates. Serve with raita and enjoy!",
      "secondary_message": null
    }
  ],
