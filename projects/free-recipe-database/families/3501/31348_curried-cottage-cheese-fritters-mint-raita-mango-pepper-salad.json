  "instructions": [
    {
      "id": 631499,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch cilantro\n½ lemon\n1 mango\n½ jalapeño pepper\n2 red bell peppers\n½ small pkg fresh mint"
    },
    {
      "id": 631500,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between two medium bowls. (Set one bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 631501,
      "primary_message": "Add cottage cheese, eggs, flour, bread crumbs, and spices to the remaining bowl with the cilantro. Stir to combine the batter. ",
      "secondary_message": "1 cup cottage cheese\n2 eggs\n½ cup all-purpose flour\n¼ cup panko bread crumbs\n1 tsp curry powder\n½ tsp garam masala\n¼ tsp salt"
    },
    {
      "id": 631502,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 631503,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 631504,
      "primary_message": "Meanwhile, juice lemon into a small bowl. Pour half of the juice into the medium bowl for the salad. (Set the small bowl aside for the raita.)",
      "secondary_message": null
    },
    {
      "id": 631505,
      "primary_message": "Add oil, salt, and pepper to the bowl with the cilantro and lemon juice. Stir to combine the salad dressing.",
      "secondary_message": "2 tsp neutral vegetable oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 631506,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 631507,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level, then small dice. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 631508,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 631509,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the small bowl with the lemon juice along with yogurt and spices. Stir to combine the raita.",
      "secondary_message": "⅔ cup plain Greek yogurt\n¼ tsp cumin, ground\n¼ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 631510,
      "primary_message": "Divide fritters and salad between plates. Serve with raita and enjoy!",
      "secondary_message": null
    }
  ],
