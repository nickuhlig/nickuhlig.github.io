  "instructions": [
    {
      "id": 157260,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ avocados\n1 ½ tomatoes"
    },
    {
      "id": 157261,
      "primary_message": "Halve tomatoes and thinly slice into half rounds; set aside.",
      "secondary_message": null
    },
    {
      "id": 157262,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Set aside.",
      "secondary_message": null
    },
    {
      "id": 157263,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157264,
      "primary_message": "Pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 157265,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 157266,
      "primary_message": "Return skillet to medium-high, add more oil and swirl to coat the bottom. ",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 157267,
      "primary_message": "Working in batches if necessary, gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes.",
      "secondary_message": "6 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 157268,
      "primary_message": "Meanwhile, toast bread and slice in half on the diagonal.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 157269,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 157270,
      "primary_message": "To serve, divide steak, eggs, and toast between plates. Garnish with tomato and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
