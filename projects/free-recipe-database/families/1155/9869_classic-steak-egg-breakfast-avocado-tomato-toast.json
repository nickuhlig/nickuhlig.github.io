  "instructions": [
    {
      "id": 157238,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ avocado\n½ tomato"
    },
    {
      "id": 157239,
      "primary_message": "Thinly slice tomato into half rounds; set aside.",
      "secondary_message": null
    },
    {
      "id": 157240,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Set aside.",
      "secondary_message": null
    },
    {
      "id": 157241,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157242,
      "primary_message": "Pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.23 kg striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 157243,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 157244,
      "primary_message": "Return skillet to medium-high, add more oil and swirl to coat the bottom. ",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 157245,
      "primary_message": "Gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes.",
      "secondary_message": "2 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 157246,
      "primary_message": "Meanwhile, toast bread and slice in half on the diagonal.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 157247,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 157248,
      "primary_message": "To serve, divide steak, eggs, and toast between plates. Garnish with tomato and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
