  "instructions": [
    {
      "id": 157281,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 avocado\n1 tomato"
    },
    {
      "id": 157282,
      "primary_message": "Halve and thinly slice tomato into half rounds; set aside.",
      "secondary_message": null
    },
    {
      "id": 157283,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon; set aside.",
      "secondary_message": null
    },
    {
      "id": 157284,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157285,
      "primary_message": "Pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 157286,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 157287,
      "primary_message": "Return skillet to medium-high, add more oil and swirl to coat the bottom. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 157288,
      "primary_message": "Working in batches if necessary, gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes.",
      "secondary_message": "8 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 157289,
      "primary_message": "Meanwhile, thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 157290,
      "primary_message": "To serve, divide steak and eggs between plates. Garnish with tomato and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
