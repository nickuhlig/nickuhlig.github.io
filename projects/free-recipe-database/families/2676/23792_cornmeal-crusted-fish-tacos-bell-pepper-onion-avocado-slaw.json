  "instructions": [
    {
      "id": 387958,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 387959,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 orange bell peppers\n2 limes\n1 avocado"
    },
    {
      "id": 387960,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick pieces. Transfer to a large baking sheet pan. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 387961,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Add to the baking sheet with the onion. Drizzle with oil and season with chili powder and salt; stir to coat and spread out in an even layer. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 387962,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until veggies start to soften, 6-8 minutes. ",
      "secondary_message": null
    },
    {
      "id": 387963,
      "primary_message": "Meanwhile, pat cod dry with paper towels. Cut into 1-inch thick fingers and place on a plate. Sprinkle with cornmeal, additional chili powder, and salt on both sides. ",
      "secondary_message": "1 ½ lb cod fillet\n¼ cup polenta (cornmeal)\n2 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 387964,
      "primary_message": "Once the veggies are soft, remove from the oven, stir, and push to one side of the baking sheet. Arrange cod fingers on the other side of the baking sheet, then drizzle with more oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 387965,
      "primary_message": "Return baking sheet to the oven and continue to bake until veggies are fork-tender and cod is cooked through, 8-10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 387966,
      "primary_message": "Meanwhile, using a clean cutting board, juice one lime into a medium bowl. Cut remaining lime into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 387967,
      "primary_message": "Add dressing and additional salt to the bowl with the lime juice; stir to combine. ",
      "secondary_message": "¼ cup ranch dressing\n¼ tsp salt"
    },
    {
      "id": 387968,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the bowl with the dressing, along with the cabbage, and stir to combine the slaw. ",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)"
    },
    {
      "id": 387969,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 387970,
      "primary_message": "Divide tortillas between plates and fill with roasted veggies, fish, and a small portion of slaw. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
