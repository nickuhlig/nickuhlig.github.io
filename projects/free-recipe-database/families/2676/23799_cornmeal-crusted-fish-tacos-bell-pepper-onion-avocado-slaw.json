  "instructions": [
    {
      "id": 388047,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 388048,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 orange bell peppers\n3 limes\n1 ½ avocados"
    },
    {
      "id": 388049,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces. Transfer to a large baking sheet pan. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 388050,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Add to the baking sheet with the onion. Drizzle with oil and season with chili powder and salt; stir to coat and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp chili powder\n¾ tsp salt"
    },
    {
      "id": 388051,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring veggies halfway through, until fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 388052,
      "primary_message": "While the veggies are baking, pat cod dry with paper towels. Cut into 1-inch thick fingers and transfer to another baking sheet. Sprinkle with cornmeal, additional chili powder, and salt on both sides, then drizzle with oil. ",
      "secondary_message": "1.02 kg cod fillet\n⅓ cup polenta (cornmeal)\n1 tbsp chili powder\n¾ tsp salt\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 388053,
      "primary_message": "Add baking sheet to the oven and bake until cod is cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 388054,
      "primary_message": "Meanwhile, using a clean cutting board, juice half of the limes into a medium bowl. Cut remaining limes into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 388055,
      "primary_message": "Add dressing and additional salt to the bowl with the lime juice; stir to combine. ",
      "secondary_message": "⅓ cup ranch dressing\n½ tsp salt"
    },
    {
      "id": 388056,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl with the dressing, along with the cabbage, and stir to combine the slaw. ",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 388057,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 388058,
      "primary_message": "Divide tortillas between plates and fill with roasted veggies, fish, and a small portion of slaw. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
