  "instructions": [
    {
      "id": 1,
      "primary_message": "In a 1-quart container or medium bowl, whisk together oat milk, maple syrup, vanilla paste or extract (if using), and salt until well combined.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add oats and chia seeds and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Refrigerate until oats have softened and thickened, at least 8 hours and up to 24 hours. Sweeten with additional maple syrup as needed and serve with fresh fruit, if desired.",
      "secondary_message": null
    }
