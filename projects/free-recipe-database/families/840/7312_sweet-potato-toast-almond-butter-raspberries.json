  "instructions": [
    {
      "id": 103398,
      "primary_message": "Preheat oven to broil and position the rack in the middle of the oven.",
      "secondary_message": null
    },
    {
      "id": 103399,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg sweet potato\n½ (170 g) pkg raspberries"
    },
    {
      "id": 103400,
      "primary_message": "Trim off and discard ends of sweet potatoes; slice lengthwise into ½-inch thick pieces. Discard the two small, outer slices, then place remaining slices on a baking sheet lined with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 103401,
      "primary_message": "Rub the coconut oil over both sides of the sweet potato slices, then season with salt. (If the oil is solid, warm it slightly with your fingers or in the microwave.)",
      "secondary_message": "1 tsp virgin coconut oil\n⅛ tsp salt"
    },
    {
      "id": 103402,
      "primary_message": "Place sweet potatoes in the oven and broil, flipping halfway through, 8-10 minutes, or until tender. (Keep a close watch on the sweet potatoes to avoid burning.)",
      "secondary_message": null
    },
    {
      "id": 103403,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 103404,
      "primary_message": "When the skillet is hot, add the slivered almonds to the pan; cook, stirring constantly until they are golden brown, 3-5 minutes. Transfer to a small bowl.",
      "secondary_message": "⅛ cup almonds, sliced"
    },
    {
      "id": 103405,
      "primary_message": "To serve, spread a spoonful of almond butter over each slice of sweet potato; top with raspberries, toasted almonds, and a sprinkle of cinnamon. Enjoy!",
      "secondary_message": "¼ cup natural almond butter\n1 pinch cinnamon"
    }
  ],
