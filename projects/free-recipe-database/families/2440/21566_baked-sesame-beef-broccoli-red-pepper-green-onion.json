  "instructions": [
    {
      "id": 363224,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 363225,
      "primary_message": "Wash, dry, trim, and cut green onions in half crosswise. Chop the white and pale green parts into 1-inch pieces and transfer to a large baking sheet pan. Thinly slice the dark green parts and set aside for serving.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 363226,
      "primary_message": "Wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips. Add bell pepper and broccoli to the baking sheet with the green onion.",
      "secondary_message": "2 red bell peppers\n1 (510 g) bag broccoli florets"
    },
    {
      "id": 363227,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch pieces. Add to the baking sheet.",
      "secondary_message": "0.68 kg striploin (New York strip) steak"
    },
    {
      "id": 363228,
      "primary_message": "Drizzle veggies and steak with stir-fry sauce and oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "½ cup stir-fry sauce\n2 tbsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 363229,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and steak is cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363230,
      "primary_message": "To serve, divide steak, veggies, and sauce between plates. Sprinkle with reserved green onions and sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
