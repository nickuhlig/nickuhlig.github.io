  "instructions": [
    {
      "id": 363180,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 363181,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 363182,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 363183,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 363184,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions in half crosswise. Chop the white and pale green parts into 1-inch pieces and divide between two large baking sheets. Thinly slice the dark green parts and set aside for serving.",
      "secondary_message": "2 small bunches green onions (scallions)"
    },
    {
      "id": 363185,
      "primary_message": "Wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips. Add bell pepper and broccoli to the baking sheets with the green onion.",
      "secondary_message": "3 red bell peppers\n1 ½ (18 oz) bags broccoli florets"
    },
    {
      "id": 363186,
      "primary_message": "Medium dice tofu and add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 363187,
      "primary_message": "Drizzle veggies and tofu with stir-fry sauce and oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 ½ cup stir-fry sauce\n2 tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 363188,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and tofu is warmed through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363189,
      "primary_message": "To serve, divide rice, tofu, veggies, and sauce between plates. Sprinkle with reserved green onions and sesame seeds. Enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
