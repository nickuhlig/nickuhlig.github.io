  "instructions": [
    {
      "id": 363231,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 363232,
      "primary_message": "Wash, dry, trim, and cut green onions in half crosswise. Chop the white and pale green parts into 1-inch pieces and divide between two large baking sheet pans. Thinly slice the dark green parts and set aside for serving.",
      "secondary_message": "2 small bunches green onions (scallions)"
    },
    {
      "id": 363233,
      "primary_message": "Wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips. Add bell pepper and broccoli to the baking sheets with the green onion.",
      "secondary_message": "3 red bell peppers\n1 ½ (510 g) bags broccoli florets"
    },
    {
      "id": 363234,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch pieces. Add to the baking sheets.",
      "secondary_message": "1.02 kg striploin (New York strip) steak"
    },
    {
      "id": 363235,
      "primary_message": "Drizzle veggies and steak with stir-fry sauce and oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "¾ cup stir-fry sauce\n3 tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 363236,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and steak is cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363237,
      "primary_message": "To serve, divide steak, veggies, and sauce between plates. Sprinkle with reserved green onions and sesame seeds. Enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
