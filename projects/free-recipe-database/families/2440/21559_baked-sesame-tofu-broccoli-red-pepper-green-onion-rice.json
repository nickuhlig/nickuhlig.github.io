  "instructions": [
    {
      "id": 363160,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 363161,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 363162,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 363163,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 363164,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions in half crosswise. Chop the white and pale green parts into 1-inch pieces and transfer to a baking sheet pan. Thinly slice the dark green parts and set aside for serving.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 363165,
      "primary_message": "Wash, dry, trim, and seed bell pepper; halve crosswise, then slice into thin strips. Add bell pepper and broccoli to the baking sheet with the green onion.",
      "secondary_message": "1 red bell pepper\n½ (18 oz) bag broccoli florets"
    },
    {
      "id": 363166,
      "primary_message": "Medium dice tofu and add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 363167,
      "primary_message": "Drizzle veggies and tofu with stir-fry sauce and oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "½ cup stir-fry sauce\n2 tsp toasted sesame oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 363168,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and tofu is warmed through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363169,
      "primary_message": "To serve, divide rice, tofu, veggies, and sauce between plates. Sprinkle with reserved green onions and sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
