  "instructions": [
    {
      "id": 363130,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 363131,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 363132,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 363133,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions in half crosswise. Chop the white and pale green parts into 1-inch pieces and divide between two large baking sheet pans. Thinly slice the dark green parts and set aside for serving.",
      "secondary_message": "2 small bunches green onions (scallions)"
    },
    {
      "id": 363134,
      "primary_message": "Wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips. Add bell pepper and broccoli to the baking sheets with the green onion.",
      "secondary_message": "3 red bell peppers\n1 ½ (18 oz) bags broccoli florets"
    },
    {
      "id": 363135,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch pieces. Add to the baking sheets.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 363136,
      "primary_message": "Drizzle veggies and steak with stir-fry sauce and oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "¾ cup stir-fry sauce\n2 tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 363137,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and steak is cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363138,
      "primary_message": "To serve, divide rice, steak, veggies, and sauce between plates. Sprinkle with reserved green onions and sesame seeds. Enjoy!",
      "secondary_message": "4 tsp sesame seeds"
    }
  ],
