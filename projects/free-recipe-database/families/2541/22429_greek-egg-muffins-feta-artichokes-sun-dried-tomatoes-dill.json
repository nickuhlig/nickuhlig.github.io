  "instructions": [
    {
      "id": 374141,
      "primary_message": "Preheat oven to 400°F and position a rack in the lower third of the oven. Grease 4 muffin cups with butter; place muffin pan on a baking sheet pan (to catch any overflow during baking) and set aside.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 374142,
      "primary_message": "Wash, dry, and shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": "¼ small bunch fresh dill"
    },
    {
      "id": 374143,
      "primary_message": "Mince sun-dried tomatoes. Drain and roughly chop artichokes. Add both to the bowl with the dill, along with the feta, and stir to combine the filling.",
      "secondary_message": "2 sun-dried tomatoes, oil-packed\n½ (6 oz) jar artichoke hearts, marinated\n½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 374144,
      "primary_message": "Divide filling between muffin cups. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 374145,
      "primary_message": "Crack eggs into the reserved bowl. Add crushed red pepper, then whisk to combine. Pour eggs over the filling.",
      "secondary_message": "4 eggs\n⅛ tsp crushed red pepper"
    },
    {
      "id": 374146,
      "primary_message": "Place muffin pan in the oven and bake, rotating the pan halfway through, until eggs are set, about 15 minutes. Remove from the oven and let cool for 1 minute. Use a silicone spatula to wedge each egg muffin out of its cup.",
      "secondary_message": null
    },
    {
      "id": 374147,
      "primary_message": "To serve, divide egg muffins between plates and enjoy!",
      "secondary_message": null
    }
  ],
