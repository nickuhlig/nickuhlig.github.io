  "instructions": [
    {
      "id": 392255,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 392256,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 392257,
      "primary_message": "While the rice is cooking, place marinara sauce, coconut milk, and spices in a large pot; stir to combine. Set over medium heat and bring the curry to a simmer. ",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce\n1 ½ (13.5 fl oz) cans coconut milk\n2 tbsp curry powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 392258,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 392259,
      "primary_message": "Once the curry is simmering, add shrimp and spinach to the pot; stir to combine. Return to a simmer and continue to cook, stirring occasionally, until spinach is wilted and shrimp are cooked through, 6-7 minutes.",
      "secondary_message": "1 ½ (16oz) bags frozen chopped spinach"
    },
    {
      "id": 392260,
      "primary_message": "While the shrimp are cooking, wash, dry, and cut limes into wedges. Set aside for serving.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 392261,
      "primary_message": "Wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 392262,
      "primary_message": "When the shrimp are done, add cilantro to the pot and stir to combine. Remove from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 392263,
      "primary_message": "Divide rice and curry between plates or bowls; serve with lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
