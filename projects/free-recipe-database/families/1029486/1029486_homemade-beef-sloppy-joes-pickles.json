  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium-high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.\n\n",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "primary_message": "Once the skillet is hot, add onion and beef; cook, breaking the meat apart with a spoon, until the beef is browned and onion is tender, 8-10 minutes. (Drain any excess cooking liquid from the skillet if necessary.)\n\n",
      "secondary_message": "1 lb lean ground beef"
    },
    {
      "primary_message": "Add ketchup, sugar, vinegar, Worcestershire, and spices to the skillet. Stir to combine, reduce heat to medium, and continue to cook until sauce is thickened, about 5 minutes. Remove from heat.\n\n",
      "secondary_message": "1 cup ketchup\n1 tbsp brown sugar\n1 tbsp apple cider vinegar\n2 tsp Worcestershire sauce\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, toast buns if desired.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, place bottom half of each bun on a plate. Top with saucy beef and pickles (optional), then close with the top half of each bun. Enjoy!\n\n",
      "secondary_message": "⅓ cup dill pickle chips"
    }
  ],
