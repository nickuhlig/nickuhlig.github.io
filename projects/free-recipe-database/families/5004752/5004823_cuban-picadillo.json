  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the yellow onion. Core, seed, and finely chop the red bell pepper. Finely chop the garlic. Dice the canned tomatoes. Peel and cut the waxy potato into 1/4-inch cubes.",
      "secondary_message": "1 medium yellow onion\n1 small red bell pepper\n4 medium cloves garlic\n1 cup canned tomatoes\n1 large waxy potato"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in large skillet over medium-high heat until shimmering. Add onion and bell pepper and cook, stirring occasionally, until softened, 5 to 7 minutes. Add tomato paste, garlic, cumin, oregano, 1 1/2 teaspoons salt, 1 teaspoon pepper, and bay leaves and cook until fragrant and tomato paste darkens in color, about 2 minutes. Add wine and cook until reduced to 1/4 cup, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add meat and cook, stirring and breaking up chunks, until no longer pink, 5 to 7 minutes. Stir in tomatoes, Worcestershire sauce, raisins, olives and their brine, capers, and potato. Cover, reduce heat to medium-low, and cook until potatoes are tender, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove cover and season to taste with salt and pepper. Remove and discard bay leaves. Serve with white rice and black beans.",
      "secondary_message": null
    }
  ],
