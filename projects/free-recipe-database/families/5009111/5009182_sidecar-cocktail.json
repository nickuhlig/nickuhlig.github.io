  "instructions": [
    {
      "id": 1,
      "primary_message": "Optional: Prepare cocktail glass by making a slit in a lemon wedge and running the cut edge around the rim of the glass; then dip the rim in a saucer of superfine sugar to create a thin crust. Chill the glass until needed.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine brandy, Cointreau, and lemon juice in a cocktail shaker and fill with ice. Shake well until chilled, about 10 seconds. Strain into prepared glass; garnish with a twist of orange or lemon peel, if the urge comes across.",
