  "instructions": [
    {
      "id": 89738,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium carrots\n0.23 kg sweet potato\n1 (2 ½ cm) piece ginger root\n1 (142 g) pkg baby spinach\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 89739,
      "primary_message": "Peel and roughly chop the carrots and potato.",
      "secondary_message": null
    },
    {
      "id": 89740,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 89741,
      "primary_message": "Peel and mince shallot; add to salad bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 89742,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 89743,
      "primary_message": "Combine the chopped carrots and potatoes, maple syrup, and salt in the saucepan.",
      "secondary_message": "1 ml pure maple syrup\n½ tsp salt"
    },
    {
      "id": 89744,
      "primary_message": "Peel and mince or grate ginger; add to the saucepan. Reduce to medium heat, cover, and stew for 10 minutes; stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 89745,
      "primary_message": "Add broth, bring to a boil; cover and simmer until vegetables are tender, about 12 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 89746,
      "primary_message": "In the salad bowl, whisk together olive oil, vinegar, maple syrup, sesame seeds, salt, and pepper.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp apple cider vinegar\n2 tsp sesame seeds\n1 tsp pure maple syrup\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 89747,
      "primary_message": "Using an immersion (hand) blender, purée the soup until smooth.",
      "secondary_message": null
    },
    {
      "id": 89748,
      "primary_message": "Measure out cranberries and almonds.",
      "secondary_message": "¼ cup dried cranberries\n¼ cup almonds"
    },
    {
      "id": 89749,
      "primary_message": "Shave the leaves off parsley stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 89750,
      "primary_message": "Add the spinach to the bowl with the dressing. Add ¾ of the parsley, the cranberries, and almonds; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 89751,
      "primary_message": "To serve, pour soup into a bowl, garnish with remaining parsley and arrange salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
