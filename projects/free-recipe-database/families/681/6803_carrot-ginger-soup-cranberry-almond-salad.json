  "instructions": [
    {
      "id": 89682,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "9 medium carrots\n1 ½ lb sweet potatoes\n3 (1 inch) pieces ginger root\n3 (5 oz) pkgs baby spinach\n1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 89683,
      "primary_message": "Peel and roughly chop the carrots and potatoes.",
      "secondary_message": null
    },
    {
      "id": 89684,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 89685,
      "primary_message": "Peel and mince shallot; add to a large salad bowl.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 89686,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 89687,
      "primary_message": "Combine the chopped carrots and potatoes, maple syrup, and salt in the pot.",
      "secondary_message": "1 tbsp pure maple syrup\n1 ½ tsp salt"
    },
    {
      "id": 89688,
      "primary_message": "Peel and mince or grate ginger; add to the pot. Reduce to medium heat, cover, and stew for 10 minutes; stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 89689,
      "primary_message": "Add broth to the pot, bring to a boil; cover and simmer until vegetables are tender, about 12 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 89690,
      "primary_message": "In the salad bowl, whisk together olive oil, vinegar, maple syrup, sesame seeds, salt, and pepper.",
      "secondary_message": "⅓ cup extra virgin olive oil\n¼ cup apple cider vinegar\n1 tbsp pure maple syrup\n2 tbsp sesame seeds\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 89691,
      "primary_message": "Using an immersion (hand) blender, purée the soup until smooth.",
      "secondary_message": null
    },
    {
      "id": 89692,
      "primary_message": "Measure out cranberries and almonds.",
      "secondary_message": "¾ cup dried cranberries\n¾ cup almonds"
    },
    {
      "id": 89693,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 89694,
      "primary_message": "Add the spinach to the bowl with the dressing. Add ¾ of the parsley, the cranberries, and almonds; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 89695,
      "primary_message": "To serve, pour soup into a bowl, garnish with remaining parsley and arrange salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
