  "instructions": [
    {
      "primary_message": "This recipe uses Betty Crocker brownie mix; if using a different brand please adjust recipe ingredients and cooking times per package instructions.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 350°F. Coat the bottom of a 9-inch square baking dish with cooking spray. \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place brownie mix, egg, oil, and water in a medium bowl, then stir until combined. Transfer batter to the baking dish and spread out in an even layer. \n\n",
      "secondary_message": "1 (16.3 oz) box chocolate brownie mix\n1 egg\n⅓ cup neutral vegetable oil\n¼ cup water"
    },
    {
      "primary_message": "Place brownies in the preheated oven and bake until a toothpick inserted 2 inches from the side of the pan comes out mostly clean, about 40 minutes. Remove from oven and set aside to cool completely, 1 hour.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the brownies are cool, remove from the pan and place on a cutting board. Cut into 12 pieces and place on a parchment-lined baking sheet pan. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Drop a generous teaspoon of icing towards the top of each brownie, then spread the frosting in a downward motion with the back of a small spoon, creating \"ghosts.\" Use the writing gel to give your ghosts eyes and mouths as desired. \n\n",
      "secondary_message": "6 tbsp white frosting\n1 (1.3 oz) tube black writing icing or gel"
    },
    {
      "primary_message": "Show off your creations, share, and enjoy!",
      "secondary_message": null
    }
  ],
