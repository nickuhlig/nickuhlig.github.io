  "instructions": [
    {
      "id": 526143,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 526144,
      "primary_message": "Meanwhile, wash, dry, and halve grape tomatoes. Place in a medium bowl.",
      "secondary_message": "1 ½ pints grape tomatoes"
    },
    {
      "id": 526145,
      "primary_message": "Wash, dry, trim, and seed bell peppers; medium dice. Add to the bowl with the tomatoes.",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 526146,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 526147,
      "primary_message": "Preheat a large skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 526148,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 526149,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies, garlic, pine nuts, and spices; cook, stirring occasionally, until veggies start to blister, about 8 minutes. Remove from heat.",
      "secondary_message": "3 tbsp butter, unsalted\n⅓ cup pine nuts\n1 ½ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 526150,
      "primary_message": "Meanwhile, divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 526151,
      "primary_message": "To serve, divide toast between plates and spread with yogurt. Top with blistered veggie mix and enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
