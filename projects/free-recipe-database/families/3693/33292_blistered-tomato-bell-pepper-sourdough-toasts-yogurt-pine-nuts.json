  "instructions": [
    {
      "id": 526179,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 526180,
      "primary_message": "Meanwhile, wash, dry, and halve grape tomatoes. Place in a small bowl.",
      "secondary_message": "½ small pkg grape tomatoes"
    },
    {
      "id": 526181,
      "primary_message": "Wash, dry, trim, and seed bell pepper; medium dice. Add to the bowl with the tomatoes.",
      "secondary_message": "1 green bell pepper"
    },
    {
      "id": 526182,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 526183,
      "primary_message": "Preheat a skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 526184,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 526185,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies, garlic, pine nuts, and spices; cook, stirring occasionally, until veggies start to blister, 6-8 minutes. Remove from heat.",
      "secondary_message": "1 tbsp butter, unsalted\n⅛ cup pine nuts\n½ tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 526186,
      "primary_message": "Meanwhile, arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 526187,
      "primary_message": "To serve, divide toast between plates and spread with yogurt. Top with blistered veggie mix and enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
