  "instructions": [
    {
      "id": 213620,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 English cucumbers\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch cilantro\n1 avocado\n1 tomato"
    },
    {
      "id": 213621,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 213622,
      "primary_message": "Trim and thinly slice cucumbers. Place in a medium bowl, along with oil, vinegar, salt, and pepper. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 213623,
      "primary_message": "Peel and mince garlic and shallots. Place half the garlic and shallot in the bowl with the cucumber and toss to combine the salad. Set aside.",
      "secondary_message": "4 cloves garlic\n2 shallots"
    },
    {
      "id": 213624,
      "primary_message": "Place remaining garlic and shallot in a large bowl. Juice lemon into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 213625,
      "primary_message": "Add beans and chili-garlic sauce to the bowl with the lemon juice. Crush the beans with a fork or potato masher until they are broken down.",
      "secondary_message": "1 tsp chili-garlic sauce"
    },
    {
      "id": 213626,
      "primary_message": "Shave parsley and cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 213627,
      "primary_message": "Drain and mince artichokes. Grate cheese. Add both to the bowl.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated\n¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 213628,
      "primary_message": "Add the eggs, bread crumbs, baking powder, and spices to the bowl and stir to combine. Mash the chickpeas once more, until a cohesive mixture is formed. ",
      "secondary_message": "2 eggs\n⅔ cup panko bread crumbs\n1 tsp baking powder\n1 tsp cumin\n1 tsp coriander\n½ tsp salt"
    },
    {
      "id": 213629,
      "primary_message": "Divide the mixture into 4 portions (about ⅔ cup each). Using your hands, form each portion into a ball, then flatten into a 1-inch thick patty. (The patties will be moist and delicate; they will firm up upon cooking.)",
      "secondary_message": null
    },
    {
      "id": 213630,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 213631,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Carefully transfer patties to the skillet and cook until dark brown on one side, 5-6 minutes. Gently flip the patties and cook until dark brown on the other side, 5 minutes more. Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 213632,
      "primary_message": "Meanwhile, place mayo, tahini, water, and salt in a small bowl. Whisk to combine the tahini mayo.",
      "secondary_message": "2 tbsp mayonnaise\n2 tbsp tahini\n2 tsp water\n⅛ tsp salt"
    },
    {
      "id": 213633,
      "primary_message": "Halve and pit the avocado; slice thinly while still in skin, then scoop out. Slice tomato into rounds. ",
      "secondary_message": null
    },
    {
      "id": 213634,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 213635,
      "primary_message": "Place the bottom half of a bun on each plate. Layer with a falafel patty, tahini mayo, avocado, and tomato; close with the top half of the bun. Serve with cucumber salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
