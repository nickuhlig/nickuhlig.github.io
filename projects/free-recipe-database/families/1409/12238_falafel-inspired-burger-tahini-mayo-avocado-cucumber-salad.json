  "instructions": [
    {
      "id": 213604,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ small bunch cilantro\n½ avocado\n½ tomato"
    },
    {
      "id": 213605,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "½ (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 213606,
      "primary_message": "Trim and thinly slice cucumber. Place in a medium bowl, along with oil, vinegar, salt, and pepper. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 213607,
      "primary_message": "Peel and mince garlic and shallot. Place half the garlic and shallot in the bowl with the cucumber and toss to combine the salad. Set aside.",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 213608,
      "primary_message": "Place remaining garlic and shallot in another medium bowl. Juice lemon into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 213609,
      "primary_message": "Add beans and chili-garlic sauce to the bowl with the lemon juice. Crush the beans with a fork or potato masher until they are broken down.",
      "secondary_message": "½ tsp chili-garlic sauce"
    },
    {
      "id": 213610,
      "primary_message": "Shave parsley and cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 213611,
      "primary_message": "Drain and mince artichokes. Grate cheese. Add both to the bowl.",
      "secondary_message": "½ (6 oz) jar artichoke hearts, marinated\n⅛ (8 oz) block mozzarella cheese"
    },
    {
      "id": 213612,
      "primary_message": "Add the egg, bread crumbs, baking powder, and spices to the bowl and stir to combine. Mash the chickpeas once more, until a cohesive mixture is formed. ",
      "secondary_message": "1 egg\n⅓ cup panko bread crumbs\n½ tsp baking powder\n½ tsp cumin\n½ tsp coriander\n¼ tsp salt"
    },
    {
      "id": 213613,
      "primary_message": "Divide the mixture into 2 portions (about ⅔ cup each). Using your hands, form each portion into a ball, then flatten into a 1-inch thick patty. (The patties will be moist and delicate; they will firm up upon cooking.)",
      "secondary_message": null
    },
    {
      "id": 213614,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 213615,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Carefully transfer patties to the skillet and cook until dark brown on one side, 5-6 minutes. Gently flip the patties and cook until dark brown on the other side, 5 minutes more. Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 213616,
      "primary_message": "Meanwhile, place mayo, tahini, water, and salt in a small bowl. Whisk to combine the tahini mayo.",
      "secondary_message": "1 tbsp mayonnaise\n1 tbsp tahini\n1 tsp water\n1 pinch salt"
    },
    {
      "id": 213617,
      "primary_message": "Halve and pit the avocado; slice thinly while still in skin, then scoop out. Slice tomato into rounds. ",
      "secondary_message": null
    },
    {
      "id": 213618,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 213619,
      "primary_message": "Place the bottom half of a bun on each plate. Layer with a falafel patty, tahini mayo, avocado, and tomato; close with the top half of the bun. Serve with cucumber salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
