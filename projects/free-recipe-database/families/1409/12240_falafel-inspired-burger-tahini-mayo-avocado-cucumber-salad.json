  "instructions": [
    {
      "id": 213636,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n1 ½ lemons\n2 small bunches Italian (flat-leaf) parsley\n1 small bunch cilantro\n1 ½ avocados\n1 ½ tomatoes"
    },
    {
      "id": 213637,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "1 ½ (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 213638,
      "primary_message": "Trim and thinly slice cucumbers. Place in a large bowl, along with oil, vinegar, salt, and pepper. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 213639,
      "primary_message": "Peel and mince garlic and onion. Place half the garlic and onion in the bowl with the cucumber and toss to combine the salad. Set aside.",
      "secondary_message": "6 cloves garlic\n½ medium red onion"
    },
    {
      "id": 213640,
      "primary_message": "Place remaining garlic and onion in another large bowl. Juice lemons into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 213641,
      "primary_message": "Add beans and chili-garlic sauce to the bowl with the lemon juice. Crush the beans with a fork or potato masher until they are broken down.",
      "secondary_message": "1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 213642,
      "primary_message": "Shave parsley and cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 213643,
      "primary_message": "Drain and mince artichokes. Grate cheese. Add both to the bowl.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated\n½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 213644,
      "primary_message": "Add the eggs, bread crumbs, baking powder, and spices to the bowl and stir to combine. Mash the chickpeas once more, until a cohesive mixture is formed. ",
      "secondary_message": "3 eggs\n1 cup panko bread crumbs\n1 ½ tsp baking powder\n1 ½ tsp cumin\n1 ½ tsp coriander\n¾ tsp salt"
    },
    {
      "id": 213645,
      "primary_message": "Divide the mixture into 6 portions (about ⅔ cup each). Using your hands, form each portion into a ball, then flatten into a 1-inch thick patty. (The patties will be moist and delicate; they will firm up upon cooking.)",
      "secondary_message": null
    },
    {
      "id": 213646,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 213647,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, carefully transfer patties to the skillet and cook until dark brown on one side, 5-6 minutes. Gently flip the patties and cook until dark brown on the other side, 5 minutes more. Remove to a plate.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 213648,
      "primary_message": "Meanwhile, place mayo, tahini, water, and salt in a small bowl. Whisk to combine the tahini mayo.",
      "secondary_message": "3 tbsp mayonnaise\n3 tbsp tahini\n1 tbsp water\n3 pinch salt"
    },
    {
      "id": 213649,
      "primary_message": "Halve and pit the avocados; slice thinly while still in skin, then scoop out. Slice tomatoes into rounds. ",
      "secondary_message": null
    },
    {
      "id": 213650,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 213651,
      "primary_message": "Place the bottom half of a bun on each plate. Layer with a falafel patty, tahini mayo, avocado, and tomato; close with the top half of the bun. Serve with cucumber salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
