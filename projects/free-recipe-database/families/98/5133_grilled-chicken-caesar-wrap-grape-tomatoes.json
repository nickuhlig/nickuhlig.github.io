  "instructions": [
    {
      "id": 61972,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 61971,
      "primary_message": "Peel and mince garlic. Grate 3 tsp of lemon zest. In a medium bowl, prepare marinade by whisking together ½ of the garlic (save the rest for the dressing), lemon zest and juice, olive oil, salt, and pepper.",
      "secondary_message": "6 cloves garlic\nzest and juice from 1 ½ lemon\n3 tbsp extra virgin olive oil\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 61970,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Add to marinade and toss to coat.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 61969,
      "primary_message": "Coat grill or bottom of skillet with oil. Add chicken and cook until cooked through, 2-3 minutes per side.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 61968,
      "primary_message": "Wash and dry lettuce. Halve lengthwise, then chop crosswise into 1 inch strips. Transfer to a large bowl.",
      "secondary_message": "1 ½ head romaine lettuce"
    },
    {
      "id": 61967,
      "primary_message": "Grate ⅓ cup of Parmesan. In a medium bowl, prepare dressing by whisking together remaining garlic, Parmesan, lemon juice, yogurt, olive oil, Dijon, Worcestershire, salt, and pepper.",
      "secondary_message": "1 ½ oz Parmesan cheese\njuice of ¾ lemon\n⅜ cup plain Greek yogurt\n6 tbsp extra virgin olive oil\n¾ tsp Dijon mustard\n¾ tsp Worcestershire sauce\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 61966,
      "primary_message": "Pour dressing into bowl with lettuce and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 61965,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 61964,
      "primary_message": "Place tortillas on a flat surface, add lettuce to the middle, and top with chicken. Tightly roll to close. Place on the grill/skillet seam side down and toast until golden brown, 1-2 minutes per side.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 61963,
      "primary_message": "Slice remaining lemon into wedges. Wash tomatoes.",
      "secondary_message": "¾ lemon\n3 pints grape tomatoes"
    },
    {
      "id": 61962,
      "primary_message": "To serve, place chicken wraps on a plate, add tomatoes on the side, and garnish with lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
