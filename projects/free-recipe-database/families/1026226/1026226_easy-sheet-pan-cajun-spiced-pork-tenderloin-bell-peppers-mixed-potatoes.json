  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry yellow and sweet potatoes. Medium dice yellow potatoes. Peel and medium dice sweet potatoes. Transfer both to a large baking sheet pan, drizzle with oil, then season with spices. Stir to combine and spread out in an even layer. Place baking sheet in the preheated oven and roast, stirring halfway through, until potatoes are fork-tender, 35-40 minutes. Remove from oven.",
      "secondary_message": "extra virgin olive oil\n1 tbsp rosemary, dried\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Transfer vegetables to another large baking sheet. Drizzle with additional oil, then sprinkle with Cajun seasoning and salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "3 (14 oz) bag frozen pepper strips\nextra virgin olive oil\n1 ½ tbsp Cajun seasoning\n½ tsp salt"
    },
    {
      "primary_message": "Pat pork dry with paper towels and place on a large plate. Drizzle with oil, then sprinkle with Cajun seasoning on all sides. Add to the baking sheet with the bell peppers, nestling it into the veggies. Add baking sheet to the oven and roast, turning pork and stirring peppers halfway through, until pork is cooked through and peppers are tender, 30-35 minutes. Remove from oven. ",
      "secondary_message": "2 ½ lb pork tenderloin\nextra virgin olive oil\n1 tbsp Cajun seasoning"
    },
    {
      "primary_message": "Thinly slice pork.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pork, roasted potatoes, and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
