  "instructions": [
    {
      "id": 431365,
      "primary_message": "Wash, dry, and quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh and place in a medium saucepan.",
      "secondary_message": "2 peaches"
    },
    {
      "id": 431366,
      "primary_message": "Wash, dry, and add blueberries to the saucepan with the peaches.",
      "secondary_message": "2 (170 g) pkgs blueberries"
    },
    {
      "id": 431367,
      "primary_message": "Add water, sugar, and vanilla to the saucepan, then stir to combine. Bring to a simmer over medium-high heat, stirring the fruit occasionally.",
      "secondary_message": "59 ml (¼ cup) water\n¼ cup granulated sugar\n4 tsp vanilla extract"
    },
    {
      "id": 431368,
      "primary_message": "Once the fruit mixture is simmering, reduce heat to medium. Cover and cook, stirring occasionally, until the fruit is soft, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 431369,
      "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water and cornstarch until smooth.",
      "secondary_message": "118 ml (½ cup) water\n2 tbsp cornstarch"
    },
    {
      "id": 431370,
      "primary_message": "When the fruit is soft, add cornstarch slurry to the saucepan in a steady stream, stirring constantly. Return mixture to a simmer and continue to cook, stirring occasionally, until sauce thickens, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 431371,
      "primary_message": "Remove sauce from heat and transfer to a heatproof bowl. Place in the fridge to cool, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 431372,
      "primary_message": "Meanwhile, place almonds in a skillet. Set over medium heat and cook, stirring frequently, until lightly toasted, about 3 minutes. Transfer to another small bowl and set aside to cool.",
      "secondary_message": "⅔ cup almonds, sliced"
    },
    {
      "id": 431373,
      "primary_message": "To serve, place one scoop of ice cream in the bottom of each bowl; top with half of the blueberry-peach sauce. Place a second scoop of ice cream on top, drizzle with remaining sauce, and sprinkle with toasted almonds. Enjoy!",
      "secondary_message": "710 ml vanilla ice cream, vegan"
    }
  ],
