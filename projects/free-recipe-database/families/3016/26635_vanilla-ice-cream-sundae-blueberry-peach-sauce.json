  "instructions": [
    {
      "id": 431230,
      "primary_message": "Wash, dry, and quarter peach lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh and place in a small saucepan.",
      "secondary_message": "1 peach"
    },
    {
      "id": 431231,
      "primary_message": "Wash, dry, and add blueberries to the saucepan with the peaches.",
      "secondary_message": "1 (6 oz) pkg blueberries"
    },
    {
      "id": 431232,
      "primary_message": "Add water, sugar, and vanilla to the saucepan, then stir to combine. Bring to a simmer over medium-high heat, stirring the fruit occasionally.",
      "secondary_message": "1 fl oz (⅛ cup) water\n2 tbsp granulated sugar\n2 tsp vanilla extract"
    },
    {
      "id": 431233,
      "primary_message": "Once the fruit mixture is simmering, reduce heat to medium. Cover and cook, stirring occasionally, until the fruit is soft, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 431234,
      "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water and cornstarch until smooth.",
      "secondary_message": "2 fl oz (¼ cup) water\n1 tbsp cornstarch"
    },
    {
      "id": 431235,
      "primary_message": "When the fruit is soft, add cornstarch slurry to the saucepan in a steady stream, stirring constantly. Return mixture to a simmer and continue to cook, stirring occasionally, until sauce thickens, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 431236,
      "primary_message": "Remove sauce from heat and transfer to a heatproof bowl. Place in the fridge to cool, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 431237,
      "primary_message": "To serve, place one scoop of ice cream in the bottom of each bowl; top with half of the blueberry-peach sauce. Place a second scoop of ice cream on top, drizzle with remaining sauce, and enjoy!",
      "secondary_message": "12 fl oz (1 ½ cups) vanilla ice cream"
    }
  ],
