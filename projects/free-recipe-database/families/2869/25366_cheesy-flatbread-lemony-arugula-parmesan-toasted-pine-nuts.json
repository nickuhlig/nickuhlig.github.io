  "instructions": [
    {
      "id": 407003,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 407004,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 407005,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 407006,
      "primary_message": "Meanwhile, arrange flatbreads on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until flatbreads are warm, about 4 minutes.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 407007,
      "primary_message": "While the flatbreads warm up, wash, dry, and zest lemon into a medium bowl (reserve lemon for later use).",
      "secondary_message": "½ lemon"
    },
    {
      "id": 407008,
      "primary_message": "Coarsely grate mozzarella. Add to the bowl with the lemon zest and stir to combine.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 407009,
      "primary_message": "Remove flatbreads from oven and sprinkle with the lemon-cheese mixture. Return baking sheet to the oven and continue to bake until flatbreads are crispy and cheese is melted, 4 minutes more. Remove from oven. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 407010,
      "primary_message": "Meanwhile, peel and mince shallot. Place in the reserved bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 407011,
      "primary_message": "Juice reserved lemon into the bowl with the shallot. Add oil, pepper, and salt, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 407012,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl with the dressing.",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 407013,
      "primary_message": "Using a peeler, shave the Parmesan into curls. Add to the bowl, along with the pine nuts, and gently toss to combine the salad.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 407014,
      "primary_message": "Top each flatbread with a small handful of the arugula salad, then slice into wedges. (Reserve remaining salad for serving.)",
      "secondary_message": null
    },
    {
      "id": 407015,
      "primary_message": "Divide flatbreads between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
