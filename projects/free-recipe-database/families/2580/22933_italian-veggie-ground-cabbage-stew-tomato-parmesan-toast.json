  "instructions": [
    {
      "id": 379056,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n1 medium carrot\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 379057,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 379058,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 379059,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 379060,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion, garlic, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n227 g veggie ground, plant based\n¾ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 379061,
      "primary_message": "Meanwhile, peel, trim, and halve carrot lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 379062,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 379063,
      "primary_message": "When the veggie ground is done, add vegetables, broth, and tomatoes to the pan. Stir to combine the stew and bring to a simmer over medium-high heat.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes"
    },
    {
      "id": 379064,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the pan and stir to combine (set remaining parsley aside for serving).",
      "secondary_message": null
    },
    {
      "id": 379065,
      "primary_message": "Once the stew is simmering, reduce heat to medium and continue to cook, stirring occasionally, until the veggies are soft, about 8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 379066,
      "primary_message": "While the stew is cooking, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 379067,
      "primary_message": "Arrange bread slices on a baking sheet pan. Drizzle with oil, then sprinkle with Italian seasoning. Place in the oven and broil until toasted, 1-2 minutes. Remove from oven and cut toasts in half.",
      "secondary_message": "2 slices whole grain bread\n1 tsp extra virgin olive oil\n¼ tsp Italian seasoning"
    },
    {
      "id": 379068,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 379069,
      "primary_message": "Divide stew between bowls; sprinkle with Parmesan and reserved parsley. Serve with toast on the side and enjoy!",
      "secondary_message": null
    }
  ],
