  "instructions": [
    {
      "id": 378738,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n1 medium carrot\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 378739,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 378740,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 378741,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 378742,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion, garlic, ground sausage, salt, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ lb ground pork sausage\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 378743,
      "primary_message": "Meanwhile, peel, trim, and halve carrot lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 378744,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 378745,
      "primary_message": "When the sausage is done, add veggies, broth, and tomatoes to the pan. Stir to combine the stew and bring to a simmer over medium-high heat.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 378746,
      "primary_message": "While the stew is coming to a simmer, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the pan and stir to combine (set remaining parsley aside for serving).",
      "secondary_message": null
    },
    {
      "id": 378747,
      "primary_message": "Once the stew is simmering, reduce heat to medium and continue to cook, stirring occasionally, until the veggies are soft, about 8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 378748,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 378749,
      "primary_message": "To serve, divide stew between bowls; sprinkle with Parmesan and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
