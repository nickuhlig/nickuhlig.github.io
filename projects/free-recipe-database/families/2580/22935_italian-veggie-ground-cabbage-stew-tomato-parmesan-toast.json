  "instructions": [
    {
      "id": 379084,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n3 medium carrots\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 379085,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 379086,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 379087,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 379088,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n2 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 379089,
      "primary_message": "Meanwhile, peel, trim, and halve carrots lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 379090,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 379091,
      "primary_message": "When the veggie ground is done, add vegetables, broth, and tomatoes to the pot. Stir to combine the stew and bring to a simmer over medium-high heat.",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes"
    },
    {
      "id": 379092,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the pot and stir to combine (set remaining parsley aside for serving).",
      "secondary_message": null
    },
    {
      "id": 379093,
      "primary_message": "Once the stew is simmering, reduce heat to medium and continue to cook, stirring occasionally, until the veggies are soft, about 8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 379094,
      "primary_message": "While the stew is cooking, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 379095,
      "primary_message": "Arrange bread slices on a large baking sheet pan. Drizzle with oil, then sprinkle with Italian seasoning. Place in the oven and broil until toasted, 1-2 minutes. Remove from oven and cut toasts in half.",
      "secondary_message": "6 slices whole grain bread\n1 tbsp extra virgin olive oil\n¾ tsp Italian seasoning"
    },
    {
      "id": 379096,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 379097,
      "primary_message": "Divide stew between bowls; sprinkle with Parmesan and reserved parsley. Serve with toast on the side and enjoy!",
      "secondary_message": null
    }
  ],
