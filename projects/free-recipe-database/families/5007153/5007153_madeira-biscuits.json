  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together flour and salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, beat together butter and sugar until light and fluffy, about 4 minutes. Add vanilla extract and beat until combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Beat in 1/2 flour mixture. Beat in second 1/2 just until dough forms. Stir in raisins and currents.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "On a lightly floured surface, roll dough into a 1 1/2 inch wide log. Wrap in plastic wrap and let chill in refrigerator for at least 1 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Preheat oven to 375°F. Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Take dough out of refrigerator and unwrap. Slice logs into 1/4 inch rounds. Place rounds on baking sheets.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Baking cookies until golden, about 12 minutes.",
      "secondary_message": null
    }
  ],
