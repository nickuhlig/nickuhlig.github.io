    {
      "ingredient_id": 116,
      "name": "all purpose flour",
      "quantity": "1 ⅔ cups"
    },
    {
      "ingredient_id": 88,
      "name": "salt",
      "quantity": "½ tsp"
    },
    {
      "ingredient_id": 115,
      "name": "unsalted butter, at room temperature",
      "quantity": "¾ cup"
    },
    {
      "ingredient_id": 346,
      "name": "sugar",
