  "instructions": [
    {
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. ",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat an ovenproof skillet over medium-high heat. Once the skillet is hot, add ground beef, salt, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "12 oz lean ground beef\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, cut tortillas in half, then cut crosswise into 1/2-inch strips. Set aside. Wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "primary_message": "When the beef is done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Add tortilla strips and enchilada sauce, then stir to combine. Sprinkle with cheese. Place in the oven and broil until the cheese is melted and sauce is bubbling, 3-4 minutes. Remove from oven.",
      "secondary_message": "1 (10 oz) can red enchilada sauce\n⅔ cup pepper jack cheese, shredded"
    },
    {
      "primary_message": "To serve, divide skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
