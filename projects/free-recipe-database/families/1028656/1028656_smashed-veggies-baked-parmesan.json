  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved if you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 400°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "primary_message": "Fill a medium saucepan with hot water (from the tap). Cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the water is boiling, add veggies and cook, stirring occasionally, until fork-tender, 4-5 minutes. Drain in a colander. ",
      "secondary_message": "1 (12 oz) bag vegetable medley (baby carrots, broccoli and cauliflower florets)"
    },
    {
      "primary_message": "Transfer drained veggies to a medium bowl, along with oil and spices, then stir to coat.",
      "secondary_message": "extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Transfer veggies to the baking sheet and use the flat bottom of a glass or measuring cup to \"smash\" them down to about ½-inch thickness. Sprinkle with Parmesan. (This is a great step to get your kids involved!)",
      "secondary_message": "1 cup Parmesan cheese, shredded"
    },
    {
      "primary_message": "Place baking sheet in the preheated oven and roast until cheese is melted and veggies are starting to get crispy, 20-25 minutes. Remove from oven and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide smashed veggies between plates and enjoy!",
      "secondary_message": null
    }
  ],
