  "instructions": [
    {
      "id": 278684,
      "primary_message": "Preheat oven to 230°C (450°F). Line two baking sheet pans with aluminum foil and coat with a thin layer of oil; set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 278685,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n15 jalapeño peppers\n1 ½ small pkgs grape tomatoes\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 278686,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 278687,
      "primary_message": "Using a box grater, coarsely grate cheddar and cream cheese into the bowl with the cilantro; add spices and mash with a fork or the back of a spoon to combine. Set aside.",
      "secondary_message": "1 ½ (227 g) blocks cheddar cheese\n1 ½ (227 g) blocks cream cheese\n1 ½ tsp cumin, ground\n¾ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 278688,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 278689,
      "primary_message": "Using a rounded tablespoon measure, fill each jalapeño half with the cheese mixture. Wrap one slice of prosciutto around each jalapeño half and divide between the baking sheets, cheese-side facing up. (Wipe bowl clean with paper towels and reserve for later use.)",
      "secondary_message": "30 slices prosciutto"
    },
    {
      "id": 278690,
      "primary_message": "Place jalapeño poppers in the oven and bake until golden and crispy, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 278691,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 ½ tsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 278692,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 278693,
      "primary_message": "Right before serving, add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 278694,
      "primary_message": "To serve, divide jalapeño poppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
