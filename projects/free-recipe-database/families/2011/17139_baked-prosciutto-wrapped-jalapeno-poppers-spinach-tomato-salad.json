  "instructions": [
    {
      "id": 278673,
      "primary_message": "Preheat oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil and coat with a thin layer of oil; set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 278674,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n10 jalapeño peppers\n1 small pkg grape tomatoes\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 278675,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 278676,
      "primary_message": "Using a box grater, coarsely grate cheddar and cream cheese into the bowl with the cilantro; add spices and mash with a fork or the back of a spoon to combine. Set aside.",
      "secondary_message": "1 (227 g) block cheddar cheese\n1 (227 g) block cream cheese\n1 tsp cumin, ground\n½ tsp garlic powder\n¼ tsp black pepper"
    },
    {
      "id": 278677,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 278678,
      "primary_message": "Using a rounded tablespoon measure, fill each jalapeño half with the cheese mixture. Wrap one slice of prosciutto around each jalapeño half and place on the baking sheet, cheese-side facing up. (Wipe bowl clean with paper towels and reserve for later use.)",
      "secondary_message": "20 slices prosciutto"
    },
    {
      "id": 278679,
      "primary_message": "Place jalapeño poppers in the oven and bake until golden and crispy, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 278680,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 278681,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 278682,
      "primary_message": "Right before serving, add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 278683,
      "primary_message": "To serve, divide jalapeño poppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
