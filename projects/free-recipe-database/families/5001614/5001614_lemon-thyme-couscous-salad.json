  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Zest the lemons. Juice the lemon. Pick the thyme leaves from the stems and finely chop them. Finely mince and grate the garlic. Chop the toasted almonds. Chop the dried apricots.",
      "secondary_message": "2 lemons\n1 lemon\n2 tbsp fresh thyme leaves, plus more for garnish\n2 cloves garlic, or pressed\n½ cup toasted almonds, plus more for garnish\n½ cup dried apricots"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk together olive oil, lemon zest, lemon juice, thyme, garlic, turmeric, salt, and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add warm cooked couscous and mix to combine with the dressing. Let sit until slightly cooled and flavors have married, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add almonds and dried apricots and toss gently to combine with couscous. Season with salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "If desired, garnish with thyme leaves and toasted chopped almonds. Serve warm or at room temperature.",
      "secondary_message": null
    }
  ],
