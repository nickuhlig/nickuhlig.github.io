  "instructions": [
    {
      "id": 445689,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 leek\n½ lemon\n½ small bunch fresh dill\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 445690,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 445691,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 445692,
      "primary_message": "While the pan heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 445693,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add leek and garlic; cook, stirring frequently, until beginning to soften, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 445694,
      "primary_message": "Meanwhile, zest the lemon. Juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 445695,
      "primary_message": "When the leek and garlic have softened, add lemon zest, broth, orzo, and salt to the pan; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n5 oz orzo pasta\n½ tsp salt"
    },
    {
      "id": 445696,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice, along with the feta, and set aside.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 445697,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445698,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 445699,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 445700,
      "primary_message": "When the orzo is done, add spinach to the pan in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 445701,
      "primary_message": "Add lemon juice, dill, and feta to the pan. Stir to combine and continue to cook, stirring frequently, until warmed through, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 445702,
      "primary_message": "Using a clean cutting board, slice chicken into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 445703,
      "primary_message": "To serve, divide orzo and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
