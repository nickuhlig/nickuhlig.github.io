  "instructions": [
    {
      "id": 445719,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 leeks\n1 ½ lemons\n1 small bunch fresh dill\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 445720,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 445721,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 445722,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 445723,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leek and garlic; cook, stirring frequently, until beginning to soften, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 445724,
      "primary_message": "Meanwhile, zest the lemons. Juice lemons into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 445725,
      "primary_message": "When the leek and garlic have softened, add lemon zest, broth, orzo, and salt to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "36 fl oz (4 ½ cups) chicken or vegetable broth\n15 oz orzo pasta\n1 ½ tsp salt"
    },
    {
      "id": 445726,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice, along with the feta, and set aside.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 445727,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445728,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445729,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 445730,
      "primary_message": "When the orzo is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 445731,
      "primary_message": "Add lemon juice, dill, and feta to the pot. Stir to combine and continue to cook, stirring frequently, until warmed through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 445732,
      "primary_message": "Using a clean cutting board, slice chicken into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 445733,
      "primary_message": "To serve, divide orzo and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
