  "instructions": [
    {
      "id": 445815,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 leek\n1 lemon\n½ small bunch fresh dill\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 445816,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 445817,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 445818,
      "primary_message": "While the pan heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 445819,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add leek and garlic; cook, stirring frequently, until beginning to soften, about 3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 445820,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 445821,
      "primary_message": "Zest the lemons. Juice lemons into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 445822,
      "primary_message": "When the leek and garlic have softened, add beans, lemon zest, broth, orzo, and salt to the pan; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n142 g orzo pasta\n¾ tsp salt"
    },
    {
      "id": 445823,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice, along with the feta, and set aside.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 445824,
      "primary_message": "When the pasta is done, add spinach to the pan in handfuls, waiting for the it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 445825,
      "primary_message": "Add lemon juice, dill, and feta to the pan. Stir to combine and continue to cook, stirring frequently, until warmed through, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 445826,
      "primary_message": "To serve, divide orzo between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
