  "instructions": [
    {
      "id": 445758,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 leeks\n3 lemons\n1 small bunch fresh dill\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 445759,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 445760,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 445761,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 445762,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leek and garlic; cook, stirring frequently, until beginning to soften, about 4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 445763,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 445764,
      "primary_message": "Zest the lemons. Juice lemons into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 445765,
      "primary_message": "When the leek and garlic have softened, add beans, lemon zest, broth, orzo, and salt to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n15 oz orzo pasta\n2 tsp salt"
    },
    {
      "id": 445766,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice, along with the feta, and set aside.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 445767,
      "primary_message": "When the pasta is done, add spinach to the pot in handfuls, waiting for the it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 445768,
      "primary_message": "Add lemon juice, dill, and feta to the pot. Stir to combine and continue to cook, stirring frequently, until warmed through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 445769,
      "primary_message": "To serve, divide orzo between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
