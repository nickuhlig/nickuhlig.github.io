  "instructions": [
    {
      "id": 445785,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 leeks\n1 lemon\n1 small bunch fresh dill\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 445786,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 445787,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 445788,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 445789,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leek and garlic; cook, stirring frequently, until beginning to soften, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 445790,
      "primary_message": "Meanwhile, zest the lemon. Juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 445791,
      "primary_message": "When the leek and garlic have softened, add lemon zest, broth, orzo, and salt to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n283 g orzo pasta\n1 tsp salt"
    },
    {
      "id": 445792,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice, along with the feta, and set aside.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 445793,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445794,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 445795,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 445796,
      "primary_message": "When the orzo is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 445797,
      "primary_message": "Add lemon juice, dill, and feta to the pot. Stir to combine and continue to cook, stirring frequently, until warmed through, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 445798,
      "primary_message": "Using a clean cutting board, slice chicken into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 445799,
      "primary_message": "To serve, divide orzo and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
