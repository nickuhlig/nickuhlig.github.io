  "instructions": [
    {
      "id": 198138,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 198139,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 198140,
      "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 198141,
      "primary_message": "Drain and rinse the beans in a large colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 198142,
      "primary_message": "Peel and thinly slice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 198143,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Stir and cook 4-5 minutes or until the gnocchi begin to float to the surface. Drain in the colander with the beans.",
      "secondary_message": "3 (454 g) pkgs potato gnocchi\n1 ½ tsp salt"
    },
    {
      "id": 198144,
      "primary_message": "Return the pot to medium heat, add oil, and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 198145,
      "primary_message": "Add onion and garlic; cook, stirring frequently, until softened, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 198146,
      "primary_message": "Meanwhile, coarsely grate the cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 198147,
      "primary_message": "Stirring constantly, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 198148,
      "primary_message": "Add beans, gnocchi, tomato sauce, and spices to the pot. Cook, stirring frequently, until heated through, 5-6 minutes.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 198149,
      "primary_message": "Pour the gnocchi mixture into a large baking dish and sprinkle with cheese. Place in the oven and bake until the cheese is bubbly and golden, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 198150,
      "primary_message": "To serve, divide gnocchi gratin between plates and enjoy!",
      "secondary_message": null
    }
  ],
