  "instructions": [
    {
      "id": 198086,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 198087,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 198088,
      "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 198089,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 198090,
      "primary_message": "Peel and thinly slice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 198091,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Stir and cook 3-4 minutes or until the gnocchi begin to float to the surface. Drain in the colander with the beans.",
      "secondary_message": "2 (16 oz) pkg potato gnocchi\n1 tsp salt"
    },
    {
      "id": 198092,
      "primary_message": "Return the pot to medium heat, add oil, and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 198093,
      "primary_message": "Add onion and garlic; cook, stirring frequently, until softened, about 4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 198094,
      "primary_message": "Meanwhile, coarsely grate the cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 198095,
      "primary_message": "Stirring constantly, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 198096,
      "primary_message": "Add beans, gnocchi, tomato sauce, and spices to the pot. Cook, stirring frequently, until heated through, about 4 minutes.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 198097,
      "primary_message": "Pour the gnocchi mixture into a medium baking dish and sprinkle with cheese. Place in the oven and bake until the cheese is bubbly and golden, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 198098,
      "primary_message": "To serve, divide gnocchi gratin between plates and enjoy!",
      "secondary_message": null
    }
  ],
