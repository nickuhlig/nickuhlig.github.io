  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring water to boil over medium-high heat in medium heavy-bottomed saucepan. Stir in rice, 1 tablespoon butter, orange rind pieces, cinnamon sticks, and salt. Reduce heat to medium and simmer, stirring from time to time, until most of the liquid is absorbed, 10 to 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in milk, sugar, dark brown sugar, raisins, and optional rum. Increase heat to medium-high and bring mixture to boil. Immediately reduce heat o medium-low and simmer, stirring from time to time, until rice is thickened and tender, about 35 to 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove from heat. Remove and discard orange rind pieces and cinnamon sticks. Stir in remaining 1 tablespoon butter. Serve warm and dust with cinnamon if desired.",
      "secondary_message": null
    }
  ],
