  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the red onion. Drain the oil-packed tuna. Cut the celery into 1/4-inch dice. Peel and shred the carrots. Juice the lemon.",
      "secondary_message": "1 medium red onion\n4 (140 g) cans oil-packed tuna\n2 ribs celery\n2 medium carrots\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, combine onion with vinegar, adding more vinegar if needed to just cover the onion. Let stand for at least 15 minutes and up to 45, then drain, reserving vinegar for another use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a medium bowl, stir together labneh and tuna until well combined and tuna has broken into small pieces.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add red onion, celery, carrots, dill, Dijon mustard, garlic powder, paprika, lemon juice, and salt, and stir well to combine. Spoon tuna salad onto slices of bread and top with lettuce leaves if desired, then close the sandwiches. Serve immediately.",
      "secondary_message": null
    }
  ],
