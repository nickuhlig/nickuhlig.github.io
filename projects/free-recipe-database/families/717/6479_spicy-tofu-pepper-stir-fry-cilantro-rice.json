  "instructions": [
    {
      "id": 163719,
      "primary_message": "Holding a knife parallel to the cutting board, cut the tofu in half horizontally to form two thin planks. Place the tofu between clean towels or paper towels and place a baking sheet with something heavy (like a skillet) on top to press out excess water. Set aside.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 163720,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "2 cups basmati rice\n1 tsp salt\n4 cup water"
    },
    {
      "id": 163721,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 yellow bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 163722,
      "primary_message": "Remove the seeds and membrane from the peppers and cut into strips; place them in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 163723,
      "primary_message": "Once the water for the rice is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 15-18 minutes. Remove from the heat and let the rice stand, covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 163724,
      "primary_message": "Peel and slice the onion into thin half moons; add to the bowl with the peppers.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 163725,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 163726,
      "primary_message": "Meanwhile, large dice the tofu (cut into ¾-inch cubes).",
      "secondary_message": null
    },
    {
      "id": 163727,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tofu, and cook, stirring occasionally, until it starts to brown, about 5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 163728,
      "primary_message": "Combine soy sauce, water, maple syrup, and chili-garlic in a small bowl, whisk to combine.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp water\n4 tsp pure maple syrup\n2 tsp chili-garlic sauce"
    },
    {
      "id": 163729,
      "primary_message": "When tofu is brown, add the soy mixture to the skillet along with the pepper and onions. Stir occasionally, until the vegetables begin to brown, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 163730,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 163731,
      "primary_message": "Roughly chop the cashews. ",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 163732,
      "primary_message": "Uncover the rice and fluff with a fork; add cilantro to rice, reserving some for garnish.",
      "secondary_message": null
    },
    {
      "id": 163733,
      "primary_message": "Divide the rice between plates and top with the tofu and pepper mixture. Garnish with cilantro and cashews and enjoy!",
      "secondary_message": null
    }
  ],
