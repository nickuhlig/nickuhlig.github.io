  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved if you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 400°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "1 lb sweet potato"
    },
    {
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Place in a large bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and slice sweet potatoes lengthwise into ½-inch thick strips, then cut crosswise into 3-inch long sticks. Add to the bowl with the carrot.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and cut parsnips crosswise into 3-inch long pieces; cut each piece lengthwise into ½-inch thick sticks. Add to the bowl, along with oil and spices, then stir to combine. Divide veggies between two baking sheet pans and spread out in an even layer.\n\n",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway, until veggie fries are fork-tender, 25-30 minutes. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place tomato paste, water, vinegar, sugar, and spices in a small bowl. Whisk to combine the ketchup. (Add additional sugar, if desired, for a sweeter ketchup.)\n\n",
      "secondary_message": "1 (6 oz) can tomato paste\n1 tbsp white wine vinegar\n1 tbsp brown sugar\n¼ tsp oregano, dried\n¼ tsp onion powder\n¼ tsp garlic powder\n¼ tsp salt\nblack pepper"
    },
    {
      "primary_message": "Divide veggie fries between plates, serve with ketchup for dipping, and enjoy!",
      "secondary_message": null
    }
  ],
