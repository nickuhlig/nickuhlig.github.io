  "instructions": [
    {
      "id": 33411,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 orange\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 33420,
      "primary_message": "Cut off a piece from each stem end of the orange to reveal the flesh; slice off the skin and pith, then cut the orange lengthwise into 8 wedges. Cut the wedges crosswise into small pieces and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 33412,
      "primary_message": "Crack the egg into a medium bowl and beat with a whisk or fork.",
      "secondary_message": "1 egg"
    },
    {
      "id": 33413,
      "primary_message": "Place the flour and bread crumbs on two separate plates.",
      "secondary_message": "2 tbsp all-purpose flour\n½ cup panko bread crumbs"
    },
    {
      "id": 33416,
      "primary_message": "Place the pork chops on a cutting board and, holding a knife parallel to the board, cut the chops in half horizontally to form thin fillets. Season generously with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 33415,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 33417,
      "primary_message": "One piece at a time, thoroughly coat the seasoned pork chops in the flour (shaking off any excess), then in the beaten egg (letting the excess drip off), then in the bread crumbs (pressing to adhere). Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 33421,
      "primary_message": "Once the skillet is hot, add the pistachios and toast, stirring constantly for 1 to 2 minutes. Once done, transfer to a small bowl.",
      "secondary_message": "⅛ cup pistachios"
    },
    {
      "id": 33418,
      "primary_message": "Once the pistachios have been transferred, add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 33419,
      "primary_message": "Place the breaded pork chops in the skillet; cook until they are golden brown and cooked through, 3 to 5 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 33539,
      "primary_message": "While the pork chops cook, in a small bowl, combine and whisk together olive oil, balsamic vinegar, Dijon, salt, and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp balsamic vinegar\n¼ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 33422,
      "primary_message": "To serve, arrange a bed of spinach on one side of a plate, top with the orange segments and pistachios, and drizzle with the dressing. Place the pork chops on the other side. Enjoy!",
      "secondary_message": null
    }
  ],
