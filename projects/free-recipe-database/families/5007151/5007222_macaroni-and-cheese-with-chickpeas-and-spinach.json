  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in a large saucepan over medium-high heat until shimmering. Add spinach and cook, stirring until wilted, about 30 seconds. Add garlic and cook, stirring, until fragrant, about 1 minute longer. Season to taste with salt and pepper. Transfer to a bowl and set aside. Fill pot with salted water and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine cornstarch, evaporated milk, and eggs in a small bowl and whisk until homogenous. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cook pasta in boiling water according to package directions. Drain, reserving 1 cup pasta cooking water. Return to stock pot and add cooking water, butter, evaporated milk mixture, both cheeses, spinach, and chickpeas. Cook over low heat, stirring constantly, until cheese is melted and pasta is creamy and smooth. Transfer to a serving bowl, top with smoked paprika, and serve immediately.",
      "secondary_message": null
    }
  ],
