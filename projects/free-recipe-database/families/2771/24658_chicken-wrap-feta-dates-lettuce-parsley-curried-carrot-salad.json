  "instructions": [
    {
      "id": 398310,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "½ lemon\n½ small bunch Italian (flat-leaf) parsley\n3 medium carrots\n½ head butter (Boston) lettuce"
    },
    {
      "id": 398311,
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 398312,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice along with yogurt, oil, Dijon, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp curry powder\n¼ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 398313,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398314,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 398315,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and spices; cook, stirring occasionally, until golden and cooked through, 4-5 minutes. Using a slotted spoon, remove chicken to a plate; set aside. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 398316,
      "primary_message": "Meanwhile, using a clean cutting board, peel, trim, and coarsely grate carrots. Add to the bowl with the dressing, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 398317,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 398318,
      "primary_message": "Return skillet (with cooking juices) to medium heat. Add onion and cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 398319,
      "primary_message": "While the onion is cooking, roughly chop dates.",
      "secondary_message": "⅛ cup medjool dates, pitted"
    },
    {
      "id": 398320,
      "primary_message": "When the onion is soft, add vinegar to the skillet. Continue to cook, stirring constantly, until vinegar is reduced, about 1 minute. ",
      "secondary_message": "1 ½ tbsp apple cider vinegar"
    },
    {
      "id": 398321,
      "primary_message": "Return chicken to the skillet, along with any accumulated juices, then add the dates and feta. Stir to combine and remove from heat.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 398322,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. ",
      "secondary_message": null
    },
    {
      "id": 398323,
      "primary_message": "Place tortillas on a flat surface, then divide chicken-feta mixture and lettuce between them. Top with a small portion of carrot salad and roll tightly to close. (Reserve remaining salad for serving.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 398324,
      "primary_message": "Cut wraps in half and divide between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
