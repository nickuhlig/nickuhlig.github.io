  "instructions": [
    {
      "id": 398445,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n9 medium carrots\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 398446,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 398447,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice along with yogurt, oil, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 ½ tsp curry powder\n¾ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 398448,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 398449,
      "primary_message": "Drain and rinse chickpeas. Place half in another large bowl along with mayo and spices. Using a fork or potato masher, mash until smooth. Add remaining whole chickpeas and stir to combine.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n3 tbsp mayonnaise\n1 ½ tsp curry powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 398450,
      "primary_message": "Roughly chop dates. Add to the bowl, along with the feta, and stir to combine the chickpea salad; set aside. ",
      "secondary_message": "¾ cup medjool dates, pitted\n1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 398451,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. ",
      "secondary_message": null
    },
    {
      "id": 398452,
      "primary_message": "Place tortillas on a flat surface, then divide chickpea salad and lettuce between them. Top with a small portion of carrot salad and roll tightly to close. (Reserve remaining salad for serving.)",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 398453,
      "primary_message": "Cut wraps in half and divide between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
