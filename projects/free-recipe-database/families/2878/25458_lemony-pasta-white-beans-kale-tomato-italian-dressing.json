  "instructions": [
    {
      "id": 408376,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, 6-8 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 408377,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 pints grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 408378,
      "primary_message": "Zest and juice lemons into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 408379,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl with the lemon.",
      "secondary_message": null
    },
    {
      "id": 408380,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 408381,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 408382,
      "primary_message": "When the pasta is almost done, add beans and kale to the pot, then stir for a few seconds. Continue to cook until beans are warmed through, kale is tender, and pasta reaches desired doneness, 3-4 minutes more.",
      "secondary_message": "1 ½ (10 oz) bags kale, cut and ready to use"
    },
    {
      "id": 408383,
      "primary_message": "Drain pasta, beans, and kale. Return to the pot along with the lemon, tomato, basil, dressing, salt, and pepper. ",
      "secondary_message": "½ cup Italian salad dressing\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 408384,
      "primary_message": "Set pot over medium heat and cook, stirring often, until tomatoes are warmed through, 2-3 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 408385,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
