  "instructions": [
    {
      "id": 408326,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, 6-8 minutes.",
      "secondary_message": "½ tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 408327,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 pint grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 408328,
      "primary_message": "Zest and juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 408329,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl with the lemon.",
      "secondary_message": null
    },
    {
      "id": 408330,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 408331,
      "primary_message": "Place chicken on the cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces. Add to the bowl and set aside.",
      "secondary_message": "½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 408332,
      "primary_message": "When the pasta is almost done, add kale to the pot and stir for a few seconds. Continue to cook until kale is tender and pasta reaches desired doneness, 2-3 minutes more.",
      "secondary_message": "½ (10 oz) bag kale, cut and ready to use"
    },
    {
      "id": 408333,
      "primary_message": "Drain pasta and kale. Return to the pot along with the lemon, tomato, basil, chicken, dressing, salt, and pepper. ",
      "secondary_message": "3 tbsp Italian salad dressing\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 408334,
      "primary_message": "Set pot over medium heat and cook, stirring often, until tomatoes and chicken are warmed through, 1-2 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 408335,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
