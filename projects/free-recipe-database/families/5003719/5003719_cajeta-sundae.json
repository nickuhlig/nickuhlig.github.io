  "instructions": [
    {
      "id": 1,
      "primary_message": "Before starting, freeze parfait glasses until frosty. Divide ice cream into as many portions as you prefer, dunking the ice cream scoop in hot water from time to time to ensure a clean release. Drizzle each with a few tablespoons of warm cajeta, then top with a generous dollop of Cajeta Whipped Cream. Sprinkle with salted popcorn or other topping and serve immediately.",
      "secondary_message": null
    }
