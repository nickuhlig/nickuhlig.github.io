  "instructions": [
    {
      "id": 148383,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n6 oz fettuccine pasta"
    },
    {
      "id": 148384,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 148385,
      "primary_message": "Peel and small dice the onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 148386,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 148387,
      "primary_message": "Add the onion to the skillet; cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 148388,
      "primary_message": "Wash and slice mushrooms. Peel and mince garlic.",
      "secondary_message": "¾ lb white mushrooms\n2 cloves garlic"
    },
    {
      "id": 148389,
      "primary_message": "Add mushrooms, garlic, and spices to the skillet. Cook, stirring frequently, until mushrooms are softened, 4-5 minutes.",
      "secondary_message": "½ tsp garlic powder\n½ tsp onion powder\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 148390,
      "primary_message": "In a small bowl, whisk together the coconut milk and cornstarch.",
      "secondary_message": "½ (13.5 fl oz) can coconut milk\n2 tbsp cornstarch"
    },
    {
      "id": 148391,
      "primary_message": "Add coconut milk mixture, broth, soy sauce, and vinegar to the skillet. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, until the sauce has thickened, 5-6 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n1 tbsp soy sauce\n1 ½ tsp balsamic vinegar"
    },
    {
      "id": 148392,
      "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems. Add leaves to the skillet and stir to combine.",
      "secondary_message": "½ small pkg fresh thyme"
    },
    {
      "id": 148393,
      "primary_message": "Wash and dry the spinach (skip if it came pre-washed). Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": "½ (5 oz) pkg baby spinach"
    },
    {
      "id": 148394,
      "primary_message": "Drain pasta and add to skillet with the sauce. Toss to combine.",
      "secondary_message": null
    },
    {
      "id": 148395,
      "primary_message": "To serve, divide the pasta and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
