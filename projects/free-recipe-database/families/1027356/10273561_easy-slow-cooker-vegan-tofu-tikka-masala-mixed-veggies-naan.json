  "instructions": [
    {
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkg extra firm tofu"
    },
    {
      "primary_message": "Peel, halve, and small dice onion. Place in a 6-quart slow cooker insert along with tomato sauce, coconut milk, ginger paste, garlic, and spices. Stir to combine the sauce.",
      "secondary_message": "1 medium yellow onion\n639 ml tomato sauce\n760 ml coconut milk\n1 tbsp ginger paste\n1 tbsp minced garlic\n1 tbsp garam masala\n2 tsp cumin, ground\n1 tsp salt\n½ tsp cardamom, ground"
    },
    {
      "primary_message": "Medium dice tofu. Add to the slow cooker, along with veggies, and stir to combine the tikka masala. Cover and cook until warmed through and flavors have blended, 5-6 hours on LOW or HIGH for 3-4 hours.",
      "secondary_message": "1 (340 g) bag vegetable medley (baby carrots, broccoli and cauliflower florets)"
    },
    {
      "primary_message": "When the tikka masala is done, add peas to the insert and stir to combine. Continue to cook until warmed through, 10-15 minutes more.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "primary_message": "Meanwhile, toast naan if desired, then cut into wedges.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide tikka masala between bowls. Serve with naan on the side and enjoy!",
      "secondary_message": null
    }
  ],
