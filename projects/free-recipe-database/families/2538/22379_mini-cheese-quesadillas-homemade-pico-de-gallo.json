  "instructions": [
    {
      "id": 420286,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 tomatoes\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 420287,
      "primary_message": "Juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 420288,
      "primary_message": "Small dice tomatoes. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 420289,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 420290,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 420291,
      "primary_message": "Peel and mince shallot and garlic. Add to the bowl, along with salt, and stir to combine the pico de gallo. Set aside.",
      "secondary_message": "1 shallot\n2 cloves garlic\n½ tsp salt"
    },
    {
      "id": 420292,
      "primary_message": "Arrange tortillas on a flat surface. Place 2 tablespoons of cheese on one side of each tortilla, then fold in half to close.",
      "secondary_message": "8 small flour tortillas\n1 cup shredded cheese, Mexican blend"
    },
    {
      "id": 420293,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 420294,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, add quesadillas and cook, flipping once, until cheese is melted and tortillas are golden, 1-1½ minutes per side. Remove to a plate.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 420295,
      "primary_message": "To serve, divide quesadillas between plates. Top with pico de gallo and enjoy!",
      "secondary_message": null
    }
  ],
