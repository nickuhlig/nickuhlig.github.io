  "instructions": [
    {
      "id": 420356,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 tomatoes\n1 ½ jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 420357,
      "primary_message": "Juice limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 420358,
      "primary_message": "Small dice tomatoes. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 420359,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 420360,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 420361,
      "primary_message": "Peel and mince shallots and garlic. Add to the bowl, along with salt, and stir to combine the pico de gallo. Set aside.",
      "secondary_message": "2 shallots\n3 cloves garlic\n¾ tsp salt"
    },
    {
      "id": 420362,
      "primary_message": "Arrange tortillas on a flat surface. Place 2 tablespoons of cheese on one side of each tortilla, then fold in half to close.",
      "secondary_message": "12 small flour tortillas\n1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 420363,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 420364,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, add quesadillas and cook, flipping once, until cheese is melted and tortillas are golden, 1-1½ minutes per side. Remove to a plate.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 420365,
      "primary_message": "To serve, divide quesadillas between plates. Top with pico de gallo and enjoy!",
      "secondary_message": null
    }
  ],
