  "instructions": [
    {
      "id": 429013,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 429014,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 429015,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 ½ small pineapples\n6 red bell peppers"
    },
    {
      "id": 429016,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 429017,
      "primary_message": "While the rice is cooking, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a small bowl along with stir-fry sauce, hot sauce, and honey. Stir to combine the sauce and set aside. (Reserve remaining cilantro for serving.)",
      "secondary_message": "1 ½ cup stir-fry sauce\n¼ cup hot sauce\n2 tbsp honey"
    },
    {
      "id": 429018,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and medium dice the flesh. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 429019,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Add to the bowl with the pineapple. ",
      "secondary_message": null
    },
    {
      "id": 429020,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 429021,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pineapple and bell pepper; cook, stirring occasionally, until bell pepper is starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 429022,
      "primary_message": "Crumble the tofu with your fingers into the pot. Cook, stirring occasionally, until tofu is warmed through, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 429023,
      "primary_message": "Add the sauce to the pot. Continue to cook, stirring occasionally, until sauce thickens slightly, 2-3 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 429024,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls, then sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
