  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the onions medium. Mince the ginger. Mince the garlic. Juice the lemon.",
      "secondary_message": "2 medium onions\n1 (3 inch) knob ginger root, about 2 tablespoons\n6 medium cloves garlic, about 2 tablespoons\n½ lemon, to taste"
    },
    {
      "id": 1,
      "primary_message": "Melt niter kibbeh or butter in a heavy saucepan on medium heat, then add onions, ginger, garlic, and berbere. Reduce heat to medium-low and cook, stirring occasionally, until onions are dark, ruddy, and golden, about 30 minutes. Onions should be at a low sizzle during cooking process. Adjust heat accordingly. Transfer to food processor and blend until not quite a purée. Return to saucepan, season to taste with salt, and keep warm.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Season beef on all sides generously with kosher salt. Heat oil in a 12-inch cast iron or stainless steel skillet over high heat high until lightly smoking. Add beef in a single layer, leaving plenty of open space in the pan (brown in batches if you don't have a large enough skillet). Cook without moving until well-seared on one side, about 3 minutes. Flip meat cubes with tongs and cook on second side until well seared. Continue to cook meat, stirring and flipping occasionally until desired level of doneness is reached. For rare meat, transfer to saucepan immediately. For medium, cook an additional one to two minutes before transferring to saucepan. For well done, cook up to five more minutes before transferring to saucepan.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Toss beef with warm sauce, stir in lemon juice, and serve immediately.",
      "secondary_message": null
    }
  ],
