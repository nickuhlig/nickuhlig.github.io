  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the roasted peanuts.",
      "secondary_message": "½ cup roasted peanuts"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 190°C (375°F). Line bottom and two sides of 8- by 20-cm pan with foil or parchment paper, allowing ends to overhand sides. Lightly grease pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place butter in a large microwaveable bowl and microwave on low power until just starting to melt, about 30 seconds. Stir in sugar and salt until combined. Stir in peanut butter, then egg and vanilla. Add flour and baking soda to the bowl, then stir until combined. Stir in peanuts.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spread into pan and smooth top. Sprinkle with Reese's Pieces. Bake until golden and just set, and a toothpick inserted into the center comes out with fudgy crumbs, 20 to 25 minutes. Let cool in pan, about an hour. Lift blondies out of pan and slice.",
      "secondary_message": null
    }
  ],
