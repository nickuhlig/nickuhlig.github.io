  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ (142 g) pkg baby arugula"
    },
    {
      "primary_message": "Quarter, core, and medium dice pears. Transfer to one half of a baking sheet pan.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and medium dice beets. Add to the other half of the baking sheet with the pears. Drizzle pears and beets with oil, then season with spices. Stir to coat (keeping them separate), then spread each out into an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway, until pears and beets are fork-tender, 25-30 minutes. Remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, line a large plate with parchment paper.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pecans, sugar, cinnamon, and salt; cook, stirring occasionally, until pecans are fragrant and caramelized, 3-4 minutes. Transfer pecans to the plate and set aside to cool (they will continue to harden as they cool). ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 cup pecan halves\n3 tbsp granulated sugar\n½ tsp cinnamon, ground\n¼ tsp salt"
    },
    {
      "primary_message": "Peel and mince shallot and garlic. Place both in a small bowl along with oil, vinegar, Dijon, maple syrup, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 shallot\n2 clove garlic\nextra virgin olive oil\n3 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n1 tsp pumpkin spice mix\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "When the pecans have cooled, roughly chop. Return to the plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange arugula on a serving platter, then top with the roasted beets and pears, candied pecans, and apple chips.",
      "secondary_message": "43 g apple chips"
    },
    {
      "primary_message": "Drizzle dressing over the salad just before serving. Enjoy!",
      "secondary_message": null
    }
  ],
