  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Wash, hull, and chop the fresh strawberries. Juice the lemon.",
      "secondary_message": "1 ½ lb fresh strawberries\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Place half of the strawberries and 3 tablespoons sugar in small saucepan. Cook over medium-low heat, stirring, until berries have softened and slightly thickened, about 5 minutes. Remove from heat, stir in lemon juice; add sugar to taste. Chill completely before using, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, stir together remaining strawberries and 3 tablespoons sugar in a medium bowl. Chill, stirring occasionally, until berries have released some of their juice, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whip cream to soft peaks. Gently fold in yogurt and vanilla until combined. Reserve 1/4 cup whipped cream for garnish. Fold chilled strawberry compote into whipped cream.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spoon strawberry cream into glasses (see note) alternating with macerated strawberries. Top each with 1 tablespoon of the reserved whipped cream. Serve chilled.",
      "secondary_message": null
    }
  ],
