  "instructions": [
    {
      "primary_message": "This recipe uses Krustez cornbread and muffin mix; if using a different brand please adjust recipe ingredients and cooking times per package instructions.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry green onions and bell pepper. Trim and cut green onions crosswise into thin pieces; place in a small bowl and set aside for serving. Trim, seed, and medium dice bell pepper.",
      "secondary_message": "½ small bunch green onion (scallion)\n1 red bell pepper"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add bell pepper, beef, salt, and black pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "680 g lean ground beef\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, prepare cornbread mix according to package instructions, using milk, oil, and egg. Once the batter is prepared, add cheese and stir once more to combine. ",
      "secondary_message": "1 (425 g) box cornbread or muffin mix\n⅔ cup whole milk\n⅓ cup neutral vegetable oil\n1 egg\n2 cups cheddar cheese, shredded"
    },
    {
      "primary_message": "When the beef is done, add corn, tomato sauce, and taco seasoning to the skillet. Stir to combine, then transfer the beef mixture to a large baking dish, spreading out in an even layer. Top with cornbread mix and jalapeños. Place in the oven and bake until a toothpick inserted in the center of the cornbread comes out clean, about 25 minutes. Remove from oven.",
      "secondary_message": "1 (432 g) can whole kernel corn, canned\n213 ml tomato sauce\n1 (28 g) pkg taco seasoning"
    },
    {
      "primary_message": "To serve, divide cornbread bake between plates or bowls. Top with sour cream and green onions. Enjoy!",
      "secondary_message": "1 ½ cups sour cream"
    }
  ],
