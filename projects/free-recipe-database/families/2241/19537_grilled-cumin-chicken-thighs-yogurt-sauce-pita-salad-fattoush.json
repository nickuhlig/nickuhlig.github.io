  "instructions": [
    {
      "id": 325377,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 325378,
      "primary_message": "Place yogurt, mayo, water, and spices in a small bowl; whisk to combine the sauce and set aside. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp mayonnaise\n3 tbsp water\n¾ tsp paprika\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 325379,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n3 pints grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 ½ heads romaine lettuce"
    },
    {
      "id": 325380,
      "primary_message": "Zest lemons into a large bowl (reserve lemons for the dressing). Peel and mince garlic; add to the bowl along with oil and spices. Whisk to combine the marinade. ",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp cumin, ground\n1 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 325381,
      "primary_message": "Pat chicken dry with paper towels, add to the bowl with the marinade, and turn to coat; set aside. ",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 325382,
      "primary_message": "Place pita breads on a cutting board. Holding a knife parallel to the board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into 1-inch pieces and place in another large bowl.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 325383,
      "primary_message": "Add oil, salt, and pepper to the bowl with the pita; toss with your hands to coat. Divide between two large baking sheet pans and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 325384,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until the pita chips are crisp, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 325385,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325386,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add chicken; grill until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 325387,
      "primary_message": "While the chicken cooks, juice the lemons into the reserved bowl; add oil, Dijon, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 325388,
      "primary_message": "Trim and small dice cucumbers; halve tomatoes. Add both to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 325389,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 325390,
      "primary_message": "Just before serving, chop or tear lettuce into bite-sized pieces; add to the bowl, along with pita chips, and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 325391,
      "primary_message": "To serve, divide salad and chicken between plates or bowls; drizzle chicken with sauce and enjoy!",
      "secondary_message": null
    }
  ],
