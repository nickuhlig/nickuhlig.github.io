  "instructions": [
    {
      "id": 325362,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 325363,
      "primary_message": "Place yogurt, mayo, water, and spices in a small bowl; whisk to combine the sauce and set aside. ",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tbsp water\n½ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 325364,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 English cucumber\n2 pints grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 head romaine lettuce"
    },
    {
      "id": 325365,
      "primary_message": "Zest lemon into a medium bowl (reserve lemon for the dressing). Peel and mince garlic; add to the bowl along with oil and spices. Whisk to combine the marinade. ",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n2 tsp cumin, ground\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 325366,
      "primary_message": "Pat chicken dry with paper towels, add to the bowl with the marinade, and turn to coat; set aside. ",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 325367,
      "primary_message": "Place pita breads on a cutting board. Holding a knife parallel to the board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into 1-inch pieces and place in a large bowl.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 325368,
      "primary_message": "Add oil, salt, and pepper to the bowl with the pita; toss with your hands to coat. Transfer to a large baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 325369,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until the pita chips are crisp, 5-6 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 325370,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325371,
      "primary_message": "Once the grill pan is hot, add chicken; grill until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 325372,
      "primary_message": "While the chicken cooks, juice the lemon into the reserved bowl; add oil, Dijon, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 325373,
      "primary_message": "Trim and small dice cucumber; halve tomatoes. Add both to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 325374,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 325375,
      "primary_message": "Just before serving, chop or tear lettuce into bite-sized pieces; add to the bowl, along with pita chips, and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 325376,
      "primary_message": "To serve, divide salad and chicken between plates or bowls; drizzle chicken with sauce and enjoy!",
      "secondary_message": null
    }
  ],
