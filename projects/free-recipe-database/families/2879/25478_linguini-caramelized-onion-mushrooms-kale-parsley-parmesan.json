  "instructions": [
    {
      "id": 408580,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 408581,
      "primary_message": "While the pot heats up, peel, halve, and slice onions crosswise into thin half-moons.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 408582,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until soft and starting to brown, 8-10 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 408583,
      "primary_message": "Meanwhile, fill another large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "1 tsp salt\n10 oz linguine pasta"
    },
    {
      "id": 408584,
      "primary_message": "While the pasta is cooking, wash and dry the fresh produce.",
      "secondary_message": "1 lb cremini mushrooms\n2 bunches kale\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 408585,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 408586,
      "primary_message": "When the onions are browned, add more oil, mushrooms, and salt to the pot. Continue to cook, stirring occasionally, until mushrooms are soft and onions are caramelized, 7-9 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 408587,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 408588,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add half of the parsley to the bowl with the kale. (Set remaining parsley aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 408589,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 408590,
      "primary_message": "When the onions are caramelized, add kale, parsley, and garlic to the pot in handfuls, waiting for kale to wilt slightly before adding the next handful. Cook, stirring occasionally, until the kale is tender, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 408591,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 408592,
      "primary_message": "When the kale is tender, add drained pasta, reserved pasta water, half of the Parmesan, vinegar, and crushed red pepper to the pot. Continue to cook, tossing frequently, until heated through, 2-3 minutes. Remove from heat. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "2 tsp balsamic vinegar\n½ tsp crushed red pepper"
    },
    {
      "id": 408593,
      "primary_message": "To serve, divide pasta between plates or bowls; top with reserved Parmesan and parsley. Enjoy!",
      "secondary_message": null
    }
  ],
