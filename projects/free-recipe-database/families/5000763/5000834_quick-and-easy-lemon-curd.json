  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, combine lemon zest with granulated sugar, and use your fingers to rub them together until the mixture becomes fragrant, about 30 seconds. Set aside for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, set up an ice bath by partially filling it with a combination of cold water and ice. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium saucepan, bring lemon juice to a simmer over medium heat, about 3 minutes. Add eggs, yolks, and salt to bowl with lemon zest and sugar, and whisk together until smooth.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Slowly drizzle heated lemon juice into yolk mixture, whisking constantly, until all of it has been incorporated. Return mixture to saucepan and cook over medium heat, whisking slowly but frequently, until mixture thickens slightly and registers 170ºF (77ºC) on an instant-read thermometer, about 6 minutes. Remove from heat and whisk in butter until melted and curd is smooth.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Strain curd through a fine-mesh strainer set over a medium bowl. Using a flexible spatula, scrape any residual curd from the bottom of the stainer into the bowl. Press plastic wrap against the surface of the lemon curd and transfer bowl to prepared ice bath. Chill for 30 minutes, then refrigerate until cold, about 1 hour. Transfer to an airtight container for later use.",
      "secondary_message": null
    }
  ],
