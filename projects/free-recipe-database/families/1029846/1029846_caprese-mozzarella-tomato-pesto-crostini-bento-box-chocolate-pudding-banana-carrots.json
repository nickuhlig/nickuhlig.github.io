  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, and trim carrot. Quarter lengthwise, then cut crosswise into 2-inch long sticks. Place in the first small compartment of the bento box.",
      "secondary_message": "1 medium carrot"
    },
    {
      "primary_message": "Place (unpeeled) banana in the second small compartment of the bento box. ",
      "secondary_message": "½ banana"
    },
    {
      "primary_message": "Wash, dry, and slice tomato crosswise into 1/4-inch rounds. Place tomato and mozzarella in the medium compartment of the bento box, alternating slices.",
      "secondary_message": "½ Roma tomato\n3 oz fresh mozzarella cheese"
    },
    {
      "primary_message": "Place pesto in a small container with a lid. Place pesto, pudding, and crostini in the large compartment of the bento box.",
      "secondary_message": "2 tbsp basil pesto\n1 (3.6 oz) cup chocolate pudding snack\n½ cup crostini-style crackers"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
