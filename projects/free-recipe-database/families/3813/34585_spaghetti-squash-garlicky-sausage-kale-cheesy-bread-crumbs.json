  "instructions": [
    {
      "id": 545865,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 545866,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium spaghetti squash\n½ bunch kale\n½ lemon"
    },
    {
      "id": 545867,
      "primary_message": "Trim spaghetti squash, then halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 545868,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 545869,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 545870,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread crumbs and salt; cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ cup panko bread crumbs\n1 pinch salt"
    },
    {
      "id": 545871,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat. Once hot, add sausage and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "0.23 kg ground pork sausage"
    },
    {
      "id": 545872,
      "primary_message": "Meanwhile, peel and thinly slice garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 545873,
      "primary_message": "When the sausage is done, add garlic and crushed red pepper to the skillet. Cook, stirring often, until fragrant, about 1 minute. Remove from heat.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 545874,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the bread crumbs and stir to combine. Set aside.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 545875,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 545876,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. ",
      "secondary_message": null
    },
    {
      "id": 545877,
      "primary_message": "Return skillet with sausage to medium-high heat. Add kale to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until the kale is tender and the sausage is warmed through, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 545878,
      "primary_message": "Juice lemon into the skillet and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 545879,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands (use an oven mitt or towel to hold it with your other hand). Season with salt.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 545880,
      "primary_message": "To serve, divide spaghetti squash between plates or bowls. Top with sausage-kale sauté and cheesy bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
