  "instructions": [
    {
      "id": 322249,
      "primary_message": "Preheat oven to 450°F. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 322250,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ mangoes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n3 limes"
    },
    {
      "id": 322251,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 322252,
      "primary_message": "Add oil and spices to the bowl with the garlic; whisk to combine the spice oil.",
      "secondary_message": "⅓ cup extra virgin olive oil\n2 ½ tsp cumin, ground\n2 ½ tsp paprika\n2 ½ tsp chili powder\n¾ tsp salt"
    },
    {
      "id": 322253,
      "primary_message": "Cut leaves from each cauliflower, separate into bite-sized florets, and cut the thick stems into smaller pieces; add to the bowl with the spice oil and toss to coat. Divide between the baking sheets and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 322254,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until cauliflower is golden brown and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 322255,
      "primary_message": "Meanwhile, peel mangoes and slice flesh away from the pits, starting with the flat sides. Small dice and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 322256,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the mango. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 322257,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the bowl. (Place remaining cilantro in a small bowl and set aside for the sauce.)",
      "secondary_message": null
    },
    {
      "id": 322258,
      "primary_message": "Juice half of the limes into the bowl with the mango. Add broccoli slaw, pumpkin seeds, and salt; toss to combine the slaw and set aside. (Reserve remaining limes for the next step.)",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw\n1 cup pumpkin seeds\n¼ tsp salt"
    },
    {
      "id": 322259,
      "primary_message": "Juice reserved limes into the bowl with the cilantro; add yogurt and salt. Whisk to combine the sauce and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n¼ tsp salt"
    },
    {
      "id": 322260,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 322261,
      "primary_message": "To serve, divide tortillas between plates; fill with slaw, cauliflower, and sauce. Enjoy!",
      "secondary_message": null
    }
  ],
