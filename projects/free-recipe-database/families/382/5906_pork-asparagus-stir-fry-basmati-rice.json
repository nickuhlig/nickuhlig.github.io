  "instructions": [
    {
      "id": 71089,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "1 ½ cups basmati rice\n3 cups water\n⅜ tsp salt"
    },
    {
      "id": 71088,
      "primary_message": "Meanwhile, in a medium bowl, combine and whisk together the coconut aminos, rice vinegar, honey, sesame oil, and cornstarch.",
      "secondary_message": "6 tbsp coconut aminos\n3 tbsp rice vinegar\n3 tsp honey\n3 tsp toasted sesame oil\n3 tsp cornstarch"
    },
    {
      "id": 71087,
      "primary_message": "Once the water is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 15 to 18 minutes. Remove from the heat and let the rice stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 71086,
      "primary_message": "Thinly slice the pork chops crosswise into strips; transfer to a medium bowl.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 71085,
      "primary_message": "Pour about ½ of the sauce over the pork strips (save the rest for later). Toss the pork until coated with the sauce.",
      "secondary_message": ""
    },
    {
      "id": 71084,
      "primary_message": "Add water to the remaining sauce in the medium bowl and mix.",
      "secondary_message": "¾ cup water"
    },
    {
      "id": 71083,
      "primary_message": "Wash and dry the cutting board and the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 71082,
      "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears on an angle into 5-cm pieces. Transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 71081,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 71080,
      "primary_message": "Peel and mince or grate the ginger; transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 71079,
      "primary_message": "Peel and mince the garlic; add to the ginger.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 71078,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 71077,
      "primary_message": "Add the pork strips to the skillet and cook until browned, 2 to 3 minutes per side. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 71076,
      "primary_message": "Once the pork has been transferred, add more oil to the skillet.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 71075,
      "primary_message": "Add the garlic and ginger; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": ""
    },
    {
      "id": 71074,
      "primary_message": "Add the asparagus and cook, stirring occasionally, until bright green and tender-crisp, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 71073,
      "primary_message": "Return the pork to the skillet and pour in the remaining sauce; stir to combine. Cook, stirring frequently, until the sauce is thickened, 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 71072,
      "primary_message": "To serve, divide the rice between bowls and top with the stir fry. Enjoy!",
      "secondary_message": ""
    }
  ],
