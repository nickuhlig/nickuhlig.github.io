  "instructions": [
    {
      "id": 371544,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 371545,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium beets\n1 pear\n0.23 kg Brussels sprouts"
    },
    {
      "id": 371546,
      "primary_message": "Peel, trim, and small dice beets. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 371547,
      "primary_message": "Drain and rinse chickpeas. Add to the baking sheet with the beets, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer. ",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n1 tbsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 371548,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are golden and beets are fork-tender, 20-25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 371549,
      "primary_message": "Meanwhile, place oil, vinegar, maple syrup, and spices in a medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 tsp pure maple syrup\n¼ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 371550,
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 371551,
      "primary_message": "Quarter, core, and thinly slice pear. Add to the bowl and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 371552,
      "primary_message": "Just before serving, add pumpkin seeds and nutritional yeast to the bowl. Stir to combine the salad. ",
      "secondary_message": "¼ cup pumpkin seeds\n⅛ cup nutritional yeast flakes"
    },
    {
      "id": 371553,
      "primary_message": "To serve, divide salad between plates or bowls; top with warm chickpeas and beets. Enjoy!",
      "secondary_message": null
    }
  ],
