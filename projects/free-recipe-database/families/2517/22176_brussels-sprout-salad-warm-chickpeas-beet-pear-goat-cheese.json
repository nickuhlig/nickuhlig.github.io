  "instructions": [
    {
      "id": 371534,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 371535,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium beets\n3 pears\n0.68 kg Brussels sprouts"
    },
    {
      "id": 371536,
      "primary_message": "Peel, trim, and small dice beets. Divide between two large baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 371537,
      "primary_message": "Drain and rinse chickpeas. Add to the baking sheets with the beets, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n3 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 371538,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are golden and beets are fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 371539,
      "primary_message": "Meanwhile, place oil, vinegar, maple syrup, and spices in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n1 tbsp pure maple syrup\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 371540,
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 371541,
      "primary_message": "Quarter, core, and thinly slice pears. Add to the bowl and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 371542,
      "primary_message": "Just before serving, add pumpkin seeds to the bowl and stir to combine the salad. ",
      "secondary_message": "¾ cup pumpkin seeds"
    },
    {
      "id": 371543,
      "primary_message": "To serve, divide salad between plates or bowls; top with warm chickpeas and beets. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    }
  ],
