  "instructions": [
    {
      "primary_message": "Place chicken, soup, broth, sour cream, and Cajun seasoning in a 6-quart slow cooker insert. Stir to combine, then cover and cook until warmed through and flavors have blended, low for 4 hours or high for about 2 hours.",
      "secondary_message": "1 lb cooked chicken (shredded)\n2 (10.5 oz) can cheddar cheese soup\n1 cup chicken or vegetable broth\n½ cup sour cream\n1 tbsp Cajun seasoning"
    },
    {
      "primary_message": "When the cheesy chicken is done, add broccoli to the slow cooker insert and stir to combine. Set slow cooker to high and continue to cook until broccoli is fork-tender, about 30 minutes.",
      "secondary_message": "1 (18 oz) bag broccoli florets"
    },
    {
      "primary_message": "Meanwhile, preheat oven to 425°F and arrange rack in the center position. Place toast on the countertop to thaw slightly. Separate toast slices, arrange on a large baking sheet pan, and place in the preheated oven. Bake until golden and toasted, 5-7 minutes. Remove from oven.",
      "secondary_message": "8 slice frozen garlic toast (with cheese)"
    },
    {
      "primary_message": "Divide chicken, broccoli, and sauce between plates or bowls. Serve with garlic toast and enjoy!",
      "secondary_message": null
    }
  ],
