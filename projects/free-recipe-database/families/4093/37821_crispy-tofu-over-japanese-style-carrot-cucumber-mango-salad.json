  "instructions": [
    {
      "id": 591203,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 591204,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 English cucumbers\n3 mangoes\n1 small bunch green onions (scallions)\n1 ½ avocados"
    },
    {
      "id": 591205,
      "primary_message": "Place mayo, vinegar, hot sauce, maple syrup, and salt in a large bowl, then whisk to combine the dressing.",
      "secondary_message": "½ cup vegan mayonnaise\n1 ½ tsp rice vinegar\n1 ½ tsp hot sauce\n1 ½ tsp pure maple syrup\n¼ tsp salt"
    },
    {
      "id": 591206,
      "primary_message": "Peel and trim carrots; using a julienne (or regular) peeler, peel the carrots into noodle-like strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 591207,
      "primary_message": "Trim cucumbers; using a julienne (or regular) peeler, peel the cucumber into noodle-like strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 591208,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; cut lengthwise into ¼-inch thick pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 591209,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, along with bread crumbs, and toss to combine the salad. Set aside.",
      "secondary_message": "½ cup panko bread crumbs"
    },
    {
      "id": 591210,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591211,
      "primary_message": "While the skillet heats up, cut the tofu planks in half, then cut each half into 2 triangles; place in another large bowl. Sprinkle with cornstarch and spices on both sides.",
      "secondary_message": "3 tbsp cornstarch\n¾ tsp crushed red pepper\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 591212,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, flipping halfway through, until golden and crispy, 6-8 minutes. Remove from heat.",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 591213,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and slice lengthwise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 591214,
      "primary_message": "To serve, divide salad, tofu, and avocado between plates or bowls. Top with sesame seeds and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
