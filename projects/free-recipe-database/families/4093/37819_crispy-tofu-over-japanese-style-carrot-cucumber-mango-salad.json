  "instructions": [
    {
      "id": 591179,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 591180,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 English cucumber\n1 mango\n½ small bunch green onions (scallions)\n½ avocado"
    },
    {
      "id": 591181,
      "primary_message": "Place mayo, vinegar, hot sauce, maple syrup, and salt in a medium bowl, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp vegan mayonnaise\n½ tsp rice vinegar\n½ tsp hot sauce\n½ tsp pure maple syrup\n⅛ tsp salt"
    },
    {
      "id": 591182,
      "primary_message": "Peel and trim carrots; using a julienne (or regular) peeler, peel the carrots into noodle-like strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 591183,
      "primary_message": "Trim cucumber; using a julienne (or regular) peeler, peel the cucumber into noodle-like strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 591184,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; cut lengthwise into ¼-inch thick pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 591185,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, along with bread crumbs, and toss to combine the salad. Set aside.",
      "secondary_message": "3 tbsp panko bread crumbs"
    },
    {
      "id": 591186,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591187,
      "primary_message": "While the skillet heats up, cut the tofu planks in half, then cut each half into 2 triangles; place in another medium bowl. Sprinkle with cornstarch and spices on both sides.",
      "secondary_message": "1 tbsp cornstarch\n¼ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 591188,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, flipping halfway through, until golden and crispy, 6-8 minutes. Remove from heat.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 591189,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice lengthwise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 591190,
      "primary_message": "To serve, divide salad, tofu, and avocado between plates or bowls. Top with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
