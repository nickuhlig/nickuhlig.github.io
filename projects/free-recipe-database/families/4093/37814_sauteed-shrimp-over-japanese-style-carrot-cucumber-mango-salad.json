  "instructions": [
    {
      "id": 591121,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 English cucumbers\n2 mangoes\n1 small bunch green onions (scallions)\n1 avocado"
    },
    {
      "id": 591122,
      "primary_message": "Place mayo, vinegar, hot sauce, honey, and salt in a medium bowl, then whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n1 tsp rice vinegar\n1 tsp hot sauce\n1 tsp honey\n¼ tsp salt"
    },
    {
      "id": 591123,
      "primary_message": "Peel and trim carrots; using a julienne (or regular) peeler, peel the carrots into noodle-like strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 591124,
      "primary_message": "Trim cucumbers; using a julienne (or regular) peeler, peel the cucumber into noodle-like strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 591125,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; cut lengthwise into ¼-inch thick pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 591126,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, along with bread crumbs, and toss to combine the salad. Set aside.",
      "secondary_message": "⅓ cup panko bread crumbs"
    },
    {
      "id": 591127,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 591128,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591129,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp and spices; cook, stirring occasionally, until just opaque, 2-3 minutes. Remove from heat.",
      "secondary_message": "4 tsp neutral vegetable oil\n¼ tsp crushed red pepper\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 591130,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice lengthwise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 591131,
      "primary_message": "To serve, divide salad, shrimp, and avocado between plates or bowls. Top with sesame seeds and enjoy!",
      "secondary_message": "4 tsp sesame seeds"
    }
  ],
