  "instructions": [
    {
      "primary_message": "TO MAKE THE LEMON-HERB CREAM CHEESE: Cut cream cheese into small pieces, place in a medium bowl, and set aside to soften.",
      "secondary_message": "4 (227 g) block cream cheese"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ small bunch Italian (flat-leaf) parsley\n1 small bunch fresh dill\n1 small pkg chives"
    },
    {
      "primary_message": "Zest and juice lemon into the bowl with the cream cheese.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave parsley and dill leaves off the stems; discard stems and mince the leaves. Add herbs to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Chop chives into small pieces. Add to the bowl along with spices, then use a hand-held mixer or the back of a spoon to combine the cream cheese spread. Set aside.",
      "secondary_message": "1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Trim, peel, and slice cucumbers crosswise into thin rounds. Place on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange bread slices on a flat surface and spread each with lemon-herb cream cheese. Top half of the bread slices with cucumber, then close with the remaining slices, pressing gently to 'stick' the sandwiches together.",
      "secondary_message": "16 slice white bread\n16 slice whole grain bread"
    },
    {
      "primary_message": "Trim crusts from each sandwich, then cut a \"v\" pattern into the top, creating a \"tiara.\" (Don't waste these cut-outs, they are great for snacking!)",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange sandwiches on a platter and enjoy!",
      "secondary_message": null
    }
  ],
