  "instructions": [
    {
      "id": 152431,
      "primary_message": "Fill a large pot halfway with hot water from the tap, cover, and bring to a boil",
      "secondary_message": null
    },
    {
      "id": 152432,
      "primary_message": "Meanwhile, wash and dry the fresh produce. Peel and small dice carrots. Small dice zucchinis.",
      "secondary_message": "4 medium carrots\n2 medium zucchini squash"
    },
    {
      "id": 152433,
      "primary_message": "Add carrots to the pot and cook until fork-tender, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 152434,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 152435,
      "primary_message": "Add zucchini and gnocchi to the pot with the carrots; boil for 2 minutes more, then drain in a colander and set aside.",
      "secondary_message": "2 (454 g) pkgs potato gnocchi"
    },
    {
      "id": 152436,
      "primary_message": "Return pot to the stove over medium heat. Add butter and swirl to coat.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 152437,
      "primary_message": "Add garlic and flour; whisk until smooth. Gradually add broth; bring to a boil over high heat, then reduce heat and simmer, whisking occasionally, until sauce thickens, 3-4 minutes.",
      "secondary_message": "¼ cup all-purpose flour\n473 ml chicken or vegetable broth"
    },
    {
      "id": 152438,
      "primary_message": "Stir in the tomato sauce, cream, salt, and pepper. ",
      "secondary_message": "1 (213 ml) can tomato sauce\n118 ml (½ cup) heavy cream\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 152439,
      "primary_message": "Add gnocchi and vegetables back to the pot. Cook, stirring often, until heated through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 152440,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 152441,
      "primary_message": "Divide gnocchi between bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
