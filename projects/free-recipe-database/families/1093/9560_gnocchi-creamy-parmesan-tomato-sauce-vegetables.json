  "instructions": [
    {
      "id": 152420,
      "primary_message": "Fill a large pot halfway with hot water from the tap, cover, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "id": 152421,
      "primary_message": "Meanwhile, wash and dry the fresh produce. Peel and small dice carrots. Small dice zucchini.",
      "secondary_message": "2 medium carrots\n1 medium zucchini squash"
    },
    {
      "id": 152422,
      "primary_message": "Add carrots to the pot and cook until fork-tender, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 152423,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 152424,
      "primary_message": "Add zucchini and gnocchi to the pot with the carrots; boil for 2 minutes more, then drain in a colander and set aside.",
      "secondary_message": "1 (454 g) pkg potato gnocchi"
    },
    {
      "id": 152425,
      "primary_message": "Return pot to the stove over medium heat. Add butter and swirl to coat.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 152426,
      "primary_message": "Add garlic and flour; whisk until smooth. Gradually add broth; bring to a boil over high heat, then reduce heat and simmer, whisking occasionally, until sauce thickens, 2-3 minutes.",
      "secondary_message": "2 tbsp all-purpose flour\n237 ml chicken or vegetable broth"
    },
    {
      "id": 152427,
      "primary_message": "Stir in the tomato sauce, cream, salt, and pepper. ",
      "secondary_message": "½ (213 ml) can tomato sauce\n59 ml (¼ cup) heavy cream\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 152428,
      "primary_message": "Add gnocchi and vegetables back to the pot. Cook, stirring often, until heated through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 152429,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 152430,
      "primary_message": "Divide gnocchi between bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
