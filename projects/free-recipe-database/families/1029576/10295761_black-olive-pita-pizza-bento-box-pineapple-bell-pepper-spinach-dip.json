  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 400°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer pita to a baking sheet pan. Spread with sauce, then top with cheese and drained olives. \n\n",
      "secondary_message": "1 white pita bread\n¼ cup pizza sauce\n½ cup shredded cheese, Italian blend\n½ (64 g) can sliced black olives"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until cheese is melted, 8-10 minutes. Remove from oven and set aside to cool completely, 20-30 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell pepper; slice lengthwise into thin strips. Place in the medium compartment of the bento box.",
      "secondary_message": "½ red bell pepper"
    },
    {
      "primary_message": "Place spinach dip in the first small compartment of the bento box. ",
      "secondary_message": "¼ cup spinach dip"
    },
    {
      "primary_message": "Drain pineapple. Place in the second small compartment of the bento box. ",
      "secondary_message": "⅓ cup pineapple chunks"
    },
    {
      "primary_message": "When the pizza is cool, cut into wedges and place in the large compartment of the bento box.",
      "secondary_message": null
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
