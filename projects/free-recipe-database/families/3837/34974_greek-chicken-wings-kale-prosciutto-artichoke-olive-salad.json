  "instructions": [
    {
      "id": 551498,
      "primary_message": "Preheat oven to 260°C (500°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 551499,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch and spices, then toss to coat. Divide between the baking sheets, spread out in an even layer, and drizzle with oil.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed\n¼ cup cornstarch\n1 ½ tsp oregano, dried\n1 ½ tsp basil, dried\n¾ tsp paprika\n¾ tsp salt\n¾ tsp black pepper\n¼ tsp cayenne pepper\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 551500,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 551501,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 551502,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch fresh dill\n3 bunches kale\n3 red bell peppers"
    },
    {
      "id": 551503,
      "primary_message": "Once the skillet is hot, working in batches, add prosciutto in a single layer and cook until crispy, about 1 minute per side. Remove to a plate and set aside.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 551504,
      "primary_message": "Zest and juice lemons. Divide between a small and a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 551505,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Divide between both bowls with the lemon, then set the small bowl aside for later use.",
      "secondary_message": null
    },
    {
      "id": 551506,
      "primary_message": "Peel and mince garlic. Add to the large bowl along with oil, honey, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp honey\n1 ½ tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 551507,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 551508,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 551509,
      "primary_message": "Drain and roughly chop artichoke hearts and olives. Add both to the bowl.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated\n⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 551510,
      "primary_message": "Crumble or chop prosciutto into bite-sized pieces. Add to the bowl, along with feta, and toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    },
    {
      "id": 551511,
      "primary_message": "When the wings are done, remove from the oven. Drizzle with the reserved lemon and dill, then toss to coat.",
      "secondary_message": null
    },
    {
      "id": 551512,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
