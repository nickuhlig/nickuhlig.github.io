  "instructions": [
    {
      "id": 551423,
      "primary_message": "Preheat oven to 500°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 551424,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch and spices, then toss to coat. Transfer to the baking sheet, spread out in an even layer, and drizzle with oil.",
      "secondary_message": "1 lb chicken wings, split with tips removed\n1 ½ tbsp cornstarch\n½ tsp oregano, dried\n½ tsp basil, dried\n¼ tsp paprika\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp cayenne pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 551425,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 551426,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 551427,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch fresh dill\n1 bunch kale\n1 red bell pepper"
    },
    {
      "id": 551428,
      "primary_message": "Once the skillet is hot, add prosciutto in a single layer and cook until crispy, about 1 minute per side. Remove to a plate and set aside.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 551429,
      "primary_message": "Zest and juice lemon. Divide between a small and a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 551430,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Divide between both bowls with the lemon, then set the small bowl aside for later use.",
      "secondary_message": null
    },
    {
      "id": 551431,
      "primary_message": "Peel and mince garlic. Add to the medium bowl along with oil, honey, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n1 tsp honey\n½ tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 551432,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 551433,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 551434,
      "primary_message": "Drain and roughly chop artichoke hearts and olives. Add both to the bowl.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated\n⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 551435,
      "primary_message": "Crumble or chop prosciutto into bite-sized pieces. Add to the bowl, along with feta, and toss to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 551436,
      "primary_message": "When the wings are done, remove from the oven. Drizzle with the reserved lemon and dill, then toss to coat.",
      "secondary_message": null
    },
    {
      "id": 551437,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
