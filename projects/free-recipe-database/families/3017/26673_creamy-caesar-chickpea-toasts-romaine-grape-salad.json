  "instructions": [
    {
      "id": 431535,
      "primary_message": "Divide dressing between two large bowls. (Set one bowl aside for the romaine salad.)",
      "secondary_message": "1 cup Caesar dressing"
    },
    {
      "id": 431536,
      "primary_message": "Drain and rinse chickpeas. Add to the first bowl with the dressing along with salt and pepper. Using a fork or potato masher, roughly mash chickpeas until semi-smooth. Set aside. ",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 431537,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 431538,
      "primary_message": "Wash, dry, and halve grapes. Add to the second bowl with the dressing.",
      "secondary_message": "0.68 kg red grapes"
    },
    {
      "id": 431539,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "3 hearts romaine hearts"
    },
    {
      "id": 431540,
      "primary_message": "Divide bread between two baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 431541,
      "primary_message": "Divide toast between plates and top with chickpea salad. Serve with romaine salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
