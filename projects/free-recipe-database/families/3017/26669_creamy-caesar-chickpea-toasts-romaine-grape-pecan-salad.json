  "instructions": [
    {
      "id": 431505,
      "primary_message": "Divide dressing between one medium and one large bowl. (Set large bowl aside for the romaine salad.)",
      "secondary_message": "⅔ cup Caesar dressing"
    },
    {
      "id": 431506,
      "primary_message": "Drain and rinse chickpeas. Add to the medium bowl with the dressing along with salt and pepper. Using a fork or potato masher, roughly mash chickpeas until semi-smooth. Set aside. ",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 431507,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 431508,
      "primary_message": "Wash, dry, and halve grapes. Add to the large bowl with the dressing.",
      "secondary_message": "0.45 kg red grapes"
    },
    {
      "id": 431509,
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl. ",
      "secondary_message": "2 hearts romaine hearts"
    },
    {
      "id": 431510,
      "primary_message": "Roughly chop pecans and add to the bowl. Toss to combine the salad and set aside. ",
      "secondary_message": "¼ cup pecan halves"
    },
    {
      "id": 431511,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 431512,
      "primary_message": "Divide toast between plates and top with chickpea salad. Serve with romaine salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
