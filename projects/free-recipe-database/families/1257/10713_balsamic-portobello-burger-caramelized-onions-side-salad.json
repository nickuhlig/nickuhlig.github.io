  "instructions": [
    {
      "id": 186022,
      "primary_message": "Peel, halve, and thinly slice the onions into half rings.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 186023,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 186024,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onions and salt; cook, stirring occasionally, until soft and caramelized, 15-20 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 186025,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 caps portobello mushrooms\n1 ½ heads romaine lettuce\n3 tomatoes\n1 ½ English cucumbers"
    },
    {
      "id": 186026,
      "primary_message": "Peel and mince garlic; place in a large bowl along with oil, vinegar, and Italian seasoning. Whisk to combine the marinade.",
      "secondary_message": "6 cloves garlic\n¼ cup extra virgin olive oil\n¼ cup balsamic vinegar\n1 tbsp Italian seasoning"
    },
    {
      "id": 186027,
      "primary_message": "Remove mushroom stems and carefully scrape out the gills. Add to the bowl with the marinade and turn to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 186028,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 186029,
      "primary_message": "While the skillet heats up, combine mayo, oil, Dijon, garlic powder, and salt in a small bowl. Whisk to combine the aioli and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 186030,
      "primary_message": "Once the skillet is hot, add mushrooms and cook until soft, 3-5 minutes per side. (Reserve bowl with leftover marinade for the next step.) When mushrooms are cooked, slice the cheese, place on top of mushroom caps, and reduce heat to low. Cover and let cook until cheese melts, 2-3 minutes. Remove from heat. Cook in batches if necessary.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 186031,
      "primary_message": "Meanwhile, add oil, vinegar, honey, Dijon, and salt to the bowl with leftover marinade. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 ½ tsp honey\n1 ½ tsp Dijon mustard\n¼ tsp salt"
    },
    {
      "id": 186032,
      "primary_message": "Separate the lettuce leaves. Set aside 1 large leaf per burger; chop or tear remaining leaves into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 186033,
      "primary_message": "Medium dice two tomatoes and add to the salad bowl. Thinly slice remaining tomato and set aside.",
      "secondary_message": null
    },
    {
      "id": 186034,
      "primary_message": "Trim and medium dice the cucumbers; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 186035,
      "primary_message": "Toast buns if desired. Spread aioli on bottom half of each bun; layer with reserved lettuce, tomato, mushrooms, and caramelized onions. Close with the top half. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 186036,
      "primary_message": "To serve, divide burgers and salad between plates and enjoy!",
      "secondary_message": null
    }
  ],
