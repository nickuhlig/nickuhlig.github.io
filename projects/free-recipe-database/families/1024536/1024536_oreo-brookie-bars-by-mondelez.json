  "instructions": [
    {
      "primary_message": " Heat oven to 350°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Line 13 x 9-inch pan with foil, with ends of foil extending over sides; spray with cooking spray. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Prepare brownie batter as directed on package; pour into prepared pan. ",
      "secondary_message": null
    },
    {
      "primary_message": "Place OREO® cookies in single layer over batter. Bake for 10 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Crumble sugar cookie dough over partially baked brownie batter.",
      "secondary_message": null
    },
    {
      "primary_message": "Bake for 15-20 minutes or until toothpick inserted in center comes out with fudgy crumbs. (Do not overbake.)",
      "secondary_message": null
    },
    {
      "primary_message": "Cool completely. Use foil handles to remove brownie from pan before cutting to serve.",
      "secondary_message": null
    }
