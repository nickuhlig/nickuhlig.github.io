  "instructions": [
    {
      "id": 263381,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ pint grape tomatoes\n1 bunch kale"
    },
    {
      "id": 263382,
      "primary_message": "Peel and mince garlic; mince anchovy fillets. Divide both evenly between two medium bowls; set one bowl aside.",
      "secondary_message": "2 cloves garlic\n2 anchovy fillets, packed in oil"
    },
    {
      "id": 263383,
      "primary_message": "Add beef, salt, and pepper to the first bowl with garlic and anchovy; use your hands to thoroughly combine. Using a ¼-cup measure, form into equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "¾ lb lean ground beef\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 263384,
      "primary_message": "Zest and juice lemon into the second bowl with garlic and anchovy. Add mayo and whisk to combine the dressing.",
      "secondary_message": "2 tbsp avocado oil mayonnaise"
    },
    {
      "id": 263385,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 263386,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces, add to the bowl, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 263387,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263388,
      "primary_message": "Once the grill pan is hot, coat with oil. Place burger patties on the grill and cook, undisturbed, for 4 minutes; flip patties, and grill an additional 2-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 263389,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 263390,
      "primary_message": "To serve, divide salad between plates; top with burger patties and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
