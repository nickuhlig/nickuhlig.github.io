  "instructions": [
    {
      "id": 44256,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n½ tsp salt\n2 cups water"
    },
    {
      "id": 44257,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (8 oz) pkg sugar snap peas\n1 small bunch green onions (scallions)"
    },
    {
      "id": 44258,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 44259,
      "primary_message": "Halve the sugar snap peas at an angle and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 44260,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 44261,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the snap peas.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 44262,
      "primary_message": "Drain the tofu and pat dry with paper towels; cut into ¾-inch cubes.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 44263,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 44264,
      "primary_message": "Add the sesame seeds to the skillet; toast, stirring frequently, until golden brown, 2 to 3 minutes. Once done, transfer to a small bowl.",
      "secondary_message": "2 tsp sesame seeds"
    },
    {
      "id": 44265,
      "primary_message": "Once the sesame seeds have been transferred, increase the heat to medium-high and add coconut oil to the skillet.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 44266,
      "primary_message": "Add the tofu to the skillet; cook, stirring occasionally, until golden brown, 4 to 6 minutes. Once done, transfer to a bowl.",
      "secondary_message": null
    },
    {
      "id": 44267,
      "primary_message": "Once the tofu has been transferred, add more coconut oil to the skillet, followed by the snap peas and garlic. Cook, stirring frequently, until the peas are bright green and slightly softened, 2 to 3 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 44268,
      "primary_message": "In a medium bowl, combine and whisk together cornstarch, water, soy sauce, rice vinegar, honey, and sesame oil.",
      "secondary_message": "2 tsp cornstarch\n6 tbsp water\n4 tbsp soy sauce\n1 tbsp rice vinegar\n2 tsp honey\n1 tsp toasted sesame oil"
    },
    {
      "id": 44269,
      "primary_message": "Return the tofu to the skillet, add about ¾ of the green onions (save the rest for garnishing), and pour in the sauce. Cook, stirring constantly, until the mixture is well coated with the sauce, 1 to 2 minutes. Once done, remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 44270,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 44271,
      "primary_message": "To serve, divide the rice between bowls, top with the stir fry, and sprinkle with the remaining green onions and toasted sesame seeds. Enjoy!",
      "secondary_message": null
    }
  ],
