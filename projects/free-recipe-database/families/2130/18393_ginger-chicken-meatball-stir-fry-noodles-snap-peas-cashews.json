  "instructions": [
    {
      "id": 301296,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 301297,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "10 oz flat rice (pad thai) noodles"
    },
    {
      "id": 301298,
      "primary_message": "Meanwhile, place soy sauce, fish sauce, water, honey, and spices in a small bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup soy sauce\n2 tbsp fish sauce\n2 tbsp water\n4 tsp honey\n1 tsp garlic powder\n½ tsp black pepper\n⅛ tsp clove, ground\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 301299,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 medium carrots\n2 (8 oz) pkg sugar snap peas\n1 small bunch green onions (scallions)\n1 small bunch cilantro"
    },
    {
      "id": 301300,
      "primary_message": "Peel and mince ginger; place in a medium bowl along with chicken, additional soy sauce, and pepper. Using your hands, mix well to combine.",
      "secondary_message": "1 lb ground chicken\n2 tsp soy sauce\n½ tsp black pepper"
    },
    {
      "id": 301301,
      "primary_message": "Using a tablespoon measure, form the chicken mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 301302,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301303,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Transfer to a clean plate and loosely cover with aluminum foil. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 301304,
      "primary_message": "Meanwhile, peel, trim, and slice carrots crosswise into thin rounds; halve snap peas crosswise. Place both in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 301305,
      "primary_message": "Trim and slice green onions crosswise into ¼-inch pieces; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 301306,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and stir-fry until fork-tender, 3-4 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 301307,
      "primary_message": "While the veggies are cooking, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 301308,
      "primary_message": "When the veggies are done, add noodles, sauce, and cilantro to the skillet; cook, stirring frequently, until the noodles are coated and warmed through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 301309,
      "primary_message": "Meanwhile, roughly chop cashews.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 301310,
      "primary_message": "To serve, divide noodles, veggies, and meatballs between bowls; top with cashews and enjoy!",
      "secondary_message": null
    }
  ],
