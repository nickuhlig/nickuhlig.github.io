  "instructions": [
    {
      "id": 301485,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 301486,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 301487,
      "primary_message": "Meanwhile, place soy sauce, fish sauce, water, honey, and spices in a small bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp fish sauce\n3 tbsp water\n2 tbsp honey\n1 ½ tsp garlic powder\n¾ tsp black pepper\n3 pinch clove, ground\n3 pinch cinnamon, ground"
    },
    {
      "id": 301488,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 medium carrots\n3 (227 g) pkg sugar snap peas\n2 small bunches green onions (scallions)\n1 small bunch cilantro"
    },
    {
      "id": 301489,
      "primary_message": "Peel and mince ginger; place in a medium bowl along with chicken, additional soy sauce, and pepper. Using your hands, mix well to combine.",
      "secondary_message": "0.68 kg ground chicken\n1 tbsp soy sauce\n¾ tsp black pepper"
    },
    {
      "id": 301490,
      "primary_message": "Using a tablespoon measure, form the chicken mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 301491,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301492,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; working in batches if necessary, add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Transfer to a clean plate and loosely cover with foil. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 301493,
      "primary_message": "Meanwhile, peel, trim, and slice carrots crosswise into thin rounds; halve snap peas crosswise. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 301494,
      "primary_message": "Trim and slice green onions crosswise into ¼-inch pieces; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 301495,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and stir-fry until fork-tender, 4-5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 301496,
      "primary_message": "While the veggies are cooking, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 301497,
      "primary_message": "When the veggies are done, add noodles, sauce, and cilantro to the pot; cook, stirring frequently, until the noodles are coated and warmed through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 301498,
      "primary_message": "Meanwhile, roughly chop cashews.",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 301499,
      "primary_message": "To serve, divide noodles, veggies, and meatballs between bowls; top with cashews and enjoy!",
      "secondary_message": null
    }
  ],
