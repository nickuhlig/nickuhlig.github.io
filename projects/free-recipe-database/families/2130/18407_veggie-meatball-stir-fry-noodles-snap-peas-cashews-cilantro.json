  "instructions": [
    {
      "id": 301500,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 301501,
      "primary_message": "Once the water in the pan is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "142 g flat rice (pad thai) noodles"
    },
    {
      "id": 301502,
      "primary_message": "Meanwhile, place soy sauce, water, maple syrup, and spices in a small bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "3 tbsp soy sauce\n1 tbsp water\n2 tsp pure maple syrup\n½ tsp garlic powder\n¼ tsp black pepper\n1 pinch clove, ground\n1 pinch cinnamon, ground"
    },
    {
      "id": 301503,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 medium carrot\n1 (227 g) pkg sugar snap peas\n½ small bunch green onions (scallions)\n½ small bunch cilantro"
    },
    {
      "id": 301504,
      "primary_message": "Peel and mince ginger; place in a medium bowl along with veggie ground and pepper. Using your hands, mix well to combine.",
      "secondary_message": "227 g veggie ground, plant based\n¼ tsp black pepper"
    },
    {
      "id": 301505,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 301506,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301507,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Transfer to a clean plate and loosely cover with aluminum foil. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 301508,
      "primary_message": "Meanwhile, peel, trim, and slice carrot crosswise into thin rounds; halve snap peas crosswise. Place both in another small bowl.",
      "secondary_message": null
    },
    {
      "id": 301509,
      "primary_message": "Trim and slice green onions crosswise into ¼-inch pieces; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 301510,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and stir-fry until fork-tender, 3-4 minutes.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 301511,
      "primary_message": "While the veggies are cooking, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 301512,
      "primary_message": "When the veggies are done, add noodles, sauce, and cilantro to the skillet; cook, stirring frequently, until the noodles are coated and warmed through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 301513,
      "primary_message": "To serve, divide noodles, veggies, and meatballs between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
