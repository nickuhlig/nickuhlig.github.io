  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the onions.",
      "secondary_message": "4 medium onions"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat the oven to 245°C (475°F). Shape dough into ball and place in medium bowl coated lightly with olive oil or nonstick spray. Cover tightly with plastic and set aside at room temperature.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine anchovy filets and milk in small bowl and set aside. Add 2 tablespoons olive oil to heavy-bottomed 30-cm sauté pan and heat over medium-high heat until shimmering. Add onions and season to taste with salt. Reduce heat to low and cook, stirring frequently until golden brown, about 40 minutes. If onions start to turn black, stir in one tablespoon water and continue to cook. Transfer to small bowl and allow to cool to room temperature.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Roll dough on well-floured work surface with rolling pin into even circle about 30-cm in diameter and 1.5-cm thick. Transfer to rimmed baking sheet. Spread onions evenly over surface, leaving one-inch border.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Rinse anchovies gently in running water. Scatter anchovies, olives, and thyme sprigs over surface of pizza (see note) Season lightly with salt (anchovies and olives are salty), and drizzle with remaining tablespoon olive oil. Bake until the crust is golden, puffed, and crisp, about 15 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
