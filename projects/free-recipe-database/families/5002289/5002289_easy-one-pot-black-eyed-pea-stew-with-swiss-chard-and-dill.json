  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the red onion. Peel and finely chop the carrot. Mince the garlic. Drain the diced tomatoes. Drain and rinse the black-eyed peas. Stem and chop the Swiss Chard.",
      "secondary_message": "1 medium red onion\n1 medium carrot\n4 medium cloves garlic\n1 (15 oz) can diced tomatoes\n2 (15 oz) cans black-eyed peas\n1 medium bunch Swiss Chard"
    },
    {
      "id": 1,
      "primary_message": "In a large pot, heat oil over medium-high heat until shimmering. Add onion, fennel, carrot, and 1 teaspoon kosher salt. Cook, stirring occasionally, until vegetables soften, 7 to10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in garlic, paprika, cumin, and black pepper, and cook until fragrant, about 1 minute. Add diced tomatoes, and cook, stirring constantly and scraping up any browned bits on bottom of skillet, until tomatoes start to simmer, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in black-eyed peas, broth, and remaining 1 1/2 teaspoons kosher salt. Bring to a boil over medium-high heat. Reduce heat to a simmer, and cook, stirring occasionally, until flavors meld and mixture slightly thickens, 8 to 10 minutes. Add Swiss chard and cook until it turns bright green, about 2 minutes. Remove from heat and then stir in dill and lemon juice.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Divide stew evenly among 4 bowls. Top each bowl with 1 tablespoon yogurt and sprinkle evenly with dill, black pepper, and olive oil. Serve.",
      "secondary_message": null
    }
  ],
