  "instructions": [
    {
      "id": 9182,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": ""
    },
    {
      "id": 9183,
      "primary_message": "Grate ⅛ cup of Parmesan.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 9184,
      "primary_message": "In a bowl, mix together ½ of the Parmesan, bread crumbs, and salt.",
      "secondary_message": "¼ cup panko bread crumbs\n⅛ tsp salt"
    },
    {
      "id": 9185,
      "primary_message": "In a different bowl, whisk egg.",
      "secondary_message": "1 egg"
    },
    {
      "id": 9186,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 9187,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "0.227 kg chicken breasts, boneless skinless\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 9188,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Dip each fillet into the egg, then in the bread mixture, pressing gently to adhere. Place in skillet and cook until golden brown, 2-3 minutes per side. (The chicken will finish cooking in the oven.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 9189,
      "primary_message": "Grate ½ cup of mozzarella.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 9191,
      "primary_message": "Pour ½ of the tomato sauce in a small baking dish, add chicken, and pour remainder of the sauce over top. Sprinkle chicken fillets with mozzarella and remaining Parmesan.",
      "secondary_message": "1 (213 ml) can tomato sauce"
    },
    {
      "id": 9192,
      "primary_message": "Place in the oven and bake until chicken is cooked through, cheese is melted and sauce is bubbly, 10-15 minutes. ",
      "secondary_message": ""
    },
    {
      "id": 9193,
      "primary_message": "In a medium bowl, prepare dressing by whisking together oil, vinegar, honey, salt, and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tbsp balsamic vinegar\n⅛ tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 9194,
      "primary_message": "Wash and dry spinach. Add to bowl with dressing and toss to coat.",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 9190,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 9195,
      "primary_message": "To serve, place chicken on a plate and have spinach salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
