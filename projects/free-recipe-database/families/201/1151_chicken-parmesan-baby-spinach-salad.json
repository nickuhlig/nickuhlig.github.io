  "instructions": [
    {
      "id": 9224,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 9225,
      "primary_message": "Grate ¼ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 9226,
      "primary_message": "In a bowl, mix together ½ of the Parmesan, bread crumbs, and salt.",
      "secondary_message": "½ cup panko bread crumbs\n¼ tsp salt"
    },
    {
      "id": 9227,
      "primary_message": "In a different bowl, whisk eggs.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 9228,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 9229,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "1 lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 9230,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Dip each fillet into the egg, then in the bread mixture, pressing gently to adhere. Place in skillet and cook until golden brown, 2-3 minutes per side. Work in batches if necessary. (The chicken will finish cooking in the oven.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 9231,
      "primary_message": "Grate 1 cup of mozzarella.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 9233,
      "primary_message": "Pour ½ of the tomato sauce in a medium baking dish, add chicken, and pour remainder of the sauce over top. Sprinkle chicken fillets with mozzarella and remaining Parmesan.",
      "secondary_message": "2 (8 oz) cans tomato sauce"
    },
    {
      "id": 9234,
      "primary_message": "Place in the oven and bake until chicken is cooked through, cheese is melted and sauce is bubbly, 10-15 minutes. ",
      "secondary_message": ""
    },
    {
      "id": 9235,
      "primary_message": "In a large bowl, prepare dressing by whisking together oil, vinegar, honey, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n¼ tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 9236,
      "primary_message": "Wash and dry spinach. Add to bowl with dressing and toss to coat.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 9232,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 9237,
      "primary_message": "To serve, divide chicken and spinach salad between plates and garnish with parsley. Enjoy! ",
      "secondary_message": ""
    }
  ],
