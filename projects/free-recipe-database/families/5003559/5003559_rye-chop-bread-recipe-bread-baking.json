  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine the rye chops, water, yeast, and sugar in the bowl of your stand mixer. Stir to combine and set aside for 20 minutes. Add the bread flour and salt, and knead until the dough is elastic. Add the oil and continue kneading until it is completely incorporated.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Form the dough into a ball, drizzle with olive oil, and return it to the bowl. Cover with plastic wrap, and set aside until doubled, about an hour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat the oven to 350 degrees and line a baking sheet with parchment paper.\nFlour your work surface and turn out the dough. Form it into your preferred shape - round or oval. Place it on the prepared baking sheet and cover it with plastic wrap. Set aside until it doubles in size, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Slash the loaf as desired and bake at 350 degrees until nicely browned, about 45 minutes. Let cool on a rack before slicing.",
      "secondary_message": null
    }
  ],
