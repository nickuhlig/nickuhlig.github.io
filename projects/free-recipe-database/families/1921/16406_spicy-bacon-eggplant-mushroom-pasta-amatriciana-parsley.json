  "instructions": [
    {
      "id": 268605,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n5 oz penne pasta"
    },
    {
      "id": 268606,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n¼ lb white mushrooms\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 268607,
      "primary_message": "Trim and small dice eggplant; quarter mushrooms. Transfer both to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 268608,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 268609,
      "primary_message": "While the skillet heats up, small dice bacon. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 268610,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": null
    },
    {
      "id": 268611,
      "primary_message": "While the bacon cooks, using a clean cutting board, peel and mince shallot and garlic. ",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 268612,
      "primary_message": "Return the skillet (with bacon drippings) to medium heat. Once the skillet is hot, add eggplant, mushrooms, shallot, garlic, and salt; cook, stirring occasionally, until eggplant and mushrooms are soft and golden, 7-8 minutes. ",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 268613,
      "primary_message": "When the pasta is done, drain in a colander and return to the pan; cover and set aside. ",
      "secondary_message": null
    },
    {
      "id": 268614,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 268615,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 268616,
      "primary_message": "When the veggies are done, add tomato sauce and spices to skillet. Stir to combine the veggie sauce and bring to a simmer; cook, stirring occasionally, until warmed through, about 2 minutes.",
      "secondary_message": "1 (8 oz) can tomato sauce\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 268617,
      "primary_message": "Add veggie sauce, bacon, and half of the parsley (reserving the rest for garnish) to the pan with the pasta; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 268618,
      "primary_message": "To serve, divide pasta between plates or bowls; top with reserved parsley, additional crushed red pepper, and Parmesan. Enjoy! ",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
