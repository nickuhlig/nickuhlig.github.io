  "instructions": [
    {
      "id": 238172,
      "primary_message": "In a small saucepan, bring broth to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the broth. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n¾ cup polenta (cornmeal)"
    },
    {
      "id": 238173,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ jalapeño pepper\n½ orange bell pepper\n½ pint grape tomatoes\n½ bunch radish\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 238174,
      "primary_message": "Juice lime into a medium bowl. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 238175,
      "primary_message": "Peel and mince garlic. Peel, halve, and thinly slice shallot into half-moons; add both to the bowl with the dressing.",
      "secondary_message": "1 clove garlic\n1 shallot"
    },
    {
      "id": 238176,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons; add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 238177,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 238178,
      "primary_message": "Halve tomatoes and add to the bowl. Trim, halve, and slice radishes into thin half-moons. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 238179,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 238180,
      "primary_message": "Preheat another small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 238181,
      "primary_message": "While the pan heats up, drain and rinse beans in a colander.",
      "secondary_message": "1 (15 oz) can pinto beans"
    },
    {
      "id": 238182,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add beans and spices to the pan; cook, stirring occasionally, until beans are warmed through, 2-3 minutes. Cover and remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp cumin, ground\n¼ tsp paprika\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 238183,
      "primary_message": "Add yeast, salt, and pepper to the polenta and stir to combine; if the polenta is too firm, add hot water, 1 tablespoon at a time, until you reach a desired consistency. Cover and remove from heat.",
      "secondary_message": "⅛ cup nutritional yeast flakes\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 238184,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 238185,
      "primary_message": "To serve, divide polenta, beans, and salad between bowls. Top with avocado and enjoy!",
      "secondary_message": null
    }
  ],
