  "instructions": [
    {
      "id": 238157,
      "primary_message": "In a large pot, bring broth to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the broth. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n2 ¼ cups polenta (cornmeal)"
    },
    {
      "id": 238158,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 ½ jalapeño peppers\n1 ½ orange bell peppers\n1 ½ pints grape tomatoes\n1 ½ bunches radish\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 238159,
      "primary_message": "Juice limes into a large bowl. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 238160,
      "primary_message": "Peel and mince garlic. Peel, halve, and thinly slice onion into half-moons; add both to the bowl with the dressing.",
      "secondary_message": "3 cloves garlic\n½ medium red onion"
    },
    {
      "id": 238161,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons; add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 238162,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 238163,
      "primary_message": "Halve tomatoes and add to the bowl. Trim, halve, and slice radishes into thin half-moons. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 238164,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 238165,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 238166,
      "primary_message": "While the skillet heats up, drain and rinse beans in a colander.",
      "secondary_message": "3 (15 oz) cans pinto beans"
    },
    {
      "id": 238167,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beans and spices to the skillet; cook, stirring occasionally, until beans are warmed through, 2-3 minutes. Cover and remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 238168,
      "primary_message": "While the beans are cooking, coarsely grate the cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 238169,
      "primary_message": "Add cheese, salt, and pepper to the polenta and stir to combine; if the polenta is too firm, add hot water, a few tablespoons at a time, until you reach a desired consistency. Cover and remove from heat.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 238170,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 238171,
      "primary_message": "To serve, divide polenta, beans, and salad between bowls. Top with avocado and enjoy!",
      "secondary_message": null
    }
  ],
