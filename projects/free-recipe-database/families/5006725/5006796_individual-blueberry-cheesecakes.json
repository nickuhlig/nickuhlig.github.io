  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, blend together crumbs and butter until combined. Divide mixture between two 227 g mugs and press into bottom with fingers. Place mugs in freezer and let chill for ten minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, beat together cream cheese and condensed milk until combined. Add lemon juice and vanilla and beat to incorporate.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Take mugs out of freezer and line bottom of each with blueberries. Cover blueberries with filling and smooth top with a knife.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cover mugs and let rest in refrigerator for 3 hours, then serve.",
      "secondary_message": null
    }
  ],
