      "ingredient_id": 1019,
      "name": "finely crushed graham cracker crumbs",
      "quantity": "½ cup"
    },
    {
      "ingredient_id": 115,
      "name": "unsalted butter, melted",
      "quantity": "2 tbsp"
    },
    {
      "ingredient_id": 355,
      "name": "cream cheese, at room temperature",
