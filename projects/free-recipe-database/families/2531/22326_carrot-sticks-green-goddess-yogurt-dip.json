  "instructions": [
    {
      "id": 373322,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small pkg chives\n1 small bunch cilantro\n9 medium carrots"
    },
    {
      "id": 373323,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 373324,
      "primary_message": "Roughly chop chives. Add to the blender.",
      "secondary_message": null
    },
    {
      "id": 373325,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 373326,
      "primary_message": "Add yogurt, oil, capers, and spices to the blender. Blend on high until smooth, adding water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n¼ cup extra virgin olive oil\n1 ½ tbsp capers\n2 tsp parsley flakes\n2 tsp dill, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 373327,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks.",
      "secondary_message": null
    },
    {
      "id": 373328,
      "primary_message": "To serve, divide carrots and dip between plates. Enjoy!",
      "secondary_message": null
    }
  ],
