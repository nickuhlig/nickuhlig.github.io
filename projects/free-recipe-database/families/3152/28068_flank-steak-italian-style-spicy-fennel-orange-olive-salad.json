  "instructions": [
    {
      "id": 449775,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 oranges\n6 fennel bulbs\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 449776,
      "primary_message": "Mince anchovy fillets. Place in a large bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "6 anchovy fillets, packed in oil\n¼ cup extra virgin olive oil\n¼ cup red wine vinegar\n¾ tsp salt\n½ tsp oregano, dried\n½ tsp crushed red pepper"
    },
    {
      "id": 449777,
      "primary_message": "Place steak on a large plate, season with salt and pepper on both sides, then drizzle with half of the dressing. Turn to coat and set aside to marinate, 15 minutes. (Reserve remaining dressing for the next step.)",
      "secondary_message": "1.02 kg flank steaks\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 449778,
      "primary_message": "While the steak is marinating, peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the remaining dressing. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 449779,
      "primary_message": "Halve olives lengthwise and add to the bowl. ",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 449780,
      "primary_message": "Cut off skin and white pith from oranges; slice between the membranes to release segments. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 449781,
      "primary_message": "When the steak is done marinating, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 449782,
      "primary_message": "Once the skillet is hot, working in batches, add steak and cook until desired doneness, 2-4 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 449783,
      "primary_message": "Meanwhile, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the olives and orange segments.",
      "secondary_message": null
    },
    {
      "id": 449784,
      "primary_message": "Pick parsley leaves off the stems; discard stems. Add leaves to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 449785,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 449786,
      "primary_message": "To serve, divide steak and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
