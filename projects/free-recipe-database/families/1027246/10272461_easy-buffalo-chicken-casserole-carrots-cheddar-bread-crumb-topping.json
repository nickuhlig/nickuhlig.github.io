  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add noodles, and stir for a few seconds; cook until desired firmness, 5-7 minutes. Drain noodles and set aside.",
      "secondary_message": "1 tsp salt\n283 g egg noodles, wide"
    },
    {
      "primary_message": "Meanwhile, place chicken on a cutting board and, using your hands, remove meat from the skin and bones; separate the meat into shred-like pieces. Transfer chicken to a large baking dish, then add soup, carrots, hot sauce, and seasoning. Stir to combine and set aside. ",
      "secondary_message": "1 (532 g) whole chicken rotisserie chicken, white and dark meat\n2 (283 g) can condensed cream of celery soup\n1 (283 g) bag shredded carrots\n½ cup hot sauce\n2 tsp herb and garlic seasoning"
    },
    {
      "primary_message": "Place cheddar, bread crumbs, and additional seasoning in a medium bowl. Stir to combine the topping.",
      "secondary_message": "2 cups cheddar cheese, shredded\n1 cup panko bread crumbs\n2 tsp herb and garlic seasoning"
    },
    {
      "primary_message": "When the noodles are done, add to the baking dish with the chicken and stir once more to combine. Sprinkle with the cheddar topping.",
      "secondary_message": null
    },
    {
      "primary_message": "Place baking dish in the oven and bake until the casserole is warmed through and topping is golden, 35-40 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide casserole between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
