  "instructions": [
    {
      "id": 175186,
      "primary_message": "In a medium saucepan, combine quinoa and broth. Bring to a boil. Reduce heat to low, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 175187,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 eggplants\n9 tomatoes\n3 red bell peppers\n3 medium zucchini squash\n1 small pkg fresh basil\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 175188,
      "primary_message": "Trim ends and medium dice eggplants. Transfer to a medium bowl, add salt, and toss to coat; set aside.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 175189,
      "primary_message": "Medium dice tomatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 175190,
      "primary_message": "Seed and medium dice bell peppers; add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 175191,
      "primary_message": "Trim ends and medium dice zucchini; add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 175192,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "1 ½ medium red onions\n6 cloves garlic"
    },
    {
      "id": 175193,
      "primary_message": "Preheat a large pot over medium heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 175194,
      "primary_message": "Add onion and garlic. Stirring frequently, cook until onion begins to soften, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 175195,
      "primary_message": "Using a clean towel or paper towel, squeeze the eggplant to release excess moisture. Add eggplant to the pot along with the chopped veggies, corn, tomato sauce, and salt. Cook, stirring occasionally, until veggies begin to soften, 15-17 minutes.",
      "secondary_message": "1 ½ cups frozen corn\n6 (8 oz) cans tomato sauce\n1 ½ tsp salt"
    },
    {
      "id": 175196,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 175197,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add quinoa and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 175198,
      "primary_message": "To serve, divide the risotto between bowls and garnish with basil. Enjoy!",
      "secondary_message": null
    }
  ],
