  "instructions": [
    {
      "id": 175243,
      "primary_message": "In a small saucepan, combine quinoa and broth. Bring to a boil. Reduce heat to low, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 175244,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 eggplant\n3 tomatoes\n1 red bell pepper\n1 medium zucchini squash\n½ small pkg fresh basil\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 175245,
      "primary_message": "Trim ends and medium dice eggplant. Transfer to a medium bowl, add salt, and toss to coat; set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 175246,
      "primary_message": "Medium dice tomatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 175247,
      "primary_message": "Seed and medium dice bell pepper; add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 175248,
      "primary_message": "Trim ends and medium dice zucchini; add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 175249,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 175250,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "½ medium red onion\n2 cloves garlic"
    },
    {
      "id": 175251,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 175252,
      "primary_message": "Add onion and garlic. Stirring frequently, cook until onion begins to soften, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 175253,
      "primary_message": "Using a clean towel or paper towel, squeeze the eggplant to release excess moisture. Add eggplant to the skillet along with the chopped veggies, corn, tomato sauce, and salt. Cook, stirring occasionally, until veggies begin to soften, 12-14 minutes.",
      "secondary_message": "½ cup frozen corn\n2 (213 ml) cans tomato sauce\n½ tsp salt"
    },
    {
      "id": 175254,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 175255,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add quinoa and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 175256,
      "primary_message": "To serve, divide the risotto between bowls and garnish with basil. Enjoy!",
      "secondary_message": null
    }
  ],
