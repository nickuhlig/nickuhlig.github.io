  "instructions": [
    {
      "primary_message": "Wash, dry, and zest orange into a small saucepan. Add butter, maple syrup, and spices. Set over medium heat, stirring occasionally, until melted and combined. Remove from heat. (Reserve orange for later use.) ",
      "secondary_message": "½ orange\n2 tbsp butter, unsalted\n2 tbsp pure maple syrup\n¾ tsp pumpkin spice mix\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, wash, dry, peel, and trim carrots; quarter lengthwise, then cut crosswise into 3-inch long sticks. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Add half of the butter mixture to the bowl with the carrots and toss to coat. Transfer to the air fryer basket, spreading the carrots out in an even layer. (Reserve remaining butter mixture for later use.)",
      "secondary_message": null
    },
    {
      "primary_message": "Insert basket into air fryer and set temperature to 400°F. Cook, tossing every 10 minutes, until carrots are tender and golden, 25-30 minutes. Remove from air fryer.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, juice reserved orange into the pan with the remaining butter mixture. Return pan to medium heat and simmer, stirring occasionally, until reduced to a thin syrupy consistency, about 5 minutes. Remove glaze from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer carrots to a serving dish, drizzle with glaze, and enjoy!",
      "secondary_message": null
    }
  ],
