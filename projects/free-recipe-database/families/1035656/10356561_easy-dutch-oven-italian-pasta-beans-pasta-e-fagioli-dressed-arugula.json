  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and small dice onion. Peel and thinly slice garlic. Place both in a Dutch oven.\n\n",
      "secondary_message": "1 medium yellow onion\n3 clove garlic"
    },
    {
      "primary_message": "Drain and rinse beans. Add to the Dutch oven with the onion and garlic, along with broth, tomatoes, and spices, then stir to combine. Cover and bring to a boil over high heat.\n\n",
      "secondary_message": "2 (442 g) can cannellini (white kidney) beans\n5 cups chicken or vegetable broth\n2 (411 g) can diced tomatoes\n2 tsp Italian seasoning\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "primary_message": "Once the liquid is boiling, uncover, and add pasta. Stir to combine and re-cover with the lid. Place soup in the oven and bake until pasta is tender, about 20 minutes. Remove from oven.\n\n",
      "secondary_message": "170 g ditalini pasta"
    },
    {
      "primary_message": "When the pasta is almost done, wash and dry arugula (skip this step if it came pre-washed). Place arugula and dressing in a medium bowl, then toss to coat.\n\n",
      "secondary_message": "1 (142 g) pkg baby arugula\n3 tbsp Italian salad dressing"
    },
    {
      "primary_message": "When the soup is done, add vinegar and stir to combine.\n\n",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "primary_message": "Divide soup between bowls and sprinkle with Parmesan. Serve with dressed arugula on the side and enjoy!\n\n",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
