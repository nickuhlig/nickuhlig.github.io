  "instructions": [
    {
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones; separate the meat into shred-like pieces. Place in a 4-quart slow cooker insert.",
      "secondary_message": "½ (532 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "primary_message": "Cut cream cheese into small pieces and add to the insert with the chicken.",
      "secondary_message": "1 (227 g) block cream cheese"
    },
    {
      "primary_message": "Coarsely grate cheddar. Set a ½-cup aside, then add the remaining cheese to the insert.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "primary_message": "Add dressing and hot sauce to the insert, then stir to combine. Cover and cook, stirring every 30 minutes, until cheese is melted and combined, 3-4 hours on low or 1-2 hours on high.",
      "secondary_message": "1 cup ranch dressing\n¾ cup hot sauce"
    },
    {
      "primary_message": "About 10 minutes before the dip is done, wash and dry the fresh produce.",
      "secondary_message": "4 stick celery"
    },
    {
      "primary_message": "Using a clean cutting board, peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Place on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and halve celery lengthwise, then cut crosswise into 3-inch long sticks. Add to the plate with the carrot.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer dip to a serving bowl and sprinkle with reserved cheese and green onions. Enjoy with veggies and tortilla chips for dipping!",
      "secondary_message": "170 g tortilla chips"
    }
  ],
