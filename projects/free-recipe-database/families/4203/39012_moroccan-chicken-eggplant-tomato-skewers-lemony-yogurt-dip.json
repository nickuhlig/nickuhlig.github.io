  "instructions": [
    {
      "id": 606804,
      "primary_message": "If using wooden skewers, place 6-8 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 606805,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n½ small pkg grape tomatoes\n½ small bunch Italian (flat-leaf) parsley\n½ lemon"
    },
    {
      "id": 606806,
      "primary_message": "Peel and mince garlic. Place in a medium bowl, along with oil and spices, then whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp paprika\n½ tsp coriander, ground\n¼ tsp cinnamon, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 606807,
      "primary_message": "Trim and large dice eggplant. Add to the bowl with the marinade.",
      "secondary_message": null
    },
    {
      "id": 606808,
      "primary_message": "Pat the chicken dry with paper towels and large dice. Add to the bowl, along with tomatoes, and stir to coat. Set aside.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 606809,
      "primary_message": "Using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 606810,
      "primary_message": "Juice lemon into the bowl with the parsley. Add yogurt, oil, salt, and pepper, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 606811,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 606812,
      "primary_message": "While the pan heats up, thread chicken, eggplant, and grape tomatoes onto skewers, then place on a plate. (Alternatively, you can cook the chicken and veggies directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 606813,
      "primary_message": "Once the pan is hot, add skewers and grill, turning occasionally, until chicken and veggies are cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 606814,
      "primary_message": "Divide skewers between plates and serve with lemony yogurt for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
