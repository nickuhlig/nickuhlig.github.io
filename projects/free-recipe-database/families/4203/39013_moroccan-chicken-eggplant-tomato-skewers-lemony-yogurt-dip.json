  "instructions": [
    {
      "id": 606815,
      "primary_message": "If using wooden skewers, place 12-16 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 606816,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n1 small pkg grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 606817,
      "primary_message": "Peel and mince garlic. Place in a large bowl, along with oil and spices, then whisk to combine the marinade.",
      "secondary_message": "4 cloves garlic\n¼ cup extra virgin olive oil\n2 tsp cumin, ground\n2 tsp paprika\n1 tsp coriander, ground\n½ tsp cinnamon, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 606818,
      "primary_message": "Trim and large dice eggplants. Add to the bowl with the marinade.",
      "secondary_message": null
    },
    {
      "id": 606819,
      "primary_message": "Pat the chicken dry with paper towels and large dice. Add to the bowl, along with tomatoes, and stir to coat. Set aside.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 606820,
      "primary_message": "Using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 606821,
      "primary_message": "Juice lemon into the bowl with the parsley. Add yogurt, oil, salt, and pepper, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 606822,
      "primary_message": "Thread chicken, eggplant, and grape tomatoes onto skewers, then place on a plate. (Alternatively, you can cook the chicken and veggies directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 606823,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 606824,
      "primary_message": "Once the pan is hot, working in batches if necessary, add skewers and grill, turning occasionally, until chicken and veggies are cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 606825,
      "primary_message": "Divide skewers between plates and serve with lemony yogurt for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
