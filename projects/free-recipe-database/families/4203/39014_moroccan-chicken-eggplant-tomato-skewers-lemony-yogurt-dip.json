  "instructions": [
    {
      "id": 606826,
      "primary_message": "If using wooden skewers, place 18-24 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 606827,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n1 ½ small pkgs grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 606828,
      "primary_message": "Peel and mince garlic. Place in a large bowl, along with oil and spices, then whisk to combine the marinade.",
      "secondary_message": "6 cloves garlic\n⅓ cup extra virgin olive oil\n1 tbsp cumin, ground\n1 tbsp paprika\n1 ½ tsp coriander, ground\n¾ tsp cinnamon, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 606829,
      "primary_message": "Trim and large dice eggplants. Add to the bowl with the marinade.",
      "secondary_message": null
    },
    {
      "id": 606830,
      "primary_message": "Pat the chicken dry with paper towels and large dice. Add to the bowl, along with tomatoes, and stir to coat. Set aside.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 606831,
      "primary_message": "Using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 606832,
      "primary_message": "Juice lemons into the bowl with the parsley. Add yogurt, oil, salt, and pepper, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 606833,
      "primary_message": "Thread chicken, eggplant, and grape tomatoes onto skewers, then place on a plate. (Alternatively, you can cook the chicken and veggies directly on the pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 606834,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 606835,
      "primary_message": "Once the pan is hot, working in batches, add skewers and grill, turning occasionally, until chicken and veggies are cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 606836,
      "primary_message": "Divide skewers between plates and serve with lemony yogurt for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
