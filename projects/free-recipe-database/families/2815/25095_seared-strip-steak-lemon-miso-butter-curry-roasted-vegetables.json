  "instructions": [
    {
      "id": 403015,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 403016,
      "primary_message": "Wash, dry, and quarter potatoes. Divide between two large baking sheet pans along with cauliflower and mushrooms. Season with spices, toss to coat, and spread out in an even layer.",
      "secondary_message": "0.68 kg new potatoes\n3 (283 g) bags cauliflower florets\n3 (227g ) pkg sliced white mushrooms\n1 tbsp curry powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 403017,
      "primary_message": "Cut butter into small pieces. Sprinkle half of the butter over the veggies. (Place remaining butter in a small bowl and set aside to soften.)",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 403018,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 403019,
      "primary_message": "Meanwhile, wash, dry, and zest lemons into the bowl with the butter. Cut lemons into wedges and set aside for serving.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 403020,
      "primary_message": "Add miso paste to the bowl and mash with the back of a spoon until combined. Set miso butter aside.",
      "secondary_message": "3 tbsp miso paste, white"
    },
    {
      "id": 403021,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 403022,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 403023,
      "primary_message": "Once the skillet is hot, add additional butter and swirl to coat the bottom. Working in batches if necessary, add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to the cutting board.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 403024,
      "primary_message": "Just before serving, thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 403025,
      "primary_message": "Divide steak and veggies between plates. Top steak with miso butter and serve with lemon wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
