  "instructions": [
    {
      "id": 501641,
      "primary_message": "In a medium saucepan, combine water and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "2 ¼ cup water\n1 cup quinoa"
    },
    {
      "id": 501642,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n3 jalapeño peppers\n3 medium carrots\n3 tomatoes\n1 small bunch cilantro\n3 avocados\n1 ½ limes"
    },
    {
      "id": 501643,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 501644,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 501645,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 501646,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 501647,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Add to the bowl with the other veggies.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 501648,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 501649,
      "primary_message": "While the veggies are cooking, drain and rinse beans.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 501650,
      "primary_message": "Add beans and broth to the pot. Stir to combine and bring to a simmer over high heat. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until beans and veggies are tender, 10-12 minutes more. Remove from heat.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth"
    },
    {
      "id": 501651,
      "primary_message": "Meanwhile, medium dice tomatoes. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 501652,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 501653,
      "primary_message": "Add the cooked quinoa, tomato, and half of the cilantro to the pot; stir to combine the soup. Continue to cook, stirring occasionally, until quinoa and tomato are warmed though, 3-4 minutes. Remove from heat. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 501654,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 501655,
      "primary_message": "Cut limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 501656,
      "primary_message": "Divide the soup between bowls, then top with avocado and reserved cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
