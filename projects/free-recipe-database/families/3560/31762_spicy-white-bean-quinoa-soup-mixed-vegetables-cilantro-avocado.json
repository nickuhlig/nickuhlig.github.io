  "instructions": [
    {
      "id": 501609,
      "primary_message": "In a small saucepan, combine water and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "¾ cup water\n⅓ cup quinoa"
    },
    {
      "id": 501610,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n1 jalapeño pepper\n1 medium carrot\n1 tomato\n½ small bunch cilantro\n1 avocado\n½ lime"
    },
    {
      "id": 501611,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 501612,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 501613,
      "primary_message": "Peel, trim, and small dice carrot. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 501614,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 501615,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl with the other veggies.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 501616,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 501617,
      "primary_message": "While the veggies are cooking, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 501618,
      "primary_message": "Add beans and broth to the pan. Stir to combine and bring to a simmer over high heat. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until beans and veggies are tender, 10-12 minutes more. Remove from heat.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth"
    },
    {
      "id": 501619,
      "primary_message": "Meanwhile, medium dice tomato. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 501620,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 501621,
      "primary_message": "Add the cooked quinoa, tomato, and half of the cilantro to the pan; stir to combine the soup. Continue to cook, stirring occasionally, until quinoa and tomato are warmed though, 2-3 minutes. Remove from heat. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 501622,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 501623,
      "primary_message": "Cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 501624,
      "primary_message": "Divide the soup between bowls, then top with avocado and reserved cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
