  "instructions": [
    {
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 tomato\n½ small bunch cilantro\n½ avocado"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n¾ lb ground turkey\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, trim, seed, and medium dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "primary_message": "When the turkey is done, add bell pepper, onion, and garlic to the skillet. Continue to cook, stirring occasionally, until veggies are tender, 3-4 minutes. Remove from heat. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Coarsely grate cheddar. Set aside.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "primary_message": "Drain and rinse beans. Place in the reserved bowl.",
      "secondary_message": "1 (15 oz) can pinto beans"
    },
    {
      "primary_message": "Medium dice tomato. Add to the bowl with the beans.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "primary_message": "Add beans, tomato, cilantro, yogurt, and water to the skillet with the turkey. Stir to combine and bring to a simmer over medium-high heat. Once simmering, remove from heat.",
      "secondary_message": "⅓ cup plain Greek yogurt"
    },
    {
      "primary_message": "Sprinkle cheese over the skillet, then place in the oven and broil until cheese is golden, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice lengthwise into thin pieces.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide skillet between plates or bowls, then top with avocado and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
