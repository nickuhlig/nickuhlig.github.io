  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cube the ripe seedless watermelon.",
      "secondary_message": "4 cups ripe seedless watermelon"
    },
    {
      "id": 1,
      "primary_message": "In a blender, purée watermelon cubes. Strain into a large pitcher. Add wine, rum, Cointreau, and simple syrup and stir.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Juice 1 lime and add juice to pitcher. Slice the other lime lengthwise and then slice into thin slices. Add lime slices to pitcher, cover and refrigerate for 2 to 4 hours. Pour into ice-filled serving glasses, garnish with additional watermelon and mint sprigs.",
      "secondary_message": null
    }
