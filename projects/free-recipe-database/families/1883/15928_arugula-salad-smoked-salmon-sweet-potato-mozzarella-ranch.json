  "instructions": [
    {
      "id": 262187,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 262188,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 ¼ lb sweet potatoes\n1 small pkg chives\n1 ½ limes\n3 Granny Smith apples\n3 (5 oz) pkgs baby arugula"
    },
    {
      "id": 262189,
      "primary_message": "Peel and cut sweet potatoes into ½-inch cubes; transfer to a large baking sheet pan. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 262190,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potatoes are golden brown and fork-tender, 20-25 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 262191,
      "primary_message": "Meanwhile, mince chives and place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 262192,
      "primary_message": "Juice limes into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 262193,
      "primary_message": "Add yogurt, mayo, and spices to the bowl; whisk to combine the dressing. If necessary, add water, 1 tablespoon at a time, to reach a drizzling consistency; set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 ½ tsp parsley flakes\n¾ tsp dill, dried\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 262194,
      "primary_message": "Medium dice mozzarella and transfer to a large plate.",
      "secondary_message": "1 ½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 262195,
      "primary_message": "Chop or tear salmon into bite-sized pieces; add to the plate with the mozzarella.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 262196,
      "primary_message": "Quarter and core apples, then medium dice and add to the plate.",
      "secondary_message": null
    },
    {
      "id": 262197,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 262198,
      "primary_message": "To serve, divide arugula between plates or bowls; top with sweet potato, mozzarella, salmon, apple, and pistachios. Serve with dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
