  "instructions": [
    {
      "id": 262375,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 262376,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.68 kg sweet potato\n1 small pkg chives\n1 lime\n2 Granny Smith apples\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 262377,
      "primary_message": "Peel and cut sweet potatoes into ½-inch cubes; transfer to a baking sheet pan. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 262378,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potatoes are golden brown and fork-tender, 20-25 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 262379,
      "primary_message": "Meanwhile, drain and rinse the chickpeas in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 262380,
      "primary_message": "Mince chives and place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 262381,
      "primary_message": "Juice lime into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 262382,
      "primary_message": "Add yogurt, mayo, and spices to the bowl; whisk to combine the dressing. If necessary, add water, 1 teaspoon at a time, to reach a drizzling consistency; set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n¼ cup mayonnaise\n1 tsp parsley flakes\n½ tsp dill, dried\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 262383,
      "primary_message": "Quarter and core apples, then medium dice.",
      "secondary_message": null
    },
    {
      "id": 262384,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 262385,
      "primary_message": "To serve, divide arugula between plates or bowls; top with sweet potato, chickpeas, apple, pistachios, and feta. Serve with dressing on the side and enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
