  "instructions": [
    {
      "id": 262163,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 262164,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "¾ lb sweet potato\n½ small pkg chives\n½ lime\n1 Granny Smith apple\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 262165,
      "primary_message": "Peel and cut sweet potato into ½-inch cubes; transfer to a baking sheet pan. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 262166,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potatoes are golden brown and fork-tender, about 20 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 262167,
      "primary_message": "Meanwhile, mince chives and place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 262168,
      "primary_message": "Juice lime into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 262169,
      "primary_message": "Add yogurt, mayo, and spices to the bowl; whisk to combine the dressing. If necessary, add water, 1 teaspoon at a time, to reach a drizzling consistency; set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n½ tsp parsley flakes\n¼ tsp dill, dried\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 262170,
      "primary_message": "Medium dice mozzarella and transfer to a plate.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 262171,
      "primary_message": "Chop or tear salmon into bite-sized pieces; add to the plate with the mozzarella.",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 262172,
      "primary_message": "Quarter and core apple, then medium dice and add to the plate.",
      "secondary_message": null
    },
    {
      "id": 262173,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "⅛ cup pistachios, unsalted"
    },
    {
      "id": 262174,
      "primary_message": "To serve, divide arugula between plates or bowls; top with sweet potato, mozzarella, salmon, apple, and pistachios. Serve with dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
