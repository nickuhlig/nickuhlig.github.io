  "instructions": [
    {
      "id": 62456,
      "primary_message": "Wash, peel, and large dice potatoes. Transfer to a large pot, cover with water, and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to saucepan.",
      "secondary_message": "6 medium yellow potatoes"
    },
    {
      "id": 62455,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 62446,
      "primary_message": "In a large bowl, combine beef, bread crumbs, soy sauce, salt, and pepper. Mix well and form into 6 patties.",
      "secondary_message": "1.02 kg lean ground beef\n⅜ cup panko bread crumbs\n3 tsp soy sauce\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 62454,
      "primary_message": "Melt butter in pan. Add beef patties and cook until browned and almost cooked through, 3-4 minutes per side. Transfer to a plate.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 62453,
      "primary_message": "Peel and thinly slice onion into half rings.",
      "secondary_message": "1 ½ medium yellow onion"
    },
    {
      "id": 62452,
      "primary_message": "Once patties have been transferred, add more butter and onion to pan. Stirring frequently, cook until onion begins to soften, 2-3 minutes.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 62451,
      "primary_message": "Wash and slice mushrooms. Peel and mince garlic.",
      "secondary_message": "0.681 kg white mushrooms\n6 cloves garlic"
    },
    {
      "id": 62450,
      "primary_message": "Add mushrooms, garlic, and thyme to pan. Stirring occasionally, cook until mushrooms are tender, 3-4 minutes.",
      "secondary_message": "1 ½ tsp thyme"
    },
    {
      "id": 62444,
      "primary_message": "In a small bowl, whisk together flour and broth until smooth. Add to pan and stir to combine.",
      "secondary_message": "1 ½ tbsp all-purpose flour\n354 ml (1 ½ cup) chicken or vegetable broth"
    },
    {
      "id": 62449,
      "primary_message": "Return beef patties and any juices to pan. Cover and simmer until gravy thickens and steaks are cooked through, 4-5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 62445,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 62448,
      "primary_message": "Add butter, broth, ½ of the parsley (save the rest for garnishing), salt, and pepper to potatoes. Mash until smooth.",
      "secondary_message": "1 ½ tbsp butter, unsalted\n354 ml (1 ½ cup) chicken or vegetable broth\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 62447,
      "primary_message": "To serve, place mashed potatoes on a plate and top with steaks and gravy. Garnish with remaining parsley and enjoy!",
      "secondary_message": ""
    }
  ],
