  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and slice the watermelon radishes thinly crosswise.",
      "secondary_message": "8 to 10 medium watermelon radishes"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together the vinegar, water, salt, and sugar until sugar and salt are fully dissolved. Add the radishes and toss to coat. Lay a clean paper towel on the surface to keep the radishes submerged. Let marinate for at least 15 minutes before serving. Pickled radishes can be packed into a jar with their brine and refrigerated for up to 2 weeks.",
      "secondary_message": null
    }
