  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Zest the lemon.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Butter a 2 quart high-sided casserole dish. Adjust oven rack to center position and preheat oven to 165°C (325°F). Bring a large kettle of water to a boil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat milk, butter, lemon zest, and 1/4 cup sugar in a medium saucepan over medium heat. Stir constantly until milk is hot, but not simmering, butter is melted, and sugar has dissolved.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk egg yolks in a large bowl then slowly add milk, whisking the entire time. Spread breadcrumbs evenly inside buttered casserole dish, then pour milk mixture over breadcrumbs. Place casserole in a roasting pan, then add boiled water until it goes halfway up the sides of the casserole.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place roasting pan in the oven and cook until custard is set but still jiggles in the center, about 25 minutes. Remove from the oven and let cool to room temperature. Once the custard is set, spread the jam evenly over the top.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Using a standing or hand mixer, beat the egg whites until frothy. Continue beating, while adding remaining 3/4 cup sugar. Continue to beat until the whites hold soft peaks.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Using a pastry bag or a small spatula, spread meringue evenly over top of custard. Refrigerate until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "When ready to serve adjust oven rack to the lowest position and preheat broiler to high. Toast the meringue until golden brown and serve immediately.",
      "secondary_message": null
    }
  ],
