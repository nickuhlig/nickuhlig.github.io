  "instructions": [
    {
      "id": 257700,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain eggs and transfer to a medium bowl; add ice or run under cold water to cool. (Reserve pot for later use.)",
      "secondary_message": "4 eggs"
    },
    {
      "id": 257701,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 small pkg chives\n1 small bunch cilantro\n1 pint grape tomatoes\n1 avocado\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 257702,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 257703,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 257704,
      "primary_message": "Roughly chop chives and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 257705,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 257706,
      "primary_message": "Add yogurt, oil, water, capers, and spices to the blender. Blend on high until almost smooth, adding additional water, 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n2 tbsp water\n1 tbsp capers\n1 tsp parsley flakes\n1 tsp dill, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 257707,
      "primary_message": "Halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 257708,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 257709,
      "primary_message": "When the eggs are done, wipe the pot clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257710,
      "primary_message": "While the pot heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 257711,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Transfer bacon to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 257712,
      "primary_message": "While the bacon is cooking, peel and quarter eggs.",
      "secondary_message": null
    },
    {
      "id": 257713,
      "primary_message": "Divide spinach between plates or bowls; top with eggs, tomatoes, avocado, bacon, and blue cheese. Serve with dressing on the side and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
    }
  ],
