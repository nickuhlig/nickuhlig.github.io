  "instructions": [
    {
      "id": 257739,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 257740,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 small pkg chives\n1 small bunch cilantro\n2 pints grape tomatoes\n2 avocados\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 257741,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 257742,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 257743,
      "primary_message": "Roughly chop chives and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 257744,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 257745,
      "primary_message": "Add yogurt, oil, water, capers, and spices to the blender. Blend on high until almost smooth, adding additional water, 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n2 tbsp water\n1 tbsp capers\n1 tsp parsley flakes\n1 tsp dill, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 257746,
      "primary_message": "Halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 257747,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 257748,
      "primary_message": "Peel and slice eggs crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 257749,
      "primary_message": "Divide spinach between plates or bowls; top with eggs, tomatoes, avocado, and blue cheese. Serve with dressing on the side and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
    }
  ],
