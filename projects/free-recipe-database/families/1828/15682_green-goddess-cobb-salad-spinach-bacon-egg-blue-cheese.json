  "instructions": [
    {
      "id": 257789,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain eggs and transfer to a medium bowl; add ice or run under cold water to cool. (Reserve pot for later use.)",
      "secondary_message": "6 eggs"
    },
    {
      "id": 257790,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small pkg chives\n1 small bunch cilantro\n1 small bunch Italian (flat-leaf) parsley\n1 ½ small pkgs grape tomatoes\n1 ½ avocados\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 257791,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 257792,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 257793,
      "primary_message": "Roughly chop chives and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 257794,
      "primary_message": "Shave cilantro and parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 257795,
      "primary_message": "Add yogurt, oil, water, capers, and spices to the blender. Blend on high until almost smooth, adding additional water, 1-2 tablespoons at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n3 tbsp water\n1 ½ tbsp capers\n1 ½ tsp dill, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 257796,
      "primary_message": "Halve tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 257797,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 257798,
      "primary_message": "When the eggs are done, wipe the pot clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257799,
      "primary_message": "While the pot heats up, small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 257800,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Transfer bacon to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 257801,
      "primary_message": "While the bacon is cooking, peel and quarter eggs.",
      "secondary_message": null
    },
    {
      "id": 257802,
      "primary_message": "Divide spinach between plates or bowls; top with eggs, tomatoes, avocado, bacon, and blue cheese. Serve with dressing on the side and enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    }
  ],
