  "instructions": [
    {
      "id": 257803,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 257804,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n½ small pkg chives\n½ small bunch cilantro\n1 small pkg grape tomatoes\n1 avocado\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 257805,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 257806,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 257807,
      "primary_message": "Roughly chop chives and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 257808,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 257809,
      "primary_message": "Add yogurt, oil, water, capers, and spices to the blender. Blend on high until almost smooth, adding additional water, 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 ½ tbsp extra virgin olive oil\n1 tbsp water\n½ tbsp capers\n½ tsp parsley flakes\n½ tsp dill, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 257810,
      "primary_message": "Halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 257811,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 257812,
      "primary_message": "Peel and slice eggs crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 257813,
      "primary_message": "Divide spinach between plates or bowls; top with eggs, tomatoes, avocado, and blue cheese. Serve with dressing on the side and enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    }
  ],
