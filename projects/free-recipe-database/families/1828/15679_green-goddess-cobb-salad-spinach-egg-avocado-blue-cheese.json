  "instructions": [
    {
      "id": 257750,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 257751,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small pkg chives\n1 small bunch cilantro\n1 small bunch Italian (flat-leaf) parsley\n3 pints grape tomatoes\n3 avocados\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 257752,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 257753,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 257754,
      "primary_message": "Roughly chop chives and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 257755,
      "primary_message": "Shave cilantro and parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 257756,
      "primary_message": "Add yogurt, oil, water, capers, and spices to the blender. Blend on high until almost smooth, adding additional water, 1-2 tablespoons at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup extra virgin olive oil\n3 tbsp water\n1 ½ tbsp capers\n1 ½ tsp dill, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 257757,
      "primary_message": "Halve tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 257758,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 257759,
      "primary_message": "Peel and slice eggs crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 257760,
      "primary_message": "Divide spinach between plates or bowls; top with eggs, tomatoes, avocado, and blue cheese. Serve with dressing on the side and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    }
  ],
