  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 (2-compartment) food storage containers and 4 sandwich bags.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water, about 10 minutes.\n\n",
      "secondary_message": "1 (16 oz) pkg extra firm tofu"
    },
    {
      "primary_message": "Meanwhile, divide rice cakes between sandwich bags (two per bag). Seal bags and store at room temperature.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place pesto, mayo, and spices in a medium bowl, then stir to combine the dressing.\n\n",
      "secondary_message": "½ cup basil pesto\n3 tbsp mayonnaise\n½ tsp salt\n½ tsp black pepper\n½ tsp onion powder\n½ tsp garlic powder"
    },
    {
      "primary_message": "Crumble tofu with your fingers into the bowl with the dressing; using a fork, mash to combine the tofu salad. Set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and slice tomatoes crosswise into thin rounds.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide tofu salad and tomato between food storage containers. Cover and refrigerate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, spoon tofu salad over rice cakes, top with tomato slices, and enjoy!",
      "secondary_message": null
    }
  ],
