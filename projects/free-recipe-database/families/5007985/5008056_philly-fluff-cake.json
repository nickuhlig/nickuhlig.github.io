  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 180°C (350°F). Grease and flour a 12-cup Bundt or tube pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, cream together cream cheese, butter, and shortening with an electric mixer on medium-high speed until light and fluffy, about 5 minutes. In a smaller bowl, combine flour, baking powder, and salt. Add flour mixture to creamed mixture and mix on low speed until blended - it will be very thick.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Gradually add 1 cup of sugar and eggs, one at a time, beating well after each addition. Add vanilla and remaining 1 cup sugar and continue beating, scraping down sides of bowl once or twice, until batter is smooth.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour half of mixture into prepared pan. Top with melted chocolate and swirl a knife through the batter to marble it. Top with remaining batter.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake for 60 to 65 minutes, or until a toothpick inserted in the center comes out clean. Cool on a wire rack for 15 minutes. Invert cake onto a platter and cool completely. Before serving, dust with a generous amount of confectioners' sugar.",
      "secondary_message": null
    }
  ],
