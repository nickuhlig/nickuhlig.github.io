  "instructions": [
    {
      "id": 492403,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 492404,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ (16 oz) pkgs strawberries\n1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 small pkg fresh mint"
    },
    {
      "id": 492405,
      "primary_message": "Medium dice tofu. Place in a large bowl, then sprinkle with cornstarch and spices. Gently toss to coat.",
      "secondary_message": "3 tbsp cornstarch\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 492406,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 492407,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes. Remove to a plate. (Reserve skillet for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 492408,
      "primary_message": "Meanwhile, peel and mince shallot. Place in another large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n¼ cup extra virgin olive oil\n¼ cup white wine vinegar\n2 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 492409,
      "primary_message": "Trim and quarter strawberries. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 492410,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492411,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492412,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set aside. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 492413,
      "primary_message": "Cut or tear bread into bite-sized pieces.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 492414,
      "primary_message": "Return skillet to low heat, add more oil, and swirl to coat the bottom. Add bread and cook, stirring occasionally, until croutons are golden and toasted, 5-6 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 492415,
      "primary_message": "Add croutons to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 492416,
      "primary_message": "To serve, divide panzanella salad between plates; top with tofu, feta, and reserved mint. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
