  "instructions": [
    {
      "id": 492515,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 492516,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with spices on both sides.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 492517,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 492518,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (454 g) pkg strawberries\n1 small pkg grape tomatoes\n1 English cucumber\n1 small pkg fresh mint"
    },
    {
      "id": 492519,
      "primary_message": "Using a clean cutting board, peel and mince shallot. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n3 tbsp extra virgin olive oil\n3 tbsp white wine vinegar\n1 tbsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 492520,
      "primary_message": "Trim and quarter strawberries. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 492521,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492522,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492523,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set aside. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 492524,
      "primary_message": "Cut or tear bread into bite-sized pieces.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 492525,
      "primary_message": "Return skillet (with drippings) to low heat, add more oil, and swirl to coat the bottom. Add bread and cook, stirring occasionally, until croutons are golden and toasted, 4-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 492526,
      "primary_message": "Add croutons to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 492527,
      "primary_message": "Slice chicken into thin strips.",
      "secondary_message": null
    },
    {
      "id": 492528,
      "primary_message": "To serve, divide panzanella salad between plates; top with chicken, feta, and reserved mint. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
