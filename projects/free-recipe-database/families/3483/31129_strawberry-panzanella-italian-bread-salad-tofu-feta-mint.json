  "instructions": [
    {
      "id": 492543,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 492544,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (454 g) pkg strawberries\n½ small pkg grape tomatoes\n½ English cucumber\n½ small pkg fresh mint"
    },
    {
      "id": 492545,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 492546,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in a medium bowl, then sprinkle with cornstarch and spices. Gently toss to coat.",
      "secondary_message": "1 tbsp cornstarch\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 492547,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes. Remove to a plate. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 492548,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a clean medium bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 ½ tbsp extra virgin olive oil\n1 ½ tbsp white wine vinegar\n2 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 492549,
      "primary_message": "Trim and quarter strawberries. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 492550,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492551,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492552,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set aside. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 492553,
      "primary_message": "Cut or tear bread into bite-sized pieces.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 492554,
      "primary_message": "Return skillet to low heat, add more oil, and swirl to coat the bottom. Add bread and cook, stirring occasionally, until croutons are golden and toasted, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 492555,
      "primary_message": "Add croutons to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 492556,
      "primary_message": "To serve, divide panzanella salad between plates; top with tofu, feta, and reserved mint. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
