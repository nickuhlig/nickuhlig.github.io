  "instructions": [
    {
      "id": 492361,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 492362,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with spices on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 492363,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 492364,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ (16 oz) pkgs strawberries\n1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 small pkg fresh mint"
    },
    {
      "id": 492365,
      "primary_message": "Using a clean cutting board, peel and mince shallot. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n¼ cup extra virgin olive oil\n¼ cup white wine vinegar\n1 ½ tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 492366,
      "primary_message": "Trim and quarter strawberries. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 492367,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492368,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 492369,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set aside. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 492370,
      "primary_message": "Cut or tear bread into bite-sized pieces.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 492371,
      "primary_message": "Return skillet (with drippings) to low heat, add more oil, and swirl to coat the bottom. Add bread and cook, stirring occasionally, until croutons are golden and toasted, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 492372,
      "primary_message": "Add croutons to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 492373,
      "primary_message": "Slice chicken into thin strips.",
      "secondary_message": null
    },
    {
      "id": 492374,
      "primary_message": "To serve, divide panzanella salad between plates; top with chicken, feta, and reserved mint. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
