  "instructions": [
    {
      "id": 1,
      "primary_message": "Place fish, garlic, lemon juice, olive oil, salt, and pepper in a large Ziplock bag. Move fish around to coat. Let rest in refrigerator for 30 minutes. Preheat oven to 205°C (400°F) while fish marinates.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Take fish out of bag, shaking off excess, but not all, marinade. Place in a glass baking dish. Roast fish until opaque and flaking, about 18 minutes.",
      "secondary_message": null
    }
  ],
