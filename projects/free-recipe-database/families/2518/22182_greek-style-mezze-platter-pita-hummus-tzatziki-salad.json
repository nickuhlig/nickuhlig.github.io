  "instructions": [
    {
      "id": 371592,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 orange bell peppers\n1 ½ English cucumbers\n6 hearts romaine hearts"
    },
    {
      "id": 371593,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 371594,
      "primary_message": "Trim and halve cucumbers lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 371595,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 371596,
      "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 371597,
      "primary_message": "Drain and roughly chop artichokes. Add to the bowl. ",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 371598,
      "primary_message": "Roughly chop olives. Add to the bowl, along with the feta, vinaigrette, and oregano. Toss to combine the salad and set aside.",
      "secondary_message": "1 cup Kalamata olives, pitted\n1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup balsamic vinaigrette\n1 ½ tsp oregano, dried"
    },
    {
      "id": 371599,
      "primary_message": "Toast pita if desired, then cut into wedges. ",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 371600,
      "primary_message": "Divide salad and pita between plates; serve with hummus and tzatziki. Enjoy!",
      "secondary_message": "1 ½ cups hummus\n1 ½ cups tzatziki sauce"
    }
  ],
