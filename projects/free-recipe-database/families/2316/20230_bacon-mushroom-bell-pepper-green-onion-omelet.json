  "instructions": [
    {
      "id": 337613,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ lb white mushrooms\n1 ½ red bell peppers"
    },
    {
      "id": 337614,
      "primary_message": "Small dice bacon. ",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 337615,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 337616,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, about 5 minutes. Using a slotted spoon, remove crispy bacon to a large paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 337617,
      "primary_message": "Meanwhile, using a clean cutting board, trim and thinly slice green onions; thinly slice mushrooms. Place both in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 337618,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 337619,
      "primary_message": "Return skillet with drippings to medium-high heat; add veggies and salt. Cook, stirring occasionally, until softened, 4-5 minutes. Using a slotted spoon, transfer veggies to the plate with the bacon. (Reserve bowl for the next step.)",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 337620,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl; whisk to combine. ",
      "secondary_message": "18 eggs\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 337621,
      "primary_message": "Preheat a second, smaller skillet over medium-low heat. Once hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 337622,
      "primary_message": "Add ⅓ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull cooked edges towards center of the pan. Then tilt the pan, allowing uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 337623,
      "primary_message": "Arrange ⅓ of the bacon and veggies over one side of the omelet; fold the omelet in half and continue to cook until filling is warmed through, about 1 minute. Transfer omelet to a cutting board. ",
      "secondary_message": null
    },
    {
      "id": 337624,
      "primary_message": "Add more oil to the skillet (2 tsp per omelet) and repeat twice more with remaining eggs, bacon, and veggies.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 337625,
      "primary_message": "To serve, cut omelets in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
