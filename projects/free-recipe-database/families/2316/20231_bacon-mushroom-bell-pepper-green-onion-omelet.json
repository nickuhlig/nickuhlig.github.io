  "instructions": [
    {
      "id": 337626,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n0.23 kg white mushrooms\n½ red bell pepper"
    },
    {
      "id": 337627,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 337628,
      "primary_message": "While the skillet heats up, small dice bacon. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 337629,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 337630,
      "primary_message": "Meanwhile, using a clean cutting board, trim and thinly slice green onions; thinly slice mushrooms. Place both in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 337631,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 337632,
      "primary_message": "Return skillet with drippings to medium-high heat; add veggies and salt. Cook, stirring occasionally, until softened, 3-4 minutes. Using a slotted spoon, transfer veggies to the plate with the bacon. (Reserve bowl for the next step and skillet for later use.)",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 337633,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl; whisk to combine. ",
      "secondary_message": "6 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 337634,
      "primary_message": "Wipe skillet clean with paper towels; return to medium-low heat, add oil, and swirl to coat the bottom. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 337635,
      "primary_message": "Add eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 337636,
      "primary_message": "Arrange bacon and veggies over one side of the omelet; fold the omelet in half and continue to cook until filling is warmed through, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 337637,
      "primary_message": "To serve, cut omelet in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
