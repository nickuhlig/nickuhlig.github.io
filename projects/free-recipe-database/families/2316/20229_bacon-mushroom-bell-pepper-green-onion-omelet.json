  "instructions": [
    {
      "id": 337600,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 lb white mushrooms\n1 red bell pepper"
    },
    {
      "id": 337601,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 337602,
      "primary_message": "While the skillet heats up, small dice bacon. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 337603,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 337604,
      "primary_message": "Meanwhile, using a clean cutting board, trim and thinly slice green onions; thinly slice mushrooms. Place both in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 337605,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 337606,
      "primary_message": "Return skillet with drippings to medium-high heat; add veggies and salt. Cook, stirring occasionally, until softened, 3-4 minutes. Using a slotted spoon, transfer veggies to the plate with the bacon. (Reserve bowl for the next step.)",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 337607,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl; whisk to combine. ",
      "secondary_message": "12 eggs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 337608,
      "primary_message": "Preheat a second, smaller skillet over medium-low heat. Once hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 337609,
      "primary_message": "Add ½ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull cooked edges towards center of the pan. Then tilt the pan, allowing uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 337610,
      "primary_message": "Arrange ½ of the bacon and veggies over one side of the omelet; fold the omelet in half and continue to cook until filling is warmed through, about 1 minute. Transfer omelet to a cutting board. ",
      "secondary_message": null
    },
    {
      "id": 337611,
      "primary_message": "Add more oil to the skillet and repeat with remaining eggs, bacon, and veggies.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 337612,
      "primary_message": "To serve, cut omelets in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
