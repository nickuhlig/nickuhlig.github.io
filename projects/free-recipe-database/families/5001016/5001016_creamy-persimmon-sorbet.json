  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and chop the persimmons.",
      "secondary_message": "4 to 5 large persimmons"
    },
    {
      "id": 1,
      "primary_message": "In a blender or food processor, combine persimmons with sugar. Blend on high speed until very smooth, about 30 seconds. Using a fine-mesh sieve, strain mixture; measure out 2 cups of purée, and reserve remainder for another use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk 2 cups persimmon purée, tea, and lemon juice to combine. Season to taste with salt. Chill in freezer until mixture is very cold, 2 to 3 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Once chilled, churn persimmon mixture in ice cream maker according to manufacturer's instructions. Serve immediately as soft serve or transfer to an airtight container and chill in freezer for 4 hours for a firmer texture.",
      "secondary_message": null
    }
  ],
