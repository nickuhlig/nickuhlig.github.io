  "instructions": [
    {
      "id": 393837,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 393838,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg sweet potato\n0.23 kg cremini mushrooms\n½ small bunch cilantro\n½ lime\n½ avocado"
    },
    {
      "id": 393839,
      "primary_message": "Peel and medium dice sweet potato. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 393840,
      "primary_message": "Quarter mushrooms and add to the baking sheet with the sweet potato. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 393841,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are browned and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 393842,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp white wine vinegar\n¾ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 393843,
      "primary_message": "Peel and halve onion. Slice one half crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. (Reserve remaining onion for the next step.)",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 393844,
      "primary_message": "Small dice the remaining onion. Peel and thinly slice garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 393845,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 393846,
      "primary_message": "While the skillet heats up, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 393847,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the diced onion, garlic, cumin, and salt; cook, stirring occasionally until starting to brown, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 393848,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 393849,
      "primary_message": "When the onion is done, add beans to the skillet. Cook, mashing with the back of a spoon, until beans are broken up slightly and warmed through, 3-4 minutes. Add water, hot sauce, and half of the cilantro, then stir to combine. Cover and remove from heat. (Reserve remaining cilantro for serving.)",
      "secondary_message": "¼ cup water\n2 tsp hot sauce"
    },
    {
      "id": 393850,
      "primary_message": "Cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 393851,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh. Halve lengthwise, then slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 393852,
      "primary_message": "Divide beans and roasted veggies between bowls; top with avocado, pickled onion, feta, and reserved cilantro. Serve with lime wedges for squeezing and additional hot sauce. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n1 tsp hot sauce"
    }
  ],
