  "instructions": [
    {
      "id": 393869,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 393870,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n0.68 kg cremini mushrooms\n1 small bunch cilantro\n1 ½ limes\n1 ½ avocados"
    },
    {
      "id": 393871,
      "primary_message": "Peel and medium dice sweet potatoes. Divide between two baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 393872,
      "primary_message": "Quarter mushrooms and add to the baking sheets with the sweet potato. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt"
    },
    {
      "id": 393873,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are browned and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 393874,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup white wine vinegar\n2 ½ tsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 393875,
      "primary_message": "Peel and halve onions. Slice half of the onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. (Reserve remaining onions for the next step.)",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 393876,
      "primary_message": "Small dice the remaining onions. Peel and thinly slice garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 393877,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 393878,
      "primary_message": "While the pot heats up, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 393879,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the diced onion, garlic, cumin, and salt; cook, stirring occasionally until starting to brown, 5-6 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 393880,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 393881,
      "primary_message": "When the onion is done, add beans to the pot. Cook, mashing with the back of a spoon, until beans are broken up slightly and warmed through, 4-5 minutes. Add water, hot sauce, and half of the cilantro, then stir to combine. Cover and remove from heat. (Reserve remaining cilantro for serving.)",
      "secondary_message": "¾ cup water\n2 tbsp hot sauce"
    },
    {
      "id": 393882,
      "primary_message": "Cut limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 393883,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh. Halve lengthwise, then slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 393884,
      "primary_message": "Divide beans and roasted veggies between bowls; top with avocado, pickled onion, feta, and reserved cilantro. Serve with lime wedges for squeezing and additional hot sauce. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese\n1 tbsp hot sauce"
    }
  ],
