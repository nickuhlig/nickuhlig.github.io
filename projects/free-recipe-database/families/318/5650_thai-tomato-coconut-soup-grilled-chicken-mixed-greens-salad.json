  "instructions": [
    {
      "id": 67475,
      "primary_message": "Peel and small dice the onion. Peel and mince the garlic. Peel and mince or grate the ginger.",
      "secondary_message": "1 ½ medium yellow onion\n3 cloves garlic\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 67474,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 67473,
      "primary_message": "Melt coconut oil in the pot. Add the onion, garlic, and ginger. Cook, stirring frequently, until the onion is softened, 3-4 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 67463,
      "primary_message": "Add the broth, diced tomatoes, coconut milk, salt, and pepper; stir to combine. Simmer for 10 minutes.",
      "secondary_message": "36 fl oz (4 ½ cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes\n1 ½ (13.5 oz) can coconut milk\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 67472,
      "primary_message": "Heat a grill, outdoor grill, or skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 67471,
      "primary_message": "Cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 67470,
      "primary_message": "Coat the grill or skillet with oil. Add the chicken and cook until golden brown and cooked through, 3-4 minutes per side.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 67469,
      "primary_message": "Wash and dry the mixed greens.",
      "secondary_message": "1 ½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 67468,
      "primary_message": "In a small bowl, prepare the salad dressing by whisking together lime juice, olive oil, Dijon, salt, and pepper.",
      "secondary_message": "juice of ¾ lime\n4 ½ tbsp extra virgin olive oil\n¾ tsp Dijon mustard\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 67467,
      "primary_message": "Cut remaining lime into wedges for garnishing.",
      "secondary_message": ""
    },
    {
      "id": 67466,
      "primary_message": "Using an immersion (hand) blender (or regular blender), purée the soup until smooth.",
      "secondary_message": ""
    },
    {
      "id": 67465,
      "primary_message": "Slice the chicken crosswise on an angle.",
      "secondary_message": ""
    },
    {
      "id": 67464,
      "primary_message": "Serve soup in a bowl and garnish with lime wedges. Arrange a bed of mixed greens on the side, top with chicken slices, and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
