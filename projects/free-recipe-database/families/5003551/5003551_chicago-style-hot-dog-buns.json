  "instructions": [
    {
      "id": 1,
      "primary_message": "Mix the water, yeast, sugar, and instant potatoes in the bowl of your stand mixer. Let stand for about 15 minutes until it is bubbly and frothy.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the salt, bread flour, and semolina, and knead until the dough is smooth and is becoming elastic. Cover the bowl and let the dough rest for 20 minutes, then add the oil and knead until it is fully incorporated and the dough is shiny and elastic.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cover the bowl and let the dough rise until doubled in size.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Preheat the oven to 350 degrees and sprinkle some cornmeal on a sheet pan.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Flour your work surface, and knead the dough briefly, then divide it into 8 equal pieces. Form each piece into a log 5-6 inches long, depending on how big your hot dogs are. Keep in mind that the buns will expand in length as they rise and bake.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "If you want poppy seeds or other toppings, brush the buns with an egg wash (one egg beaten with a tablespoon of water) or spray with Quick Shine to help the seeds adhere. You can also spray or brush the tops with water to make them sticky, but I find that I lose a lot more seeds that way.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Bake at 350 degrees for 40-45 minutes, until the rolls are golden brown.",
      "secondary_message": null
    }
  ],
