  "instructions": [
    {
      "id": 312129,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain eggs and transfer to a small bowl; add ice or run under cold water to cool. (Reserve saucepan for later use.)",
      "secondary_message": "4 eggs"
    },
    {
      "id": 312130,
      "primary_message": "Meanwhile, place quinoa and broth in another medium saucepan, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 312131,
      "primary_message": "While the quinoa cooks, wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n1 English cucumber\n1 avocado\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 312132,
      "primary_message": "Peel and mince garlic; place in a large bowl. Add mayo, vinegar, Dijon, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp mayonnaise\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n1 tsp basil, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 312133,
      "primary_message": "Medium dice tomatoes; trim and small dice cucumber. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 312134,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl and set aside.",
      "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 312135,
      "primary_message": "When the eggs are done, wipe the saucepan clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 312136,
      "primary_message": "While the pan heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 312137,
      "primary_message": "Once the pan is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 312138,
      "primary_message": "Transfer the cooked quinoa to a baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 312139,
      "primary_message": "Meanwhile, using a clean cutting board, peel and roughly chop eggs; add to the plate with the bacon.",
      "secondary_message": null
    },
    {
      "id": 312140,
      "primary_message": "Halve and pit avocado; scoop the flesh out with a spoon and medium dice. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 312141,
      "primary_message": "Chop or tear lettuce into bite-size pieces. Add to the salad bowl, along with cooled quinoa, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 312142,
      "primary_message": "To serve, divide quinoa salad between plates or bowls; top with bacon, egg, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
