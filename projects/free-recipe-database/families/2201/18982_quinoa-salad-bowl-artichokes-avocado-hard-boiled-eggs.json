  "instructions": [
    {
      "id": 312179,
      "primary_message": "Place quinoa and broth in a medium saucepan, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 312180,
      "primary_message": "Meanwhile, place eggs in a large pot, cover with hot water (from the tap) and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 312181,
      "primary_message": "While the eggs cook, wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n1 ½ English cucumbers\n3 avocados\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 312182,
      "primary_message": "Peel and mince garlic; place in a large bowl. Add mayo, vinegar, Dijon, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp mayonnaise\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n1 ½ tsp basil, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 312183,
      "primary_message": "Medium dice tomatoes; trim and small dice cucumbers. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 312184,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl and set aside.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 312185,
      "primary_message": "Transfer the cooked quinoa to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 312186,
      "primary_message": "Halve and pit avocados; scoop the flesh out with a spoon and medium dice. Place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 312187,
      "primary_message": "Peel and roughly chop eggs; add to the plate with the avocado. ",
      "secondary_message": null
    },
    {
      "id": 312188,
      "primary_message": "Chop or tear lettuce into bite-size pieces. Add to the salad bowl, along with cooled quinoa, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 312189,
      "primary_message": "To serve, divide quinoa salad between plates or bowls; top with avocado and egg. Enjoy!",
      "secondary_message": null
    }
  ],
