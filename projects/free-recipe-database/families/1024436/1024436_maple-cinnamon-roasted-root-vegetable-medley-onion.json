      "secondary_message": null
    },
    {
      "primary_message": "Large dice red potatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and large dice onions. Add to the bowl along with oil, maple syrup, and spices; stir to combine. Divide veggies between two baking sheet pans and spread out in an even layer.",
