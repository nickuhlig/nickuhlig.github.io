  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb sweet potato"
    },
    {
      "primary_message": "Peel and large dice sweet potatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
