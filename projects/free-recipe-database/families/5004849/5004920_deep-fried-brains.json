  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the anchovy fillets. Finely mince or grate the garlic. Mince the capers.",
      "secondary_message": "1 small can anchovy fillets\n12 cloves garlic\n1 tbsp capers"
    },
    {
      "id": 1,
      "primary_message": "Bring a 2-quart pot of water to simmer and add garlic, peppercorns, and herbs. Simmer for 15 minutes. Then gently lower the brains into the pot and simmer for 6 minutes. Remove brains with a slotted spoon and let cool. When brains are cold and firm, separate the lobes into 5-cm chunks.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, prepare 3 bowls with flour, egg whisked with milk, and breadcrumbs.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil to 177°C. Roll each brain segment in flour, then coat in egg mix, and breadcrumbs. Deep-fry brains until they are golden brown and crispy, about 3 minutes. Drain on paper towels and serve immediately with green sauce.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To Make the Green Sauce: Finely chop herbs and mix with anchovies, garlic, and capers. Add enough olive oil so that the mixture is spoonable but not runny. Season with black pepper.",
      "secondary_message": null
    }
  ],
