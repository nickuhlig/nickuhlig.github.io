  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. ",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and halve Brussels sprouts. Transfer to a large baking sheet pan. ",
      "secondary_message": "907 g Brussels sprouts"
    },
    {
      "primary_message": "Drizzle the sprouts with oil and season with spices. Stir to coat and spread out in an even layer. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¼ tsp cinnamon, ground\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven and roast until the sprouts begin to brown, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, roughly chop pecans. Place in a small bowl along with maple syrup. Stir to combine and set aside. ",
      "secondary_message": "¾ cup pecan halves\n3 tbsp pure maple syrup"
    },
    {
      "primary_message": "When the sprouts are brown, remove from oven. Top with pecans and maple syrup, then toss to combine.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Return baking sheet to the oven and continue to roast until sprouts are fork-tender and caramelized, 12-15 minutes more. Remove from oven. ",
      "secondary_message": null
    }
  ],
