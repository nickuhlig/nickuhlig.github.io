  "instructions": [
    {
      "id": 1,
      "primary_message": "Add grapefruit juice, lime juice, honey, mezcal, and salt to a resealable container. Shake or stir to mix; make sure all honey is dissolved. Place in freezer for at least 4 and up to 10 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "When ready to serve, add mezcal mixture and ice to a blender. Blend until uniform and pour into 2 glasses. Garnish each glass with half a lime wheel, if desired, and serve immediately.",
      "secondary_message": null
    }
  ],
