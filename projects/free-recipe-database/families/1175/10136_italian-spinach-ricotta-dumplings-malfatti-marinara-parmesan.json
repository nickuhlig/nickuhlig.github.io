  "instructions": [
    {
      "id": 161553,
      "primary_message": "Fill a large pot about ⅔ full with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 161554,
      "primary_message": "Meanwhile, peel and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 161555,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 161556,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring often, until starting to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 161557,
      "primary_message": "Wash spinach and set aside. (Skip if it came pre-washed.)",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 161558,
      "primary_message": "Add garlic, tomato sauce, diced tomatoes, water, sugar, and spices to the pot with the onions and stir to combine. Reduce heat to low and simmer, stirring occasionally, until slightly thickened, about 7 minutes. Cover and remove from the heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 ½ (14.5 oz) cans diced tomatoes\n1 cup water\n1 tbsp brown sugar\n¾ tsp Italian seasoning\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 161559,
      "primary_message": "Meanwhile, when the water in the pot comes to a boil, remove lid, add the spinach and stir for a few seconds. Cook the spinach, uncovered, until wilted, 30-60 seconds. Once done, transfer the spinach to a colander using a slotted spoon and rinse under cold water. ",
      "secondary_message": null
    },
    {
      "id": 161560,
      "primary_message": "Cover the pot of water with a lid and reduce heat to a simmer (this water will be reused to cook the dumplings).",
      "secondary_message": null
    },
    {
      "id": 161561,
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can, then transfer to a cutting board. Finely chop spinach and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 161562,
      "primary_message": "Peel and mince additional garlic and add to the bowl with the spinach.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 161563,
      "primary_message": "Finely grate Parmesan. Add half to the bowl with the spinach; set the rest aside for garnish.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 161564,
      "primary_message": "Add ricotta, bread crumbs, eggs, salt, and pepper to the bowl and stir until thoroughly combined.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n1 ½ cup panko bread crumbs\n3 eggs\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 161565,
      "primary_message": "Return the pot of water to a rolling boil.",
      "secondary_message": null
    },
    {
      "id": 161566,
      "primary_message": "While the water heats up, place flour on a large plate and spread out in an even layer. Using a rounded tablespoon, form the spinach-ricotta mixture into balls and place on the plate with the flour.",
      "secondary_message": "1 cup all-purpose flour"
    },
    {
      "id": 161567,
      "primary_message": "Gently roll each spinach-ricotta ball in the flour to coat. Cook in batches by carefully adding ⅓ of the dumplings to the boiling water; once they float to the top, boil for an additional 2-3 minutes. Remove to a plate using a slotted spoon.",
      "secondary_message": null
    },
    {
      "id": 161568,
      "primary_message": "Repeat with remaining dumplings.",
      "secondary_message": null
    },
    {
      "id": 161569,
      "primary_message": "To serve, divide marinara between bowls or plates and place spinach-ricotta dumplings on top. Sprinkle with reserved Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
