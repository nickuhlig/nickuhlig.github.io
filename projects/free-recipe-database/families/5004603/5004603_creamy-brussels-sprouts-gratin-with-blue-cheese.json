  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat an oven to 350°F and bring a medium pot of salted water to boil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Butter a shallow baking dish and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the Brussels sprouts to the water, bring back to a boil, and cook for 3 minutes. Drain, dry well, and arrange the sprouts in the buttered baking dish. Crumble the blue cheese over the sprouts.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a small bowl, whisk together the cream, milk and mustard. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour the cream mixture over the spouts, top with Parmesan, and transfer to the oven. Bake until the cream is bubbling and the top has begun to brown, 20-25 minutes. Allow to cool for a few minutes before serving.",
      "secondary_message": null
    }
  ],
