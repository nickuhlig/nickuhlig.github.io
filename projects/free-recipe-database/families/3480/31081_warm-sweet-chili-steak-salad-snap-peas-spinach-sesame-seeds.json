  "instructions": [
    {
      "id": 491859,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (227 g) pkg sugar snap peas\n1 medium carrot\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 491860,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 491861,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "⅓ kg flank steak\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 491862,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and snap peas; cook, stirring occasionally, until snap peas are soft and steak is cooked through, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 491863,
      "primary_message": "Meanwhile, place vinegar, sugar, water, chili-garlic sauce, and salt in a small saucepan; whisk to combine. Set over medium-high heat and bring to a boil, whisking occasionally.",
      "secondary_message": "1 ½ tbsp rice vinegar\n1 tbsp brown sugar\n1 tbsp water\n½ tsp chili-garlic sauce\n⅛ tsp salt"
    },
    {
      "id": 491864,
      "primary_message": "While the sauce comes to a boil, in a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "1 tbsp water\n1 ½ tsp cornstarch"
    },
    {
      "id": 491865,
      "primary_message": "Once the sauce is boiling, add cornstarch slurry to the pan in a steady stream while whisking quickly. Cook, whisking constantly, until the sweet chili sauce thickens, about 30 seconds. Remove from heat and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 491866,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp rice vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 491867,
      "primary_message": "Using a clean cutting board, peel and trim carrot; run a vegetable peeler along the length of the carrot to make ribbons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 491868,
      "primary_message": "Add spinach to the bowl. Using your hands, massage spinach and carrot until wilted, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 491869,
      "primary_message": "Add sweet chili sauce to the skillet with the steak and snap peas. Stir to coat.",
      "secondary_message": null
    },
    {
      "id": 491870,
      "primary_message": "To serve, divide spinach salad between plates or bowls. Top with steak and snap peas, then sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
