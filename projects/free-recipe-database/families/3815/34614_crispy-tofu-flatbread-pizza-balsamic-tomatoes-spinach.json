  "instructions": [
    {
      "id": 546220,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 546221,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 546222,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, about 10 minutes. Remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 546223,
      "primary_message": "Meanwhile, place tomato sauce and spices in a medium bowl; stir to combine the sauce and set aside.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n¾ tsp onion powder\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 546224,
      "primary_message": "Wash, dry, and halve grape tomatoes. Place on a plate, drizzle with vinegar, and season with salt. Set aside.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 tbsp balsamic vinegar\n½ tsp salt"
    },
    {
      "id": 546225,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Roughly chop and set aside.",
      "secondary_message": "1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 546226,
      "primary_message": "Coarsely grate cheese. Set aside.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 546227,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 546228,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble the tofu with your fingers into the skillet, then season with spices. Cook, stirring occasionally, until tofu is golden brown and warmed through, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 546229,
      "primary_message": "Evenly spread tomato sauce over each flatbread, then top with tomatoes, spinach, tofu, and cheese. Return prepared flatbreads to the oven and bake until pizzas are warmed through and cheese is melted, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 546230,
      "primary_message": "To serve, slice pizzas into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
