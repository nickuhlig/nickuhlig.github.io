  "instructions": [
    {
      "id": 546176,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 546177,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 546178,
      "primary_message": "Arrange flatbreads on a large baking sheet. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 546179,
      "primary_message": "Meanwhile, place tomato sauce and spices in a small bowl; stir to combine the sauce and set aside.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n1 tsp Italian seasoning\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 546180,
      "primary_message": "Wash, dry, and halve grape tomatoes. Place on a plate, drizzle with vinegar, and season with salt. Set aside.",
      "secondary_message": "1 pint grape tomatoes\n2 tsp balsamic vinegar\n¼ tsp salt"
    },
    {
      "id": 546181,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Roughly chop and set aside.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 546182,
      "primary_message": "Coarsely grate cheese. Set aside.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 546183,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 546184,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble the tofu with your fingers into the skillet, then season with spices. Cook, stirring occasionally, until tofu is golden brown and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 546185,
      "primary_message": "Evenly spread tomato sauce over each flatbread, then top with tomatoes, spinach, tofu, and cheese. Return prepared flatbreads to the oven and bake until pizzas are warmed through and cheese is melted, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 546186,
      "primary_message": "To serve, slice pizzas into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
