  "instructions": [
    {
      "id": 353876,
      "primary_message": "Place vinegar, sugar, water, chili-garlic sauce, and salt in a small saucepan; whisk to combine. Set over medium-high heat and bring to a boil, whisking occasionally.",
      "secondary_message": "1 ½ tbsp rice vinegar\n1 ½ tbsp brown sugar\n1 tbsp water\n½ tsp chili-garlic sauce\n⅛ tsp salt"
    },
    {
      "id": 353877,
      "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "1 tbsp water\n1 ½ tsp cornstarch"
    },
    {
      "id": 353878,
      "primary_message": "Once the sauce is boiling, add cornstarch slurry to the pan in a steady stream while whisking quickly. Cook, whisking constantly, until the sweet chili sauce thickens, about 30 seconds. Remove from heat, cover, and set aside.",
      "secondary_message": null
    },
    {
      "id": 353879,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 353880,
      "primary_message": "While the skillet heats up, pat salmon dry with paper towels and place skin-side down on a plate; season the top side with salt and pepper.",
      "secondary_message": "⅓ kg salmon fillet\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 353881,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 353882,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ bunch radish\n½ English cucumber\n½ avocado\n1 head butter (Boston) lettuce"
    },
    {
      "id": 353883,
      "primary_message": "Peel and mince ginger; place in a medium bowl. Add tahini, vinegar, soy sauce, oil, and chili-garlic sauce. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp tahini\n1 ½ tbsp rice vinegar\n1 ½ tbsp soy sauce\n1 tbsp toasted sesame oil\n½ tsp chili-garlic sauce"
    },
    {
      "id": 353884,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 353885,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 353886,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and thinly slice. Add to the plate with the salmon.",
      "secondary_message": null
    },
    {
      "id": 353887,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 353888,
      "primary_message": "Separate lettuce leaves; set aside two leaves per sandwich. Chop or tear remaining leaves into bite-sized pieces, then add to the bowl with the dressing and veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 353889,
      "primary_message": "Place the bottom half of a bun on each plate. Top with salmon, sweet chili sauce, avocado, and reserved lettuce leaves; close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
