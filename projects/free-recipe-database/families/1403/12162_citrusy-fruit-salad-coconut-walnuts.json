  "instructions": [
    {
      "id": 204641,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 oranges\n3 Gala apples\n3 pears"
    },
    {
      "id": 204642,
      "primary_message": "Juice half the oranges into a large bowl. Cut off skin and white pith from remaining oranges; slice between the membranes to release segments. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 204643,
      "primary_message": "Core and medium dice apples and pears. Transfer both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 204644,
      "primary_message": "Add walnuts and coconut to the bowl; stir to combine the salad.",
      "secondary_message": "1 ½ cups walnuts\n¾ cup shredded unsweetened coconut"
    },
    {
      "id": 204645,
      "primary_message": "To serve, divide fruit salad between bowls and enjoy!",
      "secondary_message": null
    }
