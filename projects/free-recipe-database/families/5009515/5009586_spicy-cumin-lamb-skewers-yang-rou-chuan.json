  "instructions": [
    {
      "id": 1,
      "primary_message": "Submerge the bamboo skewers in a container of cold water and let them soak for at least 2 hours or even overnight.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a mortar and pestle or spice grinder, coarsely grind chile flakes, cumin, and fennel. Add granulated garlic and kosher salt and briefly grind to break salt into smaller pieces and thoroughly combine ingredients.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Reserve 1 tablespoon of the spice mix in a small bowl. Add lamb to a large bowl and toss thoroughly with the remaining spice mix, oil, and Shaoxing wine. Thread lamb onto skewers, making sure meat is bunched tightly together and leaving no parts of the skewer exposed except for a 8-cm handle at the bottom, and the pointy tip at the top.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange coals on one side of the charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Grill skewers, covered, over indirect heat until lamb is nearly cooked through, about 4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Move skewers over direct heat, sprinkle with the reserved spice mix, and cook until well seared on both sides, about 1 minute total.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Remove skewers from the grill and serve right away.",
      "secondary_message": null
    }
  ],
