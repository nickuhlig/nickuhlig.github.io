  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Melt the unsalted butter. Chop the walnuts.",
      "secondary_message": "¾ cup (6 oz) unsalted butter\n¾ cup walnuts"
    },
    {
      "id": 1,
      "primary_message": "Make crust: Adjust oven rack to lower-middle position and preheat oven to 190°C (375°F). Butter 23-cm pie or tart plate. In large bowl stir flour, brown sugar, granulated sugar, and salt to combine. Stir in melted butter until moist crumbs form. Press into bottom and sides of pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large bowl, whisk brown sugar, sugar, salt, and butter until smooth and shiny. Whisk in egg, yolks, and vanilla.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In small bowl, stir flour and baking soda until combined. Stir flour mixture into egg mixture until combined. Stir in chocolate chips and nuts.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour into crust and bake until the top is golden brown and puffed, about 40 minutes. Transfer to wire rack to cool about 45 minutes before slicing. Serve warm or room temperature with ice cream and chocolate sauce (if desired).",
      "secondary_message": null
    }
  ],
