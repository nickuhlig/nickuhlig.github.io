  "instructions": [
    {
      "id": 180034,
      "primary_message": "Preheat the oven to 425°F. Line a large baking sheet pan with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 180035,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 eggplants\n1 (5 oz) pkg baby spinach\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 180036,
      "primary_message": "Trim off and discard ends of eggplants; slice lengthwise into ¼-inch thick pieces. Place on the baking sheet and rub with oil and salt on both sides. Place in the oven and cook until soft, about 10 minutes. Remove from oven and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 180037,
      "primary_message": "Meanwhile, place couscous in a large bowl.",
      "secondary_message": "½ cup whole wheat couscous"
    },
    {
      "id": 180038,
      "primary_message": "Place broth in a medium saucepan, cover, and bring to a boil over high heat. Remove from heat, pour into the bowl with the couscous, and stir. Cover tightly with foil and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 180039,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 180040,
      "primary_message": "Return the saucepan used for the broth to medium heat. Once the pan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 180041,
      "primary_message": "Add onion and garlic to the pan. Cook, stirring frequently, until onion begins to soften, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 180042,
      "primary_message": "Meanwhile, coarsely chop spinach. Shave parsley leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 180043,
      "primary_message": "Add spinach, half of the parsley, salt, and pepper to the pan; cook, stirring frequently, until the spinach is wilted, 1-2 minutes. Remove from heat and add to the bowl with the couscous along with the yogurt; stir to combine. Set aside remaining parsley.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper\n⅛ cup plain Greek yogurt"
    },
    {
      "id": 180044,
      "primary_message": "In a medium bowl, combine the diced tomatoes, tomato sauce, and spices. Spread a thin layer of the sauce over the bottom of a baking dish; set remaining sauce aside.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n1 (8 oz) can tomato sauce\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 180045,
      "primary_message": "Place a small amount of spinach-couscous mixture towards the end of each eggplant slice. Roll each slice and place, side-by-side, seam-side down, in the baking dish.",
      "secondary_message": null
    },
    {
      "id": 180046,
      "primary_message": "Grate the mozzarella.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 180047,
      "primary_message": "Pour remaining tomato sauce over the top of the rolls. Sprinkle with cheese and bake for 5-10 minutes, until the cheese is melted.",
      "secondary_message": null
    },
    {
      "id": 180048,
      "primary_message": "To serve, divide rolls between plates and garnish with remaining parsley. Enjoy!",
      "secondary_message": null
    }
  ],
