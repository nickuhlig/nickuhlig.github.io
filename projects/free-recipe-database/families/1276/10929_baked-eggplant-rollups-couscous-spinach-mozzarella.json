  "instructions": [
    {
      "id": 180064,
      "primary_message": "Preheat the oven to 425°F. Line two baking sheet pans with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 180065,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "5 eggplants\n3 (5 oz) pkgs baby spinach\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 180066,
      "primary_message": "Trim off and discard ends of eggplants; slice lengthwise into ¼-inch thick pieces. Divide between baking sheets and rub with oil and salt on both sides. Place in the oven and cook until soft, about 15 minutes. Remove from oven and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 180067,
      "primary_message": "Meanwhile, place couscous in a large bowl.",
      "secondary_message": "1 ½ cups whole wheat couscous"
    },
    {
      "id": 180068,
      "primary_message": "Place broth in a large pot, cover, and bring to a boil over high heat. Remove from heat, pour into the bowl with the couscous, and stir. Cover tightly with foil and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 180069,
      "primary_message": "Peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "3 medium yellow onions\n12 cloves garlic"
    },
    {
      "id": 180070,
      "primary_message": "Return the pot to medium heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 180071,
      "primary_message": "Add onion and garlic to the pot. Cook, stirring frequently, until onion begins to soften, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 180072,
      "primary_message": "Meanwhile, coarsely chop spinach. Shave parsley leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 180073,
      "primary_message": "Add spinach, half of the parsley, salt, and pepper to the pot; cook, stirring frequently, until the spinach is wilted, 3-4 minutes. Remove from heat and add to the bowl with the couscous along with the yogurt; stir to combine. Set aside remaining parsley.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper\n⅜ cup plain Greek yogurt"
    },
    {
      "id": 180074,
      "primary_message": "In a large bowl, combine the diced tomatoes, tomato sauce, and spices. Spread a thin layer of the sauce over the bottom of a large baking dish; set remaining sauce aside.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n3 (8 oz) cans tomato sauce\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 180075,
      "primary_message": "Place a small amount of spinach-couscous mixture towards the end of each eggplant slice. Roll each slice and place, side-by-side, seam-side down, in the baking dish.",
      "secondary_message": null
    },
    {
      "id": 180076,
      "primary_message": "Grate the mozzarella.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 180077,
      "primary_message": "Pour remaining tomato sauce over the top of the rolls. Sprinkle with cheese and bake for 10-12 minutes, until the cheese is melted.",
      "secondary_message": null
    },
    {
      "id": 180078,
      "primary_message": "To serve, divide rolls between plates and garnish with remaining parsley. Enjoy!",
      "secondary_message": null
    }
  ],
