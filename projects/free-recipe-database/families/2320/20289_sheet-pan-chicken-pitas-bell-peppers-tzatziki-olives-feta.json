  "instructions": [
    {
      "id": 339068,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 339069,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n1 lemon\n2 red bell peppers\n2 green bell peppers"
    },
    {
      "id": 339070,
      "primary_message": "Trim and coarsely grate cucumber, then transfer to a colander and sprinkle with salt. Place the colander in a bowl to catch excess moisture and set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 339071,
      "primary_message": "Juice lemon into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 339072,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice along with oil and spices. Stir to combine the marinade.",
      "secondary_message": "4 cloves garlic\n2 tbsp extra virgin olive oil\n2 tsp salt\n2 tsp cumin, ground\n2 tsp paprika\n2 tsp curry powder\n½ tsp cinnamon, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 339073,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin pieces; add to the bowl with the marinade.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 339074,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 339075,
      "primary_message": "Pat chicken dry with paper towels and cut crosswise into thin strips; add to the bowl and stir to coat. Transfer veggies and chicken to a large baking sheet pan and spread out in an even layer.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 339076,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until veggies are tender and chicken is cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 339077,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince additional garlic; place in a small bowl. Add yogurt and spices, then stir to combine.",
      "secondary_message": "2 cloves garlic\n1 cup plain Greek yogurt\n1 tsp dill, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 339078,
      "primary_message": "Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add cucumber to the yogurt mixture and stir to combine the tzatziki; set aside.",
      "secondary_message": null
    },
    {
      "id": 339079,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 339080,
      "primary_message": "Cut pitas in half and carefully open the pockets; spread each pocket with tzatziki, then stuff with chicken, veggies, olives, and feta.",
      "secondary_message": "4 whole grain pitas\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 339081,
      "primary_message": "To serve, divide pita pockets between plates and enjoy!",
      "secondary_message": null
    }
  ],
