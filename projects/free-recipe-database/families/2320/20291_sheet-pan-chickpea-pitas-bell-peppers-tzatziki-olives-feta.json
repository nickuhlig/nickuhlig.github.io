  "instructions": [
    {
      "id": 339096,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 339097,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n½ lemon\n1 red bell pepper\n1 green bell pepper"
    },
    {
      "id": 339098,
      "primary_message": "Trim and coarsely grate cucumber, then transfer to a colander and sprinkle with salt. Place the colander in a bowl to catch excess moisture and set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 339099,
      "primary_message": "Using a strainer, drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 339100,
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 339101,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice along with oil and spices. Stir to combine the marinade.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n1 tsp salt\n1 tsp cumin, ground\n1 tsp paprika\n1 tsp curry powder\n¼ tsp cinnamon, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 339102,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin pieces; add to the bowl with the marinade.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 339103,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl, along with the chickpeas, and stir to coat. Transfer veggies and chickpeas to a baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 339104,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until veggies and chickpeas are tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 339105,
      "primary_message": "Meanwhile, peel and mince additional garlic; place in the reserved bowl. Add yogurt and spices, then stir to combine.",
      "secondary_message": "1 clove garlic\n½ cup plain Greek yogurt\n½ tsp dill, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 339106,
      "primary_message": "Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add cucumber to the yogurt mixture and stir to combine the tzatziki; set aside.",
      "secondary_message": null
    },
    {
      "id": 339107,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 339108,
      "primary_message": "Cut pitas in half and carefully open the pockets; spread each pocket with tzatziki, then stuff with chickpeas, veggies, olives, and feta.",
      "secondary_message": "2 whole grain pitas\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 339109,
      "primary_message": "To serve, divide pita pockets between plates and enjoy!",
      "secondary_message": null
    }
  ],
