  "instructions": [
    {
      "id": 339040,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 339041,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n1 ½ lemons\n3 red bell peppers\n3 green bell peppers"
    },
    {
      "id": 339042,
      "primary_message": "Trim and coarsely grate cucumbers, then transfer to a colander and sprinkle with salt. Place the colander in a bowl to catch excess moisture and set aside.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 339043,
      "primary_message": "Using a strainer, drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 339044,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 339045,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice along with oil and spices. Stir to combine the marinade.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n1 tbsp salt\n1 tbsp cumin, ground\n1 tbsp paprika\n1 tbsp curry powder\n¾ tsp cinnamon, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 339046,
      "primary_message": "Peel, halve, and slice onions lengthwise into thin pieces; add to the bowl with the marinade.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 339047,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl, along with the chickpeas, and stir to coat. Divide veggies and chickpeas between two baking sheet pans and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 339048,
      "primary_message": "Place baking sheets in the oven and roast, stirring halfway through, until veggies and chickpeas are tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 339049,
      "primary_message": "Meanwhile, peel and mince additional garlic; place in the reserved bowl. Add yogurt and spices, then stir to combine.",
      "secondary_message": "3 cloves garlic\n1 ½ cups plain Greek yogurt\n1 ½ tsp dill, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 339050,
      "primary_message": "Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add cucumber to the yogurt mixture and stir to combine the tzatziki; set aside.",
      "secondary_message": null
    },
    {
      "id": 339051,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 339052,
      "primary_message": "Cut pitas in half and carefully open the pockets; spread each pocket with tzatziki, then stuff with chickpeas, veggies, olives, and feta.",
      "secondary_message": "6 whole grain pitas\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 339053,
      "primary_message": "To serve, divide pita pockets between plates and enjoy!",
      "secondary_message": null
    }
  ],
