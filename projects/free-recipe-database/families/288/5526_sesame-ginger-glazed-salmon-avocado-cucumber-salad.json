  "instructions": [
    {
      "id": 66240,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger.",
      "secondary_message": "3 cloves garlic\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 66239,
      "primary_message": "In a shallow bowl, whisk together the minced garlic and ginger, soy sauce, vinegar, and sesame oil.",
      "secondary_message": "6 tbsp soy sauce\n3 tbsp rice vinegar\n1 ½ tsp toasted sesame oil"
    },
    {
      "id": 66238,
      "primary_message": "Place the salmon flesh side down in the marinade and coat both sides; let it sit while you prepare the salad dressing.",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 66237,
      "primary_message": "In a large bowl, prepare the salad dressing by whisking together the mayo, vinegar, soy sauce, sesame oil, and salt.",
      "secondary_message": "3 tbsp mayonnaise\n6 tbsp rice vinegar\n1 ½ tsp soy sauce\n1 ½ tsp toasted sesame oil\n⅜ tsp salt"
    },
    {
      "id": 66236,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 66235,
      "primary_message": "Add the sesame seeds to the skillet and cook, stirring frequently, until lightly browned, 3-4 minutes. Transfer to a small bowl.",
      "secondary_message": "3 tsp sesame seeds"
    },
    {
      "id": 66234,
      "primary_message": "Once sesame seeds have been removed, increase heat to medium-high. Add oil to the skillet and swirl to coat bottom. Place salmon in the skillet skin-side down, reserving marinade in the bowl. Cook until skin is crisp, 3-4 minutes, then flip over and pour the reserved marinade over top. Continue cooking salmon in the marinade until opaque, 3-4 more minutes.",
      "secondary_message": "1 ½ tbsp toasted sesame oil"
    },
    {
      "id": 66233,
      "primary_message": "Wash the fresh produce.",
      "secondary_message": "3 English cucumbers\n3 avocados\n1 ½ small bunch green onions (scallions)"
    },
    {
      "id": 66232,
      "primary_message": "Halve the cucumbers crosswise, then quarter lengthwise and slice crosswise on an angle; add to the bowl with dressing. Halve and pit the avocados; scoop out the flesh with a spoon and medium dice; add to the bowl. Trim onion ends and thinly chop on an angle; add to the bowl. Gently toss until well combined.",
      "secondary_message": ""
    },
    {
      "id": 66231,
      "primary_message": "To serve, place salmon on a plate and sprinkle with toasted sesame seeds. Serve with salad on the side and enjoy!",
      "secondary_message": ""
    }
  ],
