  "instructions": [
    {
      "id": 24590,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger.",
      "secondary_message": "1 clove garlic\r\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 24591,
      "primary_message": "In a shallow bowl, whisk together the minced garlic and ginger, coconut aminos, vinegar, and sesame oil.",
      "secondary_message": "2 tbsp coconut aminos\r\n1 tbsp rice vinegar\r\n½ tsp toasted sesame oil"
    },
    {
      "id": 24592,
      "primary_message": "Place the salmon flesh side down in the marinade and coat both sides; let it sit while you prepare the salad dressing.",
      "secondary_message": "0.34 kg salmon fillet"
    },
    {
      "id": 24593,
      "primary_message": "In a medium bowl, prepare the salad dressing by whisking together the mayo, vinegar, coconut aminos, sesame oil, and salt.",
      "secondary_message": "1 tbsp avocado oil mayonnaise\n2 tbsp rice vinegar\n½ tsp coconut aminos\n½ tsp toasted sesame oil\n⅛ tsp salt"
    },
    {
      "id": 24594,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 24595,
      "primary_message": "Add the sesame seeds to the skillet and cook, stirring frequently, until lightly browned, 3-4 minutes. Transfer to a small bowl.",
      "secondary_message": "1 tsp sesame seeds\r\n"
    },
    {
      "id": 24596,
      "primary_message": "Once sesame seeds have been removed, increase heat to medium-high. Add oil to the skillet and swirl to coat bottom. Place salmon in the skillet skin-side down, reserving marinade in the bowl. Cook until skin is crisp, 3-4 minutes, then flip over and pour the reserved marinade over top. Continue cooking salmon in the marinade until opaque, 3-4 more minutes.",
      "secondary_message": "½ tbsp toasted sesame oil\r\n"
    },
    {
      "id": 24597,
      "primary_message": "Wash the fresh produce.",
      "secondary_message": "1 English cucumber\r\n1 avocado\r\n½ small bunch green onions (scallions)"
    },
    {
      "id": 24598,
      "primary_message": "Halve the cucumber crosswise, then quarter lengthwise and slice crosswise on an angle; add to the bowl with dressing. Halve and pit the avocado; scoop out the flesh with a spoon and medium dice; add to the bowl. Trim onion ends and thinly chop on an angle; add to the bowl. Gently toss until well combined.",
      "secondary_message": ""
    },
    {
      "id": 24599,
      "primary_message": "To serve, place salmon on a plate and sprinkle with toasted sesame seeds. Serve with salad on the side and enjoy!",
      "secondary_message": ""
    }
  ],
