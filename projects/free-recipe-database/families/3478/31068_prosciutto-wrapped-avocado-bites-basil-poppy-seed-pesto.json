  "instructions": [
    {
      "id": 491765,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; discard stems and mince the leaves. Place in a small bowl along with poppy seeds, oil, vinegar, salt, and pepper. Stir to combine the pesto and set aside.",
      "secondary_message": "½ small pkg fresh basil\n2 tbsp poppy seeds\n2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 491766,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh. Cut each half lengthwise into six wedges. ",
      "secondary_message": "3 avocados"
    },
    {
      "id": 491767,
      "primary_message": "Cut prosciutto slices in half lengthwise. Wrap each avocado wedge with a piece of prosciutto.",
      "secondary_message": "18 slices prosciutto"
    },
    {
      "id": 491768,
      "primary_message": "To serve, divide wrapped avocado between plates and top with pesto. Enjoy!",
      "secondary_message": null
    }
