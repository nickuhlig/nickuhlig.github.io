  "instructions": [
    {
      "id": 491769,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; discard stems and mince the leaves. Place in a small bowl along with poppy seeds, oil, vinegar, salt, and pepper. Stir to combine the pesto and set aside.",
      "secondary_message": "¼ small pkg fresh basil\n2 tsp poppy seeds\n2 tsp extra virgin olive oil\n1 tsp apple cider vinegar\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 491770,
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh. Cut each half lengthwise into six wedges. ",
      "secondary_message": "1 avocado"
    },
    {
      "id": 491771,
      "primary_message": "Cut prosciutto slices in half lengthwise. Wrap each avocado wedge with a piece of prosciutto.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 491772,
      "primary_message": "To serve, divide wrapped avocado between plates and top with pesto. Enjoy!",
      "secondary_message": null
    }
