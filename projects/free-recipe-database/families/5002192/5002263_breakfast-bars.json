  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly chop the pitted Medjool dates.",
      "secondary_message": "5 medium pitted Medjool dates"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 165°C (325°F)(160℃). Coat an 20-cm square baking pan with cooking spray; line bottom and sides with parchment paper, leaving a 5-cm overhang on all sides. Line a large baking sheet with parchment paper. Set both aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, stir oats, brown sugar, oil, and 2 tablespoons of the honey until well combined. Spread oat mixture evenly onto the parchment-lined baking sheet. Bake, stirring every 5 minutes and returning to an even layer, until golden brown and crisp, about 15 minutes. Let cool completely on a wire rack, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While oats are cooling, in a food processor, process dates and seed or nut butter until smooth, 1 to 2 minutes, scraping down sides of processor bowl as needed.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a large bowl, stir together the cooled oats, sunflower butter mixture, dried fruit, chia seeds, hemp seeds, sunflower kernels, fruit preserves, salt, and remaining 1 tablespoon honey until well combined and the mixture holds together, 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spread oat mixture firmly into the bottom of prepared baking pan, using bottom of a greased measuring cup to press into a flat even layer. Press plastic wrap directly onto surface of oats mixture; wrap baking pan in additional plastic wrap, and refrigerate until cold and firm, at least 8 hours or up to 3 days.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Remove and discard plastic. Using parchment overhang as handles, remove bars; place on a cutting board. Cut bars into 1 1/4- x 10-cm squares. Serve or refrigerate in an airtight container for up to 3 weeks.",
      "secondary_message": null
    }
  ],
