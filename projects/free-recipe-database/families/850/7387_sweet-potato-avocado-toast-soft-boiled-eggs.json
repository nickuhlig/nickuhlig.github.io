  "instructions": [
    {
      "id": 105646,
      "primary_message": "Preheat oven to broil and position rack in the middle of the oven.",
      "secondary_message": null
    },
    {
      "id": 105647,
      "primary_message": "Place eggs in a small saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 105648,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lb sweet potato\n1 avocado\n½ lemon"
    },
    {
      "id": 105649,
      "primary_message": "Trim off and discard ends of sweet potatoes; peel and slice lengthwise into ½-inch thick pieces. Discard the two small, outer slices, then place remaining slices on a baking sheet lined with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 105650,
      "primary_message": "Rub the oil over both sides of the sweet potato slices, then season with salt.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 105651,
      "primary_message": "Place sweet potatoes in the oven and broil, flipping halfway through, 8-10 minutes, or until tender. (Keep a close watch on the sweet potatoes to avoid burning.)",
      "secondary_message": null
    },
    {
      "id": 105652,
      "primary_message": "Halve and pit the avocado, then scoop out into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 105653,
      "primary_message": "Grate zest from the lemon and set aside, then juice lemon into the bowl with the avocado. Add salt and garlic powder and mash with a potato masher or fork; set aside.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp garlic powder"
    },
    {
      "id": 105654,
      "primary_message": "Peel and halve the eggs.",
      "secondary_message": null
    },
    {
      "id": 105655,
      "primary_message": "To serve, spread a spoonful of avocado mash over each slice of sweet potato; top with eggs, lemon zest, chili powder, and salt. Enjoy!",
      "secondary_message": "¼ tsp chili powder\n⅛ tsp salt"
    }
  ],
