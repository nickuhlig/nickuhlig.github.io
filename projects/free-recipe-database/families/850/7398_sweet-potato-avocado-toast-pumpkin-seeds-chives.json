  "instructions": [
    {
      "id": 105751,
      "primary_message": "Preheat oven to broil and position rack in the middle of the oven.",
      "secondary_message": null
    },
    {
      "id": 105752,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1.36 kg sweet potatoes\n3 avocados\n1 ½ lemons\n1 ½ small pkgs chives"
    },
    {
      "id": 105753,
      "primary_message": "Trim off and discard ends of sweet potatoes; peel and slice lengthwise into ½-inch thick pieces. Discard any small, outer slices, then place remaining slices on a baking sheet lined with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 105754,
      "primary_message": "Rub the oil over both sides of the sweet potato slices, then season with salt.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅜ tsp salt"
    },
    {
      "id": 105755,
      "primary_message": "Place sweet potatoes in the oven and broil, flipping halfway through, 8-10 minutes, or until tender. (Keep a close watch on the sweet potatoes to avoid burning.)",
      "secondary_message": null
    },
    {
      "id": 105756,
      "primary_message": "Halve and pit the avocados, then scoop out into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 105757,
      "primary_message": "Grate zest from the lemons and set aside, then juice lemons into the bowl with the avocado. Add salt and garlic powder and mash with a potato masher or fork; set aside.",
      "secondary_message": "⅜ tsp salt\n⅜ tsp garlic powder"
    },
    {
      "id": 105758,
      "primary_message": "Trim off and discard ends of chives; mince chives crosswise into ⅛-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 105759,
      "primary_message": "To serve, spread a spoonful of avocado mash over each slice of sweet potato; top with pumpkin seeds, chives, lemon zest, and chili powder. Enjoy!",
      "secondary_message": "¾ cup pumpkin seeds\n¾ tsp chili powder"
    }
  ],
