  "instructions": [
    {
      "id": 37776,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.227 kg sweet potatoes\n1 avocado\n½ small bunch cilantro"
    },
    {
      "id": 37777,
      "primary_message": "Peel and small dice the onion; transfer to a small bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 37778,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 37779,
      "primary_message": "While the saucepan warms up, peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 37780,
      "primary_message": "Add the ground beef to the saucepan; cook, breaking apart with a spoon, until crumbly and browned, 3 to 5 minutes. Once done, transfer the beef to a bowl and leave the juices in the saucepan.",
      "secondary_message": "0.34 kg lean ground beef"
    },
    {
      "id": 37781,
      "primary_message": "Once the beef has been transferred, add the onion to the saucepan; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 37782,
      "primary_message": "While the onion cooks, peel and medium dice the sweet potatoes; leave on cutting board.",
      "secondary_message": null
    },
    {
      "id": 37783,
      "primary_message": "Add the garlic and sweet potatoes to the saucepan and stir to combine; cook, stirring occasionally, for 2 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 37784,
      "primary_message": "Return the ground beef to the saucepan; season with chili powder, cumin, salt, and pepper. Stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "1 tbsp chili powder\n½ tsp cumin\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 37785,
      "primary_message": "Add the diced tomatoes to the saucepan and stir to combine. Cook the chili until the sweet potatoes are tender, 5 to 7 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes"
    },
    {
      "id": 37786,
      "primary_message": "While the chili cooks, halve the avocado lengthwise and twist to open, then remove the pit with a knife or spoon; scoop out and medium dice the flesh. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 37787,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Stir half into the chili and transfer the rest to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 37788,
      "primary_message": "To serve, spoon the chili into a bowl and garnish with avocado and remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
