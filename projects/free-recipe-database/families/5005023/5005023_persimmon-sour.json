  "instructions": [
    {
      "id": 1,
      "primary_message": "First, make a persimmon purée by blending two persimmons—stem removed—with 1/2 to 1 ounce simple syrup (to taste) in a blender.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a cocktail shaker filled with ice, combine 1 1/2 ounces persimmon purée, with gin and lime juice. Shake for 15 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Strain into a glass and garnish with a lime slice.",
      "secondary_message": null
    }
