  "instructions": [
    {
      "id": 558043,
      "primary_message": "Preheat oven to 500°F. Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 558044,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Drizzle with oil and toss once more to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "1 lb chicken wings, split with tips removed\n1 tbsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 558045,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 558046,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 (1 inch) piece ginger root\n1 (6 oz) pkg blueberries\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 558047,
      "primary_message": "Zest and juice lemon into a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 558048,
      "primary_message": "Peel and mince ginger. Add to the pan with the lemon, along with blueberries and sugar, then stir to combine the sauce. Set over medium heat and cook, stirring often, until blueberries burst and sauce is thickened, 6-8 minutes. Cover and remove from heat.",
      "secondary_message": "2 tsp brown sugar"
    },
    {
      "id": 558049,
      "primary_message": "Meanwhile, place oil, vinegar, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 558050,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the dressing and set aside.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 558051,
      "primary_message": "When the wings are done, remove from the oven. Place in another clean medium bowl, drizzle with sauce, and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 558052,
      "primary_message": "Crumble goat cheese into the bowl with the dressing. Add spinach and toss to combine the salad.",
      "secondary_message": "½ (4 oz) log goat cheese"
    },
    {
      "id": 558053,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
