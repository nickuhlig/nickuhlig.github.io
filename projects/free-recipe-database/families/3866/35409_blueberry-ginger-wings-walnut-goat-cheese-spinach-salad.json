  "instructions": [
    {
      "id": 558065,
      "primary_message": "Preheat oven to 500°F. Line two baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 558066,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Drizzle with oil and toss once more to coat. Divide between the baking sheets and spread out in an even layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed\n3 tbsp cornstarch\n¾ tsp salt\n½ tsp black pepper\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 558067,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 558068,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 (1 inch) pieces ginger root\n3 (6 oz) pkgs blueberries\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 558069,
      "primary_message": "Zest and juice lemons into a large pot.",
      "secondary_message": null
    },
    {
      "id": 558070,
      "primary_message": "Peel and mince ginger. Add to the pot with the lemon, along with blueberries and sugar, then stir to combine the sauce. Set over medium heat and cook, stirring often, until blueberries burst and sauce is thickened, 6-8 minutes. Cover and remove from heat.",
      "secondary_message": "2 tbsp brown sugar"
    },
    {
      "id": 558071,
      "primary_message": "Meanwhile, place oil, vinegar, salt, and pepper in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 558072,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the dressing and set aside.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 558073,
      "primary_message": "When the wings are done, remove from the oven. Place in another clean large bowl, drizzle with sauce, and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 558074,
      "primary_message": "Crumble goat cheese into the bowl with the dressing. Add spinach and toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 558075,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
