  "instructions": [
    {
      "id": 461638,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 461639,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed\n2 tbsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 461640,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 461641,
      "primary_message": "About 5 minutes before the wings are done, wash, dry, trim, and thinly slice radishes. Place in a medium bowl.",
      "secondary_message": "1 bunch radish"
    },
    {
      "id": 461642,
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the bowl with the radish along with shredded cabbage and half of the dressing. Toss to combine the slaw and set aside. (Place remaining dressing in another medium bowl and reserve for the next step.)",
      "secondary_message": "1 avocado\n1 (397 g) bag shredded cabbage (coleslaw mix)\n⅔ cup honey mustard dressing"
    },
    {
      "id": 461643,
      "primary_message": "Add hot sauce to the reserved bowl with the dressing and whisk to combine the sauce.",
      "secondary_message": "2 tbsp hot sauce"
    },
    {
      "id": 461644,
      "primary_message": "When the wings are done, remove from oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 461645,
      "primary_message": "To serve, divide wings and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
