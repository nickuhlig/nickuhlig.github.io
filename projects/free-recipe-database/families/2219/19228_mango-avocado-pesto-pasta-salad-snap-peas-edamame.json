  "instructions": [
    {
      "id": 316477,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 316478,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 mangoes\n1 ½ avocados\n1 ½ small pkgs fresh basil\n1 ½ limes\n3 medium carrots\n3 (227 g) pkg sugar snap peas\n1 small bunch green onions (scallions)"
    },
    {
      "id": 316479,
      "primary_message": "Peel mangos and slice flesh away from the pits, starting with the flat sides; medium dice and place half in a blender. Place the other half in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 316480,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, scoop out with a spoon, and add to the blender with the mango.",
      "secondary_message": null
    },
    {
      "id": 316481,
      "primary_message": "Peel and mince garlic; pick basil leaves off the stems. Add both to the blender.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 316482,
      "primary_message": "Juice limes into the blender; add water, oil, salt, and crushed red pepper. Blend on high until mango pesto is very smooth, adding water a few tablespoons at a time, if necessary, to reach a saucy consistency; set aside.",
      "secondary_message": "½ cup water\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 316483,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 316484,
      "primary_message": "Halve snap peas and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 316485,
      "primary_message": "Trim and thinly slice green onions crosswise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 316486,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; drain and add to the bowl.",
      "secondary_message": "2 ¼ cups edamame"
    },
    {
      "id": 316487,
      "primary_message": "When the pasta is done, drain and add to the bowl along with the mango pesto; stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 316488,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
