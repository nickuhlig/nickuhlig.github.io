    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "4 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Using an offset spatula, generously butter 4 slices white sandwich bread. In a bowl, season chips generously with salt and a few dashes of malt vinegar, if desired. Top 2 slices of buttered bread with a handful of chips and top with remaining 2 slices of bread, pressing firmly to help the chips adhere to the bread. Serve immediately with HP sauce, or ketchup, if desired.",
      "secondary_message": null
    }
