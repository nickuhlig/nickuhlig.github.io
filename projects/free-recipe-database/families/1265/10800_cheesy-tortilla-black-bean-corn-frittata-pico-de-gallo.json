  "instructions": [
    {
      "id": 176575,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 tomatoes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n3 green bell peppers"
    },
    {
      "id": 176576,
      "primary_message": "Juice limes into a medium bowl. Small dice tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 176577,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs of jalapeños with a spoon. Finely dice and add to the bowl with the lime juice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 176578,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in the bowl with the lime juice; set the other half aside in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 176579,
      "primary_message": "Peel and mince onion; add ⅓ of the onion to the bowl with the lime juice. Season with salt and stir to combine the pico de gallo. Set aside.",
      "secondary_message": "1 ½ medium yellow onions\n¾ tsp salt"
    },
    {
      "id": 176580,
      "primary_message": "Seed and slice bell peppers into thin strips. Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 176581,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 176582,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add remaining onion, bell pepper, garlic, corn, and spices to the skillet. Cook, stirring often, until veggies are soft, about 8 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ cups frozen corn\n¾ tsp cumin\n¾ tsp chili powder\n¾ tsp salt"
    },
    {
      "id": 176583,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 176584,
      "primary_message": "Grate the cheddar. ",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 176585,
      "primary_message": "Add eggs, salt, pepper, and half the cheese to the large bowl with the cilantro; whisk to combine. ",
      "secondary_message": "18 eggs\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 176586,
      "primary_message": "Drain and rinse the beans in a colander. Cut or tear tortillas into bite-sized pieces. Add both to the skillet with the veggies and stir to combine. Continue to cook until heated through, 3-4 minutes, then spread out evenly in the skillet.",
      "secondary_message": "1 ½ (398 ml) cans black beans\n6 small corn tortillas"
    },
    {
      "id": 176587,
      "primary_message": "Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 7-9 minutes. ",
      "secondary_message": null
    },
    {
      "id": 176588,
      "primary_message": "Sprinkle frittata with the remaining cheese. Place skillet in the oven and broil until the top is set, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 176589,
      "primary_message": "Cut the frittata into wedges and divide between plates. Serve with pico de gallo on the side and enjoy!",
      "secondary_message": null
    }
  ],
