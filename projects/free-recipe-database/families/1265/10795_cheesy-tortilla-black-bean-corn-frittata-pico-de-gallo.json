  "instructions": [
    {
      "id": 176500,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n1 tomato\n½ jalapeño pepper\n½ small bunch cilantro\n1 green bell pepper"
    },
    {
      "id": 176501,
      "primary_message": "Juice lime into a small bowl. Small dice tomato and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 176502,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the bowl with the lime juice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 176503,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in the bowl with the lime juice; set the other half aside in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 176504,
      "primary_message": "Peel and mince onion; add ⅓ of the onion to the bowl with the lime juice. Season with salt and stir to combine the pico de gallo. Set aside.",
      "secondary_message": "½ medium yellow onion\n¼ tsp salt"
    },
    {
      "id": 176505,
      "primary_message": "Seed and slice bell pepper into thin strips. Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 176506,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 176507,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add remaining onion, bell pepper, garlic, corn, and spices to the skillet. Cook, stirring often, until veggies are soft, 5-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ cup frozen corn\n¼ tsp cumin\n¼ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 176508,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 176509,
      "primary_message": "Grate the cheddar. ",
      "secondary_message": "⅓ (8 oz) block cheddar cheese"
    },
    {
      "id": 176510,
      "primary_message": "Add eggs, salt, pepper, and half the cheese to the medium bowl with the cilantro; whisk to combine. ",
      "secondary_message": "6 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 176511,
      "primary_message": "Drain and rinse the beans in a colander. Cut or tear tortillas into bite-sized pieces. Add both to the skillet with the veggies and stir to combine. Continue to cook until heated through, 1-2 minutes, then spread out evenly in the skillet.",
      "secondary_message": "½ (15 oz) can black beans\n2 small corn tortillas"
    },
    {
      "id": 176512,
      "primary_message": "Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 176513,
      "primary_message": "Sprinkle frittata with the remaining cheese. Place skillet in the oven and broil until the top is set, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 176514,
      "primary_message": "Cut the frittata into wedges and divide between plates. Serve with pico de gallo on the side and enjoy!",
      "secondary_message": null
    }
  ],
