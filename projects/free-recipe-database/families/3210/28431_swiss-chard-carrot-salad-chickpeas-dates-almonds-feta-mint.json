  "instructions": [
    {
      "id": 508284,
      "primary_message": "Place vinegar, honey, and salt in a small bowl, then stir to combine the pickling liquid. Set aside.",
      "secondary_message": "¼ cup white wine vinegar\n1 ½ tsp honey\n¾ tsp salt"
    },
    {
      "id": 508285,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ bunches Swiss chard\n3 lemons\n9 medium carrots\n1 small pkg fresh mint"
    },
    {
      "id": 508286,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Add stems to the bowl with the pickling liquid and stir to combine; place leaves in a medium bowl. Set both aside.",
      "secondary_message": null
    },
    {
      "id": 508287,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 508288,
      "primary_message": "While the skillet heats up, roughly chop almonds.",
      "secondary_message": "¾ cup almonds"
    },
    {
      "id": 508289,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring constantly, until lightly browned, 2-3 minutes. Set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 508290,
      "primary_message": "Zest and juice lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 508291,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon along with oil, honey, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n⅓ cup extra virgin olive oil\n2 tbsp honey\n2 tsp cumin, ground\n1 ½ tsp salt\n1 ½ tsp coriander, ground\n¾ tsp crushed red pepper"
    },
    {
      "id": 508292,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the dressing.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 508293,
      "primary_message": "Roughly chop dates. Add to the bowl.",
      "secondary_message": "¾ cup medjool dates, pitted"
    },
    {
      "id": 508294,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 508295,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl along with feta, pickled chard stems, and chard leaves. Toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    },
    {
      "id": 508296,
      "primary_message": "To serve, divide salad between plates or bowls; top with toasted almonds. Enjoy!",
      "secondary_message": null
    }
  ],
