      "name": "salt",
      "quantity": "¼ tsp"
    },
    {
      "ingredient_id": 121,
      "name": "egg, at room temperature",
      "quantity": "1 large"
    },
    {
      "ingredient_id": 3641,
      "name": "egg yolk, at room temperature",
      "quantity": "1 large"
    },
    {
      "ingredient_id": 2525,
      "name": "brandy",
      "quantity": "1 ½ tsp"
    },
    {
