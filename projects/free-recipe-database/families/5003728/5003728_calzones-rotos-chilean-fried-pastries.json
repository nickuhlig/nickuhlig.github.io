  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in Dutch oven or large pot over medium-high heat until temperature registers 350°F (oil should be about 1 1/2 inches deep). Line a baking sheet with two layers of paper towels.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While oil is heating, sift together flour, confectioners’ sugar, baking powder, and salt directly onto clean, dry work surface. Gather dry ingredients into a mound and make a well in the center.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In small bowl, whisk together egg, egg yolk, brandy, and lemon zest. Pour egg mixture into flour well. Add butter. With fork, quickly combine flour mixture and egg mixture until a crumbly dough is formed. Gather dough together with hands and knead just until it is smooth and cohesive.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Lightly dust counter and rolling pin with additional flour and roll dough out into a rectangle 1/4-inch thick. Cut dough into approximately 4- by 2-inch rectangles. Cut a vertical slit, about 1-inch long, in the center of each dough rectangle.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Gently hold short end of dough rectangle and tuck into slit, gently pulling it up to shape the pastry.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Repeat with remaining rectangles.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Fry calzones in batches of four or five until they are golden brown, about 3 minutes per batch. Using a slotted spoon or spider, transfer calzones to prepared baking sheet.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Once all the calzones are fried, dust them with additional confectioners’ sugar. Serve warm.",
      "secondary_message": null
    }
  ],
