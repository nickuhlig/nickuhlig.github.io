  "instructions": [
    {
      "id": 1,
      "primary_message": "After removing steaks from pan, turn heat to high, add olive oil and heat until shimmering. Add shallots and cook until softened and lightly browned, about 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add in beef stock and bring to a boil, scrapping browned bits off bottom of pan with a spoon. Let boil until reduced to around 1/4 cup, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add in heavy cream, brandy, red wine, and green peppercorns and cook until slightly thickened, about 3 minutes. Add in thyme and season with salt and pepper to taste; use immediately.",
      "secondary_message": null
    }
  ],
