  "instructions": [
    {
      "id": 330547,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pineapple\n2 jalapeño peppers\n1 avocado\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 330548,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 330549,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice. Transfer to the baking sheet; drizzle with oil, toss to combine, and spread out in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 330550,
      "primary_message": "Thinly slice jalapeños into rounds and sprinkle on top of the pineapple. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 330551,
      "primary_message": "Place baking sheet in the oven and broil until the pineapple is golden and slightly charred, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 330552,
      "primary_message": "Meanwhile, place vinegar, honey, and salt in a large bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp white wine vinegar\n2 tsp honey\n½ tsp salt"
    },
    {
      "id": 330553,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the bowl with the pickling liquid. Stir to combine and set aside.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 330554,
      "primary_message": "When the pineapple is done, remove from oven. Carefully remove broiled pineapple from the baking sheet by lifting the corners of the foil and transferring the whole sheet to a flat surface. ",
      "secondary_message": null
    },
    {
      "id": 330555,
      "primary_message": "Pat the pork chops dry with paper towels and place on the baking sheet; season with salt and pepper on both sides. ",
      "secondary_message": "4 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 330556,
      "primary_message": "Place baking sheet in the oven and broil the chops, flipping once, until golden brown and cooked through, 8-10 minutes. Remove from oven and let rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 330557,
      "primary_message": "While the chops are broiling, add oil, additional salt, and pepper to the bowl with the pickled onions. Stir to combine.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 330558,
      "primary_message": "Right before serving, halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl with the onions along with the pineapple, jalapeño, arugula, and feta. Gently toss to combine the salad.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 330559,
      "primary_message": "Thinly slice chops. ",
      "secondary_message": null
    },
    {
      "id": 330560,
      "primary_message": "To serve, divide salad and chops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
