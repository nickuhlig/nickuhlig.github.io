  "instructions": [
    {
      "id": 445992,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445993,
      "primary_message": "While the skillet heats up, roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 445994,
      "primary_message": "Once the skillet is hot, add walnuts and cook, stirring frequently, until lightly toasted, 2-3 minutes. Transfer to a small bowl. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 445995,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook according to package instructions). Remove from heat and cover to keep warm.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 pre-cooked vegan sausage"
    },
    {
      "id": 445996,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 fennel bulb\n2 sticks celery\n1 Granny Smith apple\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 445997,
      "primary_message": "Juice lemon into a medium bowl. Add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 445998,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 445999,
      "primary_message": "Trim and medium dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 446000,
      "primary_message": "Quarter, core, and thinly slice apple. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 446001,
      "primary_message": "Pick parsley leaves off the stems; discard stems. Add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 446002,
      "primary_message": "Using a peeler, shave Parmesan into curls.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 446003,
      "primary_message": "To serve, divide sausages and salad between plates; top salad with walnuts and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
