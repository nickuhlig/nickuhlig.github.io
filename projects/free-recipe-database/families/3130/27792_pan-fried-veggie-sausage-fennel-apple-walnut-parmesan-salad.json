  "instructions": [
    {
      "id": 445911,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445912,
      "primary_message": "While the skillet heats up, roughly chop walnuts.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 445913,
      "primary_message": "Once the skillet is hot, add walnuts and cook, stirring frequently, until lightly toasted, 2-3 minutes. Transfer to a small bowl. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 445914,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook according to package instructions). Remove from heat and cover to keep warm.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 445915,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 fennel bulbs\n6 sticks celery\n3 Granny Smith apples\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 445916,
      "primary_message": "Juice lemons into a large bowl. Add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n2 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445917,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 445918,
      "primary_message": "Trim and medium dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 445919,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 445920,
      "primary_message": "Pick parsley leaves off the stems; discard stems. Add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 445921,
      "primary_message": "Using a peeler, shave Parmesan into curls.",
      "secondary_message": "4 ½ oz Parmesan cheese"
    },
    {
      "id": 445922,
      "primary_message": "To serve, divide sausages and salad between plates; top salad with walnuts and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
