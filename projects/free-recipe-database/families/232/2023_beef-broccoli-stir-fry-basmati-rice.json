  "instructions": [
    {
      "id": 18921,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) water"
    },
    {
      "id": 18922,
      "primary_message": "Wash broccoli. Separate into bite-sized florets and cut stems into smaller pieces. Transfer to a plate.",
      "secondary_message": "4 crowns broccoli"
    },
    {
      "id": 40234,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 18923,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 18924,
      "primary_message": "Peel and thinly slice onion into half rings. Peel and mince garlic. Peel and mince or grate ginger.",
      "secondary_message": "1 medium red onion\r\n2 cloves garlic\r\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 18925,
      "primary_message": "Thinly slice steak against the grain into strips.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak"
    },
    {
      "id": 18926,
      "primary_message": "Coat bottom of skillet with oil. Add steak and stir fry until browned, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 18927,
      "primary_message": "Coat skillet with more oil, then add onion, garlic, ginger, and crushed red pepper. Stir fry until onion is softened, 3-4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 18928,
      "primary_message": "Add broccoli and stir fry until bright green and tender-crisp, 4-5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 18929,
      "primary_message": "Add steak, soy sauce, sesame oil, and pepper; toss to combine.",
      "secondary_message": "4 tbsp soy sauce\r\n1 tbsp toasted sesame oil\r\n¼ tsp black pepper"
    },
    {
      "id": 40233,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 18930,
      "primary_message": "Place rice in a bowl and top with stir fry. Enjoy!",
      "secondary_message": ""
    }
  ],
