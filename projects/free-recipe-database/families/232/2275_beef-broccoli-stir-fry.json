  "instructions": [
    {
      "id": 21726,
      "primary_message": "Wash broccoli. Separate into bite-sized florets and cut stems into smaller pieces. Transfer to a plate.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 21727,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 21728,
      "primary_message": "Peel and thinly slice onion into half rings. Peel and mince garlic. Peel and mince or grate ginger.",
      "secondary_message": "½ medium red onion\r\n1 clove garlic\r\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 21729,
      "primary_message": "Thinly slice steak against the grain into strips.",
      "secondary_message": "0.34 kg striploin (New York strip) steak"
    },
    {
      "id": 21730,
      "primary_message": "Coat bottom of skillet with oil. Add steak and stir fry until browned, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 21731,
      "primary_message": "Coat skillet with more oil, then add onion, garlic, ginger, and crushed red pepper. Stir fry until onion is softened, 3-4 minutes.",
      "secondary_message": "½ tbsp virgin coconut oil\r\n⅛ tsp crushed red pepper"
    },
    {
      "id": 21732,
      "primary_message": "Add broccoli and stir fry until bright green and tender-crisp, 4-5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 21733,
      "primary_message": "Add steak, coconut aminos, sesame oil, and pepper; toss to combine.",
      "secondary_message": "2 tbsp coconut aminos\r\n½ tbsp toasted sesame oil\r\n⅛ tsp black pepper"
    },
    {
      "id": 21734,
      "primary_message": "Place stir fry in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
