  "ingredients": [
    {
      "ingredient_id": 229,
      "name": "ripe mangoes, peeled and diced, 4 1/2 to 5 cups",
      "quantity": "0.91 kg"
    },
    {
      "ingredient_id": 359,
      "name": "water",
      "quantity": "¼ cup"
    },
    {
      "ingredient_id": 346,
      "name": "sugar",
      "quantity": "¾ cup"
    },
    {
      "ingredient_id": 1421,
      "name": "lime juice, more or less to taste",
      "quantity": "1 tsp"
    },
    {
      "ingredient_id": 88,
      "name": "kosher salt, more or less to taste",
      "quantity": "½ tsp"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "Pack diced mangoes in blender with water and blend on high speed until very smooth, about 30 seconds. Pour through a fine-mesh strainer into a large measuring cup, pushing purée through strainer with a spoon, until you have 3 cups of purée. Reserve remainder for another use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer strained purée into a large bowl and whisk in sugar until well dissolved. Whisk in lime juice and salt in small increments, adding more to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Chill purée in refrigerator until very cold, 2 to 3 hours. Churn in ice cream maker according to manufacturer's instructions, then transfer to airtight container and chill in freezer at least 4 hours before serving.",
      "secondary_message": null
    }
  ],
