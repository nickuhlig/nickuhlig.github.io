  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash and dry fish. In a medium bowl, combine flour and salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place dashi, mirin, soy sauce, and sugar in a small sauce pan and mix well. Over medium heat, bring to a simmer and stir, dissolving sugar. Let cool and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In wok, heat oil to about 350°F. Have ready a plate lined with paper towels, and the dipping sauce at hand. Lightly dredge each fish in the bowl of flour and salt, shaking off excess salt. Deep-fry for 2 to 3 minutes, until skin is golden brown. Place fried fish on paper towels to soak up oil, then eat immediately with sauce and sections of lemon.",
      "secondary_message": null
    }
  ],
