  "instructions": [
    {
      "id": 75845,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "12 medium carrots\n3 small bunches asparagus"
    },
    {
      "id": 75844,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Cut the carrots crosswise into 1-inch chunks and transfer to a medium saucepan.",
      "secondary_message": ""
    },
    {
      "id": 75843,
      "primary_message": "Cover the carrots with hot water (from the tap) by about 1 inch; bring to a boil over high heat.",
      "secondary_message": ""
    },
    {
      "id": 75842,
      "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears into 2-inch pieces at an angle and transfer to a bowl.",
      "secondary_message": ""
    },
    {
      "id": 75841,
      "primary_message": "Once the water in the saucepan is boiling, reduce the heat slightly and simmer until the carrots are tender when pierced with a knife, 15 to 20 minutes. Once the carrots are cooked, reserve 1 ½ cup of cooking water and drain the carrots in a colander. Return the carrots to the saucepan.",
      "secondary_message": ""
    },
    {
      "id": 75840,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 75839,
      "primary_message": "While the skillet heats up, pat the cod dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb cod fillet\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 75838,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 75837,
      "primary_message": "Carefully place the cod in the skillet; cook until it is opaque throughout and flakes easily, 2 to 4 minutes per side (depending on thickness). Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 75836,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 75835,
      "primary_message": "Once the cod has been transferred, add more coconut oil to the skillet, then add the asparagus and season with salt and pepper. Cook the asparagus, stirring occasionally, until bright green and tender-crisp, 3 to 5 minutes. Once done, remove the skillet from the heat.",
      "secondary_message": "1 ½ tbsp virgin coconut oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 75834,
      "primary_message": "To the carrots, add ½ of the reserved cooked water, garlic, butter, salt, and pepper; mash with a potato masher or purée with a hand blender until smooth. Add more cooking water to thin out the mash if needed.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 75833,
      "primary_message": "To serve, divide the carrot purée between plates, then top with the asparagus and cod. Enjoy!",
      "secondary_message": ""
    }
  ],
