  "instructions": [
    {
      "id": 418539,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 418540,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 hearts romaine hearts\n1 yellow bell pepper\n½ bunch radish\n½ avocado"
    },
    {
      "id": 418541,
      "primary_message": "Pat chicken dry with paper towels and transfer to a baking dish; drizzle with oil, sprinkle with taco seasoning on both sides, and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n1 tsp extra virgin olive oil\n1 ½ tbsp taco seasoning"
    },
    {
      "id": 418542,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until cooked through, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 418543,
      "primary_message": "Meanwhile, chop or tear romaine into bite-sized pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 418544,
      "primary_message": "Trim, seed, and medium dice bell pepper; trim and thinly slice radishes. Add both to the bowl with the romaine and set aside.",
      "secondary_message": null
    },
    {
      "id": 418545,
      "primary_message": "When the chicken is done, remove from oven and sprinkle with cheese. Return to the oven and bake until cheese is melted and golden, 4-5 minutes more.",
      "secondary_message": "½ cup shredded cheese, Mexican blend"
    },
    {
      "id": 418546,
      "primary_message": "Meanwhile, halve and pit avocado; scoop out with a spoon and medium dice. Add to the bowl with the veggies and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 418547,
      "primary_message": "To serve, divide salad between bowls; top with cheesy chicken and drizzle with dressing. Enjoy!",
      "secondary_message": "¼ cup ranch dressing"
    }
  ],
