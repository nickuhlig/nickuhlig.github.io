  "instructions": [
    {
      "id": 418530,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 418531,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 hearts romaine hearts\n3 yellow bell peppers\n1 ½ bunches radish\n1 ½ avocados"
    },
    {
      "id": 418532,
      "primary_message": "Pat chicken dry with paper towels and transfer to a baking sheet pan; drizzle with oil, sprinkle with taco seasoning on both sides, and spread out in an even layer.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n1 tbsp extra virgin olive oil\n¼ cup taco seasoning"
    },
    {
      "id": 418533,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until just cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 418534,
      "primary_message": "Meanwhile, chop or tear romaine into bite-sized pieces; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 418535,
      "primary_message": "Trim, seed, and medium dice bell peppers; trim and thinly slice radishes. Add both to the bowl with the romaine and set aside.",
      "secondary_message": null
    },
    {
      "id": 418536,
      "primary_message": "When the chicken is done, remove from oven and sprinkle with cheese. Return to the oven and bake until cheese is melted and golden, about 5 minutes.",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 418537,
      "primary_message": "Meanwhile, halve and pit avocados; scoop out with a spoon and medium dice. Add to the bowl with the veggies and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 418538,
      "primary_message": "To serve, divide salad between bowls; top with cheesy chicken and drizzle with dressing. Enjoy!",
      "secondary_message": "¾ cup ranch dressing"
    }
  ],
