  "instructions": [
    {
      "id": 418548,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 418549,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 hearts romaine hearts\n2 yellow bell peppers\n1 bunch radish\n1 avocado"
    },
    {
      "id": 418550,
      "primary_message": "Pat chicken dry with paper towels and transfer to a large baking dish; drizzle with oil, sprinkle with taco seasoning on both sides, and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n2 tsp extra virgin olive oil\n3 tbsp taco seasoning"
    },
    {
      "id": 418551,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until cooked through, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 418552,
      "primary_message": "Meanwhile, chop or tear romaine into bite-sized pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 418553,
      "primary_message": "Trim, seed, and medium dice bell peppers; trim and thinly slice radishes. Add both to the bowl with the romaine and set aside.",
      "secondary_message": null
    },
    {
      "id": 418554,
      "primary_message": "When the chicken is done, remove from oven and sprinkle with cheese. Return to the oven and bake until cheese is melted and golden, 4-5 minutes more.",
      "secondary_message": "1 cup shredded cheese, Mexican blend"
    },
    {
      "id": 418555,
      "primary_message": "Meanwhile, halve and pit avocado; scoop out with a spoon and medium dice. Add to the bowl with the veggies and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 418556,
      "primary_message": "To serve, divide salad between bowls; top with cheesy chicken and drizzle with dressing. Enjoy!",
      "secondary_message": "½ cup ranch dressing"
    }
  ],
