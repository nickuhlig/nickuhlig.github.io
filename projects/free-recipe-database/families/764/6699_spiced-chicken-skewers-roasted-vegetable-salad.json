  "instructions": [
    {
      "id": 164374,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 164375,
      "primary_message": "Combine spices and oil in a medium bowl. ",
      "secondary_message": "1 tbsp curry powder\n1 tbsp cumin\n1 ½ tsp turmeric\n1 ½ tsp chili powder\n1 ½ tsp salt\n1 ½ tsp black pepper\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 164376,
      "primary_message": "Pat chicken dry with paper towels, cut into 1-inch pieces and place in the medium bowl with the spice mix; toss to combine.",
      "secondary_message": "2 ¼ lb chicken thighs, boneless skinless"
    },
    {
      "id": 164377,
      "primary_message": "Thread chicken onto skewers and place on a broiler pan. If you don't have skewers you can put the chicken directly on the pan. Set pan aside.",
      "secondary_message": null
    },
    {
      "id": 164378,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium zucchini squash\n3 small bunches asparagus\n1 ½ small bunches green onions (scallions)\n1 ½ lemons\n3 red bell peppers\n1 ½ small pkgs fresh mint"
    },
    {
      "id": 164379,
      "primary_message": "Trim zucchini and green onions; chop zucchini into 1-inch pieces and green onions into ¼-inch pieces. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 164380,
      "primary_message": "Snap (or cut) off the woody ends of the asparagus and cut into thirds; add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "id": 164381,
      "primary_message": "Remove seeds and membranes from peppers and slice into thin strips; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 164382,
      "primary_message": "Peel and mince the garlic; add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 164383,
      "primary_message": "Juice lemons into the bowl with the vegetables. Add oil, salt, and pepper; toss to combine.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 164384,
      "primary_message": "Spread vegetables in an even layer on two parchment lined baking sheets. Put both the veggies and the chicken skewers in the oven and bake until chicken is cooked through and veggies are tender, about 15 minutes. Toss veggies and turn chicken half-way through.",
      "secondary_message": null
    },
    {
      "id": 164385,
      "primary_message": "Pick mint leaves off the stems; discard the stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 164386,
      "primary_message": "When chicken and vegetables are done, remove from the oven and toss mint with the veggies.",
      "secondary_message": null
    },
    {
      "id": 164387,
      "primary_message": "To serve, divide chicken and vegetables between plates; crumble cheese over the veggies and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
