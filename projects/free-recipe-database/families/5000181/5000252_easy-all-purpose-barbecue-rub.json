  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk all rub ingredients together to combine. Use your fingertips to break up any large clumps of brown sugar. For better flavor, before combining, toast ground mustard, black pepper, and coriander in a dry skillet over medium heat until fragrant. Store rub in a sealed container at room temperature for up to 4 months. (It will lose flavor over time, but it will not go bad.)",
      "secondary_message": null
    }
