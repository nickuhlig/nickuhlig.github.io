  "instructions": [
    {
      "id": 416697,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 416698,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 416699,
      "primary_message": "Place oil, vinegar, salt, and crushed red pepper in a medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 416700,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise, then slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 416701,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 416702,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n½ tsp salt"
    },
    {
      "id": 416703,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 416704,
      "primary_message": "Meanwhile, wash, dry, and cut lemon into wedges. Set aside for serving.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 416705,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl with the kale, along with the cooled pine nuts, and gently toss to combine the salad.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 416706,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 416707,
      "primary_message": "To serve, divide salad and steak between plates, then squeeze lemon over top. Enjoy!",
      "secondary_message": null
    }
  ],
