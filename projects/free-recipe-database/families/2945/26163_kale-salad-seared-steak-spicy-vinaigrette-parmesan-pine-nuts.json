  "instructions": [
    {
      "id": 416686,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 416687,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 416688,
      "primary_message": "Place oil, vinegar, salt, and crushed red pepper in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 416689,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise, then slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 2-3 minutes. Set aside.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 416690,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 416691,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt"
    },
    {
      "id": 416692,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 416693,
      "primary_message": "Meanwhile, wash, dry, and cut lemons into wedges. Set aside for serving.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 416694,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl with the kale, along with the cooled pine nuts, and gently toss to combine the salad.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 416695,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 416696,
      "primary_message": "To serve, divide salad and steak between plates, then squeeze lemon over top. Enjoy!",
      "secondary_message": null
    }
  ],
