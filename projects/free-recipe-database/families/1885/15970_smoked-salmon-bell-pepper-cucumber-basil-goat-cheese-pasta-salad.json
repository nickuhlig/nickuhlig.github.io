  "instructions": [
    {
      "id": 262119,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool; set aside.",
      "secondary_message": "1 tbsp salt\n425 g rotini pasta"
    },
    {
      "id": 262120,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 red bell peppers\n1 ½ English cucumbers\n3 small pkgs fresh basil"
    },
    {
      "id": 262121,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 262122,
      "primary_message": "Peel and mince garlic and onion; add both to the bowl with the lemon juice.",
      "secondary_message": "3 cloves garlic\n½ medium red onion"
    },
    {
      "id": 262123,
      "primary_message": "Add yogurt, mayo, vinegar, and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tbsp red wine vinegar\n1 ½ tsp salt\n¾ tsp Italian seasoning\n½ tsp black pepper"
    },
    {
      "id": 262124,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 262125,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 262126,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 262127,
      "primary_message": "Add pasta to the bowl with the veggies and stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 262128,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "3 (113 g) pkg smoked salmon"
    },
    {
      "id": 262129,
      "primary_message": "To serve, divide pasta salad and salmon between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "3 (113 g) logs goat cheese"
    }
  ],
