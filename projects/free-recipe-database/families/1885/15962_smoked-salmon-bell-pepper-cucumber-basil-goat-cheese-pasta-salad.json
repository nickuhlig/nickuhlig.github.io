  "instructions": [
    {
      "id": 262031,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool; set aside.",
      "secondary_message": "1 tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 262032,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 red bell pepper\n½ English cucumber\n1 small pkg fresh basil"
    },
    {
      "id": 262033,
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 262034,
      "primary_message": "Peel and mince garlic and shallot; add both to the bowl with the lemon juice.",
      "secondary_message": "1 clove garlic\n1 shallot"
    },
    {
      "id": 262035,
      "primary_message": "Add yogurt, mayo, vinegar, and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 tsp red wine vinegar\n½ tsp salt\n¼ tsp Italian seasoning\n⅛ tsp black pepper"
    },
    {
      "id": 262036,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 262037,
      "primary_message": "Trim and medium dice cucumber; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 262038,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 262039,
      "primary_message": "Add pasta to the bowl with the veggies and stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 262040,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 262041,
      "primary_message": "To serve, divide pasta salad and salmon between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese"
    }
  ],
