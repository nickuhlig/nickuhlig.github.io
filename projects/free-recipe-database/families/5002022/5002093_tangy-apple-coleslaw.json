  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Slaw: In a large colander, combine cabbage, carrot, and apple. Sprinkle with sugar and salt and toss to combine. Let sit for 5 minutes, then rinse thoroughly under cold running water.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, prepare the dressing: In a small bowl, whisk sour cream, mayonnaise, apple cider vinegar, sugar, honey, black pepper, mustard powder, and poppy seeds to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To Assemble: Transfer vegetables to a salad spinner and spin dry. Alternatively, transfer to a 13- by 46-cm rimmed baking sheet lined with a triple layer of paper towels or a clean kitchen towel. Blot mixture dry with paper towels, and place vegetables in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour dressing over slaw and toss to coat. Adjust seasoning with additional salt, pepper, and sugar as needed.",
      "secondary_message": null
    }
  ],
