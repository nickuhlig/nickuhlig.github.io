  "instructions": [
    {
      "id": 247917,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n1 ½ small pkgs grape tomatoes\n3 (142 g) pkg baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 247918,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 247919,
      "primary_message": "Preheat a large pot over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 247920,
      "primary_message": "While the pot heats up, small dice bacon. ",
      "secondary_message": "6 slices bacon"
    },
    {
      "id": 247921,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove to a paper towel-lined plate, leaving the drippings in the pot.",
      "secondary_message": null
    },
    {
      "id": 247922,
      "primary_message": "Meanwhile, trim zucchini and use a julienne (or regular) peeler to make noodles. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 247923,
      "primary_message": "Halve the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 247924,
      "primary_message": "Return pot (with bacon drippings) to medium heat; add tomatoes and spices to the pot. Cook, stirring occasionally, until tomatoes soften, 4-5 minutes.",
      "secondary_message": "1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 247925,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 247926,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 247927,
      "primary_message": "Add garlic and shrimp to the pot; cook until shrimp are opaque, about 2 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 247928,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 247929,
      "primary_message": "Add zucchini noodles, Parmesan (reserving a small handful for garnish), and cream to the pot; stir to combine. Cook, stirring occasionally, until the sauce is melted and combined, 2-3 minutes.",
      "secondary_message": "355 ml heavy whipping cream"
    },
    {
      "id": 247930,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half the to pot (reserving the rest for garnish) and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 247931,
      "primary_message": "To serve, divide shrimp, veggies, and sauce between bowls. Top with bacon and remaining Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
