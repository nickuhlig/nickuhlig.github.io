  "instructions": [
    {
      "id": 259077,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 259078,
      "primary_message": "Peel and mince garlic; place in a small bowl along with oil and spices. Stir to combine the garlic oil.",
      "secondary_message": "6 cloves garlic\n2 tbsp extra virgin olive oil\n¾ tsp rosemary, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 259079,
      "primary_message": "Drizzle garlic oil over the flatbreads, cut into 1½-inch wide strips, and transfer to a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 259080,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp honey\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 259081,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 ears corn\n3 peaches\n1 ½ avocados\n1 small pkg fresh basil\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 259082,
      "primary_message": "Remove husks and silks from the corn. Using a knife, carefully slice corn kernels off the cobs; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 259083,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist to separate and remove pit. Medium dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259084,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259085,
      "primary_message": "Peel and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 259086,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259087,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259088,
      "primary_message": "Crumble goat cheese into the bowl and gently stir to combine the salad.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 259089,
      "primary_message": "To serve, divide salad and breadsticks between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
