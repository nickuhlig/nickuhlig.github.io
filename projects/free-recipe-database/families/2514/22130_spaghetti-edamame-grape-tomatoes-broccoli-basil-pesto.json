  "instructions": [
    {
      "id": 427503,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 8 minutes.",
      "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
    },
    {
      "id": 427504,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise. Set aside.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 427505,
      "primary_message": "When the pasta is almost done, add broccoli and edamame to the pot. Continue to cook, stirring occasionally, until pasta reaches desired firmness and veggies are tender, 2-3 minutes more.",
      "secondary_message": "1 (18 oz) bag broccoli florets\n2 cups edamame"
    },
    {
      "id": 427506,
      "primary_message": "When the pasta and veggies are done, drain in the colander and return to the pot. Add tomatoes and pesto, then toss to combine.",
      "secondary_message": "½ cup basil pesto"
    },
    {
      "id": 427507,
      "primary_message": "To serve, divide pasta between plates or bowls and top with Parmesan. Enjoy!",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
