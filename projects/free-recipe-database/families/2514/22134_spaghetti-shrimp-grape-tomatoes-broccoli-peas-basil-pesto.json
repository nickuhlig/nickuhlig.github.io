  "instructions": [
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 8 minutes.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise. Set aside.",
      "secondary_message": "3 pints grape tomatoes"
    },
    {
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "primary_message": "When the pasta is almost done, add shrimp, broccoli, and peas to the pot. Continue to cook, stirring occasionally, until pasta reaches desired firmness, shrimp are cooked through, and veggies are tender, 3-4 minutes more.",
      "secondary_message": "1 ½ (18 oz) bags broccoli florets\n1 ½ cups frozen peas"
    },
    {
      "primary_message": "When the pasta, shrimp, and veggies are done, drain in a clean colander and return to the pot. Add tomatoes and pesto, then toss to combine.",
      "secondary_message": "¾ cup basil pesto"
    },
    {
      "primary_message": "To serve, divide pasta between plates or bowls and top with Parmesan. Enjoy!",
      "secondary_message": "¾ cup Parmesan cheese, shredded"
    }
  ],
