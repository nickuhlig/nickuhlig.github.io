  "instructions": [
    {
      "id": 429769,
      "primary_message": "Drain and rinse beans in a colander. Transfer to a medium bowl and pat dry with paper towels. Add cheese, hot sauce, salt, and pepper, then stir to combine the filling.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans\n½ (4 oz) pkg crumbled blue cheese\n3 tbsp hot sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 429770,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 429771,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide bean filling between them, arranging on one half of each tortilla. Fold tortillas in half to close. (Reserve bowl for the salad.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 429772,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add quesadillas and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 429773,
      "primary_message": "Meanwhile, wash, dry and chop (or tear) lettuce into bite-sized pieces. Wipe the reserved bowl clean with paper towels (if desired); place lettuce, carrots, and vinaigrette in the bowl, then toss to combine the salad.",
      "secondary_message": "1 heart romaine hearts\n½ (10 oz) bag shredded carrots\n3 tbsp French vinaigrette"
    },
    {
      "id": 429774,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
