  "instructions": [
    {
      "id": 429799,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces. ",
      "secondary_message": "1 ½ (850 g) whole chickens rotisserie chicken, white and dark meat"
    },
    {
      "id": 429800,
      "primary_message": "Lay tortillas on a flat surface and divide shredded chicken between them, arranging on one half of each tortilla. Top chicken with cheese and drizzle with hot sauce, then fold in half to close.",
      "secondary_message": "6 large flour tortillas\n1 ½ (113 g) pkgs crumbled blue cheese\n½ cup hot sauce"
    },
    {
      "id": 429801,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 429802,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 429803,
      "primary_message": "Meanwhile, wash and dry lettuce. Using a clean cutting board, chop (or tear) lettuce into bite-sized pieces. Place in a large bowl along with carrots and vinaigrette, then toss to combine the salad.",
      "secondary_message": "3 hearts romaine hearts\n1 ½ (283 g) bags shredded carrots\n½ cup French vinaigrette"
    },
    {
      "id": 429804,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
