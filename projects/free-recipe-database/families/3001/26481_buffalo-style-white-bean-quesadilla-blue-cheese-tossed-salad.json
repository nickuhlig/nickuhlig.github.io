  "instructions": [
    {
      "id": 429781,
      "primary_message": "Drain and rinse beans in a colander. Transfer to a large bowl and pat dry with paper towels. Add cheese, hot sauce, salt, and pepper, then stir to combine the filling.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans\n1 ½ (4 oz) pkgs crumbled blue cheese\n½ cup hot sauce\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 429782,
      "primary_message": "Lay tortillas on a flat surface and divide bean filling between them, arranging on one half of each tortilla. Fold tortillas in half to close. (Reserve bowl for the salad.)",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 429783,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 429784,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 429785,
      "primary_message": "Meanwhile, wash, dry and chop (or tear) lettuce into bite-sized pieces. Wipe the reserved bowl clean with paper towels (if desired); place lettuce, carrots, and vinaigrette in the bowl, then toss to combine the salad.",
      "secondary_message": "3 hearts romaine hearts\n1 ½ (10 oz) bags shredded carrots\n½ cup French vinaigrette"
    },
    {
      "id": 429786,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
