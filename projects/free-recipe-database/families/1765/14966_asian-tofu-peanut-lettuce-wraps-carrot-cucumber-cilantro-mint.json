  "instructions": [
    {
      "id": 247306,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 247307,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n3 medium carrots\n1 ½ English cucumbers\n1 small bunch cilantro\n1 small pkg fresh mint\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 247308,
      "primary_message": "Zest and juice limes into a small bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 247309,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 247310,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 247311,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until soft and golden, 4-5 minutes.",
      "secondary_message": "⅓ cup toasted sesame oil"
    },
    {
      "id": 247312,
      "primary_message": "Crumble the tofu with your fingers into the skillet. Add half the lime mixture (reserving the rest for the sauce), sugar, chili-garlic sauce, and salt to the skillet; stir to combine. Cook, stirring often, until tofu turns golden brown, 10-12 minutes.",
      "secondary_message": "2 tbsp brown sugar\n1 tbsp chili-garlic sauce\n1 ½ tsp salt"
    },
    {
      "id": 247313,
      "primary_message": "While the tofu is cooking, add soy sauce, sugar, and chili-garlic sauce to the bowl with the reserved lime mixture. Whisk to combine the sauce and set aside.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp brown sugar\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 247314,
      "primary_message": "Peel, trim, and thinly slice carrots; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 247315,
      "primary_message": "Trim and small dice cucumbers; add to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 247316,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl with the veggies. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 247317,
      "primary_message": "Peel and mince garlic. Roughly chop peanuts.",
      "secondary_message": "3 cloves garlic\n1 ½ cups peanuts, roasted unsalted"
    },
    {
      "id": 247318,
      "primary_message": "When the tofu is golden brown, add garlic and peanuts to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 247319,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with salad and tofu-peanut mixture; drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
