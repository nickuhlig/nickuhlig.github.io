  "instructions": [
    {
      "id": 247194,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 247195,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 medium carrot\n½ English cucumber\n½ small bunch cilantro\n½ small pkg fresh mint\n½ head butter (Boston) lettuce"
    },
    {
      "id": 247196,
      "primary_message": "Zest and juice lime into a small bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 247197,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 247198,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 247199,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the shallot and cook, stirring often, until soft and golden, 2-3 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 247200,
      "primary_message": "Crumble the tofu with your fingers into the skillet. Add half the lime mixture (reserving the rest for the sauce), sugar, chili-garlic sauce, and salt to the skillet; stir to combine. Cook, stirring often, until tofu turns golden brown, 8-10 minutes.",
      "secondary_message": "2 tsp brown sugar\n1 tsp chili-garlic sauce\n½ tsp salt"
    },
    {
      "id": 247201,
      "primary_message": "While the tofu is cooking, add soy sauce, sugar, and chili-garlic sauce to the bowl with the reserved lime mixture. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 tbsp soy sauce\n2 tsp brown sugar\n½ tsp chili-garlic sauce"
    },
    {
      "id": 247202,
      "primary_message": "Peel, trim, and thinly slice carrot; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 247203,
      "primary_message": "Trim and small dice cucumber; add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 247204,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl with the veggies. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 247205,
      "primary_message": "Peel and mince garlic. Roughly chop peanuts.",
      "secondary_message": "1 clove garlic\n½ cup peanuts, roasted unsalted"
    },
    {
      "id": 247206,
      "primary_message": "When the tofu is golden brown, add garlic and peanuts to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 247207,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with salad and tofu-peanut mixture; drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
