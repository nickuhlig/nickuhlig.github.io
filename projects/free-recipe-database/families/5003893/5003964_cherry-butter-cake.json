  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Halve the pitted cherries.",
      "secondary_message": "6 tbsp unsalted butter\n1 cup pitted"
    },
    {
      "id": 1,
      "primary_message": "Butter pan and preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour, baking powder, baking soda, and salt; set aside. In the bowl of a stand mixer, beat together butter and sugar until creamy, about 4 minutes. Add eggs one at a time, beating until just combined. Beat in lemon zest.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add 1/2 dry ingredients to bowl and beat to combine. Beat in milk then remaining dry ingredients. Stir in cherries.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour batter into prepared pan and bake until a cake tester inserted into the middle of the cake comes out clean and top is golden, 30-40 minutes. Let cool 15 minutes before turning out of pan.",
      "secondary_message": null
    }
  ],
