  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cut or tear mozzarella into bite-sized pieces.\n\n",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "primary_message": "Arrange pita breads on a large baking sheet pan. Spread sauce over each pita, then top with shredded cheese and mozzarella. Place in the oven (it doesn't have to be fully heated) and bake until pitas are slightly crisp and cheese is melted, 12-15 minutes. Remove from oven and let cool slightly, 5 minutes. \n\n",
      "secondary_message": "1 (397 g) jar pizza sauce\n2 cups shredded cheese, Italian blend"
    },
    {
      "primary_message": "To serve, cut pizzas into wedges, divide between plates, and enjoy!",
      "secondary_message": null
    }
  ],
