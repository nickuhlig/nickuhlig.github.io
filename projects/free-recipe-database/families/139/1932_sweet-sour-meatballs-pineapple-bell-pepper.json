  "instructions": [
    {
      "id": 17836,
      "primary_message": "In a medium bowl, combine beef, bread crumbs, salt, and pepper. Mix well.",
      "secondary_message": "1 ½ lb lean ground beef\n¼ cup panko bread crumbs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 17837,
      "primary_message": "Peel and medium dice onion. Wash, seed, and medium dice bell peppers. Cut off skin from pineapple, core, and cut into bite-sized pieces.",
      "secondary_message": "1 medium red onion\r\n2 green bell peppers\r\n2 red bell peppers\r\n1 small pineapple"
    },
    {
      "id": 17838,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 17839,
      "primary_message": "Form beef mixture into small meatballs and place on a plate.",
      "secondary_message": ""
    },
    {
      "id": 17840,
      "primary_message": "Coat bottom of skillet with oil. Add meatballs and, turning often, cook until browned on all sides, 3-4 minutes. Transfer to a plate.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 17841,
      "primary_message": "In a medium bowl, prepare sauce by whisking together broth, vinegar, honey, soy sauce, and cornstarch.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n4 tbsp white wine vinegar\n2 tbsp honey\n1 tbsp soy sauce\n1 tbsp cornstarch"
    },
    {
      "id": 17842,
      "primary_message": "Return skillet to stove and add more oil. Add onion and bell peppers. Stirring frequently, cook until tender-crisp, 2-3 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 17843,
      "primary_message": "Stir in pineapple and cook for about 1 minute.",
      "secondary_message": ""
    },
    {
      "id": 17844,
      "primary_message": "Pour in sauce and return meatballs to skillet. Season with salt and pepper. Stir to combine and cook until sauce is thickened, 3-4 minutes.",
      "secondary_message": "¼ tsp salt\r\n⅛ tsp crushed red pepper"
    },
    {
      "id": 17845,
      "primary_message": "To serve, place in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
