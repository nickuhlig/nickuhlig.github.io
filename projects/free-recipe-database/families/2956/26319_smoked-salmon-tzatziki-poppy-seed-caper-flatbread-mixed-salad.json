  "instructions": [
    {
      "id": 425200,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 425201,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven and set aside to cool slightly, about 3 minutes. ",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 425202,
      "primary_message": "Meanwhile, peel and mince shallots. Place in a large bowl along with the vinaigrette.",
      "secondary_message": "2 shallots\n½ cup French vinaigrette"
    },
    {
      "id": 425203,
      "primary_message": "Wash, dry, trim, and thinly slice radishes. Add to the bowl with the vinaigrette and set aside. ",
      "secondary_message": "1 ½ bunches radish"
    },
    {
      "id": 425204,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 425205,
      "primary_message": "Once the flatbreads have cooled slightly, spread tzatziki over the surface. Top with smoked salmon, capers, and poppy seeds. Slice flatbreads into wedges.",
      "secondary_message": "1 ½ cups tzatziki sauce\n3 tbsp capers\n1 ½ tsp poppy seeds"
    },
    {
      "id": 425206,
      "primary_message": "Wash and dry mixed greens (skip this step if they came pre-washed). Add to the bowl with the vinaigrette and radishes, then toss to combine the salad. ",
      "secondary_message": "1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 425207,
      "primary_message": "To serve, divide flatbread and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
