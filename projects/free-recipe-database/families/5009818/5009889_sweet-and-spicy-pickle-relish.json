  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine prepared green pepper, cucumber, and onion in a large, non-reactive (stainless steel or enamel-coated) pot. Stir in one cup of apple cider vinegar and bring to a simmer. Simmer, stirring occasionally, until vegetables have cooked down and liquid is reduced by about 1/3, about 30 minutes. Drain vegetables, discard liquid, and return vegetables to pot.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add remaining vinegar, sugar, and spices. Bring to a simmer and cook for 5 minutes. Remove pot from heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fill jars, wipe rims, apply lids and rings. Process in a boiling water canner for 10 minutes (starting time when pot returns to a boil). Remove jars from pot and let cool on a towel-lined countertop.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When jars are completely cool, remove rings and test seals. The relish is good to eat immediately. Store sealed jars in a cool dark place for up to a year.",
      "secondary_message": null
    }
  ],
