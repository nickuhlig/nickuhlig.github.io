  "instructions": [
    {
      "id": 598085,
      "primary_message": "Wash, dry, trim, and cut green beans crosswise into 1-inch pieces. Place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil over high heat. ",
      "secondary_message": "2 ¼ lb green beans\n1 ½ tsp salt"
    },
    {
      "id": 598086,
      "primary_message": "Once the water is boiling, reduce to medium-low and simmer until beans are fork-tender, 1-2 minutes. Drain and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 598087,
      "primary_message": "Meanwhile, peel, halve, and mince onion. Divide between a medium and a large bowl. Set the medium bowl aside for later use.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 598088,
      "primary_message": "Add veggie ground, eggs, bread crumbs, soy sauce, and spices to the large bowl with the onion. Using your hands, mix well to combine. Use a scant ¼-cup measure to form the veggie ground mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": "24 oz veggie ground, plant based\n3 eggs\n¾ cup panko bread crumbs\n1 tbsp soy sauce\n1 tbsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 598089,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 598090,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 598091,
      "primary_message": "Meanwhile, wash, dry, and pick mint leaves off the stems; discard stems and mince the leaves. Add to the medium bowl with the onion (reserving a small handful for serving).",
      "secondary_message": "1 small pkg fresh mint"
    },
    {
      "id": 598092,
      "primary_message": "Peel and mince garlic. Add to the bowl along with yogurt, mayo, water and spices, then stir to combine the yogurt sauce.",
      "secondary_message": "3 cloves garlic\n1 ½ cups plain Greek yogurt\n⅓ cup mayonnaise\n2 tbsp water\n1 ½ tsp dill, dried\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 598093,
      "primary_message": "To serve, divide fritters and green beans between plates or bowls. Drizzle with yogurt sauce and sprinkle with reserved mint. Enjoy!",
      "secondary_message": null
    }
  ],
