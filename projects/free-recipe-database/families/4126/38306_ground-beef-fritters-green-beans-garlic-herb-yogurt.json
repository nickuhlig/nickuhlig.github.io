  "instructions": [
    {
      "id": 598157,
      "primary_message": "Wash, dry, trim, and cut green beans crosswise into 1-inch pieces. Place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil over high heat. ",
      "secondary_message": "0.68 kg green beans\n1 tsp salt"
    },
    {
      "id": 598158,
      "primary_message": "Once the water is boiling, reduce to medium-low and simmer until beans are fork-tender, 1-2 minutes. Drain and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 598159,
      "primary_message": "Meanwhile, peel and mince shallots. Divide between a small and a medium bowl. Set the small bowl aside for later use.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 598160,
      "primary_message": "Add beef, eggs, bread crumbs, Worcestershire, and spices to the medium bowl with the shallot. Using your hands, mix well to combine. Use a ¼-cup measure to form the beef mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": "0.68 kg lean ground beef\n2 eggs\n½ cup panko bread crumbs\n2 tsp Worcestershire sauce\n2 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 598161,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 598162,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 598163,
      "primary_message": "Meanwhile, wash, dry, and pick mint leaves off the stems; discard stems and mince the leaves. Add to the small bowl with the shallot (reserving a small handful for serving).",
      "secondary_message": "1 small pkg fresh mint"
    },
    {
      "id": 598164,
      "primary_message": "Peel and mince garlic. Add to the bowl along with yogurt, mayo, water, and spices, then stir to combine the yogurt sauce.",
      "secondary_message": "2 cloves garlic\n1 cup plain Greek yogurt\n¼ cup mayonnaise\n4 tsp water\n1 tsp dill, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 598165,
      "primary_message": "To serve, divide fritters and green beans between plates or bowls. Drizzle with yogurt sauce and sprinkle with reserved mint. Enjoy!",
      "secondary_message": null
    }
  ],
