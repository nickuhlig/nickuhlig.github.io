  "instructions": [
    {
      "id": 598067,
      "primary_message": "Wash, dry, trim, and cut green beans crosswise into 1-inch pieces. Place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil over high heat. ",
      "secondary_message": "¾ lb green beans\n½ tsp salt"
    },
    {
      "id": 598068,
      "primary_message": "Once the water is boiling, reduce to medium-low and simmer until beans are fork-tender, 1-2 minutes. Drain and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 598069,
      "primary_message": "Meanwhile, peel and mince shallot. Divide between a small and a medium bowl. Set the small bowl aside for later use.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 598070,
      "primary_message": "Add veggie ground, egg, bread crumbs, soy sauce, and spices to the medium bowl with the shallot. Using your hands, mix well to combine. Use a scant ¼-cup measure to form the veggie ground mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": "8 oz veggie ground, plant based\n1 egg\n¼ cup panko bread crumbs\n1 tsp soy sauce\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 598071,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 598072,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters and pan-fry until golden and cooked through, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 598073,
      "primary_message": "Meanwhile, wash, dry, and pick mint leaves off the stems; discard stems and mince the leaves. Add to the small bowl with the shallot (reserving a small handful for serving).",
      "secondary_message": "½ small pkg fresh mint"
    },
    {
      "id": 598074,
      "primary_message": "Peel and mince garlic. Add to the bowl along with yogurt, mayo, water and spices, then stir to combine the yogurt sauce.",
      "secondary_message": "1 clove garlic\n½ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tsp water\n½ tsp dill, dried\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 598075,
      "primary_message": "To serve, divide fritters and green beans between plates or bowls. Drizzle with yogurt sauce and sprinkle with reserved mint. Enjoy!",
      "secondary_message": null
    }
  ],
