  "instructions": [
    {
      "id": 1,
      "primary_message": "Place lentils in a medium saucepan and cover with 3 cups water. Bring to a boil over high heat and reduce to a simmer. Cook until lentils are tender, about 20 minutes. Add white rice, brown rice, steel-cut oatmeal, and wheatberries. Add 1 quart of water and bring to a boil. Reduce to a bare simmer and cook, stirring occasionally, until white rice grains and oatmeal are very soft and have thickened the porridge, about 50 minutes. Season to taste with salt and pepper. Ladle porridge into bowls, garnish as desired, and serve.",
      "secondary_message": null
    }
