  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the halloumi cheese into 1/2 inch tall strips.",
      "secondary_message": "1 lb halloumi cheese"
    },
    {
      "id": 1,
      "primary_message": "Light one chimney full of charcoal. While the charcoal is lighting, dice the watermelon into one-inch cubes and toss with the mint.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly over the charcoal grate. Grill the halloumi until it browns and starts to blister on each side, about one to three minutes per side.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Immediately dice the halloumi into half-inch cubes and toss in with watermelon and mint. Season with freshly ground black pepper to taste.",
      "secondary_message": null
    }
  ],
