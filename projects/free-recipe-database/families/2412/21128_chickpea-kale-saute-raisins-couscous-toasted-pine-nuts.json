  "instructions": [
    {
      "id": 441508,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 441509,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 441510,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 2 minutes. Transfer toasted nuts to a small bowl. (Reserve skillet for later use.)",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 441511,
      "primary_message": "Peel, halve, and thinly slice onion crosswise into half-moons. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 441512,
      "primary_message": "Return skillet to medium heat.",
      "secondary_message": null
    },
    {
      "id": 441513,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 441514,
      "primary_message": "While the onion is cooking, drain and rinse chickpeas. ",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 441515,
      "primary_message": "When the onion is soft, add chickpeas to the skillet. Cook, stirring occasionally, until the chickpeas are golden and warmed through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 441516,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces.",
      "secondary_message": "2 bunches kale"
    },
    {
      "id": 441517,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 441518,
      "primary_message": "Add broth, raisins, and spices to the skillet. Continue to cook, stirring occasionally, until raisins have softened and sauce has thickened, 3-4 minutes more.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n¼ cup raisins\n½ tsp rosemary, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 441519,
      "primary_message": "Add vinegar to the skillet, stir to combine, and remove from heat. ",
      "secondary_message": "4 tsp balsamic vinegar"
    },
    {
      "id": 441520,
      "primary_message": "To serve, divide couscous and chickpea-kale sauté between plates or bowls; sprinkle with pine nuts. Enjoy!",
      "secondary_message": null
    }
  ],
