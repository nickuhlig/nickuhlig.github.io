  "instructions": [
    {
      "id": 441560,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 441561,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 441562,
      "primary_message": "Once the pot is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 2 minutes. Transfer toasted nuts to a small bowl. (Reserve pot for later use.)",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 441563,
      "primary_message": "Peel, halve, and thinly slice onions crosswise into half-moons. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 441564,
      "primary_message": "Return pot to medium heat.",
      "secondary_message": null
    },
    {
      "id": 441565,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 441566,
      "primary_message": "While the onion is cooking, drain and rinse chickpeas. ",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 441567,
      "primary_message": "When the onion is soft, add chickpeas to the pot. Cook, stirring occasionally, until the chickpeas are golden and warmed through, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 441568,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 441569,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 441570,
      "primary_message": "Add broth, raisins, and spices to the pot. Continue to cook, stirring occasionally, until raisins have softened and sauce has thickened, 4-5 minutes more.",
      "secondary_message": "355 ml chicken or vegetable broth\n⅓ cup raisins\n¾ tsp rosemary, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 441571,
      "primary_message": "Add vinegar to the pot, stir to combine, and remove from heat. ",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 441572,
      "primary_message": "To serve, divide couscous and chickpea-kale sauté between plates or bowls; sprinkle with pine nuts. Enjoy!",
      "secondary_message": null
    }
  ],
