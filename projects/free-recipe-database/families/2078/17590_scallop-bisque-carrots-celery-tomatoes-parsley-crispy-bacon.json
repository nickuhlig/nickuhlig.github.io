  "instructions": [
    {
      "id": 285257,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 285258,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 285259,
      "primary_message": "Peel, halve, and small dice onions; add to the bowl with the carrot and celery.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 285260,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the veggies (reserve remaining parsley for serving).",
      "secondary_message": null
    },
    {
      "id": 285261,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 285262,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 285263,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 285264,
      "primary_message": "Meanwhile, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg sea scallops\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 285265,
      "primary_message": "Using a slotted spoon, remove the bacon to a clean, paper towel-lined plate. (Reserve pot with drippings for the next step.)",
      "secondary_message": null
    },
    {
      "id": 285266,
      "primary_message": "Return pot with drippings to medium-high heat. Working in batches if necessary, add scallops in a single layer; cook until golden brown and opaque throughout, 1½-2 minutes per side. Once done, add to the plate with the bacon. (Reserve pot with drippings for the next step.)",
      "secondary_message": null
    },
    {
      "id": 285267,
      "primary_message": "Return pot with drippings to medium heat. Add the veggies and cook, stirring occasionally, until softened, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 285268,
      "primary_message": "Add flour to the pot with the veggies and cook, stirring frequently, for 2 minutes.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 285269,
      "primary_message": "Slowly add broth to the pot, while stirring constantly, and bring to a simmer. Once simmering, cook, stirring occasionally, until thickened, about 5 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth"
    },
    {
      "id": 285270,
      "primary_message": "Meanwhile, chop scallops into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 285271,
      "primary_message": "Add tomatoes, cream, and spices to the pot; stir to combine the soup and remove from heat. Purée with an immersion or regular blender (return soup to the pot).",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n355 ml heavy whipping cream\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cayenne pepper\n½ tsp paprika"
    },
    {
      "id": 285272,
      "primary_message": "To serve, divide soup between bowls; top with scallops, bacon, and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
