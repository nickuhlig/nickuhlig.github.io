  "instructions": [
    {
      "id": 1,
      "primary_message": "Cook bacon in a heavy-bottomed saucepan over medium heat until browned, about 5 minutes. Add onions and garlic and cook, stirring, until translucent and softened, 5 to 7 minutes. Drain excess bacon grease from pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in remaining ingredients and reduce heat to low. Simmer uncovered, stirring occasionally, until reduced and thickened to a jam-like consistency, about 1 hour. Discard bay leaf.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to a blender and pulse to combine, leaving some chunks. Use immediately, or store in the refrigerator for up to 3 days.",
      "secondary_message": null
    }
  ],
