  "instructions": [
    {
      "id": 190254,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 190255,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 crowns broccoli\n1 ½ (8 oz) pkg sugar snap peas\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 190256,
      "primary_message": "Pat the chicken breasts dry with paper towels, rub with olive oil, season generously with salt and pepper on both sides and place in the middle of a large parchment paper lined baking sheet. ",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 190257,
      "primary_message": "Peel and medium dice the onion. Cut the sugar snap peas crosswise (at an angle) into 1-inch pieces and add to a large mixing bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 190258,
      "primary_message": "Cut the bell peppers into quarters lengthwise; remove and discard the seeds and white membranes. Medium dice, add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 190259,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into bite-sized pieces and add to bowl with other vegetables.",
      "secondary_message": null
    },
    {
      "id": 190260,
      "primary_message": "Drizzle the vegetables with oil and season with salt and pepper; toss to coat, then arrange in a single layer on a second baking sheet. Place both baking sheets in the oven and bake for 20 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 190261,
      "primary_message": "Heat a medium saucepan over medium heat. Once the pan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 190262,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add to the saucepan, cook stirring until fragrant, about 30 seconds.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 190263,
      "primary_message": "Add soy sauce, honey, sesame oil, sesame seeds and water to the saucepan. Bring sauce to a boil, then reduce heat to low, stirring frequently.",
      "secondary_message": "⅓ cup tamari soy sauce\n¼ cup honey\n1 tbsp toasted sesame oil\n3 tbsp sesame seeds\n⅓ cup water"
    },
    {
      "id": 190264,
      "primary_message": "Combine cornstarch with water in a small bowl and pour into sauce. Let sauce thicken for 2-3 minutes then remove from heat and set aside.",
      "secondary_message": "1 tbsp cornstarch\n3 tbsp water"
    },
    {
      "id": 190265,
      "primary_message": "Remove chicken from oven, drizzle sauce over top and return to oven for another 5 minutes or until sauce is sticky and chicken is cooked through.",
      "secondary_message": null
    },
    {
      "id": 190266,
      "primary_message": "To serve, slice chicken into strips. Divide between plates and sprinkle sesame seeds over top. Enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
