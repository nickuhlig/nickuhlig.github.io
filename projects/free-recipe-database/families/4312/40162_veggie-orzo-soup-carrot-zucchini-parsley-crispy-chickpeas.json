  "instructions": [
    {
      "id": 622585,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 622586,
      "primary_message": "Drain and rinse chickpeas. Transfer to a large baking sheet pan and pat dry with paper towels. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 622587,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are golden and crispy, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 622588,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n4 sticks celery\n2 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 622589,
      "primary_message": "Peel, trim, and medium dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622590,
      "primary_message": "Trim and medium dice celery. Add to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 622591,
      "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622592,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622593,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onion. Peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 622594,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 622595,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 622596,
      "primary_message": "When the veggies are softened, add parsley, broth, and orzo to the pot. Stir to combine the soup and bring to a boil. Once boiling, reduce heat and simmer until the orzo is tender, 8-10 minutes. Remove from heat.",
      "secondary_message": "1420 ml chicken or vegetable broth\n170 g orzo pasta"
    },
    {
      "id": 622597,
      "primary_message": "To serve, divide soup between bowls and top with crispy chickpeas. Enjoy!",
      "secondary_message": null
    }
  ],
