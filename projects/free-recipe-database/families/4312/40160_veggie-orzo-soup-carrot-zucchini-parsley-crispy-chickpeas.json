  "instructions": [
    {
      "id": 622559,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 622560,
      "primary_message": "Drain and rinse chickpeas. Divide between two baking sheet pans and pat dry with paper towels. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 622561,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are golden and crispy, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 622562,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n3 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 622563,
      "primary_message": "Peel, trim, and medium dice carrots. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 622564,
      "primary_message": "Trim and medium dice celery. Add to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 622565,
      "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622566,
      "primary_message": "Peel, halve, and medium dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 622567,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622568,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 622569,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 622570,
      "primary_message": "When the veggies are softened, add parsley, broth, and orzo to the pot. Stir to combine the soup and bring to a boil. Once boiling, reduce heat and simmer until the orzo is tender, 8-10 minutes. Remove from heat.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n9 oz orzo pasta"
    },
    {
      "id": 622571,
      "primary_message": "To serve, divide soup between bowls and top with crispy chickpeas. Enjoy!",
      "secondary_message": null
    }
  ],
