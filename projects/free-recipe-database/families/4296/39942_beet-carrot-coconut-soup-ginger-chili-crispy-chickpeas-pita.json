  "instructions": [
    {
      "id": 619317,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n3 medium beets\n1 red chili pepper\n1 (1 inch) piece ginger root\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 619318,
      "primary_message": "Peel, trim, and medium dice carrot and beets. Place both in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 619319,
      "primary_message": "Quarter chili pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and place in a small bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 619320,
      "primary_message": "Peel and mince ginger, shallot, and garlic. Add all three to the bowl with the chili pepper.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 619321,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 619322,
      "primary_message": "While the pan heats up, zest lime into the bowl. (Reserve lime for later use.)",
      "secondary_message": null
    },
    {
      "id": 619323,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add chili pepper, ginger, shallot, garlic, and lime zest; cook, stirring constantly, until softened, about 1 minute.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 619324,
      "primary_message": "Add carrot, beet, sugar, and spices to the pan, then stir to combine. Continue to cook until fragrant, 1-2 minutes more.",
      "secondary_message": "2 tsp brown sugar\n½ tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cumin, ground\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 619325,
      "primary_message": "Add broth, water, and coconut milk to the pan; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until veggies are very tender, about 15 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup water\n½ (13.5 fl oz) can coconut milk"
    },
    {
      "id": 619326,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 619327,
      "primary_message": "While the skillet heats up, drain and rinse chickpeas. Place on paper towels and pat dry. ",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 619328,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chickpeas and spices; cook, stirring occasionally, until chickpeas are golden and crispy, 8-10 minutes. Transfer to a paper towel-lined plate and set aside. ",
      "secondary_message": "2 tsp virgin coconut oil\n½ tsp salt\n½ tsp chili powder\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 619329,
      "primary_message": "While the chickpeas are cooking, shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 619330,
      "primary_message": "When the veggies are very tender, juice reserved lime into the pan, then add cilantro. Use a potato masher to crush the veggies. (Alternatively, use a blender if you prefer a smoother soup.)",
      "secondary_message": null
    },
    {
      "id": 619331,
      "primary_message": "Cut pita into wedges.",
      "secondary_message": "1 whole grain pita"
    },
    {
      "id": 619332,
      "primary_message": "Divide soup between bowls, then top with chickpeas. Serve with pita wedges on the side and enjoy!",
      "secondary_message": null
    }
  ],
