  "instructions": [
    {
      "id": 619349,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n9 medium beets\n3 red chili peppers\n3 (1 inch) pieces ginger root\n1 ½ limes\n1 small bunch cilantro"
    },
    {
      "id": 619350,
      "primary_message": "Peel, trim, and medium dice carrots and beets. Place both in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 619351,
      "primary_message": "Quarter chili peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and place in a small bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 619352,
      "primary_message": "Peel, halve, and mince onion; peel and mince ginger and garlic. Add all three to the bowl with the chili pepper.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 619353,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 619354,
      "primary_message": "While the pot heats up, zest limes into the bowl. (Reserve limes for later use.)",
      "secondary_message": null
    },
    {
      "id": 619355,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chili pepper, ginger, onion, garlic, and lime zest; cook, stirring constantly, until softened, about 2 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 619356,
      "primary_message": "Add carrot, beet, sugar, and spices to the pot, then stir to combine. Continue to cook until fragrant, 2-3 minutes more.",
      "secondary_message": "2 tbsp brown sugar\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cumin, ground\n¼ tsp cinnamon, ground"
    },
    {
      "id": 619357,
      "primary_message": "Add broth, water, and coconut milk to the pot; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until veggies are very tender, about 15 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n3 cup water\n1 ½ (13.5 fl oz) cans coconut milk"
    },
    {
      "id": 619358,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 619359,
      "primary_message": "While the skillet heats up, drain and rinse chickpeas. Place on paper towels and pat dry. ",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 619360,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chickpeas and spices; cook, stirring occasionally, until chickpeas are golden and crispy, 10-12 minutes. Transfer to a paper towel-lined plate and set aside. ",
      "secondary_message": "2 tbsp virgin coconut oil\n1 ½ tsp salt\n1 ½ tsp chili powder\n¼ tsp cinnamon, ground"
    },
    {
      "id": 619361,
      "primary_message": "While the chickpeas are cooking, shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 619362,
      "primary_message": "When the veggies are very tender, juice reserved limes into the pot, then add cilantro. Use a potato masher to crush the veggies. (Alternatively, use a blender if you prefer a smoother soup.)",
      "secondary_message": null
    },
    {
      "id": 619363,
      "primary_message": "Cut pita into wedges.",
      "secondary_message": "3 whole grain pitas"
    },
    {
      "id": 619364,
      "primary_message": "Divide soup between bowls, then top with chickpeas. Serve with pita wedges on the side and enjoy!",
      "secondary_message": null
    }
  ],
