  "instructions": [
    {
      "id": 196351,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 red bell pepper\n½ small pkg fresh basil"
    },
    {
      "id": 196352,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Use paper towels or a clean dishcloth to squeeze excess moisture out of the zucchini noodles.",
      "secondary_message": null
    },
    {
      "id": 196353,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196354,
      "primary_message": "Seed and slice bell pepper into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 196355,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peppers and cook, stirring occasionally, until tender, 5-6 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 196356,
      "primary_message": "Meanwhile, pat the chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with spices on both sides.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n½ tsp oregano\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 196357,
      "primary_message": "Once the peppers are done, transfer to a blender and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 196358,
      "primary_message": "Return the skillet to medium-high heat. Add more oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 196359,
      "primary_message": "Add chicken to the skillet and cook until golden brown and cooked through, 3-4 minutes per side. Transfer chicken to a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 196360,
      "primary_message": "Meanwhile, pick basil leaves off the stems; discard stems. Transfer half the basil to the blender with the peppers. Using a clean cutting board, roll up remaining basil leaves and thinly slice into ribbons; set aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 196361,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 196362,
      "primary_message": "Add pinenuts, sun-dried tomatoes, oil, salt, and crushed red pepper to the blender. Blend on high, adding water 1 tbsp at a time, if necessary, to form a semi-smooth pesto.",
      "secondary_message": "⅛ cup pine nuts\n3 sun-dried tomatoes, oil-packed\n1 tbsp extra virgin olive oil\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 196363,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 196364,
      "primary_message": "Return the skillet to medium-high heat. Add pesto and zucchini noodles, toss to coat, and cook, stirring frequently, until noodles are tender and heated through, 2-3 minutes. Sprinkle with parmesan and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 196365,
      "primary_message": "Meanwhile, slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 196366,
      "primary_message": "To serve, divide noodles between plates and top with chicken. Garnish with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
