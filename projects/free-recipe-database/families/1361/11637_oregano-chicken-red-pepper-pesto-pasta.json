  "instructions": [
    {
      "id": 196469,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n425 g penne pasta"
    },
    {
      "id": 196470,
      "primary_message": "Meanwhile, wash, dry, seed, and slice bell peppers into thin strips.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 196471,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 196472,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peppers and cook, stirring occasionally, until tender, 6-7 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 196473,
      "primary_message": "Meanwhile, pat the chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with spices on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp oregano\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 196474,
      "primary_message": "Once the peppers are done, transfer to a blender and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 196475,
      "primary_message": "Return the skillet to medium-high heat. Add more oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 196476,
      "primary_message": "Working in batches if necessary, add chicken to the skillet and cook until browned and cooked through, 3-4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 196477,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; discard stems. Transfer half the basil to the blender with the peppers. Using a clean cutting board, roll up remaining basil leaves and thinly slice into ribbons; set aside for garnish.",
      "secondary_message": "1 ½ small pkgs fresh basil"
    },
    {
      "id": 196478,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 196479,
      "primary_message": "Add pinenuts, sun-dried tomatoes, oil, salt, and crushed red pepper to the blender. Blend on high, adding water 1 tbsp at a time, if necessary, to form a semi-smooth pesto.",
      "secondary_message": "⅓ cup pine nuts\n9 sun-dried tomatoes, oil-packed\n3 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 196480,
      "primary_message": "Drain pasta and return to the pot. Add pesto, stir to combine, and place over medium-high heat. Cook, stirring frequently, until heated through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 196481,
      "primary_message": "Meanwhile, slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 196482,
      "primary_message": "To serve, divide pasta between plates or bowls and top with chicken. Garnish with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
