  "instructions": [
    {
      "id": 279783,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 279784,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 medium carrots\n6 medium parsnips\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 279785,
      "primary_message": "Peel, trim, and cut carrots and parsnips lengthwise into quarters, then crosswise into 2-inch long pieces; divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 279786,
      "primary_message": "Drizzle the veggies with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 279787,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 279788,
      "primary_message": "Meanwhile, drain and rinse beans in a colander. Place in a medium bowl and mash with a potato masher or fork until semi-smooth.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 279789,
      "primary_message": "Add mayo, Dijon, and spices to the bowl with the beans; stir to combine.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp Dijon mustard\n1 tbsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 279790,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, along with the cranberries, and stir to combine the bean filling.",
      "secondary_message": "¾ cup dried cranberries"
    },
    {
      "id": 279791,
      "primary_message": "Place tortillas on a flat surface, spread evenly with the bean filling, and top with mixed greens; roll tightly to close, then cut in half.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 279792,
      "primary_message": "To serve, divide roll ups and roasted veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
