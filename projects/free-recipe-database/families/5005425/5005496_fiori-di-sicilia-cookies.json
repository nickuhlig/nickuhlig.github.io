  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "4 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to 180°C (350°F). Line 2 baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together flour, baking powder, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In the bowl of a stand mixer fitted with a paddle attachment, beat together butter and sugar until light and fluffy, about 4 minutes. Beat in egg and egg yolk. Beat in ricotta and Fiori di Sicilia until combined. Add dry ingredients and beat until just combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Drop dough by rounded tablespoon onto prepared baking sheets and bake until lightly browned on the bottom, about 18 minutes. Let cool for 5 minutes then transfer to a wire rack to finish cooling.",
      "secondary_message": null
    }
  ],
