  "instructions": [
    {
      "id": 149375,
      "primary_message": "In a small bowl, mix together the spices.",
      "secondary_message": "1 tbsp chili powder\n1 ½ tsp paprika\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp salt"
    },
    {
      "id": 149376,
      "primary_message": "Pat the fish dry with paper towels and place on a plate; drizzle with olive oil and rub both sides with the spice mixture. Set aside.",
      "secondary_message": "1.02 kg halibut fillet\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 149377,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 green bell peppers\n3 limes\n3 jalapeño peppers\n1 ½ small bunches cilantro"
    },
    {
      "id": 149378,
      "primary_message": "Peel and mince garlic. Peel and slice onions into half rings. Slice bell peppers into strips.",
      "secondary_message": "6 cloves garlic\n3 medium red onions"
    },
    {
      "id": 149379,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 149380,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 149381,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 149382,
      "primary_message": "Add garlic, onion, bell peppers, and beans to the pot. Cook, stirring occasionally, until vegetables are tender, 8-10 minutes. Cover and remove from heat; set aside.",
      "secondary_message": null
    },
    {
      "id": 149383,
      "primary_message": "Meanwhile, juice limes into a blender. ",
      "secondary_message": null
    },
    {
      "id": 149384,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs of each jalapeño with a spoon. Roughly chop and add to blender. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 149385,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 149386,
      "primary_message": "Add yogurt, salt, and garlic powder to blender. Purée until smooth, about 30 seconds.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 ½ tsp salt\n¾ tsp garlic powder"
    },
    {
      "id": 149387,
      "primary_message": "Preheat a large skillet to medium-high heat. Add more oil and swirl to coat the bottom. Place the fish on the skillet; cook until it is opaque in the center, 3-4 minutes per side. Work in batches if necessary.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 149388,
      "primary_message": "To serve, divide the vegetables and fish between plates. Drizzle with the cilantro-lime crema. Enjoy!",
      "secondary_message": null
    }
  ],
