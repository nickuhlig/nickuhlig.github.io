  "instructions": [
    {
      "id": 149345,
      "primary_message": "In a small bowl, mix together the spices.",
      "secondary_message": "1 tsp chili powder\n½ tsp paprika\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt"
    },
    {
      "id": 149346,
      "primary_message": "Pat the fish dry with paper towels and place on a plate; drizzle with olive oil and rub both sides with the spice mixture. Set aside.",
      "secondary_message": "⅓ kg halibut fillet\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 149347,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n1 lime\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 149348,
      "primary_message": "Peel and mince garlic. Peel and slice onion into half rings. Slice bell peppers into strips.",
      "secondary_message": "2 cloves garlic\n1 medium red onion"
    },
    {
      "id": 149349,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 149350,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 149351,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 149352,
      "primary_message": "Add garlic, onion, bell peppers, and beans to the skillet. Cook, stirring occasionally, until vegetables are tender, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 149353,
      "primary_message": "Meanwhile, juice lime into a blender. ",
      "secondary_message": null
    },
    {
      "id": 149354,
      "primary_message": "Quarter the jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Roughly chop and add to blender. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 149355,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 149356,
      "primary_message": "Add yogurt, salt, and garlic powder to blender. Purée until smooth, about 30 seconds.",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp salt\n¼ tsp garlic powder"
    },
    {
      "id": 149357,
      "primary_message": "Remove vegetables from the skillet and set aside on a plate, cover with foil to keep warm.",
      "secondary_message": null
    },
    {
      "id": 149358,
      "primary_message": "Return skillet to medium-high heat. Add more oil and swirl to coat the bottom. Place the fish on the skillet; cook until it is opaque in the center, 3-4 minutes per side.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 149359,
      "primary_message": "To serve, divide the vegetables and fish between plates. Drizzle with the cilantro-lime crema. Enjoy!",
      "secondary_message": null
    }
  ],
