  "instructions": [
    {
      "id": 355248,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 355249,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355250,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n454 g veggie ground, plant based"
    },
    {
      "id": 355251,
      "primary_message": "While the veggie ground is cooking, wash, dry, peel, and mince ginger; place in a small bowl.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 355252,
      "primary_message": "Add broth, soy sauce, vinegar, tomato paste, chili-garlic sauce, maple syrup, and salt to the bowl with the ginger. Whisk to combine the sauce. ",
      "secondary_message": "237 ml chicken or vegetable broth\n2 tbsp soy sauce\n2 tbsp rice vinegar\n2 tbsp tomato paste\n2 tbsp chili-garlic sauce\n2 tsp pure maple syrup\n1 tsp salt"
    },
    {
      "id": 355253,
      "primary_message": "When the veggie ground is done, add sauce to the skillet, stir to combine, and bring to a simmer.",
      "secondary_message": null
    },
    {
      "id": 355254,
      "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 355255,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 355256,
      "primary_message": "When the pasta is done, drain and add to the skillet; cook, tossing frequently, until the noodles are coated in sauce, 1 minute more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 355257,
      "primary_message": "To serve, divide stir-fry between bowls and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
