  "instructions": [
    {
      "id": 355228,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n425 g spaghetti pasta"
    },
    {
      "id": 355229,
      "primary_message": "Meanwhile, preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355230,
      "primary_message": "Once the pot is hot, add ground beef. Cook, breaking apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1.02 kg lean ground beef"
    },
    {
      "id": 355231,
      "primary_message": "While the beef cooks, wash, peel, and mince the ginger; place in a medium bowl. ",
      "secondary_message": "3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 355232,
      "primary_message": "Add broth, soy sauce, vinegar, tomato paste, chili-garlic sauce, maple syrup, and salt to the bowl with the ginger. Whisk to combine the sauce. ",
      "secondary_message": "355 ml chicken or vegetable broth\n3 tbsp soy sauce\n3 tbsp rice vinegar\n3 tbsp tomato paste\n3 tbsp chili-garlic sauce\n1 tbsp pure maple syrup\n1 ½ tsp salt"
    },
    {
      "id": 355233,
      "primary_message": "Add sauce to the pot with the beef, stir to combine, and bring to a simmer.",
      "secondary_message": null
    },
    {
      "id": 355234,
      "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 355235,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 355236,
      "primary_message": "Drain pasta and add to the pot with the beef; cook, tossing frequently, until the noodles are coated in sauce, 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 355237,
      "primary_message": "To serve, divide stir-fry between bowls and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
