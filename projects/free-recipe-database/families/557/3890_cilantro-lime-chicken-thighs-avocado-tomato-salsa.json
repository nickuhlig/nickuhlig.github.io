  "instructions": [
    {
      "id": 43193,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ pint grape tomatoes\n1 avocado\n1 lime\n½ small bunch cilantro"
    },
    {
      "id": 43199,
      "primary_message": "Pat the chicken dry with paper towels and place in a medium bowl.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 43198,
      "primary_message": "Juice the lime; add half of the juice to the bowl with the chicken and the other half to a separate medium salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 43196,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add half to each bowl.",
      "secondary_message": null
    },
    {
      "id": 43197,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add to the bowl with the chicken.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 43200,
      "primary_message": "To the bowl with the chicken, add olive oil, salt, and pepper. Turn the chicken until well coated with the marinade. Set aside for 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 43203,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 43194,
      "primary_message": "While the chicken marinates, halve the grape tomatoes crosswise. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43205,
      "primary_message": "Once the grill pan / skillet is hot, add the chicken and cook until it is golden brown and cooked through, 3 to 5 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 43195,
      "primary_message": "Halve the avocado lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43201,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces). Add to the salad bowl.",
      "secondary_message": "½ medium red onion "
    },
    {
      "id": 43202,
      "primary_message": "Add olive oil, salt, and pepper to the salad bowl; toss to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 43204,
      "primary_message": "To serve, divide the chicken between plates and top with the salsa. Enjoy!",
      "secondary_message": null
    }
  ],
