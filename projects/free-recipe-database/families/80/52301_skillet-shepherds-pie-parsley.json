  "instructions": [
    {
      "primary_message": "Wash, peel, and large dice potatoes. Place in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to saucepan.",
      "secondary_message": "6 medium yellow potatoes"
    },
    {
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and small dice onion. Wash, peel, and small dice carrots.",
      "secondary_message": "6 medium carrots"
    },
    {
      "primary_message": "Coat bottom of skillet with oil. Add onion, carrots, and ground beef. Break apart the beef with a spoon until crumbly. Stirring occasionally, cook until beef is browned and vegetables are tender, 5-7 minutes.",
      "secondary_message": "virgin coconut oil\n1.02 kg lean ground beef"
    },
    {
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "Transfer beef and vegetables to a colander and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Return skillet to stove. Add oil and flour; whisk until smooth. Add broth and Worcestershire. Bring to a simmer.",
      "secondary_message": "virgin coconut oil\n3 tbsp all-purpose flour\nchicken or vegetable broth\n3 tsp Worcestershire sauce"
    },
    {
      "primary_message": "Return beef and vegetables to skillet. Add peas, salt, and pepper. Mix well and cook until sauce thickens, 4-5 minutes.",
      "secondary_message": "1 ½ cups frozen peas\nsalt\nblack pepper"
    },
    {
      "primary_message": "Add oil, broth, salt, and pepper to potatoes. Mash until smooth.",
      "secondary_message": "virgin coconut oil\nchicken or vegetable broth\nsalt\nblack pepper"
    },
    {
      "primary_message": "To serve, place beef and veggie mixture in a bowl or on a plate, top with mashed potatoes, and garnish with parsley. Enjoy!",
      "secondary_message": null
    }
  ],
