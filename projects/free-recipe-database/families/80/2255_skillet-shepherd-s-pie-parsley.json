  "instructions": [
    {
      "id": 21522,
      "primary_message": "Wash, peel, and large dice potatoes. Place in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to saucepan.",
      "secondary_message": "0.68 kg sweet potatoes"
    },
    {
      "id": 21523,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 21524,
      "primary_message": "Peel and small dice onion. Wash, peel, and small dice carrots.",
      "secondary_message": "1 medium yellow onion\r\n4 medium carrots"
    },
    {
      "id": 21525,
      "primary_message": "Coat bottom of skillet with butter. Add onion, carrots, and ground beef. Break apart the beef with a spoon until crumbly. Stirring occasionally, cook until beef is browned and vegetables are tender, 5-7 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n0.68 kg lean ground beef"
    },
    {
      "id": 21526,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 21527,
      "primary_message": "Transfer beef and vegetables to a colander and set aside.",
      "secondary_message": ""
    },
    {
      "id": 21528,
      "primary_message": "Return skillet to stove. Add butter and arrowroot; whisk until smooth. Add broth and coconut aminos. Bring to a simmer.",
      "secondary_message": "2 tbsp butter, unsalted\n1 tbsp arrowroot starch/powder\n236 ml (1 cup) chicken or vegetable broth\n2 tsp coconut aminos"
    },
    {
      "id": 21529,
      "primary_message": "Return beef and vegetables to skillet. Add peas, salt, and pepper. Mix well and cook until sauce thickens, 4-5 minutes.",
      "secondary_message": "1 cup frozen peas\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 21530,
      "primary_message": "Add butter, broth, salt, and pepper to potatoes. Mash until smooth.",
      "secondary_message": "1 tbsp butter, unsalted\n236 ml (1 cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 21531,
      "primary_message": "To serve, place beef and veggie mixture in a bowl or on a plate, top with mashed potatoes, and garnish with parsley. Enjoy!",
      "secondary_message": ""
    }
  ],
