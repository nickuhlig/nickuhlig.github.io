  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, and trim carrots; slice crosswise into ¼-inch thick rounds. Peel, halve, and small dice onion. Place both in a medium bowl and set aside.\n\n",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Preheat a Dutch oven over medium-high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the Dutch oven heats up, pat steak dry with paper towels, and cut crosswise into thin strips. Season with salt and pepper.\n\n",
      "secondary_message": "680 g striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Once the Dutch oven is hot, add oil and swirl to coat the bottom. Add beef and cook, stirring occasionally, until browned on all sides (it won't be cooked all the way through), 4-5 minutes.\n\n",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Add carrot, onion, and garlic to the Dutch oven; continue to cook, stirring occasionally, until onion is starting to soften, 2-3 minutes. \n\n",
      "secondary_message": "1 tbsp minced garlic"
    },
    {
      "primary_message": "Add broth, tomatoes, and cocoa powder to the Dutch oven, then stir to combine. \n\n",
      "secondary_message": "4 cups beef broth\n1 (411 g) can diced tomatoes\n1 tsp cocoa powder"
    },
    {
      "primary_message": "Cover Dutch oven, then place in the oven and bake until the carrots are starting to soften, about 40 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Carefully remove dutch oven from the oven. Uncover, add noodles, shredded cabbage, and paprika, then stir to combine. Using the back of a spoon, gently press down on the goulash so that everything is covered in broth. Cover with a lid and return to the oven. Continue to bake until the noodles and cabbage are tender, about 20 minutes. Remove from oven. \n\n",
      "secondary_message": "227 g egg noodles, wide\n1 (397 g) bag shredded cabbage (coleslaw mix)\n2 tsp paprika"
    },
    {
      "primary_message": "To serve, divide goulash between bowls, top with sour cream, and enjoy! \n\n",
      "secondary_message": "½ cup sour cream"
    }
  ],
