  "instructions": [
    {
      "id": 341969,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small bunch green onions (scallions)\n3 (1 inch) pieces ginger root\n1 ½ limes\n1 small bunch cilantro\n1 ½ English cucumbers"
    },
    {
      "id": 341970,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 341971,
      "primary_message": "Trim and cut green onions crosswise into thin pieces; add to the bowl with the cauliflower and set aside.",
      "secondary_message": null
    },
    {
      "id": 341972,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 341973,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and cut into portions; season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 341974,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Remove to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 341975,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince ginger and garlic; place both in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 341976,
      "primary_message": "Juice limes into the bowl with the ginger and garlic; add oil, vinegar, and salt. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp rice vinegar\n½ tsp salt"
    },
    {
      "id": 341977,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 341978,
      "primary_message": "Trim and small dice cucumbers; add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 341979,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 341980,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add cauliflower, green onion, and salt. Cook, stirring occasionally, until cauliflower is soft, 6-8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt"
    },
    {
      "id": 341981,
      "primary_message": "To serve, divide cauliflower rice, steak, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
