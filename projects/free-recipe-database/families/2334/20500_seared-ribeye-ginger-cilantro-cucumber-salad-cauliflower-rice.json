  "instructions": [
    {
      "id": 341945,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ small bunch green onions (scallions)\n1 (1 inch) piece ginger root\n½ lime\n½ small bunch cilantro\n½ English cucumber"
    },
    {
      "id": 341946,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 341947,
      "primary_message": "Trim and cut green onions crosswise into thin pieces; add to the bowl with the cauliflower and set aside.",
      "secondary_message": null
    },
    {
      "id": 341948,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 341949,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and cut into portions; season both sides with salt and pepper.",
      "secondary_message": "¾ lb ribeye steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 341950,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add steak and cook until desired doneness, 2-5 minutes per side. Remove to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 341951,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince ginger and garlic; place both in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 341952,
      "primary_message": "Juice lime into the bowl with the ginger and garlic; add oil, vinegar, and salt. Whisk to combine the dressing.",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp rice vinegar\n⅛ tsp salt"
    },
    {
      "id": 341953,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 341954,
      "primary_message": "Trim and small dice cucumber; add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 341955,
      "primary_message": "When the steak is done, return the skillet to medium-high heat; add more oil and swirl to coat the bottom. Add cauliflower, green onion, and salt; cook, stirring occasionally, until cauliflower is soft, about 5 minutes. Remove from heat.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt"
    },
    {
      "id": 341956,
      "primary_message": "To serve, divide cauliflower rice, steak, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
