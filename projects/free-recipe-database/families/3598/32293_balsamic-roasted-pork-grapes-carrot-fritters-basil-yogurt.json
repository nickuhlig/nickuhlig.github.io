  "instructions": [
    {
      "id": 511001,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 511002,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb red grapes\n3 medium carrots\n½ lemon\n½ small pkg fresh basil"
    },
    {
      "id": 511003,
      "primary_message": "Halve grapes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 511004,
      "primary_message": "Pat pork chops dry with paper towels. Large dice and add to the bowl with the grapes along with oil, vinegar, and spices. Stir to combine, transfer to a baking dish, and spread out in an even layer.",
      "secondary_message": "2 pork chops, boneless\n2 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n½ tsp sage, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 511005,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, stirring halfway, until pork is cooked through and grapes are soft, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 511006,
      "primary_message": "Meanwhile, place egg, milk, and oil in a clean medium bowl. Whisk to combine.",
      "secondary_message": "1 egg\n2 fl oz (¼ cup) whole milk\n1 tsp extra virgin olive oil"
    },
    {
      "id": 511007,
      "primary_message": "Add flour, salt, and baking powder to the bowl with the egg mixture. Whisk once more until the batter is just combined.",
      "secondary_message": "⅓ cup all-purpose flour\n½ tsp salt\n½ tsp baking powder"
    },
    {
      "id": 511008,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the batter and gently stir until incorporated.",
      "secondary_message": null
    },
    {
      "id": 511009,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 511010,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 511011,
      "primary_message": "Meanwhile, juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 511012,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the lemon juice along with yogurt and spices. Stir to combine the yogurt sauce and set aside. (Reserve remaining basil for serving.)",
      "secondary_message": "½ cup plain Greek yogurt\n¼ tsp garlic powder\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 511013,
      "primary_message": "Divide pork, grapes, and carrot fritters between plates. Sprinkle pork with reserved basil and serve with yogurt sauce on the side. Enjoy!",
      "secondary_message": null
    }
  ],
