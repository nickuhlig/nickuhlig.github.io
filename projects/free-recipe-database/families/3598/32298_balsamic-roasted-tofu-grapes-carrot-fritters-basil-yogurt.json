  "instructions": [
    {
      "id": 511068,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 511069,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 511070,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb red grapes\n9 medium carrots\n1 ½ lemons\n1 small pkg fresh basil"
    },
    {
      "id": 511071,
      "primary_message": "Halve grapes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 511072,
      "primary_message": "Large dice tofu and add to the bowl with the grapes along with oil, vinegar, and spices. Stir to combine, divide between two large baking dishes, and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 ½ tsp sage, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 511073,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and roast, stirring halfway, until tofu is golden and grapes are soft, 20-25 minutes. Remove from oven. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 511074,
      "primary_message": "Meanwhile, place eggs, milk, and oil in the reserved bowl. Whisk to combine.",
      "secondary_message": "3 eggs\n6 fl oz (¾ cup) whole milk\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 511075,
      "primary_message": "Add flour, salt, and baking powder to the bowl with the egg mixture. Whisk once more until the batter is just combined.",
      "secondary_message": "1 cup all-purpose flour\n1 ½ tsp salt\n1 ½ tsp baking powder"
    },
    {
      "id": 511076,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the batter and gently stir until incorporated.",
      "secondary_message": null
    },
    {
      "id": 511077,
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 511078,
      "primary_message": "Working in batches, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 511079,
      "primary_message": "Meanwhile, juice lemons into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 511080,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the lemon juice along with yogurt and spices. Stir to combine the yogurt sauce and set aside. (Reserve remaining basil for serving.)",
      "secondary_message": "1 ½ cups plain Greek yogurt\n¾ tsp garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 511081,
      "primary_message": "Divide tofu, grapes, and carrot fritters between plates. Sprinkle tofu with reserved basil and serve with yogurt sauce on the side. Enjoy!",
      "secondary_message": null
    }
  ],
