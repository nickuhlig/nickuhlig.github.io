  "instructions": [
    {
      "id": 511216,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 511217,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 511218,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg red grapes\n6 medium carrots\n1 lemon\n1 small pkg fresh basil"
    },
    {
      "id": 511219,
      "primary_message": "Halve grapes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 511220,
      "primary_message": "Large dice tofu and add to the bowl with the grapes along with oil, vinegar, and spices. Stir to combine, transfer to a large baking dish, and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp balsamic vinegar\n1 tsp sage, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 511221,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, stirring halfway, until tofu is golden and grapes are soft, about 20 minutes. Remove from oven. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 511222,
      "primary_message": "Meanwhile, place eggs, milk, and oil in the reserved bowl. Whisk to combine.",
      "secondary_message": "2 eggs\n118 ml (½ cup) whole milk\n2 tsp extra virgin olive oil"
    },
    {
      "id": 511223,
      "primary_message": "Add flour, salt, and baking powder to the bowl with the egg mixture. Whisk once more until the batter is just combined.",
      "secondary_message": "⅔ cup all-purpose flour\n1 tsp salt\n1 tsp baking powder"
    },
    {
      "id": 511224,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the batter and gently stir until incorporated.",
      "secondary_message": null
    },
    {
      "id": 511225,
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 511226,
      "primary_message": "Working in batches, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 511227,
      "primary_message": "Meanwhile, juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 511228,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the lemon juice along with yogurt and spices. Stir to combine the yogurt sauce and set aside. (Reserve remaining basil for serving.)",
      "secondary_message": "1 cup plain Greek yogurt\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 511229,
      "primary_message": "Divide tofu, grapes, and carrot fritters between plates. Sprinkle tofu with reserved basil and serve with yogurt sauce on the side. Enjoy!",
      "secondary_message": null
    }
  ],
