  "instructions": [
    {
      "id": 624918,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool; set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g penne pasta"
    },
    {
      "id": 624919,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n6 tomatoes\n3 orange bell peppers\n3 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 624920,
      "primary_message": "Juice limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 624921,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lime juice, along with oil and spices, then stir to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 624922,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 624923,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 624924,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 624925,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 624926,
      "primary_message": "Drain and rinse beans. Add to the bowl.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 624927,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl.",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 624928,
      "primary_message": "Coarsely grate cheese. Add to the bowl, along with cooled pasta, and stir to combine.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 624929,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
