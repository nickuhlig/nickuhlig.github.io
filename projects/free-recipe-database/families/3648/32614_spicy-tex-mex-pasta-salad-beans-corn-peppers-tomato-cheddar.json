  "instructions": [
    {
      "id": 624894,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool; set aside.",
      "secondary_message": "½ tsp salt\n142 g penne pasta"
    },
    {
      "id": 624895,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lime\n2 tomatoes\n1 orange bell pepper\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 624896,
      "primary_message": "Juice lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 624897,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lime juice, along with oil and spices, then stir to combine the dressing.",
      "secondary_message": "½ shallot\n2 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 624898,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 624899,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 624900,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 624901,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 624902,
      "primary_message": "Drain and rinse beans. Add to the bowl.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 624903,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl.",
      "secondary_message": "⅔ cup frozen corn"
    },
    {
      "id": 624904,
      "primary_message": "Coarsely grate cheese. Add to the bowl, along with cooled pasta, and stir to combine.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 624905,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
