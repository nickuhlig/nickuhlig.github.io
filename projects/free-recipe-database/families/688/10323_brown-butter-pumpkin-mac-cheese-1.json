  "instructions": [
    {
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add pasta and salt, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "salt"
    },
    {
      "primary_message": "While pasta is cooking, melt butter in another large pot over medium-high heat. Stir, cooking until butter has browned, 3-4 minutes. Watch it carefully so that it does not burn.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "primary_message": "Remove pot from heat, stir in flour, whisking constantly, 1 minute.",
      "secondary_message": null
    },
    {
      "primary_message": "Return pot to heat, gradually stir in milk. Bring to a simmer and cook for 1 minute, stirring constantly, until thickened.",
      "secondary_message": "444 ml whole milk"
    },
    {
      "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
      "secondary_message": "1 small pkg fresh thyme"
    },
    {
      "primary_message": "Stir in pumpkin, salt, pepper, and most of the thyme (reserve some for garnish). ",
      "secondary_message": "1 (425 g) can pure pumpkin purée\nsalt\n½ tsp black pepper"
    },
    {
      "primary_message": "Grate cheese and add to pot. Cook, stirring occasionally, until cheese is melted.",
      "secondary_message": "1 ½ (227 g) blocks cheddar cheese"
    },
    {
      "primary_message": "When macaroni is done cooking, drain in a colander. Add to the cheese sauce and stir to combine. ",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide the macaroni and cheese between plates or bowls and sprinkle with fresh thyme. Enjoy!",
      "secondary_message": null
    }
  ],
