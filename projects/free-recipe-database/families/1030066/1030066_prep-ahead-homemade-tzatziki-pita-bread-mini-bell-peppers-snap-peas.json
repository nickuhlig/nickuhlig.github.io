  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 small and 4 mini food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch fresh dill\n½ English cucumber\n4 oz mini sweet bell peppers\n4 oz sugar snap peas"
    },
    {
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and coarsely grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. Add to the bowl along with yogurt, oil, and spices, then stir to combine the tzatziki. Divide tzatziki between mini containers, then cover and refrigerate.",
      "secondary_message": "2 clove garlic\n1 ½ cups plain Greek yogurt\n2 tsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper\n¼ tsp onion powder"
    },
    {
      "primary_message": "Cut pita bread into wedges. Trim, seed, and halve peppers lengthwise. Divide pita, peppers, and snap peas between small containers. Cover containers and refrigerate.",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, heat pita bread (if desired) in the toaster, air-fryer, or microwave. Dip pita and veggies in tzatziki and enjoy!",
      "secondary_message": null
    }
  ],
