  "instructions": [
    {
      "id": 319420,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 319421,
      "primary_message": "While the skillet heats up, peel and mince shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 319422,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the shallot and cook, stirring often, until softened, about 2 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 319423,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 319424,
      "primary_message": "Add garlic, seeds, salt, and pepper to the skillet with the shallot. Continue to cook, stirring often, until the shallot and garlic become golden, 2-3 minutes more. Transfer \"everything spice\" to a small bowl to keep the garlic from overcooking. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp sesame seeds\n2 tsp poppy seeds\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 319425,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ English cucumber\n1 pint grape tomatoes\n½ lemon\n½ small bunch fresh dill\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 319426,
      "primary_message": "Trim and slice cucumber into thin rounds; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 319427,
      "primary_message": "Halve tomatoes and add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 319428,
      "primary_message": "Zest lemon into another small bowl. Slice lemon into wedges, add to the plate with the veggies, and set aside.",
      "secondary_message": null
    },
    {
      "id": 319429,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon zest along with goat cheese and crushed red pepper; mash with the back of a spoon to combine and set aside.",
      "secondary_message": "1 (4 oz) log goat cheese\n¼ tsp crushed red pepper"
    },
    {
      "id": 319430,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 319431,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs"
    },
    {
      "id": 319432,
      "primary_message": "Meanwhile, chop or tear salmon into bite-sized pieces.",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 319433,
      "primary_message": "Divide spinach between bowls. Top with cucumber, tomatoes, lemon wedges, eggs, smoked salmon, and goat cheese; sprinkle with \"everything spice\" and enjoy!",
      "secondary_message": null
    }
  ],
