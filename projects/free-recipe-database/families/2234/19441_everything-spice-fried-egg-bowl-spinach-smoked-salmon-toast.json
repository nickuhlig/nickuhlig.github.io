  "instructions": [
    {
      "id": 319405,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 319406,
      "primary_message": "While the skillet heats up, peel, halve, and mince onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 319407,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until softened, 2-3 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 319408,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 319409,
      "primary_message": "Add garlic, seeds, salt, and pepper to the skillet with the onion. Continue to cook, stirring often, until the onion and garlic become golden, 2-3 minutes more. Transfer \"everything spice\" to a small bowl to keep the garlic from overcooking. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp sesame seeds\n1 tbsp poppy seeds\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 319410,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ English cucumbers\n3 pints grape tomatoes\n1 ½ lemons\n1 small bunch fresh dill\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 319411,
      "primary_message": "Trim and slice cucumbers into thin rounds; place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 319412,
      "primary_message": "Halve tomatoes and add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 319413,
      "primary_message": "Zest lemons into a medium bowl. Slice lemons into wedges, add to the plate with the veggies, and set aside.",
      "secondary_message": null
    },
    {
      "id": 319414,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon zest along with goat cheese and crushed red pepper; mash with the back of a spoon to combine and set aside.",
      "secondary_message": "3 (4 oz) logs goat cheese\n¾ tsp crushed red pepper"
    },
    {
      "id": 319415,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 319416,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n12 eggs"
    },
    {
      "id": 319417,
      "primary_message": "Meanwhile, halve rolls and toast if desired; spread with lemon-dill goat cheese.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 319418,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 319419,
      "primary_message": "Divide spinach between bowls. Top with cucumber, tomatoes, lemon wedges, eggs, and smoked salmon; sprinkle with \"everything spice.\" Serve with goat cheese rolls on the side and enjoy!",
      "secondary_message": null
    }
  ],
