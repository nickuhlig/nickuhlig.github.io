  "instructions": [
    {
      "id": 391202,
      "primary_message": "Drain and rinse beans; place in a large pot. ",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 391203,
      "primary_message": "Add marinara sauce, barbecue sauce, and spices to the pot with the beans. Stir to combine and bring to a simmer.",
      "secondary_message": "1 ½ (680 g) jars marinara sauce\n⅓ cup barbecue sauce\n1 ½ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 391204,
      "primary_message": "Once simmering, reduce heat to low and cook, stirring occasionally, until beans are tender and sauce has thickened, 8-10 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 391205,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 391206,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 391207,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 391208,
      "primary_message": "While the chops are cooking, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a medium bowl. ",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 391209,
      "primary_message": "Add shredded cabbage and dressing to the bowl with the green onion. Stir to combine the slaw. ",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n⅓ cup ranch dressing"
    },
    {
      "id": 391210,
      "primary_message": "To serve, divide pork chops, beans, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
