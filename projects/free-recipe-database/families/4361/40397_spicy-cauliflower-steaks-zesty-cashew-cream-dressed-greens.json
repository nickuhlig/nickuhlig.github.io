  "instructions": [
    {
      "id": 625528,
      "primary_message": "Preheat oven to 260°C (500°F). Line two large baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 625529,
      "primary_message": "Boil water in a kettle. (If you do not have a kettle, boil water in a small saucepan, starting with hot water from the tap.) In a small heat-safe bowl, pour boiling water over cashews and set aside to soak.",
      "secondary_message": "1 ½ cups cashews, roasted unsalted"
    },
    {
      "id": 625530,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n3 medium heads cauliflower\n3 limes\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 625531,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a small bowl along with soy sauce, oil, chili-garlic sauce, and spices, then stir to combine the sauce.",
      "secondary_message": "⅓ cup soy sauce\n⅓ cup extra virgin olive oil\n3 tbsp chili-garlic sauce\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 625532,
      "primary_message": "Slice each cauliflower lengthwise into 1-inch thick \"steaks.\" Transfer steaks (and any loose florets) to the baking sheets, then drizzle with sauce. Using your hands, rub the sauce over both sides of the cauliflower and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 625533,
      "primary_message": "Place cauliflower in oven (it doesn't have to be fully heated) and roast, flipping halfway through, until fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 625534,
      "primary_message": "Meanwhile, place oil, vinegar, maple syrup, salt, and pepper in a large bowl, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 625535,
      "primary_message": "Drain cashews and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 625536,
      "primary_message": "Zest and juice limes into the blender. Add water, nutritional yeast, flour, oil, and spices to the blender; purée on high until the cashew cream is smooth, 1-2 minutes.",
      "secondary_message": "1 ½ cup water\n⅓ cup nutritional yeast flakes\n2 tbsp all-purpose flour\n1 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder\n¾ tsp paprika"
    },
    {
      "id": 625537,
      "primary_message": "When the cauliflower is almost done, add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 625538,
      "primary_message": "To serve, divide cauliflower and salad between plates. Drizzle cauliflower with cashew cream and enjoy!",
      "secondary_message": null
    }
  ],
