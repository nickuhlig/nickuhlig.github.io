  "instructions": [
    {
      "id": 625440,
      "primary_message": "Preheat oven to 500°F. Line a baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 625441,
      "primary_message": "Boil water in a kettle. (If you do not have a kettle, boil water in a small saucepan, starting with hot water from the tap.) In a small heat-safe bowl, pour boiling water over cashews and set aside to soak.",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 625442,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ small bunch green onions (scallions)\n1 medium head cauliflower\n1 lime\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 625443,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a small bowl along with soy sauce, oil, chili-garlic sauce, and spices, then stir to combine the sauce.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp extra virgin olive oil\n1 tbsp chili-garlic sauce\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 625444,
      "primary_message": "Slice cauliflower lengthwise into 1-inch thick \"steaks.\" Transfer steaks (and any loose florets) to the baking sheet, then drizzle with sauce. Using your hands, rub the sauce over both sides of the cauliflower and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 625445,
      "primary_message": "Place cauliflower in oven (it doesn't have to be fully heated) and roast, flipping halfway through, until fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 625446,
      "primary_message": "Meanwhile, place oil, vinegar, maple syrup, salt, and pepper in a medium bowl, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n1 tsp pure maple syrup\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 625447,
      "primary_message": "Drain cashews and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 625448,
      "primary_message": "Zest and juice lime into the blender. Add water, nutritional yeast, flour, oil, and spices to the blender; purée on high until the cashew cream is smooth, 1-2 minutes.",
      "secondary_message": "½ cup water\n⅛ cup nutritional yeast flakes\n2 tsp all-purpose flour\n1 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder\n¼ tsp paprika"
    },
    {
      "id": 625449,
      "primary_message": "When the cauliflower is almost done, add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 625450,
      "primary_message": "To serve, divide cauliflower and salad between plates. Drizzle cauliflower with cashew cream and enjoy!",
      "secondary_message": null
    }
  ],
