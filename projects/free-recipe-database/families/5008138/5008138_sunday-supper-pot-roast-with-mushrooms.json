  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Quarter the button mushrooms. Finely chop the onion. Chop the carrots. Chop the celery.",
      "secondary_message": "8 oz button mushrooms\n1 onion\n2 carrots\n2 ribs celery"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°. Place dried mushrooms in a bowl and cover with boiling water. Cover bowl with plastic wrap and let sit.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place a large drizzle of olive oil in braising dish and place over medium high heat until oil is shimmering. Season all sides of pot roast with salt and pepper and sear on all sides until browned, about 15 minutes. Remove and reserve.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add quartered mushrooms to pan, stirring until browned (more olive oil may be necessary), about 6 minutes. Add onions and cook until beginning to brown, about 5 minutes. Add carrots and celery, and cook until beginning to wilt, about another 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place roast and all the accumulated juiced back in pan. Pour dried mushrooms and liquid over roast, along with beef broth. Bring to a simmer, cover with lid, and place in oven until roast is fully cooked and very tender, about 3 hours.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Once the roast is done, remove it from the braising dish, leaving behind all the liquid and vegetables, and season with salt and pepper. Mash together butter and flour to form a paste. Bring the liquid to a simmer and using a whisk, vigorously stir in flour butter paste. Simmer until thickened and serve the roast sliced, drizzled with cooking liquid.",
      "secondary_message": null
    }
  ],
