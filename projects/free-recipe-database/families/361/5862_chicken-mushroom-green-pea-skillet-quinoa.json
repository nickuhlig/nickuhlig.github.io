  "instructions": [
    {
      "id": 70428,
      "primary_message": "In a small saucepan, combine the quinoa, water, and salt; bring to a boil.",
      "secondary_message": "1 ½ cups quinoa\n710 ml (3 cups) water\n¾ tsp salt"
    },
    {
      "id": 70427,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "0.681 kg white mushrooms\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 70426,
      "primary_message": "Once the water is boiling, reduce the heat to a simmer and cover; cook for 15 minutes. Once cooked, remove from heat and let it stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 70425,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl and set aside.",
      "secondary_message": ""
    },
    {
      "id": 70424,
      "primary_message": "Slice the mushrooms and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 70423,
      "primary_message": "Peel and mince the shallots; add to the mushrooms.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 70422,
      "primary_message": "Measure out the green peas and transfer to a bowl.",
      "secondary_message": "3 cups frozen peas"
    },
    {
      "id": 70421,
      "primary_message": "Pat dry the chicken; holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "0.681 kg chicken breasts, boneless skinless"
    },
    {
      "id": 70420,
      "primary_message": "Season the chicken with salt and pepper on both sides.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 70419,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 70418,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 70417,
      "primary_message": "Place the chicken in the skillet and cook until browned, 1 to 2 minutes per side. Transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 70416,
      "primary_message": "Once the chicken has been transferred, add the shallot and mushrooms to the skillet. Season with salt and black pepper. Cook, stirring frequently, until the mushrooms have softened, 3 to 5 minutes.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 70415,
      "primary_message": "Add the broth and vinegar to the skillet; let the liquid simmer for 1 to 2 minutes.",
      "secondary_message": "355 ml (1 ½ cup) chicken or vegetable broth\n3 tbsp white wine vinegar"
    },
    {
      "id": 70414,
      "primary_message": "Place the chicken back in the skillet and cook until it is cooked through, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 70413,
      "primary_message": "Add the peas and half of the parsley (save the rest for garnishing) to the skillet; stir until well combined.",
      "secondary_message": ""
    },
    {
      "id": 70412,
      "primary_message": "Uncover the quinoa and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 70411,
      "primary_message": "Divide the quinoa between plates and top each with the chicken and vegetables. Sprinkle with the remaining parsley. Enjoy!",
      "secondary_message": ""
    }
  ],
