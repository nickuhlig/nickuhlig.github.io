  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the tender stems of the cilantro leaves. Finely chop the tender stems of the flat-leaf parsley leaves. Mince the garlic. Juice the lemon. Trim and halve the green beans crosswise. Trim and cut the asparagus into 2-inch pieces. Finely grate the lemon zest.",
      "secondary_message": "1 cup cilantro leaves\n1 cup flat-leaf parsley leaves\n3 large cloves garlic\n1 lemon\n12 oz green beans\n¾ bunch asparagus\n1 tsp lemon zest"
    },
    {
      "id": 1,
      "primary_message": "In a large stainless steel skillet, whisk olive oil, cilantro, parsley, garlic, lemon juice, paprika, cumin, tomato paste, and salt until combined.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cook over medium heat, stirring constantly, until herbs are fragrant and oil turns deep red, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add green beans and asparagus to skillet and toss to coat thoroughly. Cook, covered, until vegetables are crisp-tender, 6 to 7 minutes, stirring once halfway through.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove lid and stir in shrimp and peas. Cook over medium-high heat until shrimp are just opaque and peas are tender, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Off heat, season with pepper and additional salt to taste. Top with lemon zest. Serve over rice with lemon wedges and harissa on the side, if using.",
      "secondary_message": null
    }
  ],
