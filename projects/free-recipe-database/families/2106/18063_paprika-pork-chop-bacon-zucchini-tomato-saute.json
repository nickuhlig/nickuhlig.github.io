  "instructions": [
    {
      "id": 293298,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 293299,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 293300,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 3-4 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": null
    },
    {
      "id": 293301,
      "primary_message": "While the bacon is cooking, pat pork chops dry with paper towels and place on another plate; season with spices on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 293302,
      "primary_message": "When the bacon is done, return skillet (with drippings) to medium-high heat. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": null
    },
    {
      "id": 293303,
      "primary_message": "Meanwhile, wash and dry zucchini. Using a clean cutting board, trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons; place in a small bowl.",
      "secondary_message": "4 medium zucchini squash"
    },
    {
      "id": 293304,
      "primary_message": "Wash and dry tomatoes.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 293305,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 293306,
      "primary_message": "Return skillet (with cooking juices) to medium-high heat; add zucchini, tomatoes, garlic, and spices. Cook, stirring occasionally, until the zucchini is tender and tomatoes start to burst, 6-7 minutes.",
      "secondary_message": "1 tsp paprika\n1 tsp thyme, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 293307,
      "primary_message": "When the veggies are done, add water and continue to cook until the sauce has thickened, 2-3 minutes more. Remove from heat.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 293308,
      "primary_message": "To serve, divide chops, veggies, and sauce between plates; sprinkle with crispy bacon and enjoy!",
      "secondary_message": null
    }
  ],
