  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Line an 8- by 20-cm baking pan with parchment paper. Butter paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small saucepan, combine butter and chocolate and cook over medium heat, stirring often, until just melted. Stir until smooth. Take off heat and stir in sugar. Whisk in eggs one at a time. Stir in flour and salt until combined. Add 1/2 of chopped peppermint bark to batter and stir to incorporate.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour batter into prepared pan. Sprinkle top with remaining peppermint bark. Bake until brownies are dry on top and just cooked through but still gooey in the center, about 25 minutes. Let cool completely before serving.",
      "secondary_message": null
    }
  ],
