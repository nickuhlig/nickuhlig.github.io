  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the onion. Finely slice the onions in half-rings. Peel and chop the fresh ginger. Chop the garlic. Cut the scallions into thin rounds. Cut the hard-boiled eggs crosswise into slices.",
      "secondary_message": "½ medium onion\n1 ½ medium onions\n1 (2 ½ cm) piece fresh ginger\n2 cloves garlic\n4 scallions\n2 hard-boiled eggs"
    },
    {
      "id": 1,
      "primary_message": "Place the chopped onion, ginger, garlic, and 4 tablespoons of water into a blender. Puree until smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Spread the cut-up chicken out on a plate. Sprinkle lightly with salt and pepper and let sit.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place the flour in a bowl. Slowly add 1 cup of the chicken broth to mix well.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat a skillet over medium-high heat and add the oil. When the oil is hot, toss in the chicken and stir-fry until lightly browned. Some of the fat will render from the chicken skin. Remove the chicken with a slotted spoon.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add the sliced onions to the pan and cook slowly, allowing the onions to caramelize over the course of five to seven minutes. Towards the end of that time when the onions are beginning to brown, add the turmeric and paprika.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "In a pot suited for soups, add the chicken along with the juices that will have settled, the sautéed onions, the onion and ginger puree, and the remaining 2 cups of chicken broth. Carefully add the chickpea flour and broth mixture, mixing quickly so that the flour won't clump.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Bring the pot to a boil, then reduce the heat to low and simmer gently, uncovered, for 15 minutes. Season to taste with more salt, if needed.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Add the coconut milk. Stir to mix and return to a simmer. Serve with noodles and garnishes as desired.",
      "secondary_message": null
    }
  ],
