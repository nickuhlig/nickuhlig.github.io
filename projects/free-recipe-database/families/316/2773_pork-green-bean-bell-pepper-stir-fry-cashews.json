  "instructions": [
    {
      "id": 26888,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 26889,
      "primary_message": "Wash the green beans and trim ends; transfer to a bowl. Once the water in the saucepan is boiling, add the beans and cook until bright green and tender-crisp, 3-4 minutes. Drain and set aside.",
      "secondary_message": "0.34 kg green beans\r\n"
    },
    {
      "id": 26890,
      "primary_message": "Wash, seed, and slice the bell pepper lengthwise into strips; transfer to a medium bowl. Peel and mince the garlic; add to bowl. Peel and mince or grate the ginger; add to bowl.",
      "secondary_message": "1 red bell pepper\r\n1 clove garlic\r\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 26891,
      "primary_message": "Wash the green onions, trim ends, and thinly slice on a angle; transfer to a small bowl.",
      "secondary_message": "½ small bunch green onions (scallions)\r\n"
    },
    {
      "id": 26892,
      "primary_message": "In a small bowl, prepare the sauce by whisking together soy sauce, vinegar, and xylitol. Set aside.",
      "secondary_message": "1 tbsp tamari soy sauce\r\n½ tbsp rice vinegar\r\n½ tsp xylitol"
    },
    {
      "id": 26893,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 26894,
      "primary_message": "Thinly slice the pork chops crosswise into bite-sized strips; transfer to a small bowl. Add soy sauce and toss to coat.",
      "secondary_message": "2 pork chops, boneless\r\n1 tbsp tamari soy sauce"
    },
    {
      "id": 26895,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the pork and stir-fry until browned, 1-2 minutes. Transfer to a plate.",
      "secondary_message": "½ tbsp virgin coconut oil\r\n"
    },
    {
      "id": 26896,
      "primary_message": "Add more oil to the skillet, then add the pepper, garlic, ginger, and green beans. Stir fry until the pepper is tender-crisp, 2-3 minutes.",
      "secondary_message": "½ tbsp virgin coconut oil\r\n"
    },
    {
      "id": 26897,
      "primary_message": "Return pork to the skillet and pour in the sauce. Stir-fry until well combined, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 26898,
      "primary_message": "Roughly chop the cashews.",
      "secondary_message": "¼ cup cashews, roasted unsalted\r\n"
    },
    {
      "id": 26899,
      "primary_message": "Place stir fry in a bowl and garnish with sliced green onions and chopped cashews. Enjoy!",
      "secondary_message": ""
    }
  ],
