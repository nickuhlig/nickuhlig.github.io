  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Zest and juice the limes. Peel, pit, and dice the ripe mango. Pick the mint leaves from the stems and mince them.",
      "secondary_message": "4 limes\n1 large ripe mango\n6 large fresh mint"
    },
    {
      "id": 1,
      "primary_message": "In a medium saucepan, whisk together heavy cream, sugar, and a pinch of salt. Cook over medium heat, stirring frequently, until sugar is dissolved, about 5 minutes. Let cool slightly.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk in lime juice and zest. Pour cream mixture into glasses or ramekins, cover with plastic wrap, and refrigerate until possets are set, at least 4 hours and preferably overnight.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium bowl, toss together mango and mint. Spoon mango on top of possets, mound dollops of whipped cream on top, and serve right away.",
      "secondary_message": null
    }
  ],
