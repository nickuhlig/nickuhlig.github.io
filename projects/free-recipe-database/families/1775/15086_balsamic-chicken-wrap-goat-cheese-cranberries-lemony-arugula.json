  "instructions": [
    {
      "id": 249244,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ bunches radish\n3 (5 oz) pkgs baby arugula"
    },
    {
      "id": 249245,
      "primary_message": "Juice lemons into a large bowl; add oil, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n¾ tsp pure maple syrup\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 249246,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 249247,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces; season with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 249248,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and sauté, stirring occasionally, until cooked through, 6-8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 249249,
      "primary_message": "Meanwhile, crumble goat cheese into a small bowl and add cranberries; stir to combine and set aside.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese\n⅓ cup dried cranberries"
    },
    {
      "id": 249250,
      "primary_message": "Using a clean cutting board, peel, halve, and slice onions into thin half-moons.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 249251,
      "primary_message": "When the chicken is done, use a slotted spoon to transfer it to a plate (leaving cooking juices in the skillet).",
      "secondary_message": null
    },
    {
      "id": 249252,
      "primary_message": "Return skillet to medium-high heat. Add the onion and cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 249253,
      "primary_message": "While the onion is cooking, trim off and discard tops and root ends of radishes; cut into matchsticks and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 249254,
      "primary_message": "Add vinegar and sugar to the skillet with the onion; continue to cook, stirring constantly, until the vinegar is reduced, about 2 minutes. Return chicken to the skillet (along with any accumulated juices), stir to combine, and remove from heat.",
      "secondary_message": "⅓ cup balsamic vinegar\n1 ½ tsp brown sugar"
    },
    {
      "id": 249255,
      "primary_message": "Add arugula to the bowl with the dressing and radish; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 249256,
      "primary_message": "Place tortillas on a flat surface and divide balsamic chicken between them; top with a small amount of salad and sprinkle with the goat cheese-cranberry mixture. Roll tightly to close and cut in half. ",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 249257,
      "primary_message": "Divide wraps and remaining salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
