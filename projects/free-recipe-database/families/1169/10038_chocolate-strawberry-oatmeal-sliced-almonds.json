  "instructions": [
    {
      "id": 160114,
      "primary_message": "Place salt and water in a medium saucepan, cover, and bring to a boil over high heat.",
      "secondary_message": "⅛ tsp salt\n3 ½ cup water"
    },
    {
      "id": 160115,
      "primary_message": "Once boiling, add oats, cocoa powder, and maple syrup; whisk to combine. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency. ",
      "secondary_message": "2 cup oats, quick cooking\n¼ cup cocoa powder\n3 tbsp pure maple syrup"
    },
    {
      "id": 160116,
      "primary_message": "Meanwhile, wash, trim, and thinly slice strawberries.",
      "secondary_message": "½ (16 oz) pkg strawberries"
    },
    {
      "id": 160117,
      "primary_message": "To serve, divide oats between bowls and top with strawberries, almonds, and milk. Enjoy!",
      "secondary_message": "1 cup almonds, sliced\n16 fl oz (2 cups) almond milk, unsweetened"
    }
  ],
