  "instructions": [
    {
      "id": 160106,
      "primary_message": "Place salt and water in a large pot, cover, and bring to a boil over high heat.",
      "secondary_message": "3 pinch salt\n5 ¼ cup water"
    },
    {
      "id": 160107,
      "primary_message": "Once boiling, add oats, cocoa powder, and maple syrup; whisk to combine. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency. ",
      "secondary_message": "3 cup oats, quick cooking\n⅓ cup cocoa powder\n¼ cup pure maple syrup"
    },
    {
      "id": 160108,
      "primary_message": "Meanwhile, wash, trim, and thinly slice strawberries.",
      "secondary_message": "1 (16 oz) pkg strawberries"
    },
    {
      "id": 160109,
      "primary_message": "To serve, divide oats between bowls and top with strawberries, almonds, and milk. Enjoy!",
      "secondary_message": "1 ½ cups almonds, sliced\n24 fl oz (3 cups) whole milk"
    }
