  "instructions": [
    {
      "id": 160122,
      "primary_message": "Place salt and water in a small saucepan, cover, and bring to a boil over high heat.",
      "secondary_message": "1 pinch salt\n1 ¾ cup water"
    },
    {
      "id": 160123,
      "primary_message": "Once boiling, add oats, cocoa powder, and maple syrup; whisk to combine. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency. ",
      "secondary_message": "1 cup oats, quick cooking\n2 tbsp cocoa powder\n1 ½ tbsp pure maple syrup"
    },
    {
      "id": 160124,
      "primary_message": "Meanwhile, wash, trim, and thinly slice strawberries.",
      "secondary_message": "¼ (454 g) pkg strawberries"
    },
    {
      "id": 160125,
      "primary_message": "To serve, divide oats between bowls and top with strawberries, almonds, and milk. Enjoy!",
      "secondary_message": "½ cup almonds, sliced\n237 ml whole milk"
    }
