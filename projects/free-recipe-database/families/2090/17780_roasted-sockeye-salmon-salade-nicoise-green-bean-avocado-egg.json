  "instructions": [
    {
      "id": 287712,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 287713,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg green beans\n½ small pkg grape tomatoes\n½ avocado\n1 head butter (Boston) lettuce"
    },
    {
      "id": 287714,
      "primary_message": "Trim and discard ends of the green beans; transfer to a baking sheet pan. Drizzle with oil, season with spices, and toss to coat; spread out in an even layer.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 287715,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until green beans are fork-tender, 12-15 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 287716,
      "primary_message": "While the green beans are roasting, pat the salmon dry with paper towels and place, skin-side down, on another baking sheet. Drizzle with oil and season with spices.",
      "secondary_message": "0.23 kg sockeye salmon fillet\n1 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 287717,
      "primary_message": "Add baking sheet to the oven and roast until salmon is opaque and flakes easily with a fork, 8-10 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 287718,
      "primary_message": "Meanwhile, halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 287719,
      "primary_message": "Peel and thinly slice shallot into rings; add to the plate with the tomatoes.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 287720,
      "primary_message": "Halve eggs lengthwise; add to the plate.",
      "secondary_message": "4 hard-cooked eggs, peeled"
    },
    {
      "id": 287721,
      "primary_message": "Halve and pit avocado. Slice thinly while still in the skin, then scoop out onto the plate.",
      "secondary_message": null
    },
    {
      "id": 287722,
      "primary_message": "Separate lettuce into leaves and divide between plates. Top with green beans, salmon, tomatoes, shallots, eggs, avocado, olives, and capers. Serve with vinaigrette on the side and enjoy!",
      "secondary_message": "⅓ cup Kalamata olives, pitted\n1 tbsp capers\n3 tbsp French vinaigrette"
    }
  ],
