  "instructions": [
    {
      "id": 287701,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 287702,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n0.68 kg green beans\n1 ½ small pkgs grape tomatoes\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 287703,
      "primary_message": "Depending on size, halve or quarter potatoes into bite-sized pieces. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 287704,
      "primary_message": "Trim and discard ends of the green beans; transfer to a second baking sheet. Drizzle potatoes and green beans with oil, season with spices, and toss to coat; spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 287705,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are golden brown and fork-tender, about 20 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 287706,
      "primary_message": "While the veggies are roasting, pat the salmon dry with paper towels and place, skin-side down, on a third baking sheet. Drizzle with oil and season with spices.",
      "secondary_message": "0.68 kg sockeye salmon fillet\n1 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 287707,
      "primary_message": "Add baking sheet to the oven and roast until salmon is opaque and flakes easily with a fork, about 10 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 287708,
      "primary_message": "Meanwhile, halve tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 287709,
      "primary_message": "Peel and thinly slice shallots into rings; add to the plate with the tomatoes.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 287710,
      "primary_message": "Halve eggs lengthwise; add to the plate.",
      "secondary_message": "6 hard-cooked eggs, peeled"
    },
    {
      "id": 287711,
      "primary_message": "Separate lettuce into leaves and divide between plates. Top with potatoes, green beans, salmon, tomatoes, shallots, eggs, olives, and capers. Serve with vinaigrette on the side and enjoy!",
      "secondary_message": "1 cup Kalamata olives, pitted\n3 tbsp capers\n½ cup French vinaigrette"
    }
  ],
