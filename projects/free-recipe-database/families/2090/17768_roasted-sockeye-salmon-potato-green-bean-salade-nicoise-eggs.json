  "instructions": [
    {
      "id": 287583,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 287584,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb new potatoes\n½ lb green beans\n½ pint grape tomatoes\n1 head butter (Boston) lettuce"
    },
    {
      "id": 287585,
      "primary_message": "Depending on size, halve or quarter potatoes into bite-sized pieces. Transfer to one half of a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 287586,
      "primary_message": "Trim and discard ends of the green beans; add to the other half of the baking sheet. Drizzle veggies with oil, season with spices, and toss to coat (keeping the veggies separate); spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 287587,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are golden brown and fork-tender, 15-20 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 287588,
      "primary_message": "While the veggies are roasting, pat the salmon dry with paper towels and place, skin-side down, on another baking sheet. Drizzle with oil and season with spices.",
      "secondary_message": "½ lb sockeye salmon fillet\n1 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 287589,
      "primary_message": "Add baking sheet to the oven and roast until salmon is opaque and flakes easily with a fork, 8-10 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 287590,
      "primary_message": "Meanwhile, halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 287591,
      "primary_message": "Peel and thinly slice shallot into rings; add to the plate with the tomatoes.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 287592,
      "primary_message": "Halve eggs lengthwise; add to the plate.",
      "secondary_message": "2 hard-cooked eggs, peeled"
    },
    {
      "id": 287593,
      "primary_message": "Separate lettuce into leaves and divide between plates. Top with potatoes, green beans, salmon, tomatoes, shallots, eggs, olives, and capers. Serve with vinaigrette on the side and enjoy!",
      "secondary_message": "⅓ cup Kalamata olives, pitted\n1 tbsp capers\n3 tbsp French vinaigrette"
    }
  ],
