  "instructions": [
    {
      "id": 287669,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 287670,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n1 ½ lb green beans\n1 ½ pints grape tomatoes\n3 avocados\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 287671,
      "primary_message": "Depending on size, halve or quarter potatoes into bite-sized pieces. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 287672,
      "primary_message": "Trim and discard ends of the green beans; transfer to a second baking sheet. Drizzle potatoes and green beans with oil, season with spices, and toss to coat; spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 287673,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are golden brown and fork-tender, about 20 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 287674,
      "primary_message": "Meanwhile, halve tomatoes and place on a platter.",
      "secondary_message": null
    },
    {
      "id": 287675,
      "primary_message": "Peel and thinly slice shallots into rings; add to the platter with the tomatoes.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 287676,
      "primary_message": "Halve eggs lengthwise; add to the plate.",
      "secondary_message": "12 hard-cooked eggs, peeled"
    },
    {
      "id": 287677,
      "primary_message": "Halve and pit avocados. Slice thinly while still in the skin, then scoop out onto the platter.",
      "secondary_message": null
    },
    {
      "id": 287678,
      "primary_message": "Separate lettuce into leaves and divide between plates. Top with potatoes, green beans, tomatoes, shallots, eggs, avocado, olives, and capers. Serve with vinaigrette on the side and enjoy!",
      "secondary_message": "1 cup Kalamata olives, pitted\n3 tbsp capers\n½ cup French vinaigrette"
    }
  ],
