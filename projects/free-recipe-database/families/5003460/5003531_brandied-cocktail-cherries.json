  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium saucepan, combine sugar, cherry juice (or water), cinnamon, nutmeg, and salt. Bring to a low simmer. Simmer, stirring until sugar is fully dissolved.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove saucepan from heat. Add brandy or other liqueur, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add cherries and stir until coated with syrup.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove to clean canning jars. Let cool to room temperature and then refrigerate overnight before serving.",
      "secondary_message": null
    }
  ],
