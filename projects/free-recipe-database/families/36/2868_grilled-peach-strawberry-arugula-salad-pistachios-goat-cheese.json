  "instructions": [
    {
      "id": 27826,
      "primary_message": "Pull out all the cookware and kitchen tools you'll need, making sure they are all clean and dry, and place them in the area where you will need them.",
      "secondary_message": ""
    },
    {
      "id": 27827,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 peaches\n1 English cucumber\n1 (16 oz) pkg fresh strawberries\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 27828,
      "primary_message": "Peel and press or mince the garlic; transfer to a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 27829,
      "primary_message": "Halve and pit the peaches; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 27830,
      "primary_message": "Cut off and discard the ends of the cucumber; medium dice the cucumber and transfer to a medium bowl (separate from the peaches).",
      "secondary_message": ""
    },
    {
      "id": 27837,
      "primary_message": "Trim off and discard the stem ends of the strawberries; thinly slice the strawberries and add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 27839,
      "primary_message": "Shell the pistachios and transfer to a small bowl.",
      "secondary_message": "½ cup pistachios, roasted unsalted"
    },
    {
      "id": 27834,
      "primary_message": "Crumble the goat cheese into a small bowl.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 27831,
      "primary_message": "Preheat a grill pan (or skillet) over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 27832,
      "primary_message": "Brush or rub the cut sides of the peach halves with olive oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 27838,
      "primary_message": "Place the peach halves, cut side down, on it and cook until grill marks form (or the fruit is browned and tender), 3 to 5 minutes. Transfer back to the bowl and let them cool.",
      "secondary_message": null
    },
    {
      "id": 27833,
      "primary_message": "To prepare the salad dressing, in a small bowl, combine and whisk together the minced garlic, olive oil, vinegar, honey, Dijon, salt, and pepper.",
      "secondary_message": "6 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n2 tsp honey\n½ tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 27835,
      "primary_message": "Slice the peach halves into thin wedges.",
      "secondary_message": ""
    },
    {
      "id": 27836,
      "primary_message": "Divide the arugula, peaches, cucumber, strawberries, pistachios, and goat cheese between two plates (or containers). Finish each by drizzling with the dressing (or reserve some of the dressing in a separate container if you are saving half of the meal for next day's lunch). Enjoy!",
      "secondary_message": ""
    }
  ],
