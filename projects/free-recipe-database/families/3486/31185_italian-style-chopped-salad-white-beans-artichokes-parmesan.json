  "instructions": [
    {
      "id": 493425,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup white wine vinegar\n1 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 493426,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 493427,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n3 green bell peppers\n1 ½ small pkgs grape tomatoes\n3 heads romaine lettuce"
    },
    {
      "id": 493428,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 493429,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with mayo, vinegar, oil, sugar, and spices. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n⅓ cup white wine vinegar\n3 tbsp extra virgin olive oil\n1 tbsp brown sugar\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 493430,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493431,
      "primary_message": " Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493432,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493433,
      "primary_message": "Drain and roughly chop artichoke hearts and olives. Add both to the bowl.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated\n1 cup Kalamata olives, pitted"
    },
    {
      "id": 493434,
      "primary_message": "Finely grate Parmesan. Add to the bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 493435,
      "primary_message": "Drain pickled onions. Add to the bowl, along with beans, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 493436,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
