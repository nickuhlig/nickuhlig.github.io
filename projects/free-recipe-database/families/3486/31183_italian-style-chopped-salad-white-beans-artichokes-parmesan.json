  "instructions": [
    {
      "id": 493401,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp white wine vinegar\n1 tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 493402,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 493403,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n1 green bell pepper\n½ small pkg grape tomatoes\n1 head romaine lettuce"
    },
    {
      "id": 493404,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 493405,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with mayo, vinegar, oil, sugar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n2 tbsp white wine vinegar\n1 tbsp extra virgin olive oil\n1 tsp brown sugar\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 493406,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493407,
      "primary_message": " Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493408,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493409,
      "primary_message": "Drain and roughly chop artichoke hearts and olives. Add both to the bowl.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated\n⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 493410,
      "primary_message": "Finely grate Parmesan. Add to the bowl.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 493411,
      "primary_message": "Drain pickled onions. Add to the bowl, along with beans, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 493412,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
