  "instructions": [
    {
      "id": 493413,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup white wine vinegar\n2 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 493414,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 493415,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n2 green bell peppers\n1 small pkg grape tomatoes\n2 heads romaine lettuce"
    },
    {
      "id": 493416,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 493417,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with mayo, vinegar, oil, sugar, and spices. Whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n¼ cup white wine vinegar\n2 tbsp extra virgin olive oil\n2 tsp brown sugar\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 493418,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493419,
      "primary_message": " Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493420,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493421,
      "primary_message": "Drain and roughly chop artichoke hearts and olives. Add both to the bowl.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated\n⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 493422,
      "primary_message": "Finely grate Parmesan. Add to the bowl.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 493423,
      "primary_message": "Drain pickled onions. Add to the bowl, along with beans, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 493424,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
