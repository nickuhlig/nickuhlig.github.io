  "instructions": [
    {
      "id": 1,
      "primary_message": "Cream butter to soften, then thoroughly cream butter, shortening, and sugar. Mix in water and vanilla, then flour and nuts.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Wrap dough in plastic wrap. Chill dough for 3- 4 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat oven to 325°F. Form dough into long rolls, 1/2\" across. Cut into 3\" lengths and shape into crescents. Bake on an parchment-laced sheet for about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cool slightly on the pan, then sift confectioner's sugar over. They are very fragile, handle carefully.",
      "secondary_message": null
    }
  ],
