  "instructions": [
    {
      "id": 470151,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 470152,
      "primary_message": "While the pot heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 470153,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until cooked through but not crispy, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 470154,
      "primary_message": "Meanwhile, wash and dry bell peppers. Using a clean cutting board, trim, seed, and small dice, then place in a medium bowl.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 470155,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the bell pepper.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 470156,
      "primary_message": "When the bacon is done, add bell pepper and onion to the pot. Cook, stirring occasionally, until veggies begin to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 470157,
      "primary_message": "Add beans with their liquid (do not drain) to the pot along with tomato sauce, vinegar, Dijon, honey, Worcestershire, salt, and pepper. Stir to combine the stew and bring to a boil over high heat.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans\n2 (213 ml) cans tomato sauce\n2 tbsp apple cider vinegar\n2 tsp Dijon mustard\n2 tsp honey\n1 tsp Worcestershire sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 470158,
      "primary_message": "Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender and sauce thickens, 10-12 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 470159,
      "primary_message": "While the beans are cooking, wash, dry, and trim zucchini, then slice lengthwise into ¼-inch thick planks. Transfer to a plate, drizzle with oil, then season with salt and pepper.",
      "secondary_message": "4 medium zucchini squash\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 470160,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470161,
      "primary_message": "Once the pan is hot, working in batches if necessary, add zucchini and grill until charred and tender, 2-3 minutes per side. Return to the plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": null
    },
    {
      "id": 470162,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 470163,
      "primary_message": "Divide pork and bean stew between bowls. Serve grilled zucchini on the side and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
