  "instructions": [
    {
      "id": 470138,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 470139,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 470140,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until cooked through but not crispy, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 470141,
      "primary_message": "Meanwhile, wash and dry bell pepper. Using a clean cutting board, trim, seed, and small dice, then place in a small bowl.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 470142,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the bell pepper.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 470143,
      "primary_message": "When the bacon is done, add bell pepper and onion to the skillet. Cook, stirring occasionally, until veggies begin to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 470144,
      "primary_message": "Add beans with their liquid (do not drain) to the skillet along with tomato sauce, vinegar, Dijon, honey, Worcestershire, salt, and pepper. Stir to combine the stew and bring to a boil over high heat.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans\n1 (213 ml) can tomato sauce\n1 tbsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp Worcestershire sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 470145,
      "primary_message": "Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender and sauce thickens, 10-12 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 470146,
      "primary_message": "While the beans are cooking, wash, dry, and trim zucchini, then slice lengthwise into ¼-inch thick planks. Transfer to a plate, drizzle with oil, then season with salt and pepper.",
      "secondary_message": "2 medium zucchini squash\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 470147,
      "primary_message": "Preheat a grill pan, outdoor grill, or another skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470148,
      "primary_message": "Once the pan is hot, add zucchini and grill until charred and tender, 2-3 minutes per side. Return to the plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": null
    },
    {
      "id": 470149,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 470150,
      "primary_message": "Divide pork and bean stew between bowls. Serve grilled zucchini on the side and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
