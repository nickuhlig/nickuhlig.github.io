  "instructions": [
    {
      "primary_message": "Place butter, sugar, and spices in a small saucepan. Melt butter over medium heat, stirring occasionally.",
      "secondary_message": "2 tbsp butter, unsalted\n4 tsp brown sugar\n¼ tsp nutmeg, ground\n¼ tsp cinnamon, ground\n⅛ tsp cloves, ground\n1 pinch salt"
    },
    {
      "primary_message": "Once the butter is melted, add 10 fl oz (1 1/4 cups) water and vanilla to the pan; bring mixture to a simmer. Once simmering, continue to cook, stirring occasionally, until heated through and flavors blend, 4-5 minutes.",
      "secondary_message": "½ tsp vanilla extract"
    },
    {
      "primary_message": "Remove mixture from heat, then add 4 fl oz (1/2 cup) rum and stir to combine.",
      "secondary_message": "118 ml dark rum"
    },
    {
      "primary_message": "To serve, divide buttered rum between mugs or heat-safe glasses. Garnish with whipped topping and cinnamon sticks. Enjoy!",
      "secondary_message": "1 cup whipped topping"
    }
  ],
