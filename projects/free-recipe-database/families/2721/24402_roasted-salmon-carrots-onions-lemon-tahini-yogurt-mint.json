  "instructions": [
    {
      "id": 395396,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 395397,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "18 medium carrots\n3 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 395398,
      "primary_message": "Peel and trim carrots. Cut lengthwise into quarters or halves (depending on size), then divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 395399,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces. Add to the baking sheets with the carrots.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 395400,
      "primary_message": "Drizzle veggies with oil and season with salt; toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 395401,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until veggies are starting to soften and brown, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 395402,
      "primary_message": "Meanwhile, zest and juice half of the lemons into a medium bowl. Cut the remaining lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 395403,
      "primary_message": "Add yogurt, tahini, and salt to the bowl with the lemon juice. Whisk to combine the lemon-tahini yogurt and set aside.",
      "secondary_message": "2 ¼ cups plain Greek yogurt\n3 tbsp tahini\n½ tsp salt"
    },
    {
      "id": 395404,
      "primary_message": "When the veggies are soft, remove from the oven and stir. Add salmon to the baking sheets, nestling fillets into the veggies. Drizzle salmon with additional oil and season with salt.",
      "secondary_message": "1.02 kg salmon fillet\n1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 395405,
      "primary_message": "Return baking sheets to the oven and roast until the salmon is cooked through, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 395406,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and roughly chop the leaves. ",
      "secondary_message": null
    },
    {
      "id": 395407,
      "primary_message": "When the salmon is done, remove from the oven. Add half of the mint to the veggies and stir to combine (reserve remaining mint for serving). ",
      "secondary_message": null
    },
    {
      "id": 395408,
      "primary_message": "Spoon yogurt over the bottom of each plate. Top with veggies and salmon, drizzle the veggies with honey, then sprinkle with crushed red pepper and reserved mint. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": "3 tbsp honey\n¾ tsp crushed red pepper"
    }
  ],
