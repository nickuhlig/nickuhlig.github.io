  "instructions": [
    {
      "id": 395344,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 395345,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "12 medium carrots\n2 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 395346,
      "primary_message": "Peel and trim carrots. Cut lengthwise into quarters or halves (depending on size), then transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 395347,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces. Add to the baking sheet with the carrots.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 395348,
      "primary_message": "Drizzle veggies with oil and season with salt; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 395349,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are starting to soften and brown, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 395350,
      "primary_message": "Meanwhile, zest and juice one lemon into a small bowl. Cut the remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 395351,
      "primary_message": "Add yogurt, tahini, and salt to the bowl with the lemon juice. Whisk to combine the lemon-tahini yogurt and set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n2 tbsp tahini\n¼ tsp salt"
    },
    {
      "id": 395352,
      "primary_message": "When the veggies are soft, remove from the oven and stir. Add salmon to the baking sheet, nestling fillets into the veggies. Drizzle salmon with additional oil and season with salt.",
      "secondary_message": "1 ½ lb salmon fillet\n2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 395353,
      "primary_message": "Return baking sheet to the oven and roast until the salmon is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 395354,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and roughly chop the leaves. ",
      "secondary_message": null
    },
    {
      "id": 395355,
      "primary_message": "When the salmon is done, remove from the oven. Add half of the mint to the veggies and stir to combine (reserve remaining mint for serving). ",
      "secondary_message": null
    },
    {
      "id": 395356,
      "primary_message": "Spoon yogurt over the bottom of each plate. Top with veggies and salmon, drizzle the veggies with honey, then sprinkle with crushed red pepper and reserved mint. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": "2 tbsp honey\n½ tsp crushed red pepper"
    }
  ],
