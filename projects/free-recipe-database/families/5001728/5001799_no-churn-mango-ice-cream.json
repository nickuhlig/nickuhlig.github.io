  "instructions": [
    {
      "id": 1,
      "primary_message": "In a food processor or blender, process heavy cream, stopping and scraping down sides of processor jar as needed for even blending, until thickened and soft peaks form, 30 to 60 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add condensed milk and 1 1/2 cups mango puree and process until well combined,10 to 20 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour mixture into a loaf pan, 20-cm square baking pan or dish, or large metal or glass bowl. Drizzle remaining 1/4 cup mango puree over top and gently swirl into cream mixture using tines of a fork to create a swirl pattern. Press plastic wrap flush against surface and freeze until frozen and firm, at least 6 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Scoop and enjoy.",
      "secondary_message": null
    }
  ],
