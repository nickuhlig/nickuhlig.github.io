  "instructions": [
    {
      "id": 571567,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 571568,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 small bunch cilantro\n1 small pineapple"
    },
    {
      "id": 571569,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 571570,
      "primary_message": "While the rice is cooking, zest and juice limes. Divide between a small and medium bowl.",
      "secondary_message": null
    },
    {
      "id": 571571,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between the bowls. ",
      "secondary_message": null
    },
    {
      "id": 571572,
      "primary_message": "Peel and mince shallots. Add to the medium bowl with the lime and cilantro. (Set medium bowl aside for later use.)",
      "secondary_message": "2 shallots"
    },
    {
      "id": 571573,
      "primary_message": "Add yogurt and spices to the small bowl, then stir to combine the lime yogurt. Set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n¼ tsp coriander, ground\n¼ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 571574,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 571575,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 571576,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp neutral vegetable oil\n16 oz veggie ground, plant based\n1 tbsp chili powder\n2 tsp cumin, ground\n½ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 571577,
      "primary_message": "Meanwhile, cut off skin from pineapple; quarter, core, and medium dice the flesh. Add to the medium bowl, along with the broccoli slaw and salt, then toss to combine.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw\n¼ tsp salt"
    },
    {
      "id": 571578,
      "primary_message": "To serve, divide rice, veggie ground, and slaw between bowls. Top with lime yogurt and enjoy!",
      "secondary_message": null
    }
  ],
