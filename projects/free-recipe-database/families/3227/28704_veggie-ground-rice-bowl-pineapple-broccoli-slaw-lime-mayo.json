  "instructions": [
    {
      "id": 571615,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 571616,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small bunch cilantro\n1 ½ small pineapples"
    },
    {
      "id": 571617,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 571618,
      "primary_message": "While the rice is cooking, zest and juice limes. Divide between a small and large bowl.",
      "secondary_message": null
    },
    {
      "id": 571619,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between the bowls. ",
      "secondary_message": null
    },
    {
      "id": 571620,
      "primary_message": "Peel, halve, and mince onion. Add to the large bowl with the lime and cilantro. (Set large bowl aside for later use.)",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 571621,
      "primary_message": "Add mayo and spices to the small bowl, then stir to combine the lime mayo. Set aside.",
      "secondary_message": "½ cup vegan mayonnaise\n½ tsp coriander, ground\n½ tsp cumin, ground"
    },
    {
      "id": 571622,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 571623,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 571624,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp neutral vegetable oil\n24 oz veggie ground, plant based\n1 ½ tbsp chili powder\n1 tbsp cumin, ground\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 571625,
      "primary_message": "Meanwhile, cut off skin from each pineapple; quarter, core, and medium dice the flesh. Add to the large bowl, along with the broccoli slaw and salt, then toss to combine.",
      "secondary_message": "1 ½ (12 oz) pkgs broccoli slaw\n½ tsp salt"
    },
    {
      "id": 571626,
      "primary_message": "To serve, divide rice, veggie ground, and slaw between bowls. Top with lime mayo and enjoy!",
      "secondary_message": null
    }
  ],
