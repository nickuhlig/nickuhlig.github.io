  "instructions": [
    {
      "id": 571591,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 571592,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch cilantro\n½ small pineapple"
    },
    {
      "id": 571593,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 571594,
      "primary_message": "While the rice is cooking, zest and juice lime. Divide between a small and medium bowl.",
      "secondary_message": null
    },
    {
      "id": 571595,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between the bowls. ",
      "secondary_message": null
    },
    {
      "id": 571596,
      "primary_message": "Peel and mince shallot. Add to the medium bowl with the lime and cilantro. (Set medium bowl aside for later use.)",
      "secondary_message": "1 shallot"
    },
    {
      "id": 571597,
      "primary_message": "Add mayo and spices to the small bowl, then stir to combine the lime mayo. Set aside.",
      "secondary_message": "3 tbsp vegan mayonnaise\n⅛ tsp coriander, ground\n⅛ tsp cumin, ground\n⅛ tsp salt"
    },
    {
      "id": 571598,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 571599,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 571600,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tsp neutral vegetable oil\n8 oz veggie ground, plant based\n1 ½ tsp chili powder\n1 tsp cumin, ground\n¼ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 571601,
      "primary_message": "Meanwhile, cut off skin from pineapple; quarter, core, and medium dice the flesh. Add to the medium bowl, along with the broccoli slaw and salt, then toss to combine.",
      "secondary_message": "½ (12 oz) pkg broccoli slaw\n⅛ tsp salt"
    },
    {
      "id": 571602,
      "primary_message": "To serve, divide rice, veggie ground, and slaw between bowls. Top with lime mayo and enjoy!",
      "secondary_message": null
    }
  ],
