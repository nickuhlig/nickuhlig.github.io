  "instructions": [
    {
      "id": 36781,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n1 small bunch cilantro\n2 avocados\n2 limes"
    },
    {
      "id": 36782,
      "primary_message": "Small dice the tomatoes and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 36783,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh. Add to the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 36784,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add ½ of the cilantro to the bowl with the tomatoes and avocado and transfer the other ½ to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 36785,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 36786,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces). Transfer ½ of the onion to the bowl with the salsa ingredients and leave the rest on the cutting board.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 36787,
      "primary_message": "Once the skillet is heated, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 36788,
      "primary_message": "Add the remaining onion to the skillet; cook, stirring occasionally, until softened, 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 36789,
      "primary_message": "While the onion cooks, drain and rinse the black beans in a colander.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 36790,
      "primary_message": "Add more coconut oil to the skillet, followed by the beans and remaining cilantro.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 36791,
      "primary_message": "Season the bean mixture with chili powder, cumin, salt, and pepper; stir until fragrant, 15 to 30 seconds. Cook, stirring occasionally, until the beans are warmed through, 2 to 4 minutes. Mash some of the beans with a fork is desired.",
      "secondary_message": "2 tsp chili powder\n1 tsp cumin\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 36792,
      "primary_message": "Wrap the tortillas in a damp towel and microwave until heated through, 15 to 30 seconds.",
      "secondary_message": "16 small corn tortillas"
    },
    {
      "id": 36793,
      "primary_message": "Juice the limes; drizzle ½ of the lime juice over the beans and add the rest to the bowl with the salsa ingredients.",
      "secondary_message": null
    },
    {
      "id": 36794,
      "primary_message": "Season the salsa with salt and pepper; mix together.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 36795,
      "primary_message": "To serve, place the bean mixture into the tortillas and top with the salsa. Enjoy!",
      "secondary_message": null
    }
  ],
