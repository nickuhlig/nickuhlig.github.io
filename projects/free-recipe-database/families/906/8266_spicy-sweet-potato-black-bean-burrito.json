  "instructions": [
    {
      "id": 157418,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n0.23 kg sweet potato\n½ small bunch cilantro"
    },
    {
      "id": 157419,
      "primary_message": "Peel and small dice onion. Small dice bell pepper. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 157420,
      "primary_message": "Heat a large pot over medium heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 157421,
      "primary_message": "Add onion and bell pepper to the pot; cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 157422,
      "primary_message": "Peel and small dice sweet potato.",
      "secondary_message": null
    },
    {
      "id": 157423,
      "primary_message": "Add sweet potato and broth to the pot and bring to a boil; reduce heat and simmer, 10 minutes, until potatoes are fork-tender.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 157424,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "½ (398 ml) can black beans"
    },
    {
      "id": 157425,
      "primary_message": "Grate cheddar. Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 157426,
      "primary_message": "Once potatoes are tender, drain vegetables; return them to the pot and place on low heat. ",
      "secondary_message": null
    },
    {
      "id": 157427,
      "primary_message": "Add beans, cheddar, cilantro, yogurt, and spices to the pot. Stir to combine and remove from the heat.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 ½ tsp chili powder\n½ tsp salt\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp cayenne pepper\n¼ tsp cumin"
    },
    {
      "id": 157428,
      "primary_message": "Lay tortillas on a flat surface. Divide vegetable mixture evenly and place in the middle of each tortilla. Fold in sides of tortilla and roll tightly.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 157429,
      "primary_message": "Heat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 157430,
      "primary_message": "Lay burritos seam side down and cook for 2-3 minutes on each side, until golden brown and crispy. ",
      "secondary_message": null
    },
    {
      "id": 157431,
      "primary_message": "Remove burritos from heat, cut in half, and enjoy!",
      "secondary_message": null
    }
  ],
