  "instructions": [
    {
      "id": 12813,
      "primary_message": "Wash and dry mushrooms and bell peppers. Thinly slice mushrooms. Seed and small dice peppers. Transfer both to a medium bowl.",
      "secondary_message": "½ lb white mushrooms\r\n2 orange bell peppers"
    },
    {
      "id": 12814,
      "primary_message": "Peel and mince garlic and ginger. Grate 2 tsp of lime zest.",
      "secondary_message": "4 cloves garlic\r\n2 (1 inch) pieces ginger\r\n2 limes"
    },
    {
      "id": 12815,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 12816,
      "primary_message": "Cut chicken into bite-sized pieces.",
      "secondary_message": "1 lb chicken breasts, boneless skinless"
    },
    {
      "id": 12817,
      "primary_message": "Coat bottom of saucepan with oil. Add chicken and, stirring frequently, cook until cooked through, 3-4 minutes. Transfer to a plate.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 12818,
      "primary_message": "Return saucepan to stove. Add more oil, garlic and ginger. Stir until fragrant, 15-30 seconds. Add mushrooms, bell pepper, lime zest and juice. Stirring frequently, cook until vegetables are tender, 2-3 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n1 lime"
    },
    {
      "id": 12819,
      "primary_message": "Add broth, coconut milk, fish sauce, honey, and chicken. Simmer for about 5 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n4 tsp fish sauce\n2 tsp honey"
    },
    {
      "id": 12820,
      "primary_message": "Toast bread.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 12821,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Cut remaining lime into wedges.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 12822,
      "primary_message": "To serve, pour soup into a bowl, garnish with cilantro and squeeze lime juice, and have bread on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
