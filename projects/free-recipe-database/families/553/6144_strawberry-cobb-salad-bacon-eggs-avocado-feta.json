  "instructions": [
    {
      "id": 74638,
      "primary_message": "Place the eggs in a small saucepan and cover with cold water by about 1 inch. Cover with a lid and bring to a rolling boil over high heat.",
      "secondary_message": "9 eggs"
    },
    {
      "id": 74637,
      "primary_message": "Trim off and discard the root end of the lettuce and remove any blemished leaves; quarter the head lengthwise, then chop crosswise into 1-inch pieces. Wash and spin dry the lettuce in salad spinner, or wash in a colander, spread out on a clean towel, and pat dry. Transfer to a large bowl.",
      "secondary_message": "1 ½ head romaine lettuce"
    },
    {
      "id": 74636,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 74635,
      "primary_message": "Wash and dry the remaining fresh produce.",
      "secondary_message": "1 ½ (16 oz) pkg strawberries\n1 ½ avocados"
    },
    {
      "id": 74634,
      "primary_message": "Once the skillet is hot, add the bacon strips. Cook until the bacon is crispy, 3 to 4 minutes per side. Once done, transfer to a plate lined with paper towels.",
      "secondary_message": "9 strips bacon"
    },
    {
      "id": 74633,
      "primary_message": "Once the water is boiling, remove the pan from the heat and let the eggs sit, covered, for 6 minutes. Once done, drain and run the eggs under cold water for 1-2 minutes to stop the cooking process.",
      "secondary_message": ""
    },
    {
      "id": 74632,
      "primary_message": "Trim off and discard the stem ends of the strawberries; quarter the strawberries lengthwise and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 74631,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and medium dice the flesh.",
      "secondary_message": ""
    },
    {
      "id": 74630,
      "primary_message": "Place the feta in a small bowl.",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 74629,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 74628,
      "primary_message": "In a small bowl, combine and whisk together the minced garlic, olive oil, vinegar, Dijon, salt, and pepper. Set aside.",
      "secondary_message": "9 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n3 tsp Dijon mustard\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 74627,
      "primary_message": "Roughly chop the bacon and transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 74626,
      "primary_message": "Peel and roughly chops the eggs.",
      "secondary_message": ""
    },
    {
      "id": 74625,
      "primary_message": "To serve, arrange a bed of lettuce on a plate, then add the strawberries, avocado, bacon, eggs, and feta in rows over top. Drizzle with the dressing and enjoy!",
      "secondary_message": ""
    }
  ],
