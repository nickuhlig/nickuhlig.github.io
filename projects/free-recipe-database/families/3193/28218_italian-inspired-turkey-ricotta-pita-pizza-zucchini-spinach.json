  "instructions": [
    {
      "id": 451716,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 451717,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n1 small pkg fresh basil\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 451718,
      "primary_message": "Trim and small dice zucchini.",
      "secondary_message": null
    },
    {
      "id": 451719,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 451720,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add zucchini, turkey, and spices. Cook, breaking the meat apart with a spoon, until turkey is browned and crumbly and zucchini is tender, 6-7 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg ground turkey\n2 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 451721,
      "primary_message": "Meanwhile, divide pitas between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 451722,
      "primary_message": "While the pitas are baking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 451723,
      "primary_message": "Add tomato sauce and half of the basil to the skillet with the turkey and zucchini, then stir to combine. (Reserve remaining basil for later use.)",
      "secondary_message": "1 ½ (213 ml) cans tomato sauce"
    },
    {
      "id": 451724,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 451725,
      "primary_message": "Spread pitas with about ⅔ of the ricotta; top with turkey mixture, then dot with remaining ricotta. Return baking sheets to the oven and continue to bake until pizzas are warmed through, 6-7 minutes.",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese"
    },
    {
      "id": 451726,
      "primary_message": "When the pizzas are done, remove from the oven. Sprinkle with reserved basil and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 451727,
      "primary_message": "To serve, divide pizzas between plates and enjoy!",
      "secondary_message": null
    }
  ],
