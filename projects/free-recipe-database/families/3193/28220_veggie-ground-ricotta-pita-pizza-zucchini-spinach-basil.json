  "instructions": [
    {
      "id": 451740,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 451741,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium zucchini squash\n1 small pkg fresh basil\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 451742,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 451743,
      "primary_message": "While the skillet heats up, trim and small dice zucchini.",
      "secondary_message": null
    },
    {
      "id": 451744,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add zucchini, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until it is browned and crumbly and zucchini is tender, about 5 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n4 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp onion powder\n½ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 451745,
      "primary_message": "Meanwhile, arrange pitas on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 451746,
      "primary_message": "While the pitas are baking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 451747,
      "primary_message": "Add tomato sauce and half of the basil to the skillet with the veggie ground and zucchini, then stir to combine. (Reserve remaining basil for later use.) ",
      "secondary_message": "1 (213 ml) can tomato sauce"
    },
    {
      "id": 451748,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 451749,
      "primary_message": "Spread pitas with about ⅔ of the ricotta; top with veggie ground mixture, then dot with remaining ricotta. Return baking sheet to the oven and continue to bake until pizzas are warmed through, about 5 minutes. ",
      "secondary_message": "1 (425 g) pkg ricotta cheese"
    },
    {
      "id": 451750,
      "primary_message": "When the pizzas are done, remove from the oven. Sprinkle with reserved basil and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 451751,
      "primary_message": "To serve, divide pizzas between plates and enjoy!",
      "secondary_message": null
    }
  ],
