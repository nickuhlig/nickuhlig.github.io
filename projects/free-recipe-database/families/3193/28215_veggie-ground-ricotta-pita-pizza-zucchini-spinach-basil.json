  "instructions": [
    {
      "id": 451680,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 451681,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 451682,
      "primary_message": "Trim and small dice zucchini.",
      "secondary_message": null
    },
    {
      "id": 451683,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 451684,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add zucchini, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until it is browned and crumbly and zucchini is tender, 6-7 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n2 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 451685,
      "primary_message": "Meanwhile, divide pitas between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 451686,
      "primary_message": "While the pitas are baking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 451687,
      "primary_message": "Add tomato sauce and half of the basil to the skillet with the veggie ground and zucchini, then stir to combine. (Reserve remaining basil for later use.) ",
      "secondary_message": "1 ½ (8 oz) cans tomato sauce"
    },
    {
      "id": 451688,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 451689,
      "primary_message": "Spread pitas with about ⅔ of the ricotta; top with veggie ground mixture, then dot with remaining ricotta. Return baking sheets to the oven and continue to bake until pizzas are warmed through, 6-7 minutes. ",
      "secondary_message": "1 ½ (15 oz) pkgs ricotta cheese"
    },
    {
      "id": 451690,
      "primary_message": "When the pizzas are done, remove from the oven. Sprinkle with reserved basil and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 451691,
      "primary_message": "To serve, divide pizzas between plates and enjoy!",
      "secondary_message": null
    }
  ],
