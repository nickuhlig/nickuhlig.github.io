  "instructions": [
    {
      "id": 451620,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 451621,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium zucchini squash\n½ small pkg fresh basil\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 451622,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 451623,
      "primary_message": "While the skillet heats up, trim and small dice zucchini.",
      "secondary_message": null
    },
    {
      "id": 451624,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add zucchini, turkey, and spices. Cook, breaking the meat apart with a spoon, until turkey is browned and crumbly and zucchini is tender, about 5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¾ lb ground turkey\n2 tsp Italian seasoning\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 451625,
      "primary_message": "Meanwhile, arrange pitas on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 451626,
      "primary_message": "While the pitas are baking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 451627,
      "primary_message": "Add tomato sauce and half of the basil to the skillet with the turkey and zucchini, then stir to combine. (Reserve remaining basil for later use.)",
      "secondary_message": "½ (8 oz) can tomato sauce"
    },
    {
      "id": 451628,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 451629,
      "primary_message": "Spread pitas with about ⅔ of the ricotta; top with turkey mixture, then dot with remaining ricotta. Return baking sheet to the oven and continue to bake until pizzas are warmed through, about 5 minutes.",
      "secondary_message": "½ (15 oz) pkg ricotta cheese"
    },
    {
      "id": 451630,
      "primary_message": "When the pizzas are done, remove from the oven. Sprinkle with reserved basil and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 451631,
      "primary_message": "To serve, divide pizzas between plates and enjoy!",
      "secondary_message": null
    }
  ],
