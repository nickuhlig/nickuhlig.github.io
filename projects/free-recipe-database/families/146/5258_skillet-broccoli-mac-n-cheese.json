  "instructions": [
    {
      "id": 63242,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 6-8 minutes. Drain.",
      "secondary_message": "about 21 cups water\n3 tbsp salt\n18 oz (4 ½ cups) macaroni (elbow) pasta"
    },
    {
      "id": 63241,
      "primary_message": "Wash broccoli and cut into bite-sized florets. Add to pot with pasta during the last 2-3 minutes of cooking time.",
      "secondary_message": "6 crowns broccoli"
    },
    {
      "id": 63240,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 63239,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 63238,
      "primary_message": "Melt butter in pan. Add garlic and cook until fragrant, 15-30 seconds. Add flour and whisk until smooth.",
      "secondary_message": "3 tbsp butter, unsalted\n3 tbsp all-purpose flour"
    },
    {
      "id": 63237,
      "primary_message": "Add milk, Dijon, salt, and pepper. Whisk until well combined. Cook until thickened, about 8 minutes.",
      "secondary_message": "24 fl oz (3 cups) whole milk\n3 tsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 63236,
      "primary_message": "Preheat oven to broil.",
      "secondary_message": ""
    },
    {
      "id": 63235,
      "primary_message": "Grate 3 cups of cheddar and ⅓ cup Parmesan.",
      "secondary_message": "1 ½ (8 oz) block cheddar cheese\n1 ½ oz Parmesan cheese"
    },
    {
      "id": 63234,
      "primary_message": "Add ¾ of the cheddar to pan and stir until sauce is smooth.",
      "secondary_message": ""
    },
    {
      "id": 63233,
      "primary_message": "Add pasta and broccoli to sauce and stir to combine. Sprinkle with remaining cheddar and Parmesan.",
      "secondary_message": ""
    },
    {
      "id": 63232,
      "primary_message": "Place under the broiler until cheese is melted and golden brown, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 63231,
      "primary_message": "To serve, place in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
