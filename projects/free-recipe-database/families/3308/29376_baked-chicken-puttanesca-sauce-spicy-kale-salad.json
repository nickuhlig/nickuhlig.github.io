  "instructions": [
    {
      "id": 468016,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 468017,
      "primary_message": "Pat chicken dry with paper towels. Transfer to a large baking sheet pan, drizzle with oil, and season with salt on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n2 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 468018,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken is golden and cooked through, 20-22 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 468019,
      "primary_message": "Meanwhile, peel and thinly slice garlic; mince the anchovy fillets. Place both in a large bowl.",
      "secondary_message": "6 cloves garlic\n9 anchovy fillets, packed in oil"
    },
    {
      "id": 468020,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 468021,
      "primary_message": "While the pot heats up, halve olives. Add to bowl with the garlic and anchovies along with capers and crushed red pepper.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n3 tbsp capers\n¾ tsp crushed red pepper"
    },
    {
      "id": 468022,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add olive mixture and cook, stirring frequently, until garlic is fragrant, 1-2 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 468023,
      "primary_message": "Add tomatoes and salt to the pot; cook, stirring occasionally, until simmering, 1-2 minutes. Once simmering, reduce heat to medium-low, and continue to cook, stirring occasionally, until slightly thickened, about 15 minutes. Remove from heat.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n¼ tsp salt"
    },
    {
      "id": 468024,
      "primary_message": "Meanwhile, place oil, vinegar, salt, and crushed red pepper in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 468025,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the dressing.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 468026,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 468027,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the puttanesca sauce and stir to combine. (Reserve remaining parsley for serving). ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 468028,
      "primary_message": "To serve, divide chicken and salad between plates. Top chicken with puttanesca sauce and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
