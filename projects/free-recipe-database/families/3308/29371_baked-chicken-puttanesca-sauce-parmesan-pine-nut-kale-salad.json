  "instructions": [
    {
      "id": 467948,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 467949,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 467950,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 467951,
      "primary_message": "Pat chicken dry with paper towels. Transfer to a baking sheet pan, drizzle with oil, and season with salt on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 467952,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken is golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 467953,
      "primary_message": "Meanwhile, peel and thinly slice garlic; mince the anchovy fillets. Place both in a medium bowl.",
      "secondary_message": "2 cloves garlic\n3 anchovy fillets, packed in oil"
    },
    {
      "id": 467954,
      "primary_message": "Halve olives. Add to bowl with the garlic and anchovies along with capers and crushed red pepper.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n1 tbsp capers\n¼ tsp crushed red pepper"
    },
    {
      "id": 467955,
      "primary_message": "Return skillet to medium heat. Once the skillet is hot, add oil and swirl to coat the bottom. Add olive mixture and cook, stirring frequently, until garlic is fragrant, about 1 minute. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 467956,
      "primary_message": "Add tomatoes and salt to the skillet; cook, stirring occasionally, until simmering, about 1 minute. Once simmering, reduce heat to medium-low, and continue to cook, stirring occasionally, until slightly thickened, 12-15 minutes more. Remove from heat.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n⅛ tsp salt"
    },
    {
      "id": 467957,
      "primary_message": "Meanwhile, place oil, vinegar, salt, and crushed red pepper in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 467958,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the dressing.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 467959,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl, along with cooled pine nuts, and toss to combine the salad. Set aside.",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 467960,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the puttanesca sauce and stir to combine. (Reserve remaining parsley for serving). ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 467961,
      "primary_message": "To serve, divide chicken and salad between plates. Top chicken with puttanesca sauce and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
