  "instructions": [
    {
      "id": 351131,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain eggs and transfer to a medium bowl; add ice or run under cold water to cool.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 351132,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small pkg chives\n2 red bell peppers\n2 heads butter (Boston) lettuce\n2 avocados"
    },
    {
      "id": 351133,
      "primary_message": "Peel and mince garlic; place in a large bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 351134,
      "primary_message": "Juice lemon into the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 351135,
      "primary_message": "Chop chives into small pieces; add to the bowl along with blue cheese, mayo, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese\n2 tbsp mayonnaise\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 351136,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 351137,
      "primary_message": "Chop or tear lettuce into bite-size pieces, add to the bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 351138,
      "primary_message": "Peel and roughly chop eggs. ",
      "secondary_message": null
    },
    {
      "id": 351139,
      "primary_message": "Roughly chop cashews. ",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 351140,
      "primary_message": "Just before serving, halve and pit avocados; scoop the flesh out with a spoon and medium dice. Add to the bowl with the lettuce and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 351141,
      "primary_message": "To serve, divide salad, eggs, and cashews between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
