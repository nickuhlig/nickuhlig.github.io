  "instructions": [
    {
      "id": 351106,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain eggs and transfer to a small bowl; add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 351107,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small pkg chives\n3 red bell peppers\n3 heads butter (Boston) lettuce\n1 ½ avocados"
    },
    {
      "id": 351108,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 351109,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 351110,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 351111,
      "primary_message": "While the steak cooks, peel and mince garlic; place in a large bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 351112,
      "primary_message": "Juice lemons into the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 351113,
      "primary_message": "Chop chives into small pieces; add to the bowl along with blue cheese, mayo, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese\n3 tbsp mayonnaise\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 351114,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 351115,
      "primary_message": "Chop or tear lettuce into bite-size pieces, add to the bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 351116,
      "primary_message": "Peel and roughly chop eggs.",
      "secondary_message": null
    },
    {
      "id": 351117,
      "primary_message": "Thinly slice steak against the grain. ",
      "secondary_message": null
    },
    {
      "id": 351118,
      "primary_message": "Just before serving, halve and pit avocados; scoop the flesh out with a spoon and medium dice. Add to the bowl with the lettuce and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 351119,
      "primary_message": "To serve, divide salad, steak, and eggs between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
