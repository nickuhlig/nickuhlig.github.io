  "instructions": [
    {
      "id": 351078,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain eggs and transfer to a small bowl; add ice or run under cold water to cool.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 351079,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small pkg chives\n1 red bell pepper\n1 head butter (Boston) lettuce\n½ avocado"
    },
    {
      "id": 351080,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 351081,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 351082,
      "primary_message": "Once the grill pan is hot, coat with oil; add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 351083,
      "primary_message": "While the steak cooks, peel and mince garlic; place in a medium bowl. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 351084,
      "primary_message": "Juice lemon into the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 351085,
      "primary_message": "Chop chives into small pieces; add to the bowl along with blue cheese, mayo, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "½ (4 oz) pkg crumbled blue cheese\n1 tbsp mayonnaise\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 351086,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 351087,
      "primary_message": "Chop or tear lettuce into bite-size pieces, add to the bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 351088,
      "primary_message": "Peel and roughly chop eggs.",
      "secondary_message": null
    },
    {
      "id": 351089,
      "primary_message": "Thinly slice steak against the grain. ",
      "secondary_message": null
    },
    {
      "id": 351090,
      "primary_message": "Just before serving, halve and pit avocado; scoop the flesh out with a spoon and medium dice. Add to the bowl with the lettuce and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 351091,
      "primary_message": "To serve, divide salad, steak, and eggs between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
