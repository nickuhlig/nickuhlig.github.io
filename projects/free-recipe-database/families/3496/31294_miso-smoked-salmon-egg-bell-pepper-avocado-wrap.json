  "instructions": [
    {
      "id": 494793,
      "primary_message": "Thinly slice egg. Place on a plate and season with pepper.",
      "secondary_message": "1 hard-cooked egg, peeled\n1 pinch black pepper"
    },
    {
      "id": 494794,
      "primary_message": "Wash, dry, trim, and seed bell pepper; slice lengthwise into thin strips. Add to the plate with the egg.",
      "secondary_message": "½ yellow bell pepper"
    },
    {
      "id": 494795,
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 494796,
      "primary_message": "Place tortilla on a flat surface and spread with miso paste. Layer with egg, bell pepper, avocado, and smoked salmon. Fold in sides of tortilla and roll tightly to close the wrap, then cut in half.",
      "secondary_message": "1 large flour tortilla\n2 tsp miso paste, white\n½ (4 oz) pkg smoked salmon"
    },
    {
      "id": 494797,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
