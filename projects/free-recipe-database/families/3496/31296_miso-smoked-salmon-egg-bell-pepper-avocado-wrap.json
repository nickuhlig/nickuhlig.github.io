  "instructions": [
    {
      "id": 494803,
      "primary_message": "Thinly slice eggs. Place on a plate and season with pepper.",
      "secondary_message": "3 hard-cooked eggs, peeled\n3 pinch black pepper"
    },
    {
      "id": 494804,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips. Add to the plate with the egg.",
      "secondary_message": "1 ½ yellow bell peppers"
    },
    {
      "id": 494805,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate.",
      "secondary_message": "3 avocados"
    },
    {
      "id": 494806,
      "primary_message": "Place tortillas on a flat surface and spread with miso paste. Layer with egg, bell pepper, avocado, and smoked salmon. Fold in sides of tortillas and roll tightly to close the wraps, then cut each in half.",
      "secondary_message": "3 large flour tortillas\n2 tbsp miso paste, white\n1 ½ (4 oz) pkgs smoked salmon"
    },
    {
      "id": 494807,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
