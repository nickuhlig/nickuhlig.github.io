  "instructions": [
    {
      "id": 429199,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 429200,
      "primary_message": "Place oil, maple syrup, Dijon, salt, and pepper in a baking dish; whisk to combine the marinade.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 429201,
      "primary_message": "Pat chicken dry with paper towels, add to the baking dish with the marinade, and turn to coat. ",
      "secondary_message": "0.57 kg chicken drumsticks"
    },
    {
      "id": 429202,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until chicken is cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 429203,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ bunch kale\n½ medium head napa cabbage\n½ small bunch fresh dill"
    },
    {
      "id": 429204,
      "primary_message": "Zest and juice lemon into a medium bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 429205,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 429206,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise. Add to the bowl. Using your hands, massage the greens with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 429207,
      "primary_message": "Shave the dill leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 429208,
      "primary_message": "To serve, divide chicken and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
