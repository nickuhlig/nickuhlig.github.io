  "instructions": [
    {
      "id": 429219,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 429220,
      "primary_message": "Divide oil, maple syrup, Dijon, salt, and pepper between two baking dishes; whisk to combine the marinade.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp pure maple syrup\n2 tbsp Dijon mustard\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 429221,
      "primary_message": "Pat chicken dry with paper towels, add to the dishes with the marinade, and turn to coat. ",
      "secondary_message": "1.7 kg chicken drumsticks"
    },
    {
      "id": 429222,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until chicken is cooked through, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 429223,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 ½ bunches kale\n1 ½ medium heads napa cabbage\n1 small bunch fresh dill"
    },
    {
      "id": 429224,
      "primary_message": "Zest and juice lemons into a large bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 429225,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 429226,
      "primary_message": "Trim off and discard the root end of the cabbages; halve the cabbages lengthwise, then thinly slice crosswise. Add to the bowl. Using your hands, massage the greens with the dressing until wilted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 429227,
      "primary_message": "Shave the dill leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 429228,
      "primary_message": "To serve, divide chicken and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
