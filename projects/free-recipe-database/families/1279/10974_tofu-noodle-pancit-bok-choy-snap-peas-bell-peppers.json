  "instructions": [
    {
      "id": 180784,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse pasta in a colander and set aside. ",
      "secondary_message": "425 g spaghetti pasta"
    },
    {
      "id": 180785,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 180786,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "9 baby bok choy\n3 red bell peppers\n1 ½ (227 g) pkg sugar snap peas\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 180787,
      "primary_message": "Trim bok choy ends, cut in half lengthwise, and cut into bite-sized pieces. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 180788,
      "primary_message": "Trim, seed, and cut bell peppers into thin strips. Add to the bowl with the bok choy. ",
      "secondary_message": null
    },
    {
      "id": 180789,
      "primary_message": "Cut the peas crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 180790,
      "primary_message": "Cut tofu into bite-sized cubes and season with salt.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 180791,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 180792,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu in a single layer and stir-fry until browned on all sides, 5-6 minutes. Transfer to a plate. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 180793,
      "primary_message": "Meanwhile, peel and mince shallots and garlic. ",
      "secondary_message": "3 shallots\n12 cloves garlic"
    },
    {
      "id": 180794,
      "primary_message": "Peel and mince or grate ginger.",
      "secondary_message": null
    },
    {
      "id": 180795,
      "primary_message": "Return the large pot used for the pasta, to medium-high heat. Add oil and swirl to coat the bottom. Add shallot, garlic, and ginger; cook until fragrant, 15-30 seconds. Add broth, soy sauce, vinegar, and sugar; bring to a simmer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n177 ml chicken or vegetable broth\n½ cup soy sauce\n¼ cup rice vinegar\n3 tbsp brown sugar"
    },
    {
      "id": 180796,
      "primary_message": "Add bok choy, bell pepper, and snap peas. Cook, stirring frequently, until the vegetables are tender, 6-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 180797,
      "primary_message": "Return tofu to the pot with the veggies and add pasta. Toss gently to coat.",
      "secondary_message": null
    },
    {
      "id": 180798,
      "primary_message": "To serve, divide pancit between bowls or plates and enjoy!",
      "secondary_message": null
    }
  ],
