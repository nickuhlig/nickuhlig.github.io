  "instructions": [
    {
      "id": 180552,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse pasta in a colander and set aside. ",
      "secondary_message": "10 oz spaghetti pasta"
    },
    {
      "id": 180553,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 baby bok choy\n2 red bell peppers\n1 (8 oz) pkg sugar snap peas\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 180554,
      "primary_message": "Trim bok choy ends, cut in half lengthwise, and cut into bite-sized pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 180555,
      "primary_message": "Trim, seed, and cut bell peppers into thin strips. Add to the bowl with the bok choy. ",
      "secondary_message": null
    },
    {
      "id": 180556,
      "primary_message": "Cut the peas crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 180557,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 180558,
      "primary_message": "Pat the pork chops dry with paper towels, cut into bite-sized pieces, and season with salt.",
      "secondary_message": "4 pork chops, boneless\n½ tsp salt"
    },
    {
      "id": 180559,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and stir-fry until browned and cooked through, 5-6 minutes. Transfer to a clean plate. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 180560,
      "primary_message": "Meanwhile, peel and mince the shallots and garlic. ",
      "secondary_message": "2 shallots\n8 cloves garlic"
    },
    {
      "id": 180561,
      "primary_message": "Peel and mince or grate the ginger.",
      "secondary_message": null
    },
    {
      "id": 180562,
      "primary_message": "Return the skillet (with leftover oil from cooking) to medium-high heat. Add shallot, garlic, and ginger to the skillet; cook until fragrant, 15-30 seconds. Add broth, soy sauce, fish sauce, and sugar; bring to a simmer.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n⅓ cup soy sauce\n2 tbsp fish sauce\n4 tsp brown sugar"
    },
    {
      "id": 180563,
      "primary_message": "Add bok choy, bell pepper, and snap peas. Cook, stirring frequently, until the vegetables are tender, 5-6 minutes. ",
      "secondary_message": null
    },
    {
      "id": 180564,
      "primary_message": "Return pork to the skillet and add pasta. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 180565,
      "primary_message": "To serve, divide pancit between bowls or plates and enjoy!",
      "secondary_message": null
    }
  ],
