  "instructions": [
    {
      "id": 180740,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse pasta in a colander and set aside. ",
      "secondary_message": "425 g spaghetti pasta"
    },
    {
      "id": 180741,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "9 baby bok choy\n3 red bell peppers\n1 ½ (227 g) pkg sugar snap peas\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 180742,
      "primary_message": "Trim bok choy ends, cut in half lengthwise, and cut into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 180743,
      "primary_message": "Trim, seed, and cut bell peppers into thin strips. Add to the bowl with the bok choy. ",
      "secondary_message": null
    },
    {
      "id": 180744,
      "primary_message": "Cut the peas crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 180745,
      "primary_message": "Pat the pork chops dry with paper towels, cut into bite-sized pieces, and season with salt.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt"
    },
    {
      "id": 180746,
      "primary_message": "Preheat another large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 180747,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork and stir-fry until browned and cooked through, 6-7 minutes. Transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 180748,
      "primary_message": "Meanwhile, peel and mince the shallots and garlic. ",
      "secondary_message": "3 shallots\n12 cloves garlic"
    },
    {
      "id": 180749,
      "primary_message": "Peel and mince or grate the ginger.",
      "secondary_message": null
    },
    {
      "id": 180750,
      "primary_message": "Return the pot used for the pork (with leftover oil from cooking) to medium-high heat. Add shallot, garlic, and ginger to the pot; cook until fragrant, 15-30 seconds. Add broth, soy sauce, fish sauce, and sugar; bring to a simmer.",
      "secondary_message": "177 ml chicken or vegetable broth\n½ cup soy sauce\n3 tbsp fish sauce\n2 tbsp brown sugar"
    },
    {
      "id": 180751,
      "primary_message": "Add bok choy, bell pepper, and snap peas. Cook, stirring frequently, until the vegetables are tender, 6-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 180752,
      "primary_message": "Return pork to the pot with the veggies and add pasta. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 180753,
      "primary_message": "To serve, divide pancit between bowls or plates and enjoy!",
      "secondary_message": null
    }
  ],
