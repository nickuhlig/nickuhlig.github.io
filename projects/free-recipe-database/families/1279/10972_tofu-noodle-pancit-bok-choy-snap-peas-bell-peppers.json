  "instructions": [
    {
      "id": 180754,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse pasta in a colander and set aside. ",
      "secondary_message": "142 g spaghetti pasta"
    },
    {
      "id": 180755,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 180756,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 baby bok choy\n1 red bell pepper\n½ (227 g) pkg sugar snap peas\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 180757,
      "primary_message": "Trim bok choy ends, cut in half lengthwise, and cut into bite-sized pieces. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 180758,
      "primary_message": "Trim, seed, and cut bell pepper into thin strips. Add to the bowl with the bok choy. ",
      "secondary_message": null
    },
    {
      "id": 180759,
      "primary_message": "Cut the peas crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 180760,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 180761,
      "primary_message": "Cut tofu into bite-sized cubes and season with salt.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 180762,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and stir-fry until browned on all sides, 4-5 minutes. Transfer to a plate. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 180763,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. ",
      "secondary_message": "1 shallot\n4 cloves garlic"
    },
    {
      "id": 180764,
      "primary_message": "Peel and mince or grate ginger.",
      "secondary_message": null
    },
    {
      "id": 180765,
      "primary_message": "Return the skillet to medium-high heat. Add more oil, shallot, garlic, and ginger; cook until fragrant, 15-30 seconds. Add broth, soy sauce, vinegar, and sugar; bring to a simmer.",
      "secondary_message": "2 tsp extra virgin olive oil\n59 ml (¼ cup) chicken or vegetable broth\n3 tbsp soy sauce\n1 ½ tbsp rice vinegar\n1 tbsp brown sugar"
    },
    {
      "id": 180766,
      "primary_message": "Add bok choy, bell pepper, and snap peas. Cook, stirring frequently, until the vegetables are tender, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 180767,
      "primary_message": "Return tofu to the skillet and add pasta. Toss gently to coat.",
      "secondary_message": null
    },
    {
      "id": 180768,
      "primary_message": "To serve, divide pancit between bowls or plates and enjoy!",
      "secondary_message": null
    }
  ],
