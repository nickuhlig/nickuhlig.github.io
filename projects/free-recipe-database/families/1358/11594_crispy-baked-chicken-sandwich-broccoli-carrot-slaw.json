  "instructions": [
    {
      "id": 195949,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 195950,
      "primary_message": "Whisk together mayo and spices in a large bowl.",
      "secondary_message": "1 tbsp mayonnaise\n½ tsp paprika\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 195951,
      "primary_message": "Pat the chicken dry with paper towels. Slice crosswise into ¾-inch strips and add to the bowl with the mayo; toss to coat.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 195952,
      "primary_message": "Add bread crumbs and parsley flakes to the bowl with the chicken and toss well to coat. Arrange chicken on a large baking sheet pan and drizzle with oil. Place in the oven and bake, turning once, until golden brown and cooked through, 12-15 minutes.",
      "secondary_message": "1 cup panko bread crumbs\n1 tsp parsley flakes\n2 tsp extra virgin olive oil"
    },
    {
      "id": 195953,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n2 medium carrots\n1 tomato"
    },
    {
      "id": 195954,
      "primary_message": "Place mayo, vinegar, Dijon, maple syrup, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "½ cup mayonnaise\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n4 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 195955,
      "primary_message": "Using a clean cutting board, trim green onions and cut crosswise into ¼-inch pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 195956,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 195957,
      "primary_message": "Add broccoli slaw to the bowl and toss to combine. Set aside.",
      "secondary_message": "1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 195958,
      "primary_message": "Slice tomato into ½-inch thick rounds. ",
      "secondary_message": null
    },
    {
      "id": 195959,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 195960,
      "primary_message": "To serve, place the bottom half of a roll on each plate. Layer with slaw, chicken strips, and tomato; close with the top half of the roll and enjoy!",
      "secondary_message": null
    }
  ],
