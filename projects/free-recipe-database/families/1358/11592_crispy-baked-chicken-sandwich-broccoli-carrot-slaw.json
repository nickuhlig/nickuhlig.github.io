  "instructions": [
    {
      "id": 195925,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 195926,
      "primary_message": "Whisk together mayo and spices in a large bowl.",
      "secondary_message": "1 ½ tbsp mayonnaise\n¾ tsp paprika\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 195927,
      "primary_message": "Pat the chicken dry with paper towels. Slice crosswise into ¾-inch strips and add to the bowl with the mayo; toss to coat.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 195928,
      "primary_message": "Add bread crumbs and parsley flakes to the bowl with the chicken and toss well to coat. Arrange chicken on a large baking sheet pan and drizzle with oil. Place in the oven and bake, turning once, until golden brown and cooked through, about 15 minutes.",
      "secondary_message": "1 ½ cup panko bread crumbs\n1 ½ tsp parsley flakes\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 195929,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 medium carrots\n1 ½ tomatoes"
    },
    {
      "id": 195930,
      "primary_message": "Place mayo, vinegar, maple syrup, Dijon, salt, and pepper in another large bowl. Whisk to combine the dressing.",
      "secondary_message": "¾ cup mayonnaise\n3 tbsp apple cider vinegar\n2 tbsp pure maple syrup\n1 ½ tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 195931,
      "primary_message": "Using a clean cutting board, trim green onions and cut crosswise into ¼-inch pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 195932,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 195933,
      "primary_message": "Add broccoli slaw to the bowl and toss to combine. Set aside.",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 195934,
      "primary_message": "Slice tomatoes into ½-inch thick rounds. ",
      "secondary_message": null
    },
    {
      "id": 195935,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 195936,
      "primary_message": "To serve, place the bottom half of a roll on each plate. Layer with slaw, chicken strips, and tomato; close with the top half of the roll and enjoy!",
      "secondary_message": null
    }
  ],
