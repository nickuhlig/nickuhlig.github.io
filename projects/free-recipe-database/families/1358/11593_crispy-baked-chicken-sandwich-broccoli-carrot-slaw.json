  "instructions": [
    {
      "id": 195937,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 195938,
      "primary_message": "Whisk together mayo and spices in a medium bowl.",
      "secondary_message": "1 ½ tsp mayonnaise\n¼ tsp paprika\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 195939,
      "primary_message": "Pat the chicken dry with paper towels. Slice crosswise into ¾-inch strips and add to the bowl with the mayo; toss to coat.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 195940,
      "primary_message": "Add bread crumbs and parsley flakes to the bowl with the chicken and toss well to coat. Arrange chicken on a baking sheet pan and drizzle with oil. Place in the oven and bake, turning once, until golden brown and cooked through, 12-15 minutes.",
      "secondary_message": "½ cup panko bread crumbs\n½ tsp parsley flakes\n1 tsp extra virgin olive oil"
    },
    {
      "id": 195941,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 medium carrot\n½ tomato"
    },
    {
      "id": 195942,
      "primary_message": "Place mayo, vinegar, maple syrup, Dijon, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n1 tbsp apple cider vinegar\n2 tsp pure maple syrup\n1 ½ tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 195943,
      "primary_message": "Using a clean cutting board, trim green onions and cut crosswise into ¼-inch pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 195944,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 195945,
      "primary_message": "Add broccoli slaw to the bowl and toss to combine. Set aside.",
      "secondary_message": "½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 195946,
      "primary_message": "Slice tomato into ½-inch thick rounds. ",
      "secondary_message": null
    },
    {
      "id": 195947,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 195948,
      "primary_message": "To serve, place the bottom half of a roll on each plate. Layer with slaw, chicken strips, and tomato; close with the top half of the roll and enjoy!",
      "secondary_message": null
    }
  ],
