  "instructions": [
    {
      "id": 433461,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 433462,
      "primary_message": "While the pot heats up, wash, dry, and pick sage leaves off the stems; discard stems.",
      "secondary_message": "1 small pkg fresh sage"
    },
    {
      "id": 433463,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sage leaves in single layer and cook until crispy, about 30 seconds. Using tongs or a slotted spoon, transfer crispy sage to a paper towel-lined plate and season with salt. (Reserve pot with oil for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 433464,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 433465,
      "primary_message": "Return pot to medium-high heat. Once the pot is hot, working in batches if necessary, add chicken and pan-fry, without turning, until golden underneath, 5-6 minutes (the chicken will not be cooked all the way through). Remove to a plate. (Reserve pot with sage oil for later use.)",
      "secondary_message": null
    },
    {
      "id": 433466,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 433467,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 433468,
      "primary_message": "Return pot with sage oil to medium heat, add more oil, and swirl to coat the bottom. Add garlic and tomato paste; cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp tomato paste"
    },
    {
      "id": 433469,
      "primary_message": "Add Parmesan, pumpkin, broth, cream, and salt to the pot, then stir to combine. Cook, stirring occasionally, until sauce thickens slightly, 3-4 minutes.",
      "secondary_message": "1 ½ (398 ml) cans pure pumpkin purée\n355 ml chicken or vegetable broth\n355 ml heavy whipping cream\n¾ tsp salt"
    },
    {
      "id": 433470,
      "primary_message": "Wash, dry, and add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": "3 (142 g) pkgs baby spinach"
    },
    {
      "id": 433471,
      "primary_message": "Return chicken to the pot and nestle into the sauce; cover with a lid. Cook, turning chicken occasionally, until cooked through, 7-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 433472,
      "primary_message": "To serve, divide chicken and sauce between plates or bowls. Top with crispy sage and enjoy!",
      "secondary_message": null
    }
  ],
