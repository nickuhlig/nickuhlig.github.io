  "instructions": [
    {
      "id": 414475,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 414476,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 414477,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 414478,
      "primary_message": "Place water in a large skillet and bring to a simmer over medium-high heat.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 414479,
      "primary_message": "Once the water is simmering, add spinach in handfuls, waiting for it to wilt slightly before adding next handful. Cook, stirring frequently, until wilted, about 1 minute. Using tongs, transfer spinach to the colander, rinse with cold water, and set aside to drain (reserve skillet for later use).",
      "secondary_message": null
    },
    {
      "id": 414480,
      "primary_message": "Place vinegar, honey, soy sauce, and salt in a medium bowl. Whisk to combine the marinade.",
      "secondary_message": "2 tbsp rice vinegar\n1 tbsp honey\n1 ½ tsp soy sauce\n¼ tsp salt"
    },
    {
      "id": 414481,
      "primary_message": "Wash, dry, trim, and slice cucumber crosswise into very thin rounds. Add to the bowl with the marinade; using your hands, gently massage cucumber with the marinade until wilted, about 1 minute. Set aside. ",
      "secondary_message": "1 English cucumber"
    },
    {
      "id": 414482,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 414483,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate. Season with salt on the top-side.",
      "secondary_message": "0.68 kg salmon fillet\n¼ tsp salt"
    },
    {
      "id": 414484,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon, skin-side down, and cook until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate and set aside. ",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 414485,
      "primary_message": "Meanwhile, place tahini, sesame seeds, soy sauce, water, and honey in a small bowl. Whisk to combine the sesame dressing.",
      "secondary_message": "¼ cup tahini\n¼ cup sesame seeds\n2 tbsp soy sauce\n2 tbsp water\n4 tsp honey"
    },
    {
      "id": 414486,
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can. Place in another medium bowl, add half of the sesame dressing, and toss to coat. (Reserve remaining dressing for serving.) ",
      "secondary_message": null
    },
    {
      "id": 414487,
      "primary_message": "Divide rice between bowls; top with salmon, spinach, and cucumbers. Serve with remaining dressing for drizzling over the salmon. Enjoy!",
      "secondary_message": null
    }
  ],
