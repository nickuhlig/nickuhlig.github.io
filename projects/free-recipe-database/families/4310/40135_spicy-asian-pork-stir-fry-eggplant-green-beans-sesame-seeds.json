  "instructions": [
    {
      "id": 622268,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622269,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n1 lb green beans\n1 small bunch green onions (scallions)\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 622270,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Transfer to a plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp toasted sesame oil\n1 ½ lb lean ground pork\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 622271,
      "primary_message": "Meanwhile, trim and small dice eggplants. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 622272,
      "primary_message": "Trim and halve green beans crosswise. Add to the bowl with the eggplant.",
      "secondary_message": null
    },
    {
      "id": 622273,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622274,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 622275,
      "primary_message": "Return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until browned and softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 622276,
      "primary_message": "Meanwhile, place soy sauce, vinegar, chili-garlic sauce, and additional oil in the reserved bowl. Whisk to combine the stir-fry sauce.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp rice vinegar\n2 tsp chili-garlic sauce\n2 tsp toasted sesame oil"
    },
    {
      "id": 622277,
      "primary_message": "When the veggies are done, return pork to the skillet, along with sauce, and stir to combine. Continue to cook, stirring occasionally, until pork and veggies are coated in sauce, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 622278,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Top with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
