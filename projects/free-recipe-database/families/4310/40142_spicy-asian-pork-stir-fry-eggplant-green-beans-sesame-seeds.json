  "instructions": [
    {
      "id": 622345,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622346,
      "primary_message": "While the pot heats up, wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n0.68 kg green beans\n1 small bunch green onions (scallions)\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 622347,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Transfer to a plate. (Reserve pot with drippings for later use.)",
      "secondary_message": "1 tbsp toasted sesame oil\n1.02 kg lean ground pork\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 622348,
      "primary_message": "Meanwhile, trim and small dice eggplants. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 622349,
      "primary_message": "Trim and halve green beans crosswise. Add to the bowl with the eggplant.",
      "secondary_message": null
    },
    {
      "id": 622350,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622351,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 622352,
      "primary_message": "Return pot (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until browned and softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 622353,
      "primary_message": "Meanwhile, place soy sauce, vinegar, chili-garlic sauce, and additional oil in the reserved bowl. Whisk to combine the stir-fry sauce.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp rice vinegar\n1 tbsp chili-garlic sauce\n1 tbsp toasted sesame oil"
    },
    {
      "id": 622354,
      "primary_message": "When the veggies are done, return pork to the pot, along with sauce, and stir to combine. Continue to cook, stirring occasionally, until pork and veggies are coated in sauce, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 622355,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Top with sesame seeds and enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
