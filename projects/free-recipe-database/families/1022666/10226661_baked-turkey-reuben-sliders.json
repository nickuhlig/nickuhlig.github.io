  "instructions": [
    {
      "primary_message": "Preheat oven to 350-degrees. Cut rolls in half widthwise with a serrated knife. Place the bottom half of the rolls as a group on a baking sheet.",
      "secondary_message": null
    },
    {
      "primary_message": "Spread Thousand Island dressing on the bottom half of the rolls, about 1 1/2 teaspoon each, and top with pastrami (about 1 ounce each). Place cheese slices on top of the pastrami (cut the cheese to fit the rolls if needed). Cut the pickle slices in half if needed, then place them on top of the cheese.",
      "secondary_message": null
    },
    {
      "primary_message": "Add the top of the rolls to the sandwiches and brush olive oil over the top. Sprinkle with everything bagel seasoning. Cover with foil and bake until cheese is soft, and the roll tops are nicely brown (about 20 minutes). Serve hot!",
      "secondary_message": null
    }
  ],
