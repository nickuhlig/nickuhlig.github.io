  "instructions": [
    {
      "id": 1,
      "primary_message": "Place star anise pod in a small skillet over medium heat and toast, stirring and flipping frequently, until fragrant, about 1 minute. Transfer to a plate and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add apple brandy, Barolo Chinato, lemon juice, strong Demerara syrup, and orange bitters to a cocktail shaker and fill 2/3 full with ice. Shake until well chilled, about 15 seconds. Fine-strain into a cocktail coupe. Garnish with toasted star anise pod.",
      "secondary_message": null
    }
