  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 (2-compartment) food storage containers as well as 4 mini containers and 4 sandwich bags.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide rice cakes between sandwich bags (two per bag). Seal bags and store at room temperature.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide cream cheese between mini containers, cover with lids, and refrigerate.\n\n",
      "secondary_message": "1 (8 oz) block cream cheese"
    },
    {
      "primary_message": "Wash, dry, trim, and slice cucumber crosswise into very thin rounds. Peel, halve, and slice onion crosswise into thin pieces.\n\n",
      "secondary_message": "½ English cucumber\n¼ medium red onion"
    },
    {
      "primary_message": "Divide cucumber, onion, capers, and salmon between food storage containers. Cover and refrigerate.\n\n",
      "secondary_message": "1 tbsp capers\n1 (4 oz) pkg smoked salmon"
    },
    {
      "primary_message": "When ready to eat, spread cream cheese over rice cakes, then top with cucumber, onion, salmon, and capers. Enjoy!",
      "secondary_message": null
    }
  ],
