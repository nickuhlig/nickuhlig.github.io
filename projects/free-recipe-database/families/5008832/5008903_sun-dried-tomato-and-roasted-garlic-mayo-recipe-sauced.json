  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 350 degrees. Cut off top 1/3 of garlic, exposing tops of each clove. Place garlic, cut side down, on sheet of aluminum foil and drizzle with olive oil. Crimp foil closed and place garlic in oven and roast until completely soft, about 45 minutes. Remove from oven and let stand until cool enough to handle.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While the garlic is roasting, place sun-dried tomatoes in a small bowl and pour in boiling water. Let stand for 10 minutes, then drain and pat tomatoes with paper towels.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place mayonnaise, tomatoes, and cayenne pepper in the jar of a blender. Squeeze out bulbs of cooled garlic into blender jar with other ingredients. Blend until almost smooth, stopping to scrap down sides of jar as necessary. Store in airtight container in refrigerator.",
      "secondary_message": null
    }
  ],
