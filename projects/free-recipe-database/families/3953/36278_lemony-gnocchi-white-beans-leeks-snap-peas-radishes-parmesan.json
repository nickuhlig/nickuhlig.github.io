  "instructions": [
    {
      "id": 569649,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 569650,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 leeks\n1 bunch radish\n1 (227 g) pkg sugar snap peas\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 569651,
      "primary_message": "Once the water in the pan is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside. (Reserve a ¼-cup gnocchi water before draining.)",
      "secondary_message": "2 (454 g) pkgs potato gnocchi\n1 tsp salt"
    },
    {
      "id": 569652,
      "primary_message": "While the gnocchi are cooking, trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 569653,
      "primary_message": "Trim and quarter radishes. Add to the bowl with the leeks.",
      "secondary_message": null
    },
    {
      "id": 569654,
      "primary_message": "Cut snap peas crosswise into ½-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 569655,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 569656,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 569657,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 569658,
      "primary_message": "While the skillet heats up, drain and rinse beans.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 569659,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, garlic, beans, salt, and pepper; cook, stirring occasionally, until veggies are softened, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 569660,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 569661,
      "primary_message": "When the veggies are done, zest and juice lemon into the skillet, then add drained gnocchi and stir to combine. Add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Continue to cook until gnocchi is warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 569662,
      "primary_message": "To serve, divide gnocchi, beans, and veggies between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
