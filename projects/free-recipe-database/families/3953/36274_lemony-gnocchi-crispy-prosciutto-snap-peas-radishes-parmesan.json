  "instructions": [
    {
      "id": 569590,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 569591,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n½ bunch radish\n½ (227 g) pkg sugar snap peas\n½ small bunch Italian (flat-leaf) parsley\n½ lemon"
    },
    {
      "id": 569592,
      "primary_message": "Once the water in the pan is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside. (Reserve a ¼-cup gnocchi water before draining.)",
      "secondary_message": "1 (454 g) pkg potato gnocchi\n½ tsp salt"
    },
    {
      "id": 569593,
      "primary_message": "While the gnocchi are cooking, trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 569594,
      "primary_message": "Trim and quarter radishes. Add to the bowl with the leeks.",
      "secondary_message": null
    },
    {
      "id": 569595,
      "primary_message": "Cut snap peas crosswise into ½-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 569596,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 569597,
      "primary_message": "Peel and mince garlic. Add to the bowl and set aside.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 569598,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 569599,
      "primary_message": "While the skillet heats up, cut or tear prosciutto into bite-sized pieces.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 569600,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add prosciutto and cook, stirring occasionally, until crispy, 2-3 minutes. Using a slotted spoon, transfer prosciutto to a paper towel-lined plate and set aside. (Reserve skillet with drippings for the next step.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 569601,
      "primary_message": "Return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add veggies, garlic, salt, and pepper; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 569602,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 569603,
      "primary_message": "When the veggies are done, zest and juice lemon into the skillet, then add drained gnocchi and stir to combine. Add reserved gnocchi water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Continue to cook until gnocchi is warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 569604,
      "primary_message": "To serve, divide gnocchi and veggies between plates or bowls. Top with Parmesan and crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
