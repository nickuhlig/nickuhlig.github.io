  "instructions": [
    {
      "id": 569533,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 569534,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 leeks\n1 ½ bunches radish\n1 ½ (8 oz) pkgs sugar snap peas\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 569535,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside. (Reserve a ½-cup gnocchi water before draining.)",
      "secondary_message": "3 (16 oz) pkgs potato gnocchi\n1 ½ tsp salt"
    },
    {
      "id": 569536,
      "primary_message": "While the gnocchi are cooking, trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 569537,
      "primary_message": "Trim and quarter radishes. Add to the bowl with the leeks.",
      "secondary_message": null
    },
    {
      "id": 569538,
      "primary_message": "Cut snap peas crosswise into ½-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 569539,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 569540,
      "primary_message": "Peel and mince garlic. Add to the bowl and set aside.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 569541,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 569542,
      "primary_message": "While the pot heats up, cut or tear prosciutto into bite-sized pieces.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 569543,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add prosciutto and cook, stirring occasionally, until crispy, 3-4 minutes. Using a slotted spoon, transfer prosciutto to a paper towel-lined plate and set aside. (Reserve pot with drippings for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 569544,
      "primary_message": "Return pot (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add veggies, garlic, salt, and pepper; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 569545,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 569546,
      "primary_message": "When the veggies are done, zest and juice lemons into the pot, then add drained gnocchi and stir to combine. Add reserved gnocchi water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Continue to cook until gnocchi is warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 569547,
      "primary_message": "To serve, divide gnocchi and veggies between plates or bowls. Top with Parmesan and crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
