  "instructions": [
    {
      "id": 569663,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 569664,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 leeks\n1 ½ bunches radish\n1 ½ (227 g) pkgs sugar snap peas\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 569665,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside. (Reserve a ¾-cup gnocchi water before draining.)",
      "secondary_message": "3 (454 g) pkgs potato gnocchi\n1 ½ tsp salt"
    },
    {
      "id": 569666,
      "primary_message": "While the gnocchi are cooking, trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 569667,
      "primary_message": "Trim and quarter radishes. Add to the bowl with the leeks.",
      "secondary_message": null
    },
    {
      "id": 569668,
      "primary_message": "Cut snap peas crosswise into ½-inch pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 569669,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 569670,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 569671,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 569672,
      "primary_message": "While the pot heats up, drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 569673,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, beans, salt, and pepper; cook, stirring occasionally, until veggies are softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 569674,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 569675,
      "primary_message": "When the veggies are done, zest and juice lemon into the skillet, then add drained gnocchi and stir to combine. Add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Continue to cook until gnocchi is warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 569676,
      "primary_message": "To serve, divide gnocchi, beans, and veggies between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
