  "instructions": [
    {
      "id": 264879,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 264880,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 crowns broccoli\n1 ½ lemons\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 264881,
      "primary_message": "Working in batches if necessary, arrange flatbreads on a large baking sheet pan. Place in the oven and broil, flipping once, until golden and slightly crispy, 1-2 minutes per side. Remove from oven and set aside.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 264882,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces; transfer to another large baking sheet. Drizzle with oil, season with salt and pepper, and toss to coat; spread out in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 264883,
      "primary_message": "When the flatbreads are done, place broccoli in the oven and broil, tossing halfway through, until crisp-tender and lightly charred around the edges, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 264884,
      "primary_message": "While the broccoli is cooking, place honey, vinegar, crushed red pepper, and salt in a small bowl; whisk to combine the chili honey and set aside.",
      "secondary_message": "3 tbsp honey\n1 ½ tsp white wine vinegar\n¾ tsp crushed red pepper\n3 pinch salt"
    },
    {
      "id": 264885,
      "primary_message": "Zest lemons into a medium bowl (set lemons aside for later use).",
      "secondary_message": null
    },
    {
      "id": 264886,
      "primary_message": "Add ricotta, salt, and pepper to the bowl with the lemon zest; stir to combine the lemony ricotta. Set aside.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 264887,
      "primary_message": "Juice lemons into a large bowl; add oil, Dijon, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 264888,
      "primary_message": "Spread lemony ricotta over each flatbread, then top with the charred broccoli. Slice flatbreads into wedges.",
      "secondary_message": null
    },
    {
      "id": 264889,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 264890,
      "primary_message": "Divide flatbreads between plates and drizzle with chili honey. Serve with mixed greens on the side and enjoy!",
      "secondary_message": null
    }
  ],
