  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim the stems of the fresh green beans.",
      "secondary_message": "1 lb fresh green beans"
    },
    {
      "id": 1,
      "primary_message": "Preheat broiler and set top rack 4 to 6 inches from broiler element. Add green beans and garlic to a large stainless steel skillet and season with salt. Broil green beans and garlic until green beans become blistered with small brown spots, 5 to 7 minutes. (As with all broiling recipes and broiling steps in this recipe, watch carefully, as broilers vary greatly in their heat output.)",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, season salmon fillets all over with salt. Stir together mayonnaise and 1 teaspoon dill and spread dill mayo evenly on top of salmon fillets.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add vinegar, water, and cayenne to the beans and toss to mix well. Set salmon, mayonnaise side up, on top of green beans; make sure it’s not touching the bottom of the pan, nor fully submerged in the liquid. Broil until mayonnaise is beginning to brown and salmon registers 110°F in the very center for rare, 120°F for medium-rare, or 130°F for medium, 5 to 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To serve, remove salmon with a spatula and set aside briefly. Pour green beans and liquid into a shallow serving bowl. Mix in remaining 1/4 cup dill, then place salmon back on top of green beans, mayonnaise side up. Serve.",
      "secondary_message": null
    }
  ],
