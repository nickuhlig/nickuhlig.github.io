  "instructions": [
    {
      "primary_message": "Place chicken and mayo in a small bowl. Stir to combine the chicken salad, then season with salt and pepper to taste (if desired).",
      "secondary_message": "227 g cooked chicken (shredded)\n⅓ cup sriracha mayonnaise\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "primary_message": "Wash and dry the spinach (skip if it came pre-washed). Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and thinly slice. ",
      "secondary_message": "¼ (142 g) pkg baby spinach\n1 avocado"
    },
    {
      "primary_message": "Layer the bottom half of each bun with spinach, chicken salad, and avocado. Close sandwiches with remaining top of each bun.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
