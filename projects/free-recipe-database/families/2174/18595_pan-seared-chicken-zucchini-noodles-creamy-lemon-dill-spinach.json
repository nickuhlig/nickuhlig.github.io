  "instructions": [
    {
      "id": 324230,
      "primary_message": "Preheat oven to 400°F. ",
      "secondary_message": null
    },
    {
      "id": 324231,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "9 medium zucchini squash\n1 ½ (5 oz) pkgs baby spinach\n1 small bunch fresh dill\n1 ½ lemons"
    },
    {
      "id": 324232,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; divide between two baking sheet pans and spread out in an even layer. Cut butter into small pieces and sprinkle over top; season with salt.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt"
    },
    {
      "id": 324233,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and roast, tossing halfway through, until zucchini is tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 324234,
      "primary_message": "Meanwhile, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 324235,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 324236,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove chicken to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 324237,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop spinach; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 324238,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 324239,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 324240,
      "primary_message": "Return skillet to medium heat, add more butter, and swirl to coat the bottom; add garlic and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 324241,
      "primary_message": "Add broth and cream to the skillet; stir to combine the sauce and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until thickened, 7-8 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 324242,
      "primary_message": "Once the sauce has thickened, add spinach and dill in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Juice lemons into the skillet and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 324243,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 324244,
      "primary_message": "To serve, divide zucchini noodles, spinach, and chicken between plates. Spoon sauce over chicken and enjoy!",
      "secondary_message": null
    }
  ],
