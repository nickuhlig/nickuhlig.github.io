  "instructions": [
    {
      "id": 324245,
      "primary_message": "Preheat oven to 205°C (400°F). ",
      "secondary_message": null
    },
    {
      "id": 324246,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n½ (142 g) pkg baby spinach\n½ small bunch fresh dill\n½ lemon"
    },
    {
      "id": 324247,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; transfer to a baking sheet pan and spread out in an even layer. Cut butter into small pieces and sprinkle over top; season with salt.",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 324248,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, tossing halfway through, until zucchini is tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 324249,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 324250,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 324251,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove chicken to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 324252,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop spinach; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 324253,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 324254,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 324255,
      "primary_message": "Return skillet to medium heat, add more butter, and swirl to coat the bottom; add garlic and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 324256,
      "primary_message": "Add broth and cream to the skillet; stir to combine the sauce and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until thickened, 6-7 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 324257,
      "primary_message": "Once the sauce has thickened, add spinach and dill in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Juice lemon into the skillet and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 324258,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 324259,
      "primary_message": "To serve, divide zucchini noodles, spinach, and chicken between plates. Spoon sauce over chicken and enjoy!",
      "secondary_message": null
    }
  ],
