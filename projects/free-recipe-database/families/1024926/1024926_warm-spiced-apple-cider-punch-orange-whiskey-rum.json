  "instructions": [
    {
      "primary_message": "Wash and dry oranges. Juice one orange into a medium saucepan. Cut remaining orange half into 1/2-inch thick slices and add to the saucepan. ",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, and cut ginger into thin slices. Add to the saucepan with the orange. ",
      "secondary_message": "1 (1 inch) piece ginger root"
    },
    {
      "primary_message": "Add 16 fl oz (2 cups) apple juice, 8 fl oz (1 cup) water, sugar, and spices to the saucepan, then stir to combine. ",
      "secondary_message": "16 fl oz apple juice\n1 ½ tbsp brown sugar\n½ tsp nutmeg, ground\n¼ tsp allspice, ground"
    },
    {
      "primary_message": "Set pan over medium-high heat and bring to a simmer. Once simmering, reduce heat to medium and cook until flavors blend, about 5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Add 6 fl oz (3/4 cup) whiskey and 2 fl oz (1/4 cup) rum to the pan, then stir to combine the punch. ",
      "secondary_message": "6 fl oz blended whiskey\n2 fl oz dark rum"
    },
    {
      "primary_message": "Divide warm punch between mugs, then sprinkle with allspice. Enjoy!",
      "secondary_message": "⅛ tsp allspice, ground"
    }
  ],
