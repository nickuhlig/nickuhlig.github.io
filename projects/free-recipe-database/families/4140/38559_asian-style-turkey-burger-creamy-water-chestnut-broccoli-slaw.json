  "instructions": [
    {
      "id": 601366,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ green bell peppers\n1 ½ limes"
    },
    {
      "id": 601367,
      "primary_message": "Peel and mince ginger and garlic. Place both in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 601368,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the ginger and garlic along with turkey, bread crumbs, soy sauce, and spices; mix with your hands until well combined. Form the turkey mixture into 6 equal-sized patties and place on a plate.",
      "secondary_message": "2 ¼ lb ground turkey\n¾ cup panko bread crumbs\n3 tbsp soy sauce\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 601369,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601370,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 ½ tbsp toasted sesame oil"
    },
    {
      "id": 601371,
      "primary_message": "Meanwhile, place mayo and chili-garlic sauce in a small bowl. Stir to combine the spicy mayo and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 601372,
      "primary_message": "Zest and juice limes into a clean large bowl. Add additional mayo, sesame seeds, honey, salt, and pepper, then stir to combine the dressing. ",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp sesame seeds\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 601373,
      "primary_message": "Drain and roughly chop water chestnuts. Add to the bowl with the dressing, along with broccoli slaw, and stir to combine. Set aside.",
      "secondary_message": "6 oz water chestnuts\n1 ½ (12 oz) pkgs broccoli slaw"
    },
    {
      "id": 601374,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 601375,
      "primary_message": "Spread spicy mayo over the bottom half of each bun; top with burger patties and a small handful of slaw. Close with the top half of each bun. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
