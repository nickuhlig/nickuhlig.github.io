  "instructions": [
    {
      "id": 601416,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 green bell pepper\n1 lime"
    },
    {
      "id": 601417,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 601418,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the ginger and garlic along with veggie ground, bread crumbs, soy sauce, and spices; mix with your hands until well combined. Form the veggie ground mixture into 4 equal-sized patties and place on a plate.",
      "secondary_message": "16 oz veggie ground, plant based\n½ cup panko bread crumbs\n4 tsp soy sauce\n1 tsp coriander, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 601419,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601420,
      "primary_message": "Once the pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 601421,
      "primary_message": "Meanwhile, place mayo and chili-garlic sauce in a small bowl. Stir to combine the spicy mayo and set aside.",
      "secondary_message": "¼ cup vegan mayonnaise\n2 tsp chili-garlic sauce"
    },
    {
      "id": 601422,
      "primary_message": "Zest and juice lime into a clean medium bowl. Add additional mayo, sesame seeds, maple syrup, salt, and pepper, then stir to combine the dressing. ",
      "secondary_message": "¼ cup vegan mayonnaise\n2 tsp sesame seeds\n1 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 601423,
      "primary_message": "Drain and roughly chop water chestnuts. Add to the bowl with the dressing, along with broccoli slaw, and stir to combine. Set aside.",
      "secondary_message": "4 oz water chestnuts\n1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 601424,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 601425,
      "primary_message": "Spread spicy mayo over the bottom half of each bun; top with burger patties and a small handful of slaw. Close with the top half of each bun. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
