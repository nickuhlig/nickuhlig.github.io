  "instructions": [
    {
      "id": 601436,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ green bell pepper\n½ lime"
    },
    {
      "id": 601437,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 601438,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the ginger and garlic along with turkey, bread crumbs, soy sauce, and spices; mix with your hands until well combined. Form the turkey mixture into 2 equal-sized patties and place on a plate.",
      "secondary_message": "⅓ kg ground turkey\n¼ cup panko bread crumbs\n1 tbsp soy sauce\n½ tsp coriander, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 601439,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 601440,
      "primary_message": "Once the pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 601441,
      "primary_message": "Meanwhile, place mayo and chili-garlic sauce in a small bowl. Stir to combine the spicy mayo and set aside.",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp chili-garlic sauce"
    },
    {
      "id": 601442,
      "primary_message": "Zest and juice lime into a clean medium bowl. Add additional mayo, sesame seeds, honey, salt, and pepper, then stir to combine the dressing. ",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp sesame seeds\n½ tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 601443,
      "primary_message": "Drain and roughly chop water chestnuts. Add to the bowl with the dressing, along with broccoli slaw, and stir to combine. Set aside.",
      "secondary_message": "57 g water chestnuts\n½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 601444,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 601445,
      "primary_message": "Spread spicy mayo over the bottom half of each bun; top with burger patties and a small handful of slaw. Close with the top half of each bun. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
