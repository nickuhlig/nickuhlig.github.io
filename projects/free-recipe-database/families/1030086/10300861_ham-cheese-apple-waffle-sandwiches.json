  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, quarter, and core apple; thinly slice and set aside.",
      "secondary_message": "1 Gala apple"
    },
    {
      "primary_message": "Arrange waffles on a large baking sheet pan. Top half of the waffles with cheese slices and the other half with ham. ",
      "secondary_message": "8 slice cheddar cheese, sliced\n227 g deli ham, sliced"
    },
    {
      "primary_message": "Place baking sheet in the preheated oven and bake until cheese is melted and waffles are warmed through, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Top the ham-covered waffles with apple slices, then close sandwiches with cheesy waffles. Cut in half if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide waffle sandwiches between plates and enjoy!",
      "secondary_message": null
    }
