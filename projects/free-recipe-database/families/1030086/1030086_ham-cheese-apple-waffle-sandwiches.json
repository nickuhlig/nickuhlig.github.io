    {
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, quarter, and core apple; thinly slice and set aside.",
      "secondary_message": "1 Gala apple"
    },
    {
      "primary_message": "Arrange waffles on a large baking sheet pan. Top half of the waffles with cheese slices and the other half with ham. ",
