  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, and mince ginger.",
      "secondary_message": "1 (1 inch) piece ginger root"
    },
    {
      "primary_message": "Season steak generously with salt and pepper on both sides.",
      "secondary_message": "340 g ribeye steak\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Coat bottom of skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Wash, dry, and juice lime into a small bowl. Add ginger, oil, honey, and soy sauce. Whisk to combine the dressing and set aside.",
      "secondary_message": "½ lime\nextra virgin olive oil\n1 tsp honey"
    },
    {
      "primary_message": "Wash and dry lettuce. Chop crosswise into 1 inch strips. Transfer to a large bowl.",
      "secondary_message": "½ head romaine lettuce"
    },
    {
      "primary_message": "Wash and dry mango, bell pepper, and green onions. Peel, cut flesh away from the pit, julienne (cut into thin strips), and add mango to bowl with lettuce. Seed, julienne, and add pepper to bowl. Trim and discard root ends, chop green onions, and add to bowl.",
      "secondary_message": "1 mango\n1 red bell pepper\n½ small bunch green onions (scallions)"
    },
    {
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange salad on a plate and top with steak slices. Drizzle with dressing and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "½ tbsp sesame seeds"
    }
  ],
