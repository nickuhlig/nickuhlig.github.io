  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, and mince ginger.",
      "secondary_message": "3 (1 inch) pieces ginger root"
    },
    {
      "primary_message": "Season steak generously with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Coat bottom of skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Wash, dry, and juice limes into a small bowl. Add ginger, oil, honey, and soy sauce. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 ½ limes\nextra virgin olive oil\n1 tbsp honey"
    },
    {
      "primary_message": "Wash and dry lettuce. Halve lengthwise, then chop crosswise into 1 inch strips. Transfer to a large bowl.",
      "secondary_message": "1 ½ head romaine lettuce"
    },
    {
      "primary_message": "Wash and dry mangoes, bell peppers, and green onions. Peel, cut flesh away from the pit, julienne (cut into thin strips), and add mangoes to bowl with lettuce. Seed, julienne, and add peppers to bowl. Trim and discard root ends, chop green onions, and add to bowl.",
      "secondary_message": "3 mangoes\n3 red bell peppers\n1 ½ small bunch green onions (scallions)"
    },
    {
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange salad on a plate and top with steak slices. Drizzle with dressing and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 ½ tbsp sesame seeds"
    }
  ],
