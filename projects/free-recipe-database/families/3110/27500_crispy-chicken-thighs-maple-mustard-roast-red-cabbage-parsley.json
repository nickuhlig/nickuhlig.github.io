  "instructions": [
    {
      "id": 442112,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 442113,
      "primary_message": "Wash and dry cabbage; halve lengthwise, cut out the core, and slice crosswise into 1-inch thick wedges. Transfer to a large baking sheet pan. ",
      "secondary_message": "1 small head red cabbage"
    },
    {
      "id": 442114,
      "primary_message": "Place oil, Dijon, maple syrup, salt, and pepper in a small bowl. Stir to combine the glaze.",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup Dijon mustard\n2 tbsp pure maple syrup\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 442115,
      "primary_message": "Spread half of the glaze over the top side of the cabbage wedges. Carefully flip wedges and repeat with remaining glaze. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 442116,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until cabbage is golden brown and tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 442117,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place half in the reserved bowl. (Set aside remaining parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 442118,
      "primary_message": "Peel and mince garlic. Add to the bowl with the parsley along with mayo, Dijon, and thyme, then stir to combine. ",
      "secondary_message": "2 cloves garlic\n¼ cup mayonnaise\n2 tbsp Dijon mustard\n½ tsp thyme, dried"
    },
    {
      "id": 442119,
      "primary_message": "Pat chicken dry with paper towels, then season with salt and pepper on both sides. Transfer to a large baking dish.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 442120,
      "primary_message": "Spread Dijon mayo over the top side of the chicken, then sprinkle with bread crumbs, pressing gently to adhere. Drizzle with oil. ",
      "secondary_message": "1 cup panko bread crumbs\n4 tsp extra virgin olive oil"
    },
    {
      "id": 442121,
      "primary_message": "Add baking dish to the oven and roast until chicken is golden and cooked through, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 442122,
      "primary_message": "To serve, divide cabbage and chicken between plates; top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
