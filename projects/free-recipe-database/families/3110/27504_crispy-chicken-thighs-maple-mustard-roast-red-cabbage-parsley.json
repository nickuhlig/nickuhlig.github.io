  "instructions": [
    {
      "id": 442156,
      "primary_message": "Preheat oven to 230°C (450°F). Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 442157,
      "primary_message": "Wash and dry cabbages; halve lengthwise, cut out the core, and slice crosswise into 1-inch thick wedges. Divide between two baking sheet pans.",
      "secondary_message": "1 ½ small heads red cabbage"
    },
    {
      "id": 442158,
      "primary_message": "Place oil, Dijon, maple syrup, salt, and pepper in a small bowl. Stir to combine the glaze.",
      "secondary_message": "⅓ cup extra virgin olive oil\n⅓ cup Dijon mustard\n3 tbsp pure maple syrup\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 442159,
      "primary_message": "Spread half of the glaze over the top side of the cabbage wedges. Carefully flip wedges and repeat with remaining glaze. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 442160,
      "primary_message": "Place baking sheets on the middle and lower racks of the oven (it doesn't have to be fully heated) and roast until cabbage is golden brown and tender, about 30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 442161,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place half in the reserved bowl. (Set aside remaining parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 442162,
      "primary_message": "Peel and mince garlic. Add to the bowl with the parsley along with mayo, Dijon, and thyme, then stir to combine. ",
      "secondary_message": "3 cloves garlic\n⅓ cup mayonnaise\n3 tbsp Dijon mustard\n¾ tsp thyme, dried"
    },
    {
      "id": 442163,
      "primary_message": "Pat chicken dry with paper towels, then season with salt and pepper on both sides. Transfer to a large baking sheet.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 442164,
      "primary_message": "Spread Dijon mayo over the top side of the chicken, then sprinkle with bread crumbs, pressing gently to adhere. Drizzle with oil. ",
      "secondary_message": "1 ½ cup panko bread crumbs\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 442165,
      "primary_message": "Place baking sheet on the upper rack of the oven and roast until chicken is golden and cooked through, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 442166,
      "primary_message": "To serve, divide cabbage and chicken between plates; top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
