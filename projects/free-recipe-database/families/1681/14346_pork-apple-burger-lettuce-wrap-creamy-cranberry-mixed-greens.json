  "instructions": [
    {
      "id": 306193,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 Gala apple\n1 head butter (Boston) lettuce"
    },
    {
      "id": 306194,
      "primary_message": "Juice lemon into a medium bowl. Add yogurt, mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tsp mayonnaise\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 306195,
      "primary_message": "Quarter and core apple. Thinly slice half the apple and add to the bowl with the dressing; toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 306196,
      "primary_message": "Coarsely grate the other half of the apple and transfer to another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 306197,
      "primary_message": "Add pork, bread crumbs, Dijon, and spices to the bowl with the grated apple; use your hands to thoroughly combine. Form into 2 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "¾ lb lean ground pork\n2 tbsp panko bread crumbs\n1 tsp Dijon mustard\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 306198,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306199,
      "primary_message": "Once the grill pan is hot, coat with oil. Place burger patties on the grill and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 306200,
      "primary_message": "Meanwhile, place mayo and spices in a small bowl; stir to combine the spiced mayo.",
      "secondary_message": "1 tbsp mayonnaise\n¼ tsp paprika\n⅛ tsp garlic powder\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 306201,
      "primary_message": "Separate the lettuce leaves. Set aside two leaves per burger.",
      "secondary_message": null
    },
    {
      "id": 306202,
      "primary_message": "Chop or tear remaining lettuce leaves into bite-sized pieces and add to the bowl with the dressing. Add cranberries and toss to combine the salad.",
      "secondary_message": "⅛ cup dried cranberries"
    },
    {
      "id": 306203,
      "primary_message": "Pile lettuce leaves, in stacks of two per wrap, on each plate. Top with burger patties and spiced mayo. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
