  "instructions": [
    {
      "id": 306388,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 Gala apples\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 306389,
      "primary_message": "Juice lemons into a large bowl. Add mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup vegan mayonnaise\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 306390,
      "primary_message": "Quarter and core apples. Thinly half of the apples and add to the bowl with the dressing; toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 306391,
      "primary_message": "Coarsely grate the remaining apples and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 306392,
      "primary_message": "Add veggie ground, bread crumbs, Dijon, and spices to the bowl with the grated apple; use your hands to thoroughly combine. Form into 6 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "680 g veggie ground, plant based\n⅓ cup panko bread crumbs\n1 tbsp Dijon mustard\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 306393,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306394,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, place burger patties on the grill pan and cook, flipping once, until golden brown and cooked through, 6-8 minutes. Once done, transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 306395,
      "primary_message": "Meanwhile, place additional mayo and spices in a small bowl; stir to combine the spiced mayo.",
      "secondary_message": "3 tbsp vegan mayonnaise\n¾ tsp paprika\n½ tsp garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 306396,
      "primary_message": "If desired, place buns, cut-side down, on the grill to toast, 1-2 minutes.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 306397,
      "primary_message": "While toasting the buns, add mixed greens and cranberries to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "⅓ cup dried cranberries"
    },
    {
      "id": 306398,
      "primary_message": "Place burgers on bottom of buns, spread with spiced mayo, and close with tops.",
      "secondary_message": null
    },
    {
      "id": 306399,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
