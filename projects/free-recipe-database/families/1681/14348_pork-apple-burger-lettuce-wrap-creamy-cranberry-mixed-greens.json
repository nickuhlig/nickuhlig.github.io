  "instructions": [
    {
      "id": 306215,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 Gala apples\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 306216,
      "primary_message": "Juice lemons into a large bowl. Add yogurt, mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp mayonnaise\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 306217,
      "primary_message": "Quarter and core apples. Thinly slice half of the apples and add to the bowl with the dressing; toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 306218,
      "primary_message": "Coarsely grate the remaining apples and transfer to another large bowl.",
      "secondary_message": null
    },
    {
      "id": 306219,
      "primary_message": "Add pork, bread crumbs, Dijon, and spices to the bowl with the grated apple; use your hands to thoroughly combine. Form into 6 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "2 ¼ lb lean ground pork\n⅓ cup panko bread crumbs\n1 tbsp Dijon mustard\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 306220,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306221,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, place burger patties on the grill and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 306222,
      "primary_message": "Meanwhile, place mayo and spices in a small bowl; stir to combine the spiced mayo.",
      "secondary_message": "3 tbsp mayonnaise\n¾ tsp paprika\n½ tsp garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 306223,
      "primary_message": "Separate the lettuce leaves. Set aside two leaves per burger.",
      "secondary_message": null
    },
    {
      "id": 306224,
      "primary_message": "Chop or tear remaining lettuce leaves into bite-sized pieces and add to the bowl with the dressing. Add cranberries and toss to combine the salad.",
      "secondary_message": "⅓ cup dried cranberries"
    },
    {
      "id": 306225,
      "primary_message": "Pile lettuce leaves, in stacks of two per wrap, on each plate. Top with burger patties and spiced mayo. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
