  "instructions": [
    {
      "id": 306376,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n2 Gala apples\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 306377,
      "primary_message": "Juice lemon into a medium bowl. Add mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup vegan mayonnaise\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 306378,
      "primary_message": "Quarter and core apples. Thinly slice one apple and add to the bowl with the dressing; toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 306379,
      "primary_message": "Coarsely grate the other apple and transfer to another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 306380,
      "primary_message": "Add veggie ground, bread crumbs, Dijon, and spices to the bowl with the grated apple; use your hands to thoroughly combine. Form into 4 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "454 g veggie ground, plant based\n¼ cup panko bread crumbs\n2 tsp Dijon mustard\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 306381,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306382,
      "primary_message": "Once the grill pan is hot, coat with oil. Place burger patties on the grill pan and cook, flipping once, until golden brown and cooked through, 6-8 minutes. Once done, transfer to a clean plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 306383,
      "primary_message": "Meanwhile, place additional mayo and spices in a small bowl; stir to combine the spiced mayo.",
      "secondary_message": "2 tbsp vegan mayonnaise\n½ tsp paprika\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 306384,
      "primary_message": "If desired, place buns, cut-side down, on the grill to toast, 1-2 minutes.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 306385,
      "primary_message": "While toasting the buns, add mixed greens and cranberries to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 306386,
      "primary_message": "Place burgers on bottom of buns, spread with spiced mayo, and close with tops.",
      "secondary_message": null
    },
    {
      "id": 306387,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
