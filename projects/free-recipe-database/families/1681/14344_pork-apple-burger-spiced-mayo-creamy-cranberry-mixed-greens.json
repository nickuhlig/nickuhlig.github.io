  "instructions": [
    {
      "id": 306169,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n2 Gala apples\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 306170,
      "primary_message": "Juice lemon into a medium bowl. Add yogurt, mayo, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tsp mayonnaise\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 306171,
      "primary_message": "Quarter and core apples. Thinly slice one of the apples and add to the bowl with the dressing; toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 306172,
      "primary_message": "Coarsely grate the other apple and transfer to another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 306173,
      "primary_message": "Add pork, bread crumbs, Dijon, and spices to the bowl with the grated apple; use your hands to thoroughly combine. Form into 4 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "1 ½ lb lean ground pork\n¼ cup panko bread crumbs\n2 tsp Dijon mustard\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 306174,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306175,
      "primary_message": "Once the grill pan is hot, coat with oil. Place burger patties on the grill and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 306176,
      "primary_message": "Meanwhile, place mayo and spices in a small bowl; stir to combine the spiced mayo.",
      "secondary_message": "2 tbsp mayonnaise\n½ tsp paprika\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 306177,
      "primary_message": "If desired, place buns, cut-side down, on the grill to toast, 1-2 minutes.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 306178,
      "primary_message": "While toasting the buns, add mixed greens and cranberries to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 306179,
      "primary_message": "Place burgers on bottom of buns, spread with spiced mayo, and close with tops.",
      "secondary_message": null
    },
    {
      "id": 306180,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
