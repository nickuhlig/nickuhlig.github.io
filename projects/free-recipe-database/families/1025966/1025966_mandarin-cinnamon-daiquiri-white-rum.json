  "instructions": [
    {
      "primary_message": "FOR THE CINNAMON SYRUP: Using your hands (or the back of a knife), break cinnamon sticks into pieces. Place in a small saucepan along with sugar and water; stir to combine and bring to a boil. Reduce heat to medium and simmer, stirring occasionally, until sugar is just dissolved. Remove from heat and let cool completely before straining and using. (NOTE: this recipe makes about 2/3 cup cinnamon syrup. Transfer leftover syrup to a small jar and refrigerate for up to one month.)",
      "secondary_message": "½ cup granulated sugar"
    },
    {
      "primary_message": "FOR THE COCKTAIL: Wash and dry mandarins. Cut one thin slice from the end of one of the mandarins and set aside for garnish. Juice mandarins into a cocktail shaker.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and juice lime into the cocktail shaker with the mandarin juice. ",
      "secondary_message": "½ lime"
    },
    {
      "primary_message": "Add 1/2 fl oz (1 tbsp) cooled cinnamon syrup, 2 fl oz (1/4 cup) white rum, and ice cubes to the shaker. Shake until well chilled, about 20 seconds.",
      "secondary_message": "2 fl oz white rum\n½ cup ice cube"
    },
    {
      "primary_message": "Strain cocktail into a coupe, martini glass or glass of choice. Garnish with the reserved mandarin slice and enjoy!",
      "secondary_message": null
    }
  ],
