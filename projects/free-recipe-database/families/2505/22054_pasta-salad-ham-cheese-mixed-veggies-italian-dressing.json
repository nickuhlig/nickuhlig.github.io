  "instructions": [
    {
      "id": 423240,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 6 minutes.",
      "secondary_message": "½ tsp salt\n142 g rotini pasta"
    },
    {
      "id": 423241,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 yellow bell pepper\n1 medium carrot"
    },
    {
      "id": 423242,
      "primary_message": "Trim and medium dice cucumber. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 423243,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 423244,
      "primary_message": "Medium dice ham and add to the bowl. Set aside. ",
      "secondary_message": "227 g ham steak, boneless"
    },
    {
      "id": 423245,
      "primary_message": "Peel, trim, and medium dice carrot.",
      "secondary_message": null
    },
    {
      "id": 423246,
      "primary_message": "When the pasta is almost done, add carrot and broccoli to the pan. Continue to cook, stirring occasionally, until pasta reaches desired firmness and veggies are tender, 3-4 minutes more.",
      "secondary_message": "½ (510 g) bag broccoli florets"
    },
    {
      "id": 423247,
      "primary_message": "Drain and rinse pasta and veggies under cold water to cool. Add to the bowl with the other ingredients.",
      "secondary_message": null
    },
    {
      "id": 423248,
      "primary_message": "Add cheese and dressing to the bowl, then stir to combine the pasta salad.",
      "secondary_message": "½ cup shredded cheese, Italian blend\n¼ cup Italian salad dressing"
    },
    {
      "id": 423249,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
