  "instructions": [
    {
      "id": 464612,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 464613,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 orange bell peppers\n½ English cucumber\n½ pint grape tomatoes"
    },
    {
      "id": 464614,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper; arrange cut-side down. Place baking sheet in the oven and broil until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 464615,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 464616,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 464617,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, pork, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n¾ lb lean ground pork\n½ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464618,
      "primary_message": "Meanwhile, roughly chop olives and sun-dried tomatoes. ",
      "secondary_message": "⅓ cup Kalamata olives, pitted\n6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 464619,
      "primary_message": "When the pork is done, add olives, sun-dried tomatoes, and half of the feta to the skillet. Stir to combine the filling and remove from heat. (Reserve remaining feta for the next step.)",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 464620,
      "primary_message": "Turn pepper halves cut-side up, stuff with the filling, then top with reserved feta. Return baking sheet to the oven and continue to broil peppers until the cheese is melted, 3-4 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 464621,
      "primary_message": "While the peppers are broiling, place yogurt, vinegar, oil, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tsp red wine vinegar\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 464622,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464623,
      "primary_message": "Halve grape tomatoes. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464624,
      "primary_message": "To serve, divide stuffed peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
