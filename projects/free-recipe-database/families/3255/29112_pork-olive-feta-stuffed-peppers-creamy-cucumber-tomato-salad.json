  "instructions": [
    {
      "id": 464638,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 464639,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 orange bell peppers\n1 ½ English cucumbers\n1 ½ pints grape tomatoes"
    },
    {
      "id": 464640,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper; arrange cut-side down. Place baking sheet in the oven and broil until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464641,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 464642,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 464643,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, pork, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 ¼ lb lean ground pork\n1 ½ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 464644,
      "primary_message": "Meanwhile, roughly chop olives and sun-dried tomatoes. ",
      "secondary_message": "1 cup Kalamata olives, pitted\n18 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 464645,
      "primary_message": "When the pork is done, add olives, sun-dried tomatoes, and half of the feta to the skillet. Stir to combine the filling and remove from heat. (Reserve remaining feta for the next step.)",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 464646,
      "primary_message": "Turn pepper halves cut-side up, stuff with the filling, then top with reserved feta. Return baking sheet to the oven and continue to broil peppers until the cheese is melted, 3-4 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 464647,
      "primary_message": "While the peppers are broiling, place yogurt, vinegar, oil, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp red wine vinegar\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464648,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464649,
      "primary_message": "Halve grape tomatoes. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464650,
      "primary_message": "To serve, divide stuffed peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
