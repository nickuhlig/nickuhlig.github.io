  "instructions": [
    {
      "id": 464664,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 464665,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 orange bell peppers\n1 English cucumber\n1 pint grape tomatoes"
    },
    {
      "id": 464666,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper; arrange cut-side down. Place baking sheet in the oven and broil until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464667,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 464668,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 464669,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, veggie ground, and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based\n1 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464670,
      "primary_message": "Meanwhile, roughly chop olives and sun-dried tomatoes.",
      "secondary_message": "⅔ cup Kalamata olives, pitted\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 464671,
      "primary_message": "When the veggie ground is done, add olives, sun-dried tomatoes, and half of the feta to the skillet. Stir to combine the filling and remove from heat. (Reserve remaining feta for the next step.)",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 464672,
      "primary_message": "Turn pepper halves cut-side up, stuff with the filling, then top with reserved feta. Return baking sheet to the oven and continue to broil peppers until the cheese is melted, 3-4 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 464673,
      "primary_message": "While the peppers are broiling, place yogurt, vinegar, oil, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tsp red wine vinegar\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464674,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464675,
      "primary_message": "Halve grape tomatoes. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464676,
      "primary_message": "To serve, divide stuffed peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
