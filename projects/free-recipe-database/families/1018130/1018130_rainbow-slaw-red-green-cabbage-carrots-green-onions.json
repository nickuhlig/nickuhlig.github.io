  "instructions": [
    {
      "primary_message": "Peel and mince garlic. Place in a large bowl along with oil, vinegar, maple syrup, Dijon, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n1 tbsp pure maple syrup\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small head red cabbage\n½ small head green cabbage\n½ small bunch green onions (scallions)\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "Halve each cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips. Add both to the bowl with the dressing.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine the slaw, and set aside to marinate, about 20 minutes.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer slaw to a serving bowl. Stir once more before serving to re-dress. Enjoy!",
      "secondary_message": null
    }
  ],
