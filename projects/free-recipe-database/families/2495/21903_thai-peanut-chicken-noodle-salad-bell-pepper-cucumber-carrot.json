  "instructions": [
    {
      "id": 367955,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 367956,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 ½ limes\n3 yellow bell peppers\n1 ½ English cucumbers"
    },
    {
      "id": 367957,
      "primary_message": "Once the water is boiling, remove from heat and add the rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 367958,
      "primary_message": "While the noodles are soaking, juice limes into a large bowl. Add peanut sauce, soy sauce, sugar, and crushed red pepper; whisk to combine the dressing.",
      "secondary_message": "1 cup peanut sauce\n1 tbsp soy sauce\n1 tbsp brown sugar\n3 pinch crushed red pepper"
    },
    {
      "id": 367959,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 367960,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 367961,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and add to the bowl. ",
      "secondary_message": "1 ½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 367962,
      "primary_message": "Add drained noodles and carrots to the bowl. Toss to combine the noodle salad. ",
      "secondary_message": "1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 367963,
      "primary_message": "To serve, divide noodle salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
