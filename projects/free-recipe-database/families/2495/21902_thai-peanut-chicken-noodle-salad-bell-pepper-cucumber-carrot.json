  "instructions": [
    {
      "id": 367946,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 367947,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 lime\n2 yellow bell peppers\n1 English cucumber"
    },
    {
      "id": 367948,
      "primary_message": "Once the water is boiling, remove from heat and add the rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "283 g flat rice (pad thai) noodles"
    },
    {
      "id": 367949,
      "primary_message": "While the noodles are soaking, juice lime into a large bowl. Add peanut sauce, soy sauce, sugar, and crushed red pepper; whisk to combine the dressing.",
      "secondary_message": "⅔ cup peanut sauce\n2 tsp soy sauce\n2 tsp brown sugar\n⅛ tsp crushed red pepper"
    },
    {
      "id": 367950,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 367951,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 367952,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and add to the bowl. ",
      "secondary_message": "1 (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 367953,
      "primary_message": "Add drained noodles and carrots to the bowl. Toss to combine the noodle salad. ",
      "secondary_message": "1 (283 g) bag shredded carrots"
    },
    {
      "id": 367954,
      "primary_message": "To serve, divide noodle salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
