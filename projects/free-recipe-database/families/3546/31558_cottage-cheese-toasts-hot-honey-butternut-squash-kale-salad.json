  "instructions": [
    {
      "id": 498192,
      "primary_message": "Preheat oven to 230°C (450°F) and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 498193,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "½ small butternut squash\n½ lemon\n½ bunch kale"
    },
    {
      "id": 498194,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 498195,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 498196,
      "primary_message": "Meanwhile, place cottage cheese in a strainer to remove excess liquid. Transfer to a small bowl, season with salt, and stir to combine. Set aside.",
      "secondary_message": "1 cup cottage cheese\n1 pinch salt"
    },
    {
      "id": 498197,
      "primary_message": "Finely grate Parmesan. Place in a medium bowl.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 498198,
      "primary_message": "Juice lemon into the bowl with the Parmesan. Add oil, honey, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp honey\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 498199,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing and, using your hands, massage kale until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 498200,
      "primary_message": "When the squash is done, remove from the oven, then drizzle with honey and hot sauce. Stir to coat and set aside to cool slightly, about 5 minutes.",
      "secondary_message": "1 ½ tbsp honey\n1 ½ tsp hot sauce"
    },
    {
      "id": 498201,
      "primary_message": "Change oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 498202,
      "primary_message": "Arrange bread on another baking sheet. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 498203,
      "primary_message": "Spread the cottage cheese over each piece of toast, then top with hot honey squash.",
      "secondary_message": null
    },
    {
      "id": 498204,
      "primary_message": "To serve, divide cheesy toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
