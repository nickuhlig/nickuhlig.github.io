  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, quarter, and core apples; medium dice. Place in a medium saucepan.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and juice lemon into the pan with the apple. Add butter, water, and salt, then set over medium-high heat. Cook, stirring occasionally, until starting to soften, 5-6 minutes. Remove from heat. ",
      "secondary_message": "½ lemon\nbutter, unsalted\n¼ tsp salt"
    },
    {
      "primary_message": "Meanwhile, place pumpkin, sugar, milk, flour, egg, and pumpkin spice mix in a medium bowl. Whisk to combine.",
      "secondary_message": "½ (425 g) can pure pumpkin purée\n⅓ cup granulated sugar\n¼ cup whole milk\nall-purpose flour\n1 egg\n½ tsp pumpkin spice mix"
    },
    {
      "primary_message": "When the apples are done, transfer to an 8-inch round or square baking dish and spread out in an even layer. Top with the pumpkin mixture, spreading it out to the edges of the dish. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place additional flour, sugar, and pumpkin spice mix in another medium bowl, then stir to combine.",
      "secondary_message": "¾ cup all-purpose flour\n⅔ cup granulated sugar\n½ tsp pumpkin spice mix"
    },
    {
      "primary_message": "Using a box grater, coarsely grate cold butter into the bowl with the flour mixture. Using two hands, combine the flour and butter by rubbing the mixture between your thumbs and fingers until it looks crumbly. Sprinkle topping over the pumpkin mixture in an even layer.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "primary_message": "Place dish in the oven and bake until the crisp is golden brown and set in the middle, 30-40 minutes. Remove from oven and set aside to cool slightly, about 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide crisp between plates or bowls and serve with whipped topping. Enjoy!",
      "secondary_message": "1 cup whipped topping"
    }
  ],
