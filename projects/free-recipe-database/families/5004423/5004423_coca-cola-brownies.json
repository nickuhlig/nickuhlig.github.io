  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Either grease baking pan with oil or line with tin foil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, stir together flour, sugar, cocoa, salt, and baking powder until combined. Stir in Coca Cola, a little at a time because it will foam, until incorporated and batter forms. Pour batter into pan and bake until a tester inserted into the middle of the pan comes out clean, about 30 minutes. Top will be slightly sticky.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Let cool completely in pan then cut into squares.",
      "secondary_message": null
    }
  ],
