  "instructions": [
    {
      "id": 192879,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg chives\n1 lemon\n1 head romaine lettuce\n2 avocados\n2 mangoes"
    },
    {
      "id": 192880,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 192881,
      "primary_message": "Add the bacon to the skillet and cook until crispy, 3-5 minutes per side. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 192882,
      "primary_message": "Meanwhile, finely dice chives. Peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 192883,
      "primary_message": "Place frozen edamame in a medium bowl, cover with hot water (from the tap), and let sit 5 minutes. Drain in a colander; set aside to drain further.",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 192884,
      "primary_message": "Juice the lemon into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 192885,
      "primary_message": "Add mayonnaise and spices to the bowl and whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n½ tsp salt\n¼ tsp cayenne pepper\n¼ tsp black pepper"
    },
    {
      "id": 192886,
      "primary_message": "Chop or tear the lettuce into bite-sized pieces and transfer to a salad bowl. ",
      "secondary_message": null
    },
    {
      "id": 192887,
      "primary_message": "Once the bacon is cooked transfer to a plate lined with paper towels and pat to remove excess oil. Crumble or chop into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 192888,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out into the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 192889,
      "primary_message": "Peel mangoes and slice the flesh away from the pit, starting with the flat sides. Slice the mangoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 192890,
      "primary_message": "Add edamame to the bowl and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 192891,
      "primary_message": "To serve, divide the salad between plates or bowls. Drizzle dressing over salad and enjoy!",
      "secondary_message": null
    }
  ],
