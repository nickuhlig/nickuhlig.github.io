  "instructions": [
    {
      "id": 192925,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs chives\n1 ½ lemons\n3 heads butter (Boston) lettuce\n3 avocados\n3 mangoes"
    },
    {
      "id": 192926,
      "primary_message": "Place frozen edamame in a medium bowl, cover with hot water (from the tap), and let sit 5 minutes. Drain in a colander; set aside to drain further.",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 192927,
      "primary_message": "Meanwhile, finely dice chives. Peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 192928,
      "primary_message": "Juice the lemons into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 192929,
      "primary_message": "Add mayonnaise and spices to the bowl and whisk to combine the dressing.",
      "secondary_message": "½ cup vegan mayonnaise\n¾ tsp salt\n¼ tsp cayenne pepper\n¼ tsp black pepper"
    },
    {
      "id": 192930,
      "primary_message": "Chop or tear the lettuce into bite-sized pieces and transfer to a large salad bowl along with the edamame. ",
      "secondary_message": null
    },
    {
      "id": 192931,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out into the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 192932,
      "primary_message": "Peel mangoes and slice the flesh away from the pit, starting with the flat sides. Slice the mangoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 192933,
      "primary_message": "Add edamame to the bowl and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 192934,
      "primary_message": "To serve, divide the salad between plates or bowls. Drizzle dressing over salad and enjoy!",
      "secondary_message": null
    }
  ],
