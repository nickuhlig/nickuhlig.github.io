  "instructions": [
    {
      "id": 192974,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg chives\n½ lemon\n1 head butter (Boston) lettuce\n1 avocado\n1 mango"
    },
    {
      "id": 192975,
      "primary_message": "Place frozen edamame in a medium bowl, cover with hot water (from the tap), and let sit 5 minutes. Drain in a colander; set aside to drain further.",
      "secondary_message": "1 cup edamame"
    },
    {
      "id": 192976,
      "primary_message": "Meanwhile, finely dice chives. Peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 192977,
      "primary_message": "Juice the lemon into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 192978,
      "primary_message": "Add mayonnaise and spices to the bowl and whisk to combine the dressing.",
      "secondary_message": "3 tbsp vegan mayonnaise\n¼ tsp salt\n⅛ tsp cayenne pepper\n⅛ tsp black pepper"
    },
    {
      "id": 192979,
      "primary_message": "Chop or tear the lettuce into bite-sized pieces and transfer to a salad bowl along with the edamame. ",
      "secondary_message": null
    },
    {
      "id": 192980,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out into the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 192981,
      "primary_message": "Peel mango and slice the flesh away from the pit, starting with the flat sides. Slice the mango and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 192982,
      "primary_message": "Add edamame to the bowl and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 192983,
      "primary_message": "To serve, divide the salad between plates or bowls. Drizzle dressing over salad and enjoy!",
      "secondary_message": null
    }
  ],
