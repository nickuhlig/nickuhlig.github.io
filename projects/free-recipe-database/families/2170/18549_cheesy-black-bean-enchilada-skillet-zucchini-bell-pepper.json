  "instructions": [
    {
      "id": 303834,
      "primary_message": "Preheat a medium saucepan over medium-high heat. Once the pan is hot, add oil and swirl to coat the bottom; add flour and cook, whisking constantly, until lightly golden, about 1 minute.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp all-purpose flour"
    },
    {
      "id": 303835,
      "primary_message": "Slowly whisk in tomato sauce, broth, and spices. Bring to a boil, then reduce heat and simmer until thickened, 4-5 minutes. Remove enchilada sauce from heat and set aside.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n237 ml chicken or vegetable broth\n2 tbsp chili powder\n1 tsp cumin, ground\n1 tsp salt\n½ tsp oregano, dried"
    },
    {
      "id": 303836,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 jalapeño peppers\n2 red bell peppers\n4 medium zucchini squash"
    },
    {
      "id": 303837,
      "primary_message": "Quarter jalapeños lengthwise; seed and remove ribs with a spoon. Finely dice and place in a large bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 303838,
      "primary_message": "Trim, seed, and small dice bell peppers. Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add both to the bowl with the jalapeño.",
      "secondary_message": null
    },
    {
      "id": 303839,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 303840,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the veggies.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 303841,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggies and spices. Cook, stirring occasionally, until fork-tender, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp chili powder\n1 tsp salt\n½ tsp cumin, ground\n¼ tsp black pepper"
    },
    {
      "id": 303842,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 303843,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 303844,
      "primary_message": "Coarsely grate cheddar, place in the reserved bowl, and set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 303845,
      "primary_message": "Cut cream cheese into small pieces. When the veggies are done, add cream cheese to the skillet and cook, stirring occasionally, until melted and combined, 2-3 minutes.",
      "secondary_message": "½ (227 g) block cream cheese"
    },
    {
      "id": 303846,
      "primary_message": "Meanwhile, slice tortillas into 2-inch long strips. Add to the skillet, along with the enchilada sauce and beans; stir to combine and remove from heat.",
      "secondary_message": "4 small corn tortillas"
    },
    {
      "id": 303847,
      "primary_message": "Top skillet with cheddar and place in the oven; broil until the cheese is melted and bubbly, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 303848,
      "primary_message": "To serve, divide enchilada skillet between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
