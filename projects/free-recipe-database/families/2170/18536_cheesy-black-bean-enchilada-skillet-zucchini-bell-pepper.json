  "instructions": [
    {
      "id": 303633,
      "primary_message": "Preheat a small saucepan over medium-high heat. Once the pan is hot, add oil and swirl to coat the bottom; add flour and cook, whisking constantly, until lightly golden, about 1 minute.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp all-purpose flour"
    },
    {
      "id": 303634,
      "primary_message": "Slowly whisk in tomato sauce, broth, and spices. Bring to a boil, then reduce heat and simmer until thickened, 4-5 minutes. Remove enchilada sauce from heat and set aside.",
      "secondary_message": "1 (8 oz) can tomato sauce\n4 fl oz (½ cup) chicken or vegetable broth\n1 tbsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp oregano, dried"
    },
    {
      "id": 303635,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n1 red bell pepper\n2 medium zucchini squash"
    },
    {
      "id": 303636,
      "primary_message": "Quarter jalapeño lengthwise; seed and remove ribs with a spoon. Finely dice and place in a medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 303637,
      "primary_message": "Trim, seed, and small dice bell pepper. Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add both to the bowl with the jalapeño.",
      "secondary_message": null
    },
    {
      "id": 303638,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 303639,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the veggies.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 303640,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggies and spices. Cook, stirring occasionally, until fork-tender, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp chili powder\n½ tsp salt\n¼ tsp cumin, ground\n⅛ tsp black pepper"
    },
    {
      "id": 303641,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 303642,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 303643,
      "primary_message": "Coarsely grate cheddar, place in the reserved bowl, and set aside.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 303644,
      "primary_message": "Cut cream cheese into small pieces. When the veggies are done, add cream cheese to the skillet and cook, stirring occasionally, until melted and combined, 2-3 minutes.",
      "secondary_message": "¼ (8 oz) block cream cheese"
    },
    {
      "id": 303645,
      "primary_message": "Meanwhile, slice tortillas into 2-inch long strips. Add to the skillet, along with the enchilada sauce and beans; stir to combine and remove from heat.",
      "secondary_message": "2 small corn tortillas"
    },
    {
      "id": 303646,
      "primary_message": "Top skillet with cheddar and place in the oven; broil until the cheese is melted and bubbly, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 303647,
      "primary_message": "To serve, divide enchilada skillet between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
