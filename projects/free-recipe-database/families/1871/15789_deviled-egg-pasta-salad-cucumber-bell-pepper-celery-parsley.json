  "instructions": [
    {
      "id": 259213,
      "primary_message": "Place eggs in a medium saucepan, cover with hot water (from the tap) and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain and add ice or run under cold water to cool; set aside.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 259214,
      "primary_message": "While the eggs are cooking, fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool completely; set aside.",
      "secondary_message": "2 tsp salt\n283 g rotini pasta"
    },
    {
      "id": 259215,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 English cucumber\n2 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 259216,
      "primary_message": "Trim and small dice celery; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 259217,
      "primary_message": "Trim and medium dice cucumber; add to the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 259218,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259219,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259220,
      "primary_message": "Peel and mince shallots; add to the bowl and set aside.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 259221,
      "primary_message": "Once the eggs have cooled, peel and halve lengthwise. Using a spoon, separate the yolks from the whites and place the yolks in a small bowl. Roughly chop the egg whites and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 259222,
      "primary_message": "Gently mash the yolks with a fork. Add mayo, Dijon, vinegar, and spices to the bowl; stir to combine the dressing.",
      "secondary_message": "⅔ cup mayonnaise\n2 tbsp Dijon mustard\n2 tbsp apple cider vinegar\n1 tsp salt\n½ tsp paprika\n¼ tsp black pepper"
    },
    {
      "id": 259223,
      "primary_message": "Add pasta and dressing to the bowl with the veggies; stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 259224,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
