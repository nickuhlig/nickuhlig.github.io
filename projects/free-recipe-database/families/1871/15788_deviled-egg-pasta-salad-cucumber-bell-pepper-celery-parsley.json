  "instructions": [
    {
      "id": 259201,
      "primary_message": "Place eggs in a small saucepan, cover with hot water (from the tap) and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain and add ice or run under cold water to cool; set aside.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 259202,
      "primary_message": "While the eggs are cooking, fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and rinse under cold water to cool completely; set aside.",
      "secondary_message": "1 tsp salt\n142 g rotini pasta"
    },
    {
      "id": 259203,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n½ English cucumber\n1 red bell pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 259204,
      "primary_message": "Trim and small dice celery; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 259205,
      "primary_message": "Trim and medium dice cucumber; add to the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 259206,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259207,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259208,
      "primary_message": "Peel and mince shallot; add to the bowl and set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 259209,
      "primary_message": "Once the eggs have cooled, peel and halve lengthwise. Using a spoon, separate the yolks from the whites and place the yolks in a small bowl. Roughly chop the egg whites and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 259210,
      "primary_message": "Gently mash the yolks with a fork. Add mayo, Dijon, vinegar, and spices to the bowl; stir to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp Dijon mustard\n1 tbsp apple cider vinegar\n½ tsp salt\n¼ tsp paprika\n⅛ tsp black pepper"
    },
    {
      "id": 259211,
      "primary_message": "Add pasta and dressing to the bowl with the veggies; stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 259212,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
