  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Shell and devein the raw medium shrimp. Cut the fresh corn kernels from about 3 ears of corn. Juice the lime. Thinly slice the serrano pepper. Dice the whole red bell pepper. Pick the cilantro leaves and tender stems from the thick stems and roughly chop them.",
      "secondary_message": "1 lb raw medium shrimp\n3 cups fresh corn kernels\n1 lime, divided\n1 serrano pepper\n1 whole red bell pepper\n¼ cup fresh cilantro leaves, tender stems"
    },
    {
      "id": 1,
      "primary_message": "Combine shrimp, 1 teaspoon kosher salt, and baking soda in a medium bowl and toss to coat. Set aside in refrigerator while you cook the corn.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring a medium pot of well-salted water to a boil. Add corn and cook until tender-crisp, about 3 minutes. Drain carefully, rinse under cold running water, and spin dry in a salad spinner.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add shrimp to now-empty pot and cover with 3 cups cold water. Add remaining 1 tablespoon salt along with 1 tablespoon lime juice. Place over medium-high heat and heat until water is barely steaming and registers 170°F on an instant-read thermometer; adjust heat to maintain this temperature for remainder of cooking. Cook shrimp until pink and firm to the touch, about 7 minutes total. Drain carefully, rinse under cold running water, and spin dry in salad spinner.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Combine cooked shrimp and corn with tomatillos, serrano pepper, red bell pepper, scallions, cilantro, olive oil, and remaining lime juice. Toss to coat, season to taste with salt and pepper, and serve.",
      "secondary_message": null
    }
  ],
