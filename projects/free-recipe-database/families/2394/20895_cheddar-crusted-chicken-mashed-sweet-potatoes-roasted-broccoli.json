  "instructions": [
    {
      "id": 401584,
      "primary_message": "Preheat oven to 425°F. Line two large baking sheet pans with aluminum foil to make cleanup easier (optional), then coat with oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 401585,
      "primary_message": "Coarsely grate cheese into a medium bowl; add bread crumbs and spices. Stir to combine the coating.",
      "secondary_message": "¾ (8 oz) block cheddar cheese\n1 ½ cup panko bread crumbs\n¾ tsp paprika\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 401586,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 401587,
      "primary_message": "Spread mayo over both sides of the cutlets, then dredge in the bread crumb coating, pressing firmly to adhere. Transfer cutlets to one of the baking sheets and drizzle with oil; set aside.",
      "secondary_message": "3 tbsp mayonnaise\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 401588,
      "primary_message": "Wash and dry broccoli; using a clean cutting board, separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to the second baking sheet.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 401589,
      "primary_message": "Drizzle broccoli with oil, season with salt and pepper, then toss to coat; spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 401590,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, flipping chicken and tossing broccoli halfway through, until chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 401591,
      "primary_message": "Meanwhile, wash, dry, peel, and medium dice sweet potatoes; place in a large pot. Cover with hot water (from the tap) and bring to a boil over high heat.",
      "secondary_message": "2 ¼ lb sweet potatoes"
    },
    {
      "id": 401592,
      "primary_message": "Once the liquid in the pot is boiling, reduce heat to medium, cover, and simmer until sweet potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 401593,
      "primary_message": "When the sweet potatoes are done, drain in a colander, and return to the pot. Add oil, salt, and pepper, then mash until smooth.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 401594,
      "primary_message": "To serve, divide mashed sweet potatoes, chicken, and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
