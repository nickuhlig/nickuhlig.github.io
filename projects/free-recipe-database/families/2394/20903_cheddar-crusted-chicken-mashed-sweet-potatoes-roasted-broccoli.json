  "instructions": [
    {
      "id": 401678,
      "primary_message": "Preheat oven to 220°C (425°F). Line a large baking sheet pan with aluminum foil to make cleanup easier (optional), then coat with oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 401679,
      "primary_message": "Coarsely grate cheese into a medium bowl; add bread crumbs and spices. Stir to combine the coating.",
      "secondary_message": "½ (227 g) block cheddar cheese\n1 cup panko bread crumbs\n½ tsp paprika\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 401680,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 401681,
      "primary_message": "Spread mayo over both sides of the cutlets, then dredge in the bread crumb coating, pressing firmly to adhere. Transfer cutlets to one side of the baking sheet and drizzle with oil.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp extra virgin olive oil"
    },
    {
      "id": 401682,
      "primary_message": "Wash and dry broccoli; using a clean cutting board, separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the other side of the baking sheet with the chicken.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 401683,
      "primary_message": "Drizzle broccoli with oil, season with salt and pepper, then toss to coat; spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 401684,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping chicken and tossing broccoli halfway through, until chicken is cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 401685,
      "primary_message": "Meanwhile, wash, dry, peel, and medium dice sweet potatoes; place in a medium saucepan. Cover with hot water (from the tap) and bring to a boil over high heat.",
      "secondary_message": "0.68 kg sweet potato"
    },
    {
      "id": 401686,
      "primary_message": "Once the liquid in the saucepan is boiling, reduce heat to medium, cover, and simmer until sweet potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 401687,
      "primary_message": "When the sweet potatoes are done, drain in a colander, and return to the pan. Add oil, salt, and pepper, then mash until smooth.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 401688,
      "primary_message": "To serve, divide mashed sweet potatoes, chicken, and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
