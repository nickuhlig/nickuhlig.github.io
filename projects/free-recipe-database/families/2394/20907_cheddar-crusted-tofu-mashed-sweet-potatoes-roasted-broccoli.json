  "instructions": [
    {
      "id": 401726,
      "primary_message": "Cut tofu into ½-inch thick slices along the short side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 401727,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 401728,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces and transfer to another large baking sheet.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 401729,
      "primary_message": "Drizzle broccoli with oil, season with salt and pepper, then toss to coat; spread out in an even layer. Set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 401730,
      "primary_message": "Place mayo and spices in a small bowl; stir to combine the aioli.",
      "secondary_message": "⅓ cup mayonnaise\n¾ tsp paprika\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 401731,
      "primary_message": "Coarsely grate cheese into another small bowl, add bread crumbs, and stir to combine the bread crumb coating.",
      "secondary_message": "¾ (227 g) block cheddar cheese\n1 ½ cup panko bread crumbs"
    },
    {
      "id": 401732,
      "primary_message": "Remove tofu from the baking sheet and wipe it dry with paper towels. Return tofu to the baking sheet, arranging the slices in a single layer.",
      "secondary_message": null
    },
    {
      "id": 401733,
      "primary_message": "Spread aioli over both sides of the tofu, sprinkle with half of the bread crumb coating, and drizzle with half of the oil. Carefully flip tofu and repeat with the remaining aioli, bread crumbs, and oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 401734,
      "primary_message": "Place both baking sheets in the oven (it doesn't have to be fully heated) and bake, flipping tofu and tossing broccoli halfway through, until tofu is crispy and golden brown, 18-20 minutes. Remove baking sheets from oven.",
      "secondary_message": null
    },
    {
      "id": 401735,
      "primary_message": "Meanwhile, wash, dry, peel, and medium dice sweet potatoes; place in a large pot. Cover with hot water (from the tap) and bring to a boil over high heat.",
      "secondary_message": "1.02 kg sweet potatoes"
    },
    {
      "id": 401736,
      "primary_message": "Once the liquid in the pot is boiling, reduce heat to medium, cover, and simmer until sweet potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 401737,
      "primary_message": "When the sweet potatoes are done, drain in a colander, and return to the pot. Add oil, salt, and pepper, then mash until smooth.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 401738,
      "primary_message": "To serve, divide mashed sweet potatoes, tofu, and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
