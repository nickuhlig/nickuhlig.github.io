  "instructions": [
    {
      "id": 399166,
      "primary_message": "Peel, halve, and small dice onion. Place in a medium bowl. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 399167,
      "primary_message": "Drain and rinse lentils. Add to the bowl with the onion.",
      "secondary_message": "1 (15 oz) can lentils"
    },
    {
      "id": 399168,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 pint grape tomatoes\n½ English cucumber\n½ small bunch Italian (flat-leaf) parsley\n1 avocado\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 399169,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 399170,
      "primary_message": "Trim and small dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 399171,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 399172,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 399173,
      "primary_message": "Add feta and vinaigrette to the bowl, then stir to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese\n¼ cup balsamic vinaigrette"
    },
    {
      "id": 399174,
      "primary_message": "To serve, divide arugula between plates or bowls; top with the lentil salad. Enjoy!",
      "secondary_message": null
    }
  ],
