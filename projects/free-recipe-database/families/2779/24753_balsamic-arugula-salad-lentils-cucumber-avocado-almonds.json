  "instructions": [
    {
      "id": 399265,
      "primary_message": "Peel, halve, and small dice onions. Place in a large bowl. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 399266,
      "primary_message": "Drain and rinse lentils. Add to the bowl with the onions.",
      "secondary_message": "3 (255 g) cans lentils"
    },
    {
      "id": 399267,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 small pkgs grape tomatoes\n1 ½ English cucumbers\n1 small bunch Italian (flat-leaf) parsley\n3 avocados\n3 (142 g) pkg baby arugula"
    },
    {
      "id": 399268,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 399269,
      "primary_message": "Trim and small dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 399270,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 399271,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 399272,
      "primary_message": "Add almonds and vinaigrette to the bowl, then stir to combine the salad.",
      "secondary_message": "1 ½ cups almonds, sliced\n¾ cup balsamic vinaigrette"
    },
    {
      "id": 399273,
      "primary_message": "To serve, divide arugula between plates or bowls; top with the lentil salad. Enjoy!",
      "secondary_message": null
    }
  ],
