  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the white onion. Mince the garlic cloves. Peel and mince the ginger. Peel and cut the sweet potato into 1-inch cubes.",
      "secondary_message": "1 medium white onion\n2 medium garlic cloves\n1 inch piece ginger root\n⅓ lb sweet potato"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a large saucepan over medium-high heat until shimmering. Add cumin seeds, and stir constantly with a wooden spoon until fragrant, 15 to 20 seconds. Stir in onion, garlic, and ginger and cook until onion is lightly browned, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add cayenne, paprika, cardamom, cinnamon, and salt, and stir until combined. Add sweet potatoes, and stir until they are evenly coated in the spice mixture. Add water, and stir to dislodge any browned bits on the bottom of the pan. Reduce heat to medium-low, cover skillet, and cook until sweet potatoes are tender, stirring occasionally, 10 to 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove cover from skillet and increase heat to medium. Stir frequently until sauce thickens. Some cubes will break down into the sauce. Add a handful of spinach leaves, and stir until wilted. Repeat process until all of the spinach is added.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Season with more salt if necessary. Serve with white rice.",
      "secondary_message": null
    }
  ],
