  "instructions": [
    {
      "id": 489137,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 489138,
      "primary_message": "Wash and dry grape tomatoes. Divide between two baking sheet pans.",
      "secondary_message": "6 pints grape tomatoes"
    },
    {
      "id": 489139,
      "primary_message": "Peel garlic and add to the baking sheets with the tomatoes. Drizzle veggies with oil, then season with salt and crushed red pepper; stir to combine and spread out in an even layer.",
      "secondary_message": "12 cloves garlic\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 489140,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tomatoes are burst and browned in spots, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 489141,
      "primary_message": "When the tomatoes have about 10 minutes left, fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 489142,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "3 (16 oz) pkgs potato gnocchi\n1 ½ tsp salt"
    },
    {
      "id": 489143,
      "primary_message": "Meanwhile, using a peeler, shave Parmesan into curls. Place half in a medium bowl. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 489144,
      "primary_message": "Wash, dry, and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to bowl with the Parmesan. (Reserve remaining basil for serving.)",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 489145,
      "primary_message": "When the tomatoes are done, remove from the oven. Add drained gnocchi, Parmesan, basil, and vinegar to the baking sheets. Gently stir to combine.",
      "secondary_message": "1 tbsp balsamic vinegar"
    },
    {
      "id": 489146,
      "primary_message": "To serve, divide gnocchi and tomatoes between plates or bowls. Top with reserved Parmesan and basil, then drizzle with oil. Enjoy!",
      "secondary_message": "3 tbsp extra virgin olive oil"
    }
  ],
