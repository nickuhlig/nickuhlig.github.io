  "instructions": [
    {
      "id": 489147,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 489148,
      "primary_message": "Wash and dry grape tomatoes. Transfer to a baking sheet pan.",
      "secondary_message": "2 small pkgs grape tomatoes"
    },
    {
      "id": 489149,
      "primary_message": "Peel garlic and add to the baking sheet with the tomatoes. Drizzle veggies with oil, then season with salt and crushed red pepper; stir to combine and spread out in an even layer.",
      "secondary_message": "4 cloves garlic\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 489150,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tomatoes are burst and browned in spots, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 489151,
      "primary_message": "When the tomatoes have about 10 minutes left, fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 489152,
      "primary_message": "Once the water in the pan is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "1 (454 g) pkg potato gnocchi\n½ tsp salt"
    },
    {
      "id": 489153,
      "primary_message": "Meanwhile, using a peeler, shave Parmesan into curls. Place half in a small bowl. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 489154,
      "primary_message": "Wash, dry, and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to bowl with the Parmesan. (Reserve remaining basil for serving.)",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 489155,
      "primary_message": "When the tomatoes are done, remove from the oven. Add drained gnocchi, Parmesan, basil, and vinegar to the baking sheet. Gently stir to combine.",
      "secondary_message": "1 tsp balsamic vinegar"
    },
    {
      "id": 489156,
      "primary_message": "To serve, divide gnocchi and tomatoes between plates or bowls. Top with reserved Parmesan and basil, then drizzle with oil. Enjoy!",
      "secondary_message": "1 tbsp extra virgin olive oil"
    }
  ],
