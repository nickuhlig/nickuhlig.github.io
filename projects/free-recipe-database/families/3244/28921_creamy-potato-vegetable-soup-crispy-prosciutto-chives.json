  "instructions": [
    {
      "id": 461801,
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a medium saucepan.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 461802,
      "primary_message": "Wash, dry, and chop chives into small pieces. Add half to the pan with the celery. (Set remaining chives aside for serving.)",
      "secondary_message": "½ small pkg chives"
    },
    {
      "id": 461803,
      "primary_message": "Add broth, shredded potatoes, carrots, and spices to the pan, then bring to a boil over high heat. Once the soup is boiling, reduce heat to medium-low and simmer until the veggies are soft, about 15 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n2 cups frozen shredded hash brown potatoes\n½ (283 g) bag shredded carrots\n¼ tsp garlic powder\n¼ tsp thyme, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 461804,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461805,
      "primary_message": "While the skillet heats up, cut or tear prosciutto into bite-sized pieces.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 461806,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add prosciutto and cook, stirring occasionally, until crispy, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 461807,
      "primary_message": "While the prosciutto is cooking, cut cream cheese into small pieces.",
      "secondary_message": "½ (227 g) block cream cheese"
    },
    {
      "id": 461808,
      "primary_message": "When the veggies are soft, add cream cheese to the pan. Continue to cook, stirring constantly, until the cream cheese is melted and combined, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 461809,
      "primary_message": "To serve, divide soup between bowls; sprinkle with crispy prosciutto and reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
