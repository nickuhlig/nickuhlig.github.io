  "instructions": [
    {
      "id": 461783,
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a large pot.",
      "secondary_message": "4 sticks celery"
    },
    {
      "id": 461784,
      "primary_message": "Wash, dry, and chop chives into small pieces. Add half to the pot with the celery. (Set remaining chives aside for serving.)",
      "secondary_message": "1 small pkg chives"
    },
    {
      "id": 461785,
      "primary_message": "Add broth, shredded potatoes, carrots, and spices to the pot, then bring to a boil over high heat. Once the soup is boiling, reduce heat to medium-low and simmer until the veggies are soft, about 15 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n4 cups frozen shredded hash brown potatoes\n1 (10 oz) bag shredded carrots\n½ tsp garlic powder\n½ tsp thyme, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 461786,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461787,
      "primary_message": "While the skillet heats up, cut or tear prosciutto into bite-sized pieces.",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 461788,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add prosciutto and cook, stirring occasionally, until crispy, 2-3 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 461789,
      "primary_message": "While the prosciutto is cooking, cut cream cheese into small pieces.",
      "secondary_message": "1 (8 oz) block cream cheese"
    },
    {
      "id": 461790,
      "primary_message": "When the veggies are soft, add cream cheese to the pot. Continue to cook, stirring constantly, until the cream cheese is melted and combined, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 461791,
      "primary_message": "To serve, divide soup between bowls; sprinkle with crispy prosciutto and reserved chives. Enjoy!",
      "secondary_message": null
    }
  ],
