  "instructions": [
    {
      "id": 428469,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 428470,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 428471,
      "primary_message": "Large dice tofu, drizzle with oil, and season with spices. Thread onto skewers and place on a plate. (If you don't have skewers, you can cook the tofu directly on the grill pan.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp chili powder\n1 ½ tsp garlic powder\n1 ½ tsp salt"
    },
    {
      "id": 428472,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428473,
      "primary_message": "Once the pan is hot, working in batches if necessary, add the skewers and cook, turning occasionally, until the tofu is golden brown, 8-10 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 428474,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 Granny Smith apples\n3 avocados"
    },
    {
      "id": 428475,
      "primary_message": "Trim and medium dice cucumbers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 428476,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 428477,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl along with shredded cabbage and dressing, then stir to combine the slaw. ",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n½ cup ranch dressing"
    },
    {
      "id": 428478,
      "primary_message": "To serve, divide skewers and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
