  "instructions": [
    {
      "id": 428422,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 428423,
      "primary_message": "Pat chicken dry with paper towels, cut into 1-inch cubes, and season with spices. Thread onto skewers and place on a plate. (If you don't have skewers, you can cook the chicken directly on the grill pan.)",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n2 tsp chili powder\n½ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 428424,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428425,
      "primary_message": "Once the pan is hot, coat with oil; add the skewers and cook, turning occasionally, until the chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 428426,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 Granny Smith apple\n1 avocado"
    },
    {
      "id": 428427,
      "primary_message": "Using a clean cutting board, trim and medium dice cucumber. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 428428,
      "primary_message": "Quarter, core, and medium dice apple. Add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 428429,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl along with shredded cabbage and dressing, then stir to combine the slaw.",
      "secondary_message": "½ (397 g) bag shredded cabbage (coleslaw mix)\n3 tbsp ranch dressing"
    },
    {
      "id": 428430,
      "primary_message": "To serve, divide skewers and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
