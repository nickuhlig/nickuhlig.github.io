  "instructions": [
    {
      "id": 234749,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 234750,
      "primary_message": "While the grill pan heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 234751,
      "primary_message": "Once grill pan is hot, coat the bottom with oil. Add chicken and grill until cooked through and golden, flipping once, 8-10 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 234752,
      "primary_message": "Meanwhile, peel and mince garlic; place in a medium bowl. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 234753,
      "primary_message": "Add oil, fish sauce, vinegar, chili-garlic sauce, and honey to bowl with garlic; whisk to combine dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp fish sauce\n2 tsp rice vinegar\n1 tsp chili-garlic sauce\n½ tsp honey"
    },
    {
      "id": 234754,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n½ small pkg grape tomatoes\n½ English cucumber\n½ small pkg fresh mint\n½ small bunch cilantro\n½ small bunch green onions (scallions)"
    },
    {
      "id": 234755,
      "primary_message": "When the chicken is done, remove from the grill pan and transfer to a plate; cover with aluminum foil and let rest.",
      "secondary_message": null
    },
    {
      "id": 234756,
      "primary_message": "Using a julienne peeler (or regular peeler), peel the carrots into noodle-like sticks; transfer to the salad bowl. ",
      "secondary_message": null
    },
    {
      "id": 234757,
      "primary_message": "Halve the tomatoes; trim ends from the cucumber, slice lengthwise, and cut crosswise into thin half moons. Add both to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 234758,
      "primary_message": "Pick mint leaves off the stems; discard the stems and mince the leaves. Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add both to the bowl and toss the salad to combine.",
      "secondary_message": null
    },
    {
      "id": 234759,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 234760,
      "primary_message": "Roughly chop the peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 234761,
      "primary_message": "Slice the chicken crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 234762,
      "primary_message": "To serve, divide the salad between plates and top with chicken, green onions, and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
