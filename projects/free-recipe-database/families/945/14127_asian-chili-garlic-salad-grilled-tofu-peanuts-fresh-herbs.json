  "instructions": [
    {
      "id": 234693,
      "primary_message": "Peel and mince garlic; place in a large baking dish. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 234694,
      "primary_message": "Add oil, soy sauce, vinegar, chili-garlic sauce, and maple syrup to the dish with the garlic; whisk to combine the marinade.",
      "secondary_message": "⅓ cup extra virgin olive oil\n¼ cup soy sauce\n¼ cup rice vinegar\n2 tbsp chili-garlic sauce\n1 tbsp pure maple syrup"
    },
    {
      "id": 234695,
      "primary_message": "Drain and cut tofu into 1-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Place tofu in the baking dish with the marinade and turn to coat; set aside.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 234696,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n1 ½ pints grape tomatoes\n3 English cucumbers\n1 small pkg fresh mint\n1 small bunch cilantro\n1 small bunch green onions (scallions)"
    },
    {
      "id": 234697,
      "primary_message": "Using a julienne peeler (or regular peeler), peel the carrots into noodle-like sticks; transfer to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 234698,
      "primary_message": "Halve the tomatoes; trim cucumbers, slice lengthwise, and cut crosswise into thin half-moons. Add both to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 234699,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Shave cilantro leaves off the stems; discard stems and mince the leaves. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 234700,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 234701,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 234702,
      "primary_message": "Once the grill pan is hot, coat the bottom with oil. Working in batches if necessary, place marinated tofu on the grill and cook, flipping once, until charred, about 6 minutes. (Reserve remaining marinade for the salad.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 234703,
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "1 cup peanuts, roasted unsalted"
    },
    {
      "id": 234704,
      "primary_message": "Remove tofu from the grill, slice crosswise into strips, and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 234705,
      "primary_message": "Add remaining marinade from the baking dish to the bowl and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 234706,
      "primary_message": "To serve, divide the salad between plates and top with peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
