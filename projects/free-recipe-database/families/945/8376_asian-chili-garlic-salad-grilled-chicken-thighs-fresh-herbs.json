  "instructions": [
    {
      "id": 234819,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 234820,
      "primary_message": "While the grill pan heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 234821,
      "primary_message": "Once grill pan is hot, coat the bottom with oil. Working in batches if necessary, add chicken and grill until cooked through and golden, flipping once, 8-10 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 234822,
      "primary_message": "Meanwhile, peel and mince garlic; place in a large bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 234823,
      "primary_message": "Add oil, fish sauce, vinegar, and chili-garlic sauce to the bowl with garlic; whisk to combine dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp fish sauce\n2 tbsp rice vinegar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 234824,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n1 ½ small pkgs grape tomatoes\n1 ½ English cucumbers\n1 ½ small pkgs fresh mint\n1 ½ small bunches cilantro\n1 ½ small bunches green onions (scallions)"
    },
    {
      "id": 234825,
      "primary_message": "When the chicken is done, remove from the grill pan and transfer to a plate; cover with aluminum foil and let rest.",
      "secondary_message": null
    },
    {
      "id": 234826,
      "primary_message": "Using a julienne peeler (or regular peeler), peel the carrot into noodle-like sticks; transfer to the salad bowl. ",
      "secondary_message": null
    },
    {
      "id": 234827,
      "primary_message": "Halve the tomatoes; trim ends from the cucumbers, slice lengthwise, and cut crosswise into thin half moons. Add both to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 234828,
      "primary_message": "Pick mint leaves off the stems; discard the stems and mince the leaves. Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add both to the bowl and toss the salad to combine.",
      "secondary_message": null
    },
    {
      "id": 234829,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 234830,
      "primary_message": "Roughly chop the peanuts.",
      "secondary_message": "⅜ cup peanuts, roasted unsalted"
    },
    {
      "id": 234831,
      "primary_message": "Slice the chicken crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 234832,
      "primary_message": "To serve, divide the salad between plates and top with chicken, green onions, and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
