  "instructions": [
    {
      "id": 234833,
      "primary_message": "Peel and mince garlic; place in a baking dish. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 234834,
      "primary_message": "Add oil, soy sauce, vinegar, chili-garlic sauce, and maple syrup to the dish with the garlic; whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp soy sauce\n4 tsp rice vinegar\n2 tsp chili-garlic sauce\n1 tsp pure maple syrup"
    },
    {
      "id": 234835,
      "primary_message": "Drain and cut tofu into 1-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Place tofu in the baking dish with the marinade and turn to coat; set aside.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 234836,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n½ small pkg grape tomatoes\n1 English cucumber\n½ small pkg fresh mint\n½ small bunch cilantro\n½ small bunch green onions (scallions)"
    },
    {
      "id": 234837,
      "primary_message": "Using a julienne peeler (or regular peeler), peel the carrots into noodle-like sticks; transfer to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 234838,
      "primary_message": "Halve the tomatoes; trim cucumber, slice lengthwise, and cut crosswise into thin half-moons. Add both to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 234839,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Shave cilantro leaves off the stems; discard stems and mince the leaves. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 234840,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 234841,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 234842,
      "primary_message": "Once the grill pan is hot, coat the bottom with oil. Place marinated tofu on the grill and cook, flipping once, until charred, about 6 minutes. (Reserve remaining marinade for the salad.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 234843,
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 234844,
      "primary_message": "Remove tofu from the grill, slice crosswise into strips, and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 234845,
      "primary_message": "Add remaining marinade from the baking dish to the bowl and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 234846,
      "primary_message": "To serve, divide the salad between plates and top with peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
