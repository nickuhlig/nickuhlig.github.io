  "instructions": [
    {
      "id": 339659,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 339660,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 339661,
      "primary_message": "Meanwhile, place vinegar, oil, chili-garlic sauce, honey, and salt in a small bowl; whisk to combine the sauce.",
      "secondary_message": "⅓ cup rice vinegar\n⅓ cup toasted sesame oil\n3 tbsp chili-garlic sauce\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 339662,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end (or corner) firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin.",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 339663,
      "primary_message": "Cut the salmon into 1-inch cubes and thread onto the skewers; place on a plate, drizzle with half of the sauce, and turn to coat. If you don't have skewers, you can cook the salmon directly on the grill pan. (Reserve remaining sauce for later use.)",
      "secondary_message": null
    },
    {
      "id": 339664,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 339665,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add skewers and grill, turning every 1½-2 minutes, until salmon is opaque and cooked through, 6-8 minutes. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 339666,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ bunches radish\n1 ½ English cucumbers\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 339667,
      "primary_message": "Using a clean cutting board, trim and thinly slice radishes; place on another clean plate.",
      "secondary_message": null
    },
    {
      "id": 339668,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds; add to the plate with the radish and set aside.",
      "secondary_message": null
    },
    {
      "id": 339669,
      "primary_message": "Add mayo to the bowl with the reserved sauce and whisk to combine.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 339670,
      "primary_message": "To serve, divide quinoa between bowls; top with spinach, radish, cucumber, and salmon skewers. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
