  "instructions": [
    {
      "id": 339599,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 339600,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 339601,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 339602,
      "primary_message": "Meanwhile, place vinegar, oil, chili-garlic sauce, maple syrup, and salt in a small bowl; whisk to combine the sauce.",
      "secondary_message": "2 tbsp rice vinegar\n2 tbsp toasted sesame oil\n1 tbsp chili-garlic sauce\n1 tsp pure maple syrup\n¼ tsp salt"
    },
    {
      "id": 339603,
      "primary_message": "Large dice tofu, thread onto skewers, and return to the baking sheet; drizzle with half of the sauce, and turn to coat. If you don't have skewers, you can cook the tofu directly on the grill pan. (Reserve remaining sauce for later use.)",
      "secondary_message": null
    },
    {
      "id": 339604,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 339605,
      "primary_message": "Once the grill pan is hot, add skewers and grill, turning occasionally, until the tofu is lightly charred and warmed through, 6-8 minutes. Return to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 339606,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ bunch radish\n½ English cucumber\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 339607,
      "primary_message": "Trim and thinly slice radishes; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 339608,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds; add to the plate with the radish and set aside.",
      "secondary_message": null
    },
    {
      "id": 339609,
      "primary_message": "Add mayo to the bowl with the reserved sauce and whisk to combine.",
      "secondary_message": "2 tbsp vegan mayonnaise"
    },
    {
      "id": 339610,
      "primary_message": "To serve, divide quinoa between bowls; top with spinach, radish, cucumber, and tofu skewers. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
