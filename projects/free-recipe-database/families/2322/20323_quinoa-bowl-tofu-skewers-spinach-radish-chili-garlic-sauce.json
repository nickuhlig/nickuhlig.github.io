  "instructions": [
    {
      "id": 339683,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 339684,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 339685,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n473 ml chicken or vegetable broth"
    },
    {
      "id": 339686,
      "primary_message": "Meanwhile, place vinegar, oil, chili-garlic sauce, maple syrup, and salt in a small bowl; whisk to combine the sauce.",
      "secondary_message": "¼ cup rice vinegar\n¼ cup toasted sesame oil\n2 tbsp chili-garlic sauce\n2 tsp pure maple syrup\n½ tsp salt"
    },
    {
      "id": 339687,
      "primary_message": "Large dice tofu, thread onto skewers, and return to the baking sheet; drizzle with half of the sauce, and turn to coat. If you don't have skewers, you can cook the tofu directly on the grill pan. (Reserve remaining sauce for later use.)",
      "secondary_message": null
    },
    {
      "id": 339688,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 339689,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add skewers and grill, turning occasionally, until the tofu is lightly charred and warmed through, 6-8 minutes. Return to the baking sheet and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 339690,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 bunch radish\n1 English cucumber\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 339691,
      "primary_message": "Trim and thinly slice radishes; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 339692,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds; add to the plate with the radish and set aside.",
      "secondary_message": null
    },
    {
      "id": 339693,
      "primary_message": "Add mayo to the bowl with the reserved sauce and whisk to combine.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "id": 339694,
      "primary_message": "To serve, divide quinoa between bowls; top with spinach, radish, cucumber, and tofu skewers. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
