  "instructions": [
    {
      "id": 322522,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch green onions (scallions)\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 322523,
      "primary_message": "Peel and mince garlic; divide between two large bowls.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 322524,
      "primary_message": "Juice lemons into one of the bowls with the garlic. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 322525,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the dressing, whisk to combine and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 322526,
      "primary_message": "Add remaining parsley, turkey, bread crumbs, eggs, sesame seeds, oil, and spices to the second bowl with the garlic. Using your hands, mix well to combine.",
      "secondary_message": "1.02 kg ground turkey\n1 cup panko bread crumbs\n3 eggs\n¼ cup sesame seeds\n3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n¾ tsp coriander, ground\n¾ tsp paprika\n¾ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 322527,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 322528,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 322529,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 322530,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 322531,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 322532,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 322533,
      "primary_message": "Add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 322534,
      "primary_message": "To serve, divide the meatballs and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
