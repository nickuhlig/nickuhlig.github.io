  "instructions": [
    {
      "id": 322431,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch green onions (scallions)\n1 English cucumber\n1 pint grape tomatoes\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 322432,
      "primary_message": "Peel and mince garlic; divide between two medium bowls.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 322433,
      "primary_message": "Juice lemon into one of the bowls with the garlic. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 322434,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the dressing, whisk to combine and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 322435,
      "primary_message": "Add remaining parsley, turkey, almond meal, eggs, sesame seeds, oil, and spices to the second bowl with the garlic. Using your hands, mix well to combine.",
      "secondary_message": "1 ½ lb ground turkey\n¼ cup almond meal/flour\n2 eggs\n3 tbsp sesame seeds\n2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n½ tsp coriander, ground\n½ tsp paprika\n½ tsp chili powder\n½ tsp salt\n½ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 322436,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 322437,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 322438,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 322439,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 322440,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 322441,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 322442,
      "primary_message": "Add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 322443,
      "primary_message": "To serve, divide the meatballs and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
