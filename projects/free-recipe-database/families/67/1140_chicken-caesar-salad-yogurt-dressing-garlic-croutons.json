  "instructions": [
    {
      "id": 9078,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 9079,
      "primary_message": "Cube bread and transfer to a sheet pan.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 9080,
      "primary_message": "Peel and press or mince garlic. Drizzle bread with oil and sprinkle with ¾ of the garlic (save the rest for dressing), parsley flakes, salt, and pepper. Toss to coat.",
      "secondary_message": "8 cloves garlic\r\n2 tbsp extra virgin olive oil\r\n1 tsp parsley flakes\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 9081,
      "primary_message": "Place in the oven and bake until golden brown and crispy, 8-10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 9082,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 9083,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "1 lb boneless skinless chicken breasts\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 9084,
      "primary_message": "Coat grill or bottom of skillet with oil. Add chicken and cook until browned and cooked through, 2-3 minutes per side.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 9085,
      "primary_message": "Wash and dry lettuce. Halve lengthwise, then chop crosswise into 1 inch strips.",
      "secondary_message": "2 heads romaine lettuce"
    },
    {
      "id": 9086,
      "primary_message": "Grate ½ cup of Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 9087,
      "primary_message": "In a medium bowl, prepare dressing by whisking together remaining garlic, 4 tbsp of the grated Parmesan (save the rest for garnishing), yogurt, lemon juice, oil, Dijon, Worcestershire, salt, and pepper.",
      "secondary_message": "½ cup plain Greek yogurt\n½ lemon\n2 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp Worcestershire sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 9088,
      "primary_message": "Cut remaining ½ lemon into wedges. Slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 9089,
      "primary_message": "To serve, arrange a bed of lettuce on a plate and top with chicken and croutons. Drizzle with dressing, sprinkle with remaining Parmesan, and serve with lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
