  "instructions": [
    {
      "id": 406107,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 406108,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 406109,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 small bunches asparagus\n6 medium carrots\n1 ½ avocados"
    },
    {
      "id": 406110,
      "primary_message": "Peel and mince ginger and garlic. Place both in a large bowl along with soy sauce, oil, maple syrup, and chili-garlic sauce. Whisk to combine the sauce. ",
      "secondary_message": "6 cloves garlic\n⅓ cup soy sauce\n3 tbsp toasted sesame oil\n3 tbsp pure maple syrup\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 406111,
      "primary_message": "Cut tofu planks in half, then cut each half into four triangles. Add to the bowl with the sauce and turn to coat. Divide between two baking dishes and arrange in an even layer. (Wipe bowl clean and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 406112,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until tofu is golden and crispy, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 406113,
      "primary_message": "Meanwhile, place mayo, vinegar, sesame seeds, oil, soy sauce, and chili-garlic sauce in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup vegan mayonnaise\n3 tbsp rice vinegar\n3 tbsp sesame seeds\n2 tbsp toasted sesame oil\n2 tbsp soy sauce\n1 ½ tbsp chili-garlic sauce"
    },
    {
      "id": 406114,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears crosswise into thin coins. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 406115,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 406116,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 406117,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
