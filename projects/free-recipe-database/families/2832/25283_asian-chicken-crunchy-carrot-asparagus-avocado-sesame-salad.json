  "instructions": [
    {
      "id": 406224,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 406225,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 small bunches asparagus\n4 medium carrots\n1 avocado"
    },
    {
      "id": 406226,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl along with soy sauce, oil, chili-garlic sauce, and maple syrup. Whisk to combine the sauce.",
      "secondary_message": "4 cloves garlic\n¼ cup soy sauce\n4 tsp toasted sesame oil\n4 tsp chili-garlic sauce\n2 tsp pure maple syrup"
    },
    {
      "id": 406227,
      "primary_message": "Add chicken to the bowl with the sauce and turn to coat. Transfer to a large baking dish and arrange in an even layer.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 406228,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, flipping halfway though, until chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 406229,
      "primary_message": "Meanwhile, place mayo, vinegar, sesame seeds, oil, soy sauce, and chili-garlic sauce in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp rice vinegar\n2 tbsp sesame seeds\n4 tsp toasted sesame oil\n4 tsp soy sauce\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 406230,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears crosswise into thin coins. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 406231,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 406232,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 406233,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
