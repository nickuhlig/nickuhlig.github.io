  "instructions": [
    {
      "id": 406085,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 406086,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 406087,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 small bunch asparagus\n2 medium carrots\n½ avocado"
    },
    {
      "id": 406088,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl along with soy sauce, oil, maple syrup, and chili-garlic sauce. Whisk to combine the sauce. ",
      "secondary_message": "2 cloves garlic\n2 tbsp soy sauce\n1 tbsp toasted sesame oil\n1 tbsp pure maple syrup\n2 tsp chili-garlic sauce"
    },
    {
      "id": 406089,
      "primary_message": "Cut tofu planks in half, then cut each half into four triangles. Add to the bowl with the sauce and turn to coat. Transfer to a baking dish and arrange in an even layer. (Wipe bowl clean and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 406090,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until tofu is golden and crispy, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 406091,
      "primary_message": "Meanwhile, place mayo, vinegar, sesame seeds, oil, soy sauce, and chili-garlic sauce in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp vegan mayonnaise\n1 tbsp rice vinegar\n1 tbsp sesame seeds\n2 tsp toasted sesame oil\n2 tsp soy sauce\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 406092,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears crosswise into thin coins. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 406093,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 406094,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 406095,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
