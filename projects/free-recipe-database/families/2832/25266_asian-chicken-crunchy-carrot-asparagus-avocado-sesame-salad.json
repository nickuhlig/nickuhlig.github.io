  "instructions": [
    {
      "id": 406042,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 406043,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 small bunches asparagus\n6 medium carrots\n1 ½ avocados"
    },
    {
      "id": 406044,
      "primary_message": "Peel and mince ginger and garlic. Place both in a large bowl along with soy sauce, oil, chili-garlic sauce, and maple syrup. Whisk to combine the sauce.",
      "secondary_message": "6 cloves garlic\n⅓ cup soy sauce\n2 tbsp toasted sesame oil\n2 tbsp chili-garlic sauce\n1 tbsp pure maple syrup"
    },
    {
      "id": 406045,
      "primary_message": "Add chicken to the bowl with the sauce and turn to coat. Divide between two baking dishes and arrange in an even layer.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 406046,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and roast, flipping halfway though, until chicken is cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 406047,
      "primary_message": "Meanwhile, place mayo, vinegar, sesame seeds, oil, soy sauce, and chili-garlic sauce in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n3 tbsp rice vinegar\n3 tbsp sesame seeds\n2 tbsp toasted sesame oil\n2 tbsp soy sauce\n1 ½ tbsp chili-garlic sauce"
    },
    {
      "id": 406048,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears crosswise into thin coins. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 406049,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 406050,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 406051,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
