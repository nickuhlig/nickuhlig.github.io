  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thaw the frozen puff pastry but very cold. Chop the wild mixed mushrooms to a rubble.",
      "secondary_message": "1 sheet frozen puff pastry\n8 oz wild mixed mushrooms"
    },
    {
      "id": 1,
      "primary_message": "Preheat the oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Lightly flour a cutting board, and place the pastry on it. Cut out 9 circles from the pastry using a 2.5-inch biscuit cutter. Use a 1.5-inch biscuit cutter to make an indent (not all the way through) in the center of each pastry circle.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake the puff pastry for 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Meanwhile, make the mushroom filling mixture. Melt the butter in a wide sauté pan. Add the mushrooms, garlic, and thyme. Sauté the mixture over medium heat for about 4 minutes, until the mushrooms have greatly shrunk in size and the pan has dried out. Season with salt and pepper, and add the wine. Allow to reduce. Remove the garlic and thyme stems from the pan, and take the pan off the heat. Stir in the crème fraîche.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Use a paring knife to gently remove the center disc from each puff pastry shell. Reserve. Fill the cavity with the mushroom mixture, and replace the pastry disc.",
      "secondary_message": null
    }
  ],
