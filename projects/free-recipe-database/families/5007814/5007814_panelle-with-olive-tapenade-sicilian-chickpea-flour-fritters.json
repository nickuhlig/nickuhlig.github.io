  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the parsley leaves from the stems and mince them. Mince the garlic. Rinse the anchovy fillets if packed in oil. Juice the lemon. Pick the parsley leaves from the stems and chop them.",
      "secondary_message": "2 tbsp parsley\n2 cloves garlic\n4 anchovy fillets\n½ lemon\n1 tbsp parsley"
    },
    {
      "id": 1,
      "primary_message": "In a medium saucepan, whisk together water and chickpea flour until combined and free of lumps. Whisk in salt and pepper. Turn heat to medium. Stir mixture with a wooden spoon until it has thickened to the same consistency as polenta, about 8 minutes. Stir in herbs and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using a spatula, spread dough over bottom of a baking sheet. The layer should be about 1/4 inch thick. Let dough cool to room temperature.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, place olives, garlic, capers, anchovies, and lemon juice in food processor. Pulse until olives are finely chopped, about ten pulses. While the motor is running, add the olive oil. Continue to pulse until almost smooth, about ten seconds. Scoop tapenade into a bowl for serving. Garnish with parsley. Set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When dough has cooled, cut it into long, thin triangles. Heat olive oil in a large sauté pan over medium high heat. Fry panelle in batches, turning over once. The panelle are done when they’ve puffed up and turned golden, about two minutes per side. Serve hot with tapenade.",
      "secondary_message": null
    }
  ],
