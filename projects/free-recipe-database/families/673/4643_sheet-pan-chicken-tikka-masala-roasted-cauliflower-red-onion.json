  "instructions": [
    {
      "id": 175087,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 175088,
      "primary_message": "Peel and mince or grate the ginger. Peel and mince or press the garlic. Set half of the garlic aside. ",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n2 cloves garlic"
    },
    {
      "id": 175089,
      "primary_message": "In a medium bowl, combine ginger, tomato paste, cumin, paprika, cayenne, and salt, with half of the garlic, and yogurt. Add chicken and toss to coat. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n½ tbsp tomato paste\n½ tsp cumin\n¼ tsp paprika\n¼ tsp cayenne pepper\n½ tsp salt\n0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 175090,
      "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stems into smaller pieces; transfer to a sheet pan. Peel and cut onion into ½-inch pieces; add to the sheet pan with the cauliflower. ",
      "secondary_message": "½ medium head cauliflower\n½ medium red onion"
    },
    {
      "id": 175091,
      "primary_message": "Toss cauliflower and onion on the pan with oil and season with salt and pepper. Arrange in a single layer and place in the oven. Roast until the cauliflower is fork-tender (about 18-20 minutes). ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 175092,
      "primary_message": "Transfer the chicken to a sheet pan, spreading the pieces out in a single layer. Place the pan in the oven and roast until cooked through (18-20 minutes). ",
      "secondary_message": null
    },
    {
      "id": 175093,
      "primary_message": "Meanwhile, combine olive oil, paprika, cumin, salt, and remaining yogurt and garlic in a medium small bowl.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tsp extra virgin olive oil\n½ tsp paprika\n½ tsp cumin\n¼ tsp salt"
    },
    {
      "id": 175094,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Once cooked, remove the cauliflower from the oven and toss with fresh parsley. ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 175095,
      "primary_message": "To serve, arrange the chicken and vegetables on plates, and top chicken with a dollop of yogurt sauce. Enjoy!",
      "secondary_message": null
    }
  ],
