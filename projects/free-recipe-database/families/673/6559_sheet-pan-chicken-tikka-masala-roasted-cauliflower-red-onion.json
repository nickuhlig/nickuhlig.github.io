  "instructions": [
    {
      "id": 175078,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 175079,
      "primary_message": "Peel and mince or grate the ginger. Peel and mince or press the garlic. Set half of the garlic aside. ",
      "secondary_message": "3 (1 inch) pieces ginger root\n6 cloves garlic"
    },
    {
      "id": 175080,
      "primary_message": "In a large bowl, combine ginger, tomato paste, cumin, paprika, cayenne, and salt, with half of the garlic, and yogurt. Add chicken and toss to coat. ",
      "secondary_message": "1 cup plain Greek yogurt\n1 ½ tbsp tomato paste\n1 ½ tsp cumin\n¾ tsp paprika\n¾ tsp cayenne pepper\n1 ½ tsp salt\n3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 175081,
      "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stems into smaller pieces; transfer to a sheet pan. Peel and cut onion into ½-inch pieces; add to the sheet pan with the cauliflower. ",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ medium red onions"
    },
    {
      "id": 175082,
      "primary_message": "Toss cauliflower and onion on the pan with oil and season with salt and pepper. Arrange in a single layer and place in the oven.  Roast until the cauliflower is fork-tender (about 18-20 minutes). ",
      "secondary_message": "⅓ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 175083,
      "primary_message": "Transfer the chicken to a sheet pan, spreading the pieces out in a single layer. Place the pan in the oven and roast until cooked through (18- 20minutes). ",
      "secondary_message": null
    },
    {
      "id": 175084,
      "primary_message": "Meanwhile, combine olive oil, paprika, cumin, salt, and remaining yogurt and garlic in a medium bowl. ",
      "secondary_message": "1 cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n1 ½ tsp paprika\n1 ½ tsp cumin\n¾ tsp salt"
    },
    {
      "id": 175085,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Once cooked, remove the cauliflower from the oven and toss with fresh parsley. ",
      "secondary_message": "¾ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 175086,
      "primary_message": "To serve, arrange the chicken and vegetables on plates, and top chicken with a dollop of yogurt sauce. Enjoy!",
      "secondary_message": null
    }
  ],
