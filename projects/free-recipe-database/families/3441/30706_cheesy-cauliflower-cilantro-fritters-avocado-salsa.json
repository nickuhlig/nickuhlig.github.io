  "instructions": [
    {
      "id": 489075,
      "primary_message": "Place riced cauliflower in the colander or strainer and rinse under hot, running water (from the tap) to defrost. Use your hands or the back of a spoon to press out as much water as possible from the cauliflower, then transfer to a medium bowl.",
      "secondary_message": "1 (12 oz) bag frozen, riced cauliflower"
    },
    {
      "id": 489076,
      "primary_message": "Wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the cauliflower.",
      "secondary_message": "¼ small bunch cilantro"
    },
    {
      "id": 489077,
      "primary_message": "Add egg, cheese, and spices to the bowl. Stir well to combine the batter.",
      "secondary_message": "1 egg\n⅔ cup shredded cheese, Mexican blend\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 489078,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": null
    },
    {
      "id": 489079,
      "primary_message": "Using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; press down with a spatula to form round, ½-inch thick fritters. Cook, carefully flipping once (the fritters are delicate but will firm up as they finish cooking on the other side), until fritters are golden brown, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 489080,
      "primary_message": "Meanwhile, wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": "½ avocado"
    },
    {
      "id": 489081,
      "primary_message": "To serve, divide fritters between plates; top with avocado and salsa. Enjoy!",
      "secondary_message": "¼ cup salsa"
    }
  ],
