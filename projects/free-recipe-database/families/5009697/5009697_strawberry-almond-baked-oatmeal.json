  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the almonds. Hull and quarter the strawberries. Melt the unsalted butter.",
      "secondary_message": "½ cup almonds\n1 ¼ lb strawberries\n2 tbsp (1 oz) unsalted butter, plus extra for greasing dish"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Lightly grease shallow 2-quart baking dish. Scatter oats, almonds, and strawberries into baking dish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk 1/3 cup plus 2 tablespoons brown sugar, salt, cinnamon, egg, milk, and melted butter in medium bowl until combined. Pour into baking dish. Using spoon, gently press oats into liquid to moisten evenly.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Scatter remaining tablespoon brown sugar over top and bake until center is just set, about 30 minutes. Serve immediately, passing extra brown sugar at the table.",
      "secondary_message": null
    }
  ],
