  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the large stems from the spinach. Peel and crush the garlic. Drain the jar of marinated artichokes.",
      "secondary_message": "10 oz spinach\n6 cloves garlic\n1 oz jar of marinated artichokes"
    },
    {
      "id": 1,
      "primary_message": "Heat olive oil on medium-low heat, then add spinach. Add a good pinch of salt and stir often until the spinach wilts down. Let it cook till it becomes glossy, limp, and feathery in texture.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the garlic and cook another minute or two, just until the raw taste is cooked out. Then add the artichokes to heat them through, which allows their brine to easily mix with the olive oil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer the mixture to a food processor and add the yogurt and lemon juice. Pulse six to nine times or until just combined. Add additional salt and lemon juice if need be, then serve immediately or at room temperature.",
      "secondary_message": null
    }
  ],
