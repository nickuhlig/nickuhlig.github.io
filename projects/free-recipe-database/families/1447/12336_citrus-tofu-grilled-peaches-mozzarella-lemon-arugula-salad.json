  "instructions": [
    {
      "id": 207207,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 peaches\n3 lemons\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 207208,
      "primary_message": "Zest and juice half the lemons into a large baking dish. Add oil and spices, then whisk to combine the marinade. Set remaining lemons aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp paprika\n¾ tsp garlic powder\n¾ tsp cumin\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 207209,
      "primary_message": "Drain and cut tofu into 1-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Place tofu in the baking dish with the marinade and turn to coat; set aside.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 207210,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 207211,
      "primary_message": "While the grill pan heats up, halve the peaches lengthwise (around the pit) and twist the halves to separate. Remove and discard pits.",
      "secondary_message": null
    },
    {
      "id": 207212,
      "primary_message": "Once the grill pan is hot, coat with oil. Grill peach halves, cut-side down, until lightly charred, 2-3 minutes. Remove to a cutting board.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 207213,
      "primary_message": "Meanwhile, juice remaining lemons into a large bowl; add oil, maple syrup, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp pure maple syrup\n2 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 207214,
      "primary_message": "Coat the grill pan with additional oil. Working in batches if necessary, place tofu on the grill and cook, until charred on one side, 3-5 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 207215,
      "primary_message": "While the tofu cooks, slice mozzarella into rounds.",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 207216,
      "primary_message": "Thinly slice grilled peaches.",
      "secondary_message": null
    },
    {
      "id": 207217,
      "primary_message": "Flip the tofu, top with mozzarella and peach slices, and continue to grill until the cheese is melted and tofu is warmed through, about 2 minutes. Remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 207218,
      "primary_message": "Add arugula to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 207219,
      "primary_message": "To serve, divide salad and grilled tofu between plates. Enjoy!",
      "secondary_message": null
    }
  ],
