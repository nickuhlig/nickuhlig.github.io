  "instructions": [
    {
      "id": 207169,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 peaches\n3 lemons\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 207170,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 207171,
      "primary_message": "While the grill pan heats up, halve the peaches lengthwise (around the pit) and twist the halves to separate. Remove and discard pits.",
      "secondary_message": null
    },
    {
      "id": 207172,
      "primary_message": "Once the grill pan is hot, coat with oil. Grill peach halves, cut-side down, until lightly charred, 2-3 minutes. Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 207173,
      "primary_message": "Meanwhile, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 207174,
      "primary_message": "Coat the grill pan with additional oil. Working in batches if necessary, place chicken on the grill and cook, until charred on one side and almost cooked through, 3-5 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 207175,
      "primary_message": "While the chicken cooks, using a clean cutting board, slice mozzarella into rounds.",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 207176,
      "primary_message": "Thinly slice grilled peaches.",
      "secondary_message": null
    },
    {
      "id": 207177,
      "primary_message": "Flip the chicken, top with mozzarella and peach slices, and continue to grill until the cheese is melted and chicken is cooked through, about 2 minutes. Remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 207178,
      "primary_message": "Meanwhile, juice lemons into a large bowl; add oil, maple syrup, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp pure maple syrup\n2 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 207179,
      "primary_message": "Add arugula to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 207180,
      "primary_message": "To serve, divide salad and grilled chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
