  "instructions": [
    {
      "id": 464888,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg chives\n½ lemon\n1 Gala apple\n1 head butter (Boston) lettuce"
    },
    {
      "id": 464889,
      "primary_message": "Chop chives into small pieces. Place half in a medium bowl (set remaining chives aside for serving).",
      "secondary_message": null
    },
    {
      "id": 464890,
      "primary_message": "Zest and juice lemon into the bowl with the chives. ",
      "secondary_message": null
    },
    {
      "id": 464891,
      "primary_message": "Peel and mince garlic. Add to the bowl. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 464892,
      "primary_message": "Drain and rinse beans. Add to the bowl along with tahini, oil, and spices. Using a fork or potato masher, roughly mash the beans until semi-smooth. Set aside. ",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans\n1 tbsp tahini\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 464893,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 464894,
      "primary_message": "Place oil, vinegar, Dijon, maple syrup, salt, and pepper in another medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 464895,
      "primary_message": "Quarter, core, and thinly slice apple. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464896,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464897,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, 2-3 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 464898,
      "primary_message": "Divide toast between plates, spread with smashed beans, and sprinkle with reserved chives. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
