  "instructions": [
    {
      "id": 464943,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg chives\n1 ½ lemons\n3 Gala apples\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 464944,
      "primary_message": "Chop chives into small pieces. Place half in a large bowl (set remaining chives aside for serving).",
      "secondary_message": null
    },
    {
      "id": 464945,
      "primary_message": "Zest and juice lemons into the bowl with the chives. ",
      "secondary_message": null
    },
    {
      "id": 464946,
      "primary_message": "Peel and mince garlic. Add to the bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 464947,
      "primary_message": "Drain and rinse beans. Add to the bowl along with tahini, oil, and spices. Using a fork or potato masher, roughly mash the beans until semi-smooth. Set aside. ",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans\n3 tbsp tahini\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 464948,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 464949,
      "primary_message": "Place oil, vinegar, Dijon, maple syrup, salt, and pepper in another large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464950,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464951,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464952,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, 2-3 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 464953,
      "primary_message": "Divide toast between plates, spread with smashed beans, and sprinkle with reserved chives. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
