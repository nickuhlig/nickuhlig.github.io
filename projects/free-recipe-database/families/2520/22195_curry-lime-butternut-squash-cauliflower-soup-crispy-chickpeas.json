  "instructions": [
    {
      "id": 371718,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 371719,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small butternut squash\n½ medium head cauliflower\n1 lime\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 371720,
      "primary_message": "Peel, halve, and small dice onion. Place in a medium bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 371721,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 371722,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 371723,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 371724,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, curry powder, and salt; cook, stirring occasionally, until starting to brown, about 15 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp curry powder\n½ tsp salt"
    },
    {
      "id": 371725,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Transfer to a baking sheet pan and pat dry with paper towels. ",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 371726,
      "primary_message": "Add whole (unpeeled) garlic cloves to the baking sheet with the chickpeas. Drizzle with oil, then season with curry powder and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 cloves garlic\n1 tbsp extra virgin olive oil\n2 tsp curry powder\n¼ tsp salt"
    },
    {
      "id": 371727,
      "primary_message": "Place baking sheet in the oven and roast, stirring chickpeas halfway through, until crispy and golden, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 371728,
      "primary_message": "When the veggies in the saucepan are starting to brown, add broth and coconut milk; bring to a simmer. Once simmering, reduce heat to medium and continue to cook, stirring occasionally, until veggies are very tender, about 10 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n½ (398 ml) can coconut milk"
    },
    {
      "id": 371729,
      "primary_message": "Meanwhile, zest and juice half of the lime into the reserved bowl. (Cut remaining lime into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 371730,
      "primary_message": "Peel and mince ginger. Add to the bowl with the lime zest and juice.",
      "secondary_message": null
    },
    {
      "id": 371731,
      "primary_message": "When the chickpeas and garlic are done, remove from oven. Carefully transfer roasted garlic to the cutting board. Using the back of a spoon, press on the cloves to remove the skins; add garlic to the bowl. Set aside the crispy chickpeas.",
      "secondary_message": null
    },
    {
      "id": 371732,
      "primary_message": "Once the veggies are tender, remove soup from heat. Add lime, ginger, and roasted garlic to the pan. Use a hand blender to purée the soup until smooth. Alternatively, use a potato masher to crush the veggies (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 371733,
      "primary_message": "Divide the soup between bowls and top with crispy chickpeas. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
