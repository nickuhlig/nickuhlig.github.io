  "instructions": [
    {
      "id": 371750,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 371751,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n1 ½ medium heads cauliflower\n3 limes\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 371752,
      "primary_message": "Peel, halve, and small dice onions. Place in a large bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 371753,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 371754,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 371755,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 371756,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, curry powder, and salt; cook, stirring occasionally, until starting to brown, about 20 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tbsp curry powder\n1 ½ tsp salt"
    },
    {
      "id": 371757,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Divide between two baking sheet pans and pat dry with paper towels.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 371758,
      "primary_message": "Add whole (unpeeled) garlic cloves to the baking sheets with the chickpeas. Drizzle with oil, then season with curry powder and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "9 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp curry powder\n¾ tsp salt"
    },
    {
      "id": 371759,
      "primary_message": "Place baking sheets in the oven and roast, stirring chickpeas halfway through, until crispy and golden, about 18 minutes.",
      "secondary_message": null
    },
    {
      "id": 371760,
      "primary_message": "When the veggies in the pot are starting to brown, add broth and coconut milk; bring to a simmer. Once simmering, reduce heat to medium and continue to cook, stirring occasionally, until veggies are very tender, about 10 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk"
    },
    {
      "id": 371761,
      "primary_message": "Meanwhile, zest and juice half of the limes into the reserved bowl. (Cut remaining limes into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 371762,
      "primary_message": "Peel and mince ginger. Add to the bowl with the lime zest and juice.",
      "secondary_message": null
    },
    {
      "id": 371763,
      "primary_message": "When the chickpeas and garlic are done, remove from oven. Carefully transfer roasted garlic to the cutting board. Using the back of a spoon, press on the cloves to remove the skins; add garlic to the bowl. Set aside the crispy chickpeas.",
      "secondary_message": null
    },
    {
      "id": 371764,
      "primary_message": "Once the veggies are tender, remove soup from heat. Add lime, ginger, and roasted garlic to the pot. Use a hand blender to purée the soup until smooth. Alternatively, use a potato masher to crush the veggies (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 371765,
      "primary_message": "Divide the soup between bowls and top with crispy chickpeas. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
