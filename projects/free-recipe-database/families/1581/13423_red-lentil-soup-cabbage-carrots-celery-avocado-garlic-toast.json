  "instructions": [
    {
      "id": 296188,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n½ medium head napa cabbage\n½ avocado"
    },
    {
      "id": 296189,
      "primary_message": "Peel, trim, and small dice carrot. Trim and small dice celery; transfer both to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 296190,
      "primary_message": "Peel and small dice onion. Peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 296191,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 296192,
      "primary_message": "Meanwhile, place lentils in the colander, rinse, and set aside to drain.",
      "secondary_message": "½ cup red lentils, dried"
    },
    {
      "id": 296193,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices to the pan; cook, stirring occasionally, until veggies are softened, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 296194,
      "primary_message": "While the veggies cook, trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 296195,
      "primary_message": "Add cabbage, lentils, and broth to the pan; stir to combine, cover, and bring to a simmer. Reduce heat to medium-low and continue to simmer, stirring occasionally, until lentils and vegetables are tender, about 15 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 296196,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 296197,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 296198,
      "primary_message": "Slice buns in half and place, cut-side up, on a baking sheet pan. Drizzle with oil and sprinkle with garlic and spices.",
      "secondary_message": "2 whole grain buns or rolls\n2 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 296199,
      "primary_message": "Place buns in the oven and toast until golden, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 296200,
      "primary_message": "Halve and pit the avocado; slice thinly while still in skin, then scoop out with a spoon. Arrange avocado slices on top of the garlic toast.",
      "secondary_message": null
    },
    {
      "id": 296201,
      "primary_message": "Divide soup between bowls and serve with avocado-garlic toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
