  "instructions": [
    {
      "id": 296345,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n1 ½ medium heads napa cabbage\n1 ½ avocados"
    },
    {
      "id": 296346,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery; transfer both to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 296347,
      "primary_message": "Peel and small dice onions. Peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 296348,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 296349,
      "primary_message": "Meanwhile, place lentils in the colander, rinse, and set aside to drain.",
      "secondary_message": "1 ½ cup red lentils, dried"
    },
    {
      "id": 296350,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices to the pot; cook, stirring occasionally, until veggies are softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 296351,
      "primary_message": "While the veggies cook, trim off and discard the root end of each cabbage; halve lengthwise, then thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 296352,
      "primary_message": "Add cabbage, lentils, and broth to the pot; stir to combine, cover, and bring to a simmer. Reduce heat to medium-low and continue to simmer, stirring occasionally, until lentils and vegetables are tender, 15-20 minutes.",
      "secondary_message": "2129 ml chicken or vegetable broth"
    },
    {
      "id": 296353,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 296354,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 296355,
      "primary_message": "Slice buns in half and divide between two baking sheet pans, cut-side up. Drizzle with oil and sprinkle with garlic and spices.",
      "secondary_message": "6 whole grain buns or rolls\n2 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 296356,
      "primary_message": "Working in batches, place buns in the oven and toast until golden, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 296357,
      "primary_message": "Halve and pit the avocados; slice thinly while still in skin, then scoop out with a spoon. Arrange avocado slices on top of the garlic toast.",
      "secondary_message": null
    },
    {
      "id": 296358,
      "primary_message": "Divide soup between bowls and serve with avocado-garlic toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
