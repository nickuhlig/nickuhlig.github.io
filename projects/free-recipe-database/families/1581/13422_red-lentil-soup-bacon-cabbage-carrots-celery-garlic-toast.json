  "instructions": [
    {
      "id": 296173,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n1 ½ medium heads napa cabbage"
    },
    {
      "id": 296174,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery; transfer both to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 296175,
      "primary_message": "Peel and small dice onions. Peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 296176,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 296177,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 296178,
      "primary_message": "When the pot is hot, add bacon and cook, stirring often, until bacon has released its fat and is starting to brown, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 296179,
      "primary_message": "Meanwhile, place lentils in a colander, rinse, and set aside to drain.",
      "secondary_message": "1 ½ cup red lentils, dried"
    },
    {
      "id": 296180,
      "primary_message": "Add veggies and spices to the pot; cook, stirring occasionally, until veggies are softened, 5-6 minutes.",
      "secondary_message": "1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 296181,
      "primary_message": "While the veggies cook, using a clean cutting board, trim off and discard the root end of each cabbage; halve lengthwise, then thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 296182,
      "primary_message": "Add cabbage, lentils, and broth to the pot; stir to combine, cover, and bring to a simmer. Reduce heat to medium-low and continue to simmer, stirring occasionally, until lentils are tender, 15-20 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 296183,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 296184,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 296185,
      "primary_message": "Slice buns in half and divide between two baking sheet pans, cut-side up. Drizzle with oil and sprinkle with garlic and spices.",
      "secondary_message": "6 whole grain buns or rolls\n2 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 296186,
      "primary_message": "Working in batches, place buns in the oven and toast until golden, 1-2 minutes. Remove from oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 296187,
      "primary_message": "Divide soup between bowls and serve with toasted buns on the side. Enjoy!",
      "secondary_message": null
    }
  ],
