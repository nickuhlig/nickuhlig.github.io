  "instructions": [
    {
      "id": 296287,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 medium head napa cabbage"
    },
    {
      "id": 296288,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery; transfer both to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 296289,
      "primary_message": "Peel and small dice onion. Peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 296290,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 296291,
      "primary_message": "While the pot heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 296292,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring often, until bacon has released its fat and is starting to brown, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 296293,
      "primary_message": "Meanwhile, place lentils in a colander, rinse, and set aside to drain.",
      "secondary_message": "1 cup red lentils, dried"
    },
    {
      "id": 296294,
      "primary_message": "Add veggies and spices to the pot; cook, stirring occasionally, until veggies are softened, about 5 minutes.",
      "secondary_message": "1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 296295,
      "primary_message": "While the veggies cook, using a clean cutting board, trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 296296,
      "primary_message": "Add cabbage, lentils, and broth to the pot; stir to combine, cover, and bring to a simmer. Reduce heat to medium-low and continue to simmer, stirring occasionally, until lentils are tender, about 15 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth"
    },
    {
      "id": 296297,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 296298,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 296299,
      "primary_message": "Slice buns in half and place, cut-side up, on a large baking sheet pan. Drizzle with oil and sprinkle with garlic and spices.",
      "secondary_message": "4 whole grain buns or rolls\n4 tsp extra virgin olive oil\n½ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 296300,
      "primary_message": "Place buns in the oven and toast until golden, 1-2 minutes. Remove from oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 296301,
      "primary_message": "Divide soup between bowls and serve with toasted buns on the side. Enjoy!",
      "secondary_message": null
    }
  ],
