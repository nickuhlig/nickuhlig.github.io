  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to center position and preheat oven to 450°F. Toss strawberries with 6 tablespoons sugar in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place flour in a large bowl. Whisk in 1 tablespoon sugar. Stirring with a wooden spoon, drizzle in 3/4 cup cream. Stir until a lumpy dough is formed. Do not overmix.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a 1-ounce cookie scoop, scoop balls of dough onto a parchment-lined baking sheet, spacing them 2 inches apart. Brush tops with cream and bake until golden brown, about 12 minutes. Remove biscuits and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Using a wire whisk or an electric mixer, whip remaining cream with remaining tablespoon sugar and vanilla extract until stiff peaks form. Split biscuits, top with strawberries and cream, close shortcakes, top with more whipped cream, and serve immediately.",
      "secondary_message": null
    }
  ],
