  "instructions": [
    {
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\nsalt\nblack pepper"
    },
    {
      "primary_message": "Add oil to skillet and swirl to coat bottom. Add chicken and cook until browned and cooked through, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "virgin coconut oil"
    },
    {
      "primary_message": "Peel and mince shallots.",
      "secondary_message": "3 shallots"
    },
    {
      "primary_message": "Once chicken has been transferred, reduce heat to medium. Add more oil and shallots; cook, stirring frequently, until softened, 2-3 minutes.",
      "secondary_message": "virgin coconut oil"
    },
    {
      "primary_message": "Add broth and vinegar; scrape skillet to loosen any browned bits. Cook, stirring occasionally, until the liquid is reduced by about half, 4-5 minutes.",
      "secondary_message": "12 fl oz (1 ½ cup) chicken or vegetable broth\n6 tbsp white wine vinegar"
    },
    {
      "primary_message": "Add Dijon and oil; stir until well combined and continue cooking for 1-2 minutes. Remove from heat and season with salt and freshly ground pepper.",
      "secondary_message": "3 tbsp Dijon mustard\nvirgin coconut oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Wash and dry spinach.",
      "secondary_message": "3 (5 oz) pkg baby spinach"
    },
    {
      "primary_message": "To serve, arrange spinach and chicken on a plate; drizzle with mustard sauce and enjoy!",
      "secondary_message": null
    }
  ],
