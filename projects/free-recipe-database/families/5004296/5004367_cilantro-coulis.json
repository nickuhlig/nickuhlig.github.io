  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Wash the cilantro, then thickly remove the stems. Blend the 0.25% of total of the Xanthan gum ingredients above.",
      "secondary_message": "1 bunch cilantro\nXanthan gum"
    },
    {
      "id": 1,
      "primary_message": "Weigh blender on scale and note weight in grams.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Blanch cilantro in boiling water for 30 seconds, then rinse in cold water until cool. Add to blender with just enough water to blend to a smooth purée, then add small amounts of lime juice, aleppo, salt, and sugar to taste and blend till smooth.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer blender and purée to scale and subtract weight of blender from total weight. Multiply weight of liquid by 0.0025 and measure out that amount of xanthan gum. Add to blender and blend till smooth. Pour through a fine mesh strainer and serve as a finishing sauce or garnish.",
      "secondary_message": null
    }
  ],
