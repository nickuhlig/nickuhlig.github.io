  "instructions": [
    {
      "id": 25804,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 25805,
      "primary_message": "Peel and finely dice the shallots. Grate zest from the lemon. In a large bowl, prepare the dressing by whisking together the shallot, lemon zest and juice, olive oil, salt, and pepper. Set aside.",
      "secondary_message": "2 shallots\r\nzest and juice of 1 lemon\r\n4 tbsp extra virgin olive oil\r\n½ tsp Dijon mustard\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25806,
      "primary_message": "Wash the green beans, trim ends, and halve.",
      "secondary_message": "0.68 kg green beans"
    },
    {
      "id": 25807,
      "primary_message": "Add the green beans to the boiling water and cook until bright green and tender-crisp, 3-4 minutes. Drain in a colander and rinse with cold water to prevent further cooking. Set aside to drain and cool.",
      "secondary_message": ""
    },
    {
      "id": 25808,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 25809,
      "primary_message": "Season the steak with salt and pepper on both sides.",
      "secondary_message": "0.68 kg ribeye steak\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25810,
      "primary_message": "Coat the grill or skillet with oil. Add the steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 25811,
      "primary_message": "Wash the tomatoes and parsley. Halve the tomatoes and add to the dressing. Shave the parsley leaves off the stems; discard the stems, mince the leaves, and add to the bowl.",
      "secondary_message": "1 small pkg grape tomatoes\r\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 25812,
      "primary_message": "Add the green beans to the bowl and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 25813,
      "primary_message": "To serve, place the steak and salad on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
