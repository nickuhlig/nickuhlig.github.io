  "instructions": [
    {
      "id": 425653,
      "primary_message": "Preheat oven to 400°F. Coat a baking sheet pan with a thin layer of oil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 425654,
      "primary_message": "Cut tofu into ½-inch thick slices along the short side. Sandwich tofu between clean towels or paper towels and place on another baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 425655,
      "primary_message": "Place mayo, garlic powder, and salt in a medium bowl; stir to combine.",
      "secondary_message": "2 tbsp mayonnaise\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 425656,
      "primary_message": "Place Parmesan, bread crumbs, and paprika in another medium bowl. Stir to combine the coating.",
      "secondary_message": "⅓ cup Parmesan cheese, shredded\n¼ cup panko bread crumbs\n¼ tsp paprika"
    },
    {
      "id": 425657,
      "primary_message": "Cut each tofu slice crosswise into 1-inch sticks.",
      "secondary_message": null
    },
    {
      "id": 425658,
      "primary_message": "Working in batches, add a few tofu sticks to the bowl with the mayo mixture and turn to coat. Next, dredge in the bread crumb coating, pressing to adhere. Transfer to the oiled baking sheet and drizzle with more oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 425659,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until sticks start to turn golden, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 425660,
      "primary_message": "Meanwhile, wash, dry, and trim green beans. Set aside.",
      "secondary_message": "¾ lb green beans"
    },
    {
      "id": 425661,
      "primary_message": "When the tofu sticks are golden, remove from the oven and flip. Return to the oven and continue to bake until golden brown, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 425662,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 425663,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green beans and salt; cook, stirring occasionally, until tender-crisp, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 425664,
      "primary_message": "Divide tofu sticks and green beans between plates. Serve with a side of dressing for dipping. Enjoy!",
      "secondary_message": "¼ cup honey mustard dressing"
    }
  ],
