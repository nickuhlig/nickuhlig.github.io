  "instructions": [
    {
      "id": 425780,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a large baking sheet pan with a thin layer of oil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 425781,
      "primary_message": "Place mayo, garlic powder, and salt in a large bowl; stir to combine.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 425782,
      "primary_message": "Place Parmesan, bread crumbs, and paprika in another large bowl. Stir to combine the coating.",
      "secondary_message": "1 cup Parmesan cheese, shredded\n¾ cup panko bread crumbs\n¾ tsp paprika"
    },
    {
      "id": 425783,
      "primary_message": "Pat chicken dry with paper towels and slice into ¾-inch tenders. Add to the bowl with the mayo mixture and toss to coat.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 425784,
      "primary_message": "Working in batches, dredge tenders in the bread crumb coating, pressing to adhere. Transfer to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 425785,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until tenders start to turn golden, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 425786,
      "primary_message": "While the tenders are baking, wash, dry, and using a clean cutting board, trim green beans. Set aside.",
      "secondary_message": "1.02 kg green beans"
    },
    {
      "id": 425787,
      "primary_message": "When the chicken is golden, flip and continue to bake until cooked through, 8-10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 425788,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 425789,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add green beans and salt; cook, stirring occasionally, until tender-crisp, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 425790,
      "primary_message": "Divide chicken tenders and green beans between plates. Serve with a side of dressing for dipping. Enjoy!",
      "secondary_message": "¾ cup honey mustard dressing"
    }
  ],
