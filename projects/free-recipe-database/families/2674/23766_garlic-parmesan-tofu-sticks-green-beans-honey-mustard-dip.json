  "instructions": [
    {
      "id": 425677,
      "primary_message": "Preheat oven to 400°F. Coat a large baking sheet pan with a thin layer of oil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 425678,
      "primary_message": "Cut tofu into ½-inch thick slices along the short side. Sandwich tofu between clean towels or paper towels and place on another large baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 425679,
      "primary_message": "Place mayo, garlic powder, and salt in a large bowl; stir to combine.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 425680,
      "primary_message": "Place Parmesan, bread crumbs, and paprika in another large bowl. Stir to combine the coating.",
      "secondary_message": "1 cup Parmesan cheese, shredded\n¾ cup panko bread crumbs\n¾ tsp paprika"
    },
    {
      "id": 425681,
      "primary_message": "Cut each tofu slice crosswise into 1-inch sticks.",
      "secondary_message": null
    },
    {
      "id": 425682,
      "primary_message": "Working in batches, add a few tofu sticks to the bowl with the mayo mixture and turn to coat. Next, dredge in the bread crumb coating, pressing to adhere. Transfer to the oiled baking sheet and drizzle with more oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 425683,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until sticks start to turn golden, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 425684,
      "primary_message": "Meanwhile, wash, dry, and trim green beans. Set aside.",
      "secondary_message": "2 ¼ lb green beans"
    },
    {
      "id": 425685,
      "primary_message": "When the tofu sticks are golden, remove from the oven and flip. Return to the oven and continue to bake until golden brown, 5-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 425686,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 425687,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add green beans and salt; cook, stirring occasionally, until tender-crisp, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 425688,
      "primary_message": "Divide tofu sticks and green beans between plates. Serve with a side of dressing for dipping. Enjoy!",
      "secondary_message": "¾ cup honey mustard dressing"
    }
  ],
