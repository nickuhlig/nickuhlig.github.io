  "instructions": [
    {
      "id": 189733,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 189734,
      "primary_message": "Drain shrimp in a colander and rinse under cold water until there are no more ice chunks. Spread out on a clean towel and pat dry. Skip this step if you are using fresh shrimp.",
      "secondary_message": "0.23 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 189735,
      "primary_message": "Wash the asparagus and snap (or cut) off the woody ends. Cut into 1-inch pieces and transfer to a baking sheet; drizzle with olive oil and bake in the oven for 10-12 minutes. ",
      "secondary_message": "½ small bunch asparagus\n½ tsp extra virgin olive oil"
    },
    {
      "id": 189736,
      "primary_message": "To make crisps, line a baking sheet with parchment paper and grate Parmesan cheese. Measure out 1 tbsp of the grated Parmesan and place in a pile on the sheet. Repeat with remaining cheese, keeping the piles a few inches apart. ",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 189737,
      "primary_message": "Place in the oven and bake until lightly browned, 5-7 minutes. Watch carefully because they can burn quickly. Once done, remove from the oven and let them sit for a couple of minutes.",
      "secondary_message": null
    },
    {
      "id": 189738,
      "primary_message": "Trim, peel, and mince the shallot and garlic.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 189739,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 189740,
      "primary_message": "When the pot is hot, add oil and swirl to coat. Add the shrimp; cook until opaque, about 3-4 minutes, stirring occasionally. Once done, transfer to a plate.",
      "secondary_message": "1 tsp virgin coconut oil"
    },
    {
      "id": 189741,
      "primary_message": "Return pot to heat, add oil, swirling to coat the bottom; add shallot and garlic. Cook, stirring frequently, until shallots are translucent, 2-3 minutes.",
      "secondary_message": "1 tsp virgin coconut oil"
    },
    {
      "id": 189742,
      "primary_message": "Wash mint. Pick leaves off the stems; discard the stems and finely mince the leaves. Add to pot.",
      "secondary_message": "½ small pkg fresh mint"
    },
    {
      "id": 189743,
      "primary_message": "Add peas, broth, salt, and pepper to the pot. Bring to a boil over high heat, then turn down to medium-high. Cook until peas have softened, 4-5 minutes.",
      "secondary_message": "2 cups frozen peas\n473 ml chicken or vegetable broth\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 189744,
      "primary_message": "Add the roasted asparagus and cream to the soup, reserving some asparagus for garnish. Using an immersion (hand) blender, purée the soup until smooth. Allow soup to heat through but not boil, 2-3 minutes more.",
      "secondary_message": "89 ml (⅜ cup) heavy cream"
    },
    {
      "id": 189745,
      "primary_message": "To serve, ladle soup into bowls and drizzle with more cream. Top with reserved asparagus, Parmesan crisps, and shrimp. Enjoy!",
      "secondary_message": "2 tbsp heavy cream"
    }
  ],
