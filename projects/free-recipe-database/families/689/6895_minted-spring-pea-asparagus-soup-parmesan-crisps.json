  "instructions": [
    {
      "id": 189810,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 189811,
      "primary_message": "Wash the asparagus and snap (or cut) off the woody ends. Cut into 1-inch pieces and transfer to a baking sheet. Drizzle with olive oil and bake in the oven for 10-12 minutes.",
      "secondary_message": "1 small bunch asparagus\n1 tsp extra virgin olive oil"
    },
    {
      "id": 189812,
      "primary_message": "To make crisps, line a baking sheet with parchment paper and grate Parmesan cheese. Measure out 1 tbsp of the grated Parmesan and place in a pile on the sheet. Repeat with remaining cheese, keeping the piles a few inches apart. ",
      "secondary_message": "227 g Parmesan cheese"
    },
    {
      "id": 189813,
      "primary_message": "Place in the oven and bake until lightly browned, 5-7 minutes. Watch carefully because they can burn quickly. Once done, remove from the oven and let them sit for a couple of minutes.",
      "secondary_message": null
    },
    {
      "id": 189814,
      "primary_message": "Trim, peel, and mince the shallot and garlic. ",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 189815,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 189816,
      "primary_message": "When the pot is hot, add oil and swirl to coat. Add shallot and garlic. Cook, stirring frequently, until shallots are translucent, 2-3 minutes.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 189817,
      "primary_message": "Wash mint. Pick leaves off the stems; discard the stems and finely mince the leaves. Add to pot.",
      "secondary_message": "1 small pkg fresh mint"
    },
    {
      "id": 189818,
      "primary_message": "Add peas, broth, salt, and pepper to the pot. Bring to a boil over high heat, then turn down to medium-high. Cook until peas have softened, 4-5 minutes.",
      "secondary_message": "4 cups frozen peas\n946 ml chicken or vegetable broth\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 189819,
      "primary_message": "Add the roasted asparagus and cream to the soup, reserving some of each for garnish. Using an immersion (hand) blender, purée the soup until smooth.",
      "secondary_message": "177 ml heavy cream"
    },
    {
      "id": 189820,
      "primary_message": "To serve, ladle soup into bowls and drizzle with more cream. Top with reserved asparagus and Parmesan crisps. Enjoy!",
      "secondary_message": "59 ml (¼ cup) heavy cream"
    }
  ],
