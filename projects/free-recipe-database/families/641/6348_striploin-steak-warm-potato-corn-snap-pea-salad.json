  "instructions": [
    {
      "id": 77431,
      "primary_message": "Preheat the oven to 450°F. Place the rack in the center position.",
      "secondary_message": ""
    },
    {
      "id": 77418,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n1 ½ (8 oz) pkg sugar snap peas\n1 ½ small bunch green onions (scallions)"
    },
    {
      "id": 77430,
      "primary_message": "Medium dice the potatoes (cut into ½-inch cubes) and transfer to a baking sheet.",
      "secondary_message": ""
    },
    {
      "id": 77417,
      "primary_message": "Add the corn to the potatoes.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 77416,
      "primary_message": "Drizzle the potatoes and corn with olive oil and season with salt and pepper; toss to coat, then arrange in a single layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 77429,
      "primary_message": "Place the sheet in the oven and roast, tossing halfway through cooking time, until the potatoes are tender when pierced with a fork, 20 to 25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 77415,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a large bowl (that is big enough to hold the potato salad).",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 77428,
      "primary_message": "Add mayonnaise, paprika, salt, and pepper to the bowl with the garlic and mix together.",
      "secondary_message": "9 tbsp mayonnaise\n¾ tsp paprika\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 77427,
      "primary_message": "Cut the sugar snap peas crosswise (at an angle) into ¼-inch pieces and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77426,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise (at an angle) into ¼-inch pieces and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77425,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 77424,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 77423,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 77422,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 77421,
      "primary_message": "Once the potatoes are tender, remove them from the oven and transfer to the salad bowl. Gently mix the ingredients together.",
      "secondary_message": ""
    },
    {
      "id": 77420,
      "primary_message": "Slice the steak against the grain into strips.",
      "secondary_message": ""
    },
    {
      "id": 77419,
      "primary_message": "To serve, divide the salad and steak slices between plates. Enjoy!",
      "secondary_message": ""
    }
  ],
