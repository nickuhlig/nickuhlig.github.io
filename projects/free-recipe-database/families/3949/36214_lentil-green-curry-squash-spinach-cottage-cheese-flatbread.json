  "instructions": [
    {
      "id": 568819,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small butternut squash\n½ small bunch green onions (scallions)\n½ (5 oz) pkg baby spinach\n½ small bunch cilantro"
    },
    {
      "id": 568820,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 568821,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add the white and pale green parts to the bowl with the squash. (Reserve dark green parts for later use.)",
      "secondary_message": null
    },
    {
      "id": 568822,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568823,
      "primary_message": "While the pan heats up, peel and mince garlic. Add to the bowl with the squash.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 568824,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add squash, onion, garlic, and spices; cook, stirring frequently, until onion starts to brown and squash is just tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cumin, ground\n¼ tsp crushed red pepper"
    },
    {
      "id": 568825,
      "primary_message": "Meanwhile, roughly chop spinach. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 568826,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the spinach and set aside. ",
      "secondary_message": null
    },
    {
      "id": 568827,
      "primary_message": "Rinse lentils in a colander or strainer.",
      "secondary_message": "½ cup green lentils, dried"
    },
    {
      "id": 568828,
      "primary_message": "When the squash is just tender, add lentils and broth to the pan; stir to combine the curry and bring to a boil over high heat. Once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, about 20 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 568829,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in another medium bowl along with egg, cottage cheese, flour, milk, baking powder, and salt. Whisk to combine the batter.",
      "secondary_message": "1 clove garlic\n1 egg\n½ cup cottage cheese\n½ cup all-purpose flour\n1 fl oz (⅛ cup) whole milk\n½ tsp baking powder\n¼ tsp salt"
    },
    {
      "id": 568830,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568831,
      "primary_message": "While the skillet heats up, add reserved green onions to the bowl with the batter and whisk once more to combine.",
      "secondary_message": null
    },
    {
      "id": 568832,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Using a ½-cup measure, drop batter into the skillet, spacing scoops a few inches apart; spread into an oval shape with the back of a spoon. Cook until \"flatbreads\" are golden brown, 3-5 minutes per side. Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 568833,
      "primary_message": "When the lentils are tender, add spinach and cilantro to the pan in handfuls, waiting for the greens to wilt slightly before adding the next handful. Remove from heat, add yogurt, and stir to combine.",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 568834,
      "primary_message": "Divide curry and flatbread between bowls. Serve with additional yogurt and enjoy! ",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
