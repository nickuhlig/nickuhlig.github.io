  "instructions": [
    {
      "id": 568851,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ small butternut squash\n1 small bunch green onions (scallions)\n1 ½ (5 oz) pkgs baby spinach\n1 small bunch cilantro"
    },
    {
      "id": 568852,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 568853,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add the white and pale green parts to the bowl with the squash. (Reserve dark green parts for later use.)",
      "secondary_message": null
    },
    {
      "id": 568854,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568855,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl with the squash.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 568856,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add squash, onion, garlic, and spices to the pot; cook, stirring frequently, until onion starts to brown and squash is just tender, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cumin, ground\n¾ tsp crushed red pepper"
    },
    {
      "id": 568857,
      "primary_message": "Meanwhile, roughly chop spinach. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 568858,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the spinach and set aside. ",
      "secondary_message": null
    },
    {
      "id": 568859,
      "primary_message": "Rinse lentils in a colander or strainer.",
      "secondary_message": "1 ½ cups green lentils, dried"
    },
    {
      "id": 568860,
      "primary_message": "When the squash is just tender, add lentils and broth to the pot; stir to combine the curry and bring to a boil over high heat. Once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, about 20 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 568861,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a medium bowl along with eggs, cottage cheese, flour, milk, baking powder, and salt. Whisk to combine the batter.",
      "secondary_message": "3 cloves garlic\n3 eggs\n1 ½ cups cottage cheese\n1 ½ cup all-purpose flour\n3 fl oz (⅜ cup) whole milk\n1 ½ tsp baking powder\n¾ tsp salt"
    },
    {
      "id": 568862,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568863,
      "primary_message": "While the skillet heats up, add reserved green onions to the bowl with the batter and whisk once more to combine.",
      "secondary_message": null
    },
    {
      "id": 568864,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, using a ½-cup measure, drop batter into skillet, spacing scoops a few inches apart; spread into oval shapes with the back of a spoon. Cook until \"flatbreads\" are golden brown, 3-5 minutes per side. Remove to a plate.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 568865,
      "primary_message": "When the lentils are tender, add spinach and cilantro to the pot in handfuls, waiting for the greens to wilt slightly before adding the next handful. Remove from heat, add yogurt, and stir to combine.",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 568866,
      "primary_message": "Divide curry and flatbread between bowls. Serve with additional yogurt and enjoy! ",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
