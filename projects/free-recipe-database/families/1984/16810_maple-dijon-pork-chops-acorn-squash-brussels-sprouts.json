  "instructions": [
    {
      "id": 396092,
      "primary_message": "Preheat oven to 230°C (450°F). Line two baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 396093,
      "primary_message": "Wash and dry acorn squash; halve each squash lengthwise, trim off the ends, then scoop out seeds. Cut crosswise into ¼-inch thick slices and place in a large bowl. ",
      "secondary_message": "3 acorn squash"
    },
    {
      "id": 396094,
      "primary_message": "Wash, dry, and trim Brussels sprouts; halve lengthwise and add to the bowl with the squash. ",
      "secondary_message": "0.68 kg Brussels sprouts"
    },
    {
      "id": 396095,
      "primary_message": "Peel, halve, and thinly slice onions into half-moons; add to the bowl.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 396096,
      "primary_message": "Peel and mince garlic; add to the bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 396097,
      "primary_message": "Drizzle oil over veggies and season with spices; toss to coat.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp rosemary, dried\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 396098,
      "primary_message": "Divide veggies between the baking sheets and spread out in an even layer. Place in the oven and bake, tossing halfway through, until veggies are fork-tender, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 396099,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 396100,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a large plate; season with salt and pepper on both sides. ",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 396101,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 396102,
      "primary_message": "While the chops are cooking, place maple syrup, Dijon, and salt in a small bowl; whisk to combine the maple-Dijon sauce.",
      "secondary_message": "¼ cup pure maple syrup\n3 tbsp Dijon mustard\n¼ tsp salt"
    },
    {
      "id": 396103,
      "primary_message": "When the chops are done, remove to a clean plate, pour maple-Dijon sauce over top, and turn to coat both sides.",
      "secondary_message": null
    },
    {
      "id": 396104,
      "primary_message": "To serve, divide pork chops, sauce, and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
