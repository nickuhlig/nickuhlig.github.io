  "instructions": [
    {
      "id": 396066,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 396067,
      "primary_message": "Wash and dry acorn squash; halve lengthwise, trim off the ends, then scoop out seeds. Cut crosswise into ¼-inch thick slices and place in a medium bowl. ",
      "secondary_message": "1 acorn squash"
    },
    {
      "id": 396068,
      "primary_message": "Wash, dry, and trim Brussels sprouts; halve lengthwise and add to the bowl with the squash. ",
      "secondary_message": "0.23 kg Brussels sprouts"
    },
    {
      "id": 396069,
      "primary_message": "Peel, halve, and thinly slice onion into half-moons; add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 396070,
      "primary_message": "Peel and mince garlic; add to the bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 396071,
      "primary_message": "Drizzle oil over veggies and season with spices; toss to coat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tsp rosemary, dried\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 396072,
      "primary_message": "Transfer veggies to the baking sheet and spread out in an even layer. Place in the oven and bake, tossing halfway through, until veggies are fork-tender, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 396073,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 396074,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides. ",
      "secondary_message": "2 pork chops, boneless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 396075,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 396076,
      "primary_message": "While the chops are cooking, place maple syrup, Dijon, and salt in a small bowl; whisk to combine the maple-Dijon sauce.",
      "secondary_message": "1 ½ tbsp pure maple syrup\n1 tbsp Dijon mustard\n⅛ tsp salt"
    },
    {
      "id": 396077,
      "primary_message": "When the chops are done, remove to a clean plate, pour maple-Dijon sauce over top, and turn to coat both sides.",
      "secondary_message": null
    },
    {
      "id": 396078,
      "primary_message": "To serve, divide pork chops, sauce, and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
