  "instructions": [
    {
      "id": 348068,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes; drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n15 oz spaghetti pasta"
    },
    {
      "id": 348069,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 eggplants\n1 small pkg fresh basil\n3 pints grape tomatoes\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 348070,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 348071,
      "primary_message": "Trim and medium dice eggplants.",
      "secondary_message": null
    },
    {
      "id": 348072,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 348073,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add eggplant and cook, stirring occasionally, until golden brown, about 10 minutes. Transfer eggplant to a plate. (Reserve pot for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 348074,
      "primary_message": "Meanwhile, peel and mince garlic; place in a medium bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 348075,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add half to the bowl with the garlic. (Reserve remaining basil for garnish.)",
      "secondary_message": null
    },
    {
      "id": 348076,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348077,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom; add shrimp, garlic, basil, tomatoes, vinegar, salt, and crushed red pepper. Cook, stirring occasionally, until shrimp are opaque, 3-4 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 348078,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 348079,
      "primary_message": "Add drained pasta and eggplant to the pot; toss to combine. Continue to cook until pasta and eggplant are warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 348080,
      "primary_message": "To serve, divide pasta between plates or bowls; top with feta and reserved basil. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
