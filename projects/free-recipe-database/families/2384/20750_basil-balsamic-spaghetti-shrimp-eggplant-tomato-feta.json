  "instructions": [
    {
      "id": 348055,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes; drain and set aside.",
      "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
    },
    {
      "id": 348056,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 eggplants\n1 small pkg fresh basil\n2 pints grape tomatoes\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 348057,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 348058,
      "primary_message": "Trim and medium dice eggplants.",
      "secondary_message": null
    },
    {
      "id": 348059,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 348060,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add eggplant and cook, stirring occasionally, until golden brown, 8-10 minutes. Transfer eggplant to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 348061,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 348062,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add half to the bowl with the garlic. (Reserve remaining basil for garnish.)",
      "secondary_message": null
    },
    {
      "id": 348063,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348064,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom; add shrimp, garlic, basil, tomatoes, vinegar, salt, and crushed red pepper. Cook, stirring occasionally, until shrimp are opaque, 2-3 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tbsp balsamic vinegar\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 348065,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 348066,
      "primary_message": "Add drained pasta and eggplant to the skillet; toss to combine. Continue to cook until pasta and eggplant are warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 348067,
      "primary_message": "To serve, divide pasta between plates or bowls; top with feta and reserved basil. Enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
