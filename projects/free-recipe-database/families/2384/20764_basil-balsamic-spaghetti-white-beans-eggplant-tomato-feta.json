  "instructions": [
    {
      "id": 348237,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes; drain and set aside.",
      "secondary_message": "½ tsp salt\n142 g spaghetti pasta"
    },
    {
      "id": 348238,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 eggplant\n½ small pkg fresh basil\n1 small pkg grape tomatoes\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 348239,
      "primary_message": "Trim and medium dice eggplant.",
      "secondary_message": null
    },
    {
      "id": 348240,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 348241,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add eggplant and cook, stirring occasionally, until golden brown, 8-10 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 348242,
      "primary_message": "Meanwhile, drain and rinse beans; place in a medium bowl.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 348243,
      "primary_message": "Peel and mince garlic; add to the bowl with the beans.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 348244,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add half to the bowl with the garlic. (Reserve remaining basil for garnish.)",
      "secondary_message": null
    },
    {
      "id": 348245,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348246,
      "primary_message": "When the eggplant is done, add beans, garlic, basil, tomatoes, vinegar, salt, and crushed red pepper to the skillet. Cook, stirring occasionally, until beans are warmed through, 5-6 minutes.",
      "secondary_message": "1 tbsp balsamic vinegar\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 348247,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 348248,
      "primary_message": "Add drained pasta to the skillet and toss to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 348249,
      "primary_message": "To serve, divide pasta between plates or bowls; top with feta and reserved basil. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
