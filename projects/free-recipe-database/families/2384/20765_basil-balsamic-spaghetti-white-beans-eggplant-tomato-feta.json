  "instructions": [
    {
      "id": 348250,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes; drain and set aside.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 348251,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 eggplants\n1 small pkg fresh basil\n2 small pkgs grape tomatoes\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 348252,
      "primary_message": "Trim and medium dice eggplants.",
      "secondary_message": null
    },
    {
      "id": 348253,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 348254,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add eggplant and cook, stirring occasionally, until golden brown, 8-10 minutes. Transfer eggplant to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 348255,
      "primary_message": "Meanwhile, drain and rinse beans; place in a medium bowl.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 348256,
      "primary_message": "Peel and mince garlic; add to the bowl with the beans.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 348257,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add half to the bowl. (Reserve remaining basil for garnish.)",
      "secondary_message": null
    },
    {
      "id": 348258,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348259,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom; add beans, garlic, basil, tomatoes, vinegar, salt, and crushed red pepper. Cook, stirring occasionally, until beans are warmed through, 5-6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tbsp balsamic vinegar\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 348260,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 348261,
      "primary_message": "Add drained pasta and eggplant to the skillet; toss to combine. Continue to cook until pasta and eggplant are warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 348262,
      "primary_message": "To serve, divide pasta between plates or bowls; top with feta and reserved basil. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
