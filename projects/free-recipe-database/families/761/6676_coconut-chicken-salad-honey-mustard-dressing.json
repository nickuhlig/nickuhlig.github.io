  "instructions": [
    {
      "id": 113972,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 113973,
      "primary_message": "Slice chicken into 1-½ inch strips; season with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 113974,
      "primary_message": "In a small bowl, combine the shredded coconut, breadcrumbs, and garlic powder.",
      "secondary_message": "½ cup shredded unsweetened coconut\n½ cup panko bread crumbs\n¼ tsp garlic powder"
    },
    {
      "id": 113975,
      "primary_message": "In another small bowl, whisk the egg with the water.",
      "secondary_message": "1 egg\n1 tbsp water"
    },
    {
      "id": 113976,
      "primary_message": "Dip the chicken tenders into the egg and then into the breadcrumb mixture, pressing gently to adhere. Place on a baking sheet lined with parchment paper and bake for 30 minutes, turning once, halfway through.",
      "secondary_message": null
    },
    {
      "id": 113977,
      "primary_message": "In a small bowl, whisk together the Dijon, oil, honey, and vinegar; set aside.",
      "secondary_message": "1 tbsp Dijon mustard\n1 ½ tbsp extra virgin olive oil\n1 tbsp honey\n1 tbsp apple cider vinegar"
    },
    {
      "id": 113978,
      "primary_message": "Wash and dry the fresh produce (Skip spring mix if it came pre-washed).",
      "secondary_message": "½ English cucumber\n½ small pkg grape tomatoes\n2 medium carrots\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 113979,
      "primary_message": "Medium dice the cucumber. Halve the grape tomatoes.",
      "secondary_message": null
    },
    {
      "id": 113980,
      "primary_message": "Trim and peel the carrots, then julienne or coarsely grate them.",
      "secondary_message": null
    },
    {
      "id": 113981,
      "primary_message": "To serve, divide the spring mix, cucumbers, tomatoes, and carrots between bowls. Top with baked chicken strips and drizzle with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
