  "instructions": [
    {
      "id": 340487,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes; drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n15 oz fettuccine pasta"
    },
    {
      "id": 340488,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 crowns broccoli\n1 small pkg fresh basil"
    },
    {
      "id": 340489,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 340490,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340491,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom; add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "¼ cup butter, unsalted\n24 oz veggie ground, plant based"
    },
    {
      "id": 340492,
      "primary_message": "While the veggie ground is cooking, separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 340493,
      "primary_message": "Add veggies to the pot; cook, stirring occasionally, until tender-crisp, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 340494,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 340495,
      "primary_message": "When the veggies are done, sprinkle with flour and continue to cook, stirring constantly, for 1 minute.",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 340496,
      "primary_message": "Add milk, salt, and pepper to the pot with the veggie ground; cook, stirring occasionally, until the sauce thickens, 5-6 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) whole milk\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 340497,
      "primary_message": "Add drained pasta and basil to the pot; toss to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 340498,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
