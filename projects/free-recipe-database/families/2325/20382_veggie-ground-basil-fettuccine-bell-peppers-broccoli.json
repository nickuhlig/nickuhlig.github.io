  "instructions": [
    {
      "id": 340463,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes; drain and set aside.",
      "secondary_message": "½ tsp salt\n5 oz fettuccine pasta"
    },
    {
      "id": 340464,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 crown broccoli\n½ small pkg fresh basil"
    },
    {
      "id": 340465,
      "primary_message": "Trim, seed, and slice bell pepper into thin strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 340466,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340467,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 ½ tbsp butter, unsalted\n8 oz veggie ground, plant based"
    },
    {
      "id": 340468,
      "primary_message": "While the veggie ground is cooking, separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 340469,
      "primary_message": "Add veggies to the skillet; cook, stirring occasionally, until tender-crisp, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 340470,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 340471,
      "primary_message": "When the veggies are done, sprinkle with flour and continue to cook, stirring constantly, for 1 minute.",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 340472,
      "primary_message": "Add milk, salt, and pepper to the skillet; cook, stirring occasionally, until the sauce thickens, 4-5 minutes.",
      "secondary_message": "4 fl oz (½ cup) whole milk\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 340473,
      "primary_message": "Add drained pasta and basil to the skillet; toss to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 340474,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
