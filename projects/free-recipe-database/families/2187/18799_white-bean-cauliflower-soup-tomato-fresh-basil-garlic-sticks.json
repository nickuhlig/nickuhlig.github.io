  "instructions": [
    {
      "id": 309705,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 pints grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 309706,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 309707,
      "primary_message": "Peel, halve, and medium dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 309708,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 309709,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add onion, garlic, and spices. Cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 309710,
      "primary_message": "Meanwhile, separate each cauliflower head into bite-sized florets and cut stems into smaller pieces. Add cauliflower and water to the pot with the onion; continue to cook, stirring occasionally, while preparing the tomatoes.",
      "secondary_message": "⅓ cup water"
    },
    {
      "id": 309711,
      "primary_message": "Halve tomatoes; add to the pot along with the beans and broth. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies are fork-tender, about 10 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 309712,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 309713,
      "primary_message": "Peel and mince additional garlic; place in a small bowl along with oil and spices. Stir to combine the garlic oil.",
      "secondary_message": "3 cloves garlic\n1 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 309714,
      "primary_message": "Place flatbread on a large baking sheet pan and spread garlic oil over top; place in the oven and broil until golden and crisp, 3-4 minutes. Remove from oven and slice crosswise into sticks.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 309715,
      "primary_message": "While the garlic bread is toasting, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 309716,
      "primary_message": "When the soup is done, add vinegar, stir to combine, and remove from heat.",
      "secondary_message": "3 tbsp balsamic vinegar"
    },
    {
      "id": 309717,
      "primary_message": "Divide soup between bowls and top with basil. Serve with breadsticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
