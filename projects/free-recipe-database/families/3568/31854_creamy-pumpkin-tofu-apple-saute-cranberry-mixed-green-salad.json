  "instructions": [
    {
      "id": 503828,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 503829,
      "primary_message": "Wash, dry, quarter, and core apples; slice into ¼-inch thick wedges. Place in a medium bowl.",
      "secondary_message": "6 Gala apples"
    },
    {
      "id": 503830,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the apple.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 503831,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503832,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 503833,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add apple, onion, garlic, and spices. Cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp sage, dried\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 503834,
      "primary_message": "Meanwhile, place pumpkin, broth, and cream in the reserved bowl. Whisk to combine.",
      "secondary_message": "1 ½ (398 ml) cans pure pumpkin purée\n355 ml chicken or vegetable broth\n177 ml heavy whipping cream"
    },
    {
      "id": 503835,
      "primary_message": "When the apple and onion are soft, add pumpkin mixture to the pot and stir to combine. Continue to cook, stirring occasionally, until sauce thickens slightly, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 503836,
      "primary_message": "While the sauce is cooking, cut the tofu planks in half crosswise, then season with salt and pepper on both sides.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 503837,
      "primary_message": "Once the sauce is thickened slightly, add tofu to the pot and use a spoon to coat in sauce. Reduce heat to medium-low and cover with a lid. Cook until tofu is warmed through, 5-6 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 503838,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, maple syrup, and spices in a large bowl, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 ½ tsp pure maple syrup\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 503839,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing, along with cranberries, and toss to combine the salad.",
      "secondary_message": "1 ½ (142 g) pkgs spring mix (mixed greens)\n¾ cup dried cranberries"
    },
    {
      "id": 503840,
      "primary_message": "Divide tofu, apples, and sauce between plates or bowls. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
