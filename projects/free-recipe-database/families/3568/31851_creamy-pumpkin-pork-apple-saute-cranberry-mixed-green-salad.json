  "instructions": [
    {
      "id": 503790,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503791,
      "primary_message": "While the pot heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 503792,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and cook until golden, about 2 minutes per side (they will not be cooked all the way through). Transfer to a clean plate. (Reserve pot with drippings for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 503793,
      "primary_message": "Meanwhile, wash, dry, quarter, and core apples; slice into ¼-inch thick wedges. Place in a medium bowl.",
      "secondary_message": "6 Gala apples"
    },
    {
      "id": 503794,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl with the apple.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 503795,
      "primary_message": "Return the pot (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add apple, onion, garlic, and spices. Cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp sage, dried\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 503796,
      "primary_message": "While the apple and onion are cooking, place pumpkin, broth, and cream in the reserved bowl. Whisk to combine. ",
      "secondary_message": "1 ½ (398 ml) cans pure pumpkin purée\n355 ml chicken or vegetable broth\n177 ml heavy whipping cream"
    },
    {
      "id": 503797,
      "primary_message": "When the apple and onion are soft, add pumpkin mixture to the pot and stir to combine. Continue to cook, stirring occasionally, until sauce thickens slightly, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 503798,
      "primary_message": "Return pork to the pot and use a spoon to coat in sauce; reduce heat to medium-low and cover with a lid. Simmer until pork is cooked through, 5-6 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 503799,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, maple syrup, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 ½ tsp pure maple syrup\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 503800,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing, along with cranberries, and toss to combine the salad.",
      "secondary_message": "1 ½ (142 g) pkgs spring mix (mixed greens)\n¾ cup dried cranberries"
    },
    {
      "id": 503801,
      "primary_message": "Divide pork, apples, and sauce between plates or bowls. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
