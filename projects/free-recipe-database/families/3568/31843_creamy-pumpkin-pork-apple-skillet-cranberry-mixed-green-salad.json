  "instructions": [
    {
      "id": 503691,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503692,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 503693,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and cook until golden, about 2 minutes per side (they will not be cooked all the way through). Transfer to a clean plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 503694,
      "primary_message": "Meanwhile, wash, dry, quarter, and core apples; slice into ¼-inch thick wedges. Place in a medium bowl.",
      "secondary_message": "2 Gala apples"
    },
    {
      "id": 503695,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl with the apple.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 503696,
      "primary_message": "Return the skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add apple, onion, garlic, and spices. Cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tsp extra virgin olive oil\n½ tsp sage, dried\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 503697,
      "primary_message": "While the apple and onion are cooking, place pumpkin, broth, and cream in the reserved bowl. Whisk to combine. ",
      "secondary_message": "½ (15 oz) can pure pumpkin purée\n4 fl oz (½ cup) chicken or vegetable broth\n2 fl oz (¼ cup) heavy whipping cream"
    },
    {
      "id": 503698,
      "primary_message": "When the apple and onion are soft, add pumpkin mixture to the skillet and stir to combine. Continue to cook, stirring occasionally, until sauce thickens slightly, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 503699,
      "primary_message": "Return pork to the skillet and use a spoon to coat in sauce; reduce heat to medium-low and cover with a lid. Simmer until pork is cooked through, about 5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 503700,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, maple syrup, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp white wine vinegar\n1 tsp Dijon mustard\n½ tsp pure maple syrup\n¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 503701,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing, along with cranberries, and toss to combine the salad.",
      "secondary_message": "½ (5 oz) pkg spring mix (mixed greens)\n¼ cup dried cranberries"
    },
    {
      "id": 503702,
      "primary_message": "Divide pork, apples, and sauce between plates or bowls. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
