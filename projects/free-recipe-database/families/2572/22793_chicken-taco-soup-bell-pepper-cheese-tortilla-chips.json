  "instructions": [
    {
      "id": 419072,
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a medium bowl.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 419073,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Add to the bowl with the celery.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 419074,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 419075,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 419076,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 419077,
      "primary_message": "Meanwhile, place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces.",
      "secondary_message": "1 (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 419078,
      "primary_message": "When the veggies are soft, add chicken, broth, tomatoes, and spices to the pot; stir to combine. Bring to a boil over high heat, then reduce heat and simmer until flavors blend, about 5 minutes. Remove from heat.",
      "secondary_message": "946 ml chicken or vegetable broth\n2 (398 ml) cans diced tomatoes\n3 tbsp taco seasoning\n1 tsp salt\n½ tsp garlic powder"
    },
    {
      "id": 419079,
      "primary_message": "To serve, divide soup between bowls. Top with cheese and chips. Enjoy!",
      "secondary_message": "1 cup shredded cheese, Mexican blend\n113 g tortilla chips"
    }
  ],
