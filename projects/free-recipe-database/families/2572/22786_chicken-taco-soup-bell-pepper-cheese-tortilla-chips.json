  "instructions": [
    {
      "id": 419016,
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a medium bowl.",
      "secondary_message": "1 stick celery"
    },
    {
      "id": 419017,
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice. Add to the bowl with the celery.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 419018,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 419019,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 419020,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 419021,
      "primary_message": "Meanwhile, place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces.",
      "secondary_message": "½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 419022,
      "primary_message": "When the veggies are soft, add chicken, broth, tomatoes, and spices to the pan; stir to combine. Bring to a boil over high heat, then reduce heat and simmer until flavors blend, about 5 minutes. Remove from heat.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes\n1 ½ tbsp taco seasoning\n½ tsp salt\n¼ tsp garlic powder"
    },
    {
      "id": 419023,
      "primary_message": "To serve, divide soup between bowls. Top with cheese and chips. Enjoy!",
      "secondary_message": "½ cup shredded cheese, Mexican blend\n2 oz tortilla chips"
    }
  ],
