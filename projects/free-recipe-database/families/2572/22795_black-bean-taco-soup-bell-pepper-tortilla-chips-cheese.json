  "instructions": [
    {
      "id": 419088,
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a medium bowl.",
      "secondary_message": "1 stick celery"
    },
    {
      "id": 419089,
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice. Add to the bowl with the celery.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 419090,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 419091,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 419092,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 419093,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 419094,
      "primary_message": "When the veggies are soft, add beans, broth, tomatoes, and spices to the pan; stir to combine. Bring to a boil over high heat, then reduce heat and simmer until flavors blend, about 5 minutes. Remove from heat.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n1 ½ tbsp taco seasoning\n½ tsp salt\n¼ tsp garlic powder"
    },
    {
      "id": 419095,
      "primary_message": "To serve, divide soup between bowls. Top with cheese and chips. Enjoy!",
      "secondary_message": "½ cup shredded cheese, Mexican blend\n57 g tortilla chips"
    }
  ],
