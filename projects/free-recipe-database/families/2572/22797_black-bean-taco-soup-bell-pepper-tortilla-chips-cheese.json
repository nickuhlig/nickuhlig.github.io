  "instructions": [
    {
      "id": 419104,
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a medium bowl.",
      "secondary_message": "3 sticks celery"
    },
    {
      "id": 419105,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Add to the bowl with the celery.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 419106,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 419107,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 419108,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 419109,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 419110,
      "primary_message": "When the veggies are soft, add beans, broth, tomatoes, and spices to the pot; stir to combine. Bring to a boil over high heat, then reduce heat and simmer until flavors blend, 6-7 minutes. Remove from heat.",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes\n¼ cup taco seasoning\n1 ½ tsp salt\n¾ tsp garlic powder"
    },
    {
      "id": 419111,
      "primary_message": "To serve, divide soup between bowls. Top with cheese and chips. Enjoy!",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend\n170 g tortilla chips"
    }
  ],
