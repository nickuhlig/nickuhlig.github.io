  "instructions": [
    {
      "id": 301867,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 301868,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium turnips\n4 medium carrots\n0.45 kg new potatoes\n1 small pkg fresh mint\n2 (170 g) pkg blackberries\n1 lemon"
    },
    {
      "id": 301869,
      "primary_message": "Peel, trim, and medium dice turnips and carrots; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 301870,
      "primary_message": "Quarter potatoes and add to the baking sheet with the other veggies; drizzle with oil, sprinkle with spices, toss to coat, and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 301871,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 301872,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301873,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 301874,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 301875,
      "primary_message": "While the steak is cooking, pick mint leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 301876,
      "primary_message": "Roughly chop blackberries.",
      "secondary_message": null
    },
    {
      "id": 301877,
      "primary_message": "When the steak is done, zest and juice lemon into the skillet; add mint, blackberries, water, sugar, salt, and pepper. Stir to combine and bring to a simmer over medium-high heat. Once simmering, reduce heat to medium and cook, stirring often, until sauce thickens, about 5 minutes; remove from heat.",
      "secondary_message": "½ cup water\n2 tbsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 301878,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 301879,
      "primary_message": "To serve, divide steak and roasted veggies between plates; drizzle sauce over the steak and enjoy!",
      "secondary_message": null
    }
  ],
