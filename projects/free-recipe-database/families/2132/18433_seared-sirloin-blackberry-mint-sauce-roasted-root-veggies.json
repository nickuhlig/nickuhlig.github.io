  "instructions": [
    {
      "id": 301880,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 301881,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium turnips\n6 medium carrots\n0.68 kg new potatoes\n1 small pkg fresh mint\n3 (170 g) pkg blackberries\n1 ½ lemons"
    },
    {
      "id": 301882,
      "primary_message": "Peel, trim, and medium dice turnips and carrots; divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 301883,
      "primary_message": "Quarter potatoes and add to the baking sheets with the other veggies; drizzle with oil, sprinkle with spices, toss to coat, and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 301884,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 301885,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301886,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 301887,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 301888,
      "primary_message": "While the steak is cooking, pick mint leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 301889,
      "primary_message": "Roughly chop blackberries.",
      "secondary_message": null
    },
    {
      "id": 301890,
      "primary_message": "When the steak is done, zest and juice lemons into the skillet; add mint, blackberries, water, sugar, salt, and pepper. Stir to combine and bring to a simmer over medium-high heat. Once simmering, reduce heat to medium and cook, stirring often, until sauce thickens, 6-7 minutes; remove from heat.",
      "secondary_message": "¾ cup water\n3 tbsp brown sugar\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 301891,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 301892,
      "primary_message": "To serve, divide steak and roasted veggies between plates; drizzle sauce over the steak and enjoy!",
      "secondary_message": null
    }
  ],
