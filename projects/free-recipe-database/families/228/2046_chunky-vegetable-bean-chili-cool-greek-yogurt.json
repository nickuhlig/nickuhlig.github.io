  "instructions": [
    {
      "id": 19180,
      "primary_message": "Heat a medium saucepan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 19181,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\r\n4 cloves garlic"
    },
    {
      "id": 19182,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and garlic.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 19183,
      "primary_message": "Wash celery and bell peppers. Medium dice and add celery to a saucepan. Seed, medium dice, and add peppers to saucepan. Stirring frequently, cook until vegetables have softened, 4-5 minutes.",
      "secondary_message": "4 sticks celery\r\n2 red bell peppers"
    },
    {
      "id": 19184,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "4 (15 oz) cans kidney beans"
    },
    {
      "id": 19185,
      "primary_message": "In a small bowl, mix together chili powder, cumin, salt, black pepper, and cayenne pepper.",
      "secondary_message": "2 tbsp chili powder\n2 tsp cumin\n1 tsp salt\n¼ tsp black pepper\n¼ tsp cayenne pepper (optional)"
    },
    {
      "id": 19186,
      "primary_message": "Add spice mixture, beans, tomatoes, and broth to saucepan. Stir to combine and bring to a boil. Then reduce heat to medium, cover, and simmer until vegetables are tender and chili has thickened, about 10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 19187,
      "primary_message": "Wash green onions, trim and discard root ends, and chop. Stir ½ into the chili and save the rest for garnishing.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 19188,
      "primary_message": "Serve chili in a bowl, garnish with remaining green onions and spoonfuls of yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
