  "instructions": [
    {
      "id": 602755,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 602756,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ medium heads napa cabbage\n1 ½ mangoes"
    },
    {
      "id": 602757,
      "primary_message": "Juice half of the limes into a large bowl; cut remaining limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 602758,
      "primary_message": "Add yogurt, mayo, and spices to the bowl with the lime juice, then whisk to combine the dressing.",
      "secondary_message": "1 cup plain Greek yogurt\n⅓ cup mayonnaise\n1 ½ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 602759,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 602760,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 602761,
      "primary_message": "Place flour and spices in another large bowl, then stir to combine.",
      "secondary_message": "⅓ cup all-purpose flour\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 602762,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 602763,
      "primary_message": "While the skillet heats up, medium dice tofu. Add to the bowl with the flour mixture and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 602764,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add tofu and pan-fry, turning occasionally, until golden and warmed through, 5-7 minutes. Transfer to a plate and loosely cover with aluminum foil. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 602765,
      "primary_message": "Return tofu to the skillet (if necessary), add hot sauce, and stir until sauce coats tofu.",
      "secondary_message": "¾ cup hot sauce"
    },
    {
      "id": 602766,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 602767,
      "primary_message": "Divide tortillas between plates, then fill with a small portion of slaw and tofu. Serve with remaining slaw on the side and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
