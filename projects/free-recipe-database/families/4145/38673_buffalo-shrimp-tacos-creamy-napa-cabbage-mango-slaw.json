  "instructions": [
    {
      "id": 602872,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ medium heads napa cabbage\n1 ½ mangoes"
    },
    {
      "id": 602873,
      "primary_message": "Juice half of the limes into a large bowl; cut remaining limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 602874,
      "primary_message": "Add yogurt, mayo, and spices to the bowl with the lime juice, then whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 ½ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 602875,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 602876,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 602877,
      "primary_message": "Place flour and spices in another large bowl, then stir to combine.",
      "secondary_message": "⅓ cup all-purpose flour\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 602878,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 602879,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 602880,
      "primary_message": "While the skillet heats up, add shrimp to the bowl with the flour mixture and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 602881,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add shrimp and cook until they are opaque, 1-2 minutes per side.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 602882,
      "primary_message": "Remove skillet from heat, add hot sauce, and stir until sauce coats shrimp. ",
      "secondary_message": "¾ cup hot sauce"
    },
    {
      "id": 602883,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 602884,
      "primary_message": "Divide tortillas between plates, then fill with a small portion of slaw and shrimp. Serve with remaining slaw on the side and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
