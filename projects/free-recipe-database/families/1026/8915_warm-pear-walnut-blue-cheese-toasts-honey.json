  "instructions": [
    {
      "id": 138839,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler. Line a baking sheet pan with aluminum foil (optional). ",
      "secondary_message": null
    },
    {
      "id": 138840,
      "primary_message": "Place bread slices on the baking sheet. Place in the oven and broil, flipping halfway through, 2-3 minutes, or until toasted. Remove toast from the oven and set aside. (Keep the broiler on.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 138841,
      "primary_message": "Meanwhile, roughly chop walnuts and transfer to a medium bowl. ",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 138842,
      "primary_message": "Add blue cheese to the bowl with the walnuts. ",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 138843,
      "primary_message": "Wash, core, and medium dice the pear; transfer to the bowl with the walnuts and stir to combine.",
      "secondary_message": "1 pear"
    },
    {
      "id": 138844,
      "primary_message": "Top each piece of toast with equal portions of walnut mixture.",
      "secondary_message": null
    },
    {
      "id": 138845,
      "primary_message": "Place baking sheet in the oven and broil until walnuts are toasted and the cheese becomes bubbly, 1-2 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 138846,
      "primary_message": "To serve, divide toasts between dishes, drizzle with honey, and enjoy! ",
      "secondary_message": "2 tsp honey"
    }
  ],
