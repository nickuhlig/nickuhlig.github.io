  "instructions": [
    {
      "id": 472563,
      "primary_message": "Preheat oven to 500°F. Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 472564,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 472565,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 472566,
      "primary_message": "Meanwhile, pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Divide between the baking sheets and spread out in an even layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed\n2 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 472567,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. ",
      "secondary_message": null
    },
    {
      "id": 472568,
      "primary_message": "While the rice and wings are cooking, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n1 ½ English cucumbers\n1 ½ bunches radish\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 472569,
      "primary_message": "Place vinegar, sugar, and salt in a clean large bowl. Whisk to combine the pickling liquid. ",
      "secondary_message": "½ cup rice vinegar\n1 ½ tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 472570,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 472571,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 472572,
      "primary_message": "Trim and halve radishes lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 472573,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl, stir to combine, and set aside. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 472574,
      "primary_message": "Peel and mince garlic. Place in another large bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 472575,
      "primary_message": "Zest and juice limes into the bowl with the garlic. Add fish sauce, chili-garlic sauce, and sugar, then whisk to combine the sauce.",
      "secondary_message": "¼ cup fish sauce\n2 tbsp chili-garlic sauce\n1 ½ tbsp brown sugar"
    },
    {
      "id": 472576,
      "primary_message": "When the wings are almost done, roughly chop peanuts. Add half to the bowl with the pickled veggies and stir once more to combine. (Reserve remaining peanuts for serving.)",
      "secondary_message": "1 cup peanuts, roasted unsalted"
    },
    {
      "id": 472577,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 472578,
      "primary_message": "To serve, divide wings, rice, and pickled veggies between plates. Top wings with reserved cilantro and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
