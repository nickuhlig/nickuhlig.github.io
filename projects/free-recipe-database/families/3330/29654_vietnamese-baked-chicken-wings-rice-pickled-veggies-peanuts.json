  "instructions": [
    {
      "id": 472637,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 472638,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 472639,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 472640,
      "primary_message": "Meanwhile, pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed\n4 tsp cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 472641,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 472642,
      "primary_message": "While the rice and wings are cooking, wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n1 English cucumber\n1 bunch radish\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 472643,
      "primary_message": "Place vinegar, sugar, and salt in a clean medium bowl. Whisk to combine the pickling liquid. ",
      "secondary_message": "⅓ cup rice vinegar\n1 tbsp brown sugar\n½ tsp salt"
    },
    {
      "id": 472644,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 472645,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 472646,
      "primary_message": "Trim and halve radishes lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 472647,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl, stir to combine, and set aside. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 472648,
      "primary_message": "Peel and mince garlic. Place in another medium bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 472649,
      "primary_message": "Zest and juice lime into the bowl with the garlic. Add fish sauce, chili-garlic sauce, and sugar, then whisk to combine the sauce.",
      "secondary_message": "3 tbsp fish sauce\n4 tsp chili-garlic sauce\n1 tbsp brown sugar"
    },
    {
      "id": 472650,
      "primary_message": "When the wings are almost done, roughly chop peanuts. Add half to the bowl with the pickled veggies and stir once more to combine. (Reserve remaining peanuts for serving.)",
      "secondary_message": "⅔ cup peanuts, roasted unsalted"
    },
    {
      "id": 472651,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 472652,
      "primary_message": "To serve, divide wings, rice, and pickled veggies between plates. Top wings with reserved cilantro and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
