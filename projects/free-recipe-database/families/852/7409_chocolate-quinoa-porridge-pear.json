  "instructions": [
    {
      "id": 178424,
      "primary_message": "Combine quinoa, almond milk, maple syrup, cocoa powder, and salt in a medium saucepan. Whisk to combine and bring to a boil over high heat. ",
      "secondary_message": "1 cup quinoa\n710 ml almond milk, unsweetened\n¼ cup pure maple syrup\n2 tbsp cocoa powder\n½ tsp salt"
    },
    {
      "id": 178425,
      "primary_message": "Once the quinoa mixture comes to a boil, reduce heat to low, allow to cool slightly, and cover with a lid. Cook until most of the liquid is absorbed, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 178426,
      "primary_message": "During the last 5 minutes of cook time, wash, dry, and thinly slice the pears.",
      "secondary_message": "2 pears"
    },
    {
      "id": 178427,
      "primary_message": "To serve, divide chocolate quinoa between bowls and top with pear. Enjoy!",
      "secondary_message": null
    }
