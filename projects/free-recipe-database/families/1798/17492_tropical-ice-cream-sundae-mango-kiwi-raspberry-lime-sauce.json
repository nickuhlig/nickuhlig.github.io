  "instructions": [
    {
      "id": 283655,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ (6 oz) pkg raspberries\n1 mango\n1 kiwifruit"
    },
    {
      "id": 283656,
      "primary_message": "Juice lime into a blender. Add raspberries, sugar, and vanilla; blend until smooth.",
      "secondary_message": "1 ½ tbsp granulated sugar\n¼ tsp vanilla extract"
    },
    {
      "id": 283657,
      "primary_message": "Pour raspberry-lime pureé into a strainer placed over a medium bowl. Using a silicone spatula, press pureé through the strainer to remove seeds; discard seeds and set sauce aside.",
      "secondary_message": null
    },
    {
      "id": 283658,
      "primary_message": "Peel and slice mango flesh away from the pit, starting with the flat sides; medium dice.",
      "secondary_message": null
    },
    {
      "id": 283659,
      "primary_message": "Trim, peel, and small dice kiwi.",
      "secondary_message": null
    },
    {
      "id": 283660,
      "primary_message": "To serve, place one scoop of ice cream in the bottom of each bowl; top with half the raspberry-lime sauce and the diced fruit. Place a second scoop of ice cream on top, drizzle with remaining sauce, and enjoy!",
      "secondary_message": "12 fl oz (1 ½ cups) vanilla ice cream, vegan"
    }
  ],
