  "instructions": [
    {
      "id": 193455,
      "primary_message": "Peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 193456,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 193457,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 193458,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Drain rice and transfer to the pot along with the spices. Cook, stirring constantly, about 3 minutes.",
      "secondary_message": "2 ¼ cups basmati rice\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 193459,
      "primary_message": "Add broth and tomato sauce to the pot and bring to a boil over high heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ (8 oz) cans tomato sauce"
    },
    {
      "id": 193460,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 193461,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the pot, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 193462,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 193463,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add shrimp and cook until opaque, 1-2 minutes per side.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 193464,
      "primary_message": "While the shrimp cooks, wash, dry, and zest the lemons into a small bowl, then juice it into the same bowl.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 193465,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 193466,
      "primary_message": "Remove skillet from the heat and stir in lemon zest, juice, and parsley. Cover with a lid and set aside.",
      "secondary_message": null
    },
    {
      "id": 193467,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw; add to the rice, tossing gently to combine.",
      "secondary_message": "3 cups frozen peas"
    },
    {
      "id": 193468,
      "primary_message": "To serve, divide rice pilaf and lemon shrimp between plates. Enjoy!",
      "secondary_message": null
    }
  ],
