  "instructions": [
    {
      "id": 193469,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 193470,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 193471,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until softened, about 2 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 193472,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Drain rice and transfer to the saucepan along with the spices. Cook, stirring constantly, about 1 minute.",
      "secondary_message": "¾ cup basmati rice\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 193473,
      "primary_message": "Add broth and tomato sauce to the saucepan and bring to a boil over high heat.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ (213 ml) can tomato sauce"
    },
    {
      "id": 193474,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 193475,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 193476,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 193477,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp and cook until opaque, 1-2 minutes per side.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 193478,
      "primary_message": "While the shrimp cooks, wash, dry, and zest the lemon into a small bowl, then juice it into the same bowl.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 193479,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 193480,
      "primary_message": "Remove skillet from the heat and stir in lemon zest, juice, and parsley. Cover with a lid and set aside.",
      "secondary_message": null
    },
    {
      "id": 193481,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw; add to the rice, tossing gently to combine.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 193482,
      "primary_message": "To serve, divide rice pilaf and lemon shrimp between plates. Enjoy!",
      "secondary_message": null
    }
  ],
