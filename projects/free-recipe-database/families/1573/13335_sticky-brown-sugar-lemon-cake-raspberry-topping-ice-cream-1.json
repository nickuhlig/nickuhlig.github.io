  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Place butter in a medium saucepan and melt over medium heat.",
      "secondary_message": "butter, unsalted"
    },
    {
      "primary_message": "Divide melted butter between 6 muffin cups, sprinkle with sugar, and set aside. (Reserve saucepan for later use.)",
      "secondary_message": "brown sugar"
    },
    {
      "primary_message": "Wash, dry, zest, and juice lemons into a medium bowl.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "primary_message": "Add flour, sugar, water, baking powder, vanilla, and salt to the bowl with the lemon; whisk to combine the batter.",
      "secondary_message": "brown sugar\n1 ½ tsp baking powder\nvanilla extract\n¼ tsp salt"
    },
    {
      "primary_message": "Divide batter between muffin cups. Place in the oven and bake until a knife or skewer inserted in the center comes out clean, 15-20 minutes. Remove from oven and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry the raspberries.",
      "secondary_message": "3 (6 oz) pkgs raspberries"
    },
    {
      "primary_message": "Return saucepan to medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add raspberries, sugar, and vanilla. Cook, stirring occasionally, until raspberries have softened, 3-4 minutes. Remove from heat and set aside.",
      "secondary_message": "butter, unsalted\nbrown sugar\nvanilla extract"
    },
    {
      "primary_message": "Slide a knife down and around the side of each cake to loosen. Holding the muffin pan over a baking sheet pan, carefully invert, and tap the pan to loosen the cakes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide cakes, raspberry sauce, and ice cream between bowls. Enjoy!",
      "secondary_message": "36 fl oz (4 ½ cups) vanilla ice cream"
    }
  ],
