  "instructions": [
    {
      "id": 1,
      "primary_message": "Pre-heat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine the flour, sugar, baking powder & soda and 5-spice in a mixing bowl. Add the weighed out duck fat (1/2 duck fat & 1/2 vegetable shortening works well too) and put the bowl in a freezer for 15 minutes to chill thoroughly.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a pastry cutter or bench scraper, cut the chilled fat into the flour mixture until it looks like coarse sand.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add 1 egg and almond extract and stir with a rubber spatula, working everything into a dough. If it seems too wet, add flour a little at a time until you have a tight dough. Wrap in plastic and store in the refrigerator for at least two hours or overnight.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Portion 2 Tablespoon dough balls and press them into disks about 1.5 cm thick. Place evenly on a tray lined with parchment paper or a silpat, leaving about 2.5 cm of spreading space between cookies. (Optional: press a single blanched almond into the center of each cookie.)",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Beat the remaining egg, and brush each cookie with egg-wash. Bake until golden and cooked through, about 15 minutes. Allow at least 15 minutes of cooling time.",
      "secondary_message": null
    }
  ],
