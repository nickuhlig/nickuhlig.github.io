  "instructions": [
    {
      "id": 1,
      "primary_message": "Gut the mackerel, keep it whole and make 2 or 3 diagonal slits along it's length on both sides.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Mix ginger-garlic paste, red chilli powder, turmeric powder, lime juice/vinegar and salt in a bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Apply the marinade to the fish, making sure that it gets into the slits. Allow it marinate for 8 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat oil in a pan till shimmering. Slide in the marinated mackerel and fry on a medium flame for about 4 minutes on each side till golden brown, taking care not to break the skin while flipping.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Serve hot with a sprinkle of lime.",
      "secondary_message": null
    }
  ],
