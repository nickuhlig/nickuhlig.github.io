  "instructions": [
    {
      "id": 1,
      "primary_message": "Cook bacon in a large, heavy-bottomed skillet over medium-low heat until crisp and rendered. Transfer bacon to a paper towel-lined plate. Pour fat into a small bowl and stir in corn starch with a fork.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In medium saucepan, stir cocoa with sugar and salt. Stir in reserved bacon fat/corn starch mixture, milk, milk chocolate, and bittersweet chocolate. Heat over medium heat until, stirring constantly, until chocolate is melted and mixture is hot. Gently whisk to completely homogenize mixture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add Frangelico and bourbon. Pour into individual serving cups. Top with whipped cream, chopped toasted hazelnuts, and a strip of bacon. Serve immediately.",
      "secondary_message": null
    }
  ],
