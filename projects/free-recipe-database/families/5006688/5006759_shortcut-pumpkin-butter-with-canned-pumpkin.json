  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine all ingredients in a medium saucepan and bring to a simmer over medium heat. Reduce the heat to low and simmer gently, uncovered. Cook, stirring occasionally, until the pumpkin butter is thick and spreadable and the bubbles that form in it burst very slowly, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Allow the pumpkin butter to cool to room temperature. Store in a sealed container in the refrigerator.",
      "secondary_message": null
    }
