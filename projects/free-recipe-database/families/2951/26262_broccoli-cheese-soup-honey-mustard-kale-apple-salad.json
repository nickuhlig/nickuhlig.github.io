  "instructions": [
    {
      "id": 420101,
      "primary_message": "Place broth in a large pot. Bring to a boil over medium-high heat.",
      "secondary_message": "1420 ml chicken or vegetable broth"
    },
    {
      "id": 420102,
      "primary_message": "Once the broth is boiling, add broccoli, carrots, cream, and spices to the pot, then stir to combine. Reduce heat to low and cook, stirring occasionally, until broccoli is tender, 10-15 minutes.",
      "secondary_message": "1 ½ (510 g) bags broccoli florets\n1 ½ (283 g) bags shredded carrots\n355 ml heavy whipping cream\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 420103,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place kale and dressing in a large bowl. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": "1 ½ bunches kale\n½ cup honey mustard dressing"
    },
    {
      "id": 420104,
      "primary_message": "Wash, dry, quarter, and core apples; small dice. Add to the bowl with the kale, stir to combine, and set aside.",
      "secondary_message": "3 Gala apples"
    },
    {
      "id": 420105,
      "primary_message": "When the broccoli is tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.)",
      "secondary_message": null
    },
    {
      "id": 420106,
      "primary_message": "Add most of the cheese to the pot (reserving a small handful for garnish). Continue to cook, stirring constantly, until the cheese is melted and combined, 2-3 minutes more. Remove from heat.",
      "secondary_message": "2 cups shredded cheese, Mexican blend"
    },
    {
      "id": 420107,
      "primary_message": "Divide soup between bowls and top with reserved cheese. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
