  "instructions": [
    {
      "id": 420087,
      "primary_message": "Place broth in a medium saucepan. Bring to a boil over medium-high heat.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 420088,
      "primary_message": "Once the broth is boiling, add broccoli, carrots, cream, and spices to the pan, then stir to combine. Reduce heat to low and cook, stirring occasionally, until broccoli is tender, 10-15 minutes.",
      "secondary_message": "½ (510 g) bag broccoli florets\n½ (283 g) bag shredded carrots\n118 ml (½ cup) heavy whipping cream\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 420089,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place kale and dressing in a medium bowl. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": "½ bunch kale\n3 tbsp honey mustard dressing"
    },
    {
      "id": 420090,
      "primary_message": "Wash, dry, quarter, and core apple; small dice. Add to the bowl with the kale, stir to combine, and set aside.",
      "secondary_message": "1 Gala apple"
    },
    {
      "id": 420091,
      "primary_message": "When the broccoli is tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.)",
      "secondary_message": null
    },
    {
      "id": 420092,
      "primary_message": "Add most of the cheese to the pan (reserving a small handful for garnish). Continue to cook, stirring constantly, until the cheese is melted and combined, 1-2 minutes more. Remove from heat.",
      "secondary_message": "⅔ cup shredded cheese, Mexican blend"
    },
    {
      "id": 420093,
      "primary_message": "Divide soup between bowls and top with reserved cheese. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
