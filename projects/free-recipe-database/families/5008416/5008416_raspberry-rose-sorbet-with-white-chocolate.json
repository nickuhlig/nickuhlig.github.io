  "instructions": [
    {
      "id": 1,
      "primary_message": "Allow the sorbet to sit out of the freezer for 10 minutes before you scoop. Scoop 4 large balls of sorbet into 4 small ramekins that just hold each scoop. Drizzle each scoop of sorbet with 1/4 teaspoon rosewater (or to taste). Use a coarse Microplane grater to cover the top in excellent white chocolate. Serve right away.",
      "secondary_message": null
