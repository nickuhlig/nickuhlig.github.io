  "instructions": [
    {
      "id": 571795,
      "primary_message": "Preheat oven to 425°F. Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 571796,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "12 caps portobello mushrooms\n3 crowns broccoli\n3 pints grape tomatoes"
    },
    {
      "id": 571797,
      "primary_message": "Remove stems from portobello mushrooms and carefully scrape out the gills. Rub with oil, then season with salt and pepper; transfer to the baking sheet, cap-side down, and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 571798,
      "primary_message": "Finely grate Parmesan. Divide between a large and a medium bowl. (Set medium bowl aside for later use.)",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 571799,
      "primary_message": "Peel and mince garlic. Add to the large bowl with the Parmesan along with veggie ground, bread crumbs, vinegar, and spices. Mix with your hands until well combined.",
      "secondary_message": "3 cloves garlic\n24 oz veggie ground, plant based\n¾ cup panko bread crumbs\n2 tbsp white wine vinegar\n1 tbsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 571800,
      "primary_message": "Divide the veggie ground mixture between mushrooms (about 2 tablespoons each). Using your hands, spread the mixture over the inside of each mushroom in an even layer, gently pressing to adhere.",
      "secondary_message": null
    },
    {
      "id": 571801,
      "primary_message": "Place mushrooms in the oven (it doesn't have to be fully heated) and roast until they begin to soften, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 571802,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a clean large bowl, along with the tomatoes. Drizzle with oil, season with salt and pepper, then toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 571803,
      "primary_message": "Transfer broccoli and tomatoes to another large baking sheet, spreading them out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 571804,
      "primary_message": "When the mushrooms are starting to soften, remove baking sheet from the oven. Sprinkle remaining Parmesan over the mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 571805,
      "primary_message": "Place both baking sheets in the oven and continue to roast until veggies are fork-tender and sausage is cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 571806,
      "primary_message": "To serve, divide stuffed mushrooms and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
