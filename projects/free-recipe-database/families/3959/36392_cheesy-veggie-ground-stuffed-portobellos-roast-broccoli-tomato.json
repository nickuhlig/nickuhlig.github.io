  "instructions": [
    {
      "id": 571927,
      "primary_message": "Preheat oven to 220°C (425°F). Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 571928,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "8 caps portobello mushrooms\n2 crowns broccoli\n2 small pkgs grape tomatoes"
    },
    {
      "id": 571929,
      "primary_message": "Remove stems from portobello mushrooms and carefully scrape out the gills. Rub with oil, then season with salt and pepper; transfer to the baking sheet, cap-side down, and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 571930,
      "primary_message": "Finely grate Parmesan. Divide between a medium and a small bowl. (Set small bowl aside for later use.)",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 571931,
      "primary_message": "Peel and mince garlic. Add to the medium bowl with the Parmesan along with veggie ground, bread crumbs, vinegar, and spices. Mix with your hands until well combined.",
      "secondary_message": "2 cloves garlic\n454 g veggie ground, plant based\n½ cup panko bread crumbs\n4 tsp white wine vinegar\n2 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 571932,
      "primary_message": "Divide the veggie ground mixture between mushrooms (about 2 tablespoons each). Using your hands, spread the mixture over the inside of each mushroom in an even layer, gently pressing to adhere.",
      "secondary_message": null
    },
    {
      "id": 571933,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until mushrooms begin to soften, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 571934,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a clean medium bowl, along with the tomatoes. Drizzle with oil, season with salt and pepper, then toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 571935,
      "primary_message": "Transfer broccoli and tomatoes to another baking sheet, spreading them out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 571936,
      "primary_message": "When the mushrooms are starting to soften, remove baking sheet from the oven. Sprinkle remaining Parmesan over the mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 571937,
      "primary_message": "Place both baking sheets in the oven and continue to roast until veggies are fork-tender and veggie ground is cooked through, 12-15 minutes more. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 571938,
      "primary_message": "To serve, divide stuffed mushrooms and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
