  "ingredients": [
    {
      "ingredient_id": 1729,
      "name": "70% cocoa chocolate",
      "quantity": "340 g"
    },
    {
      "ingredient_id": 115,
      "name": "unsalted butter",
      "quantity": "2 sticks"
    },
    {
      "ingredient_id": 121,
      "name": "eggs",
      "quantity": "5"
    },
    {
      "ingredient_id": 1903,
      "name": "superfine sugar",
      "quantity": "1 cup"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat the oven to 150°C (300°F) degrees.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using extra butter, grease a 25-cm round cake pan and line with baking parchment.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Break the chocolate into pieces and melt with butter in a bowl over simmering water. Beat the eggs and 5 tablespoons of the sugar in an electric mixer until the volume quadruples.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat the remaining sugar with 7 tablespoons of water until dissolved into a light syrup. Pour the hot syrup into the melted chocolate and cool slightly.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add the chocolate to the eggs and beat slowly until the mixture is combined. Pour into the pan.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Put a folded dish towel in the bottom of a roasting pan. Put in the cake and add enough hot water to come three-quarters of the way up the side of the cake pan.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Bake in the oven for 1 hour until set. Leave the cake to cool in the water before unmolding.",
      "secondary_message": null
    }
  ],
