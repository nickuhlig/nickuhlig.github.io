  "instructions": [
    {
      "id": 556017,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 556018,
      "primary_message": "Wash, dry, and halve new potatoes. Divide between two large baking sheet pans, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 ½ lb new potatoes\n1 tbsp extra virgin olive oil\n1 ½ tsp rosemary, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 556019,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until potatoes start to soften, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 556020,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into 3-inch long pieces. Place in a large bowl, along with oil, salt, and pepper, then toss to coat. Set aside.",
      "secondary_message": "3 small bunches asparagus\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 556021,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 556022,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 556023,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest. (Reserve skillet with drippings for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 556024,
      "primary_message": "When the potatoes have started to soften, remove baking sheets from the oven, add asparagus, and toss to combine. Return baking sheets to oven and continue to roast until veggies are golden and fork-tender, 10-12 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 556025,
      "primary_message": "Meanwhile, peel, halve, and slice onions lengthwise into thin strips. Place in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 556026,
      "primary_message": "Thinly slice apricots. Add to the bowl with the onion.",
      "secondary_message": "12 dried apricots"
    },
    {
      "id": 556027,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 556028,
      "primary_message": "Return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add onion, apricots, garlic, salt, and pepper; cook, stirring occasionally, until onions are soft, 8-10 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 556029,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 556030,
      "primary_message": "To serve, divide steak, potatoes, and asparagus between plates; top steak with apricot-onion sauté. Enjoy!",
      "secondary_message": null
    }
  ],
