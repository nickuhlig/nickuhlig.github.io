  "instructions": [
    {
      "id": 556045,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 556046,
      "primary_message": "Wash, dry, and halve new potatoes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "0.45 kg new potatoes\n2 tsp extra virgin olive oil\n1 tsp rosemary, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 556047,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until potatoes start to soften, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 556048,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into 3-inch long pieces. Place in a medium bowl, along with oil, salt, and pepper, then toss to coat. Set aside.",
      "secondary_message": "2 small bunches asparagus\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 556049,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 556050,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "0.68 kg ribeye steak\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 556051,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 556052,
      "primary_message": "When the potatoes have started to soften, remove baking sheet from the oven, add asparagus, and toss to combine. Return baking sheet to oven and continue to roast until veggies are golden and fork-tender, 10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 556053,
      "primary_message": "Meanwhile, peel, halve, and slice onion lengthwise into thin strips. Place in a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 556054,
      "primary_message": "Thinly slice apricots. Add to the bowl with the onion.",
      "secondary_message": "8 dried apricots"
    },
    {
      "id": 556055,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 556056,
      "primary_message": "Return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add onion, apricots, garlic, salt, and pepper; cook, stirring occasionally, until onions are soft, 6-8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 556057,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 556058,
      "primary_message": "To serve, divide steak, potatoes, and asparagus between plates; top steak with apricot-onion sauté. Enjoy!",
      "secondary_message": null
    }
  ],
