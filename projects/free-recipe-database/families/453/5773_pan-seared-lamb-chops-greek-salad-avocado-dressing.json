  "instructions": [
    {
      "id": 69055,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ pint grape tomatoes\n1 ½ English cucumber\n1 ½ avocados\n1 ½ lemon\n1 ½ head romaine lettuce"
    },
    {
      "id": 69054,
      "primary_message": "Trim off and discard the root end of the lettuce and remove any blemished leaves; quarter the lettuce lengthwise, then chop crosswise into 1-inch pieces and transfer to a large salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 69062,
      "primary_message": "Trim off and discard the ends of the cucumber; slice the cucumber crosswise into ⅛-inch-thick rounds and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 69061,
      "primary_message": "Halve the tomatoes and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 69053,
      "primary_message": "Halve the olives lengthwise and add to the salad bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 69060,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 69052,
      "primary_message": "While the skillet heats up, trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 69059,
      "primary_message": "Grate all of the zest from the lemons, then juice the lemons into a small bowl (that will be used for the salad dressing) and set aside.",
      "secondary_message": ""
    },
    {
      "id": 69051,
      "primary_message": "In a small bowl, combine and mix together ½ of the garlic (save the rest for the salad dressing), lemon zest, oregano, salt, and pepper.",
      "secondary_message": "3 tsp dried oregano\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 69050,
      "primary_message": "Pat dry the lamb chops with paper towels and place on a plate; rub both sides of the chops with the spice mixture.",
      "secondary_message": "18 lamb rib chops"
    },
    {
      "id": 69058,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 69057,
      "primary_message": "Place the lamb chops in the skillet; cook until they are nicely seared and cooked to your desired doneness, 3 to 4 minutes per side. Once done, transfer the chops to a plate and let them rest for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 69048,
      "primary_message": "While the lamb chops cook, halve the avocado lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out the flesh into the bowl with the lemon juice and mash with a fork until smooth.",
      "secondary_message": ""
    },
    {
      "id": 69049,
      "primary_message": "To make the dressing, add the remaining garlic, olive oil, salt, and pepper to the avocado and lemon mixture; mix together.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 69056,
      "primary_message": "To serve, arrange the salad on a plate, spoon the avocado dressing overtop, and place the lamb chops on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
