  "instructions": [
    {
      "id": 335324,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 335325,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg green beans\n6 medium carrots\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 335326,
      "primary_message": "Trim green beans and divide between two baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 335327,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long pieces; add to the baking sheets with the green beans. Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 335328,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender, 20-25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 335329,
      "primary_message": "Meanwhile, place pork, coconut, and spices in a large bowl; using your hands, mix well to combine.",
      "secondary_message": "1.02 kg lean ground pork\n⅓ cup shredded unsweetened coconut\n1 ½ tsp coriander, ground\n¾ tsp cinnamon, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 335330,
      "primary_message": "Using a tablespoon measure, form the pork mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 335331,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 335332,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; working in batches if necessary, add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 335333,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 335334,
      "primary_message": "When the meatballs are done, add broth, cream, and cilantro to the pot, then bring sauce to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until sauce thickens slightly and coats meatballs, 4-5 minutes more.",
      "secondary_message": "355 ml chicken or vegetable broth\n177 ml heavy whipping cream"
    },
    {
      "id": 335335,
      "primary_message": "Juice limes into the pot, stir to combine, and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 335336,
      "primary_message": "To serve, divide veggies, meatballs, and sauce between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
