  "instructions": [
    {
      "id": 335272,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 335273,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb green beans\n4 medium carrots\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 335274,
      "primary_message": "Trim green beans and transfer to a large baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 335275,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long pieces; add to the baking sheet with the green beans. Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 335276,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 335277,
      "primary_message": "Meanwhile, place veggie ground, coconut, and spices in a medium bowl; using your hands, mix well to combine.",
      "secondary_message": "16 oz veggie ground, plant based\n½ cup shredded unsweetened coconut\n1 tsp coriander, ground\n½ tsp cinnamon, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 335278,
      "primary_message": "Using a tablespoon measure, form the mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 335279,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 335280,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 335281,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 335282,
      "primary_message": "When the meatballs are done, add broth, cream, and cilantro to the skillet, then bring sauce to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until sauce thickens slightly and coats meatballs, 3-4 minutes more.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 335283,
      "primary_message": "Juice lime into the skillet, stir to combine, and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 335284,
      "primary_message": "To serve, divide veggies, meatballs, and sauce between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
