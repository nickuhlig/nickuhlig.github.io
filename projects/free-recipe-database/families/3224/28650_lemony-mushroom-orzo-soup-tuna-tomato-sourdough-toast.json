  "instructions": [
    {
      "id": 457892,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb cremini mushrooms\n3 tomatoes\n1 ½ lemons"
    },
    {
      "id": 457893,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 457894,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 457895,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Add to the bowl with the mushrooms.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 457896,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the mushrooms, onion, and spices. Cook, stirring occasionally, until the mushrooms are tender, 10-12 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 457897,
      "primary_message": "Meanwhile, drain tuna, place in the reserved bowl, and flake with a fork. Add mayo and spices, then stir to combine the tuna salad. Set aside.",
      "secondary_message": "3 (6 oz) cans chunk light tuna in water\n⅓ cup mayonnaise\n¾ tsp dill, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 457898,
      "primary_message": "Slice tomatoes crosswise into thin rounds and set aside.",
      "secondary_message": null
    },
    {
      "id": 457899,
      "primary_message": "When the mushrooms are tender, zest and juice lemons into the pot, then add broth and orzo. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to medium-low and cook until the pasta is tender, 7-8 minutes. Remove from heat.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n6 oz orzo pasta"
    },
    {
      "id": 457900,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 457901,
      "primary_message": "Arrange bread slices on a large baking sheet pan. Place in the oven and broil until toasted, 1-2 minutes. Remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "6 slices sourdough bread"
    },
    {
      "id": 457902,
      "primary_message": "Divide tuna salad between toasted bread and top with tomato slices. Season with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 457903,
      "primary_message": "Divide soup between bowls and serve with tuna-tomato toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
