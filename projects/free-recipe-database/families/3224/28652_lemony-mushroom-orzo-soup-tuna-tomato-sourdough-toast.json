  "instructions": [
    {
      "id": 457916,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg cremini mushrooms\n2 tomatoes\n1 lemon"
    },
    {
      "id": 457917,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 457918,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 457919,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Add to the bowl with the mushrooms.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 457920,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the mushrooms, onion, and spices. Cook, stirring occasionally, until the mushrooms are tender, about 10 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 457921,
      "primary_message": "Meanwhile, drain tuna, place in the reserved bowl, and flake with a fork. Add mayo and spices, then stir to combine the tuna salad. Set aside.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water\n¼ cup mayonnaise\n½ tsp dill, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 457922,
      "primary_message": "Slice tomatoes crosswise into thin rounds and set aside.",
      "secondary_message": null
    },
    {
      "id": 457923,
      "primary_message": "When the mushrooms are tender, zest and juice lemon into the pot, then add broth and orzo. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to medium-low and cook until the pasta is tender, 7-8 minutes. Remove from heat.",
      "secondary_message": "1893 ml chicken or vegetable broth\n113 g orzo pasta"
    },
    {
      "id": 457924,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 457925,
      "primary_message": "Arrange bread slices on a baking sheet pan. Place in the oven and broil until toasted, 1-2 minutes. Remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 457926,
      "primary_message": "Divide tuna salad between toasted bread and top with tomato slices. Season with salt and pepper.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 457927,
      "primary_message": "Divide soup between bowls and serve with tuna-tomato toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
