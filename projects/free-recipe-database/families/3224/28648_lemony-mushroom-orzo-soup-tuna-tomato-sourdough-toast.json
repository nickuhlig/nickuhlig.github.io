  "instructions": [
    {
      "id": 457868,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb cremini mushrooms\n1 tomato\n½ lemon"
    },
    {
      "id": 457869,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 457870,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 457871,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl with the mushrooms.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 457872,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the mushrooms, onion, and spices. Cook, stirring occasionally, until the mushrooms are tender, about 10 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 457873,
      "primary_message": "Meanwhile, drain tuna, place in the reserved bowl, and flake with a fork. Add mayo and spices, then stir to combine the tuna salad. Set aside.",
      "secondary_message": "1 (6 oz) can chunk light tuna in water\n2 tbsp mayonnaise\n¼ tsp dill, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 457874,
      "primary_message": "Slice tomato crosswise into thin rounds and set aside.",
      "secondary_message": null
    },
    {
      "id": 457875,
      "primary_message": "When the mushrooms are tender, zest and juice lemon into the pan, then add broth and orzo. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to medium-low and cook until the pasta is tender, 7-8 minutes. Remove from heat.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 oz orzo pasta"
    },
    {
      "id": 457876,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 457877,
      "primary_message": "Arrange bread slices on a baking sheet pan. Place in the oven and broil until toasted, 1-2 minutes. Remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "2 slices sourdough bread"
    },
    {
      "id": 457878,
      "primary_message": "Divide tuna salad between toasted bread and top with tomato slices. Season with salt and pepper.",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 457879,
      "primary_message": "Divide soup between bowls and serve with tuna-tomato toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
