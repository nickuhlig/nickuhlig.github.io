  "instructions": [
    {
      "id": 46788,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n½ tsp salt\n2 cups water"
    },
    {
      "id": 46789,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n1 small bunch fresh basil"
    },
    {
      "id": 46790,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and roughly chop the leaves. Transfer to a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 46791,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 46792,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 46793,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 46794,
      "primary_message": "While the skillet heats up, drain and large dice the tofu (cut into 2-cm cubes); place the cubes on paper towels or a clean towel and pat dry.",
      "secondary_message": "2 (340 g) pkg extra firm tofu"
    },
    {
      "id": 46795,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 46796,
      "primary_message": "Add the tofu to the skillet and cook, stirring occasionally, until golden brown, 8 to 10 minutes. Once done, transfer the tofu to a bowl.",
      "secondary_message": null
    },
    {
      "id": 46797,
      "primary_message": "While the tofu cooks, trim off and discard the ends of the eggplants; large dice the eggplants (cut into 2-cm cubes).",
      "secondary_message": null
    },
    {
      "id": 46798,
      "primary_message": "Once the tofu has been transferred, add more coconut oil to the skillet followed by the garlic. Cook the garlic until fragrant, 15 to 30 seconds.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 46799,
      "primary_message": "Add the eggplants to the skillet; cook, stirring occasionally, until the eggplant is tender, 6 to 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 46800,
      "primary_message": "In a medium bowl, combine and whisk together water, soy sauce, rice vinegar, honey, sesame oil, cornstarch, and crushed red pepper.",
      "secondary_message": "4 tbsp water\n4 tbsp soy sauce\n2 tbsp rice vinegar\n2 tsp honey\n1 tsp toasted sesame oil\n2 tsp cornstarch\n¼ tsp crushed red pepper"
    },
    {
      "id": 46801,
      "primary_message": "Add the tofu and about ¾ of the basil (save the rest for garnishing) to the skillet, then pour in the sauce; stir until the tofu and eggplant are thoroughly coated in the sauce the sauce has thickened, 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 46802,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 46803,
      "primary_message": "To serve, divide the rice between plates or bowls, top with the stir fry, and garnish with the remaining basil. Enjoy!",
      "secondary_message": null
    }
  ],
