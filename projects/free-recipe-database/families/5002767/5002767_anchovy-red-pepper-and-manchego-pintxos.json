  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the garlic in half. Drain and cut the jarred roasted red bell pepper into 12 slivers. Drain the olive oil-packed anchovy fillets.",
      "secondary_message": "1 medium clove garlic\n1 jarred roasted red bell pepper\n12 olive oil-packed anchovy fillets"
    },
    {
      "id": 1,
      "primary_message": "Brush both sides of the baguette slices with the olive oil, then place the baguette slices on a baking sheet. Lightly toast the bread directly under the broiler until golden brown, 30-seconds to 1 minute per side. Remove the bread from the broiler and rub the top of each baguette slice with the cut side of the garlic.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place the manchego slices on each slice of bread, followed by a sliver of roasted red bell pepper, followed by an anchovy fillet. Return the baguette slices to the broiler and broil just until the cheese melts, 30-seconds to 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove the topped baguette slices from the oven, then secure each with a toothpick. sprinkle with sherry vinegar and serve immediately.",
      "secondary_message": null
    }
  ],
