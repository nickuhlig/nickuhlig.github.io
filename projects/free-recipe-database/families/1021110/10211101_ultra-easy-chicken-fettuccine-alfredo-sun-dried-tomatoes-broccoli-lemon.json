  "instructions": [
    {
      "primary_message": "Spread noodles over the bottom of a large skillet. Shake sauce package to combine, then add to the skillet along with 1/2-cup water. Set skillet over medium-high heat and cook, stirring gently and frequently, for 6 minutes.",
      "secondary_message": "1 (1106 g) pkg chicken fettuccine Alfredo meal kit"
    },
    {
      "primary_message": "While the pasta is heating, slice sun-dried tomatoes into thin strips. Add tomatoes and chicken to the skillet; continue to cook, stirring often, until heated through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "6 sun-dried tomatoes, oil-packed"
    },
    {
      "primary_message": "Meanwhile, place broccoli bag on a microwave safe plate and pierce with a fork. Place in the microwave and cook on high, until tender, 4-5 minutes. Remove plate from microwave and carefully open the bag to let out the steam. ",
      "secondary_message": "1 (340 g) bag broccoli florets"
    },
    {
      "primary_message": "While the broccoli is cooking, wash, dry, and cut lemon into wedges.",
      "secondary_message": "½ lemon"
    },
    {
      "primary_message": "To serve, divide chicken fettuccine and broccoli between plates. Juice lemon over top, then season to taste with salt and pepper. Enjoy!",
      "secondary_message": null
    }
  ],
