  "instructions": [
    {
      "id": 366706,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse.",
      "secondary_message": "142 g flat rice (pad thai) noodles"
    },
    {
      "id": 366707,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 366708,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and slice crosswise into thin strips. Sprinkle with cornstarch, salt, and pepper.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n1 tsp cornstarch\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 366709,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and stir-fry until cooked through, 4-5 minutes. Transfer steak to a plate and loosely cover with aluminum foil. (Reserve skillet with drippings for later use.)",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 366710,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n1 red bell pepper\n1 (2 ½ cm) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 366711,
      "primary_message": "Using a clean cutting board, trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 366712,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 366713,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 366714,
      "primary_message": "Return skillet (with drippings) to medium heat. Add veggies, salt, and pepper; stir-fry until veggies are fork-tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 366715,
      "primary_message": "While the veggies are cooking, place soy sauce, water, fish sauce, and additional cornstarch in the reserved bowl. Whisk to combine.",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp water\n1 tsp fish sauce\n½ tsp cornstarch"
    },
    {
      "id": 366716,
      "primary_message": "When the veggies are done, add sauce to the skillet and cook, stirring occasionally, until thickened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 366717,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 366718,
      "primary_message": "Once the sauce has thickened, add noodles, steak, and green onions to the skillet. Toss to coat and continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 366719,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
