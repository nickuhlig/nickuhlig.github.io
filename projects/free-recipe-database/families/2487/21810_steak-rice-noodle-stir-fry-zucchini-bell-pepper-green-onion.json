  "instructions": [
    {
      "id": 366734,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 366735,
      "primary_message": "Meanwhile, pat steak dry with paper towels and slice crosswise into thin strips. Sprinkle with cornstarch, salt, and pepper.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 tbsp cornstarch\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 366736,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 366737,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add steak and stir-fry until cooked through, 5-6 minutes. Transfer steak to a plate and loosely cover with aluminum foil. (Reserve pot with drippings for later use.)",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 366738,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 366739,
      "primary_message": "Using a clean cutting board, trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 366740,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 366741,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 366742,
      "primary_message": "Return pot (with drippings) to medium heat. Add veggies, salt, and pepper; stir-fry until veggies are fork-tender, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 366743,
      "primary_message": "While the veggies are cooking, place soy sauce, water, fish sauce, and cornstarch in the reserved bowl. Whisk to combine.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp water\n1 tbsp fish sauce\n1 ½ tsp cornstarch"
    },
    {
      "id": 366744,
      "primary_message": "When the veggies are done, add sauce to the pot and cook, stirring occasionally, until thickened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 366745,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 366746,
      "primary_message": "Once the sauce has thickened, add noodles, steak, and green onions to the pot. Toss to coat and continue to cook until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 366747,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
