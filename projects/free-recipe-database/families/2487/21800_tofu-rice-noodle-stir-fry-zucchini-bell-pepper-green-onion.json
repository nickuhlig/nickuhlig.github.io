  "instructions": [
    {
      "id": 366589,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 366590,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse.",
      "secondary_message": "10 oz flat rice (pad thai) noodles"
    },
    {
      "id": 366591,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 366592,
      "primary_message": "Medium dice tofu, then sprinkle with cornstarch, salt, and pepper.",
      "secondary_message": "4 tsp cornstarch\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 366593,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and stir-fry until golden and crispy, 7-8 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 366594,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 red bell peppers\n2 (1 inch) pieces ginger root\n1 lime\n1 small bunch green onions (scallions)"
    },
    {
      "id": 366595,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 366596,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 366597,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 366598,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add veggies, salt, and pepper; stir-fry until fork-tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 366599,
      "primary_message": "While the veggies are cooking, juice lime into the reserved bowl. Add soy sauce, water, and additional cornstarch, then whisk to combine the sauce.",
      "secondary_message": "¼ cup soy sauce\n2 tbsp water\n2 tsp cornstarch"
    },
    {
      "id": 366600,
      "primary_message": "When the veggies are done, add sauce to the skillet and cook, stirring occasionally, until thickened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 366601,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 366602,
      "primary_message": "Once the sauce has thickened, add noodles, tofu, and green onions to the skillet. Toss to coat and continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 366603,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
