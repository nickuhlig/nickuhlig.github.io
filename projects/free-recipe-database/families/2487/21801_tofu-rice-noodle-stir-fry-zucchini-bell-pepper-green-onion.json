  "instructions": [
    {
      "id": 366604,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 366605,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 366606,
      "primary_message": "Meanwhile, medium dice tofu, then sprinkle with cornstarch, salt, and pepper.",
      "secondary_message": "2 tbsp cornstarch\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 366607,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 366608,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add tofu and stir-fry until golden and crispy, 8-10 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve pot for later use.)",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 366609,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n3 (1 inch) pieces ginger root\n1 ½ limes\n1 small bunch green onions (scallions)"
    },
    {
      "id": 366610,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 366611,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 366612,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 366613,
      "primary_message": "Return pot to medium heat, add more oil, and swirl to coat the bottom. Add veggies, salt, and pepper; stir-fry until fork-tender, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 366614,
      "primary_message": "While the veggies are cooking, juice limes into the reserved bowl. Add soy sauce, water, and cornstarch, then whisk to combine the sauce.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp water\n1 tbsp cornstarch"
    },
    {
      "id": 366615,
      "primary_message": "When the veggies are done, add sauce to the pot and cook, stirring occasionally, until thickened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 366616,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 366617,
      "primary_message": "Once the sauce has thickened, add noodles, tofu, and green onions to the pot. Toss to coat and continue to cook until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 366618,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
