  "instructions": [
    {
      "id": 64132,
      "primary_message": "Heat a large saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 64131,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onion\n6 cloves garlic"
    },
    {
      "id": 64130,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and garlic; begin cooking while you prepare the squash.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 64123,
      "primary_message": "Wash squash, cut off ends, and peel. Halve, scrape out seeds, medium dice the flesh, and add to saucepan. Stirring occasionally, cook until onion is softened, 3-4 minutes.",
      "secondary_message": "3 small butternut squash"
    },
    {
      "id": 64129,
      "primary_message": "In a small bowl, prepare salad dressing by whisking together olive oil, vinegar, maple syrup, salt, and pepper. Set aside.",
      "secondary_message": "4 ½ tbsp extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n¾ tsp pure maple syrup\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 64128,
      "primary_message": "Add broth, salt, and pepper to saucepan. Increase heat to medium-high, cover, and cook until squash is tender, 10-15 minutes.",
      "secondary_message": "1416 ml (6 cups) chicken or vegetable broth\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 64127,
      "primary_message": "Wash and dry arugula. Transfer to a large bowl.",
      "secondary_message": "1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 64126,
      "primary_message": "Wash, core, and cut apples into thin wedges. Add to arugula.",
      "secondary_message": "3 Gala apple"
    },
    {
      "id": 64125,
      "primary_message": "Purée soup using a hand or regular blender until smooth.",
      "secondary_message": ""
    },
    {
      "id": 64124,
      "primary_message": "Pour soup into a bowl and garnish with pumpkin seeds. Place salad on the side and drizzle with dressing. Enjoy!",
      "secondary_message": "⅜ cup pumpkin seeds"
    }
  ],
