  "instructions": [
    {
      "id": 413096,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 413097,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n6 tomatoes\n1 small bunch cilantro\n1 ½ limes\n3 mangoes\n1 ½ English cucumbers"
    },
    {
      "id": 413098,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 413099,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 413100,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the ginger and garlic and set aside.",
      "secondary_message": null
    },
    {
      "id": 413101,
      "primary_message": "Peel, halve, and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 413102,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 413103,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until beginning to soften, about 4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 413104,
      "primary_message": "When the onion is soft, add ginger, garlic, tomatoes, and spices to the pot. Cook, stirring occasionally, until tomato is soft, about 6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp garam masala\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 413105,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl (setting aside a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 413106,
      "primary_message": "Juice limes into the bowl with the cilantro. Add oil, salt, and pepper; stir to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 413107,
      "primary_message": "Drain and rinse beans in a colander. When the tomato is soft, add beans and water to the pot; stir to combine the curry and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until curry has thickened, 5-7 minutes.",
      "secondary_message": "3 (15 oz) cans kidney beans\n2 ¼ cup water"
    },
    {
      "id": 413108,
      "primary_message": "Meanwhile, peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 413109,
      "primary_message": "Trim and medium dice the cucumbers. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 413110,
      "primary_message": "When the curry is done, remove from heat. Add yogurt and stir to combine.",
      "secondary_message": "1 cup plain Greek yogurt"
    },
    {
      "id": 413111,
      "primary_message": "To serve, divide rice, curry, and salad between plates or bowls; top curry with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
