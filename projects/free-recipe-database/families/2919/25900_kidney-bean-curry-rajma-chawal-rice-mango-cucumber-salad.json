  "instructions": [
    {
      "id": 413112,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 413113,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n2 tomatoes\n½ small bunch cilantro\n½ lime\n1 mango\n½ English cucumber"
    },
    {
      "id": 413114,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 413115,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a medium bowl and set aside.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 413116,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 413117,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 413118,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until beginning to soften, about 3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 413119,
      "primary_message": "While the onion is cooking, medium dice tomatoes. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 413120,
      "primary_message": "When the onion is soft, add ginger, garlic, tomatoes, and spices to the skillet. Cook, stirring occasionally, until tomato is soft, about 5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 ½ tsp garam masala\n½ tsp turmeric, ground\n½ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 413121,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl (setting aside a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 413122,
      "primary_message": "Juice lime into the bowl with the cilantro. Add oil, salt, and pepper; stir to combine the dressing and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 413123,
      "primary_message": "Drain and rinse beans in a colander. When the tomato is soft, add beans and water to the skillet; stir to combine the curry and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until curry has thickened, about 5 minutes. Remove from heat.",
      "secondary_message": "1 (15 oz) can kidney beans\n¾ cup water"
    },
    {
      "id": 413124,
      "primary_message": "Meanwhile, peel mango and slice flesh away from the pit, starting with the flat sides; medium dice. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 413125,
      "primary_message": "Trim and medium dice the cucumber. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 413126,
      "primary_message": "To serve, divide rice, curry, and salad between plates or bowls; top curry with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
