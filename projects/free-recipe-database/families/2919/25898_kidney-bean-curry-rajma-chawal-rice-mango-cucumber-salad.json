  "instructions": [
    {
      "id": 413080,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 413081,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n4 tomatoes\n1 small bunch cilantro\n1 lime\n2 mangoes\n1 English cucumber"
    },
    {
      "id": 413082,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 413083,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a medium bowl and set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 413084,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 413085,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 413086,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until beginning to soften, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 413087,
      "primary_message": "While the onion is cooking, medium dice tomatoes. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 413088,
      "primary_message": "When the onion is soft, add ginger, garlic, tomatoes, and spices to the skillet. Cook, stirring occasionally, until tomato is soft, about 5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp garam masala\n1 tsp turmeric, ground\n1 tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 413089,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl (setting aside a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 413090,
      "primary_message": "Juice lime into the bowl with the cilantro. Add oil, salt, and pepper; stir to combine the dressing and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 413091,
      "primary_message": "Drain and rinse beans in a colander. When the tomato is soft, add beans and water to the skillet; stir to combine the curry and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until curry has thickened, about 5 minutes.",
      "secondary_message": "2 (15 oz) cans kidney beans\n1 ½ cup water"
    },
    {
      "id": 413092,
      "primary_message": "Meanwhile, peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 413093,
      "primary_message": "Trim and medium dice the cucumber. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 413094,
      "primary_message": "When the curry is done, remove from heat. Add yogurt and stir to combine.",
      "secondary_message": "⅔ cup plain Greek yogurt"
    },
    {
      "id": 413095,
      "primary_message": "To serve, divide rice, curry, and salad between plates or bowls; top curry with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
