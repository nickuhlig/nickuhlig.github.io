  "instructions": [
    {
      "id": 217833,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 217834,
      "primary_message": "Wash and dry pineapple. Cut off skin, quarter, core, and cut into ½-inch pieces; transfer to a baking dish.",
      "secondary_message": "1 small pineapple"
    },
    {
      "id": 217835,
      "primary_message": "Using a box grater, coarsely grate cold butter. Sprinkle butter, sugar, clove, and cardamom over the pineapple; stir to combine, then spread out in an even layer.",
      "secondary_message": "2 tbsp butter, unsalted\n2 tbsp brown sugar\n⅛ tsp clove, ground\n⅛ tsp cardamom, ground"
    },
    {
      "id": 217836,
      "primary_message": "Place pineapple in the oven (it doesn't have to be fully heated) and roast until tender and lightly caramelized, 15-20 minutes. Remove from oven and let cool slightly.",
      "secondary_message": null
    },
    {
      "id": 217837,
      "primary_message": "Meanwhile, melt additional butter in a medium saucepan over low heat.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 217838,
      "primary_message": "Once butter is melted, whisk in cream, sugar, honey, and salt. Increase heat to medium and simmer, whisking frequently, until caramel sauce is slightly thickened and glossy, about 2 minutes. Remove from heat and let cool slightly to further thicken the sauce.",
      "secondary_message": "2 fl oz (¼ cup) heavy cream\n¼ cup brown sugar\n2 tbsp honey\n⅛ tsp salt"
    },
    {
      "id": 217839,
      "primary_message": "To serve, place one scoop of ice cream in the bottom of each bowl; top with half the caramel sauce and the roasted pineapple. Place a second scoop of ice cream on top of the pineapple, drizzle with remaining caramel sauce, and enjoy!",
      "secondary_message": "24 fl oz (3 cups) vanilla ice cream"
    }
  ],
