  "instructions": [
    {
      "id": 484157,
      "primary_message": "Preheat oven to 350°F. Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 484158,
      "primary_message": "Peel banana, break into chunks, and place in a medium bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "1 banana"
    },
    {
      "id": 484159,
      "primary_message": "Roughly chop pecans. Add to the bowl with the banana along with egg and maple syrup. Stir to combine.",
      "secondary_message": "¼ cup pecan halves\n1 egg\n1 tbsp pure maple syrup"
    },
    {
      "id": 484160,
      "primary_message": "Wash and dry blueberries. Add to the bowl along with oats, protein powder, cinnamon, and salt. Stir once more to combine the batter.",
      "secondary_message": "½ (6 oz) pkg blueberries\n¾ cup oats, quick cooking\n1 serving vanilla whey-based protein powder (containing 20 grams protein/serving)\n½ tsp cinnamon, ground\n1 pinch salt"
    },
    {
      "id": 484161,
      "primary_message": "Using a ¼-cup measure, scoop batter onto the baking sheet, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 484162,
      "primary_message": "Allow to cool for a few minutes before transferring to plates. Enjoy!",
      "secondary_message": null
    }
  ],
