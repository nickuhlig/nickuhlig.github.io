  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium and 4 mini food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Place blue cheese, sour cream, and mayo in a small bowl. Mash with a fork until semi-smooth and no large chunks remain. ",
      "secondary_message": "¼ cup crumbled blue cheese\n2 tbsp sour cream\n2 tbsp mayonnaise"
    },
    {
      "primary_message": "Add buttermilk, vinegar, sugar, and spices to the bowl, then stir to combine. Add additional blue cheese to the bowl, then stir once more to combine the dressing. Divide between mini containers, cover with lids, and set aside.",
      "secondary_message": "2 tbsp reduced-fat buttermilk\n1 tsp white wine vinegar\n¼ tsp granulated sugar\n⅛ tsp onion powder\n⅛ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper\ncrumbled blue cheese"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 head iceberg lettuce\n1 pint cherry tomatoes\n½ small pkg chives"
    },
    {
      "primary_message": "Trim and quarter lettuce head lengthwise, to make 4 wedges. Divide wedges between medium food storage containers (cutting them into smaller pieces if needed to fit the size of your containers).",
      "secondary_message": null
    },
    {
      "primary_message": "Halve tomatoes. Chop chives into small pieces. Sprinkle tomatoes and chives over lettuce wedges. Add dressing to each container, then cover and refrigerate.",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, drizzle dressing over salad and enjoy!",
      "secondary_message": null
    }
  ],
