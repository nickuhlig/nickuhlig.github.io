  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry potatoes. Prick all over with a fork, then transfer to a baking sheet pan.\n\n",
      "secondary_message": "4 medium russet potatoes"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until potatoes are tender, so a knife can easily pierce through the flesh, about 1 hour. Remove from oven and allow to cool slightly, 10 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and separate broccoli into small florets; thinly slice the stems. Place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil over medium-high heat, then cook until tender, 2-3 minutes. Drain in a colander and set aside.\n\n",
      "secondary_message": "1 crown broccoli\n½ tsp salt"
    },
    {
      "primary_message": "When the potatoes are cool enough to handle, slice in half lengthwise and carefully scoop the flesh into a medium bowl, leaving about 1/4-inch of potato attached to the skins. Return potato skins, cut-side up, to the baking sheet and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Add sour cream, dressing, salt, and pepper to the bowl with the potato and mash to combine.\n\n",
      "secondary_message": "⅓ cup sour cream\n⅓ cup ranch dressing\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Add cooked broccoli and cheese to the bowl with the mashed potatoes, then stir to combine the filling.",
      "secondary_message": "1 cup cheddar cheese, shredded"
    },
    {
      "primary_message": "Spoon the filling back into the reserved potato skins. Return baking sheet to the oven and continue to bake until cheese is melted and filling is warmed through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide potatoes between plates and enjoy!",
      "secondary_message": null
    }
  ],
