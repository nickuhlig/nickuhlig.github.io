  "instructions": [
    {
      "id": 203991,
      "primary_message": "Preheat oven to 205°C (400°F). Coat a baking dish with a thin layer of butter.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 203992,
      "primary_message": "Wash, dry, and halve each apple lengthwise; remove stem and core.",
      "secondary_message": "4 Gala apples"
    },
    {
      "id": 203993,
      "primary_message": "Place apples, cut-side down, in the baking dish. Place in the oven (it doesn't have to be fully heated) and bake until apples are partially cooked through, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 203994,
      "primary_message": "Meanwhile, halve dates lengthwise, then thinly slice crosswise. Place in a medium bowl.",
      "secondary_message": "⅔ cup medjool dates, pitted"
    },
    {
      "id": 203995,
      "primary_message": "Roughly chop pecans; add to the bowl along with cinnamon and salt.",
      "secondary_message": "1 cup pecans, dry roasted\n1 tsp cinnamon\n⅛ tsp salt"
    },
    {
      "id": 203996,
      "primary_message": "Using a box grater, coarsely grate cold butter into the bowl. Stir to combine the date mixture",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 203997,
      "primary_message": "Remove apples from the oven and carefully flip over, so the cut-side is facing up. Divide date mixture between apples, forming a mound on top of each half. Return to the oven and bake until pecans are toasted and apples are fork-tender, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 203998,
      "primary_message": "To serve, divide warm apples between plates and enjoy!",
      "secondary_message": null
    }
  ],
