  "instructions": [
    {
      "id": 203895,
      "primary_message": "Preheat oven to 400°F. Coat a baking dish with a thin layer of oil.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 203896,
      "primary_message": "Wash, dry, and halve each apple lengthwise; remove stem and core.",
      "secondary_message": "4 Gala apples"
    },
    {
      "id": 203897,
      "primary_message": "Place apples, cut-side down, in the baking dish. Place in the oven (it doesn't have to be fully heated) and bake until apples are partially cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 203898,
      "primary_message": "Meanwhile, place flour, sugar, cinnamon, and salt in a medium bowl; stir to combine.",
      "secondary_message": "⅔ cup all-purpose flour\n⅓ cup brown sugar\n½ tsp cinnamon\n⅛ tsp salt"
    },
    {
      "id": 203899,
      "primary_message": "Add oil to the bowl with the flour. Using two hands or a fork, combine the flour and oil by rubbing the mixture between your thumbs and fingers until it looks crumbly. ",
      "secondary_message": "¼ cup virgin coconut oil"
    },
    {
      "id": 203900,
      "primary_message": "Roughly chop pecans and add to the bowl; use your hands to mix and combine with the crumble.",
      "secondary_message": "⅔ cup pecans, dry roasted"
    },
    {
      "id": 203901,
      "primary_message": "Remove apples from the oven and carefully flip over, so the cut-side is facing up. Divide crumble between apples, forming a mound on top of each half. Return to the oven and bake until crumble is golden and apples are fork-tender, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 203902,
      "primary_message": "To serve, divide warm apples between plates and enjoy!",
      "secondary_message": null
    }
  ],
