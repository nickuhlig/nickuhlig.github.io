  "instructions": [
    {
      "id": 291411,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ (142 g) pkg baby spinach\n1 ½ lemons"
    },
    {
      "id": 291412,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 291413,
      "primary_message": "Medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 291414,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 291415,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, transfer crispy bacon to a paper towel-lined plate (leaving the drippings in the pot). Set pot aside for later use.",
      "secondary_message": null
    },
    {
      "id": 291416,
      "primary_message": "Meanwhile, finely grate Parmesan and set aside.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 291417,
      "primary_message": "Using a clean cutting board, cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower and place in another large pot.",
      "secondary_message": null
    },
    {
      "id": 291418,
      "primary_message": "Add hot water (from the tap) to the pot with the cauliflower, filling it about halfway; cover and bring to a boil over medium-high heat. Once the water is boiling, reduce heat to medium and simmer until the cauliflower is tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 291419,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 291420,
      "primary_message": "Return the pot (with bacon drippings) to medium-low heat. Once the pot is hot, add garlic and cook, stirring constantly, until fragrant, about 30 seconds. ",
      "secondary_message": null
    },
    {
      "id": 291421,
      "primary_message": "Add cream, shrimp, and spices to the pot; cook, stirring occasionally, until the shrimp is just opaque, 4-5 minutes.",
      "secondary_message": "177 ml heavy whipping cream\n1 ½ tsp salt\n¾ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 291422,
      "primary_message": "When the cauliflower is done, drain in a strainer and return to the pot. Add Parmesan, butter, salt, and pepper. Using a potato masher, gently mash the cauliflower into a \"grits\" consistency; cover and set aside.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 291423,
      "primary_message": "When the shrimp is done, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Juice lemons into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 291424,
      "primary_message": "To serve, divide cauliflower \"grits\" and creamy shrimp between bowls; top with bacon and enjoy!",
      "secondary_message": null
    }
  ],
