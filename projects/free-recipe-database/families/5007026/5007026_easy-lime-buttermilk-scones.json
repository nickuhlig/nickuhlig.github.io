  "ingredients": [
    {
      "ingredient_id": 116,
      "name": "all-purpose flour",
      "quantity": "1 ¾ cups (8 ¾ oz)"
    },
    {
      "ingredient_id": 346,
      "name": "granulated sugar",
      "quantity": "¼ cup (1 ¾ oz)"
    },
    {
      "ingredient_id": 331,
      "name": "baking powder",
      "quantity": "2 tsp"
    },
    {
      "ingredient_id": 88,
      "name": "salt",
      "quantity": "½ tsp"
    },
    {
      "ingredient_id": 348,
      "name": "baking soda",
      "quantity": "¼ tsp"
    },
    {
      "ingredient_id": 115,
      "name": "cold unsalted butter, cut into cubes",
      "quantity": "9 tbsp (4 ½ oz)"
    },
    {
      "ingredient_id": 2346,
      "name": "lightly packed zest, from 2 whole limes",
      "quantity": "2 tbsp"
    },
    {
