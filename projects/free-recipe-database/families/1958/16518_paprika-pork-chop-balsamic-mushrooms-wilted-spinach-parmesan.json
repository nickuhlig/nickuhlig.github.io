  "instructions": [
    {
      "id": 270011,
      "primary_message": "Preheat the oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 270012,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.91 kg cremini mushrooms\n1 small bunch green onions (scallions)\n2 (142 g) pkg baby spinach"
    },
    {
      "id": 270013,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 270014,
      "primary_message": "Add vinegar, oil, maple syrup, soy sauce, salt, and thyme to the bowl with the garlic; whisk to combine the sauce.",
      "secondary_message": "¼ cup balsamic vinegar\n2 tbsp extra virgin olive oil\n4 tsp pure maple syrup\n4 tsp soy sauce\n½ tsp salt\n½ tsp thyme, dried"
    },
    {
      "id": 270015,
      "primary_message": "Quarter mushrooms, add to the bowl, and toss to coat; transfer to the baking sheet and spread out in an even layer. Place in the oven and roast, stirring halfway through, until tender and caramelized, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 270016,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 270017,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper\n½ tsp thyme, dried"
    },
    {
      "id": 270018,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 270019,
      "primary_message": "While the chops are cooking, finely grate Parmesan and set aside.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 270020,
      "primary_message": "Peel and mince additional garlic. Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 270021,
      "primary_message": "When the chops are done, wipe the skillet clean with paper towels and return to medium heat.",
      "secondary_message": null
    },
    {
      "id": 270022,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add garlic and green onions; cook, stirring constantly, until soft and fragrant, about 1 minute.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 270023,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add Parmesan and salt, stir to combine, and remove from the heat.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 270024,
      "primary_message": "To serve, divide pork chops, mushrooms, and spinach between plates. Enjoy!",
      "secondary_message": null
    }
  ],
