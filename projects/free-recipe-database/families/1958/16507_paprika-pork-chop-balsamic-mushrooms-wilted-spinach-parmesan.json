  "instructions": [
    {
      "id": 269863,
      "primary_message": "Preheat the oven to 450°F. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 269864,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 lb cremini mushrooms\n1 small bunch green onions (scallions)\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 269865,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 269866,
      "primary_message": "Add vinegar, oil, maple syrup, soy sauce, salt, and thyme to the bowl with the garlic; whisk to combine the sauce.",
      "secondary_message": "⅓ cup balsamic vinegar\n3 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n2 tbsp soy sauce\n¾ tsp salt\n¾ tsp thyme, dried"
    },
    {
      "id": 269867,
      "primary_message": "Quarter mushrooms, add to the bowl, and toss to coat; divide between the baking sheets and spread out in an even layer. Place in the oven and roast, stirring halfway through, until tender and caramelized, about 18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 269868,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 269869,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a large plate; season with spices on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp thyme, dried"
    },
    {
      "id": 269870,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 269871,
      "primary_message": "While the chops are cooking, finely grate Parmesan and set aside.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 269872,
      "primary_message": "Peel and mince additional garlic. Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 269873,
      "primary_message": "When the chops are done, wipe the skillet clean with paper towels and return to medium heat.",
      "secondary_message": null
    },
    {
      "id": 269874,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add garlic and green onions; cook, stirring constantly, until soft and fragrant, 1-2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 269875,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add Parmesan and salt, stir to combine, and remove from the heat.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 269876,
      "primary_message": "To serve, divide pork chops, mushrooms, and spinach between plates. Enjoy!",
      "secondary_message": null
    }
  ],
