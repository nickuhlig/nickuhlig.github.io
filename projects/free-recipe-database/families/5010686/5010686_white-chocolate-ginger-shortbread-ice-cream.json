  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and finely grate the ginger. Finely chop the candied ginger.",
      "secondary_message": "¼ cup ginger, with juice\n¼ cup candied ginger"
    },
    {
      "id": 1,
      "primary_message": "For the Ice Cream: Bring half and half to a simmer in a heavy saucepan. Remove from heat, stir in ginger, and let steep covered for 30 minutes. Half and half may separate slightly but it won't affect the final ice cream.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a bowl, whisk egg yolks and sugar together until they thicken and lighten in color. When ginger is done steeping, quickly whisk yolk mixture into saucepan. Cook on medium-low heat, stirring frequently, until custard coats the back of a spoon but a swiped finger leaves a clean line.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Strain custard into an airtight container. Add white chocolate chunks, and when melt, add salt to taste. Chill custard overnight and churn the next day according to manufacturer's instructions.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For the Shortbread Crumble: Preheat oven to 350°F with a rack in the middle. Melt butter in a small saucepan, then add both sugars and salt until white sugar mostly dissolves. Stir in flour until mixture resembles a thick paste. Do not overmix.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pat dough out on a sheetpan to 1/4 inch thickness and bake for 6 to 8 minutes, until shortbread is just set. Let cool, then crumble into mixed-size chunks. When ice cream is churned, stir in candied ginger and most of the crumble, reserving some for topping. Let ice cream chill in freezer for at least 2 to 3 hours before serving.",
      "secondary_message": null
    }
  ],
