  "instructions": [
    {
      "id": 487288,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 487289,
      "primary_message": "Place oil, vinegar, mayo, salt, and pepper in a medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp red wine vinegar\n2 tsp mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 487290,
      "primary_message": "Wash, dry, trim, and seed bell peppers; halve lengthwise, then slice into thin strips. Add half to the bowl with the dressing. (Reserve remaining bell pepper for the pizza toasts.)",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 487291,
      "primary_message": "Drain and roughly chop artichoke hearts. Add to the bowl and set aside.",
      "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 487292,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "8 slices sourdough bread"
    },
    {
      "id": 487293,
      "primary_message": "Meanwhile, place tomato sauce and spices in a small bowl. Stir to combine the pizza sauce and set aside. ",
      "secondary_message": "2 (8 oz) cans tomato sauce\n2 tsp Italian seasoning\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 487294,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "⅔ (8 oz) block mozzarella cheese"
    },
    {
      "id": 487295,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 487296,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces. ",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 487297,
      "primary_message": "Spread toasted bread with pizza sauce, then top with cheese, bell pepper, olives, and prosciutto. ",
      "secondary_message": null
    },
    {
      "id": 487298,
      "primary_message": "Return baking sheet to the oven and broil until pizza toasts are warmed through and cheese is melted, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 487299,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and veggies, then toss to combine the salad. ",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 487300,
      "primary_message": "To serve, divide pizza toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
