  "instructions": [
    {
      "id": 487413,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 487414,
      "primary_message": "Place oil, vinegar, mayo, salt, and pepper in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp mayonnaise\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 487415,
      "primary_message": "Wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips. Add half to the bowl with the dressing. (Reserve remaining bell pepper for the pizza toasts.)",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 487416,
      "primary_message": "Drain and roughly chop artichoke hearts. Add to the bowl and set aside.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 487417,
      "primary_message": "Place tomato sauce and spices in a small bowl. Stir to combine the pizza sauce and set aside. ",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 487418,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 487419,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 487420,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 487421,
      "primary_message": "Spread toasted bread with pizza sauce, then top with cheese, bell pepper, and olives. ",
      "secondary_message": null
    },
    {
      "id": 487422,
      "primary_message": "Working in batches, return baking sheets to the oven and broil until pizza toasts are warmed through and cheese is melted, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 487423,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and veggies, then toss to combine the salad. ",
      "secondary_message": "1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 487424,
      "primary_message": "To serve, divide pizza toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
