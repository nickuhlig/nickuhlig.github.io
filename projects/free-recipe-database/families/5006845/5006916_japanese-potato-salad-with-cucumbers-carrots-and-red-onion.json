  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the Persian cucumbers crosswise. Quarter and thinly slice the carrot crosswise. Thinly slice the red onion. Peel and chop the hard boiled eggs.",
      "secondary_message": "2 Persian cucumbers\n1 small carrot\n¼ red onion\n2 hard boiled eggs"
    },
    {
      "id": 1,
      "primary_message": "Place potatoes in a large pot and add enough cold water to cover by 2.5 cm. Season generously with salt and bring to a boil over high heat. Reduce to a simmer and cook until potatoes are easily pierced with a fork, 10 to 15 minutes. Drain potatoes and transfer to a large bowl. Let cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, place cucumbers in a bowl and sprinkle 1/2 teaspoon salt. Mix well, then let stand for 10 minutes. Drain any accumulated water, then gently squeeze cucumbers with paper towels to blot up any excess liquid.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, whisk together rice vinegar, mayonnaise, and hot mustard until well combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Mash potatoes with a masher or a large fork, allowing some small lumps to remain. Add cucumbers, carrot, onion, eggs, scallion, and mayonnaise mixture. Mix well and season with salt to taste. Serve right away. The salad can be refrigerated up to 1 day.",
      "secondary_message": null
    }
  ],
