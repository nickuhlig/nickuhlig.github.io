  "instructions": [
    {
      "id": 487699,
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces and place in a large bowl. Add soy sauce, vinegar, and Italian seasoning. Gently stir to coat and set aside to marinate.",
      "secondary_message": "3 (227g ) pkgs tempeh\n3 tbsp soy sauce\n3 tbsp balsamic vinegar\n1 tbsp Italian seasoning"
    },
    {
      "id": 487700,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "9 apricots\n1 ½ small pkgs grape tomatoes\n1 small pkg fresh basil\n3 (142 g) pkgs baby spinach"
    },
    {
      "id": 487701,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 487702,
      "primary_message": "While the pan heats up, halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Season the cut-side with salt and pepper. ",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 487703,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches, add apricot halves, cut-side down, and grill until charred and soft, 1-2 minutes per side. Remove from heat and set aside to cool slightly.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 487704,
      "primary_message": "Meanwhile, peel, halve, and slice onion crosswise into thin half-moons. Place in another large bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 487705,
      "primary_message": "Peel and mince garlic. Add to the bowl with the onion along with oil, vinegar, Dijon, maple syrup, salt, and pepper. Stir to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n2 tbsp Dijon mustard\n2 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 487706,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 487707,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh in a single layer (leaving any excess marinade in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 487708,
      "primary_message": "While the tempeh is cooking, halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 487709,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 487710,
      "primary_message": "Cut or tear mozzarella into bite-sized pieces. Add to the bowl.",
      "secondary_message": "1 ½ (227 g) pkgs fresh mozzarella cheese"
    },
    {
      "id": 487711,
      "primary_message": "When the apricots are cool enough to handle, thinly slice. Add to the bowl, along with spinach, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 487712,
      "primary_message": "To serve, divide salad between plates or bowls and top with seared tempeh. Enjoy!",
      "secondary_message": null
    }
  ],
