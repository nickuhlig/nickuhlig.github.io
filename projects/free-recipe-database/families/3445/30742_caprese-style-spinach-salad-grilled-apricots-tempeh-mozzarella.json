  "instructions": [
    {
      "id": 487587,
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces and place in a medium bowl. Add soy sauce, vinegar, and Italian seasoning. Gently stir to coat and set aside to marinate.",
      "secondary_message": "1 (8 oz) package tempeh\n1 tbsp soy sauce\n1 tbsp balsamic vinegar\n1 tsp Italian seasoning"
    },
    {
      "id": 487588,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 apricots\n½ pint grape tomatoes\n½ small pkg fresh basil\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 487589,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 487590,
      "primary_message": "While the pan heats up, halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Season the cut-side with salt and pepper. ",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 487591,
      "primary_message": "Once the grill pan is hot, coat with oil. Add apricot halves, cut-side down, and grill until charred and soft, 1-2 minutes per side. Remove from heat and set aside to cool slightly.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 487592,
      "primary_message": "Meanwhile, peel, halve, and slice shallot crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 487593,
      "primary_message": "Peel and mince garlic. Add to the bowl with the shallot along with oil, vinegar, Dijon, maple syrup, salt, and pepper. Stir to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 487594,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 487595,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh in a single layer (leaving any excess marinade in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 487596,
      "primary_message": "While the tempeh is cooking, halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 487597,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 487598,
      "primary_message": "Cut or tear mozzarella into bite-sized pieces. Add to the bowl.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 487599,
      "primary_message": "When the apricots are cool enough to handle, thinly slice. Add to the bowl, along with spinach, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 487600,
      "primary_message": "To serve, divide salad between plates or bowls and top with seared tempeh. Enjoy!",
      "secondary_message": null
    }
  ],
