  "instructions": [
    {
      "id": 75135,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium red potatoes\n3 (8 oz) pkg sugar snap peas\n1 ½ lemon\n1 ½ small pkg fresh mint"
    },
    {
      "id": 75143,
      "primary_message": "Quarter the potatoes lengthwise (into wedges) and transfer to a medium saucepan. Cover with hot water (from the tap) by about 1 inch and bring to a boil over high heat.",
      "secondary_message": ""
    },
    {
      "id": 75142,
      "primary_message": "Grate the zest from the lemons, then juice the lemons; add both to a large bowl (that will hold the salad).",
      "secondary_message": ""
    },
    {
      "id": 75134,
      "primary_message": "To the salad bowl, add yogurt, olive oil, Dijon, salt, and pepper; whisk together.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n3 tsp Dijon mustard\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 75141,
      "primary_message": "Once the water in the saucepan is boiling, cook the potato pieces until they are tender when pierced with a knife or fork, 10 to 15 minutes, making sure not to overcook. Drain in a colander.",
      "secondary_message": ""
    },
    {
      "id": 75140,
      "primary_message": "Halve the sugar snap peas at an angle; add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 75139,
      "primary_message": "Pick the mint leaves off the stems; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 75133,
      "primary_message": "Trim off and discard the ends of the shallots; peel and finely dice the shallots. Add to the salad bowl.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 75132,
      "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 75131,
      "primary_message": "Pat the tilapia dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb tilapia fillet\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 75138,
      "primary_message": "Once the skillet is hot, add the tilapia; cook until it is cooked through and golden brown, 2 to 4 minutes per side. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 75137,
      "primary_message": "Cut the potato quarters crosswise into ¼-inch-thick pieces; add to the salad bowl. Gently toss the salad until well coated with the dressing.",
      "secondary_message": ""
    },
    {
      "id": 75136,
      "primary_message": "To serve, divide the tilapia and salad between plates. Enjoy!",
      "secondary_message": ""
    }
  ],
