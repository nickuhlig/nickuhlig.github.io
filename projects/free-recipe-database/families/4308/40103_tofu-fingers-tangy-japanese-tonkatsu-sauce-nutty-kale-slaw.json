  "instructions": [
    {
      "id": 630546,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 630547,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 630548,
      "primary_message": "Place bread crumbs, oil, salt, and pepper in a small bowl. Stir to combine the breading mixture and set aside.",
      "secondary_message": "1 cup panko bread crumbs\n1 tbsp toasted sesame oil\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 630549,
      "primary_message": "Cut tofu crosswise into 1-inch wide fingers. Place in a large bowl along with mayo, salt, and pepper, then turn to coat. (Wipe baking sheet dry with paper towels, coat with a thin layer of oil, and reserve for the next step.)",
      "secondary_message": "¼ cup mayonnaise\n¾ tsp salt\n¼ tsp black pepper\n1 tbsp toasted sesame oil"
    },
    {
      "id": 630550,
      "primary_message": "Add breading mixture to the bowl with the tofu and gently turn to coat, pressing gently to adhere. Return tofu to the baking sheet and arrange in a single layer. (Reserve small bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 630551,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and warmed through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 630552,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n1 ½ bunches kale\n1 small bunch green onions (scallions)\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 630553,
      "primary_message": "Place peanut butter, oil, vinegar, sugar, and spices in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup natural peanut butter\n2 tbsp toasted sesame oil\n2 tbsp rice vinegar\n2 tbsp brown sugar\n1 ½ tsp garlic powder\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 630554,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 630555,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces; add to the bowl. Using your hands, massage kale and cabbage with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 630556,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 630557,
      "primary_message": "Roughly chop peanuts. Add to the bowl, toss to combine the slaw, and set aside.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 630558,
      "primary_message": "Peel and mince ginger. Place in the reserved small bowl, along with ketchup, soy sauce, vinegar, and sugar. Whisk to combine the tonkatsu sauce.",
      "secondary_message": "⅓ cup ketchup\n2 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp brown sugar"
    },
    {
      "id": 630559,
      "primary_message": "Divide tofu fingers and slaw between plates. Serve with tonkatsu sauce for dipping and enjoy!",
      "secondary_message": null
    }
  ],
