  "instructions": [
    {
      "id": 630694,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 630695,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 630696,
      "primary_message": "Place bread crumbs, oil, salt, and pepper in a small bowl. Stir to combine the breading mixture and set aside.",
      "secondary_message": "⅔ cup panko bread crumbs\n2 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 630697,
      "primary_message": "Cut tofu crosswise into 1-inch wide fingers. Place in a medium bowl along with mayo, salt, and pepper, then turn to coat. (Wipe baking sheet dry with paper towels, coat with a thin layer of oil, and reserve for the next step.)",
      "secondary_message": "3 tbsp mayonnaise\n½ tsp salt\n¼ tsp black pepper\n2 tsp toasted sesame oil"
    },
    {
      "id": 630698,
      "primary_message": "Add breading mixture to the bowl with the tofu and gently turn to coat, pressing gently to adhere. Return tofu to the baking sheet and arrange in a single layer. (Reserve small bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 630699,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and warmed through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 630700,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n1 bunch kale\n1 small bunch green onions (scallions)\n2 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 630701,
      "primary_message": "Place peanut butter, oil, vinegar, sugar, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp natural peanut butter\n4 tsp toasted sesame oil\n4 tsp rice vinegar\n4 tsp brown sugar\n1 tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 630702,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 630703,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces; add to the bowl. Using your hands, massage kale and cabbage with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 630704,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 630705,
      "primary_message": "Roughly chop peanuts. Add to the bowl, toss to combine the slaw, and set aside.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 630706,
      "primary_message": "Peel and mince ginger. Place in the reserved small bowl, along with ketchup, soy sauce, vinegar, and sugar. Whisk to combine the tonkatsu sauce.",
      "secondary_message": "¼ cup ketchup\n4 tsp soy sauce\n2 tsp rice vinegar\n2 tsp brown sugar"
    },
    {
      "id": 630707,
      "primary_message": "Divide tofu fingers and slaw between plates. Serve with tonkatsu sauce for dipping and enjoy!",
      "secondary_message": null
    }
  ],
