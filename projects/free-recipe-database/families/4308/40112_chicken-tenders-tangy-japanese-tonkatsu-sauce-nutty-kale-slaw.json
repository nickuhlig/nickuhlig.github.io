  "instructions": [
    {
      "id": 630667,
      "primary_message": "Preheat oven to 205°C (400°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 630668,
      "primary_message": "Place bread crumbs, oil, salt, and pepper in a small bowl. Stir to combine the breading mixture and set aside.",
      "secondary_message": "1 cup panko bread crumbs\n1 tbsp toasted sesame oil\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 630669,
      "primary_message": "Pat chicken dry with paper towels, then slice lengthwise into 1-inch strips. Place in a large bowl along with mayo, salt, and pepper, then toss to coat. ",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¼ cup mayonnaise\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 630670,
      "primary_message": "Add breading mixture to the bowl with the chicken and toss to coat, pressing gently to adhere. Divide chicken between the baking sheets and arrange in a single layer. (Reserve small bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 630671,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 630672,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n1 ½ bunches kale\n1 small bunch green onions (scallions)\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 630673,
      "primary_message": "Place peanut butter, oil, vinegar, sugar, and spices in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup natural peanut butter\n2 tbsp toasted sesame oil\n2 tbsp rice vinegar\n2 tbsp brown sugar\n1 ½ tsp garlic powder\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 630674,
      "primary_message": "Using a clean cutting board, trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 630675,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces; add to the bowl. Using your hands, massage kale and cabbage with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 630676,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 630677,
      "primary_message": "Roughly chop peanuts. Add to the bowl, toss to combine the slaw, and set aside.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 630678,
      "primary_message": "Peel and mince ginger. Place in the reserved small bowl, along with ketchup, soy sauce, vinegar, and sugar. Whisk to combine the tonkatsu sauce.",
      "secondary_message": "⅓ cup ketchup\n2 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp brown sugar"
    },
    {
      "id": 630679,
      "primary_message": "Divide chicken tenders and slaw between plates. Serve with tonkatsu sauce for dipping and enjoy!",
      "secondary_message": null
    }
  ],
