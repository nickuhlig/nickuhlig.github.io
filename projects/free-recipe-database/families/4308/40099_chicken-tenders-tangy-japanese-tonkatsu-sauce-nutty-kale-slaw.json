  "instructions": [
    {
      "id": 630492,
      "primary_message": "Preheat oven to 400°F. Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 630493,
      "primary_message": "Place bread crumbs, oil, salt, and pepper in a small bowl. Stir to combine the breading mixture and set aside.",
      "secondary_message": "⅔ cup panko bread crumbs\n2 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 630494,
      "primary_message": "Pat chicken dry with paper towels, then slice lengthwise into 1-inch strips. Place in a medium bowl along with mayo, salt, and pepper, then toss to coat. ",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n3 tbsp mayonnaise\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 630495,
      "primary_message": "Add breading mixture to the bowl with the chicken and toss to coat, pressing gently to adhere. Transfer chicken to the baking sheet and arrange in a single layer. (Reserve small bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 630496,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 630497,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n1 bunch kale\n1 small bunch green onions (scallions)\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 630498,
      "primary_message": "Place peanut butter, oil, vinegar, sugar, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp natural peanut butter\n4 tsp toasted sesame oil\n4 tsp rice vinegar\n4 tsp brown sugar\n1 tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 630499,
      "primary_message": "Using a clean cutting board, trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 630500,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces; add to the bowl. Using your hands, massage kale and cabbage with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 630501,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 630502,
      "primary_message": "Roughly chop peanuts. Add to the bowl, toss to combine the slaw, and set aside.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 630503,
      "primary_message": "Peel and mince ginger. Place in the reserved small bowl, along with ketchup, soy sauce, vinegar, and sugar. Whisk to combine the tonkatsu sauce.",
      "secondary_message": "¼ cup ketchup\n4 tsp soy sauce\n2 tsp rice vinegar\n2 tsp brown sugar"
    },
    {
      "id": 630504,
      "primary_message": "Divide chicken tenders and slaw between plates. Serve with tonkatsu sauce for dipping and enjoy!",
      "secondary_message": null
    }
  ],
