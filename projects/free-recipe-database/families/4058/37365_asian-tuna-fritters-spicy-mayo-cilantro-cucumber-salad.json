  "instructions": [
    {
      "id": 617652,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n3 English cucumbers\n1 ½ limes"
    },
    {
      "id": 617653,
      "primary_message": "Peel and mince ginger and garlic. Divide both between a large bowl and a medium bowl, then set the medium bowl aside for the salad.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 617654,
      "primary_message": "Drain tuna, removing as much liquid as possible. Add to the large bowl with the ginger and garlic, then flake with a fork.",
      "secondary_message": "6 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 617655,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, along with eggs, mayo, coconut aminos, and crushed red pepper, then stir to combine.",
      "secondary_message": "3 eggs\n⅓ cup avocado oil mayonnaise\n1 tbsp coconut aminos\n¼ tsp crushed red pepper"
    },
    {
      "id": 617656,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 617657,
      "primary_message": "While the skillet heats up, using a scant ¼-cup measure, form the tuna mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 617658,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 617659,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the reserved medium bowl with the ginger and garlic, along with vinegar, sesame seeds, coconut aminos, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp rice vinegar\n2 tbsp sesame seeds\n1 tbsp coconut aminos\n¼ tsp crushed red pepper"
    },
    {
      "id": 617660,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into 1-inch thick pieces. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 617661,
      "primary_message": "Juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 617662,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the lime juice, along with mayo, hot sauce, salt, and pepper, then stir to combine the spicy mayo.",
      "secondary_message": "3 cloves garlic\n¾ cup avocado oil mayonnaise\n1 tbsp hot sauce\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 617663,
      "primary_message": "To serve, divide fritters and salad between plates or bowls. Drizzle fritters with spicy mayo and enjoy!",
      "secondary_message": null
    }
  ],
