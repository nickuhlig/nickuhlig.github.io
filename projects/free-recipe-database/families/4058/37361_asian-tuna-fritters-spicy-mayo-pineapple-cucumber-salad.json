  "instructions": [
    {
      "id": 617602,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 English cucumber\n1 small pineapple\n1 lime"
    },
    {
      "id": 617603,
      "primary_message": "Peel and mince ginger and garlic. Divide both between two medium bowls, then set one bowl aside for the salad.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 617604,
      "primary_message": "Drain tuna, removing as much liquid as possible. Add to the remaining bowl with the ginger and garlic, then flake with a fork.",
      "secondary_message": "4 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 617605,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, along with eggs, mayo, bread crumbs, soy sauce, and crushed red pepper, then stir to combine.",
      "secondary_message": "2 eggs\n¼ cup mayonnaise\n¼ cup panko bread crumbs\n2 tsp soy sauce\n¼ tsp crushed red pepper"
    },
    {
      "id": 617606,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 617607,
      "primary_message": "While the skillet heats up, using a ¼-cup measure, form the tuna mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 617608,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 617609,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the reserved medium bowl with the ginger and garlic, along with vinegar, sesame seeds, soy sauce, honey, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp rice vinegar\n4 tsp sesame seeds\n2 tsp soy sauce\n2 tsp honey\n¼ tsp crushed red pepper"
    },
    {
      "id": 617610,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into 1-inch thick pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 617611,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice the flesh. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 617612,
      "primary_message": "Juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 617613,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the lime juice, along with mayo, hot sauce, salt, and pepper, then stir to combine the spicy mayo.",
      "secondary_message": "2 cloves garlic\n½ cup mayonnaise\n2 tsp hot sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 617614,
      "primary_message": "To serve, divide fritters and salad between plates or bowls. Drizzle fritters with spicy mayo and enjoy!",
      "secondary_message": null
    }
  ],
