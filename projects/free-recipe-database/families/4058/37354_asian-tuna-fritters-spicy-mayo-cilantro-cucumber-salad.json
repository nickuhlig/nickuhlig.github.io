  "instructions": [
    {
      "id": 617514,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)\n½ small bunch cilantro\n1 English cucumber\n½ lime"
    },
    {
      "id": 617515,
      "primary_message": "Peel and mince ginger and garlic. Divide both between two medium bowls, then set one bowl aside for the salad.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 617516,
      "primary_message": "Drain tuna, removing as much liquid as possible. Add to the remaining bowl with the ginger and garlic, then flake with a fork.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 617517,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, along with egg, mayo, coconut aminos, and crushed red pepper, then stir to combine.",
      "secondary_message": "1 egg\n2 tbsp avocado oil mayonnaise\n1 tsp coconut aminos\n⅛ tsp crushed red pepper"
    },
    {
      "id": 617518,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 617519,
      "primary_message": "While the skillet heats up, using a scant ¼-cup measure, form the tuna mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 617520,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters and pan-fry until golden and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 617521,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the reserved medium bowl with the ginger and garlic, along with vinegar, sesame seeds, coconut aminos, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp rice vinegar\n2 tsp sesame seeds\n1 tsp coconut aminos\n⅛ tsp crushed red pepper"
    },
    {
      "id": 617522,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into 1-inch thick pieces. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 617523,
      "primary_message": "Juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 617524,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the lime juice, along with mayo, hot sauce, salt, and pepper, then stir to combine the spicy mayo.",
      "secondary_message": "1 clove garlic\n¼ cup avocado oil mayonnaise\n1 tsp hot sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 617525,
      "primary_message": "To serve, divide fritters and salad between plates or bowls. Drizzle fritters with spicy mayo and enjoy!",
      "secondary_message": null
    }
  ],
