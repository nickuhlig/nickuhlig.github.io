  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg chives\n½ small bunch fresh dill\n1 lime\n1 yellow bell pepper\n1 English cucumber\n1 bunch radish"
    },
    {
      "primary_message": "Mince chives. Place in a small bowl.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the chives.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Juice lime into the bowl.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add yogurt, mayo, and spices to the bowl; whisk to combine the ranch dip. Transfer dip to a small serving bowl and place on a serving platter.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup mayonnaise\n1 tsp parsley flakes\n1 tsp garlic powder\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into 1/2-inch wide strips. Add to the platter with the dip.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into 3-inch pieces. Slice each piece lengthwise into 3-4 spears. Add to the platter.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and halve radishes lengthwise. Add to the platter along with the broccoli florets. \n\n",
      "secondary_message": "½ (510 g) bag broccoli florets"
    },
    {
      "primary_message": "Serve and enjoy!",
      "secondary_message": null
    }
  ],
