  "instructions": [
    {
      "id": 201981,
      "primary_message": "Wash, dry, and peel the butternut squash; halve and remove seeds with a spoon. Small dice squash and place in a medium bowl; set aside.",
      "secondary_message": "1 small butternut squash"
    },
    {
      "id": 201982,
      "primary_message": "Peel and small dice onion; add to the bowl with the squash.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 201983,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 201984,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 201985,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the squash, onion, garlic, and spices to the skillet. Cook, stirring occasionally, until the squash is fork-tender, 6-8 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 tsp cinnamon\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 201986,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the bowl used for the squash; whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 201987,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 201988,
      "primary_message": "Small dice the sausages. Add to the skillet and cook, stirring occasionally, until heated through, about 3 minutes (or cook sausages according to package instructions).",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 201989,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 201990,
      "primary_message": "Wash and dry the spinach (skip washing if it came pre-washed). Stirring constantly, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Spread sausage-veggie mixture out evenly in the skillet.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 201991,
      "primary_message": "Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 201992,
      "primary_message": "Sprinkle with cheese. Place skillet in the oven and broil until the top is set, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 201993,
      "primary_message": "To serve, cut frittata into wedges, place on plates, and enjoy!",
      "secondary_message": null
    }
  ],
