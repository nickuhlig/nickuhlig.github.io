  "instructions": [
    {
      "id": 240641,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 red bell pepper\n1 yellow bell pepper\n1 small bunch cilantro"
    },
    {
      "id": 240642,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 240643,
      "primary_message": "Place ginger, garlic, broth, soy sauce, sugar, and cinnamon in a small saucepan; whisk to combine. Place the saucepan over high heat and bring to a boil.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n2 tbsp soy sauce\n1 tbsp brown sugar\n1 pinch cinnamon, ground"
    },
    {
      "id": 240644,
      "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth. When liquid in the saucepan comes to a boil, add slurry in a steady stream while whisking quickly. Let boil for 1 minute, then remove from heat and pour the teriyaki sauce into another small bowl; set aside.",
      "secondary_message": "2 tbsp water\n1 tbsp cornstarch"
    },
    {
      "id": 240645,
      "primary_message": "Rinse the saucepan and reserve for the next step.",
      "secondary_message": null
    },
    {
      "id": 240646,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to the reserved saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 240647,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 240648,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven. Line a baking sheet pan with aluminum foil to make clean up easier (optional) and coat with a thin layer of oil.",
      "secondary_message": "½ tsp toasted sesame oil"
    },
    {
      "id": 240649,
      "primary_message": "Pat chicken dry with paper towels and place on the baking sheet. Pour half of the teriyaki sauce over the chicken (reserving the rest for serving) and turn to coat; spread chicken out in an even layer.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 240650,
      "primary_message": "Place baking sheet in the oven and broil the chicken, flipping once, until golden brown and cooked through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 240651,
      "primary_message": "While the chicken is cooking, place oil, vinegar, soy sauce, sugar, and salt in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp toasted sesame oil\n1 tsp rice vinegar\n½ tsp soy sauce\n½ tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 240652,
      "primary_message": "Trim, seed, and cut bell peppers into thin matchsticks; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 240653,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 240654,
      "primary_message": "Roughly chop peanuts and add to the bowl; toss to combine the salad.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 240655,
      "primary_message": "To serve, divide rice, chicken, and salad between plates. Top chicken with reserved teriyaki sauce and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
