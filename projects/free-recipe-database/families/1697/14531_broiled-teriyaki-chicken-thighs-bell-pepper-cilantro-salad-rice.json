  "instructions": [
    {
      "id": 240761,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 red bell peppers\n3 yellow bell peppers\n3 small bunches cilantro"
    },
    {
      "id": 240762,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 240763,
      "primary_message": "Place ginger, garlic, broth, soy sauce, sugar, and cinnamon in a medium saucepan; whisk to combine. Place the saucepan over high heat and bring to a boil.",
      "secondary_message": "355 ml chicken or vegetable broth\n⅓ cup soy sauce\n3 tbsp brown sugar\n3 pinch cinnamon, ground"
    },
    {
      "id": 240764,
      "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth. When liquid in the saucepan comes to a boil, add slurry in a steady stream while whisking quickly. Let boil for 1-2 minutes, then remove from heat and pour the teriyaki sauce into another small bowl; set aside.",
      "secondary_message": "⅓ cup water\n3 tbsp cornstarch"
    },
    {
      "id": 240765,
      "primary_message": "Rinse the saucepan and reserve for the next step.",
      "secondary_message": null
    },
    {
      "id": 240766,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to the reserved saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 240767,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 240768,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven. Line a large baking sheet pan with aluminum foil to make clean up easier (optional) and coat with a thin layer of oil.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 240769,
      "primary_message": "Pat chicken dry with paper towels and place on the baking sheet. Pour half of the teriyaki sauce over the chicken (reserving the rest for serving) and turn to coat; spread chicken out in an even layer.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 240770,
      "primary_message": "Place baking sheet in the oven and broil the chicken, flipping once, until golden brown and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 240771,
      "primary_message": "While the chicken is cooking, place oil, vinegar, soy sauce, sugar, and salt in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp toasted sesame oil\n1 tbsp rice vinegar\n1 ½ tsp soy sauce\n1 ½ tsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 240772,
      "primary_message": "Trim, seed, and cut bell peppers into thin matchsticks; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 240773,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 240774,
      "primary_message": "Roughly chop peanuts and add to the bowl; toss to combine the salad.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 240775,
      "primary_message": "To serve, divide rice, chicken, and salad between plates. Top chicken with reserved teriyaki sauce and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
