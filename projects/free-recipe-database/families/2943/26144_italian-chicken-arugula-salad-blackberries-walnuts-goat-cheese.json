  "instructions": [
    {
      "id": 415893,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415894,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with spices on both sides. ",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 415895,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden and cooked through, 3-4 minutes per side. Remove to a plate and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 415896,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 English cucumber\n2 (6 oz) pkgs blackberries\n2 (5 oz) pkgs baby arugula"
    },
    {
      "id": 415897,
      "primary_message": "Using a clean cutting board, trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 415898,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the cucumber. ",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 415899,
      "primary_message": "Drain and roughly chop artichoke hearts. Add to the bowl along with the blackberries, arugula, and vinaigrette; toss to combine the salad.",
      "secondary_message": "2 (6 oz) jars artichoke hearts, marinated\n½ cup balsamic vinaigrette"
    },
    {
      "id": 415900,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 415901,
      "primary_message": "To serve, divide salad between plates or bowls; top with chicken, then crumble goat cheese over top. Enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese"
    }
  ],
