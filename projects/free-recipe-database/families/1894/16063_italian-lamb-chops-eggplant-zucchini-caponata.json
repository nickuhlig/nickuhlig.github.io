  "instructions": [
    {
      "id": 300674,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 medium zucchini squash\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 300675,
      "primary_message": "Trim and medium dice eggplants and zucchini; place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 300676,
      "primary_message": "Peel and small dice onions; peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 300677,
      "primary_message": "Trim and small dice celery; add to the bowl with onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 300678,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300679,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and celery; cook, stirring often, until softened, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 300680,
      "primary_message": "Add eggplant, zucchini, and spices to the pot; reduce heat to medium and cover. Cook, stirring occasionally, until softened, 6-7 minutes.",
      "secondary_message": "1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 300681,
      "primary_message": "Meanwhile, pat the lamb chops dry with paper towels and place on a large plate; season with spices on both sides.",
      "secondary_message": "12 lamb loin chops\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp Italian seasoning"
    },
    {
      "id": 300682,
      "primary_message": "When the veggies are ready, add tomatoes, capers, vinegar, and sugar to the pot; stir to combine the caponata. Bring to a simmer and continue to cook, stirring occasionally, until slightly thickened, 10-12 minutes. Remove from heat. ",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n3 tbsp capers\n1 tbsp red wine vinegar\n1 ½ tsp brown sugar"
    },
    {
      "id": 300683,
      "primary_message": "While the caponata is cooking, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300684,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add lamb chops and cook, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, cover with aluminum foil, and let rest 5 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 300685,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Stir parsley into the caponata (reserving a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 300686,
      "primary_message": "To serve, divide caponata and lamb chops between plates; top caponata with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
