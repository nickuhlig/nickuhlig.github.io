  "instructions": [
    {
      "id": 300687,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n1 medium zucchini squash\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 300688,
      "primary_message": "Trim and medium dice eggplant and zucchini; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 300689,
      "primary_message": "Peel and small dice onion; peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 300690,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300691,
      "primary_message": "While the pan heats up, trim and small dice celery; add to the bowl with onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 300692,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion, garlic, and celery; cook, stirring often, until softened, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 300693,
      "primary_message": "Add eggplant, zucchini, and spices to the pan; reduce heat to medium and cover. Cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 300694,
      "primary_message": "Meanwhile, pat the lamb chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "4 lamb loin chops\n½ tsp salt\n¼ tsp black pepper\n¼ tsp Italian seasoning"
    },
    {
      "id": 300695,
      "primary_message": "When the veggies are ready, add tomatoes, capers, vinegar, and sugar to the pan; stir to combine the caponata. Bring to a simmer and continue to cook, stirring occasionally, until slightly thickened, 8-10 minutes. Remove from heat. ",
      "secondary_message": "1 (398 ml) can diced tomatoes\n1 tbsp capers\n1 tsp red wine vinegar\n½ tsp brown sugar"
    },
    {
      "id": 300696,
      "primary_message": "While the caponata is cooking, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300697,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add lamb chops and cook, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, cover with aluminum foil, and let rest 5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 300698,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Stir parsley into the caponata (reserving a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 300699,
      "primary_message": "To serve, divide caponata and lamb chops between plates; top caponata with pine nuts and reserved parsley. Enjoy!",
      "secondary_message": "⅛ cup pine nuts"
    }
  ],
