  "instructions": [
    {
      "id": 42195,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ (5 oz) pkg spring mix (mixed greens)\n½ pint grape tomatoes\n½ English cucumber\n1 lime\n½ small bunch cilantro\n½ small pkg fresh mint "
    },
    {
      "id": 42320,
      "primary_message": "Transfer the mixed greens to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42200,
      "primary_message": "Trim off and discard the ends of the cucumber; halve the cucumber lengthwise, then slice crosswise into ¼-inch-thick half-rounds at an angle. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42194,
      "primary_message": "Halve the grape tomatoes crosswise and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42198,
      "primary_message": "Trim off and discard the ends of the shallot; peel and halve the shallot lengthwise, then thinly slice crosswise into half-rounds. Add to the salad bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 42196,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42197,
      "primary_message": "Pick the mint leaves off the stems; discard the stems and roughly chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42191,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 42318,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42192,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 42193,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 42199,
      "primary_message": "Roughly chop the peanuts and transfer to a small bowl.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 42201,
      "primary_message": "Juice the lime into a small bowl (that will be used to make the dressing).",
      "secondary_message": null
    },
    {
      "id": 42202,
      "primary_message": "To the lime juice, add olive oil, fish sauce, honey, and crushed red pepper; whisk together.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tbsp fish sauce\n1 tsp honey\n⅛ tsp crushed red pepper"
    },
    {
      "id": 42569,
      "primary_message": "Pour the dressing over the salad and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 42319,
      "primary_message": "Transfer the steak to a cutting board and thinly slice against the grain.",
      "secondary_message": null
    },
    {
      "id": 42317,
      "primary_message": "To serve, divide the salad between plates, top with the steak slices, and garnish with the chopped peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
