  "instructions": [
    {
      "id": 410912,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 410913,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch green onions (scallions)\n½ English cucumber"
    },
    {
      "id": 410914,
      "primary_message": "Juice lime into a medium bowl. Add peanut sauce and stir to combine the dressing.",
      "secondary_message": "½ cup peanut sauce"
    },
    {
      "id": 410915,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 410916,
      "primary_message": "Trim and small dice cucumber. Add to the bowl along with the carrots.",
      "secondary_message": "½ (10 oz) bag shredded carrots"
    },
    {
      "id": 410917,
      "primary_message": "Place edamame in a colander.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 410918,
      "primary_message": "When the pasta is done, drain over the edamame to defrost. Rinse pasta and edamame under cold water to cool. Add to the bowl and stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 410919,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
