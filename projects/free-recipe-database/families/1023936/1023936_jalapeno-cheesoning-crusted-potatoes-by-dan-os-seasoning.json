  "instructions": [
    {
      "primary_message": "Preheat your oven to 400°F (200°C).",
      "secondary_message": null
    },
    {
      "primary_message": "Cut the potatoes in half lengthwise. Score each half by making two cuts on each side to create a crisscross pattern.",
      "secondary_message": null
    },
    {
      "primary_message": "In a 13 x 9-inch baking dish, combine the melted butter and Dan-O’s® jalapeño cheesoning. Mix until it forms a paste.",
      "secondary_message": null
    },
    {
      "primary_message": "Spread the butter mixture evenly on the bottom of the baking dish. Lay the potatoes face down on the paste and gently press down to ensure the paste gets into the scoring cuts.",
      "secondary_message": null
    },
    {
      "primary_message": "Bake in the preheated oven for 25-30 minutes, or until the potatoes are tender.",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from the oven and let cool for 5 minutes before serving.",
      "secondary_message": null
    }
  ],
