  "instructions": [
    {
      "id": 416042,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 416043,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n6 medium carrots\n3 small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 416044,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 416045,
      "primary_message": "Peel, trim, and medium dice carrots. Add to the baking sheets with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 416046,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces. Add to the baking sheets along with whole (unpeeled) garlic cloves. Drizzle with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "3 medium red onions\n6 cloves garlic\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 416047,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the veggies are golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 416048,
      "primary_message": "Meanwhile, using a strainer, rinse lentils under cold water; drain and transfer to a large pot. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes.",
      "secondary_message": "2 ¼ cups green lentils, dried\n1420 ml chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 416049,
      "primary_message": "While the lentils are cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 416050,
      "primary_message": "Mince anchovy fillets and capers. Add both to the bowl with the parsley along with additional oil, vinegar, and pepper; set aside.",
      "secondary_message": "3 anchovy fillets, packed in oil\n3 tbsp capers\n¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n¾ tsp black pepper"
    },
    {
      "id": 416051,
      "primary_message": "When the lentils are done, drain and return to the pot. Cover and set aside.",
      "secondary_message": null
    },
    {
      "id": 416052,
      "primary_message": "When the veggies are done, carefully transfer roasted garlic to the cutting board. Using the back of a spoon, press on the cloves to remove the skins. Mash with a fork, add to the bowl with the parsley mixture, and stir to combine the salsa verde.",
      "secondary_message": null
    },
    {
      "id": 416053,
      "primary_message": "Add half of the salsa verde to the pot with the lentils. Stir to combine. (Reserve remaining salsa verde for serving.)",
      "secondary_message": null
    },
    {
      "id": 416054,
      "primary_message": "To serve, divide lentils between plates or bowls; top with the veggies, feta, and reserved salsa verde. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    }
  ],
