  "instructions": [
    {
      "id": 193083,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch green onions (scallions)\n2 medium zucchini squash\n1 avocado\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 193084,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals (if using fresh shrimp, skip this step). Place the shrimp on a clean towel or paper towels and pat dry. Set aside.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 193085,
      "primary_message": "Juice the lemon into the small bowl. Shave leaves off the parsley stems; discard the stems, mince the leaves and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 193086,
      "primary_message": "Finely chop the anchovy fillets. Add to the bowl along with mayo, capers, oil, Dijon, and salt; whisk to combine dressing and set aside.",
      "secondary_message": "2 anchovy fillets, packed in oil\n½ cup avocado oil mayonnaise\n2 tbsp capers\n2 tsp extra virgin olive oil\n2 tsp Dijon mustard\n⅛ tsp salt"
    },
    {
      "id": 193087,
      "primary_message": "Trim green onions and cut them crosswise into ¼-inch pieces at an angle; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 193088,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 193089,
      "primary_message": "While the skillet heats up, trim zucchini, halve lengthwise, and cut crosswise into ¼-inch-thick half-rounds.",
      "secondary_message": null
    },
    {
      "id": 193090,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom, then add zucchini and salt. Cook, stirring occasionally, until golden brown, about 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 193091,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 193092,
      "primary_message": "Remove zucchini to the bowl with the onion and return the skillet to medium-high heat. Add more oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 193093,
      "primary_message": "Add shrimp, garlic, salt, and pepper to the skillet. Cook, stirring often, until cooked through and slightly golden, about 4 minutes; remove from the heat. ",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 193094,
      "primary_message": "Meanwhile, halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 193095,
      "primary_message": "To serve, divide mixed greens between plates; top with shrimp, vegetables, avocado, and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
