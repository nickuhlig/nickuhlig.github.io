  "instructions": [
    {
      "id": 193031,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ pint grape tomatoes\n½ small bunch green onions (scallions)\n½ (8 oz) pkg sugar snap peas\n1 medium zucchini squash\n1 avocado\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 193032,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals (if using fresh shrimp, skip this step). Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 193033,
      "primary_message": "Juice lemon into a small bowl. Shave leaves off the parsley stems; discard stems, mince the leaves, and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 193034,
      "primary_message": "Finely chop the anchovy fillet. Add to the bowl along with mayo, capers, oil, Dijon, and salt; whisk to combine dressing and set aside.",
      "secondary_message": "1 anchovy fillet, packed in oil\n¼ cup mayonnaise\n1 tbsp capers\n1 tsp extra virgin olive oil\n1 tsp Dijon mustard\n1 pinch salt"
    },
    {
      "id": 193035,
      "primary_message": "Halve grape tomatoes. Trim green onions and cut crosswise into ¼-inch pieces at an angle; place both in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 193036,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces at an angle. Trim zucchini, halve lengthwise, and cut crosswise into ¼-inch-thick half-rounds.",
      "secondary_message": null
    },
    {
      "id": 193037,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 193038,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peas, zucchini, and salt. Cook, stirring occasionally, until golden brown, about 4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 193039,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 193040,
      "primary_message": "Remove peas and zucchini to the bowl with the tomatoes. Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 193041,
      "primary_message": "Add shrimp, garlic, salt, and pepper to the skillet. Cook, stirring often, until cooked through and slightly golden, about 4 minutes; remove from the heat. ",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 193042,
      "primary_message": "Meanwhile, halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 193043,
      "primary_message": "To serve, divide mixed greens between plates; top with shrimp, vegetables, avocado, and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
