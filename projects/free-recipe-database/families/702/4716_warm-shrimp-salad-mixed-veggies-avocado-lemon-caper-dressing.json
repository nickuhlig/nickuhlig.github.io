  "instructions": [
    {
      "id": 190393,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "1 medium zucchini squash\n½ small pkg grape tomatoes\n½ (142 g) pkg spring mix (mixed greens)\n½ small bunch green onions (scallions)\n½ small bunch Italian (flat-leaf) parsley\n½ lemon\n½ (227 g) pkg sugar snap peas"
    },
    {
      "id": 190394,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals (if using fresh shrimp, skip this step). Place the shrimp on a clean towel or paper towels and pat dry. Set aside.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 190395,
      "primary_message": "Juice the lemon into the small bowl. Shave leaves off the parsley stems; discard the stems, mince the leaves and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 190396,
      "primary_message": "Finely chop the anchovy fillet, add to the bowl with lemon and parsley. Add mayo, capers, Dijon and salt; whisk to combine dressing and set aside.",
      "secondary_message": "1 anchovy fillet, packed in oil\n¼ cup mayonnaise\n1 tbsp capers\n1 tsp Dijon mustard\n1 pinch salt"
    },
    {
      "id": 190397,
      "primary_message": "Halve the grape tomatoes. Trim off and discard the root ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and set aside.",
      "secondary_message": null
    },
    {
      "id": 190398,
      "primary_message": "Heat skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 190399,
      "primary_message": "Halve the sugar snap peas at an angle. Trim off and discard the ends of the zucchini; halve the zucchini lengthwise, then cut the halves crosswise into ¼-inch-thick half-rounds.",
      "secondary_message": null
    },
    {
      "id": 190400,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom. Add snap peas and zucchini to pan and season with salt. Cook, stirring occasionally, until golden brown, about 2-4 minutes. Once cooked, remove veggies from the skillet and place the skillet back on the heat.",
      "secondary_message": "1 tsp virgin coconut oil\n1 pinch salt"
    },
    {
      "id": 190401,
      "primary_message": "Peel and mince or press the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 190402,
      "primary_message": "Add more oil to the skillet. Add shrimp in an even layer, add garlic and season with salt and pepper. Cook for 2 minutes each side until cooked through and slightly golden. ",
      "secondary_message": "1 tsp virgin coconut oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 190403,
      "primary_message": "To serve, place salad leaves on the plate, top with shrimp, tomatoes, and sautéed vegetables. Drizzle dressing over top and sprinkle with green onions. Serve warm and enjoy!",
      "secondary_message": null
    }
  ],
