  "instructions": [
    {
      "id": 193135,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ small pkgs grape tomatoes\n1 small bunch green onions (scallions)\n1 ½ (227 g) pkg sugar snap peas\n3 medium zucchini squash\n3 avocados\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 193136,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals (if using fresh shrimp, skip this step). Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 193137,
      "primary_message": "Juice lemons into a medium bowl. Shave leaves off the parsley stems; discard stems, mince the leaves, and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 193138,
      "primary_message": "Finely chop the anchovy fillets. Add to the bowl along with mayo, capers, oil, Dijon, and salt; whisk to combine dressing and set aside.",
      "secondary_message": "3 anchovy fillets, packed in oil\n¾ cup mayonnaise\n3 tbsp capers\n1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n3 pinch salt"
    },
    {
      "id": 193139,
      "primary_message": "Halve grape tomatoes. Trim green onions and cut crosswise into ¼-inch pieces at an angle; place both in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 193140,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces at an angle. Trim zucchini, halve lengthwise, and cut crosswise into ¼-inch-thick half-rounds.",
      "secondary_message": null
    },
    {
      "id": 193141,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 193142,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peas, zucchini, and salt. Cook, stirring occasionally, until golden brown, about 6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 193143,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 193144,
      "primary_message": "Remove peas and zucchini to the bowl with the tomatoes. Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 193145,
      "primary_message": "Working in batches if necessary, add shrimp, garlic, salt, and pepper to the skillet. Cook, stirring often, until cooked through and slightly golden, about 5 minutes; remove from the heat. ",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 193146,
      "primary_message": "Meanwhile, halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 193147,
      "primary_message": "To serve, divide mixed greens between plates; top with shrimp, vegetables, avocado, and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
