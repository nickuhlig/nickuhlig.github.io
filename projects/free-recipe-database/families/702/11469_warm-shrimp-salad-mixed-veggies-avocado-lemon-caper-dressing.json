  "instructions": [
    {
      "id": 193096,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch green onions (scallions)\n3 medium zucchini squash\n2 avocados\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 193097,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals (if using fresh shrimp, skip this step). Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 193098,
      "primary_message": "Juice lemons into a medium bowl. Shave leaves off the parsley stems; discard the stems, mince the leaves, and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 193099,
      "primary_message": "Finely chop the anchovy fillets. Add to the bowl along with mayo, capers, oil, Dijon, and salt; whisk to combine dressing and set aside.",
      "secondary_message": "3 anchovy fillets, packed in oil\n¾ cup avocado oil mayonnaise\n3 tbsp capers\n1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n3 pinch salt"
    },
    {
      "id": 193100,
      "primary_message": "Trim green onions and cut them crosswise into ¼-inch pieces at an angle; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 193101,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 193102,
      "primary_message": "While the skillet heats up, trim zucchini, halve lengthwise, and cut crosswise into ¼-inch-thick half-rounds.",
      "secondary_message": null
    },
    {
      "id": 193103,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom, then add zucchini and salt. Cook, stirring occasionally, until golden brown, about 6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 193104,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 193105,
      "primary_message": "Remove zucchini to the bowl with the onion and return the skillet to medium-high heat. Add more oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 193106,
      "primary_message": "Working in batches if necessary, add shrimp, garlic, salt, and pepper to the skillet. Cook, stirring often, until cooked through and slightly golden, about 4 minutes; remove from the heat. ",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 193107,
      "primary_message": "Meanwhile, halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 193108,
      "primary_message": "To serve, divide mixed greens between plates; top with shrimp, vegetables, avocado, and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
