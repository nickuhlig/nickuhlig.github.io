  "instructions": [
    {
      "id": 317010,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 6 minutes.",
      "secondary_message": "1 tsp salt\n283 g penne pasta"
    },
    {
      "id": 317011,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 crowns broccoli\n2 lemons\n1 small pkg fresh basil\n2 small pkgs grape tomatoes\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 317012,
      "primary_message": "Small dice mozzarella, place in a large bowl, and set aside. ",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 317013,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 317014,
      "primary_message": "When the pasta is almost done, add broccoli to the pot; continue to cook, stirring occasionally, until pasta reaches desired firmness and broccoli is tender, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 317015,
      "primary_message": "Meanwhile, peel garlic and place in a blender. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 317016,
      "primary_message": "Zest and juice lemons into the blender with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 317017,
      "primary_message": "Pick basil leaves off the stems; add to the blender along with nutritional yeast, almonds, water, oil, salt, and pepper. Blend on high until very smooth, 1-2 minutes. Add to the bowl with the mozzarella. ",
      "secondary_message": "½ cup nutritional yeast flakes\n¼ cup almonds\n¼ cup water\n2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 317018,
      "primary_message": "When the pasta and broccoli are done, drain and rinse under cold water to cool; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 317019,
      "primary_message": "Halve tomatoes; add to the bowl, along with mixed greens, and stir to combine the pasta salad. ",
      "secondary_message": null
    },
    {
      "id": 317020,
      "primary_message": "To serve, divide pasta salad between plates or bowls and enjoy! ",
      "secondary_message": null
    }
  ],
