  "instructions": [
    {
      "id": 317032,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 6 minutes.",
      "secondary_message": "½ tsp salt\n142 g penne pasta"
    },
    {
      "id": 317033,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 crown broccoli\n1 lemon\n½ small pkg fresh basil\n1 small pkg grape tomatoes\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 317034,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 317035,
      "primary_message": "When the pasta is almost done, add broccoli to the pan; continue to cook, stirring occasionally, until pasta reaches desired firmness and broccoli is tender, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 317036,
      "primary_message": "Meanwhile, peel garlic and place in a blender. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 317037,
      "primary_message": "Zest and juice lemon into the blender with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 317038,
      "primary_message": "Pick basil leaves off the stems; add to the blender along with nutritional yeast, almonds, oil, water, salt, and pepper. Blend on high until very smooth, 1-2 minutes. Transfer to a medium bowl. ",
      "secondary_message": "¼ cup nutritional yeast flakes\n⅛ cup almonds\n2 tbsp extra virgin olive oil\n1 ½ tbsp water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 317039,
      "primary_message": "When the pasta and broccoli are done, drain and rinse under cold water to cool. Add to the bowl with the pesto. ",
      "secondary_message": null
    },
    {
      "id": 317040,
      "primary_message": "Halve tomatoes; add to the bowl, along with mixed greens, and stir to combine the pasta salad. ",
      "secondary_message": null
    },
    {
      "id": 317041,
      "primary_message": "To serve, divide pasta salad between plates or bowls and enjoy! ",
      "secondary_message": null
    }
  ],
