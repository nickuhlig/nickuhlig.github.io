  "instructions": [
    {
      "id": 1,
      "primary_message": "In the bowl of a stand mixer fitted with a paddle attachment, mix butter, cream cheese, granulated sugar, brown sugar, and salt on medium speed until completely combined, about 1 minute. Mix in vanilla until combined. Mix in flour until combined.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pat dough into an 8-inch square, wrap dough in plastic wrap, and chill until fairly firm, about 1 hour. In the meantime, mix together ingredients for filling in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven rack to upper-middle and lower-middle positions. Preheat oven to 350°F. Line 2 rimmed baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cut dough into 4 equal pieces. Place all but 1 piece in the refrigerator to keep cool. On a floured surface, roll out the first piece into a 12-inch by 4-inch strip. Sprinkle 1/4 of the chocolate mixture onto dough and gently press into dough to adhere.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Working from the long end, gently roll dough strip into a 12-inch long log, making sure seam is at the bottom. Cut log into 1-inch pieces and place on one half of the baking sheet, evenly spacing apart. Repeat with second piece of dough to fill the first pan. Repeat with remaining pieces of dough to fill second pan. (You should have 24 rugelach per pan).",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "In a small bowl, stir together sugar and cinnamon, and sprinkle on rugelach. Bake until rugelach is light golden brown, 20 to 25 minutes, rotating pans from top to bottom and front to back halfway through baking. Cool for 5 minutes on pan, then transfer rugelach to wire rack to cool completely.",
      "secondary_message": null
    }
  ],
