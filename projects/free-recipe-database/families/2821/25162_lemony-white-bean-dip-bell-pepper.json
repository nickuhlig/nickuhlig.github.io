  "instructions": [
    {
      "id": 404148,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 orange bell pepper\n1 yellow bell pepper"
    },
    {
      "id": 404149,
      "primary_message": "Zest and juice lemon into a blender. (Alternatively, the dip can be prepared in a food processor.)",
      "secondary_message": null
    },
    {
      "id": 404150,
      "primary_message": "Drain and rinse beans. Add to the blender.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 404151,
      "primary_message": "Add water, tahini, oil, and spices to the blender. Blend on high for several minutes until smooth. Add more water, 1 tablespoon at a time, if needed, to reach desired consistency. Set aside.",
      "secondary_message": "¼ cup water\n2 tbsp tahini\n2 tsp extra virgin olive oil\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp cumin, ground\n¼ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 404152,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into ¾-inch wide strips.",
      "secondary_message": null
    },
    {
      "id": 404153,
      "primary_message": "To serve, divide dip and bell pepper strips between plates. Enjoy!",
      "secondary_message": null
    }
  ],
