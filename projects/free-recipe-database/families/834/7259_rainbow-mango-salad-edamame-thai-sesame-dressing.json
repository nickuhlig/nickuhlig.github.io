  "instructions": [
    {
      "id": 173440,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 (227 g) pkg sugar snap peas\n2 small pkgs grape tomatoes\n2 mangoes\n1 lime\n1 small pkg fresh mint"
    },
    {
      "id": 173441,
      "primary_message": "Place frozen edamame in a medium bowl, cover with hot water (from the tap), and let sit 5 minutes. Drain in a colander; set aside to drain further.",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 173442,
      "primary_message": "Peel, halve, and thinly slice the shallot into half rings; place in a large salad bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 173443,
      "primary_message": "Trim, peel, and coarsely grate the carrots; add to the bowl with the shallots.",
      "secondary_message": null
    },
    {
      "id": 173444,
      "primary_message": "Halve the sugar snap peas at an angle and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 173445,
      "primary_message": "Halve the tomatoes and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 173446,
      "primary_message": "Peel the mangoes and slice the flesh away from the pit, starting with the flat sides; medium dice and place in the salad bowl along with the edamame.",
      "secondary_message": null
    },
    {
      "id": 173447,
      "primary_message": "Juice lime over the veggies in the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 173448,
      "primary_message": "Coarsely chop the cashews.",
      "secondary_message": "1 cup cashews, roasted unsalted"
    },
    {
      "id": 173449,
      "primary_message": "Pick mint leaves off the stems; discard the stems and coarsely chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 173450,
      "primary_message": "Combine vinegar, soy sauce, sesame oil, sesame seeds, and crushed red pepper in a small bowl; whisk to combine.",
      "secondary_message": "2 tbsp rice vinegar\n2 tbsp soy sauce\n2 tsp toasted sesame oil\n1 tsp sesame seeds\n⅛ tsp crushed red pepper"
    },
    {
      "id": 173451,
      "primary_message": "To serve, divide salad between plates, top with cashews and chopped mint. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
