  "instructions": [
    {
      "id": 223374,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 223375,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n¾ lb Brussels sprouts\n½ small pkg fresh thyme"
    },
    {
      "id": 223376,
      "primary_message": "Trim and peel the squash. Halve lengthwise, scrape out seeds, and medium dice the flesh. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 223377,
      "primary_message": "Trim and halve Brussels sprouts; add to the baking sheet with the squash.",
      "secondary_message": null
    },
    {
      "id": 223378,
      "primary_message": "Slide thyme leaves off the stems; discard stems and sprinkle leaves over the veggies.",
      "secondary_message": null
    },
    {
      "id": 223379,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 223380,
      "primary_message": "Drizzle veggies with oil and maple syrup; season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 223381,
      "primary_message": "Season both sides of the chicken with salt and pepper; nestle chicken in the veggies on the baking sheet.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 223382,
      "primary_message": "Place baking sheet in the oven; bake until the chicken is cooked through and veggies are tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 223383,
      "primary_message": "To serve, divide roasted veggies and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
