  "instructions": [
    {
      "id": 223414,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 223415,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small butternut squash\n0.68 kg Brussels sprouts\n1 small pkg fresh thyme"
    },
    {
      "id": 223416,
      "primary_message": "Trim and peel each squash. Halve lengthwise, scrape out seeds, and medium dice the flesh. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 223417,
      "primary_message": "Trim and halve Brussels sprouts; add to the baking sheet with the squash.",
      "secondary_message": null
    },
    {
      "id": 223418,
      "primary_message": "Slide thyme leaves off the stems; discard stems and sprinkle leaves over the veggies.",
      "secondary_message": null
    },
    {
      "id": 223419,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 223420,
      "primary_message": "Drizzle veggies with oil and maple syrup; season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 223421,
      "primary_message": "Season both sides of the chicken with salt and pepper; nestle chicken in the veggies on the baking sheet.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 223422,
      "primary_message": "Place baking sheet in the oven; bake until the chicken is cooked through and veggies are tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 223423,
      "primary_message": "To serve, divide roasted veggies and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
