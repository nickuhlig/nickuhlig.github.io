  "instructions": [
    {
      "id": 223424,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 223425,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small butternut squash\n0.91 kg Brussels sprouts\n1 small pkg fresh thyme"
    },
    {
      "id": 223426,
      "primary_message": "Trim and peel each squash. Halve lengthwise, scrape out seeds, and medium dice the flesh. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 223427,
      "primary_message": "Trim and halve Brussels sprouts; add to the baking sheets with the squash.",
      "secondary_message": null
    },
    {
      "id": 223428,
      "primary_message": "Slide thyme leaves off the stems; discard stems and sprinkle leaves over the veggies.",
      "secondary_message": null
    },
    {
      "id": 223429,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 223430,
      "primary_message": "Drizzle veggies with oil and maple syrup; season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp pure maple syrup\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 223431,
      "primary_message": "Season both sides of the chicken with salt and pepper; nestle chicken in the veggies on the baking sheets.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 223432,
      "primary_message": "Place baking sheet in the oven; bake until the chicken is cooked through and veggies are tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 223433,
      "primary_message": "To serve, divide roasted veggies and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
