      "name": "cream cheese",
      "quantity": "8 oz"
    },
    {
      "ingredient_id": 351,
      "name": "ground cloves",
      "quantity": "⅛ tsp"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat butter in a medium skillet on medium heat until it melts and foam subsides, then add carrots and 1/4 teaspoon of salt. Increase heat to high and cook, stirring frequently, until very soft and beginning to brown around the edges, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer carrots to blender and add half and half and sugar. Blend on high until well combined, about 30 seconds. Blend in cream cheese and cloves until well combined. Season to taste with salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour through a strainer into an airtight container and chill in refrigerator until very cold, about 3 hours. Churn in ice cream machine according to manufacturer's instructions. Chill in freezer for at least 4 hours until firm and scoopable; let ice cream rest on counter 5 minutes before serving.",
      "secondary_message": null
    }
  ],
