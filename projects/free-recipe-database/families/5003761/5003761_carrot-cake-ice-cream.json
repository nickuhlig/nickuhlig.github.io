  "ingredients": [
    {
      "ingredient_id": 115,
      "name": "unsalted butter",
      "quantity": "2 tbsp"
    },
    {
      "ingredient_id": 159,
      "name": "packed grated carrots",
      "quantity": "1 cup"
    },
    {
      "ingredient_id": 88,
      "name": "Kosher salt",
      "quantity": ""
    },
    {
      "ingredient_id": 1061,
      "name": "half and half",
      "quantity": "2 cups"
    },
    {
