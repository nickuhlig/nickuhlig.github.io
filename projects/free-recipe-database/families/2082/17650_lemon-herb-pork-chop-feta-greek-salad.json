  "instructions": [
    {
      "id": 286031,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n3 tomatoes\n3 yellow bell peppers"
    },
    {
      "id": 286032,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 286033,
      "primary_message": "Juice lemons into the bowl with the garlic; add oil and spices. Whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp oregano, dried\n¾ tsp rosemary, dried\n¾ tsp basil, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 286034,
      "primary_message": "Pat pork chops dry with paper towels and place in a large baking dish. Pour marinade over the chops, turn to coat, and set aside. (Reserve bowl for next step.)",
      "secondary_message": "6 pork chops, bone-in"
    },
    {
      "id": 286035,
      "primary_message": "While the chops are marinating, peel and mince additional garlic; place in the reserved bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 286036,
      "primary_message": "Peel, halve, and thinly slice onion; add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 286037,
      "primary_message": "Trim and medium dice cucumbers; medium dice tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 286038,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 286039,
      "primary_message": "Thinly slice olives and add to the bowl; stir to combine the salad and set aside.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 286040,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 286041,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add chops and marinade; pan-fry until golden brown on one side, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 286042,
      "primary_message": "Flip chops and sprinkle the top side with half of the feta (reserve remaining feta for the salad). Continue to pan-fry until cheese has softened and chops are cooked through, 3-4 minutes more. Remove from heat. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 286043,
      "primary_message": "To serve, divide chops and salad between plates; top salad with reserved feta and enjoy!",
      "secondary_message": null
    }
  ],
