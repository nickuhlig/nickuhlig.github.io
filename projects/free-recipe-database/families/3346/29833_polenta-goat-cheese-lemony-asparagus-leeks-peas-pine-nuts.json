  "instructions": [
    {
      "id": 475197,
      "primary_message": "In a small saucepan, bring broth to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated; add salt. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n¾ cup polenta (cornmeal)\n¼ tsp salt"
    },
    {
      "id": 475198,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 475199,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 475200,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 leek\n½ small bunch asparagus\n½ (8 oz) pkg sugar snap peas\n½ lemon\n½ small pkg fresh mint"
    },
    {
      "id": 475201,
      "primary_message": "Trim off the root end and the dark green top of the leek, leaving only the white and pale green parts. Cut the leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 475202,
      "primary_message": "Return skillet to medium-low heat, add butter, and swirl to coat the bottom. Add leeks and salt; cook, stirring occasionally, until just beginning to brown, about 5 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 475203,
      "primary_message": "Meanwhile, snap (or cut) off woody ends of the asparagus; cut spears into 2-inch long pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 475204,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 475205,
      "primary_message": "When the leeks are done, increase heat to medium-high, then add veggies and salt to the skillet. Cook, stirring occasionally, until bright green and tender, 2-3 minutes. Remove from heat.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 475206,
      "primary_message": "Zest and juice lemon into the skillet. ",
      "secondary_message": null
    },
    {
      "id": 475207,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the skillet, along with cooled pine nuts, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 475208,
      "primary_message": "When the polenta is done, crumble goat cheese into the pan. Add butter and pepper, then stir to combine. If the polenta is too firm, add hot water, 1 tablespoon at a time, until you reach a desired consistency. Remove from heat.",
      "secondary_message": "½ (4 oz) log goat cheese\n1 tbsp butter, unsalted\n¼ tsp black pepper"
    },
    {
      "id": 475209,
      "primary_message": "To serve, divide cheesy polenta between plates or bowls. Top with veggies and enjoy!",
      "secondary_message": null
    }
  ],
