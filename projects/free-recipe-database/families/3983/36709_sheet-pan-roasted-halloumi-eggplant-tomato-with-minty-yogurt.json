  "instructions": [
    {
      "id": 576178,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a baking sheet pan with a thin layer of oil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 576179,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n1 small pkg grape tomatoes\n½ lemon\n½ small pkg fresh mint"
    },
    {
      "id": 576180,
      "primary_message": "Trim and medium dice eggplant. Transfer to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 576181,
      "primary_message": "Peel, halve, and slice onion lengthwise into ½-inch thick wedges. Add to the baking sheet with the eggplant.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 576182,
      "primary_message": "Pat halloumi dry with paper towels, then medium dice. Add to the baking sheet along with tomatoes. Drizzle with oil, then season with salt and crushed red pepper; stir to combine and spread out in an even layer.",
      "secondary_message": "1 (250 g) pkg halloumi cheese\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 576183,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are tender and halloumi is golden, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 576184,
      "primary_message": "Meanwhile, juice lemon into a blender. ",
      "secondary_message": null
    },
    {
      "id": 576185,
      "primary_message": "Pick mint leaves off the stems; discard stems. Roughly chop leaves, then add to the blender along with yogurt, capers, honey, salt, and crushed red pepper. Blend on high until minty yogurt is smooth; set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n½ tbsp capers\n1 tsp honey\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 576186,
      "primary_message": "To serve, divide halloumi and veggies between plates or bowls. Drizzle with minty yogurt and enjoy!",
      "secondary_message": null
    }
  ],
