  "instructions": [
    {
      "id": 576197,
      "primary_message": "Preheat oven to 230°C (450°F). Coat two large baking sheet pans with a thin layer of oil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 576198,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 small pkgs grape tomatoes\n1 ½ lemons\n1 small pkg fresh mint"
    },
    {
      "id": 576199,
      "primary_message": "Trim and medium dice eggplants. Divide between the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 576200,
      "primary_message": "Peel, halve, and slice onions lengthwise into ½-inch thick wedges. Add to the baking sheets with the eggplant.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 576201,
      "primary_message": "Pat halloumi dry with paper towels, then medium dice. Add to the baking sheets along with tomatoes. Drizzle with oil, then season with salt and crushed red pepper; stir to combine and spread out in an even layer.",
      "secondary_message": "3 (250 g) pkgs halloumi cheese\n⅓ cup extra virgin olive oil\n1 ½ tsp salt\n1 ½ tsp crushed red pepper"
    },
    {
      "id": 576202,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until veggies are tender and halloumi is golden, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 576203,
      "primary_message": "Meanwhile, juice half of the lemons into a blender. (Reserve remaining lemons for later use.)",
      "secondary_message": null
    },
    {
      "id": 576204,
      "primary_message": "Pick mint leaves off the stems; discard stems. Roughly chop leaves, then add to the blender along with yogurt, capers, honey, salt, and crushed red pepper. Blend on high until minty yogurt is smooth; set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 ½ tbsp capers\n1 tbsp honey\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 576205,
      "primary_message": "Juice reserved lemons over veggies and halloumi.",
      "secondary_message": null
    },
    {
      "id": 576206,
      "primary_message": "To serve, divide halloumi and veggies between plates or bowls. Drizzle with minty yogurt and enjoy!",
      "secondary_message": null
    }
  ],
