  "instructions": [
    {
      "id": 147017,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n6 (1 inch) pieces ginger root\n3 jalapeño peppers\n1 ½ lemons\n1 ½ small bunches cilantro"
    },
    {
      "id": 147018,
      "primary_message": "Medium dice potatoes. Transfer to a large pot, add salt, cover with water, and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and set aside.",
      "secondary_message": "1 tbsp salt"
    },
    {
      "id": 147019,
      "primary_message": "Peel and grate or mince the ginger. Transfer half of the ginger to a blender; place the other half in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 147020,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely dice; add half to the blender and half to the small bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 147021,
      "primary_message": "Juice lemons into the blender.",
      "secondary_message": null
    },
    {
      "id": 147022,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems. Add cilantro to the blender, along with coconut, water, salt, chili powder, and sugar. Blend on high until smooth and creamy. Transfer cilantro chutney to a small bowl and set aside.",
      "secondary_message": "¾ cup shredded unsweetened coconut\n⅓ cup water\n¾ tsp salt\n½ tsp chili powder\n½ tsp brown sugar"
    },
    {
      "id": 147023,
      "primary_message": "Peel and mince the onions.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 147024,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 147025,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add reserved ginger, jalapeño, and onion to the skillet; cook, stirring constantly, until softened, 5-7 minutes.",
      "secondary_message": "⅓ cup virgin coconut oil"
    },
    {
      "id": 147026,
      "primary_message": "Add cooked potatoes, water, Dijon, and spices to the skillet; mash with a fork or potato masher, leaving some small pieces whole.",
      "secondary_message": "1 ½ cup water\n1 tbsp Dijon mustard\n1 ½ tsp salt\n1 ½ tsp curry powder\n1 ½ tsp turmeric\n1 ½ tsp cumin\n¾ tsp chili powder"
    },
    {
      "id": 147027,
      "primary_message": "Add edamame, and cook, stirring often, until edamame are tender and potatoes are soft and fragrant, 5-6 minutes.",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 147028,
      "primary_message": "Toast pita if desired, then slice in half and carefully open using your fingers. Fill each pita with an equal portion of the potato filling.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 147029,
      "primary_message": "To serve, divide spiced potato pockets between plates. Enjoy with cilantro chutney on the side!",
      "secondary_message": null
    }
  ],
