  "instructions": [
    {
      "id": 146949,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n2 (1 inch) pieces ginger root\n1 jalapeño pepper\n½ lemon\n½ small bunch cilantro\n½ small pkg fresh mint"
    },
    {
      "id": 146950,
      "primary_message": "Medium dice potatoes. Transfer to a medium saucepan, add salt, cover with water, and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and set aside.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 146951,
      "primary_message": "Peel and grate or mince the ginger. Transfer half of the ginger to a blender; place the other half in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 146952,
      "primary_message": "Quarter the jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice; add half to the blender and half to the small bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 146953,
      "primary_message": "Juice lemon into the blender.",
      "secondary_message": null
    },
    {
      "id": 146954,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems. Add cilantro to the blender, along with coconut, water, salt, chili powder, and sugar. Blend on high until smooth and creamy. Transfer cilantro chutney to a small bowl and set aside. Rinse blender.",
      "secondary_message": "¼ cup shredded unsweetened coconut\n2 tbsp water\n¼ tsp salt\n⅛ tsp chili powder\n⅛ tsp brown sugar"
    },
    {
      "id": 146955,
      "primary_message": "Pick mint leaves off the stems; discard the stems. Transfer mint leaves to the blender along with yogurt, water, sugar, and spices. Blend on high until smooth and creamy. Transfer mint raita to a small bowl and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp water\n⅛ tsp brown sugar\n⅛ tsp salt\n⅛ tsp cumin\n⅛ tsp chili powder"
    },
    {
      "id": 146956,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 146957,
      "primary_message": "Peel and mince the onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 146958,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add reserved ginger, jalapeño, and onion to the skillet; cook, stirring constantly, until softened, 3-5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 146959,
      "primary_message": "Add cooked potatoes, water, Dijon, and spices to the skillet; mash with a fork or potato masher, leaving some small pieces whole.",
      "secondary_message": "½ cup water\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp curry powder\n½ tsp turmeric\n½ tsp cumin\n¼ tsp chili powder"
    },
    {
      "id": 146960,
      "primary_message": "Add peas, and cook, stirring often, until peas are tender and potatoes are soft and fragrant, 2-3 minutes.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 146961,
      "primary_message": "Toast pita if desired, then slice in half and carefully open using your fingers. Fill each pita with an equal portion of the potato filling.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 146962,
      "primary_message": "To serve, divide spiced potato pockets between plates. Enjoy with cilantro chutney and mint raita on the side!",
      "secondary_message": null
    }
  ],
