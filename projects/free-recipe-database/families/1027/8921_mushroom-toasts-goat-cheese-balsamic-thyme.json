  "instructions": [
    {
      "id": 138887,
      "primary_message": "Peel and thinly slice the shallot into rings. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 138888,
      "primary_message": "Wash and slice mushrooms. ",
      "secondary_message": "½ lb white mushrooms"
    },
    {
      "id": 138889,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 138890,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 138891,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the mushrooms and shallot; cook, stirring occasionally, until mushrooms begin to soften, about 3 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 138892,
      "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
      "secondary_message": "¼ small pkg fresh thyme"
    },
    {
      "id": 138893,
      "primary_message": "Add garlic, vinegar, salt, and pepper to the skillet and cook, stirring often, until fragrant, 1-2 minutes. Remove from the heat.",
      "secondary_message": "1 tsp balsamic vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 138894,
      "primary_message": "Meanwhile, toast the bread.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 138895,
      "primary_message": "Spread goat cheese over toast and top with warm mushrooms.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 138896,
      "primary_message": "To serve, divide toasts between dishes and garnish with thyme. Enjoy!",
      "secondary_message": null
    }
  ],
