  "instructions": [
    {
      "id": 26357,
      "primary_message": "Wash the cauliflower and remove the leaves. Using a food processor or box grater, grate to rice-like texture. Transfer to a large bowl and set aside.",
      "secondary_message": "1 medium head cauliflower\r\n"
    },
    {
      "id": 26358,
      "primary_message": "In a skillet, heat oil over medium-high heat. Add the cauliflower and cook, stirring occasionally, until the rice is slightly browned and tender, 7-10 minutes. Return to the bowl and set aside.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 26359,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Grate zest from the lemon.",
      "secondary_message": "1 clove garlic\r\n1 (2 ½ cm) piece ginger\r\n½ lemon"
    },
    {
      "id": 26360,
      "primary_message": "In a small bowl, create a slurry by whisking together water with cornstarch until smooth. Add the minced garlic and ginger, lemon zest and juice, soy sauce, and honey and whisk together. Set aside.",
      "secondary_message": "3 tbsp water\r\n1 tsp cornstarch\r\nzest and juice from ½ lemon\r\n1 tbsp soy sauce\r\n1 tbsp honey"
    },
    {
      "id": 26361,
      "primary_message": "Wash the asparagus and snap (or cut) off the woody ends. Cut on an angle into 5 cm pieces. Transfer to a bowl.",
      "secondary_message": "1 bunch asparagus\r\n"
    },
    {
      "id": 26362,
      "primary_message": "Cut the chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "0.227 kg chicken breasts, boneless skinless\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 26363,
      "primary_message": "Once the cauliflower rice has been removed, add more oil to the skillet. Add the chicken and cook until browned and cooked through, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "½ tbsp virgin coconut oil\r\n"
    },
    {
      "id": 26364,
      "primary_message": "Once the chicken has been removed, add more oil to the skillet. Add asparagus and cook, stirring occasionally, until bright green and tender-crisp, 3-4 minutes.",
      "secondary_message": "½ tbsp virgin coconut oil\r\n"
    },
    {
      "id": 26365,
      "primary_message": "Return the chicken to the skillet and pour in the sauce. Stir-fry until heated through and sauce thickens, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 26366,
      "primary_message": "Place cauliflower rice in a bowl and top with the stir fry. Enjoy!",
      "secondary_message": ""
    }
  ],
