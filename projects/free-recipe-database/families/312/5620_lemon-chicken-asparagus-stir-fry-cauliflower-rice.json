  "instructions": [
    {
      "id": 67168,
      "primary_message": "Wash the cauliflower and remove the leaves. Using a food processor or box grater, grate to rice-like texture. Transfer to a large bowl and set aside.",
      "secondary_message": "3 medium heads cauliflower"
    },
    {
      "id": 67167,
      "primary_message": "In a skillet, heat oil over medium-high heat. Add the cauliflower and cook, stirring occasionally, until the rice is slightly browned and tender, 7-10 minutes. Return to the bowl and set aside.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 67166,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Grate zest from the lemons.",
      "secondary_message": "3 cloves garlic\n3 (1 inch) pieces ginger\n1 ½ lemon"
    },
    {
      "id": 67165,
      "primary_message": "In a medium bowl, create a slurry by whisking together water with arrowroot until smooth. Add the minced garlic and ginger, lemon zest and juice, coconut aminos, and honey and whisk together. Set aside.",
      "secondary_message": "9 tbsp water\n3 tsp arrowroot starch/powder\nzest and juice from 1 ½ lemon\n3 tbsp coconut aminos\n3 tbsp honey"
    },
    {
      "id": 67164,
      "primary_message": "Wash the asparagus and snap (or cut) off the woody ends. Cut on an angle into 2 inch pieces. Transfer to a bowl.",
      "secondary_message": "3 bunches asparagus"
    },
    {
      "id": 67163,
      "primary_message": "Cut the chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 67162,
      "primary_message": "Once the cauliflower rice has been removed, add more oil to the skillet. Add the chicken and cook until browned and cooked through, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 67161,
      "primary_message": "Once the chicken has been removed, add more oil to the skillet. Add asparagus and cook, stirring occasionally, until bright green and tender-crisp, 3-4 minutes.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 67160,
      "primary_message": "Return the chicken to the skillet and pour in the sauce. Stir-fry until heated through and sauce thickens, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 67159,
      "primary_message": "Place cauliflower rice in a bowl and top with the stir fry. Enjoy!",
      "secondary_message": ""
    }
  ],
