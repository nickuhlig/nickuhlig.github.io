  "instructions": [
    {
      "id": 181188,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add pasta and salt, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "283 g fettuccine pasta\n2 tsp salt"
    },
    {
      "id": 181189,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh basil\n4 ears corn\n2 small pkgs grape tomatoes"
    },
    {
      "id": 181190,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with oil, salt, and crushed red pepper; whisk to combine.",
      "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 181191,
      "primary_message": "Finely chop pine nuts and add to the bowl.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 181192,
      "primary_message": "Pick basil leaves off the stems; discard the stems and mince the leaves. Add to the bowl and stir to combine the pesto. Set aside.",
      "secondary_message": null
    },
    {
      "id": 181193,
      "primary_message": "Remove husks and silks from corn. Using your hands, snap each ear in half. Working over a large bowl, coarsely grate corn off of the cob, catching all of the kernels and juices in the bowl.",
      "secondary_message": null
    },
    {
      "id": 181194,
      "primary_message": "Halve tomatoes and add to the bowl with the corn. Set aside.",
      "secondary_message": null
    },
    {
      "id": 181195,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 181196,
      "primary_message": "While the skillet heats up, pat scallops dry with paper towels and place on a plate; rub with oil and season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg sea scallops\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 181197,
      "primary_message": "Once the skillet is hot, add scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a clean plate and loosely cover with foil. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 181198,
      "primary_message": "When the pasta is done, drain and rinse in a colander.",
      "secondary_message": null
    },
    {
      "id": 181199,
      "primary_message": "Return the large pot to the stove over medium heat. Add grated corn, tomatoes, and any juices left in the bowl, along with water, salt, and pepper. Cook, stirring frequently, until the corn thickens and becomes fragrant, 1-2 minutes. ",
      "secondary_message": "¼ cup water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 181200,
      "primary_message": "Add pasta and half of the pesto to the pot; toss to coat. Continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 181201,
      "primary_message": "To serve, divide pasta and scallops between bowls or plates. Top with remaining pesto and enjoy!",
      "secondary_message": null
    }
  ],
