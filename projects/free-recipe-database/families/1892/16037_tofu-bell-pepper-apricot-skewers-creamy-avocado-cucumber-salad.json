  "instructions": [
    {
      "id": 263225,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 263226,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 263227,
      "primary_message": "Place yogurt, oil, and spices in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 ½ tsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp paprika\n½ tsp salt"
    },
    {
      "id": 263228,
      "primary_message": "Cut tofu into 1-inch cubes, add to the bowl with the marinade along with the apricots, and stir to coat; set aside.",
      "secondary_message": "12 dried apricots"
    },
    {
      "id": 263229,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh mint\n½ English cucumber\n1 avocado\n1 red bell pepper"
    },
    {
      "id": 263230,
      "primary_message": "Pick mint leaves off the stems; discard stems and, using a clean cutting board, mince the leaves. Place half in another medium bowl (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 263231,
      "primary_message": "Add yogurt, oil, and salt to the bowl with the mint and whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 ½ tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 263232,
      "primary_message": "Trim, halve, and slice cucumber crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 263233,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 263234,
      "primary_message": "Peel, halve, and cut onion into 1½-inch wide pieces. Trim, seed, and cut bell pepper into 1½-inch pieces. Add both to the bowl with the tofu and apricots; stir to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 263235,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263236,
      "primary_message": "While the grill pan heats up, thread tofu, apricots, onion, and bell pepper onto skewers, alternating ingredients; place on a plate. (If you don't have skewers, you can cook the tofu, apricots, and veggies directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 263237,
      "primary_message": "Once the grill pan is hot, coat with oil; add the skewers and cook, turning occasionally, until the tofu is golden brown and veggies are fork-tender, 8-10 minutes. Return to the plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 263238,
      "primary_message": "To serve, divide skewers and salad between plates; sprinkle with reserved mint and enjoy!",
      "secondary_message": null
    }
  ],
