  "instructions": [
    {
      "id": 263213,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 263214,
      "primary_message": "Place yogurt, oil, and spices in a large bowl; whisk to combine the marinade.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n1 tbsp cumin, ground\n1 tbsp paprika\n1 ½ tsp salt"
    },
    {
      "id": 263215,
      "primary_message": "Cut steak into 1-inch cubes, add to the bowl with the marinade along with the apricots and stir to coat; set aside.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n36 dried apricots"
    },
    {
      "id": 263216,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh mint\n1 ½ English cucumbers\n3 red bell peppers"
    },
    {
      "id": 263217,
      "primary_message": "Pick mint leaves off the stems; discard stems and, using a clean cutting board, mince the leaves. Place half in a medium bowl (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 263218,
      "primary_message": "Add yogurt, oil, and salt to the bowl with the mint and whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 263219,
      "primary_message": "Trim, halve, and slice cucumbers crosswise into thin half-moons; add to the bowl with the dressing and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 263220,
      "primary_message": "Peel, halve, and cut onions into 1½-inch wide pieces. Trim, seed, and cut bell peppers into 1½-inch pieces. Add both to the bowl with the steak and apricots; stir to coat.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 263221,
      "primary_message": "Thread steak, apricots, onion, and bell pepper onto skewers, alternating ingredients; place on a plate. (If you don't have skewers, you can cook the steak, apricots, and veggies directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 263222,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263223,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add the skewers and cook, turning occasionally, until the steak is cooked through and veggies are fork-tender, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 263224,
      "primary_message": "To serve, divide skewers and salad between plates; sprinkle with reserved mint and enjoy!",
      "secondary_message": null
    }
  ],
