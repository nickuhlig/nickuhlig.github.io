  "instructions": [
    {
      "id": 402614,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 402615,
      "primary_message": "Wash, dry, and zest lemons into a medium bowl (reserve lemons for later use).",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 402616,
      "primary_message": "Add ricotta, salt, and pepper to the bowl with the lemon zest. Stir to combine and set aside.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 402617,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, 8-10 minutes. Remove from oven and set aside.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 402618,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a large bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 402619,
      "primary_message": "Juice reserved lemons into the bowl with the shallot. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 402620,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears crosswise into thin coins. Add to the bowl with the dressing.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 402621,
      "primary_message": "Chop (or tear) prosciutto into bite-sized pieces. Add to the bowl and stir to combine the salad. ",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 402622,
      "primary_message": "Spread the lemon ricotta over each flatbread, then top with asparagus-prosciutto salad.",
      "secondary_message": null
    },
    {
      "id": 402623,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
