  "instructions": [
    {
      "id": 402634,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 402635,
      "primary_message": "Wash, dry, and zest lemon into a small bowl (reserve lemon for later use).",
      "secondary_message": "1 lemon"
    },
    {
      "id": 402636,
      "primary_message": "Add ricotta, salt, and pepper to the bowl with the lemon zest. Stir to combine and set aside.",
      "secondary_message": "1 (425 g) pkg ricotta cheese\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 402637,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, about 8 minutes. Remove from oven and set aside.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 402638,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 402639,
      "primary_message": "Juice reserved lemon into the bowl with the shallot. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 402640,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears crosswise into thin coins. Add to the bowl with the dressing.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 402641,
      "primary_message": "Chop (or tear) prosciutto into bite-sized pieces. Add to the bowl and stir to combine the salad. ",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 402642,
      "primary_message": "Spread the lemon ricotta over each flatbread, then top with asparagus-prosciutto salad.",
      "secondary_message": null
    },
    {
      "id": 402643,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
