  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large saucepan, heat oil over medium-high heat until shimmering. Add mustard seeds, then immediately reduce heat to medium and add curry leaves and cook, stirring frequently, until fragrant about 15 seconds. Add chiles and stir until fragrant, about 15 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add shallots and cook, stirring constantly, until slightly softened, about 1 minute. Add turmeric and cumin, and stir vigorously to ensure the spices don't burn until the oil turns yellow, about 10 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add cabbage, season with salt, and cook, stirring, until just starting to wilt, about 1 minute. Cover and cook, stirring occasionally, until cabbage is fully wilted, 7 to 10 minutes. Uncover and cook until any remaining liquid has evaporated.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Stir in grated coconut until thoroughly combined, then remove from heat. Season to taste with salt. Serve right away with rice and daal, or puris (deep-fried bread).",
      "secondary_message": null
    }
  ],
