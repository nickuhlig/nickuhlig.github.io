  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the scallions. Crumble the feta cheese into about 1/2-inch pieces.",
      "secondary_message": "3 scallions\n7 oz feta cheese"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and heat oven to 400°F. Line a rimmed baking sheet with foil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place chicken breasts, skin side up, on a prepared sheet. Brush all over with oil and season with 1 1/2 teaspoons kosher salt and 3/4 teaspoon pepper. Roast until the thickest part of the breast registers 155°F in the center, 40 to 55 minutes. Cool to room temperature, about 40 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove meat from bones and discard skin and bones. Cut chicken into 1/2-inch cubes (about 4 cups).",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a large bowl, combine mayo, yogurt, parsley, dill, lemon zest and juice, remaining 1/2 teaspoons kosher salt, and remaining 1/4 teaspoon black pepper.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add chicken, scallions, and feta and gently fold until combined. Season to taste with salt and pepper. Serve with lettuce, in a wrap, or as a sandwich.",
      "secondary_message": null
    }
  ],
