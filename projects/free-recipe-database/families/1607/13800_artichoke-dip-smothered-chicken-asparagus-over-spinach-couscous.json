  "instructions": [
    {
      "id": 229346,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 229347,
      "primary_message": "Wash and dry spinach (skip if it came pre-washed); roughly chop half and transfer to a medium bowl. Set remaining spinach aside.",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 229348,
      "primary_message": "Drain and coarsely chop artichokes; add to the bowl with the spinach.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 229349,
      "primary_message": "Cut cream cheese into small pieces and add to the bowl along with spices. Use a silicone spatula or spoon to mash and thoroughly combine the artichoke dip.",
      "secondary_message": "1 ½ (8 oz) blocks cream cheese\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 229350,
      "primary_message": "Place chicken on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Place cutlets on the baking sheet and season with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229351,
      "primary_message": "Spread artichoke dip over the cutlets.",
      "secondary_message": null
    },
    {
      "id": 229352,
      "primary_message": "Wash and dry asparagus. Using a clean cutting board, snap or cut off woody ends; divide and place on top of each cutlet.",
      "secondary_message": "1 ½ small bunches asparagus"
    },
    {
      "id": 229353,
      "primary_message": "Coarsely grate mozzarella; sprinkle over the chicken and asparagus.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 229354,
      "primary_message": "Place baking sheet in the oven and bake until chicken is cooked through and golden, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 229355,
      "primary_message": "Meanwhile, in a large pot, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 229356,
      "primary_message": "Uncover the couscous and add remaining spinach in handfuls, gently stirring, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 229357,
      "primary_message": "To serve, divide couscous between plates or bowls and top with smothered chicken. Enjoy!",
      "secondary_message": null
    }
  ],
