  "instructions": [
    {
      "id": 229358,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a baking dish with a thin layer of oil.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 229359,
      "primary_message": "Wash and dry spinach (skip if it came pre-washed); roughly chop half and transfer to a medium bowl. Set remaining spinach aside.",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 229360,
      "primary_message": "Drain and coarsely chop artichokes; add to the bowl with the spinach.",
      "secondary_message": "½ (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 229361,
      "primary_message": "Cut cream cheese into small pieces and add to the bowl along with spices. Use a silicone spatula or spoon to mash and thoroughly combine the artichoke dip.",
      "secondary_message": "½ (227 g) block cream cheese\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229362,
      "primary_message": "Place chicken on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Place cutlets in the baking dish and season with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229363,
      "primary_message": "Spread artichoke dip over the cutlets.",
      "secondary_message": null
    },
    {
      "id": 229364,
      "primary_message": "Wash and dry asparagus. Using a clean cutting board, snap or cut off woody ends; divide and place on top of each cutlet.",
      "secondary_message": "½ small bunch asparagus"
    },
    {
      "id": 229365,
      "primary_message": "Coarsely grate mozzarella; sprinkle over the chicken and asparagus.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 229366,
      "primary_message": "Place baking dish in the oven and bake until chicken is cooked through and golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 229367,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 229368,
      "primary_message": "Uncover the couscous and add remaining spinach. Gently stir spinach into couscous until slightly wilted.",
      "secondary_message": null
    },
    {
      "id": 229369,
      "primary_message": "To serve, divide couscous between plates or bowls and top with smothered chicken. Enjoy!",
      "secondary_message": null
    }
  ],
