  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and quarter strawberries lengthwise. Place in a small bowl and set aside.\n\n",
      "secondary_message": "¼ (16 oz) pkg strawberries"
    },
    {
      "primary_message": "Place granola, chocolate chips, and sprinkles each in their own small bowls and set the toppings aside. \n\n",
      "secondary_message": "1 cup granola\n¼ cup mini chocolate chips\n2 tbsp rainbow sprinkles"
    },
    {
      "primary_message": "Divide yogurt between the waffle bowls and place each on a small plate. \n\n",
      "secondary_message": "3 cups vanilla Greek yogurt"
    },
    {
      "primary_message": "Allow everyone to add strawberries and toppings as desired. Show off your creations and enjoy!",
      "secondary_message": null
    }
  ],
