  "instructions": [
    {
      "id": 489321,
      "primary_message": "Preheat oven to broil on high and position rack in the middle of the oven. Line a baking sheet pan with aluminum foil (optional).",
      "secondary_message": null
    },
    {
      "id": 489322,
      "primary_message": "Wash, dry, and peel sweet potato. Trim off and discard ends, then cut lengthwise into ½-inch thick slices. Discard the two small, outer pieces, then arrange remaining slices on the baking sheet.",
      "secondary_message": "⅓ kg sweet potato"
    },
    {
      "id": 489323,
      "primary_message": "Using your hands, rub oil over both sides of the sweet potato slices, then season with salt. (If the oil is solid, warm it slightly with your fingers or in the microwave.)",
      "secondary_message": "1 tsp virgin coconut oil\n⅛ tsp salt"
    },
    {
      "id": 489324,
      "primary_message": "Place baking sheet in the oven and broil, flipping halfway through, until sweet potato is tender, 8-10 minutes. (Keep a close watch on the sweet potatoes to avoid burning.) Remove from oven and let cool slightly, 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 489325,
      "primary_message": "Meanwhile, roughly chop walnuts and cranberries.",
      "secondary_message": "⅓ cup walnuts\n⅛ cup dried cranberries"
    },
    {
      "id": 489326,
      "primary_message": "To serve, divide cooled sweet potato slices between plates; top with yogurt, walnuts, cranberries, and a sprinkle of cinnamon. Enjoy!",
      "secondary_message": "⅔ cup plain Greek yogurt\n1 pinch cinnamon, ground"
    }
  ],
