  "instructions": [
    {
      "id": 547411,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 547412,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 547413,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 547414,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small head red cabbage\n2 fennel bulbs"
    },
    {
      "id": 547415,
      "primary_message": "Zest and juice lemon into a medium bowl. Add yogurt, mayo, poppy seeds, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 tsp poppy seeds\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 547416,
      "primary_message": "Quarter cabbage lengthwise, then cut out and discard the core; slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 547417,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl, toss to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 547418,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 547419,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 547420,
      "primary_message": "To assemble the sandwiches, layer half of the bread slices with steak and a small portion of the slaw; close with remaining bread slices and cut in half. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
