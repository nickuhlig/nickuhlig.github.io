  "instructions": [
    {
      "id": 547449,
      "primary_message": "Slice tempeh crosswise into thin strips and place in a large bowl. Add soy sauce, vinegar, and Italian seasoning. Gently stir to coat and set aside to marinate.",
      "secondary_message": "3 (8 oz) packages tempeh\n3 tbsp soy sauce\n3 tbsp balsamic vinegar\n1 ½ tsp Italian seasoning"
    },
    {
      "id": 547450,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ small heads red cabbage\n3 fennel bulbs"
    },
    {
      "id": 547451,
      "primary_message": "Zest and juice lemons into another large bowl. Add yogurt, mayo, poppy seeds, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 ½ tsp poppy seeds\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 547452,
      "primary_message": "Quarter each cabbage lengthwise, then cut out and discard the core; slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 547453,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl, toss to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 547454,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 547455,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh in a single layer (leaving any excess marinade in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 547456,
      "primary_message": "Meanwhile, toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 547457,
      "primary_message": "To assemble the sandwiches, layer half of the bread slices with tempeh and a small portion of the slaw; close with remaining bread slices and cut in half. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
