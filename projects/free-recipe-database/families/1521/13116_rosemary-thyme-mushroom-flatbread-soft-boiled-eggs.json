  "instructions": [
    {
      "id": 219838,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 219839,
      "primary_message": "Meanwhile, wash and dry mushrooms; roughly chop into small pieces and place in a large bowl. Set aside.",
      "secondary_message": "1.36 kg cremini mushrooms"
    },
    {
      "id": 219840,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219841,
      "primary_message": "While the pot heats up, peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 219842,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 4-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 219843,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 219844,
      "primary_message": "Add mushrooms, garlic, vinegar, and spices to the pot. Cook, stirring occasionally, until mushrooms have softened, 7-10 minutes.",
      "secondary_message": "1 tbsp balsamic vinegar\n¾ tsp rosemary\n¾ tsp thyme\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 219845,
      "primary_message": "While the mushrooms are cooking, toast flatbreads (if desired).",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 219846,
      "primary_message": "Peel and halve eggs.",
      "secondary_message": null
    },
    {
      "id": 219847,
      "primary_message": "To serve, place a flatbread on each plate. Use a slotted spoon to divide mushrooms between flatbreads, then top with eggs. Enjoy!",
      "secondary_message": null
    }
  ],
