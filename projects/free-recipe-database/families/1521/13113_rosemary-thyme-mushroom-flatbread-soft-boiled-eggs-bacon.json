  "instructions": [
    {
      "id": 219804,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 219805,
      "primary_message": "Meanwhile, wash and dry mushrooms; roughly chop into small pieces and place in a large bowl. Set aside.",
      "secondary_message": "1.36 kg cremini mushrooms"
    },
    {
      "id": 219806,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219807,
      "primary_message": "Add bacon to the pot and cook until crispy, 3-5 minutes per side.",
      "secondary_message": "6 slices bacon"
    },
    {
      "id": 219808,
      "primary_message": "While the bacon is cooking, peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 219809,
      "primary_message": "Once the bacon is cooked, transfer to a plate lined with paper towels; pat to remove excess oil.",
      "secondary_message": null
    },
    {
      "id": 219810,
      "primary_message": "Return pot (with bacon fat) to the stove over medium heat.",
      "secondary_message": null
    },
    {
      "id": 219811,
      "primary_message": "Once the pot is hot, add onion and cook, stirring occasionally, until softened, 4-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 219812,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 219813,
      "primary_message": "Add mushrooms, garlic, vinegar, and spices to the pot. Cook, stirring occasionally, until mushrooms have softened, 7-10 minutes.",
      "secondary_message": "1 tbsp balsamic vinegar\n¾ tsp rosemary\n¾ tsp thyme\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 219814,
      "primary_message": "While the mushrooms are cooking, toast flatbreads (if desired).",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 219815,
      "primary_message": "Peel and halve eggs.",
      "secondary_message": null
    },
    {
      "id": 219816,
      "primary_message": "Chop or crumble bacon into small pieces.",
      "secondary_message": null
    },
    {
      "id": 219817,
      "primary_message": "To serve, place a flatbread on each plate. Use a slotted spoon to divide mushrooms between flatbreads, then top with bacon and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
