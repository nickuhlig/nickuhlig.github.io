  "instructions": [
    {
      "id": 219776,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 219777,
      "primary_message": "Meanwhile, wash and dry mushrooms; roughly chop into small pieces and place in a medium bowl. Set aside.",
      "secondary_message": "0.45 kg cremini mushrooms"
    },
    {
      "id": 219778,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219779,
      "primary_message": "Add bacon to the skillet and cook until crispy, 3-5 minutes per side.",
      "secondary_message": "2 slices bacon"
    },
    {
      "id": 219780,
      "primary_message": "While the bacon is cooking, peel and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 219781,
      "primary_message": "Once the bacon is cooked, transfer to a plate lined with paper towels; pat to remove excess oil.",
      "secondary_message": null
    },
    {
      "id": 219782,
      "primary_message": "Return skillet (with bacon fat) to the stove over medium heat.",
      "secondary_message": null
    },
    {
      "id": 219783,
      "primary_message": "Once the skillet is hot, add onion and cook, stirring occasionally, until softened, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 219784,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 219785,
      "primary_message": "Add mushrooms, garlic, vinegar, and spices to the skillet. Cook, stirring occasionally, until mushrooms have softened, 5-7 minutes.",
      "secondary_message": "1 tsp balsamic vinegar\n¼ tsp rosemary\n¼ tsp thyme\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 219786,
      "primary_message": "While the mushrooms are cooking, toast flatbreads (if desired).",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 219787,
      "primary_message": "Peel and halve eggs.",
      "secondary_message": null
    },
    {
      "id": 219788,
      "primary_message": "Chop or crumble bacon into small pieces.",
      "secondary_message": null
    },
    {
      "id": 219789,
      "primary_message": "To serve, place a flatbread on each plate. Use a slotted spoon to divide mushrooms between flatbreads, then top with bacon and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
