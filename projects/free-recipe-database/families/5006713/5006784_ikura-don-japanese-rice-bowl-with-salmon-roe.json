  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, combine salmon roe with soy sauce, mirin or sake, and dashi. Let stand for at least 15 and up to 30 minutes. (This is a good time to cook the rice.)",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Scoop rice into a serving bowl. Drain roe, then gently spoon onto rice. Garnish with wasabi, nori strips, and shiso, if desired. If you want, you can add other seafood to the bowl, like slices of salmon sashimi, picked cooked crabmeat, uni (sea urchin), or more.",
      "secondary_message": null
    }
  ],
