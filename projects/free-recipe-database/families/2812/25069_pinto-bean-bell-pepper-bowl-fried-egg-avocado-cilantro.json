  "instructions": [
    {
      "id": 402699,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 402700,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 orange bell pepper\n1 yellow bell pepper\n½ small bunch cilantro\n½ lime\n1 avocado"
    },
    {
      "id": 402701,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 402702,
      "primary_message": "Peel, halve, and slice onion crosswise into ¼-inch thick half-moons. Add to the baking sheet with the peppers. Drizzle veggies with oil and season with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n1 tbsp extra virgin olive oil\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 402703,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are browned and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402704,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can pinto beans"
    },
    {
      "id": 402705,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 402706,
      "primary_message": "While the skillet heats up, peel and mince garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 402707,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beans, garlic, cumin, and salt; cook, mashing with the back of a spoon, until beans are broken up slightly and warmed through, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 402708,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Set half aside for serving.",
      "secondary_message": null
    },
    {
      "id": 402709,
      "primary_message": "When the beans are done, add water, hot sauce, and remaining cilantro to the skillet, then stir to combine. Transfer to a medium bowl and loosely cover with aluminum foil. (Reserve skillet for the next step.)",
      "secondary_message": "¼ cup water\n1 tbsp hot sauce"
    },
    {
      "id": 402710,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat; add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat, then season with salt and pepper.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n2 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 402711,
      "primary_message": "While the eggs are cooking, cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 402712,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh. Halve lengthwise, then slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 402713,
      "primary_message": "Divide beans and roasted veggies between bowls; top each bowl with an egg, avocado, and the reserved cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
