  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Zest the lemon. Chill the butter cut into small cubes.",
      "secondary_message": "1 lemon\n10 tbsp butter"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 375°F with a rack in the middle. In a 9 by 9 glass baking dish, toss peaches and raspberries with bourbon and 1/4 teaspoon salt. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine flour, sugar, 1 teaspoon salt, mace, and lemon zest in food processor. Pulse until mace is broken up and no longer visible. Add pecans and pulse just until they are broken into large chunks with some small pieces. Add butter and pulse until mixture resembles a coarse meal. Pecans should be well integrated but with visible chunks, and butter should be in pea-sized clumps.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Very lightly pat topping evenly on fruit, spreading out to edges with fingers. Bake for 45 minutes or until crust is browned, filling is bubbly, and juices resemble a thick syrup. Let cool for 10 minutes, then serve with fresh cream or ice cream.",
      "secondary_message": null
    }
  ],
