  "instructions": [
    {
      "id": 286707,
      "primary_message": "Place cherries in a colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "1 cup frozen cherries"
    },
    {
      "id": 286708,
      "primary_message": "Place cocoa powder, maple syrup, water, tahini, vanilla, and salt in a small saucepan. Cook over low heat, whisking constantly, until sauce is combined and thickened, 3-4 minutes. Cover and remove from heat.",
      "secondary_message": "½ cup cocoa powder\n⅓ cup pure maple syrup\n89 ml (⅜ cup) water\n2 tbsp tahini\n½ tsp vanilla extract\n⅛ tsp salt"
    },
    {
      "id": 286709,
      "primary_message": "Roughly chop nuts. ",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 286710,
      "primary_message": "Roughly chop cherries. ",
      "secondary_message": null
    },
    {
      "id": 286711,
      "primary_message": "Peel bananas and halve lengthwise. ",
      "secondary_message": "4 bananas"
    },
    {
      "id": 286712,
      "primary_message": "To serve, divide bananas and ice cream between bowls. Top with chocolate sauce, walnuts, and cherries. Enjoy!",
      "secondary_message": "710 ml vanilla ice cream, vegan"
    }
  ],
