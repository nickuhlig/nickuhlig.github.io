  "instructions": [
    {
      "id": 286668,
      "primary_message": "Place cherries in a colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "½ cup frozen cherries"
    },
    {
      "id": 286669,
      "primary_message": "Place milk, chocolate, sugar, and vanilla in a small saucepan. Slowly melt chocolate over low heat, stirring constantly, until sauce is combined and thickened, about 5 minutes. Remove from heat. ",
      "secondary_message": "59 ml (¼ cup) whole milk\n⅓ cup dark chocolate chips\n1 ½ tsp granulated sugar\n½ tsp vanilla extract"
    },
    {
      "id": 286670,
      "primary_message": "Roughly chop nuts. ",
      "secondary_message": "⅛ cup walnuts"
    },
    {
      "id": 286671,
      "primary_message": "Roughly chop cherries. ",
      "secondary_message": null
    },
    {
      "id": 286672,
      "primary_message": "Peel bananas and halve lengthwise.",
      "secondary_message": "2 bananas"
    },
    {
      "id": 286673,
      "primary_message": "To serve, divide bananas and ice cream between bowls. Top with chocolate sauce, walnuts, and cherries. Enjoy!",
      "secondary_message": "355 ml vanilla ice cream"
    }
