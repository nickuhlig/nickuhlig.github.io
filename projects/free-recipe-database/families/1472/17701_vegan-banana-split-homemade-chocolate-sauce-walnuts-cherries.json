  "instructions": [
    {
      "id": 286713,
      "primary_message": "Place cherries in a colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "1 ½ cup frozen cherries"
    },
    {
      "id": 286714,
      "primary_message": "Place cocoa powder, maple syrup, water, tahini, vanilla, and salt in a medium saucepan. Cook over low heat, whisking constantly, until sauce is combined and thickened, 3-4 minutes. Cover and remove from heat.",
      "secondary_message": "¾ cup cocoa powder\n½ cup pure maple syrup\n133 ml water\n3 tbsp tahini\n¾ tsp vanilla extract\n3 pinch salt"
    },
    {
      "id": 286715,
      "primary_message": "Roughly chop nuts. ",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 286716,
      "primary_message": "Roughly chop cherries. ",
      "secondary_message": null
    },
    {
      "id": 286717,
      "primary_message": "Peel bananas and halve lengthwise. ",
      "secondary_message": "6 bananas"
    },
    {
      "id": 286718,
      "primary_message": "To serve, divide bananas and ice cream between bowls. Top with chocolate sauce, walnuts, and cherries. Enjoy!",
      "secondary_message": "1065 ml vanilla ice cream, vegan"
    }
  ],
