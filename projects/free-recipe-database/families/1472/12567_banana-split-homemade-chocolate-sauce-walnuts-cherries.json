  "instructions": [
    {
      "id": 286629,
      "primary_message": "Place cherries in a colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "1 ½ cup frozen cherries"
    },
    {
      "id": 286630,
      "primary_message": "Place milk, chocolate, sugar, and vanilla in a medium saucepan. Slowly melt chocolate over low heat, stirring constantly, until sauce is combined and thickened, 6-7 minutes. Remove from heat. ",
      "secondary_message": "6 fl oz (¾ cup) whole milk\n1 cup dark chocolate chips\n1 ½ tbsp granulated sugar\n1 ½ tsp vanilla extract"
    },
    {
      "id": 286631,
      "primary_message": "Roughly chop nuts. ",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 286632,
      "primary_message": "Roughly chop cherries. ",
      "secondary_message": null
    },
    {
      "id": 286633,
      "primary_message": "Peel bananas and halve lengthwise.",
      "secondary_message": "6 bananas"
    },
    {
      "id": 286634,
      "primary_message": "To serve, divide bananas and ice cream between bowls. Top with chocolate sauce, walnuts, and cherries. Enjoy!",
      "secondary_message": "36 fl oz (4 ½ cups) vanilla ice cream"
    }
