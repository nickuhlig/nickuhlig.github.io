  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Seed the habanero bonnet chile. Lightly chop the scallions.",
      "secondary_message": "1 habanero bonnet chile\n4 scallions, white and green parts"
    },
    {
      "id": 1,
      "primary_message": "Place all of the ingredients for paste in the jar of a blender and blend until smooth. Place pork chunks in large Ziploc bag and pour in the paste, seal and toss to evenly distribute; open and reseal the bag, removing as much air as possible. Let marinate in the refrigerator for 2 to 3 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together ingredients for sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. While the charcoal is lighting, thread the pork chunks onto the skewers.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over the charcoal grate. Clean and oil the grilling grate. Place the skewers on the grill and cook until the meat is cooked through, about 6 to 8 minutes, turning three or four times during grilling. Serve immediately with the honey-lime sauce.",
      "secondary_message": null
    }
  ],
