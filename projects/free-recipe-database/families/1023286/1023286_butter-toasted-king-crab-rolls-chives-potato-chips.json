  "instructions": [
    {
      "primary_message": "Crack crab legs and claws, then pick out the crabmeat (you should have about 3 cups loosely packed crabmeat). Gently break the crabmeat into bite-sized pieces, picking out any small pieces of shell that may have been missed. Place in a small bowl and set aside. ",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n2 stick celery\n1 small pkg chives"
    },
    {
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and small dice celery. Add to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "primary_message": "Chop chives into small pieces. Add half to the bowl along with mayo, pepper, and salt, then stir to combine the dressing. (Reserve remaining chives for serving.)",
      "secondary_message": "⅓ cup mayonnaise\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "primary_message": "Add crabmeat to the bowl with the dressing. Gently stir to combine and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Melt butter in the microwave or a small saucepan.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Gently open up the rolls (making sure to keep one side attached), then brush the insides with melted butter.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add buns, butter-side down, and toast until golden brown, 30-60 seconds. Remove to a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide toasted buns between plates, fill with crab salad, and top with reserved chives. Serve with potato chips and enjoy! ",
      "secondary_message": "1 (7.5 oz) bag potato chips, kettle cooked"
    }
  ],
