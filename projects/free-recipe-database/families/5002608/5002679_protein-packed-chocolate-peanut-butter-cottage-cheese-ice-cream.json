  "instructions": [
    {
      "id": 1,
      "primary_message": "In a food processor or blender, process heavy cream, stopping and scraping down sides as needed for even blending, until thickened and soft peaks form, 30 to 60 seconds. Transfer whipped cream to a medium bowl. Do not wipe processor clean.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In now-empty food processor or blender, place cottage cheese, cocoa powder, maple syrup, and vanilla (if using) and process until smooth, stopping to scrape down sides as needed, about 2 minutes. Add whipped cream and pulse until just fully incorporated, about 5 (1-second) pulses. Transfer to a 9- x 13-cm loaf pan.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small microwave-safe bowl, microwave peanut butter on high until loosened, about 30 seconds; dollop warmed peanut butter over cottage cheese mixture in loaf pan, then use a butter knife or offset spatula to swirl peanut butter into cottage cheese mixture.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Press plastic wrap flush against surface and freeze until firm, at least 6 hours. Let sit at room temperature for 15 minutes before scooping.",
      "secondary_message": null
    }
  ],
