  "instructions": [
    {
      "id": 427662,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 427663,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 427664,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 427665,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl with the other veggies along with the carrots.",
      "secondary_message": "1 ½ medium yellow onions\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 427666,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 427667,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add vegetables, veggie ground, Cajun seasoning, and salt. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n¼ cup Cajun seasoning\n¾ tsp salt"
    },
    {
      "id": 427668,
      "primary_message": "Add water, tomato sauce, and pasta to the pot. Stir to combine, cover, and bring to a boil. Once boiling, reduce heat to medium-low and simmer (while covered) until pasta is tender and the liquid is mostly absorbed, 8-10 minutes.",
      "secondary_message": "3 cup water\n3 (8 oz) cans tomato sauce\n15 oz macaroni (elbow) pasta"
    },
    {
      "id": 427669,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 427670,
      "primary_message": "When the pasta is done, add parsley, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 427671,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with cheese. Enjoy!",
      "secondary_message": "¾ cup Parmesan cheese, shredded"
    }
  ],
