  "instructions": [
    {
      "id": 427732,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 427733,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 427734,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 427735,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 427736,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl with the other veggies along with the carrots.",
      "secondary_message": "½ medium yellow onion\n½ (283 g) bag shredded carrots"
    },
    {
      "id": 427737,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, chicken, Cajun seasoning, and salt. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n0.23 kg ground chicken\n1 ½ tbsp Cajun seasoning\n¼ tsp salt"
    },
    {
      "id": 427738,
      "primary_message": "Add water, tomato sauce, and pasta to the pan. Stir to combine, cover, and bring to a boil. Once boiling, reduce heat to medium-low and simmer (while covered) until pasta is tender and the liquid is mostly absorbed, 8-10 minutes.",
      "secondary_message": "1 cup water\n1 (213 ml) can tomato sauce\n142 g macaroni (elbow) pasta"
    },
    {
      "id": 427739,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 427740,
      "primary_message": "When the pasta is done, add parsley, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 427741,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with cheese. Enjoy!",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    }
  ],
