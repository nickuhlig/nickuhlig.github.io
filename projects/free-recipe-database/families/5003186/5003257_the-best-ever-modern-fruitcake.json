  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Stem and quarter the dried figs lengthwise. Chop the dried red plums. Pit the Medjool dates. Coarsely chop the walnuts. Coarsely chop the pistachios. Lightly beat the eggs and bring them to room temperature.",
      "secondary_message": "⅓ cup dried figs\n⅓ cup dried red plums\n½ cup Medjool dates\n1 cup walnuts\n½ cup pistachios\n2 large eggs"
    },
    {
      "id": 1,
      "primary_message": "For the Cake: Adjust oven rack to middle position and heat oven to 175°C (350°F). Grease a Bundt pan with baking spray.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In small saucepan, bring orange liqueur, cognac, raisins, cherries, figs, and plums or apricots to boil over medium-high heat. Reduce heat to medium-low and simmer until fruits are plump and liquid has reduced to about 2 tablespoons, 8 to 10 minutes. Set aside and cool completely, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, in food processor, pulse orange pieces, dates, and fresh ginger until ground to a pulp. Transfer to large bowl. Stir in poached fruit mixture, walnuts, pistachios, candied pineapple, candied orange peel, and candied ginger.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In separate bowl, stir together flour, baking soda, salt, cinnamon, ginger, cloves, and allspice.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "In separate medium bowl, whisk together boiling water, espresso powder, and molasses until thoroughly combined.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "In large bowl, beat together oil, brown sugar, and eggs on medium speed until smooth, about 1 minute. Reduce speed to low and add flour mixture in three batches, alternating with the molasses mixture and beat just until combined, scraping down sides and bottom of bowl as necessary.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Stir in fruit mixture. Scrape batter into prepared pan and bake until tester inserted in center of cake comes out clean, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Transfer pan to cooling rack and cool cake in pan 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "For the Glaze: While cake is cooling, combine orange juice, sugar, vanilla, and salt in medium heavy-bottomed saucepan and bring to boil over medium-high heat. Reduce heat to medium and simmer until thickened and reduced to 1/2 cup, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "Invert cake onto cooling rack. Brush sides and top of cake with warm glaze and cool completely, 1 to 2 hours.",
      "secondary_message": null
    }
  ],
