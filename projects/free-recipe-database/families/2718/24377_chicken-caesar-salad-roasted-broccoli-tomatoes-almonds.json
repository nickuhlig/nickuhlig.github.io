  "instructions": [
    {
      "id": 425268,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 425269,
      "primary_message": "Transfer broccoli to a baking sheet pan. Drizzle with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "1 (510 g) bag broccoli florets\n2 tbsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 425270,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing broccoli halfway through, until fork-tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 425271,
      "primary_message": "Meanwhile, wash, dry, and chop (or tear) lettuce into bite-sized pieces. Place in a large bowl. ",
      "secondary_message": "4 hearts romaine hearts"
    },
    {
      "id": 425272,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise. Add to the bowl with the lettuce. ",
      "secondary_message": "2 small pkgs grape tomatoes"
    },
    {
      "id": 425273,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and add to the bowl. Set aside.",
      "secondary_message": "1 (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 425274,
      "primary_message": "When the broccoli is done, remove from the oven and let cool, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 425275,
      "primary_message": "Add roasted broccoli, Parmesan, almonds, and dressing to the bowl with the chicken. Toss to combine the salad.",
      "secondary_message": "½ cup Parmesan cheese, shredded\n¼ cup almonds, sliced\n½ cup Caesar dressing"
    },
    {
      "id": 425276,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
