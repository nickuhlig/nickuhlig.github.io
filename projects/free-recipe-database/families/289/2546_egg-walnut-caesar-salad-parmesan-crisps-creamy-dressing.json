  "instructions": [
    {
      "id": 24680,
      "primary_message": "Preheat the oven to 200°C (400°F).",
      "secondary_message": ""
    },
    {
      "id": 24681,
      "primary_message": "Place the eggs in a small saucepan, cover with water, and bring to a full, rolling boil. Once boiling, remove the pan from the heat, cover, and let sit for 10 minutes. Drain and cover with cold water or ice to cool.",
      "secondary_message": "4 eggs\r\n"
    },
    {
      "id": 24682,
      "primary_message": "Coarsely grate ½ cup of Parmesan.",
      "secondary_message": "28 g Parmesan cheese\r\n"
    },
    {
      "id": 24683,
      "primary_message": "Line a baking sheet with parchment paper. Measure out 1 tbsp of the grated Parmesan and place in a pile on the sheet. Repeat with remaining cheese.",
      "secondary_message": ""
    },
    {
      "id": 24684,
      "primary_message": "Place in the oven and bake until lightly browned, 5-7 minutes. Once done, remove from the oven and let them sit for a couple of minutes.",
      "secondary_message": ""
    },
    {
      "id": 24685,
      "primary_message": "Finely grate ⅛ cup of Parmesan.",
      "secondary_message": "14 g Parmesan cheese \r\n"
    },
    {
      "id": 24686,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "1 clove garlic\r\n"
    },
    {
      "id": 24687,
      "primary_message": "In a small bowl, prepare the dressing by whisking together the grated Parmesan, minced garlic, lemon juice, mayo, olive oil, Dijon, coconut aminos, salt, and pepper. Set aside.",
      "secondary_message": "juice of ¼ lemon\n4 tbsp avocado oil mayonnaise\n2 tbsp extra virgin olive oil\n¼ tsp Dijon mustard\n½ tsp coconut aminos\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 24688,
      "primary_message": "Roughly chop the walnuts and transfer to a small bowl.",
      "secondary_message": "½ cup walnuts\r\n"
    },
    {
      "id": 24689,
      "primary_message": "Wash and dry the lettuce. Halve lengthwise, then chop crosswise into 2 ½ cm strips.",
      "secondary_message": "1 head romaine lettuce"
    },
    {
      "id": 24690,
      "primary_message": "Peel and quarter the eggs. Gently peel the Parmesan crisps off of the parchment paper. Slice remaining ¼ lemon into wedges.",
      "secondary_message": ""
    },
    {
      "id": 24691,
      "primary_message": "To serve, arrange a bed of romaine on a plate, add eggs, walnuts, and Parmesan crisps. Drizzle with dressing and lemon juice and enjoy!",
      "secondary_message": ""
    }
  ],
