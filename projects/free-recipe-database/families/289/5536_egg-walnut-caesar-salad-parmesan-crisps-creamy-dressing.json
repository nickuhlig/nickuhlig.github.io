  "instructions": [
    {
      "id": 66350,
      "primary_message": "Preheat the oven to 400°F.",
      "secondary_message": ""
    },
    {
      "id": 66349,
      "primary_message": "Place the eggs in a medium saucepan, cover with water, and bring to a full, rolling boil. Once boiling, remove the pan from the heat, cover, and let sit for 10 minutes. Drain and cover with cold water or ice to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 66348,
      "primary_message": "Coarsely grate 1 ½ cup of Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 66347,
      "primary_message": "Line a baking sheet with parchment paper. Measure out 1 tbsp of the grated Parmesan and place in a pile on the sheet. Repeat with remaining cheese.",
      "secondary_message": ""
    },
    {
      "id": 66346,
      "primary_message": "Place in the oven and bake until lightly browned, 5-7 minutes. Once done, remove from the oven and let them sit for a couple of minutes.",
      "secondary_message": ""
    },
    {
      "id": 66345,
      "primary_message": "Finely grate ⅓ cup of Parmesan.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 66344,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 66343,
      "primary_message": "In a small bowl, prepare the dressing by whisking together the grated Parmesan, minced garlic, lemon juice, mayo, olive oil, Dijon, soy sauce, salt, and pepper. Set aside.",
      "secondary_message": "juice of ¾ lemon\n12 tbsp mayonnaise\n6 tbsp extra virgin olive oil\n¾ tsp Dijon mustard\n1 ½ tsp soy sauce\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 66342,
      "primary_message": "Roughly chop the walnuts and transfer to a small bowl.",
      "secondary_message": "1 ½ cups walnuts"
    },
    {
      "id": 66339,
      "primary_message": "Wash and dry the lettuce. Halve lengthwise, then chop crosswise into 1 inch strips.",
      "secondary_message": "3 heads romaine lettuce"
    },
    {
      "id": 66341,
      "primary_message": "Peel and quarter the eggs. Gently peel the Parmesan crisps off of the parchment paper. Slice remaining lemon into wedges.",
      "secondary_message": ""
    },
    {
      "id": 66340,
      "primary_message": "To serve, arrange a bed of romaine on a plate, add eggs, walnuts, and Parmesan crisps. Drizzle with dressing and lemon juice and enjoy!",
      "secondary_message": ""
    }
  ],
