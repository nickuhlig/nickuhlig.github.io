  "instructions": [
    {
      "id": 60958,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 60953,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with Italian seasoning, salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 60957,
      "primary_message": "Coat grill or bottom of skillet with oil. Add chicken and cook until cooked through, 2-3 minutes per side.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 60952,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by whisking together garlic, oil, vinegar, oregano, salt, and pepper.",
      "secondary_message": "3 cloves garlic\n4 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n1 ½ tsp oregano\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60956,
      "primary_message": "Wash and dry cucumbers, bell peppers, and tomatoes. Medium dice cucumbers. Seed and medium dice peppers. Halve tomatoes. Peel and medium dice onion. Add everything to bowl with dressing.",
      "secondary_message": "1 ½ English cucumber\n3 red bell peppers\n1 ½ pint grape tomatoes\n1 ½ medium red onion"
    },
    {
      "id": 60955,
      "primary_message": "Add olives to bowl and toss salad.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 60954,
      "primary_message": "To serve, place chicken and greek salad on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
