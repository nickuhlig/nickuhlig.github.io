  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the oven to 400 degrees F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Prepare the vegetables by slicing the potatoes and scallions into thirds. In a roasting pan, toss together the potatoes with the fresh thyme, 1 scant tablespoon olive oil, and salt and pepper. Put into the oven to begin softening.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, prepare the duck. Trim the duck of any excess fat, and reserve. Rub both duck legs with 1 teaspoon of olive oil total, just to give it a light coating.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Sprinkle the duck liberally on both sides with herbes de Provence, and season well with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Heat a sauté pan on medium-high heat, and add in the reserved duck fat so that it begins to render. Place the duck legs skin side down into the hot pan, and sear just about 4 minutes until the skin is nice and golden. Flip the duck, and sear another minute.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Open the oven, and toss the scallions and sugar snap peas in with the potatoes, coating the green vegetables with the seasoned potato oil. Place the duck legs skin side up on the bed of vegetables, and roast for 30-35 minutes, or just until the juices run clear. Garnish with stems of fresh thyme.",
      "secondary_message": null
    }
  ],
