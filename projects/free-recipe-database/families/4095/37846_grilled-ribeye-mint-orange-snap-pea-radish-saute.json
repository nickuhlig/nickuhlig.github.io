  "instructions": [
    {
      "id": 591539,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591540,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb ribeye steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 591541,
      "primary_message": "Once the pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 591542,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh mint\n½ orange\n1 bunch radish\n½ (8 oz) pkg sugar snap peas"
    },
    {
      "id": 591543,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 591544,
      "primary_message": "Zest and juice orange into the bowl with the mint. Add water, Dijon, and salt, then stir to combine the sauce. Set aside. ",
      "secondary_message": "2 tbsp water\n2 tsp Dijon mustard\n1 pinch salt"
    },
    {
      "id": 591545,
      "primary_message": "Trim and quarter radishes lengthwise.",
      "secondary_message": null
    },
    {
      "id": 591546,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591547,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 591548,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add radishes, garlic, snap peas, salt, and pepper; cook, stirring often, until just fork-tender, 2-3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 591549,
      "primary_message": "Add sauce to the skillet and continue to cook, stirring often, until veggies are tender and coated in sauce, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 591550,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 591551,
      "primary_message": "To serve, divide steak and veggie sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
