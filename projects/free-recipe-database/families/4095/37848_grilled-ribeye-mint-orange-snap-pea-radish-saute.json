  "instructions": [
    {
      "id": 591565,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591566,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 591567,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 591568,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh mint\n1 ½ oranges\n3 bunches radish\n1 ½ (8 oz) pkgs sugar snap peas"
    },
    {
      "id": 591569,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 591570,
      "primary_message": "Zest and juice oranges into the bowl with the mint. Add water, Dijon, and salt, then stir to combine the sauce. Set aside. ",
      "secondary_message": "⅓ cup water\n2 tbsp Dijon mustard\n3 pinch salt"
    },
    {
      "id": 591571,
      "primary_message": "Trim and quarter radishes lengthwise.",
      "secondary_message": null
    },
    {
      "id": 591572,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591573,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 591574,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add radishes, garlic, snap peas, salt, and pepper; cook, stirring often, until just fork-tender, 3-4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 591575,
      "primary_message": "Add sauce to the pot and continue to cook, stirring often, until veggies are tender and coated in sauce, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 591576,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 591577,
      "primary_message": "To serve, divide steak and veggie sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
