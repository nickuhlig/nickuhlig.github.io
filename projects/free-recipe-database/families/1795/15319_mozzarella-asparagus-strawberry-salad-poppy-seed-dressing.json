  "instructions": [
    {
      "id": 252452,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 252453,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 small bunches asparagus\n1 ½ (16 oz) pkg strawberries\n1 ½ bunches radish\n1 small pkg fresh basil\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 252454,
      "primary_message": "Snap or cut off woody ends of the asparagus; cut into bite-sized pieces. Divide between two baking sheet pans, drizzle with oil, and sprinkle with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 252455,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until asparagus is tender-crisp, 10-12 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 252456,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, poppy seeds, Dijon, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n⅓ cup balsamic vinegar\n1 ½ tbsp brown sugar\n1 ½ tsp poppy seeds\n¾ tsp Dijon mustard\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 252457,
      "primary_message": "Trim and slice strawberries crosswise into ¼-inch thick pieces; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 252458,
      "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 252459,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 252460,
      "primary_message": "Add roasted asparagus and mixed greens to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 252461,
      "primary_message": "Slice mozzarella into thin rounds.",
      "secondary_message": "3 (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 252462,
      "primary_message": "To serve, divide salad between plates and top with mozzarella. Enjoy!",
      "secondary_message": null
    }
  ],
