  "instructions": [
    {
      "id": 252505,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 252506,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch asparagus\n½ (454 g) pkg strawberries\n½ bunch radish\n½ small pkg fresh basil\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 252507,
      "primary_message": "Snap or cut off woody ends of the asparagus; cut into bite-sized pieces. Transfer to a baking sheet pan, drizzle with oil, and sprinkle with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 252508,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until asparagus is tender-crisp, 8-10 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 252509,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, poppy seeds, Dijon, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 ½ tsp brown sugar\n½ tsp poppy seeds\n¼ tsp Dijon mustard\n¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 252510,
      "primary_message": "Trim and slice strawberries crosswise into ¼-inch thick pieces; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 252511,
      "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 252512,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 252513,
      "primary_message": "Add roasted asparagus and mixed greens to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 252514,
      "primary_message": "Slice mozzarella into thin rounds.",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 252515,
      "primary_message": "To serve, divide salad between plates and top with mozzarella. Enjoy!",
      "secondary_message": null
    }
  ],
