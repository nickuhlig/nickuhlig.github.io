  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the cheddar cheese. Halve the cherry tomatoes.",
      "secondary_message": "57 g cheddar cheese\n6 cherry tomatoes"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 205°C (400°F). Line baking sheet with parchment paper. Roll out puff pastry to a 5 1/2- by 51-cm rectangle that's about 0.5-cm thick. Trim edges and cut into four rectangular pieces.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place puff pastry squares on baking sheet and fold over edges to create a raised crust, giving a slightly curved shape to the edges pastry. Using a fork, prick bottom of the pastry.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake pastry until puffed, golden and crisp, 15 to 20 minutes. Let cool slightly, then gently press center of pastry shells to deflate it and create a well for the egg.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Sprinkle cheese onto center of pastry shells. Crack an egg into a small bowl and gently slide it into a puff pastry shell. Repeat with remaining eggs and shells. Arrange tomatoes, cut side up, on eggs and sprinkle lightly with salt.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake until egg white is just set and yolk is almost set, 8 to 10 minutes. Garnish with parsley leaves and serve immediately.",
      "secondary_message": null
    }
  ],
