  "instructions": [
    {
      "id": 1,
      "primary_message": "Place chips on a microwave-safe plate in a single layer. Microwave on high power until they smell nice and toasty, about 30 seconds to 1 minute. Remove from microwave and top each chip with 1 teaspoon of beans, a little shredded cheese, and a jalapeño slice. Return to microwave and cook for 30 seconds. Continue to cook in 15-second intervals until all the cheese is melted and bubbly. Eat and repeat as necessary.",
      "secondary_message": null
