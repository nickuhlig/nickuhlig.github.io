  "instructions": [
    {
      "id": 435011,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 435012,
      "primary_message": "Wash, dry, peel, and slice mango flesh away from the pits, starting with the flat sides; medium dice. Place in a blender. ",
      "secondary_message": "2 mangoes"
    },
    {
      "id": 435013,
      "primary_message": "Wash, dry, zest, and juice lime into the blender. Blend on high speed for several minutes until mango is smooth.",
      "secondary_message": "1 lime"
    },
    {
      "id": 435014,
      "primary_message": "Add yogurt and honey to the blender. Blend once more on high speed until combined, then set aside. ",
      "secondary_message": "⅔ cup plain Greek yogurt\n¼ cup honey"
    },
    {
      "id": 435015,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "8 fl oz (1 cup) heavy whipping cream"
    },
    {
      "id": 435016,
      "primary_message": "Transfer the mango-yogurt mixture to the bowl with the whipped cream. Using a silicone spatula, gently fold the two together until the mousse is just combined.",
      "secondary_message": null
    },
    {
      "id": 435017,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "¼ cup pecan halves"
    },
    {
      "id": 435018,
      "primary_message": "To serve, divide mousse between small bowls, cups, or jars; top with pecans and drizzle with additional honey. Enjoy!",
      "secondary_message": "2 tsp honey"
    }
  ],
