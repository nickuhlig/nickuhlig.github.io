  "instructions": [
    {
      "id": 435086,
      "primary_message": "Place a large bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 435087,
      "primary_message": "Wash, dry, peel, and slice mango flesh away from the pits, starting with the flat sides; medium dice. Place in a blender. ",
      "secondary_message": "3 mangoes"
    },
    {
      "id": 435088,
      "primary_message": "Wash, dry, zest, and juice limes into the blender. Blend on high speed until mango is puréed. ",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 435089,
      "primary_message": "Add yogurt and honey to the blender. Blend once more on high speed until combined, then set aside. ",
      "secondary_message": "1 cup plain Greek yogurt\n⅓ cup honey"
    },
    {
      "id": 435090,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "355 ml heavy whipping cream"
    },
    {
      "id": 435091,
      "primary_message": "Transfer the mango-yogurt mixture to the bowl with the whipped cream. Using a silicone spatula, gently fold the two together until the mousse is just combined.",
      "secondary_message": null
    },
    {
      "id": 435092,
      "primary_message": "To serve, divide mousse between small bowls, cups, or jars; drizzle with additional honey. Enjoy!",
      "secondary_message": "1 tbsp honey"
    }
  ],
