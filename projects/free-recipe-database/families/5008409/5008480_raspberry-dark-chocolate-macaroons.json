  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven racks to middle and upper positions and preheat oven to 165°C (325°F). Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In the bowl of a food processor combine coconut, sugar, salt, vanilla, egg whites, and almonds. Pulse to combine, about 8 short pulses. Add raspberries and pulse until evenly distributed, about another 8 pulses. Use a medium size cookie scoop (7-cm diameter, 1 1/2 Tbsp) to scoop dough and drop it onto the prepared baking sheet in rounded balls. Bake cookies until golden in color and dry to the touch, 30-35 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Let cookies cool for 5 minutes then transfer to a wire rack to cool completely. Melt chocolate in a double boiler or in the microwave. Drizzle chocolate over cookies and let stand until hardened.",
      "secondary_message": null
    }
  ],
