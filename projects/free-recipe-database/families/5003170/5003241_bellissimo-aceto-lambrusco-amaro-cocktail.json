  "instructions": [
    {
      "id": 1,
      "primary_message": "Add mint, white balsamic vinegar, Amaro Lucano, and salt to a cocktail shaker and fill with ice. Shake vigorously until well chilled, about 12 seconds. Double-strain into 2 Champagne flutes (you'll have about 43 g or 45ml of the mix in each glass).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Top each glass with 90 ml Lambrusco and serve immediately.",
      "secondary_message": null
    }
