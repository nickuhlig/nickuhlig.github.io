  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the garlic. Peel and finely chop the ginger.",
      "secondary_message": "2 medium cloves garlic\n1 (1 inch) piece ginger"
    },
    {
      "id": 1,
      "primary_message": "Heat vegetable oil in a medium nonstick skillet over medium-high heat until shimmering. Add onion, garlic, and ginger. Cook, stirring constantly with a spatula, until onions soften, about 5 minutes. Add cumin, turmeric, paprika, coriander, curry powder, and red pepper flakes. Continue to cook until the spices begin to smell toasted, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Reduce heat to medium and add tomato paste. Continue to cook, stirring, until tomato paste is evenly incorporated, about 3 minutes. Add flour and stir until there well combined. Pour the water and lemon juice into the pan and stir until the mixture begins to thicken. Allow curry sauce to cook until the mixture has reduced to about 1 1/2 cups.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To purée and strain (optional): Transfer curry sauce to a food processor or blender. Process until smooth, then pass through a fine-mesh strainer into a storage container.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Season sauce with salt and pepper to taste, then use to make a variety of delicious curries. Curry sauce can be stored for up to a week in the refrigerator.",
      "secondary_message": null
    }
  ],
