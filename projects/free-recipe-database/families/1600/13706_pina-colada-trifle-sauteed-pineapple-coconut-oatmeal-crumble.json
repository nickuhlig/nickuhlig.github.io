  "instructions": [
    {
      "id": 228006,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 228007,
      "primary_message": "Wash and dry pineapple. Cut off skin, quarter, core, and small dice. Transfer to a medium saucepan.",
      "secondary_message": "1 small pineapple"
    },
    {
      "id": 228008,
      "primary_message": "Place pineapple over medium-high heat and cook, stirring frequently, until pineapple is soft and caramelized, 10-15 minutes. Transfer pineapple to a plate and spread out in a thin layer; set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 228009,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 228010,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add oats, coconut, sugar, vanilla, and salt to the skillet. Cook, stirring constantly, until oats and coconut become golden brown and fragrant, 5-6 minutes. Transfer mixture to another plate and set aside to cool.",
      "secondary_message": "3 tbsp butter, unsalted\n1 cup oats, quick cooking\n1 cup shredded unsweetened coconut\n2 tbsp brown sugar\n2 tsp vanilla extract\n⅛ tsp salt"
    },
    {
      "id": 228011,
      "primary_message": "Using a box grater, coarsely grate cream cheese into a small bowl; add vanilla. Use a silicone spatula or fork to soften and combine the cream cheese mixture, creating a smooth cream.",
      "secondary_message": "½ (227 g) block cream cheese\n1 tsp vanilla extract"
    },
    {
      "id": 228012,
      "primary_message": "Using a strainer, sift powdered sugar into the bowl with the cream cheese. Use the spatula or fork to mash and combine the mixture until smooth and no lumps remain. Set aside.",
      "secondary_message": "½ cup powdered sugar"
    },
    {
      "id": 228013,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk to beat the cream vigorously, until medium-soft peaks form, about 2 minutes. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 228014,
      "primary_message": "Transfer the cream cheese mixture to the bowl with the whipped cream. Using a silicone spatula, gently fold the two together until almost combined.",
      "secondary_message": null
    },
    {
      "id": 228015,
      "primary_message": "To serve, divide coconut-oatmeal crumble, pineapple, and sweet cream between small bowls, cups, or jars, alternating ingredients to create layers. Enjoy!",
      "secondary_message": null
    }
  ],
