  "instructions": [
    {
      "id": 248144,
      "primary_message": "Place eggs in a medium saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 248145,
      "primary_message": "While the eggs are cooking, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n340 g macaroni (elbow) pasta"
    },
    {
      "id": 248146,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 sticks celery\n2 green bell peppers\n3 medium carrots\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 248147,
      "primary_message": "Place yogurt, mayo, vinegar, Dijon, honey, and spices in a large bowl. Whisk to combine the creamy dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n½ cup mayonnaise\n1 ½ tbsp red wine vinegar\n1 ½ tbsp Dijon mustard\n1 tbsp honey\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 248148,
      "primary_message": "Peel and mince onion; add to the bowl with the creamy dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 248149,
      "primary_message": "Mince olives and add to the bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 248150,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248151,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248152,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248153,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248154,
      "primary_message": "Peel and small dice the eggs. Add to the bowl, stir to combine the macaroni salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 248155,
      "primary_message": "Place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 248156,
      "primary_message": "To serve, divide mixed greens between plates and drizzle with vinaigrette. Top with macaroni salad and enjoy!",
      "secondary_message": null
    }
  ],
