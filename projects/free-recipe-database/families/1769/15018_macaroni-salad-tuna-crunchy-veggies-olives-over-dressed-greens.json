  "instructions": [
    {
      "id": 248082,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n113 g macaroni (elbow) pasta"
    },
    {
      "id": 248083,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 stick celery\n½ green bell pepper\n1 medium carrot\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 248084,
      "primary_message": "Place yogurt, mayo, vinegar, Dijon, honey, and spices in a medium bowl. Whisk to combine the creamy dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 ½ tsp red wine vinegar\n1 ½ tsp Dijon mustard\n1 tsp honey\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 248085,
      "primary_message": "Drain tuna and add to the bowl with the creamy dressing; flake with a fork.",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 248086,
      "primary_message": "Mince olives and add to the bowl.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 248087,
      "primary_message": "Peel and mince shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 248088,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248089,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248090,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248091,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl. Stir to combine the macaroni salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 248092,
      "primary_message": "Place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 248093,
      "primary_message": "To serve, divide mixed greens between plates and drizzle with vinaigrette. Top with macaroni salad and enjoy!",
      "secondary_message": null
    }
  ],
