  "instructions": [
    {
      "id": 247981,
      "primary_message": "Place eggs in a small saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 247982,
      "primary_message": "While the eggs are cooking, fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n8 oz macaroni (elbow) pasta"
    },
    {
      "id": 247983,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 sticks celery\n1 green bell pepper\n2 medium carrots\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 247984,
      "primary_message": "Place yogurt, mayo, vinegar, Dijon, honey, and spices in a large bowl. Whisk to combine the creamy dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 tbsp red wine vinegar\n1 tbsp Dijon mustard\n2 tsp honey\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 247985,
      "primary_message": "Peel and mince shallots; add to the bowl with the creamy dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 247986,
      "primary_message": "Mince olives and add to the bowl.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 247987,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 247988,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 247989,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 247990,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 247991,
      "primary_message": "Peel and small dice the eggs. Add to the bowl, stir to combine the macaroni salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 247992,
      "primary_message": "Place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 247993,
      "primary_message": "To serve, divide mixed greens between plates and drizzle with vinaigrette. Top with macaroni salad and enjoy!",
      "secondary_message": null
    }
  ],
