  "instructions": [
    {
      "id": 537338,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n⅔ lb white mushrooms\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 537339,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place half in a medium bowl along with mayo, vinegar, water, salt, and pepper. Whisk to combine the dressing. (Reserve remaining basil for serving.)",
      "secondary_message": "2 tbsp mayonnaise\n4 tsp rice vinegar\n2 tsp water\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 537340,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 537341,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 537342,
      "primary_message": "While the water heats up, finely grate Parmesan. Set aside.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 537343,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "2 (16 oz) pkgs potato gnocchi\n1 tsp salt"
    },
    {
      "id": 537344,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 537345,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chili-garlic sauce and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "⅓ cup butter, unsalted\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 537346,
      "primary_message": "Add drained gnocchi and Parmesan to the skillet with the chili butter. Continue to cook, stirring often, until cheese is melted and gnocchi are coated in sauce, 1 minute more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 537347,
      "primary_message": "Add spinach to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 537348,
      "primary_message": "To serve, divide gnocchi and salad between plates or bowls. Top gnocchi with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
