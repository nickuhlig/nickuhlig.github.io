  "instructions": [
    {
      "id": 537349,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n1 lb white mushrooms\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 537350,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place half in a large bowl along with mayo, vinegar, water, salt, and pepper. Whisk to combine the dressing. (Reserve remaining basil for serving.)",
      "secondary_message": "3 tbsp mayonnaise\n2 tbsp rice vinegar\n1 tbsp water\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 537351,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 537352,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 537353,
      "primary_message": "While the water heats up, finely grate Parmesan. Set aside.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 537354,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "3 (16 oz) pkgs potato gnocchi\n1 ½ tsp salt"
    },
    {
      "id": 537355,
      "primary_message": "Meanwhile, preheat another large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 537356,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add chili-garlic sauce and cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "½ cup butter, unsalted\n3 tbsp chili-garlic sauce"
    },
    {
      "id": 537357,
      "primary_message": "Add drained gnocchi and Parmesan to the pot with the chili butter. Continue to cook, stirring often, until cheese is melted and gnocchi are coated in sauce, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 537358,
      "primary_message": "Add spinach to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 537359,
      "primary_message": "To serve, divide gnocchi and salad between plates or bowls. Top gnocchi with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
