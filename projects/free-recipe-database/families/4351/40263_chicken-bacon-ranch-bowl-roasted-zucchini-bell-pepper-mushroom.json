  "instructions": [
    {
      "id": 623382,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 623383,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch fresh dill\n1 medium zucchini squash\n1 red bell pepper\n0.23 kg white mushrooms"
    },
    {
      "id": 623384,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl, along with spices, and stir to combine the spice mix. Set aside.",
      "secondary_message": "1 tsp parsley flakes\n1 tsp garlic powder\n1 tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623385,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into half-moons. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 623386,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the baking sheet with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 623387,
      "primary_message": "Halve mushrooms. Add to the baking sheet, drizzle with oil, then sprinkle with half of the spice mix. Stir to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 623388,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623389,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623390,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 623391,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 3-4 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 623392,
      "primary_message": "While the bacon is cooking, cut chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623393,
      "primary_message": "When the bacon is done, return skillet (with drippings) to medium-high heat. Add chicken and cook, stirring occasionally, until golden and cooked through, 5-6 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 623394,
      "primary_message": "Meanwhile, add mayo and vinegar to the bowl with the reserved spice mix. Whisk to combine the ranch dressing. Add water, 1 teaspoon at a time, if needed, to reach a drizzling consistency.",
      "secondary_message": "3 tbsp mayonnaise\n2 tsp white wine vinegar"
    },
    {
      "id": 623395,
      "primary_message": "To serve, divide roasted veggies and chicken between plates or bowls. Top with crispy bacon, drizzle with ranch, and enjoy!",
      "secondary_message": null
    }
  ],
