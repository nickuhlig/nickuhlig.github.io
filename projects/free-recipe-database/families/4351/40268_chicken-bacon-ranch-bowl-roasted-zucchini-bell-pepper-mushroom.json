  "instructions": [
    {
      "id": 623452,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 623453,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n3 medium zucchini squash\n3 red bell peppers\n0.68 kg white mushrooms"
    },
    {
      "id": 623454,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl, along with spices, and stir to combine the spice mix. Set aside.",
      "secondary_message": "1 tbsp parsley flakes\n1 tbsp garlic powder\n1 tbsp onion powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 623455,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into half-moons. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 623456,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the baking sheets with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 623457,
      "primary_message": "Halve mushrooms. Add to the baking sheets, drizzle with oil, then sprinkle with half of the spice mix. Stir to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 623458,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623459,
      "primary_message": "Meanwhile, medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 623460,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623461,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 623462,
      "primary_message": "While the bacon is cooking, cut chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 623463,
      "primary_message": "When the bacon is done, return skillet (with drippings) to medium-high heat. Add chicken and cook, stirring occasionally, until golden and cooked through, 6-7 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 623464,
      "primary_message": "Meanwhile, add mayo and vinegar to the bowl with the reserved spice mix. Whisk to combine the ranch dressing. Add water, a few teaspoons at a time, if needed, to reach a drizzling consistency.",
      "secondary_message": "½ cup avocado oil mayonnaise\n2 tbsp white wine vinegar"
    },
    {
      "id": 623465,
      "primary_message": "To serve, divide roasted veggies and chicken between plates or bowls. Top with crispy bacon, drizzle with ranch, and enjoy!",
      "secondary_message": null
    }
  ],
