  "instructions": [
    {
      "id": 507331,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 507332,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 (2 ½ cm) piece ginger root\n½ lime\n1 mango\n½ small bunch cilantro"
    },
    {
      "id": 507333,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 507334,
      "primary_message": "While the rice is cooking, place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "2 tbsp rice vinegar\n½ tsp honey\n¼ tsp salt"
    },
    {
      "id": 507335,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 507336,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl along with oil, soy sauce, honey, and spices; whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n2 tsp toasted sesame oil\n1 ½ tsp soy sauce\n1 tsp honey\n½ tsp smoked paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 507337,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end (or corner) firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin.",
      "secondary_message": "⅓ kg salmon fillet"
    },
    {
      "id": 507338,
      "primary_message": "Cut the salmon into 1-inch cubes. Add to the bowl with the marinade, stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 507339,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 507340,
      "primary_message": "While the skillet heats up, juice lime into another small bowl. Add yogurt and chili-garlic sauce, then stir to combine the spicy yogurt sauce. Set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n⅛ tsp chili-garlic sauce"
    },
    {
      "id": 507341,
      "primary_message": "Once the skillet is hot, add salmon (with marinade) and cook, turning occasionally, until cooked through, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 507342,
      "primary_message": "Meanwhile, using a clean cutting board, peel mango and slice flesh away from the pit, starting with the flat sides; cut into bite-sized pieces. Place in a third small bowl.",
      "secondary_message": null
    },
    {
      "id": 507343,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the mango (reserving a small handful for serving) and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 507344,
      "primary_message": "Just before serving, fluff rice with a fork. Add coconut and stir to combine.",
      "secondary_message": "⅛ cup shredded unsweetened coconut"
    },
    {
      "id": 507345,
      "primary_message": "To serve, divide rice, salmon, pickled cucumber, and mango between bowls. Drizzle with yogurt sauce, top with reserved cilantro, and enjoy!",
      "secondary_message": null
    }
  ],
