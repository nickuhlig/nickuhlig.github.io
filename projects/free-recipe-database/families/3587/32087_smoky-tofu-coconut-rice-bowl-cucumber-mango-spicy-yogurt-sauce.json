  "instructions": [
    {
      "id": 507391,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 507392,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 507393,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 (2 ½ cm) pieces ginger root\n1 lime\n2 mangoes\n1 small bunch cilantro"
    },
    {
      "id": 507394,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 507395,
      "primary_message": "While the rice is cooking, place vinegar, honey, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "¼ cup rice vinegar\n1 tsp honey\n½ tsp salt"
    },
    {
      "id": 507396,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 507397,
      "primary_message": "Peel and mince ginger and garlic. Place both in another medium bowl along with oil, soy sauce, honey, and spices; whisk to combine the marinade.",
      "secondary_message": "4 cloves garlic\n4 tsp toasted sesame oil\n1 tbsp soy sauce\n2 tsp honey\n1 tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 507398,
      "primary_message": "Medium dice tofu. Add to the bowl with the marinade, gently stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 507399,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 507400,
      "primary_message": "While the skillet heats up, juice lime into a small bowl. Add yogurt and chili-garlic sauce, then stir to combine the spicy yogurt sauce. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n¼ tsp chili-garlic sauce"
    },
    {
      "id": 507401,
      "primary_message": "Once the skillet is hot, add tofu (with marinade) and cook, turning occasionally, until golden, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 507402,
      "primary_message": "Meanwhile, peel mangoes and slice flesh away from the pits, starting with the flat sides; cut into bite-sized pieces. Place in a third medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 507403,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the mango (reserving a small handful for serving) and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 507404,
      "primary_message": "Just before serving, fluff rice with a fork. Add coconut and stir to combine.",
      "secondary_message": "¼ cup shredded unsweetened coconut"
    },
    {
      "id": 507405,
      "primary_message": "To serve, divide rice, tofu, pickled cucumber, and mango between bowls. Drizzle with yogurt sauce, top with reserved cilantro, and enjoy!",
      "secondary_message": null
    }
  ],
