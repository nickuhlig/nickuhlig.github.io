  "instructions": [
    {
      "id": 108321,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 108322,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 small pkgs grape tomatoes\n2 small pkgs fresh basil\n4 medium zucchini squash"
    },
    {
      "id": 108323,
      "primary_message": "Heat a large skillet over medium-high heat. Add oil and swirl to coat the bottom. Add tomatoes and salt and cook, stirring occasionally, until the tomatoes burst, about 8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 108324,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 108325,
      "primary_message": "Using a julienne peeler (or regular peeler), peel zucchini into noodle-like sticks. Leave raw or warm up in a skillet with a little olive oil until slightly softened.",
      "secondary_message": null
    },
    {
      "id": 108326,
      "primary_message": "Add the shrimp, garlic, and crushed red pepper. Simmer uncovered, stirring occasionally, until the sauce begins to thicken and the shrimp is cooked through, about 5 minutes.",
      "secondary_message": "2 ml crushed red pepper"
    },
    {
      "id": 108327,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Stir into the sauce.",
      "secondary_message": null
    },
    {
      "id": 108328,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "227 g Parmesan cheese"
    },
    {
      "id": 108329,
      "primary_message": "To serve, divide the zucchini noodles between bowls and top with shrimp, sauce, and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
