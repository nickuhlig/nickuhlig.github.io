  "instructions": [
    {
      "id": 108279,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 108280,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 108281,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 108282,
      "primary_message": "When the water in the pot comes to a boil, uncover the pot and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for about 10 minutes (or according to package directions). Drain the pasta in a colander.",
      "secondary_message": "170 g linguine pasta\n1 ½ tsp salt"
    },
    {
      "id": 108283,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 108284,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 108285,
      "primary_message": "Add oil to the skillet and swirl to coat the bottom; add tomatoes and salt. Cook, stirring occasionally, until the tomatoes burst, about 8 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 108286,
      "primary_message": "Add the shrimp, garlic, and crushed red pepper to the skillet with the tomatoes. Simmer, uncovered, stirring occasionally, until the sauce begins to thicken and the shrimp is cooked through, about 5 minutes.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 108287,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 108288,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Stir into the sauce.",
      "secondary_message": null
    },
    {
      "id": 108289,
      "primary_message": "To serve, divide the pasta between bowls and top with shrimp, sauce, and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
