  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and cut the carrots into 1/2 inch rounds. Chop the onion into 1/4-inch dice. Chop the celery into 1/4-inch dice.",
      "secondary_message": "2 medium carrots\n1 medium onion\n2 stalks celery"
    },
    {
      "id": 1,
      "primary_message": "In a large Dutch oven, heat oil over medium heat. Dry pork cheeks and sprinkle with salt and pepper. Add them to the pan in batches, taking care not to crowd the meat. Cook until the surface is browned on both sides, about 4 minutes per side, flipping only once or twice so as not to disturb browning. Remove with tongs to a plate and brown remaining cheeks, adding more oil if needed. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat oven to 150°C (300°F). Add onions, carrots, and celery to Dutch oven and sauté until softened but not brown, about 5 minutes. Add wine, tomato, and rosemary. Return pork cheeks to pan, stir to combine, and bring the mixture to a simmer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cover pan and transfer to oven. Braise until meat is very tender, about 2 1/2 to 3 hours. Allow meat to cool and settle in liquid (for best results, cover and refrigerate overnight). Skim fat from surface and reheat gently. Serve with pasta or polenta.",
      "secondary_message": null
    }
  ],
