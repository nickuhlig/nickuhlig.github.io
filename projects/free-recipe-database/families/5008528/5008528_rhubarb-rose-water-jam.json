  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the rhubarb. Juice the lemons.",
      "secondary_message": "2 lb rhubarb\n1 ½ lemons"
    },
    {
      "id": 1,
      "primary_message": "Whisk together sugar and pectin a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine rhubarb and 1/2 cup water in a large saucepan. Bring to a boil, then reduce heat, cover, and simmer just until the rhubarb breaks down, 10 to 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Measure 4 cups of stewed rhubarb (if you have extra, reserve for another use). Return 4 cups of rhubarb to saucepan. Add lemon juice, rose water, calcium water, and food coloring (if using) and bring to a boil over medium-high heat. Add the sugar-pectin mixture and return the fruit mixture to a boil, stirring constantly. Boil hard for one minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove the pot from the heat and skim any foam from the surface of the jam with a cold metal spoon. Ladle jam into hot sterilized jars and process them in a hot water bath for 10 minutes.",
      "secondary_message": null
    }
  ],
