  "instructions": [
    {
      "id": 375909,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 375910,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ small pkgs grape tomatoes\n1 small pkg fresh basil\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 375911,
      "primary_message": "Cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 375912,
      "primary_message": "Add oil and spices to the bowl with the cauliflower, then stir to combine. Transfer cauliflower rice to a large baking sheet pan and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 375913,
      "primary_message": "Pat the salmon dry with paper towels and place, skin-side down, on another baking sheet. Drizzle with oil, then season the top side with salt and pepper.",
      "secondary_message": "1.02 kg salmon fillet\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 375914,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until rice is tender and salmon is cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 375915,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 375916,
      "primary_message": "Once the skillet is hot, add additional oil and swirl to coat the bottom. Add tomatoes and salt; cook, stirring occasionally, until tomatoes start to burst, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 375917,
      "primary_message": "While the tomatoes are cooking, finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 375918,
      "primary_message": "Add Parmesan, broth, cream, and garlic powder to the skillet; stir to combine the sauce and bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until sauce has thickened, 7-8 minutes. ",
      "secondary_message": "355 ml chicken or vegetable broth\n355 ml heavy whipping cream\n1 ½ tsp garlic powder"
    },
    {
      "id": 375919,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 375920,
      "primary_message": "When the sauce is done, add basil and spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 375921,
      "primary_message": "To serve, divide cauliflower rice, salmon, and sauce between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
