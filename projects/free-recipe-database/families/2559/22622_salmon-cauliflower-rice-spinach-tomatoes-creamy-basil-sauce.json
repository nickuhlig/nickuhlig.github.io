  "instructions": [
    {
      "id": 375896,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 375897,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium head cauliflower\n1 small pkg grape tomatoes\n1 small pkg fresh basil\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 375898,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 375899,
      "primary_message": "Add oil and spices to the bowl with the cauliflower, then stir to combine. Transfer cauliflower rice to one half of a large baking sheet pan and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 375900,
      "primary_message": "Pat the salmon dry with paper towels and place, skin-side down, on the other half of the baking sheet. Drizzle with oil, then season the top side with salt and pepper.",
      "secondary_message": "0.68 kg salmon fillet\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 375901,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until rice is tender and salmon is cooked through, 13-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 375902,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 375903,
      "primary_message": "Once the skillet is hot, add additional oil and swirl to coat the bottom. Add tomatoes and salt; cook, stirring occasionally, until tomatoes start to burst, about 4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 375904,
      "primary_message": "While the tomatoes are cooking, finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 375905,
      "primary_message": "Add Parmesan, broth, cream, and garlic powder to the skillet; stir to combine the sauce and bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until sauce has thickened, 6-7 minutes. ",
      "secondary_message": "237 ml chicken or vegetable broth\n237 ml heavy whipping cream\n1 tsp garlic powder"
    },
    {
      "id": 375906,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 375907,
      "primary_message": "When the sauce is done, add basil and spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 375908,
      "primary_message": "To serve, divide cauliflower rice, salmon, and sauce between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
