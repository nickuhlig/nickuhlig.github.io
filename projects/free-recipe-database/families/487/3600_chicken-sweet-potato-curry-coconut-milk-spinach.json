  "instructions": [
    {
      "id": 38649,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lb sweet potatoes\n2 (1 inch) pieces ginger root\n1 small bunch cilantro\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 38650,
      "primary_message": "Peel and cut the sweet potatoes into ¾-inch cubes; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 38651,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces) and transfer to a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 38652,
      "primary_message": "Preheat the sauté pan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 38653,
      "primary_message": "While the pan heats up, pat the chicken thighs dry with paper towels and place on the cutting board. Cut the chicken into bite-sized pieces.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 38654,
      "primary_message": "Once the pan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 38655,
      "primary_message": "Add the onion and chicken to the pan and season with salt and pepper; cook, tossing occasionally, until the onion is softened and the chicken is browned, 5 to 6 minutes.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 38656,
      "primary_message": "Wash and dry the cutting board and knife.",
      "secondary_message": null
    },
    {
      "id": 38657,
      "primary_message": "Peel and grate or mince the ginger; transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 38658,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the ginger.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 38659,
      "primary_message": "Add the ginger, garlic, curry powder, and turmeric to the pan; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "2 tbsp curry powder\n2 tsp turmeric"
    },
    {
      "id": 38660,
      "primary_message": "Add the sweet potatoes and coconut milk to the pan; season with salt and pepper. Bring the mixture to a boil, then reduce heat to a simmer, cover the pan, and cook until the sweet potatoes are tender, 12 to 15 minutes.",
      "secondary_message": "1 (13.5 fl oz) can coconut milk\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 38661,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Stir about ¾ of the cilantro into the curry and save the rest for garnishing.",
      "secondary_message": null
    },
    {
      "id": 38662,
      "primary_message": "Once the sweet potatoes are tender, add the spinach to the curry and stir until wilted, then remove the curry from the heat.",
      "secondary_message": null
    },
    {
      "id": 38663,
      "primary_message": "To serve, spoon the curry into a bowl and sprinkle with the remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
