  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the ripe tomatoes into bite-size chunks. Pit and slice the apricots. Tear the mint leaves. Break the feta cheese into rough chunks.",
      "secondary_message": "3 ½ ripe tomatoes\n2 to 3 apricots\n1 small handful fresh mint leaves\n170 g feta cheese"
    },
    {
      "id": 1,
      "primary_message": "Combine tomatoes, apricots, and half of mint in a large bowl and season with salt and pepper. Drizzle with olive oil and toss very gently to coat. Arrange on a serving platter. Add chunks of feta cheese. Sprinkle with remaining mint. Drizzle with more olive oil. Serve.",
      "secondary_message": null
    }
