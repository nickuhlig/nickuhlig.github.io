  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Place oil and spices in a large bowl. Stir to combine the spice paste.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp chili powder\n1 tbsp smoked paprika\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces. Add to the bowl with the spice paste, gently stir to coat, and set aside.",
      "secondary_message": "3 (227 g) packages tempeh"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 yellow bell peppers\n1 ½ limes\n1 ½ avocados"
    },
    {
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the tempeh.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and slice onions crosswise into ½-inch thick half-moons. Add to the bowl and gently stir once more to combine. Divide tempeh and veggies between two large baking sheet pans and spread out in an even layer.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tempeh is browned and veggies are fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, cut limes into wedges. Set aside for serving.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "Divide tortillas between plates, then fill with tempeh, veggies, and avocado. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
