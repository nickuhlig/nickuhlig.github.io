  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Place oil and spices in a large bowl. Stir to combine the spice paste.",
      "secondary_message": "3 tbsp extra virgin olive oil\n4 tsp chili powder\n2 tsp smoked paprika\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces. Add to the bowl with the spice paste, gently stir to coat, and set aside.",
      "secondary_message": "2 (8 oz) packages tempeh"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 yellow bell peppers\n1 lime\n1 avocado"
    },
    {
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the tempeh.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and slice onion crosswise into ½-inch thick half-moons. Add to the bowl and gently stir once more to combine. Transfer tempeh and veggies to a large baking sheet pan and spread out in an even layer.",
      "secondary_message": "1 medium red onion"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tempeh is browned and veggies are fork-tender, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, cut lime into wedges. Set aside for serving.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "Divide tortillas between plates, then fill with tempeh, veggies, and avocado. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
