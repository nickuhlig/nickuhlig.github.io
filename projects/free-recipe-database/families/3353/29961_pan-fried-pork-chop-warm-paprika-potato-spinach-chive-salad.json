  "instructions": [
    {
      "id": 477055,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 ¼ lb new potatoes\n1 ½ lemons\n1 small pkg chives\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 477056,
      "primary_message": "Quarter potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 477057,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add yogurt, mayo, Dijon, and spices, then whisk to combine the dressing. ",
      "secondary_message": "1 cup plain Greek yogurt\n⅓ cup mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 477058,
      "primary_message": "Chop chives into small pieces. Add half to the bowl with the dressing and set aside. (Reserve remaining chives for serving.)",
      "secondary_message": null
    },
    {
      "id": 477059,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477060,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, bone-in\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 477061,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 477062,
      "primary_message": "When the potatoes are done, drain and rinse under cold water to cool. Set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 477063,
      "primary_message": "Return skillet (with drippings) to medium heat. Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 477064,
      "primary_message": "Add spinach to the bowl with the dressing, along with drained potatoes, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 477065,
      "primary_message": "To serve, divide pork chops and potato salad between plates. Top potato salad with reserved chives and enjoy!",
      "secondary_message": null
    }
  ],
