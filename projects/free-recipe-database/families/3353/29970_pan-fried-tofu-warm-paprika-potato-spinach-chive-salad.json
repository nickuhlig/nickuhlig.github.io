  "instructions": [
    {
      "id": 547389,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 547390,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1.02 kg new potatoes\n1 ½ lemons\n1 small pkg chives\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 547391,
      "primary_message": "Quarter potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 547392,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add yogurt, mayo, Dijon, and spices, then whisk to combine the dressing. ",
      "secondary_message": "1 cup plain Greek yogurt\n½ cup mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 547393,
      "primary_message": "Chop chives into small pieces. Add half to the bowl with the dressing and set aside. (Reserve remaining chives for serving.)",
      "secondary_message": null
    },
    {
      "id": 547394,
      "primary_message": "Cut the tofu planks in half crosswise and place on a plate. Sprinkle with cornstarch and spices on both sides. ",
      "secondary_message": "3 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 547395,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 547396,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tofu and pan-fry until golden brown an warmed through, 2-3 minutes per side. Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 547397,
      "primary_message": "When the potatoes are done, drain and rinse under cold water to cool. Set aside to drain further. ",
      "secondary_message": null
    },
    {
      "id": 547398,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 547399,
      "primary_message": "Add spinach to the bowl with the dressing, along with drained potatoes, and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 547400,
      "primary_message": "To serve, divide tofu and potato salad between plates. Top potato salad with reserved chives and enjoy!",
      "secondary_message": null
    }
  ],
