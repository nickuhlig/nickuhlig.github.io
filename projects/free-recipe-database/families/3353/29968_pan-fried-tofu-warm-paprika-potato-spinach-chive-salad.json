  "instructions": [
    {
      "id": 547365,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 547366,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "⅓ kg new potatoes\n½ lemon\n½ small pkg chives\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 547367,
      "primary_message": "Quarter potatoes; place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 547368,
      "primary_message": "Meanwhile, juice lemon into a medium bowl. Add yogurt, mayo, Dijon, and spices, then whisk to combine the dressing. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tsp Dijon mustard\n½ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 547369,
      "primary_message": "Chop chives into small pieces. Add half to the bowl with the dressing and set aside. (Reserve remaining chives for serving.)",
      "secondary_message": null
    },
    {
      "id": 547370,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 547371,
      "primary_message": "While the skillet heats up, cut the tofu planks in half crosswise and place on a plate. Sprinkle with cornstarch and spices on both sides. ",
      "secondary_message": "1 tbsp cornstarch\n½ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 547372,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry until golden brown an warmed through, 2-3 minutes per side. Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 547373,
      "primary_message": "When the potatoes are done, drain and rinse under cold water to cool. Set aside to drain further. ",
      "secondary_message": null
    },
    {
      "id": 547374,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 547375,
      "primary_message": "Add spinach to the bowl with the dressing, along with drained potatoes, and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 547376,
      "primary_message": "To serve, divide tofu and potato salad between plates. Top potato salad with reserved chives and enjoy!",
      "secondary_message": null
    }
  ],
