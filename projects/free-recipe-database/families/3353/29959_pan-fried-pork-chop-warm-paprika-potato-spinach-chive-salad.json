  "instructions": [
    {
      "id": 477033,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "¾ lb new potatoes\n½ lemon\n½ small pkg chives\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 477034,
      "primary_message": "Quarter potatoes; place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 477035,
      "primary_message": "Meanwhile, juice lemon into a medium bowl. Add yogurt, mayo, Dijon, and spices, then whisk to combine the dressing. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 tsp Dijon mustard\n½ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 477036,
      "primary_message": "Chop chives into small pieces. Add half to the bowl with the dressing and set aside. (Reserve remaining chives for serving.)",
      "secondary_message": null
    },
    {
      "id": 477037,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477038,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 477039,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 477040,
      "primary_message": "When the potatoes are done, drain and rinse under cold water to cool. Set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 477041,
      "primary_message": "Return skillet (with drippings) to medium heat. Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 477042,
      "primary_message": "Add spinach to the bowl with the dressing, along with drained potatoes, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 477043,
      "primary_message": "To serve, divide pork chops and potato salad between plates. Top potato salad with reserved chives and enjoy!",
      "secondary_message": null
    }
  ],
