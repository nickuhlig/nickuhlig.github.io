  "instructions": [
    {
      "id": 78246,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) water"
    },
    {
      "id": 78245,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ pint grape tomatoes\n1 ½ avocados\n1 ½ limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 78244,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78243,
      "primary_message": "Quarter the grape tomatoes and transfer to a medium salad bowl (that will hold the pico de gallo salsa).",
      "secondary_message": ""
    },
    {
      "id": 78242,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 78241,
      "primary_message": "Juice the limes and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 78240,
      "primary_message": "Trim off and discard the ends of the onions and remove the outer layer; small dice the onions into ¼-inch pieces. Transfer one ½ of the diced onions to the salad bowl and the other ½ to a small bowl.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 78239,
      "primary_message": "Add coconut oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 78238,
      "primary_message": "In a small bowl, combine and mix together chili powder, cumin, oregano, garlic powder, onion powder, salt, and pepper.",
      "secondary_message": "3 tbsp chili powder\n3 tsp cumin\n1 ½ tsp oregano\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 78237,
      "primary_message": "Once the skillet is hot, add the remaining onion; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78236,
      "primary_message": "Add the ground turkey to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes.",
      "secondary_message": "2 ¼ lb ground turkey"
    },
    {
      "id": 78235,
      "primary_message": "Add the spice mixture to the onion and turkey; stir until fragrant and well combined into the mixture, 15 to 30 seconds.",
      "secondary_message": ""
    },
    {
      "id": 78234,
      "primary_message": "Season the pico de gallo with salt and pepper; toss to combine.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 78233,
      "primary_message": "Remove the pit from the avocado with a knife or spoon; thinly slice the flesh crosswise (without piercing the skin) and scoop out. Transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 78232,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 78231,
      "primary_message": "To serve, arrange the rice, ground turkey, pico de gallo, and avocado slices in bowls. Enjoy!",
      "secondary_message": ""
    }
  ],
