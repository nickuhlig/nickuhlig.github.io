  "instructions": [
    {
      "id": 358039,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 358040,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n1 ½ green bell peppers\n3 tomatoes\n1 ½ avocados"
    },
    {
      "id": 358041,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans pinto beans"
    },
    {
      "id": 358042,
      "primary_message": "Juice limes into a large bowl. Add oil, maple syrup, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 ½ tsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 358043,
      "primary_message": "Cut tofu pieces in half crosswise, then cut each half into two triangles; place on a plate. Sprinkle with cornstarch and spices on both sides.",
      "secondary_message": "3 tbsp cornstarch\n1 ½ tsp garlic powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 358044,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 358045,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, flipping once, until golden brown and warmed through, 6-8 minutes. Return to the plate.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 358046,
      "primary_message": "Meanwhile, peel, halve, and mince onion; add to the bowl with the dressing. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 358047,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 358048,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 358049,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 358050,
      "primary_message": "Small dice tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 358051,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl, along with the beans, and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 358052,
      "primary_message": "To serve, divide tofu and bean salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
