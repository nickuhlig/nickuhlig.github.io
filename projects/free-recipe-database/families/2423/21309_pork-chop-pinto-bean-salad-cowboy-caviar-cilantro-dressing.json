  "instructions": [
    {
      "id": 357998,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small bunch cilantro\n1 ½ jalapeño peppers\n1 ½ green bell peppers\n3 tomatoes\n1 ½ avocados"
    },
    {
      "id": 357999,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans pinto beans"
    },
    {
      "id": 358000,
      "primary_message": "Juice limes into a large bowl. Add oil, honey, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp honey\n1 ½ tsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 358001,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 358002,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season with spices on both sides. ",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp garlic powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 358003,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 358004,
      "primary_message": "Meanwhile, peel, halve, and mince onion; add to the bowl with the dressing. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 358005,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 358006,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 358007,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 358008,
      "primary_message": "Small dice tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 358009,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl, along with the beans, and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 358010,
      "primary_message": "To serve, divide chops and bean salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
