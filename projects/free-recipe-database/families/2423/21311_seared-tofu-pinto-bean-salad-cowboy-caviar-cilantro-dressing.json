  "instructions": [
    {
      "id": 358025,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 358026,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 jalapeño pepper\n1 small bunch cilantro\n1 green bell pepper\n2 tomatoes\n1 avocado"
    },
    {
      "id": 358027,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "id": 358028,
      "primary_message": "Juice limes into a medium bowl. Add oil, maple syrup, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp pure maple syrup\n1 tsp chili powder\n1 tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 358029,
      "primary_message": "Cut tofu pieces in half crosswise, then cut each half into two triangles; place on a plate. Sprinkle with cornstarch and spices on both sides.",
      "secondary_message": "2 tbsp cornstarch\n1 tsp garlic powder\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 358030,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 358031,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, flipping once, until golden brown and warmed through, 6-8 minutes. Return to the plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 358032,
      "primary_message": "Meanwhile, peel and mince shallots; add to the bowl with the dressing. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 358033,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 358034,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 358035,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 358036,
      "primary_message": "Small dice tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 358037,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl, along with the beans, and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 358038,
      "primary_message": "To serve, divide tofu and bean salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
