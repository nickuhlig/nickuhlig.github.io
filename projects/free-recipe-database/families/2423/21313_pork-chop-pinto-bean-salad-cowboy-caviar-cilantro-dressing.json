  "instructions": [
    {
      "id": 358053,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch cilantro\n½ jalapeño pepper\n½ green bell pepper\n1 tomato\n½ avocado"
    },
    {
      "id": 358054,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can pinto beans"
    },
    {
      "id": 358055,
      "primary_message": "Juice lime into a medium bowl. Add oil, honey, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp honey\n½ tsp chili powder\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 358056,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 358057,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season with spices on both sides. ",
      "secondary_message": "2 pork chops, boneless\n½ tsp garlic powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 358058,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 358059,
      "primary_message": "Meanwhile, peel and mince shallot; add to the bowl with the dressing. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 358060,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 358061,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 358062,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 358063,
      "primary_message": "Small dice tomato and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 358064,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl, along with the beans, and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 358065,
      "primary_message": "To serve, divide chops and bean salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
