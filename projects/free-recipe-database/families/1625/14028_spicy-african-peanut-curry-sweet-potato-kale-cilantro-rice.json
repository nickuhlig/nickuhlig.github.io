  "instructions": [
    {
      "id": 233134,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 233135,
      "primary_message": "Once the liquid comes to a boil, add salt, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 233136,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 jalapeño peppers\n1 ½ lb sweet potatoes\n1 ½ bunches kale\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 233137,
      "primary_message": "Peel and mince garlic and ginger; transfer to a medium bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 233138,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl with the garlic; set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 233139,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 233140,
      "primary_message": "While the pot heats up, peel and small dice onions.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 233141,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 5-7 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 233142,
      "primary_message": "Meanwhile, peel and medium dice sweet potatoes.",
      "secondary_message": null
    },
    {
      "id": 233143,
      "primary_message": "Add garlic, ginger, jalapeños, curry powder, and salt to the pot. Cook, stirring constantly, until fragrant, 1-2 minutes. (Reserve bowl for later.)",
      "secondary_message": "3 tbsp curry powder\n1 ½ tsp salt"
    },
    {
      "id": 233144,
      "primary_message": "Add broth, tomatoes, peanut butter, and sweet potato to the pot. Stir to combine and bring to a simmer over medium-high heat. Reduce heat and simmer, stirring occasionally, until sweet potato begins to soften, 10-12 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes\n¾ cup natural peanut butter"
    },
    {
      "id": 233145,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces, place in the reserved bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 233146,
      "primary_message": "Coarsely chop peanuts. Shave cilantro leaves off the stems; discard stems and mince the leaves. Set both aside.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 233147,
      "primary_message": "Add kale to the simmering curry and stir to combine. Continue to simmer, stirring occasionally, until veggies are tender, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 233148,
      "primary_message": "While the curry finishes cooking, slice lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 233149,
      "primary_message": "To serve, divide rice and curry between bowls; top with peanuts, cilantro, and a squeeze of lime. Enjoy!",
      "secondary_message": null
    }
  ],
