  "instructions": [
    {
      "id": 233150,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 233151,
      "primary_message": "Once the liquid comes to a boil, add salt, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 233152,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 jalapeño pepper\n0.23 kg sweet potato\n½ bunch kale\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 233153,
      "primary_message": "Peel and mince garlic and ginger; transfer to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 233154,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl with the garlic; set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 233155,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 233156,
      "primary_message": "While the pan heats up, peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 233157,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 233158,
      "primary_message": "Meanwhile, peel and medium dice sweet potato.",
      "secondary_message": null
    },
    {
      "id": 233159,
      "primary_message": "Add garlic, ginger, jalapeño, curry powder, and salt to the pan. Cook, stirring constantly, until fragrant, about 1 minute. (Reserve bowl for later.)",
      "secondary_message": "1 tbsp curry powder\n½ tsp salt"
    },
    {
      "id": 233160,
      "primary_message": "Add broth, tomatoes, peanut butter, and sweet potato to the pan. Stir to combine and bring to a simmer over medium-high heat. Reduce heat and simmer, stirring occasionally, until sweet potato begins to soften, about 10 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n¼ cup natural peanut butter"
    },
    {
      "id": 233161,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces, place in the reserved bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 233162,
      "primary_message": "Coarsely chop peanuts. Shave cilantro leaves off the stems; discard stems and mince the leaves. Set both aside.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 233163,
      "primary_message": "Add kale to the simmering curry and stir to combine. Continue to simmer, stirring occasionally, until veggies are tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 233164,
      "primary_message": "While the curry finishes cooking, slice lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 233165,
      "primary_message": "To serve, divide rice and curry between bowls; top with peanuts, cilantro, and a squeeze of lime. Enjoy!",
      "secondary_message": null
    }
  ],
