  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°F. Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together flour, baking powder, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, whisk together sugar and egg. Whisk in butter. Add milk and vanilla and whisk until combined. Stir in flour mixture until evenly incorporated. Mix in hazelnuts and black pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Divide dough in two and form into 3-inch wide logs. Bake until lightly golden, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Let dough cool slightly then cut into 3/4-inch wide slices, cutting on a bias. Place cookies, cut side down, onto baking sheets.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Bake cookies until toasted, about 20 minutes. Move to a wire rack and let cool.",
      "secondary_message": null
    }
  ],
