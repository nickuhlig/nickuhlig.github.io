  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "primary_message": "Pat hot dogs dry with paper towels. Halve crosswise, place on a plate, and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Open the crescent roll package and unroll the dough onto a flat surface. Pinch and press the diagonal (perforated) lines closed so that you have 4 rectangles.",
      "secondary_message": "1 (228 g) tube crescent roll dough"
    },
    {
      "primary_message": "Working one at a time, cut each rectangle lengthwise into 6 strips to use as \"bandages\" for wrapping the \"mummies.\"",
      "secondary_message": null
    },
    {
      "primary_message": "Wrap each hot dog piece with 2 bandages, crisscrossing them, and making sure to leave a space for the \"face\" at the uncut end. Place wrapped mummies on the baking sheet, spacing them at least 1-inch apart.",
      "secondary_message": null
    },
    {
      "primary_message": "Place baking sheet in the oven and bake until the pastry is golden brown and cooked through, 10-12 minutes. Remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Using the end of a chopstick, dot mustard on the face of each mummy to create \"eyes.\"",
      "secondary_message": "½ tbsp yellow mustard"
    },
    {
      "primary_message": "Arrange mummies on a platter; serve with ketchup and additional mustard for dipping. Enjoy!",
      "secondary_message": "¼ cup ketchup\n2 tbsp yellow mustard"
    }
  ],
