  "instructions": [
    {
      "id": 398156,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 398157,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 398158,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide parsley between two medium bowls.",
      "secondary_message": null
    },
    {
      "id": 398159,
      "primary_message": "Finely grate Parmesan. Divide between the two bowls.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 398160,
      "primary_message": "Coarsely grate mozzarella. Add all of the mozzarella to one of the bowls, stir to combine, and set aside.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 398161,
      "primary_message": "Add chicken, bread crumbs, eggs, oil, and spices to the remaining bowl with the parsley and Parmesan; use your hands to combine the chicken mixture. Using a tablespoon measure, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "0.45 kg ground chicken\n½ cup panko bread crumbs\n2 eggs\n2 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 398162,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398163,
      "primary_message": "While the skillet heats up, place tomato sauce and spices in a baking dish. Stir to combine the sauce.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n1 tsp Italian seasoning\n½ tsp crushed red pepper\n⅛ tsp salt"
    },
    {
      "id": 398164,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). Transfer to the baking dish with the sauce and turn to coat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 398165,
      "primary_message": "Top the saucy meatballs with reserved parsley and two-cheese mixture. Place baking dish in the oven and bake until cheese is melted and meatballs are cooked through, 7-8 minutes. Remove from oven. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 398166,
      "primary_message": "Meanwhile, zest and juice lemon into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 398167,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 398168,
      "primary_message": "Add arugula to the bowl with the dressing and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 398169,
      "primary_message": "To serve, divide meatballs, sauce, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
