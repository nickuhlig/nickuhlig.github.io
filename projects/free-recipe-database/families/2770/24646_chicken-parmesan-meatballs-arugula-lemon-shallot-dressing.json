  "instructions": [
    {
      "id": 398142,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 398143,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ lemon\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 398144,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide parsley between two medium bowls.",
      "secondary_message": null
    },
    {
      "id": 398145,
      "primary_message": "Finely grate Parmesan. Divide between the two bowls.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 398146,
      "primary_message": "Coarsely grate mozzarella. Add all of the mozzarella to one of the bowls, stir to combine, and set aside.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 398147,
      "primary_message": "Add chicken, bread crumbs, egg, oil, and spices to the remaining bowl with the parsley and Parmesan; use your hands to combine the chicken mixture. Using a tablespoon measure, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "0.23 kg ground chicken\n¼ cup panko bread crumbs\n1 egg\n1 tsp extra virgin olive oil\n¼ tsp oregano, dried\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 398148,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398149,
      "primary_message": "While the skillet heats up, place tomato sauce and spices in a small bowl. Stir to combine the sauce.",
      "secondary_message": "1 (213 ml) can tomato sauce\n½ tsp Italian seasoning\n¼ tsp crushed red pepper\n1 pinch salt"
    },
    {
      "id": 398150,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 398151,
      "primary_message": "When the meatballs are browned, pour tomato sauce over top, stir to coat, then sprinkle with reserved parsley and two-cheese mixture. Place skillet in the oven and bake until cheese is melted and meatballs are cooked through, 7-8 minutes more. Remove from oven. (Reserve medium bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 398152,
      "primary_message": "Meanwhile, zest and juice lemon into the medium reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 398153,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 398154,
      "primary_message": "Add arugula to the bowl with the dressing and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 398155,
      "primary_message": "To serve, divide meatballs, sauce, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
