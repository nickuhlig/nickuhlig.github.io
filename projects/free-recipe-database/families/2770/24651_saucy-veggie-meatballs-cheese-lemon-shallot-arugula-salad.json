  "instructions": [
    {
      "id": 398212,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 398213,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 398214,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide parsley between two large bowls.",
      "secondary_message": null
    },
    {
      "id": 398215,
      "primary_message": "Finely grate Parmesan. Divide between the two bowls.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 398216,
      "primary_message": "Coarsely grate mozzarella. Add all of the mozzarella to one of the bowls, stir to combine, and set aside.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 398217,
      "primary_message": "Add veggie ground, bread crumbs, water, and spices to the remaining bowl with the parsley and Parmesan; use your hands to combine the veggie ground mixture. Using a tablespoon measure, form the mixture into rounded \"meatballs\" and place on a large plate.",
      "secondary_message": "680 g veggie ground, plant based\n¾ cup panko bread crumbs\n3 tbsp water\n¾ tsp oregano, dried\n¾ tsp garlic powder\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 398218,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398219,
      "primary_message": "While the skillet heats up, place tomato sauce and spices in a large baking dish. Stir to combine the sauce.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n3 pinch salt"
    },
    {
      "id": 398220,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). Transfer to the baking dish with the sauce and turn to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 398221,
      "primary_message": "Top the saucy meatballs with reserved parsley and two-cheese mixture. Place baking dish in the oven and bake until cheese is melted and meatballs are cooked through, 7-8 minutes. Remove from oven. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 398222,
      "primary_message": "Meanwhile, zest and juice lemons into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 398223,
      "primary_message": "Peel and mince shallots. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 398224,
      "primary_message": "Add arugula to the bowl with the dressing and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 398225,
      "primary_message": "To serve, divide meatballs, sauce, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
