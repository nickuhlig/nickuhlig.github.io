  "instructions": [
    {
      "id": 75995,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ (5 oz) pkg baby spinach\n3 Gala apples\n6 sticks celery\n¾ lb red grapes"
    },
    {
      "id": 75994,
      "primary_message": "Drain and rinse the chickpeas, then set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 75993,
      "primary_message": "In a large salad bowl, combine and whisk together yogurt, apple cider vinegar, Dijon, honey, salt, and pepper.",
      "secondary_message": "1 ½ cup plain Greek yogurt\n3 tbsp apple cider vinegar\n3 tsp Dijon mustard\n3 tsp honey\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 75992,
      "primary_message": "Quarter the apples lengthwise, then cut out the core and stem from each section; medium dice the apples (cut into ½-inch cubes) and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 75991,
      "primary_message": "Trim off and discard the ends of the celery; medium dice the celery (cut into ½-inch cubes) and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 75990,
      "primary_message": "Halve or quarter the grapes (depending on the size) and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 75989,
      "primary_message": "Roughly chop the walnuts and add to the salad bowl.",
      "secondary_message": "1 ½ cups walnuts"
    },
    {
      "id": 75988,
      "primary_message": "Add the chickpeas to the salad bowl; toss the salad until thoroughly coated with the dressing.",
      "secondary_message": ""
    },
    {
      "id": 75987,
      "primary_message": "To serve, divide the spinach between plates and top with the salad. Enjoy!",
      "secondary_message": ""
    }
  ],
