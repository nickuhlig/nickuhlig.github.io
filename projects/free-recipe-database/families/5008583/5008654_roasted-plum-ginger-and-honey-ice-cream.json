  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Stone and halve the plums. Peel and grate the ginger.",
      "secondary_message": "12 plums\n2 tbsp ginger root"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 260°C (500°F) with a rack in the middle. Line a rimmed baking sheet with aluminum foil and arrange plums, cut side up, in a single layer. Roast for 15 minutes, until plums are jammy and offer no resistance to a paring knife. Remove from oven and wrap in aluminum foil to cool for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer plums to blender or food processor with ginger and plum brandy. Blend till smooth, then add cream (or cream and half-and-half). Blend again for 30 seconds or until very smooth. Pour through a fine-mesh strainer into a bowl or storage container. Stir in salt and 3/4 to 1 cup of honey, to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Chill overnight, then churn the next day according to manufacturer’s instructions. Serve immediately as soft serve or let firm up in freezer for 2 to 3 hours.",
      "secondary_message": null
    }
  ],
