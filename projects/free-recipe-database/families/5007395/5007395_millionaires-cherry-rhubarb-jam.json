  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the rhubarb. Split the vanilla bean lengthwise. Zest the lemon.",
      "secondary_message": "6 cups rhubarb\n½ vanilla bean\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Whisk the sugar and pectin in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine the rhubarb, vanilla bean, and 1/2 cup water in a large saucepan. Bring to a boil, then reduce the heat, cover, and simmer just until the rhubarb breaks down, 10 to 12 minutes. Meanwhile, puree the cherries in a food processor or blender. You should have 1 cup.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Measure the stewed rhubarb. You should have 3 cups. Discard the vanilla bean. Return the rhubarb and the pureed cherries to the saucepan. Add lemon zest and juice and calcium water and bring to a boil over medium-high heat. Add the sugar-pectin mixture and return the fruit mixture to a boil, stirring constantly. Boil hard for one minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove the pot from the heat and skim any foam from the surface of the jam with a cold metal spoon. Stir in the Grand Marnier. Ladle the jam into hot sterilized jars and process them in a hot water bath for 10 minutes.",
      "secondary_message": null
    }
  ],
