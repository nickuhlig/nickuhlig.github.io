  "instructions": [
    {
      "id": 110128,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 ½ (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 110129,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 avocados\n1 ½ lemons\n3 tomatoes"
    },
    {
      "id": 110130,
      "primary_message": "Halve and pit the avocados. Cut into chunks while still in the skin, then scoop out into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 110131,
      "primary_message": "Juice lemons into the bowl with the avocado.",
      "secondary_message": null
    },
    {
      "id": 110132,
      "primary_message": "Peel and mince garlic; add to the same bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 110133,
      "primary_message": "Add beans and spices to the bowl with the avocado; mash until well combined but still slightly chunky.",
      "secondary_message": "¾ tsp thyme\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 110134,
      "primary_message": "Medium dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 110135,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 110136,
      "primary_message": "To serve, divide toast between plates, top with avocado-bean mix and tomatoes. Enjoy!",
      "secondary_message": null
    }
  ],
