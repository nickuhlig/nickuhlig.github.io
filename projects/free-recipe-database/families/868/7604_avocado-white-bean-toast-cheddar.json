  "instructions": [
    {
      "id": 110204,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 110205,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 avocados\n1 lemon\n2 tomatoes"
    },
    {
      "id": 110206,
      "primary_message": "Halve and pit the avocados. Cut into chunks while still in the skin, then scoop out into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 110207,
      "primary_message": "Juice lemon into the bowl with the avocado.",
      "secondary_message": null
    },
    {
      "id": 110208,
      "primary_message": "Peel and mince garlic; add to the same bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 110209,
      "primary_message": "Add beans and spices to the bowl with the avocado; mash until well combined but still slightly chunky.",
      "secondary_message": "½ tsp thyme\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 110210,
      "primary_message": "Medium dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 110211,
      "primary_message": "Slice cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 110212,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 110213,
      "primary_message": "To serve, divide toast between plates, top with cheese, avocado-bean mix, and tomatoes. Enjoy!",
      "secondary_message": null
    }
  ],
