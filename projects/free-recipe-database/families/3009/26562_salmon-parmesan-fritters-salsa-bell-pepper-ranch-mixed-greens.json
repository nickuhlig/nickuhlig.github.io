  "instructions": [
    {
      "id": 430427,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n1 ½ yellow bell peppers\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 430428,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between two large bowls; set one bowl aside for later use.",
      "secondary_message": null
    },
    {
      "id": 430429,
      "primary_message": "Drain salmon and flake with a fork. Add to the bowl with the cilantro along with eggs, bread crumbs, Parmesan, chili powder, and salt. Stir to combine the salmon mixture.",
      "secondary_message": "6 (213 g) cans wild pink salmon, traditional style\n6 eggs\n¾ cup panko bread crumbs\n¾ cup Parmesan cheese, shredded\n1 tbsp chili powder\n¾ tsp salt"
    },
    {
      "id": 430430,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 430431,
      "primary_message": "Working in batches, using a ⅓-cup measure, drop salmon mixture into the skillet, spacing scoops a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, about 3 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 430432,
      "primary_message": "Meanwhile, trim, seed, and small dice bell peppers. Add to the remaining bowl with the cilantro along with the mixed greens. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 430433,
      "primary_message": "Divide fritters and salad between plates; drizzle salad with dressing. Serve with salsa on the side and enjoy!",
      "secondary_message": "⅓ cup ranch dressing\n1 ½ cup salsa"
    }
  ],
