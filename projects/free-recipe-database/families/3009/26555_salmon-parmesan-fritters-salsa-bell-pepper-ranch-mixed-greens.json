  "instructions": [
    {
      "id": 430378,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n1 yellow bell pepper\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 430379,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between two medium bowls; set one bowl aside for later use.",
      "secondary_message": null
    },
    {
      "id": 430380,
      "primary_message": "Drain salmon and flake with a fork. Add to the bowl with the cilantro along with eggs, bread crumbs, Parmesan, chili powder, and salt. Stir to combine the salmon mixture.",
      "secondary_message": "4 (7.5 oz) cans wild pink salmon, traditional style\n4 eggs\n½ cup panko bread crumbs\n½ cup Parmesan cheese, shredded\n2 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 430381,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 430382,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Using a ⅓-cup measure, drop salmon mixture into skillet, spacing scoops a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, about 3 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 430383,
      "primary_message": "Meanwhile, trim, seed, and small dice bell pepper. Add to the remaining bowl with the cilantro along with the mixed greens. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 430384,
      "primary_message": "Divide fritters and salad between plates; drizzle salad with dressing. Serve with salsa on the side and enjoy!",
      "secondary_message": "¼ cup ranch dressing\n1 cup salsa"
    }
  ],
