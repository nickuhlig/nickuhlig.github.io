  "instructions": [
    {
      "id": 157763,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 157764,
      "primary_message": "Combine flour and spices in a large bowl.",
      "secondary_message": "1 tbsp all-purpose flour\n1 ½ tsp paprika\n1 tsp garlic powder\n1 tsp onion powder\n1 tsp thyme\n½ tsp salt\n½ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 157765,
      "primary_message": "Coat chicken with oil. Add drumsticks one by one to the bowl with the spices, rolling and pressing to adhere on all sides. Place chicken on the baking sheet.",
      "secondary_message": "⅓ kg chicken drumsticks\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 157766,
      "primary_message": "Place baking sheet in the oven and bake, turning once, until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 157767,
      "primary_message": "Meanwhile, heat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 157768,
      "primary_message": "Add corn to the colander and rinse under hot water for several minutes to defrost. Set aside to drain.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 157769,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 157770,
      "primary_message": "Add flour and whisk until smooth. Slowly add cream, whisking to make sure no lumps form. Stir in corn, salt, and pepper. Cover pan; remove from heat and set aside.",
      "secondary_message": "1 tsp all-purpose flour\n59 ml (¼ cup) heavy cream\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 157771,
      "primary_message": "Wash green beans and trim ends.",
      "secondary_message": "0.23 kg green beans"
    },
    {
      "id": 157772,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157773,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 157774,
      "primary_message": "Add green beans to the skillet and season with salt and pepper. Cook, tossing frequently, until bright green and tender-crisp, 3-4 minutes. Remove from the heat.",
      "secondary_message": "¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 157775,
      "primary_message": "To serve, divide the chicken, creamed corn, and green beans between plates. Enjoy!",
      "secondary_message": null
    }
  ],
