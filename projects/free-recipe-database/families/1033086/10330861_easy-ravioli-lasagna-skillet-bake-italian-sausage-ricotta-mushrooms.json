  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n2 (283 g) pkg cheese ravioli, fresh or frozen"
    },
    {
      "primary_message": "Meanwhile, preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, mushrooms, garlic, salt, and pepper to the skillet; cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n227 g cremini mushrooms\n1 tsp minced garlic\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Add sausage to the skillet and cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "680 g ground pork sausage"
    },
    {
      "primary_message": "Add cooked ravioli, marinara sauce, and ricotta to the skillet, then stir to combine. Sprinkle with cheese and loosely cover with aluminum foil. Place \"lasagna\" skillet in the oven and bake for 15 minutes. Remove foil and continue to bake until the cheese is melted and bubbly, 10 minutes more. Remove from oven.",
      "secondary_message": "1 (680 g) jar marinara sauce\n½ (425 g) pkg ricotta cheese\n1 cup shredded cheese, Italian blend"
    },
    {
      "primary_message": "To serve, divide lasagna skillet between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
