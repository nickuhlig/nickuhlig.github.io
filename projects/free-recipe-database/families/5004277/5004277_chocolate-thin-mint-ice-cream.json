  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the dark chocolate fine.",
      "secondary_message": "5 oz dark chocolate"
    },
    {
      "id": 1,
      "primary_message": "In a medium saucepan off heat, whisk together egg yolks and sugar until light in color and slightly thickened, 3 to 5 minutes. Whisk in cocoa powder until no lumps remain. Slowly add half and half, whisking constantly. Finely chop 10 Thin Mints (crumbs should be no larger than a pea) and stir into dairy.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Put saucepan on medium-low heat and cook, whisking frequently, until custard reaches 180°F on an instant read thermometer (custard should coat the back of a spoon but a swiped finger should leave a clean line). Remove custard from heat and stir in chocolate, then salt to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When chocolate is fully melted and incorporated, transfer to an airtight container and chill overnight in refrigerator.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "The next day, churn in an ice cream maker according to manufacturer's instructions. Roughly chop remaining Thin Mints; chunks should range from pea to nickle-sized. In the last minute of churn, add chopped Thin Mints. Return ice cream to container and chill in freezer for at least two hours before serving.",
      "secondary_message": null
    }
  ],
