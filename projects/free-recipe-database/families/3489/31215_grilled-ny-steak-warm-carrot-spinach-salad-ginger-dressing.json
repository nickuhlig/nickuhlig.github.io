  "instructions": [
    {
      "id": 493809,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493810,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels. Place on a plate, then season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 493811,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest. (Reserve pan for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 493812,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "12 medium carrots\n3 (2 ½ cm) pieces ginger root\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 493813,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long pieces. Place on a large plate, drizzle with oil, and season with salt and pepper. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 493814,
      "primary_message": "Return grill pan to medium heat. Working in batches, add carrots and grill, turning occasionally, until lightly charred and tender, 6-8 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 493815,
      "primary_message": "Meanwhile, peel and mince ginger. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 493816,
      "primary_message": "Juice lemons into the bowl with the ginger. Add oil, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp honey\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 493817,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493818,
      "primary_message": "Add grilled carrots and spinach to the bowl with the dressing. Gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 493819,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 493820,
      "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
