  "instructions": [
    {
      "id": 493797,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493798,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels. Place on a plate, then season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 493799,
      "primary_message": "Once the pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest. (Reserve pan for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 493800,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "8 medium carrots\n2 (2 ½ cm) pieces ginger root\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 493801,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long pieces. Place on another plate, drizzle with oil, and season with salt and pepper. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 493802,
      "primary_message": "Return grill pan to medium heat. Working in batches if necessary, add carrots and grill, turning occasionally, until lightly charred and tender, 6-8 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 493803,
      "primary_message": "Meanwhile, peel and mince ginger. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 493804,
      "primary_message": "Juice lemon into the bowl with the ginger. Add oil, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp honey\n1 tsp coriander, ground\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 493805,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493806,
      "primary_message": "Add grilled carrots and spinach to the bowl with the dressing. Gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 493807,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 493808,
      "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
