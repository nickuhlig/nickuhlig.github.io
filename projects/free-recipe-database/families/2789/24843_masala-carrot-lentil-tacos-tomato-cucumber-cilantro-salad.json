  "instructions": [
    {
      "id": 400235,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 400236,
      "primary_message": "Drain and rinse lentils, then divide between two baking sheet pans.",
      "secondary_message": "3 (255 g) cans lentils"
    },
    {
      "id": 400237,
      "primary_message": "Add carrots to the baking sheets with the lentils. Drizzle with oil and season with spices; stir to coat and spread out in an even layer. ",
      "secondary_message": "1 ½ (283 g) bags shredded carrots\n3 tbsp extra virgin olive oil\n1 ½ tbsp garam masala\n1 ½ tsp coriander, ground\n1 ½ tsp salt"
    },
    {
      "id": 400238,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until carrots and lentils are warmed through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400239,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small bunch cilantro\n1 ½ English cucumbers\n6 tomatoes"
    },
    {
      "id": 400240,
      "primary_message": "Juice half of the limes into a medium bowl. Cut remaining limes into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 400241,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice. ",
      "secondary_message": null
    },
    {
      "id": 400242,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400243,
      "primary_message": "Medium dice tomatoes. Add to the bowl along with oil, salt, and coriander, then stir to combine the salad. Set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp coriander, ground"
    },
    {
      "id": 400244,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 400245,
      "primary_message": "Divide tortillas between plates, then fill with the warm lentil-carrot mixture. Serve with salad on the side and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
