  "instructions": [
    {
      "id": 400125,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 400126,
      "primary_message": "Drain and rinse lentils, then transfer to a large baking sheet pan. ",
      "secondary_message": "2 (15 oz) cans lentils"
    },
    {
      "id": 400127,
      "primary_message": "Add carrots to the baking sheet with the lentils. Drizzle with oil and season with spices; stir to coat and spread out in an even layer. ",
      "secondary_message": "1 (10 oz) bag shredded carrots\n2 tbsp extra virgin olive oil\n4 tsp garam masala\n1 tsp coriander, ground\n1 tsp salt"
    },
    {
      "id": 400128,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until carrots and lentils are warmed through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400129,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 small bunch cilantro\n1 English cucumber\n4 tomatoes"
    },
    {
      "id": 400130,
      "primary_message": "Juice one lime into a medium bowl. Cut remaining lime into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 400131,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice. ",
      "secondary_message": null
    },
    {
      "id": 400132,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400133,
      "primary_message": "Medium dice tomatoes. Add to the bowl along with salt and coriander, then stir to combine the salad. Set aside. ",
      "secondary_message": "½ tsp salt\n¼ tsp coriander, ground"
    },
    {
      "id": 400134,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 400135,
      "primary_message": "Divide tortillas between plates, then fill with warm lentil-carrot mixture and feta. Serve with salad on the side and lime wedges for squeezing. Enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
