  "instructions": [
    {
      "id": 248952,
      "primary_message": "Drain and rinse beans; set aside.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 248953,
      "primary_message": "Peel and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 248954,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 248955,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the onion and garlic; cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 248956,
      "primary_message": "Add beans, corn, tomatoes, quinoa, water, chili powder, and salt to the pot. Stir to combine the chili and bring to a boil over high heat; reduce heat to low, cover, and cook until the liquid is absorbed and quinoa is tender, about 20 minutes.",
      "secondary_message": "2 ¼ cups frozen corn\n3 (14.5 oz) cans diced tomatoes\n1 ½ cups quinoa\n1 ½ cup water\n3 tbsp chili powder\n1 ½ tsp salt"
    },
    {
      "id": 248957,
      "primary_message": "While the chili is cooking, place oil, vinegar, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 ½ tsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 248958,
      "primary_message": "Wash and dry kale; fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 248959,
      "primary_message": "Small dice dates and add to the bowl along with the pumpkin seeds; toss to combine the salad.",
      "secondary_message": "½ cup medjool dates, pitted\n½ cup pumpkin seeds"
    },
    {
      "id": 248960,
      "primary_message": "Divide chili between bowls and serve with salad on the side; enjoy!",
      "secondary_message": null
    }
  ],
