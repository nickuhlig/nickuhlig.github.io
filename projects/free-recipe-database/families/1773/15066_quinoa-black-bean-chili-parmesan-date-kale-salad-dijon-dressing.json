  "instructions": [
    {
      "id": 248904,
      "primary_message": "Drain and rinse beans; set aside.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 248905,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 248906,
      "primary_message": "Meanwhile, peel and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 248907,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the onion and garlic; cook, stirring occasionally, until softened, about 2 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 248908,
      "primary_message": "Add beans, corn, tomatoes, quinoa, water, chili powder, and salt to the pan. Stir to combine the chili and bring to a boil over high heat; reduce heat to low, cover, and cook until the liquid is absorbed and quinoa is tender, about 20 minutes.",
      "secondary_message": "½ cup frozen corn\n1 (14.5 oz) can diced tomatoes\n½ cup quinoa\n½ cup water\n1 tbsp chili powder\n½ tsp salt"
    },
    {
      "id": 248909,
      "primary_message": "While the chili is cooking, place oil, vinegar, Dijon, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp apple cider vinegar\n½ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 248910,
      "primary_message": "Wash and dry kale; fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 248911,
      "primary_message": "Small dice dates and add to the bowl along with the pumpkin seeds.",
      "secondary_message": "⅛ cup medjool dates, pitted\n⅛ cup pumpkin seeds"
    },
    {
      "id": 248912,
      "primary_message": "Grate or shave Parmesan with a vegetable peeler and add to the bowl with the kale; toss to combine the salad.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 248913,
      "primary_message": "Divide chili between bowls and top with a dollop of yogurt; serve with salad on the side and enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
