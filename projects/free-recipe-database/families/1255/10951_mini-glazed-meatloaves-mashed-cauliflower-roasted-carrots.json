  "instructions": [
    {
      "id": 292777,
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 292778,
      "primary_message": "Peel and mince onion; place in a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 292779,
      "primary_message": "Add ground beef, egg, milk, almond meal, salt, and pepper to the bowl with the onions. Mix with your hands until well combined.",
      "secondary_message": "¾ lb lean ground beef\n1 egg\n2 fl oz (¼ cup) whole milk\n2 tbsp almond meal/flour\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 292780,
      "primary_message": "Place ketchup and Dijon in a small bowl; stir to combine.",
      "secondary_message": "1 ½ tbsp ketchup\n1 tsp Dijon mustard"
    },
    {
      "id": 292781,
      "primary_message": "Divide meatloaf mixture between 6 muffin cups and top with ketchup glaze. Place in the oven and bake until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 292782,
      "primary_message": "Meanwhile, fill a medium saucepan with about 1-inch of hot water (from the tap); cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 292783,
      "primary_message": "Wash cauliflower and cut off the leaves. Roughly chop into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 292784,
      "primary_message": "Once the water in the saucepan is boiling, add cauliflower, reduce heat to medium, cover, and cook until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 292785,
      "primary_message": "Meanwhile, wash, trim, and peel carrots. Slice lengthwise into quarters. Place on a baking sheet pan, drizzle with oil, and season with salt and pepper. Place in the oven and bake until golden and fork-tender, about 10 minutes.",
      "secondary_message": "3 medium carrots\n2 tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 292786,
      "primary_message": "When the cauliflower is cooked, drain in a colander and transfer to a blender. Add butter, salt, and pepper; purée until smooth.",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 292787,
      "primary_message": "To serve, divide the meatloaves, roasted carrots, and mashed cauliflower between plates. Enjoy!",
      "secondary_message": null
    }
  ],
