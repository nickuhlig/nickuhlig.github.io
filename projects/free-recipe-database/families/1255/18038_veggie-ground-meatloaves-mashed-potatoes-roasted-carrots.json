  "instructions": [
    {
      "id": 292963,
      "primary_message": "Preheat the oven to 220°C (425°F). Coat 6 muffin cups with oil and set aside.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 292964,
      "primary_message": "Peel and mince onion; place in a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 292965,
      "primary_message": "Add veggie ground, egg, bread crumbs, salt, and pepper to the bowl with the onions. Mix with your hands until well combined.",
      "secondary_message": "227 g veggie ground, plant based\n1 egg\n¼ cup panko bread crumbs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 292966,
      "primary_message": "Place ketchup, Dijon, and brown sugar in a small bowl; whisk to combine.",
      "secondary_message": "1 ½ tbsp ketchup\n1 tsp Dijon mustard\n½ tsp brown sugar"
    },
    {
      "id": 292967,
      "primary_message": "Divide veggie ground mixture between the muffin cups and top with ketchup glaze. Place in the oven and bake until cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 292968,
      "primary_message": "Meanwhile, wash, dry, peel, and medium dice potato. Transfer to a medium saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. ",
      "secondary_message": "1 medium yellow potato"
    },
    {
      "id": 292969,
      "primary_message": "Wash, dry, trim, and peel carrots. Slice lengthwise into quarters. Place on a baking sheet pan, drizzle with oil, and season with salt and pepper. Place in the oven and bake until golden and fork-tender, about 10 minutes.",
      "secondary_message": "3 medium carrots\n2 tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 292970,
      "primary_message": "When the potatoes are done, drain, and return to the pan.",
      "secondary_message": null
    },
    {
      "id": 292971,
      "primary_message": "Add milk, butter, salt, and pepper to the potatoes. Mash until smooth.",
      "secondary_message": "59 ml (¼ cup) whole milk\n2 tsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 292972,
      "primary_message": "To serve, divide the \"meatloaves\", roasted carrots, and mashed potatoes between plates. Enjoy!",
      "secondary_message": null
    }
  ],
