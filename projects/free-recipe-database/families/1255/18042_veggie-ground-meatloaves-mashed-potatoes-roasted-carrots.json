  "instructions": [
    {
      "primary_message": "Preheat the oven to 425°F. Coat 12 muffin cups with oil and set aside.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Peel and mince onion; place in a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Add veggie ground, eggs, bread crumbs, salt, and pepper to the bowl with the onions. Mix with your hands until well combined.",
      "secondary_message": "454 g veggie ground, plant based\n2 eggs\n½ cup gluten-free bread crumbs\nsalt\nblack pepper"
    },
    {
      "primary_message": "Place ketchup, Dijon, and brown sugar in a small bowl; whisk to combine.",
      "secondary_message": "3 tbsp ketchup\n2 tsp Dijon mustard\n1 tsp brown sugar"
    },
    {
      "primary_message": "Divide veggie ground mixture between the muffin cups and top with ketchup glaze. Place in the oven and bake until cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, peel, and medium dice potatoes. Transfer to a medium saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. ",
      "secondary_message": "2 medium yellow potatoes"
    },
    {
      "primary_message": "Wash, dry, trim, and peel carrots. Slice lengthwise into quarters. Place on a large baking sheet pan, drizzle with oil, and season with salt and pepper. Place in the oven and bake until golden and fork-tender, about 10 minutes.",
      "secondary_message": "6 medium carrots\nextra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "When the potatoes are done, drain, and return to the pan.",
      "secondary_message": null
    },
    {
      "primary_message": "Add milk, butter, salt, and pepper to the potatoes. Mash until smooth.",
      "secondary_message": "118 ml whole milk\n4 tsp butter, unsalted\nsalt\nblack pepper"
    },
    {
      "primary_message": "To serve, divide the \"meatloaves\", roasted carrots, and mashed potatoes between plates. Enjoy!",
      "secondary_message": null
    }
  ],
