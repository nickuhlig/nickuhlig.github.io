  "instructions": [
    {
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince onions; place in a large bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "primary_message": "Add ground beef, eggs, milk, bread crumbs, salt, and pepper to the bowl with the onions. Mix with your hands until well combined.",
      "secondary_message": "1.02 kg lean ground beef\n3 eggs\nwhole milk\nsalt\nblack pepper"
    },
    {
      "primary_message": "Place ketchup, Dijon, and brown sugar in a small bowl; whisk to combine.",
      "secondary_message": "¼ cup ketchup\n1 tbsp Dijon mustard\n1 ½ tsp brown sugar"
    },
    {
      "primary_message": "Divide meatloaf mixture between 18 muffin cups and top with ketchup glaze. Place in the oven and bake until cooked through, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, peel, and medium dice potatoes. Transfer to a medium saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. ",
      "secondary_message": "3 medium yellow potatoes"
    },
    {
      "primary_message": "Wash, trim, and peel carrots. Slice lengthwise into quarters. Place on a baking sheet pan, drizzle with oil, and season with salt and pepper. Place in the oven and bake until golden and fork-tender, 12-15 minutes.",
      "secondary_message": "9 medium carrots\n2 tbsp extra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "When the potatoes are done, drain, and return to the pan.",
      "secondary_message": null
    },
    {
      "primary_message": "Add milk, butter, salt, and pepper to the potatoes. Mash until smooth.",
      "secondary_message": "whole milk\n2 tbsp butter, unsalted\nsalt\nblack pepper"
    },
    {
      "primary_message": "To serve, divide the meatloaves, roasted carrots, and mashed potatoes between plates. Enjoy!",
      "secondary_message": null
    }
  ],
