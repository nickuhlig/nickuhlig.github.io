  "instructions": [
    {
      "id": 292952,
      "primary_message": "Preheat the oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 292953,
      "primary_message": "Peel and mince onions; place in a large bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 292954,
      "primary_message": "Add ground beef, eggs, milk, almond meal, salt, and pepper to the bowl with the onions. Mix with your hands until well combined.",
      "secondary_message": "1.02 kg lean ground beef\n3 eggs\n177 ml whole milk\n⅓ cup almond meal/flour\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 292955,
      "primary_message": "Place ketchup and Dijon in a small bowl; stir to combine.",
      "secondary_message": "¼ cup ketchup\n1 tbsp Dijon mustard"
    },
    {
      "id": 292956,
      "primary_message": "Divide meatloaf mixture between 18 muffin cups and top with ketchup glaze. Place in the oven and bake until cooked through, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 292957,
      "primary_message": "Meanwhile, fill a large pot with about 1-inch of hot water (from the tap); cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 292958,
      "primary_message": "Wash cauliflower heads and cut off the leaves. Roughly chop into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 292959,
      "primary_message": "Once the water in the pot is boiling, add cauliflower, reduce heat to medium, cover, and cook until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 292960,
      "primary_message": "Meanwhile, wash, trim, and peel carrots. Slice lengthwise into quarters. Place on a large baking sheet pan, drizzle with oil, and season with salt and pepper. Place in the oven and bake until golden and fork-tender, about 12 minutes.",
      "secondary_message": "9 medium carrots\n2 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 292961,
      "primary_message": "When the cauliflower is cooked, drain in a colander and transfer to a blender. Add butter, salt, and pepper; purée until smooth. Work in batches to best fit your blender.",
      "secondary_message": "3 tbsp butter, unsalted\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 292962,
      "primary_message": "To serve, divide the meatloaves, roasted carrots, and mashed cauliflower between plates. Enjoy!",
      "secondary_message": null
    }
  ],
