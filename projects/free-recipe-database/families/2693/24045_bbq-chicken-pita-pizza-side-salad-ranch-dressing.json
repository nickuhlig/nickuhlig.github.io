  "instructions": [
    {
      "id": 417368,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 417369,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and place in a large bowl.",
      "secondary_message": "1 ½ (850 g) whole chickens rotisserie chicken, white and dark meat"
    },
    {
      "id": 417370,
      "primary_message": "Divide pitas between two baking sheet pans; evenly spread with barbecue sauce, then top with chicken and cheese.",
      "secondary_message": "6 whole grain pitas\n¾ cup barbecue sauce\n2 ¼ cups shredded cheese, Mexican blend"
    },
    {
      "id": 417371,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until pita pizzas are golden and cheese is melted, about 8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 417372,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 tomatoes\n3 hearts romaine hearts"
    },
    {
      "id": 417373,
      "primary_message": "Using a clean cutting board, peel, trim, and halve cucumbers lengthwise; cut crosswise into thin half-moons. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 417374,
      "primary_message": "Medium dice tomatoes. Add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 417375,
      "primary_message": "Chop or tear romaine into bite-sized pieces. Add to the bowl, along with the dressing, and toss to combine the salad.",
      "secondary_message": "⅓ cup ranch dressing"
    },
    {
      "id": 417376,
      "primary_message": "Cut pizzas into wedges.",
      "secondary_message": null
    },
    {
      "id": 417377,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
