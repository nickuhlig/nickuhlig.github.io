  "instructions": [
    {
      "id": 417318,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 417319,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 417320,
      "primary_message": "Arrange pitas on a baking sheet pan; evenly spread with barbecue sauce, then top with beans and cheese.",
      "secondary_message": "2 whole grain pitas\n¼ cup barbecue sauce\n½ cup shredded cheese, Mexican blend"
    },
    {
      "id": 417321,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until pita pizzas are golden and cheese is melted, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 417322,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 tomato\n1 heart romaine hearts"
    },
    {
      "id": 417323,
      "primary_message": "Peel, trim, and halve cucumber lengthwise; cut crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 417324,
      "primary_message": "Medium dice tomato. Add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 417325,
      "primary_message": "Chop or tear romaine into bite-sized pieces. Add to the bowl, along with the dressing, and toss to combine the salad.",
      "secondary_message": "2 tbsp ranch dressing"
    },
    {
      "id": 417326,
      "primary_message": "Cut pizzas into wedges.",
      "secondary_message": null
    },
    {
      "id": 417327,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
