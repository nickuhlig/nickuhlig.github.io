  "instructions": [
    {
      "id": 1,
      "primary_message": "Pour the olive oil into a pot. Turn the heat to medium-high and add the cubed bread. Cook for 5 minutes, stirring often, until the bread is lightly browned. Toss in the garlic, pimentón, and a pinch of salt. Stir well, and cook for 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour in the stock, bring to a boil, then reduce heat to a simmer. Cook for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Poach the eggs. Follow this guide.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Ladle some soup into a bowl and top with a poached egg.",
      "secondary_message": null
    }
  ],
