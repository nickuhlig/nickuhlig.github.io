  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, quarter, and core pears; slice lengthwise into ½-inch thick wedges. Transfer to a small baking dish. ",
      "secondary_message": "2 pears"
    },
    {
      "primary_message": "Peel, halve, and large dice onion. Add to the baking dish with the pears, drizzle with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n2 tsp extra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until pears are soft, 15-20 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, medium dice bacon. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "primary_message": "Once the skillet is hot, add bacon and walnuts. Cook, stirring occasionally, until bacon starts to crisp, 3-4 minutes. ",
      "secondary_message": "⅛ cup walnuts"
    },
    {
      "primary_message": "Meanwhile, place tahini, Dijon, vinegar, water, sugar, and spices in a medium bowl. Whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tbsp tahini\n1 tbsp Dijon mustard\n1 tbsp apple cider vinegar\nbrown sugar\nsalt\nblack pepper\n⅛ tsp crushed red pepper"
    },
    {
      "primary_message": "When the bacon starts to crisp, add additional sugar to the skillet. Continue to cook, stirring often, until bacon and walnuts are candied, 2-3 minutes more. Using a slotted spoon, remove bacon and walnuts to a paper towel-lined plate.",
      "secondary_message": "brown sugar"
    },
    {
      "primary_message": "Wash and dry kale. Using a clean cutting board, fold leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": "1 bunch kale"
    },
    {
      "primary_message": "Add cooled pears and onions to the bowl. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide salad between plates or bowls. Top with candied bacon and walnuts, then crumble goat cheese over top. Enjoy!",
      "secondary_message": "½ (4 oz) log goat cheese"
    }
  ],
