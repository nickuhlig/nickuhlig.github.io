  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, quarter, and core pears; slice lengthwise into ½-inch thick wedges. Transfer to a large baking dish. ",
      "secondary_message": "6 pears"
    },
    {
      "primary_message": "Peel, halve, and large dice onions. Add to the baking dish with the pears, drizzle with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "3 medium red onions\n2 tbsp extra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until pears are soft, 15-20 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, medium dice bacon. ",
      "secondary_message": "12 slices bacon"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add bacon and walnuts. Cook, stirring occasionally, until bacon starts to crisp, 4-5 minutes. ",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "primary_message": "Meanwhile, place tahini, Dijon, vinegar, water, sugar, and spices in a large bowl. Whisk to combine the dressing and set aside. ",
      "secondary_message": "⅓ cup tahini\n3 tbsp Dijon mustard\n3 tbsp apple cider vinegar\nbrown sugar\nsalt\nblack pepper\n½ tsp crushed red pepper"
    },
    {
      "primary_message": "When the bacon starts to crisp, add additional sugar to the skillet. Continue to cook, stirring often, until bacon and walnuts are candied, 3-4 minutes more. Using a slotted spoon, remove bacon and walnuts to a paper towel-lined plate.",
      "secondary_message": "brown sugar"
    },
    {
      "primary_message": "Wash and dry kale. Using a clean cutting board, fold leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, about 2 minutes.",
      "secondary_message": "3 bunches kale"
    },
    {
      "primary_message": "Add cooled pears and onions to the bowl. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide salad between plates or bowls. Top with candied bacon and walnuts, then crumble goat cheese over top. Enjoy!",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    }
  ],
