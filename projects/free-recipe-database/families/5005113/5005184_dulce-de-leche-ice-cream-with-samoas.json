  "instructions": [
    {
      "id": 1,
      "primary_message": "In a heavy medium saucepan, whisk together egg yolks and dulce de leche until well combined. Slowly whisk in cream, a little at a time, until fully incorporated, then whisk in milk.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cook over medium heat, whisking frequently, until a custard forms on the back of a spoon but a swiped finger leaves a clean line. Strain into an airtight container and stir in salt to taste, 1/4 teaspoon at a time.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Chill in refrigerator overnight, or at least 6 hours, then churn in ice cream maker according to manufacturer's instructions. During last minute of churning, add chopped Samoas. Transfer ice cream to airtight container and let firm up in freezer at least 4 hours before serving.",
      "secondary_message": null
    }
  ],
