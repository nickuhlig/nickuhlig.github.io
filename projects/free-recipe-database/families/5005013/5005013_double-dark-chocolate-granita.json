  "instructions": [
    {
      "id": 1,
      "primary_message": "In medium saucepan over medium heat, whisk coffee, sugar, and cocoa until melted and smooth. Whisk in vanilla and chocolate until smooth. Transfer to bowl and chill until cold, about 2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer mixture to plastic container and freeze, briefly stirring with fork once every hour, for about 5 hours. Continue to freeze until completely frozen, about 3 more hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Break up granita with fork before serving.",
      "secondary_message": null
    }
