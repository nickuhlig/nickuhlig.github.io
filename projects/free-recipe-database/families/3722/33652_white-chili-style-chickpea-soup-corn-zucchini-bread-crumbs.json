  "instructions": [
    {
      "id": 532437,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n2 sticks celery\n2 medium zucchini squash\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 532438,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and place in a medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 532439,
      "primary_message": "Trim and small dice celery. Add to the bowl with the jalapeño. ",
      "secondary_message": null
    },
    {
      "id": 532440,
      "primary_message": "Trim and medium dice zucchini. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 532441,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 532442,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the other veggies. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 532443,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp chili powder\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 532444,
      "primary_message": "Add flour to the pan with the veggies. Cook, stirring frequently, for 1 minute. ",
      "secondary_message": "1 tbsp all-purpose flour"
    },
    {
      "id": 532445,
      "primary_message": "Add beans with their liquid (do not drain) and broth to the pan; stir to combine and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender and soup thickens slightly, 10-12 minutes.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 532446,
      "primary_message": "Meanwhile, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 532447,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 532448,
      "primary_message": "Once the skillet is hot, add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Transfer toasted bread crumbs to the bowl with the cilantro, along with salt, and stir to combine. Set aside.",
      "secondary_message": "¼ cup panko bread crumbs\n1 pinch salt"
    },
    {
      "id": 532449,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice.",
      "secondary_message": null
    },
    {
      "id": 532450,
      "primary_message": "When the soup has thickened, add cream and corn to the pan, then stir to combine. Remove from heat. ",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream\n⅔ cup frozen corn"
    },
    {
      "id": 532451,
      "primary_message": "To serve, divide soup between bowls; top with bread crumbs and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
