  "instructions": [
    {
      "id": 532557,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 jalapeño peppers\n6 sticks celery\n6 medium zucchini squash\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 532558,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and place in a large bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 532559,
      "primary_message": "Trim and small dice celery. Add to the bowl with the jalapeño. ",
      "secondary_message": null
    },
    {
      "id": 532560,
      "primary_message": "Trim and medium dice zucchini. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 532561,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 532562,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 532563,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp chili powder\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 532564,
      "primary_message": "Add flour to the pot with the veggies. Cook, stirring frequently, for 1 minute. ",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 532565,
      "primary_message": "Add beans with their liquid (do not drain) and broth to the pot; stir to combine and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender and soup thickens slightly, 10-12 minutes.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n710 ml chicken or vegetable broth"
    },
    {
      "id": 532566,
      "primary_message": "Meanwhile, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 532567,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 532568,
      "primary_message": "Once the skillet is hot, add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Transfer toasted bread crumbs to the bowl with the cilantro, along with salt, and stir to combine. Set aside.",
      "secondary_message": "¾ cup panko bread crumbs\n3 pinch salt"
    },
    {
      "id": 532569,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice.",
      "secondary_message": null
    },
    {
      "id": 532570,
      "primary_message": "When the soup has thickened, add cream and corn to the pot, then stir to combine. Remove from heat. ",
      "secondary_message": "355 ml heavy whipping cream\n2 cups frozen corn"
    },
    {
      "id": 532571,
      "primary_message": "To serve, divide soup between bowls; top with bread crumbs and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
