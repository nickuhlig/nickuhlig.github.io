  "instructions": [
    {
      "id": 532542,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 jalapeño peppers\n4 sticks celery\n4 medium zucchini squash\n1 small bunch cilantro\n1 avocado"
    },
    {
      "id": 532543,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and place in a medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 532544,
      "primary_message": "Trim and small dice celery. Add to the bowl with the jalapeño. ",
      "secondary_message": null
    },
    {
      "id": 532545,
      "primary_message": "Trim and medium dice zucchini. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 532546,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 532547,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the other veggies. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 532548,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp chili powder\n2 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 532549,
      "primary_message": "Add flour to the pot with the veggies. Cook, stirring frequently, for 1 minute. ",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 532550,
      "primary_message": "Add beans with their liquid (do not drain) and broth to the pot; stir to combine and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender and soup thickens slightly, 10-12 minutes.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n473 ml chicken or vegetable broth"
    },
    {
      "id": 532551,
      "primary_message": "Meanwhile, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 532552,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 532553,
      "primary_message": "Once the skillet is hot, add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Transfer toasted bread crumbs to the bowl with the cilantro, along with salt, and stir to combine. Set aside.",
      "secondary_message": "½ cup panko bread crumbs\n⅛ tsp salt"
    },
    {
      "id": 532554,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice.",
      "secondary_message": null
    },
    {
      "id": 532555,
      "primary_message": "When the soup has thickened, add cream and corn to the pot, then stir to combine. Remove from heat. ",
      "secondary_message": "237 ml heavy whipping cream\n1 ⅓ cups frozen corn"
    },
    {
      "id": 532556,
      "primary_message": "To serve, divide soup between bowls; top with bread crumbs and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
