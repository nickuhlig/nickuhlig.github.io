  "instructions": [
    {
      "id": 48248,
      "primary_message": "Preheat the oven to 400°F and place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 48249,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n1 tomato"
    },
    {
      "id": 48250,
      "primary_message": "Halve the eggplant lengthwise and place cut-side-up on a baking sheet. Rub with olive oil and season with salt and pepper.",
      "secondary_message": "½ tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 48251,
      "primary_message": "Place the eggplant in the oven and roast until softened, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 48252,
      "primary_message": "Slice the tomato into rounds and place on a plate lined with paper towels.",
      "secondary_message": null
    },
    {
      "id": 48253,
      "primary_message": "Drain the mozzarella and pat dry with paper towels; slice into rounds.",
      "secondary_message": "½ (8oz) pkg fresh mozzarella"
    },
    {
      "id": 48254,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 48255,
      "primary_message": "Drain and rinse the chickpeas; transfer to paper towels or a clean towel and pat dry.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 48256,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 48257,
      "primary_message": "Add the chickpeas to the skillet and shake to distribute. Cook the chickpeas, shaking occasionally, until they are golden brown and crispy, 5 to 7 minutes.",
      "secondary_message": ""
    },
    {
      "id": 48258,
      "primary_message": "In a medium bowl, combine and mix together paprika, cumin, and salt.",
      "secondary_message": "1 tsp paprika\n¼ tsp cumin\n¼ tsp salt"
    },
    {
      "id": 48259,
      "primary_message": "Using a slotted spoon, transfer the chickpeas to a paper towel lined plate.",
      "secondary_message": null
    },
    {
      "id": 48260,
      "primary_message": "Remove the baking sheet from the oven. Top the eggplant halves with tomato and fresh mozzarella slices.",
      "secondary_message": null
    },
    {
      "id": 48261,
      "primary_message": "Return the eggplant to the oven and bake until the cheese has melted, another 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 48263,
      "primary_message": "Add the chickpeas to the bowl with the spices and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 48262,
      "primary_message": "To serve, divide the eggplant melts and chickpeas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
