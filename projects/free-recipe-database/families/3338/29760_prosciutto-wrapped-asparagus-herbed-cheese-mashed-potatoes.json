  "instructions": [
    {
      "id": 483804,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 483805,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium yellow potatoes\n3 small bunches asparagus\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg chives"
    },
    {
      "id": 483806,
      "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 483807,
      "primary_message": "While the potatoes are cooking, snap (or cut) off woody ends of the asparagus. Divide between two baking sheet pans, drizzle with oil, and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 483808,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until asparagus is just tender, 7-8 minutes, depending on the thickness of the spears. Remove baking sheets from oven and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 483809,
      "primary_message": "Meanwhile, using a box grater, coarsely grate cream cheese into a medium bowl.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 483810,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the cream cheese.",
      "secondary_message": null
    },
    {
      "id": 483811,
      "primary_message": "Chop chives into small pieces. Add to the bowl along with salt and pepper, then stir to combine.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 483812,
      "primary_message": "Lay prosciutto on a flat surface and spread each slice evenly with the cream cheese mixture.",
      "secondary_message": "18 slices prosciutto"
    },
    {
      "id": 483813,
      "primary_message": "When the asparagus is cool enough to handle, divide into 18 equal piles. Wrap each pile with a slice of the prepared prosciutto, gently pressing the cream cheese-side around the asparagus to secure. Arrange, seam-side down, on the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 483814,
      "primary_message": "Return baking sheets to the oven and continue to roast until prosciutto is golden and asparagus is fork-tender, 5-7 minutes. Remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 483815,
      "primary_message": "When the potatoes are done, drain in a colander and return to the pot. Add oil, salt, and pepper, then using a potato masher, mash until smooth.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 483816,
      "primary_message": "To serve, divide mashed potatoes and prosciutto-wrapped asparagus between plates. Enjoy!",
      "secondary_message": null
    }
  ],
