  "instructions": [
    {
      "id": 483778,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 483779,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n1 small bunch asparagus\n½ small bunch Italian (flat-leaf) parsley\n½ small pkg chives"
    },
    {
      "id": 483780,
      "primary_message": "Peel and medium dice potatoes; place in a medium saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 483781,
      "primary_message": "While the potatoes are cooking, snap (or cut) off woody ends of the asparagus. Transfer to a baking sheet pan, drizzle with oil, and spread out in an even layer.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 483782,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until asparagus is just tender, 5-7 minutes, depending on the thickness of the spears. Remove baking sheet from oven and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 483783,
      "primary_message": "Meanwhile, using a box grater, coarsely grate cream cheese into a small bowl.",
      "secondary_message": "½ (227 g) block cream cheese"
    },
    {
      "id": 483784,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the cream cheese.",
      "secondary_message": null
    },
    {
      "id": 483785,
      "primary_message": "Chop chives into small pieces. Add to the bowl along with salt and pepper, then stir to combine.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 483786,
      "primary_message": "Lay prosciutto on a flat surface and spread each slice evenly with the cream cheese mixture.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 483787,
      "primary_message": "When the asparagus is cool enough to handle, divide into 6 equal piles. Wrap each pile with a slice of the prepared prosciutto, gently pressing the cream cheese-side around the asparagus to secure. Arrange, seam-side down, on the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 483788,
      "primary_message": "Return baking sheet to the oven and continue to roast until prosciutto is golden and asparagus is fork-tender, about 5 minutes. Remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 483789,
      "primary_message": "When the potatoes are done, drain in a colander and return to the pan. Add oil, salt, and pepper, then using a potato masher, mash until smooth.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 483790,
      "primary_message": "To serve, divide mashed potatoes and prosciutto-wrapped asparagus between plates. Enjoy!",
      "secondary_message": null
    }
  ],
