  "instructions": [
    {
      "primary_message": "Place half of the cranberry sauce, broth, honey, and spices in a 6-quart slow cooker insert. Whisk to combine the sauce. (Transfer remaining cranberry sauce to a sealed container and refrigerate for later use.)\n\n",
      "secondary_message": "1 (397 g) can cranberry sauce, whole berry\n½ cup chicken or vegetable broth\n1 ½ tbsp honey\n1 tsp ground mustard\n⅛ tsp nutmeg, ground\n1 pinch allspice, ground"
    },
    {
      "primary_message": "Pat pork dry with paper towels, then season with salt and pepper. Add to the insert, nestling the pork into the sauce. \n\n",
      "secondary_message": "907 g pork tenderloin\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Cover the slow cooker and cook, turning halfway, until pork is cooked through, 2-3 hours on low or about 1 1/2 hours on high.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the pork is done, transfer to a plate. Loosely cover with aluminum foil and let rest, 10 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place water and cornstarch in a small bowl, then whisk to combine the slurry. Add slurry to the slow cooker with the sauce, along with reserved cranberry sauce, and stir to combine. Set slow cooker to high and cook, stirring occasionally, until gravy is thickened, about 10 minutes.\n\n",
      "secondary_message": "1 tbsp cornstarch"
    },
    {
      "primary_message": "Cut pork into thin slices and transfer to a platter. Serve with cranberry gravy and enjoy!",
      "secondary_message": null
    }
  ],
