  "instructions": [
    {
      "id": 106668,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 sticks celery\n3 medium zucchini squash\n3 red bell peppers"
    },
    {
      "id": 106669,
      "primary_message": "In a large bowl, combine and mix together the spices.",
      "secondary_message": "1 ½ tsp paprika\n¾ tsp garlic powder\n¾ tsp salt\n⅜ tsp onion powder\n⅜ tsp oregano\n⅜ tsp cayenne pepper\n⅜ tsp thyme\n⅜ tsp black pepper"
    },
    {
      "id": 106670,
      "primary_message": "Small dice the celery. Peel and mince the shallots.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 106671,
      "primary_message": "Preheat a large pot over medium-high heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 106672,
      "primary_message": "Add the shallots and celery to the pot and cook, stirring occasionally, for 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 106673,
      "primary_message": "Add the tomato paste and half of the spice mixture to the pot. Cook, stirring continuously, 1 minute.",
      "secondary_message": "3 tbsp tomato paste"
    },
    {
      "id": 106674,
      "primary_message": "Add the rice and broth to the pot and bring to a boil. Once the liquid comes to a boil, stir the mixture, cover the pot, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": "1 ½ cups basmati rice\n1065 ml chicken or vegetable broth"
    },
    {
      "id": 106675,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 106676,
      "primary_message": "Add the shrimp and oil to the large bowl with the rest of the spice mixture. Stir to combine and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 106677,
      "primary_message": "Halve zucchinis lengthwise, then slice crosswise into half moons. Medium dice the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 106678,
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 106679,
      "primary_message": "Add the zucchini, bell pepper, and frozen corn to the skillet and cook, stirring frequently, until softened, 5-7 minutes. Cook in batches if necessary.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 106680,
      "primary_message": "Add the shrimp to the skillet; cook until opaque, 2-3 minutes per side. Once done, remove skillet from heat.",
      "secondary_message": null
    },
    {
      "id": 106681,
      "primary_message": "To serve, divide the rice between bowls and top with the shrimp and vegetables. Enjoy!",
      "secondary_message": null
    }
  ],
