  "instructions": [
    {
      "id": 106640,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n1 medium zucchini squash\n1 red bell pepper"
    },
    {
      "id": 106641,
      "primary_message": "In a medium bowl, combine and mix together the spices.",
      "secondary_message": "½ tsp paprika\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp onion powder\n⅛ tsp oregano\n⅛ tsp cayenne pepper\n⅛ tsp thyme\n⅛ tsp black pepper"
    },
    {
      "id": 106642,
      "primary_message": "Small dice the celery. Peel and mince the shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 106643,
      "primary_message": "Preheat a medium saucepan over medium-high heat. Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 106644,
      "primary_message": "Add the shallot and celery to the saucepan and cook, stirring occasionally, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 106645,
      "primary_message": "Add the tomato paste and half of the spice mixture to the saucepan. Cook, stirring continuously, for 1 minute.",
      "secondary_message": "1 tbsp tomato paste"
    },
    {
      "id": 106646,
      "primary_message": "Add the rice and broth to the saucepan and bring to a boil. Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": "½ cup basmati rice\n355 ml chicken or vegetable broth"
    },
    {
      "id": 106647,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 106648,
      "primary_message": "Add the shrimp and oil to the medium bowl with the rest of the spice mixture. Stir to combine and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 106649,
      "primary_message": "Halve zucchini lengthwise, then slice crosswise into half moons. Medium dice the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 106650,
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 106651,
      "primary_message": "Add the zucchini, bell pepper, and frozen corn to the skillet and cook, stirring frequently, until softened, 4-5 minutes.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 106652,
      "primary_message": "Add the shrimp to the skillet; cook until opaque, 1-2 minutes per side. Once done, remove skillet from heat.",
      "secondary_message": null
    },
    {
      "id": 106653,
      "primary_message": "To serve, divide the rice between bowls and top with the shrimp and vegetables. Enjoy!",
      "secondary_message": null
    }
  ],
