  "instructions": [
    {
      "id": 106612,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n2 medium zucchini squash\n2 red bell peppers"
    },
    {
      "id": 106613,
      "primary_message": "In a medium bowl, combine and mix together the spices.",
      "secondary_message": "1 tsp paprika\n½ tsp garlic powder\n½ tsp salt\n¼ tsp onion powder\n¼ tsp oregano\n¼ tsp cayenne pepper\n¼ tsp thyme\n¼ tsp black pepper"
    },
    {
      "id": 106614,
      "primary_message": "Small dice the celery. Peel and mince the shallots.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 106615,
      "primary_message": "Preheat a medium saucepan over medium-high heat. Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 106616,
      "primary_message": "Add the shallots and celery to the saucepan and cook, stirring occasionally, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 106617,
      "primary_message": "Add the tomato paste and half of the spice mixture to the saucepan. Cook, stirring continuously, 1 minute.",
      "secondary_message": "2 tbsp tomato paste"
    },
    {
      "id": 106618,
      "primary_message": "Add the rice and broth to the saucepan and bring to a boil. Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": "1 cup basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 106619,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 106620,
      "primary_message": "Add the shrimp and oil to the medium bowl with the rest of the spice mixture. Stir to combine and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 106621,
      "primary_message": "Halve zucchinis lengthwise, then slice crosswise into half moons. Medium dice the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 106622,
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 106623,
      "primary_message": "Add the zucchini, bell pepper, and frozen corn to the skillet and cook, stirring frequently, until softened, 5-6 minutes.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 106624,
      "primary_message": "Add the shrimp to the skillet; cook until opaque, 1-2 minutes per side. Once done, remove skillet from heat.",
      "secondary_message": null
    },
    {
      "id": 106625,
      "primary_message": "To serve, divide the rice between bowls and top with the shrimp and vegetables. Enjoy!",
      "secondary_message": null
    }
  ],
