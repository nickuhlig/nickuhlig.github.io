  "instructions": [
    {
      "id": 283102,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 283103,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ lb green beans\n1 ½ pints grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 283104,
      "primary_message": "Zest lemons into a small bowl (reserve lemons for later use).",
      "secondary_message": null
    },
    {
      "id": 283105,
      "primary_message": "Add goat cheese and butter to the bowl with the lemon zest; set aside to soften.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese\n⅓ cup butter, unsalted"
    },
    {
      "id": 283106,
      "primary_message": "Trim green beans; divide between two baking sheet pans along with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 283107,
      "primary_message": "Peel, halve, and thinly slice onions crosswise into half-moons; add to the baking sheets with the other veggies.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 283108,
      "primary_message": "Juice lemons over the veggies and season with spices; toss to combine and spread out in an even layer. ",
      "secondary_message": "1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 283109,
      "primary_message": "Cut additional butter into small pieces and sprinkle over the veggies; place baking sheets in the oven and roast, tossing once, until veggies are fork-tender, 15-20 minutes.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 283110,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 283111,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, bone-in\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 283112,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 283113,
      "primary_message": "While the chops are cooking, pick basil leaves off the stems, roll up crosswise, and mince; add to the bowl with the softened butter and goat cheese. Use the back of a spoon to mash and combine the basil-goat cheese butter.",
      "secondary_message": null
    },
    {
      "id": 283114,
      "primary_message": "To serve, divide pork chops and roasted veggies between plates; top chops with basil-goat cheese butter. Enjoy!",
      "secondary_message": null
    }
  ],
