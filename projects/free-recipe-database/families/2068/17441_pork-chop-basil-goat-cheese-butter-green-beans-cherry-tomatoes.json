  "instructions": [
    {
      "id": 283154,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 283155,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n0.23 kg green beans\n½ small pkg grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 283156,
      "primary_message": "Zest lemon into a small bowl (reserve lemon for later use).",
      "secondary_message": null
    },
    {
      "id": 283157,
      "primary_message": "Add goat cheese and butter to the bowl with the lemon zest; set aside to soften.",
      "secondary_message": "½ (113 g) log goat cheese\n2 tbsp butter, unsalted"
    },
    {
      "id": 283158,
      "primary_message": "Trim green beans; transfer to a baking sheet pan along with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 283159,
      "primary_message": "Peel, halve, and thinly slice onion crosswise into half-moons; add to the baking sheet with the other veggies.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 283160,
      "primary_message": "Juice lemon over the veggies and season with spices; toss to combine and spread out in an even layer. ",
      "secondary_message": "½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 283161,
      "primary_message": "Cut additional butter into small pieces and sprinkle over the veggies; place baking sheet in the oven and roast, tossing once, until veggies are fork-tender, about 15 minutes.",
      "secondary_message": "1 ½ tsp butter, unsalted"
    },
    {
      "id": 283162,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 283163,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 283164,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 283165,
      "primary_message": "While the chops are cooking, pick basil leaves off the stems, roll up crosswise, and mince; add to the bowl with the softened butter and goat cheese. Use the back of a spoon to mash and combine the basil-goat cheese butter.",
      "secondary_message": null
    },
    {
      "id": 283166,
      "primary_message": "To serve, divide pork chops and roasted veggies between plates; top chops with basil-goat cheese butter. Enjoy!",
      "secondary_message": null
    }
  ],
