  "instructions": [
    {
      "id": 546483,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 546484,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 546485,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lb cremini mushrooms\n1 (1 inch) piece ginger root\n1 small bunch green onions (scallions)\n½ small butternut squash"
    },
    {
      "id": 546486,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 546487,
      "primary_message": "While the rice is cooking, quarter mushrooms and place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 546488,
      "primary_message": "Peel and mince ginger. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 546489,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl. (Reserve a small handful of green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 546490,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 546491,
      "primary_message": "While skillet heats up, medium dice tofu. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 546492,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, ginger, green onion, and spices; cook, stirring occasionally until tender, 6-8 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 ½ tbsp neutral vegetable oil\n1 tbsp curry powder\n1 tsp garam masala\n¼ tsp salt"
    },
    {
      "id": 546493,
      "primary_message": "Meanwhile, trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice. Add to the bowl with the tofu.",
      "secondary_message": null
    },
    {
      "id": 546494,
      "primary_message": "Once the mushrooms are tender, add tofu, squash, broth, soy sauce, honey, and vinegar to the skillet; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and continue to cook, until squash is tender, about 15 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp soy sauce\n1 tbsp honey\n1 tsp rice vinegar"
    },
    {
      "id": 546495,
      "primary_message": "Meanwhile, place water and cornstarch in the reserved bowl. Whisk until slurry is smooth.",
      "secondary_message": "¼ cup water\n2 tsp cornstarch"
    },
    {
      "id": 546496,
      "primary_message": "When the squash is tender, add slurry to the skillet. Continue to cook, stirring frequently, until the sauce is thickened, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 546497,
      "primary_message": "To serve, divide rice and curry between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
