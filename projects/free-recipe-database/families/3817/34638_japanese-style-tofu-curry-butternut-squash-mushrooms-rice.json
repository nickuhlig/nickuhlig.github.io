  "instructions": [
    {
      "id": 546558,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 546559,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 546560,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb cremini mushrooms\n3 (1 inch) pieces ginger root\n3 small bunches green onions (scallions)\n1 ½ small butternut squash"
    },
    {
      "id": 546561,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 546562,
      "primary_message": "While the rice is cooking, quarter mushrooms and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 546563,
      "primary_message": "Peel and mince ginger. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 546564,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl. (Reserve a small handful of green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 546565,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 546566,
      "primary_message": "While pot heats up, medium dice tofu. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 546567,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, ginger, green onion, and spices; cook, stirring occasionally until tender, 8-10 minutes. (Reserve bowl for later use.)",
      "secondary_message": "¼ cup neutral vegetable oil\n3 tbsp curry powder\n1 tbsp garam masala\n¾ tsp salt"
    },
    {
      "id": 546568,
      "primary_message": "Meanwhile, trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice. Add to the bowl with the tofu.",
      "secondary_message": null
    },
    {
      "id": 546569,
      "primary_message": "Once the mushrooms are tender, add tofu, squash, broth, soy sauce, maple syrup, and vinegar to the pot; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and continue to cook, until squash is tender, about 20 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n⅓ cup soy sauce\n3 tbsp pure maple syrup\n1 tbsp rice vinegar"
    },
    {
      "id": 546570,
      "primary_message": "Meanwhile, place water and cornstarch in the reserved bowl. Whisk until slurry is smooth.",
      "secondary_message": "¾ cup water\n2 tbsp cornstarch"
    },
    {
      "id": 546571,
      "primary_message": "When the squash is tender, add slurry to the pot. Continue to cook, stirring frequently, until the sauce is thickened, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 546572,
      "primary_message": "To serve, divide rice and curry between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
