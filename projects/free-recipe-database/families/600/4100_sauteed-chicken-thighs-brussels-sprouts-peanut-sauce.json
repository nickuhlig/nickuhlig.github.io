  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb Brussels sprouts\n½ lime"
    },
    {
      "primary_message": "Remove the outer layer of leaves from the Brussels sprouts, then trim off and discard the stem ends; quarter the sprouts lengthwise and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "primary_message": "Carefully place the chicken thighs in the skillet; sear on both sides until golden brown, 2 to 3 minutes per side. Then, reduce the heat to medium and continue to cook until they are cooked through, 3 to 5 minutes total. Once done, transfer to a plate and cover with foil to keep warm.",
      "secondary_message": null
    },
    {
      "primary_message": "While the chicken cooks, trim off and discard the ends of the shallot; peel and mince the shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "primary_message": "Once the chicken has been transferred, add the shallot to the skillet and cook, stirring frequently, until softened, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Add the Brussels sprouts to the skillet; cook, stirring frequently, until lightly browned and tender, 4 to 6 minutes. Once done, remove from the heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the sprouts cook, juice the lime and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add to the lime juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "primary_message": "To the lime juice and garlic, add peanut butter, water, soy sauce, honey, and crushed red pepper; whisk together.",
      "secondary_message": "2 tbsp natural peanut butter\n1 tbsp tamari soy sauce\n1 tsp honey\n⅛ tsp crushed red pepper"
    },
    {
      "primary_message": "To serve, divide the chicken thighs and Brussels sprouts between dishes; drizzle with the peanut sauce or serve the sauce on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
