  "instructions": [
    {
      "id": 334324,
      "primary_message": "Cut tofu into ½-inch thick slices along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 334325,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 334326,
      "primary_message": "Wash, dry, and separate cauliflower into bite-sized florets; cut stems into smaller pieces and transfer to a large baking sheet. Drizzle with oil, then season with curry powder and salt; toss to combine and spread out in an even layer.",
      "secondary_message": "1 medium head cauliflower\n4 tsp extra virgin olive oil\n2 tsp curry powder\n½ tsp salt"
    },
    {
      "id": 334327,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until cauliflower is fork-tender, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 334328,
      "primary_message": "Meanwhile, place bread crumbs and spices in a small bowl; stir to combine.",
      "secondary_message": "½ cup panko bread crumbs\n1 tsp turmeric, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 334329,
      "primary_message": "Place tofu on the baking sheet. Spread half of the mayo over top side of the tofu, sprinkle with half of the bread crumb mixture, then drizzle with half of the oil. Carefully flip tofu and repeat with remaining mayo, bread crumbs, and oil.",
      "secondary_message": "¼ cup vegan mayonnaise\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 334330,
      "primary_message": "Add baking sheet to the oven and bake until tofu is golden and warmed through, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 334331,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n½ tsp salt\n⅛ tsp cayenne pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 334332,
      "primary_message": "Wash, dry, quarter, and core apples; cut into matchsticks or coarsely grate. Add to the bowl with the dressing, along with raisins, and toss to combine the salad.",
      "secondary_message": "2 Granny Smith apples\n½ cup raisins"
    },
    {
      "id": 334333,
      "primary_message": "To serve, divide tofu, cauliflower, and apple salad between plates; enjoy!",
      "secondary_message": null
    }
  ],
