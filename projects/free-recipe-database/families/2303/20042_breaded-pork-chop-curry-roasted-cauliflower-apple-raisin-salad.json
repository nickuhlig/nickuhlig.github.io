  "instructions": [
    {
      "id": 334164,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 334165,
      "primary_message": "Wash, dry, and separate cauliflower into bite-sized florets; cut stems into smaller pieces and transfer to a baking sheet pan. Drizzle with oil, then season with curry powder and salt; toss to combine and spread out in an even layer.",
      "secondary_message": "½ medium head cauliflower\n2 tsp extra virgin olive oil\n1 tsp curry powder\n¼ tsp salt"
    },
    {
      "id": 334166,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until cauliflower is fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 334167,
      "primary_message": "Meanwhile, place bread crumbs and spices in a small bowl; stir to combine.",
      "secondary_message": "¼ cup panko bread crumbs\n½ tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 334168,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334169,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels, place on a plate, and spread both sides with mayo. Sprinkle bread crumb mixture over both sides and press to adhere.",
      "secondary_message": "2 pork chops, boneless\n1 tbsp mayonnaise"
    },
    {
      "id": 334170,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 334171,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tsp extra virgin olive oil\n1 tsp apple cider vinegar\n¼ tsp salt\n1 pinch cayenne pepper\n1 pinch cinnamon, ground"
    },
    {
      "id": 334172,
      "primary_message": "Wash, dry, quarter, and core apple; cut into matchsticks or coarsely grate. Add to the bowl with the dressing, along with raisins, and toss to combine the salad.",
      "secondary_message": "1 Granny Smith apple\n¼ cup raisins"
    },
    {
      "id": 334173,
      "primary_message": "To serve, divide chops, cauliflower, and apple salad between plates; enjoy!",
      "secondary_message": null
    }
  ],
