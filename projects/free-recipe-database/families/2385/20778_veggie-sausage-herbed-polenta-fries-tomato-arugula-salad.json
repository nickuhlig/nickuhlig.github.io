  "instructions": [
    {
      "id": 361519,
      "primary_message": "Preheat oven to 475°F.",
      "secondary_message": null
    },
    {
      "id": 361520,
      "primary_message": "Halve each tube of polenta crosswise, then cut each half lengthwise into ½-inch thick \"fries.\" Divide between two large baking sheet pans, spreading the fries out in a single layer.",
      "secondary_message": "3 (18 oz) tubes polenta, pre-cooked"
    },
    {
      "id": 361521,
      "primary_message": "Drizzle fries with oil and season with spices; carefully toss to coat, then arrange on the baking sheets so that none of the fries are touching. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 361522,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, flipping fries halfway through, until golden brown and slightly crisp on the outside, 35-40 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 361523,
      "primary_message": "When the fries have about 15 minutes left of cooking, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 361524,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 361525,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ pints grape tomatoes\n1 ½ yellow bell peppers\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 361526,
      "primary_message": "Halve tomatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 361527,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 361528,
      "primary_message": "Add arugula to the bowl, along with the dressing, and toss to combine the salad; set aside.",
      "secondary_message": "⅓ cup Italian salad dressing"
    },
    {
      "id": 361529,
      "primary_message": "Slice sausages crosswise into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 361530,
      "primary_message": "To serve, divide sausage, polenta fries, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
