  "instructions": [
    {
      "id": 173172,
      "primary_message": "Wash and dry the arugula. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 173173,
      "primary_message": "Wash, dry, and zest the lemons into a small bowl, then juice the lemon into a medium bowl.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 173174,
      "primary_message": "Add mayonnaise, garlic powder, and paprika to the medium bowl with the lemon zest; stir to make the aioli.",
      "secondary_message": "⅓ cup mayonnaise\n¾ tsp garlic powder\n⅜ tsp paprika"
    },
    {
      "id": 173175,
      "primary_message": "Add oil, maple syrup, Dijon, salt, and pepper to the large bowl with the lemon juice; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n1 tbsp Dijon mustard\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 173176,
      "primary_message": "Crack the eggs into a medium bowl and season with salt and pepper; whisk together.",
      "secondary_message": "9 eggs\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 173177,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 173178,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 173179,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 173180,
      "primary_message": "Add the arugula to the bowl with the dressing and toss to thoroughly coat.",
      "secondary_message": null
    },
    {
      "id": 173181,
      "primary_message": "Place tortillas on a flat surface and top with scrambled eggs and arugula salad. Tightly roll to close and serve with aioli. Enjoy! ",
      "secondary_message": "6 large flour tortillas"
    }
  ],
