  "instructions": [
    {
      "primary_message": "Medium dice cream cheese and place in a medium bowl. Set aside to soften.",
      "secondary_message": "1 (227 g) block cream cheese"
    },
    {
      "primary_message": "Meanwhile, line a baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place cookies in a resealable bag and crush with a rolling pin (or heavy saucepan) until they are broken into a fine crumb. (Alternatively, you can use a food processor.)",
      "secondary_message": "36 vanilla creme chocolate sandwich cookies"
    },
    {
      "primary_message": "Add cookie crumbs to the bowl with the softened cream cheese along with cinnamon and cayenne. Using a spoon (or your hands), mix until the dough comes together and is evenly combined. Set aside.",
      "secondary_message": "½ tsp cinnamon, ground\n½ tsp cayenne pepper"
    },
    {
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "primary_message": "Uncover the pan and place a medium, heat-proof, bowl over the simmering water, allowing it to sit on the rim. Add chocolate to the bowl; using a silicone spatula, stir continuously, until melted. Remove bowl from the heat.",
      "secondary_message": "1 ½ cups dark chocolate chips"
    },
    {
      "primary_message": "While the chocolate is melting, use a heaping tablespoon measure to scoop out and portion the dough. Use your hands to roll the dough into balls and place on the prepared baking sheet.",
      "secondary_message": null
    },
    {
      "primary_message": "Using a fork, dip the cookie balls, one at a time, in the chocolate. Turn to coat and return to the baking sheet. Top with desired amount of marshmallows, pressing gently to adhere.",
      "secondary_message": "½ cup mini marshmallows"
    },
    {
      "primary_message": "Place baking sheet in the refrigerator and chill until chocolate is firm, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange cookie balls on a platter. Enjoy!",
      "secondary_message": null
    }
  ],
