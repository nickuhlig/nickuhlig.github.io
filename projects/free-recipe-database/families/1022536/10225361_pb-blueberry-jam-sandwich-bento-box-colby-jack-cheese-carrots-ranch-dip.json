  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Place carrots in the medium compartment of the bento box.",
      "secondary_message": "1 cup baby carrots"
    },
    {
      "primary_message": "Place cheese and ranch dip each in their own small compartments of the bento box.",
      "secondary_message": "43 g colby jack cheese, cubed\n3 tbsp ranch dip"
    },
    {
      "primary_message": "Spread peanut butter and jam over one slice of bread. Close with the second slice of bread, then cut in half. Place sandwich in the large compartment of the bento box.",
      "secondary_message": "2 slice white bread\n3 tbsp natural peanut butter\n3 tbsp blueberry jam"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
