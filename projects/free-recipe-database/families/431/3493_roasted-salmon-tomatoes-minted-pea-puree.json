  "instructions": [
    {
      "id": 36996,
      "primary_message": "Preheat the oven to 425°F (218°C).",
      "secondary_message": ""
    },
    {
      "id": 36997,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n1 small pkg fresh mint"
    },
    {
      "id": 36998,
      "primary_message": "Cut each of the tomatoes into 8 wedges; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 36999,
      "primary_message": "Drizzle the tomatoes with olive oil and season with salt and pepper; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 37000,
      "primary_message": "Pat the salmon dry with paper towels and place, skin-side down, on a baking sheet (that is also big enough to hold the tomatoes).",
      "secondary_message": "0.68 kg salmon fillet"
    },
    {
      "id": 37001,
      "primary_message": "Rub the salmon with olive oil and season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 37002,
      "primary_message": "Transfer the tomatoes to the baking sheet and arrange in a single layer around the salmon.",
      "secondary_message": null
    },
    {
      "id": 37003,
      "primary_message": "Place the sheet in the oven; cook until the salmon is cooked through, 10 to 12 minutes, and the tomatoes are tender, 12 to 15 minutes. Remove the salmon from the oven once it is done and continue to cook the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 37004,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 37005,
      "primary_message": "Peel and mince (or press) the garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 37006,
      "primary_message": "Once the saucepan is heated, add butter and the garlic. Cook until the butter has melted and the garlic is fragrant, 15 to 30 seconds.",
      "secondary_message": "4 tbsp butter, unsalted"
    },
    {
      "id": 37007,
      "primary_message": "Add the peas to the saucepan and mix with the butter; cook until the peas are warmed through but still bright green, 4 to 6 minutes. Once done, remove the saucepan from the heat.",
      "secondary_message": "4 cups frozen peas"
    },
    {
      "id": 37008,
      "primary_message": "While the peas cook, pick the mint leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 37009,
      "primary_message": "Add the minced mint to the peas and season with salt and pepper. Mash the peas with an immersion blender, potato masher, or fork until smooth.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 37010,
      "primary_message": "To serve, place the minted pea purée, salmon, and tomatoes on a plate. Enjoy!",
      "secondary_message": null
    }
  ],
