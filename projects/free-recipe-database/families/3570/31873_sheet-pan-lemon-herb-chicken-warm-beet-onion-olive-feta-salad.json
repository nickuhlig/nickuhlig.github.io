  "instructions": [
    {
      "id": 504078,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 504079,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium beets\n½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ head butter (Boston) lettuce"
    },
    {
      "id": 504080,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice into ¼-inch thick wedges. Transfer to one half of a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer. Set aside.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 504081,
      "primary_message": "Zest and juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 504082,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add parsley to the bowl with the lemon, reserving a small handful for garnish.",
      "secondary_message": null
    },
    {
      "id": 504083,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil and spices, then whisk to combine the dressing. Transfer half to another medium bowl and set aside for the salad.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 504084,
      "primary_message": "Add chicken to the bowl with the remaining dressing and turn to coat. Transfer chicken (and any dressing in the bowl) to the other half of the baking sheet, then spread out in an even layer.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 504085,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring the beets halfway through, until beets are tender and chicken is cooked through, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 504086,
      "primary_message": "Meanwhile, add vinegar and honey to the remaining bowl with the dressing. Whisk to combine.",
      "secondary_message": "1 ½ tsp balsamic vinegar\n1 tsp honey"
    },
    {
      "id": 504087,
      "primary_message": "Peel, trim, and slice onion crosswise into ¼-inch thick rings. Add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 504088,
      "primary_message": "Roughly chop olives and add to the bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 504089,
      "primary_message": "When the chicken and beets are done, remove baking sheet from the oven. Add warm beets to the bowl.",
      "secondary_message": null
    },
    {
      "id": 504090,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 504091,
      "primary_message": "To serve, divide salad and chicken between plates; top with feta and reserved parsley. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
