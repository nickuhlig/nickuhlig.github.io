  "instructions": [
    {
      "id": 504025,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 504026,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium beets\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 504027,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice into ¼-inch thick wedges. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer. Set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 504028,
      "primary_message": "Zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 504029,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add parsley to the bowl with the lemon, reserving a small handful for garnish.",
      "secondary_message": null
    },
    {
      "id": 504030,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil and spices, then whisk to combine the dressing. Transfer half to another large bowl and set aside for the salad.",
      "secondary_message": "3 cloves garlic\n⅓ cup extra virgin olive oil\n1 ½ tsp oregano, dried\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 504031,
      "primary_message": "Add chicken to the bowl with the remaining dressing and turn to coat. Transfer chicken (and any dressing in the bowl) to another large baking sheet, then spread out in an even layer.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 504032,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring the beets halfway through, until beets are tender and chicken is cooked through, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 504033,
      "primary_message": "Meanwhile, add vinegar and honey to the remaining bowl with the dressing. Whisk to combine.",
      "secondary_message": "1 ½ tbsp balsamic vinegar\n1 tbsp honey"
    },
    {
      "id": 504034,
      "primary_message": "Peel, trim, and slice onions crosswise into ¼-inch thick rings. Add to the bowl with the dressing.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 504035,
      "primary_message": "Roughly chop olives and add to the bowl.",
      "secondary_message": "1 ½ cups Kalamata olives, pitted"
    },
    {
      "id": 504036,
      "primary_message": "When the chicken and beets are done, remove baking sheets from the oven. Add warm beets to the bowl.",
      "secondary_message": null
    },
    {
      "id": 504037,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 504038,
      "primary_message": "To serve, divide salad and chicken between plates; top with feta and reserved parsley. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
