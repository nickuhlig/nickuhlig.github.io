  "instructions": [
    {
      "id": 504120,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 504121,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium beets\n½ small bunch Italian (flat-leaf) parsley\n½ lemon\n½ head butter (Boston) lettuce"
    },
    {
      "id": 504122,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice into ¼-inch thick wedges. Transfer to one half of a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer. Set aside.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 504123,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Place parsley in a medium bowl, reserving a small handful for garnish.",
      "secondary_message": null
    },
    {
      "id": 504124,
      "primary_message": "Peel and mince garlic. Add to the bowl with the parsley along with oil and spices, then whisk to combine the dressing. Transfer half to another medium bowl and set aside for the salad.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 504125,
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces. Add to the remaining bowl with the dressing and turn to coat. Transfer tempeh to the other half of the baking sheet and spread out in an even layer.",
      "secondary_message": "1 (227g ) pkg tempeh"
    },
    {
      "id": 504126,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tempeh is golden and beets are tender, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 504127,
      "primary_message": "Meanwhile, zest and juice lemon into the remaining bowl with the dressing. Add vinegar and honey, then whisk to combine.",
      "secondary_message": "1 ½ tsp balsamic vinegar\n1 tsp honey"
    },
    {
      "id": 504128,
      "primary_message": "Peel, trim, and slice onion crosswise into ¼-inch thick rings. Add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 504129,
      "primary_message": "Roughly chop olives. Add to the bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 504130,
      "primary_message": "When the tempeh and beets are done, remove baking sheet from the oven. Add warm beets to the bowl.",
      "secondary_message": null
    },
    {
      "id": 504131,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 504132,
      "primary_message": "To serve, divide salad and tempeh between plates; top with feta and reserved parsley. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
