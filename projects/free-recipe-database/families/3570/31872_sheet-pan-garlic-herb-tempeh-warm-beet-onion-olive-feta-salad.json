  "instructions": [
    {
      "id": 504065,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 504066,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium beets\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 504067,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice into ¼-inch thick wedges. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer. Set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 504068,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Place parsley in a large bowl, reserving a small handful for garnish.",
      "secondary_message": null
    },
    {
      "id": 504069,
      "primary_message": "Peel and mince garlic. Add to the bowl with the parsley along with oil and spices, then whisk to combine the dressing. Transfer half to another large bowl and set aside for the salad.",
      "secondary_message": "3 cloves garlic\n⅓ cup extra virgin olive oil\n1 ½ tsp oregano, dried\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 504070,
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces. Add to the remaining bowl with the dressing and turn to coat. Transfer tempeh to another large baking sheet and spread out in an even layer.",
      "secondary_message": "3 (8 oz) packages tempeh"
    },
    {
      "id": 504071,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tempeh is golden and beets are tender, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 504072,
      "primary_message": "Meanwhile, zest and juice lemons into the remaining bowl with the dressing. Add vinegar and honey, then whisk to combine.",
      "secondary_message": "1 ½ tbsp balsamic vinegar\n1 tbsp honey"
    },
    {
      "id": 504073,
      "primary_message": "Peel, trim, and slice onions crosswise into ¼-inch thick rings. Add to the bowl with the dressing.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 504074,
      "primary_message": "Roughly chop olives. Add to the bowl.",
      "secondary_message": "1 ½ cups Kalamata olives, pitted"
    },
    {
      "id": 504075,
      "primary_message": "When the tempeh and beets are done, remove baking sheets from the oven. Add warm beets to the bowl.",
      "secondary_message": null
    },
    {
      "id": 504076,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 504077,
      "primary_message": "To serve, divide salad and tempeh between plates; top with feta and reserved parsley. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
