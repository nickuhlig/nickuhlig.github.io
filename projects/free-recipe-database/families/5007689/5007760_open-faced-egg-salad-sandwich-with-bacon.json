  "instructions": [
    {
      "id": 1,
      "primary_message": "Carefully add the eggs and 1 1/2 quarts of water to a saucepan. Bring to a bare simmer over high heat (approximately 82°C), then turn heat to lowest setting, cover, and cook for 10 minutes. Remove eggs and place in a bowl under cold running water. When cool, peel eggs, discarded the shells, and finely chop the yolks and whites with a knife or by squeezing through your fingers in a bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, cook bacon in a large skillet over medium heat, turning occasionally until crispy, about 10 minutes. Drain on paper towels.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine mayonnaise, lemon juice, scallions, and celery in a medium-sized bowl. Stir the chopped eggs into the mayonnaise mixture. Taste and season with more salt and pepper if necessary.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Toast the slices of bread. Top each slices with some of the egg salad and a slice bacon broken in half. Serve immediately.",
      "secondary_message": null
    }
  ],
