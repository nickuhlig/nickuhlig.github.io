  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the special crabmeat over for shells. Zest and juice the lemon. Pick the parsley leaves from the stems and mince them. Finely mince the shallot. Melt the unsalted butter.",
      "secondary_message": "0.45 kg special crabmeat\n½ lemon, plus grated zest of 1/2 a lemon\n2 tbsp fresh flat-leaf parsley\n1 small shallot\n2 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 190°C (375°F). In a medium bowl, stir together crabmeat, mayonnaise, Dijon, lemon juice and zest, parsley, Old Bay, and shallot until evenly incorporated. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, stir bread crumbs with melted butter until evenly coated. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pack crab mixture in a 1-quart baking or gratin dish, then layer buttered bread crumbs evenly on top. Set on top of a rimmed baking sheet and bake until crab mixture is heated through and bread crumbs are golden, about 20 minutes. Serve with toasts or crackers, if desired.",
      "secondary_message": null
    }
  ],
