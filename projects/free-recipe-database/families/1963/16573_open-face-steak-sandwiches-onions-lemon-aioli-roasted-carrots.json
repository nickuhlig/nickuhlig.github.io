  "instructions": [
    {
      "id": 270729,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 270730,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium carrots\n1 ½ lemons\n3 tomatoes"
    },
    {
      "id": 270731,
      "primary_message": "Peel, trim, and cut carrots lengthwise into quarters; divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 270732,
      "primary_message": "Zest lemons into a small bowl and set aside. Juice lemons over the carrots, drizzle with oil, and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 270733,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing once, until carrots are fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 270734,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 270735,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onions into half-moons.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 270736,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until soft and golden, 8-10 minutes. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 270737,
      "primary_message": "While the onions are cooking, add mayo and garlic powder to the bowl with the lemon zest; stir to combine the lemon aioli and set aside.",
      "secondary_message": "¼ cup mayonnaise\n1 ½ tsp garlic powder"
    },
    {
      "id": 270738,
      "primary_message": "Pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 270739,
      "primary_message": "Once the onions are done, return the skillet to medium-high heat and add more oil; swirl to coat the bottom. Working in batches if necessary, add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Add to the plate with the onions, re-cover with foil, and let rest 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 270740,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 270741,
      "primary_message": "Slice tomatoes into rounds.",
      "secondary_message": null
    },
    {
      "id": 270742,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 270743,
      "primary_message": "Divide buns between plates, spread each with lemon aioli, then top with tomato, steak, and onions. Serve with roasted carrots on the side and enjoy!",
      "secondary_message": null
    }
  ],
