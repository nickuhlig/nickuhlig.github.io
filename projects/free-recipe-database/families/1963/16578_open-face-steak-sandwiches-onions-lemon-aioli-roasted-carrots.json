  "instructions": [
    {
      "id": 270798,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 270799,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n1 lemon\n2 tomatoes"
    },
    {
      "id": 270800,
      "primary_message": "Peel, trim, and cut carrots lengthwise into quarters; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 270801,
      "primary_message": "Zest lemon into a small bowl and set aside. Juice lemon over the carrots, drizzle with oil, and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 270802,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing once, until carrots are fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 270803,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 270804,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion into half-moons.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 270805,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until soft and golden, about 8 minutes. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 270806,
      "primary_message": "While the onions are cooking, add mayo and garlic powder to the bowl with the lemon zest; stir to combine the lemon aioli and set aside.",
      "secondary_message": "3 tbsp mayonnaise\n1 tsp garlic powder"
    },
    {
      "id": 270807,
      "primary_message": "Pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 270808,
      "primary_message": "Once the onions are done, return the skillet to medium-high heat and add more oil; swirl to coat the bottom. Add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Add to the plate with the cooked onions, re-cover with foil, and let rest 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 270809,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 270810,
      "primary_message": "Slice tomatoes into rounds.",
      "secondary_message": null
    },
    {
      "id": 270811,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 270812,
      "primary_message": "Divide buns between plates, spread each with lemon aioli, then top with tomato, steak, and onions. Serve with roasted carrots on the side and enjoy!",
      "secondary_message": null
    }
  ],
