  "instructions": [
    {
      "id": 270828,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 270829,
      "primary_message": "Wash, dry, peel, trim, and cut carrots lengthwise into quarters; transfer to a baking sheet pan.",
      "secondary_message": "3 medium carrots"
    },
    {
      "id": 270830,
      "primary_message": "Wash, dry, and zest lemon into a small bowl; set aside.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 270831,
      "primary_message": "Juice lemon over the carrots, drizzle with oil, and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¼ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 270832,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing once, until carrots are fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 270833,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 270834,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion into half-moons.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 270835,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until soft and golden, about 8 minutes. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 270836,
      "primary_message": "While the onions are cooking, add mayo and garlic powder to the bowl with the lemon zest; stir to combine the lemon aioli and set aside.",
      "secondary_message": "1 ½ tbsp avocado oil mayonnaise\n½ tsp garlic powder"
    },
    {
      "id": 270837,
      "primary_message": "Pat the steak dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 270838,
      "primary_message": "Once the onions are done, return the skillet to medium-high heat and add more oil; swirl to coat the bottom. Add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Add to the plate with the cooked onions, re-cover with foil, and let rest 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 270839,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 270840,
      "primary_message": "Divide steak between plates and top with onions; serve with roasted carrots and aioli for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
