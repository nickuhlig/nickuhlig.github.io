  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Toast and freshly grind the long pepper. Toast and freshly grind the coriander. Mince the garlic. Zest the lemon.",
      "secondary_message": "1 ½ tsp long pepper\n1 ½ tsp coriander\n4 cloves garlic\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Turn on broiler and adjust rack to 4 to 6 inches from heat source. Trim bottom two inches off asparagus, rub with oil, and season well with salt. Arrange in a single layer in an oven-safe skillet or baking sheet.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Broil for two to three minutes, then check on asparagus for signs of light charring and a bright green color. Very thin spears may be finished at this point. Squeeze gently with tongs. If still very firm, return to broiler for another two to three minutes, or until spears bend slightly but break with a snap.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine long pepper, coriander, garlic, and lemon zest in a small bowl and mix to combine. Toss with asparagus and serve immediately.",
      "secondary_message": null
    }
  ],
