  "instructions": [
    {
      "id": 380839,
      "primary_message": "Preheat oven to 205°C (400°F). Line a baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 380840,
      "primary_message": "Peel and mince shallot and garlic. Place both in a medium bowl along with oil, mayo, vinegar, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 clove garlic\n2 tbsp extra virgin olive oil\n1 ½ tbsp mayonnaise\n1 tbsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 380841,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems; finely chop leaves. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 380842,
      "primary_message": "Finely grate Parmesan. Place in a pile on the baking sheet and spread out into a 6-inch circle.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 380843,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until Parmesan is lightly browned and crisp, 5-7 minutes. (Watch carefully as the Parmesan can burn quickly.) Remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 380844,
      "primary_message": "Meanwhile, drain and rinse beans in a colander. Add to the bowl with the kale.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 380845,
      "primary_message": "Wash, dry, quarter, core, and thinly slice apple. Add to the bowl.",
      "secondary_message": "1 Granny Smith apple"
    },
    {
      "id": 380846,
      "primary_message": "Roughly chop dates and add to the bowl. Toss to combine the salad.",
      "secondary_message": "⅛ cup medjool dates, pitted"
    },
    {
      "id": 380847,
      "primary_message": "Break crispy Parmesan into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 380848,
      "primary_message": "To serve, divide the salad between plates or bowls; top with pumpkin seeds and crispy Parmesan. Enjoy!",
      "secondary_message": "¼ cup pumpkin seeds"
    }
  ],
