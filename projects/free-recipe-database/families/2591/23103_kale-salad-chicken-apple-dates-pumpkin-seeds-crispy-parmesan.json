  "instructions": [
    {
      "id": 380895,
      "primary_message": "Preheat oven to 205°C (400°F). Line a large baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 380896,
      "primary_message": "Peel and mince shallots and garlic. Place both in a large bowl along with oil, vinegar, mayo, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n3 cloves garlic\n¼ cup extra virgin olive oil\n3 tbsp apple cider vinegar\n3 tbsp avocado oil mayonnaise\n1 ½ tsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 380897,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems; finely chop leaves. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 2-3 minutes. Set aside.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 380898,
      "primary_message": "Finely grate Parmesan. Divide into 3 piles and place on the baking sheet several inches apart from each other. Spread each pile out into a 6-inch circle.",
      "secondary_message": "128 g Parmesan cheese"
    },
    {
      "id": 380899,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until Parmesan is lightly browned and crisp, 5-7 minutes. (Watch carefully as the Parmesan can burn quickly.) Remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 380900,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 380901,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 380902,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 380903,
      "primary_message": "Meanwhile, wash and dry apples; using a clean cutting board, quarter, core, and thinly slice. Add to the bowl with the kale.",
      "secondary_message": "3 Granny Smith apples"
    },
    {
      "id": 380904,
      "primary_message": "Roughly chop dates and add to the bowl. Toss to combine the salad.",
      "secondary_message": "⅓ cup medjool dates, pitted"
    },
    {
      "id": 380905,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 380906,
      "primary_message": "Break the crispy Parmesan into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 380907,
      "primary_message": "To serve, divide the salad between plates or bowls and top with sliced chicken, pumpkin seeds, and crispy Parmesan. Enjoy!",
      "secondary_message": "¾ cup pumpkin seeds"
    }
  ],
