  "instructions": [
    {
      "id": 380859,
      "primary_message": "Preheat oven to 205°C (400°F). Line a large baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 380860,
      "primary_message": "Peel and mince shallots and garlic. Place both in a large bowl along with oil, mayo, vinegar, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n3 cloves garlic\n⅓ cup extra virgin olive oil\n¼ cup mayonnaise\n3 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp Italian seasoning\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 380861,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems; finely chop leaves. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 2-3 minutes. Set aside.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 380862,
      "primary_message": "Finely grate Parmesan. Divide into 3 piles and place on the baking sheet several inches apart from each other. Spread each pile out into a 6-inch circle.",
      "secondary_message": "128 g Parmesan cheese"
    },
    {
      "id": 380863,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until Parmesan is lightly browned and crisp, 5-7 minutes. (Watch carefully as the Parmesan can burn quickly.) Remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 380864,
      "primary_message": "Meanwhile, drain and rinse beans in a colander. Add to the bowl with the kale.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 380865,
      "primary_message": "Wash, dry, quarter, core, and thinly slice apples. Add to the bowl.",
      "secondary_message": "3 Granny Smith apples"
    },
    {
      "id": 380866,
      "primary_message": "Roughly chop dates and add to the bowl. Toss to combine the salad.",
      "secondary_message": "⅓ cup medjool dates, pitted"
    },
    {
      "id": 380867,
      "primary_message": "Break crispy Parmesan into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 380868,
      "primary_message": "To serve, divide the salad between plates or bowls; top with pumpkin seeds and crispy Parmesan. Enjoy!",
      "secondary_message": "¾ cup pumpkin seeds"
    }
  ],
