  "instructions": [
    {
      "id": 384131,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 384132,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n3 medium zucchini squash\n1 small bunch cilantro"
    },
    {
      "id": 384133,
      "primary_message": "Trim, seed, and roughly chop bell pepper. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 384134,
      "primary_message": "Halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper along with the broccoli. ",
      "secondary_message": "1 ½ (18 oz) bags broccoli florets"
    },
    {
      "id": 384135,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384136,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add curry paste and veggies; cook, stirring frequently, until veggies start to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n⅓ cup Thai curry paste, green"
    },
    {
      "id": 384137,
      "primary_message": "Add broth, coconut milk, sugar, and salt to the pot. Stir to combine the soup and bring to a simmer over medium-high heat. ",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n1 ½ (13.5 fl oz) cans coconut milk\n1 tbsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 384138,
      "primary_message": "While the soup is heating, medium dice tofu. ",
      "secondary_message": null
    },
    {
      "id": 384139,
      "primary_message": "Once the soup is simmering, add tofu and reduce heat to medium-low. Cook, stirring occasionally, until veggies are fork-tender and tofu is warmed through, 5-6 minutes. ",
      "secondary_message": null
    },
    {
      "id": 384140,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 384141,
      "primary_message": "When the soup is done, remove from heat. Add cilantro and vinegar, then stir to combine. ",
      "secondary_message": "3 tbsp rice vinegar"
    },
    {
      "id": 384142,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
