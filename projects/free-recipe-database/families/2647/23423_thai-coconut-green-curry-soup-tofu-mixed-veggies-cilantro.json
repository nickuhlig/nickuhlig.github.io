  "instructions": [
    {
      "id": 384191,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 384192,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 yellow bell peppers\n2 medium zucchini squash\n1 small bunch cilantro"
    },
    {
      "id": 384193,
      "primary_message": "Trim, seed, and roughly chop bell pepper. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 384194,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384195,
      "primary_message": "While the pot heats up, halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper along with the broccoli. ",
      "secondary_message": "1 (510 g) bag broccoli florets"
    },
    {
      "id": 384196,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add curry paste and veggies; cook, stirring frequently, until veggies start to soften, 3-4 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n¼ cup Thai curry paste, green"
    },
    {
      "id": 384197,
      "primary_message": "Add broth, coconut milk, sugar, and salt to the pot. Stir to combine the soup and bring to a simmer over medium-high heat. ",
      "secondary_message": "1420 ml chicken or vegetable broth\n1 (398 ml) can coconut milk\n2 tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 384198,
      "primary_message": "While the soup is heating, medium dice tofu. ",
      "secondary_message": null
    },
    {
      "id": 384199,
      "primary_message": "Once the soup is simmering, add tofu and reduce heat to medium-low. Cook, stirring occasionally, until veggies are fork-tender and tofu is warmed through, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 384200,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 384201,
      "primary_message": "When the soup is done, remove from heat. Add cilantro and vinegar, then stir to combine. ",
      "secondary_message": "2 tbsp rice vinegar"
    },
    {
      "id": 384202,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
