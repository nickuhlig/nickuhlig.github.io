  "instructions": [
    {
      "primary_message": "Fold a 30-inch long piece of aluminum foil in thirds lengthwise to create a \"collar\" for your slow cooker insert. Place the collar in the slow cooker, pressing it against the sides of the insert, then coat with cooking spray. \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place butter in a medium microwave safe bowl and melt in the microwave. Once melted, add milk, egg, and vanilla to the bowl, then whisk to combine. Add flour, sugar, cocoa, baking powder, and salt to the bowl, then stir to combine the batter.",
      "secondary_message": "¼ cup butter, unsalted\n½ cup whole milk\n1 egg\n2 tsp vanilla extract\n1 cup all-purpose flour\n½ cup granulated sugar\n¼ cup cocoa powder\n2 tsp baking powder\n¼ tsp salt"
    },
    {
      "primary_message": "Transfer batter to the slow cooker and spread out in an even layer.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Bring water to a boil in a kettle or saucepan. Once boiling, set aside.\n\n",
      "secondary_message": "1 cup water"
    },
    {
      "primary_message": "Place additional sugar and cocoa in a small bowl, then stir to combine. Evenly sprinkle over the batter in the slow cooker, then carefully pour boiling water over top (do not stir).\n\n",
      "secondary_message": "½ cup granulated sugar\n¼ cup cocoa powder"
    },
    {
      "primary_message": "Cover the slow cooker and cook until cake has risen and the top is set, HIGH for about 1 hour 30 minutes. Remove from heat, carefully remove and discard foil collar, then let sit for 15 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pudding cake and ice cream between bowls. Enjoy!\n\n",
      "secondary_message": "4 ½ cups vanilla ice cream"
    }
  ],
