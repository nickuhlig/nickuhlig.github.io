  "instructions": [
    {
      "id": 579292,
      "primary_message": "This recipe will make about 6 cups of smoothie. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 579293,
      "primary_message": "Peel bananas, break into chunks, and place in a blender. Add milk, yogurt, oats, raisins, maple syrup, spices, and 8 ice cubes, then blend on high speed until smooth, 1-2 minutes.",
      "secondary_message": "4 bananas\n16 fl oz (2 cups) whole milk\n2 cups plain Greek yogurt\n1 cup oats, quick cooking\n½ cup raisins\n2 tbsp pure maple syrup\n¼ tsp salt\n¼ tsp cinnamon, ground\n⅛ tsp nutmeg, ground"
    },
    {
      "id": 579294,
      "primary_message": "To serve, divide smoothie between glasses and sprinkle with additional cinnamon. Enjoy!",
      "secondary_message": "⅛ tsp cinnamon, ground"
    }
