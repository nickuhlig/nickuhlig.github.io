  "instructions": [
    {
      "primary_message": "Preheat a sauté pan over medium high heat. Add oil and evenly coat the bottom of the pan. Add the broccoli and sauté until fork-tender, 4-5 minutes.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add the bell pepper, shrimp, bamboo shoots, water chestnuts, garlic, salt and pepper. Stirring frequently, cook until the shrimp are cooked through, about 3-4 minutes. Remove from heat and combine the shrimp mixture with the Samyang® Buldak Carbonara Spicy Ramen. Sprinkle with the furikake seasoning and serve.\n",
      "secondary_message": null
    }
