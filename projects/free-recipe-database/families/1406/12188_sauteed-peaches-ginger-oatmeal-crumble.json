  "instructions": [
    {
      "id": 204973,
      "primary_message": "Preheat oven to 400°F. Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 204974,
      "primary_message": "Combine oats, flour, sugar, and spices in a medium bowl.",
      "secondary_message": "⅔ cup oats, quick cooking\n⅔ cup all-purpose flour\n¼ cup brown sugar\n½ tsp cinnamon\n¼ tsp nutmeg, ground\n⅛ tsp salt"
    },
    {
      "id": 204975,
      "primary_message": "Add oil to the bowl with the flour. Using two hands or a fork, combine the flour and oil by rubbing the mixture between your thumbs and fingers until it looks crumbly. ",
      "secondary_message": "¼ cup virgin coconut oil"
    },
    {
      "id": 204976,
      "primary_message": "Transfer crumble mixture to the baking sheet and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake until golden brown, about 10 minutes. Remove from oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 204977,
      "primary_message": "Meanwhile, wash, dry, and halve peaches. Twist to open and remove pits. Slice each half into 4 wedges.",
      "secondary_message": "6 peaches"
    },
    {
      "id": 204978,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 204979,
      "primary_message": "While the skillet is heating, wash, peel, and mince or grate the ginger.",
      "secondary_message": "2 (1 inch) pieces ginger root"
    },
    {
      "id": 204980,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peaches, ginger, sugar, vanilla, and cinnamon to the skillet. Cook, stirring often, until peaches just begin to soften and release their juices, 3-4 minutes. Remove from heat.",
      "secondary_message": "3 tbsp virgin coconut oil\n¼ cup brown sugar\n1 tsp vanilla extract\n½ tsp cinnamon"
    },
    {
      "id": 204981,
      "primary_message": "To serve, divide sautéed peaches between bowls. Sprinkle with oatmeal crumble and enjoy!",
      "secondary_message": null
    }
  ],
