  "instructions": [
    {
      "id": 205045,
      "primary_message": "Preheat oven to 205°C (400°F). Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 205046,
      "primary_message": "Combine oats, flour, sugar, and spices in a medium bowl.",
      "secondary_message": "⅓ cup oats, quick cooking\n⅓ cup all-purpose flour\n2 tbsp brown sugar\n¼ tsp cinnamon\n⅛ tsp nutmeg, ground\n1 pinch salt"
    },
    {
      "id": 205047,
      "primary_message": "Using a box grater, coarsely grate cold butter into the bowl with the flour. Using two hands, combine the flour and butter by rubbing the mixture between your thumbs and fingers until it looks crumbly.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 205048,
      "primary_message": "Transfer crumble mixture to the baking sheet and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake until golden brown, about 10 minutes. Remove from oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 205049,
      "primary_message": "Meanwhile, wash, dry, and halve peaches. Twist to open and remove pits. Slice each half into 4 wedges.",
      "secondary_message": "2 peaches"
    },
    {
      "id": 205050,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 205051,
      "primary_message": "While the skillet is heating, wash, peel, and mince or grate the ginger.",
      "secondary_message": "1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 205052,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add peaches, ginger, sugar, vanilla, and cinnamon to the skillet. Cook, stirring often, until peaches just begin to soften and release their juices, about 3 minutes. Remove from heat.",
      "secondary_message": "1 ½ tbsp butter, unsalted\n1 ½ tbsp brown sugar\n¼ tsp vanilla extract\n¼ tsp cinnamon"
    },
    {
      "id": 205053,
      "primary_message": "To serve, divide sautéed peaches and ice cream between bowls. Sprinkle with oatmeal crumble and enjoy!",
      "secondary_message": "177 ml vanilla ice cream"
    }
  ],
