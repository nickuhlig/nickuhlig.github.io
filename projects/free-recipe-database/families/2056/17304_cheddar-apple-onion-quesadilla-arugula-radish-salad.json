  "instructions": [
    {
      "id": 322845,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 Granny Smith apples\n1 bunch radish\n1 avocado\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 322846,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 322847,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion into half-moons.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 322848,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, salt, and pepper; cook, stirring occasionally, until onions are soft and golden brown, 6-7 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 322849,
      "primary_message": "Meanwhile, quarter and core apples, then thinly slice.",
      "secondary_message": null
    },
    {
      "id": 322850,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 322851,
      "primary_message": "Place tortillas on a flat surface and divide onion, apple, and cheese between them, arranging the filling on one half of each tortilla; fold in half to close.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 322852,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 322853,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add quesadillas and cook until cheese is melted and tortillas are golden, 2½-3 minutes per side. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 322854,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 322855,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 322856,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 322857,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
