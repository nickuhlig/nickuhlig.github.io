  "instructions": [
    {
      "id": 417972,
      "primary_message": "Preheat the oven to 230°C (450°F). Line a two large baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 417973,
      "primary_message": "Pat steak dry with paper towels and place on one baking sheet. Drizzle with oil and season with spices on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 417974,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into strips. Transfer to the other baking sheet, drizzle with additional oil, and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "3 red bell peppers\n3 green bell peppers\n2 tbsp extra virgin olive oil\n1 tbsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 417975,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring veggies and flipping steak halfway through, until veggies are tender and steak is cooked to desired doneness, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 417976,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 417977,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add riced cauliflower, water, and salt to the pot; cook, stirring occasionally, until liquid has evaporated and cauliflower is tender, 6-7 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 (340 g) bags frozen, riced cauliflower\n½ cup water\n½ tsp salt"
    },
    {
      "id": 417978,
      "primary_message": "When the steak and veggies are done, transfer steak to the cutting board and let rest, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 417979,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 417980,
      "primary_message": "Divide cauliflower rice, steak, veggies, guacamole, and cheese between bowls. Serve with hot sauce on the side and enjoy!",
      "secondary_message": "1 ½ cups guacamole\n1 ½ cups shredded cheese, Mexican blend\n1 tbsp hot sauce"
    }
  ],
