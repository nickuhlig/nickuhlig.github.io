  "instructions": [
    {
      "id": 417988,
      "primary_message": "Preheat the oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 417989,
      "primary_message": "Drain and rinse beans; pat dry with paper towels. Transfer to a large baking sheet pan. ",
      "secondary_message": "2 (398 ml) cans kidney beans"
    },
    {
      "id": 417990,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into strips. Add to the baking sheet with the beans, drizzle with oil, and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "2 red bell peppers\n2 green bell peppers\n3 tbsp extra virgin olive oil\n4 tsp chili powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 417991,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring once, until beans are warmed through and veggies are tender, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 417992,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 417993,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add riced cauliflower, water, and salt to the skillet; cook, stirring occasionally, until liquid has evaporated and cauliflower is tender, 5-6 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 (340 g) bags frozen, riced cauliflower\n⅓ cup water\n¼ tsp salt"
    },
    {
      "id": 417994,
      "primary_message": "Divide cauliflower rice, beans, veggies, guacamole, and cheese between bowls. Serve with hot sauce on the side and enjoy!",
      "secondary_message": "1 cup guacamole\n1 cup shredded cheese, Mexican blend\n2 tsp hot sauce"
    }
  ],
