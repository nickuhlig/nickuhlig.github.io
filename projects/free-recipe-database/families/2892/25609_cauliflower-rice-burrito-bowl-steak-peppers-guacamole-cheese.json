  "instructions": [
    {
      "id": 417954,
      "primary_message": "Preheat the oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 417955,
      "primary_message": "Pat steak dry with paper towels and place on one half of the baking sheet. Drizzle with oil and season with spices on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n1 tsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 417956,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into strips. Add to the other half of the baking sheet, drizzle with additional oil, and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "1 red bell pepper\n1 green bell pepper\n2 tsp extra virgin olive oil\n1 tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 417957,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring veggies and flipping steak halfway through, until veggies are tender and steak is cooked to desired doneness, 13-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 417958,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 417959,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add riced cauliflower, water, and salt to the skillet; cook, stirring occasionally, until liquid has evaporated and cauliflower is tender, 5-6 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "1 tsp extra virgin olive oil\n1 (340 g) bag frozen, riced cauliflower\n¼ cup water\n⅛ tsp salt"
    },
    {
      "id": 417960,
      "primary_message": "When the steak and veggies are done, transfer steak to the cutting board and let rest, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 417961,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 417962,
      "primary_message": "Divide cauliflower rice, steak, veggies, guacamole, and cheese between bowls. Serve with hot sauce on the side and enjoy!",
      "secondary_message": "½ cup guacamole\n½ cup shredded cheese, Mexican blend\n1 tsp hot sauce"
    }
  ],
