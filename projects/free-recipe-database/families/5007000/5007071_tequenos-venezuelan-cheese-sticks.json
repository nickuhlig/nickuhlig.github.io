  "instructions": [
    {
      "id": 1,
      "primary_message": "Place flour and salt in workbowl of a food processor fitted with a steel blade; pulse to combine. Sprinkle butter evenly over flour and pulse until butter is cut into pieces slightly smaller than a pea, about 8 one-second pulses. Transfer dough to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add in egg and water. Using a rubber spatula, press dough against side of bowl until it forms a ball. If dough is not fully forming, add additional water one tablespoon at a time until it comes together. Press dough into a disc, wrap tightly in plastic wrap, and rest in refrigerator for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Unwrap dough and place on a lightly floured surface. Roll out into a square 0.5-cm thick. Cut off edges to create a 30-cm square. Cut square into 14 strips, each 2-cm wide.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Take one strip of dough and drape end over top of one cheese slice. Wrap entire cheese slice in dough on a diagonal, overlapping dough. Cover bottom of cheese slice in dough and pinch edges close to fully seal. Repeat with remaining cheese slices.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Fill a cast iron skillet with 2-cm of oil. Heat oil to 204°C over high heat. Place tequeños in oil and fry until crust is golden brown and blistery, 3 to 5 minutes, turning halfway through. Transfer tequeños to a paper towel-lined plate, let cool for 1 to 2 minutes, then serve immediately.",
      "secondary_message": null
    }
  ],
