  "instructions": [
    {
      "id": 449637,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a baking dish with a thin layer of oil and set aside.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 449638,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 449639,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 small bunch green onions (scallions)\n½ English cucumber\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 449640,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 449641,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 449642,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl with the ginger and garlic (set remainder aside for serving). ",
      "secondary_message": null
    },
    {
      "id": 449643,
      "primary_message": "Add beef, bread crumbs, soy sauce, chili-garlic sauce, oil, sugar, fish sauce, and pepper to the bowl. Using your hands, mix well to combine. ",
      "secondary_message": "⅓ kg lean ground beef\n¼ cup panko bread crumbs\n1 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 ½ tsp toasted sesame oil\n1 ½ tsp brown sugar\n1 tsp fish sauce\n⅛ tsp black pepper"
    },
    {
      "id": 449644,
      "primary_message": "Using a tablespoon measure, form the beef mixture into rounded meatballs and place in the prepared dish. ",
      "secondary_message": null
    },
    {
      "id": 449645,
      "primary_message": "Place meatballs in the oven and bake, turning once, until cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 449646,
      "primary_message": "Meanwhile, place soy sauce, vinegar, sugar, fish sauce, and chili-garlic sauce in a clean medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tsp soy sauce\n2 tsp rice vinegar\n1 ½ tsp brown sugar\n1 tsp fish sauce\n½ tsp chili-garlic sauce"
    },
    {
      "id": 449647,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 449648,
      "primary_message": "Just before serving, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 449649,
      "primary_message": "To serve, divide rice, meatballs, and salad between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
