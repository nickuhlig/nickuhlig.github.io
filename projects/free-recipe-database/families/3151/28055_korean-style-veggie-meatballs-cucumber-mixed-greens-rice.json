  "instructions": [
    {
      "id": 449611,
      "primary_message": "Preheat oven to 425°F. Coat a baking dish with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 449612,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 449613,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 small bunches green onions (scallions)\n1 English cucumber\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 449614,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 449615,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 449616,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl with the ginger and garlic (set remainder aside for serving).",
      "secondary_message": null
    },
    {
      "id": 449617,
      "primary_message": "Add veggie ground, bread crumbs, soy sauce, chili-garlic sauce, oil, sugar, salt, and pepper to the bowl. Using your hands, mix well to combine. ",
      "secondary_message": "16 oz veggie ground, plant based\n½ cup panko bread crumbs\n2 tbsp soy sauce\n2 tbsp chili-garlic sauce\n4 tsp toasted sesame oil\n1 tbsp brown sugar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 449618,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and place in the prepared dish. ",
      "secondary_message": null
    },
    {
      "id": 449619,
      "primary_message": "Place meatballs in the oven and bake, turning once, until cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 449620,
      "primary_message": "Meanwhile, place soy sauce, vinegar, sugar, oil, and chili-garlic sauce in a clean medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp soy sauce\n4 tsp rice vinegar\n1 tbsp brown sugar\n2 tsp toasted sesame oil\n1 tsp chili-garlic sauce"
    },
    {
      "id": 449621,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 449622,
      "primary_message": "Just before serving, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 449623,
      "primary_message": "To serve, divide rice, meatballs, and salad between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
