  "instructions": [
    {
      "id": 449702,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a large baking dish with a thin layer of oil and set aside.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 449703,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 449704,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 small bunches green onions (scallions)\n1 ½ English cucumbers\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 449705,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 449706,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 449707,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl with the ginger and garlic (set remainder aside for serving).",
      "secondary_message": null
    },
    {
      "id": 449708,
      "primary_message": "Add veggie ground, bread crumbs, soy sauce, chili-garlic sauce, oil, sugar, salt, and pepper to the bowl. Using your hands, mix well to combine. ",
      "secondary_message": "680 g veggie ground, plant based\n¾ cup panko bread crumbs\n3 tbsp soy sauce\n3 tbsp chili-garlic sauce\n2 tbsp toasted sesame oil\n1 ½ tbsp brown sugar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 449709,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and place in the prepared dish. ",
      "secondary_message": null
    },
    {
      "id": 449710,
      "primary_message": "Place meatballs in the oven and bake, turning once, until cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 449711,
      "primary_message": "Meanwhile, place soy sauce, vinegar, sugar, oil, and chili-garlic sauce in a clean large bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp rice vinegar\n1 ½ tbsp brown sugar\n1 tbsp toasted sesame oil\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 449712,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 449713,
      "primary_message": "Just before serving, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 449714,
      "primary_message": "To serve, divide rice, meatballs, and salad between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
