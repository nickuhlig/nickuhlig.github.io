  "instructions": [
    {
      "id": 1,
      "primary_message": "Cut crust off bread and cut bread into circles to fit your parfait glass. Place 1 piece bread in bottom of each glass.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large saucepan over medium heat, combine all berries, sugar, and water. Heat, stirring occasionally until juices are released, about 4 minutes. Spoon some fruit into each glass, covering bread. Add another layer of bread, then top it with remaining fruit. Cover glasses with plastic wrap, place into refrigerator and refrigerate for 8 hours or overnight.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Serve parfaits chilled with a dollop of Greek yogurt on top if desired.",
      "secondary_message": null
    }
  ],
