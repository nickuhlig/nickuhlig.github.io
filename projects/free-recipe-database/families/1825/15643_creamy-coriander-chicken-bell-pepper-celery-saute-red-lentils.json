  "instructions": [
    {
      "id": 287125,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, about 15 minutes.",
      "secondary_message": "1 ½ cup red lentils, dried\n710 ml chicken or vegetable broth"
    },
    {
      "id": 287126,
      "primary_message": "Meanwhile, cut chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 287127,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 287128,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and sauté until cooked through, 3-4 minutes. Using a slotted spoon, transfer chicken to a plate, cover with aluminum foil, and set aside. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 287129,
      "primary_message": "While the chicken is cooking, wash and dry the fresh produce.",
      "secondary_message": "6 green bell peppers\n6 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 287130,
      "primary_message": "Using a clean cutting board, trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 287131,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 287132,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 287133,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 287134,
      "primary_message": "Return pot (with cooking juices) to medium heat.",
      "secondary_message": null
    },
    {
      "id": 287135,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add veggies and spices to the pot; cook, stirring often, until veggies begin to soften, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp coriander, ground\n¾ tsp salt\n½ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 287136,
      "primary_message": "Add tomatoes and broth to the pot. Reduce heat to low and simmer, stirring occasionally, until sauce thickens, 7-8 minutes.",
      "secondary_message": "1 ½ (398 ml) cans diced tomatoes\n355 ml chicken or vegetable broth"
    },
    {
      "id": 287137,
      "primary_message": "Return chicken to the pot, stir to combine, and simmer until heated through, 3-4 minutes. Remove from heat and stir in cream.",
      "secondary_message": "177 ml heavy whipping cream"
    },
    {
      "id": 287138,
      "primary_message": "To serve, divide lentils and chicken sauté between bowls. Garnish with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
