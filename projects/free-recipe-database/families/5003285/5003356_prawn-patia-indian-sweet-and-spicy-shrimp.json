  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the onion. Devein the shelled shrimp.",
      "secondary_message": "1 small onion\n1 cup shelled, medium"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a large skillet over medium-high heat until shimmering. Gently put in the curry leaves and step aside as they pop. Stir for 20 seconds. Add the chopped onions and stir until lightly browned, about 5 minutes. Add the green chillies and stir for another minute. Add the tomato puree and keep stirring until oil separates from the onion tomato mix, about 5 minutes. Add the ginger-garlic past, red chilli, turmeric, and cumin, and keep stirring until mixture is fragrant, about 5 minutes, taking care to ensure the mixture doesn't stick to the bottom.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the sugar/grated jaggery, vinegar, and water and cook till the rawness of the tomato is gone, about 5 minutes. Season to taste with salt. Add the shrmp, stir and let cook for one minute. Remove from heat. Allow to continue cooking off heat, stirring occasionally, until shrimp are cooked through, about 4 minutes longer. Garnish with coriander and serve with white rice and daal.",
      "secondary_message": null
    }
  ],
