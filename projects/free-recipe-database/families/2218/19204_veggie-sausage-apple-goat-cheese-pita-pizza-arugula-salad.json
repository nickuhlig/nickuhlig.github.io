  "instructions": [
    {
      "id": 316189,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 316190,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 316191,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions).",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 316192,
      "primary_message": "Meanwhile, divide pitas between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven and set aside.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 316193,
      "primary_message": "While the pitas bake, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 Gala apples\n1 ½ lemons\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs baby arugula\n1 small pkg fresh basil"
    },
    {
      "id": 316194,
      "primary_message": "Quarter, core, and thinly slice apples.",
      "secondary_message": null
    },
    {
      "id": 316195,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 316196,
      "primary_message": "Layer baked pitas with apple and sausage slices, then crumble goat cheese over top. Working in batches if necessary, return baking sheets to the oven and bake until warmed through and cheese is melted, about 5 minutes. Remove from oven.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 316197,
      "primary_message": "Meanwhile, juice lemons into a large bowl; add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 316198,
      "primary_message": "Trim, halve, and slice cucumbers into thin half-moons. Add to the bowl with the dressing, along with the arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 316199,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 316200,
      "primary_message": "Divide pita pizzas between plates and sprinkle with basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
