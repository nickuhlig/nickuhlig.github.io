  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 180°C (350°F). Arrange bread slices on baking sheet in a single layer. Drizzle both sides with olive oil. (You don't have to cover every inch of bread or saturate it, but the drizzling should be even and consistent.) Season both sides with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Toast bread slices, rotating baking sheet from front to back and flipping slices halfway through baking, until toasts are browned and crispy throughout, about 12 minutes. Toasts can be kept at room temperature in zipper-lock bags up to overnight.",
      "secondary_message": null
    }
  ],
