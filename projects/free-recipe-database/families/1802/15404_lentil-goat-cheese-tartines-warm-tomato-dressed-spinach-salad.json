  "instructions": [
    {
      "id": 253612,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 253613,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a small saucepan. Add water and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 20-25 minutes.",
      "secondary_message": "½ cup brown lentils, dried\n1 ½ cup water\n¼ tsp salt"
    },
    {
      "id": 253614,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small pkg grape tomatoes\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 253615,
      "primary_message": "Peel and mince garlic; halve grape tomatoes. Transfer both to a small baking dish, drizzle with oil, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 253616,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until tomatoes have softened and released their juices, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 253617,
      "primary_message": "Meanwhile, peel, halve, and slice shallot into thin half-moons. Peel and mince additional garlic. Place both in a medium bowl along with vinegar and spices; stir to combine.",
      "secondary_message": "½ shallot\n1 clove garlic\n1 tbsp red wine vinegar\n¼ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 253618,
      "primary_message": "Trim and slice celery crosswise into thin pieces. Add to the bowl with the shallot and garlic.",
      "secondary_message": null
    },
    {
      "id": 253619,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 253620,
      "primary_message": "Slice sun-dried tomatoes into thin strips and add to the bowl.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 253621,
      "primary_message": "Crumble goat cheese into the bowl and set aside.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 253622,
      "primary_message": "When the roasted tomatoes are done, add cream to the baking dish, and stir to combine the warm tomato dressing. Set aside.",
      "secondary_message": "2 tbsp heavy whipping cream"
    },
    {
      "id": 253623,
      "primary_message": "When the lentils are done, drain in a colander. Add to the bowl with the goat cheese mixture and stir until creamy and combined. ",
      "secondary_message": null
    },
    {
      "id": 253624,
      "primary_message": "Toast bread in the oven or toaster (if desired). Divide lentil mixture between bread slices, spreading it out in an even layer.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 253625,
      "primary_message": "To serve, divide lentil tartines and spinach between plates. Spoon the warm tomato dressing over the spinach and enjoy!",
      "secondary_message": null
    }
  ],
