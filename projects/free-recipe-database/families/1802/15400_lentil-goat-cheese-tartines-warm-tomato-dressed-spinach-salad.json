  "instructions": [
    {
      "id": 253556,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 253557,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a medium saucepan. Add water and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 20-25 minutes.",
      "secondary_message": "1 ½ cups brown lentils, dried\n4 ½ cup water\n¾ tsp salt"
    },
    {
      "id": 253558,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ pints grape tomatoes\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 253559,
      "primary_message": "Peel and mince garlic; halve grape tomatoes. Transfer both to a large baking dish, drizzle with oil, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 253560,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until tomatoes have softened and released their juices, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 253561,
      "primary_message": "Meanwhile, peel, halve, and slice shallots into thin half-moons. Peel and mince additional garlic. Place both in a medium bowl along with vinegar and spices; stir to combine.",
      "secondary_message": "2 shallots\n3 cloves garlic\n3 tbsp red wine vinegar\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 253562,
      "primary_message": "Trim and slice celery crosswise into thin pieces. Add to the bowl with the shallot and garlic.",
      "secondary_message": null
    },
    {
      "id": 253563,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 253564,
      "primary_message": "Slice sun-dried tomatoes into thin strips and add to the bowl.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 253565,
      "primary_message": "Crumble goat cheese into the bowl and set aside.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 253566,
      "primary_message": "When the roasted tomatoes are done, add cream to the baking dish, and stir to combine the warm tomato dressing. Set aside.",
      "secondary_message": "3 fl oz (⅜ cup) heavy whipping cream"
    },
    {
      "id": 253567,
      "primary_message": "When the lentils are done, drain in a colander. Add to the bowl with the goat cheese mixture and stir until creamy and combined. ",
      "secondary_message": null
    },
    {
      "id": 253568,
      "primary_message": "Toast bread in the oven or toaster (if desired). Divide lentil mixture between bread slices, spreading it out in an even layer.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 253569,
      "primary_message": "To serve, divide lentil tartines and spinach between plates. Spoon the warm tomato dressing over the spinach and enjoy!",
      "secondary_message": null
    }
  ],
