  "instructions": [
    {
      "id": 213700,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 213701,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 213702,
      "primary_message": "Meanwhile, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 213703,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 213704,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and cook until golden brown and cooked through, 3-4 minutes per side.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 213705,
      "primary_message": "Meanwhile, wash and dry ginger. Peel and mince ginger and garlic; transfer both to a small bowl.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 clove garlic"
    },
    {
      "id": 213706,
      "primary_message": "Add broth, soy sauce, additional oil, honey, and cinnamon to the bowl with the garlic and ginger; whisk to combine the sauce.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n2 tbsp soy sauce\n1 tsp toasted sesame oil\n1 tsp honey\n¼ tsp cinnamon"
    },
    {
      "id": 213707,
      "primary_message": "When the chops are done, remove to a clean plate and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 213708,
      "primary_message": "Pour sauce into the skillet and cook, scraping up any browned bits from the bottom of the pan. Bring to a simmer and cook until slightly thickened, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 213709,
      "primary_message": "While the sauce thickens, wash, dry, and trim snap peas.",
      "secondary_message": "1 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 213710,
      "primary_message": "Add snap peas to the skillet and cook, stirring occasionally, until tender-crisp, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 213711,
      "primary_message": "To serve, divide rice, pork chops, snap peas, and sauce between plates. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
