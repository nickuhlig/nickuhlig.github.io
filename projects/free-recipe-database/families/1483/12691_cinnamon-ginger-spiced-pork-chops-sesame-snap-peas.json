  "instructions": [
    {
      "id": 213898,
      "primary_message": "Pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 213899,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 213900,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and cook until golden brown and cooked through, 3-4 minutes per side.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 213901,
      "primary_message": "Meanwhile, wash and dry ginger. Peel and mince ginger and garlic; transfer both to a small bowl.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 clove garlic"
    },
    {
      "id": 213902,
      "primary_message": "Add broth, soy sauce, additional oil, and cinnamon to the bowl with the garlic and ginger; whisk to combine the sauce.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n2 tbsp soy sauce\n1 tsp toasted sesame oil\n¼ tsp cinnamon"
    },
    {
      "id": 213903,
      "primary_message": "When the chops are done, remove to a clean plate and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 213904,
      "primary_message": "Pour sauce into the skillet and cook, scraping up any browned bits from the bottom of the pan. Bring to a simmer and cook until slightly thickened, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 213905,
      "primary_message": "While the sauce thickens, wash, dry, and trim snap peas.",
      "secondary_message": "1 (227 g) pkg sugar snap peas"
    },
    {
      "id": 213906,
      "primary_message": "Add snap peas to the skillet and cook, stirring occasionally, until tender-crisp, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 213907,
      "primary_message": "To serve, divide pork chops, snap peas, and sauce between plates. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
