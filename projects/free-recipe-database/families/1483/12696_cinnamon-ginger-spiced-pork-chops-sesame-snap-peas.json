  "instructions": [
    {
      "id": 213948,
      "primary_message": "Pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, bone-in\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 213949,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 213950,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and cook until golden brown and cooked through, 3-4 minutes per side.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 213951,
      "primary_message": "Meanwhile, wash and dry ginger. Peel and mince ginger and garlic; transfer both to a small bowl.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 cloves garlic"
    },
    {
      "id": 213952,
      "primary_message": "Add broth, coconut aminos, additional oil, and cinnamon to the bowl with the garlic and ginger; whisk to combine the sauce.",
      "secondary_message": "355 ml chicken or vegetable broth\n⅓ cup coconut aminos\n1 tbsp toasted sesame oil\n¾ tsp cinnamon"
    },
    {
      "id": 213953,
      "primary_message": "When the chops are done, remove to a clean plate and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 213954,
      "primary_message": "Pour sauce into the skillet and cook, scraping up any browned bits from the bottom of the pan. Bring to a simmer and cook until slightly thickened, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 213955,
      "primary_message": "While the sauce thickens, wash, dry, and trim snap peas.",
      "secondary_message": "3 (227 g) pkg sugar snap peas"
    },
    {
      "id": 213956,
      "primary_message": "Add snap peas to the skillet and cook, stirring occasionally, until tender-crisp, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 213957,
      "primary_message": "To serve, divide pork chops, snap peas, and sauce between plates. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
