  "instructions": [
    {
      "id": 606686,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ (454 g) pkgs strawberries\n6 kiwifruit"
    },
    {
      "id": 606687,
      "primary_message": "Juice lemons into a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 606688,
      "primary_message": "Trim and quarter strawberries. Add to the pan with the lemon juice, along with honey and salt, then stir to combine.",
      "secondary_message": "3 tbsp honey\n¼ tsp salt"
    },
    {
      "id": 606689,
      "primary_message": "Set pan over medium heat and cook, stirring occasionally, until the strawberries soften and release their juices, 5-7 minutes. Remove compote from heat and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 606690,
      "primary_message": "Meanwhile, peel, trim, and halve kiwis lengthwise, then cut crosswise into thin half-moons. Place on a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 606691,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "id": 606692,
      "primary_message": "To serve, divide yogurt between bowls. Top with strawberry compote, kiwi, and pistachios. Enjoy!",
      "secondary_message": "6 cups plain Greek yogurt"
    }
  ],
