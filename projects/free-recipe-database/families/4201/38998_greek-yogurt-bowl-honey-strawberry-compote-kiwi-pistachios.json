  "instructions": [
    {
      "id": 606679,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 (454 g) pkg strawberries\n4 kiwifruit"
    },
    {
      "id": 606680,
      "primary_message": "Juice lemon into a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 606681,
      "primary_message": "Trim and quarter strawberries. Add to the pan with the lemon juice, along with honey and salt, then stir to combine.",
      "secondary_message": "2 tbsp honey\n¼ tsp salt"
    },
    {
      "id": 606682,
      "primary_message": "Set pan over medium heat and cook, stirring occasionally, until the strawberries soften and release their juices, about 5 minutes. Remove compote from heat and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 606683,
      "primary_message": "Meanwhile, peel, trim, and halve kiwis lengthwise, then cut crosswise into thin half-moons. Place on a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 606684,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 606685,
      "primary_message": "To serve, divide yogurt between bowls. Top with strawberry compote, kiwi, and pistachios. Enjoy!",
      "secondary_message": "4 cups plain Greek yogurt"
    }
  ],
