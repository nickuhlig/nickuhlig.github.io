  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ (16 oz) pkg strawberries\n2 kiwifruit"
    },
    {
      "primary_message": "Juice lemon into a medium saucepan.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and quarter strawberries. Add to the pan with the lemon juice, along with honey and salt, then stir to combine.",
      "secondary_message": "1 tbsp honey\n⅛ tsp salt"
    },
    {
      "primary_message": "Set pan over medium heat and cook, stirring occasionally, until the strawberries soften and release their juices, about 5 minutes. Remove compote from heat and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, peel, trim, and halve kiwis lengthwise, then cut crosswise into thin half-moons. Place on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide yogurt between bowls. Top with strawberry compote and kiwi. Enjoy!",
      "secondary_message": "2 cups plain Greek yogurt"
    }
  ],
