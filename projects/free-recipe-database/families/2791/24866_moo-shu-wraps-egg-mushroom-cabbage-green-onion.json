  "instructions": [
    {
      "id": 400488,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400489,
      "primary_message": "While the skillet heats up, place eggs, salt, and pepper in a medium bowl, then whisk to combine.",
      "secondary_message": "8 eggs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400490,
      "primary_message": "Once the skillet is hot, add oil and swirl the bottom. Add eggs and scramble using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until no longer runny; transfer to a plate and loosely cover with foil. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 400491,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 400492,
      "primary_message": "Wash, dry, peel, and mince ginger.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 400493,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400494,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add green onion, ginger, and garlic powder; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "4 tsp toasted sesame oil\n1 tsp garlic powder"
    },
    {
      "id": 400495,
      "primary_message": "Add mushrooms, cabbage, salt, and pepper to the skillet. Continue to cook, stirring often, until veggies are tender-crisp, 3-4 minutes more.",
      "secondary_message": "2 (227g ) pkg sliced white mushrooms\n1 (397 g) bag shredded cabbage (coleslaw mix)\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400496,
      "primary_message": "Return egg to the skillet, along with hoisin sauce, and stir to combine. Continue to cook the \"moo shu\" fillling until heated through, about 1 minute. Remove from heat.",
      "secondary_message": "¼ cup hoisin sauce"
    },
    {
      "id": 400497,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 400498,
      "primary_message": "Divide tortillas and \"moo shu\" filling between plates. Serve with additional hoisin sauce on the side for dipping and enjoy!",
      "secondary_message": "¼ cup hoisin sauce"
    }
  ],
