  "instructions": [
    {
      "id": 400463,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 400464,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400465,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper; cook, stirring occasionally, until opaque, 3-4 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve pot for later use.)",
      "secondary_message": "1 tbsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400466,
      "primary_message": "Meanwhile, place eggs in a small bowl and whisk until smooth.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 400467,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. ",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 400468,
      "primary_message": "Add egg to the pot and scramble using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until no longer runny; add to the plate with the shrimp and re-cover with the foil. (Reserve pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 400469,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 400470,
      "primary_message": "Wash, dry, peel, and mince ginger. ",
      "secondary_message": "3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 400471,
      "primary_message": "Return pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400472,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add green onion, ginger, and garlic powder; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 ½ tsp garlic powder"
    },
    {
      "id": 400473,
      "primary_message": "Add mushrooms, cabbage, salt, and pepper to the pot. Continue to cook, stirring occasionally, until veggies are tender-crisp, 4-5 minutes more.",
      "secondary_message": "3 (227g ) pkg sliced white mushrooms\n1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 400474,
      "primary_message": "Return shrimp and egg to the pot, then add hoisin sauce; stir to combine. Continue to cook the \"moo shu\" filling until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "⅓ cup hoisin sauce"
    },
    {
      "id": 400475,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 400476,
      "primary_message": "Divide tortillas and \"moo shu\" filling between plates. Serve with additional hoisin sauce on the side for dipping and enjoy!",
      "secondary_message": "⅓ cup hoisin sauce"
    }
  ],
