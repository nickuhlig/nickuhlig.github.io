  "instructions": [
    {
      "id": 400499,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400500,
      "primary_message": "While the pot heats up, place eggs, salt, and pepper in a medium bowl, then whisk to combine.",
      "secondary_message": "12 eggs\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 400501,
      "primary_message": "Once the pot is hot, add oil and swirl the bottom. Add eggs and scramble using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until no longer runny; transfer to a plate and loosely cover with foil. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 400502,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 400503,
      "primary_message": "Wash, dry, peel, and mince ginger.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 400504,
      "primary_message": "Return pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400505,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add green onion, ginger, and garlic powder; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 ½ tsp garlic powder"
    },
    {
      "id": 400506,
      "primary_message": "Add mushrooms, cabbage, salt, and pepper to the pot. Continue to cook, stirring often, until veggies are tender-crisp, 4-5 minutes more.",
      "secondary_message": "3 (227g ) pkg sliced white mushrooms\n1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 400507,
      "primary_message": "Return egg to the pot, along with hoisin sauce, and stir to combine. Continue to cook the \"moo shu\" fillling until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "⅓ cup hoisin sauce"
    },
    {
      "id": 400508,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 400509,
      "primary_message": "Divide tortillas and \"moo shu\" filling between plates. Serve with additional hoisin sauce on the side for dipping and enjoy!",
      "secondary_message": "⅓ cup hoisin sauce"
    }
  ],
