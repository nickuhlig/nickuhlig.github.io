  "instructions": [
    {
      "id": 400374,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 400375,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400376,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper; cook, stirring occasionally, until opaque, about 3 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400377,
      "primary_message": "Meanwhile, place eggs in a small bowl and whisk until smooth.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 400378,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. ",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 400379,
      "primary_message": "Add egg to the skillet and scramble using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until no longer runny; add to the plate with the shrimp and re-cover with the foil. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 400380,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 400381,
      "primary_message": "Wash, dry, peel, and mince ginger. ",
      "secondary_message": "2 (1 inch) pieces ginger root"
    },
    {
      "id": 400382,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400383,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add green onion, ginger, and garlic powder; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "4 tsp toasted sesame oil\n1 tsp garlic powder"
    },
    {
      "id": 400384,
      "primary_message": "Add mushrooms, cabbage, salt, and pepper to the skillet. Continue to cook, stirring occasionally, until veggies are tender-crisp, 3-4 minutes more.",
      "secondary_message": "2 (8 oz) pkg sliced white mushrooms\n1 (14 oz) bag shredded cabbage (coleslaw mix)\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400385,
      "primary_message": "Return shrimp and egg to the skillet, then add hoisin sauce; stir to combine. Continue to cook the \"moo shu\" filling until heated through, about 1 minute. Remove from heat.",
      "secondary_message": "¼ cup hoisin sauce"
    },
    {
      "id": 400386,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 400387,
      "primary_message": "Divide tortillas and \"moo shu\" filling between plates. Serve with additional hoisin sauce on the side for dipping and enjoy!",
      "secondary_message": "¼ cup hoisin sauce"
    }
  ],
