  "instructions": [
    {
      "id": 229781,
      "primary_message": "Place eggs in a small saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 229782,
      "primary_message": "While the eggs are cooking, wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "2 medium yellow potatoes\n1 medium carrot\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 229783,
      "primary_message": "Peel, trim, and medium dice potatoes. Transfer to a medium saucepan, fill about halfway with hot water (from the tap), and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 229784,
      "primary_message": "Meanwhile, peel, trim, and medium dice carrot. Add carrot to the pan with the potatoes and stir to combine. Cook until veggies are crisp-tender, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 229785,
      "primary_message": "While the eggs and veggies are cooking, place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette and set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229786,
      "primary_message": "Place yogurt, mayo, and spices in a medium bowl; whisk to combine the creamy dressing.",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp mayonnaise\n½ tsp dill, dried\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229787,
      "primary_message": "Place peas in a colander. When the potatoes and carrots are done, pour into the colander over the peas. Run under cold water to cool and set aside to drain.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 229788,
      "primary_message": "Drain and mince capers; add to the bowl with the creamy dressing.",
      "secondary_message": "1 tbsp capers"
    },
    {
      "id": 229789,
      "primary_message": "Peel and mince shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 229790,
      "primary_message": "Peel and medium dice eggs; add to the bowl along with the potatoes, carrots, and peas. Stir to combine the potato salad.",
      "secondary_message": null
    },
    {
      "id": 229791,
      "primary_message": "To serve, divide spring mix between plates and drizzle with vinaigrette. Top with potato salad and enjoy!",
      "secondary_message": null
    }
  ],
