  "instructions": [
    {
      "id": 229684,
      "primary_message": "Place eggs in a medium saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 229685,
      "primary_message": "While the eggs are cooking, wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "4 medium yellow potatoes\n2 medium carrots\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 229686,
      "primary_message": "Peel, trim, and medium dice potatoes. Transfer to another medium saucepan, fill about halfway with hot water (from the tap), and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 229687,
      "primary_message": "Meanwhile, peel, trim, and medium dice carrots. Add carrots to the pan with the potatoes and stir to combine. Cook until veggies are crisp-tender, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 229688,
      "primary_message": "While the eggs and veggies are cooking, place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229689,
      "primary_message": "Place yogurt, mayo, and spices in a large bowl; whisk to combine the creamy dressing.",
      "secondary_message": "⅔ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 tsp dill, dried\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229690,
      "primary_message": "Place peas in a colander. When the potatoes and carrots are done, pour into the colander over the peas. Run under cold water to cool and set aside to drain.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 229691,
      "primary_message": "Drain and mince capers; add to the bowl with the creamy dressing.",
      "secondary_message": "2 tbsp capers"
    },
    {
      "id": 229692,
      "primary_message": "Peel and mince onion; add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 229693,
      "primary_message": "Peel and medium dice eggs; add to the bowl along with the potatoes, carrots, and peas. Stir to combine the potato salad.",
      "secondary_message": null
    },
    {
      "id": 229694,
      "primary_message": "To serve, divide spring mix between plates and drizzle with vinaigrette. Top with potato salad and enjoy!",
      "secondary_message": null
    }
  ],
