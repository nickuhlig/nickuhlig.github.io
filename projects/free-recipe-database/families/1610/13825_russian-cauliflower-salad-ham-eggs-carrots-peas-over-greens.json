  "instructions": [
    {
      "id": 229634,
      "primary_message": "Place eggs in a small saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 229635,
      "primary_message": "While the eggs are cooking, wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "1 medium carrot\n½ medium head cauliflower\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 229636,
      "primary_message": "Peel, trim, and medium dice carrot. Transfer to a medium saucepan, fill about halfway with hot water (from the tap), and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 229637,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. ",
      "secondary_message": null
    },
    {
      "id": 229638,
      "primary_message": "Add cauliflower to the pan with the carrots and stir to combine. Cook until veggies are crisp-tender, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 229639,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette; set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229640,
      "primary_message": "Place peas in a colander. When the carrots and cauliflower are done, pour into the colander over the peas. Run under cold water to cool and set aside to drain.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 229641,
      "primary_message": "Place yogurt, mayo, and spices in a medium bowl; whisk to combine the creamy dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n¼ cup avocado oil mayonnaise\n½ tsp dill, dried\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229642,
      "primary_message": "Drain and mince capers; add to the bowl with the creamy dressing.",
      "secondary_message": "1 tbsp capers"
    },
    {
      "id": 229643,
      "primary_message": "Peel and mince shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 229644,
      "primary_message": "Chop or tear prosciutto into small pieces and add to the bowl.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 229645,
      "primary_message": "Peel and medium dice eggs; add to the bowl along with the carrots, cauliflower, and peas. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 229646,
      "primary_message": "To serve, divide spring mix between plates and drizzle with vinaigrette. Top with cauliflower salad and enjoy!",
      "secondary_message": null
    }
  ],
