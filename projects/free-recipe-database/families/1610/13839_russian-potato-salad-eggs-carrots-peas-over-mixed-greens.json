  "instructions": [
    {
      "id": 229803,
      "primary_message": "Place eggs in a large pot, cover with hot water (from the tap), and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 229804,
      "primary_message": "While the eggs are cooking, wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "6 medium yellow potatoes\n3 medium carrots\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 229805,
      "primary_message": "Peel, trim, and medium dice potatoes. Transfer to another large pot, fill about halfway with hot water (from the tap), and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 229806,
      "primary_message": "Meanwhile, peel, trim, and medium dice carrots. Add carrots to the pot with the potatoes and stir to combine. Cook until veggies are crisp-tender, 7-9 minutes.",
      "secondary_message": null
    },
    {
      "id": 229807,
      "primary_message": "While the eggs and veggies are cooking, place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette and set aside.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229808,
      "primary_message": "Place yogurt, mayo, and spices in a large bowl; whisk to combine the creamy dressing.",
      "secondary_message": "1 cup plain Greek yogurt\n½ cup mayonnaise\n1 ½ tsp dill, dried\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 229809,
      "primary_message": "Place peas in a colander. When the potatoes and carrots are done, pour into the colander over the peas. Run under cold water to cool and set aside to drain.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 229810,
      "primary_message": "Drain and mince capers; add to the bowl with the creamy dressing.",
      "secondary_message": "3 tbsp capers"
    },
    {
      "id": 229811,
      "primary_message": "Peel and mince onion; add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 229812,
      "primary_message": "Peel and medium dice eggs; add to the bowl along with the potatoes, carrots, and peas. Stir to combine the potato salad.",
      "secondary_message": null
    },
    {
      "id": 229813,
      "primary_message": "To serve, divide spring mix between plates and drizzle with vinaigrette. Top with potato salad and enjoy!",
      "secondary_message": null
    }
  ],
