  "instructions": [
    {
      "id": 229660,
      "primary_message": "Place eggs in a large pot, cover with hot water (from the tap), and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "9 eggs"
    },
    {
      "id": 229661,
      "primary_message": "While the eggs are cooking, wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "3 medium carrots\n1 ½ medium heads cauliflower\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 229662,
      "primary_message": "Peel, trim, and medium dice carrots. Transfer to another large pot, fill about halfway with hot water (from the tap), and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 229663,
      "primary_message": "Meanwhile, cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. ",
      "secondary_message": null
    },
    {
      "id": 229664,
      "primary_message": "Add cauliflower to the pot with the carrots and stir to combine. Cook until veggies are crisp-tender, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 229665,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette; set aside.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229666,
      "primary_message": "Place yogurt, mayo, and spices in a large bowl; whisk to combine the creamy dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n¾ cup avocado oil mayonnaise\n1 ½ tsp dill, dried\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 229667,
      "primary_message": "Place peas in a colander. When the carrots and cauliflower are done, pour into the colander over the peas. Run under cold water to cool and set aside to drain.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 229668,
      "primary_message": "Drain and mince capers; add to the bowl with the creamy dressing.",
      "secondary_message": "3 tbsp capers"
    },
    {
      "id": 229669,
      "primary_message": "Peel and mince onion; add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 229670,
      "primary_message": "Chop or tear prosciutto into small pieces and add to the bowl.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 229671,
      "primary_message": "Peel and medium dice eggs; add to the bowl along with the carrots, cauliflower, and peas. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 229672,
      "primary_message": "To serve, divide spring mix between plates and drizzle with vinaigrette. Top with cauliflower salad and enjoy!",
      "secondary_message": null
    }
  ],
