  "instructions": [
    {
      "id": 229647,
      "primary_message": "Place eggs in a medium saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 229648,
      "primary_message": "While the eggs are cooking, wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "2 medium carrots\n1 medium head cauliflower\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 229649,
      "primary_message": "Peel, trim, and medium dice carrots. Transfer to another medium saucepan, fill about halfway with hot water (from the tap), and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 229650,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. ",
      "secondary_message": null
    },
    {
      "id": 229651,
      "primary_message": "Add cauliflower to the pan with the carrots and stir to combine. Cook until veggies are crisp-tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 229652,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the vinaigrette; set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229653,
      "primary_message": "Place peas in a colander. When the carrots and cauliflower are done, pour into the colander over the peas. Run under cold water to cool and set aside to drain.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 229654,
      "primary_message": "Place yogurt, mayo, and spices in a large bowl; whisk to combine the creamy dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n½ cup avocado oil mayonnaise\n1 tsp dill, dried\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229655,
      "primary_message": "Drain and mince capers; add to the bowl with the creamy dressing.",
      "secondary_message": "2 tbsp capers"
    },
    {
      "id": 229656,
      "primary_message": "Peel and mince onion; add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 229657,
      "primary_message": "Chop or tear prosciutto into small pieces and add to the bowl.",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 229658,
      "primary_message": "Peel and medium dice eggs; add to the bowl along with the carrots, cauliflower, and peas. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 229659,
      "primary_message": "To serve, divide spring mix between plates and drizzle with vinaigrette. Top with cauliflower salad and enjoy!",
      "secondary_message": null
    }
  ],
