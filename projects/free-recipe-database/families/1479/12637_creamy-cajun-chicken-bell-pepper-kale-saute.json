  "instructions": [
    {
      "id": 224154,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ bunch kale\n1 red bell pepper\n1 green bell pepper"
    },
    {
      "id": 224155,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 224156,
      "primary_message": "Meanwhile, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 224157,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 224158,
      "primary_message": "Add chicken to the skillet and pan-fry, flipping once, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 224159,
      "primary_message": "While the chicken cooks, using a clean cutting board, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to a medium bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 224160,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 224161,
      "primary_message": "Once the chicken is done, remove to a plate and cover with foil. Return skillet to medium-high heat, add more butter, and swirl to coat the bottom. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 224162,
      "primary_message": "Add peppers to the skillet and cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 224163,
      "primary_message": "Add tomatoes, broth, and spices to the skillet. Stir to combine and bring to a simmer. ",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n4 fl oz (½ cup) chicken or vegetable broth\n½ tsp paprika\n¼ tsp salt\n¼ tsp cayenne pepper\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp thyme, dried"
    },
    {
      "id": 224164,
      "primary_message": "Meanwhile, cut cream cheese into small pieces. ",
      "secondary_message": "¼ (8 oz) block cream cheese"
    },
    {
      "id": 224165,
      "primary_message": "Once simmering, reduce heat to medium. Add cream cheese, a few pieces at a time, and stir until melted and combined, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 224166,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 224167,
      "primary_message": "Return chicken to the skillet and turn to coat in the sauce. Continue to cook, until heated through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 224168,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
