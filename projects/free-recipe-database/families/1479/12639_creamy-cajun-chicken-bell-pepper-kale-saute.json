  "instructions": [
    {
      "id": 224184,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ bunches kale\n3 red bell peppers\n3 green bell peppers"
    },
    {
      "id": 224185,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 224186,
      "primary_message": "Meanwhile, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 224187,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 224188,
      "primary_message": "Working in batches if necessary, add chicken to the pot and pan-fry, flipping once, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 224189,
      "primary_message": "While the chicken cooks, using a clean cutting board, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to a medium bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 224190,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 224191,
      "primary_message": "Once the chicken is done, remove to a large plate and cover with foil. Return the pot to medium-high heat, add more butter, and swirl to coat the bottom. ",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 224192,
      "primary_message": "Add peppers to the pot and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 224193,
      "primary_message": "Add tomatoes, broth, and spices to the pot. Stir to combine and bring to a simmer. ",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n12 fl oz (1 ½ cups) chicken or vegetable broth\n1 ½ tsp paprika\n¾ tsp salt\n¾ tsp cayenne pepper\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp thyme, dried"
    },
    {
      "id": 224194,
      "primary_message": "Meanwhile, cut cream cheese into small pieces. ",
      "secondary_message": "¾ (8 oz) block cream cheese"
    },
    {
      "id": 224195,
      "primary_message": "Once simmering, reduce heat to medium. Add cream cheese, a few pieces at a time, and stir until melted and combined, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 224196,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 224197,
      "primary_message": "Return chicken to the pot and turn to coat in the sauce. Continue to cook, until heated through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 224198,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
