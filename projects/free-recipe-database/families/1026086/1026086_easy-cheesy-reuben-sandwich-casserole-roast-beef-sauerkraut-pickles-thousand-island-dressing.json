  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Coat a large baking dish with cooking spray. ",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place sauerkraut in a colander and set aside to drain.",
      "secondary_message": "2 cups sauerkraut"
    },
    {
      "primary_message": "Cut bread into 1-inch cubes, then place in the baking dish and drizzle with thousand island dressing. Roughly chop pickles and roast beef slices. Add both to the baking dish, spreading each out in an even layer. Top with drained sauerkraut. ",
      "secondary_message": "1 (16 oz) loaf rye bread\n⅓ cup Thousand Island dressing\n16 oz deli roast beef, sliced"
    },
    {
      "primary_message": "Place eggs, milk, honey mustard dressing, salt, and pepper in a medium bowl, then whisk to combine. Pour over the ingredients in the baking dish, then layer with cheese slices.",
      "secondary_message": "3 cups whole milk\n¼ cup honey mustard dressing\n½ tsp salt\n¼ tsp black pepper\n8 oz Swiss cheese, sliced"
    },
    {
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until casserole is golden and set, about 45 minutes. Remove from oven and let cool slightly, 10 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide casserole between plates or bowls, then drizzle with thousand island dressing. Enjoy!!",
      "secondary_message": "⅓ cup Thousand Island dressing"
    }
  ],
