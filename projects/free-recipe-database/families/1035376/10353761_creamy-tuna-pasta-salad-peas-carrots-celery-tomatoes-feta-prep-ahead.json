  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta, rinse under cold water to cool, and set aside.",
      "secondary_message": "1 tsp salt\n227 g rotini pasta"
    },
    {
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, Dijon, and spices in a large bowl, then whisk to combine the dressing.\n\n",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp mayonnaise\n2 tsp red wine vinegar\n2 tsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper\n½ tsp dill, dried\n¼ tsp garlic powder"
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "3 stick celery\n1 pint grape tomatoes"
    },
    {
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the dressing.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and small dice celery. Add to the bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Halve grape tomatoes. Add to the bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Rinse peas under hot water (from the tap) to thaw. Add to the bowl.\n\n",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "primary_message": "Drain tuna, add to the bowl, and flake with a fork.\n\n",
      "secondary_message": "3 (120 g) can chunk light tuna in water"
    },
    {
      "primary_message": "Add cooled pasta to the bowl, along with feta, and stir to combine the pasta salad.\n\n",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "primary_message": "Divide pasta salad between the containers, cover, and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
