  "instructions": [
    {
      "id": 314969,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 pints grape tomatoes\n1 small bunch cilantro\n3 jalapeño peppers\n3 avocados"
    },
    {
      "id": 314970,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons; peel and mince garlic. Place both in a large bowl.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 314971,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 314972,
      "primary_message": "Halve tomatoes; add half to the bowl with the other veggies. Place remaining tomatoes in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 314973,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 314974,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggies and spices. Cook, stirring occasionally, until tender, about 5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp curry powder\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp turmeric, ground"
    },
    {
      "id": 314975,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "18 eggs\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 314976,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 314977,
      "primary_message": "When the veggies are tender, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 314978,
      "primary_message": "Crumble goat cheese over the frittata. Place in the oven and broil until top is set and cheese is slightly melted, 3-4 minutes; remove from oven.",
      "secondary_message": "3 (4 oz) logs goat cheese"
    },
    {
      "id": 314979,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the remaining tomatoes.",
      "secondary_message": null
    },
    {
      "id": 314980,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 314981,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 314982,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
