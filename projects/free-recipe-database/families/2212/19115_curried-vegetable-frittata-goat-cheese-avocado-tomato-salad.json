  "instructions": [
    {
      "id": 314941,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n1 pint grape tomatoes\n½ small bunch cilantro\n1 jalapeño pepper\n1 avocado"
    },
    {
      "id": 314942,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 314943,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 314944,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 314945,
      "primary_message": "While the skillet heats up, halve tomatoes; add half to the bowl with the other veggies. Place remaining tomatoes in a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 314946,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggies and spices. Cook, stirring occasionally, until tender, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp curry powder\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp turmeric, ground"
    },
    {
      "id": 314947,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "6 eggs\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 314948,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 314949,
      "primary_message": "When the veggies are tender, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 314950,
      "primary_message": "Crumble goat cheese over the frittata. Place in the oven and broil until top is set and cheese is slightly melted, 3-4 minutes; remove from oven.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 314951,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the remaining tomatoes.",
      "secondary_message": null
    },
    {
      "id": 314952,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 314953,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 314954,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
