  "instructions": [
    {
      "id": 1,
      "primary_message": "Prepare a steamer over boiling water. Combine eggs, coconut milk, sugar, salt, flour, and vanilla, in a mixing bowl; Whisk together thoroughly. Strain custard mixture and divide it among four 6-ounce ramekins. Divide pumpkin among four ramekins. Steam until custard is set around edges but still slightly soft in the middle. This may take anywhere from 10 to 20 minutes depending on the type of steamer you use. Let custard cool to room temperature before serving.",
      "secondary_message": null
    }
