  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat the oil over high heat in a wok or large frying pan. When you can see waves forming in the hot oil, add the chilis, shallots, and garlic and stir-fry until golden, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the green beans and stir-fry until cooked but still crunchy, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the ground chicken, using a wooden spoon or spatula to break up the meat into small pieces. Stir-fry until chicken is cooked through.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add the fish sauce and sugar to the pan, and stir to distribute. Taste, and add more fish sauce or sugar if desired.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Reduce heat to medium-low. Add the basil leaves and stir-fry until completely wilted. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Serve with boiled rice, fried egg (optional), and nam pla prik or lime wedges.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Nam Pla Prik (Chili Fish Sauce): Mix fish sauce and lime juice to taste (a typical ratio is 3-4 parts fish sauce to 1 part lime juice) and pour over chilis and shallots. Consume immediately, or pour into a clean jar and store in refrigerator for up to two weeks.",
      "secondary_message": null
    }
  ],
