  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine two cups milk, sugar, cinnamon, and salt in a medium saucepan over moderate heat to just below a simmer. Simmer, stirring often, for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk together 1/2 cup milk with cornstarch and egg in a medium bowl until no lumps remain. Gradually pour heated milk into bowl, whisking constantly, then transfer pudding mixture back to pot. Increase heat to medium high and cook, stirring constantly with a spatula, until pudding thickens, 2 to 3 minutes. Stir in orange zest, juice, rum, and orange blossom water, and cook for 1 minute longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer pudding to small custard cups or one large bowl. Chill in refrigerator for at least 3 hours, or until set. To avoid a skin forming on top of pudding, cover surface with plastic wrap.",
      "secondary_message": null
    }
  ],
