  "instructions": [
    {
      "id": 232900,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n1 ½ yellow bell peppers\n1 ½ English cucumbers\n1 ½ (227 g) pkg sugar snap peas\n3 avocados"
    },
    {
      "id": 232901,
      "primary_message": "Peel and grate or mince ginger; transfer to a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 232902,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to the saucepan with the ginger. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 232903,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 232904,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a medium bowl along with mayo and whisk to combine.",
      "secondary_message": "3 cloves garlic\n¾ cup mayonnaise"
    },
    {
      "id": 232905,
      "primary_message": "Trim and thinly slice green onions; add to the bowl with the mayo.",
      "secondary_message": null
    },
    {
      "id": 232906,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 232907,
      "primary_message": "Chop or tear salmon into small pieces and add to the bowl. Stir to combine the salmon mixture and set aside.",
      "secondary_message": "3 (113 g) pkg smoked salmon"
    },
    {
      "id": 232908,
      "primary_message": "Place sesame seeds, oil, vinegar, soy sauce, sugar, chili powder, and salt in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp sesame seeds\n1 tbsp toasted sesame oil\n1 tbsp rice vinegar\n1 tbsp soy sauce\n1 ½ tsp brown sugar\n¾ tsp chili powder\n3 pinch salt"
    },
    {
      "id": 232909,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 232910,
      "primary_message": "Cut the snap peas crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 232911,
      "primary_message": "Uncover the rice and fluff with a fork. Add vinegar and sugar; stir to combine, then spread the rice out on a baking sheet pan to cool, about 5 minutes.",
      "secondary_message": "1 ½ tsp rice vinegar\n¾ tsp brown sugar"
    },
    {
      "id": 232912,
      "primary_message": "Meanwhile, halve and pit the avocados; scoop out flesh with a spoon and medium dice. Add to the bowl with the other veggies and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 232913,
      "primary_message": "Place a ⅓-cup of the salmon mixture in a small cup or bowl; top with a ½-cup of rice and press gently to secure. Once the stack is complete, flip the cup or bowl onto a plate; tap on the bottom to loosen the stack. If the rice is sticking, run a knife around the edge before flipping.",
      "secondary_message": null
    },
    {
      "id": 232914,
      "primary_message": "Repeat with remaining salmon mixture and rice, creating 2 stacks per plate.",
      "secondary_message": null
    },
    {
      "id": 232915,
      "primary_message": "To serve, divide salad between plates and enjoy!",
      "secondary_message": null
    }
  ],
