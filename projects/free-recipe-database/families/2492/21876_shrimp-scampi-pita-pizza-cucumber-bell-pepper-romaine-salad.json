  "instructions": [
    {
      "id": 367610,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 367611,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n3 red bell peppers\n1 ½ English cucumbers\n1 ½ lemons\n1 ½ heads romaine lettuce"
    },
    {
      "id": 367612,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 367613,
      "primary_message": "Shave parsley leaves off stems; discard the stems and mince the leaves. Place half in a large bowl. (Set remaining parsley aside for the pizzas.)",
      "secondary_message": null
    },
    {
      "id": 367614,
      "primary_message": "Add mayo, vinegar, oregano, and salt to the bowl with the parsley. Stir to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n3 tbsp white wine vinegar\n¾ tsp oregano, dried\n¾ tsp salt"
    },
    {
      "id": 367615,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 367616,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into thin pieces. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 367617,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 367618,
      "primary_message": "While the skillet heats up, peel, halve, and mince onion. Peel and mince garlic.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 367619,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add shrimp, onion, garlic, salt, and pepper. Cook, stirring occasionally, until shrimp are opaque, 3-4 minutes. ",
      "secondary_message": "⅓ cup butter, unsalted\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 367620,
      "primary_message": "When the shrimp are done, zest and juice lemons into the skillet. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 367621,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 367622,
      "primary_message": "Divide pitas between two baking sheet pans. Top with shrimp and sauce from the skillet, then sprinkle with cheese. Place in the oven and bake until the cheese is melted, 4-5 minutes. Remove from oven and cut into wedges.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 367623,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing and veggies; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 367624,
      "primary_message": "To serve, divide pizzas and salad between plates. Sprinkle pizzas with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
