  "instructions": [
    {
      "id": 314130,
      "primary_message": "Preheat the oven to 220°C (425°F). Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 314131,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh thyme\n1 ½ lemons\n6 leeks\n1 ½ small butternut squash"
    },
    {
      "id": 314132,
      "primary_message": "Slide thyme leaves off the stems; discard stems and place leaves in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 314133,
      "primary_message": "Zest and juice lemons into the bowl with the thyme; add honey and spices. Whisk to combine the marinade. ",
      "secondary_message": "1 tbsp honey\n1 tbsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 314134,
      "primary_message": "Pat chicken dry with paper towels, add to the bowl with the marinade, and turn to coat; set aside. ",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 314135,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. ",
      "secondary_message": null
    },
    {
      "id": 314136,
      "primary_message": "Slice leeks crosswise into 4-inch pieces. Transfer to the baking sheet and arrange side-by-side, cut-side down. ",
      "secondary_message": null
    },
    {
      "id": 314137,
      "primary_message": "Cut butter into small pieces.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 314138,
      "primary_message": "Arrange chicken on top of the leeks, pouring any leftover marinade on top. Sprinkle butter over leeks and chicken, then season with additional salt and pepper.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 314139,
      "primary_message": "Place baking sheet in the oven and roast, turning chicken halfway through, until leeks are tender and chicken is cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 314140,
      "primary_message": "Meanwhile, trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice. Place squash in a large pot, cover with hot water (from the tap), and bring to a boil. Once boiling, reduce heat to medium and simmer until squash is fork-tender, 12-14 minutes.",
      "secondary_message": null
    },
    {
      "id": 314141,
      "primary_message": "When the squash is done, drain in a colander and return to the pot; add cream, salt, and pepper. Using a potato masher, mash until smooth.",
      "secondary_message": "355 ml heavy whipping cream\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 314142,
      "primary_message": "To serve, divide mashed butternut squash, roasted leeks, and chicken between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
