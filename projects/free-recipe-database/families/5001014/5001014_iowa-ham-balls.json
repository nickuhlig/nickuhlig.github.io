  "instructions": [
    {
      "id": 1,
      "primary_message": "For the glaze: Adjust oven rack to middle position and preheat oven to 350℉ (175℃). In a small saucepan, combine all glaze ingredients and bring to a simmer over medium-high heat. Simmer, whisking frequently until sugar dissolves, then remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the ham balls: In a food processor, pulse the ham until finely ground, about 25 pulses; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, mix cracker crumbs, ginger, white pepper, and clove until well combined. Add buttermilk and stir to combine. Let sit until crumbs are softened and hydrated, about 5 minutes. Stir in ground ham to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a small bowl, beat eggs and soy sauce together, then add to the ham mixture and use your hands to combine. Add pork and mix gently, until fully incorporated. Divide meat mixture into 16 ham balls by rolling each meat portion between your wet hands to form balls, rewetting hands as needed. Nestle prepared ham balls into an oven-proof nonstick or lightly greased 9-by-9-inch baking dish or pan.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour the glaze evenly over the balls, being sure to coat each one. Bake until the glaze is reduced and lightly caramelized and ham balls are cooked through, tender, and register at least 160°F on an instant-read thermometer, 40 to 50 minutes. Spoon the ham balls onto plates to serve, topping with extra glaze.",
      "secondary_message": null
    }
  ],
