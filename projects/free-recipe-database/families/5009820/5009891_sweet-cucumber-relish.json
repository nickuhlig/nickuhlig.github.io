  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Quarter the white onions. Seed the red bell peppers. Seed the green bell peppers.",
      "secondary_message": "2 medium white onions\n2 medium red bell peppers\n1 large green bell peppers"
    },
    {
      "id": 1,
      "primary_message": "Grate the cucumbers using the grating disc of a food processor, or the medium-sized holes of a box grater. Use the steel blade of the food processor to pulse cucumbers until finely chopped. Repeat with onions and both peppers.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place chopped cucumbers, onions, and peppers in a medium bowl and mix in salt. Cover and allow to sit for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour vegetable mixture out into fine-mesh strainer. Rinse under cold water and strain, pushing the vegetables against the side of the strainer using a rubber spatula to remove as much water as possible.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a medium saucepan, bring vinegar, sugar, mustard seed, and celery seed to a boil over medium high heat, stirring to dissolve to sugar. Add vegetable mixture, reduce heat to medium-low, and simmer for 10 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Let cool to room temperature, transfer relish to an airtight container and store in the refrigerator.",
      "secondary_message": null
    }
  ],
