  "instructions": [
    {
      "id": 152807,
      "primary_message": "If using wooden skewers, place 4 skewers in a shallow dish of water to soak until you are ready to use them. ",
      "secondary_message": null
    },
    {
      "id": 152808,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 lemon\n½ small bunch green onions (scallions)\n½ English cucumber\n2 tomatoes\n½ small bunch Italian (flat-leaf) parsley\n½ small pkg fresh mint"
    },
    {
      "id": 152809,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 152810,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152811,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower, salt, and pepper; cook, stirring occasionally, until crisp-tender, 4-5 minutes. Transfer cauliflower to a baking sheet pan and spread out in an even layer to cool. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 152812,
      "primary_message": "Meanwhile, combine spices in a medium bowl; stir to combine. ",
      "secondary_message": "⅜ tsp salt\n1 tsp cumin\n¾ tsp paprika\n¼ tsp coriander\n¼ tsp black pepper\n1 pinch cayenne pepper"
    },
    {
      "id": 152813,
      "primary_message": "Cut the steak into 1½-inch cubes; transfer to the bowl with the spices and toss to coat; set aside.",
      "secondary_message": "⅓ kg striploin (New York strip) steak"
    },
    {
      "id": 152814,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152815,
      "primary_message": "Thread steak onto the skewers and place on a plate. Alternatively, you can cook the steak pieces directly on the grill/skillet without using skewers.",
      "secondary_message": null
    },
    {
      "id": 152816,
      "primary_message": "Coat the grill or skillet with oil; place kabobs on the grill, rotating every 2½ minutes, until browned and cooked through, about 10 minutes. Transfer to a plate and loosely cover with foil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 152817,
      "primary_message": "Meanwhile, grate the zest from the lemon and transfer to a medium bowl, then juice the lemon into the same bowl. Add the cauliflower and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 152818,
      "primary_message": "Peel and mince garlic. Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces. Transfer both to the bowl with the cauliflower. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 152819,
      "primary_message": "Peel and small dice the cucumber. Small dice the tomatoes; add both to the bowl with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 152820,
      "primary_message": "Shave parsley leaves off the stems; pick mint leaves off the stems. Discard the stems and mince the leaves. Add herbs, oil, salt, and pepper to the bowl with the cauliflower and stir to combine the tabouli salad. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 152821,
      "primary_message": "To serve, divide tabouli between plates or bowls. Place steak kabobs on top and enjoy! ",
      "secondary_message": null
    }
  ],
