  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine all ingredients in a large stockpot and cover with water by 4 cm. Bring to a boil, reduce to a bare simmer, and cook, stirring occasionally, until vegetables are completely tender and stock is aromatic and flavorful, about 40 minutes. Remove mushrooms with tongs and set aside for another use. Strain stock through a fine-mesh strainer. Discard solids. Allow stock to cool uncovered at room temperature for 1 hour. Cover and transfer to refrigerator until completely chilled. Refrigerated stock will keep for about 1 week.",
      "secondary_message": null
