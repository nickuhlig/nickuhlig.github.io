  "instructions": [
    {
      "id": 421389,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a small baking dish with a thin layer of oil and set aside.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 421390,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 421391,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, salt, and pepper. Cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 (227g ) pkg sliced white mushrooms\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 421392,
      "primary_message": "Meanwhile, slice polenta crosswise into ½-inch thick rounds.",
      "secondary_message": "1 (510 g) tube polenta, pre-cooked"
    },
    {
      "id": 421393,
      "primary_message": "Wash and dry spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 421394,
      "primary_message": "When the mushrooms are done, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add the pesto, stir to combine, and remove from heat.",
      "secondary_message": "½ cup basil pesto"
    },
    {
      "id": 421395,
      "primary_message": "Arrange polenta slices in the bottom of the baking dish, overlapping slightly. Top with the sautéed veggies and pesto, then sprinkle with cheese.",
      "secondary_message": "¾ cup shredded cheese, Italian blend"
    },
    {
      "id": 421396,
      "primary_message": "Place baking dish in the oven and bake until cheese is bubbly and golden, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 421397,
      "primary_message": "To serve, divide polenta bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
