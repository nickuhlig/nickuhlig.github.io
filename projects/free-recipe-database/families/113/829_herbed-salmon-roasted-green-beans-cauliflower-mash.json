  "instructions": [
    {
      "id": 10499,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": ""
    },
    {
      "id": 10500,
      "primary_message": "Fill a medium saucepan halfway with water and bring to a boil.",
      "secondary_message": "about 7 cups water"
    },
    {
      "id": 10501,
      "primary_message": "Wash green beans and trim ends. Transfer to a sheet pan. Drizzle with oil and season with salt and pepper; toss to coat.",
      "secondary_message": "0.227 kg green beans\r\n½ tbsp extra virgin olive oil\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 10502,
      "primary_message": "Spread out evenly and place in the oven. Tossing once halfway through, roast until tender-crisp, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 10503,
      "primary_message": "Wash and remove leaves from cauliflower; cut into bite-sized florets.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 10504,
      "primary_message": "Once water in saucepan is boiling, add cauliflower. Reduce heat to medium, cover, and cook until very tender, 12-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 10505,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 10506,
      "primary_message": "Season salmon fillet with salt, pepper, and parsley flakes.",
      "secondary_message": "0.34 kg salmon fillet\r\n1 pinch salt\r\n1 pinch black pepper\r\n1 pinch parsley flakes"
    },
    {
      "id": 10507,
      "primary_message": "Coat bottom of skillet with oil. Add salmon and cook until opaque, 3-4 minutes per side.",
      "secondary_message": "about 1 tbsp virgin coconut oil "
    },
    {
      "id": 10508,
      "primary_message": "Drain cauliflower and return to saucepan. Add oil, parsley flakes, salt, and pepper. Mash until smooth.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n½ tsp parsley flakes\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 10509,
      "primary_message": "Cut lemon into wedges.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 10510,
      "primary_message": "To serve, place cauliflower mash on a plate, add salmon on top, and have green beans on the side. Garnish with lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
