  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, cover yellow and brown mustard seeds with vinegar and 1/2 cup of beer. Cover and place in the refrigerator overnight.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small saucepan, mix together remaining 1⁄2 cup of beer, sugar, honey, salt, turmeric, and allspice. Bring to a boil over medium heat, remove from heat, and let cool slightly.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In the jar of a blender add mustard seeds with their soaking liquid and cooled mixture from saucepan. Puree until smooth. Transfer to an airtight container and refrigerate overnight before using.",
      "secondary_message": null
    }
  ],
