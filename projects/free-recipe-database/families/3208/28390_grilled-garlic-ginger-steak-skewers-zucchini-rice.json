  "instructions": [
    {
      "id": 454034,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 454035,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 454036,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 454037,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger; peel and mince garlic. Place both in a medium bowl along with soy sauce, oil, salt, and crushed red pepper, then stir to combine the marinade.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 clove garlic\n1 tbsp soy sauce\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 454038,
      "primary_message": "Pat steak dry with paper towels, cut into 1-inch cubes, and add to the bowl with the marinade. Toss to coat and set aside.",
      "secondary_message": "¾ lb striploin (New York strip) steak"
    },
    {
      "id": 454039,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 454040,
      "primary_message": "While the pan heats up, wash and dry zucchini. Using a clean cutting board, trim and slice lengthwise into ¼-inch thick planks. Transfer to a plate, drizzle with oil, then season with salt and pepper.",
      "secondary_message": "2 medium zucchini squash\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 454041,
      "primary_message": "Once the pan is hot, add zucchini and grill until charred and tender, 2-3 minutes per side. Return to the plate and cover loosely with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 454042,
      "primary_message": "Meanwhile, thread steak onto skewers and place on another plate. (If you don't have skewers, you can cook the steak directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 454043,
      "primary_message": "When the zucchini is done, add the skewers to the pan. Cook, turning occasionally, until the steak reaches desired doneness, 6-10 minutes. Add to the plate with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 454044,
      "primary_message": "To serve, divide rice, zucchini, and steak skewers between plates. Enjoy!",
      "secondary_message": null
    }
  ],
