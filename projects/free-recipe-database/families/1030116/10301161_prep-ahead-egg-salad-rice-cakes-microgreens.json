  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 (2-compartment) food storage containers and 4 sandwich bags.",
      "secondary_message": null
    },
    {
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, divide rice cakes between sandwich bags (two per bag). Seal bags and store at room temperature.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 stick celery\n½ small pkg chives\n1 (50 g) pkg microgreens"
    },
    {
      "primary_message": "Place mayo, vinegar, Dijon, and spices in a medium bowl, then whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n2 tsp white wine vinegar\n2 tsp Dijon mustard\n1 tsp curry powder\n½ tsp dill, dried\n½ tsp salt\n½ tsp black pepper\n¼ tsp paprika\n¼ tsp garlic powder"
    },
    {
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Chop chives into small pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and roughly chop the eggs. Add to the bowl and stir to combine the egg salad.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide egg salad and microgreens between food storage containers. Cover and refrigerate.",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, spoon egg salad over rice cakes, then top with microgreens. Enjoy!",
      "secondary_message": null
    }
  ],
