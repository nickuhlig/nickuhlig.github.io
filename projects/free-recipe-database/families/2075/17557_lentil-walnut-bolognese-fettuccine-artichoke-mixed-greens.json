  "instructions": [
    {
      "id": 342412,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n3 tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 342413,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 342414,
      "primary_message": "Medium dice tomatoes; add to the bowl with the carrot and celery.",
      "secondary_message": null
    },
    {
      "id": 342415,
      "primary_message": "Peel, halve, and small dice onions; add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 342416,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 342417,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n1 ½ tsp basil, dried\n1 ½ tsp oregano, dried"
    },
    {
      "id": 342418,
      "primary_message": "Add tomato sauce, water, lentils, and walnuts to the pot; stir to combine the bolognese. Bring to a boil over high heat, then reduce heat to medium-low and simmer, stirring occasionally, until lentils are soft, about 20 minutes.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n2 ¼ cup water\n¾ cup brown lentils, dried\n⅓ cup walnuts"
    },
    {
      "id": 342419,
      "primary_message": "While the bolognese is cooking, fill another large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta in a colander.",
      "secondary_message": "1 ½ tsp salt\n425 g fettuccine pasta"
    },
    {
      "id": 342420,
      "primary_message": "Meanwhile, peel and mince garlic; place in the reserved bowl. Add mayo, vinegar, Dijon, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp vegan mayonnaise\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n1 ½ tsp basil, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 342421,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing and set aside. ",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 342422,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 342423,
      "primary_message": "When the lentils are soft, use a potato masher to mash the bolognese until semi-smooth, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 342424,
      "primary_message": "Add drained pasta and half of the parsley to the pot with the bolognese, then toss to combine; remove from heat. (Reserve remaining parsley for garnish.)",
      "secondary_message": null
    },
    {
      "id": 342425,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 342426,
      "primary_message": "To serve, divide pasta and salad between plates; top pasta with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
