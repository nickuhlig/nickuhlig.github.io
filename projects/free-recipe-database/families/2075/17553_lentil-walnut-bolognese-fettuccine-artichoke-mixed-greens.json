  "instructions": [
    {
      "id": 342352,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n2 tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 342353,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 342354,
      "primary_message": "Medium dice tomatoes; add to the bowl with the carrot and celery.",
      "secondary_message": null
    },
    {
      "id": 342355,
      "primary_message": "Peel, halve, and small dice onion; add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 342356,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 342357,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n1 tsp basil, dried\n1 tsp oregano, dried"
    },
    {
      "id": 342358,
      "primary_message": "Add tomato sauce, water, lentils, and walnuts to the pot; stir to combine the bolognese. Bring to a boil over high heat, then reduce heat to medium-low and simmer, stirring occasionally, until lentils are soft, about 18 minutes.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n1 ½ cup water\n½ cup brown lentils, dried\n¼ cup walnuts"
    },
    {
      "id": 342359,
      "primary_message": "While the bolognese is cooking, fill another large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta in a colander.",
      "secondary_message": "1 tsp salt\n283 g fettuccine pasta"
    },
    {
      "id": 342360,
      "primary_message": "Meanwhile, peel and mince garlic; place in the reserved bowl. Add mayo, vinegar, Dijon, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp mayonnaise\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n1 tsp basil, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 342361,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing and set aside. ",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 342362,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 342363,
      "primary_message": "When the lentils are soft, use a potato masher to mash the bolognese until semi-smooth, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 342364,
      "primary_message": "Add drained pasta and half of the parsley to the pot with the bolognese, then toss to combine; remove from heat. (Reserve remaining parsley for garnish.)",
      "secondary_message": null
    },
    {
      "id": 342365,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 342366,
      "primary_message": "To serve, divide pasta and salad between plates; top pasta with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
