  "instructions": [
    {
      "id": 342382,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n1 tomato\n½ small bunch Italian (flat-leaf) parsley\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 342383,
      "primary_message": "Peel, trim, and small dice carrot; trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 342384,
      "primary_message": "Medium dice tomato; add to the bowl with the carrot and celery.",
      "secondary_message": null
    },
    {
      "id": 342385,
      "primary_message": "Peel, halve, and small dice onion; add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 342386,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 342387,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp basil, dried\n½ tsp oregano, dried"
    },
    {
      "id": 342388,
      "primary_message": "Add tomato sauce, water, lentils, and walnuts to the pan; stir to combine the bolognese. Bring to a boil over high heat, then reduce heat to medium-low and simmer, stirring occasionally, until lentils are soft, about 18 minutes.",
      "secondary_message": "1 (213 ml) can tomato sauce\n¾ cup water\n¼ cup brown lentils, dried\n⅛ cup walnuts"
    },
    {
      "id": 342389,
      "primary_message": "While the bolognese is cooking, fill another medium saucepan about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta in a colander.",
      "secondary_message": "½ tsp salt\n142 g fettuccine pasta"
    },
    {
      "id": 342390,
      "primary_message": "Meanwhile, peel and mince garlic; place in the reserved bowl. Add mayo, vinegar, Dijon, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 tbsp vegan mayonnaise\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n½ tsp basil, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 342391,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing and set aside. ",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 342392,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 342393,
      "primary_message": "When the lentils are soft, use a potato masher to mash the bolognese until semi-smooth, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 342394,
      "primary_message": "Add drained pasta and half of the parsley to the pan with the bolognese, then toss to combine; remove from heat. (Reserve remaining parsley for garnish.)",
      "secondary_message": null
    },
    {
      "id": 342395,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 342396,
      "primary_message": "To serve, divide pasta and salad between plates; top pasta with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
