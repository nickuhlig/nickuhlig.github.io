  "instructions": [
    {
      "id": 232062,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 grapefruits\n3 bunches kale\n1 small pkg fresh mint"
    },
    {
      "id": 232063,
      "primary_message": "Cut off skin and white pith from grapefruits. Slice between the membranes to release segments, transfer to a small bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 232064,
      "primary_message": "Peel and mince garlic; place in a large bowl, along with oil, peanut butter, vinegar, honey, fish sauce, and soy sauce. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp natural peanut butter\n2 tbsp rice vinegar\n2 tbsp honey\n1 tbsp fish sauce\n1 tbsp soy sauce"
    },
    {
      "id": 232065,
      "primary_message": "Pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 232066,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 232067,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add the chicken and grill until cooked through, 3-4 minutes per side; remove from heat and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 232068,
      "primary_message": "Meanwhile, using a clean cutting board, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 232069,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the kale and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 232070,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 232071,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 232072,
      "primary_message": "To serve, divide salad between plates or bowls. Top with grapefruit segments, grilled chicken, and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
