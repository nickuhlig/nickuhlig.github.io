  "instructions": [
    {
      "id": 384613,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 384614,
      "primary_message": "Once the water is boiling, add broccoli, noodles, and salt; cook until broccoli and noodles are tender, 5-6 minutes. Once done, drain and rinse thoroughly under warm water (from the tap); set aside.",
      "secondary_message": "1 ½ (510 g) bags broccoli florets\n425 g soba (buckwheat) noodles\n¾ tsp salt"
    },
    {
      "id": 384615,
      "primary_message": "Meanwhile, wash, dry, and juice limes into a large bowl. ",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 384616,
      "primary_message": "Add miso paste, vinegar, water, oil, and soy sauce to the bowl with the lime juice. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup miso paste, white\n⅓ cup rice vinegar\n3 tbsp water\n3 tbsp toasted sesame oil\n3 tbsp soy sauce"
    },
    {
      "id": 384617,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the dressing along with the carrots.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 384618,
      "primary_message": "Place chickens on the cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces. Add to the bowl, along with the broccoli and noodles, then toss to combine.",
      "secondary_message": "1 ½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 384619,
      "primary_message": "To serve, divide noodles, chicken, and veggies between bowls; sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
