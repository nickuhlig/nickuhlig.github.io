  "instructions": [
    {
      "id": 384543,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 384544,
      "primary_message": "Once the water is boiling, add broccoli, edamame, noodles, and salt; cook until veggies and noodles are tender, about 5 minutes. Once done, drain and rinse thoroughly under warm water (from the tap); set aside.",
      "secondary_message": "1 (18 oz) bag broccoli florets\n3 cups edamame\n10 oz soba (buckwheat) noodles\n½ tsp salt"
    },
    {
      "id": 384545,
      "primary_message": "Meanwhile, wash, dry, and juice lime into a large bowl. ",
      "secondary_message": "1 lime"
    },
    {
      "id": 384546,
      "primary_message": "Add miso paste, vinegar, water, oil, and soy sauce to the bowl with the lime juice. Whisk to combine the dressing.",
      "secondary_message": "¼ cup miso paste, white\n¼ cup rice vinegar\n2 tbsp water\n2 tbsp toasted sesame oil\n2 tbsp soy sauce"
    },
    {
      "id": 384547,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 384548,
      "primary_message": "Add broccoli, edamame, noodles, and carrots to the bowl. Toss to combine. ",
      "secondary_message": "1 (10 oz) bag shredded carrots"
    },
    {
      "id": 384549,
      "primary_message": "To serve, divide noodles, edamame, and veggies between bowls; sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "4 tsp sesame seeds"
    }
  ],
