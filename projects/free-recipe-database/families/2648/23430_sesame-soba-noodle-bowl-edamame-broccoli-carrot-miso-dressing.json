  "instructions": [
    {
      "id": 384550,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 384551,
      "primary_message": "Once the water is boiling, add broccoli, edamame, noodles, and salt; cook until veggies and noodles are tender, 5-6 minutes. Once done, drain and rinse thoroughly under warm water (from the tap); set aside.",
      "secondary_message": "1 ½ (18 oz) bags broccoli florets\n4 ½ cups edamame\n15 oz soba (buckwheat) noodles\n¾ tsp salt"
    },
    {
      "id": 384552,
      "primary_message": "Meanwhile, wash, dry, and juice limes into a large bowl. ",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 384553,
      "primary_message": "Add miso paste, vinegar, water, oil, and soy sauce to the bowl with the lime juice. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup miso paste, white\n⅓ cup rice vinegar\n3 tbsp water\n3 tbsp toasted sesame oil\n3 tbsp soy sauce"
    },
    {
      "id": 384554,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 384555,
      "primary_message": "Add broccoli, edamame, noodles, and carrots to the bowl. Toss to combine. ",
      "secondary_message": "1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 384556,
      "primary_message": "To serve, divide noodles, edamame, and veggies between bowls; sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
