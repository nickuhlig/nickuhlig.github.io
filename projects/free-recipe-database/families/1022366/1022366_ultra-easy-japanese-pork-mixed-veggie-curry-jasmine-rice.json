  "instructions": [
    {
      "primary_message": "Preheat a large pot over medium-high heat. Once the pot is hot, add oil and swirl to coat the bottom. Add pork and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil\n16 oz lean ground pork\n¼ tsp black pepper"
    },
    {
      "primary_message": "Add water to the pot and bring to a boil. Once boiling, add veggies, reduce heat, and simmer until veggies are tender, 5-6 minutes. Remove from heat.",
      "secondary_message": "3 cups frozen mixed vegetables"
    },
    {
      "primary_message": "Crumble curry mix block into the pot. Stir until incorporated, then return to medium heat and simmer until thickened, 3-5 minutes more. Remove from heat.",
      "secondary_message": "1 (3.2 oz) pkg Japanese curry mix"
    },
    {
      "primary_message": "Meanwhile, working one at a time, place rice pouches in the microwave, seam-side up. Heat on high for 3-4 minutes (until pouch balloons up with steam for 30 seconds). Allow steam to vent before opening pouch. (Alternatively, rice can be heated in a saucepan according to package instructions.)",
      "secondary_message": "2 (10 oz) pouch frozen Jasmine rice, pre-cooked"
    },
    {
      "primary_message": "To serve, divide rice and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
