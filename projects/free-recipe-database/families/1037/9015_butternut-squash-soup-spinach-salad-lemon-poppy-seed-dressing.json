  "instructions": [
    {
      "id": 140223,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium carrots\n2 (2 ½ cm) pieces ginger root\n2 small butternut squash\n2 lemons\n2 Gala apples\n2 (142 g) pkg baby spinach"
    },
    {
      "id": 140224,
      "primary_message": "Peel and small dice the carrots. Peel and small dice the onions. Peel and mince or grate the ginger. ",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 140225,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 140226,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 140227,
      "primary_message": "Add the carrots, onions, and ginger to the pot. Cook, stirring occasionally, until the veggies are tender, 5-6 minutes. ",
      "secondary_message": null
    },
    {
      "id": 140228,
      "primary_message": "Meanwhile, trim off and discard the ends of each squash. Halve squashes lengthwise and scrape out the seeds; peel and small dice the squash. You should have about 8 cups of diced squash. ",
      "secondary_message": null
    },
    {
      "id": 140229,
      "primary_message": "Add the squash, broth, and spices to the pot. Bring to a boil over high heat, then reduce to a simmer and cook until squash is fork-tender, 10-15 minutes. ",
      "secondary_message": "1420 ml chicken or vegetable broth\n1 tsp cinnamon\n1 tsp curry powder\n1 tsp salt"
    },
    {
      "id": 140230,
      "primary_message": "Juice half of the lemons into a large bowl; add the oil, honey, Dijon, onion powder, and poppy seeds. Whisk to combine the dressing. ",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tsp honey\n½ tsp Dijon mustard\n½ tsp onion powder\n½ tsp poppy seeds"
    },
    {
      "id": 140231,
      "primary_message": "Core and medium dice apples. ",
      "secondary_message": null
    },
    {
      "id": 140232,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 140233,
      "primary_message": "Add the spinach, feta, walnuts, cranberries, and apples to the bowl with the dressing. Toss to combine and set aside. ",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n½ cup dried cranberries"
    },
    {
      "id": 140234,
      "primary_message": "Once the squash is tender, juice remaining lemon into the pot. Add the milk. Stir to combine and remove from the heat. ",
      "secondary_message": "237 ml whole milk"
    },
    {
      "id": 140235,
      "primary_message": "Pureé the soup with an immersion (hand) blender or regular blender.",
      "secondary_message": null
    },
    {
      "id": 140236,
      "primary_message": "To serve, divide the soup between bowls and top with pumpkin seeds. Serve with the salad and enjoy! ",
      "secondary_message": "¼ cup pumpkin seeds"
    }
  ],
