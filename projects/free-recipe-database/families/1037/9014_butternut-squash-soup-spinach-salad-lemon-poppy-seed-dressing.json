  "instructions": [
    {
      "id": 140209,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium carrot\n1 (2 ½ cm) piece ginger root\n1 small butternut squash\n1 lemon\n1 Gala apple\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 140210,
      "primary_message": "Peel and small dice the carrot. Peel and small dice the onion. Peel and mince or grate the ginger. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 140211,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 140212,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 140213,
      "primary_message": "Add the carrot, onion, and ginger to the pot. Cook, stirring occasionally, until the veggies are tender, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 140214,
      "primary_message": "Meanwhile, trim off and discard the ends of the squash. Halve the squash lengthwise and scrape out the seeds; peel and small dice the squash. You should have about 4 cups of diced squash. ",
      "secondary_message": null
    },
    {
      "id": 140215,
      "primary_message": "Add the squash, broth, and spices to the pot. Bring to a boil over high heat, then reduce to a simmer and cook until squash is fork-tender, 10-15 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n½ tsp cinnamon\n½ tsp curry powder\n½ tsp salt"
    },
    {
      "id": 140216,
      "primary_message": "Juice half of the lemon into a large bowl; add the oil, honey, Dijon, onion powder, and poppy seeds. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp honey\n¼ tsp Dijon mustard\n¼ tsp onion powder\n¼ tsp poppy seeds"
    },
    {
      "id": 140217,
      "primary_message": "Core and medium dice apple. ",
      "secondary_message": null
    },
    {
      "id": 140218,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "⅛ cup walnuts"
    },
    {
      "id": 140219,
      "primary_message": "Add the spinach, feta, walnuts, cranberries, and apple to the bowl with the dressing. Toss to combine and set aside. ",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n¼ cup dried cranberries"
    },
    {
      "id": 140220,
      "primary_message": "Once the squash is tender, juice remaining lemon into the pot. Add the milk. Stir to combine and remove from the heat. ",
      "secondary_message": "118 ml (½ cup) whole milk"
    },
    {
      "id": 140221,
      "primary_message": "Pureé the soup with an immersion (hand) blender or regular blender.",
      "secondary_message": null
    },
    {
      "id": 140222,
      "primary_message": "To serve, divide the soup between bowls and top with pumpkin seeds. Serve with the salad and enjoy! ",
      "secondary_message": "⅛ cup pumpkin seeds"
    }
  ],
