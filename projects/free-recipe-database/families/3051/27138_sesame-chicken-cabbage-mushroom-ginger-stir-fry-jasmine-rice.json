  "instructions": [
    {
      "id": 437297,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 437298,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n1 ½ medium heads napa cabbage\n0.68 kg cremini mushrooms"
    },
    {
      "id": 437299,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 437300,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a small bowl along with soy sauce, oil, sesame seeds, water, cornstarch, vinegar, sugar, chili-garlic sauce, and pepper. Stir to combine the stir-fry sauce and set aside.",
      "secondary_message": "6 cloves garlic\n½ cup soy sauce\n3 tbsp toasted sesame oil\n3 tbsp sesame seeds\n3 tbsp water\n2 tbsp cornstarch\n1 ½ tbsp rice vinegar\n1 ½ tbsp brown sugar\n1 tbsp chili-garlic sauce\n½ tsp black pepper"
    },
    {
      "id": 437301,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a large bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 437302,
      "primary_message": "Trim off and discard root end of each cabbage; quarter lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the green onions.",
      "secondary_message": null
    },
    {
      "id": 437303,
      "primary_message": "Thinly slice mushrooms. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 437304,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. ",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 437305,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 437306,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until starting to brown, about 4 minutes. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 437307,
      "primary_message": "Add veggies to the pot and stir-fry until veggies are tender and chicken is cooked through, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 437308,
      "primary_message": "Add stir-fry sauce to the pot and continue to cook until sauce thickens, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 437309,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
