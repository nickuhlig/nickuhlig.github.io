  "instructions": [
    {
      "id": 437271,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 437272,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ small bunch green onions (scallions)\n½ medium head napa cabbage\n0.23 kg cremini mushrooms"
    },
    {
      "id": 437273,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 437274,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a small bowl along with soy sauce, oil, sesame seeds, water, cornstarch, vinegar, sugar, chili-garlic sauce, and pepper. Stir to combine the stir-fry sauce and set aside.",
      "secondary_message": "2 cloves garlic\n3 tbsp soy sauce\n1 tbsp toasted sesame oil\n1 tbsp sesame seeds\n1 tbsp water\n2 tsp cornstarch\n1 ½ tsp rice vinegar\n1 ½ tsp brown sugar\n1 tsp chili-garlic sauce\n⅛ tsp black pepper"
    },
    {
      "id": 437275,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 437276,
      "primary_message": "Trim off and discard root end of cabbage; quarter lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the green onions.",
      "secondary_message": null
    },
    {
      "id": 437277,
      "primary_message": "Thinly slice mushrooms. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 437278,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 437279,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and cut into bite-sized pieces. ",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 437280,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until starting to brown, about 2 minutes. ",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 437281,
      "primary_message": "Add veggies to the skillet and stir-fry until veggies are tender and chicken is cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 437282,
      "primary_message": "Add stir-fry sauce to the skillet and continue to cook until sauce thickens, about 30 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 437283,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
