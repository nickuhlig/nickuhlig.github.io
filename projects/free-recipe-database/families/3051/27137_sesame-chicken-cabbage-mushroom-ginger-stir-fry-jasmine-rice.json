  "instructions": [
    {
      "id": 437284,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 437285,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n1 medium head napa cabbage\n0.45 kg cremini mushrooms"
    },
    {
      "id": 437286,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 437287,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a small bowl along with soy sauce, oil, sesame seeds, water, cornstarch, vinegar, sugar, chili-garlic sauce, and pepper. Stir to combine the stir-fry sauce and set aside.",
      "secondary_message": "4 cloves garlic\n⅓ cup soy sauce\n2 tbsp toasted sesame oil\n2 tbsp sesame seeds\n2 tbsp water\n4 tsp cornstarch\n1 tbsp rice vinegar\n1 tbsp brown sugar\n2 tsp chili-garlic sauce\n¼ tsp black pepper"
    },
    {
      "id": 437288,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a large bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 437289,
      "primary_message": "Trim off and discard root end of cabbage; quarter lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the green onions.",
      "secondary_message": null
    },
    {
      "id": 437290,
      "primary_message": "Thinly slice mushrooms. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 437291,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 437292,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and cut into bite-sized pieces. ",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 437293,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until starting to brown, about 3 minutes. ",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 437294,
      "primary_message": "Add veggies to the skillet and stir-fry until veggies are tender and chicken is cooked through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 437295,
      "primary_message": "Add stir-fry sauce to the skillet and continue to cook until sauce thickens, about 30 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 437296,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
