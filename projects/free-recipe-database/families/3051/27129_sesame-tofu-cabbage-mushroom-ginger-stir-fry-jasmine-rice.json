  "instructions": [
    {
      "id": 437180,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 437181,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 437182,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ medium heads napa cabbage\n1 ½ lb cremini mushrooms\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 437183,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 437184,
      "primary_message": "While the rice is cooking, trim and cut green onions crosswise into thin pieces. Place half in a large bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 437185,
      "primary_message": "Trim off and discard root end of each cabbage; quarter lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the green onions.",
      "secondary_message": null
    },
    {
      "id": 437186,
      "primary_message": "Thinly slice mushrooms. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 437187,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 437188,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Crumble tofu into large pieces with your fingers and add to the pot. Cook, stirring occasionally, until tofu is golden brown, 8-10 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 437189,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl along with soy sauce, oil, sesame seeds, water, cornstarch, vinegar, sugar, chili-garlic sauce, and pepper. Stir to combine the stir-fry sauce and set aside.",
      "secondary_message": "6 cloves garlic\n½ cup soy sauce\n3 tbsp toasted sesame oil\n3 tbsp sesame seeds\n3 tbsp water\n2 tbsp cornstarch\n1 ½ tbsp rice vinegar\n1 ½ tbsp brown sugar\n1 tbsp chili-garlic sauce\n½ tsp black pepper"
    },
    {
      "id": 437190,
      "primary_message": "When the tofu is done, add veggies to the pot. Stir-fry until tender, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 437191,
      "primary_message": "Add stir-fry sauce to the pot and continue to cook until sauce thickens, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 437192,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
