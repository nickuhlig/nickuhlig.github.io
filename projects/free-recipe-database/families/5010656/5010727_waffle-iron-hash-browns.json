  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat waffle iron. If it has temperature controls, set it to medium.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Squeeze shredded potato with a towel until it’s as dry as possible.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a mixing bowl, combine shredded potato, salt, and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Using a silicone brush or paper towel, carefully grease both sides of waffle iron with butter.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pile shredded potatoes into waffle iron, over-stuffing it a bit, and close lid. (The pressure of the lid will compress the potatoes and help them emerge as a cohesive, waffled unit.) Cook for 2 minutes, then press down on lid to further compress potatoes (be careful: lid may be hot).",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Continue cooking potatoes for 5 minutes longer, then begin checking them: They are ready when potatoes are golden brown all over, about 1 to 2 minutes longer. Serve hot with eggs or any other breakfast foods.",
      "secondary_message": null
    }
  ],
