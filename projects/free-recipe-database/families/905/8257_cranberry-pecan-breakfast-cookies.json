  "instructions": [
    {
      "id": 125546,
      "primary_message": "Preheat the oven to 175°C (350°F) and place the rack in the center position. Line a sheet pan with parchment paper (optional).",
      "secondary_message": null
    },
    {
      "id": 125547,
      "primary_message": "Peel banana, break into chunks, and place in a medium bowl. ",
      "secondary_message": "1 banana"
    },
    {
      "id": 125548,
      "primary_message": "Crack the egg into the bowl and add honey. Use a fork or potato masher to mash the ingredients together.",
      "secondary_message": "1 egg\n1 tbsp honey"
    },
    {
      "id": 125549,
      "primary_message": "Roughly chop the pecans and add the bowl.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 125550,
      "primary_message": "Add oats, cinnamon, and cranberries to the bowl. Stir until all ingredients are well combined. ",
      "secondary_message": "1 ⅓ cup oats, quick cooking\n½ tsp cinnamon\n¼ cup dried cranberries"
    },
    {
      "id": 125551,
      "primary_message": "Use a ¼ cup measure to evenly scoop the batter onto the sheet pan. Press each cookie flat with your fingertips. Place in the oven and bake for 12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 125552,
      "primary_message": "Allow to cool for a few minutes before transferring to plates, enjoy! ",
      "secondary_message": null
    }
  ],
