  "instructions": [
    {
      "id": 475455,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 475456,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 fennel bulb\n1 red bell pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 475457,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 475458,
      "primary_message": "Trim, seed, and large dice bell pepper. Add to the baking sheet with the fennel. ",
      "secondary_message": null
    },
    {
      "id": 475459,
      "primary_message": "Roughly chop walnuts and add to the baking sheet. Drizzle walnuts and veggies with oil, then season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "⅓ cup walnuts\n2 tsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 475460,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 475461,
      "primary_message": "Meanwhile, fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "½ tsp salt\n142 g penne pasta"
    },
    {
      "id": 475462,
      "primary_message": "While the pasta is cooking, peel and mince garlic. Place in a medium bowl along with oil, vinegar, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 475463,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 475464,
      "primary_message": "Drain and thinly slice artichoke hearts and sun-dried tomatoes. Add both to the bowl.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated\n6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 475465,
      "primary_message": "When the veggies and walnuts are done, remove from the oven. Add to the bowl, along with cooled pasta, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 475466,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "½ (113 g) log goat cheese"
    }
  ],
