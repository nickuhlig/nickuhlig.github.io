  "instructions": [
    {
      "id": 475479,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 475480,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 fennel bulbs\n3 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 475481,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 475482,
      "primary_message": "Trim, seed, and large dice bell peppers. Add to the baking sheets with the fennel. ",
      "secondary_message": null
    },
    {
      "id": 475483,
      "primary_message": "Roughly chop walnuts and add to the baking sheets. Drizzle walnuts and veggies with oil, then season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "1 cup walnuts\n2 tbsp extra virgin olive oil\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 475484,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 475485,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g penne pasta"
    },
    {
      "id": 475486,
      "primary_message": "While the pasta is cooking, peel and mince garlic. Place in a large bowl along with oil, vinegar, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 475487,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 475488,
      "primary_message": "Drain and thinly slice artichoke hearts and sun-dried tomatoes. Add both to the bowl.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated\n18 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 475489,
      "primary_message": "When the veggies and walnuts are done, remove from the oven. Add to the bowl, along with cooled pasta, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 475490,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    }
  ],
