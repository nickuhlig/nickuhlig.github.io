  "instructions": [
    {
      "id": 247654,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 lemons\n3 sticks celery\n1 small pkg chives\n1 small bunch fresh dill\n3 Gala apples\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 247655,
      "primary_message": "Juice half the lemons into a large bowl. (Set remaining lemons aside for later.)",
      "secondary_message": null
    },
    {
      "id": 247656,
      "primary_message": "Drain and rinse chickpeas. Transfer half the chickpeas to the bowl with the lemon juice; add mayo and spices. Using a fork or potato masher, mash until smooth.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n⅓ cup mayonnaise\n1 ½ tsp curry powder\n¾ tsp turmeric, ground\n½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 247657,
      "primary_message": "Add remaining chickpeas to the bowl and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 247658,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 247659,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 247660,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the chickpea salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 247661,
      "primary_message": "Juice remaining lemons into another large bowl. Add oil, honey, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp honey\n1 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 247662,
      "primary_message": "Quarter and core apples, then thinly slice each quarter; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 247663,
      "primary_message": "Add mixed greens, feta, and pumpkin seeds to the bowl. Toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup pumpkin seeds"
    },
    {
      "id": 247664,
      "primary_message": "To serve, divide green salad between plates or bowls, top with curried chickpea salad, and enjoy!",
      "secondary_message": null
    }
  ],
