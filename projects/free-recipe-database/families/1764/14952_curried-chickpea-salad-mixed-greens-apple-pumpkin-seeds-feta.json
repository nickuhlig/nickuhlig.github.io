  "instructions": [
    {
      "id": 247632,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n1 stick celery\n½ small pkg chives\n½ small bunch fresh dill\n1 Gala apple\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 247633,
      "primary_message": "Juice half the lemon into a medium bowl. (Set remaining lemon aside for later.)",
      "secondary_message": null
    },
    {
      "id": 247634,
      "primary_message": "Drain and rinse chickpeas. Transfer half the chickpeas to the bowl with the lemon juice; add mayo and spices. Using a fork or potato masher, mash until smooth.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)\n2 tbsp mayonnaise\n½ tsp curry powder\n¼ tsp turmeric, ground\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder"
    },
    {
      "id": 247635,
      "primary_message": "Add remaining chickpeas to the bowl and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 247636,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 247637,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 247638,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the chickpea salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 247639,
      "primary_message": "Juice remaining lemon into another medium bowl. Add oil, honey, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp honey\n1 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 247640,
      "primary_message": "Quarter and core apple, then thinly slice each quarter; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 247641,
      "primary_message": "Add mixed greens, feta, and pumpkin seeds to the bowl. Toss to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese\n¼ cup pumpkin seeds"
    },
    {
      "id": 247642,
      "primary_message": "To serve, divide green salad between plates or bowls, top with curried chickpea salad, and enjoy!",
      "secondary_message": null
    }
  ],
