  "instructions": [
    {
      "id": 1,
      "primary_message": "Melt butter in medium saucepan over medium heat. Add onion and cook until softened, about 5 minutes. Add garlic and cook until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add tomato sauce, cherries, brown sugar, orange juice, molasses, cider vinegar, ancho chile powder, mustard, salt, white pepper, and cayenne and stir to combine. Bring to a boil, then reduce heat to low and simmer until slightly thickened, about 30 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer sauce to the jar of a blender and blend until smooth. Let cool to room temperature, transfer to a jar and store in refrigerator for up to 1 month.",
      "secondary_message": null
    }
  ],
