  "instructions": [
    {
      "id": 324679,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n3 limes\n1 ½ jalapeño peppers\n1 ½ mangoes\n1 ½ small heads red cabbage\n3 red bell peppers"
    },
    {
      "id": 324680,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a large bowl and half in a blender. ",
      "secondary_message": null
    },
    {
      "id": 324681,
      "primary_message": "Juice half of the limes into the bowl with the cilantro; juice remaining limes into the blender and set aside. ",
      "secondary_message": null
    },
    {
      "id": 324682,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the cilantro. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 324683,
      "primary_message": "Peel and mince shallots; add to the bowl along with oil, salt, and cumin; whisk to combine the dressing. ",
      "secondary_message": "2 shallots\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp cumin, ground"
    },
    {
      "id": 324684,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 324685,
      "primary_message": "Quarter each cabbage lengthwise, then cut out and discard the core; slice crosswise into thin (shred-like) strips and add to the bowl. Stir to combine the slaw and set aside.",
      "secondary_message": null
    },
    {
      "id": 324686,
      "primary_message": "Trim, seed, and thinly slice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 324687,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 324688,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper and salt. Cook, stirring occasionally, until softened, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 324689,
      "primary_message": "Meanwhile, drain and rinse beans; add to the blender with the cilantro and lime juice.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 324690,
      "primary_message": "Peel garlic; add to the blender along with water, pumpkin seeds, and spices. Blend on high until smooth.",
      "secondary_message": "3 cloves garlic\n1 ½ cup water\n¾ cup pumpkin seeds\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp salt"
    },
    {
      "id": 324691,
      "primary_message": "Place tortillas on a flat surface and spread each with an even layer of black bean spread. Top with bell peppers and a small portion of slaw (reserving the rest for serving); roll tightly to close.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 324692,
      "primary_message": "Cut wraps in half and divide between plates; serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
