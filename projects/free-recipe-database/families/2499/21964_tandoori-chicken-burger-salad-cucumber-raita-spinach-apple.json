  "instructions": [
    {
      "id": 368756,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ small bunch cilantro\n½ English cucumber\n1 lime\n1 Granny Smith apple\n½ avocado\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 368757,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 368758,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the ginger and garlic. ",
      "secondary_message": null
    },
    {
      "id": 368759,
      "primary_message": "Add chicken, almond meal, and spices to the bowl; mix with your hands until well combined. Form the chicken mixture into 2 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "0.23 kg ground chicken\n2 tbsp almond meal/flour\n2 tsp curry powder\n½ tsp paprika\n½ tsp salt"
    },
    {
      "id": 368760,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368761,
      "primary_message": "Once the grill pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 368762,
      "primary_message": "Meanwhile, trim and coarsely grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. ",
      "secondary_message": null
    },
    {
      "id": 368763,
      "primary_message": "Place cucumber in a small bowl, then add yogurt and salt. Whisk to combine the raita and set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\n⅛ tsp salt"
    },
    {
      "id": 368764,
      "primary_message": "Juice lime into in a clean medium bowl. Add oil, honey, and salt; whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt"
    },
    {
      "id": 368765,
      "primary_message": "Quarter, core, and thinly slice apple. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 368766,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 368767,
      "primary_message": "Add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 368768,
      "primary_message": "To serve, divide salad and burger patties between plates or bowls. Top burgers with raita and enjoy!",
      "secondary_message": null
    }
  ],
