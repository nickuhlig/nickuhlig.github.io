  "instructions": [
    {
      "id": 368782,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro\n1 ½ English cucumbers\n3 limes\n3 Granny Smith apples\n1 ½ avocados\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 368783,
      "primary_message": "Peel and mince ginger and garlic. Place both in a large bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 368784,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the ginger and garlic. ",
      "secondary_message": null
    },
    {
      "id": 368785,
      "primary_message": "Add chicken, almond meal, and spices to the bowl; mix with your hands until well combined. Form the chicken mixture into 6 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "0.68 kg ground chicken\n⅓ cup almond meal/flour\n2 tbsp curry powder\n1 ½ tsp paprika\n1 ½ tsp salt"
    },
    {
      "id": 368786,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368787,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 368788,
      "primary_message": "Meanwhile, trim and coarsely grate cucumbers. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. ",
      "secondary_message": null
    },
    {
      "id": 368789,
      "primary_message": "Place cucumber in a medium bowl, then add yogurt and salt. Whisk to combine the raita and set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 368790,
      "primary_message": "Juice limes into in a clean large bowl. Add oil, honey, and salt; whisk to combine the dressing. ",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 368791,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 368792,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 368793,
      "primary_message": "Add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 368794,
      "primary_message": "To serve, divide salad and burger patties between plates or bowls. Top burgers with raita and enjoy!",
      "secondary_message": null
    }
  ],
