  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (1 inch) piece ginger root\n½ small bunch cilantro\n½ English cucumber\n½ lime\n1 Granny Smith apple\n½ (5 oz) pkg baby spinach"
    },
    {
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the ginger and garlic. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add chicken, bread crumbs, and spices to the bowl; mix with your hands until well combined. Form the chicken mixture into 2 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "½ lb ground chicken\n2 tsp curry powder\n½ tsp paprika\nsalt"
    },
    {
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the grill pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, trim and coarsely grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. ",
      "secondary_message": null
    },
    {
      "primary_message": "Place cucumber in a small bowl, then add yogurt and salt. Whisk to combine the raita and set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\nsalt"
    },
    {
      "primary_message": "Juice lime into in a clean medium bowl. Add oil, honey, and salt; whisk to combine the dressing. ",
      "secondary_message": "extra virgin olive oil\n½ tsp honey\nsalt"
    },
    {
      "primary_message": "Quarter, core, and thinly slice apple. Add to the bowl with the dressing, along with the spinach, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "primary_message": "Toast buns if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "To assemble the burgers, spread the bottom half of each bun with half of the raita. Layer with burger patties and remaining raita, then close with the top half of the buns. ",
      "secondary_message": null
    },
    {
      "primary_message": "Divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
