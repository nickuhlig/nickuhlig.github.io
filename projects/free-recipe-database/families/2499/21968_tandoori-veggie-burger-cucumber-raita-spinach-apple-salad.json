  "instructions": [
    {
      "id": 368808,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 small bunch cilantro\n1 English cucumber\n1 lime\n2 Granny Smith apples\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 368809,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 368810,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the ginger and garlic. ",
      "secondary_message": null
    },
    {
      "id": 368811,
      "primary_message": "Add veggie ground, bread crumbs, and spices to the bowl; mix with your hands until well combined. Form the veggie ground mixture into 4 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "454 g veggie ground, plant based\n½ cup panko bread crumbs\n4 tsp curry powder\n1 tsp paprika\n½ tsp salt"
    },
    {
      "id": 368812,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368813,
      "primary_message": "Once the grill pan is hot, coat with oil. Add patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes. Once done, transfer to a clean plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 368814,
      "primary_message": "Meanwhile, trim and coarsely grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. ",
      "secondary_message": null
    },
    {
      "id": 368815,
      "primary_message": "Place cucumber in a small bowl, then add yogurt and salt. Whisk to combine the raita and set aside. ",
      "secondary_message": "1 cup plain Greek yogurt\n¼ tsp salt"
    },
    {
      "id": 368816,
      "primary_message": "Juice lime into in a clean medium bowl. Add oil, honey, and salt; whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt"
    },
    {
      "id": 368817,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl with the dressing, along with the spinach, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 368818,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 368819,
      "primary_message": "To assemble the burgers, spread the bottom half of each bun with half of the raita. Layer with burger patties and remaining raita, then close with the top half of the buns.",
      "secondary_message": null
    },
    {
      "id": 368820,
      "primary_message": "Divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
