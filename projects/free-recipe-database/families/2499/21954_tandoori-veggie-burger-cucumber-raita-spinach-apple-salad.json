  "instructions": [
    {
      "id": 368626,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 small bunch cilantro\n1 ½ English cucumbers\n1 ½ limes\n3 Granny Smith apples\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 368627,
      "primary_message": "Peel and mince ginger and garlic. Place both in a large bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 368628,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the ginger and garlic. ",
      "secondary_message": null
    },
    {
      "id": 368629,
      "primary_message": "Add veggie ground, bread crumbs, and spices to the bowl; mix with your hands until well combined. Form the veggie ground mixture into 6 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "24 oz veggie ground, plant based\n¾ cup panko bread crumbs\n2 tbsp curry powder\n1 ½ tsp paprika\n¾ tsp salt"
    },
    {
      "id": 368630,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368631,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes. Once done, transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 368632,
      "primary_message": "Meanwhile, trim and coarsely grate cucumbers. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. ",
      "secondary_message": null
    },
    {
      "id": 368633,
      "primary_message": "Place cucumber in a medium bowl, then add yogurt and salt. Whisk to combine the raita and set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 368634,
      "primary_message": "Juice limes into in a clean large bowl. Add oil, honey, and salt; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp honey\n½ tsp salt"
    },
    {
      "id": 368635,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl with the dressing, along with the spinach, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 368636,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 368637,
      "primary_message": "To assemble the burgers, spread the bottom half of each bun with half of the raita. Layer with burger patties and remaining raita, then close with the top half of the buns.",
      "secondary_message": null
    },
    {
      "id": 368638,
      "primary_message": "Divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
