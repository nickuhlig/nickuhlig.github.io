  "instructions": [
    {
      "id": 260705,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 260706,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ small pkgs fresh basil\n6 tomatoes\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 260707,
      "primary_message": "Place mayo, nutritional yeast, and spices in a large bowl; whisk to combine the creamy dressing.",
      "secondary_message": "¾ cup vegan mayonnaise\n⅓ cup nutritional yeast flakes\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 260708,
      "primary_message": "Finely chop pine nuts and add to the bowl with the creamy dressing.",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 260709,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 260710,
      "primary_message": "Crumble tofu with your fingers into the bowl; using a fork, mash to combine the tofu salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 260711,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 260712,
      "primary_message": "Slice tomatoes into rounds.",
      "secondary_message": null
    },
    {
      "id": 260713,
      "primary_message": "Divide bread between two baking sheets. Working in batches, place baking sheets in the oven and broil until bread is golden brown and toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 260714,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, salt, and pepper in another large bowl. Whisk to combine the vinaigrette.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n3 pinch brown sugar\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 260715,
      "primary_message": "Add mixed greens to the bowl with the vinaigrette and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 260716,
      "primary_message": "To serve, divide toast between plates; top with dressed greens, tofu salad, and tomato slices. Season tomatoes with salt and pepper. Enjoy!",
      "secondary_message": "½ tsp salt\n3 pinch black pepper"
    }
  ],
