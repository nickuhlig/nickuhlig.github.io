  "instructions": [
    {
      "id": 615799,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 615800,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 615801,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n1 ½ lb cremini mushrooms\n3 (1 inch) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 615802,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 615803,
      "primary_message": "While the rice is cooking, trim and medium dice zucchini. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 615804,
      "primary_message": "Quarter mushrooms. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 615805,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 615806,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 615807,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 615808,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 615809,
      "primary_message": "Meanwhile, medium dice tofu.",
      "secondary_message": null
    },
    {
      "id": 615810,
      "primary_message": "When the veggies are softened, add tomato paste and spices to the pot. Cook, stirring frequently, until fragrant, 1-2 minutes.",
      "secondary_message": "3 tbsp tomato paste\n2 tbsp curry powder\n1 tbsp garam masala\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 615811,
      "primary_message": "Add tofu, coconut milk, and water to the pot; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until thickened slightly, 5-7 minutes more. ",
      "secondary_message": "1 ½ (13.5 fl oz) cans coconut milk\n⅓ cup water"
    },
    {
      "id": 615812,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. When the curry is thickened, add cilantro to the pot and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 615813,
      "primary_message": "To serve, divide rice and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
