  "instructions": [
    {
      "id": 615784,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 615785,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 615786,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n1 lb cremini mushrooms\n2 (1 inch) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 615787,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 615788,
      "primary_message": "While the rice is cooking, trim and medium dice zucchini. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 615789,
      "primary_message": "Quarter mushrooms. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 615790,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 615791,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 615792,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 615793,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 615794,
      "primary_message": "Meanwhile, medium dice tofu.",
      "secondary_message": null
    },
    {
      "id": 615795,
      "primary_message": "When the veggies are softened, add tomato paste and spices to the skillet. Cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "2 tbsp tomato paste\n4 tsp curry powder\n2 tsp garam masala\n1 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 615796,
      "primary_message": "Add tofu, coconut milk, and water to the skillet; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until thickened slightly, 5 minutes more. ",
      "secondary_message": "1 (13.5 fl oz) can coconut milk\n¼ cup water"
    },
    {
      "id": 615797,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. When the curry is thickened, add cilantro to the skillet and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 615798,
      "primary_message": "To serve, divide rice and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
