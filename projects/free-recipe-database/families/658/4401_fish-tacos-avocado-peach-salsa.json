  "instructions": [
    {
      "id": 49904,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 peaches\n1 avocado\n1 jalapeño pepper\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 49905,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard the pit; small dice the quarters into 6-mm cubes. Transfer to a medium bowl (that will hold the salsa).",
      "secondary_message": null
    },
    {
      "id": 49906,
      "primary_message": "Halve the avocado lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh into 6-mm cubes. Add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 49907,
      "primary_message": "Quarter the jalapeño pepper lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the pepper and add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 49908,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 49909,
      "primary_message": "Trim off and discard the ends of the shallot; peel and finely dice the shallot. Add to the salsa bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 49910,
      "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 49911,
      "primary_message": "While the skillet heats up, pat the fish dry with paper towels and place on a plate; season with chili powder, salt, and pepper on both sides.",
      "secondary_message": "0.34 kg cod fillet\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 49912,
      "primary_message": "Once the skillet is hot, add the fish; cook until it is cooked through and flakes easily, 2 to 4 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 49913,
      "primary_message": "Juice the lime and add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 49914,
      "primary_message": "Season the salsa with salt and pepper; toss to combine.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 49915,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15 to 30 seconds.",
      "secondary_message": "8 small corn tortillas"
    },
    {
      "id": 49916,
      "primary_message": "Using a fork or your hands, flake the fish.",
      "secondary_message": null
    },
    {
      "id": 49917,
      "primary_message": "To serve, divide the fish between the tortillas and top with the avocado-peach salsa. Enjoy!",
      "secondary_message": null
    }
  ],
