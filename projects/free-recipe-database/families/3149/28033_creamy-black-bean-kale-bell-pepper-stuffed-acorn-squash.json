  "instructions": [
    {
      "id": 449343,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 449344,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 acorn squash\n½ bunch kale\n1 red bell pepper"
    },
    {
      "id": 449345,
      "primary_message": "Halve acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil, then season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 449346,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 449347,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 449348,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the kale.",
      "secondary_message": null
    },
    {
      "id": 449349,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 449350,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 449351,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add kale, bell pepper, and garlic to the skillet in handfuls, waiting for kale to wilt slightly before adding the next handful. Cook, stirring often, until the veggies are tender, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 449352,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 449353,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "⅓ (227 g) block cream cheese"
    },
    {
      "id": 449354,
      "primary_message": "When the veggies are done, add beans, cream cheese, broth, and spices to the skillet; stir until cheese is melted and combined. Bring to a simmer and continue to cook, stirring occasionally, until sauce thickens, 3-4 minutes more. Remove from heat.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n1 tsp chili powder\n½ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 449355,
      "primary_message": "To serve, divide squash halves between plates, stuff with filling, and sprinkle with bread crumbs. Enjoy!",
      "secondary_message": "2 tbsp panko bread crumbs"
    }
  ],
