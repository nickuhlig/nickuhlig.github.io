  "instructions": [
    {
      "id": 449291,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 449292,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 acorn squash\n1 ½ bunches kale\n3 red bell peppers"
    },
    {
      "id": 449293,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil, then season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 449294,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 449295,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 449296,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the kale.",
      "secondary_message": null
    },
    {
      "id": 449297,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 449298,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 449299,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add kale, bell pepper, and garlic to the pot in handfuls, waiting for kale to wilt slightly before adding the next handful. Cook, stirring often, until the veggies are tender, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 449300,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 449301,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "1 (8 oz) block cream cheese"
    },
    {
      "id": 449302,
      "primary_message": "When the veggies are done, add beans, cream cheese, broth, and spices to the pot; stir until cheese is melted and combined. Bring to a simmer and continue to cook, stirring occasionally, until sauce thickens, 4-5 minutes more. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n1 tbsp chili powder\n1 ½ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 449303,
      "primary_message": "To serve, divide squash halves between plates, stuff with filling, and sprinkle with bread crumbs. Enjoy!",
      "secondary_message": "⅓ cup panko bread crumbs"
    }
  ],
