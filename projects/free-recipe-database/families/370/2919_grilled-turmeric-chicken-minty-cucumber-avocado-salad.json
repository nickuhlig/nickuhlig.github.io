  "instructions": [
    {
      "id": 28331,
      "primary_message": "In a medium bowl, combine and mix together the yogurt, lemon juice, turmeric, cumin, salt, and pepper. Transfer half of the yogurt mixture to another medium bowl.",
      "secondary_message": "¾ cup plain Greek yogurt\n½ lemon\n1 tsp turmeric\n½ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 28332,
      "primary_message": "Holding a knife parallel to the cutting board; cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "1 lb chicken breasts, boneless skinless"
    },
    {
      "id": 28333,
      "primary_message": "Place the chicken in one of the bowls and coat in the yogurt mixture; set aside for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 28334,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n1 avocado\n½ small pkg fresh mint"
    },
    {
      "id": 28335,
      "primary_message": "Trim and discard the cucumber ends; small dice the cucumber and add to the other bowl of yogurt.",
      "secondary_message": null
    },
    {
      "id": 28336,
      "primary_message": "Halve and pit the avocado; scoop out the flesh and discard the skins. Small dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 28337,
      "primary_message": "Peel and mince the shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 28338,
      "primary_message": "Heat a grill pan or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 28342,
      "primary_message": "While the pan/skillet heats up, pick the mint leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl and toss the salad until well combined.",
      "secondary_message": null
    },
    {
      "id": 28340,
      "primary_message": "Transfer the chicken to a plate, wiping off excess marinade.",
      "secondary_message": ""
    },
    {
      "id": 28339,
      "primary_message": "Coat the grill pan or skillet with coconut oil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 28341,
      "primary_message": "Place the chicken in the grill pan or skillet; cook until cooked through and golden brown, 3 to 4 minutes per side. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 28343,
      "primary_message": "Divide the chicken and cucumber-avocado salad between two plates (or one plate and one lunch container). Enjoy!",
      "secondary_message": null
    }
  ],
