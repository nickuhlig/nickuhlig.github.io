  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Line two baking sheet pans with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel bananas, break into chunks, and place in a large bowl.",
      "secondary_message": "1 ½ bananas"
    },
    {
      "primary_message": "Add sugar, oil, and vanilla to the bowl with the banana. Crush with a fork or potato masher until smooth.",
      "secondary_message": "½ cup brown sugar\n3 tbsp virgin coconut oil\n1 ½ tsp vanilla extract"
    },
    {
      "primary_message": "Add granola to the bowl, breaking apart any extra-large pieces with your hands, and stir to combine; set aside.",
      "secondary_message": "2 cups granola"
    },
    {
      "primary_message": "Place flour, cornstarch, baking powder, baking soda, and salt in a small bowl; stir to combine.",
      "secondary_message": "¾ tsp cornstarch\n½ tsp baking powder\n½ tsp baking soda\n3 pinch salt"
    },
    {
      "primary_message": "Add flour mixture to the bowl with the banana and stir to combine the cookie batter.",
      "secondary_message": null
    },
    {
      "primary_message": "Using a scant ¼-cup measure, divide batter into 12 portions and place on the baking sheets. Using a silicone spatula or the back of a spoon, spread each cookie into a 2-inch circle.",
      "secondary_message": null
    },
    {
      "primary_message": "Place baking sheets in the oven and bake until cookies are golden and slightly firm around the edges, about 15 minutes. Remove from oven and let cool to room temperature.",
      "secondary_message": null
    },
    {
      "primary_message": "Once cool, arrange half of the cookies on a flat surface, bottom-side facing up. Place a scoop of ice cream on top of each, then cover with remaining cookies. Gently press cookies into the ice cream to secure the sandwiches.",
      "secondary_message": "532 ml vanilla ice cream"
    },
    {
      "primary_message": "To serve, divide ice cream sandwiches between plates and enjoy!",
      "secondary_message": null
    }
  ],
