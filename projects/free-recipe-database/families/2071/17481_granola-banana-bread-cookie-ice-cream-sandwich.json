  "instructions": [
    {
      "id": 283527,
      "primary_message": "Preheat oven to 175°C (350°F). Line a large baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 283528,
      "primary_message": "Peel banana, break into chunks, and place in a medium bowl.",
      "secondary_message": "1 banana"
    },
    {
      "id": 283529,
      "primary_message": "Add sugar, oil, and vanilla to the bowl with the banana. Crush with a fork or potato masher until smooth.",
      "secondary_message": "⅓ cup brown sugar\n2 tbsp virgin coconut oil\n1 tsp vanilla extract"
    },
    {
      "id": 283530,
      "primary_message": "Add granola to the bowl, breaking apart any extra-large pieces with your hands, and stir to combine; set aside.",
      "secondary_message": "1 ⅓ cup granola"
    },
    {
      "id": 283531,
      "primary_message": "Place flour, cornstarch, baking powder, baking soda, and salt in a small bowl; stir to combine.",
      "secondary_message": "½ cup all-purpose flour\n½ tsp cornstarch\n¼ tsp baking powder\n¼ tsp baking soda\n⅛ tsp salt"
    },
    {
      "id": 283532,
      "primary_message": "Add flour mixture to the bowl with the banana and stir to combine the cookie batter.",
      "secondary_message": null
    },
    {
      "id": 283533,
      "primary_message": "Using a scant ¼-cup measure, divide batter into 8 portions and place on the baking sheet. Using a silicone spatula or the back of a spoon, spread each cookie into a 2-inch circle.",
      "secondary_message": null
    },
    {
      "id": 283534,
      "primary_message": "Place baking sheet in the oven and bake until cookies are golden and slightly firm around the edges, 12-15 minutes. Remove from oven and let cool to room temperature.",
      "secondary_message": null
    },
    {
      "id": 283535,
      "primary_message": "Once cool, arrange half of the cookies on a flat surface, bottom-side facing up. Place a scoop of ice cream on top of each, then cover with remaining cookies. Gently press cookies into the ice cream to secure the sandwiches.",
      "secondary_message": "355 ml vanilla ice cream"
    },
    {
      "id": 283536,
      "primary_message": "To serve, divide ice cream sandwiches between plates and enjoy!",
      "secondary_message": null
    }
  ],
