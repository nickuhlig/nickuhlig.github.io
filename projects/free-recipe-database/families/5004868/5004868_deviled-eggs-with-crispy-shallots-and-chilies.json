  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and halve the hard-boiled eggs lengthwise.",
      "secondary_message": "6 hard-boiled eggs"
    },
    {
      "id": 1,
      "primary_message": "Place all of the yolks in a medium bowl. Select 8 of the best looking egg white halves and set aside. Reserve the remaining 4 for another use. Add mayonnaise, jalapeño or Thai bird chilies, lemon juice, and half of fried shallots. Using a stiff whisk, mash until thoroughly combined. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer yolk filling to zipper-lock bag. Filling and egg white halves can be stored covered in the refrigerator up to overnight before filling and serving (lay egg white halves cut-side-down on a large plate and cover with plastic wrap). Cut off corner of zipper-lock bag and pipe filling mixture into egg white halves, overstuffing each hole. Garnish with remaining fried shallots and jalapeño. Serve immediately.",
      "secondary_message": null
    }
  ],
