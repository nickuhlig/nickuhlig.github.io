  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, drain and rinse chickpeas.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chickpeas, salt, and pepper; cook, stirring occasionally, until tender and warmed through, 8-10 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n1 medium carrot\n1 Granny Smith apple"
    },
    {
      "primary_message": "Place yogurt, vinegar, salt, and pepper in a medium bowl, then whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\napple cider vinegar\nsalt\nblack pepper"
    },
    {
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter, core, and coarsely grate apple. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place ketchup, vinegar, soy sauce, Dijon, and spices in another medium bowl. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp ketchup\napple cider vinegar\n½ tsp soy sauce\n½ tsp Dijon mustard\n¼ tsp chili powder\nsalt\nblack pepper"
    },
    {
      "primary_message": "Coarsely grate cheese. Add to the bowl with the sauce, along with chickpeas, then stir to combine the cheesy chickpea filling.",
      "secondary_message": "⅓ (8 oz) block cheddar cheese"
    },
    {
      "primary_message": "Place tortillas on a flat surface, then divide cheesy chickpea filling and a small portion of slaw between them. Roll tightly to close. (Reserve remaining slaw for serving.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "primary_message": "Cut wraps in half and divide between plates. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
