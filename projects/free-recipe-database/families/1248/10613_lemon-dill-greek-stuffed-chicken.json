  "instructions": [
    {
      "id": 170408,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 170409,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n1 small bunch fresh dill\n2 medium zucchini squash\n2 tomatoes"
    },
    {
      "id": 170410,
      "primary_message": "Zest and juice lemons into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 170411,
      "primary_message": "Shave dill leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 170412,
      "primary_message": "Peel and mince garlic; add to the bowl with oil and whisk to combine the marinade. Set aside.",
      "secondary_message": "4 cloves garlic\n¼ cup extra virgin olive oil"
    },
    {
      "id": 170413,
      "primary_message": "Trim zucchini, halve lengthwise, and slice into thin half moons. Halve tomatoes and slice into half moons. Set aside on a plate.",
      "secondary_message": null
    },
    {
      "id": 170414,
      "primary_message": "Peel and slice onion into half rings.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 170415,
      "primary_message": "Pat chicken dry with paper towels and season with salt and pepper. Make 5 crosswise slits in each breast, being careful not to cut through completely.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 170416,
      "primary_message": "Place chicken on a large sheet pan and stuff each slit with a slice of zucchini, tomato, and onion. Add remaining veggies to the sheet pan next to the chicken.",
      "secondary_message": null
    },
    {
      "id": 170417,
      "primary_message": "Drizzle chicken and vegetables with the marinade.",
      "secondary_message": null
    },
    {
      "id": 170418,
      "primary_message": "Grate mozzarella. Sprinkle cheeses over the chicken and vegetables.",
      "secondary_message": "½ (227 g) block mozzarella cheese\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 170419,
      "primary_message": "Place in the oven and bake for 20-25 minutes, until chicken is cooked through.",
      "secondary_message": null
    },
    {
      "id": 170420,
      "primary_message": "To serve, divide chicken and vegetables between plates. Enjoy!",
      "secondary_message": null
    }
  ],
