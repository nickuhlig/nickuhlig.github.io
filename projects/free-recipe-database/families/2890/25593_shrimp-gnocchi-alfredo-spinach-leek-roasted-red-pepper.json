  "instructions": [
    {
      "id": 410020,
      "primary_message": "Wash, dry, and trim off the root end and dark green top of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Place in a medium bowl. ",
      "secondary_message": "3 leeks"
    },
    {
      "id": 410021,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl with the leek. ",
      "secondary_message": "1 ½ (12 oz) jars roasted red bell peppers"
    },
    {
      "id": 410022,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410023,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 410024,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add leeks, peppers, and garlic; cook, stirring occasionally, until leeks soften, 3-4 minutes. ",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 410025,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 410026,
      "primary_message": "Once the leek is soft, add shrimp, Alfredo sauce, and spices to the pot; stir to combine and bring to a simmer. Once simmering, continue to cook, stirring occasionally, until shrimp are almost cooked through, about 4 minutes.",
      "secondary_message": "1 ½ (16 oz) jars Alfredo sauce\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 410027,
      "primary_message": "Meanwhile, place spinach in a colander and rinse under hot, running water (from the tap) to defrost.",
      "secondary_message": "1 ½ (16oz) bags frozen chopped spinach"
    },
    {
      "id": 410028,
      "primary_message": "When the shrimp are done, add spinach and gnocchi to the pot. Continue to cook, stirring occasionally, until spinach is warmed through and gnocchi are soft, 3-4 minutes more. Remove from heat.",
      "secondary_message": "3 (16 oz) pkg potato gnocchi"
    },
    {
      "id": 410029,
      "primary_message": "To serve, divide shrimp gnocchi between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
