  "instructions": [
    {
      "id": 410010,
      "primary_message": "Wash, dry, and trim off the root end and dark green top of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Place in a medium bowl. ",
      "secondary_message": "2 leeks"
    },
    {
      "id": 410011,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl with the leek. ",
      "secondary_message": "1 (12 oz) jar roasted red bell peppers"
    },
    {
      "id": 410012,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410013,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 410014,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add leeks, peppers, and garlic; cook, stirring occasionally, until leeks soften, 2-3 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 410015,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 410016,
      "primary_message": "Once the leek is soft, add shrimp, Alfredo sauce, and spices to the skillet; stir to combine and bring to a simmer. Once simmering, continue to cook, stirring occasionally, until shrimp are almost cooked through, about 3 minutes.",
      "secondary_message": "1 (16 oz) jar Alfredo sauce\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 410017,
      "primary_message": "Meanwhile, place spinach in a colander and rinse under hot, running water (from the tap) to defrost.",
      "secondary_message": "1 (16oz) bag frozen chopped spinach"
    },
    {
      "id": 410018,
      "primary_message": "When the shrimp are done, add spinach and gnocchi to the skillet. Continue to cook, stirring occasionally, until spinach is warmed through and gnocchi are soft, 2-3 minutes more. Remove from heat.",
      "secondary_message": "2 (16 oz) pkg potato gnocchi"
    },
    {
      "id": 410019,
      "primary_message": "To serve, divide shrimp gnocchi between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
