  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 stick celery\n1 (5 oz) pkg baby spinach"
    },
    {
      "primary_message": "Peel, trim, and medium dice carrots. Trim and medium dice celery. Place both in a 6-quart slow cooker insert.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and medium dice onion. Roughly chop apricots. Add both to the slow cooker along with beef, broth, orange juice, and spices. Stir to combine the stew, then cover and cook until the meat is tender and flavors have blended, LOW for 5-6 hours or HIGH for about 3 hours.",
      "secondary_message": "1 medium yellow onion\n2 lb beef for stew\n1 cup chicken or vegetable broth\n½ cup orange juice\n2 tsp smoked paprika\n2 tsp allspice, ground\n2 tsp cinnamon, ground\n1 tsp salt"
    },
    {
      "primary_message": "When the meat is tender, add spinach to the slow cooker. Cover and continue to cook until the spinach is fully wilted, about 20 minutes. Stir gently to combine.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, in a medium saucepan, bring broth and couscous to a boil over high heat (reserve spice packets for the next step). Once boiling, reduce to medium and cook, stirring occasionally, for 8 minutes. (The mixture will be soupy.) ",
      "secondary_message": "2 (4.7 oz) box roasted garlic & olive oil couscous mix\nchicken or vegetable broth"
    },
    {
      "primary_message": "Add spice packets to the pan and stir to combine. Continue to cook, stirring occasionally, until tender, 4-6 minutes more. Remove from heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide couscous and beef stew between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
