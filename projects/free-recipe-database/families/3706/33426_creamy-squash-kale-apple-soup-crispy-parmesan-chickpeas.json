  "instructions": [
    {
      "id": 527833,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 527834,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n3 leeks\n3 Gala apples\n1 ½ bunches kale"
    },
    {
      "id": 527835,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 527836,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Add to the bowl with the squash.",
      "secondary_message": null
    },
    {
      "id": 527837,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 527838,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add butternut squash, leek, and spices to the pot; cook, stirring occasionally, until veggies are softened, 8-10 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n1 ½ tsp sage, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 527839,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Divide between two baking sheet pans and pat dry with paper towels. Drizzle with oil, then season with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n1 ½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 527840,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 527841,
      "primary_message": "While the chickpeas are roasting, quarter, core, and small dice apples.",
      "secondary_message": null
    },
    {
      "id": 527842,
      "primary_message": "When the veggies are softened, add apple and broth to the pot; stir to combine the soup and bring to a simmer. Once simmering, reduce heat to medium and continue to cook, stirring occasionally, until apple is tender, about 6 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
    },
    {
      "id": 527843,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 527844,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. When the apple is done, add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 527845,
      "primary_message": "Add cream to the pot, stir to combine, and remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 527846,
      "primary_message": "When the chickpeas are done, remove from the oven. Add Parmesan to the baking sheets and stir until cheese starts to melt and combine with chickpeas. ",
      "secondary_message": null
    },
    {
      "id": 527847,
      "primary_message": "To serve, divide soup between bowls and top with the crispy chickpeas. Enjoy!",
      "secondary_message": null
    }
  ],
