  "instructions": [
    {
      "id": 527848,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 527849,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small butternut squash\n1 leek\n1 Gala apple\n½ bunch kale"
    },
    {
      "id": 527850,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 527851,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Add to the bowl with the squash.",
      "secondary_message": null
    },
    {
      "id": 527852,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 527853,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add butternut squash, leek, and spices to the pan; cook, stirring occasionally, until veggies are softened, 6-8 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp sage, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 527854,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Transfer to a baking sheet pan and pat dry with paper towels. Drizzle with oil, then season with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n2 tsp extra virgin olive oil\n½ tsp paprika\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 527855,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 527856,
      "primary_message": "While the chickpeas are roasting, quarter, core, and small dice apple.",
      "secondary_message": null
    },
    {
      "id": 527857,
      "primary_message": "When the veggies are softened, add apple and broth to the pan; stir to combine the soup and bring to a simmer. Once simmering, reduce heat to medium and continue to cook, stirring occasionally, until apple is tender, about 5 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 527858,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 527859,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. When the apple is done, add kale to the pan in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 527860,
      "primary_message": "Add cream to the pan, stir to combine, and remove from heat.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 527861,
      "primary_message": "When the chickpeas are done, remove from the oven. Add Parmesan to the baking sheet and stir until cheese starts to melt and combine with chickpeas. ",
      "secondary_message": null
    },
    {
      "id": 527862,
      "primary_message": "To serve, divide soup between bowls and top with the crispy chickpeas. Enjoy!",
      "secondary_message": null
    }
  ],
