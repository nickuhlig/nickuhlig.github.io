  "instructions": [
    {
      "id": 585871,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 585872,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 green bell peppers\n1 jalapeño pepper\n1 small bunch green onions (scallions)\n1 (5 oz) pkg baby spinach\n1 small bunch cilantro\n2 avocados"
    },
    {
      "id": 585873,
      "primary_message": "Peel and mince garlic. Place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 585874,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 585875,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 585876,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 585877,
      "primary_message": "Roughly chop spinach. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 585878,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 585879,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl (reserving a small handful of cilantro for serving).",
      "secondary_message": null
    },
    {
      "id": 585880,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until tender, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 585881,
      "primary_message": "Add broth and vinegar to the skillet; stir to combine the stew and bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until stew is slightly thickened, about 5 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 tbsp white wine vinegar"
    },
    {
      "id": 585882,
      "primary_message": "Using a stirring spoon, make a well in the stew for each egg; crack an egg into each well, sprinkle with feta, and season with pepper. Place the skillet in the oven and bake until egg whites are firm but yolks are still soft, 8-10 minutes. Remove from oven.",
      "secondary_message": "8 eggs\n1 (4 oz) pkg crumbled feta cheese\n½ tsp black pepper"
    },
    {
      "id": 585883,
      "primary_message": "Meanwhile, toast bread if desired, then cut in half.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 585884,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice lengthwise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 585885,
      "primary_message": "To serve, divide stew, eggs, and sourdough between plates or bowls. Top with yogurt, avocado, and reserved cilantro. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
