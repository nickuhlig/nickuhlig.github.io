  "instructions": [
    {
      "id": 585976,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 585977,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 green bell peppers\n1 ½ jalapeño peppers\n1 small bunch green onions (scallions)\n1 ½ (142 g) pkgs baby spinach\n1 small bunch cilantro\n3 avocados"
    },
    {
      "id": 585978,
      "primary_message": "Peel and mince garlic. Place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 585979,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 585980,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 585981,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 585982,
      "primary_message": "Roughly chop spinach. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 585983,
      "primary_message": "Preheat two large ovenproof skillets over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 585984,
      "primary_message": "While the skillets heat up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl (reserving a small handful of cilantro for serving).",
      "secondary_message": null
    },
    {
      "id": 585985,
      "primary_message": "Once the skillets are hot, divide oil between them and swirl to coat the bottoms. Divide veggies and spices between the skillets; cook, stirring occasionally, until tender, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 585986,
      "primary_message": "Add broth and vinegar to the skillets; stir to combine the stew and bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until stew is slightly thickened, 6-7 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n3 tbsp white wine vinegar"
    },
    {
      "id": 585987,
      "primary_message": "Using a stirring spoon, make a well in the stew for each egg; crack an egg into each well, sprinkle with feta, and season with pepper. Place the skillets in the oven and bake until egg whites are firm but yolks are still soft, 10-12 minutes. Remove from oven.",
      "secondary_message": "12 eggs\n1 ½ (113 g) pkgs crumbled feta cheese\n¾ tsp black pepper"
    },
    {
      "id": 585988,
      "primary_message": "Meanwhile, toast bread if desired, then cut in half.",
      "secondary_message": "6 slices sourdough bread"
    },
    {
      "id": 585989,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice lengthwise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 585990,
      "primary_message": "To serve, divide stew, eggs, and sourdough between plates or bowls. Top with yogurt, avocado, and reserved cilantro. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
