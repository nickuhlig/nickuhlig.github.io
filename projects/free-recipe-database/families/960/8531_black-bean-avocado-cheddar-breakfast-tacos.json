  "instructions": [
    {
      "id": 129522,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 lime\n1 avocado"
    },
    {
      "id": 129523,
      "primary_message": "Peel and medium dice onion. Medium dice the pepper. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 129524,
      "primary_message": "Heat a skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and peppers and cook, stirring occasionally, until vegetables begin to soften, 5-6 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 129525,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 129526,
      "primary_message": "Peel and mince the garlic. Add to the skillet and cook for 1 minute more. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 129527,
      "primary_message": "Add beans, water, and spices to the skillet and stir to combine. Bring to a simmer and then reduce heat to medium-low and cook until slightly thickened, 5-7 minutes. ",
      "secondary_message": "½ cup water\n1 tsp chili powder\n1 tsp oregano\n½ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 129528,
      "primary_message": "Meanwhile, preheat another skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 129529,
      "primary_message": "Break the eggs into a medium bowl and add salt and pepper; whisk together.",
      "secondary_message": "8 eggs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 129530,
      "primary_message": "Once the second skillet is hot, add oil and swirl to coat the bottom; add the egg mixture. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny then remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 129531,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 129532,
      "primary_message": "Once the beans are cooked, remove from heat. Juice the lime into the skillet and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 129533,
      "primary_message": "Halve and pit the avocado; slice crosswise and lengthwise to form cubes while still in the skin and scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 129534,
      "primary_message": "To serve, divide tortillas between plates and layer eggs, beans, cheese, and avocado down the center of each tortilla. Enjoy! ",
      "secondary_message": "4 small corn tortillas"
    }
  ],
