  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a medium saucepan filled with water to a boil over high heat. Blanch peaches in boiling water for 1 minute. Remove, let sit until cool enough to handle, then peel, pit, and roughly chop the peach flesh. Discard peels and pits.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Melt butter in a medium saucepan over medium heat. When foaming subsides, add shallots and cook, stirring frequently until softened and just starting to brown, about 5 minutes. Stir in ginger and garlic and cook until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add chopped peaches, brown sugar, cinnamon, and mustard powder and continue to cook until peaches have softened and released their juices, 10 to 15 minutes. Stir in bourbon, cook for 1 minute more. Season with salt to taste and serve.",
      "secondary_message": null
    }
  ],
