  "instructions": [
    {
      "id": 430171,
      "primary_message": "Wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. Place in a large bowl and set aside.",
      "secondary_message": "9 medium zucchini squash"
    },
    {
      "id": 430172,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 430173,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 430174,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 430175,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Peel and mince garlic. Place both in a small bowl along with oil, crushed red pepper, and salt. Stir to combine the chili oil.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 cloves garlic\n½ cup toasted sesame oil\n1 tbsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 430176,
      "primary_message": "Return skillet to medium heat. Once hot, add chili oil and cook until sizzling and fragrant, 30-60 seconds. Remove from heat and immediately drizzle over the zucchini noodles. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 430177,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 430178,
      "primary_message": "To serve, divide steak and zucchini noodles between plates. Enjoy!",
      "secondary_message": null
    }
  ],
