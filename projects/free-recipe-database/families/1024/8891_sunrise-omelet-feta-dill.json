  "instructions": [
    {
      "id": 162190,
      "primary_message": "Wash and shave the dill leaves off the stems; discard the stems and mince the leaves. Reserve a small amount for garnish.",
      "secondary_message": "½ small bunch fresh dill"
    },
    {
      "id": 162191,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 162192,
      "primary_message": "In a medium bowl, whisk together eggs, salt, and pepper.",
      "secondary_message": "6 eggs\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 162193,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 162194,
      "primary_message": "Add eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing the uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 162195,
      "primary_message": "Sprinkle cheese and dill over one side of the omelet. Fold the omelet in half and cook until warmed through, about 1 minute.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 162196,
      "primary_message": "Wash and slice orange into rounds.",
      "secondary_message": "1 orange"
    },
    {
      "id": 162197,
      "primary_message": "To serve, cut omelet in half and divide between plates; garnish with reserved dill. Enjoy with orange slices on the side!",
      "secondary_message": null
    }
  ],
