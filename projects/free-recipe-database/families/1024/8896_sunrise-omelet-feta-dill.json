  "instructions": [
    {
      "id": 162231,
      "primary_message": "Wash and shave the dill leaves off the stems; discard the stems and mince the leaves. Reserve a small amount for garnish.",
      "secondary_message": "1 ½ small bunches fresh dill"
    },
    {
      "id": 162232,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 162233,
      "primary_message": "In a large bowl, whisk together eggs, salt, and pepper.",
      "secondary_message": "18 eggs\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 162234,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 162235,
      "primary_message": "Add ⅓ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing the uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 162236,
      "primary_message": "Sprinkle ½ a package of cheese and ⅓ of the dill over one side of the omelet. Fold the omelet in half and cook until warmed through, about 1 minute. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 162237,
      "primary_message": "Add more butter to the skillet (1 tbsp per omelet) and repeat twice more with remaining egg mixture, cheese (½ a pkg per omelet), and dill.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 162238,
      "primary_message": "To serve, cut omelets in half and divide between plates; garnish with reserved dill and enjoy!",
      "secondary_message": null
    }
  ],
