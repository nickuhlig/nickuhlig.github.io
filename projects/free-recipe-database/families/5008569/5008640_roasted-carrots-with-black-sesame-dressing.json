  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to center position and preheat oven to 190°C (375°F). Place carrots in a large pot, cover with water, and season heavily with salt. Heat over high heat until boiling. Reduce to a simmer and cook until barely tender, about 5 minutes. Drain and allow to dry for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer carrots to a rimmed baking sheet, drizzle with just enough olive oil to coat, and roast until caramelized, about 40 minutes, turning once or twice during roasting.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, in a small bowl, whisk together sesame paste, 1 tablespoon of olive oil, and lemon juice. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Arrange carrots on a serving plate, drizzle with sesame sauce, and garnish with parsley and grated lemon zest. Serve.",
      "secondary_message": null
    }
  ],
