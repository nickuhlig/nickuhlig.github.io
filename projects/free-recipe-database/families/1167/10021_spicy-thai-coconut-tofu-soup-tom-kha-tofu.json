  "instructions": [
    {
      "id": 159916,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n0.68 kg white mushrooms\n1 ½ small bunches green onions (scallions)\n1 ½ small bunches cilantro\n1 ½ limes"
    },
    {
      "id": 159917,
      "primary_message": "Peel and thinly slice onions into half rings.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 159918,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 159919,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 159920,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 159921,
      "primary_message": "Add onion, ginger, garlic, and chili-garlic sauce to the pot. Cook, stirring frequently, until onion begins to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp chili-garlic sauce"
    },
    {
      "id": 159922,
      "primary_message": "Add broth, coconut milk, sugar, and salt to the pot. Bring to a boil over high heat, then reduce heat to a simmer.",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 (398 ml) cans coconut milk\n1 ½ tbsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 159923,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 159924,
      "primary_message": "Drain and small dice tofu. ",
      "secondary_message": "1 ½ (340 g) pkgs extra firm tofu"
    },
    {
      "id": 159925,
      "primary_message": "Add mushrooms and tofu to the pot and continue to simmer for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 159926,
      "primary_message": "Meanwhile, trim green onions; cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 159927,
      "primary_message": "Shave cilantro leaves off the stems; discard stems.",
      "secondary_message": null
    },
    {
      "id": 159928,
      "primary_message": "When the soup is done, juice limes into the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 159929,
      "primary_message": "To serve, divide soup between bowls. Top with green onions and cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
