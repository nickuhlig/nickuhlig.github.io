  "instructions": [
    {
      "id": 71625,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (8 oz) pkg sugar snap peas\n3 mangoes\n3 red bell peppers\n3 (1 inch) pieces ginger root\n1 ½ small bunch green onions (scallions)"
    },
    {
      "id": 71624,
      "primary_message": "Peel the mangoes, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and large dice the flesh (cut into ¾-inch cubes). Transfer the mangoes to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 71623,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Large dice the peppers (cut into ¾-inch cubes) and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 71638,
      "primary_message": "Halve the sugar snap peas at an angle and add to the bowl with the bell peppers.",
      "secondary_message": ""
    },
    {
      "id": 71637,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 71636,
      "primary_message": "Peel and grate or mince the ginger. Transfer the ginger to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 71635,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add the garlic to the bowl with the ginger.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 71634,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 71633,
      "primary_message": "While the skillet heats up, pat dry the pork chops with paper towels and place on a cutting board; thinly slice crosswise into bite-sized strips.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 71632,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 71631,
      "primary_message": "Add the pork strips to the skillet and season with salt and pepper; cook, tossing occasionally, until the pork is browned and cooked through, 3 to 4 minutes total. Once done, transfer to a bowl.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 71630,
      "primary_message": "Once the pork has been transferred, add more coconut oil to the skillet followed by the ginger, garlic, and crushed red pepper; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "1 ½ tbsp virgin coconut oil\n⅜ tsp crushed red pepper"
    },
    {
      "id": 71629,
      "primary_message": "Add the bell pepper and snap peas to the skillet; cook, tossing occasionally, until the vegetables are lightly browned and tender-crisp, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 71628,
      "primary_message": "While the vegetables cook, in a medium bowl, combine and whisk together cornstarch, broth, and soy sauce.",
      "secondary_message": "6 tsp cornstarch\n12 fl oz (1 ½ cup) chicken or vegetable broth\n6 tbsp soy sauce"
    },
    {
      "id": 71627,
      "primary_message": "Return the pork to the skillet, then add the mango, ¾ of the green onions (save the rest for garnishing), and sauce. Cook, stirring constantly, until the stir fry is heated through and the sauce is thickened, 2 to 3 minutes. Remove from the heat.",
      "secondary_message": ""
    },
    {
      "id": 71626,
      "primary_message": "To serve, add the stir fry to a dinner bowl and garnish with the remaining green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
