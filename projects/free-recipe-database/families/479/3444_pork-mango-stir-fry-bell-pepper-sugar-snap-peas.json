  "instructions": [
    {
      "id": 36238,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (8 oz) pkg sugar snap peas\n1 mango\n1 red bell pepper\n1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 36239,
      "primary_message": "Peel the mango, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and large dice the flesh (cut into ¾-inch cubes). Transfer the mango to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 36240,
      "primary_message": "Quarter the bell pepper lengthwise; remove and discard the stem, seeds, and membranes. Large dice the pepper (cut into ¾-inch cubes) and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 36241,
      "primary_message": "Halve the sugar snap peas at an angle and add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 36242,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 36243,
      "primary_message": "Peel and grate or mince the ginger. Transfer the ginger to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 36244,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add the garlic to the bowl with the ginger.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 36245,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 36246,
      "primary_message": "While the skillet heats up, pat dry the pork chops with paper towels and place on a cutting board; thinly slice crosswise into bite-sized strips.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 36247,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 36248,
      "primary_message": "Add the pork strips to the skillet and season with salt and pepper; cook, tossing occasionally, until the pork is browned and cooked through, 3 to 4 minutes total. Once done, transfer to a bowl.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 36249,
      "primary_message": "Once the pork has been transferred, add more coconut oil to the skillet followed by the ginger, garlic, and crushed red pepper; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "½ tbsp virgin coconut oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 36250,
      "primary_message": "Add the bell pepper and snap peas to the skillet; cook, tossing occasionally, until the vegetables are lightly browned and tender-crisp, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 36251,
      "primary_message": "While the vegetables cook, in a small bowl, combine and whisk together cornstarch, broth, and coconut aminos.",
      "secondary_message": "2 tsp cornstarch\n4 fl oz (½ cup) chicken or vegetable broth\n2 tbsp coconut aminos"
    },
    {
      "id": 36252,
      "primary_message": "Return the pork to the skillet, then add the mango, ¾ of the green onions (save the rest for garnishing), and sauce. Cook, stirring constantly, until the stir fry is heated through and the sauce is thickened, 2 to 3 minutes. Remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 36253,
      "primary_message": "To serve, add the stir fry to a dinner bowl and garnish with the remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
