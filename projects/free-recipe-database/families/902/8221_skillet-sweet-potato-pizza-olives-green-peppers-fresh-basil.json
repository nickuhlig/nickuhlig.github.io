  "instructions": [
    {
      "id": 178693,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 178694,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb sweet potato\n½ green bell pepper\n½ small pkg fresh basil"
    },
    {
      "id": 178695,
      "primary_message": "Peel and coarsely grate the sweet potato. ",
      "secondary_message": null
    },
    {
      "id": 178696,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 178697,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 178698,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 178699,
      "primary_message": "Add sweet potatoes, garlic, salt, and pepper to the skillet and fry, stirring occasionally, until softened, about 5 minutes. ",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 178700,
      "primary_message": "Meanwhile, grate cheese. ",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 178701,
      "primary_message": "Peel and thinly slice the shallot into rounds. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 178702,
      "primary_message": "Using the back of a spoon, press the sweet potato mixture into an even layer. Place skillet in the oven and broil until starting to brown, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 178703,
      "primary_message": "Meanwhile, seed and thinly slice the pepper into rounds. Thinly slice olives. ",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 178704,
      "primary_message": "Remove skillet from oven and top with tomato sauce, oregano, cheese, and veggies. ",
      "secondary_message": "½ (8 oz) can tomato sauce\n½ tsp oregano"
    },
    {
      "id": 178705,
      "primary_message": "Return skillet to the oven and broil until the cheese is melted and golden, about 5 minutes. (The sweet potato crust will remain soft, enjoy this pizza with a fork and knife.)",
      "secondary_message": null
    },
    {
      "id": 178706,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 178707,
      "primary_message": "Remove skillet from the oven and garnish with fresh basil and crushed red pepper. Divide between plates and enjoy! ",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
