  "instructions": [
    {
      "id": 178723,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 178724,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lb sweet potatoes\n1 ½ green bell peppers\n1 small pkg fresh basil"
    },
    {
      "id": 178725,
      "primary_message": "Peel and coarsely grate the sweet potatoes. ",
      "secondary_message": null
    },
    {
      "id": 178726,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 178727,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 178728,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 178729,
      "primary_message": "Add sweet potatoes, garlic, salt, and pepper to the skillet and fry, stirring occasionally, until softened, 5-7 minutes. ",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 178730,
      "primary_message": "Meanwhile, grate cheese. ",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 178731,
      "primary_message": "Peel and thinly slice the onion into rounds. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 178732,
      "primary_message": "Transfer the sweet potatoes to a baking dish. Using the back of a spoon, press the sweet potato mixture into an even layer. Place baking dish in the oven and broil until starting to brown, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 178733,
      "primary_message": "Meanwhile, seed and thinly slice the peppers into rounds. Thinly slice olives. ",
      "secondary_message": "⅜ cup Kalamata olives, pitted"
    },
    {
      "id": 178734,
      "primary_message": "Remove baking dish from the oven and top with tomato sauce, oregano, cheese, and veggies.",
      "secondary_message": "1 ½ (8 oz) cans tomato sauce\n1 ½ tsp oregano"
    },
    {
      "id": 178735,
      "primary_message": "Return baking dish to the oven and broil until the cheese is melted and golden, about 5 minutes. (The sweet potato crust will remain soft, enjoy this pizza with a fork and knife.) ",
      "secondary_message": null
    },
    {
      "id": 178736,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 178737,
      "primary_message": "Remove baking dish from the oven and garnish with fresh basil and crushed red pepper. Divide between plates and enjoy! ",
      "secondary_message": "¾ tsp crushed red pepper"
    }
  ],
