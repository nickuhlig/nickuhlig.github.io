  "instructions": [
    {
      "id": 104605,
      "primary_message": "Add salt and water to the pot, cover, and bring to a boil over high heat. Once boiling, stir in oats and maple syrup. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency.",
