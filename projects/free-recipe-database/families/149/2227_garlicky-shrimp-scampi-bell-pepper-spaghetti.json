  "instructions": [
    {
      "id": 21229,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "about 7 cups water\n1 tbsp salt\n6 oz (1 quarter coin = 2 oz) spaghetti pasta"
    },
    {
      "id": 21230,
      "primary_message": "If using frozen shrimp, place in a medium bowl, cover with cold water, and set aside to thaw. If using fresh shrimp, skip this step.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 21231,
      "primary_message": "Wash and dry bell peppers and parsley.",
      "secondary_message": "2 red bell peppers\r\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 21232,
      "primary_message": "Seed and cut bell peppers into small strips. Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": ""
    },
    {
      "id": 21233,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 21234,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 21235,
      "primary_message": "Drain shrimp in a colander and rinse under cold water until there are no more ice chunks. Spread out on a clean towel and pat dry.",
      "secondary_message": ""
    },
    {
      "id": 21236,
      "primary_message": "Add butter to skillet and let it melt. Add shrimp and cook, stirring frequently, until opaque and pink, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 21237,
      "primary_message": "Reduce heat to medium and add more butter to skillet. Then add garlic, bell peppers, and crushed red pepper. Cook, stirring frequently, until peppers are tender-crisp, 2-3 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\r\n⅛ tsp crushed red pepper"
    },
    {
      "id": 21238,
      "primary_message": "Add broth to skillet and cook until it reduces, 1-2 minutes.",
      "secondary_message": "2 fl oz (¼ cup) chicken or vegetable broth"
    },
    {
      "id": 21239,
      "primary_message": "Finely grate ⅛ cup of Parmesan.",
      "secondary_message": "½ oz Parmesan cheese"
    },
    {
      "id": 21240,
      "primary_message": "Drain pasta in a colander.",
      "secondary_message": ""
    },
    {
      "id": 21241,
      "primary_message": "Add pasta, shrimp, parsley, and Parmesan to skillet. Pour in remaining broth and drizzle with lemon juice. Season with salt and pepper and toss until well combined.",
      "secondary_message": "2 fl oz (¼ cup) chicken or vegetable broth\njuice of ½ lemon\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 21242,
      "primary_message": "Serve pasta on a plate or in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
