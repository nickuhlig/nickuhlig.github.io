  "instructions": [
    {
      "id": 402230,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 402231,
      "primary_message": "Pat salmon dry with paper towels and place, skin-side down, on a baking sheet pan. Season with spices, then spread with Dijon and drizzle with oil. Set aside.",
      "secondary_message": "0.68 kg sockeye salmon fillet\n1 ½ tsp Italian seasoning\n½ tsp salt\n3 pinch black pepper\n1 ½ tbsp Dijon mustard\n1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 402232,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Place on a large baking sheet; season with salt and pepper, then drizzle with additional oil. Toss to coat, then spread out in an even layer.",
      "secondary_message": "3 small bunches asparagus\n¾ tsp salt\n½ tsp black pepper\n1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 402233,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing asparagus halfway through, until salmon easily flakes with a fork and asparagus is tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402234,
      "primary_message": "Meanwhile, small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 402235,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 402236,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 402237,
      "primary_message": "Meanwhile, drain and rinse lentils.",
      "secondary_message": "3 (255 g) cans lentils"
    },
    {
      "id": 402238,
      "primary_message": "When the bacon is done, add lentils to the pot along with vinegar and spices. Continue to cook, stirring occasionally, until the lentils are warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "1 tbsp apple cider vinegar\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 402239,
      "primary_message": "To serve, divide lentils, asparagus, and salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
