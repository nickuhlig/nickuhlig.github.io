  "instructions": [
    {
      "id": 402180,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 402181,
      "primary_message": "Pat salmon dry with paper towels and place, skin-side down, on one half of a baking sheet pan. Season with spices, then spread with Dijon and drizzle with oil.",
      "secondary_message": "½ lb sockeye salmon fillet\n½ tsp Italian seasoning\n⅛ tsp salt\n1 pinch black pepper\n1 ½ tsp Dijon mustard\n1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 402182,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Add to the other half baking sheet; season with salt and pepper, then drizzle with additional oil. Toss asparagus to coat, then spread out in an even layer.",
      "secondary_message": "1 small bunch asparagus\n¼ tsp salt\n⅛ tsp black pepper\n1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 402183,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing asparagus halfway through, until salmon easily flakes with a fork and asparagus is tender, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402184,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 402185,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 402186,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402187,
      "primary_message": "Meanwhile, drain and rinse lentils.",
      "secondary_message": "1 (15 oz) can lentils"
    },
    {
      "id": 402188,
      "primary_message": "When the bacon is done, add lentils to the skillet along with vinegar and spices. Continue to cook, stirring occasionally, until the lentils are warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "1 tsp apple cider vinegar\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 402189,
      "primary_message": "To serve, divide lentils, asparagus, and salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
