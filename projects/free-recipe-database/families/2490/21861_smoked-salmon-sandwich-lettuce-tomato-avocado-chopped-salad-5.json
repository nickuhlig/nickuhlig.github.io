  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 sticks celery\n1 ½ English cucumbers\n1 ½ heads butter (Boston) lettuce\n3 tomatoes\n3 avocados"
    },
    {
      "primary_message": "Place mayo, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "mayonnaise\n2 tbsp apple cider vinegar\n1 ½ tsp dill, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Separate lettuce leaves; set aside one leaf per sandwich. Chop or tear remaining leaves into bite-sized pieces and add to the bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add broccoli slaw to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw"
    },
    {
      "primary_message": "Thinly slice tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon. Add to the plate with the tomato.",
      "secondary_message": null
    },
    {
      "primary_message": "Toast bread if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "To assemble the sandwiches, spread each bread slice with additional mayo. Layer half of the slices with the reserved lettuce, tomato, avocado, and smoked salmon; close with remaining slices.",
      "secondary_message": "mayonnaise\n3 (4 oz) pkgs smoked salmon"
    },
    {
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
