  "instructions": [
    {
      "id": 367430,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n½ English cucumber\n½ head butter (Boston) lettuce\n1 tomato\n1 avocado"
    },
    {
      "id": 367431,
      "primary_message": "Place mayo, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp apple cider vinegar\n½ tsp dill, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 367432,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 367433,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 367434,
      "primary_message": "Separate lettuce leaves; set aside one leaf per sandwich. Chop or tear remaining leaves into bite-sized pieces and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 367435,
      "primary_message": "Add broccoli slaw to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 367436,
      "primary_message": "Thinly slice tomato and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 367437,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon. Add to the plate with the tomato.",
      "secondary_message": null
    },
    {
      "id": 367438,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 367439,
      "primary_message": "To assemble the sandwiches, spread each bread slice with additional mayo. Layer half of the slices with the reserved lettuce, tomato, avocado, and smoked salmon; close with remaining slices.",
      "secondary_message": "4 tsp mayonnaise\n1 (113 g) pkg smoked salmon"
    },
    {
      "id": 367440,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
