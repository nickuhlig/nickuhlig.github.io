  "instructions": [
    {
      "id": 443811,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "½ tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 443812,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 jalapeño pepper\n½ lime\n½ small bunch cilantro\n½ English cucumber"
    },
    {
      "id": 443813,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 443814,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 443815,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 443816,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 443817,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 443818,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add bell pepper, jalapeño, garlic, corn, and spices; cook, stirring frequently, until veggies are soft, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp butter, unsalted\n1 cup frozen corn\n½ tsp smoked paprika\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 443819,
      "primary_message": "Add shrimp to the skillet and continue to cook, stirring often, until opaque, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 443820,
      "primary_message": "While the shrimp are cooking, juice lime into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 443821,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the lime juice, along with yogurt and mayo, then stir to combine the dressing.",
      "secondary_message": "1 oz Parmesan cheese\n⅛ cup plain Greek yogurt\n2 tbsp mayonnaise"
    },
    {
      "id": 443822,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 443823,
      "primary_message": "Trim and small dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 443824,
      "primary_message": "When the shrimp are done, add to the bowl along with the veggies and cooled pasta. Stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 443825,
      "primary_message": "To serve, divide the pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
