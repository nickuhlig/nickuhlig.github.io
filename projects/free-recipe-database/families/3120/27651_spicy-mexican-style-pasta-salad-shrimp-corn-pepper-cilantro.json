  "instructions": [
    {
      "id": 444009,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 444010,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 jalapeño peppers\n1 ½ limes\n1 small bunch cilantro\n1 ½ English cucumbers"
    },
    {
      "id": 444011,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 444012,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 444013,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 444014,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 444015,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 444016,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add bell pepper, jalapeño, garlic, corn, and spices; cook, stirring frequently, until veggies are soft, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp butter, unsalted\n3 cups frozen corn\n1 ½ tsp smoked paprika\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 444017,
      "primary_message": "Add shrimp to the skillet and continue to cook, stirring often, until opaque, 4-5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 444018,
      "primary_message": "While the shrimp are cooking, juice limes into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 444019,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the lime juice, along with yogurt and mayo, then stir to combine the dressing.",
      "secondary_message": "85 g Parmesan cheese\n½ cup plain Greek yogurt\n⅓ cup mayonnaise"
    },
    {
      "id": 444020,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 444021,
      "primary_message": "Trim and small dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 444022,
      "primary_message": "When the shrimp are done, add to the bowl along with the veggies and cooled pasta. Stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 444023,
      "primary_message": "To serve, divide the pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
