  "instructions": [
    {
      "id": 443869,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 443870,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 jalapeño peppers\n1 lime\n1 small bunch cilantro\n1 English cucumber"
    },
    {
      "id": 443871,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 443872,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 443873,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 443874,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 443875,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add bell pepper, jalapeño, garlic, corn, and spices to the skillet; cook, stirring frequently, until veggies are soft, 3-4 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp butter, unsalted\n1 cup frozen corn\n1 tsp smoked paprika\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 443876,
      "primary_message": "While the veggies are cooking, juice lime into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 443877,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the lime juice, along with yogurt and mayo, then stir to combine the dressing.",
      "secondary_message": "2 oz Parmesan cheese\n¼ cup plain Greek yogurt\n¼ cup mayonnaise"
    },
    {
      "id": 443878,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 443879,
      "primary_message": "Trim and small dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 443880,
      "primary_message": "Drain and rinse beans. Add to the bowl, along with the cooled pasta and veggies, then stir to combine the pasta salad.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 443881,
      "primary_message": "To serve, divide the pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
