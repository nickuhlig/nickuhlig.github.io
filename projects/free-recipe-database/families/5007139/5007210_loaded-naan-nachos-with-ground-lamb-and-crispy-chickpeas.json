  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Seed and mince the jalapeño peppers. Dice the onion. Drain and rinse the chickpeas. Mince the ginger. Mince the garlic.",
      "secondary_message": "3 jalapeño peppers, divided\n1 medium onion, divided\n1 (425 g) can chickpeas, and dried\n2 tbsp ginger\n4 cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 205°C (400°F). In a food processor, combine 1/2 cup cilantro, 1 cup mint leaves, 1 jalapeño pepper, 1/2 teaspoon cumin, 1/2 of the chopped onion, and 1 tablespoon lime juice until completely combined. Thin with water until thick but pourable. Season with salt to taste. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cut the naan into triangular pieces and place on a baking sheet. Brush both sides with oil and sprinkle with salt. Bake until golden, about 8 minutes, flipping once halfway through. Keep the oven on but remove the naan chips from the oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Toss the chickpeas with 2/3 teaspoon garam masala, 1/3 teaspoon paprika, 1/3 teaspoon salt, and 2 tablespoons oil. Spread the chickpeas out on the baking sheet and bake until crispy, about 35 minutes, tossing once.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a small bowl, combine the mango, remaining 2 jalapeño peppers (seeded and minced), remaining chopped onion, 2 tablespoons of the minced ginger, and the garlic. Set aside.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Heat 2 tablespoons oil in a skillet over medium-high heat. Add half of the mango mixture and cook, stirring, until fragrant, about 1 minute. Add the ground lamb, 1 teaspoon garam masala, 1 teaspoon cumin, 1 teaspoon ground coriander, remaining 1/2 teaspoon paprika, and salt and pepper to taste. Cook, stirring, until cooked through and set aside.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Mix the remaining mango mixture with remaining 1/4 cup cilantro (chopped), remaining tablespoon lime juice, and 1 tablespoon rice wine vinegar.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Layer the nachos with the ground lamb, roasted chickpeas, mint chutney, mango salsa, and greek yogurt. Garnish with herbs, if desired. Serve immediately",
      "secondary_message": null
    }
  ],
