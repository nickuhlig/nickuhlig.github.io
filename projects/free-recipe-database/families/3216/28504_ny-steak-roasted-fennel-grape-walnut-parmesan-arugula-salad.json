  "instructions": [
    {
      "id": 455432,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 455433,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 fennel bulb\n½ lb red grapes\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 455434,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 455435,
      "primary_message": "Add grapes to the baking sheet with the fennel; drizzle with oil and season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp rosemary, dried\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 455436,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated); roast, stirring halfway through, until fennel and grapes are lightly browned and tender, about 20 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 455437,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455438,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 455439,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 455440,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl along with additional oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "½ shallot\n1 tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n1 tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 455441,
      "primary_message": "Using a peeler, shave Parmesan into curls and add to the bowl with the dressing.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 455442,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "⅛ cup walnuts"
    },
    {
      "id": 455443,
      "primary_message": "Transfer cooled fennel and grapes to the bowl, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 455444,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 455445,
      "primary_message": "To serve, divide steak and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
