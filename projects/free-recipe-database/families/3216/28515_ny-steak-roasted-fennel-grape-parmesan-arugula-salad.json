  "instructions": [
    {
      "id": 455581,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 455582,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 fennel bulbs\n0.68 kg red grapes\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 455583,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Transfer to a large baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 455584,
      "primary_message": "Add grapes to the baking sheet with the fennel; drizzle with oil and season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp rosemary, dried\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 455585,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated); roast, stirring halfway through, until fennel and grapes are lightly browned and tender, 20-25 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 455586,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455587,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 455588,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 455589,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a large bowl along with additional oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "1 shallot\n3 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n1 tbsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 455590,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl with the dressing along with the pumpkin seeds.",
      "secondary_message": "85 g Parmesan cheese\n⅓ cup pumpkin seeds"
    },
    {
      "id": 455591,
      "primary_message": "Transfer cooled fennel and grapes to the bowl, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 455592,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 455593,
      "primary_message": "To serve, divide steak and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
