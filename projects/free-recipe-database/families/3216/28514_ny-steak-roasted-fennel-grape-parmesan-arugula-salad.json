  "instructions": [
    {
      "id": 455568,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 455569,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 fennel bulbs\n0.45 kg red grapes\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 455570,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 455571,
      "primary_message": "Add grapes to the baking sheet with the fennel; drizzle with oil and season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp rosemary, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 455572,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated); roast, stirring halfway through, until fennel and grapes are lightly browned and tender, about 20 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 455573,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455574,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 455575,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 455576,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a large bowl along with additional oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 455577,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl with the dressing along with the pumpkin seeds.",
      "secondary_message": "57 g Parmesan cheese\n¼ cup pumpkin seeds"
    },
    {
      "id": 455578,
      "primary_message": "Transfer cooled fennel and grapes to the bowl, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 455579,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 455580,
      "primary_message": "To serve, divide steak and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
