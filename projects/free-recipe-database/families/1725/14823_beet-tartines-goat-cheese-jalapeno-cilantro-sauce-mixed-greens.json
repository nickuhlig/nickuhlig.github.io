  "instructions": [
    {
      "id": 245295,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 245296,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "2 medium beets\n½ lime\n1 small bunch cilantro\n1 jalapeño pepper\n1 orange\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 245297,
      "primary_message": "Peel, trim, and slice beets into ¼-inch thick rounds. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 245298,
      "primary_message": "Drizzle beets with oil and season with salt and pepper; toss to coat, then arrange in a single layer. Place baking sheet in the oven (it doesn't have to be fully heated) and roast until beets are tender, 15-20 minutes. Remove from oven.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 245299,
      "primary_message": "Meanwhile, set goat cheese on the counter to soften.",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "id": 245300,
      "primary_message": "Juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 245301,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with oil, sugar, cumin, and salt; whisk to combine the lime mixture.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n½ tsp brown sugar\n½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 245302,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime mixture. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 245303,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the jalapeño-cilantro sauce; set aside.",
      "secondary_message": null
    },
    {
      "id": 245304,
      "primary_message": "Peel and mince additional garlic. Place in a medium bowl along with oil, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 245305,
      "primary_message": "Peel and thinly slice shallot into rings. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 245306,
      "primary_message": "Cut off skin and white pith from the orange; slice between the membranes to release segments. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 245307,
      "primary_message": "Split rolls in half and place on another baking sheet, cut-side facing up. Place in the oven and bake until lightly toasted, 3-4 minutes. Remove from oven.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 245308,
      "primary_message": "Roughly chop almonds. Add to the salad bowl along with the mixed greens; toss to combine the salad.",
      "secondary_message": "⅛ cup almonds"
    },
    {
      "id": 245309,
      "primary_message": "Divide toasted rolls between plates; spread each with a thick layer of goat cheese, then top with roasted beets and jalapeño-cilantro sauce. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
