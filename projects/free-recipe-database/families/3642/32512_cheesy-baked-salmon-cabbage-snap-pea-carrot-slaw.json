  "instructions": [
    {
      "id": 513779,
      "primary_message": "Preheat oven to 400°F and arrange rack in the upper third of the oven. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 513780,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ small bunch Italian (flat-leaf) parsley\n2 medium carrots\n½ medium head napa cabbage\n½ (8 oz) pkg sugar snap peas"
    },
    {
      "id": 513781,
      "primary_message": "Juice lemon and divide between a small and medium bowl. Set the medium bowl aside for the slaw. ",
      "secondary_message": null
    },
    {
      "id": 513782,
      "primary_message": "Peel and mince garlic. Add to the small bowl with the lemon juice along with mayo, Dijon, and spices. Whisk to combine.",
      "secondary_message": "1 clove garlic\n1 ½ tbsp mayonnaise\n2 tsp Dijon mustard\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 513783,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 513784,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 513785,
      "primary_message": "Pat salmon dry with paper towels. Place on the baking sheet, skin-side down, and top with sliced onions. Spread mayo mixture over top, then sprinkle with cheese, gently pressing to adhere.",
      "secondary_message": "¾ lb salmon fillet"
    },
    {
      "id": 513786,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through and cheese is melted, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 513787,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the medium bowl with the lemon juice along with mayo, Dijon, oil, maple syrup, poppy seeds, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp mayonnaise\n2 tsp Dijon mustard\n1 tsp extra virgin olive oil\n1 tsp pure maple syrup\n1 tsp poppy seeds\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 513788,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 513789,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 513790,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 513791,
      "primary_message": "When the salmon is done, change oven to broil on high. Broil until the cheese is golden, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 513792,
      "primary_message": "To serve, divide salmon and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
