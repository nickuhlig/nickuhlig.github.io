  "instructions": [
    {
      "id": 513849,
      "primary_message": "Preheat oven to 400°F and arrange rack in the upper third of the oven. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 513850,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch Italian (flat-leaf) parsley\n6 medium carrots\n1 ½ medium heads napa cabbage\n1 ½ (8 oz) pkgs sugar snap peas"
    },
    {
      "id": 513851,
      "primary_message": "Juice lemons and divide between a small and large bowl. Set the large bowl aside for the slaw. ",
      "secondary_message": null
    },
    {
      "id": 513852,
      "primary_message": "Peel and mince garlic. Add to the small bowl with the lemon juice along with mayo, Dijon, and spices. Whisk to combine.",
      "secondary_message": "3 cloves garlic\n¼ cup mayonnaise\n2 tbsp Dijon mustard\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 513853,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 513854,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 513855,
      "primary_message": "Pat salmon dry with paper towels. Place on the baking sheet, skin-side down, and top with sliced onions. Spread mayo mixture over top, then sprinkle with cheese, gently pressing to adhere.",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 513856,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through and cheese is melted, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 513857,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the large bowl with the lemon juice along with mayo, Dijon, oil, poppy seeds, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp avocado oil mayonnaise\n2 tbsp Dijon mustard\n1 tbsp extra virgin olive oil\n1 tbsp poppy seeds\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 513858,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 513859,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 513860,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 513861,
      "primary_message": "When the salmon is done, change oven to broil on high. Broil until the cheese is golden, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 513862,
      "primary_message": "To serve, divide salmon and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
