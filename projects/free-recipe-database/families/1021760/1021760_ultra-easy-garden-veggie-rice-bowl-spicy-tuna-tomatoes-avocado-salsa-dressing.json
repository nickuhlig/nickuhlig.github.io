  "instructions": [
    {
      "primary_message": "Squeeze rice pouches to separate grains, then tear a two-inch opening at the top of each to vent. Place both pouches in the microwave and heat on high until warmed through, about 2 1/2 minutes. Carefully remove from microwave and set aside to cool slightly.",
      "secondary_message": "2 (8.8 oz) pouch garden vegetable rice, pre-cooked"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes.",
      "secondary_message": "1 (12 oz) pkg cherry tomatoes"
    },
    {
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": "1 avocado"
    },
    {
      "primary_message": "To serve, divide rice between bowls, then top with tuna, tomatoes, and avocado. Drizzle with dressing and enjoy!",
      "secondary_message": "2 (2.6 oz) pouch seasoned tuna, jalapeño flavor\n⅓ cup creamy salsa ranch dressing"
    }
  ],
