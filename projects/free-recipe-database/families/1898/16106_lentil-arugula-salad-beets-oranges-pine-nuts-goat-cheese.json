  "instructions": [
    {
      "id": 264267,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 264268,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 medium beets\n2 oranges\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 264269,
      "primary_message": "Peel, trim, and cut beets into ½-inch cubes. Transfer to a baking sheet pan, drizzle with oil, and season with spices. Toss to coat, then spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp rosemary, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 264270,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, stirring halfway through, until fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 264271,
      "primary_message": "Meanwhile, using a strainer, rinse lentils under cold water; drain and transfer to a small saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes.",
      "secondary_message": "⅔ cup brown lentils, dried\n16 fl oz (2 cups) chicken or vegetable broth\n¼ tsp salt"
    },
    {
      "id": 264272,
      "primary_message": "While the lentils are cooking, zest half of the oranges into a medium bowl (reserve oranges for later use).",
      "secondary_message": null
    },
    {
      "id": 264273,
      "primary_message": "Peel and mince shallot; add to the bowl with the orange zest along with vinegar, oil, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n2 tbsp balsamic vinegar\n1 tbsp extra virgin olive oil\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 264274,
      "primary_message": "Cut off skin and white pith from reserved oranges; slice between the membranes to release segments. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 264275,
      "primary_message": "Crumble goat cheese into a small bowl.",
      "secondary_message": "½ (4 oz) log goat cheese"
    },
    {
      "id": 264276,
      "primary_message": "When the lentils are done, drain in a colander, rinse with cold water, and add to the bowl with the orange segments.",
      "secondary_message": null
    },
    {
      "id": 264277,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 264278,
      "primary_message": "To serve, divide salad between plates or bowls; top with roasted beets, pine nuts, and goat cheese. Enjoy!",
      "secondary_message": "⅛ cup pine nuts"
    }
  ],
