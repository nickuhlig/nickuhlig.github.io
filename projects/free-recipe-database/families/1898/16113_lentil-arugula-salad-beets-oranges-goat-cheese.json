  "instructions": [
    {
      "id": 264348,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 264349,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 medium beets\n4 oranges\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 264350,
      "primary_message": "Peel, trim, and cut beets into ½-inch cubes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to coat, then spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp rosemary, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 264351,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, stirring halfway through, until fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 264352,
      "primary_message": "Meanwhile, using a strainer, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes.",
      "secondary_message": "1 ⅓ cups brown lentils, dried\n32 fl oz (4 cups) chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 264353,
      "primary_message": "While the lentils are cooking, zest half of the oranges into a large bowl (reserve oranges for later use).",
      "secondary_message": null
    },
    {
      "id": 264354,
      "primary_message": "Peel and mince shallot; add to the bowl with the orange zest along with vinegar, oil, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n¼ cup balsamic vinegar\n2 tbsp extra virgin olive oil\n4 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 264355,
      "primary_message": "Cut off skin and white pith from reserved oranges; slice between the membranes to release segments. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 264356,
      "primary_message": "Crumble goat cheese into a small bowl.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 264357,
      "primary_message": "When the lentils are done, drain in a colander, rinse with cold water, and add to the bowl with the orange segments.",
      "secondary_message": null
    },
    {
      "id": 264358,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 264359,
      "primary_message": "To serve, divide salad between plates or bowls; top with roasted beets and goat cheese. Enjoy!",
      "secondary_message": null
    }
  ],
