  "instructions": [
    {
      "id": 264291,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 264292,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 medium beets\n6 oranges\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 264293,
      "primary_message": "Peel, trim, and cut beets into ½-inch cubes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to coat, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp rosemary, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264294,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, stirring halfway through, until fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 264295,
      "primary_message": "Meanwhile, using a strainer, rinse lentils under cold water; drain and transfer to a large pot. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes.",
      "secondary_message": "2 cups brown lentils, dried\n48 fl oz (6 cups) chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 264296,
      "primary_message": "While the lentils are cooking, zest half of the oranges into a large bowl (reserve oranges for later use).",
      "secondary_message": null
    },
    {
      "id": 264297,
      "primary_message": "Peel and mince shallots; add to the bowl with the orange zest along with vinegar, oil, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n⅓ cup balsamic vinegar\n3 tbsp extra virgin olive oil\n2 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264298,
      "primary_message": "Cut off skin and white pith from reserved oranges; slice between the membranes to release segments. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 264299,
      "primary_message": "Crumble goat cheese into a small bowl.",
      "secondary_message": "2 (4 oz) logs goat cheese"
    },
    {
      "id": 264300,
      "primary_message": "When the lentils are done, drain in a colander, rinse with cold water, and add to the bowl with the orange segments.",
      "secondary_message": null
    },
    {
      "id": 264301,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 264302,
      "primary_message": "To serve, divide salad between plates or bowls; top with roasted beets, pine nuts, and goat cheese. Enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
