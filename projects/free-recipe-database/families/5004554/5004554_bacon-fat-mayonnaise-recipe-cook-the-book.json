  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Chill the ingredients and utensils (including your mixing bowl) down to about 40°F. Don't skip this step or the mayonnaise may break.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Put the egg yolks, mustard, and 1 1/2 teaspoons of the into a blender or mixing bowl. Beat on high for 2 minutes, until well blended.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the bacon fat (no need to add gradually if everything is properly chilled), continuing to beat until the mixture is thick. Depending on how thick and rich you like your mayonnaise you may or may not need the entire amount of fat.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Slowly blend in the remaining lemon juice, sea salt and pepper, whipping it pretty much continuously throughout. Adjust the seasoning to taste.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "The mayonnaise keeps for a couple of weeks in the refrigerator.",
      "secondary_message": null
    }
  ],
