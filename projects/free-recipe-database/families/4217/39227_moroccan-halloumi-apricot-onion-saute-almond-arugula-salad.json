  "instructions": [
    {
      "id": 631818,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 ½ lemons\n9 apricots\n3 medium carrots\n1 small pkg fresh mint\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 631819,
      "primary_message": "Peel and mince ginger. Place in a small bowl, along with spices, then stir to combine the spice mix.",
      "secondary_message": "1 ½ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp coriander, ground\n¾ tsp cinnamon, ground\n¼ tsp cloves, ground"
    },
    {
      "id": 631820,
      "primary_message": "Juice lemons into a large bowl. Add half of the spice mix (reserving remainder for the halloumi), oil, and maple syrup, then whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup"
    },
    {
      "id": 631821,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin strips. Add to the bowl with the marinade.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 631822,
      "primary_message": "Halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices, add to the bowl, and toss to combine. Set aside.",
      "secondary_message": null
    },
    {
      "id": 631823,
      "primary_message": "Pat halloumi dry with paper towels; holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half lengthwise into 1-inch thick strips. Season both sides with the reserved spice mix.",
      "secondary_message": "3 (250 g) pkgs halloumi cheese"
    },
    {
      "id": 631824,
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 631825,
      "primary_message": "Working in batches if necessary, add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. Remove to a plate and cover with aluminum foil to keep warm. (Reserve skillet for later use and bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 631826,
      "primary_message": "Meanwhile, place oil, vinegar, maple syrup, and spices in another large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp pure maple syrup\n¾ tsp salt\n¼ tsp black pepper\n¼ tsp cumin, ground\n¼ tsp coriander, ground\n¼ tsp cinnamon, ground"
    },
    {
      "id": 631827,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 631828,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 631829,
      "primary_message": "Roughly chop almonds. Add to the bowl, along with arugula, and toss to combine the salad. Set aside.",
      "secondary_message": "⅓ cup almonds"
    },
    {
      "id": 631830,
      "primary_message": "Return the skillet to medium-high heat. Add apricots and onion; cook, stirring occasionally, until tender and caramelized, 3-4 minutes. Return halloumi to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 631831,
      "primary_message": "To serve, divide salad and halloumi sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
