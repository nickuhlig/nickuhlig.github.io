  "instructions": [
    {
      "id": 631709,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 (1 inch) piece ginger root\n½ lemon\n3 apricots\n1 medium carrot\n½ small pkg fresh mint\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 631710,
      "primary_message": "Peel and mince ginger. Place in a small bowl, along with spices, then stir to combine the spice mix.",
      "secondary_message": "½ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp coriander, ground\n¼ tsp cinnamon, ground\n⅛ tsp cloves, ground"
    },
    {
      "id": 631711,
      "primary_message": "Juice lemon into a medium bowl. Add half of the spice mix (reserving remainder for the halloumi), oil, and maple syrup, then whisk to combine the marinade.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp pure maple syrup"
    },
    {
      "id": 631712,
      "primary_message": "Peel and quarter shallot lengthwise. Add to the bowl with the marinade.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 631713,
      "primary_message": "Halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices, add to the bowl, and toss to combine. Set aside.",
      "secondary_message": null
    },
    {
      "id": 631714,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 631715,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels; holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half lengthwise into 1-inch thick strips. Season both sides with the reserved spice mix.",
      "secondary_message": "1 (9 oz) pkg halloumi cheese"
    },
    {
      "id": 631716,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. Remove to a plate and cover with aluminum foil to keep warm. (Reserve skillet for later use and bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 631717,
      "primary_message": "Meanwhile, place oil, vinegar, maple syrup, and spices in another medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp cumin, ground\n⅛ tsp coriander, ground\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 631718,
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 631719,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 631720,
      "primary_message": "Roughly chop almonds. Add to the bowl, along with arugula, and toss to combine the salad. Set aside.",
      "secondary_message": "⅛ cup almonds"
    },
    {
      "id": 631721,
      "primary_message": "Return the skillet to medium-high heat. Add apricots and shallots; cook, stirring occasionally, until tender and caramelized, 2-3 minutes. Return halloumi to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 631722,
      "primary_message": "To serve, divide salad and halloumi sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
