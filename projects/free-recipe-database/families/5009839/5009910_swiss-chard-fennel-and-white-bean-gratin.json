  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Core and slice the fennel thin. Slice the onion thin. Mince the garlic. Freshly grate the nutmeg. Drain and rinse the white beans. Finely grate the Parmesan cheese.",
      "secondary_message": "1 large bulb fennel\n1 large onion\n3 medium cloves garlic\n½ tsp nutmeg\n2 (425 g) cans white beans\n57 g Parmesan cheese"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 200°C (400°F). Melt 2 tablespoons butter in a large sauce pot or Dutch oven over medium-high heat. Add fennel and onion, season with salt and pepper, and cook, stirring occasionally, until vegetables are softened and translucent, about 10 minutes, reducing heat if it starts to brown. Add garlic and cook, stirring constantly until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add 1/3 of Swiss chard and cook, stirring, until wilted, about 1 minute. Repeat with remaining Swiss chard in 2 more batches. Add nutmeg and flour and stir to combine. Add half-and-half, stir to combine, and cook, stirring occasionally, until thickened. Add beans and reduce to a bare simmer. Continue to cook, stirring occasionally, for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, melt remaining 3 tablespoons butter. Toss breadcrumbs, butter, and cheese in a large bowl and season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Season filling with salt and pepper, transfer to a large baking dish, top with breadcrumbs, and bake until golden brown on top and bubbling around the edges, about 30 minutes. Remove from oven, let rest about 10 minutes, and serve.",
      "secondary_message": null
    }
  ],
