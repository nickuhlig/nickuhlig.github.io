  "instructions": [
    {
      "id": 168123,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 168124,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain and add ice or run under cold water to cool.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 168125,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.23 kg sweet potato\n1 medium carrot\n½ medium head napa cabbage\n1 red bell pepper\n1 English cucumber\n½ small bunch cilantro\n0.23 kg green beans\n1 lime"
    },
    {
      "id": 168126,
      "primary_message": "Peel sweet potato; slice lengthwise and crosswise into ¼-inch half rounds. Once the water is boiling in the large pot, add the potatoes and cook until tender, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 168127,
      "primary_message": "Meanwhile, peel and trim carrot; coarsely grate. Transfer to a large plate.",
      "secondary_message": null
    },
    {
      "id": 168128,
      "primary_message": "Quarter the cabbage lengthwise (into wedges) and cut out the core; chop crosswise into bite-sized pieces (about 1-inch-wide). Transfer to the plate with the carrots. ",
      "secondary_message": null
    },
    {
      "id": 168129,
      "primary_message": "Seed and slice pepper into thin strips. Transfer to the plate. ",
      "secondary_message": null
    },
    {
      "id": 168130,
      "primary_message": "Trim and slice cucumber into thin rounds. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 168131,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 168132,
      "primary_message": "Trim the green beans. Add to the potatoes during the last 2-3 minutes of cooking time and cook until bright green and tender-crisp. Drain veggies in a colander and rinse under cold water. ",
      "secondary_message": null
    },
    {
      "id": 168133,
      "primary_message": "Juice the lime into a medium bowl. Add peanut butter, water, soy sauce, maple syrup, and chili-garlic sauce; whisk until smooth. Set aside. ",
      "secondary_message": "¼ cup natural peanut butter\n2 tbsp water\n1 tbsp tamari soy sauce\n1 tbsp pure maple syrup\n2 tsp chili-garlic sauce"
    },
    {
      "id": 168134,
      "primary_message": "Peel and cut eggs in half. ",
      "secondary_message": null
    },
    {
      "id": 168135,
      "primary_message": "To serve, divide the cabbage between bowls, top with sweet potatoes, green beans, eggs, peppers, carrots, and cucumbers. Drizzle with dressing and sprinkle with peanuts and cilantro. Enjoy! ",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    }
  ],
