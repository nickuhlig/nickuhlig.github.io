  "instructions": [
    {
      "id": 168110,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "1 tbsp salt"
    },
    {
      "id": 168111,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 168112,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb sweet potatoes\n3 medium carrots\n1 ½ medium heads napa cabbage\n3 red bell peppers\n3 English cucumbers\n1 small bunch cilantro\n1 ½ lb green beans\n3 limes"
    },
    {
      "id": 168113,
      "primary_message": "Peel sweet potatoes; slice lengthwise and crosswise into ¼-inch half rounds. Once the water is boiling in the large pot, add the potatoes and cook until tender, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 168114,
      "primary_message": "Meanwhile, peel and trim carrots; coarsely grate. Transfer to a large plate.",
      "secondary_message": null
    },
    {
      "id": 168115,
      "primary_message": "Quarter the cabbages lengthwise (into wedges) and cut out the core; chop crosswise into bite-sized pieces (about 1-inch-wide). Transfer to the plate with the carrots. ",
      "secondary_message": null
    },
    {
      "id": 168116,
      "primary_message": "Seed and slice peppers into thin strips. Transfer to the plate. ",
      "secondary_message": null
    },
    {
      "id": 168117,
      "primary_message": "Trim and slice cucumbers into thin rounds. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 168118,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 168119,
      "primary_message": "Trim the green beans. Add to the potatoes during the last 2-3 minutes of cooking time and cook until bright green and tender-crisp. Drain veggies in a colander and rinse under cold water. ",
      "secondary_message": null
    },
    {
      "id": 168120,
      "primary_message": "Juice the limes into a large bowl. Add peanut butter, water, soy sauce, maple syrup, and chili-garlic sauce; whisk until smooth. Set aside. ",
      "secondary_message": "¾ cup natural peanut butter\n⅓ cup water\n3 tbsp tamari soy sauce\n3 tbsp pure maple syrup\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 168121,
      "primary_message": "Peel and cut eggs in half. ",
      "secondary_message": null
    },
    {
      "id": 168122,
      "primary_message": "To serve, divide the cabbage between bowls, top with sweet potatoes, green beans, eggs, peppers, carrots, and cucumbers. Drizzle with dressing and sprinkle with peanuts and cilantro. Enjoy! ",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    }
  ],
