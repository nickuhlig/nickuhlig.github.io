  "instructions": [
    {
      "id": 370867,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 370868,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 370869,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 orange bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 370870,
      "primary_message": "Cut the tofu planks in half, then cut each half into two triangles; transfer to a large baking sheet. Season both sides with salt and pepper, then drizzle both sides with oil. ",
      "secondary_message": "1 tsp salt\n½ tsp black pepper\n2 tbsp toasted sesame oil"
    },
    {
      "id": 370871,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping once, until golden brown, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370872,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with sesame seeds, soy sauce, chili-garlic sauce, honey, vinegar, and pepper. Whisk to combine the sauce and set aside. ",
      "secondary_message": "2 cloves garlic\n2 tbsp sesame seeds\n2 tbsp soy sauce\n2 tbsp chili-garlic sauce\n2 tbsp honey\n4 tsp rice vinegar\n¼ tsp black pepper"
    },
    {
      "id": 370873,
      "primary_message": "Place yogurt, mayo, additional vinegar, oil, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tbsp rice vinegar\n2 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 370874,
      "primary_message": "Trim and slice cucumber into thin rounds; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 370875,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 370876,
      "primary_message": "Trim and cut green onions crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370877,
      "primary_message": "Add broccoli slaw, blue cheese, and additional sesame seeds to the bowl with the dressing; toss to combine the slaw and set aside. ",
      "secondary_message": "1 (12 oz) pkg broccoli slaw\n1 (4 oz) pkg crumbled blue cheese\n4 tsp sesame seeds"
    },
    {
      "id": 370878,
      "primary_message": "When the tofu is done, drizzle with sauce and gently turn to coat.",
      "secondary_message": null
    },
    {
      "id": 370879,
      "primary_message": "To serve, divide tofu and slaw between plates; drizzle any remaining sauce over tofu and enjoy!",
      "secondary_message": null
    }
  ],
