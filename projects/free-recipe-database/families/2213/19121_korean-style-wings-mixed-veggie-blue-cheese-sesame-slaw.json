  "instructions": [
    {
      "id": 370818,
      "primary_message": "Preheat oven to 475°F. Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 370819,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 orange bell pepper\n½ small bunch green onions (scallions)"
    },
    {
      "id": 370820,
      "primary_message": "Pat chicken wings dry with paper towels and transfer to the baking sheet. Sprinkle with baking powder and salt; toss to coat and spread out in an even layer.",
      "secondary_message": "1 lb chicken wings, split with tips removed\n1 tsp baking powder\n½ tsp salt"
    },
    {
      "id": 370821,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370822,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with sesame seeds, soy sauce, chili-garlic sauce, honey, vinegar, and pepper. Whisk to combine the wing sauce and set aside. ",
      "secondary_message": "1 clove garlic\n1 tbsp sesame seeds\n1 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 tbsp honey\n2 tsp rice vinegar\n⅛ tsp black pepper"
    },
    {
      "id": 370823,
      "primary_message": "Place yogurt, mayo, additional vinegar, oil, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tbsp mayonnaise\n2 tsp rice vinegar\n1 tsp toasted sesame oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 370824,
      "primary_message": "Trim and slice cucumber into thin rounds; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 370825,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 370826,
      "primary_message": "Trim and cut green onions crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370827,
      "primary_message": "Add broccoli slaw, blue cheese, and additional sesame seeds to the bowl with the dressing and veggies; toss to combine the slaw and set aside. ",
      "secondary_message": "½ (12 oz) pkg broccoli slaw\n½ (4 oz) pkg crumbled blue cheese\n2 tsp sesame seeds"
    },
    {
      "id": 370828,
      "primary_message": "When the wings are done, drizzle with sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 370829,
      "primary_message": "To serve, divide wings and slaw between plates; drizzle any remaining sauce over wings and enjoy!",
      "secondary_message": null
    }
  ],
