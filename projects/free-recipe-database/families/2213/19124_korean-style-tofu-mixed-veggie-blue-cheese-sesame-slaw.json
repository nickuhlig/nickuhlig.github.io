  "instructions": [
    {
      "id": 370854,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 370855,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 370856,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 orange bell pepper\n½ small bunch green onions (scallions)"
    },
    {
      "id": 370857,
      "primary_message": "Cut the tofu planks in half, then cut each half into two triangles; transfer to a baking sheet. Season both sides with salt and pepper, then drizzle both sides with oil. ",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper\n1 tbsp toasted sesame oil"
    },
    {
      "id": 370858,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping once, until golden brown, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370859,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with sesame seeds, soy sauce, chili-garlic sauce, honey, vinegar, and pepper. Whisk to combine the sauce and set aside. ",
      "secondary_message": "1 clove garlic\n1 tbsp sesame seeds\n1 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 tbsp honey\n2 tsp rice vinegar\n⅛ tsp black pepper"
    },
    {
      "id": 370860,
      "primary_message": "Place yogurt, mayo, additional vinegar, oil, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 tbsp rice vinegar\n1 tsp toasted sesame oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 370861,
      "primary_message": "Trim and slice cucumber into thin rounds; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 370862,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 370863,
      "primary_message": "Trim and cut green onions crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370864,
      "primary_message": "Add broccoli slaw, blue cheese, and additional sesame seeds to the bowl with the dressing; toss to combine the slaw and set aside. ",
      "secondary_message": "½ (12 oz) pkg broccoli slaw\n½ (4 oz) pkg crumbled blue cheese\n2 tsp sesame seeds"
    },
    {
      "id": 370865,
      "primary_message": "When the tofu is done, drizzle with sauce and gently turn to coat.",
      "secondary_message": null
    },
    {
      "id": 370866,
      "primary_message": "To serve, divide tofu and slaw between plates; drizzle any remaining sauce over tofu and enjoy!",
      "secondary_message": null
    }
  ],
