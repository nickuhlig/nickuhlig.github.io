  "instructions": [
    {
      "id": 370992,
      "primary_message": "Preheat oven to 245°C (475°F). Line two baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 370993,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 orange bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 370994,
      "primary_message": "Pat chicken wings dry with paper towels and divide between the baking sheets. Sprinkle with baking powder and salt; toss to coat and spread out in an even layer.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed\n1 tbsp baking powder\n1 ½ tsp salt"
    },
    {
      "id": 370995,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370996,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with sesame seeds, soy sauce, chili-garlic sauce, honey, vinegar, and pepper. Whisk to combine the wing sauce and set aside. ",
      "secondary_message": "3 cloves garlic\n3 tbsp sesame seeds\n3 tbsp soy sauce\n3 tbsp chili-garlic sauce\n3 tbsp honey\n2 tbsp rice vinegar\n½ tsp black pepper"
    },
    {
      "id": 370997,
      "primary_message": "Place yogurt, mayo, additional vinegar, oil, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp mayonnaise\n2 tbsp rice vinegar\n1 tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 370998,
      "primary_message": "Trim and slice cucumbers into thin rounds; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 370999,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 371000,
      "primary_message": "Trim and cut green onions crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 371001,
      "primary_message": "Add broccoli slaw, blue cheese, and additional sesame seeds to the bowl with the dressing and veggies; toss to combine the slaw and set aside. ",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw\n1 ½ (113 g) pkg crumbled blue cheese\n2 tbsp sesame seeds"
    },
    {
      "id": 371002,
      "primary_message": "When the wings are done, drizzle with sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 371003,
      "primary_message": "To serve, divide wings and slaw between plates; drizzle any remaining sauce over wings and enjoy!",
      "secondary_message": null
    }
  ],
