  "instructions": [
    {
      "id": 370880,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 370881,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 370882,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 orange bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 370883,
      "primary_message": "Cut the tofu planks in half, then cut each half into two triangles; divide between two baking sheets. Season both sides with salt and pepper, then drizzle both sides with oil. ",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper\n3 tbsp toasted sesame oil"
    },
    {
      "id": 370884,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping once, until golden brown, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370885,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with sesame seeds, soy sauce, chili-garlic sauce, honey, vinegar, and pepper. Whisk to combine the sauce and set aside. ",
      "secondary_message": "3 cloves garlic\n3 tbsp sesame seeds\n3 tbsp soy sauce\n3 tbsp chili-garlic sauce\n3 tbsp honey\n2 tbsp rice vinegar\n½ tsp black pepper"
    },
    {
      "id": 370886,
      "primary_message": "Place yogurt, mayo, additional vinegar, oil, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n3 tbsp mayonnaise\n3 tbsp rice vinegar\n1 tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 370887,
      "primary_message": "Trim and slice cucumbers into thin rounds; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 370888,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 370889,
      "primary_message": "Trim and cut green onions crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370890,
      "primary_message": "Add broccoli slaw, blue cheese, and additional sesame seeds to the bowl with the dressing; toss to combine the slaw and set aside. ",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw\n1 ½ (4 oz) pkgs crumbled blue cheese\n2 tbsp sesame seeds"
    },
    {
      "id": 370891,
      "primary_message": "When the tofu is done, drizzle with sauce and gently turn to coat.",
      "secondary_message": null
    },
    {
      "id": 370892,
      "primary_message": "To serve, divide tofu and slaw between plates; drizzle any remaining sauce over tofu and enjoy!",
      "secondary_message": null
    }
  ],
