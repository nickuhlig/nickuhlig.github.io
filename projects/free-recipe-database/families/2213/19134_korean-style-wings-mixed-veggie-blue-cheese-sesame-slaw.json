  "instructions": [
    {
      "id": 370980,
      "primary_message": "Preheat oven to 245°C (475°F). Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 370981,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 orange bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 370982,
      "primary_message": "Pat chicken wings dry with paper towels and transfer to the baking sheet. Sprinkle with baking powder and salt; toss to coat and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed\n2 tsp baking powder\n1 tsp salt"
    },
    {
      "id": 370983,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370984,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with sesame seeds, soy sauce, chili-garlic sauce, honey, vinegar, and pepper. Whisk to combine the wing sauce and set aside. ",
      "secondary_message": "2 cloves garlic\n2 tbsp sesame seeds\n2 tbsp soy sauce\n2 tbsp chili-garlic sauce\n2 tbsp honey\n4 tsp rice vinegar\n¼ tsp black pepper"
    },
    {
      "id": 370985,
      "primary_message": "Place yogurt, mayo, additional vinegar, oil, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n4 tsp rice vinegar\n2 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 370986,
      "primary_message": "Trim and slice cucumber into thin rounds; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 370987,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 370988,
      "primary_message": "Trim and cut green onions crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370989,
      "primary_message": "Add broccoli slaw, blue cheese, and additional sesame seeds to the bowl with the dressing and veggies; toss to combine the slaw and set aside. ",
      "secondary_message": "1 (340 g) pkg broccoli slaw\n1 (113 g) pkg crumbled blue cheese\n4 tsp sesame seeds"
    },
    {
      "id": 370990,
      "primary_message": "When the wings are done, drizzle with sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 370991,
      "primary_message": "To serve, divide wings and slaw between plates; drizzle any remaining sauce over wings and enjoy!",
      "secondary_message": null
    }
  ],
