  "instructions": [
    {
      "id": 421326,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 421327,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g penne pasta"
    },
    {
      "id": 421328,
      "primary_message": "Meanwhile, medium dice peppers and set aside.",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers"
    },
    {
      "id": 421329,
      "primary_message": "Place spinach in a colander.",
      "secondary_message": "1 ½ (454 g) bags frozen chopped spinach"
    },
    {
      "id": 421330,
      "primary_message": "When the pasta is done, drain in the colander over the spinach; return pasta and spinach to the pot.",
      "secondary_message": null
    },
    {
      "id": 421331,
      "primary_message": "Add diced peppers, marinara sauce, and ricotta to the pot with the pasta and spinach; stir to combine.",
      "secondary_message": "1 ½ (680 g) jars marinara sauce\n1 ½ (425 g) pkgs ricotta cheese"
    },
    {
      "id": 421332,
      "primary_message": "Place pasta over medium heat and cook, stirring occasionally, until just warmed through, 2-3 minutes. Divide pasta between two baking dishes and top with cheese.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 421333,
      "primary_message": "Place baking dishes in the oven and bake until cheese is melted and sauce is bubbly, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 421334,
      "primary_message": "To serve, divide pasta bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
