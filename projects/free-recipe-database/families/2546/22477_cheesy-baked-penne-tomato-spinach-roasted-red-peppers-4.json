  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "primary_message": "Meanwhile, medium dice peppers and set aside.",
      "secondary_message": "½ (12 oz) jar roasted red bell peppers"
    },
    {
      "primary_message": "Place spinach in a colander.",
      "secondary_message": "½ (16oz) bag frozen chopped spinach"
    },
    {
      "primary_message": "When the pasta is done, drain in the colander over the spinach; return pasta and spinach to the pan.",
      "secondary_message": null
    },
    {
      "primary_message": "Add diced peppers, marinara sauce, and ricotta to the pan with the pasta and spinach; stir to combine.",
      "secondary_message": "½ (24 oz) jar marinara sauce\n½ (15 oz) pkg ricotta cheese"
    },
    {
      "primary_message": "Place pasta over medium heat and cook, stirring occasionally, until just warmed through, 1-2 minutes. Transfer pasta to a baking dish and top with cheese.",
      "secondary_message": "½ cup shredded cheese, Italian blend"
    },
    {
      "primary_message": "Place baking dish in the oven and bake until cheese is melted and sauce is bubbly, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pasta bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
