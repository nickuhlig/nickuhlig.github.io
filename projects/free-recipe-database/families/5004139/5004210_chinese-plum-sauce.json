  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pit and chop the plums. Freshly grate the ginger.",
      "secondary_message": "12 plums\n3 tbsp ginger root"
    },
    {
      "id": 1,
      "primary_message": "Prepare: Combine the plums, vinegar, brown sugar, soy sauce, ginger, garlic, and star anise in a large nonreactive pot, and bring to a boil. Reduce the heat and simmer until thickened, 20 to 25 minutes. Fish out the star anise and discard. Purée the sauce with a stick blender.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Refrigerate: Ladle into bowls or jars. Cool, cover, and refrigerate for up to 3 weeks.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Can: Use the boiling-water method. Ladle into clean, hot 113 g or half-pint canning jars, leaving 0.5 cm of headspace. Release trapped air. Wipe the rims clean; center lids on the jars and screw on jar bands. Process for 10 minutes. Turn off heat, remove canner lid, and let jars rest in the water for 5 minutes. Remove jars and set aside for 24 hours. Check seals, then store in a cool, dark place for up to 1 year.",
      "secondary_message": null
    }
  ],
