  "instructions": [
    {
      "id": 572036,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 572037,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 English cucumbers\n4 red chili peppers\n1 small bunch cilantro"
    },
    {
      "id": 572038,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 572039,
      "primary_message": "While the rice is cooking, place vinegar, honey, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "¼ cup red wine vinegar\n4 tsp honey\n½ tsp salt"
    },
    {
      "id": 572040,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl with the pickling liquid. ",
      "secondary_message": null
    },
    {
      "id": 572041,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 572042,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Place in a blender. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 572043,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 572044,
      "primary_message": "Peel garlic. Add to the blender along with oil, vinegar, and spices. Blend on high until peri-peri sauce is smooth. Transfer to another medium bowl.",
      "secondary_message": "4 cloves garlic\n¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n2 tsp smoked paprika\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 572045,
      "primary_message": "Pat the chicken thighs dry with paper towels and add to the bowl with the sauce; turn to coat.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 572046,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 572047,
      "primary_message": "Once the pan is hot, add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 572048,
      "primary_message": "To serve, divide rice, chicken, and pickled cucumbers between plates. Enjoy!",
      "secondary_message": null
    }
  ],
