  "instructions": [
    {
      "id": 572221,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 572222,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 572223,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n6 red chili peppers\n2 small bunches cilantro"
    },
    {
      "id": 572224,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 572225,
      "primary_message": "While the rice is cooking, place vinegar, honey, and salt in a large bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "⅓ cup red wine vinegar\n2 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 572226,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl with the pickling liquid. ",
      "secondary_message": null
    },
    {
      "id": 572227,
      "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 572228,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Place in a blender. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 572229,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 572230,
      "primary_message": "Peel garlic. Add to the blender along with oil, vinegar, and spices. Blend on high until peri-peri sauce is smooth. Set aside.",
      "secondary_message": "6 cloves garlic\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp smoked paprika\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 572231,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 572232,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in another large bowl, sprinkle with cornstarch and salt, then gently toss to coat.",
      "secondary_message": "3 tbsp cornstarch\n1 ½ tsp salt"
    },
    {
      "id": 572233,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes. Transfer to a plate.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 572234,
      "primary_message": "Return tofu to the skillet, then add sauce. Continue to cook, stirring occasionally, until sauce is warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 572235,
      "primary_message": "To serve, divide rice, tofu, and pickled cucumbers between plates. Enjoy!",
      "secondary_message": null
    }
  ],
