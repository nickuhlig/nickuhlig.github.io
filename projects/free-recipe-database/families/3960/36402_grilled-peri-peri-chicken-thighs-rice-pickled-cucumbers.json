  "instructions": [
    {
      "id": 572049,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 572050,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n6 red chili peppers\n2 small bunches cilantro"
    },
    {
      "id": 572051,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 572052,
      "primary_message": "While the rice is cooking, place vinegar, honey, and salt in a large bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "⅓ cup red wine vinegar\n2 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 572053,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl with the pickling liquid. ",
      "secondary_message": null
    },
    {
      "id": 572054,
      "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 572055,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Place in a blender. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 572056,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 572057,
      "primary_message": "Peel garlic. Add to the blender along with oil, vinegar, and spices. Blend on high until peri-peri sauce is smooth. Transfer to another large bowl.",
      "secondary_message": "6 cloves garlic\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp smoked paprika\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 572058,
      "primary_message": "Pat the chicken thighs dry with paper towels and add to the bowl with the sauce; turn to coat.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 572059,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 572060,
      "primary_message": "Once the pan is hot, working in batches if necessary, add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 572061,
      "primary_message": "To serve, divide rice, chicken, and pickled cucumbers between plates. Enjoy!",
      "secondary_message": null
    }
  ],
