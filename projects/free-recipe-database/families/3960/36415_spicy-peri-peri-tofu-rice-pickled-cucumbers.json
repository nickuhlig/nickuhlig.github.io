  "instructions": [
    {
      "id": 572236,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 572237,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 572238,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 red chili peppers\n½ small bunch cilantro"
    },
    {
      "id": 572239,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 572240,
      "primary_message": "While the rice is cooking, place vinegar, maple syrup, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "2 tbsp red wine vinegar\n2 tsp pure maple syrup\n¼ tsp salt"
    },
    {
      "id": 572241,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the bowl with the pickling liquid. ",
      "secondary_message": null
    },
    {
      "id": 572242,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 572243,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Place in a blender. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 572244,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 572245,
      "primary_message": "Peel garlic. Add to the blender along with oil, vinegar, and spices. Blend on high until peri-peri sauce is smooth. Set aside.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp smoked paprika\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 572246,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 572247,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in another medium bowl, sprinkle with cornstarch and salt, then gently toss to coat.",
      "secondary_message": "1 tbsp cornstarch\n½ tsp salt"
    },
    {
      "id": 572248,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 572249,
      "primary_message": "Add sauce to the skillet. Continue to cook, stirring occasionally, until sauce is warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 572250,
      "primary_message": "To serve, divide rice, tofu, and pickled cucumbers between plates. Enjoy!",
      "secondary_message": null
    }
  ],
