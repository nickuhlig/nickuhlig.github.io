  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place cherries in a colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "2 cups frozen cherries"
    },
    {
      "primary_message": "Wash, dry, peel, and mince ginger. ",
      "secondary_message": "2 (1 inch) pieces ginger root"
    },
    {
      "primary_message": "Place ginger, oats, flour, sugar, cinnamon, and salt in a medium bowl.",
      "secondary_message": "1 cup oats, quick cooking\nbrown sugar\n⅛ tsp salt"
    },
    {
      "primary_message": "Using a box grater, coarsely grate cold butter into the bowl with the flour. Using two hands, combine the flour and butter by rubbing the mixture between your thumbs and fingers until it looks crumbly.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "primary_message": "Transfer crumble mixture to the baking sheet and spread out in an even layer. Place in the oven and bake until golden brown, about 10 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, zest, and juice lemon into the bowl used for the crumble. ",
      "secondary_message": "1 lemon"
    },
    {
      "primary_message": "Using a box grater, coarsely grate cream cheese into the bowl; add sugar and vanilla. Use a silicone spatula or fork to soften and combine the cream cheese mixture, creating a smooth cream.",
      "secondary_message": "⅔ (227 g) block cream cheese\nbrown sugar\n1 tsp vanilla extract"
    },
    {
      "primary_message": "Roughly chop cherries.",
      "secondary_message": null
    },
    {
      "primary_message": "Add cherries (reserving a small handful for garnish) and yogurt to the bowl with the cream cheese; using a silicone spatula or fork, fold the two together to combine the cheesecake mixture.",
      "secondary_message": "2 cups plain Greek yogurt"
    },
    {
      "primary_message": "To serve, divide cheesecake mixture and crumble between small bowls, cups, or jars, alternating ingredients to create layers. Top trifles with reserved cherries and enjoy!",
      "secondary_message": null
    }
  ],
