  "instructions": [
    {
      "id": 461412,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 461413,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461414,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a plate. Season with spices on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n½ tsp smoked paprika\n½ tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 461415,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the chicken and sear until golden brown, 2-3 minutes per side (the chicken will not be cooked all the way through). Remove to a clean plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 461416,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lb cremini mushrooms\n1 red bell pepper\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 461417,
      "primary_message": "Thinly slice mushrooms and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 461418,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 461419,
      "primary_message": "Drain and rinse beans. Add to the bowl.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 461420,
      "primary_message": "Return skillet (with cooking juices) to medium heat, add more oil, and swirl to coat the bottom. Add veggies, beans, and spices; cook, stirring occasionally, until veggies soften, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 461421,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 461422,
      "primary_message": "Nestle chicken into the veggies and crumble goat cheese over the top. Place skillet in the oven and bake until cheese is melted and chicken is cooked through, 7-8 minutes. Remove from oven.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 461423,
      "primary_message": "To serve, divide chicken and veggie skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
