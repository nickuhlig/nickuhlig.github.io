  "instructions": [
    {
      "id": 461473,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 461474,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461475,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a plate. Season with spices on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1 ½ tsp smoked paprika\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 461476,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the chicken and sear until golden brown, 2-3 minutes per side (the chicken will not be cooked all the way through). Remove to a clean plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 461477,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg cremini mushrooms\n3 red bell peppers\n3 (142 g) pkgs baby spinach"
    },
    {
      "id": 461478,
      "primary_message": "Thinly slice mushrooms and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 461479,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 461480,
      "primary_message": "Drain and rinse beans. Add to the bowl.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 461481,
      "primary_message": "Return skillet (with cooking juices) to medium heat, add more oil, and swirl to coat the bottom. Add veggies, beans, and spices; cook, stirring occasionally, until veggies soften, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 461482,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 461483,
      "primary_message": "Transfer veggies to a large baking dish. Nestle chicken into the veggies and crumble goat cheese over the top.",
      "secondary_message": "3 (113 g) logs goat cheese"
    },
    {
      "id": 461484,
      "primary_message": "Place baking dish in the oven and bake until cheese is melted and chicken is cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 461485,
      "primary_message": "To serve, divide chicken and veggie bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
