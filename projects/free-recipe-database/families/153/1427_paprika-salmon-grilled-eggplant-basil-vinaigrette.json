  "instructions": [
    {
      "id": 12532,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 12533,
      "primary_message": "In a small bowl, mix together oil, paprika, cumin, salt, and pepper.",
      "secondary_message": "1 tsp extra virgin olive oil\r\n⅛ tsp paprika\r\n⅛ tsp cumin\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 12534,
      "primary_message": "Rub salmon with spice mixture.",
      "secondary_message": "¾ lb salmon fillet"
    },
    {
      "id": 12535,
      "primary_message": "Coat grill or bottom of skillet with oil. Add salmon and cook until opaque, 4-5 minutes per side. Transfer to a plate.",
      "secondary_message": "about 1 tbsp virgin coconut oil"
    },
    {
      "id": 12536,
      "primary_message": "Wash, dry, and slice eggplant into ¼ inch thick pieces. Transfer to a large bowl, drizzle with oil, and season with salt; toss to coat.",
      "secondary_message": "1 eggplant\r\n1 tbsp extra virgin olive oil\r\n⅛ tsp salt"
    },
    {
      "id": 12537,
      "primary_message": "Add eggplant to grill/skillet and cook until tender and lightly browned, 2-3 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 12538,
      "primary_message": "Wash and dry basil. Pick leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. In a small bowl, whisk together basil, garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "½ small pkg fresh basil\r\n1 clove garlic\r\n2 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n1 pinch salt\r\n1 pinch black pepper"
    },
    {
      "id": 12539,
      "primary_message": "To serve, place salmon and eggplant on a plate and drizzle with basil vinaigrette. Enjoy!",
      "secondary_message": ""
    }
  ],
