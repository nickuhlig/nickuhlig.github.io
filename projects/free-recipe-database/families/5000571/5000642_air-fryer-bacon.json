  "instructions": [
    {
      "id": 1,
      "primary_message": "Set air fryer to 175°C (350°F) (175ºC) and preheat for 10 minutes. Place bacon in the basket, trying not to overlap (it’s okay if the bacon comes up the sides of the basket slightly). Cook, using tongs to flip halfway through, for 8 to 10 minutes for tender-crisp and 10 to 12 minutes for shattering-crisp bacon. (For thick-cut bacon, cook for 12 minutes for tender-crisp and 14 to 15 minutes for shattering-crisp, flipping halfway through).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer the bacon onto a plate lined with paper towels and allow it to drain. Serve.",
      "secondary_message": null
    }
  ],
