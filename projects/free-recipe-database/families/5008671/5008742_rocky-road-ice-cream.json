  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the roasted hazelnuts. Chop the roasted almonds. Chop the dark chocolate. Chop the white chocolate.",
      "secondary_message": "57 g roasted hazelnuts\n57 g roasted almonds\n71 g dark chocolate\n71 g white chocolate"
    },
    {
      "id": 1,
      "primary_message": "In a large, heavy saucepan whisk together egg yolks and cocoa until very smooth and no lumps remain. Slowly whisk in sugar. If mixture is too dry, whisk in 1 or 2 tablespoons of cream to make a smooth paste.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Once the yolk paste is smooth and all the sugar is incorporated, whisk in remaining cream and milk. Put pan over medium heat and cook, whisking frequently, until a custard thickly coats the back of a spoon, but a swiped finger leaves a clean line. Strain into an airtight container, stir in vanilla and salt, and chill in refrigerator overnight.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "The next day, churn in ice cream maker according to manufacturer's instructions. Transfer ice cream to a container capable of holding 2 quarts or larger, and quickly stir in nuts, chocolates, and marshmallows with a rubber spatula until thoroughly mixed in. Chill in freezer for at least 3 hours before serving.",
      "secondary_message": null
    }
  ],
