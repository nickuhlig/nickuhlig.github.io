  "instructions": [
    {
      "id": 389917,
      "primary_message": "Preheat the oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 389918,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 yellow bell peppers\n3 limes\n1 ½ medium heads cauliflower\n3 avocados\n1 small bunch cilantro"
    },
    {
      "id": 389919,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 389920,
      "primary_message": "Peel, halve, and slice onions crosswise into ½-inch thick half-moons. Add to the bowl with the peppers along with oil, soy sauce, and spices; toss to combine. Divide veggies between two baking sheet pans and spread out in an even layer.",
      "secondary_message": "3 medium red onions\n2 tbsp extra virgin olive oil\n1 tbsp soy sauce\n1 ½ tbsp chili powder\n1 tbsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 389921,
      "primary_message": "Juice half of the limes over the veggies. Cut remaining limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 389922,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and starting to char, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 389923,
      "primary_message": "Meanwhile, cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.)",
      "secondary_message": null
    },
    {
      "id": 389924,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 389925,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower and salt; cook, stirring often, until cauliflower is lightly golden and cooked through, 7-8 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 389926,
      "primary_message": "While the cauliflower is cooking, drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans pinto beans"
    },
    {
      "id": 389927,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 389928,
      "primary_message": "When the veggies are done, remove from the oven. Add beans and additional soy sauce to the baking sheets; stir to combine, spread out in an even layer, and sprinkle with cheese.",
      "secondary_message": "1 tbsp soy sauce"
    },
    {
      "id": 389929,
      "primary_message": "Return baking sheets to the oven and continue to bake until beans are warmed through and cheese is melted, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 389930,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. ",
      "secondary_message": null
    },
    {
      "id": 389931,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the cauliflower rice and stir to combine. (Set remaining cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 389932,
      "primary_message": "Divide cauliflower rice, cheesy fajita bake, and avocado between bowls; sprinkle with reserved cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
