  "instructions": [
    {
      "id": 389837,
      "primary_message": "Preheat the oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 389838,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 red bell pepper\n1 yellow bell pepper\n½ medium head cauliflower\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 389839,
      "primary_message": "Juice half of the lime into a medium bowl. Cut remaining lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 389840,
      "primary_message": "Add oil, soy sauce, and spices to the bowl with the lime juice. Stir to combine the spice paste and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp soy sauce\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 389841,
      "primary_message": "Pat steak dry with paper towels and place in the center of a baking sheet pan; drizzle with half of the spice paste, turning the steak to coat on both sides (reserve remaining spice paste for the veggies).",
      "secondary_message": "⅓ kg striploin (New York strip) steak"
    },
    {
      "id": 389842,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the remaining spice paste.",
      "secondary_message": null
    },
    {
      "id": 389843,
      "primary_message": "Peel, halve, and slice onion crosswise into ½-inch thick half-moons. Add to the bowl, then toss veggies in the spice paste to coat.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 389844,
      "primary_message": "Add veggies to the baking sheet, arranging them in an even layer around the steak.",
      "secondary_message": null
    },
    {
      "id": 389845,
      "primary_message": "Place baking sheet in the oven and roast, stirring veggies and flipping steak halfway through, until veggies are tender and steak is cooked to desired doneness, 13-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 389846,
      "primary_message": "Meanwhile, cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.)",
      "secondary_message": null
    },
    {
      "id": 389847,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 389848,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower and salt; cook, stirring often, until cauliflower is lightly golden and cooked through, 5-7 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 389849,
      "primary_message": "While the cauliflower rice is cooking, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the cauliflower rice and stir to combine. (Set remaining cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 389850,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Set aside.",
      "secondary_message": null
    },
    {
      "id": 389851,
      "primary_message": "Transfer steak to the cutting board and thinly slice against the grain.",
      "secondary_message": null
    },
    {
      "id": 389852,
      "primary_message": "Divide cauliflower rice, steak, veggies, and avocado between bowls; sprinkle with reserved cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
