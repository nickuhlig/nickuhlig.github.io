  "instructions": [
    {
      "id": 389693,
      "primary_message": "Preheat the oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 389694,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 yellow bell pepper\n1 lime\n½ medium head cauliflower\n1 avocado\n½ small bunch cilantro"
    },
    {
      "id": 389695,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 389696,
      "primary_message": "Peel, halve, and slice onion crosswise into ½-inch thick half-moons. Add to the bowl with the peppers along with oil, soy sauce, and spices; toss to combine. Transfer veggies to a baking sheet pan and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n2 tsp extra virgin olive oil\n1 tsp soy sauce\n1 ½ tsp chili powder\n1 tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 389697,
      "primary_message": "Juice half of the lime over the veggies. Cut remaining lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 389698,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and starting to char, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 389699,
      "primary_message": "Meanwhile, cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.)",
      "secondary_message": null
    },
    {
      "id": 389700,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 389701,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower and salt; cook, stirring often, until cauliflower is lightly golden and cooked through, 5-7 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 389702,
      "primary_message": "While the cauliflower is cooking, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can pinto beans"
    },
    {
      "id": 389703,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "⅓ (8 oz) block cheddar cheese"
    },
    {
      "id": 389704,
      "primary_message": "When the veggies are done, remove from the oven. Add beans and additional soy sauce to the baking sheet; stir to combine, spread out in an even layer, and sprinkle with cheese.",
      "secondary_message": "1 tsp soy sauce"
    },
    {
      "id": 389705,
      "primary_message": "Return baking sheet to the oven and continue to bake until beans are warmed through and cheese is melted, 3-4 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 389706,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. ",
      "secondary_message": null
    },
    {
      "id": 389707,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the cauliflower rice and stir to combine. (Set remaining cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 389708,
      "primary_message": "Divide cauliflower rice, cheesy fajita bake, and avocado between bowls; sprinkle with reserved cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
