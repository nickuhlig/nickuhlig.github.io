  "instructions": [
    {
      "id": 389869,
      "primary_message": "Preheat the oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 389870,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n3 red bell peppers\n3 yellow bell peppers\n1 ½ medium heads cauliflower\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 389871,
      "primary_message": "Juice half of the limes into a large bowl. Cut remaining limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 389872,
      "primary_message": "Add oil, soy sauce, and spices to the bowl with the lime juice. Stir to combine the spice paste and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp soy sauce\n3 tbsp chili powder\n1 ½ tbsp cumin, ground\n1 ½ tsp salt"
    },
    {
      "id": 389873,
      "primary_message": "Pat steak dry with paper towels and divide between two baking sheet pans; drizzle with half of the spice paste, turning the steak to coat on both sides (reserve remaining spice paste for the veggies).",
      "secondary_message": "1.02 kg striploin (New York strip) steak"
    },
    {
      "id": 389874,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the remaining spice paste.",
      "secondary_message": null
    },
    {
      "id": 389875,
      "primary_message": "Peel, halve, and slice onions crosswise into ½-inch thick half-moons. Add to the bowl, then toss veggies in the spice paste to coat.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 389876,
      "primary_message": "Add veggies to the baking sheets, arranging them in an even layer around the steak.",
      "secondary_message": null
    },
    {
      "id": 389877,
      "primary_message": "Place baking sheets in the oven and roast, stirring veggies and flipping steak halfway through, until veggies are tender and steak is cooked to desired doneness, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 389878,
      "primary_message": "Meanwhile, cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.)",
      "secondary_message": null
    },
    {
      "id": 389879,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 389880,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower and salt; cook, stirring often, until cauliflower is lightly golden and cooked through, 7-8 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 389881,
      "primary_message": "While the cauliflower rice is cooking, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the cauliflower rice and stir to combine. (Set remaining cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 389882,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Set aside.",
      "secondary_message": null
    },
    {
      "id": 389883,
      "primary_message": "Transfer steak to the cutting board and thinly slice against the grain.",
      "secondary_message": null
    },
    {
      "id": 389884,
      "primary_message": "Divide cauliflower rice, steak, veggies, and avocado between bowls; sprinkle with reserved cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
