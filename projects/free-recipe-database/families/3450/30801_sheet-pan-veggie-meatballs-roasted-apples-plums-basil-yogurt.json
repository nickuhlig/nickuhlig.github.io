  "instructions": [
    {
      "id": 488631,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a large baking sheet pan with a thin layer of oil and set aside for the \"meatballs.\"",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 488632,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "6 plums\n6 Gala apples\n1 small pkg fresh basil"
    },
    {
      "id": 488633,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ½-inch thick slices. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 488634,
      "primary_message": "Quarter, core, and slice apples into ¼-inch thick wedges. Add to the bowl with the plums.",
      "secondary_message": null
    },
    {
      "id": 488635,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick strips. Add to the bowl along with oil, salt, and pepper, then stir to combine. ",
      "secondary_message": "1 ½ medium yellow onions\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 488636,
      "primary_message": "Transfer fruit and onions to another large baking sheet, then spread out in an even layer. Set aside. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 488637,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Divide between the reserved large bowl and a small bowl. (Set small bowl aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 488638,
      "primary_message": "Add veggie ground, bread crumbs, and spices to the large bowl with the basil. Using your hands, mix well to combine.",
      "secondary_message": "680 g veggie ground, plant based\n1 cup panko bread crumbs\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 488639,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded meatballs. Arrange on the oiled baking sheet.",
      "secondary_message": null
    },
    {
      "id": 488640,
      "primary_message": "Place both baking sheets in the oven and bake, tossing fruit and turning meatballs halfway, until meatballs are cooked through and fruit is fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 488641,
      "primary_message": "Meanwhile, add yogurt, mayo, water, and spices to the small bowl with the basil. Stir to combine.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n⅓ cup mayonnaise\n3 tbsp water\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 488642,
      "primary_message": "To serve, divide yogurt and roasted fruit between plates; top yogurt with meatballs. Enjoy!",
      "secondary_message": null
    }
  ],
