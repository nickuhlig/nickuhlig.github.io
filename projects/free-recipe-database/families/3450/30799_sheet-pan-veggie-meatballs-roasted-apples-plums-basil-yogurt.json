  "instructions": [
    {
      "id": 488607,
      "primary_message": "Preheat oven to 220°C (425°F). Coat one half of a baking sheet pan with a thin layer of oil.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 488608,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 plums\n2 Gala apples\n½ small pkg fresh basil"
    },
    {
      "id": 488609,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ½-inch thick slices. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 488610,
      "primary_message": "Quarter, core, and slice apples into ¼-inch thick wedges. Add to the bowl with the plums.",
      "secondary_message": null
    },
    {
      "id": 488611,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick strips. Add to the bowl along with oil, salt, and pepper, then stir to combine. ",
      "secondary_message": "½ medium yellow onion\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 488612,
      "primary_message": "Transfer fruit and onions to the unoiled half of the baking sheet and spread out in an even layer. Set aside. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 488613,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Divide between the reserved medium bowl and a small bowl. (Set small bowl aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 488614,
      "primary_message": "Add veggie ground, bread crumbs, and spices to the medium bowl with the basil. Using your hands, mix well to combine.",
      "secondary_message": "227 g veggie ground, plant based\n⅓ cup panko bread crumbs\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 488615,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs.\" Arrange on the oiled half of the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 488616,
      "primary_message": "Place baking sheet in the oven and bake, tossing fruit and turning meatballs halfway, until meatballs are cooked through and fruit is fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 488617,
      "primary_message": "Meanwhile, add yogurt, mayo, water, and spices to the small bowl with the basil. Stir to combine.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 tbsp water\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 488618,
      "primary_message": "To serve, divide yogurt and roasted fruit between plates; top yogurt with meatballs. Enjoy!",
      "secondary_message": null
    }
  ],
