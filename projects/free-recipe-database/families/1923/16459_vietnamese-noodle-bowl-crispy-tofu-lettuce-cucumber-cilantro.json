  "instructions": [
    {
      "id": 321338,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 321339,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 limes\n1 ½ jalapeño peppers\n1 small bunch green onions (scallions)\n1 ½ heads butter (Boston) lettuce\n1 ½ English cucumbers\n3 medium carrots\n1 small bunch cilantro"
    },
    {
      "id": 321340,
      "primary_message": "Juice limes into a medium bowl. Add water, soy sauce, sugar, and chili-garlic sauce; whisk the dressing until sugar is dissolved.",
      "secondary_message": "1 ½ cup water\n½ cup soy sauce\n⅓ cup brown sugar\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 321341,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 321342,
      "primary_message": "Peel and mince garlic; add to the bowl. Whisk to combine and set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 321343,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Once boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 321344,
      "primary_message": "Large dice tofu and place in a large bowl. Sprinkle with cornstarch and gently toss to coat.",
      "secondary_message": "⅓ cup cornstarch"
    },
    {
      "id": 321345,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321346,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, turning every few minutes, until golden brown and crispy, about 10 minutes. Remove from heat.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 321347,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into ¼-inch pieces; transfer to a platter.",
      "secondary_message": null
    },
    {
      "id": 321348,
      "primary_message": "Halve each head of lettuce lengthwise, then chop crosswise into thin (shred-like) strips. Add to the platter with the green onion.",
      "secondary_message": null
    },
    {
      "id": 321349,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into ¼-inch thick pieces; add to the platter.",
      "secondary_message": null
    },
    {
      "id": 321350,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the platter.",
      "secondary_message": null
    },
    {
      "id": 321351,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 321352,
      "primary_message": "To serve, divide noodles, veggies, and tofu between bowls. Pour dressing over top and sprinkle with cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
