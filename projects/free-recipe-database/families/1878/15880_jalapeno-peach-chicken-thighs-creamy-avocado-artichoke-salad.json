  "instructions": [
    {
      "id": 261169,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 261170,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 261171,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 261172,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add chicken and pan-fry, without turning, until golden underneath, 5-6 minutes. When the chicken is golden, transfer to a large baking dish, cooked-side facing up. (The chicken will not be cooked all the way through.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 261173,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 peaches\n3 jalapeño peppers\n1 ½ lemons\n1 ½ avocados\n1 ½ heads romaine lettuce"
    },
    {
      "id": 261174,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Cut each quarter into wedges and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 261175,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the peaches. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 261176,
      "primary_message": "When the chicken is done, zest and juice lemons into the baking dish; top chicken with peaches and jalapeño, then drizzle with honey (reserve bowl for the next step). Place baking dish in the oven and bake until the chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": "2 tbsp honey"
    },
    {
      "id": 261177,
      "primary_message": "While the chicken is cooking, peel and mince garlic; transfer to the reserved bowl. Add mayo, vinegar, honey, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp mayonnaise\n2 tbsp white wine vinegar\n1 tbsp honey\n1 tbsp Dijon mustard\n1 ½ tsp basil, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 261178,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 261179,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 261181,
      "primary_message": "Chop or tear romaine into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 261183,
      "primary_message": "To serve, divide salad, chicken, and peaches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
