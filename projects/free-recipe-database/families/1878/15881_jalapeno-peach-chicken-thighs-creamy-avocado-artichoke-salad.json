  "instructions": [
    {
      "id": 261191,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 261192,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 261193,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 261194,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry, without turning, until golden underneath, 5-6 minutes. When the chicken is golden, flip, and remove skillet from the heat (the chicken will not be cooked all the way through).",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 261195,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 peaches\n1 jalapeño pepper\n½ lemon\n½ avocado\n½ head romaine lettuce"
    },
    {
      "id": 261196,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Cut each quarter into wedges and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 261197,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the peaches. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 261198,
      "primary_message": "When the chicken has been removed from the heat, zest and juice lemon into the skillet; top chicken with peaches and jalapeño, then drizzle with honey (reserve bowl for the next step). Place skillet in the oven and bake until the chicken is cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": "2 tsp honey"
    },
    {
      "id": 261199,
      "primary_message": "While the chicken is cooking, peel and mince garlic; transfer to the reserved bowl. Add mayo, vinegar, honey, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 tbsp mayonnaise\n2 tsp white wine vinegar\n1 tsp honey\n1 tsp Dijon mustard\n½ tsp basil, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 261200,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 261201,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 261202,
      "primary_message": "Chop or tear romaine into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 261203,
      "primary_message": "To serve, divide salad, chicken, and peaches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
