  "instructions": [
    {
      "id": 1,
      "primary_message": "Make a balsamic syrup by pouring the vinegar and honey into a small saucepan and simmering over medium heat just long enough for it to reduce and have a thick, running consistency—about 5 minutes. Set aside, as it will thicken further as it cools.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Assemble each salad on its plate. First some arugula, then a slice of watermelon, then some arugula, another slice of watermelon, argula, then watermelon again. Crumble the chèvre over the watermelon, and season with cracked black pepper and fleur de sel. Drizzle with olive oil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a crème brulée torch, melt and brown the chèvre quickly over the watermelon. Drizzle with balsamic syrup, and serve.",
      "secondary_message": null
    }
  ],
