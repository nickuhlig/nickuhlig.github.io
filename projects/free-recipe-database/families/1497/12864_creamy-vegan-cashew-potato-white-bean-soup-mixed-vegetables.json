  "instructions": [
    {
      "id": 216786,
      "primary_message": "Place a large pot over high heat. Add broth, cover, and bring to a boil.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 216787,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n6 medium red potatoes\n1 small pkg fresh thyme"
    },
    {
      "id": 216788,
      "primary_message": "Place cashews in a medium bowl. Carefully pour boiling broth over the cashews and set aside to soak for 15 minutes. Reserve pot for later use.",
      "secondary_message": "1 ½ cups cashews, roasted unsalted"
    },
    {
      "id": 216789,
      "primary_message": "Peel and mince garlic. Peel and small dice onions. Transfer both to a large bowl.",
      "secondary_message": "6 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 216790,
      "primary_message": "Peel and small dice carrots. Trim and small dice celery. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 216791,
      "primary_message": "Medium dice potatoes. Add to the bowl along with corn and peas.",
      "secondary_message": "1 ½ cups frozen corn\n1 ½ cups frozen peas"
    },
    {
      "id": 216792,
      "primary_message": "Return pot to medium heat.",
      "secondary_message": null
    },
    {
      "id": 216793,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 216794,
      "primary_message": "Add veggies to the pot and cook, stirring occasionally, until starting to soften, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 216795,
      "primary_message": "Meanwhile, slide thyme leaves off the stems; discard stems.",
      "secondary_message": null
    },
    {
      "id": 216796,
      "primary_message": "Add broth, half the thyme (reserving the rest for garnish), and spices to the pot.",
      "secondary_message": "2129 ml chicken or vegetable broth\n1 tbsp Italian seasoning\n1 tbsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 216797,
      "primary_message": "Drain and rinse beans; add to the pot.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 216798,
      "primary_message": "Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, until potatoes are fork-tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 216799,
      "primary_message": "Meanwhile, working in batches if necessary, transfer the cashew-broth mixture to a blender and purée until smooth.",
      "secondary_message": null
    },
    {
      "id": 216800,
      "primary_message": "Add cashew cream to the pot and stir to combine. Cook, stirring occasionally, until soup begins to thicken, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 216801,
      "primary_message": "To serve, divide soup between bowls. Top with reserved thyme and enjoy!",
      "secondary_message": null
    }
  ],
