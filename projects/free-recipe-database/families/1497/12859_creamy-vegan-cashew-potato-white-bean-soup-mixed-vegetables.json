  "instructions": [
    {
      "id": 216706,
      "primary_message": "Place a medium saucepan over high heat. Add broth, cover, and bring to a boil.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 216707,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n2 medium red potatoes\n½ small pkg fresh thyme"
    },
    {
      "id": 216708,
      "primary_message": "Place cashews in a small bowl. Carefully pour boiling broth over the cashews and set aside to soak for 15 minutes. Reserve saucepan for later use.",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 216709,
      "primary_message": "Meanwhile, peel and mince garlic. Peel and small dice onion. Transfer both to a medium bowl.",
      "secondary_message": "2 cloves garlic\n½ medium yellow onion"
    },
    {
      "id": 216710,
      "primary_message": "Peel and small dice carrot. Trim and small dice celery. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 216711,
      "primary_message": "Medium dice potatoes. Add to the bowl along with corn and peas.",
      "secondary_message": "½ cup frozen corn\n½ cup frozen peas"
    },
    {
      "id": 216712,
      "primary_message": "Return saucepan to medium heat.",
      "secondary_message": null
    },
    {
      "id": 216713,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 216714,
      "primary_message": "Add veggies to the pan and cook, stirring occasionally, until starting to soften, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 216715,
      "primary_message": "Meanwhile, slide thyme leaves off the stems; discard stems.",
      "secondary_message": null
    },
    {
      "id": 216716,
      "primary_message": "Add broth, half the thyme (reserving the rest for garnish), and spices to the pan.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 216717,
      "primary_message": "Drain and rinse beans; add to the pan.",
      "secondary_message": "½ (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 216718,
      "primary_message": "Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, until potatoes are fork-tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 216719,
      "primary_message": "Meanwhile, transfer the cashew-broth mixture to a blender and purée until smooth.",
      "secondary_message": null
    },
    {
      "id": 216720,
      "primary_message": "Add cashew cream to the pan and stir to combine. Cook, stirring occasionally, until soup begins to thicken, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 216721,
      "primary_message": "To serve, divide soup between bowls. Top with reserved thyme and enjoy!",
      "secondary_message": null
    }
  ],
