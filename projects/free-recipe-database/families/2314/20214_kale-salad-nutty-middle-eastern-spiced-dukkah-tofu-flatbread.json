  "instructions": [
    {
      "id": 337384,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 337385,
      "primary_message": "Peel and mince walnuts and garlic.",
      "secondary_message": "½ cup walnuts\n2 cloves garlic"
    },
    {
      "id": 337386,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 337387,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add walnuts, garlic, sesame seeds, and spices; cook, stirring constantly, until fragrant and toasted, 1-2 minutes. Transfer the \"dukkah\" spice mix to a small bowl to keep the garlic from overcooking. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tbsp sesame seeds\n2 tsp coriander, ground\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 337388,
      "primary_message": "Medium dice tofu and place in a medium bowl; sprinkle with cornstarch, salt, and pepper. Toss to coat.",
      "secondary_message": "2 tsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 337389,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add the tofu and cook, turning occasionally, until golden on all sides and warmed through, about 10 minutes. (Wipe the bowl clean with paper towels and reserve for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 337390,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 bunch kale\n1 English cucumber\n1 small pkg grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 337391,
      "primary_message": "Peel and mince additional garlic; place in the reserved bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 337392,
      "primary_message": "Zest and juice lemon into the bowl with the garlic, then add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 337393,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 337394,
      "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons; halve tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 337395,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 337396,
      "primary_message": "When the tofu is done, sprinkle with half of the dukkah, toss to coat, and remove from heat. (Reserve remaining dukkah for the flatbread.)",
      "secondary_message": null
    },
    {
      "id": 337397,
      "primary_message": "Toast flatbread if desired; drizzle with oil, sprinkle with remaining dukkah, and cut into wedges.",
      "secondary_message": "2 flatbreads or naan\n2 tsp extra virgin olive oil"
    },
    {
      "id": 337398,
      "primary_message": "To serve, divide salad, tofu, and flatbread between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
