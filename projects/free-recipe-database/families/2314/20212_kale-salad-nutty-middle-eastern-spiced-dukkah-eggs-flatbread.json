  "instructions": [
    {
      "id": 337355,
      "primary_message": "Mince walnuts.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 337356,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 337357,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 337358,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add walnuts, garlic, sesame seeds, and spices to the pot. Cook, stirring constantly, until fragrant and toasted, 1-2 minutes. Transfer the \"dukkah\" spice mix to a small bowl to keep the garlic from overcooking. (Reserve pot for next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp sesame seeds\n1 tbsp coriander, ground\n1 ½ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 337359,
      "primary_message": "Wipe the pot clean with paper towels. Place eggs in the pot, cover with water (from the tap), and bring to a boil; reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 337360,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ bunches kale\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 337361,
      "primary_message": "Peel and mince additional garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 337362,
      "primary_message": "Zest and juice lemons into the bowl with the garlic, then add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 337363,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 337364,
      "primary_message": "Trim and halve cucumbers lengthwise, then slice crosswise into thin half-moons; halve tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 337365,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 337366,
      "primary_message": "Peel eggs, roll in the dukkah to coat, and halve lengthwise. (Reserve remaining dukkah for the flatbread.)",
      "secondary_message": null
    },
    {
      "id": 337367,
      "primary_message": "Toast flatbread if desired; drizzle with oil, sprinkle with remaining dukkah, and cut into wedges.",
      "secondary_message": "3 flatbreads or naan\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 337368,
      "primary_message": "To serve, divide salad, eggs, and flatbread between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
