  "instructions": [
    {
      "id": 1,
      "primary_message": "Divide beef into four even five ounce portions, gently pressing each into a patty about 11 cm wide. Cover with plastic and refrigerate until needed. Meanwhile, combine mayonnaise, ketchup, vinegar, sugar, and relish in small bowl. Stir with spoon until smooth. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place as much pastrami as can fit in one layer in a 30-cm non-stick or cast iron skillet or griddle and place over medium high heat. Cook until pastrami is well-browned and crisp on first side, about 3 minutes. Flip and cook until browned on second side, about 45 seconds longer. Transfer to paper towel-lined plate. Repeat with remaining pastrami, placing directly on hot skillet, using as many batches as necessary (you'll probably need about three batches). Set pastrami aside until needed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Return empty skillet to heat (leave the pastrami fat) and add two buns, cut-side down. Toast until golden brown, about 1 minute. Repeat with remaining buns. Set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Return pan to heat. Season burger patties generously with salt and pepper and add to pan. Cook until well browned on both sides and center of burger reads 54°C on an instant-read thermometer for medium rare, about 5 minutes total, flipping and adding cheese halfway through cooking. While burgers are cooking, divide mayonnaise mixture and coleslaw evenly between bottom buns. Top with cooked burgers, crispy pastrami, and bun tops. Serve immediately.",
      "secondary_message": null
    }
  ],
