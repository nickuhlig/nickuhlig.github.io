  "instructions": [
    {
      "primary_message": "Wash, dry, trim, and halve Brussels sprouts. Place in a medium bowl and set aside. ",
      "secondary_message": "907 g Brussels sprouts"
    },
    {
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, large dice bacon. ",
      "secondary_message": "9 slice bacon"
    },
    {
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until the fat has rendered and bacon is crispy, about 8 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for the next step.) ",
      "secondary_message": null
    },
    {
      "primary_message": "Return the skillet (with drippings) to medium heat. Add Brussels sprouts and stir to coat. Add a ½ cup water, cover, and cook, removing the lid and stirring occasionally, until sprouts are fork-tender, about 6 minutes. (Add additional water, a few tablespoons at a time, if needed, to keep the sprouts from sticking to the skillet.) ",
      "secondary_message": null
    },
    {
      "primary_message": "When the sprouts are tender, remove the lid and season with salt and pepper. Increase heat to medium-high; continue to cook, uncovered, stirring occasionally, until the sprouts are golden, about 2 minutes. ",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Return bacon to the skillet with the sprouts, stir to combine, and remove from heat. ",
      "secondary_message": null
    }
  ],
