  "instructions": [
    {
      "id": 265019,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 265020,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 265021,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 red bell peppers\n6 caps portobello mushrooms\n3 (1 inch) pieces ginger root\n2 small pkgs fresh basil"
    },
    {
      "id": 265022,
      "primary_message": "Trim and quarter the eggplants lengthwise, then cut crosswise into ¼-inch thick pieces. ",
      "secondary_message": null
    },
    {
      "id": 265023,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 265024,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add eggplant and cook, stirring occasionally, until golden brown, 10-12 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 265025,
      "primary_message": "Meanwhile, peel, halve, and medium dice onions; place in a large bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 265026,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips. Remove stems from mushrooms, halve, and cut crosswise into thin strips. Add both to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 265027,
      "primary_message": "When the eggplant is done, remove to a large plate and set aside. Return pot to medium-high heat, add more oil, and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 265028,
      "primary_message": "Add onion, bell pepper, and mushrooms to the pot. Cook, stirring occasionally, until the veggies are almost fork-tender, 7-8 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 265029,
      "primary_message": "While the veggies are cooking, drain and rinse the chickpeas in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 265030,
      "primary_message": "Peel and mince ginger and garlic; place in the reserved bowl along with soy sauce, water, peanut butter, maple syrup, cornstarch, vinegar, oil, chili-garlic sauce, and pepper. Whisk to combine the sauce and set aside.",
      "secondary_message": "3 cloves garlic\n½ cup soy sauce\n⅓ cup water\n3 tbsp natural peanut butter\n2 tbsp pure maple syrup\n1 ½ tbsp cornstarch\n1 tbsp rice vinegar\n1 tbsp toasted sesame oil\n1 ½ tsp chili-garlic sauce\n¾ tsp black pepper"
    },
    {
      "id": 265031,
      "primary_message": "Add chickpeas to the pot and continue to cook, stirring occasionally, until the veggies are tender and chickpeas are warmed through, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 265032,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 265033,
      "primary_message": "Add sauce, half of the basil (reserving the rest for garnish), and the cooked eggplant to the pot. Continue to cook, stirring frequently, until the sauce is thickened and veggies are coated, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 265034,
      "primary_message": "To serve, divide rice and stir-fry between plates; sprinkle with sesame seeds and reserved basil. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
