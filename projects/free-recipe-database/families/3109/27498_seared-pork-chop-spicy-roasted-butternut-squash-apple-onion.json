  "instructions": [
    {
      "id": 442091,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 442092,
      "primary_message": "Wash, dry, trim, and peel each squash; quarter lengthwise, scrape out the seeds, and cut crosswise into thin slices. Place in a large bowl.",
      "secondary_message": "1 ½ small butternut squash"
    },
    {
      "id": 442093,
      "primary_message": "Wash, dry, quarter, core, and thinly slice apples. Add to the bowl with the butternut squash.",
      "secondary_message": "3 Gala apples"
    },
    {
      "id": 442094,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 442095,
      "primary_message": "Add oil, sugar, and spices to the bowl, then toss to combine. Divide squash, apple, and onion between two large baking sheet pans, then spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp brown sugar\n¾ tsp cayenne pepper\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 442096,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until squash and apples are tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 442097,
      "primary_message": "When the squash and apples have about 15 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 442098,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides. ",
      "secondary_message": "6 pork chops, bone-in\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 442099,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 442100,
      "primary_message": "To serve, divide chops and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
