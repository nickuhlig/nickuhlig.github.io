  "instructions": [
    {
      "id": 442051,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 442052,
      "primary_message": "Wash, dry, trim, and peel squash; quarter lengthwise, scrape out the seeds, and cut crosswise into thin slices. Place in a large bowl.",
      "secondary_message": "1 small butternut squash"
    },
    {
      "id": 442053,
      "primary_message": "Wash, dry, quarter, core, and thinly slice apples. Add to the bowl with the butternut squash.",
      "secondary_message": "2 Gala apples"
    },
    {
      "id": 442054,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 442055,
      "primary_message": "Add oil, sugar, and spices to the bowl, then toss to combine. Transfer squash, apple, and onion to a large baking sheet pan, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp brown sugar\n½ tsp cayenne pepper\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 442056,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until squash and apples are tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 442057,
      "primary_message": "When the squash and apples have about 10 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 442058,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides. ",
      "secondary_message": "4 pork chops, bone-in\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 442059,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 442060,
      "primary_message": "To serve, divide chops and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
