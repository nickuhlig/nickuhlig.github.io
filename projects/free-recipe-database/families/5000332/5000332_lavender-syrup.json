  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small saucepan, combine sugar and water. Add lavender, using 1/2 teaspoon for a more mild lavender flavor or 1 teaspoon for a stronger one. Bring to a boil over medium-high heat, then reduce heat as needed to a simmer and cook for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain lavender syrup through a fine-mesh strainer set over a small heatproof bowl or container; discard lavender flowers. Let cool, then use as desired.",
      "secondary_message": null
    }
