  "instructions": [
    {
      "id": 476987,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 476988,
      "primary_message": "Meanwhile, small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 476989,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 476990,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 476991,
      "primary_message": "While the bacon is cooking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 ½ bunches kale\n0.68 kg Brussels sprouts\n1 ½ avocados"
    },
    {
      "id": 476992,
      "primary_message": "Return skillet (with drippings) to medium-high heat. Add tomatoes and salt; cook, stirring occasionally, until starting to brown and burst, 5-7 minutes. Remove from heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 476993,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallots. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n¼ cup extra virgin olive oil\n1 ½ tbsp red wine vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 476994,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 476995,
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476996,
      "primary_message": "Using your hands, massage the greens with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 476997,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and large dice. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 476998,
      "primary_message": "Peel and quarter eggs, then season with salt and pepper. ",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 476999,
      "primary_message": "To serve, divide greens between plates or bowls. Top with bacon, eggs, tomatoes, avocado, and blue cheese. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled blue cheese"
    }
  ],
