  "instructions": [
    {
      "id": 476889,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 476890,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 476891,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 476892,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 3-4 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 476893,
      "primary_message": "While the bacon is cooking, wash and dry the fresh produce.",
      "secondary_message": "½ pint grape tomatoes\n½ bunch kale\n½ lb Brussels sprouts\n½ avocado"
    },
    {
      "id": 476894,
      "primary_message": "Return skillet (with drippings) to medium-high heat. Add tomatoes and salt; cook, stirring occasionally, until starting to brown and burst, 4-6 minutes. Remove from heat.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 476895,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in a medium bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 ½ tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n1 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 476896,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 476897,
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476898,
      "primary_message": "Using your hands, massage the greens with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 476899,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and large dice.",
      "secondary_message": null
    },
    {
      "id": 476900,
      "primary_message": "Peel and quarter eggs, then season with salt and pepper. ",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 476901,
      "primary_message": "To serve, divide greens between plates or bowls. Top with bacon, eggs, tomatoes, avocado, and blue cheese. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled blue cheese"
    }
  ],
