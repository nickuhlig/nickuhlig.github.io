  "instructions": [
    {
      "id": 477022,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 477023,
      "primary_message": "While the eggs are cooking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 ½ bunches kale\n0.68 kg Brussels sprouts\n3 avocados"
    },
    {
      "id": 477024,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477025,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tomatoes and salt; cook, stirring occasionally, until starting to brown and burst, 5-7 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 477026,
      "primary_message": "Meanwhile, peel and mince shallots. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n¼ cup extra virgin olive oil\n1 ½ tbsp red wine vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 477027,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 477028,
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477029,
      "primary_message": "Using your hands, massage the greens with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 477030,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and large dice. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 477031,
      "primary_message": "Peel and quarter eggs, then season with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 477032,
      "primary_message": "To serve, divide greens between plates or bowls. Top with eggs, tomatoes, avocado, and blue cheese. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled blue cheese"
    }
  ],
