  "instructions": [
    {
      "id": 240927,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 240928,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 jalapeño peppers\n1 small bunch cilantro\n1 ½ pints grape tomatoes"
    },
    {
      "id": 240929,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 240930,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic; place in a small bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 240931,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the ginger and garlic. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 240932,
      "primary_message": "Peel and small dice onions.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 240933,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 240934,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, jalapeño, onion, and spices to the pot. Cook, stirring occasionally, until onion is soft, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp curry powder\n¾ tsp salt\n¾ tsp turmeric, ground\n3 pinch cinnamon, ground\n3 pinch cumin, ground"
    },
    {
      "id": 240935,
      "primary_message": "Meanwhile, rinse the lentils in a colander or strainer.",
      "secondary_message": "1 ½ cup red lentils, dried"
    },
    {
      "id": 240936,
      "primary_message": "Add lentils, broth, and coconut milk to the pot. Bring the mixture to a boil over high heat; once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, 20-25 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ (13.5 fl oz) cans coconut milk"
    },
    {
      "id": 240937,
      "primary_message": "While the lentils are cooking, quarter tomatoes.",
      "secondary_message": null
    },
    {
      "id": 240938,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 240939,
      "primary_message": "When the lentils are done, add tomatoes and half the cilantro (reserving the rest for garnish) to the pot; stir to combine and continue to cook until heated through, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 240940,
      "primary_message": "To serve, divide lentils and rice between bowls; top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
