  "instructions": [
    {
      "id": 240899,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 240900,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 jalapeño pepper\n½ small bunch cilantro\n½ pint grape tomatoes"
    },
    {
      "id": 240901,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 240902,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic; place in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 240903,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the ginger and garlic. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 240904,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 240905,
      "primary_message": "While the pan heats up, peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 240906,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add ginger, garlic, jalapeño, onion, and spices to the pan. Cook, stirring occasionally, until onion is soft, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp curry powder\n¼ tsp salt\n¼ tsp turmeric, ground\n1 pinch cinnamon, ground\n1 pinch cumin, ground"
    },
    {
      "id": 240907,
      "primary_message": "Meanwhile, rinse the lentils in a colander or strainer.",
      "secondary_message": "½ cup red lentils, dried"
    },
    {
      "id": 240908,
      "primary_message": "Add lentils, broth, and coconut milk to the pan. Bring the mixture to a boil over high heat; once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, 15-20 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ (13.5 fl oz) can coconut milk"
    },
    {
      "id": 240909,
      "primary_message": "While the lentils are cooking, quarter tomatoes.",
      "secondary_message": null
    },
    {
      "id": 240910,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 240911,
      "primary_message": "When the lentils are done, add tomatoes and half the cilantro (reserving the rest for garnish) to the pan; stir to combine and continue to cook until heated through, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 240912,
      "primary_message": "To serve, divide lentils and rice between bowls; top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
