  "instructions": [
    {
      "id": 240955,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 240956,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 jalapeño peppers\n1 small bunch cilantro\n1 small pkg grape tomatoes"
    },
    {
      "id": 240957,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 240958,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic; place in a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 240959,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the ginger and garlic. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 240960,
      "primary_message": "Peel and small dice onions.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 240961,
      "primary_message": "Preheat another medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 240962,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add ginger, garlic, jalapeño, onion, and spices to the pan. Cook, stirring occasionally, until onion is soft, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp curry powder\n½ tsp salt\n½ tsp turmeric, ground\n⅛ tsp cinnamon, ground\n⅛ tsp cumin, ground"
    },
    {
      "id": 240963,
      "primary_message": "Meanwhile, rinse the lentils in a colander or strainer.",
      "secondary_message": "1 cup red lentils, dried"
    },
    {
      "id": 240964,
      "primary_message": "Add lentils, broth, and coconut milk to the pan. Bring the mixture to a boil over high heat; once boiling, reduce to a simmer, cover, and cook until the lentils are just tender, about 20 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 (398 ml) can coconut milk"
    },
    {
      "id": 240965,
      "primary_message": "While the lentils are cooking, quarter tomatoes.",
      "secondary_message": null
    },
    {
      "id": 240966,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 240967,
      "primary_message": "When the lentils are done, add tomatoes and half the cilantro (reserving the rest for garnish) to the pan; stir to combine and continue to cook until heated through, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 240968,
      "primary_message": "To serve, divide lentils and rice between bowls; top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
