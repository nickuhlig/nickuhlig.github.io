  "instructions": [
    {
      "id": 47060,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 bunch kale\n2 grapefruits\n1 avocado"
    },
    {
      "id": 47061,
      "primary_message": "Cut out and discard the kale stems; cut the leaves into 2 ½-cm pieces. Transfer to a large salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 47062,
      "primary_message": "Drizzle the kale with olive oil and season with salt and pepper. Massage the kale with your hands until the leaves are evenly coated with the oil and begin to become more tender, 1 to 2 minutes. Set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 47063,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 47064,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 47065,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 47066,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 47067,
      "primary_message": "Halve the avocado lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and large dice the avocado flesh into 2-cm cubes. Add to the salad bowl with the kale.",
      "secondary_message": ""
    },
    {
      "id": 47068,
      "primary_message": "Slice off a piece from both grapefruit ends, then place it flat on one of the ends and slice off the peel (from top to bottom), exposing the flesh; cut out the segments of flesh from between the membranes, then cut them into 2-cm pieces. Add the pieces (and any leftover juice) to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47069,
      "primary_message": "Toss the salad until well combined.",
      "secondary_message": null
    },
    {
      "id": 47070,
      "primary_message": "Slice the steak against the grain into strips.",
      "secondary_message": null
    },
    {
      "id": 47071,
      "primary_message": "To serve, divide the salad and steak between plates. Enjoy!",
      "secondary_message": null
    }
  ],
