  "instructions": [
    {
      "id": 219941,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 219942,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 219943,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219944,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 219945,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and sear until golden brown, 2-3 minutes per side. Transfer to a clean plate and set aside (the chicken will not be cooked all the way through). ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 219946,
      "primary_message": "Meanwhile, wash, dry, and trim green beans. Transfer to a medium bowl and set aside.",
      "secondary_message": "⅓ kg green beans"
    },
    {
      "id": 219947,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 219948,
      "primary_message": "Return the skillet to medium-high heat. Place garlic, broth, soy sauce, vinegar, sugar, and pepper in the skillet; stir to combine, scraping up any browned bits from the bottom of the skillet.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n3 tbsp soy sauce\n2 tbsp rice vinegar\n1 tsp brown sugar\n⅛ tsp black pepper"
    },
    {
      "id": 219949,
      "primary_message": "Return chicken to the skillet and and turn to coat in the sauce. Add green beans, cover, and simmer until chicken is cooked through and green beans are tender-crisp, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 219950,
      "primary_message": "To serve, divide rice, chicken, green beans, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
