  "instructions": [
    {
      "id": 219993,
      "primary_message": "Wash, dry, and cut cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a medium bowl. Set aside.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 219994,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 219995,
      "primary_message": "While the pot heats up, pat the chicken thighs dry with paper towels and place on a large plate; season with salt and pepper on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 219996,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and sear until golden brown, 2-3 minutes per side. Transfer to a clean plate and set aside (the chicken will not be cooked all the way through). ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 219997,
      "primary_message": "Meanwhile, wash, dry, and trim green beans. Transfer to another medium bowl and set aside.",
      "secondary_message": "1.36 kg green beans"
    },
    {
      "id": 219998,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 219999,
      "primary_message": "Return the pot to medium-high heat. Place garlic, broth, coconut aminos, vinegar, honey, and pepper in the pot; stir to combine, scraping up any browned bits from the bottom of the pot. ",
      "secondary_message": "355 ml chicken or vegetable broth\n⅓ cup coconut aminos\n⅓ cup rice vinegar\n2 tbsp honey\n½ tsp black pepper"
    },
    {
      "id": 220000,
      "primary_message": "Return chicken to the pot and turn to coat in the sauce. Add green beans, cover, and simmer until chicken is cooked through and green beans are tender-crisp, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 220001,
      "primary_message": "Meanwhile, heat another large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 220002,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add cauliflower and season with salt; cook, stirring occasionally, until tender, 8-10 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 220003,
      "primary_message": "To serve, divide cauliflower rice, chicken, green beans, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
