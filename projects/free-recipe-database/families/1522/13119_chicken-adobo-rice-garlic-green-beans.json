  "instructions": [
    {
      "id": 219868,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 219869,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 219870,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219871,
      "primary_message": "While the pot heats up, pat the chicken thighs dry with paper towels and place on a large plate; season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 219872,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and sear until golden brown, 2-3 minutes per side. Transfer to a clean plate and set aside (the chicken will not be cooked all the way through). ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 219873,
      "primary_message": "Meanwhile, wash, dry, and trim green beans. Transfer to a medium bowl and set aside.",
      "secondary_message": "2 ¼ lb green beans"
    },
    {
      "id": 219874,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 219875,
      "primary_message": "Return the pot to medium-high heat. Place garlic, broth, soy sauce, vinegar, sugar, and pepper in the pot; stir to combine, scraping up any browned bits from the bottom of the pot.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n½ cup soy sauce\n⅓ cup rice vinegar\n1 tbsp brown sugar\n½ tsp black pepper"
    },
    {
      "id": 219876,
      "primary_message": "Return chicken to the pot and and turn to coat in the sauce. Add green beans, cover, and simmer until chicken is cooked through and green beans are tender-crisp, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 219877,
      "primary_message": "To serve, divide rice, chicken, green beans, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
