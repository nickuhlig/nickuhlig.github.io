  "instructions": [
    {
      "id": 219878,
      "primary_message": "Wash, dry, and cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a medium bowl. Set aside.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 219879,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 219880,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 219881,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and sear until golden brown, 2-3 minutes per side. Transfer to a clean plate and set aside (the chicken will not be cooked all the way through). ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 219882,
      "primary_message": "Meanwhile, wash, dry, and trim green beans. Transfer to another medium bowl and set aside.",
      "secondary_message": "1 lb green beans"
    },
    {
      "id": 219883,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 219884,
      "primary_message": "Return the skillet to medium-high heat. Place garlic, broth, coconut aminos, vinegar, honey, and pepper in the skillet; stir to combine, scraping up any browned bits from the bottom of the skillet. ",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n2 tbsp coconut aminos\n2 tbsp rice vinegar\n2 tsp honey\n⅛ tsp black pepper"
    },
    {
      "id": 219885,
      "primary_message": "Return chicken to the skillet and turn to coat in the sauce. Add green beans, cover, and simmer until chicken is cooked through and green beans are tender-crisp, 8-10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 219886,
      "primary_message": "Meanwhile, heat a medium saucepan over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 219887,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add cauliflower and season with salt; cook, stirring occasionally, until tender, 6-8 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 219888,
      "primary_message": "To serve, divide cauliflower rice, chicken, green beans, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
