  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Soften the unsalted butter. Mince the 1 of the garlic. Grate the ginger. Quarter the onion. Seed and thinly slice the serrano chiles. Quarter the lime.",
      "secondary_message": "2 tbsp unsalted butter\n5 cloves garlic\n1 tbsp ginger root, plus 12 slices ginger\n1 onion\n2 serrano chiles\n1 lime"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 220°C (425°F). Set rack in the lower third of the oven. In a small bowl, mix together the butter, minced garlic, and grated ginger.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pat the chicken dry. Rub half of the butter under the skin and half over it. Season the bird liberally with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place the chicken breast-side-up on a rack in a roasting pan. Scatter the onion, garlic cloves, ginger slices, chiles, and lime around the bird and add 1/2 cup of water to the pan. Roast for 30 minutes, until the breast is beginning to brown in spots. Turn the chicken over and roast for 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Turn the chicken breast-side-up again, and add another 1/2 cup of water to the pan. Return to the oven for another 20 minutes, or until done.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Tilt the chicken and drain the juices into the pan. Remove the bird to a serving platter. Remove the rack from the pan and spoon off as much of the fat as possible. Place the pan on the stovetop over high heat. Add the chicken stock and cook, scraping up the browned bits. Stir in the Asian fish sauce.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Serve the chicken, passing the sauce on the side.",
      "secondary_message": null
    }
  ],
