  "instructions": [
    {
      "id": 421564,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 421565,
      "primary_message": "Drain and roughly chop roasted peppers. Place in a large pot along with gnocchi, marinara sauce, and spices; stir to combine.",
      "secondary_message": "1 ½ (12 oz) jars roasted red bell peppers\n3 (16 oz) pkgs potato gnocchi\n1 ½ (24 oz) jars marinara sauce\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 421566,
      "primary_message": "Bring gnocchi and sauce to a simmer over medium-high heat, stirring occasionally. Once simmering, reduce heat to medium and cook until gnocchi soften, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 421567,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice cucumbers. Place in a large bowl.",
      "secondary_message": "1 ½ English cucumbers"
    },
    {
      "id": 421568,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the cucumber and set aside.",
      "secondary_message": "1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 421569,
      "primary_message": "When the gnocchi have softened, transfer to a large baking dish, top with cheese, and place in the oven. Bake until cheese is melted and golden, 5-6 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 421570,
      "primary_message": "Meanwhile, add pumpkin seeds and dressing to the bowl with the greens; toss to combine the salad.",
      "secondary_message": "¾ cup pumpkin seeds\n⅓ cup ranch dressing"
    },
    {
      "id": 421571,
      "primary_message": "To serve, divide gnocchi and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
