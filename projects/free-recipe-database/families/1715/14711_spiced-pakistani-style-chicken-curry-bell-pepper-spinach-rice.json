  "instructions": [
    {
      "id": 243399,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 243400,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 limes\n3 (1 inch) pieces ginger root\n3 red bell peppers\n1 small bunch cilantro\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 243401,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 243402,
      "primary_message": "While the rice cooks, juice the limes into a large bowl. Add spices and stir to combine the marinade.",
      "secondary_message": "1 tbsp paprika\n1 ½ tsp salt\n¾ tsp chili powder\n¾ tsp turmeric, ground\n¾ tsp coriander, ground\n¾ tsp cumin, ground\n½ tsp black pepper\n3 pinch cinnamon, ground"
    },
    {
      "id": 243403,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-size pieces. Add to the bowl with the marinade and stir to combine; set aside.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 243404,
      "primary_message": "Using a clean cutting board, peel and mince ginger and garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 243405,
      "primary_message": "Peel and small dice onions.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 243406,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 243407,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, and onion; cook, stirring often, until onion is soft, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 243408,
      "primary_message": "Add chicken to the pot and cook, stirring occasionally, until partially cooked through, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 243409,
      "primary_message": "Meanwhile, trim, seed, and medium dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 243410,
      "primary_message": "Add bell peppers, tomato sauce, and water to the pot. Stir to combine and bring to a boil over high. Once boiling, reduce heat to medium-low; simmer, stirring occasionally, until chicken is cooked through, about 20 minutes.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n¾ cup water"
    },
    {
      "id": 243411,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 243412,
      "primary_message": "When the chicken is done, remove from heat. Stir handfuls of spinach into the pot, waiting for the spinach to wilt slightly before adding the next handful. Add half the cilantro (reserving the rest for garnish) and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 243413,
      "primary_message": "To serve, divide rice and chicken curry between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
