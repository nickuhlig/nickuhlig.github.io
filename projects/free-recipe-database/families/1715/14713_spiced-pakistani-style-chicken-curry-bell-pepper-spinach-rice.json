  "instructions": [
    {
      "id": 243429,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 243430,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 limes\n2 (2 ½ cm) pieces ginger root\n2 red bell peppers\n1 small bunch cilantro\n2 (142 g) pkg baby spinach"
    },
    {
      "id": 243431,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 243432,
      "primary_message": "While the rice cooks, juice the limes into a large bowl. Add spices and stir to combine the marinade.",
      "secondary_message": "2 tsp paprika\n1 tsp salt\n½ tsp chili powder\n½ tsp turmeric, ground\n½ tsp coriander, ground\n½ tsp cumin, ground\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 243433,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-size pieces. Add to the bowl with the marinade and stir to combine; set aside.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 243434,
      "primary_message": "Using a clean cutting board, peel and mince ginger and garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 243435,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 243436,
      "primary_message": "While the skillet heats up, peel and small dice onions.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 243437,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, and onion; cook, stirring often, until onion is soft, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 243438,
      "primary_message": "Add chicken to the skillet and cook, stirring occasionally, until partially cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 243439,
      "primary_message": "Meanwhile, trim, seed, and medium dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 243440,
      "primary_message": "Add bell peppers, tomato sauce, and water to the skillet. Stir to combine and bring to a boil over high. Once boiling, reduce heat to medium-low; simmer, stirring occasionally, until chicken is cooked through, 15-18 minutes.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n½ cup water"
    },
    {
      "id": 243441,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 243442,
      "primary_message": "When the chicken is done, remove from heat. Stir handfuls of spinach into the skillet, waiting for the spinach to wilt slightly before adding the next handful. Add half the cilantro (reserving the rest for garnish) and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 243443,
      "primary_message": "To serve, divide rice and chicken curry between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
