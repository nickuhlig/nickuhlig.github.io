  "instructions": [
    {
      "id": 243414,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 243415,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lime\n1 (2 ½ cm) piece ginger root\n1 red bell pepper\n½ small bunch cilantro\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 243416,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 243417,
      "primary_message": "While the rice cooks, juice the lime into a medium bowl. Add spices and stir to combine the marinade.",
      "secondary_message": "1 tsp paprika\n½ tsp salt\n¼ tsp chili powder\n¼ tsp turmeric, ground\n¼ tsp coriander, ground\n¼ tsp cumin, ground\n⅛ tsp black pepper\n1 pinch cinnamon, ground"
    },
    {
      "id": 243418,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-size pieces. Add to the bowl with the marinade and stir to combine; set aside.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 243419,
      "primary_message": "Using a clean cutting board, peel and mince ginger and garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 243420,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 243421,
      "primary_message": "While the skillet heats up, peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 243422,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, and onion; cook, stirring often, until onion is soft, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 243423,
      "primary_message": "Add chicken to the skillet and cook, stirring occasionally, until partially cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 243424,
      "primary_message": "Meanwhile, trim, seed, and medium dice bell pepper.",
      "secondary_message": null
    },
    {
      "id": 243425,
      "primary_message": "Add bell pepper, tomato sauce, and water to the skillet. Stir to combine and bring to a boil over high. Once boiling, reduce heat to medium-low; simmer, stirring occasionally, until chicken is cooked through, 15-18 minutes.",
      "secondary_message": "1 (213 ml) can tomato sauce\n¼ cup water"
    },
    {
      "id": 243426,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 243427,
      "primary_message": "When the chicken is done, remove from heat. Stir handfuls of spinach into the skillet, waiting for the spinach to wilt slightly before adding the next handful. Add half the cilantro (reserving the rest for garnish) and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 243428,
      "primary_message": "To serve, divide rice and chicken curry between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
