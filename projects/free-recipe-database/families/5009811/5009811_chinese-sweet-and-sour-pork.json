  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Beat the egg. Chop the scallions into 1-inch segments. Thinly slice the ginger.",
      "secondary_message": "1 large egg\n3 scallions\n1 (1 inch) ginger root"
    },
    {
      "id": 1,
      "primary_message": "Cut the meat into slices 1-inch long and about 1/4 inch thick. Combine 1 teaspoon salt and rice wine in a medium bowl and stir to combine. Add the pork and transfer to refrigerate. Allow to marinate at least 30 minutes and up to overnight.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine 1/2 teaspoon salt, sugar, vinegar, soy sauce and 2 teaspoons cornstarch in a small bowl and mix to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil in a wok or Dutch oven to 350°F. Beat together egg and remaining 1/4 cup cornstarch to form a batter. Coat pork with batter, allow excess to drain, and carefully transfer to the hot oil, adding the pieces one at a time to prevent clumping. Cook until crisp and just barely cooked through, about 3 minutes. Remove the pork with a slotted spoon. and transfer to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour off all but 3 tablespoons of the oil in the wok and return to medium-high heat. Add the ginger and the scallions and stir-fry until fragrant, about 30 seconds. Add the pork strips and stir-fry for 30 seconds more, to toss the meat in the fragrant oil.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add all of the stock or water, bring the liquid to a simmer, then sugar/vinegar/soy mixture. Stir quickly as the liquid thickens to prevent the cornstarch from clumping. Cook until the sauce has thickened and no longer tastes like cornstarch, about 30 seconds. Drizzle in sesame oil and serve immediately.",
      "secondary_message": null
    }
  ],
