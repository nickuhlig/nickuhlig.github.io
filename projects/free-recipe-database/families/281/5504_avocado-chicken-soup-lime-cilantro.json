  "instructions": [
    {
      "id": 66013,
      "primary_message": "Wash jalapeños and tomatoes. Seed and mince jalapeños. Medium dice tomatoes.",
      "secondary_message": "3 jalapeño peppers\n6 tomatoes"
    },
    {
      "id": 66012,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onion\n6 cloves garlic"
    },
    {
      "id": 66011,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 66010,
      "primary_message": "Add oil to pot and swirl to coat bottom. Add onions and jalapeños; cook, stirring frequently, until tender, 2-3 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 66009,
      "primary_message": "Add garlic and tomatoes to saucepan; cook for about 1 minute.",
      "secondary_message": ""
    },
    {
      "id": 66008,
      "primary_message": "Slice chicken in half horizontally into thin fillets.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 66007,
      "primary_message": "Add broth, cumin, salt, and pepper to saucepan.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n¾ tsp cumin\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 66006,
      "primary_message": "Place chicken in liquid and bring to a boil. Reduce heat back to medium, cover, and cook until chicken is cooked through, 8-10 minutes. Once cooked, transfer chicken to a plate.",
      "secondary_message": ""
    },
    {
      "id": 66005,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and chop the leaves.",
      "secondary_message": "1 ½ small bunches cilantro"
    },
    {
      "id": 66004,
      "primary_message": "Halve and pit avocados. Spoon out the flesh and medium dice.",
      "secondary_message": "3 avocados"
    },
    {
      "id": 66003,
      "primary_message": "Shred or dice chicken and return to saucepan. Stir in ¾ of the cilantro (save the rest for garnishing) and lime juice.",
      "secondary_message": "juice of 1 ½ limes"
    },
    {
      "id": 66002,
      "primary_message": "Cut remaining lime to wedges.",
      "secondary_message": ""
    },
    {
      "id": 66001,
      "primary_message": "Serve soup in a bowl, stir in avocado, and garnish with remaining cilantro and lime wedges.",
      "secondary_message": ""
    }
  ],
