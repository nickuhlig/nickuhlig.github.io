  "instructions": [
    {
      "id": 224782,
      "primary_message": "Preheat oven to 375°F. Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 224783,
      "primary_message": "Wash and dry grapes; separate into small bunches and place on the baking sheet.",
      "secondary_message": "1 ½ lb red grapes"
    },
    {
      "id": 224784,
      "primary_message": "Wash, dry, and slide thyme leaves off the stems; discard stems. Sprinkle thyme over the grapes, then drizzle with oil. ",
      "secondary_message": "1 small pkg fresh thyme\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 224785,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until grapes begin to swell, about 15 minutes. Remove from oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 224786,
      "primary_message": "Meanwhile, finely chop pecans and place on a plate.",
      "secondary_message": "1 cup pecans, dry roasted"
    },
    {
      "id": 224787,
      "primary_message": "Slice goat cheese into ½-inch thick medallions and transfer to the plate with the pecans. Turn to coat, gently pressing pecans into both sides of the medallions. Set aside.",
      "secondary_message": "3 (4 oz) logs goat cheese"
    },
    {
      "id": 224788,
      "primary_message": "Arrange bread on another large baking sheet and place in the oven to toast, about 5 minutes. (Alternatively, you can use a toaster.) Slice toast in half.",
      "secondary_message": "9 slices whole grain bread"
    },
    {
      "id": 224789,
      "primary_message": "To serve, divide roasted grapes, goat cheese medallions, and toast between plates. Drizzle honey over the goat cheese and enjoy!",
      "secondary_message": "⅓ cup honey"
    }
  ],
