  "instructions": [
    {
      "id": 609635,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 sticks celery\n3 medium carrots\n3 red chili peppers\n1 ½ lemons\n3 small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 609636,
      "primary_message": "Peel and mince garlic. Divide between two medium bowls, then set one bowl aside for later use.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 609637,
      "primary_message": "Add vinegar, sugar, and spices to the remaining bowl with the garlic. Whisk to combine the pickling liquid.",
      "secondary_message": "½ cup white wine vinegar\n1 tbsp brown sugar\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 609638,
      "primary_message": "Trim and small dice celery. Add to the bowl with pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 609639,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 609640,
      "primary_message": "Thinly slice chili peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 609641,
      "primary_message": "Roughly chop olives. Add to the bowl, along with capers, and stir to combine the relish. Set aside.",
      "secondary_message": "⅓ cup Kalamata olives, pitted\n3 tbsp capers"
    },
    {
      "id": 609642,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 609643,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 609644,
      "primary_message": "Meanwhile, zest and juice lemons into the reserved bowl with the garlic. Add mayo, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 609645,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 609646,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop or tear the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 609647,
      "primary_message": "Cut or tear mozzarella into bite-sized pieces. Add to the bowl and stir to combine the salad.",
      "secondary_message": "1 ½ (227 g) pkgs fresh mozzarella cheese"
    },
    {
      "id": 609648,
      "primary_message": "To serve, divide salad and sausage between plates. Top sausage with relish and enjoy! ",
      "secondary_message": null
    }
  ],
