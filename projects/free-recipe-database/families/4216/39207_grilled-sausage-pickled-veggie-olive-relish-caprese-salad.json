  "instructions": [
    {
      "id": 609481,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n1 medium carrot\n1 red chili pepper\n½ lemon\n1 pint grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 609482,
      "primary_message": "Peel and mince garlic. Divide between a small and a medium bowl, then set the medium bowl aside for later use.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 609483,
      "primary_message": "Add vinegar, sugar, and spices to the small bowl with the garlic. Whisk to combine the pickling liquid.",
      "secondary_message": "3 tbsp white wine vinegar\n1 tsp brown sugar\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 609484,
      "primary_message": "Trim and small dice celery. Add to the bowl with pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 609485,
      "primary_message": "Peel, trim, and small dice carrot. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 609486,
      "primary_message": "Thinly slice chili pepper into rings; seed and remove ribs with a spoon to reduce spice level. Add to the bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 609487,
      "primary_message": "Roughly chop olives. Add to the bowl, along with capers, and stir to combine the relish. Set aside.",
      "secondary_message": "⅛ cup Kalamata olives, pitted\n1 tbsp capers"
    },
    {
      "id": 609488,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 609489,
      "primary_message": "Once the pan is hot, coat with oil; add sausages and grill, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 pork sausages"
    },
    {
      "id": 609490,
      "primary_message": "Meanwhile, zest and juice lemon into the reserved medium bowl with the garlic. Add mayo, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 609491,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 609492,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop or tear the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 609493,
      "primary_message": "Cut or tear mozzarella into bite-sized pieces. Add to the bowl and stir to combine the salad.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 609494,
      "primary_message": "To serve, divide salad and sausage between plates. Top sausage with relish and enjoy! ",
      "secondary_message": null
    }
  ],
