  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small saucepan, melt butter over medium-high heat, stirring and swirling, until foaming has subsided and milk solids have turned a chestnut-brown color, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add maple syrup and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add pecans and cook, stirring, until a caramel forms and thickens enough to briefly leave a trail when a spoon is scraped along the bottom of the saucepan, about 4 minutes. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place popped popcorn in a large mixing bowl and drizzle caramel mixture and nuts all over, tossing as you go, until popcorn is evenly coated in caramel. Season with salt, if necessary. Refrigerate popcorn until caramel is set, about 10 minutes. Toss to break up any clumps and serve. Popcorn can be refrigerated in a zipper-lock bag overnight.",
      "secondary_message": null
    }
  ],
