  "instructions": [
    {
      "id": 264591,
      "primary_message": "Fill a large pot halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz penne pasta"
    },
    {
      "id": 264592,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ bunches radish\n6 peaches\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 264593,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 264594,
      "primary_message": "Zest and juice lemons into a large bowl. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tbsp Dijon mustard\n1 tbsp honey\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264595,
      "primary_message": "Peel, halve, and slice shallots lengthwise into very thin strips; add to the bowl with the dressing and stir to combine.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 264596,
      "primary_message": "Add beans to the bowl.",
      "secondary_message": null
    },
    {
      "id": 264597,
      "primary_message": "Trim and thinly slice radishes; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 264598,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 264599,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 264600,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool.",
      "secondary_message": null
    },
    {
      "id": 264601,
      "primary_message": "Add pasta and arugula to the bowl; toss to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 264602,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    }
  ],
