  "instructions": [
    {
      "id": 37669,
      "primary_message": "Preheat the oven to 500°F (260°C). Line a baking sheet with aluminum foil to make cleanup easier (optional).",
      "secondary_message": ""
    },
    {
      "id": 37670,
      "primary_message": "Wash squash, halve lengthwise, and scoop out the seeds. Rub each half with olive oil and season with salt and freshly ground pepper. Place halves, cut side down, on a baking sheet.",
      "secondary_message": "2 medium spaghetti squash\n4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 37672,
      "primary_message": "Place the squash in the oven (it doesn't have to be fully heated) and roast until tender so a knife can easily pierce though the flesh, 20-25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 37673,
      "primary_message": "While the squash cooks, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 37674,
      "primary_message": "Seed and small dice the bell peppers; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 37675,
      "primary_message": "Seed and mince the jalapeño peppers (leave the seeds in for more heat if desired); add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 37676,
      "primary_message": "Peel and small dice the onion; add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 37677,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 37678,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 37679,
      "primary_message": "While the skillet heats up, drain and rinse the beans.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 37680,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom. Add the onion and peppers; cook, stirring occasionally, until the vegetables begin to soften, 3 to 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 37681,
      "primary_message": "Add the beans, chili powder, salt, and black pepper to the skillet and squeeze lime juice over top; stir to combine and cook for 1 to 2 minutes. Reduce heat to low and stir occasionally while you wait for the squash to cook.",
      "secondary_message": "2 tbsp chili powder\n½ tsp salt\n½ tsp black pepper\n1 lime"
    },
    {
      "id": 37682,
      "primary_message": "Coarsely grate 1 cup of cheddar.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 37683,
      "primary_message": "Remove the squash from the oven and change the oven setting to broil. Allow squash to cool slightly, about 5 minutes. Using a fork, scrape up the squash flesh to make spaghetti-like strings (use an oven mitt or towel to hold it with your other hand).",
      "secondary_message": null
    },
    {
      "id": 37684,
      "primary_message": "Add the strands of spaghetti squash along with half of the minced cilantro (save the rest for garnishing) to the skillet; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 37685,
      "primary_message": "Fill the squash halves with the squash-vegetable mixture and sprinkle with the grated cheddar.",
      "secondary_message": ""
    },
    {
      "id": 37686,
      "primary_message": "Place the squash back in the oven and broil until the cheese is melted, 1-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 37687,
      "primary_message": "Place the squash halves on four plates (or on two plates and in two lunch containers) and sprinkle with the remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
