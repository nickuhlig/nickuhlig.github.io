  "instructions": [
    {
      "id": 37650,
      "primary_message": "Preheat the oven to 500°F (260°C). Line a baking sheet with aluminum foil to make cleanup easier (optional).",
      "secondary_message": ""
    },
    {
      "id": 37651,
      "primary_message": "Wash squash, halve lengthwise, and scoop out the seeds. Rub each half with olive oil and season with salt and freshly ground pepper. Place halves, cut side down, on a baking sheet.",
      "secondary_message": "1 medium spaghetti squash\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 37653,
      "primary_message": "Place the squash in the oven (it doesn't have to be fully heated) and roast until tender so a knife can easily pierce though the flesh, 20-25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 37654,
      "primary_message": "While the squash cooks, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 37655,
      "primary_message": "Seed and small dice the bell pepper; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 37656,
      "primary_message": "Seed and mince the jalapeño pepper (leave the seeds in for more heat if desired); add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 37657,
      "primary_message": "Peel and small dice the onion; add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 37658,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 37659,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 37660,
      "primary_message": "While the skillet heats up, drain and rinse the beans.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 37661,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom. Add the onion and peppers; cook, stirring occasionally, until the vegetables begin to soften, 3 to 4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 37662,
      "primary_message": "Add the beans, chili powder, salt, and black pepper to the skillet and squeeze lime juice over top; stir to combine and cook for 1 to 2 minutes. Reduce heat to low and stir occasionally while you wait for the squash to cook.",
      "secondary_message": "1 tbsp chili powder\n¼ tsp salt\n¼ tsp black pepper\n½ lime"
    },
    {
      "id": 37663,
      "primary_message": "Coarsely grate ½ cup of cheddar.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 37664,
      "primary_message": "Remove the squash from the oven and change the oven setting to broil. Allow the squash to cool slightly, about 5 minutes. Using a fork, scrape up the squash flesh to make spaghetti-like strings (use an oven mitt or towel to hold it with your other hand).",
      "secondary_message": null
    },
    {
      "id": 37665,
      "primary_message": "Add the strands of spaghetti squash along with halve of the minced cilantro (save the rest for garnishing) to the skillet; toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 37666,
      "primary_message": "Fill the squash halves with the squash-vegetable mixture and sprinkle with the grated cheddar.",
      "secondary_message": ""
    },
    {
      "id": 37667,
      "primary_message": "Place the squash back in the oven and broil until the cheese is melted, 1 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 37668,
      "primary_message": "Place the squash halves on two plates (or on one plate and in one lunch container) and sprinkle with the remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
