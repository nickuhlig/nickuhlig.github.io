  "instructions": [
    {
      "id": 552504,
      "primary_message": "Preheat oven to 400°F. ",
      "secondary_message": null
    },
    {
      "id": 552505,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 552506,
      "primary_message": "Place bread crumbs, coconut, and spices in a small bowl. Stir to combine the breading mixture and set aside.",
      "secondary_message": "½ cup panko bread crumbs\n½ cup shredded unsweetened coconut\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 552507,
      "primary_message": "Place mayo and salt in a medium bowl; stir to combine.",
      "secondary_message": "¼ cup vegan mayonnaise\n½ tsp salt"
    },
    {
      "id": 552508,
      "primary_message": "Cut tofu crosswise into 1-inch wide fingers. Add to the bowl with the mayo mixture and gently toss to coat. (Wipe baking sheet dry with paper towels, coat with a thin layer of oil, and reserve for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 552509,
      "primary_message": "Add the breading mixture to the bowl with the tofu and turn to coat, pressing gently to adhere. Return tofu to the baking sheet and arrange in a single layer.",
      "secondary_message": null
    },
    {
      "id": 552510,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and warmed through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 552511,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 lime\n1 jalapeño pepper\n1 small bunch cilantro\n1 medium head napa cabbage\n2 mangoes"
    },
    {
      "id": 552512,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small saucepan along with maple syrup, vinegar, water, and crushed red pepper. Set over medium-high heat and bring sauce to a boil.",
      "secondary_message": "2 cloves garlic\n⅓ cup pure maple syrup\n⅓ cup rice vinegar\n⅓ cup water\n½ tsp crushed red pepper"
    },
    {
      "id": 552513,
      "primary_message": "Once the sauce is boiling, reduce to medium and cook, stirring occasionally, until thickened slightly, 2-3 minutes. Remove from heat, then transfer ⅓ of the sauce to a clean medium bowl. Set remaining sauce aside for serving.",
      "secondary_message": null
    },
    {
      "id": 552514,
      "primary_message": "Juice lime into the bowl with the sauce, then whisk to combine the dressing.",
      "secondary_message": null
    },
    {
      "id": 552515,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 552516,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 552517,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 552518,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; slice into ¼-inch thick pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 552519,
      "primary_message": "Divide tofu and salad between plates. Serve with reserved sauce for dipping and enjoy!",
      "secondary_message": null
    }
  ],
