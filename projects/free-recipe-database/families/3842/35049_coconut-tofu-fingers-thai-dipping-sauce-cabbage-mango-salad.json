  "instructions": [
    {
      "id": 552520,
      "primary_message": "Preheat oven to 400°F. ",
      "secondary_message": null
    },
    {
      "id": 552521,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 552522,
      "primary_message": "Place bread crumbs, coconut, and spices in a small bowl. Stir to combine the breading mixture and set aside.",
      "secondary_message": "¾ cup panko bread crumbs\n¾ cup shredded unsweetened coconut\n1 ½ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 552523,
      "primary_message": "Place mayo and salt in a large bowl; stir to combine.",
      "secondary_message": "⅓ cup vegan mayonnaise\n¾ tsp salt"
    },
    {
      "id": 552524,
      "primary_message": "Cut tofu crosswise into 1-inch wide fingers. Add to the bowl with the mayo mixture and gently toss to coat. (Wipe baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 552525,
      "primary_message": "Coat reserved baking sheet and an additional baking sheet with a thin layer of oil. Add bread crumb mixture to the bowl with the tofu and gently toss once more to coat, then divide tofu between the baking sheets and arrange in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 552526,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and warmed through, about 18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 552527,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ limes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n1 ½ medium heads napa cabbage\n3 mangoes"
    },
    {
      "id": 552528,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small saucepan along with maple syrup, vinegar, water, and crushed red pepper. Set over medium-high heat and bring sauce to a boil.",
      "secondary_message": "3 cloves garlic\n½ cup pure maple syrup\n½ cup rice vinegar\n½ cup water\n¾ tsp crushed red pepper"
    },
    {
      "id": 552529,
      "primary_message": "Once the sauce is boiling, reduce to medium and cook, stirring occasionally, until thickened slightly, 3-4 minutes. Remove from heat, then transfer ⅓ of the sauce to a clean large bowl. Set remaining sauce aside for serving.",
      "secondary_message": null
    },
    {
      "id": 552530,
      "primary_message": "Juice limes into the bowl with the sauce, then whisk to combine the dressing.",
      "secondary_message": null
    },
    {
      "id": 552531,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 552532,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 552533,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 552534,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; slice into ¼-inch thick pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 552535,
      "primary_message": "Divide tofu and salad between plates. Serve with reserved sauce for dipping and enjoy!",
      "secondary_message": null
    }
  ],
