  "instructions": [
    {
      "id": 167787,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch cilantro\n½ small bunch green onions (scallions)\n1 (1 inch) piece ginger root\n2 baby bok choy"
    },
    {
      "id": 167788,
      "primary_message": "Pour broth, oil, and sauces into a large pot and heat over medium-high. ",
      "secondary_message": "28 fl oz (3 ½ cups) chicken or vegetable broth\n1 tbsp toasted sesame oil\n1 tbsp soy sauce\n1 tsp chili-garlic sauce"
    },
    {
      "id": 167789,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add half of each to the pot and transfer the remaining half to a medium bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 167790,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Transfer half to the bowl with the ginger and garlic and set the other half aside in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 167791,
      "primary_message": "Trim and finely chop green onions. Add half to the medium bowl and half to the small bowl.",
      "secondary_message": null
    },
    {
      "id": 167792,
      "primary_message": "Add pork, egg, sauces, and pepper to the medium bowl and gently mix to combine the ingredients. ",
      "secondary_message": "¾ lb lean ground pork\n1 egg\n1 tsp soy sauce\n¼ tsp Worcestershire sauce\n¼ tsp black pepper"
    },
    {
      "id": 167793,
      "primary_message": "Using a tablespoon measure, form the pork mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 167794,
      "primary_message": "Once the broth begins to boil, turn down to a simmer. Carefully add the meatballs (a few at a time, to avoid splashing) to the pot. Simmer until pork is cooked through, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 167795,
      "primary_message": "Meanwhile, trim bok choy and slice in half lengthwise. Add to the soup along with the remaining cilantro and green onion.",
      "secondary_message": null
    },
    {
      "id": 167796,
      "primary_message": "Return soup to a simmer and cook until bok choy is tender, 4-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 167797,
      "primary_message": "To serve, divide soup between bowls and enjoy! ",
      "secondary_message": null
    }
  ],
