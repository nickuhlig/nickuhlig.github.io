  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the limes.",
      "secondary_message": "2 limes"
    },
    {
      "id": 1,
      "primary_message": "Measure the sugar into a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine the pomegranate juice and lime juice in a large, heavy-bottomed pot. Sprinkle the pectin over the juice and whisk until it dissolves, about 1 minute. Add the butter and bring the mixture to a boil over high heat. Add the sugar all at once and whisk to break up any clumps. Stirring constantly, bring the mixture to a full rolling boil. Boil hard for 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove the pot from the heat and skim any foam from the surface of the jelly with a cold metal spoon. Ladle the hot jelly into hot sterilized jars and process them in a hot water bath for 10 minutes.",
      "secondary_message": null
    }
  ],
