  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and seed bell pepper; slice lengthwise into thin strips. Transfer to a baking dish, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 green bell pepper\n2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Add meatballs to the baking dish, arranging them over the bell pepper, then place in the preheated oven. Bake stirring halfway through, until meatballs are cooked through and peppers are tender, 15-25 min. Remove from the oven.",
      "secondary_message": "170 g frozen homestyle meatballs, fully-cooked"
    },
    {
      "primary_message": "Set oven to broil on high. Add marinara sauce to the baking dish, stir to coat the meatballs and peppers, then sprinkle with cheese. Return baking dish to the oven and broil until sauce is warmed through and cheese is melted, 3-4 min.",
      "secondary_message": "1 cup marinara sauce\n⅔ cup shredded cheese, Italian blend"
    },
    {
      "primary_message": "Toast rolls if desired, then divide between plates; fill with cheese meatballs, bell peppers, and sauce. Enjoy!",
      "secondary_message": null
    }
  ],
