  "instructions": [
    {
      "id": 456761,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, then stir for a few seconds. Cook until pasta is desired firmness, 8-10 minutes. (Reserve a ¼-cup cooking water before draining and set aside.)",
      "secondary_message": "½ tsp salt\n142 g spaghetti pasta"
    },
    {
      "id": 456762,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a small bowl and set aside.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 456763,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456764,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Add to the bowl with the Parmesan, along with spices, and stir to combine; set aside. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp butter, unsalted\n¼ cup panko bread crumbs\n¼ tsp garlic powder\n¼ tsp crushed red pepper\n⅛ tsp salt"
    },
    {
      "id": 456765,
      "primary_message": "Wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces, keeping them separate. Place leaves in a medium bowl (reserving stems for later use).",
      "secondary_message": "1 bunch Swiss chard"
    },
    {
      "id": 456766,
      "primary_message": "Drain and rinse beans in a colander.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 456767,
      "primary_message": "Return skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add chard stems, beans, and spices to the skillet; cook, stirring occasionally, until stems soften and beans are warmed through, 3-4 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 456768,
      "primary_message": "Add cooked pasta and reserved pasta water to the skillet. Continue to cook, stirring occasionally, until water has evaporated, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 456769,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Cook, stirring occasionally, until the chard is tender, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 456770,
      "primary_message": "Wash, dry, and juice lemon into the skillet. Stir to combine and remove from heat.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 456771,
      "primary_message": "To serve, divide pasta between plates or bowls and top with cheesy bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
