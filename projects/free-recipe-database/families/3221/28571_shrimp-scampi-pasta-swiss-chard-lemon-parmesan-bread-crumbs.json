  "instructions": [
    {
      "id": 456607,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, then stir for a few seconds. Cook until pasta is desired firmness, 8-10 minutes. (Reserve a ½-cup cooking water before draining and set aside.)",
      "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
    },
    {
      "id": 456608,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a small bowl and set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 456609,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456610,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Add to the bowl with the Parmesan, along with spices, and stir to combine; set aside. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp butter, unsalted\n½ cup panko bread crumbs\n½ tsp garlic powder\n½ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 456611,
      "primary_message": "Wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces, keeping them separate. Place leaves in a medium bowl (reserving stems for later use).",
      "secondary_message": "2 bunches Swiss chard"
    },
    {
      "id": 456612,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 456613,
      "primary_message": "Return skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add chard stems, shrimp, and spices to the skillet; cook, stirring frequently, until shrimp are just opaque, 2-3 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 456614,
      "primary_message": "Add cooked pasta and reserved pasta water to the skillet. Continue to cook, stirring occasionally, until water has evaporated, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 456615,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Cook, stirring occasionally, until the chard is tender, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 456616,
      "primary_message": "Wash, dry, and juice lemon into the skillet. Stir to combine and remove from heat.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 456617,
      "primary_message": "To serve, divide pasta between plates or bowls and top with cheesy bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
