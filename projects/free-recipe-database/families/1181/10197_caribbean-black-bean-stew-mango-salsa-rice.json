  "instructions": [
    {
      "id": 162543,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 162544,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 162545,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n0.23 kg sweet potato\n1 mango\n½ small bunch green onions (scallions)\n½ small bunch cilantro\n½ jalapeño pepper\n1 lime"
    },
    {
      "id": 162546,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 162547,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 162548,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 162549,
      "primary_message": "Seed and small dice bell pepper.",
      "secondary_message": null
    },
    {
      "id": 162550,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom. Add onion, garlic, and bell pepper; cook, stirring occasionally, until veggies begin to soften, about 3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 162551,
      "primary_message": "Meanwhile, peel and chop sweet potato into ½-inch pieces. Add to the pan with the veggies along with the beans, broth, and spices. Stir and bring to a boil over high heat. Reduce heat to a simmer and cook, stirring occasionally, until potatoes are fork-tender, about 10 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n½ tsp salt\n¼ tsp cinnamon\n⅛ tsp cayenne pepper\n⅛ tsp cumin"
    },
    {
      "id": 162552,
      "primary_message": "Peel mango and slice the flesh away from the pit, starting with the flat sides; small dice and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 162553,
      "primary_message": "Trim and mince green onions; add to the bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 162554,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 162555,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 162556,
      "primary_message": "Juice lime into the bowl and stir to combine the salsa.",
      "secondary_message": null
    },
    {
      "id": 162557,
      "primary_message": "To serve, divide rice, stew, and mango salsa between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
