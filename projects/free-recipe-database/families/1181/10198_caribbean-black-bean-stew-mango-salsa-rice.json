  "instructions": [
    {
      "id": 162558,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 162559,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 162560,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n0.45 kg sweet potato\n2 mangoes\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 jalapeño pepper\n2 limes"
    },
    {
      "id": 162561,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 162562,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 162563,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 162564,
      "primary_message": "Seed and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 162565,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and bell pepper; cook, stirring occasionally, until veggies begin to soften, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 162566,
      "primary_message": "Meanwhile, peel and chop sweet potatoes into ½-inch pieces. Add to the pot with the veggies along with the beans, broth, and spices. Stir and bring to a boil over high heat. Reduce heat to a simmer and cook, stirring occasionally, until potatoes are fork-tender, about 10 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n1 tsp salt\n½ tsp cinnamon\n¼ tsp cayenne pepper\n¼ tsp cumin"
    },
    {
      "id": 162567,
      "primary_message": "Peel mangoes and slice the flesh away from the pit, starting with the flat sides; small dice and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 162568,
      "primary_message": "Trim and mince green onions; add to the bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 162569,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 162570,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 162571,
      "primary_message": "Juice limes into the bowl and stir to combine the salsa.",
      "secondary_message": null
    },
    {
      "id": 162572,
      "primary_message": "To serve, divide rice, stew, and mango salsa between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
