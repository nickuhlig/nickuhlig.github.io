  "instructions": [
    {
      "id": 450792,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 450793,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 450794,
      "primary_message": "While the rice is cooking, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450795,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground, carrots, curry paste, and salt; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 ½ (283 g) bags shredded carrots\n¼ cup Thai curry paste, green\n¾ tsp salt"
    },
    {
      "id": 450796,
      "primary_message": "Meanwhile, wash and dry snap peas. Cut crosswise into bite-sized pieces.",
      "secondary_message": "1 ½ (227 g) pkgs sugar snap peas"
    },
    {
      "id": 450797,
      "primary_message": "When the veggie ground is done, add snap peas and water to the pot. Cook, stirring occasionally, until the peas are just tender and sauce has thickened slightly, 2-3 minutes. Cover and remove from heat.",
      "secondary_message": "1 cup water"
    },
    {
      "id": 450798,
      "primary_message": "While the snap peas are cooking, wash, dry, and cut limes into wedges. Set aside for serving.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 450799,
      "primary_message": "When the rice is done, add to the pot along with soy sauce. Set over high heat and cook, stirring constantly, until warmed through, 2-3 minutes. Remove from heat.",
      "secondary_message": "2 tbsp soy sauce"
    },
    {
      "id": 450800,
      "primary_message": "To serve, divide fried rice between plates or bowls. Squeeze lime over top and enjoy!",
      "secondary_message": null
    }
  ],
