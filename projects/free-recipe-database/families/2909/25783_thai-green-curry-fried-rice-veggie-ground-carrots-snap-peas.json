  "instructions": [
    {
      "id": 450774,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 450775,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 450776,
      "primary_message": "While the rice is cooking, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450777,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, carrots, curry paste, and salt; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n227 g veggie ground, plant based\n½ (283 g) bag shredded carrots\n1 ½ tbsp Thai curry paste, green\n¼ tsp salt"
    },
    {
      "id": 450778,
      "primary_message": "Meanwhile, wash and dry snap peas. Cut crosswise into bite-sized pieces.",
      "secondary_message": "½ (227 g) pkg sugar snap peas"
    },
    {
      "id": 450779,
      "primary_message": "When the veggie ground is done, add snap peas and water to the skillet. Cook, stirring occasionally, until the peas are just tender and sauce has thickened slightly, 1-2 minutes. Cover and remove from heat.",
      "secondary_message": "⅓ cup water"
    },
    {
      "id": 450780,
      "primary_message": "While the snap peas are cooking, wash, dry, and cut lime into wedges. Set aside for serving.",
      "secondary_message": "½ lime"
    },
    {
      "id": 450781,
      "primary_message": "When the rice is done, add to the skillet along with soy sauce. Set over high heat and cook, stirring constantly, until warmed through, about 2 minutes. Remove from heat.",
      "secondary_message": "2 tsp soy sauce"
    },
    {
      "id": 450782,
      "primary_message": "To serve, divide fried rice between plates or bowls. Squeeze lime over top and enjoy!",
      "secondary_message": null
    }
  ],
