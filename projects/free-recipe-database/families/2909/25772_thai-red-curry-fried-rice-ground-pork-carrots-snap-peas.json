  "instructions": [
    {
      "id": 450675,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 450676,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 450677,
      "primary_message": "While the rice is cooking, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450678,
      "primary_message": "Once the skillet is hot, add pork, carrots, curry paste, and salt. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 ½ lb lean ground pork\n1 (10 oz) bag shredded carrots\n¼ cup Thai curry paste, red\n½ tsp salt"
    },
    {
      "id": 450679,
      "primary_message": "Meanwhile, wash and dry snap peas. Cut crosswise into bite-sized pieces.",
      "secondary_message": "1 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 450680,
      "primary_message": "When the pork is done, add snap peas and water to the skillet. Cook, stirring occasionally, until the peas are just tender and sauce has thickened slightly, 1-2 minutes. Cover and remove from heat.",
      "secondary_message": "⅔ cup water"
    },
    {
      "id": 450681,
      "primary_message": "While the snap peas are cooking, wash, dry, and cut lime into wedges. Set aside for serving.",
      "secondary_message": "1 lime"
    },
    {
      "id": 450682,
      "primary_message": "When the rice is done, add to the skillet along with fish sauce. Set over high heat and cook, stirring constantly, until warmed through, about 2 minutes. Remove from heat.",
      "secondary_message": "4 tsp fish sauce"
    },
    {
      "id": 450683,
      "primary_message": "To serve, divide fried rice between plates or bowls. Squeeze lime over top and enjoy!",
      "secondary_message": null
    }
  ],
