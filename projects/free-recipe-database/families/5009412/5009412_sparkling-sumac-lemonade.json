  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Sumac Syrup: Combine water and sugar in a small saucepan. Heat over medium heat, stirring occasionally, until the sugar is dissolved. All to cool to room temperature. Add sumac, stir to combine, and allow to infuse for 5 minutes. Strain through a fine mesh strainer. Sumac syrup can be stored in a sealed container in the refrigerator for up to 5 days.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Soda: For each serving, combine 1 cup club soda, 1/4 cup sumac syrup, and 1 tablespoon lemon juice in a cup. Add ice and stir. Serve immediately with lemon wedges.",
      "secondary_message": null
    }
  ],
