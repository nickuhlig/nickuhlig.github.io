  "instructions": [
    {
      "id": 77910,
      "primary_message": "In a small saucepan, combine the quinoa and water; bring to a boil over high heat.",
      "secondary_message": "1 ½ cups quinoa\n710 ml (3 cups) water"
    },
    {
      "id": 77909,
      "primary_message": "Drain and rinse the black beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 77908,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 mangoes\n1 ½ avocados\n1 ½ limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 77907,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the quinoa for 15 minutes. Once done, remove the quinoa from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 77906,
      "primary_message": "Juice the limes and transfer to a medium salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77905,
      "primary_message": "To the lime juice, add olive oil, honey, salt, and pepper; whisk together.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tsp honey\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 77904,
      "primary_message": "Peel the mangoes, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and small dice the flesh into 6-mm cubes. Add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77903,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh into 6-mm cubes. Add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77902,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77901,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion into 6-mm pieces. Add to the salad bowl.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 77900,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 77899,
      "primary_message": "Once the skillet is hot, add the black beans and cook until heated through, 2 to 3 minutes. Remove from the heat.",
      "secondary_message": ""
    },
    {
      "id": 77898,
      "primary_message": "Uncover the quinoa and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 77897,
      "primary_message": "To serve, arrange the quinoa, black beans, and mango-avocado mixture in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
