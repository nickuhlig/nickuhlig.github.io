  "instructions": [
    {
      "id": 341381,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 mangoes\n3 Gala apples\n1 small pkg fresh basil"
    },
    {
      "id": 341382,
      "primary_message": "Zest and juice limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 341383,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides. Medium dice and add to the bowl with the lime.",
      "secondary_message": null
    },
    {
      "id": 341384,
      "primary_message": "Quarter, core, and medium dice apples; add to the bowl and stir to combine the fruit medley. Set aside.",
      "secondary_message": null
    },
    {
      "id": 341385,
      "primary_message": "Place mayo, curry paste, vinegar, honey, and salt in a large bowl. Stir to combine the dressing.",
      "secondary_message": "½ cup mayonnaise\n2 tbsp Thai curry paste, red\n1 ½ tbsp rice vinegar\n1 ½ tsp honey\n¾ tsp salt"
    },
    {
      "id": 341386,
      "primary_message": "Roughly chop eggs and add to the bowl with the dressing. Using a potato masher, mash and combine the egg salad. ",
      "secondary_message": "18 hard-cooked eggs, peeled"
    },
    {
      "id": 341387,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the egg salad and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 341388,
      "primary_message": "Place half of the bread slices on a flat surface and divide egg salad between them; cover with remaining slices and press gently to adhere. Cut sandwiches in half.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 341389,
      "primary_message": "To serve, divide sandwiches and fruit medley between plates. Enjoy!",
      "secondary_message": null
    }
  ],
