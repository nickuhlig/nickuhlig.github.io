  "instructions": [
    {
      "id": 341363,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n1 mango\n1 Gala apple\n½ small pkg fresh basil"
    },
    {
      "id": 341364,
      "primary_message": "Zest and juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 341365,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides. Medium dice and add to the bowl with the lime.",
      "secondary_message": null
    },
    {
      "id": 341366,
      "primary_message": "Quarter, core, and medium dice apple; add to the bowl and stir to combine the fruit medley. Set aside.",
      "secondary_message": null
    },
    {
      "id": 341367,
      "primary_message": "Place mayo, curry paste, vinegar, honey, and salt in a medium bowl. Stir to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n2 tsp Thai curry paste, red\n1 ½ tsp rice vinegar\n½ tsp honey\n¼ tsp salt"
    },
    {
      "id": 341368,
      "primary_message": "Roughly chop eggs and add to the bowl with the dressing. Using a fork or potato masher, mash and combine the egg salad. ",
      "secondary_message": "6 hard-cooked eggs, peeled"
    },
    {
      "id": 341369,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the egg salad and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 341370,
      "primary_message": "Place half of the bread slices on a flat surface and divide egg salad between them; cover with remaining slices and press gently to adhere. Cut sandwiches in half.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 341371,
      "primary_message": "To serve, divide sandwiches and fruit medley between plates. Enjoy!",
      "secondary_message": null
    }
  ],
