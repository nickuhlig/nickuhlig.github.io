  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Coarsely chop the garlic scapes. Juice the lemon. Grate the Parmesan cheese.",
      "secondary_message": "¾ cup garlic scapes\n½ lemon\n¼ cup Parmesan cheese"
    },
    {
      "id": 1,
      "primary_message": "In the bowl of a food processor fitted with a metal blade, combine scapes, pine nuts, and lemon juice and zest, and season with salt. Process, scraping down sides halfway through with a flexible spatula, until scapes and nuts are broken down into small pieces, about 1 minute. Add cheese and process until incorporated, about 30 seconds. Add basil and pulse until finely minced, about ten 1-second pulses.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer scape mixture to a medium bowl. While stirring continuously, slowly pour olive oil into scape mixture in a thin stream. Season with salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pesto can be used right away, or transferred to a jar or container, covered with a thin layer of olive oil, and sealed, then stored following the instructions below.",
      "secondary_message": null
    }
  ],
