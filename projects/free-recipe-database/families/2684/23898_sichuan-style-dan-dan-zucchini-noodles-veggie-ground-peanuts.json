  "instructions": [
    {
      "id": 480321,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 480322,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n1 small bunch green onions (scallions)\n3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 480323,
      "primary_message": "Trim zucchini; use a julienne (or regular) peeler to make noodles. Divide between two baking sheet pans, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 480324,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and roast, tossing halfway through, until zucchini is tender, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 480325,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 480326,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 480327,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 480328,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add green onion, garlic, veggie ground, salt, and pepper. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "3 tbsp toasted sesame oil\n680 g veggie ground, plant based\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 480329,
      "primary_message": "Meanwhile, peel and mince ginger and additional garlic. Place both in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 480330,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half of the cilantro to the bowl with the ginger and garlic. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 480331,
      "primary_message": "Add tahini, water, soy sauce, vinegar, chili-garlic sauce, and additional oil to the bowl. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup tahini\n¼ cup water\n3 tbsp soy sauce\n2 tbsp rice vinegar\n2 tbsp chili-garlic sauce\n1 tbsp toasted sesame oil"
    },
    {
      "id": 480332,
      "primary_message": "When the veggie ground is done, add cooked zucchini noodles and sauce to the pot; stir to combine. Cook, stirring frequently, until sauce is warmed through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 480333,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 480334,
      "primary_message": "To serve, divide veggie ground and zucchini noodles between plates or bowls; top with reserved cilantro and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
