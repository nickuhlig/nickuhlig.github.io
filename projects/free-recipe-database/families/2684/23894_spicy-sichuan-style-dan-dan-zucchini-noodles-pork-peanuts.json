  "instructions": [
    {
      "id": 480265,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 480266,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n1 small bunch green onions (scallions)\n2 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 480267,
      "primary_message": "Trim zucchini; use a julienne (or regular) peeler to make noodles. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 480268,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, tossing halfway through, until zucchini is tender, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 480269,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 480270,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 480271,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 480272,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onion, garlic, pork, salt, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "4 tsp toasted sesame oil\n0.68 kg lean ground pork\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 480273,
      "primary_message": "Meanwhile, peel and mince ginger and additional garlic. Place both in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 480274,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half of the cilantro to the bowl with the ginger and garlic. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 480275,
      "primary_message": "Add tahini, water, soy sauce, vinegar, chili-garlic sauce, and additional oil to the bowl. Whisk to combine the sauce.",
      "secondary_message": "¼ cup tahini\n3 tbsp water\n2 tbsp soy sauce\n4 tsp rice vinegar\n4 tsp chili-garlic sauce\n2 tsp toasted sesame oil"
    },
    {
      "id": 480276,
      "primary_message": "When the pork is done, add cooked zucchini noodles and sauce to the skillet; stir to combine. Cook, stirring frequently, until sauce is warmed through, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 480277,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 480278,
      "primary_message": "To serve, divide pork zucchini noodles between plates or bowls; top with reserved cilantro and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
