  "instructions": [
    {
      "id": 344617,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 344618,
      "primary_message": "Meanwhile, preheat the oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 344619,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lb white mushrooms\n1 ½ lemons\n1 small bunch green onions (scallions)"
    },
    {
      "id": 344620,
      "primary_message": "Place maple syrup, oil, soy sauce, chili-garlic sauce, and paprika in a large bowl; whisk to combine the maple sauce.",
      "secondary_message": "3 tbsp pure maple syrup\n2 tbsp extra virgin olive oil\n2 tbsp soy sauce\n1 tbsp chili-garlic sauce\n¾ tsp paprika"
    },
    {
      "id": 344621,
      "primary_message": "Cut leaves off each cauliflower head, separate into small florets, and cut the thick stems into smaller pieces; add to the bowl with the maple sauce.",
      "secondary_message": null
    },
    {
      "id": 344622,
      "primary_message": "Quarter mushrooms, add to the bowl, and toss to combine. Transfer veggies to a large baking sheet pan and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 344623,
      "primary_message": "Place baking sheet in the oven and roast until veggies are almost tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 344624,
      "primary_message": "While the veggies are roasting, juice lemons into a small bowl; add mayo, maple syrup, vinegar, and spices. Whisk to combine the lemon-mayo sauce and set aside.",
      "secondary_message": "⅓ cup vegan mayonnaise\n1 tbsp pure maple syrup\n1 ½ tsp apple cider vinegar\n½ tsp salt\n3 pinch black pepper\n3 pinch paprika"
    },
    {
      "id": 344625,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 344626,
      "primary_message": "When the veggies are almost tender, remove from the oven and stir; add sausages, nestling them into the veggies. Return to the oven and continue to cook until veggies are tender and sausages are warmed through, 5-8 minutes more. (Or cook sausages according to package directions.) Remove from oven.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 344627,
      "primary_message": "To serve, divide quinoa, roasted veggies, and sausages between bowls. Drizzle with lemon-mayo sauce and top with green onions. Enjoy!",
      "secondary_message": null
    }
  ],
