  "instructions": [
    {
      "id": 344691,
      "primary_message": "Preheat the oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 344692,
      "primary_message": "Place chicken in a medium bowl, drizzle with oil, season with spices, and toss to coat. Transfer to the baking sheet and arrange in a single layer.",
      "secondary_message": "0.57 kg chicken drumsticks\n2 tsp extra virgin olive oil\n½ tsp paprika\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 344693,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until the chicken is cooked through and golden, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344694,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n0.23 kg white mushrooms\n½ small bunch green onions (scallions)"
    },
    {
      "id": 344695,
      "primary_message": "Place maple syrup, oil, soy sauce, chili-garlic sauce, and paprika in a clean medium bowl; whisk to combine the sauce.",
      "secondary_message": "1 tbsp pure maple syrup\n2 tsp extra virgin olive oil\n2 tsp soy sauce\n1 tsp chili-garlic sauce\n¼ tsp paprika"
    },
    {
      "id": 344696,
      "primary_message": "Cut off leaves from the cauliflower, separate into small florets, and cut the thick stems into smaller pieces; add to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 344697,
      "primary_message": "Quarter mushrooms, add to the bowl, and toss to combine. Transfer veggies to a baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 344698,
      "primary_message": "Add baking dish to the oven and roast, tossing halfway through, until the veggies are fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344699,
      "primary_message": "While the veggies are roasting, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 344700,
      "primary_message": "To serve, divide chicken and veggies between plates; top with green onions and enjoy!",
      "secondary_message": null
    }
  ],
