  "instructions": [
    {
      "primary_message": "Preheat the oven to 450°F. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "Place chicken in a large bowl, drizzle with oil, season with spices, and toss to coat. Transfer to the baking sheet and arrange in a single layer.",
      "secondary_message": "3 ¾ lb chicken drumsticks\nextra virgin olive oil\npaprika\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until the chicken is cooked through and golden, about 35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lb white mushrooms\n1 small bunch green onions (scallions)"
    },
    {
      "primary_message": "Place maple syrup, oil, soy sauce, chili-garlic sauce, and paprika in a clean large bowl; whisk to combine the sauce.",
      "secondary_message": "3 tbsp pure maple syrup\nextra virgin olive oil\n1 tbsp chili-garlic sauce\npaprika"
    },
    {
      "primary_message": "Cut leaves off each cauliflower head, separate into small florets, and cut the thick stems into smaller pieces; add to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter mushrooms, add to the bowl, and toss to combine. Transfer veggies to another large baking sheet and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "primary_message": "Add baking sheet to the oven and roast, tossing halfway through, until the veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "While the veggies are roasting, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide chicken and veggies between plates; top with green onions and enjoy!",
      "secondary_message": null
    }
  ],
