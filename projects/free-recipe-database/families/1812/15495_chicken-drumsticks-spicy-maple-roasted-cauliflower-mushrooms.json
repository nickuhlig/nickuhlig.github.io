  "instructions": [
    {
      "id": 344575,
      "primary_message": "Preheat the oven to 450°F. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 344576,
      "primary_message": "Place chicken in a medium bowl, drizzle with oil, season with spices, and toss to coat. Transfer to the baking sheet and arrange in a single layer.",
      "secondary_message": "2 ½ lb chicken drumsticks\n4 tsp extra virgin olive oil\n1 tsp paprika\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 344577,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until the chicken is cooked through and golden, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344578,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 lb white mushrooms\n1 small bunch green onions (scallions)"
    },
    {
      "id": 344579,
      "primary_message": "Place maple syrup, oil, soy sauce, chili-garlic sauce, and paprika in a large bowl; whisk to combine the sauce.",
      "secondary_message": "2 tbsp pure maple syrup\n4 tsp extra virgin olive oil\n4 tsp soy sauce\n2 tsp chili-garlic sauce\n½ tsp paprika"
    },
    {
      "id": 344580,
      "primary_message": "Cut off leaves from the cauliflower, separate into small florets, and cut the thick stems into smaller pieces; add to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 344581,
      "primary_message": "Quarter mushrooms, add to the bowl, and toss to combine. Transfer veggies to a large baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 344582,
      "primary_message": "Add baking dish to the oven and roast, tossing halfway through, until the veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344583,
      "primary_message": "While the veggies are roasting, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 344584,
      "primary_message": "To serve, divide chicken and veggies between plates; top with green onions and enjoy!",
      "secondary_message": null
    }
  ],
