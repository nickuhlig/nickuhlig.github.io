  "instructions": [
    {
      "id": 344595,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 344596,
      "primary_message": "Meanwhile, preheat the oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 344597,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ lb white mushrooms\n½ lemon\n½ small bunch green onions (scallions)"
    },
    {
      "id": 344598,
      "primary_message": "Place maple syrup, oil, soy sauce, chili-garlic sauce, and paprika in a medium bowl; whisk to combine the maple sauce.",
      "secondary_message": "1 tbsp pure maple syrup\n2 tsp extra virgin olive oil\n2 tsp soy sauce\n1 tsp chili-garlic sauce\n¼ tsp paprika"
    },
    {
      "id": 344599,
      "primary_message": "Cut off leaves from the cauliflower, separate into small florets, and cut the thick stems into smaller pieces; add to the bowl with the maple sauce.",
      "secondary_message": null
    },
    {
      "id": 344600,
      "primary_message": "Quarter mushrooms, add to the bowl, and toss to combine. Transfer veggies to a baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 344601,
      "primary_message": "Place baking dish in the oven and roast until veggies are almost tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 344602,
      "primary_message": "While the veggies are roasting, juice lemon into a small bowl; add mayo, maple syrup, vinegar, and spices. Whisk to combine the lemon-mayo sauce and set aside.",
      "secondary_message": "2 tbsp vegan mayonnaise\n1 tsp pure maple syrup\n½ tsp apple cider vinegar\n⅛ tsp salt\n1 pinch black pepper\n1 pinch paprika"
    },
    {
      "id": 344603,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 344604,
      "primary_message": "When the veggies are almost tender, remove from the oven and stir; add sausages, nestling them into the veggies. Return to the oven and continue to cook until veggies are tender and sausages are warmed through, 5-8 minutes more. (Or cook sausages according to package directions.) Remove from oven.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 344605,
      "primary_message": "To serve, divide quinoa, roasted veggies, and sausages between bowls. Drizzle with lemon-mayo sauce and top with green onions. Enjoy!",
      "secondary_message": null
    }
  ],
