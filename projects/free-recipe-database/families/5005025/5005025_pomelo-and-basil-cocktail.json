  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Tear the fresh basil leaves in half.",
      "secondary_message": "6 large fresh basil leaves"
    },
    {
      "id": 1,
      "primary_message": "To make basil simple syrup: Combine sugar and water in a small saucepan over medium-high heat. Stir to dissolve sugar and bring to a boil. Add basil leaves, reduce to a simmer and continue to cook for 10 minutes. Remove from heat and let cool completely. Strain before bottling.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the cocktail, fill a cocktail shaker with ice. Add pomelo juice, basil simple syrup, and gin. Shake vigorously for about 10 seconds. Strain into a chilled cocktail glass and garnish with pomelo slice.",
      "secondary_message": null
    }
