  "instructions": [
    {
      "id": 471489,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 jalapeño peppers\n3 avocados\n1 ½ limes"
    },
    {
      "id": 471490,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl. Stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup white wine vinegar\n1 ½ tsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 471491,
      "primary_message": "Thinly slice jalapeño peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the bowl with pickling liquid, stir to combine, and set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 471492,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 471493,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Peel and thinly slice garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 471494,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until onions are soft, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp oregano, dried\n1 ½ tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 471495,
      "primary_message": "Meanwhile, roughly chop olives.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 471496,
      "primary_message": "When the onions are soft, add olives, tomatoes, and capers to the pot. Stir to combine and bring the sauce to a boil over medium-high heat. Once boiling, reduce heat to a simmer and cook, stirring occasionally, until sauce is thickened, about 10 minutes.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n3 tbsp capers"
    },
    {
      "id": 471497,
      "primary_message": "While the sauce thickens, pat cod dry with paper towels and cut into 1-inch pieces. Season with salt and pepper.",
      "secondary_message": "2 ¼ lb cod fillet\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471498,
      "primary_message": "When the sauce is thickened, add fish to the pot and gently stir to combine. Cover and continue to simmer until fish is cooked through, 5-6 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 471499,
      "primary_message": "Meanwhile, using a clean cutting board, cut limes into wedges. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 471500,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the lime.",
      "secondary_message": null
    },
    {
      "id": 471501,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 471502,
      "primary_message": "Divide fish and sauce between plates. Serve with tortillas, avocado, pickled jalapeño, and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
