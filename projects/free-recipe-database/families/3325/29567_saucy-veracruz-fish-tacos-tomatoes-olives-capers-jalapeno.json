  "instructions": [
    {
      "id": 471517,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 jalapeño peppers\n2 avocados\n1 lime"
    },
    {
      "id": 471518,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl. Stir to combine the pickling liquid.",
      "secondary_message": "¼ cup white wine vinegar\n1 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 471519,
      "primary_message": "Thinly slice jalapeño peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the bowl with pickling liquid, stir to combine, and set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 471520,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 471521,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and thinly slice garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 471522,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until onions are soft, 2-3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp oregano, dried\n1 tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 471523,
      "primary_message": "Meanwhile, roughly chop olives.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 471524,
      "primary_message": "When the onions are soft, add olives, tomatoes, and capers to the skillet. Stir to combine and bring the sauce to a boil over medium-high heat. Once boiling, reduce heat to a simmer and cook, stirring occasionally, until sauce is thickened, 7-8 minutes.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n2 tbsp capers"
    },
    {
      "id": 471525,
      "primary_message": "While the sauce thickens, pat cod dry with paper towels and cut into 1-inch pieces. Season with salt and pepper.",
      "secondary_message": "0.68 kg cod fillet\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 471526,
      "primary_message": "When the sauce is thickened, add fish to the skillet and gently stir to combine. Cover and continue to simmer until fish is cooked through, 5-6 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 471527,
      "primary_message": "Meanwhile, using a clean cutting board, cut lime into wedges. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 471528,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the lime.",
      "secondary_message": null
    },
    {
      "id": 471529,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 471530,
      "primary_message": "Divide fish and sauce between plates. Serve with tortillas, avocado, pickled jalapeño, and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
