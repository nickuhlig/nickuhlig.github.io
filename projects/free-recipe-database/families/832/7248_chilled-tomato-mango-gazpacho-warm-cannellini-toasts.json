  "instructions": [
    {
      "id": 112217,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 mangoes\n1 ½ English cucumbers\n6 tomatoes\n3 yellow bell peppers\n6 limes\n1 small pkg chives"
    },
    {
      "id": 112218,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 112219,
      "primary_message": "Peel mangos and slice the flesh away from the pit, starting with the flat sides. Chop mangos into 1-inch pieces and add to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 112220,
      "primary_message": "Peel the cucumbers, then trim off the ends. Chop the cucumbers and the tomatoes into 1-inch pieces; add to bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 112221,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Chop peppers into 1-inch pieces and add to the bowl with the mango and cucumber.",
      "secondary_message": null
    },
    {
      "id": 112222,
      "primary_message": "Juice limes into a separate, large bowl, and add broth, olive oil, turmeric, salt, and pepper; whisk to combine.",
      "secondary_message": "710 ml chicken or vegetable broth\n3 tbsp extra virgin olive oil\n¾ tsp turmeric\n1 ½ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 112223,
      "primary_message": "This recipe will make about 15 cups of gazpacho; combine vegetables and liquid in batches to best fit your blender. Blend on high speed for 1-2 minutes until smooth, but not frothy. Transfer gazpacho to a container with a lid and refrigerate until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 112224,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 112225,
      "primary_message": "Toast the bread.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 112226,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the beans, salt, and pepper to the skillet and cook until heated through.",
      "secondary_message": "3 tbsp extra virgin olive oil\n⅜ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 112227,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 112228,
      "primary_message": "Mash the beans with a potato masher; then spread bean mash on toast.",
      "secondary_message": null
    },
    {
      "id": 112229,
      "primary_message": "To serve, divide chilled gazpacho between bowls; top with chives and a drizzle of olive oil. Serve with cannellini bean toasts on the side. Enjoy!",
      "secondary_message": "1 tbsp extra virgin olive oil"
    }
  ],
