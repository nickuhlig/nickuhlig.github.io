  "instructions": [
    {
      "id": 112096,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 mangoes\n1 English cucumber\n4 tomatoes\n2 yellow bell peppers\n4 limes\n1 small pkg chives"
    },
    {
      "id": 112097,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 112098,
      "primary_message": "Peel mangos and slice the flesh away from the pit, starting with the flat sides. Chop mangos into 1-inch pieces and add to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 112099,
      "primary_message": "Peel the cucumber, then trim off the ends. Chop the cucumber and the tomatoes into 1-inch pieces; add to bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 112100,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Chop peppers into 1-inch pieces and add to the bowl with the mango and cucumber.",
      "secondary_message": null
    },
    {
      "id": 112101,
      "primary_message": "Juice limes into a separate, medium bowl, and add broth, olive oil, turmeric, salt, and pepper; whisk to combine.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 tbsp extra virgin olive oil\n½ tsp turmeric\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 112102,
      "primary_message": "This recipe will make about 10 cups of gazpacho; combine vegetables and liquid in batches to best fit your blender. Blend on high speed for 1-2 minutes until smooth, but not frothy. Transfer gazpacho to a container with a lid and refrigerate until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 112103,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 112104,
      "primary_message": "Toast the bread.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 112105,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the beans, salt, and pepper to the skillet and cook until heated through.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 112106,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 112107,
      "primary_message": "Mash the beans with a potato masher; then spread bean mash on toast.",
      "secondary_message": null
    },
    {
      "id": 112108,
      "primary_message": "To serve, divide chilled gazpacho between bowls; top with chives and a drizzle of olive oil. Serve with cannellini bean toasts on the side. Enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
