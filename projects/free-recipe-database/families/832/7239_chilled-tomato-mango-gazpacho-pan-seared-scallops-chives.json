  "instructions": [
    {
      "id": 112073,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 mangoes\n1 ½ English cucumbers\n6 tomatoes\n3 yellow bell peppers\n6 limes\n1 small pkg chives"
    },
    {
      "id": 112074,
      "primary_message": "Peel mangos and slice the flesh away from the pit, starting with the flat sides. Chop mangos into 1-inch pieces and add to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 112075,
      "primary_message": "Peel the cucumbers, then trim off the ends. Chop the cucumbers and the tomatoes into 1-inch pieces; add to bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 112076,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Chop peppers into 1-inch pieces and add to the bowl with mango and cucumber.",
      "secondary_message": null
    },
    {
      "id": 112077,
      "primary_message": "Juice limes into a separate, large bowl, and add broth, olive oil, turmeric, salt, and pepper; whisk to combine.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n⅓ cup extra virgin olive oil\n¾ tsp turmeric\n1 ½ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 112078,
      "primary_message": "This recipe will make about 15 cups of gazpacho; combine vegetables and liquid in batches to best fit your blender. Blend on high speed for 1-2 minutes until smooth, but not frothy. Transfer gazpacho to a container with a lid and refrigerate until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 112079,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 112080,
      "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; rub with olive oil and season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb sea scallops\n3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 112081,
      "primary_message": "Working in batches, carefully add the scallops to the hot skillet in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 112082,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 112083,
      "primary_message": "To serve, divide chilled gazpacho and scallops between large bowls. Top with chives and a drizzle of olive oil. Enjoy!",
      "secondary_message": "1 tbsp extra virgin olive oil"
    }
  ],
