  "instructions": [
    {
      "id": 112170,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 mangoes\n1 English cucumber\n4 tomatoes\n2 yellow bell peppers\n4 limes\n1 small pkg chives"
    },
    {
      "id": 112171,
      "primary_message": "Peel mangos and slice the flesh away from the pit, starting with the flat sides. Chop mangos into 1-inch pieces and add to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 112172,
      "primary_message": "Peel the cucumber, then trim off the ends. Chop the cucumber and the tomatoes into 1-inch pieces; add to bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 112173,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Chop peppers into 1-inch pieces and add to the bowl with mango and cucumber.",
      "secondary_message": null
    },
    {
      "id": 112174,
      "primary_message": "Juice limes into a separate, medium bowl, and add broth, olive oil, turmeric, salt, and pepper; whisk to combine.",
      "secondary_message": "473 ml chicken or vegetable broth\n¼ cup extra virgin olive oil\n½ tsp turmeric\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 112175,
      "primary_message": "This recipe will make about 10 cups of gazpacho; combine vegetables and liquid in batches to best fit your blender. Blend on high speed for 1-2 minutes until smooth, but not frothy. Transfer gazpacho to a container with a lid and refrigerate until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 112176,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 112177,
      "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; rub with olive oil and season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg sea scallops\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 112178,
      "primary_message": "Working in batches, carefully add the scallops to the hot skillet in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 112179,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 112180,
      "primary_message": "To serve, divide chilled gazpacho and scallops between large bowls. Top with chives and a drizzle of olive oil. Enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
