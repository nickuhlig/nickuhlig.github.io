  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small saucepan, bring water to a boil over high heat. Add tea bags, reduce heat to medium-low, and simmer until tea is dark and aromatic, 5 to 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove from heat. Using a slotted spoon, carefully remove tea bags. Use a spoon to press down on tea bags to extract any excess tea. Whisk in evaporated milk. Season to taste with sugar and additional evaporated milk, as desired.",
      "secondary_message": null
    }
  ],
