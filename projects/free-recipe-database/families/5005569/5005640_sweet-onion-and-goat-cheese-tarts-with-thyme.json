  "ingredients": [
    {
      "ingredient_id": 115,
      "name": "butter",
      "quantity": "1 tbsp"
    },
    {
      "ingredient_id": 152,
      "name": "yellow onion, thinly sliced",
      "quantity": "1 large"
    },
    {
      "ingredient_id": 287,
      "name": "fresh thyme",
      "quantity": "2 stems"
    },
    {
      "ingredient_id": 293,
      "name": "brown sugar",
      "quantity": "1 tsp"
    },
    {
      "ingredient_id": 1021,
      "name": "frozen puff pastry, thawed, but very cold",
      "quantity": "1 sheet"
    },
    {
      "ingredient_id": 126,
      "name": "fresh chèvre cheese",
      "quantity": "57 g"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "In a sauté pan, melt the butter over medium heat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the onions and thyme, and sauté, stirring often, for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the sugar to the onions, and sauté another 10 minutes, adjusting the heat if the onions are turning brown too quickly.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Preheat the oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Lay out the puff pastry, and use a 6-cm biscuit cutter to cut out 9 puff pastry circles.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Arrange the pastry circles on a cookie sheet. Top with the onion mixture (remove the thyme stems!), then top with chèvre. Bake 20 to 25 minutes, until golden and crisp.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Garnish, if you like, with the stingiest drizzle of extra virgin olive oil, and more fresh thyme.",
      "secondary_message": null
    }
  ],
