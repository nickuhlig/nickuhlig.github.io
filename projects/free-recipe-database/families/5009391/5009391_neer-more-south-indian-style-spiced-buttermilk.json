  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Keep the buttermilk cold until you use it. Seed and mince the fresh jalapeño. Roughly chop the fresh cilantro leaves.",
      "secondary_message": "1 cup buttermilk\n½ fresh jalapeño\n½ cup fresh cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "In a blender combine buttermilk, water, lemon juice, ginger, jalapeno, cilantro, asafoetida, and a pinch of salt. Cover and blend on high speed until mixture takes on a greenish tint, about 10 seconds. Taste and adjust for salt, then set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in a medium skillet over medium high heat until shimmering. Add mustard seeds and curry leaves, coat with oil, and cook until the mustard seeds begin to crackle and pop, 1 minute or less. Immediately remove from heat and add to blender. Stir mixture together until well combined, then serve immediately.",
      "secondary_message": null
    }
  ],
