  "instructions": [
    {
      "id": 559075,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 559076,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 medium carrot\n½ English cucumber\n1 red bell pepper\n½ bunch radish\n½ small pkg fresh mint\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 559077,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.)",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 559078,
      "primary_message": "Once the water is boiling, add shrimp to the pan. Cook, stirring occasionally, until shrimp are cooked through, 2-3 minutes. Using a slotted spoon, transfer shrimp to a plate. (Reserve boiling water in pan for the next step.)",
      "secondary_message": null
    },
    {
      "id": 559079,
      "primary_message": "Add rice noodles to the pan with the boiling water, remove from heat, and soak for 10 minutes (or prepare according to package instructions). Drain in a clean colander, rinse under cold water, and set aside.",
      "secondary_message": "142 g flat rice (pad thai) noodles"
    },
    {
      "id": 559080,
      "primary_message": "Meanwhile, cut green onions crosswise into thin pieces. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 559081,
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the plate with the green onions.",
      "secondary_message": null
    },
    {
      "id": 559082,
      "primary_message": "Trim and cut cucumber into thin matchsticks. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 559083,
      "primary_message": "Trim, seed, and cut bell pepper into thin matchsticks. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 559084,
      "primary_message": "Trim and thinly slice radishes. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 559085,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 559086,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small bowl along with peanut butter, honey, soy sauce, fish sauce, and vinegar. Whisk to combine the peanut sauce.",
      "secondary_message": "1 clove garlic\n3 tbsp natural peanut butter\n1 tbsp honey\n1 tbsp soy sauce\n1 tsp fish sauce\n1 tsp rice vinegar"
    },
    {
      "id": 559087,
      "primary_message": "To serve, divide rice noodles, veggies, and shrimp between bowls. Drizzle with peanut sauce and enjoy!",
      "secondary_message": null
    }
  ],
