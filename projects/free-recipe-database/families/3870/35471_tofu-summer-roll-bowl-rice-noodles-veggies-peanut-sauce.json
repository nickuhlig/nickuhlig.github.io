  "instructions": [
    {
      "id": 558966,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 558967,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat. Once boiling, remove from heat, uncover, and add rice noodles. Soak for 10 minutes (or prepare according to package instructions). Drain in a colander and set aside.",
      "secondary_message": "10 oz flat rice (pad thai) noodles"
    },
    {
      "id": 558968,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n2 medium carrots\n1 English cucumber\n2 red bell peppers\n1 bunch radish\n1 small pkg fresh mint\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 558969,
      "primary_message": "Cut green onions crosswise into thin pieces. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 558970,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the plate with the green onions.",
      "secondary_message": null
    },
    {
      "id": 558971,
      "primary_message": "Trim and cut cucumber into thin matchsticks. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 558972,
      "primary_message": "Trim, seed, and cut bell peppers into thin matchsticks. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 558973,
      "primary_message": "Trim and thinly slice radishes. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 558974,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 558975,
      "primary_message": "Medium dice tofu. Place in a medium bowl, then sprinkle with cornstarch, salt, and pepper. Gently toss to coat.",
      "secondary_message": "4 tsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 558976,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 558977,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes. Remove from heat.",
      "secondary_message": "4 tsp neutral vegetable oil"
    },
    {
      "id": 558978,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl along with peanut butter, maple syrup, soy sauce, and vinegar. Whisk to combine the peanut sauce.",
      "secondary_message": "2 cloves garlic\n⅓ cup natural peanut butter\n4 tsp pure maple syrup\n2 tbsp soy sauce\n2 tsp rice vinegar"
    },
    {
      "id": 558979,
      "primary_message": "To serve, divide rice noodles, veggies, and tofu between bowls. Drizzle with peanut sauce and enjoy!",
      "secondary_message": null
    }
  ],
