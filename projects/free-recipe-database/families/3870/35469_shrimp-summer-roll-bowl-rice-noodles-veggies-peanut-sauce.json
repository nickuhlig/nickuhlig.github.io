  "instructions": [
    {
      "id": 558939,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 558940,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 medium carrots\n1 ½ English cucumbers\n3 red bell peppers\n1 ½ bunches radish\n1 small pkg fresh mint\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 558941,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.)",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 558942,
      "primary_message": "Once the water is boiling, add shrimp to the pot. Cook, stirring occasionally, until shrimp are cooked through, 2-3 minutes. Using a slotted spoon, transfer shrimp to a plate. (Reserve boiling water in pot for the next step.)",
      "secondary_message": null
    },
    {
      "id": 558943,
      "primary_message": "Add rice noodles to the pot with the boiling water, remove from heat, and soak for 10 minutes (or prepare according to package instructions). Drain in a clean colander, rinse under cold water, and set aside.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 558944,
      "primary_message": "Meanwhile, cut green onions crosswise into thin pieces. Place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 558945,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the plate with the green onions.",
      "secondary_message": null
    },
    {
      "id": 558946,
      "primary_message": "Trim and cut cucumbers into thin matchsticks. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 558947,
      "primary_message": "Trim, seed, and cut bell peppers into thin matchsticks. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 558948,
      "primary_message": "Trim and thinly slice radishes. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 558949,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 558950,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small bowl along with peanut butter, honey, soy sauce, fish sauce, and vinegar. Whisk to combine the peanut sauce.",
      "secondary_message": "3 cloves garlic\n½ cup natural peanut butter\n3 tbsp honey\n3 tbsp soy sauce\n1 tbsp fish sauce\n1 tbsp rice vinegar"
    },
    {
      "id": 558951,
      "primary_message": "To serve, divide rice noodles, veggies, and shrimp between bowls. Drizzle with peanut sauce and enjoy!",
      "secondary_message": null
    }
  ],
