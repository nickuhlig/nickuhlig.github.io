  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n1 Gala apple\n1 (1 inch) piece ginger root\n½ orange"
    },
    {
      "primary_message": "Peel and small dice potato. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter, core, and small dice apple. Add to the bowl with the potato.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add potato, onion, apple, and spices; cook, stirring occasionally, until starting to soften, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp pumpkin spice mix\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in the reserved bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "primary_message": "Zest orange into the bowl with the ginger and garlic (reserve orange for later use).",
      "secondary_message": null
    },
    {
      "primary_message": "When the veggies are starting to soften, add ginger, garlic, and orange zest to the pot. Continue to cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "primary_message": "Juice orange into the pot, then add broth and pumpkin. Stir to combine the soup and bring to a boil over medium-high heat. Once boiling, reduce to a simmer and cook until the potato and apple are tender, 8-10 minutes.",
      "secondary_message": "4 cups chicken or vegetable broth\n1 (15 oz) can pure pumpkin purée"
    },
    {
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add pumpkin seeds and toast, stirring often, until golden and fragrant, about 3 minutes. Remove from heat.",
      "secondary_message": "¼ cup pumpkin seeds"
    },
    {
      "primary_message": "When the soup is done, using a hand blender, purée until smooth. Add vanilla, stir to combine, and remove from heat. (If using a regular blender, work in batches as needed, then return soup to the pot.) ",
      "secondary_message": "1 ½ tsp vanilla extract"
    },
    {
      "primary_message": "To serve, divide soup between bowls, drizzle with cream, and sprinkle with toasted pumpkin seeds. Enjoy!",
      "secondary_message": "¼ cup heavy whipping cream"
    }
  ],
