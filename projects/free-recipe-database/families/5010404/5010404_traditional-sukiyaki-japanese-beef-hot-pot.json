  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring mirin, sake, soy sauce, dashi, and sugar to a simmer and stir until sugar is dissolved. Remove from heat and reserve.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Arrange beef and tofu on separate platters (or dinner plates) cover with plastic wrap and refrigerate. Arrange mushrooms, onion, scallions, and bok choy on a serving platter and set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Rinse rice in a fine-mesh strainer until water runs clear. Place in a small pot and cover with 2 cups water, bring to a simmer then turn heat to low and cover with a tight fitting lid. Steam until all the water is absorbed, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Set up butane burner or electric hot plate, and carefully ignite. Place a thick bottomed, low sided pan over burner and pour in sauce mixture. Bring to a simmer.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Divide rice among 4 small bowls. Place platters of ingredients around burner and cook as you eat by transferring to simmering broth and cooking to the desired doneness. If desired, break egg into a separate bowl, beat, and use to dip steaming hot ingredients into.",
      "secondary_message": null
    }
  ],
