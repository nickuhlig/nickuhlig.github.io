  "instructions": [
    {
      "id": 209986,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n5 oz linguine pasta"
    },
    {
      "id": 209987,
      "primary_message": "Meanwhile, place cashews in a small bowl. Using a measuring cup, carefully remove 1 cup of boiling water from the pot and pour over the cashews; let sit for 15 minutes.",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 209988,
      "primary_message": "Peel and slice garlic; transfer to a blender.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 209989,
      "primary_message": "Once cashews are done soaking, drain and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 209990,
      "primary_message": "Add pumpkin, broth, nutritional yeast, flour, and spices to the blender and purée until smooth.",
      "secondary_message": "½ (15 oz) can pure pumpkin purée\n6 fl oz (¾ cup) chicken or vegetable broth\n⅛ cup nutritional yeast flakes\n2 tsp all-purpose flour\n½ tsp salt\n⅛ tsp black pepper\n1 pinch nutmeg, ground"
    },
    {
      "id": 209991,
      "primary_message": "Wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 209992,
      "primary_message": "Drain pasta and set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 209993,
      "primary_message": "Return saucepan to medium heat. Add the sauce from the blender and bring to a simmer.",
      "secondary_message": null
    },
    {
      "id": 209994,
      "primary_message": "Once simmering, add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 209995,
      "primary_message": "Add pasta, stir to combine, and cook, stirring occasionally, until warmed through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 209996,
      "primary_message": "Divide pasta between bowls and enjoy!",
      "secondary_message": null
    }
  ],
