  "instructions": [
    {
      "id": 1,
      "primary_message": "If using sugar, place the sugar cube in the bottom of the glass and add the 2 dashes of bitters. Muddle well to blend the sugar and bitters, then add a few drops of water and stir to dissolve the sugar.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "If using simple syrup, add the syrup and bitters to the glass.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place a large chunk of ice into the glass filled with sugar and bitters and add the apple brandy. Stir well to incorporate the sugar and brandy.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Twist the lemon peel over the top, drop it into the glass and serve.",
      "secondary_message": null
    }
  ],
