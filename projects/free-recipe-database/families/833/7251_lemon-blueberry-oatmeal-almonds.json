  "instructions": [
    {
      "id": 131770,
      "primary_message": "Wash and dry the lemon. Grate the zest into a small bowl and set aside. Then, juice the lemon into a large pot.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 131771,
      "primary_message": "Add salt and water to the pot with the lemon juice, cover, and bring to a boil over high heat. Once boiling, stir in oats and maple syrup. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency. ",
      "secondary_message": "3 pinch salt\n5 ¼ cup water\n3 cup oats, quick cooking\n2 tbsp pure maple syrup"
    },
    {
      "id": 131772,
      "primary_message": "Wash and dry blueberries.",
      "secondary_message": "3 (6 oz) pkgs blueberries"
    },
    {
      "id": 131773,
      "primary_message": "To serve, divide oats between bowls and top with almonds, blueberries, maple syrup, and lemon zest. Serve with almond milk and enjoy!",
      "secondary_message": "1 ½ cups almonds, sliced\n2 tbsp pure maple syrup\n12 fl oz (1 ½ cups) almond milk, unsweetened"
    }
