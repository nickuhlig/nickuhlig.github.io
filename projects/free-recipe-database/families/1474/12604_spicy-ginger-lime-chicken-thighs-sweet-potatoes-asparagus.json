  "instructions": [
    {
      "id": 214936,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 214937,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg sweet potato\n1 small bunch asparagus\n½ lime\n1 (2 ½ cm) piece ginger root\n½ small bunch cilantro"
    },
    {
      "id": 214938,
      "primary_message": "Peel and medium dice sweet potatoes; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 214939,
      "primary_message": "Snap or cut off the woody ends of the asparagus; add to the baking sheet with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 214940,
      "primary_message": "Drizzle oil over veggies and season with salt and pepper; toss to combine, then spread out in an even layer. Place in the oven and bake until vegetables are fork-tender, 15-20 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 214941,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 214942,
      "primary_message": "Pat chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 214943,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 214944,
      "primary_message": "Add chicken to the skillet; cook until golden brown, about 2 minutes per side. Once golden, transfer to a clean plate and loosely cover with aluminum foil (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 214945,
      "primary_message": "Meanwhile, peel and mince ginger.",
      "secondary_message": null
    },
    {
      "id": 214946,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 214947,
      "primary_message": "Return skillet to medium heat. Juice lime into the skillet. Add ginger, half of the cilantro (reserving the rest for garnish), oil, chili-garlic sauce, honey, and coriander. Stir to combine the sauce.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n2 tsp chili-garlic sauce\n2 tsp honey\n⅛ tsp coriander"
    },
    {
      "id": 214948,
      "primary_message": "Return chicken to the skillet, along with any accumulated juices. Cover and simmer until chicken is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 214949,
      "primary_message": "To serve, divide chicken and vegetables between plates. Sprinkle with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
