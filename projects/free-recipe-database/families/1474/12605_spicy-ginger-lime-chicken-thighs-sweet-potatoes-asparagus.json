  "instructions": [
    {
      "id": 214950,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 214951,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.91 kg sweet potato\n2 small bunches asparagus\n1 lime\n2 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 214952,
      "primary_message": "Peel and medium dice sweet potatoes; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 214953,
      "primary_message": "Snap or cut off the woody ends of the asparagus; add to the baking sheet with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 214954,
      "primary_message": "Drizzle oil over veggies and season with salt and pepper; toss to combine, then spread out in an even layer. Place in the oven and bake until vegetables are fork-tender, about 20 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 214955,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 214956,
      "primary_message": "Pat chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 214957,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 214958,
      "primary_message": "Working in batches if necessary, add chicken to the skillet; cook until golden brown, about 2 minutes per side. Once golden, transfer to a clean plate and loosely cover with aluminum foil (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 214959,
      "primary_message": "Meanwhile, peel and mince ginger.",
      "secondary_message": null
    },
    {
      "id": 214960,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 214961,
      "primary_message": "Return skillet to medium heat. Juice lime into the skillet. Add ginger, half of the cilantro (reserving the rest for garnish), oil, chili-garlic sauce, honey, and coriander. Stir to combine the sauce.",
      "secondary_message": "3 tbsp extra virgin olive oil\n4 tsp chili-garlic sauce\n4 tsp honey\n¼ tsp coriander"
    },
    {
      "id": 214962,
      "primary_message": "Return chicken to the skillet, along with any accumulated juices. Cover and simmer until chicken is cooked through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 214963,
      "primary_message": "To serve, divide chicken and vegetables between plates. Sprinkle with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
