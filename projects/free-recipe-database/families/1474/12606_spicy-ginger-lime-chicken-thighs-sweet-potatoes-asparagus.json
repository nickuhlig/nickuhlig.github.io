  "instructions": [
    {
      "id": 214964,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 214965,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.36 kg sweet potatoes\n3 small bunches asparagus\n1 ½ limes\n3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 214966,
      "primary_message": "Peel and medium dice sweet potatoes; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 214967,
      "primary_message": "Snap or cut off the woody ends of the asparagus; transfer to a second baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 214968,
      "primary_message": "Drizzle oil over veggies and season with salt and pepper; toss to combine, then spread out in an even layer. Place baking sheets in the oven and bake until vegetables are fork-tender, 20-25 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 214969,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 214970,
      "primary_message": "Pat chicken thighs dry with paper towels and place on a large plate; season with salt and pepper on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 214971,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 214972,
      "primary_message": "Working in batches if necessary, add chicken to the skillet; cook until golden brown, about 2 minutes per side. Once golden, transfer to a clean plate and loosely cover with aluminum foil (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 214973,
      "primary_message": "Meanwhile, peel and mince ginger.",
      "secondary_message": null
    },
    {
      "id": 214974,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 214975,
      "primary_message": "Return skillet to medium heat. Juice limes into the skillet. Add ginger, half of the cilantro (reserving the rest for garnish), oil, chili-garlic sauce, honey, and coriander. Stir to combine the sauce.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp chili-garlic sauce\n2 tbsp honey\n½ tsp coriander"
    },
    {
      "id": 214976,
      "primary_message": "Return the chicken to the skillet, slightly overlapping the thighs if necessary, along with any accumulated juices. Cover and simmer until chicken is cooked through, 12-14 minutes.",
      "secondary_message": null
    },
    {
      "id": 214977,
      "primary_message": "To serve, divide chicken and vegetables between plates. Sprinkle with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
