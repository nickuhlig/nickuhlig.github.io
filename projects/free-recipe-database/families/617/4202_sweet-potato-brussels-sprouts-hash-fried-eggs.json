  "instructions": [
    {
      "id": 47442,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potatoes\n0.68 kg brussels sprouts"
    },
    {
      "id": 47443,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 47444,
      "primary_message": "Peel and large dice the sweet potatoes into 2-cm cubes; transfer to a bowl.",
      "secondary_message": null
    },
    {
      "id": 47445,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 47446,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion into 6-mm pieces.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 47447,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 47448,
      "primary_message": "Add the sweet potatoes and onion to the skillet; cook, stirring occasionally, until the potatoes are tender, 6 to 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 47449,
      "primary_message": "While the potatoes and onions cook, trim off and discard the stems ends of the Brussels sprouts, then remove the outer layer of leaves; quarter the sprouts lengthwise.",
      "secondary_message": null
    },
    {
      "id": 47450,
      "primary_message": "Add the garlic and Brussels sprouts to the skillet; cook, stirring frequently, until tender, 3 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 47451,
      "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 47452,
      "primary_message": "Gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 3 to 4 minutes. Once done, separate the eggs. Cook in batches if necessary.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 47453,
      "primary_message": "Season the hash with salt and pepper; stir to combine and remove from the heat.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 47454,
      "primary_message": "To serve, divide the hash between plates, top with the fried eggs, and season with additional salt and pepper if desired. Enjoy!",
      "secondary_message": null
    }
  ],
