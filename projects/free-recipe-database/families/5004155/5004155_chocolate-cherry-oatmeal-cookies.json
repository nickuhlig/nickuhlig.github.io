  "instructions": [
    {
      "id": 1,
      "primary_message": "Place cherries in a bowl and cover with boiling water. Let stand 8 minutes and drain. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour, baking soda, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat together butter, sugar, and brown sugar until light and fluffy, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Beat in vanilla. Beat in eggs until well combined.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add flour mixture to bowl and beat until just combined. Use a spoon to stir oats into dough.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Add chocolate and cherries and stir until evenly incorporated. Cover dough with plastic wrap and let sit in refrigerator for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Preheat oven to 350°F. Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Form dough into 2 inch balls and place on prepared baking sheets. Bake cookies until golden, about 10 minutes.",
      "secondary_message": null
    }
  ],
