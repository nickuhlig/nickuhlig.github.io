  "instructions": [
    {
      "id": 356918,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "3 medium carrots\n3 green bell peppers\n3 (1 inch) pieces ginger root\n6 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 356919,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further. ",
      "secondary_message": "3 (15 oz) cans kidney beans"
    },
    {
      "id": 356920,
      "primary_message": "Peel, halve, and small dice onions. Peel, trim, and small dice carrots. Place both in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 356921,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 356922,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 356923,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp virgin coconut oil\n¾ tsp salt"
    },
    {
      "id": 356924,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Small dice tomatoes. Add both to the reserved bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 356925,
      "primary_message": "Once the veggies are soft, add ginger, garlic, tomato, and spices to the pot. Cook, stirring frequently, until fragrant, 1-2 minutes. ",
      "secondary_message": "1 ½ tbsp garam masala\n1 ½ tsp chili powder\n1 ½ tsp salt\n¾ tsp turmeric, ground"
    },
    {
      "id": 356926,
      "primary_message": "Add beans, coconut milk, and water to the pot; bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until beans are tender and curry has thickened, about 10 minutes. ",
      "secondary_message": "1 ½ (13.5 fl oz) cans coconut milk\n⅓ cup water"
    },
    {
      "id": 356927,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 356928,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 356929,
      "primary_message": "Arrange naan on a large baking sheet pan and place in the oven; broil, flipping once, until golden brown and toasted, 1-2 minutes. ",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 356930,
      "primary_message": "Remove naan from the oven, spread with oil, and sprinkle with half of the cilantro; cut into wedges. (Reserve remaining cilantro for the curry.)",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 356931,
      "primary_message": "When the curry is done, remove from heat. Add reserved cilantro and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 356932,
      "primary_message": "Divide curry between bowls and serve with naan on the side. Enjoy!",
      "secondary_message": null
    }
  ],
