  "instructions": [
    {
      "id": 450134,
      "primary_message": "Place oil and spices in a medium bowl; stir to combine the spice paste.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 450135,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450136,
      "primary_message": "While the pan heats up, add cod to the bowl with the spice paste and turn to coat.",
      "secondary_message": "⅓ kg cod fillet"
    },
    {
      "id": 450137,
      "primary_message": "Once the pan is hot, coat with oil. Add cod and grill until the flesh is opaque and flakey, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 450138,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ small bunch cilantro\n2 tomatoes\n½ head butter (Boston) lettuce"
    },
    {
      "id": 450139,
      "primary_message": "Zest and juice lime into a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 450140,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 450141,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 450142,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 450143,
      "primary_message": "Add oil, chili-garlic sauce, salt, and pepper to the bowl. Stir to combine the salsa and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp chili-garlic sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 450144,
      "primary_message": "Separate lettuce leaves, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 450145,
      "primary_message": "Use a fork to break the cod into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 450146,
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 450147,
      "primary_message": "To serve, divide tortillas between plates; fill with grilled cod, salsa, and lettuce. Enjoy!",
      "secondary_message": null
    }
  ],
