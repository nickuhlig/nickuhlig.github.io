  "instructions": [
    {
      "id": 450055,
      "primary_message": "Place oil and spices in a large bowl; stir to combine the spice paste.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 450056,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450057,
      "primary_message": "While the pan heats up, add cod to the bowl with the spice paste and turn to coat.",
      "secondary_message": "2 ¼ lb cod fillet"
    },
    {
      "id": 450058,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add cod and grill until the flesh is opaque and flakey, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 450059,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 small bunch cilantro\n6 tomatoes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 450060,
      "primary_message": "Zest and juice limes into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 450061,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 450062,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 450063,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 450064,
      "primary_message": "Add oil, chili-garlic sauce, salt, and pepper to the bowl. Stir to combine the salsa and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp chili-garlic sauce\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 450065,
      "primary_message": "Separate lettuce leaves, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 450066,
      "primary_message": "Use a fork to break the cod into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 450067,
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 450068,
      "primary_message": "To serve, divide tortillas between plates; fill with grilled cod, salsa, and lettuce. Enjoy!",
      "secondary_message": null
    }
  ],
