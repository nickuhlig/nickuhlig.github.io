  "instructions": [
    {
      "id": 450202,
      "primary_message": "Place oil and spices in a medium bowl; stir to combine the spice paste.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 450203,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450204,
      "primary_message": "While the pan heats up, slice tempeh crosswise into thin strips. Add to the bowl with the spice paste and turn to coat.",
      "secondary_message": "3 (227g ) pkgs tempeh"
    },
    {
      "id": 450205,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add the tempeh and grill until browned and crispy, 3-4 minutes per side. Remove to a plate. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 450206,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 small bunch cilantro\n6 tomatoes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 450207,
      "primary_message": "Zest and juice limes into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 450208,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 450209,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 450210,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 450211,
      "primary_message": "Add oil, chili-garlic sauce, salt, and pepper to the bowl. Stir to combine the salsa and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp chili-garlic sauce\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 450212,
      "primary_message": "Separate lettuce leaves, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 450213,
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 450214,
      "primary_message": "To serve, divide tortillas between plates; fill with tempeh, salsa, and lettuce. Enjoy!",
      "secondary_message": null
    }
  ],
