  "instructions": [
    {
      "id": 598256,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 598257,
      "primary_message": "Drizzle both sides of the tortillas with oil and sprinkle with salt; arrange on a baking sheet pan. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until tortillas are golden brown and crispy, 10-15 minutes. Remove from oven.",
      "secondary_message": "2 small corn tortillas\n1 tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 598258,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 avocado\n1 tomato\n¼ small bunch cilantro"
    },
    {
      "id": 598259,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and place in a small bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": null
    },
    {
      "id": 598260,
      "primary_message": "Small dice tomato. Add to the bowl with the avocado.",
      "secondary_message": null
    },
    {
      "id": 598261,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl (reserving a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 598262,
      "primary_message": "Peel and mince shallot. Add to the bowl, along with mayo and spices, then stir to combine the avocado spread. Set aside.",
      "secondary_message": "½ shallot\n2 tsp mayonnaise\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 598263,
      "primary_message": "Cut or tear smoked salmon into bite-sized pieces. ",
      "secondary_message": "½ (4 oz) pkg smoked salmon"
    },
    {
      "id": 598264,
      "primary_message": "To serve, divide crispy tortillas between plates, then top with avocado spread and smoked salmon. Sprinkle tostadas with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
