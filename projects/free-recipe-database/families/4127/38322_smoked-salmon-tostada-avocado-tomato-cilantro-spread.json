  "instructions": [
    {
      "id": 598301,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 598302,
      "primary_message": "Drizzle both sides of the tortillas with oil and sprinkle with salt; arrange on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until tortillas are golden brown and crispy, 10-15 minutes. Remove from oven.",
      "secondary_message": "6 small corn tortillas\n1 tbsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 598303,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 avocados\n3 tomatoes\n½ small bunch cilantro"
    },
    {
      "id": 598304,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and place in a medium bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": null
    },
    {
      "id": 598305,
      "primary_message": "Small dice tomatoes. Add to the bowl with the avocado.",
      "secondary_message": null
    },
    {
      "id": 598306,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl (reserving a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 598307,
      "primary_message": "Peel and mince shallots. Add to the bowl, along with mayo and spices, then stir to combine the avocado spread. Set aside.",
      "secondary_message": "2 shallots\n2 tbsp mayonnaise\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 598308,
      "primary_message": "Cut or tear smoked salmon into bite-sized pieces. ",
      "secondary_message": "1 ½ (113 g) pkgs smoked salmon"
    },
    {
      "id": 598309,
      "primary_message": "To serve, divide crispy tortillas between plates, then top with avocado spread and smoked salmon. Sprinkle tostadas with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
