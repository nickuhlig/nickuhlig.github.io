  "instructions": [
    {
      "id": 261447,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches green onions (scallions)\n3 limes\n1 ½ medium heads napa cabbage\n6 medium carrots"
    },
    {
      "id": 261448,
      "primary_message": "Pat the steak dry with paper towels and slice into thin strips; place in a medium bowl.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 261449,
      "primary_message": "Using a clean cutting board, peel and mince garlic; add to the bowl with the steak, toss to combine, and set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 261450,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 261451,
      "primary_message": "While the skillet heats up, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 261452,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the green onion (reserving a handful for garnish) and cook, stirring constantly, until browned, 1-2 minutes. Transfer to a large bowl.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 261453,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add steak strips and garlic; cook, stirring frequently, until the beef is just cooked through, 4-5 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 261454,
      "primary_message": "Juice limes into the skillet with the beef. Add soy sauce, sugar, and pepper; stir to combine, then transfer beef and sauce to the bowl with the green onion.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp brown sugar\n1 ½ tsp black pepper"
    },
    {
      "id": 261455,
      "primary_message": "Trim off and discard root end of each cabbage; halve the cabbages lengthwise, then thinly slice crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 261456,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 261457,
      "primary_message": "To serve, divide beef and cabbage salad between plates or bowls; top with reserved green onion and enjoy!",
      "secondary_message": null
    }
  ],
