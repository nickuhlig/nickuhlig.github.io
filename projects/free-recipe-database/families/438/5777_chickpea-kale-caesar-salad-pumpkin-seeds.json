  "instructions": [
    {
      "id": 69119,
      "primary_message": "Wash and dry the kale leaves and lemons.",
      "secondary_message": "3 bunches kale\n1 ½ lemon"
    },
    {
      "id": 69125,
      "primary_message": "One kale leaf at a time, cut along the sides of the tough center ribs, then pull out and discard the ribs. When all the leaves are trimmed, chop them crosswise into 1-inch pieces and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 69118,
      "primary_message": "Finely grate ¾ cup of Parmesan.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 69117,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 69124,
      "primary_message": "Cut the lemons in half; juice half of them into a small bowl (that is big enough for making the dressing) and cut the other half into wedges for serving.",
      "secondary_message": ""
    },
    {
      "id": 69116,
      "primary_message": "Add ½ of the grated Parmesan (save the rest for garnishing), minced garlic, yogurt, Dijon, soy sauce, salt, and pepper to the bowl with the lemon juice; whisk together until smooth.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 ½ tsp Dijon mustard\n3 tsp soy sauce\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 69123,
      "primary_message": "Pour the dressing over the kale and toss to combine. If the kale is tough, massage it with your hands to soften it.",
      "secondary_message": ""
    },
    {
      "id": 69122,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 69109,
      "primary_message": "While the skillet heats up, cut the buns or rolls into ¾-inch cubes.",
      "secondary_message": "3 whole grain buns or rolls"
    },
    {
      "id": 69112,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 69115,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 69114,
      "primary_message": "Add the bread cubes to the skillet; sprinkle with salt and toss to coat in the oil, then arrange in a single layer. Toast the bread, tossing occasionally, until the bread cubes are golden brown, 4 to 5 minutes. Once done, transfer the croutons to a bowl and return the skillet to the stove.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 69113,
      "primary_message": "While the bread cubes cook, drain and rinse the chickpeas, then transfer them to a clean towel (or paper towels) and pat dry.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 69121,
      "primary_message": "Once the croutons have been transferred, wipe out the skillet with a paper towel and heat over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 69111,
      "primary_message": "Add the chickpeas to the skillet; season with salt and pepper and toss to coat in the oil. Cook, stirring occasionally, until the chickpeas are golden brown and crispy, 5 to 7 minutes. Once done, remove the skillet from the heat.",
      "secondary_message": "1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 69110,
      "primary_message": "Measure out the pumpkin seeds and place in a small bowl.",
      "secondary_message": "¾ cup pumpkin seeds"
    },
    {
      "id": 69120,
      "primary_message": "To serve, arrange a bed of the kale on a plate and top with the croutons, chickpeas, pumpkin seeds, and remaining Parmesan. Garnish with lemon wedges for squeezing over the top.",
      "secondary_message": ""
    }
  ],
