  "instructions": [
    {
      "id": 157502,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 head romaine lettuce\n1 Gala apple"
    },
    {
      "id": 157503,
      "primary_message": "Zest the lemon into a large salad bowl. Juice half of the lemon into the same bowl. Cut remaining lemon into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 157504,
      "primary_message": "Add water, tahini, Dijon, oil, salt, and pepper to the bowl with lemon juice and zest; whisk until the dressing becomes smooth and glossy.",
      "secondary_message": "2 tbsp water\n2 tbsp tahini\n2 tsp Dijon mustard\n2 tsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 157505,
      "primary_message": "Peel and finely mince garlic. Finely mince anchovy fillet; transfer both to the salad bowl.",
      "secondary_message": "1 clove garlic\n1 anchovy fillet, packed in oil"
    },
    {
      "id": 157506,
      "primary_message": "Finely grate half of the Parmesan and add to the salad bowl (set the rest aside for garnish). Stir to combine and set aside.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 157507,
      "primary_message": "Pat the salmon fillets dry with paper towels and place on a plate; season with salt and pepper.",
      "secondary_message": "¾ lb salmon fillet\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 157508,
      "primary_message": "Combine the egg and cornstarch into a medium bowl; beat with a whisk or fork until smooth and frothy.",
      "secondary_message": "1 egg\n1 tbsp cornstarch"
    },
    {
      "id": 157509,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 157510,
      "primary_message": "While the skillet is heating, dip the skinless side of the salmon into the egg mixture and place back on the plate, skin-side down. Sprinkle sesame seeds over the surface of the fish, pressing down gently with your fingers to adhere.",
      "secondary_message": "2 tbsp sesame seeds"
    },
    {
      "id": 157511,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 157512,
      "primary_message": "Add salmon to the skillet, sesame-seed side down, and cook until crust is firm and seeds are golden brown, about 3 minutes. Flip and cook until salmon is cooked through and skin is crispy, 5-7 minutes longer. Remove skillet from the heat.",
      "secondary_message": null
    },
    {
      "id": 157513,
      "primary_message": "Meanwhile, chop or tear the romaine into bite-sized pieces and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 157514,
      "primary_message": "Wash, core, and thinly slice the apple; add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 157515,
      "primary_message": "To serve, divide salad and salmon between bowls or plates. Grate reserved Parmesan over top and garnish with lemon wedges. Enjoy! ",
      "secondary_message": null
    }
  ],
