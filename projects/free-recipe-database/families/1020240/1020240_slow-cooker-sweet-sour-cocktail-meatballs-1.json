  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Place pork, beef, egg, bread crumbs, and spices in a medium bowl. Use your hands to combine the meatball mixture. Using a tablespoon measure, form the mixture into rounded meatballs and arrange in a single layer on a large baking sheet pan.",
      "secondary_message": "½ lb ground pork sausage\n½ lb lean ground beef\n1 egg\n¼ cup panko bread crumbs\n¾ tsp onion powder\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until browned and firm, 12-15 minutes (the meatballs will not be cooked all the way through). Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place apricot preserves, hot sauce, Worcestershire, and Dijon in a small bowl. Stir to combine the sauce.",
      "secondary_message": "¾ cup apricot preserves\n2 tsp hot sauce\n1 tsp Worcestershire sauce\n1 tsp Dijon mustard"
    },
    {
      "primary_message": "When the meatballs are partially cooked through, carefully transfer them to a 4-quart slow cooker insert, leaving behind any of the rendered fat.",
      "secondary_message": null
    },
    {
      "primary_message": "Drizzle meatballs with sauce, cover, and cook until meatballs are cooked through, 3-4 hours on low or about 2 hours on high.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer meatballs and sauce to a serving dish, then sprinkle with crushed red pepper. Serve with toothpicks and enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
