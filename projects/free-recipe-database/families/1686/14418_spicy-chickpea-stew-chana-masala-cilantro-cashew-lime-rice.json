  "instructions": [
    {
      "id": 239273,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 239274,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ jalapeño pepper\n½ small bunch cilantro\n1 lime\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 239275,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 239276,
      "primary_message": "While the rice is cooking, peel and mince garlic and ginger; place in a small bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 239277,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the garlic and ginger; set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 239278,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 239279,
      "primary_message": "While the pan heats up, peel and small dice onion. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 239280,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 239281,
      "primary_message": "Meanwhile, drain and rinse chickpeas in a colander. Set aside to drain further. ",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 239282,
      "primary_message": "Add garlic, ginger, jalapeño, and spices to the pan. Cook, stirring constantly, until fragrant, about 1 minute. (Reserve bowl for later use.)",
      "secondary_message": "1 tsp cumin, ground\n1 tsp coriander, ground\n1 tsp curry powder\n½ tsp salt\n¼ tsp black pepper\n1 pinch turmeric, ground\n1 pinch chili powder"
    },
    {
      "id": 239283,
      "primary_message": "Add chickpeas, broth, and diced tomatoes to the pan; stir to combine and bring to a boil over medium-high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until chickpeas are soft and stew has thickened, about 15 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes"
    },
    {
      "id": 239284,
      "primary_message": "Meanwhile, roughly chop cashews. Shave cilantro leaves off the stems; discard stems and mince the leaves. Place both in the reserved bowl.",
      "secondary_message": "⅛ cup cashews, roasted unsalted"
    },
    {
      "id": 239285,
      "primary_message": "Juice half the lime into the bowl with the cilantro and cashews. Cut remaining lime into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 239286,
      "primary_message": "When the rice is done, add the cashew-cilantro mixture to the pan and stir to combine; cover and set aside.",
      "secondary_message": null
    },
    {
      "id": 239287,
      "primary_message": "When the stew is done, add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 239288,
      "primary_message": "Divide rice and chickpea stew between bowls; serve with lime wedges on the side and enjoy!",
      "secondary_message": null
    }
  ],
