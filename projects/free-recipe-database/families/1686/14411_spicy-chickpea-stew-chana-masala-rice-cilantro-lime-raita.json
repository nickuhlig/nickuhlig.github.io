  "instructions": [
    {
      "id": 239165,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 239166,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ jalapeño peppers\n3 limes\n1 small bunch cilantro\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 239167,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 239168,
      "primary_message": "While the rice is cooking, peel and mince garlic and ginger; place in a medium bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 239169,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the garlic and ginger; set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 239170,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 239171,
      "primary_message": "While the pot heats up, peel and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 239172,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 239173,
      "primary_message": "Meanwhile, drain and rinse chickpeas in a colander. Set aside to drain further. ",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 239174,
      "primary_message": "Add garlic, ginger, jalapeño, and spices to the pot with the onion. Continue to cook, stirring constantly, until fragrant, 1-2 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp cumin, ground\n1 tbsp coriander, ground\n1 tbsp curry powder\n1 ½ tsp salt\n¾ tsp black pepper\n3 pinch turmeric, ground\n3 pinch chili powder"
    },
    {
      "id": 239175,
      "primary_message": "Add chickpeas, broth, and diced tomatoes to the pot; stir to combine and bring to a boil over medium-high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until chickpeas are soft and stew has thickened, about 20 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 239176,
      "primary_message": "While the stew cooks, juice half the limes into the reserved bowl. Cut remaining limes into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 239177,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice along with yogurt, salt, and pepper; whisk to combine the raita. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 239178,
      "primary_message": "When the stew is done, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 239179,
      "primary_message": "Divide rice and chickpea stew between bowls; serve with lime wedges and raita on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
