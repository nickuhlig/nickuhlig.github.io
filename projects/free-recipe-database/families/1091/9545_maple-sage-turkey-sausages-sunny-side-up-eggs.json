  "instructions": [
    {
      "id": 331529,
      "primary_message": "Place turkey, maple syrup, and spices in a medium bowl and mix with your hands until well combined. ",
      "secondary_message": "0.23 kg ground turkey\n2 tsp pure maple syrup\n½ tsp sage, dried\n¼ tsp thyme, dried\n¼ tsp paprika\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp garlic powder"
    },
    {
      "id": 331530,
      "primary_message": "Using a ¼ cup measure, portion and form the meat mixture into thin patties. ",
      "secondary_message": null
    },
    {
      "id": 331531,
      "primary_message": "Preheat a skillet over medium heat. Once the skillet is hot add oil and swirl to coat. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 331532,
      "primary_message": "Place patties in the skillet and cook until nicely browned and cooked through, 3-4 minutes per side. Once done, transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 331533,
      "primary_message": "Return skillet to medium heat and add more oil. Gently crack eggs into the skillet and cook until whites are set but yolks are still runny, about 3 minutes. Season with salt and pepper. ",
      "secondary_message": "1 tsp extra virgin olive oil\n4 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 331534,
      "primary_message": "Meanwhile, toast bread if desired.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 331535,
      "primary_message": "To serve, divide toast, eggs, and breakfast sausage patties between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
