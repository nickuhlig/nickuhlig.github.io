  "instructions": [
    {
      "id": 331543,
      "primary_message": "Place turkey, maple syrup, and spices in a medium bowl and mix with your hands until well combined. ",
      "secondary_message": "0.68 kg ground turkey\n2 tbsp pure maple syrup\n1 ½ tsp sage, dried\n¾ tsp thyme, dried\n¾ tsp paprika\n¾ tsp salt\n¾ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 331544,
      "primary_message": "Using a ¼ cup measure, portion and form the meat mixture into thin patties. ",
      "secondary_message": null
    },
    {
      "id": 331545,
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot add oil and swirl to coat. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 331546,
      "primary_message": "Working in batches if necessary, place patties in the skillet and cook until nicely browned and cooked through, 3-4 minutes per side. Once done, transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 331547,
      "primary_message": "Return skillet to medium heat and add more oil. Working in batches if necessary, gently crack eggs into the skillet and cook until whites are set but yolks are still runny, about 3 minutes. Season with salt and pepper. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n12 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 331548,
      "primary_message": "Meanwhile, toast bread if desired.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 331549,
      "primary_message": "To serve, divide toast, eggs, and breakfast sausage patties between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
