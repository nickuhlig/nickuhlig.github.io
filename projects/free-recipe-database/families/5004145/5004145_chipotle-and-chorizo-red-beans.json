  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat a large Dutch oven on high with oil. When it smokes, add chorizo, crumbling with wooden spoon. Stir frequently until fat renders out and chorizo is crisp and well browned. Remove with a slotted spoon to a plate.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add onion and poblanos, stirring to coat with fat. Stir occassionally until onions turn translucent and poblanos turn slightly charred around edges. Add garlic, cumin, and chipotle, and cook for one more minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When spices are aromatic, return chorizo to pot and add tomatoes and beans (with their cooking liquid if using dried). Add water to not quite cover beans, then bring to a boil. Reduce to a simmer and cook 20 to 30 minutes or until flavors are well melded.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add vinegar and salt to taste, Serve with finely chopped red onion, cilantro, and sour cream at the table.",
      "secondary_message": null
    }
  ],
