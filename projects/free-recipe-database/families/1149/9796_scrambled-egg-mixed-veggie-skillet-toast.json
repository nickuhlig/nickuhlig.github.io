  "instructions": [
    {
      "id": 156366,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "¾ lb cremini mushrooms\n1 ½ red bell peppers\n2 medium carrots\n1 ½ small bunches green onions (scallions)\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 156367,
      "primary_message": "Thinly slice mushrooms. Seed and thinly slice bell peppers; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 156368,
      "primary_message": "Peel and grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 156369,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 156370,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 156371,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 156372,
      "primary_message": "Add veggies and cook, stirring occasionally, until they start to soften, 5-6 minutes. Add spinach in handfuls and continue to cook until spinach is wilted. Transfer veggies to a plate and cover with foil. ",
      "secondary_message": null
    },
    {
      "id": 156373,
      "primary_message": "Meanwhile, in a large bowl, whisk together the eggs, salt, and pepper.",
      "secondary_message": "12 eggs\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 156374,
      "primary_message": "Return skillet to the heat, add butter, and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 156375,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 156376,
      "primary_message": "Toast bread if desired and spread with butter.",
      "secondary_message": "2 tbsp butter, unsalted\n6 slices whole grain bread"
    },
    {
      "id": 156377,
      "primary_message": "To serve, divide toast, scrambled eggs, and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
