  "instructions": [
    {
      "id": 156355,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lb cremini mushrooms\n1 red bell pepper\n1 medium carrot\n1 small bunch green onions (scallions)\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 156356,
      "primary_message": "Thinly slice mushrooms. Seed and thinly slice bell pepper; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 156357,
      "primary_message": "Peel and grate carrot; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 156358,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 156359,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 156360,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 156361,
      "primary_message": "Add veggies and cook, stirring occasionally, until they start to soften, 4-5 minutes. Add spinach in handfuls and continue to cook until spinach is wilted.",
      "secondary_message": null
    },
    {
      "id": 156362,
      "primary_message": "Meanwhile, in a medium bowl, whisk together the eggs, salt, and pepper.",
      "secondary_message": "8 eggs\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 156363,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 156364,
      "primary_message": "Toast bread if desired and spread with butter.",
      "secondary_message": "4 tsp butter, unsalted\n4 slices whole grain bread"
    },
    {
      "id": 156365,
      "primary_message": "To serve, divide toast and veggie-scrambled eggs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
