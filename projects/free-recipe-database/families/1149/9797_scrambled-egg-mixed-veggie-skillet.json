  "instructions": [
    {
      "id": 156378,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "¼ lb cremini mushrooms\n½ red bell pepper\n1 medium carrot\n½ small bunch green onions (scallions)\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 156379,
      "primary_message": "Thinly slice mushrooms. Seed and thinly slice bell pepper; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 156380,
      "primary_message": "Peel and grate carrot; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 156381,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 156382,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 156383,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 156384,
      "primary_message": "Add veggies and cook, stirring occasionally, until they start to soften, about 3 minutes. Add spinach in handfuls and continue to cook until spinach is wilted.",
      "secondary_message": null
    },
    {
      "id": 156385,
      "primary_message": "Meanwhile, in a medium bowl, whisk together the eggs, salt, and pepper.",
      "secondary_message": "4 eggs\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 156386,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 156387,
      "primary_message": "To serve, divide veggie-scrambled eggs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
