  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve and pit the apricots. Slice the almonds. Melt the unsalted butter.",
      "secondary_message": "2 apricots\n1 tbsp almonds\n3 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 220°C (425°F). Place apricots cut-site up in baking dish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together oats, almonds, brown sugar, cinnamon, ginger, and salt. Add melted butter and mix until well combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Divide oat topping evenly among apricots, mounding on top of each fruit. Bake until oats are golden and apricots are soft, about 25 minutes. Let cool slightly then serve warm or at room temperature, with yogurt on the side if desired.",
      "secondary_message": null
    }
  ],
