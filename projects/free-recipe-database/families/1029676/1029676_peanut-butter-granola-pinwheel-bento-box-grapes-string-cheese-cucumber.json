  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and slice cucumber crosswise into thin rounds. Place in one of the small compartments of the bento box.",
      "secondary_message": "¼ English cucumber"
    },
    {
      "primary_message": "Place string cheese in the other small compartment of the bento box. (If the cheese does not fit, remove packaging and cut in half.)",
      "secondary_message": "1 stick string cheese"
    },
    {
      "primary_message": "Wash, dry, and place grapes in the medium compartment of the bento box. ",
      "secondary_message": "½ cup red grapes"
    },
    {
      "primary_message": "Place lavash (about 8 x 10-inches in size) on a flat surface. Spread peanut butter over the bread in an even layer, making sure to spread it out to the edges. ",
      "secondary_message": "1 (8 x 10-inch) piece lavash bread\n¼ cup natural peanut butter"
    },
    {
      "primary_message": "Sprinkle granola evenly over the peanut butter. With the short edge of the lavash facing towards you, tightly roll the bread into a cylinder. Slice bread crosswise into 6 even pieces and place in the large compartment of the bento box. ",
      "secondary_message": "½ cup granola"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
