  "instructions": [
    {
      "id": 230778,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n3 medium carrots\n⅓ kg green beans\n1 ½ avocados\n1 lime"
    },
    {
      "id": 230779,
      "primary_message": "Peel and large dice onions. Large dice tomatoes; place both in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 230780,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 230781,
      "primary_message": "While the pot heats up, peel and roughly chop garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 230782,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onions, tomatoes, garlic, and salt; cook, stirring occasionally, until veggies start to soften, 5-7 minutes. Remove from heat. (Reserve bowl for next step.)",
      "secondary_message": "⅓ cup butter, unsalted\n½ tsp salt"
    },
    {
      "id": 230783,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots. Trim and cut green beans into 1-inch pieces. Place both in the reserved bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 230784,
      "primary_message": "Working in batches if necessary, transfer the tomato-onion mixture to a blender and blend on high until smooth; set aside.",
      "secondary_message": null
    },
    {
      "id": 230785,
      "primary_message": "Use your hands to break the pasta into 1-inch pieces.",
      "secondary_message": "255 g spaghetti pasta"
    },
    {
      "id": 230786,
      "primary_message": "Return pot to the stove over medium-high heat; add more butter and swirl to coat the bottom. Add the pasta and cook, stirring constantly, until it turns golden, 2-3 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 230787,
      "primary_message": "Add tomato-onion pureé, broth, tomato sauce, carrots, green beans, and spices to the pot. Stir to combine, bring to a boil, then reduce the heat to medium-low and cover the pot. Simmer, stirring occasionally, until pasta and vegetables are tender, about 10 minutes.",
      "secondary_message": "2129 ml chicken or vegetable broth\n3 (213 ml) cans tomato sauce\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cumin, ground"
    },
    {
      "id": 230788,
      "primary_message": "Add peas to the soup during the last 2-3 minutes of cooking; continue to simmer until heated through, 2-3 minutes.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 230789,
      "primary_message": "Meanwhile, halve and pit the avocados; scoop out flesh with a spoon and medium dice.",
      "secondary_message": null
    },
    {
      "id": 230790,
      "primary_message": "Cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 230791,
      "primary_message": "Divide soup between bowls; top with avocado and feta. Serve with lime wedges on the side and enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
