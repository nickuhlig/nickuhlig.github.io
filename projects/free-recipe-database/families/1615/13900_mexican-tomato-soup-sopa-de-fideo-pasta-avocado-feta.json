  "instructions": [
    {
      "id": 230582,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n1 medium carrot\n¼ lb green beans\n½ avocado\n½ lime"
    },
    {
      "id": 230583,
      "primary_message": "Peel and large dice onion. Large dice tomatoes; place both in a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 230584,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 230585,
      "primary_message": "While the pan heats up, peel and roughly chop garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 230586,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add onion, tomatoes, garlic, and salt; cook, stirring occasionally, until veggies start to soften, about 5 minutes. Remove from heat. (Reserve bowl for next step.)",
      "secondary_message": "2 tbsp butter, unsalted\n⅛ tsp salt"
    },
    {
      "id": 230587,
      "primary_message": "Meanwhile, peel, trim, and small dice carrot. Trim and cut green beans into 1-inch pieces. Place both in the reserved bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 230588,
      "primary_message": "Transfer the tomato-onion mixture to a blender and blend on high until smooth; set aside.",
      "secondary_message": null
    },
    {
      "id": 230589,
      "primary_message": "Use your hands to break the pasta into 1-inch pieces.",
      "secondary_message": "3 oz spaghetti pasta"
    },
    {
      "id": 230590,
      "primary_message": "Return pan to the stove over medium-high heat; add more butter and swirl to coat the bottom. Add the pasta and cook, stirring constantly, until it turns golden, 1-2 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 230591,
      "primary_message": "Add tomato-onion pureé, broth, tomato sauce, carrots, green beans, and spices to the pan. Stir to combine, bring to a boil, then reduce the heat to medium-low and cover the pan. Simmer, stirring occasionally, until pasta and vegetables are tender, 8-10 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 (8 oz) can tomato sauce\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cumin, ground"
    },
    {
      "id": 230592,
      "primary_message": "Add peas to the soup during the last 2 minutes of cooking; continue to simmer until heated through, 1-2 minutes.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 230593,
      "primary_message": "Meanwhile, halve and pit the avocado; scoop out flesh with a spoon and medium dice.",
      "secondary_message": null
    },
    {
      "id": 230594,
      "primary_message": "Cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 230595,
      "primary_message": "Divide soup between bowls; top with avocado and feta. Serve with lime wedges on the side and enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
