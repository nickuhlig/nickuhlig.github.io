  "instructions": [
    {
      "id": 267481,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 267482,
      "primary_message": "Place pine nuts on a baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and toast, stirring every 2-3 minutes, until golden brown, 5-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 267483,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n½ lemon\n1 bunch kale"
    },
    {
      "id": 267484,
      "primary_message": "Place oil, vinegar, salt, and pepper in a small baking dish; whisk to combine the marinade.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 267485,
      "primary_message": "Slice tomatoes into ¼-inch thick rounds; add to the dish with the marinade, turn to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 267486,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 267487,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 267488,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 267489,
      "primary_message": "Turn oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 267490,
      "primary_message": "While the broiler heats up, roughly chop toasted pine nuts. Add pine nuts and nutritional yeast to the bowl with the kale and toss to combine the salad; set aside. (Reserve baking sheet for next step.)",
      "secondary_message": "⅛ cup nutritional yeast flakes"
    },
    {
      "id": 267491,
      "primary_message": "Arrange bread on the baking sheet. Place in the oven and toast, flipping once, until golden brown, 1-2 minutes. Remove from the oven. ",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 267492,
      "primary_message": "Spread each slice of toast with a thick layer of mayo. Top half of the slices with marinated tomatoes, then close with remaining toast slices.",
      "secondary_message": "3 tbsp vegan mayonnaise"
    },
    {
      "id": 267493,
      "primary_message": "To serve, divide tomato sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
