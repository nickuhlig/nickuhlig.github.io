  "instructions": [
    {
      "id": 267588,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 267589,
      "primary_message": "Place pine nuts on a large baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and toast, stirring every 2-3 minutes, until golden brown, 5-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 267590,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n1 ½ lemons\n3 bunches kale"
    },
    {
      "id": 267591,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large baking dish; whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 267592,
      "primary_message": "Slice tomatoes into ¼-inch thick rounds; add to the dish with the marinade, turn to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 267593,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 267594,
      "primary_message": "Juice lemons into the bowl with the garlic. Add oil, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 267595,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 267596,
      "primary_message": "Turn oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 267597,
      "primary_message": "While the broiler heats up, roughly chop toasted pine nuts. Add pine nuts and nutritional yeast to the bowl with the kale and toss to combine the salad; set aside. (Reserve baking sheet for next step.)",
      "secondary_message": "⅓ cup nutritional yeast flakes"
    },
    {
      "id": 267598,
      "primary_message": "Working in batches if necessary, arrange bread on the baking sheet. Place in the oven and toast, flipping once, until golden brown, 1-2 minutes. Remove from the oven. ",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 267599,
      "primary_message": "Spread each slice of toast with a thick layer of mayo. Top half of the slices with marinated tomatoes, then close with remaining toast slices.",
      "secondary_message": "½ cup vegan mayonnaise"
    },
    {
      "id": 267600,
      "primary_message": "To serve, divide tomato sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
