  "instructions": [
    {
      "id": 352638,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 352639,
      "primary_message": "Meanwhile, fill a separate, large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 352640,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 sticks celery\n1 small bunch fresh dill\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 352641,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. ",
      "secondary_message": null
    },
    {
      "id": 352642,
      "primary_message": "Once the water in the second pot comes to a boil, uncover, add cauliflower and salt; stir for a few seconds. Cook until crisp-tender, about 3 minutes. Drain and set aside to cool.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 352643,
      "primary_message": "Add mayonnaise, Dijon, vinegar, and spices to a large bowl; whisk together.",
      "secondary_message": "½ cup mayonnaise\n3 tbsp Dijon mustard\n2 tbsp red wine vinegar\n¾ tsp garlic powder\n¾ tsp curry powder\n¾ tsp salt\n¾ tsp black pepper\n½ tsp paprika"
    },
    {
      "id": 352644,
      "primary_message": "Peel and mince shallots. Small dice celery (reserving celery leaves for garnish); transfer both to the bowl with the dressing.",
      "secondary_message": "1 ½ shallots"
    },
    {
      "id": 352645,
      "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 352646,
      "primary_message": "Halve the olives lengthwise; add dill and olives to the bowl.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 352647,
      "primary_message": "Peel and roughly chop the eggs. Add eggs and drained cauliflower to the bowl; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 352648,
      "primary_message": "In a small bowl, whisk together oil, vinegar, Dijon, and spices to make a dressing for the mixed greens.",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp Dijon mustard\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 352649,
      "primary_message": "To serve, divide mixed greens between plates or bowls; drizzle dressing over greens and top with cauliflower salad. Garnish with celery leaves and enjoy!",
      "secondary_message": null
    }
  ],
