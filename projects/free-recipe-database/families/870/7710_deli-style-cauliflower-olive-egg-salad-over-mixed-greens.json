  "instructions": [
    {
      "id": 352479,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 352480,
      "primary_message": "Meanwhile, fill a separate, medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 352481,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 stick celery\n½ small bunch fresh dill\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 352482,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. ",
      "secondary_message": null
    },
    {
      "id": 352483,
      "primary_message": "Once the water in the medium saucepan comes to a boil, uncover, add cauliflower and salt; stir for a few seconds. Cook until crisp-tender, about 3 minutes. Drain and set aside to cool.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 352484,
      "primary_message": "Add mayonnaise, Dijon, vinegar, and spices to a medium bowl; whisk together.",
      "secondary_message": "3 tbsp mayonnaise\n1 tbsp Dijon mustard\n2 tsp red wine vinegar\n¼ tsp garlic powder\n¼ tsp curry powder\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp paprika"
    },
    {
      "id": 352485,
      "primary_message": "Peel and mince shallot. Small dice celery (reserving celery leaves for garnish); transfer both to the bowl with the dressing.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 352486,
      "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 352487,
      "primary_message": "Halve the olives lengthwise; add dill and olives to the bowl.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 352488,
      "primary_message": "Peel and roughly chop the eggs. Add eggs and drained cauliflower to the bowl; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 352489,
      "primary_message": "In a small bowl, whisk together oil, vinegar, Dijon, and spices to make a dressing for the mixed greens.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 352490,
      "primary_message": "To serve, divide mixed greens between plates or bowls; drizzle dressing over greens and top with cauliflower salad. Garnish with celery leaves and enjoy!",
      "secondary_message": null
    }
  ],
