  "instructions": [
    {
      "id": 352592,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 352593,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n2 sticks celery\n1 small bunch fresh dill"
    },
    {
      "id": 352594,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. ",
      "secondary_message": null
    },
    {
      "id": 352595,
      "primary_message": "Once the water comes to a boil, uncover, add cauliflower and salt; stir for a few seconds. Cook until crisp-tender, about 3 minutes. Drain and set aside to cool.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 352596,
      "primary_message": "Preheat the broiler to high and position rack about 6 inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 352597,
      "primary_message": "Place pork chops on a broiler pan and season both sides with salt and pepper.",
      "secondary_message": "4 pork chops, bone-in\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 352598,
      "primary_message": "Place pork chops in the oven and broil, flipping halfway through cooking time. Cook until chops are no longer pink in the center and are browned at the edges, 12-14 minutes, or until they reach an internal temperature of 65°C (145°F). Remove from the oven and let rest for 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 352599,
      "primary_message": "While the pork chops are cooking, add mayonnaise, Dijon, vinegar, and spices to a large bowl; whisk together.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp Dijon mustard\n4 tsp red wine vinegar\n½ tsp garlic powder\n½ tsp curry powder\n½ tsp salt\n½ tsp black pepper\n¼ tsp paprika"
    },
    {
      "id": 352600,
      "primary_message": "Peel and mince shallot. Small dice celery (reserving celery leaves for garnish); transfer both to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 352601,
      "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. Add dill and drained cauliflower to the bowl and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 352602,
      "primary_message": "To serve, divide cauliflower salad and pork chops between plates. Garnish with celery leaves and enjoy!",
      "secondary_message": null
    }
  ],
