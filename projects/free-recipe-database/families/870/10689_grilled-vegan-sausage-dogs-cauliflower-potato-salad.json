  "instructions": [
    {
      "id": 352672,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 352673,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 sticks celery\n1 small bunch fresh dill"
    },
    {
      "id": 352674,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. ",
      "secondary_message": null
    },
    {
      "id": 352675,
      "primary_message": "Once the water comes to a boil, uncover, add cauliflower and salt; stir for a few seconds. Cook until crisp-tender, about 3 minutes. Drain and set aside to cool.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 352676,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 352677,
      "primary_message": "While the grill pan heats up, combine mayonnaise, Dijon, vinegar, and spices in a large bowl; whisk together.",
      "secondary_message": "½ cup vegan mayonnaise\n3 tbsp Dijon mustard\n2 tbsp red wine vinegar\n¾ tsp garlic powder\n¾ tsp curry powder\n¾ tsp salt\n¾ tsp black pepper\n½ tsp paprika"
    },
    {
      "id": 352678,
      "primary_message": "Once the grill pan is hot, coat with oil. Place sausages on the grill and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate and cover with foil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 352679,
      "primary_message": "Meanwhile, peel and mince shallots. Small dice celery (reserving celery leaves for garnish); transfer both to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 352680,
      "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. Add dill and drained cauliflower to the bowl and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 352681,
      "primary_message": "Open buns and place on the grill pan to toast, 30-60 seconds, if desired. Work in batches if necessary.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 352682,
      "primary_message": "To serve, divide cauliflower salad and buns between plates. Place a sausage in each bun and top with ketchup and Dijon. Garnish the salad with celery leaves and enjoy!",
      "secondary_message": "2 tbsp ketchup\n2 tbsp Dijon mustard"
    }
  ],
