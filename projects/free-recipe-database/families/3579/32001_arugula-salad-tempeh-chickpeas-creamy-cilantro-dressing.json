  "instructions": [
    {
      "id": 505861,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ limes\n1 small bunch cilantro\n1 ½ orange bell peppers\n1 ½ small pkgs grape tomatoes\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 505862,
      "primary_message": "Place vinegar, honey, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup white wine vinegar\n1 ½ tsp honey\n¾ tsp salt"
    },
    {
      "id": 505863,
      "primary_message": "Peel, halve, and slice onions crosswise into ¼-inch thick half-moons. Add to bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 505864,
      "primary_message": "Zest limes into a large bowl (reserve limes for later use). Add soy sauce and spices, then stir to combine the spice paste.",
      "secondary_message": "2 tbsp soy sauce\n1 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n¾ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 505865,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 505866,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces. Add to the bowl with the spice paste and stir to coat.",
      "secondary_message": "3 (227g ) pkgs tempeh"
    },
    {
      "id": 505867,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh in a single layer (leaving any excess spice paste in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 505868,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems. Place stems and half of the leaves in a blender. (Reserve remaining leaves for serving.)",
      "secondary_message": null
    },
    {
      "id": 505869,
      "primary_message": "Juice reserved limes into the blender, then add yogurt, oil, water, honey, and salt. Blend on high until smooth. Add additional water, a few teaspoons at a time, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n3 tbsp water\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 505870,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 505871,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 505872,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 505873,
      "primary_message": "Add chickpeas and arugula to the bowl, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 505874,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with dressing, then top with seared tempeh, pickled onions, and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
