  "instructions": [
    {
      "id": 505659,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lime\n½ small bunch cilantro\n½ orange bell pepper\n½ pint grape tomatoes\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 505660,
      "primary_message": "Place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "2 tbsp white wine vinegar\n½ tsp honey\n¼ tsp salt"
    },
    {
      "id": 505661,
      "primary_message": "Peel, halve, and slice onion crosswise into ¼-inch thick half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 505662,
      "primary_message": "Zest lime into another small bowl (reserve lime for later use). Add spices and stir to combine the spice mix.",
      "secondary_message": "½ tsp cumin, ground\n½ tsp garlic powder\n¼ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 505663,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 505664,
      "primary_message": "While the pan heats up, pat the chicken dry with paper towels; holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with the spice mix.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 505665,
      "primary_message": "Once the pan is hot, coat with oil. Add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 505666,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems. Place stems and half of the leaves in a blender. (Reserve remaining leaves for serving.)",
      "secondary_message": null
    },
    {
      "id": 505667,
      "primary_message": "Juice reserved lime into the blender, then add yogurt, oil, water, honey, and salt. Blend on high until smooth. Add additional water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n1 tbsp water\n1 tsp honey\n¼ tsp salt"
    },
    {
      "id": 505668,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 505669,
      "primary_message": "Trim, seed, and medium dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 505670,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 505671,
      "primary_message": "Add chickpeas and arugula to the bowl, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 505672,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 505673,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with dressing, then top with chicken, pickled onions, and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
