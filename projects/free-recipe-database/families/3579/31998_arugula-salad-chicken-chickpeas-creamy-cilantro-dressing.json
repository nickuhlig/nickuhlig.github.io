  "instructions": [
    {
      "id": 505818,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ limes\n1 small bunch cilantro\n1 ½ orange bell peppers\n1 ½ small pkgs grape tomatoes\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 505819,
      "primary_message": "Place vinegar, honey, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup white wine vinegar\n1 ½ tsp honey\n¾ tsp salt"
    },
    {
      "id": 505820,
      "primary_message": "Peel, halve, and slice onions crosswise into ¼-inch thick half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 505821,
      "primary_message": "Zest limes into a small bowl (reserve limes for later use). Add spices and stir to combine the spice mix.",
      "secondary_message": "1 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n¾ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 505822,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 505823,
      "primary_message": "While the pan heats up, pat the chicken dry with paper towels; holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with the spice mix.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 505824,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 505825,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems. Place stems and half of the leaves in a blender. (Reserve remaining leaves for serving.)",
      "secondary_message": null
    },
    {
      "id": 505826,
      "primary_message": "Juice reserved limes into the blender, then add yogurt, oil, water, honey, and salt. Blend on high until smooth. Add additional water, a few teaspoons at a time, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n3 tbsp water\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 505827,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 505828,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 505829,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 505830,
      "primary_message": "Add chickpeas and arugula to the bowl, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 505831,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 505832,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with dressing, then top with chicken, pickled onions, and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
