  "instructions": [
    {
      "id": 505718,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lime\n1 small bunch cilantro\n1 orange bell pepper\n1 pint grape tomatoes\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 505719,
      "primary_message": "Place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "¼ cup white wine vinegar\n1 tsp honey\n½ tsp salt"
    },
    {
      "id": 505720,
      "primary_message": "Peel, halve, and slice onion crosswise into ¼-inch thick half-moons. Add to bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 505721,
      "primary_message": "Zest lime into a large bowl (reserve lime for later use). Add soy sauce and spices, then stir to combine the spice paste.",
      "secondary_message": "4 tsp soy sauce\n1 tsp cumin, ground\n1 tsp garlic powder\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 505722,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 505723,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces. Add to the bowl with the spice paste and stir to coat.",
      "secondary_message": "2 (8 oz) packages tempeh"
    },
    {
      "id": 505724,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tempeh in a single layer (leaving any excess spice paste in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 505725,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems. Place stems and half of the leaves in a blender. (Reserve remaining leaves for serving.)",
      "secondary_message": null
    },
    {
      "id": 505726,
      "primary_message": "Juice reserved lime into the blender, then add yogurt, oil, water, honey, and salt. Blend on high until smooth. Add additional water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n2 tbsp water\n2 tsp honey\n½ tsp salt"
    },
    {
      "id": 505727,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 505728,
      "primary_message": "Trim, seed, and medium dice bell pepper. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 505729,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 505730,
      "primary_message": "Add chickpeas and arugula to the bowl, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 505731,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with dressing, then top with seared tempeh, pickled onions, and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
