  "instructions": [
    {
      "id": 407366,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 avocado\n1 lime\n½ small pineapple\n½ red bell pepper\n½ small bunch cilantro\n½ small head red cabbage"
    },
    {
      "id": 407367,
      "primary_message": "Halve and pit avocado. Scoop out into a small bowl and mash with a fork.",
      "secondary_message": null
    },
    {
      "id": 407368,
      "primary_message": "Peel and mince garlic; add to the bowl with the avocado.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 407369,
      "primary_message": "Juice half of the lime into the bowl with the avocado; add salt, stir to combine the guacamole, and set aside. (Reserve remaining lime for the salsa.)",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 407370,
      "primary_message": "Cut off skin from pineapple, core, and small dice. Trim, seed, and small dice bell pepper; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 407371,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the pineapple and bell pepper.",
      "secondary_message": null
    },
    {
      "id": 407372,
      "primary_message": "Peel and mince shallot; add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 407373,
      "primary_message": "Juice remaining lime into the bowl; add salt, stir to combine the pineapple salsa, and set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 407374,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 407375,
      "primary_message": "While the pan heats up, quarter the cabbage lengthwise, then cut out and discard the core; slice crosswise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 407376,
      "primary_message": "Once the pan is hot, coat with oil. Add cabbage and cook, stirring frequently, until softened, 3-4 minutes. Transfer cabbage to a plate and cover with aluminum foil to keep warm. (Reserve pan for the next step).",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 407377,
      "primary_message": "While the cabbage is cooking, pat scallops dry with paper towels and place on another plate; rub with oil and season with spices on both sides.",
      "secondary_message": "⅓ kg sea scallops\n1 tsp extra virgin olive oil\n¼ tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 407378,
      "primary_message": "Return pan to medium-high heat. Add scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, add to the plate with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 407379,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 407380,
      "primary_message": "To serve, spread tortillas with guacamole and top with scallops (cutting them in half if necessary); garnish with wilted cabbage and pineapple salsa. Enjoy!",
      "secondary_message": null
    }
  ],
