  "instructions": [
    {
      "id": 407306,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 avocados\n3 limes\n1 ½ small pineapples\n1 ½ red bell peppers\n1 small bunch cilantro\n1 ½ small heads red cabbage"
    },
    {
      "id": 407307,
      "primary_message": "Halve and pit avocados. Scoop out into a medium bowl and mash with a fork.",
      "secondary_message": null
    },
    {
      "id": 407308,
      "primary_message": "Peel and mince garlic; add to the bowl with the avocado.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 407309,
      "primary_message": "Juice half of the limes into the bowl with the avocado; add salt, stir to combine the guacamole, and set aside. (Reserve remaining limes for the salsa.)",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 407310,
      "primary_message": "Cut off skin from pineapples, core, and small dice. Trim, seed, and small dice bell peppers; place both in another medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 407311,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the pineapple and bell pepper.",
      "secondary_message": null
    },
    {
      "id": 407312,
      "primary_message": "Peel and mince onion; add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 407313,
      "primary_message": "Juice remaining limes into the bowl; add salt, stir to combine the pineapple salsa, and set aside.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 407314,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 407315,
      "primary_message": "While the pan heats up, quarter each cabbage lengthwise, then cut out and discard the core; slice crosswise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 407316,
      "primary_message": "Once the pan is hot, coat with oil. Add cabbage and cook, stirring frequently, until softened, 5-6 minutes. Transfer cabbage to a large plate and cover with aluminum foil to keep warm. (Reserve pan for the next step).",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 407317,
      "primary_message": "While the cabbage is cooking, pat scallops dry with paper towels and place on another plate; rub with oil and season with spices on both sides.",
      "secondary_message": "2 ¼ lb sea scallops\n1 tbsp extra virgin olive oil\n¾ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 407318,
      "primary_message": "Return pan to medium-high heat. Working in batches if necessary, add scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, add to the plate with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 407319,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 407320,
      "primary_message": "To serve, spread tortillas with guacamole and top with scallops (cutting them in half if necessary); garnish with wilted cabbage and pineapple salsa. Enjoy!",
      "secondary_message": null
    }
  ],
