  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven racks to lower-middle and upper-middle positions and preheat oven to 175°C (350°F). Line 2 baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Sift flour, cocoa powder, baking soda, and salt into medium bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In bowl of standing mixer fitted with paddle attachment, cream butter with sugars on medium speed until light and fluffy, about 1 minute. Add egg and vanilla until combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Reduce speed to low and add dry ingredients until just combined, scraping down sides of bowl as necessary to incorporate ingredients evenly. Add chocolate chips, white chocolate chips, and pistachios until just combined.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Evenly place 12 heaping tablespoons of dough onto prepared pans, spacing 5 cm apart. Gently roll each piece of dough into a ball and press down gently until slightly flattened. Sprinkle a few flakes of sea salt on top of each cookie.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Bake until cookies have puffed and small cracks appear, about 13 minutes, rotating pans from top to bottom and front to back halfway through baking. Let cookies cool on pans for 5 minutes, then transfer cookies to wire rack to cool completely. Repeat with remaining cookies.",
      "secondary_message": null
    }
  ],
