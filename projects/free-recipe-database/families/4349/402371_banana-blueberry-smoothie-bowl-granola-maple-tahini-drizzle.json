  "instructions": [
    {
      "primary_message": "This recipe will make about 6 cups of smoothie. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "primary_message": "Place tahini, maple syrup, cinnamon, and salt in a small bowl. Whisk to combine and set aside.",
      "secondary_message": "¼ cup tahini\n2 tbsp pure maple syrup\n½ tsp cinnamon, ground\n¼ tsp salt"
    },
    {
      "primary_message": "Peel bananas, break into chunks, and place in a blender.",
      "secondary_message": "2 bananas"
    },
    {
      "primary_message": "Wash and dry blueberries. Add to the blender along with milk, yogurt, and 8 ice cubes, then blend on high speed until smooth, 1-2 minutes.",
      "secondary_message": "2 (170 g) pkgs blueberries\n473 ml whole milk\n1 cup plain Greek yogurt"
    },
    {
      "primary_message": "To serve, divide smoothie between bowls. Top with granola and drizzle with maple tahini. Enjoy!",
      "secondary_message": "1 cup granola, nut free"
    }
