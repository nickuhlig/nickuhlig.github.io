  "instructions": [
    {
      "id": 623167,
      "primary_message": "This recipe will make about 9 cups of smoothie. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 623168,
      "primary_message": "Place tahini, maple syrup, cinnamon, and salt in a small bowl. Whisk to combine and set aside.",
      "secondary_message": "⅓ cup tahini\n3 tbsp pure maple syrup\n¾ tsp cinnamon, ground\n¼ tsp salt"
    },
    {
      "id": 623169,
      "primary_message": "Peel bananas, break into chunks, and place in a blender.",
      "secondary_message": "3 bananas"
    },
    {
      "id": 623170,
      "primary_message": "Wash and dry blueberries. Add to the blender along with milk, yogurt, and 12 ice cubes, then blend on high speed until smooth, 1-2 minutes.",
      "secondary_message": "3 (6 oz) pkgs blueberries\n24 fl oz (3 cups) whole milk\n1 ½ cups plain Greek yogurt"
    },
    {
      "id": 623171,
      "primary_message": "To serve, divide smoothie between bowls. Top with granola and drizzle with maple tahini. Enjoy!",
      "secondary_message": "1 ½ cup granola"
    }
  ],
