  "instructions": [
    {
      "id": 349230,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349231,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat and cover with a lid to keep warm.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 ½ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 349232,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ jalapeño peppers\n3 mangoes\n1 ½ red bell peppers\n1 small bunch cilantro\n1 ½ limes\n1 head butter (Boston) lettuce"
    },
    {
      "id": 349233,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and place in a large bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 349234,
      "primary_message": "Peel and mince shallots and garlic; add both to the bowl with the jalapeño.",
      "secondary_message": "2 shallots\n6 cloves garlic"
    },
    {
      "id": 349235,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; small dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349236,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349237,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349238,
      "primary_message": "Juice limes into the bowl; add salt and stir to combine the mango salsa. Set aside.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 349239,
      "primary_message": "Remove lettuce leaves from head, then chop crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 349240,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 349241,
      "primary_message": "To serve, divide tortillas between plates; fill with veggie ground, lettuce, and mango salsa. Enjoy!",
      "secondary_message": null
    }
  ],
