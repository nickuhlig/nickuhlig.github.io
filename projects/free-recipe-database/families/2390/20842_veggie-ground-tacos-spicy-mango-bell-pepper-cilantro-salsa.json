  "instructions": [
    {
      "id": 349206,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349207,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat and cover with a lid to keep warm.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 349208,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ jalapeño pepper\n1 mango\n½ red bell pepper\n½ small bunch cilantro\n½ lime\n½ head butter (Boston) lettuce"
    },
    {
      "id": 349209,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and place in a medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 349210,
      "primary_message": "Peel and mince shallot and garlic; add both to the bowl with the jalapeño.",
      "secondary_message": "½ shallot\n2 cloves garlic"
    },
    {
      "id": 349211,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; small dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349212,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349213,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349214,
      "primary_message": "Juice lime into the bowl; add salt and stir to combine the mango salsa. Set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 349215,
      "primary_message": "Remove lettuce leaves from head, then chop crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 349216,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 349217,
      "primary_message": "To serve, divide tortillas between plates; fill with veggie ground, lettuce, and mango salsa. Enjoy!",
      "secondary_message": null
    }
  ],
