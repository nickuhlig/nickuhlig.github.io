  "instructions": [
    {
      "id": 196139,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp oregano"
    },
    {
      "id": 196140,
      "primary_message": "Pat the steak dry with paper towels, then slice against the grain into ¼-inch thick strips. Transfer steak to a medium bowl, pour half of the dressing over the steak, and turn to coat. Set aside.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 196141,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 tomatoes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 196142,
      "primary_message": "Using a clean cutting board, peel, halve, and thinly slice onions into half-moons. Transfer to the bowl with the remaining dressing.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 196143,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196144,
      "primary_message": "Medium dice tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196145,
      "primary_message": "Drain and thinly slice artichokes. Roughly chop olives. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated\n¾ cup Kalamata olives, pitted"
    },
    {
      "id": 196146,
      "primary_message": "Preheat a grill pan or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196147,
      "primary_message": "While the grill pan heats up, peel and mince additional garlic. Place in a small bowl along with yogurt, salt, and pepper; whisk to combine the yogurt sauce.",
      "secondary_message": "3 cloves garlic\n1 cup plain Greek yogurt\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 196148,
      "primary_message": "Working in batches if necessary, add steak strips to the hot grill pan and cook to desired doneness, about 1 minute per side for medium-rare. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 196149,
      "primary_message": "Separate lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill with Greek salad, steak, and feta. Serve with yogurt sauce on the side and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
