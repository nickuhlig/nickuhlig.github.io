  "instructions": [
    {
      "id": 196150,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp oregano"
    },
    {
      "id": 196151,
      "primary_message": "Pat the steak dry with paper towels, then slice against the grain into ¼-inch thick strips. Transfer steak to a small bowl, pour half of the dressing over the steak, and turn to coat. Set aside.",
      "secondary_message": "¾ lb striploin (New York strip) steak"
    },
    {
      "id": 196152,
      "primary_message": "Using a clean cutting board, peel, halve, and thinly slice onion into half-moons. Transfer to the bowl with the remaining dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 196153,
      "primary_message": "Wash, dry, and trim cucumber; medium dice and add to the bowl.",
      "secondary_message": "½ English cucumber"
    },
    {
      "id": 196154,
      "primary_message": "Drain and thinly slice artichokes. Roughly chop olives. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": "½ (6 oz) jar artichoke hearts, marinated\n¼ cup Kalamata olives, pitted"
    },
    {
      "id": 196155,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196156,
      "primary_message": "While the grill pan heats up, peel and mince additional garlic. Place in a small bowl along with yogurt, salt, and pepper; whisk to combine the yogurt sauce.",
      "secondary_message": "1 clove garlic\n⅓ cup plain Greek yogurt\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 196157,
      "primary_message": "Once the grill pan is hot, add the steak strips and cook to desired doneness, about 1 minute per side for medium-rare. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 196158,
      "primary_message": "Wash and dry lettuce; separate into leaves.",
      "secondary_message": "½ head butter (Boston) lettuce"
    },
    {
      "id": 196159,
      "primary_message": "Pile lettuce leaves, in stacks of two per wrap, onto plates. Fill with Greek salad, steak, and feta. Serve with yogurt sauce on the side and enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
