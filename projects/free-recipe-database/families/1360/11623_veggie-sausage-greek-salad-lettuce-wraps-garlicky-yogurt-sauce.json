  "instructions": [
    {
      "id": 196276,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 tomato\n½ head butter (Boston) lettuce"
    },
    {
      "id": 196277,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp oregano"
    },
    {
      "id": 196278,
      "primary_message": "Peel, halve, and thinly slice onion into half-moons. Transfer to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 196279,
      "primary_message": "Trim and medium dice cucumber; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196280,
      "primary_message": "Medium dice tomato and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196281,
      "primary_message": "Drain and thinly slice artichokes. Roughly chop olives. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated\n¼ cup Kalamata olives, pitted"
    },
    {
      "id": 196282,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196283,
      "primary_message": "Chop sausages into bite-sized pieces.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 196284,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring often, until slightly crispy and warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 196285,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a small bowl along with yogurt, salt, and pepper; whisk to combine the yogurt sauce.",
      "secondary_message": "1 clove garlic\n⅓ cup plain Greek yogurt\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 196286,
      "primary_message": "Separate lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill with Greek salad, sausage, and feta. Serve with yogurt sauce on the side and enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
