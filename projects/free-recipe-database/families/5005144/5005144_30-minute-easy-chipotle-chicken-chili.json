  "instructions": [
    {
      "id": 1,
      "primary_message": "In large saucepan or dutch oven, heat oil over medium heat until shimmering. Add onion and 1 teaspoon salt. Cook, stirring, until softened and beginning to turn golden, 6 to 8 minutes. Add jalapeños, garlic, cumin, oregano, and cayenne. Cook until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add chicken and cook until just cooked through, about 4 minutes. Add chipotle chilies, beans, and broth and bring to simmer. Simmer for about 10 to 15 minutes to let flavors meld.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add corn to just heat through. Season to taste. Stir in cilantro and serve with avocado, chips, and lime.",
      "secondary_message": null
    }
  ],
