  "instructions": [
    {
      "id": 35087,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 35088,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "1 mango\n1 avocado\n1 jalapeño pepper\n1 lime\n½ small bunch cilantro"
    },
    {
      "id": 35089,
      "primary_message": "Once the water is boiling, reduce the heat to low and cover. Cook the rice until the liquid is absorbed, 15 to 18 minutes. Once done, remove the saucepan from the heat and let it stand, covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 35090,
      "primary_message": "Peel the mango and cut the flesh away from the pit, starting from the flat sides. Small dice the flesh and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 35091,
      "primary_message": "Halve and pit the avocado; scoop out the flesh and small dice. Add to the bowl with the mango.",
      "secondary_message": null
    },
    {
      "id": 35092,
      "primary_message": "Halve the jalapeño and remove the seeds; mince the pepper and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 35093,
      "primary_message": "Preheat a grill pan or skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 35094,
      "primary_message": "Juice the lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 35095,
      "primary_message": "Place the fish on a plate; season with salt and pepper, then drizzle with olive oil and ½ of the lime juice (save the rest for the salsa).",
      "secondary_message": "0.34 kg halibut fillet\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 35096,
      "primary_message": "Place the fish on the grill pan or skillet; cook until it is opaque in the center, 3 to 4 minutes per side. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 35097,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the mango and avocado mixture.",
      "secondary_message": null
    },
    {
      "id": 35098,
      "primary_message": "Add the remaining lime juice to the salsa and season with salt and pepper; mix well.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper "
    },
    {
      "id": 35099,
      "primary_message": "To serve, place the rice and fish on a plate and spoon the mango-avocado salsa on top. Enjoy!",
      "secondary_message": null
    }
  ],
