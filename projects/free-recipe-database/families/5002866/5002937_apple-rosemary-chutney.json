  "instructions": [
    {
      "id": 1,
      "primary_message": "In a saucepan, combine onions, vinegar, apple cider, rosemary, juniper, and a pinch of salt. Bring to a simmer and cook, covered, for ten minutes, or until onions have mostly softened.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add apples and another pinch of salt. Increase heat slightly and cook uncovered for ten minutes, or until apples have softened and liquid has mostly evaporated.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in lemon zest and butter, and add sugar, more vinegar, and salt as needed. Remove rosemary stems and serve warm or room temperature.",
      "secondary_message": null
    }
  ],
