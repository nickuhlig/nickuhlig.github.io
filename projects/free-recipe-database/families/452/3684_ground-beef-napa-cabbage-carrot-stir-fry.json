  "instructions": [
    {
      "id": 39956,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n1 medium head napa cabbage\n1 small bunch green onions (scallions)"
    },
    {
      "id": 39957,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Using a box grater, coarsely grate the carrots and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 39958,
      "primary_message": "Trim off and discard the root end of the cabbage; quarter the cabbage lengthwise, then thinly slice crosswise into shreds and add to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 39959,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 39960,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 39961,
      "primary_message": "While the skillet heats up, trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 39962,
      "primary_message": "In a small bowl, combine and whisk together coconut aminos, sesame oil, and honey.",
      "secondary_message": "4 tbsp coconut aminos\n1 tbsp toasted sesame oil\n2 tsp honey"
    },
    {
      "id": 39963,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 39964,
      "primary_message": "Add the minced garlic and crushed red pepper to the skillet; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": "½ tsp crushed red pepper"
    },
    {
      "id": 39965,
      "primary_message": "Add the beef to the skillet; cook the beef, breaking apart with a spoon, until browned and crumbly, 3 to 5 minutes.",
      "secondary_message": "0.68 kg lean ground beef"
    },
    {
      "id": 39966,
      "primary_message": "Once the beef is cooked, add the carrots and cabbage to the skillet. Cook, stirring continuously, until the the cabbage is wilted, 2 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 39967,
      "primary_message": "Pour the sauce over the stir-fry and add about ¾ of the green onions (save the rest for garnishing); stir and cook for another 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 39968,
      "primary_message": "To serve, spoon the stir-fry into a bowl and garnish with the remaining green onions and sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
