  "instructions": [
    {
      "id": 30765,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n½ medium head napa cabbage\n½ small bunch green onions (scallions)"
    },
    {
      "id": 30764,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Using a box grater, coarsely grate the carrots and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 30771,
      "primary_message": "Trim off and discard the root end of the cabbage; half the cabbage lengthwise, then thinly slice crosswise into shreds and add to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 30766,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 30767,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 30867,
      "primary_message": "While the skillet heats up, trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 30770,
      "primary_message": "In a small bowl, combine and whisk together soy sauce, sesame oil, and honey.",
      "secondary_message": "2 tbsp soy sauce\n½ tbsp toasted sesame oil\n1 tsp honey"
    },
    {
      "id": 30768,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 30775,
      "primary_message": "Add the minced garlic and crushed red pepper to the skillet; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 30769,
      "primary_message": "Add the beef to the skillet; cook the beef, breaking apart with a spoon, until browned and crumbly, 3 to 5 minutes.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 30772,
      "primary_message": "Once the beef is cooked, add the carrots and cabbage to the skillet. Cook, stirring continuously, until the the cabbage is wilted, 2 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 30773,
      "primary_message": "Pour the sauce over the stir-fry and add about ¾ of the green onions (save the rest for garnishing); stir and cook for another 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 30774,
      "primary_message": "To serve, spoon the stir-fry into a bowl and garnish with the remaining green onions and sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
