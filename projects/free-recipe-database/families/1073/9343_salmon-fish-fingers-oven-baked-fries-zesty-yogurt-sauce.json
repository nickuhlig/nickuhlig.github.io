  "instructions": [
    {
      "id": 148327,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 148328,
      "primary_message": "Wash, peel, and slice potatoes into ¼-inch thick strips. Place in a large bowl and add oil and salt; toss to coat.",
      "secondary_message": "6 medium yellow potatoes\n3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 148329,
      "primary_message": "Spread potatoes out in a single layer on a large baking sheet and place in the lower third of the oven (it doesn't have to be fully heated). Tossing once halfway through, roast until golden brown, 15-20 minutes. Reserve bowl for next step. ",
      "secondary_message": null
    },
    {
      "id": 148330,
      "primary_message": "Wash, dry, and zest lemons into the reserved bowl. ",
      "secondary_message": "3 lemons"
    },
    {
      "id": 148331,
      "primary_message": "Add bread crumbs, oil, salt, and pepper to the bowl with the lemon zest; stir to combine.",
      "secondary_message": "3 cup panko bread crumbs\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 148332,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin. If you don’t have a tail end, start at one corner of the fillet and work your way in until the knife is between the skin and flesh. ",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 148333,
      "primary_message": "Slice the crosswise into 1-inch wide fingers.",
      "secondary_message": null
    },
    {
      "id": 148334,
      "primary_message": "Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 148335,
      "primary_message": "Roll the salmon in the bread crumb mixture, pressing to adhere; place on the prepared baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 148336,
      "primary_message": "Place salmon in the upper third of the oven and bake until golden, crispy, and cooked through, 6-8 minutes. Watch carefully because the bread crumbs can burn quickly.",
      "secondary_message": null
    },
    {
      "id": 148337,
      "primary_message": "Meanwhile, juice half of the lemons into a medium bowl. Cut the remaining lemon into wedges. ",
      "secondary_message": null
    },
    {
      "id": 148338,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the lemon juice. ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 148339,
      "primary_message": "Add yogurt, Dijon, salt, and pepper to the bowl; stir to combine the yogurt sauce. ",
      "secondary_message": "¾ cup plain Greek yogurt\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 148340,
      "primary_message": "Divide salmon and fries between plates; serve with lemon wedges and yogurt sauce on the side. Enjoy!",
      "secondary_message": null
    }
  ],
