  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the oven to 450°F. Line two small gratin dishes or one medium casserole dish with endive leaves. Dot with butter. Place the gratin dishes on a baking sheet and roast for 10 minutes. Top with scallops, season with salt and pepper, and turn the scallops in the butter now melted in the bottom of each dish. Return to oven and continue baking until scallops are cooked through, about 8 minutes longer. Serve immediately with lemon wedges and bread for soaking up melted butter.",
      "secondary_message": null
    }
  ],
