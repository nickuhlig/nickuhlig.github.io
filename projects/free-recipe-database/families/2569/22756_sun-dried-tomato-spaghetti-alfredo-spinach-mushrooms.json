  "instructions": [
    {
      "id": 377044,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n142 g spaghetti pasta"
    },
    {
      "id": 377045,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 377046,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, salt, and pepper; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 (227g ) pkg sliced white mushrooms\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 377047,
      "primary_message": "Add spinach, Alfredo sauce, pesto, and water to the skillet; cook, stirring often, until heated through, about 5 minutes. Reduce heat to low and allow to simmer gently until the pasta is finished cooking.",
      "secondary_message": "½ (454 g) bag frozen chopped spinach\n½ (454 g) jar Alfredo sauce\n⅓ cup sun-dried tomato pesto\n2 tbsp water"
    },
    {
      "id": 377048,
      "primary_message": "When the pasta is done, drain in a colander and add to the skillet with the sauce. Toss to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 377049,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
