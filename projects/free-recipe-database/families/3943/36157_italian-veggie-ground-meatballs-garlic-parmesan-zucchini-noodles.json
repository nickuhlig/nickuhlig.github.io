  "instructions": [
    {
      "id": 568081,
      "primary_message": "Preheat oven to 425°F. Coat a baking dish with a thin layer of butter.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 568082,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl. (Reserve a small handful of parsley for serving.)",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 568083,
      "primary_message": "Peel and mince garlic. Add half to the bowl with the parsley. (Reserve remaining garlic for later use.)",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 568084,
      "primary_message": "Mince sun-dried tomatoes. Add to the bowl along with veggie ground and spices. Using your hands, mix well to combine.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed\n8 oz veggie ground, plant based\n¼ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 568085,
      "primary_message": "Using a rounded tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and place in the baking dish.",
      "secondary_message": null
    },
    {
      "id": 568086,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 568087,
      "primary_message": "Meanwhile, wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. Place in a clean medium bowl.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 568088,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568089,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add reserved garlic and cook until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 568090,
      "primary_message": "Add zucchini and spices to the skillet. Cook, tossing occasionally, until zucchini noodles are just tender, 3-4 minutes.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 568091,
      "primary_message": "While the zucchini is cooking, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 568092,
      "primary_message": "When the zucchini noodles are just tender, add Parmesan to the skillet. Continue to cook, tossing frequently, until cheese melts, 1 minute more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 568093,
      "primary_message": "To serve, divide zucchini noodles and meatballs between plates or bowls. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
