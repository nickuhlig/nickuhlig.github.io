  "instructions": [
    {
      "id": 568107,
      "primary_message": "Preheat oven to 425°F. Coat two large baking dishes with a thin layer of butter.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 568108,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl. (Reserve a small handful of parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 568109,
      "primary_message": "Peel and mince garlic. Add half to the bowl with the parsley. (Reserve remaining garlic for later use.)",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 568110,
      "primary_message": "Mince sun-dried tomatoes. Add to the bowl along with veggie ground and spices. Using your hands, mix well to combine.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n24 oz veggie ground, plant based\n¾ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 568111,
      "primary_message": "Using a rounded tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and divide between the baking dishes.",
      "secondary_message": null
    },
    {
      "id": 568112,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 568113,
      "primary_message": "Meanwhile, wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. Place in a clean large bowl.",
      "secondary_message": "9 medium zucchini squash"
    },
    {
      "id": 568114,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568115,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add reserved garlic and cook until fragrant, 15-30 seconds.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 568116,
      "primary_message": "Add zucchini and spices to the pot. Cook, tossing occasionally, until zucchini noodles are just tender, 4-5 minutes.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 568117,
      "primary_message": "While the zucchini is cooking, finely grate Parmesan.",
      "secondary_message": "9 oz Parmesan cheese"
    },
    {
      "id": 568118,
      "primary_message": "When the zucchini noodles are just tender, add Parmesan to the pot. Continue to cook, tossing frequently, until cheese melts, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 568119,
      "primary_message": "To serve, divide zucchini noodles and meatballs between plates or bowls. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
