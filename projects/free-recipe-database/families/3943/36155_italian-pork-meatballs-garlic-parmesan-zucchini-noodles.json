  "instructions": [
    {
      "id": 568057,
      "primary_message": "Preheat oven to 425°F. Coat a large baking dish with a thin layer of butter.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 568058,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl. (Reserve a small handful of parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 568059,
      "primary_message": "Peel and mince garlic. Add half to the bowl with the parsley along with pork and spices. Using your hands, mix well to combine. (Reserve remaining garlic for later use.)",
      "secondary_message": "4 cloves garlic\n1 ½ lb lean ground pork\n½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 568060,
      "primary_message": "Using a rounded tablespoon measure, form the pork mixture into meatballs and place in the baking dish.",
      "secondary_message": null
    },
    {
      "id": 568061,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 568062,
      "primary_message": "Meanwhile, wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. Place in a clean medium bowl.",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 568063,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568064,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add reserved garlic and cook until fragrant, 15-30 seconds.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 568065,
      "primary_message": "Add zucchini noodles and spices to the skillet. Cook, tossing occasionally, until zucchini noodles are just tender, 3-4 minutes.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 568066,
      "primary_message": "While the zucchini is cooking, finely grate Parmesan.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 568067,
      "primary_message": "When the zucchini noodles are just tender, add Parmesan to the skillet. Continue to cook, tossing frequently, until cheese melts, 1 minute more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 568068,
      "primary_message": "To serve, divide zucchini noodles and meatballs between plates or bowls. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
