  "instructions": [
    {
      "id": 165155,
      "primary_message": "Wash and dry the mushrooms and beans. Thinly slice the mushrooms.",
      "secondary_message": "0.45 kg cremini mushrooms\n0.45 kg green beans"
    },
    {
      "id": 165156,
      "primary_message": "Peel and mince the garlic and place in a small bowl; add Dijon, honey, vinegar, salt, and pepper and whisk to combine.",
      "secondary_message": "4 cloves garlic\n¼ cup Dijon mustard\n2 tbsp honey\n2 tbsp white wine vinegar\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 165157,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 165158,
      "primary_message": "In a separate bowl, toss lamb chops in half the honey mustard sauce. Reserve the remaining, untouched sauce for later.",
      "secondary_message": "12 lamb loin chops"
    },
    {
      "id": 165159,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "id": 165160,
      "primary_message": "Place the lamb chops in the skillet; cook until they are nicely seared and cooked to your desired doneness, 3-4 minutes per side. Once done, transfer the chops to a plate and let them rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 165161,
      "primary_message": "Return the skillet to the heat; add oil and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until mushrooms soften, 4-5 min.",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "id": 165162,
      "primary_message": "Meanwhile, trim and discard the ends of the green beans.",
      "secondary_message": null
    },
    {
      "id": 165163,
      "primary_message": "Add beans to the skillet and continue to cook until beans are tender crisp, 2-3 min.",
      "secondary_message": null
    },
    {
      "id": 165164,
      "primary_message": "Add remaining, untouched sauce to the skillet with the veggies and cook until heated through, stirring frequently, 1 min more.",
      "secondary_message": null
    },
    {
      "id": 165165,
      "primary_message": "To serve, divide lamb chops between plates, arrange veggies on the side drizzling with any sauce remaining in the pan. Enjoy!",
      "secondary_message": null
    }
  ],
