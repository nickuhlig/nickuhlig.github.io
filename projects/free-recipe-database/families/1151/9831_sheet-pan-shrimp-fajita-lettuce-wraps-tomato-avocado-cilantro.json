  "instructions": [
    {
      "id": 156806,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 156807,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 156808,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 orange bell peppers\n2 yellow bell peppers\n1 head butter (Boston) lettuce\n2 tomatoes\n1 lime\n2 avocados\n1 small bunch cilantro"
    },
    {
      "id": 156809,
      "primary_message": "In a small bowl, mix together the spices; set aside.",
      "secondary_message": "1 ½ tsp chili powder\n1 tsp cumin\n1 tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 156810,
      "primary_message": "Seed and slice bell peppers into thin strips; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 156811,
      "primary_message": "Peel and mince garlic. Peel and thinly slice onion into half rings; transfer both to the bowl with the peppers. ",
      "secondary_message": "2 cloves garlic\n1 medium red onion"
    },
    {
      "id": 156812,
      "primary_message": "Add oil and approximately ⅔ of the spice mixture to the bowl with the veggies; toss to combine. Transfer veggies to a large baking sheet pan, place in the oven and bake until slightly soft, 8-10 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 156813,
      "primary_message": "Meanwhile, transfer shrimp to the bowl used for the veggies. Add more oil and remaining spice mix; toss to coat and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 156814,
      "primary_message": "Medium dice tomatoes and slice lime into wedges. Transfer both to a plate.",
      "secondary_message": null
    },
    {
      "id": 156815,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 156816,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 156817,
      "primary_message": "Remove veggies from the oven and toss. Layer shrimp on top and return to the oven; bake until shrimp are opaque and cooked through, 7-8 more minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 156818,
      "primary_message": "Meanwhile, separate the lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 156819,
      "primary_message": "Grate cheese.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 156820,
      "primary_message": "To serve, divide shrimp and veggies between plates and garnish with cilantro. Serve with lettuce leaves, cheese, tomato, avocado, yogurt, and lime wedges. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
