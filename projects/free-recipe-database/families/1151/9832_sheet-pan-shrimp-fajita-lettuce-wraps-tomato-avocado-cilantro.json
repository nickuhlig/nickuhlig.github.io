  "instructions": [
    {
      "id": 156821,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 156822,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 156823,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 orange bell peppers\n3 yellow bell peppers\n1 ½ heads butter (Boston) lettuce\n3 tomatoes\n1 ½ limes\n3 avocados\n1 small bunch cilantro"
    },
    {
      "id": 156824,
      "primary_message": "In a small bowl, mix together the spices; set aside.",
      "secondary_message": "2 tsp chili powder\n1 ½ tsp cumin\n1 ½ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 156825,
      "primary_message": "Seed and slice bell peppers into thin strips; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 156826,
      "primary_message": "Peel and mince garlic. Peel and thinly slice onions into half rings; transfer both to the bowl with the peppers. ",
      "secondary_message": "3 cloves garlic\n1 ½ medium red onions"
    },
    {
      "id": 156827,
      "primary_message": "Add oil and approximately ⅔ of the spice mixture to the bowl with the veggies; toss to combine. Divide veggies between 2 large baking sheet pans; place in the oven and bake until slightly soft, 10-12 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 156828,
      "primary_message": "Meanwhile, transfer shrimp to the bowl used for the veggies. Add more oil and remaining spice mix; toss to coat and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 156829,
      "primary_message": "Medium dice tomatoes and slice limes into wedges. Transfer both to a plate.",
      "secondary_message": null
    },
    {
      "id": 156830,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 156831,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 156832,
      "primary_message": "Remove veggies from the oven and toss. Layer shrimp on top and return to the oven; bake until shrimp are opaque and cooked through, 8-10 more minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 156833,
      "primary_message": "Meanwhile, separate the lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 156834,
      "primary_message": "Grate cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 156835,
      "primary_message": "To serve, divide shrimp and veggies between plates and garnish with cilantro. Serve with lettuce leaves, cheese, tomato, avocado, yogurt, and lime wedges. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
