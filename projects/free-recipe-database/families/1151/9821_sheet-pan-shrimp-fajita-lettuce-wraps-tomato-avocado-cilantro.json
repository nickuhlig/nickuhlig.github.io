  "instructions": [
    {
      "id": 156662,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 156663,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 156664,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 orange bell pepper\n1 yellow bell pepper\n½ head butter (Boston) lettuce\n1 tomato\n½ lime\n1 avocado\n½ small bunch cilantro"
    },
    {
      "id": 156665,
      "primary_message": "In a small bowl, mix together the spices; set aside.",
      "secondary_message": "¾ tsp chili powder\n½ tsp cumin\n½ tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 156666,
      "primary_message": "Seed and slice bell peppers into thin strips; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 156667,
      "primary_message": "Peel and mince garlic. Peel and thinly slice onion into half rings; transfer both to the bowl with the peppers. ",
      "secondary_message": "1 clove garlic\n½ medium red onion"
    },
    {
      "id": 156668,
      "primary_message": "Add oil and approximately ⅔ of the spice mixture to the bowl with the veggies; toss to combine. Transfer veggies to a baking sheet pan, place in the oven and bake until slightly soft, about 8 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 156669,
      "primary_message": "Meanwhile, transfer shrimp to the bowl used for the veggies. Add more oil and remaining spice mix; toss to coat and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 156670,
      "primary_message": "Medium dice tomato and slice lime into wedges. Transfer both to a plate.",
      "secondary_message": null
    },
    {
      "id": 156671,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 156672,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 156673,
      "primary_message": "Remove veggies from the oven and toss. Layer shrimp on top and return to the oven; bake until shrimp are opaque and cooked through, 7-8 more minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 156674,
      "primary_message": "Meanwhile, separate the lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 156675,
      "primary_message": "Grate cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 156676,
      "primary_message": "To serve, divide shrimp and veggies between plates and garnish with cilantro. Serve with lettuce leaves, cheese, tomato, avocado, yogurt, and lime wedges. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
