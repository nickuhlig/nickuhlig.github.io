  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Slice the fresh red Thai chiles.",
      "secondary_message": "8 medium cloves garlic\n2 fresh red Thai chiles"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat the oven to 220°C (425°F). Place eggplant on a foil-lined rimmed baking sheet and brush each eggplant all over with 1 tablespoon oil. Roast until tender and brown, 20 to 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a small heatproof bowl, combine garlic, chiles, oyster sauce, sugar, light soy sauce, and MSG, if using. In a small saucepan set over medium heat, heat the remaining 3 tablespoons oil until shimmering. Pour hot oil over garlic and chiles, add other seasonings, and stir well to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove eggplants from the oven and, using a paring knife, split the eggplant open by making an incision down the center of each eggplant (do not cut all the way through). Divide sauce between eggplants, spooning into each incision. Roast until the garlic begins to carmelize and brown, about 10 more minutes. Remove from heat, let cool slightly, garnish with scallions, and serve.",
      "secondary_message": null
    }
  ],
