  "instructions": [
    {
      "id": 244577,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions; drain in a colander and rinse.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 244578,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 medium carrots\n3 red bell peppers\n3 (2 ½ cm) pieces ginger root\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 244579,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 244580,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 244581,
      "primary_message": "Peel, trim, and cut carrots crosswise into ¼-inch thick rounds. Add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 244582,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 244583,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 244584,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper to the pot; cook, stirring occasionally, until tender-crisp, 6-7 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 ½ tbsp virgin coconut oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 244585,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Peel and small dice onion.",
      "secondary_message": "6 cloves garlic\n1 medium red onion"
    },
    {
      "id": 244586,
      "primary_message": "When the veggies are done, return them to the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 244587,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add garlic, ginger, and onion to the pot; cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 244588,
      "primary_message": "Add coconut milk, water, fish sauce, honey, and spices to the pot; stir to combine the sauce and bring to a simmer.",
      "secondary_message": "1 ½ (398 ml) cans coconut milk\n¾ cup water\n3 tbsp fish sauce\n1 ½ tsp honey\n1 ½ tsp turmeric, ground\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 244589,
      "primary_message": "Once the sauce is simmering, add drained rice noodles, edamame, and cooked veggies to the pot; stir to combine. Continue to cook, stirring occasionally, until noodles are warmed through and sauce has thickened slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 244590,
      "primary_message": "Meanwhile, cut lime into wedges; set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 244591,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 244592,
      "primary_message": "To serve, divide saucy noodles and veggies between bowls; top with a squeeze of lime and enjoy!",
      "secondary_message": null
    }
  ],
