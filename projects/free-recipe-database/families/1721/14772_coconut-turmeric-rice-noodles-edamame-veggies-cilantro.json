  "instructions": [
    {
      "id": 244545,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions; drain in a colander and rinse.",
      "secondary_message": "142 g flat rice (pad thai) noodles"
    },
    {
      "id": 244546,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 medium carrot\n1 red bell pepper\n1 (2 ½ cm) piece ginger root\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 244547,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 244548,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 244549,
      "primary_message": "Peel, trim, and cut carrot crosswise into ¼-inch thick rounds. Add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 244550,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 244551,
      "primary_message": "While the skillet heats up, trim, seed, and medium dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 244552,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper to the skillet; cook, stirring occasionally, until tender-crisp, about 5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 ½ tsp virgin coconut oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 244553,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Peel and small dice shallot.",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 244554,
      "primary_message": "When the veggies are done, return them to the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 244555,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add garlic, ginger, and shallot to the skillet; cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "1 ½ tsp virgin coconut oil"
    },
    {
      "id": 244556,
      "primary_message": "Add coconut milk, water, fish sauce, honey, and spices to the skillet; stir to combine the sauce and bring to a simmer.",
      "secondary_message": "½ (398 ml) can coconut milk\n¼ cup water\n1 tbsp fish sauce\n½ tsp honey\n½ tsp turmeric, ground\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 244557,
      "primary_message": "Once the sauce is simmering, add drained rice noodles, edamame, and cooked veggies to the skillet; stir to combine. Continue to cook, stirring occasionally, until noodles are warmed through and sauce has thickened slightly, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 244558,
      "primary_message": "Meanwhile, cut lime into wedges; set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 244559,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 244560,
      "primary_message": "To serve, divide saucy noodles and veggies between bowls; top with a squeeze of lime and enjoy!",
      "secondary_message": null
    }
  ],
