  "instructions": [
    {
      "id": 244561,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions; drain in a colander and rinse.",
      "secondary_message": "283 g flat rice (pad thai) noodles"
    },
    {
      "id": 244562,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 medium carrots\n2 red bell peppers\n2 (2 ½ cm) pieces ginger root\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 244563,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 244564,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 244565,
      "primary_message": "Peel, trim, and cut carrots crosswise into ¼-inch thick rounds. Add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 244566,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 244567,
      "primary_message": "While the skillet heats up, trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 244568,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper to the skillet; cook, stirring occasionally, until tender-crisp, about 5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp virgin coconut oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 244569,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Peel and small dice onion.",
      "secondary_message": "4 cloves garlic\n½ medium red onion"
    },
    {
      "id": 244570,
      "primary_message": "When the veggies are done, return them to the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 244571,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add garlic, ginger, and onion to the skillet; cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 244572,
      "primary_message": "Add coconut milk, water, fish sauce, honey, and spices to the skillet; stir to combine the sauce and bring to a simmer.",
      "secondary_message": "1 (398 ml) can coconut milk\n½ cup water\n2 tbsp fish sauce\n1 tsp honey\n1 tsp turmeric, ground\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 244573,
      "primary_message": "Once the sauce is simmering, add drained rice noodles, edamame, and cooked veggies to the skillet; stir to combine. Continue to cook, stirring occasionally, until noodles are warmed through and sauce has thickened slightly, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 244574,
      "primary_message": "Meanwhile, cut lime into wedges; set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 244575,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 244576,
      "primary_message": "To serve, divide saucy noodles and veggies between bowls; top with a squeeze of lime and enjoy!",
      "secondary_message": null
    }
  ],
