  "instructions": [
    {
      "id": 460914,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 jalapeño pepper\n½ small bunch cilantro\n1 mango\n½ English cucumber\n1 avocado"
    },
    {
      "id": 460915,
      "primary_message": "Juice lime and divide between two medium bowls. ",
      "secondary_message": null
    },
    {
      "id": 460916,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and divide between the two bowls. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 460917,
      "primary_message": "Shave cilantro leaves off the stems. Mince half of the leaves, add to one of the bowls, and set aside for the guacamole. Roughly chop remaining leaves, add to the remaining bowl, and stir to combine the dressing.",
      "secondary_message": null
    },
    {
      "id": 460918,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 460919,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl, along with oil and salt, then stir to combine the salad. Set aside.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 460920,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 460921,
      "primary_message": "Peel and mince shallot. Add to the bowl for the guacamole.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 460922,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh. Add to the bowl, along with salt, and mash with a fork or potato masher until guacamole is semi-smooth. ",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 460923,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the guacamole and lightly mash chickpeas until semi-smooth and combined.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 460924,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 460925,
      "primary_message": "Divide toast between plates and top with chickpea guacamole. Serve with mango-cucumber salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
