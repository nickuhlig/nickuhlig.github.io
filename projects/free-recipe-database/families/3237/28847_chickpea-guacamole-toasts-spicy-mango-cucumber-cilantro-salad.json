  "instructions": [
    {
      "id": 460926,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 jalapeño peppers\n1 small bunch cilantro\n2 mangoes\n1 English cucumber\n2 avocados"
    },
    {
      "id": 460927,
      "primary_message": "Juice limes and divide between two medium bowls. ",
      "secondary_message": null
    },
    {
      "id": 460928,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and divide between the two bowls. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 460929,
      "primary_message": "Shave cilantro leaves off the stems. Mince half of the leaves, add to one of the bowls, and set aside for the guacamole. Roughly chop remaining leaves, add to the remaining bowl, and stir to combine the dressing.",
      "secondary_message": null
    },
    {
      "id": 460930,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 460931,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl, along with oil and salt, then stir to combine the salad. Set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 460932,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 460933,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl for the guacamole.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 460934,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh. Add to the bowl, along with salt, and mash with a fork or potato masher until guacamole is semi-smooth. ",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 460935,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the guacamole and lightly mash chickpeas until semi-smooth and combined.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 460936,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 460937,
      "primary_message": "Divide toast between plates and top with chickpea guacamole. Serve with mango-cucumber salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
