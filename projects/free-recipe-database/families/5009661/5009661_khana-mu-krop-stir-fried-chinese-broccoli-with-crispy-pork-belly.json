  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the roast pork belly into 1/2- by 1/2- by 1-inch pieces. Trim and cut the Chinese broccoli into 1-inch pieces. Peel and smash the garlic. Smash the fresh bird's eye chiles.",
      "secondary_message": "1 lb roast pork belly\n1 lb Chinese broccoli\n2 large cloves garlic\n2 fresh bird's eye chiles"
    },
    {
      "id": 1,
      "primary_message": "Heat vegetable oil in a wok over high heat until lightly smoking.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add pork belly and stir to brown pieces on all sides, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add Chinese broccoli, garlic, chiles, oyster sauce, and sugar; stir.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cook until broccoli is tender-crisp, about 1 minute.",
      "secondary_message": null
    },
    {
