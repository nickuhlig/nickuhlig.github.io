  "instructions": [
    {
      "id": 378372,
      "primary_message": "Place turkey, carrots, bread crumbs, eggs, and spices in a large bowl. Use your hands to combine the turkey mixture. Using a ¼-cup measure, form the mixture into ½-inch thick fritters and place on a large plate.",
      "secondary_message": "1.02 kg ground turkey\n1 ½ (283 g) bags shredded carrots\n¾ cup panko bread crumbs\n3 eggs\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 378373,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 378374,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters to the skillet and cook, flipping once, until golden and cooked through, about 10 minutes. Remove to a clean plate.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 378375,
      "primary_message": "Meanwhile, wash and dry tomatoes. Halve lengthwise and place in a clean large bowl.",
      "secondary_message": "3 small pkgs grape tomatoes"
    },
    {
      "id": 378376,
      "primary_message": "Wash, dry, and cut snap peas crosswise into ½-inch pieces. Add to the bowl with the tomatoes.",
      "secondary_message": "3 (227 g) pkg sugar snap peas"
    },
    {
      "id": 378377,
      "primary_message": "Roughly chop olives. Add to the bowl along with the tzatziki and salt. Stir to combine the salad and set aside.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n¾ cup tzatziki sauce\n3 pinch salt"
    },
    {
      "id": 378378,
      "primary_message": "To serve, divide fritters and salad between plates; top fritters with additional tzatziki. Enjoy!",
      "secondary_message": "¾ cup tzatziki sauce"
    }
  ],
