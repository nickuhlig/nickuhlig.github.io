  "instructions": [
    {
      "id": 378358,
      "primary_message": "Place turkey, carrots, bread crumbs, egg, and spices in a medium bowl. Use your hands to combine the turkey mixture. Using a ¼-cup measure, form the mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": "⅓ kg ground turkey\n½ (283 g) bag shredded carrots\n¼ cup panko bread crumbs\n1 egg\n1 tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 378359,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 378360,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters to the skillet and cook, flipping once, until golden and cooked through, about 10 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 378361,
      "primary_message": "Meanwhile, wash and dry tomatoes. Halve lengthwise and place in a clean medium bowl.",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 378362,
      "primary_message": "Wash, dry, and cut snap peas crosswise into ½-inch pieces. Add to the bowl with the tomatoes.",
      "secondary_message": "1 (227 g) pkg sugar snap peas"
    },
    {
      "id": 378363,
      "primary_message": "Roughly chop olives. Add to the bowl along with the tzatziki and salt. Stir to combine the salad and set aside.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n¼ cup tzatziki sauce\n1 pinch salt"
    },
    {
      "id": 378364,
      "primary_message": "To serve, divide fritters and salad between plates; top fritters with additional tzatziki. Enjoy!",
      "secondary_message": "¼ cup tzatziki sauce"
    }
  ],
