  "instructions": [
    {
      "id": 452940,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch green onions (scallions)\n1 ½ English cucumbers\n1 ½ heads butter (Boston) lettuce\n3 tomatoes\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 452941,
      "primary_message": "Zest and juice lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 452942,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon along with mayo, Dijon, and spices. Whisk until smooth.",
      "secondary_message": "3 cloves garlic\n¾ cup mayonnaise\n1 tbsp Dijon mustard\n1 tbsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 452943,
      "primary_message": "Drain and rinse chickpeas; add to the bowl with the mayo dressing. Using a fork or potato masher, roughly mash chickpeas until semi-smooth. ",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 452944,
      "primary_message": "Roughly chop sun-dried tomatoes and olives. Add both to the bowl. ",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 452945,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, stir to combine the chickpea salad, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 452946,
      "primary_message": "Place oil, vinegar, and spices in another large bowl. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp oregano, dried\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 452947,
      "primary_message": "Drain and roughly chop artichokes. Add to the bowl with the dressing.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 452948,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 452949,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 452950,
      "primary_message": "Slice tomatoes into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 452951,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 452952,
      "primary_message": "Divide the chickpea salad between half of the slices and spread out in an even layer. Layer with tomato and sprouts, then close sandwiches with remaining slices of bread.",
      "secondary_message": null
    },
    {
      "id": 452953,
      "primary_message": "Slice sandwiches in half and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
