  "instructions": [
    {
      "id": 452926,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small bunch green onions (scallions)\n1 English cucumber\n1 head butter (Boston) lettuce\n2 tomatoes\n1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 452927,
      "primary_message": "Zest and juice lemon into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 452928,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon along with mayo, Dijon, and spices. Whisk until smooth.",
      "secondary_message": "2 cloves garlic\n½ cup mayonnaise\n2 tsp Dijon mustard\n2 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 452929,
      "primary_message": "Drain and rinse chickpeas; add to the bowl with the mayo dressing. Using a fork or potato masher, roughly mash chickpeas until semi-smooth. ",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 452930,
      "primary_message": "Roughly chop sun-dried tomatoes and olives. Add both to the bowl. ",
      "secondary_message": "8 sun-dried tomatoes, oil-packed\n¼ cup Kalamata olives, pitted"
    },
    {
      "id": 452931,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, stir to combine the chickpea salad, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 452932,
      "primary_message": "Place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 452933,
      "primary_message": "Drain and roughly chop artichokes. Add to the bowl with the dressing.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 452934,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 452935,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 452936,
      "primary_message": "Slice tomatoes into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 452937,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 452938,
      "primary_message": "Divide the chickpea salad between half of the slices and spread out in an even layer. Layer with tomato and sprouts, then close sandwiches with remaining slices of bread.",
      "secondary_message": null
    },
    {
      "id": 452939,
      "primary_message": "Slice sandwiches in half and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
