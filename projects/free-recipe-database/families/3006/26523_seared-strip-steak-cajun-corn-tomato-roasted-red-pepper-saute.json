  "instructions": [
    {
      "id": 472281,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 472282,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 472283,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 472284,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise. Place in a medium bowl. ",
      "secondary_message": "3 small pkgs grape tomatoes"
    },
    {
      "id": 472285,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl with the tomatoes. ",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers"
    },
    {
      "id": 472286,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 472287,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add tomatoes, peppers, corn, and spices; cook, stirring frequently, until veggies are tender and corn is warmed through, 4-5 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 ½ cups frozen corn\n2 tbsp Cajun seasoning\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 472288,
      "primary_message": "When the corn sauté is done, remove pot from heat, add vinaigrette, and stir to combine. ",
      "secondary_message": "⅓ cup French vinaigrette"
    },
    {
      "id": 472289,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 472290,
      "primary_message": "To serve, divide steak and corn sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
