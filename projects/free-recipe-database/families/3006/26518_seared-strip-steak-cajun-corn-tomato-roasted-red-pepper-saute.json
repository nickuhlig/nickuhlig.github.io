  "instructions": [
    {
      "id": 472235,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 472236,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 472237,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest. (Reserve skillet for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 472238,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise. Place in a small bowl. ",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 472239,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl with the tomatoes. ",
      "secondary_message": "½ (12 oz) jar roasted red bell peppers"
    },
    {
      "id": 472240,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium heat; add more oil and swirl to coat the bottom. Add tomatoes, peppers, corn, and spices; cook, stirring frequently, until veggies are tender and corn is warmed through, 3-4 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ cups frozen corn\n2 tsp Cajun seasoning\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 472241,
      "primary_message": "When the corn sauté is done, remove skillet from heat, add vinaigrette, and stir to combine. ",
      "secondary_message": "2 tbsp French vinaigrette"
    },
    {
      "id": 472242,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 472243,
      "primary_message": "To serve, divide steak and corn sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
