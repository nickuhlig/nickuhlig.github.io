  "instructions": [
    {
      "id": 396279,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg new potatoes\n1 small bunch asparagus\n½ bunch radish\n1 lemon"
    },
    {
      "id": 396280,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 396281,
      "primary_message": "While the eggs are cooking, halve potatoes. Place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to medium, and simmer until starting to soften, 8-10 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 396282,
      "primary_message": "Meanwhile, snap (or cut) off the woody ends of asparagus; cut spears in half crosswise. Once the potatoes start to soften, add asparagus to the pan and continue to cook until veggies are tender, 2-3 minutes more. Drain and rinse under cold water to cool.",
      "secondary_message": null
    },
    {
      "id": 396283,
      "primary_message": "While the veggies are cooking, trim and halve radishes lengthwise. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 396284,
      "primary_message": "Drain artichokes. Add to the plate with the radish.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 396285,
      "primary_message": "Halve olives lengthwise and add to the plate. Set aside.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 396286,
      "primary_message": "Peel and mince shallot. Place in a small bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 396287,
      "primary_message": "Juice lemon into the bowl with the shallot. Add oil, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 396288,
      "primary_message": "When potatoes and asparagus are cool, return to the pan and drizzle with half of the dressing. Gently toss to coat and set aside. (Reserve remaining dressing for serving.)",
      "secondary_message": null
    },
    {
      "id": 396289,
      "primary_message": "Drain tuna, place in another small bowl, and flake with a fork.",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 396290,
      "primary_message": "Peel and halve eggs. Season with salt and pepper.",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 396291,
      "primary_message": "To serve, divide tuna, eggs, potatoes, asparagus, radishes, artichokes, and olives between plates or bowls. Top with capers, drizzle with remaining dressing, and enjoy!",
      "secondary_message": "1 tbsp capers"
    }
  ],
