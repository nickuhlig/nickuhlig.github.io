  "instructions": [
    {
      "id": 396305,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n3 small bunches asparagus\n1 ½ bunches radish\n3 lemons"
    },
    {
      "id": 396306,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "9 eggs"
    },
    {
      "id": 396307,
      "primary_message": "While the eggs are cooking, halve potatoes. Place in another large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to medium, and simmer until starting to soften, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 396308,
      "primary_message": "Meanwhile, snap (or cut) off the woody ends of asparagus; cut spears in half crosswise. Once the potatoes start to soften, add asparagus to the pot and continue to cook until veggies are tender, 2-3 minutes more. Drain and rinse under cold water to cool.",
      "secondary_message": null
    },
    {
      "id": 396309,
      "primary_message": "While the veggies are cooking, trim and halve radishes lengthwise. Transfer to a large plate.",
      "secondary_message": null
    },
    {
      "id": 396310,
      "primary_message": "Drain artichokes. Add to the plate with the radish.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 396311,
      "primary_message": "Halve olives lengthwise and add to the plate. Set aside.",
      "secondary_message": "1 ½ cups Kalamata olives, pitted"
    },
    {
      "id": 396312,
      "primary_message": "Peel and mince shallots. Place in a small bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 396313,
      "primary_message": "Juice lemons into the bowl with the shallot. Add oil, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "½ cup extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 396314,
      "primary_message": "When potatoes and asparagus are cool, return to the pot and drizzle with half of the dressing. Gently toss to coat and set aside. (Reserve remaining dressing for serving.)",
      "secondary_message": null
    },
    {
      "id": 396315,
      "primary_message": "Drain tuna, place in a medium bowl, and flake with a fork.",
      "secondary_message": "3 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 396316,
      "primary_message": "Peel and halve eggs. Season with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 396317,
      "primary_message": "To serve, divide tuna, eggs, potatoes, asparagus, radishes, artichokes, and olives between plates or bowls. Top with capers, drizzle with remaining dressing, and enjoy!",
      "secondary_message": "3 tbsp capers"
    }
  ],
