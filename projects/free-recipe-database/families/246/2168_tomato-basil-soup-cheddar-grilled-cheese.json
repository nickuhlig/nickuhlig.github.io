  "instructions": [
    {
      "id": 20558,
      "primary_message": "Remove butter from fridge and allow to soften in the microwave or on the counter.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 20559,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 20560,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\r\n2 cloves garlic"
    },
    {
      "id": 20561,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and garlic; begin cooking while you chop the carrot and celery.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 20562,
      "primary_message": "Wash and thinly slice carrot and celery; add to saucepan. Stirring occasionally, cook until carrots and celery have softened, 6-7 minutes.",
      "secondary_message": "1 medium carrot\r\n1 stick celery"
    },
    {
      "id": 20563,
      "primary_message": "Wash and medium dice tomatoes.",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 20564,
      "primary_message": "Wash basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 20565,
      "primary_message": "Add fresh and canned tomatoes, broth, salt, and pepper to saucepan. Stir and bring to a boil. Reduce heat, cover, and simmer for about 10 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n236 ml (1 cup) chicken or vegetable broth\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 20566,
      "primary_message": "Heat a skillet over medium-low heat.",
      "secondary_message": ""
    },
    {
      "id": 20567,
      "primary_message": "Grate ½ cup of cheddar.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 20568,
      "primary_message": "Spread butter onto 1 side of each bread slice and place buttered-side down on a flat surface.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 20569,
      "primary_message": "Divide cheddar between 2 of the bread slices and top with the other slices. Place in the skillet and gently press down with a spatula. Cook until cheese is melted and bread is golden brown, 2-4 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 20570,
      "primary_message": "Add basil to the soup and stir. Purée soup until smooth using a hand or regular blender.",
      "secondary_message": ""
    },
    {
      "id": 20571,
      "primary_message": "Pour soup into a bowl and service with grilled cheese on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
