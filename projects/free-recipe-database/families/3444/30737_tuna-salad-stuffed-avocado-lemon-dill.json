  "instructions": [
    {
      "id": 487557,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ small bunch fresh dill\n2 avocados"
    },
    {
      "id": 487558,
      "primary_message": "Drain tuna, place in a medium bowl, and flake with a fork.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 487559,
      "primary_message": "Juice lemon into the bowl with the tuna.",
      "secondary_message": null
    },
    {
      "id": 487560,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl along with mayo, Dijon, and spices, then stir to combine the tuna salad.",
      "secondary_message": "¼ cup mayonnaise\n2 tsp Dijon mustard\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 487561,
      "primary_message": "Halve and pit avocados (leaving them inside the skin), then season with salt and pepper. Divide the tuna salad between avocado halves.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 487562,
      "primary_message": "To serve, divide stuffed avocados between plates. Enjoy!",
      "secondary_message": null
    }
  ],
