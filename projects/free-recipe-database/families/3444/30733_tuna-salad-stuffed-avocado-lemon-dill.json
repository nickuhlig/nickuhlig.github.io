  "instructions": [
    {
      "id": 487533,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n¼ small bunch fresh dill\n1 avocado"
    },
    {
      "id": 487534,
      "primary_message": "Drain tuna, place in a small bowl, and flake with a fork.",
      "secondary_message": "1 (6 oz) can chunk light tuna in water"
    },
    {
      "id": 487535,
      "primary_message": "Juice lemon into the bowl with the tuna.",
      "secondary_message": null
    },
    {
      "id": 487536,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl along with mayo, Dijon, and spices, then stir to combine the tuna salad.",
      "secondary_message": "2 tbsp avocado oil mayonnaise\n1 tsp Dijon mustard\n¼ tsp garlic powder\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 487537,
      "primary_message": "Halve and pit avocado (leaving it inside the skin), then season with salt and pepper. Divide the tuna salad between avocado halves.",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 487538,
      "primary_message": "To serve, divide stuffed avocados between plates. Enjoy!",
      "secondary_message": null
    }
  ],
