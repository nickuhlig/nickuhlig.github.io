  "instructions": [
    {
      "id": 487581,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n½ small bunch fresh dill\n3 avocados"
    },
    {
      "id": 487582,
      "primary_message": "Drain tuna, place in a medium bowl, and flake with a fork.",
      "secondary_message": "3 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 487583,
      "primary_message": "Juice lemons into the bowl with the tuna.",
      "secondary_message": null
    },
    {
      "id": 487584,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl along with mayo, Dijon, and spices, then stir to combine the tuna salad.",
      "secondary_message": "⅓ cup avocado oil mayonnaise\n1 tbsp Dijon mustard\n¾ tsp garlic powder\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 487585,
      "primary_message": "Halve and pit avocados (leaving them inside the skin), then season with salt and pepper. Divide the tuna salad between avocado halves.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 487586,
      "primary_message": "To serve, divide stuffed avocados between plates. Enjoy!",
      "secondary_message": null
    }
  ],
