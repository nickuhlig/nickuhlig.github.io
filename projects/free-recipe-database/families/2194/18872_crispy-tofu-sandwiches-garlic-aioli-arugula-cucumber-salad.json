  "instructions": [
    {
      "id": 310711,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 310712,
      "primary_message": "Cut tofu into ½-inch thick planks along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 310713,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lemon\n½ English cucumber\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 310714,
      "primary_message": "Zest lemon into a small bowl (reserve lemon for the dressing). Add mayo and spices, then stir to combine the aioli. ",
      "secondary_message": "¼ cup vegan mayonnaise\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 310715,
      "primary_message": "Place tofu on the baking sheet. Spread 1 tablespoon aioli over top side of the tofu, sprinkle with half of the bread crumbs, and drizzle with half of the oil. Carefully flip tofu and repeat with 1 tablespoon aioli, remaining bread crumbs, and remaining oil. (Reserve remaining aioli for sandwiches.)",
      "secondary_message": "½ cup panko bread crumbs\n2 tsp extra virgin olive oil"
    },
    {
      "id": 310716,
      "primary_message": "Place tofu in the oven and bake, turning once, until the breading is crispy and golden brown, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 310717,
      "primary_message": "Meanwhile, juice the lemon into a medium bowl. Add oil, maple syrup, Dijon, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n1 tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 310718,
      "primary_message": "Trim and thinly slice cucumber crosswise into rounds; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 310719,
      "primary_message": "Add broccoli slaw and arugula to the bowl; toss to combine the salad.",
      "secondary_message": "½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 310720,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 310721,
      "primary_message": "Spread the remaining aioli over both halves of each bun. Layer each with a small portion of salad (reserving the rest for serving) and crispy tofu.",
      "secondary_message": null
    },
    {
      "id": 310722,
      "primary_message": "To serve, divide sandwiches and reserved salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
