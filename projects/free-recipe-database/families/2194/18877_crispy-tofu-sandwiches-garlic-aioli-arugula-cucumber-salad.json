  "instructions": [
    {
      "id": 310771,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 310772,
      "primary_message": "Cut tofu into ½-inch thick planks along the short side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 310773,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 310774,
      "primary_message": "Zest lemons into a small bowl (reserve lemons for the dressing). Add mayo and spices, then stir to combine the aioli. ",
      "secondary_message": "¾ cup mayonnaise\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 310775,
      "primary_message": "Place tofu on the baking sheet. Spread 1 tablespoon aioli over top side of the tofu, sprinkle with half of the bread crumbs, and drizzle with half of the oil. Carefully flip tofu and repeat with 1 tablespoon aioli, remaining bread crumbs, and remaining oil. (Reserve remaining aioli for sandwiches.)",
      "secondary_message": "1 ½ cup panko bread crumbs\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 310776,
      "primary_message": "Place tofu in the oven and bake, turning once, until the breading is crispy and golden brown, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 310777,
      "primary_message": "Meanwhile, juice the lemons into a large bowl. Add oil, maple syrup, Dijon, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 tbsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 310778,
      "primary_message": "Trim and thinly slice cucumbers crosswise into rounds; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 310779,
      "primary_message": "Add broccoli slaw and arugula to the bowl; toss to combine the salad.",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 310780,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 310781,
      "primary_message": "Spread the remaining aioli over both halves of each bun. Layer each with a small portion of salad (reserving the rest for serving) and crispy tofu.",
      "secondary_message": null
    },
    {
      "id": 310782,
      "primary_message": "To serve, divide sandwiches and reserved salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
