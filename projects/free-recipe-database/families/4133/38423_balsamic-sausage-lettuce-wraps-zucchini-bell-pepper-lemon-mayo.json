  "instructions": [
    {
      "id": 599672,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 orange bell peppers\n1 lemon\n1 head butter (Boston) lettuce"
    },
    {
      "id": 599673,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 599674,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 599675,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 599676,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 599677,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, garlic, sausage, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly and veggies are tender, 5-6 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n0.45 kg ground pork sausage\n1 tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 599678,
      "primary_message": "Meanwhile, juice lemon into a small bowl. Add mayo and spices, then whisk to combine the sauce. Set aside.",
      "secondary_message": "⅓ cup avocado oil mayonnaise\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 599679,
      "primary_message": "When the sausage and veggies are done, add vinegar to the skillet and stir to combine. Remove from heat.",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 599680,
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; top with sausage and veggies. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
