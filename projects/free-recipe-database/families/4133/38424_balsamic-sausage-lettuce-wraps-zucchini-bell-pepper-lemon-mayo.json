  "instructions": [
    {
      "id": 599681,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 orange bell peppers\n1 ½ lemons\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 599682,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 599683,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 599684,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 599685,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 599686,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, sausage, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly and veggies are tender, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n0.68 kg ground pork sausage\n1 ½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 599687,
      "primary_message": "Meanwhile, juice lemons into a small bowl. Add mayo and spices, then whisk to combine the sauce. Set aside.",
      "secondary_message": "½ cup avocado oil mayonnaise\n¾ tsp Italian seasoning\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 599688,
      "primary_message": "When the sausage and veggies are done, add vinegar to the pot and stir to combine. Remove from heat.",
      "secondary_message": "3 tbsp balsamic vinegar"
    },
    {
      "id": 599689,
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; top with sausage and veggies. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
