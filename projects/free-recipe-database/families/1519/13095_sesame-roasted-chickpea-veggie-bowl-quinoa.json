  "instructions": [
    {
      "id": 219574,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 219575,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 219576,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 crowns broccoli\n0.68 kg cremini mushrooms\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 219577,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 219578,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into half rounds. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 219579,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 219580,
      "primary_message": "Quarter mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 219581,
      "primary_message": "Peel and mince garlic and ginger; add to the bowl along with oil, salt, and pepper. Toss to combine, divide between two baking sheet pans, and spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n¼ cup toasted sesame oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 219582,
      "primary_message": "Place veggies in the oven and roast until starting to brown, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 219583,
      "primary_message": "Meanwhile, place chickpeas, oil, and soy sauce in the bowl used for the veggies; stir to coat.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp soy sauce"
    },
    {
      "id": 219584,
      "primary_message": "Once the veggies are starting to brown, add seasoned chickpeas to the baking sheets; return to the oven and continue to bake until the veggies are fork-tender, 7-8 minutes more.",
      "secondary_message": null
    },
    {
      "id": 219585,
      "primary_message": "Place additional soy sauce, maple syrup, and chili-garlic sauce in the bowl; whisk to combine the sauce.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp pure maple syrup\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 219586,
      "primary_message": "To serve, divide quinoa between bowls. Top with roasted chickpeas, veggies, and sesame seeds. Drizzle with sauce and enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
