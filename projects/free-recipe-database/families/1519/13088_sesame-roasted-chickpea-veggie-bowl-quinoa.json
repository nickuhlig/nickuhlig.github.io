  "instructions": [
    {
      "id": 219483,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 219484,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 219485,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 crowns broccoli\n1 lb cremini mushrooms\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 219486,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 219487,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into half rounds. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 219488,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 219489,
      "primary_message": "Quarter mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 219490,
      "primary_message": "Peel and mince garlic and ginger; add to the bowl along with oil, salt, and pepper. Toss to combine, transfer to a large baking sheet pan, and spread out in an even layer.",
      "secondary_message": "4 cloves garlic\n3 tbsp toasted sesame oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 219491,
      "primary_message": "Place veggies in the oven and roast until starting to brown, about 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 219492,
      "primary_message": "Meanwhile, place chickpeas, oil, and soy sauce in the bowl used for the veggies; stir to coat.",
      "secondary_message": "4 tsp toasted sesame oil\n4 tsp soy sauce"
    },
    {
      "id": 219493,
      "primary_message": "Once the veggies are starting to brown, add seasoned chickpeas to the baking sheet; return to the oven and continue to bake until the veggies are fork-tender, 5-7 minutes more.",
      "secondary_message": null
    },
    {
      "id": 219494,
      "primary_message": "Place additional soy sauce, maple syrup, and chili-garlic sauce in the bowl; whisk to combine the sauce.",
      "secondary_message": "2 tbsp soy sauce\n4 tsp pure maple syrup\n1 tsp chili-garlic sauce"
    },
    {
      "id": 219495,
      "primary_message": "To serve, divide quinoa between bowls. Top with roasted chickpeas, veggies, and sesame seeds. Drizzle with sauce and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
