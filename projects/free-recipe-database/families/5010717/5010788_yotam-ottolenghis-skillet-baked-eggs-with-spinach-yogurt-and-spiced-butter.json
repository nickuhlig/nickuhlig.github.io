  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince or press the garlic clove through a garlic press. Chop the leek. Chop the scallions. Juice the lemon. Pick the oregano leaves from the stems and chop them.",
      "secondary_message": "1 medium garlic clove\n1 large leek\n4 scallions\n½ lemon\n1 tsp fresh oregano"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, combine the yogurt, garlic, and a pinch of salt. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven to center rack and preheat oven to 150°C (300°F). In a 30-cm skillet, heat 1 tablespoon of butter over medium heat until the foam subsides. Lower the heat to low, then add the leek and scallion and cook until completely soft and golden, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add as much spinach as will fit and lemon juice to the skillet, along with a pinch of salt. Increase the heat to medium-high and cook, stirring frequently and adding spinach a handful at a time as it wilts until all the spinach is just wilted, 4 to 5 minutes. Taste and season with salt or more lemon juice as needed.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Using tongs, remove the spinach to a second 25-cm oven-proof skillet, leaving any excess liquid behind. Make 4 indentations in the spinach and crack the eggs into them, taking care to keep the yolks intact. Sprinkle each egg with a pinch of salt, then transfer to the oven and cook until the whites are just set, 10 to 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Meanwhile, melt the last tablespoon of butter in a small skillet over medium-low heat. Add the chili powder and/or paprika and continue cooking until the butter just begins to brown. Add the oregano and cook for 30 seconds longer, then remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Serve the baked eggs with the yogurt mixture, and top with the spiced butter.",
      "secondary_message": null
    }
  ],
