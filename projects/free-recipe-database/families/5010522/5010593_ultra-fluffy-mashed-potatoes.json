  "instructions": [
    {
      "id": 1,
      "primary_message": "Peel potatoes and cut into 1- or 5-cm cubes. Transfer to a pot of cold water and rinse, changing water 2 or 3 times until it runs clear. Cover potatoes with fresh cold water and season generously with salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Set potatoes over medium-high heat and bring to a boil, then reduce heat to maintain a gentle simmer. Cook until potatoes are completely tender, about 15 minutes after reaching a simmer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Drain potatoes in a colander and rinse under hot running water for 30 seconds to wash away excess starch. Allow potatoes to steam for 1 minute to remove excess moisture.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Set a ricer or food mill over now-empty pot and pass potatoes through.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add butter and gently fold into potatoes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Mound potatoes into the center of the pot and pour milk all around. Set over medium heat and bring milk to a simmer before gently folding it into the potatoes. If looser potatoes are desired, add additional milk in a similar fashion around the mashed potato mass and bring it to a simmer before folding into potatoes. Season with salt and pepper, then serve.",
      "secondary_message": null
    }
  ],
