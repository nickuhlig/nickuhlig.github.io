  "instructions": [
    {
      "id": 382798,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 382799,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 382800,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside.",
      "secondary_message": null
    },
    {
      "id": 382801,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n3 avocados\n6 hearts romaine hearts"
    },
    {
      "id": 382802,
      "primary_message": "Using a clean cutting board, roughly chop eggs. Place on a large plate.",
      "secondary_message": "6 hard-cooked eggs, peeled"
    },
    {
      "id": 382803,
      "primary_message": "Halve tomatoes lengthwise. Add to the plate with the egg.",
      "secondary_message": null
    },
    {
      "id": 382804,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 382805,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 382806,
      "primary_message": "To serve, divide lettuce between plates or bowls; top with tomatoes, avocado, bacon, eggs, and feta. Drizzle with dressing and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup honey mustard dressing"
    }
  ],
