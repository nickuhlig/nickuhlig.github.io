  "instructions": [
    {
      "id": 382825,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 382826,
      "primary_message": "Drain and rinse chickpeas, then divide between two baking sheet pans. Drizzle with oil, season with garlic powder and salt, then stir to coat; spread out in an even layer.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 382827,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are golden and crispy, about 20 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 382828,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n3 avocados\n6 hearts romaine hearts"
    },
    {
      "id": 382829,
      "primary_message": "Roughly chop eggs. Place on a large plate.",
      "secondary_message": "6 hard-cooked eggs, peeled"
    },
    {
      "id": 382830,
      "primary_message": "Halve tomatoes lengthwise. Add to the plate with the egg.",
      "secondary_message": null
    },
    {
      "id": 382831,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 382832,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 382833,
      "primary_message": "To serve, divide lettuce between plates or bowls; top with tomatoes, avocado, crispy chickpeas, eggs, and feta. Drizzle with dressing and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup honey mustard dressing"
    }
  ],
