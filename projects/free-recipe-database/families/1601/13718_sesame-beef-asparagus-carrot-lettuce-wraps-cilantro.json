  "instructions": [
    {
      "id": 228166,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n2 (2 ½ cm) pieces ginger root\n4 medium carrots\n1 small bunch cilantro\n1 lime\n1 head butter (Boston) lettuce"
    },
    {
      "id": 228167,
      "primary_message": "Snap or cut off the woody ends of the asparagus and cut into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 228168,
      "primary_message": "In a medium saucepan, bring a ½-inch of water to a boil over high heat. Add asparagus and cook, uncovered, until crisp-tender, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 228169,
      "primary_message": "Meanwhile, peel and mince or grate ginger; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 228170,
      "primary_message": "Add soy sauce, oil, and vinegar to the bowl with the ginger; whisk to combine the dressing.",
      "secondary_message": "¼ cup soy sauce\n3 tbsp toasted sesame oil\n4 tsp rice vinegar"
    },
    {
      "id": 228171,
      "primary_message": "When the asparagus is done, drain and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 228172,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 228173,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 228174,
      "primary_message": "Once the grill pan is hot, coat with oil. Add steak and grill until desired doneness, 2-5 minutes per side. Transfer to a clean plate, cover loosely with aluminum foil, and set aside to rest for about 5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 228175,
      "primary_message": "Meanwhile, peel and trim carrots. Using a julienne (or regular) peeler, peel carrots into thin noodle-like sticks; add to bowl with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 228176,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 228177,
      "primary_message": "Slice lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 228178,
      "primary_message": "Thinly slice steak against the grain and add to the bowl with the vegetables. Toss to combine.",
      "secondary_message": null
    },
    {
      "id": 228179,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill with steak, vegetables, and cilantro; sprinkle with sesame seeds. Serve with lime wedges on the side and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
