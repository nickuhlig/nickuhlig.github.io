  "instructions": [
    {
      "id": 342019,
      "primary_message": "Using a strainer, rinse lentils under cold water and place in a small saucepan; add broth and bring to a boil over high heat.",
      "secondary_message": "½ cup brown lentils, dried\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 342020,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook lentils until tender, about 15 minutes; drain and rinse with cold water (from the tap) to cool. Set aside.",
      "secondary_message": null
    },
    {
      "id": 342021,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ English cucumber\n½ small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 342022,
      "primary_message": "Zest and juice lemon into a medium bowl; add oil, Dijon, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 342023,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 342024,
      "primary_message": "Trim and medium dice cucumber; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 342025,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 342026,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 342027,
      "primary_message": "Once the grill pan is hot, coat with oil. Place sausages on the pan and cook, turning occasionally, until warmed through, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "1 tsp extra virgin olive oil\n2 pre-cooked vegan sausage"
    },
    {
      "id": 342028,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 342029,
      "primary_message": "Add lentils, sausage, and spinach to the bowl with the dressing and veggies; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 342030,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
