  "instructions": [
    {
      "id": 342043,
      "primary_message": "Using a strainer, rinse lentils under cold water and place in a medium saucepan; add broth and bring to a boil over high heat.",
      "secondary_message": "1 ½ cups brown lentils, dried\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 342044,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook lentils until tender, about 15 minutes; drain and rinse with cold water (from the tap) to cool. Set aside.",
      "secondary_message": null
    },
    {
      "id": 342045,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n1 small bunch Italian (flat-leaf) parsley\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 342046,
      "primary_message": "Zest and juice lemons into a large bowl; add oil, Dijon, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 342047,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 342048,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 342049,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 342050,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 342051,
      "primary_message": "Once the grill pan is hot, coat with oil. Place sausages on the pan and cook, turning occasionally, until warmed through, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 342052,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 342053,
      "primary_message": "Add lentils, sausage, and spinach to the bowl with the dressing and veggies; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 342054,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
