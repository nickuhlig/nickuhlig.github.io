  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thaw the frozen phyllo dough. Melt the unsalted butter. Chop the strawberries.",
      "secondary_message": "4 sheets frozen phyllo dough\n2 tbsp unsalted butter\n¾ cup strawberries"
    },
    {
      "id": 1,
      "primary_message": "Place oven rack in upper middle position and preheat oven to 350°F. Grease a 12-well muffin tin tray. Lay one sheet phyllo dough on a clean work surface. Brush all over with butter. Lay second sheet over phyllo on top and brush with butter. Cut into 12 squares. Place in prepared muffin tin. Butter a remaining sheet of phyllo and top it with final sheet. Brush all over with butter and cut into 12 squares. Place a square in each muffin tin, alternating corner points with first square. Bake until phyllo is golden, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Let phyllo cups cool to room temperature. Fill each cup with about 1 1/2 tablespoons Greek yogurt and top with 1 tablespoon strawberries. Drizzle each cup with honey.",
      "secondary_message": null
    }
  ],
