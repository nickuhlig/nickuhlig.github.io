  "instructions": [
    {
      "id": 494485,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n1 ½ English cucumbers\n1 ½ orange bell peppers\n1 small bunch fresh dill\n1 ½ lemons"
    },
    {
      "id": 494486,
      "primary_message": "Place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 494487,
      "primary_message": "Small dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 494488,
      "primary_message": "Small dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494489,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494490,
      "primary_message": "Roughly chop olives. Add to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 494491,
      "primary_message": "Peel and mince shallot. Place in a medium bowl along with chicken and spices. Mix with your hands until well combined.",
      "secondary_message": "1 shallot\n1 ½ lb ground chicken\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 494492,
      "primary_message": "Arrange tortillas on a flat surface, then divide the chicken mixture between them (about 2 tablespoons per tortilla). Using a knife (or your hands), spread the chicken mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 494493,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 494494,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, meat-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the chicken is cooked through, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 494495,
      "primary_message": "Flip tacos, chicken-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a large plate and carefully fold in half to form tacos. ",
      "secondary_message": null
    },
    {
      "id": 494496,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 494497,
      "primary_message": "Juice lemons into the bowl with the dill. Add yogurt, sugar, and salt, then stir to combine the dill yogurt. ",
      "secondary_message": "1 cup plain Greek yogurt\n¾ tsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 494498,
      "primary_message": "Divide tacos between plates. Fill each with a small portion of salad and drizzle with dill yogurt. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
