  "instructions": [
    {
      "id": 494639,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 tomatoes\n1 English cucumber\n1 orange bell pepper\n1 small bunch fresh dill\n1 lemon"
    },
    {
      "id": 494640,
      "primary_message": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 494641,
      "primary_message": "Small dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 494642,
      "primary_message": "Small dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494643,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494644,
      "primary_message": "Roughly chop olives. Add to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 494645,
      "primary_message": "Peel and mince shallot. Place in another medium bowl along with chicken and spices. Mix with your hands until well combined.",
      "secondary_message": "1 shallot\n0.45 kg ground chicken\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 494646,
      "primary_message": "Arrange tortillas on a flat surface, then divide the chicken mixture between them (about 2 tablespoons per tortilla). Using a knife (or your hands), spread the chicken mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 494647,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 494648,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, meat-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the chicken is cooked through, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 494649,
      "primary_message": "Flip tacos, chicken-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a plate and carefully fold in half to form tacos. ",
      "secondary_message": null
    },
    {
      "id": 494650,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 494651,
      "primary_message": "Juice lemon into the bowl with the dill. Add yogurt, sugar, and salt, then stir to combine the dill yogurt. ",
      "secondary_message": "⅔ cup plain Greek yogurt\n½ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 494652,
      "primary_message": "Divide tacos between plates. Fill each with a small portion of salad and drizzle with dill yogurt. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
