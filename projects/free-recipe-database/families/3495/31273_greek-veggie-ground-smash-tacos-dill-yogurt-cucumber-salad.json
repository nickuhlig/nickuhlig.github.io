  "instructions": [
    {
      "id": 494499,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n½ English cucumber\n½ orange bell pepper\n½ small bunch fresh dill\n½ lemon"
    },
    {
      "id": 494500,
      "primary_message": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 494501,
      "primary_message": "Small dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 494502,
      "primary_message": "Small dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494503,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494504,
      "primary_message": "Roughly chop olives. Add to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 494505,
      "primary_message": "Peel and mince shallot. Place in another medium bowl along with veggie ground and spices. Mix with your hands until well combined.",
      "secondary_message": "½ shallot\n8 oz veggie ground, plant based\n½ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 494506,
      "primary_message": "Arrange tortillas on a flat surface, then divide the veggie ground mixture between them (about 2 tablespoons per tortilla). Using a knife (or your hands), spread the veggie ground mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 494507,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 494508,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, veggie ground-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the veggie ground is cooked through, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 494509,
      "primary_message": "Flip tacos, veggie ground-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a plate and carefully fold in half to form tacos. ",
      "secondary_message": null
    },
    {
      "id": 494510,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 494511,
      "primary_message": "Juice lemon into the bowl with the dill. Add yogurt, sugar, and salt, then stir to combine the dill yogurt. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n¼ tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 494512,
      "primary_message": "Divide tacos between plates. Fill each with a small portion of salad and drizzle with dill yogurt. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
