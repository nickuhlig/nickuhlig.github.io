  "instructions": [
    {
      "id": 445485,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 heart romaine hearts\n½ English cucumber\n½ mango\n1 avocado"
    },
    {
      "id": 445486,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 445487,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 445488,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; cut into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 445489,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; add to the bowl.",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 445490,
      "primary_message": "Add shredded cabbage, almonds, and dressing to the bowl. Toss to combine the salad.",
      "secondary_message": "½ (14 oz) bag shredded cabbage (coleslaw mix)\n⅓ cup almonds, sliced\n⅓ cup sesame ginger dressing"
    },
    {
      "id": 445491,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 445492,
      "primary_message": "To serve, divide salad between plates or bowls; top with avocado and sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
