  "instructions": [
    {
      "id": 131080,
      "primary_message": "Wash and juice oranges into a pot.",
      "secondary_message": "3 oranges"
    },
    {
      "id": 131081,
      "primary_message": "Add salt and water to the pot, cover, and bring to a boil over high heat. Once boiling, stir in oats, cranberries, cinnamon, and maple syrup; reduce heat to medium-low. Cover and let simmer for 3-5 minutes or until oats reach desired consistency. ",
      "secondary_message": "3 pinch salt\n5 ¼ cup water\n3 cup oats, quick cooking\n1 ½ cups dried cranberries\n1 ½ tsp cinnamon\n2 tbsp pure maple syrup"
    },
    {
      "id": 131082,
      "primary_message": "Roughly chop the pistachios.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 131083,
      "primary_message": "To serve, divide oats between bowls and top with pistachios and milk. Enjoy! ",
      "secondary_message": "355 ml whole milk"
    }
