  "instructions": [
    {
      "id": 428118,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). ",
      "secondary_message": "510 g cheese tortellini, fresh or frozen"
    },
    {
      "id": 428119,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg grape tomatoes\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 428120,
      "primary_message": "Halve tomatoes and place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 428121,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl with the tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 428122,
      "primary_message": "Roughly chop peppers and add to the bowl. ",
      "secondary_message": "1 (340 g) jar roasted red bell peppers"
    },
    {
      "id": 428123,
      "primary_message": "Roughly chop olives; add to the bowl along with the arugula and cheese.",
      "secondary_message": "⅔ cup Kalamata olives, pitted\n⅔ cup Parmesan cheese, shredded"
    },
    {
      "id": 428124,
      "primary_message": "When the tortellini is done, drain and rinse under cold water to cool. Add to the bowl along with dressing, salt, and pepper; stir to combine the pasta salad. ",
      "secondary_message": "½ cup Italian salad dressing\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 428125,
      "primary_message": "To serve, divide pasta salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
