  "instructions": [
    {
      "id": 174957,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n½ small bunch Italian (flat-leaf) parsley\n2 lemons"
    },
    {
      "id": 174958,
      "primary_message": "Heat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 174959,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces; season with spices.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n2 tsp Italian seasoning\n½ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 174960,
      "primary_message": "When the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 174961,
      "primary_message": "Add chicken to the skillet and cook, stirring occasionally, until cooked through and golden brown, 7-8 minutes. Transfer to a plate and set aside. ",
      "secondary_message": null
    },
    {
      "id": 174962,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 174963,
      "primary_message": "Once the chicken has been removed, add garlic and broth to the skillet and stir; bring to a boil over high heat. Reduce heat and simmer, until reduced by half, about 6-7 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 174964,
      "primary_message": "Snap or cut off the woody ends of the asparagus; cut into 2-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 174965,
      "primary_message": "Add asparagus to the skillet. Stir to combine and cook until tender, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 174966,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince leaves.",
      "secondary_message": null
    },
    {
      "id": 174967,
      "primary_message": "Juice one lemon into a small bowl. Cut remaining lemon into wedges.",
      "secondary_message": null
    },
    {
      "id": 174968,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 174969,
      "primary_message": "Add butter, lemon juice, Parmesan, and most of the parsley to the skillet; stir until cheese is melted. (Reserve some parsley for garnish.)",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 174970,
      "primary_message": "Return chicken to the skillet, along with any accumulated juices, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 174971,
      "primary_message": "To serve, divide chicken and asparagus between plates, top with reserved parsley and crushed red pepper. Garnish with lemon wedges and enjoy!",
      "secondary_message": "1 pinch crushed red pepper"
    }
  ],
