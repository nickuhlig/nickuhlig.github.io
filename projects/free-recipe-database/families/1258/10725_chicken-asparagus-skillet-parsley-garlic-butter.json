  "instructions": [
    {
      "id": 174972,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "5 small bunches asparagus\n1 small bunch Italian (flat-leaf) parsley\n3 lemons"
    },
    {
      "id": 174973,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 174974,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces; season with spices.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 tbsp Italian seasoning\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 174975,
      "primary_message": "When the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 174976,
      "primary_message": "Working in batches if necessary, add chicken and cook, stirring often, until cooked through and golden brown, 8-9 minutes. Transfer to a plate and set aside. ",
      "secondary_message": null
    },
    {
      "id": 174977,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 174978,
      "primary_message": "Once the chicken has been removed, add garlic and broth to the pot and stir; bring to a boil over high heat. Reduce heat and simmer, until reduced by half, about 8 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 174979,
      "primary_message": "Snap or cut off the woody ends of the asparagus; cut into 2-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 174980,
      "primary_message": "Working in batches if necessary, add asparagus to the pot. Stir to combine and cook until tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 174981,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince leaves.",
      "secondary_message": null
    },
    {
      "id": 174982,
      "primary_message": "Juice two lemons into a small bowl. Cut remaining lemon into wedges.",
      "secondary_message": null
    },
    {
      "id": 174983,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 174984,
      "primary_message": "Add butter, lemon juice, Parmesan, and most of the parsley to the pot; stir until melted. (Reserve some parsley for garnish.)",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 174985,
      "primary_message": "Return chicken to the pot, along with any accumulated juices, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 174986,
      "primary_message": "To serve, divide chicken and asparagus between plates, top with reserved parsley and crushed red pepper. Garnish with lemon wedges and enjoy!",
      "secondary_message": "1 pinch crushed red pepper"
    }
  ],
