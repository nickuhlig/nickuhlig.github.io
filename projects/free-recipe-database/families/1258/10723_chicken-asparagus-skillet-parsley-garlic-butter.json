  "instructions": [
    {
      "id": 174942,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches asparagus\n½ small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 174943,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 174944,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces; season with spices.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n1 tsp Italian seasoning\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 174945,
      "primary_message": "When the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 174946,
      "primary_message": "Add chicken to the skillet and cook, stirring occasionally, until cooked through and golden brown, 6-8 minutes. Transfer to a plate and set aside. ",
      "secondary_message": null
    },
    {
      "id": 174947,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 174948,
      "primary_message": "Once the chicken has been removed, add garlic and broth to the skillet and stir; bring to a boil over high heat. Reduce heat and simmer, until reduced by half, about 5 minutes.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 174949,
      "primary_message": "Snap or cut off the woody ends of the asparagus; cut into 2-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 174950,
      "primary_message": "Add asparagus to the skillet. Stir to combine and cook until tender, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 174951,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince leaves.",
      "secondary_message": null
    },
    {
      "id": 174952,
      "primary_message": "Juice half of the lemon into a small bowl. Cut remaining lemon into wedges.",
      "secondary_message": null
    },
    {
      "id": 174953,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 174954,
      "primary_message": "Add butter, lemon juice, Parmesan, and most of the parsley to the skillet; stir until cheese is melted. (Reserve some parsley for garnish.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 174955,
      "primary_message": "Return chicken to the skillet, along with any accumulated juices, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 174956,
      "primary_message": "To serve, divide chicken and asparagus between plates, top with reserved parsley and crushed red pepper. Garnish with lemon wedges and enjoy!",
      "secondary_message": "1 pinch crushed red pepper"
    }
  ],
