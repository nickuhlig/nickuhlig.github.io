  "instructions": [
    {
      "id": 466541,
      "primary_message": "Place hash browns in a colander; rinse under hot water (from the tap) to thaw. Using your hands, squeeze as much water from the hash browns as you can.",
      "secondary_message": "1 cup frozen shredded hash brown potatoes"
    },
    {
      "id": 466542,
      "primary_message": "Place hash browns in a medium bowl along with beef, cheese, egg, salt, and pepper. Mix with your hands to combine, then form into 6 equal-sized patties and place on a plate.",
      "secondary_message": "¾ lb lean ground beef\n½ cup shredded cheese, Mexican blend\n1 egg\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 466543,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 466544,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties and cook, undisturbed, until golden underneath, about 5 minutes; flip patties and cook an additional 5-6 minutes, until cooked through. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 466545,
      "primary_message": "Meanwhile, wash, dry, and halve grape tomatoes. Place in a clean medium bowl.",
      "secondary_message": "½ pint grape tomatoes"
    },
    {
      "id": 466546,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the tomatoes, along with dressing, and toss to combine the salad.",
      "secondary_message": "½ (5 oz) pkg spring mix (mixed greens)\n2 tbsp ranch dressing"
    },
    {
      "id": 466547,
      "primary_message": "To serve, divide salad and patties between plates. Drizzle patties with ketchup and enjoy!",
      "secondary_message": "2 tbsp ketchup"
    }
  ],
