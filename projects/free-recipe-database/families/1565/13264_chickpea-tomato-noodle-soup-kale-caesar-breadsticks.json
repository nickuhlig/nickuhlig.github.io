  "instructions": [
    {
      "id": 221897,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 221898,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. Place half the garlic in a medium bowl and set aside for the salad dressing.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 221899,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 221900,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add shallot and remaining garlic to the pan; cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 221901,
      "primary_message": "Add broth, tomato sauce, pasta, and spices to the pan; stir to combine. Bring to a simmer, reduce heat to medium, cover, and cook until noodles are just tender, about 8 minutes. ",
      "secondary_message": "355 ml chicken or vegetable broth\n1 (213 ml) can tomato sauce\n85 g penne pasta\n¼ tsp Italian seasoning\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 221902,
      "primary_message": "Meanwhile, cut flatbread into 1½-inch wide strips, place on a baking sheet pan, and drizzle with oil. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven and set aside.",
      "secondary_message": "1 flatbread or naan\n2 tsp extra virgin olive oil"
    },
    {
      "id": 221903,
      "primary_message": "While the breadsticks are baking, wash, dry, and juice lemon into the bowl with the garlic. Add mayo, Dijon, soy sauce, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "½ lemon\n1 tbsp mayonnaise\n1 tsp Dijon mustard\n½ tsp soy sauce\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 221904,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl with the dressing; toss to combine the salad and set aside. ",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 221905,
      "primary_message": "Drain and rinse chickpeas. Once the pasta is tender, add chickpeas to the pan and stir to combine. Continue to cook until heated through, 1-2 minutes. ",
      "secondary_message": "½ (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 221906,
      "primary_message": "Finely grate cheese. ",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 221907,
      "primary_message": "Ladle soup into bowls and serve with salad and breadsticks on the side. Top soup and salad with cheese and enjoy!",
      "secondary_message": null
    }
  ],
