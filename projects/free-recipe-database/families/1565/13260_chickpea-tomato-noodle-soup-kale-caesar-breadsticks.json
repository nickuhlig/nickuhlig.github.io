  "instructions": [
    {
      "id": 221856,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 221857,
      "primary_message": "Meanwhile, peel and mince onion and garlic. Place half the garlic in a large bowl and set aside for the salad dressing.",
      "secondary_message": "1 medium red onion\n3 cloves garlic"
    },
    {
      "id": 221858,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 221859,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and remaining garlic to the pot; cook, stirring occasionally, until fragrant, 1-2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 221860,
      "primary_message": "Add broth, tomato sauce, pasta, and spices to the pot; stir to combine. Bring to a simmer, reduce heat to medium, cover, and cook until noodles are just tender, 8-10 minutes. ",
      "secondary_message": "36 fl oz (4 ½ cups) chicken or vegetable broth\n3 (8 oz) cans tomato sauce\n8 oz penne pasta\n¾ tsp Italian seasoning\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 221861,
      "primary_message": "Meanwhile, cut flatbreads into 1½-inch wide strips, place on a large baking sheet pan, and drizzle with oil. Place in the oven (it doesn't have to be fully heated) and bake until crispy, about 10 minutes. Remove from the oven and set aside.",
      "secondary_message": "3 flatbreads or naan\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 221862,
      "primary_message": "While the breadsticks are baking, wash, dry, and juice lemons into the bowl with the garlic. Add mayo, Dijon, soy sauce, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "1 ½ lemons\n3 tbsp mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp soy sauce\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 221863,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl with the dressing; toss to combine the salad and set aside. ",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 221864,
      "primary_message": "Drain and rinse chickpeas. Once the pasta is tender, add chickpeas to the pot and stir to combine. Continue to cook until heated through, 2-3 minutes. ",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 221865,
      "primary_message": "Finely grate cheese. ",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 221866,
      "primary_message": "Ladle soup into bowls and serve with salad and breadsticks on the side. Top soup and salad with cheese and enjoy!",
      "secondary_message": null
    }
  ],
