  "instructions": [
    {
      "id": 415738,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 415739,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n6 crowns broccoli\n1 small pkg fresh mint"
    },
    {
      "id": 415740,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 415741,
      "primary_message": "Separate broccoli into bite-sized florets. Add to the baking sheets with the bell peppers, drizzle with oil, and season with salt; stir to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 415742,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are starting to char, about 25 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 415743,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup red wine vinegar\n2 ½ tsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 415744,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 415745,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 415746,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, 3-4 minutes. Transfer to a small bowl and set aside to cool.",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 415747,
      "primary_message": "Place oil, vinegar, salt, and crushed red pepper in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 415748,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the dressing.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 415749,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 415750,
      "primary_message": "Add cooled veggies, pickled onions, pine nuts, and feta to the bowl. Gently stir to combine the salad. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 415751,
      "primary_message": "To serve, divide the salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
