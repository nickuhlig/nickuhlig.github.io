  "instructions": [
    {
      "id": 415710,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 415711,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n2 crowns broccoli\n½ small pkg fresh mint"
    },
    {
      "id": 415712,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 415713,
      "primary_message": "Separate broccoli into bite-sized florets. Add to the baking sheet with the bell pepper, drizzle with oil, and season with salt; stir to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 415714,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are starting to char, 20-25 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 415715,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp red wine vinegar\n¾ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 415716,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 415717,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 415718,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to another small bowl and set aside to cool.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 415719,
      "primary_message": "Place oil, vinegar, salt, and crushed red pepper in a medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 415720,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the dressing.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 415721,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 415722,
      "primary_message": "Add cooled veggies, pickled onions, pine nuts, and feta to the bowl. Gently stir to combine the salad. ",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 415723,
      "primary_message": "To serve, divide the salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
