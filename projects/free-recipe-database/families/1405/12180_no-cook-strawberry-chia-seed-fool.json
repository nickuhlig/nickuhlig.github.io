  "instructions": [
    {
      "id": 204789,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 204790,
      "primary_message": "Meanwhile, wash, dry, and trim strawberries. Medium dice ⅓ of the berries and place in small bowl or container; cover with plastic wrap or a lid and refrigerate until ready to serve. Transfer remaining berries to a blender.",
      "secondary_message": "1 ½ (16 oz) pkg strawberries"
    },
    {
      "id": 204791,
      "primary_message": "Wash, dry, and juice oranges into the blender.",
      "secondary_message": "1 ½ oranges"
    },
    {
      "id": 204792,
      "primary_message": "Add sugar and vanilla; blend on high speed for several minutes until smooth.",
      "secondary_message": "¾ cup granulated sugar\n1 ½ tsp vanilla extract"
    },
    {
      "id": 204793,
      "primary_message": "Pour the strawberry pureé into a medium bowl, add chia seeds, and whisk to combine. Let the mixture rest, whisking occasionally, until seeds start to swell, about 15 minutes.",
      "secondary_message": "⅓ cup chia seeds"
    },
    {
      "id": 204794,
      "primary_message": "Once the seeds are slightly swollen, remove bowl from the freezer. Pour cold cream into the bowl.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy cream"
    },
    {
      "id": 204795,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 204796,
      "primary_message": "Whisk the strawberry mixture once more to separate any seeds that are clumped together. Transfer half the mixture to the bowl with the whipped cream. Using a silicone spatula, gently fold the two together until almost combined. Add remaining mixture and continue to fold until just combined.",
      "secondary_message": null
    },
    {
      "id": 204797,
      "primary_message": "Divide the strawberry fool between small bowls, cups, or jars. Cover with plastic wrap or lids and refrigerate until set, about 2 hours (or overnight).",
      "secondary_message": null
    },
    {
      "id": 204798,
      "primary_message": "To serve, garnish strawberry fool with reserved berries and enjoy!",
      "secondary_message": null
    }
  ],
