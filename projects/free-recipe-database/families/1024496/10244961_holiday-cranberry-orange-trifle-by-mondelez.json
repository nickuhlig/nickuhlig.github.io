  "instructions": [
    {
      "primary_message": "Combine sugar and cornstarch in medium saucepan. Add orange juice; stir until cornstarch is dissolved. Add 3 1/2 cups cranberries and cinnamon sticks; stir.",
      "secondary_message": null
    },
    {
      "primary_message": "Bring to boil on medium heat, stirring frequently. Simmer on medium-low heat 3 to 5 minutes or until thickened, stirring occasionally. Remove from heat. Stir in orange zest.",
      "secondary_message": null
    },
    {
      "primary_message": "Refrigerate for 2 hours or until completely cooled. Remove and discard cinnamon sticks.",
      "secondary_message": null
    },
    {
      "primary_message": "Beat pudding mixes and milk in large bowl with whisk for 2 minutes. Let stand for 5 minutes, then stir in 2 cups whipped topping.",
      "secondary_message": null
    },
    {
      "primary_message": "Place 16 NILLA® wafers on bottom of 10- to 12-cup straight-sided clear glass trifle dish.",
      "secondary_message": null
    },
    {
      "primary_message": "Layer half each of the pudding and cranberry mixtures in prepared dish. Arrange 30 of the remaining wafers over cranberry mixture and around side of dish. Cover with layers of the remaining pudding and cranberry mixtures. Top with 16 of the remaining wafers and remaining whipped topping.",
      "secondary_message": null
    },
    {
      "primary_message": "Refrigerate for 3 hours or until chilled.",
      "secondary_message": null
    },
    {
      "primary_message": "Garnish with remaining wafer and cranberries just before serving.",
      "secondary_message": null
    }
  ],
