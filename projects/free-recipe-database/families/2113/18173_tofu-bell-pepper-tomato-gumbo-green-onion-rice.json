  "instructions": [
    {
      "id": 297007,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 297008,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 297009,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 297010,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 small bunch green onions (scallions)\n2 sticks celery\n1 green bell pepper"
    },
    {
      "id": 297011,
      "primary_message": "Preheat a skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 297012,
      "primary_message": "While the skillet heats up, peel and mince garlic; place in a small bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 297013,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add flour and cook, stirring occasionally, until mixture is golden brown, about 5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp all-purpose flour"
    },
    {
      "id": 297014,
      "primary_message": "Meanwhile, trim and thinly slice green onions crosswise; add half to the bowl with the garlic. (Set remaining green onions aside for the rice.)",
      "secondary_message": null
    },
    {
      "id": 297015,
      "primary_message": "Trim and small dice celery; trim, seed, and small dice bell pepper. Add both to the bowl with the garlic and green onion. ",
      "secondary_message": null
    },
    {
      "id": 297016,
      "primary_message": "When the flour mixture is golden brown, add veggies to the skillet and cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 297017,
      "primary_message": "Meanwhile, medium dice the tofu. ",
      "secondary_message": null
    },
    {
      "id": 297018,
      "primary_message": "When the veggies are soft, add broth and spices to the skillet; bring to a boil over high heat. Once boiling, reduce heat to medium and cook, stirring frequently, until thickened, 2-3 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n2 tsp paprika\n1 tsp oregano, dried\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 297019,
      "primary_message": "Add tofu and tomatoes to the skillet; stir to combine the gumbo. Continue to cook, stirring occasionally, until tofu is warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 (398 ml) can diced tomatoes"
    },
    {
      "id": 297020,
      "primary_message": "Just before serving, add remaining green onion to the rice, and gently stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 297021,
      "primary_message": "To serve, divide green onion rice and gumbo between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
