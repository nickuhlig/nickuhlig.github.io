  "instructions": [
    {
      "id": 297022,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 297023,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 297024,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 297025,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "2 small bunches green onions (scallions)\n4 sticks celery\n2 green bell peppers"
    },
    {
      "id": 297026,
      "primary_message": "Peel and mince garlic; place in a medium bowl. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 297027,
      "primary_message": "Trim and thinly slice green onions crosswise; add half to the bowl with the garlic and set aside. (Set remaining green onions aside for the rice.)",
      "secondary_message": null
    },
    {
      "id": 297028,
      "primary_message": "Preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 297029,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add flour and cook, stirring occasionally, until mixture is golden brown, about 5 minutes.",
      "secondary_message": "⅓ cup extra virgin olive oil\n¼ cup all-purpose flour"
    },
    {
      "id": 297030,
      "primary_message": "Meanwhile, trim and small dice celery; trim, seed, and small dice bell peppers. Add both to the bowl with the garlic and green onion. ",
      "secondary_message": null
    },
    {
      "id": 297031,
      "primary_message": "When the flour mixture is golden brown, add veggies to the skillet and cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 297032,
      "primary_message": "While the veggies cook, medium dice the tofu. ",
      "secondary_message": null
    },
    {
      "id": 297033,
      "primary_message": "When the veggies are soft, add broth and spices to the skillet; bring to a boil over high heat. Once boiling, reduce heat to medium and cook, stirring frequently, until thickened, 2-3 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n4 tsp paprika\n2 tsp oregano, dried\n2 tsp chili powder\n1 tsp salt\n½ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 297034,
      "primary_message": "Add tofu and tomatoes to the skillet; stir to combine the gumbo. Continue to cook, stirring occasionally, until tofu is warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "2 (398 ml) cans diced tomatoes"
    },
    {
      "id": 297035,
      "primary_message": "Just before serving, add remaining green onion to the rice, and gently stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 297036,
      "primary_message": "To serve, divide green onion rice and gumbo between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
