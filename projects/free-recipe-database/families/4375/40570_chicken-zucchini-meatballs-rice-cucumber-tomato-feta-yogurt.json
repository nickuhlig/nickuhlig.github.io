  "instructions": [
    {
      "id": 627330,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 627331,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "1 cup jasmine rice\n473 ml chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 627332,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 small pkg fresh mint\n1 English cucumber\n1 small pkg grape tomatoes"
    },
    {
      "id": 627333,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 627334,
      "primary_message": "While the rice is cooking, trim and coarsely grate zucchini. Transfer to a colander, then sprinkle with salt and toss to coat. Place the colander in a bowl to catch excess liquid and set aside.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 627335,
      "primary_message": "Roughly chop sun-dried tomatoes. Place in a medium bowl along with chicken, eggs, bread crumbs, and spices.",
      "secondary_message": "8 sun-dried tomatoes, oil-packed\n0.45 kg ground chicken\n2 eggs\n½ cup panko bread crumbs\n½ tsp basil, dried\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 627336,
      "primary_message": "Use paper towels or a clean cloth to squeeze excess moisture out of the grated zucchini. Add to the bowl with the chicken and mix with your hands until well combined. Using a scant ¼-cup measure, form the chicken mixture into meatballs. Transfer to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 627337,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 627338,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place in a small bowl along with feta, yogurt, water, and spices. Stir to combine the feta sauce and set aside.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n½ cup plain Greek yogurt\n3 tbsp water\n⅛ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 627339,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 627340,
      "primary_message": "Halve grape tomatoes. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 627341,
      "primary_message": "To serve, divide rice and meatballs between bowls. Top with cucumber and tomato, then drizzle with feta sauce. Enjoy!",
      "secondary_message": null
    }
  ],
