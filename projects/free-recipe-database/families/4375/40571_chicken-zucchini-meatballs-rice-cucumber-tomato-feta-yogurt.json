  "instructions": [
    {
      "id": 627342,
      "primary_message": "Preheat oven to 230°C (450°F). Coat two large baking sheet pans with a thin layer of oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 627343,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "1 ½ cups jasmine rice\n710 ml chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 627344,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 small pkg fresh mint\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 627345,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 627346,
      "primary_message": "While the rice is cooking, trim and coarsely grate zucchini. Transfer to a colander, then sprinkle with salt and toss to coat. Place the colander in a bowl to catch excess liquid and set aside.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 627347,
      "primary_message": "Roughly chop sun-dried tomatoes. Place in a large bowl along with chicken, eggs, bread crumbs, and spices.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n0.68 kg ground chicken\n3 eggs\n¾ cup panko bread crumbs\n¾ tsp basil, dried\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 627348,
      "primary_message": "Use paper towels or a clean cloth to squeeze excess moisture out of the grated zucchini. Add to the bowl with the chicken and mix with your hands until well combined. Using a scant ¼-cup measure, form the chicken mixture into meatballs. Divide between the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 627349,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 627350,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place in a small bowl along with feta, yogurt, water, and spices. Stir to combine the feta sauce and set aside.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese\n¾ cup plain Greek yogurt\n¼ cup water\n3 pinch garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 627351,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 627352,
      "primary_message": "Halve grape tomatoes. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 627353,
      "primary_message": "To serve, divide rice and meatballs between bowls. Top with cucumber and tomato, then drizzle with feta sauce. Enjoy!",
      "secondary_message": null
    }
  ],
