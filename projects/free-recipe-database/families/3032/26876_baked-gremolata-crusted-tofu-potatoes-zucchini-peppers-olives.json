  "instructions": [
    {
      "id": 434131,
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 434132,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 434133,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n2 medium zucchini squash\n2 red bell peppers\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 434134,
      "primary_message": "Quarter potatoes and transfer to a large baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 434135,
      "primary_message": "Peel, halve, and large dice onion. Add to the baking sheet with the potatoes, then drizzle with oil and season with spices. Stir to coat and spread out in an even layer. ",
      "secondary_message": "1 medium red onion\n2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 434136,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until the potatoes start to soften, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 434137,
      "primary_message": "Meanwhile, trim and large dice zucchini. Trim, seed, and large dice bell peppers. Place both in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 434138,
      "primary_message": "Zest lemon into a small bowl. Juice lemon into another small bowl.",
      "secondary_message": null
    },
    {
      "id": 434139,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the lemon zest and half to the bowl with the lemon juice. (Set the bowl with the lemon juice aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 434140,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon zest along with bread crumbs, oil, salt, and pepper. Stir to combine the gremolata topping.",
      "secondary_message": "2 cloves garlic\n½ cup panko bread crumbs\n2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 434141,
      "primary_message": "Cut the tofu planks in half crosswise. Wipe the baking sheet dry with paper towels, then coat with a thin layer of oil. Return tofu to the baking sheet, sprinkle with gremolata topping, and press gently to adhere. Set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 434142,
      "primary_message": "Once the potatoes have softened, remove from oven. Add zucchini and bell pepper to the baking sheet, stir to combine, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 434143,
      "primary_message": "Return veggies to the oven, along with the tofu. Continue to bake until veggies are fork-tender, gremolata topping is golden brown, and tofu is warmed through, 8-10 minutes more.",
      "secondary_message": null
    },
    {
      "id": 434144,
      "primary_message": "Meanwhile, add yogurt, mayo, and salt to the bowl with the lemon juice. Stir to combine the sauce.",
      "secondary_message": "⅔ cup plain Greek yogurt\n3 tbsp mayonnaise\n½ tsp salt"
    },
    {
      "id": 434145,
      "primary_message": "When the tofu is done, remove baking sheet from the oven. Add olives to the veggies and stir to combine.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 434146,
      "primary_message": "Divide tofu and veggies between plates or bowls. Serve with sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
