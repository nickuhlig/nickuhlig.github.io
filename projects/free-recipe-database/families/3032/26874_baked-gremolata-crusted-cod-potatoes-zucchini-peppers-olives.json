  "instructions": [
    {
      "id": 434099,
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 434100,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n3 medium zucchini squash\n3 red bell peppers\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 434101,
      "primary_message": "Quarter potatoes and divide between two large baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 434102,
      "primary_message": "Peel, halve, and large dice onions. Add to the baking sheets with the potatoes, then drizzle with oil and season with spices. Stir to coat and spread out in an even layer. ",
      "secondary_message": "1 ½ medium red onions\n3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 434103,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until the potatoes start to soften, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 434104,
      "primary_message": "Meanwhile, trim and large dice zucchini. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 434105,
      "primary_message": "Trim, seed, and large dice bell peppers. Add to the bowl with the zucchini and set aside.",
      "secondary_message": null
    },
    {
      "id": 434106,
      "primary_message": "Zest lemons into a small bowl. Juice lemons into another small bowl.",
      "secondary_message": null
    },
    {
      "id": 434107,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the lemon zest and half to the bowl with the lemon juice. (Set the bowl with the lemon juice aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 434108,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon zest along with bread crumbs, oil, salt, and pepper. Stir to combine the gremolata topping.",
      "secondary_message": "3 cloves garlic\n¾ cup panko bread crumbs\n3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 434109,
      "primary_message": "Pat cod dry with paper towels and cut into portions (if necessary). Sprinkle cod with gremolata topping, pressing gently to adhere. ",
      "secondary_message": "2 ¼ lb cod fillet"
    },
    {
      "id": 434110,
      "primary_message": "Once the potatoes have softened, remove from oven. Add zucchini and bell pepper to the baking sheets, stir to combine, and spread out in an even layer. Add cod to the baking sheets, nestling it into the veggies.",
      "secondary_message": null
    },
    {
      "id": 434111,
      "primary_message": "Continue to bake until veggies are fork-tender, gremolata topping is golden brown, and cod is cooked through, 10-12 minutes more.",
      "secondary_message": null
    },
    {
      "id": 434112,
      "primary_message": "Meanwhile, add yogurt, mayo, and salt to the bowl with the lemon juice. Stir to combine the sauce.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup mayonnaise\n¾ tsp salt"
    },
    {
      "id": 434113,
      "primary_message": "When the cod is done, remove baking sheet from the oven. Add olives to the veggies and stir to combine.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 434114,
      "primary_message": "Divide cod and veggies between plates or bowls. Serve with sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
