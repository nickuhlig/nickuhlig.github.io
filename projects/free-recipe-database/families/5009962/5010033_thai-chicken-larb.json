  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Peel and slice the shallots into thin rings. Chop the fresh mint leaves. Chop the fresh cilantro leaves.",
      "secondary_message": "6 large cloves garlic\n6 small shallots\n1 ¼ cups fresh mint leaves\n1 ¼ cups fresh cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "Trim chicken of visible fat and cut into 2.5-cm cubes. Place in single layer on tray and freeze until partially frozen, about 30 minutes. Working in 2 or 3 batches, pulse chicken in food processor until roughly ground into pieces the size of small peas; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large 30-cm skillet (or wok), heat the chicken stock over medium-high heat with the oil, sugar, and salt. Add the chicken and the garlic, and cook until the chicken is just cooked through, stirring and breaking up the chicken, about 2 to 3 minutes. Stir in the lime juice, fish sauce, and chili flakes. Stir in the shallots, mint, and cilantro.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in the ground toasted rice. Season to taste with more sugar, lime juice, fish sauce, and chili flakes as desired. Serve the larb warm or room temperature rice and lettuce.",
      "secondary_message": null
    }
  ],
