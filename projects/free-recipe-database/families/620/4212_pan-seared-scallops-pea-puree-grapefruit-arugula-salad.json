  "instructions": [
    {
      "id": 47608,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby arugula\n2 grapefruits"
    },
    {
      "id": 47609,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 47610,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 47611,
      "primary_message": "In a large salad bowl, combine and whisk together olive oil, vinegar, honey, Dijon, salt, and pepper.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp honey\n½ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 47612,
      "primary_message": "Slice off a piece from both grapefruit ends, then place it flat on one of the ends and slice off the peel (from top to bottom), exposing the flesh; cut out the segments of flesh from between the membranes. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47613,
      "primary_message": "Add the arugula to the salad bowl and toss until the salad is thoroughly coated with the dressing.",
      "secondary_message": null
    },
    {
      "id": 47614,
      "primary_message": "Once the water is boiling, season with salt and add the peas. Cook until the peas are bright green and tender, 2 to 3 minutes. Drain the peas in a colander, reserving ½ cup of the cooking water, and return to the saucepan.",
      "secondary_message": "2 tsp salt\n3 cups frozen peas"
    },
    {
      "id": 47615,
      "primary_message": "Add the butter, garlic, and reserved cooking water to the peas. Using a hand blender, purée the mixture until smooth. Alternatively, use a potato masher to mash the peas.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 47616,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 47617,
      "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; rub with olive oil and season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb sea scallops\n1 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 47618,
      "primary_message": "Once the skillet is hot, carefully add the scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1 ½ to 2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 47619,
      "primary_message": "To serve, divide the pea purée between plates, then top with the salad and scallops. Enjoy!",
      "secondary_message": null
    }
  ],
