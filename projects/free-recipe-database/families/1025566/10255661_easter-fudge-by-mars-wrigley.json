  "instructions": [
    {
      "primary_message": "Grease 8-inch square baking pan; line with enough parchment paper to overhang edges. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Combine sugar, evaporated milk and butter in heavy-bottomed saucepan set over medium heat; bring to boil, stirring constantly, for 4 minutes; remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Stir in marshmallows, chocolate chips, vanilla and salt. Stir vigorously for 1 minute or until marshmallows and chocolate are melted.",
      "secondary_message": null
    },
    {
      "primary_message": "Pour mixture into prepared baking pan. Top with M&M’S® Milk Chocolate Pastels. Refrigerate for 1 1/2 to 2 hours or until firm. Cut into 16 squares.",
      "secondary_message": null
    }
  ],
