  "instructions": [
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 8 minutes.",
      "secondary_message": "1 tsp salt\n10 oz fettuccine pasta"
    },
    {
      "primary_message": "When the pasta is almost done, add broccoli to the pot. Continue to cook, stirring occasionally, until pasta reaches desired firmness and broccoli is tender, 2-3 minutes more.",
      "secondary_message": "1 (18 oz) bag broccoli florets"
    },
    {
      "primary_message": "When the pasta and broccoli are done, drain in a colander and return to the pot. Add chicken and Alfredo sauce, then toss to combine.",
      "secondary_message": "1 (16 oz) jar Alfredo sauce\n20 oz cooked chicken (shredded)"
    },
    {
      "primary_message": "Return pot to medium heat and cook, stirring occasionally, until warmed through, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
