  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "4 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together flour, baking soda, cloves, ginger, grated nutmeg, and salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, beat together butter and sugar until light and fluffy. Add molasses, orange juice, and zest and beat until combined. Add dry ingredients and beat until dough comes together. Divide dough in two, cover in plastic wrap, and chill for three hours in the refrigerator.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat oven to 160°C (325°F). Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Take dough out of fridge and roll out on a lightly floured surface to 0.5 cm thick. (In order for cookies to be crispy, they must be as thin as possible). Cut out cookies (see note) and place on baking sheet. Bake until dry and darkened in color, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Let cookies cool on baking sheet for 5 minutes then transfer to a wire rack. Let cool completely. Top 1/2 of cookies with about 1/2 teaspoon Biscoff spread. Top with remaining cookies to form sandwiches.",
      "secondary_message": null
    }
  ],
