  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim the haricots verts. Thinly slice the garlic.",
      "secondary_message": "1 ¾ lb haricots verts\n16 cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Bring a large pot of water to a boil, and salt it. Blanch the haricots verts until tender-crisp, about 4 minutes. Drain, and shock in cold water. Meanwhile, in a mini food processor, add the tomatoes, 4 teaspoons of olive oil, and a good pinch of salt. Pulse until chopped. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Once the haricots verts have been drained, add the remaining 1/4 cup olive oil to the original pot, and set over medium-low heat. Add the garlic and cook, stirring often, until fragrant, and just about to go golden around the edges. Immediately add the haricots verts to stop the garlic from burning, season with salt, and toss to warm through. Plate, and top with the chopped tomatoes. Eat hot or at room temperature.",
      "secondary_message": null
    }
  ],
