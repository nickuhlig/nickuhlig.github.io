  "instructions": [
    {
      "id": 188872,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 caps portobello mushrooms\n1 medium zucchini squash\n½ small bunch green onions (scallions)\n¼ small pkg fresh thyme"
    },
    {
      "id": 188873,
      "primary_message": "Add dried spaghetti to a large pot, off the heat, breaking noodles in half.",
      "secondary_message": "142 g spaghetti pasta"
    },
    {
      "id": 188874,
      "primary_message": "Remove the stems of the portobello mushrooms. Using a spoon, carefully scrape out the gills, making sure not to damage the rim of the mushrooms. Dice mushrooms into ½-inch cubes and add to the pot.",
      "secondary_message": null
    },
    {
      "id": 188875,
      "primary_message": "Trim and discard the ends of the zucchini; small dice the zucchini into ½-inch cubes and add to the pot.",
      "secondary_message": null
    },
    {
      "id": 188876,
      "primary_message": "Peel and mince or press the garlic; add to pot. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 188877,
      "primary_message": "Remove the stem ends of the green onions. Slice in ¼-inch pieces and add to pot.",
      "secondary_message": null
    },
    {
      "id": 188878,
      "primary_message": "Slide the thyme leaves off the stems; discard the stems, add to the pot. Add butter and season everything with salt and pepper. ",
      "secondary_message": "1 tsp salt\n¼ tsp black pepper\n1 ½ tsp butter, unsalted"
    },
    {
      "id": 188879,
      "primary_message": "Add enough water to the pot just to cover noodles. Bring to a boil over high heat, then reduce heat to medium; water should remain at a low boil for the entire cooking process. ",
      "secondary_message": null
    },
    {
      "id": 188880,
      "primary_message": "Ensure pasta is mostly submerged in cooking liquid while cooking. Stirring frequently, simmer, uncovered, until pasta is cooked through, vegetables have softened and liquid has reduced. About 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 188881,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 188882,
      "primary_message": "When pasta is done cooking drain any excess liquid from the pot using a colander. ",
      "secondary_message": null
    },
    {
      "id": 188883,
      "primary_message": "Return pasta and veggies to the pot. Stir in heavy cream and Parmesan. Serve immediately. Enjoy!",
      "secondary_message": "59 ml (¼ cup) heavy cream"
    }
  ],
