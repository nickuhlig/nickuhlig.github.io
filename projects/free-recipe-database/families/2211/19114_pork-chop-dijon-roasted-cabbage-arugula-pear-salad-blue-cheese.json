  "instructions": [
    {
      "id": 314927,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 314928,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ small heads red cabbage\n3 pears\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 314929,
      "primary_message": "Place Dijon, oil, water, honey, salt, and pepper in a large bowl; whisk to combine the Dijon sauce. ",
      "secondary_message": "3 tbsp Dijon mustard\n2 tbsp extra virgin olive oil\n2 tbsp water\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 314930,
      "primary_message": "Halve each cabbage lengthwise and cut out the cores; slice crosswise into 1-inch thick wedges. Divide between two baking sheet pans, then drizzle both sides of the cabbage with Dijon sauce. (Reserve bowl for later use.) ",
      "secondary_message": null
    },
    {
      "id": 314931,
      "primary_message": "Place baking sheets in the oven and roast, gently flipping cabbage halfway through, until tender and golden around the edges, 20-25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 314932,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 314933,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels. Place on a plate and season both sides with salt and pepper. ",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 314934,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 314935,
      "primary_message": "While the chops are cooking, place oil, vinegar, Dijon, and salt in the reserved bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n½ tsp salt"
    },
    {
      "id": 314936,
      "primary_message": "Peel, halve, and slice onions into thin half-moons; add to the bowl with the dressing and toss to combine. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 314937,
      "primary_message": "Quarter, core, and thinly slice pears; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 314938,
      "primary_message": "Roughly chop walnuts and add to the bowl. ",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 314939,
      "primary_message": "Just before serving, add arugula and blue cheese to the bowl; toss to combine the salad. ",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 314940,
      "primary_message": "To serve, divide roasted cabbage, chops, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
