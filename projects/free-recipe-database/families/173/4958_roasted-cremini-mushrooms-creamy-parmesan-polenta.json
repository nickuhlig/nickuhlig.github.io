  "instructions": [
    {
      "id": 60224,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": ""
    },
    {
      "id": 60216,
      "primary_message": "In a medium saucepan, bring broth and water to a boil. Gradually add polenta in a thin steady steam, while whisking constantly until all the polenta is incorporated into the liquid. Lower heat to medium-low and, stirring frequently, cook until polenta thickens, 25-30 minutes.",
      "secondary_message": "708 ml (3 cups) chicken or vegetable broth\n8 ¼ cups water\n2 ¼ cups polenta (cornmeal)"
    },
    {
      "id": 60223,
      "primary_message": "Peel and mince garlic. In a small bowl, whisk together garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60222,
      "primary_message": "Wash, dry, and quarter mushrooms. Transfer to a sheet pan, pour sauce over top, and toss to coat.",
      "secondary_message": "1.362 kg cremini mushrooms"
    },
    {
      "id": 60221,
      "primary_message": "Place in the oven and, stirring halfway through, cook until tender, about 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 60220,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 60219,
      "primary_message": "Grate 1 ½ cup Parmesan.",
      "secondary_message": "84 g Parmesan cheese"
    },
    {
      "id": 60215,
      "primary_message": "Add butter, Parmesan, salt, and pepper to polenta. Stir to combine.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60218,
      "primary_message": "Remove mushrooms from oven, sprinkle with parsley, and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 60217,
      "primary_message": "To serve, place polenta in a bowl and top with mushrooms. Enjoy!",
      "secondary_message": ""
    }
  ],
