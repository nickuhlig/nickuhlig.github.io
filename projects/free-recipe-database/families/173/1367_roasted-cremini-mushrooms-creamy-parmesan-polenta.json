  "instructions": [
    {
      "id": 11786,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": ""
    },
    {
      "id": 11787,
      "primary_message": "In a small saucepan, bring broth and water to a boil. Gradually add polenta in a thin steady steam, while whisking constantly until all the polenta is incorporated into the liquid. Lower heat to medium-low and, stirring frequently, cook until polenta thickens, 25-30 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 ¾ cups water\n¾ cup polenta (cornmeal)"
    },
    {
      "id": 11788,
      "primary_message": "Peel and mince garlic. In a small bowl, whisk together garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n½ tbsp balsamic vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 11789,
      "primary_message": "Wash, dry, and quarter mushrooms. Transfer to a sheet pan, pour sauce over top, and toss to coat.",
      "secondary_message": "1 lb cremini mushrooms"
    },
    {
      "id": 11790,
      "primary_message": "Place in the oven and, stirring halfway through, cook until tender, about 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11791,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 11792,
      "primary_message": "Grate ½ cup Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 11793,
      "primary_message": "Add butter, Parmesan, salt, and pepper to polenta. Stir to combine.",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 11794,
      "primary_message": "Remove mushrooms from oven, sprinkle with parsley, and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 11795,
      "primary_message": "To serve, place polenta in a bowl and top with mushrooms. Enjoy!",
      "secondary_message": ""
    }
  ],
