  "instructions": [
    {
      "id": 1,
      "primary_message": "In a food processor, pulse almonds with 2 tablespoons sugar until ground to a fine paste.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large heavy-bottomed saucepan, combine milk, cinnamon sticks, lemon rind, vanilla, and baking soda. Bring to a boil over medium-high heat; reduce heat to medium-low and simmer for 15 to 20 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In large bowl, whisk egg yolks, remaining 1 1/2 cups sugar, and ground almonds until thick and pale. Remove cinnamon stick and lemon rind from milk; discard. Slowly pour milk into yolk mixture, constantly whisking, to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Return mixture to saucepan and cook over low heat, stirring and scraping the bottom and sides of the pan constantly, until the mixture thickens enough to coat the back of a spoon, 5 to 7 minutes. Set aside to cool completely, about 2 hours (see notes).",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Stir in rum or aguardiente and serve.",
      "secondary_message": null
    }
  ],
