  "instructions": [
    {
      "id": 34682,
      "primary_message": "Place the eggs in a small saucepan and cover with cold water by about 2 ½ cm. Cover with a lid and bring to a rolling boil over high heat.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 34683,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n1 head romaine lettuce\n2 avocados"
    },
    {
      "id": 34684,
      "primary_message": "Trim off and discard the root end of the lettuce and remove any blemished leaves; quarter the lettuce lengthwise, then chop crosswise into 2 ½-cm pieces and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 34685,
      "primary_message": "Once the water is boiling, remove the pan from the heat and let the eggs sit, covered, for 6 minutes. Once done, drain and run the eggs under cold water for 1-2 minutes to stop the cooking process.",
      "secondary_message": null
    },
    {
      "id": 34686,
      "primary_message": "Halve the tomatoes and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 34687,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and medium dice the flesh. Transfer the avocado to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 34688,
      "primary_message": "Drain and rinse the chickpeas; set aside in the colander.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 34689,
      "primary_message": "In a small bowl, combine and whisk together olive oil, red wine vinegar, Dijon mustard, honey, salt, and pepper.",
      "secondary_message": "6 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 34690,
      "primary_message": "Peel and roughly chop the eggs.",
      "secondary_message": ""
    },
    {
      "id": 34691,
      "primary_message": "To serve, arrange the lettuce on a plate, top with the tomatoes, avocado, chickpeas, and eggs, and drizzle with the dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
