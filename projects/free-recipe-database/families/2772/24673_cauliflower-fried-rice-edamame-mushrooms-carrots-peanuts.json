  "instructions": [
    {
      "id": 398475,
      "primary_message": "Wash, dry, peel, and mince ginger. Place in a small bowl along with stir-fry sauce, miso paste, vinegar, salt, and pepper. Stir to combine the sauce and set aside. ",
      "secondary_message": "1 (1 inch) piece ginger root\n⅓ cup stir-fry sauce\n1 tbsp miso paste, white\n2 tsp rice vinegar\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 398476,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398477,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add riced cauliflower, edamame, mushrooms, and carrots; stir-fry until tender and warmed through, 4-5 minutes. ",
      "secondary_message": "1 tbsp toasted sesame oil\n1 (12 oz) bag frozen, riced cauliflower\n2 cups edamame\n1 (8 oz) pkg sliced white mushrooms\n½ (10 oz) bag shredded carrots"
    },
    {
      "id": 398478,
      "primary_message": "Add sauce and peanuts to the skillet. Continue to cook, stirring occasionally, until sauce thickens, 1-2 minutes more. Remove from heat. ",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 398479,
      "primary_message": "To serve, divide cauliflower-edamame \"fried rice\" between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
