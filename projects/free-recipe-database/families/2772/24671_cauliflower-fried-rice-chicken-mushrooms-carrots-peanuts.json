  "instructions": [
    {
      "id": 398461,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398462,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and cut into bite-sized pieces. Season with salt and pepper. ",
      "secondary_message": "1 ½ lb chicken thighs, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 398463,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chicken and peanuts; cook, stirring occasionally, until peanuts are golden brown and chicken is cooked through, 6-7 minutes. Transfer to a plate. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil\n½ cup peanuts, roasted unsalted"
    },
    {
      "id": 398464,
      "primary_message": "Meanwhile, wash and dry ginger; using a clean cutting board, peel and mince. Place in a small bowl along with stir-fry sauce, water, miso paste, vinegar, salt, and pepper. Stir to combine the sauce and set aside. ",
      "secondary_message": "2 (1 inch) pieces ginger root\n⅔ cup stir-fry sauce\n2 tbsp water\n2 tbsp miso paste, white\n4 tsp rice vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 398465,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. Add riced cauliflower, mushrooms, and carrots; stir-fry until tender and warmed through, 5-6 minutes. ",
      "secondary_message": "4 tsp toasted sesame oil\n2 (12 oz) bags frozen, riced cauliflower\n2 (8 oz) pkg sliced white mushrooms\n1 (10 oz) bag shredded carrots"
    },
    {
      "id": 398466,
      "primary_message": "Return chicken to the pot along with the sauce. Continue to cook, stirring occasionally, until sauce thickens and chicken is warmed through, 2-3 minutes more. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 398467,
      "primary_message": "To serve, divide chicken-cauliflower \"fried rice\" between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
