  "instructions": [
    {
      "id": 398516,
      "primary_message": "Wash, dry, peel, and mince ginger. Place in a small bowl along with stir-fry sauce, miso paste, vinegar, salt, and pepper. Stir to combine the sauce and set aside. ",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n⅔ cup stir-fry sauce\n2 tbsp miso paste, white\n4 tsp rice vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 398517,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398518,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add riced cauliflower, edamame, mushrooms, and carrots; stir-fry until tender and warmed through, about 6 minutes. ",
      "secondary_message": "2 tbsp toasted sesame oil\n2 (340 g) bags frozen, riced cauliflower\n4 cups edamame\n2 (227g ) pkg sliced white mushrooms\n1 (283 g) bag shredded carrots"
    },
    {
      "id": 398519,
      "primary_message": "Add sauce and peanuts to the pot. Continue to cook, stirring occasionally, until sauce thickens, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 398520,
      "primary_message": "To serve, divide cauliflower-edamame \"fried rice\" between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
