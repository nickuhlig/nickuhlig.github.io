  "instructions": [
    {
      "id": 423510,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 423511,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n27 oz cheese ravioli, fresh or frozen"
    },
    {
      "id": 423512,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 423513,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 423514,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, mushrooms, Italian seasoning, and salt. Cook, stirring occasionally, until starting to soften, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 (8 oz) pkgs sliced white mushrooms\n1 ½ tsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 423515,
      "primary_message": "Meanwhile, wash, dry, trim, and medium dice zucchini.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 423516,
      "primary_message": "When the veggies are soft, add zucchini to the pot. Continue to cook, stirring occasionally, until veggies are tender, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 423517,
      "primary_message": "While the zucchini is cooking, drain and rinse beans in a colander.",
      "secondary_message": "3 (15 oz) cans kidney beans"
    },
    {
      "id": 423518,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 423519,
      "primary_message": "When the veggies are done, add the beans, half of the basil, and marinara sauce to the pot. Stir to combine and continue to cook until warmed through, 2-3 minutes more. (Reserve remaining basil for serving.)",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce"
    },
    {
      "id": 423520,
      "primary_message": "Transfer ravioli to a large baking dish, arranging them in an even layer. Spoon bean-marinara sauce over the ravioli and sprinkle with cheese. Place in the oven and broil until cheese is melted and bubbly, about 5 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 423521,
      "primary_message": "To serve, divide ravioli bake between plates or bowls and sprinkle with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
