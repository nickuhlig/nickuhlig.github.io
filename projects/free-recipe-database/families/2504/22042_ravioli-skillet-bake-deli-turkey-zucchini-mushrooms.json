  "instructions": [
    {
      "id": 423522,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 423523,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "½ tsp salt\n255 g cheese ravioli, fresh or frozen"
    },
    {
      "id": 423524,
      "primary_message": "Meanwhile, preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 423525,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 423526,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, mushrooms, Italian seasoning, and salt. Cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 (227g ) pkg sliced white mushrooms\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 423527,
      "primary_message": "Meanwhile, wash, dry, trim, and medium dice zucchini.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 423528,
      "primary_message": "When the veggies are soft, add zucchini to the skillet. Continue to cook, stirring occasionally, until the veggies are tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 423529,
      "primary_message": "While the zucchini is cooking, roughly chop turkey into bite-sized pieces. ",
      "secondary_message": "227 g oven roasted turkey breast, sliced"
    },
    {
      "id": 423530,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 423531,
      "primary_message": "When the veggies are done, add the turkey, half of the basil, and marinara sauce to the skillet. Stir to combine and continue to cook until warmed through, 1-2 minutes more. (Reserve remaining basil for serving.)",
      "secondary_message": "½ (680 g) jar marinara sauce"
    },
    {
      "id": 423532,
      "primary_message": "Add ravioli to the skillet, stir to combine, and sprinkle with cheese. Place in the oven and broil until cheese is melted and bubbly, 4-5 minutes. Remove from oven.",
      "secondary_message": "½ cup shredded cheese, Italian blend"
    },
    {
      "id": 423533,
      "primary_message": "To serve, divide ravioli bake between plates or bowls and sprinkle with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
