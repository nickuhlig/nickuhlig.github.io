  "instructions": [
    {
      "id": 379469,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 379470,
      "primary_message": "Place bread crumbs and spices in a medium bowl. Stir to combine.",
      "secondary_message": "¾ cup panko bread crumbs\n½ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 379471,
      "primary_message": "Pat the chicken dry with paper towels and arrange on one half of a large baking sheet pan. Spread ranch dressing over the chicken thighs, coating both sides. Working in batches, dredge chicken in the bread crumb mixture, pressing gently to adhere; return to the baking sheet.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n⅓ cup ranch dressing"
    },
    {
      "id": 379472,
      "primary_message": "Wash, dry, trim, and halve Brussels sprouts. Transfer to the other half of the baking sheet along with the cauliflower. ",
      "secondary_message": "0.23 kg Brussels sprouts\n1 (283 g) bag cauliflower florets"
    },
    {
      "id": 379473,
      "primary_message": "Drizzle veggies with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 379474,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring veggies and flipping chicken halfway through, until veggies are fork-tender and chicken is golden and cooked through, 15-18 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 379475,
      "primary_message": "To serve, divide veggies and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
