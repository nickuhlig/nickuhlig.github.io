  "instructions": [
    {
      "id": 379483,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 379484,
      "primary_message": "Place bread crumbs and spices in a medium bowl. Stir to combine.",
      "secondary_message": "2 ¼ cup panko bread crumbs\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 379485,
      "primary_message": "Pat the chicken dry with paper towels and spread out on a large baking sheet pan. Spread ranch dressing over the chicken thighs, coating both sides. Working in batches, dredge chicken in the bread crumb mixture, pressing gently to adhere; return to the baking sheet.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1 cup ranch dressing"
    },
    {
      "id": 379486,
      "primary_message": "Wash, dry, trim, and halve Brussels sprouts. Divide Brussels sprouts and cauliflower between two additional baking sheets.",
      "secondary_message": "0.68 kg Brussels sprouts\n3 (283 g) bags cauliflower florets"
    },
    {
      "id": 379487,
      "primary_message": "Drizzle veggies with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 379488,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring veggies and flipping chicken halfway through, until veggies are fork-tender and chicken is golden and cooked through, 20-25. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 379489,
      "primary_message": "To serve, divide veggies and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
