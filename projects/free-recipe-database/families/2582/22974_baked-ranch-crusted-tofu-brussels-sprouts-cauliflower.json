  "instructions": [
    {
      "id": 379509,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 379510,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 379511,
      "primary_message": "Wash, dry, trim, and halve Brussels sprouts. Divide Brussels sprouts and cauliflower between two additional baking sheets.",
      "secondary_message": "0.68 kg Brussels sprouts\n3 (283 g) bags cauliflower florets"
    },
    {
      "id": 379512,
      "primary_message": "Drizzle veggies with oil, then season with salt and pepper. Toss to coat and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 379513,
      "primary_message": "Place bread crumbs and spices in a small bowl. Stir to combine.",
      "secondary_message": "2 ¼ cup panko bread crumbs\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 379514,
      "primary_message": "Cut tofu planks in half crosswise. Wipe baking sheet dry with paper towels, then return tofu to the pan, arranging the slices in a single layer.",
      "secondary_message": null
    },
    {
      "id": 379515,
      "primary_message": "Spread half of the ranch dressing over top side of the tofu, sprinkle with half of the bread crumb mixture, and drizzle with half of the oil. Carefully flip tofu and repeat with remaining dressing, bread crumbs, and oil.",
      "secondary_message": "¾ cup ranch dressing\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 379516,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring veggies and flipping tofu halfway through, until veggies are fork-tender and tofu is golden brown, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 379517,
      "primary_message": "To serve, divide veggies and tofu between plates. Enjoy!",
      "secondary_message": null
    }
  ],
