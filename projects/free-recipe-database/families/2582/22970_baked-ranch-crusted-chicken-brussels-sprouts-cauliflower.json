  "instructions": [
    {
      "id": 379476,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 379477,
      "primary_message": "Place bread crumbs and spices in a medium bowl. Stir to combine.",
      "secondary_message": "1 ½ cup panko bread crumbs\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 379478,
      "primary_message": "Pat the chicken dry with paper towels and spread out on a large baking sheet pan. Spread ranch dressing over the chicken thighs, coating both sides. Working in batches, dredge chicken in the bread crumb mixture, pressing gently to adhere; return to the baking sheet.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n⅔ cup ranch dressing"
    },
    {
      "id": 379479,
      "primary_message": "Wash, dry, trim, and halve Brussels sprouts. Transfer to another large baking sheet along with the cauliflower.",
      "secondary_message": "0.45 kg Brussels sprouts\n2 (283 g) bags cauliflower florets"
    },
    {
      "id": 379480,
      "primary_message": "Drizzle veggies with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 379481,
      "primary_message": "Place both baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring veggies and flipping chicken halfway through, until veggies are fork-tender and chicken is golden and cooked through, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 379482,
      "primary_message": "To serve, divide veggies and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
