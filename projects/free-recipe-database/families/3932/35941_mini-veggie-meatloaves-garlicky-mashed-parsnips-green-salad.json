  "instructions": [
    {
      "id": 565143,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil for easier cleanup (optional). Coat foil with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 565144,
      "primary_message": "Place ketchup, water, soy sauce, and sugar in a small bowl, then whisk to combine the sauce. Set aside.",
      "secondary_message": "1 ½ tbsp ketchup\n1 tsp soy sauce\n2 tsp water\n1 tsp brown sugar"
    },
    {
      "id": 565145,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with veggie ground, egg, bread crumbs, additional ketchup, and spices; mix with your hands until the \"meatloaf\" mixture is well combined.",
      "secondary_message": "1 clove garlic\n227 g veggie ground, plant based\n1 egg\n¼ cup panko bread crumbs\n2 tsp ketchup\n½ tsp Italian seasoning\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 565146,
      "primary_message": "Form the meatloaf mixture into 6 short, sausage-like shapes, approximately 2 ½-inches long. Transfer to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 565147,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until meatloaves are cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 565148,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "4 medium parsnips\n½ English cucumber\n½ small pkg grape tomatoes\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 565149,
      "primary_message": "Peel and medium dice parsnips; peel garlic. Place both in a medium saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 12-15 minutes.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 565150,
      "primary_message": "While the parsnips are cooking, place oil, vinegar, Dijon, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n½ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 565151,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 565152,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 565153,
      "primary_message": "When the parsnips are done, drain in a colander and return to the pan. Add milk, salt, and pepper, then using a potato masher, mash until smooth.",
      "secondary_message": "59 ml (¼ cup) whole milk\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 565154,
      "primary_message": "To serve, divide mashed parsnips, meatloaves, and salad between plates. Top meatloaves with sauce and enjoy!",
      "secondary_message": null
    }
  ],
