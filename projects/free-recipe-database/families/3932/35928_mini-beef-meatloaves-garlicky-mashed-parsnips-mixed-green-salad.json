  "instructions": [
    {
      "id": 564987,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 564988,
      "primary_message": "Place ketchup, water, Worcestershire, and sugar in a small bowl, then whisk to combine the sauce. Set aside.",
      "secondary_message": "¼ cup ketchup\n2 tbsp water\n1 tbsp Worcestershire sauce\n1 tbsp brown sugar"
    },
    {
      "id": 564989,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with beef, eggs, bread crumbs, additional ketchup, and spices; mix with your hands until the meatloaf mixture is well combined.",
      "secondary_message": "3 cloves garlic\n2 ¼ lb lean ground beef\n3 eggs\n¾ cup panko bread crumbs\n2 tbsp ketchup\n1 ½ tsp Italian seasoning\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 564990,
      "primary_message": "Form the meatloaf mixture into 18 short, sausage-like shapes, approximately 3-inches long. Transfer to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 564991,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until meatloaves are cooked through, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 564992,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "12 medium parsnips\n1 ½ English cucumbers\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 564993,
      "primary_message": "Peel and medium dice parsnips; peel garlic. Place both in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 12-15 minutes.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 564994,
      "primary_message": "While the parsnips are cooking, place oil, vinegar, Dijon, salt, and pepper in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 564995,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 564996,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 564997,
      "primary_message": "When the parsnips are done, drain in a colander and return to the pot. Add milk, salt, and pepper, then using a potato masher, mash until smooth.",
      "secondary_message": "6 fl oz (¾ cup) whole milk\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 564998,
      "primary_message": "To serve, divide mashed parsnips, meatloaves, and salad between plates. Top meatloaves with sauce and enjoy!",
      "secondary_message": null
    }
  ],
