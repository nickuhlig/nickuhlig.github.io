  "instructions": [
    {
      "id": 493239,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 493240,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed\n4 tsp cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 493241,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 493242,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 bunch kale\n0.45 kg Brussels sprouts"
    },
    {
      "id": 493243,
      "primary_message": "Zest lemon into a clean medium bowl. Juice lemon into another medium bowl and set aside for the wing sauce.",
      "secondary_message": null
    },
    {
      "id": 493244,
      "primary_message": "Add mayo, oil, Dijon, salt and pepper to the bowl with the lemon zest; whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n2 tsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 493245,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493246,
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493247,
      "primary_message": "Using your hands, massage the greens with dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 493248,
      "primary_message": "Add honey, pepper, and salt to the bowl with the lemon juice, then whisk to combine the sauce.",
      "secondary_message": "¼ cup honey\n1 tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 493249,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 493250,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
