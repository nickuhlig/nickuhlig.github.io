  "instructions": [
    {
      "id": 493179,
      "primary_message": "Preheat oven to 500°F. Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 493180,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Divide between the baking sheets and spread out in an even layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed\n2 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 493181,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. ",
      "secondary_message": null
    },
    {
      "id": 493182,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ bunches kale\n1 ½ lb Brussels sprouts"
    },
    {
      "id": 493183,
      "primary_message": "Zest lemons into a clean large bowl. Juice lemons into another large bowl and set aside for the wing sauce.",
      "secondary_message": null
    },
    {
      "id": 493184,
      "primary_message": "Add mayo, oil, Dijon, salt and pepper to the bowl with the lemon zest; whisk to combine the dressing.",
      "secondary_message": "½ cup mayonnaise\n1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 493185,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 493186,
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 493187,
      "primary_message": "Using your hands, massage the greens with dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 493188,
      "primary_message": "Add honey, pepper, and salt to the bowl with the lemon juice, then whisk to combine the sauce.",
      "secondary_message": "⅓ cup honey\n1 ½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 493189,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 493190,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
