  "instructions": [
    {
      "id": 352362,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 352363,
      "primary_message": "While the pan heats up, wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n1 orange bell pepper\n½ small pkg fresh basil"
    },
    {
      "id": 352364,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add sausage and spices; cook, breaking the meat apart with a spoon, until brown and crumbly, 5-6 minutes. Using a slotted spoon, transfer sausage to a small bowl. (Reserve pan with drippings for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil\n0.23 kg ground pork sausage\n½ tsp Italian seasoning\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 352365,
      "primary_message": "Meanwhile, peel, trim, and small dice carrot; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 352366,
      "primary_message": "Trim and small dice celery; add to the bowl with the carrot.",
      "secondary_message": "1 stick celery"
    },
    {
      "id": 352367,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352368,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 352369,
      "primary_message": "When the sausage is done, return the pan (with drippings) to medium heat. Add veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 352370,
      "primary_message": "Add broth and tomatoes to the pan; stir to combine the soup and bring to a boil over high heat.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes"
    },
    {
      "id": 352371,
      "primary_message": "Once the soup is boiling, reduce heat to medium and simmer, stirring occasionally, until the veggies are soft, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 352372,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 352373,
      "primary_message": "When the soup is done, add half of the basil to the pan (reserving the rest for garnish). Purée with an immersion or regular blender (return soup to the pan if using a regular blender).",
      "secondary_message": null
    },
    {
      "id": 352374,
      "primary_message": "Add cooked sausage to the soup along with cream, salt, and pepper. Reduce heat to low and cook, stirring occasionally, until warmed through, 2-3 minutes.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 352375,
      "primary_message": "To serve, divide soup between bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
