  "instructions": [
    {
      "id": 352404,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 352405,
      "primary_message": "While the pan heats up, wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n1 orange bell pepper\n½ small pkg fresh basil"
    },
    {
      "id": 352406,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until brown and crumbly, 5-6 minutes. Transfer veggie ground to a small bowl. (Reserve pan for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 352407,
      "primary_message": "Meanwhile, peel, trim, and small dice carrot; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 352408,
      "primary_message": "Trim and small dice celery; add to the bowl with the carrot.",
      "secondary_message": "1 stick celery"
    },
    {
      "id": 352409,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352410,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 352411,
      "primary_message": "When the veggie ground is done, return the pan to medium heat, add more oil, and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 352412,
      "primary_message": "Add broth and tomatoes to the pan; stir to combine the soup and bring to a boil over high heat.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes"
    },
    {
      "id": 352413,
      "primary_message": "When the soup is boiling, reduce heat to medium and simmer, stirring occasionally, until the veggies are soft, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 352414,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 352415,
      "primary_message": "When the soup is done, add half of the basil (reserving the rest for garnish) to the pan. Purée with an immersion or regular blender (return soup to the pan if using a regular blender).",
      "secondary_message": null
    },
    {
      "id": 352416,
      "primary_message": "Add cooked veggie ground to the soup along with cream, salt, and pepper. Reduce heat to low and cook, stirring occasionally, until warmed through, 2-3 minutes.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 352417,
      "primary_message": "To serve, divide soup between bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
