  "instructions": [
    {
      "id": 352348,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 352349,
      "primary_message": "While the pot heats up, wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n3 orange bell peppers\n1 small pkg fresh basil"
    },
    {
      "id": 352350,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until brown and crumbly, 6-7 minutes. Transfer veggie ground to a small bowl. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 352351,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 352352,
      "primary_message": "Trim and small dice celery; add to the bowl with the carrot.",
      "secondary_message": "3 sticks celery"
    },
    {
      "id": 352353,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352354,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 352355,
      "primary_message": "When the veggie ground is done, return the pot to medium heat, add more oil, and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 352356,
      "primary_message": "Add broth and tomatoes to the pot; stir to combine the soup and bring to a boil over high heat.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 352357,
      "primary_message": "When the soup is boiling, reduce heat to medium and simmer, stirring occasionally, until the veggies are soft, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 352358,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 352359,
      "primary_message": "When the soup is done, add half of the basil (reserving the rest for garnish) to the pot. Purée with an immersion or regular blender (return soup to the pot if using a regular blender).",
      "secondary_message": null
    },
    {
      "id": 352360,
      "primary_message": "Add cooked veggie ground to the soup along with cream, salt, and pepper. Reduce heat to low and cook, stirring occasionally, until warmed through, 3-4 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 352361,
      "primary_message": "To serve, divide soup between bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
