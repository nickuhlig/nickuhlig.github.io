  "instructions": [
    {
      "id": 352418,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 352419,
      "primary_message": "While the pot heats up, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n2 orange bell peppers\n1 small pkg fresh basil"
    },
    {
      "id": 352420,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until brown and crumbly, 5-6 minutes. Transfer veggie ground to a small bowl. (Reserve pot for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 352421,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 352422,
      "primary_message": "Trim and small dice celery; add to the bowl with the carrot.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 352423,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352424,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 352425,
      "primary_message": "When the veggie ground is done, return the pot to medium heat, add more oil, and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 352426,
      "primary_message": "Add broth and tomatoes to the pot; stir to combine the soup and bring to a boil over high heat.",
      "secondary_message": "946 ml chicken or vegetable broth\n2 (398 ml) cans diced tomatoes"
    },
    {
      "id": 352427,
      "primary_message": "When the soup is boiling, reduce heat to medium and simmer, stirring occasionally, until the veggies are soft, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 352428,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 352429,
      "primary_message": "When the soup is done, add half of the basil (reserving the rest for garnish) to the pot. Purée with an immersion or regular blender (return soup to the pot if using a regular blender).",
      "secondary_message": null
    },
    {
      "id": 352430,
      "primary_message": "Add cooked veggie ground to the soup along with cream, salt, and pepper. Reduce heat to low and cook, stirring occasionally, until warmed through, 2-3 minutes.",
      "secondary_message": "237 ml heavy whipping cream\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 352431,
      "primary_message": "To serve, divide soup between bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
