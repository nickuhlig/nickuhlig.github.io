  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine raspberries, lime juice, sugar, and salt in a blender. Blend on high speed until smooth, about 1 minute. Strain through a fine mesh strainer into a pitcher. Discard solids. Add cold water and whisk to combine. Add ice. Serve in ice-filled glasses garnished with raspberries and lime wedges.",
      "secondary_message": null
    }
