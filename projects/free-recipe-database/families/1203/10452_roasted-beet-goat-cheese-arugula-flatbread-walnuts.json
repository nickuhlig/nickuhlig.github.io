  "instructions": [
    {
      "id": 172106,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 172107,
      "primary_message": "Wash beets, then trim off and discard the ends; peel and cut into ¼-inch thick slices. Transfer to a large baking sheet pan.",
      "secondary_message": "6 medium beets"
    },
    {
      "id": 172108,
      "primary_message": "Drizzle beets with oil and season with salt and pepper; toss to coat, then arrange in a single layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 172109,
      "primary_message": "Place the baking sheet in the oven and roast until beets are tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 172110,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "⅜ cup walnuts"
    },
    {
      "id": 172111,
      "primary_message": "Crumble goat cheese into a small bowl.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 172112,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 172113,
      "primary_message": "Wash and dry arugula (skip if it came pre-washed). Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 172114,
      "primary_message": "Toast flatbreads if desired.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 172115,
      "primary_message": "Once beets are tender, remove from the oven and drizzle with vinegar.",
      "secondary_message": "3 tbsp red wine vinegar"
    },
    {
      "id": 172116,
      "primary_message": "To serve, divide flatbreads between plates. Top with beets, goat cheese, arugula, and walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
