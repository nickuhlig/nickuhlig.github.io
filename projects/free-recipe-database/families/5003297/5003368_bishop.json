  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash the orange and pierce the skin with the cloves, leaving the buds protruding from the orange skin. Continue until the orange is well studded with cloves.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place the orange on a baking dish and bake in a preheated 350-degree oven until the skin is lightly toasted, 60 to 90 minutes. Remove from oven and let cool.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat port and water in a saucepan until gently simmering. Stir in sugar and spices.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cut the orange into slices and add it and its juice to the pan of port (or you can get fancy and put it all in a warmed bowl) along with cognac, if using. Stir and serve.",
      "secondary_message": null
    }
  ],
