  "instructions": [
    {
      "id": 420646,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 420647,
      "primary_message": "Place curry paste, oil, soy sauce, salt, and pepper in a large bowl. Stir to combine the spice paste.",
      "secondary_message": "⅓ cup Thai curry paste, green\n3 tbsp toasted sesame oil\n3 tbsp soy sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 420648,
      "primary_message": "Cut the tofu planks in half, then cut each half into two triangles. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet. Drizzle with half of the spice paste. (Reserve bowl with remaining spice paste for the salad.)",
      "secondary_message": null
    },
    {
      "id": 420649,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420650,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook until golden, 2-3 minutes per side. Return to the baking sheet.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 420651,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 ½ limes\n1 ½ English cucumbers\n3 avocados"
    },
    {
      "id": 420652,
      "primary_message": "Juice limes into the bowl with the remaining spice paste. Add maple syrup and stir to combine the dressing. ",
      "secondary_message": "1 tbsp pure maple syrup"
    },
    {
      "id": 420653,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 420654,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 420655,
      "primary_message": "Roughly chop cashews. Add to the bowl, along with the carrots, and stir to combine the salad. ",
      "secondary_message": "¾ cup cashews, roasted unsalted\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 420656,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
