  "instructions": [
    {
      "id": 420488,
      "primary_message": "Place curry paste, oil, soy sauce, salt, and pepper in a large bowl. Stir to combine the spice paste. ",
      "secondary_message": "⅓ cup Thai curry paste, red\n3 tbsp toasted sesame oil\n3 tbsp soy sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 420489,
      "primary_message": "Pat the cod dry with paper towels and place on a plate. Drizzle with half of the spice paste, then turn to coat the fish. (Reserve bowl with remaining spice paste for the salad.)",
      "secondary_message": "2 ¼ lb cod fillet"
    },
    {
      "id": 420490,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420491,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add cod and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 420492,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 ½ limes\n1 ½ English cucumbers\n3 avocados"
    },
    {
      "id": 420493,
      "primary_message": "Juice limes into the bowl with the remaining spice paste. Add honey and stir to combine the dressing. ",
      "secondary_message": "2 tbsp honey"
    },
    {
      "id": 420494,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 420495,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 420496,
      "primary_message": "Roughly chop cashews. Add to the bowl, along with the carrots, and stir to combine the salad. ",
      "secondary_message": "¾ cup cashews, roasted unsalted\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 420497,
      "primary_message": "To serve, divide cod and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
