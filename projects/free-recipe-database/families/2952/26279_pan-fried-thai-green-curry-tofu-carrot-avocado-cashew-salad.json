  "instructions": [
    {
      "id": 420635,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 420636,
      "primary_message": "Place curry paste, oil, soy sauce, salt, and pepper in a medium bowl. Stir to combine the spice paste.",
      "secondary_message": "¼ cup Thai curry paste, green\n2 tbsp toasted sesame oil\n2 tbsp soy sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 420637,
      "primary_message": "Cut the tofu planks in half, then cut each half into two triangles. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet. Drizzle with half of the spice paste. (Reserve bowl with remaining spice paste for the salad.)",
      "secondary_message": null
    },
    {
      "id": 420638,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420639,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook until golden, 2-3 minutes per side. Return to the baking sheet.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 420640,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 lime\n1 English cucumber\n2 avocados"
    },
    {
      "id": 420641,
      "primary_message": "Juice lime into the bowl with the remaining spice paste. Add maple syrup and stir to combine the dressing. ",
      "secondary_message": "2 tsp pure maple syrup"
    },
    {
      "id": 420642,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 420643,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 420644,
      "primary_message": "Roughly chop cashews. Add to the bowl, along with the carrots, and stir to combine the salad. ",
      "secondary_message": "½ cup cashews, roasted unsalted\n1 (283 g) bag shredded carrots"
    },
    {
      "id": 420645,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
