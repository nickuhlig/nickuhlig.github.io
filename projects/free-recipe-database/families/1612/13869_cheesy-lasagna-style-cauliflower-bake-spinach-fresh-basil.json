  "instructions": [
    {
      "id": 363002,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 363003,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 363004,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n3 (5 oz) pkgs baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 363005,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets.",
      "secondary_message": null
    },
    {
      "id": 363006,
      "primary_message": "Once the water in the pot is boiling, add cauliflower and salt. Cook, stirring occasionally, until fork-tender, about 5 minutes. Drain in a colander and set aside.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 363007,
      "primary_message": "Meanwhile, roughly chop the spinach and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 363008,
      "primary_message": "Peel and mince garlic and onion. ",
      "secondary_message": "6 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 363009,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 363010,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and onion to the skillet; cook, stirring frequently, until softened, 1-2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 363011,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat and set aside. (Reserve bowl for later use.) ",
      "secondary_message": null
    },
    {
      "id": 363012,
      "primary_message": "Place tomato sauce, Italian seasoning, and salt in a medium bowl; whisk to combine and set aside.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 tbsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 363013,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 363014,
      "primary_message": "Place ricotta, eggs, and spices in the reserved bowl; whisk until smooth. Add the cooked spinach and half the basil (reserving the rest for garnish), and stir to combine.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n3 eggs\n¾ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 363015,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 363016,
      "primary_message": "Wipe skillet clean with paper towels and coat the bottom with oil. Transfer half the cauliflower to the skillet and spread it out in an even layer. Spoon half the ricotta mixture over the cauliflower, followed by half the tomato sauce and mozzarella. Repeat process once more, creating two layers.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 363017,
      "primary_message": "Place skillet in the oven and bake until cheese is melted and cauliflower is heated through, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 363018,
      "primary_message": "To serve, divide cauliflower bake between plates and garnish with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
