  "instructions": [
    {
      "id": 363061,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 363062,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 363063,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n1 (142 g) pkg baby spinach\n½ small pkg fresh basil"
    },
    {
      "id": 363064,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets.",
      "secondary_message": null
    },
    {
      "id": 363065,
      "primary_message": "Once the water in the pot is boiling, add cauliflower and salt. Cook, stirring occasionally, until fork-tender, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 363066,
      "primary_message": "Meanwhile, roughly chop the spinach and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 363067,
      "primary_message": "Peel and mince garlic and shallot. ",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 363068,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 363069,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and shallot to the skillet; cook, stirring frequently, until softened, about 1 minute.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 363070,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat and set aside. (Reserve bowl for later use.) ",
      "secondary_message": null
    },
    {
      "id": 363071,
      "primary_message": "Place tomato sauce, Italian seasoning, and salt in a small bowl; whisk to combine and set aside.",
      "secondary_message": "1 (213 ml) can tomato sauce\n1 tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 363072,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 363073,
      "primary_message": "Place ricotta, egg, and spices in the reserved bowl; whisk until smooth. Add the cooked spinach and half the basil (reserving the rest for garnish), and stir to combine.",
      "secondary_message": "½ (425 g) pkg ricotta cheese\n1 egg\n¼ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 363074,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 363075,
      "primary_message": "Wipe skillet clean with paper towels and coat the bottom with oil. Transfer half the cauliflower to the skillet and spread it out in an even layer. Spoon half the ricotta mixture over the cauliflower, followed by half the tomato sauce and mozzarella. Repeat process once more, creating two layers.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 363076,
      "primary_message": "Place skillet in the oven and bake until cheese is melted and cauliflower is heated through, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 363077,
      "primary_message": "To serve, divide cauliflower bake between plates and garnish with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
