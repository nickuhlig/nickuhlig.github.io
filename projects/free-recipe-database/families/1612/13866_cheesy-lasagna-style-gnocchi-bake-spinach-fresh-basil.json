  "instructions": [
    {
      "id": 362954,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 362955,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add gnocchi and salt, and stir for a few seconds. Cook, stirring occasionally, until gnocchi begins to float to the surface, 3-5 minutes. Drain in a colander and set aside.",
      "secondary_message": "3 (16 oz) pkg potato gnocchi\n1 ½ tsp salt"
    },
    {
      "id": 362956,
      "primary_message": "Meanwhile, wash, dry, and roughly chop the spinach (skip washing if using pre-washed spinach). Transfer to a large bowl.",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 362957,
      "primary_message": "Peel and mince garlic and onion. ",
      "secondary_message": "6 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 362958,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 362959,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and onion to the skillet; cook, stirring frequently, until fragrant, 1-2 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 362960,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat and set aside. (Reserve bowl for later use.) ",
      "secondary_message": null
    },
    {
      "id": 362961,
      "primary_message": "Place tomato sauce, Italian seasoning, and salt in a medium bowl; whisk to combine and set aside.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 tbsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 362962,
      "primary_message": "Wash, dry, and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 362963,
      "primary_message": "Place ricotta, eggs, and spices in the reserved bowl; whisk until smooth. Add the cooked spinach and half the basil (reserving the rest for garnish); stir to combine.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n3 eggs\n¾ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 362964,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 362965,
      "primary_message": "Wipe skillet clean with paper towels and coat the bottom with oil. Transfer half the gnocchi to the skillet and spread it out in an even layer. Spoon half the ricotta mixture over the gnocchi, followed by half the tomato sauce and mozzarella. Repeat process once more, creating two layers.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 362966,
      "primary_message": "Place skillet in the oven and bake until cheese is melted and gnocchi is heated through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 362967,
      "primary_message": "To serve, divide gnocchi bake between plates and garnish with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
