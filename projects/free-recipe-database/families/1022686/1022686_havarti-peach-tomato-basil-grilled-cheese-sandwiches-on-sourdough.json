  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "primary_message": "Slice tomatoes crosswise into thin rounds. Place on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into thin wedges and add to the plate with the tomato. Season tomatoes and peaches with spices.",
      "secondary_message": "¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange half of the bread slices on a baking sheet pan, layer each with 1 1/2 slices of cheese, tomato slices, peach wedges, and basil. Top each with another 1 1/2 slices of cheese, then close sandwiches with remaining bread slices.",
      "secondary_message": "8 slice sourdough bread\n12 slice Havarti cheese, sliced"
    },
    {
      "primary_message": "Preheat an outdoor grill or grill pan over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the grill heats up, spread mayo on the top side of the sandwiches.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "primary_message": "Once the grill is hot, add sandwiches, mayo-side down, and grill until bottoms are golden, 2-4 minutes. (Reserve baking sheet for the next step.)",
      "secondary_message": null
    },
    {
      "primary_message": "Remove sandwiches to the baking sheet, grilled-side down, and spread the other side with additional mayo. Return sandwiches, mayo-side down, to the grill and continue to cook until golden on the other side and cheese is melted, 2-4 minutes more. Transfer to a cutting board.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "primary_message": "To serve, slice sandwiches in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
