  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Bring the mascarpone cheese to room temperature. Scrape out the seeds from the vanilla bean pod. Bring the eggs to room temperature. Bring the egg yolk to room temperature. Bring the milk to room temperature. Bring the mascarpone cheese to room temperature. Scrape out the seeds from the vanilla bean pod. Juice the lemon.",
      "secondary_message": "8 tbsp (4 oz) unsalted butter\n2 tbsp mascarpone cheese\n½ vanilla bean pod\n2 large eggs\n1 large egg yolk\n½ cup milk\n¾ cup mascarpone cheese\n½ vanilla bean pod\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "For the Cake: Adjust oven rack to middle position and preheat oven to 350°F. Coat one 9-inch round cake pan with baking spray.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Sift together flour, baking powder, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In large bowl, beat butter, mascarpone, sugar, and vanilla bean seeds on medium speed until light and fluffy, about 3 minutes. Add eggs and egg yolk, one at a time, beating well after each addition.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Decrease mixer speed to low and add flour mixture in three batches, alternating with milk. Scrape sides and bottom of bowl with rubber spatula as needed.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Scrape batter into prepared baking pan and bake until toothpick inserted in center comes out clean, 25 to 30 minutes. Transfer cake to cooling rack and cool in pan 10 minutes, then invert onto plate, and invert once again onto cooling rack. Cool completely, at least 1 hour.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For the Icing: In large bowl, beat mascarpone, sugar, and vanilla bean seeds on medium speed until light and fully combined, about 3 minutes. Add lemon juice and beat just to combine.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Spread icing on top of cake.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "For the Persimmons: Core persimmons and slice into 16 wedges. Arrange on top of iced cake in a circular pattern.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Place sugar and salt small heavy-bottomed saucepan. Cook over medium-high heat until the sugar is dissolved. Dampen a clean pastry brush and brush down any sugar crystals from the sides of the pan. Boil, swirling the pan occasionally, until sugar turns deep amber, 3 to 5 minutes. Immediately drizzle over cake. Serve cake the day it is made.",
      "secondary_message": null
    }
  ],
