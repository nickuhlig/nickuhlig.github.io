  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the lamb fat into 3/4-inch cubes.",
      "secondary_message": "1 lb lamb fat"
    },
    {
      "id": 1,
      "primary_message": "Place cumin, coriander, and fennel seeds in a cast iron skillet over medium heat and toast until fragrant, about 2 minutes. Transfer to a spice grinder and grind into a fine powder. Transfer spice mixture to a small bowl and mix in paprika, salt, and cayenne.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place lamb and fat in a large bowl. Add spice mixture, garlic, and harissa. Toss to thoroughly coat meat and fat in spices. Refrigerate until chilled, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Grind mixture through a meat grinder, fitted with small die, into a medium bowl set into a large bowl filled with ice.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In the bowl of a stand mixer fitted with a paddle attachment, mix ground meat on low speed for 1 minute. Add in water and mix until liquid is incorporated and sausage is uniform and sticky, about 1 minute more.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Form a small sausage patty; place rest of sausage mixture in refrigerator. Cook patty in a small frying pan over medium-high heat until cooked through. Taste and adjust seasonings if necessary.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Stuff sausage into lamb casings and twist into 6-inch links. Refrigerate until ready to cook.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals evenly over entire surface of coal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Grill over medium-high direct heat until sausage registers 155°F when an instant read thermometer is inserted in middle of link. Remove from grill, let rest for 5 minutes, and serve.",
      "secondary_message": null
    }
  ],
