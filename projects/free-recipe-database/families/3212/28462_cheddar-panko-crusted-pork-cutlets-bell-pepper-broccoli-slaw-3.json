  "instructions": [
    {
      "primary_message": "Place egg in a medium bowl and beat with a whisk or fork until smooth. Set aside.",
      "secondary_message": "1 egg"
    },
    {
      "primary_message": "Grate cheese into another medium bowl. Add bread crumbs and spices, then stir to combine. Set aside.",
      "secondary_message": "¼ (227 g) block cheddar cheese\nsalt\n¼ tsp garlic powder\n¼ tsp smoked paprika"
    },
    {
      "primary_message": "Pat pork dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chops in half horizontally to form thin cutlets.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, dip the cutlets into the beaten egg (letting the excess drip off), then into the bread crumb mixture, pressing gently to adhere. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the breaded cutlets and pan-fry until golden brown and cooked through, about 3 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "While the chops are cooking, place mayo in a clean medium bowl. Add vinegar, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp apple cider vinegar\nsalt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Wash and dry bell pepper; using a clean cutting board, trim, seed, and slice lengthwise into thin strips. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine.",
      "secondary_message": "1 yellow bell pepper\n½ (340 g) pkg broccoli slaw"
    },
    {
      "primary_message": "To serve, divide slaw between plates or bowls. Top with pork cutlets and enjoy!",
      "secondary_message": null
    }
  ],
