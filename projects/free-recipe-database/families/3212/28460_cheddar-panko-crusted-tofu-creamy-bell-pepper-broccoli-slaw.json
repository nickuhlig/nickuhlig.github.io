  "instructions": [
    {
      "id": 454940,
      "primary_message": "Cut tofu in half along the long side, then cut the planks in half crosswise. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 454941,
      "primary_message": "Place eggs in a medium bowl and beat with a whisk or fork until smooth. Set aside.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 454942,
      "primary_message": "Grate cheese into another medium bowl. Add bread crumbs and spices, then stir to combine. Set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese\n⅔ cup panko bread crumbs\n1 tsp salt\n½ tsp garlic powder\n½ tsp smoked paprika"
    },
    {
      "id": 454943,
      "primary_message": "Dip tofu planks into the beaten egg (letting the excess drip off), then into the bread crumb mixture, pressing gently to adhere. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 454944,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 454945,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add breaded tofu and pan-fry until golden brown, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 454946,
      "primary_message": "While the tofu is cooking, place mayo in a clean medium bowl. Add vinegar, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n4 tsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 454947,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine.",
      "secondary_message": "2 yellow bell peppers\n1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 454948,
      "primary_message": "To serve, divide slaw between plates or bowls. Top with tofu and enjoy!",
      "secondary_message": null
    }
  ],
