  "instructions": [
    {
      "id": 454913,
      "primary_message": "Place eggs in a medium bowl and beat with a whisk or fork until smooth. Set aside.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 454914,
      "primary_message": "Grate cheese into another medium bowl. Add bread crumbs and spices, then stir to combine. Set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese\n⅔ cup panko bread crumbs\n1 tsp salt\n½ tsp garlic powder\n½ tsp smoked paprika"
    },
    {
      "id": 454915,
      "primary_message": "Pat pork dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chops in half horizontally to form thin cutlets.",
      "secondary_message": "4 pork chops, boneless"
    },
    {
      "id": 454916,
      "primary_message": "Dip the cutlets into the beaten egg (letting the excess drip off), then into the bread crumb mixture, pressing gently to adhere. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 454917,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 454918,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the breaded cutlets and pan-fry until golden brown and cooked through, about 3 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 454919,
      "primary_message": "While the chops are cooking, place mayo in a clean medium bowl. Add vinegar, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n4 tsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 454920,
      "primary_message": "Wash and dry bell peppers; using a clean cutting board, trim, seed, and slice lengthwise into thin strips. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine.",
      "secondary_message": "2 yellow bell peppers\n1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 454921,
      "primary_message": "To serve, divide slaw between plates or bowls. Top with pork cutlets and enjoy!",
      "secondary_message": null
    }
  ],
