  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the parsley leaves from the stems and roughly chop them. Roughly chop the garlic.",
      "secondary_message": "1 cup loosely packed fresh flat leaf parsley\n2 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Combine parsley, basil, oregano, garlic, vinegar, and honey in the bowl of a food processor and process until a paste forms. With the machine running, drizzle in the olive oil to form an emulsion. Season to taste with salt and pepper. Vinaigrette is best used immediately, but can be stored in a sealed container in the refrigerator for up to 5 days.",
      "secondary_message": null
    }
