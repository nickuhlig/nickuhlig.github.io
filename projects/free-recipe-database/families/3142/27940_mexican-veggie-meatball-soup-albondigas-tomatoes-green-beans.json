  "instructions": [
    {
      "id": 448113,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch cilantro\n½ small pkg fresh mint\n1 medium carrot\n½ lb green beans"
    },
    {
      "id": 448114,
      "primary_message": "Peel and mince garlic. Place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 448115,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic, setting aside a small handful for serving.",
      "secondary_message": null
    },
    {
      "id": 448116,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 448117,
      "primary_message": "Add veggie ground, rice, egg, and spices to the bowl; mix with your hands until well combined. Using a tablespoon measure, form mixture into rounded \"meatballs\" and place on a plate. Set aside.",
      "secondary_message": "8 oz veggie ground, plant based\n½ cup basmati rice\n1 egg\n½ tsp oregano, dried\n½ tsp cumin, ground\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 448118,
      "primary_message": "Peel, trim, and small dice carrot. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 448119,
      "primary_message": "Trim and cut green beans into 1-inch pieces. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 448120,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448121,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 448122,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 448123,
      "primary_message": "Add broth, tomatoes, and meatballs to the pan; gently stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer, stirring occasionally, until meatballs are cooked through, 10-15 minutes. Remove from heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 448124,
      "primary_message": "To serve, divide soup between bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
