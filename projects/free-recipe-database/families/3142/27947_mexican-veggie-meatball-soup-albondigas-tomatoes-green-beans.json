  "instructions": [
    {
      "id": 448197,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 small pkg fresh mint\n2 medium carrots\n0.45 kg green beans"
    },
    {
      "id": 448198,
      "primary_message": "Peel and mince garlic. Place in a medium bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 448199,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic, setting aside a small handful for serving.",
      "secondary_message": null
    },
    {
      "id": 448200,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 448201,
      "primary_message": "Add veggie ground, rice, eggs, and spices to the bowl; mix with your hands until well combined. Using a tablespoon measure, form mixture into rounded \"meatballs\" and place on a plate. Set aside.",
      "secondary_message": "454 g veggie ground, plant based\n1 cup basmati rice\n2 eggs\n1 tsp oregano, dried\n1 tsp cumin, ground\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 448202,
      "primary_message": "Peel, trim, and small dice carrots. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 448203,
      "primary_message": "Trim and cut green beans into 1-inch pieces. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 448204,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448205,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 448206,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 448207,
      "primary_message": "Add broth, tomatoes, and meatballs to the pot; gently stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer, stirring occasionally, until meatballs are cooked through, 10-15 minutes. Remove from heat.",
      "secondary_message": "1420 ml chicken or vegetable broth\n2 (398 ml) cans diced tomatoes"
    },
    {
      "id": 448208,
      "primary_message": "To serve, divide soup between bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
