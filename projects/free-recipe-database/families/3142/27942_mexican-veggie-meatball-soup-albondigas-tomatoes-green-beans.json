  "instructions": [
    {
      "id": 448137,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 small pkg fresh mint\n3 medium carrots\n1 ½ lb green beans"
    },
    {
      "id": 448138,
      "primary_message": "Peel and mince garlic. Place in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 448139,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic, setting aside a small handful for serving.",
      "secondary_message": null
    },
    {
      "id": 448140,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 448141,
      "primary_message": "Add veggie ground, rice, eggs, and spices to the bowl; mix with your hands until well combined. Using a tablespoon measure, form mixture into rounded \"meatballs\" and place on a plate. Set aside.",
      "secondary_message": "24 oz veggie ground, plant based\n1 ½ cups basmati rice\n3 eggs\n1 ½ tsp oregano, dried\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 448142,
      "primary_message": "Peel, trim, and small dice carrots. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 448143,
      "primary_message": "Trim and cut green beans into 1-inch pieces. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 448144,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448145,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 448146,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 448147,
      "primary_message": "Add broth, tomatoes, and meatballs to the pot; gently stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer, stirring occasionally, until meatballs are cooked through, 10-15 minutes. Remove from heat.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 448148,
      "primary_message": "To serve, divide soup between bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
