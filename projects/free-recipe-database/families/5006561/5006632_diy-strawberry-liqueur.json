  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly slice the strawberries.",
      "secondary_message": "227 g strawberries"
    },
    {
      "id": 1,
      "primary_message": "Place the strawberries and tarragon in a sealable glass jar, then add vodka. Seal and shake. Let mixture steep for 2 days at room temperature away from direct sunlight. Strain strawberries and tarragon, then filter mixture through a coffee filter or through two layers of cheesecloth, pressing down to extract liquid.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat water and sugar in a pot on medium heat until it boils and forms a syrup, about 5 minutes. Let syrup cool.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Once the syrup is cool, combine it with the strawberry-tarragon infusion. Seal in bottle or jar, then shake to mix. Let rest for a minimum of 1 day. Store in the refrigerator for up to 2 months.",
      "secondary_message": null
    }
  ],
