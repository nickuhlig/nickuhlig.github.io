  "instructions": [
    {
      "id": 353338,
      "primary_message": "Preheat oven to 500°F. Line two baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 353339,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 red chili peppers\n1 ½ medium heads cauliflower\n3 green bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 353340,
      "primary_message": "Zest and juice limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 353341,
      "primary_message": "Quarter chili peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 353342,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil, salt, and pepper; whisk to combine the sauce.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 353343,
      "primary_message": "Pat chicken wings dry with paper towels and add to the bowl with the sauce; toss to coat. Divide wings between the baking sheets, drizzle with any sauce left in the bowl, and spread out in an even layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed"
    },
    {
      "id": 353344,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 353345,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 353346,
      "primary_message": "While the water heats up, separate each cauliflower into small bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 353347,
      "primary_message": "Once the water is boiling, uncover and add cauliflower and salt; stir for a few seconds. Cook until crisp-tender, about 3 minutes. Drain and rinse under cold water to cool; set aside to drain further.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 353348,
      "primary_message": "Meanwhile, place mayo, Dijon, vinegar, and spices in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "¾ cup avocado oil mayonnaise\n3 tbsp Dijon mustard\n2 tbsp white wine vinegar\n1 ½ tsp curry powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 353349,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl along with the cooked cauliflower and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 353350,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Sprinkle over the wings and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 353351,
      "primary_message": "To serve, divide wings and cauliflower salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
