  "instructions": [
    {
      "id": 353408,
      "primary_message": "Preheat oven to 260°C (500°F). Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 353409,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 red chili peppers\n1 medium head cauliflower\n2 green bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 353410,
      "primary_message": "Zest and juice lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 353411,
      "primary_message": "Quarter chili peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 353412,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil, salt, and pepper; whisk to combine the sauce.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 353413,
      "primary_message": "Pat chicken wings dry with paper towels and add to the bowl with the sauce; toss to coat. Transfer wings to the baking sheet, drizzle with any sauce left in the bowl, and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed"
    },
    {
      "id": 353414,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 353415,
      "primary_message": "Meanwhile, fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 353416,
      "primary_message": "While the water heats up, separate cauliflower into small bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 353417,
      "primary_message": "Once the water is boiling, uncover and add cauliflower and salt; stir for a few seconds. Cook until crisp-tender, about 3 minutes. Drain and rinse under cold water to cool; set aside to drain further.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 353418,
      "primary_message": "Meanwhile, place mayo, Dijon, vinegar, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "½ cup avocado oil mayonnaise\n2 tbsp Dijon mustard\n4 tsp white wine vinegar\n1 tsp curry powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 353419,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl along with the cooked cauliflower and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 353420,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Sprinkle over the wings and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 353421,
      "primary_message": "To serve, divide wings and cauliflower salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
