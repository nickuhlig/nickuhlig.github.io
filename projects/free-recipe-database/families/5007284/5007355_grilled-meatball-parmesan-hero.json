  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Lightly beat the eggs. Thinly slice or grate the whole milk mozzarella cheese. Halve the Italian hero rolls.",
      "secondary_message": "2 large eggs\n170 g whole milk mozzarella cheese\n4 Italian hero rolls"
    },
    {
      "id": 1,
      "primary_message": "For the Sauce: place olive oil, garlic, and crushed red pepper in medium saucepan over medium heat. When oil starts to bubble around garlic, stir in tomatoes. Bring to a boil, then reduce to a simmer and cook until sauce has slightly thickened, about 15 minutes. Stir in basil; season with sugar, salt, and pepper to taste. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Meatballs: In a large bowl, mix together chuck, pork, bread crumbs, egg, Parmesan, garlic, parsley, and red pepper flakes until thoroughly combined. Roll meat mixture into 16 meatballs 4 cm in diameter. Season meatballs all over liberally with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Set cooking grate in place, cover grill, and allow to preheat for 5 minutes. Clean and oil the grilling grate. Brush meatballs with olive oil and place on hot side of grill and cook until well browned all over and cooked through, about 8 minutes total, 2 minutes per side. Remove to plate.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Toast hero rolls on hot side of grill, cut side down, until lightly browned. Move rolls to cool side of the grill, cut side up, and fill with meatballs. Spoon sauce over meatballs and top with mozzarella cheese. Cover grill and cook until cheese has completely melted. Remove from grill and serve immediately.",
      "secondary_message": null
    }
  ],
