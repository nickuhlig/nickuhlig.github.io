  "instructions": [
    {
      "id": 106982,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 Gala apples\n¼ (1 inch) piece ginger root\n½ avocado\n1 (5 oz) pkg baby spinach\n1 banana"
    },
    {
      "id": 106983,
      "primary_message": "Peel and quarter apples, removing seeds and stem. Peel the banana. Add both to blender.",
      "secondary_message": null
    },
    {
      "id": 106984,
      "primary_message": "Wash, dry, peel, and slice ginger. (If you have a high powered blender, you can put the chunk in whole).",
      "secondary_message": null
    },
    {
      "id": 106985,
      "primary_message": "Halve and pit the avocado. Using a spoon, scoop the flesh into the blender.",
      "secondary_message": null
    },
    {
      "id": 106986,
      "primary_message": "Add spinach, almond milk, maple syrup, and 4 ice cubes to the blender.",
      "secondary_message": "8 fl oz (1 cup) almond milk, unsweetened\n1 tsp pure maple syrup"
    },
    {
      "id": 106987,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 106988,
      "primary_message": "Pour the smoothie into glasses and enjoy!",
      "secondary_message": null
    }
  ],
