  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve the Picholine olives. Halve the Niçoise olives. Zest the lemon. Quarter the blue basil.",
      "secondary_message": "20 Picholine olives\n20 Niçoise olives\n¼ lemon\n6 leaves blue basil"
    },
    {
      "id": 1,
      "primary_message": "Preheat the oven to 300 degrees F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place the halibut in a baking dish small enough so that when you pour the oil over the fish, it covers it.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake the fish for 45 to 50 minutes, or just until it flakes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Meanwhile, combine all the other ingredients in a bowl. When the fish is ready, stir 1/4 cup of the cooking oil into the \"tapenade.\" Spoon over the fish.",
      "secondary_message": null
    }
  ],
