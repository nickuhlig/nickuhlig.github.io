  "instructions": [
    {
      "id": 17916,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 pints grape tomatoes\n2 English cucumbers\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 17917,
      "primary_message": "Drain and rinse the chickpeas; place on a clean towel or paper towels and pat dry. Transfer to a large bowl and, using a potato masher or fork, mash into a paste.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 17918,
      "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and mince the leaves. Add ½ of the parsley to the bowl with the chickpeas and transfer the other ½ to a medium salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 17919,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add ½ of the garlic to the bowl with the chickpeas and transfer the other ½ to a small bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 17920,
      "primary_message": "Juice the lemon; add ½ of the juice to the bowl with the chickpeas and add the other ½ to the small bowl with the garlic.",
      "secondary_message": ""
    },
    {
      "id": 17921,
      "primary_message": "Add olive oil to a nonstick skillet and heat over medium-high heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 17922,
      "primary_message": "To the bowl of chickpeas, add olive oil, flour, coriander, cumin, salt, and pepper; stir until well combined. Form the mixture into 12 patties and place on a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp all-purpose flour\n2 tsp coriander\n2 tsp cumin\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 17923,
      "primary_message": "Once the skillet is hot, add ½ of the patties and cook until golden brown and crispy, 3 to 5 minutes per side. Once done, transfer to a plate. Repeat with the remaining patties and more olive oil.",
      "secondary_message": ""
    },
    {
      "id": 17924,
      "primary_message": "Halve the grape tomatoes and add to the salad bowl with the parsley.",
      "secondary_message": ""
    },
    {
      "id": 17925,
      "primary_message": "Trim off and discard the ends of the cucumbers; coarsely grate ½ of one cucumber and add to the bowl with the garlic and lemon juice, then quarter the remaining cucumbers lengthwise and cut crosswise into ¼-inch-thick pieces. Add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 38714,
      "primary_message": "Add yogurt to the bowl with the garlic, lemon juice, and cucumber; season with salt and pepper and mix together.",
      "secondary_message": "1 cup plain Greek yogurt\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 38715,
      "primary_message": "To the salad bowl, add olive oil, vinegar, salt, and pepper; toss to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 38716,
      "primary_message": "To serve, place the patties on a plate, add the salad on the side, and serve with tzatziki sauce. Enjoy!",
      "secondary_message": null
    }
  ],
