  "instructions": [
    {
      "id": 169098,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 169099,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 medium carrots\n3 lemons\n3 avocados\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 169100,
      "primary_message": "Peel and thinly slice the carrots at an angle.",
      "secondary_message": null
    },
    {
      "id": 169101,
      "primary_message": "Once the water in the saucepan is boiling, add the carrots and cook until fork-tender, about 5 minutes. Drain and rinse under cold water and set aside.",
      "secondary_message": null
    },
    {
      "id": 169102,
      "primary_message": "Meanwhile, zest half of the lemons into a large bowl, then juice all the lemons into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 169103,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 169104,
      "primary_message": "Add oil and spices to the bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp oregano\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 169105,
      "primary_message": "Peel and mince the shallots; add to the bowl, stirring to combine.",
      "secondary_message": "1 ½ shallots"
    },
    {
      "id": 169106,
      "primary_message": "Halve and pit the avocados; cut the flesh into cubes while still in the skin and scoop out into the bowl. ",
      "secondary_message": null
    },
    {
      "id": 169107,
      "primary_message": "Roughly chop the pistachios and add to the bowl.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 169108,
      "primary_message": "Drain and rinse the beans in the colander with the carrots, then add both to the bowl and toss to combine the salad.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 169109,
      "primary_message": "To serve, divide spinach between plates and top with vegetable-bean salad. Enjoy!",
      "secondary_message": null
    }
  ],
