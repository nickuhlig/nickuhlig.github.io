  "instructions": [
    {
      "id": 461764,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 ½ limes\n3 red bell peppers\n1 ½ English cucumbers"
    },
    {
      "id": 461765,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 461766,
      "primary_message": "Juice limes into the bowl with the cilantro. Add half of the peanut sauce, water, and salt; stir to combine the dressing and set aside. (Place remaining peanut sauce in a small bowl and set aside for serving.)",
      "secondary_message": "1 cup peanut sauce\n3 tbsp water\n½ tsp salt"
    },
    {
      "id": 461767,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461768,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, curry paste, and salt; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n680 g veggie ground, plant based\n2 tbsp Thai curry paste, green\n3 pinch salt"
    },
    {
      "id": 461769,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers into thin strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 461770,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into thin pieces. Add to the bowl, along with the shredded cabbage, and stir to combine the slaw. Set aside.",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 461771,
      "primary_message": "When the veggie ground is done, add additional water to the skillet. Continue to cook, stirring occasionally, until the sauce is thickened, 2-3 minutes more. Remove from heat.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 461772,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 461773,
      "primary_message": "Divide tortillas between plates, then fill with veggie ground and a small portion of the slaw. Drizzle tacos with reserved peanut sauce and serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
