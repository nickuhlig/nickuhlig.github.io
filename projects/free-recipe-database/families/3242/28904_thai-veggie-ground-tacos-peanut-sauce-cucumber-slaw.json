  "instructions": [
    {
      "id": 461694,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 lime\n2 red bell peppers\n1 English cucumber"
    },
    {
      "id": 461695,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 461696,
      "primary_message": "Juice lime into the bowl with the cilantro. Add half of the peanut sauce, water, and salt; stir to combine the dressing and set aside. (Place remaining peanut sauce in a small bowl and set aside for serving.)",
      "secondary_message": "⅔ cup peanut sauce\n2 tbsp water\n¼ tsp salt"
    },
    {
      "id": 461697,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461698,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, curry paste, and salt; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp virgin coconut oil\n16 oz veggie ground, plant based\n4 tsp Thai curry paste, green\n⅛ tsp salt"
    },
    {
      "id": 461699,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers into thin strips. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 461700,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into thin pieces. Add to the bowl, along with the shredded cabbage, and stir to combine the slaw. Set aside.",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)"
    },
    {
      "id": 461701,
      "primary_message": "When the veggie ground is done, add additional water to the skillet. Continue to cook, stirring occasionally, until the sauce is thickened, 1-2 minutes more. Remove from heat.",
      "secondary_message": "⅓ cup water"
    },
    {
      "id": 461702,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 461703,
      "primary_message": "Divide tortillas between plates, then fill with veggie ground and a small portion of the slaw. Drizzle tacos with reserved peanut sauce and serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
