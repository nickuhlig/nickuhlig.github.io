  "instructions": [
    {
      "id": 157038,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n½ small bunch green onions (scallions)\n1 head butter (Boston) lettuce"
    },
    {
      "id": 157039,
      "primary_message": "Medium dice tomatoes; set aside.",
      "secondary_message": null
    },
    {
      "id": 157040,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces at an angle. Set aside.",
      "secondary_message": null
    },
    {
      "id": 157041,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157042,
      "primary_message": "Cut bacon strips in half; add to the skillet and cook until crispy, 3-4 minutes per side. Cook in batches if necessary.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 157043,
      "primary_message": "Meanwhile, grate cheese.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 157044,
      "primary_message": "Crack the eggs into a medium bowl and season with salt and pepper; whisk together. ",
      "secondary_message": "8 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 157045,
      "primary_message": "When the bacon is done, remove and set aside on a paper towel-lined plate. Pour off all but 2 tsp bacon fat and return skillet to medium heat.",
      "secondary_message": null
    },
    {
      "id": 157046,
      "primary_message": "Pour egg mixture into the skillet. Scramble eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Sprinkle with cheese and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 157047,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Top with cheesy eggs, bacon, tomato, and green onion. Enjoy!",
      "secondary_message": null
    }
  ],
