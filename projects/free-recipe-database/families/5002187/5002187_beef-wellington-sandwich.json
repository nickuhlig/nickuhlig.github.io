  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Split the croissants. Thinly slice the shallot crosswise. Stem and cut the cremini mushrooms into 1/4-inch slices.",
      "secondary_message": "4 large croissants, homemade or store-bought\n1 small shallot\n1 lb cremini mushrooms"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 375ºF (190°C). On a 13-by-18-inch rimmed baking sheet, place croissants cut-side up and toast until edges are lightly browned and slightly crisp, 6 to 8 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together mayonnaise, mustard, and horseradish. Season with salt and pepper to taste. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium skillet over medium high heat, melt butter. Add shallots, mushrooms, thyme, salt, and pepper. Cook, stirring occasionally, until mushrooms are well browned, 6 to 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To Assemble: Using a butter knife or offset spatula, spread 1 tablespoon mayonnaise sauce evenly over 1 side of each croissant half. Top each bottom half with 3 ounces roast beef (about 2 slices), 1 ounce prosciutto (about 2 slices), and 1/4 of the arugula. Divide mushrooms equally (about 1/3 cup each) between the top halves and carefully flip top half of croissant onto each bottom half to close the sandwich, pressing gently to secure.",
      "secondary_message": null
    }
  ],
