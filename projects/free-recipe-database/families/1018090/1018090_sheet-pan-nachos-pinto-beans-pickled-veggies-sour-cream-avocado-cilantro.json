  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons.",
      "secondary_message": "½ medium red onion"
    },
    {
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "primary_message": "Place vinegar, water, sugar, and spices in a small saucepan. Stir to combine and bring to a boil over high heat. ",
      "secondary_message": "⅓ cup apple cider vinegar\n⅓ cup water\n1 ½ tbsp brown sugar\n½ tsp salt\n¼ tsp coriander, ground\n¼ tsp black pepper"
    },
    {
      "primary_message": "Once boiling, remove from heat. Add onion and jalapeño to the pan; stir to combine and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (15 oz) can pinto beans"
    },
    {
      "primary_message": "Small dice tomatoes and place in a small bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Place in another small bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange tortilla chips on a large baking sheet pan, spreading them out in an even layer. Top with beans and cheese. ",
      "secondary_message": "6 oz tortilla chips\n1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "primary_message": "Place nachos in the oven and bake until beans are warmed through and cheese is melted, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, have and pit avocados; using a spoon, scoop out the flesh and small dice. Place in a third small bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide nachos between plates and top with tomato, cilantro, avocado, pickled veggies, and sour cream as desired. Enjoy!",
      "secondary_message": "⅔ cup sour cream"
    }
  ],
