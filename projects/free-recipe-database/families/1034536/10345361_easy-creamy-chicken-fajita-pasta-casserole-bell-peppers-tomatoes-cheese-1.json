  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips. Place in a large bowl.",
      "secondary_message": "1 red bell pepper\n1 green bell pepper"
    },
    {
      "primary_message": "Small dice cream cheese. Add to the bowl with the bell pepper.\n\n",
      "secondary_message": "½ (227 g) block cream cheese"
    },
    {
      "primary_message": "Pat chicken dry with paper towels and large dice. Add to the bowl, along with tomatoes, pasta, water, minced garlic, fajita seasoning, salt, and pepper, then stir to combine. Transfer to a large (3-quart) baking dish, spread out in an even layer, and loosely cover with aluminum foil.\n\n",
      "secondary_message": "680 g chicken breasts, boneless skinless\n1 (411 g) can diced tomatoes\n227 g rotini pasta\n¾ cup water\n1 tbsp minced garlic\n1 (28 g) pkg fajita seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Place casserole in the preheated oven and bake until the chicken is cooked through and pasta is fork-tender, 40-45 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove casserole from the oven, uncover, and stir. Spread back out in an even layer and sprinkle with cheese. Return casserole to the oven and continue to bake until cheese is bubbly and golden, 10 minutes more. Remove from oven.\n\n",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "primary_message": "To serve, divide casserole between plates and enjoy!",
      "secondary_message": null
    }
  ],
