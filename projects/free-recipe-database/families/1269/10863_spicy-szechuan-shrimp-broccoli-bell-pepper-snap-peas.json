  "instructions": [
    {
      "id": 178856,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 178857,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 crowns broccoli\n3 red bell peppers\n3 small bunches green onions (scallions)\n1 ½ (8 oz) pkg sugar snap peas"
    },
    {
      "id": 178858,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 178859,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 178860,
      "primary_message": "Peel and mince ginger; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 178861,
      "primary_message": "Add water, ketchup, soy sauce, cornstarch, honey, and crushed red pepper to the bowl with the ginger. Whisk to combine the sauce and set aside.",
      "secondary_message": "¾ cup water\n⅓ cup ketchup\n3 tbsp soy sauce\n2 tbsp cornstarch\n1 tbsp honey\n1 ½ tsp crushed red pepper"
    },
    {
      "id": 178862,
      "primary_message": "Chop broccoli into bite-size florets. Seed bell peppers and medium dice. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 178863,
      "primary_message": "Peel and mince garlic. Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 178864,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 178865,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 178866,
      "primary_message": "Add garlic and half the green onions to the pot (reserve the rest for garnish); cook until fragrant, 15-30 seconds.",
      "secondary_message": null
    },
    {
      "id": 178867,
      "primary_message": "Add broccoli, bell pepper, and snap peas. Cook, stirring occasionally, until tender-crisp, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 178868,
      "primary_message": "Add shrimp and sauce to the pot. Cook, stirring occasionally, until shrimp are opaque and the sauce begins to thicken, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 178869,
      "primary_message": "To serve, divide rice between bowls. Top with shrimp, vegetables, and remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
