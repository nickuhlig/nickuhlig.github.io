  "instructions": [
    {
      "id": 253126,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 253127,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with yogurt, mayo, vinegar, Dijon, sugar, and spices; whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n⅛ cup plain Greek yogurt\n1 ½ tbsp mayonnaise\n1 tbsp apple cider vinegar\n2 tsp Dijon mustard\n1 tsp brown sugar\n½ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 253128,
      "primary_message": "Arrange sausages on a baking sheet pan and place in the oven (it doesn't have to be fully heated); bake, flipping once, until sausages are golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 253129,
      "primary_message": "Meanwhile, wash and dry cabbage. Trim off and discard the root end, halve lengthwise, then thinly slice crosswise; add to the bowl with the dressing.",
      "secondary_message": "½ medium head napa cabbage"
    },
    {
      "id": 253130,
      "primary_message": "Wash, dry, peel, and coarsely grate carrot; add to to the bowl and toss to combine the slaw. Set aside.",
      "secondary_message": "1 medium carrot"
    },
    {
      "id": 253131,
      "primary_message": "Peel and mince additional garlic. Peel and small dice onion.",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 253132,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 253133,
      "primary_message": "While the skillet heats up, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 253134,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and onion; cook, stirring often, until starting to soften, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 253135,
      "primary_message": "Meanwhile, place water, ketchup, vinegar, sugar, Worcestershire, Dijon, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "½ cup water\n2 tbsp ketchup\n2 tsp apple cider vinegar\n2 tsp brown sugar\n1 ½ tsp Worcestershire sauce\n½ tsp Dijon mustard\n¼ tsp paprika\n⅛ tsp black pepper\n1 pinch salt"
    },
    {
      "id": 253136,
      "primary_message": "Add beans and BBQ sauce to the skillet. Continue to cook, stirring often, until liquid has reduced to a saucy consistency, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 253137,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into rounds. Add to the skillet with the beans, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 253138,
      "primary_message": "To serve, divide slaw, beans, and sausage between plates. Enjoy!",
      "secondary_message": null
    }
  ],
