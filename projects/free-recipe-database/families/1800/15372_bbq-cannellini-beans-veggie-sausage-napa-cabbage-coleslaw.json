  "instructions": [
    {
      "id": 253178,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 253179,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with yogurt, mayo, vinegar, Dijon, sugar, and spices; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n¼ cup plain Greek yogurt\n¼ cup mayonnaise\n2 tbsp apple cider vinegar\n4 tsp Dijon mustard\n2 tsp brown sugar\n1 tsp onion powder\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 253180,
      "primary_message": "Wash and dry cabbage. Trim off and discard the root end, halve lengthwise, then thinly slice crosswise; add to the bowl with the dressing.",
      "secondary_message": "1 medium head napa cabbage"
    },
    {
      "id": 253181,
      "primary_message": "Wash, dry, peel, and coarsely grate carrots; add to to the bowl and toss to combine the slaw. Set aside.",
      "secondary_message": "2 medium carrots"
    },
    {
      "id": 253182,
      "primary_message": "Arrange sausages on the baking sheet and place in the oven (it doesn't have to be fully heated); bake, flipping once, until sausages are golden and warmed through, about 10 minutes. Remove from oven.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 253183,
      "primary_message": "Peel and mince additional garlic. Peel and small dice onion.",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 253184,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 253185,
      "primary_message": "While the skillet heats up, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 253186,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and onion; cook, stirring often, until starting to soften, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 253187,
      "primary_message": "Meanwhile, place water, ketchup, vinegar, sugar, soy sauce, Dijon, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "¾ cup water\n¼ cup ketchup\n4 tsp apple cider vinegar\n4 tsp brown sugar\n1 tbsp soy sauce\n1 tsp Dijon mustard\n½ tsp paprika\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 253188,
      "primary_message": "Add beans and BBQ sauce to the skillet. Continue to cook, stirring often, until liquid has reduced to a saucy consistency, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 253189,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into rounds. Add to the skillet with the beans, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 253190,
      "primary_message": "To serve, divide slaw, beans, and sausage between plates. Enjoy!",
      "secondary_message": null
    }
  ],
