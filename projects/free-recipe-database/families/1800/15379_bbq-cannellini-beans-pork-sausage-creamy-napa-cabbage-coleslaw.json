  "instructions": [
    {
      "id": 253269,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 253270,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with yogurt, mayo, vinegar, Dijon, sugar, and spices; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n½ cup plain Greek yogurt\n¼ cup mayonnaise\n3 tbsp apple cider vinegar\n2 tbsp Dijon mustard\n1 tbsp brown sugar\n1 ½ tsp onion powder\n1 ¼ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 253271,
      "primary_message": "Arrange sausages on a baking sheet pan and place in the oven (it doesn't have to be fully heated); bake, flipping once, until sausages are golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 253272,
      "primary_message": "Meanwhile, wash and dry cabbages. Trim off and discard the root end of each cabbage, halve lengthwise, then thinly slice crosswise; add to the bowl with the dressing.",
      "secondary_message": "1 ½ medium heads napa cabbage"
    },
    {
      "id": 253273,
      "primary_message": "Wash, dry, peel, and coarsely grate carrots; add to to the bowl and toss to combine the slaw. Set aside.",
      "secondary_message": "3 medium carrots"
    },
    {
      "id": 253274,
      "primary_message": "Peel and mince additional garlic. Peel and small dice onions.",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 253275,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 253276,
      "primary_message": "While the skillet heats up, drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 253277,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and onion; cook, stirring often, until starting to soften, 5-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 253278,
      "primary_message": "Meanwhile, place water, ketchup, vinegar, sugar, Worcestershire, Dijon, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "1 cup water\n⅓ cup ketchup\n2 tbsp apple cider vinegar\n2 tbsp brown sugar\n1 ½ tbsp Worcestershire sauce\n1 ½ tsp Dijon mustard\n¾ tsp paprika\n½ tsp black pepper\n3 pinch salt"
    },
    {
      "id": 253279,
      "primary_message": "Add beans and BBQ sauce to the skillet. Continue to cook, stirring often, until liquid has reduced to a saucy consistency, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 253280,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into rounds. Add to the skillet with the beans, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 253281,
      "primary_message": "To serve, divide slaw, beans, and sausage between plates. Enjoy!",
      "secondary_message": null
    }
  ],
