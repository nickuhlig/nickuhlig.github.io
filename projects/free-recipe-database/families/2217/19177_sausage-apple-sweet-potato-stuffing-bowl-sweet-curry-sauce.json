  "instructions": [
    {
      "id": 315821,
      "primary_message": "Preheat oven to 450°F and position racks in the upper and middle thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 315822,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n1 ½ lb sweet potatoes\n3 sticks celery\n3 Gala apples"
    },
    {
      "id": 315823,
      "primary_message": "Peel, trim, and medium dice carrots and sweet potatoes. Divide both between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 315824,
      "primary_message": "Trim and medium dice celery; peel, halve, and medium dice onions. Add both to the baking sheets with the other veggies, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "1 ½ medium red onions\n2 tbsp extra virgin olive oil\n1 ½ tsp sage, dried\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cinnamon, ground"
    },
    {
      "id": 315825,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 315826,
      "primary_message": "Meanwhile, quarter, core, and medium dice apples.",
      "secondary_message": null
    },
    {
      "id": 315827,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 315828,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add apple, sausage, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes; remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ lb ground pork sausage\n¾ tsp sage, dried\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 315829,
      "primary_message": "While the sausage and apple are cooking, place yogurt, water, honey, Dijon, and spices in a small bowl; whisk to combine the sauce. Add additional water, 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp water\n1 tbsp honey\n1 tbsp Dijon mustard\n1 tbsp curry powder\n¾ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 315830,
      "primary_message": "Cut bread into 1-inch cubes.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 315831,
      "primary_message": "When the veggies are done, remove from oven and set oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 315832,
      "primary_message": "Sprinkle bread cubes over the veggies; working in batches if necessary, return the baking sheets to the top rack of the oven, and broil until golden and toasted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 315833,
      "primary_message": "When the bread cubes are done, remove from the oven; add sausage mixture to the baking sheets and toss to combine the \"stuffing.\"",
      "secondary_message": null
    },
    {
      "id": 315834,
      "primary_message": "To serve, divide stuffing between bowls, drizzle with sauce, and enjoy!",
      "secondary_message": null
    }
  ],
