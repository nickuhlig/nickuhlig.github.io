  "instructions": [
    {
      "id": 316003,
      "primary_message": "Preheat oven to 230°C (450°F) and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 316004,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n0.23 kg sweet potato\n1 stick celery\n1 Gala apple"
    },
    {
      "id": 316005,
      "primary_message": "Peel, trim, and medium dice carrot and sweet potato. Transfer both to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 316006,
      "primary_message": "Trim and medium dice celery; peel, halve, and medium dice onion. Add both to the baking sheet with the other veggies, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "½ medium red onion\n2 tsp extra virgin olive oil\n½ tsp sage, dried\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cinnamon, ground"
    },
    {
      "id": 316007,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 316008,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 316009,
      "primary_message": "While the skillet heats up, quarter, core, and medium dice apple.",
      "secondary_message": null
    },
    {
      "id": 316010,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add apple, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes; remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp Italian seasoning\n¼ tsp sage, dried\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 316011,
      "primary_message": "While the veggie ground and apple are cooking, place yogurt, water, honey, Dijon, and spices in a small bowl; whisk to combine the sauce. Add additional water, 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp water\n1 tsp honey\n1 tsp Dijon mustard\n1 tsp curry powder\n¼ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 316012,
      "primary_message": "Cut bread into 1-inch cubes.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 316013,
      "primary_message": "When the veggies are done, remove from oven and set oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 316014,
      "primary_message": "Sprinkle bread cubes over the veggies, return baking sheet to the oven, and broil until golden and toasted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 316015,
      "primary_message": "When the bread cubes are done, remove from the oven; add veggie ground mixture to the baking sheet and toss to combine the \"stuffing.\"",
      "secondary_message": null
    },
    {
      "id": 316016,
      "primary_message": "To serve, divide stuffing between bowls, drizzle with sauce, and enjoy!",
      "secondary_message": null
    }
  ],
