  "instructions": [
    {
      "id": 1,
      "primary_message": "Purée plums in a blender or food processor until smooth. Once pitted, 2 pounds of plums should yield 1 quart of purée. Add sugar and corn syrup and blend for 30 seconds. Add salt, blend to incorporate, and adjust to taste. If plums are very sweet, add lemon juice to taste, starting with 1/4 teaspoon.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain purée and transfer to refrigerator; chill for 2 to 3 hours until very cold. Churn sorbet in ice cream maker according to manufacturer's instructions. Transfer sorbet to freezer to firm up for 2 to 3 hours before serving.",
      "secondary_message": null
    }
  ],
