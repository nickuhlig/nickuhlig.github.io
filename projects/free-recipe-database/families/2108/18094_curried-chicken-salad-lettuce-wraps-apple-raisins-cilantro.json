  "instructions": [
    {
      "id": 293623,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 sticks celery\n3 Gala apples\n1 small bunch cilantro\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 293624,
      "primary_message": "Peel and mince shallots; place in a large bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 293625,
      "primary_message": "Add yogurt, mayo, curry powder, and salt to the bowl with the shallot; whisk to combine the dressing.",
      "secondary_message": "1 cup plain Greek yogurt\n¾ cup mayonnaise\n3 tbsp curry powder\n¾ tsp salt"
    },
    {
      "id": 293626,
      "primary_message": "Trim and small dice celery; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 293627,
      "primary_message": "Quarter, core, and small dice apples; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 293628,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 293629,
      "primary_message": "Add raisins to the bowl.",
      "secondary_message": "¾ cup raisins"
    },
    {
      "id": 293630,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, add to the bowl, and stir to combine the chicken salad.",
      "secondary_message": "1 ½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 293631,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with chicken salad and enjoy!",
      "secondary_message": null
    }
  ],
