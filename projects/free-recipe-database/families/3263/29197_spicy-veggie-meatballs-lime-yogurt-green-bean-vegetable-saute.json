  "instructions": [
    {
      "id": 466001,
      "primary_message": "Preheat oven to 450°F. Coat a baking dish with a thin layer of oil.",
      "secondary_message": "1 tsp neutral vegetable oil"
    },
    {
      "id": 466002,
      "primary_message": "Place veggie ground, bread crumbs, hot sauce, oil, and spices in a medium bowl. Using your hands, mix well to combine. Using a tablespoon measure, form the veggie ground mixture into mini rounded \"meatballs.\" Transfer to the baking dish.",
      "secondary_message": "8 oz veggie ground, plant based\n¼ cup panko bread crumbs\n2 tbsp hot sauce\n1 tsp neutral vegetable oil\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 466003,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 466004,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ red bell pepper\n½ lb green beans\n½ lime"
    },
    {
      "id": 466005,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 466006,
      "primary_message": "Trim and cut green beans crosswise into 1-inch pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 466007,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 466008,
      "primary_message": "While the skillet heats up, drain and roughly chop water chestnuts. Add to the bowl along with corn.",
      "secondary_message": "5 oz water chestnuts\n1 cup frozen corn"
    },
    {
      "id": 466009,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; sauté until tender and starting to brown, 6-8 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp neutral vegetable oil\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 466010,
      "primary_message": "Meanwhile, juice lime into the reserved bowl. Add yogurt, water, garlic powder, and salt, then stir to combine the sauce.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tsp water\n¼ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 466011,
      "primary_message": "To serve, divide meatballs and veggies between plates or bowls. Drizzle meatballs with sauce and enjoy!",
      "secondary_message": null
    }
  ],
