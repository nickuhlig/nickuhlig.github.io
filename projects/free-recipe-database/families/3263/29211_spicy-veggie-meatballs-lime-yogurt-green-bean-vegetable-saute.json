  "instructions": [
    {
      "id": 466155,
      "primary_message": "Preheat oven to 230°C (450°F). Coat two large baking dishes with a thin layer of oil.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 466156,
      "primary_message": "Place veggie ground, bread crumbs, hot sauce, oil, and spices in a large bowl. Using your hands, mix well to combine. Using a tablespoon measure, form the veggie ground mixture into mini rounded \"meatballs.\" Divide between the baking dishes.",
      "secondary_message": "680 g veggie ground, plant based\n¾ cup panko bread crumbs\n⅓ cup hot sauce\n1 tbsp neutral vegetable oil\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 466157,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 466158,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ red bell peppers\n0.68 kg green beans\n1 ½ limes"
    },
    {
      "id": 466159,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 466160,
      "primary_message": "Trim and cut green beans crosswise into 1-inch pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 466161,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 466162,
      "primary_message": "While the pot heats up, drain and roughly chop water chestnuts. Add to the bowl along with corn.",
      "secondary_message": "425 g water chestnuts\n3 cups frozen corn"
    },
    {
      "id": 466163,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; sauté until tender and starting to brown, 8-10 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp neutral vegetable oil\n1 tbsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 466164,
      "primary_message": "Meanwhile, juice limes into the reserved bowl. Add yogurt, water, garlic powder, and salt, then stir to combine the sauce.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n2 tbsp water\n¾ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 466165,
      "primary_message": "To serve, divide meatballs and veggies between plates or bowls. Drizzle meatballs with sauce and enjoy!",
      "secondary_message": null
    }
  ],
