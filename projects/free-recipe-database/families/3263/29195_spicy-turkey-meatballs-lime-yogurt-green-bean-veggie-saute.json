  "instructions": [
    {
      "id": 465979,
      "primary_message": "Preheat oven to 450°F. Coat a large baking dish with a thin layer of oil.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 465980,
      "primary_message": "Place turkey, bread crumbs, hot sauce, oil, and spices in a medium bowl. Using your hands, mix well to combine. Using a tablespoon measure, form the turkey mixture into mini rounded meatballs. Transfer to the baking dish.",
      "secondary_message": "1 ½ lb ground turkey\n⅔ cup panko bread crumbs\n¼ cup hot sauce\n2 tsp neutral vegetable oil\n1 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 465981,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 465982,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 lb green beans\n1 lime"
    },
    {
      "id": 465983,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 465984,
      "primary_message": "Trim and cut green beans crosswise into 1-inch pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 465985,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 465986,
      "primary_message": "While the skillet heats up, drain and roughly chop water chestnuts. Add to the bowl along with corn.",
      "secondary_message": "10 oz water chestnuts\n2 cups frozen corn"
    },
    {
      "id": 465987,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; sauté until tender and starting to brown, 6-8 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp neutral vegetable oil\n2 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 465988,
      "primary_message": "Meanwhile, juice lime into the reserved bowl. Add yogurt, water, garlic powder, and salt, then stir to combine the sauce.",
      "secondary_message": "1 cup plain Greek yogurt\n4 tsp water\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 465989,
      "primary_message": "To serve, divide meatballs and veggies between plates or bowls. Drizzle meatballs with sauce and enjoy!",
      "secondary_message": null
    }
  ],
