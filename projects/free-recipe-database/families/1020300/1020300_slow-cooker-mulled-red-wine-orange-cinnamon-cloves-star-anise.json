  "instructions": [
    {
      "primary_message": "Wash, dry, and cut orange crosswise into ½-inch thick slices. Place in a 4-quart slow cooker insert.",
      "secondary_message": "1 orange"
    },
    {
      "primary_message": "Break cinnamon sticks in half. Add to the insert with the orange along with cloves, star anise, and sugar.",
      "secondary_message": "2 star anise, whole\n¼ cup brown sugar"
    },
    {
      "primary_message": "Add wine to the insert and stir to combine. Cover and cook until warm and flavors have blended, about 4 hours on low or 2 hours on high. ",
      "secondary_message": "2 (750 ml) bottle red wine (such as Cabernet Sauvignon)"
    },
    {
      "primary_message": "To serve, remove spices and divide mulled wine between mugs or glasses. Enjoy!",
      "secondary_message": null
    },
    {
      "primary_message": "This recipe is intended for customers 21 years of age or older. Please drink responsibly.",
      "secondary_message": null
    }
