  "instructions": [
    {
      "id": 97944,
      "primary_message": "Preheat oven to broil and position a rack under the broiler; position a second rack in the bottom portion of the oven and place a baking sheet on it to preheat.",
      "secondary_message": null
    },
    {
      "id": 97945,
      "primary_message": "While the oven heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 97946,
      "primary_message": "Wash and dry the fresh produce (skip the broccoli slaw if it came pre-washed).",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 oranges\n3 (12 oz) pkg broccoli slaw\n1 ½ bunches kale"
    },
    {
      "id": 97947,
      "primary_message": "Peel and mince or grate the ginger; place in a medium salad bowl and add peanut butter, chili garlic sauce, honey, and salt.",
      "secondary_message": "3 tbsp natural peanut butter\n1 tbsp chili-garlic sauce\n1 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 97948,
      "primary_message": "Juice oranges into the salad bowl and whisk to combine the dressing.",
      "secondary_message": null
    },
    {
      "id": 97949,
      "primary_message": "Carefully remove the baking sheet from the oven and use tongs to transfer steak onto it. Place under broiler on top rack and cook 6-7 minutes for medium rare, flipping once halfway through. Transfer steak to a plate and let it rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 97950,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the salad bowl; add broccoli slaw.",
      "secondary_message": null
    },
    {
      "id": 97951,
      "primary_message": "Drizzle any pan juices over the salad and toss with salad dressing to combine.",
      "secondary_message": null
    },
    {
      "id": 97952,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 97953,
      "primary_message": "To serve, divide the salad between plates or bowls along with steak strips. Enjoy!",
      "secondary_message": null
    }
  ],
