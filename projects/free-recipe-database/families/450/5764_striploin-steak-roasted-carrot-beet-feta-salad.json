  "instructions": [
    {
      "id": 68932,
      "primary_message": "Preheat the oven to 500°F. Place the rack in the center position.",
      "secondary_message": ""
    },
    {
      "id": 68922,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 medium beets\n1 ½ small pkg fresh thyme"
    },
    {
      "id": 68931,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Cut the carrots into ¼-inch-thick rounds (at an angle). Transfer the carrots to a baking sheet.",
      "secondary_message": ""
    },
    {
      "id": 68930,
      "primary_message": "Trim off and discard the ends of the beets; peel and cut the beets into ¼-inch thick wedges. (To avoid staining, line your cutting board with paper towels before handling the beets.) Transfer the beets to the baking sheet.",
      "secondary_message": ""
    },
    {
      "id": 68929,
      "primary_message": "One by one, holding a sprig of thyme at its top, run you fingers down it to remove the leaves. Discard the sprigs and chop the leaves. Sprinkle ¾ of the leaves over the carrots and beets (save the rest for garnishing).",
      "secondary_message": ""
    },
    {
      "id": 68921,
      "primary_message": "Drizzle the carrots and beets with olive oil and season with salt and pepper; toss to coat, then arrange in a single layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 68928,
      "primary_message": "Place the baking sheet in the oven and roast until the carrots and beets are tender, 15 to 20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68927,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 68920,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season generously with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 68926,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 68925,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68924,
      "primary_message": "Measure out the feta.",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 68923,
      "primary_message": "To serve, place the steak on a plate, arrange the roasted vegetables on the side and sprinkle with the feta and remaining thyme. Enjoy!",
      "secondary_message": ""
    }
  ],
