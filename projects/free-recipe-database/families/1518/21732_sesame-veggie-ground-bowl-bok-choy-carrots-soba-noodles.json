  "instructions": [
    {
      "id": 365684,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat. Once boiling, reduce to medium, and let simmer, covered, until you are ready to cook the noodles.",
      "secondary_message": null
    },
    {
      "id": 365685,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "12 baby bok choy\n3 medium carrots\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 365686,
      "primary_message": "Place soy sauce, oil, maple syrup, and chili-garlic sauce in a large bowl. Whisk to combine the sauce.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp toasted sesame oil\n2 tbsp pure maple syrup\n2 ½ tsp chili-garlic sauce"
    },
    {
      "id": 365687,
      "primary_message": "Trim off and discard root ends of the bok choy; separate into leaves and add to the bowl with the sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 365688,
      "primary_message": "Peel, trim, and thinly slice carrots crosswise. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 365689,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365690,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n680 g veggie ground, plant based"
    },
    {
      "id": 365691,
      "primary_message": "Meanwhile, peel and mince ginger and garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 365692,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 365693,
      "primary_message": "When the veggie ground is done, add ginger, garlic, and green onion to the pot with the veggie ground. Continue to cook, stirring often, until fragrant, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 365694,
      "primary_message": "Add carrots and broth to the pot, stir to combine, and bring to a simmer.",
      "secondary_message": "355 ml chicken or vegetable broth"
    },
    {
      "id": 365695,
      "primary_message": "Add bok choy and sauce to the pot. Cover and cook until veggies are fork-tender, 4-5 minutes; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 365696,
      "primary_message": "Meanwhile, return water in the pot to a boil, add noodles, and cook according to package directions, about 5 minutes. Once done, drain in a colander.",
      "secondary_message": "425 g soba (buckwheat) noodles"
    },
    {
      "id": 365697,
      "primary_message": "To serve, divide noodles between bowls. Top with veggie ground, vegetables, sauce, and sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
