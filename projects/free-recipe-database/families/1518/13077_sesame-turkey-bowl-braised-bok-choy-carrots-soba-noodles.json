  "instructions": [
    {
      "id": 365474,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat. Once boiling, reduce to medium, and let simmer, covered, until you are ready to cook the noodles.",
      "secondary_message": null
    },
    {
      "id": 365475,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "12 baby bok choy\n3 medium carrots\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 365476,
      "primary_message": "Place soy sauce, oil, honey, and chili-garlic sauce in a large bowl. Whisk to combine the sauce.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp toasted sesame oil\n2 tbsp honey\n2 ½ tsp chili-garlic sauce"
    },
    {
      "id": 365477,
      "primary_message": "Trim off and discard root ends of the bok choy; separate into leaves and add to the bowl with the sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 365478,
      "primary_message": "Peel and thinly slice carrots; transfer to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 365479,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365480,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ground turkey and cook, breaking apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 ¼ lb ground turkey"
    },
    {
      "id": 365481,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 365482,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 365483,
      "primary_message": "When the turkey is done, add garlic, ginger, and green onions to the pot; stir to combine, and continue to cook until fragrant, 1 minute more.",
      "secondary_message": null
    },
    {
      "id": 365484,
      "primary_message": "Add carrots and broth to the pot, stir to combine, and bring to a simmer.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 365485,
      "primary_message": "Add bok choy and sauce to the pot. Cover and cook until veggies are fork-tender, 4-5 minutes; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 365486,
      "primary_message": "Meanwhile, return water in the first pot to a boil, add noodles, and cook according to package directions, 5-7 minutes. Once done, drain in a colander.",
      "secondary_message": "15 oz soba (buckwheat) noodles"
    },
    {
      "id": 365487,
      "primary_message": "To serve, divide noodles between bowls. Top with turkey, veggies, sauce, and sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
