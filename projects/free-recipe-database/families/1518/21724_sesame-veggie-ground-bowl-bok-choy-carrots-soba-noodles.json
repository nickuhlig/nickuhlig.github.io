  "instructions": [
    {
      "id": 365488,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat. Once boiling, reduce to medium, and let simmer, covered, until you are ready to cook the noodles.",
      "secondary_message": null
    },
    {
      "id": 365489,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 baby bok choy\n1 medium carrot\n1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 365490,
      "primary_message": "Place soy sauce, oil, maple syrup, and chili-garlic sauce in a medium bowl. Whisk to combine the sauce.",
      "secondary_message": "1 tbsp soy sauce\n2 tsp toasted sesame oil\n2 tsp pure maple syrup\n¾ tsp chili-garlic sauce"
    },
    {
      "id": 365491,
      "primary_message": "Trim off and discard root ends of the bok choy; separate into leaves and add to the bowl with the sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 365492,
      "primary_message": "Peel, trim, and thinly slice carrot crosswise. Place in a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 365493,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365494,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n8 oz veggie ground, plant based"
    },
    {
      "id": 365495,
      "primary_message": "Meanwhile, peel and mince ginger and garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 365496,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 365497,
      "primary_message": "When the veggie ground is done, add ginger, garlic, and green onion to the skillet. Continue to cook, stirring often, until fragrant, 1 minute more.",
      "secondary_message": null
    },
    {
      "id": 365498,
      "primary_message": "Add carrots and broth to the skillet, stir to combine, and bring to a simmer.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 365499,
      "primary_message": "Add bok choy and sauce to the skillet. Cover and cook until veggies are fork-tender, 3-4 minutes; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 365500,
      "primary_message": "Meanwhile, return water in the saucepan to a boil, add noodles, and cook according to package directions, about 5 minutes. Once done, drain in a colander.",
      "secondary_message": "5 oz soba (buckwheat) noodles"
    },
    {
      "id": 365501,
      "primary_message": "To serve, divide noodles between bowls. Top with veggie ground, vegetables, sauce, and sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
