  "instructions": [
    {
      "id": 365628,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat. Once boiling, reduce to medium, and let simmer, covered, until you are ready to cook the noodles.",
      "secondary_message": null
    },
    {
      "id": 365629,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "8 baby bok choy\n2 medium carrots\n2 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 365630,
      "primary_message": "Place soy sauce, oil, honey, and chili-garlic sauce in a large bowl. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp soy sauce\n4 tsp toasted sesame oil\n4 tsp honey\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 365631,
      "primary_message": "Trim off and discard root ends of the bok choy; separate into leaves and add to the bowl with the sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 365632,
      "primary_message": "Peel and thinly slice carrots; transfer to a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 365633,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365634,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ground turkey and cook, breaking apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n0.68 kg ground turkey"
    },
    {
      "id": 365635,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 365636,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 365637,
      "primary_message": "When the turkey is done, add garlic, ginger, and green onions to the skillet; stir to combine, and continue to cook until fragrant, 1 minute more.",
      "secondary_message": null
    },
    {
      "id": 365638,
      "primary_message": "Add carrots and broth to the skillet, stir to combine, and bring to a simmer.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 365639,
      "primary_message": "Add bok choy and sauce to the skillet. Cover and cook until veggies are fork-tender, 3-4 minutes; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 365640,
      "primary_message": "Meanwhile, return water in the pot to a boil, add noodles, and cook according to package directions, about 5 minutes. Once done, drain in a colander.",
      "secondary_message": "283 g soba (buckwheat) noodles"
    },
    {
      "id": 365641,
      "primary_message": "To serve, divide noodles between bowls. Top with turkey, veggies, sauce, and sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
