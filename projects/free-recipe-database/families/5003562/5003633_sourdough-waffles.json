  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together flour, baking powder, sugar, and salt until well combined.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk together eggs, milk, starter, and melted butter until well combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add dry mixture to wet mixture and whisk until just combined. (Depending on the thickness of the starter, you may need to adjust the batter's consistency. It should be the consistency of pancake batter. Add milk to thin it, if necessary.)",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cook in waffle iron according to the manufacturer's directions. Serve right away with butter and maple syrup.",
      "secondary_message": null
    }
