  "instructions": [
    {
      "id": 70468,
      "primary_message": "Heat the oven to 400°F (204°C) and place the rack in the middle position.",
      "secondary_message": ""
    },
    {
      "id": 70467,
      "primary_message": "In a small saucepan, combine the quinoa and broth; bring to a boil.",
      "secondary_message": "1 ½ cups quinoa\n710 ml (3 cups) chicken or vegetable broth"
    },
    {
      "id": 70466,
      "primary_message": "Wash and dry the mushrooms; remove the stems and carefully scrape out the gills, making sure not to damage the rim of the mushrooms.",
      "secondary_message": "12 caps portobello mushrooms"
    },
    {
      "id": 70465,
      "primary_message": "Place the mushrooms on the baking sheet; rub with olive oil.",
      "secondary_message": "6 tsp extra virgin olive oil"
    },
    {
      "id": 70464,
      "primary_message": "Once the quinoa is boiling, reduce heat to a simmer and cover; cook for 15 minutes. Once cooked, remove from the heat and let stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 70463,
      "primary_message": "Break an egg into each mushroom cap and season with salt and pepper.",
      "secondary_message": "12 eggs\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 70462,
      "primary_message": "Place the mushrooms in the oven and bake for 8 minutes.",
      "secondary_message": ""
    },
    {
      "id": 70461,
      "primary_message": "Wash and dry the asparagus. Snap (or cut) off and discard the woody ends; cut the spears on an angle into 2 ½-cm pieces. Transfer to a large bowl, drizzle with olive oil, and season with salt and pepper; toss to coat.",
      "secondary_message": "3 small bunches asparagus\n3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 70460,
      "primary_message": "Finely grate ¾ cup of Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 70459,
      "primary_message": "After the 8 minutes are up, remove the sheet pan from the oven temporarily. Arrange the asparagus on the sheet around the mushrooms.",
      "secondary_message": ""
    },
    {
      "id": 70458,
      "primary_message": "Return the sheet to the oven and continue to bake until the eggs are cooked and the asparagus is tender, 7 to 10 more minutes.",
      "secondary_message": ""
    },
    {
      "id": 70457,
      "primary_message": "Uncover the quinoa and fluff with a fork. Add the asparagus and Parmesan; stir until well combined.",
      "secondary_message": ""
    },
    {
      "id": 70456,
      "primary_message": "Divide the mushrooms and quinoa between plates. Enjoy!",
      "secondary_message": ""
    }
  ],
