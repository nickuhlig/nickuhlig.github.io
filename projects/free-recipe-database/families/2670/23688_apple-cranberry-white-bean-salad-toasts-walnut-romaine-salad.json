  "instructions": [
    {
      "id": 386909,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n3 Granny Smith apples\n3 hearts romaine hearts"
    },
    {
      "id": 386910,
      "primary_message": "Place yogurt, mayo, onion powder, and salt in a large bowl. Stir to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n¾ tsp onion powder\n¾ tsp salt"
    },
    {
      "id": 386911,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 386912,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl along with the cranberries. ",
      "secondary_message": "⅓ cup dried cranberries"
    },
    {
      "id": 386913,
      "primary_message": "Drain and rinse beans. Add to the bowl, stir to combine the bean salad, and set aside.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 386914,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 386915,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Place in another large bowl.",
      "secondary_message": null
    },
    {
      "id": 386916,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the lettuce along with additional cranberries, dressing, and salt. Toss to combine the salad and set aside. ",
      "secondary_message": "¾ cup walnuts\n⅓ cup dried cranberries\n⅓ cup ranch dressing\n3 pinch salt"
    },
    {
      "id": 386917,
      "primary_message": "Divide bread between two baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 386918,
      "primary_message": "Divide toast between plates and top with bean salad. Serve with romaine salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
