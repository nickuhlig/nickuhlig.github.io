  "instructions": [
    {
      "primary_message": "Place beef and spices in a medium bowl and mix with your hands until well combined. Working with 2 tablespoons of meat at a time, form the beef mixture into ½-inch thick \"nuggets\" and place on a plate.\n\n",
      "secondary_message": "454 g lean ground beef\n1 tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place cornstarch in another medium bowl. Working one at a time, add beef nuggets to the bowl with the cornstarch and turn to coat. Return to the plate.\n\n",
      "secondary_message": "¼ cup cornstarch"
    },
    {
      "primary_message": "Spray air fryer basket with cooking spray. Working in batches to best fit the size of your air fryer, add nuggets to the basket, spacing them at least ½-inch apart. Coat beef with additional cooking spray. \n\n",
      "secondary_message": "3 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Insert basket into the air fryer and set temperature to 400°F. Cook, flipping halfway, until nuggets are golden and cooked through, 8-10 minutes. Remove basket from air fryer.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Serve nuggets with ketchup for dipping and enjoy!\n\n",
      "secondary_message": "½ cup ketchup"
    }
  ],
