  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the beefsteak tomato.",
      "secondary_message": "1 large beefsteak tomato"
    },
    {
      "id": 1,
      "primary_message": "In a large mixing bowl, combine the ground beef, soy sauce, 5 tablespoons of the Sriracha, and the pepper. Do not overmix. Form the mixture into 8 patties, and set aside, on a parchment-lined baking sheet, covered, in the refrigerator.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat a charcoal or gas grill to medium high heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium frying pan over medium-low heat, cook the bacon, turning as necessary. While the bacon is cooking, peel and quarter the onions. Cut each section into 0.5-cm slices. Once the bacon is cooked through and slightly crispy, remove the slices from the pan, cut each in half crosswise, and drain onto paper towels, reserving the remaining bacon fat in the pan. Cook the sliced onions in the bacon fat over medium-low heat until they caramelize, 20 to 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Grill the burgers, turning once, 4 to 4 1/2 minutes on each side or until a meat thermometer registers 130° to 57°C for medium-rare.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "While the burgers are cooking, in a small bowl, combine the blue cheese dressing with the remaining 5 tablespoons Sriracha. Lightly toast the buns on the grill during the last minute of cooking time.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "To assemble, spread the blue cheese mixture on both halves of each hamburger bun. Stack a burger patty, Swiss cheese slice, bacon, caramelized onions, tomato slice, and a small handful of arugula between each hamburger bun.",
      "secondary_message": null
    }
  ],
