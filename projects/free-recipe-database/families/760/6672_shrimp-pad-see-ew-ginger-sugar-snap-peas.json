  "instructions": [
    {
      "id": 108476,
      "primary_message": "Fill a large pot halfway with water and bring to a boil. Remove from heat and add rice noodles; stir to seperate the noodles. Soak for 10 minutes or according to package directions.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 108477,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (227 g) pkg sugar snap peas\n3 small pkgs fresh basil\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 108478,
      "primary_message": "Drain shrimp in a colander and rinse under cold water until there are no more ice chunks; skip this step if you are using fresh shrimp. Spread out on a clean towel and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 108479,
      "primary_message": "Peel and thinly slice onions into half rings.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 108480,
      "primary_message": "Peel and mince or grate the ginger.",
      "secondary_message": null
    },
    {
      "id": 108481,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 108482,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 108483,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onions and sugar snap peas. Cook, stirring occasionally, until the peas are tender crisp, 2-3 minutes. Transfer the veggies to a plate and return the skillet to the heat.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 108484,
      "primary_message": "Add more coconut oil to the skillet and swirl to coat the bottom. Add the shrimp, garlic, and ginger to the skillet. Cook until the shrimp are opaque, 1-2 minutes per side. Once done, remove from heat.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 108485,
      "primary_message": "When the noodles are tender, scoop out ¾ cup of the cooking water, then drain in a colander. Rinse the noodles under cold running water.",
      "secondary_message": null
    },
    {
      "id": 108486,
      "primary_message": "Return the skillet to the heat and add noodles, veggies, soy sauce, fish sauce, maple syrup, and the reserved cooking water to the shrimp. Stir until well combined and heated through, 2-3 minutes. Cook in batches if necessary.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp fish sauce\n3 tbsp pure maple syrup"
    },
    {
      "id": 108487,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Roughly chop the peanuts.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 108488,
      "primary_message": "To serve, divide shrimp, noodles, and veggies between plates and sprinkle with basil and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
