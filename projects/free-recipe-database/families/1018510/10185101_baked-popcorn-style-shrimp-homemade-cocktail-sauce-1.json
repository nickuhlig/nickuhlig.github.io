  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. Line two baking sheet pans with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "907 g raw peeled shrimp, fresh or frozen"
    },
    {
      "primary_message": "Place mayo and spices in a medium bowl; stir to combine.\n\n",
      "secondary_message": "½ cup mayonnaise\n1 tsp paprika\n1 tsp oregano, dried\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "primary_message": "Place breadcrumbs in a large bowl.",
      "secondary_message": "2 cups panko bread crumbs"
    },
    {
      "primary_message": "Add shrimp to the bowl with the seasoned mayo and toss to coat.",
      "secondary_message": null
    },
    {
      "primary_message": "Working in batches, add shrimp to the bowl with the bread crumbs and turn to coat, pressing gently to adhere. Divide shrimp between prepared baking sheets, arranging in a single layer. Drizzle with oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Place shrimp in the oven and bake for 8 minutes, then flip and continue to bake until golden and crisp, 5-6 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and juice lemon into a small bowl. Add ketchup, Worcestershire, sugar, and spices. Stir to combine the cocktail sauce and set aside.",
      "secondary_message": "1 lemon\n⅔ cup ketchup\n2 tsp Worcestershire sauce\n2 tsp brown sugar\n¼ tsp chili powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Arrange shrimp on a platter and serve with cocktail sauce for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
