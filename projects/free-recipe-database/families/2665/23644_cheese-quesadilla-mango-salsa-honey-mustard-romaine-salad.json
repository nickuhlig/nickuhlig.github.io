  "instructions": [
    {
      "id": 419457,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 mango\n½ jalapeño pepper\n½ small bunch cilantro\n1 heart romaine hearts"
    },
    {
      "id": 419458,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; small dice. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 419459,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the mango. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 419460,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with vinegar and salt. Stir to combine the salsa and set aside.",
      "secondary_message": "2 tsp apple cider vinegar\n⅛ tsp salt"
    },
    {
      "id": 419461,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 419462,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide cheese between them, arranging on one half of each tortilla. Fold in half to close. ",
      "secondary_message": "2 large flour tortillas\n¾ cup shredded cheese, Mexican blend"
    },
    {
      "id": 419463,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add quesadillas and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 419464,
      "primary_message": "Meanwhile, roughly chop or tear lettuce into bite-sized pieces. Place in a medium bowl along with carrots, pumpkin seeds, dressing, and salt. Stir to combine the salad.",
      "secondary_message": "½ (10 oz) bag shredded carrots\n¼ cup pumpkin seeds\n2 tbsp honey mustard dressing\n1 pinch salt"
    },
    {
      "id": 419465,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salsa and salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
