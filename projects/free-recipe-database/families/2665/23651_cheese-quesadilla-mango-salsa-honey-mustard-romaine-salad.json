  "instructions": [
    {
      "id": 419520,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 mangoes\n1 jalapeño pepper\n1 small bunch cilantro\n2 hearts romaine hearts"
    },
    {
      "id": 419521,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; small dice. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 419522,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the mango. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 419523,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with vinegar and salt. Stir to combine the salsa and set aside.",
      "secondary_message": "4 tsp apple cider vinegar\n¼ tsp salt"
    },
    {
      "id": 419524,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 419525,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide cheese between them, arranging on one half of each tortilla. Fold in half to close. ",
      "secondary_message": "4 large flour tortillas\n1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 419526,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 419527,
      "primary_message": "Meanwhile, roughly chop or tear lettuce into bite-sized pieces. Place in another medium bowl along with carrots, pumpkin seeds, dressing, and salt. Stir to combine the salad.",
      "secondary_message": "1 (283 g) bag shredded carrots\n½ cup pumpkin seeds\n¼ cup honey mustard dressing\n⅛ tsp salt"
    },
    {
      "id": 419528,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salsa and salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
