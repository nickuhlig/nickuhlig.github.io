  "instructions": [
    {
      "id": 419475,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 mangoes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n3 hearts romaine hearts"
    },
    {
      "id": 419476,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; small dice. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 419477,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the mango. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 419478,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with vinegar and salt. Stir to combine the salsa and set aside.",
      "secondary_message": "2 tbsp apple cider vinegar\n½ tsp salt"
    },
    {
      "id": 419479,
      "primary_message": "Lay tortillas on a flat surface and divide cheese between them, arranging on one half of each tortilla. Fold in half to close. ",
      "secondary_message": "6 large flour tortillas\n2 ¼ cups shredded cheese, Mexican blend"
    },
    {
      "id": 419480,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 419481,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 419482,
      "primary_message": "Meanwhile, roughly chop or tear lettuce into bite-sized pieces. Place in a large bowl along with carrots, pumpkin seeds, dressing, and salt. Stir to combine the salad.",
      "secondary_message": "1 ½ (10 oz) bags shredded carrots\n¾ cup pumpkin seeds\n⅓ cup honey mustard dressing\n3 pinch salt"
    },
    {
      "id": 419483,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salsa and salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
