  "instructions": [
    {
      "id": 139873,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 139874,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 139875,
      "primary_message": "Add the bacon to the skillet and cook until crispy, 3-5 minutes per side. Work in batches if necessary. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 139876,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lb white mushrooms\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 139877,
      "primary_message": "Peel and thinly slice the onion. Slice the mushrooms.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 139878,
      "primary_message": "Once the bacon is cooked, use a slotted spoon to transfer to a plate lined with paper towels; pat to remove excess oil. Crumble or chop into small pieces.",
      "secondary_message": null
    },
    {
      "id": 139879,
      "primary_message": "Return skillet (with bacon fat) to the stove over medium heat. Add the onions, mushrooms, and salt; cook, stirring occasionally, until vegetables soften, 5-6 minutes. Leaving bacon fat in the skillet, transfer the vegetables to a plate; set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 139880,
      "primary_message": "Return the skillet to medium heat. Add the vinegar, brown sugar, oil, Dijon, salt, and pepper. Whisk vigorously, scraping the bottom of the skillet to incorporate any browned bits. Bring to a simmer and reduce heat, whisking occasionally, until dressing thickens, about 2 minutes. Remove from heat. ",
      "secondary_message": "⅓ cup apple cider vinegar\n1 tbsp brown sugar\n¼ cup extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 139881,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": "2 avocados"
    },
    {
      "id": 139882,
      "primary_message": "Peel and slice the eggs. ",
      "secondary_message": null
    },
    {
      "id": 139883,
      "primary_message": "In a large bowl, combine the spinach, bacon, onion, mushrooms, avocado, and dressing from the skillet. Toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 139884,
      "primary_message": "Divide the salad between plates or bowls. Top with the sliced egg and enjoy! ",
      "secondary_message": null
    }
  ],
