  "instructions": [
    {
      "id": 298261,
      "primary_message": "Preheat oven to 230°C (450°F). Line two baking sheet pans with aluminum foil (for easier cleanup). ",
      "secondary_message": null
    },
    {
      "id": 298262,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium heads cauliflower\n3 tomatoes\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 ½ avocados\n1 ½ limes"
    },
    {
      "id": 298263,
      "primary_message": "Remove leaves and thick stems from each cauliflower head, then cut into bite-sized florets. Divide between baking sheets, drizzle with oil, and season with salt and pepper. Toss to coat, then spread out in a single layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 298264,
      "primary_message": "Place cauliflower in the oven (it doesn't have to be fully heated) and roast, tossing once, until golden and fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 298265,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 298266,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 298267,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ground turkey and spices; cook, breaking the meat apart with a spoon, until browned and no longer pink, 7-8 minutes. Stir in the garlic and remove from the heat. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1.02 kg ground turkey\n2 tbsp cumin, ground\n2 tbsp chili powder\n¾ tsp salt"
    },
    {
      "id": 298268,
      "primary_message": "While the turkey is cooking, small dice tomatoes and place on a platter.",
      "secondary_message": null
    },
    {
      "id": 298269,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Add to the platter with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 298270,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 298271,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out with a spoon. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 298272,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 298273,
      "primary_message": "When the cauliflower is done, top with an even layer of ground turkey and cheese. Return to the oven and bake until the cheese is melted and turkey is warmed through, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 298274,
      "primary_message": "Meanwhile, cut limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 298275,
      "primary_message": "To serve, divide cauliflower bites between plates; top with tomato, green onion, cilantro, avocado, lime wedges, and yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
