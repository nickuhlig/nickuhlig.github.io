  "instructions": [
    {
      "id": 298246,
      "primary_message": "Preheat oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil (for easier cleanup). ",
      "secondary_message": null
    },
    {
      "id": 298247,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium heads cauliflower\n2 tomatoes\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 avocado\n1 lime"
    },
    {
      "id": 298248,
      "primary_message": "Remove leaves and thick stems from each cauliflower head, then cut into bite-sized florets. Transfer to the baking sheet, drizzle with oil, and season with salt and pepper. Toss to coat, then spread out in a single layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 298249,
      "primary_message": "Place cauliflower in the oven (it doesn't have to be fully heated) and roast, tossing once, until golden and fork-tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 298250,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 298251,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 298252,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ground turkey and spices; cook, breaking the meat apart with a spoon, until browned and no longer pink, 5-7 minutes. Stir in the garlic and remove from the heat. ",
      "secondary_message": "2 tsp extra virgin olive oil\n0.68 kg ground turkey\n4 tsp cumin, ground\n4 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 298253,
      "primary_message": "While the turkey is cooking, small dice tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 298254,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 298255,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 298256,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 298257,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "⅔ (227 g) block cheddar cheese"
    },
    {
      "id": 298258,
      "primary_message": "When the cauliflower is done, top with an even layer of ground turkey and cheese. Return to the oven and bake until the cheese is melted and turkey is warmed through, about 3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 298259,
      "primary_message": "Meanwhile, cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 298260,
      "primary_message": "To serve, divide cauliflower bites between plates; top with tomato, green onion, cilantro, avocado, lime wedges, and yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
