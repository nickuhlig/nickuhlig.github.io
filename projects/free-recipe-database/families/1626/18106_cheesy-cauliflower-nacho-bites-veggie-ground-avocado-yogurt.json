  "instructions": [
    {
      "id": 298216,
      "primary_message": "Preheat oven to 450°F. Line two baking sheet pans with aluminum foil (for easier cleanup). ",
      "secondary_message": null
    },
    {
      "id": 298217,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium heads cauliflower\n3 tomatoes\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 ½ avocados\n1 ½ limes"
    },
    {
      "id": 298218,
      "primary_message": "Remove leaves and thick stems from each cauliflower head, then cut into bite-sized florets. Divide between baking sheets, drizzle with oil, and season with salt and pepper. Toss to coat, then spread out in a single layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 298219,
      "primary_message": "Place cauliflower in the oven (it doesn't have to be fully heated) and roast, tossing once, until golden and fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 298220,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 298221,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 298222,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Stir in the garlic, then remove from the heat. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 ½ tbsp cumin, ground\n1 ½ tbsp chili powder\n¾ tsp salt"
    },
    {
      "id": 298223,
      "primary_message": "While the veggie ground is cooking, small dice tomatoes and place on a platter.",
      "secondary_message": null
    },
    {
      "id": 298224,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Add to the platter with the tomato.",
      "secondary_message": null
    },
    {
      "id": 298225,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the platter.",
      "secondary_message": null
    },
    {
      "id": 298226,
      "primary_message": "Halve and pit avocados; slice thinly while still in skin, then scoop out with a spoon. Add to the platter.",
      "secondary_message": null
    },
    {
      "id": 298227,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 298228,
      "primary_message": "When the cauliflower is done, top with an even layer of veggie ground and cheese. Return to the oven and bake until the cheese is melted and veggie ground is warmed through, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 298229,
      "primary_message": "Meanwhile, cut limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 298230,
      "primary_message": "To serve, divide cauliflower bites between plates; top with tomato, green onion, cilantro, avocado, lime wedges, and yogurt. Enjoy!",
      "secondary_message": "1 cup plain Greek yogurt"
    }
  ],
