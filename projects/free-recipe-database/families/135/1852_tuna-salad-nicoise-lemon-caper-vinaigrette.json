  "instructions": [
    {
      "id": 16934,
      "primary_message": "Wash and large dice potatoes. Place potatoes and eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and set aside to cool.",
      "secondary_message": "2 medium red potatoes\r\n4 eggs"
    },
    {
      "id": 16935,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 16936,
      "primary_message": "Wash green beans and trim ends. Once water is boiling, uncover saucepan and add beans. Cook until bright green, 2-3 minutes. Drain and rinse under cold water. Set aside.",
      "secondary_message": "½ lb green beans"
    },
    {
      "id": 16937,
      "primary_message": "In a small bowl, prepare dressing by whisking together lemon juice, olive oil, Dijon, parsley flakes, salt, and pepper. Stir in capers and set aside.",
      "secondary_message": "juice of 1 lemon\r\n6 tbsp extra virgin olive oil\r\n1 tbsp Dijon mustard\r\n½ tsp parsley flakes\r\n¼ tsp salt\r\n¼ tsp black pepper\r\n2 tbsp capers"
    },
    {
      "id": 16938,
      "primary_message": "Wash and dry lettuce. Halve lengthwise, then chop crosswise into 1 inch strips. Wash and halve tomatoes.",
      "secondary_message": "1 head romaine lettuce\n1 pint grape tomatoes"
    },
    {
      "id": 16939,
      "primary_message": "Measure out olives.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 16940,
      "primary_message": "Drain and flake tuna.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 16941,
      "primary_message": "Peel and quarter eggs.",
      "secondary_message": ""
    },
    {
      "id": 16942,
      "primary_message": "To serve, arrange lettuce, potato, tomatoes, eggs, tuna, and olives in long sections on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
