  "instructions": [
    {
      "id": 16891,
      "primary_message": "Wash and large dice potato. Place potato and eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook until potato can be easily pierced with a fork, 10-12 minutes. Drain and set aside to cool.",
      "secondary_message": "1 medium red potato\r\n2 eggs"
    },
    {
      "id": 16892,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 16893,
      "primary_message": "Wash green beans and trim ends. Once water is boiling, uncover saucepan and add beans. Cook until bright green, 2-3 minutes. Drain and rinse under cold water. Set aside.",
      "secondary_message": "0.113 kg green beans"
    },
    {
      "id": 16894,
      "primary_message": "In a small bowl, prepare dressing by whisking together lemon juice, olive oil, Dijon, parsley flakes, salt, and pepper. Stir in capers and set aside.",
      "secondary_message": "juice of ½ lemon\r\n3 tbsp extra virgin olive oil\r\n½ tbsp Dijon mustard\r\n¼ tsp parsley flakes\r\n⅛ tsp salt\r\n⅛ tsp black pepper\r\n1 tbsp capers"
    },
    {
      "id": 16895,
      "primary_message": "Wash and dry lettuce. Chop crosswise into 2 ½ cm strips. Wash and halve tomatoes.",
      "secondary_message": "½ head romaine lettuce\n½ small pkg grape tomatoes"
    },
    {
      "id": 16896,
      "primary_message": "Measure out olives.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 16900,
      "primary_message": "Drain and flake tuna.",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 16901,
      "primary_message": "Peel and quarter eggs.",
      "secondary_message": ""
    },
    {
      "id": 16903,
      "primary_message": "To serve, arrange lettuce, potato, tomatoes, eggs, tuna, and olives in long sections on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
