  "instructions": [
    {
      "id": 350547,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 350548,
      "primary_message": "While the water heats up, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Stack leaves on top of one another, then cut crosswise into thin (shred-like) ribbons. ",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 350549,
      "primary_message": "Once the water in the pot is boiling, uncover, add kale, and stir. Cook until bright green and wilted, about 15 seconds. Transfer kale to a colander using a slotted spoon. (Reserve pot of water for the next step.)",
      "secondary_message": null
    },
    {
      "id": 350550,
      "primary_message": "Return water to a boil. Once the water is boiling, add noodles and cook according to package directions, about 5 minutes.",
      "secondary_message": "5 oz soba (buckwheat) noodles"
    },
    {
      "id": 350551,
      "primary_message": "Meanwhile, wash, dry, and trim green onions; cut crosswise into thin pieces and set aside.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 350552,
      "primary_message": "Place tahini, water, soy sauce, chili-garlic sauce, and oil in a medium bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup tahini\n¼ cup water\n2 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 tsp toasted sesame oil"
    },
    {
      "id": 350553,
      "primary_message": "When the noodles are done, drain in the colander over the kale. Rinse thoroughly under cold water.",
      "secondary_message": null
    },
    {
      "id": 350554,
      "primary_message": "Add noodles, kale, and half of the green onions to the bowl with the sauce; toss to combine. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 350555,
      "primary_message": "To serve, divide the noodles and kale between plates or bowls. Top with remaining green onions and sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
