  "instructions": [
    {
      "id": 350536,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 350537,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 350538,
      "primary_message": "While the water heats up, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Stack leaves on top of one another, then cut crosswise into thin (shred-like) ribbons. ",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 350539,
      "primary_message": "Once the water in the pot is boiling, working in batches, uncover, add kale, and stir. Cook until bright green and wilted, about 15 seconds. Transfer kale to a colander using a slotted spoon. (Reserve pot of water for the next step.)",
      "secondary_message": null
    },
    {
      "id": 350540,
      "primary_message": "Return water to a boil. Once the water is boiling, add noodles and cook according to package directions, about 5 minutes.",
      "secondary_message": "15 oz soba (buckwheat) noodles"
    },
    {
      "id": 350541,
      "primary_message": "Meanwhile, wash, dry, and trim green onions; cut crosswise into thin pieces and set aside.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 350542,
      "primary_message": "Place tahini, water, soy sauce, chili-garlic sauce, and oil in a large bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¾ cup tahini\n¾ cup water\n⅓ cup soy sauce\n3 tbsp chili-garlic sauce\n1 tbsp toasted sesame oil"
    },
    {
      "id": 350543,
      "primary_message": "When the noodles are done, drain in the colander over the kale. Rinse thoroughly under cold water and set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 350544,
      "primary_message": "Peel and quarter the eggs. ",
      "secondary_message": null
    },
    {
      "id": 350545,
      "primary_message": "Add noodles, kale, and half of the green onions to the bowl with the sauce; toss to combine. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 350546,
      "primary_message": "To serve, divide the noodles and kale between plates or bowls. Top with remaining green onions, sesame seeds, and eggs. Enjoy!",
      "secondary_message": "⅓ cup sesame seeds"
    }
  ],
