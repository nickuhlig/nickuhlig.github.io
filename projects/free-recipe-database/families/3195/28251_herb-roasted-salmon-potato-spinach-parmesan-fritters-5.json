  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Pat salmon dry with paper towels. Place on the baking sheet, skin-side down, and sprinkle with spices.",
      "secondary_message": "1.02 kg salmon fillet\noregano, dried\nsalt\nblack pepper\n½ tsp thyme, dried"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place both hash browns and spinach in a colander; rinse under hot water (from the tap) to thaw. Using your hands, squeeze as much water from the hash browns and spinach as you can. Place in a large bowl. ",
      "secondary_message": "6 cups frozen shredded hash brown potatoes\n1 ½ (454 g) bags frozen chopped spinach"
    },
    {
      "primary_message": "Add Parmesan, eggs, flour, and spices to the bowl with the hash browns and spinach. Stir to combine the potato mixture.",
      "secondary_message": "¾ cup Parmesan cheese, shredded\n6 eggs\nsalt\noregano, dried\nblack pepper"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Working in batches, using a ¼-cup measure, drop potato mixture into the skillet, spacing scoops a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide salmon and fritters between plates. Enjoy!",
      "secondary_message": null
    }
  ],
