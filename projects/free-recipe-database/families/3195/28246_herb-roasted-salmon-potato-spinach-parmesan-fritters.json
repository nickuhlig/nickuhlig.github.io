  "instructions": [
    {
      "id": 459604,
      "primary_message": "Preheat oven to 205°C (400°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 459605,
      "primary_message": "Pat salmon dry with paper towels. Place on the baking sheet, skin-side down, and sprinkle with spices.",
      "secondary_message": "⅓ kg salmon fillet\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp thyme, dried"
    },
    {
      "id": 459606,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 459607,
      "primary_message": "Meanwhile, place both hash browns and spinach in a colander; rinse under hot water (from the tap) to thaw. Using your hands, squeeze as much water from the hash browns and spinach as you can. Place in a medium bowl. ",
      "secondary_message": "2 cups frozen shredded hash brown potatoes\n½ (454 g) bag frozen chopped spinach"
    },
    {
      "id": 459608,
      "primary_message": "Add Parmesan, eggs, flour, and spices to the bowl with the hash browns and spinach. Stir to combine the potato mixture.",
      "secondary_message": "¼ cup Parmesan cheese, shredded\n2 eggs\n¼ cup all-purpose flour\n½ tsp salt\n¼ tsp oregano, dried\n⅛ tsp black pepper"
    },
    {
      "id": 459609,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 459610,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Using a ¼-cup measure, drop potato mixture into the skillet, spacing scoops a few inches apart; press down to form round fritters. Cook, flipping once, until fritters are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 459611,
      "primary_message": "To serve, divide salmon and fritters between plates. Enjoy!",
      "secondary_message": null
    }
  ],
