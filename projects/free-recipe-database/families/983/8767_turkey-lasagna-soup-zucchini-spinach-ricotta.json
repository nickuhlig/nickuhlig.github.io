  "instructions": [
    {
      "id": 134538,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 134539,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 134540,
      "primary_message": "Peel and mince the garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 134541,
      "primary_message": "Add ground turkey, garlic, onion powder, and crushed red pepper to the pot. Cook, breaking apart the meat with a spoon, until browned and crumbly, 3 to 4 minutes. ",
      "secondary_message": "1.02 kg ground turkey\n1 ½ tbsp onion powder\n¾ tsp crushed red pepper"
    },
    {
      "id": 134542,
      "primary_message": "Small dice the zucchini. ",
      "secondary_message": null
    },
    {
      "id": 134543,
      "primary_message": "Add the zucchini, tomato sauce, diced tomatoes, broth, and spices to the pot. Bring to a boil over high heat, then reduce heat to medium-low. ",
      "secondary_message": "3 (213 ml) cans tomato sauce\n3 (398 ml) cans diced tomatoes\n1420 ml chicken or vegetable broth\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 134544,
      "primary_message": "Break the lasagna noodles into bite-sized pieces. Add to the pot and stir; cover and simmer for 15 minutes. ",
      "secondary_message": "9 no-boil lasagna noodles"
    },
    {
      "id": 134545,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 134546,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful; cook until fully wilted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 134547,
      "primary_message": "To serve, divide the soup between bowls and top with a large spoonful of ricotta and parsley. Enjoy! ",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese"
    }
  ],
