  "instructions": [
    {
      "id": 430322,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, 6-8 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 430323,
      "primary_message": "Meanwhile, place hummus, milk, nutritional yeast, salt, and pepper in a medium saucepan. Stir to combine and bring to a simmer over medium heat. Once simmering, remove sauce from heat, cover with a lid to keep warm, and set aside.",
      "secondary_message": "1 ½ cups hummus\n355 ml almond milk, unsweetened\n⅓ cup nutritional yeast flakes\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 430324,
      "primary_message": "While the sauce is heating, drain and roughly chop roasted peppers and olives. Place both in a medium bowl.",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers\n1 cup Kalamata olives, pitted"
    },
    {
      "id": 430325,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add to the bowl with the peppers and olives, then set aside.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 430326,
      "primary_message": "When the pasta is almost done, add kale to the pot and stir to combine. Continue to cook until pasta and kale are tender, 2-3 minutes more. ",
      "secondary_message": "1 ½ (283 g) bags kale, cut and ready to use"
    },
    {
      "id": 430327,
      "primary_message": "Drain pasta and kale in a colander. Return to the pot along with the sauce, peppers, olives, and basil; gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 430328,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
