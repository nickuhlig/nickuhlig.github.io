  "instructions": [
    {
      "primary_message": "Peel and mince garlic; mince capers. Transfer both to a small bowl along with mayo, vinegar, Dijon, and pepper. Whisk to combine the tartar sauce; set aside.",
      "secondary_message": "2 cloves garlic\n1 tbsp capers\n⅓ cup mayonnaise\nwhite wine vinegar\nDijon mustard\nblack pepper"
    },
    {
      "primary_message": "Combine oil, vinegar, Dijon, maple syrup, salt, and pepper in a large salad bowl; whisk to combine the dressing.",
      "secondary_message": "extra virgin olive oil\nwhite wine vinegar\nDijon mustard\n1 tsp pure maple syrup\nsalt\nblack pepper"
    },
    {
      "primary_message": "Peel and thinly slice onion into half rounds. Set half of the onions aside on a plate. Add the other half to the bowl with the dressing and stir to combine.",
      "secondary_message": "½ medium red onion"
    },
    {
      "primary_message": "Wash and dry the tomatoes, then halve and slice them. Place half of the tomatoes on the plate; transfer the other half to the salad bowl.",
      "secondary_message": "4 tomatoes"
    },
    {
      "primary_message": "Drain and thinly slice artichoke hearts; transfer to the salad bowl. Set aside while you prepare the fish.",
      "secondary_message": "2 (106 g) jars artichoke hearts, marinated"
    },
    {
      "primary_message": "Whisk eggs in a medium bowl.",
      "secondary_message": "2 eggs"
    },
    {
      "primary_message": "Place bread crumbs in a second medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Pat the fish dry with paper towels and place on a plate or other flat surface. Season with salt and pepper on both sides. ",
      "secondary_message": "680 g tilapia fillet\nsalt\nblack pepper"
    },
    {
      "primary_message": "Sprinkle flour over both sides of each fillet. Press gently to adhere.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To bread the fish, dip each fillet into the egg, and then the bread crumbs. Press gently to adhere.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fish to the skillet in a single layer and cook until golden brown and cooked through, about 4 minutes per side. Once done, transfer to a clean plate lined with paper towel.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, toast the rolls.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the lettuce; separate the leaves. Set aside 2 large leaves per sandwich. Chop or tear remaining leaves into bite-sized pieces, add to the salad bowl and toss to combine.",
      "secondary_message": "2 heads butter (Boston) lettuce"
    },
    {
      "primary_message": "Place the bottom half of a roll on each plate. Layer with tartar sauce, lettuce, tomato, onion, and a crispy fish fillet; close with top half of the roll. Serve salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
