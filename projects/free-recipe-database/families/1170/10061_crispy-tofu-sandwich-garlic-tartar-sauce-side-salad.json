  "instructions": [
    {
      "id": 160556,
      "primary_message": "Cut the tofu into ¼-inch thick planks along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 160557,
      "primary_message": "Meanwhile, peel and mince garlic; mince capers. Transfer both to a small bowl along with mayo, vinegar, Dijon, and pepper. Whisk to combine the tartar sauce; set aside.",
      "secondary_message": "2 cloves garlic\n1 tbsp capers\n⅓ cup vegan mayonnaise\n2 tsp white wine vinegar\n2 tsp Dijon mustard\n⅛ tsp black pepper"
    },
    {
      "id": 160558,
      "primary_message": "Combine oil, vinegar, Dijon, maple syrup, salt, and pepper in a large salad bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp white wine vinegar\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 160559,
      "primary_message": "Peel and thinly slice onion into half rounds. Set half of the onions aside on a plate. Add the other half to the bowl with the dressing and stir to combine.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 160560,
      "primary_message": "Wash and dry the tomatoes, then halve and slice them. Place half of the tomatoes on the plate; transfer the other half to the salad bowl.",
      "secondary_message": "4 tomatoes"
    },
    {
      "id": 160561,
      "primary_message": "Drain and thinly slice artichoke hearts; transfer to the salad bowl. Set aside while you prepare the tofu.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 160562,
      "primary_message": "Combine soy sauce, cornstarch, mayo, and spices in medium bowl; beat with a whisk or fork until smooth.",
      "secondary_message": "2 tbsp soy sauce\n4 tsp cornstarch\n2 tsp vegan mayonnaise\n½ tsp paprika\n½ tsp oregano\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 160563,
      "primary_message": "Place bread crumbs in a second medium bowl.",
      "secondary_message": "1 cup panko bread crumbs"
    },
    {
      "id": 160564,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 160565,
      "primary_message": "Dip each tofu plank into the cornstarch mixture, turning to coat. Next, dip into the bread crumbs, pressing gently to adhere.",
      "secondary_message": null
    },
    {
      "id": 160566,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu to the skillet and cook until golden brown, about 2 minutes per side. Once done, transfer to a clean plate lined with paper towel. Cook in batches if necessary.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 160567,
      "primary_message": "Meanwhile, toast the rolls.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 160568,
      "primary_message": "Wash and dry the lettuce; separate the leaves. Set aside 2 large leaves per sandwich. Chop or tear remaining leaves into bite-sized pieces, add to the salad bowl and toss to combine.",
      "secondary_message": "2 heads butter (Boston) lettuce"
    },
    {
      "id": 160569,
      "primary_message": "Place the bottom half of a roll on each plate. Layer with tartar sauce, lettuce, tomato, onion, and crispy tofu; close with top half of the roll. Serve salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
