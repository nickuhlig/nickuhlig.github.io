  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine gin, lemon juice, Cointreau, and marmalade in cocktail shaker and stir to break up marmalade and mix it with the liquid ingredients. Fill shaker with ice, shake well for 10 seconds, and strain into chilled cocktail glass. Squeeze orange zest over drink so orange oil sprays over surface. Drop orange zest into cocktail to garnish, and serve.",
      "secondary_message": null
    }
  ],
