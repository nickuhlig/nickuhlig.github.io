  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 150°C (300°F). Season ribs all over with salt and pepper. In a small bowl, thoroughly combine smoked paprika, cumin, coriander, fennel, sugar, and chili flakes. Rub ribs all over with spice mixture and place on a wire rack set in a rimmed baking sheet or roasting pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bake ribs for 1 hour, then increase heat to 190°C (375°F) and cook until browned outside, tender within, and an instant-read thermometer registers 79°C, about 1 hour longer. Let rest for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, pour off fat from pan. Set pan on burner and heat over medium heat. Add 1/2 cup stock and stir, scraping up any browned bits; pour into a medium saucepan and add remaining 1 cup stock. Cook over medium heat until reduced by half, about 8 minutes. Stir in mustard and season with salt and pepper. Off the heat, whisk in butter.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Divide ribs by cutting between the bones and serve with the sauce.",
      "secondary_message": null
    }
  ],
