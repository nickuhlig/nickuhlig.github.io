  "instructions": [
    {
      "id": 447600,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tsp neutral vegetable oil"
    },
    {
      "id": 447601,
      "primary_message": "Place both cheeses in a small bowl. Use a fork to mash and combine the cheese mixture.",
      "secondary_message": "2 (4 oz) logs goat cheese\n½ (8 oz) block cream cheese"
    },
    {
      "id": 447602,
      "primary_message": "Using a tablespoon measure, form the cheese into rounded balls and place on a plate. Place plate in the refrigerator until cheese balls are firm, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 447603,
      "primary_message": "Meanwhile, drizzle flatbreads with maple syrup and sprinkle with cinnamon. Cut flatbreads into wedges and transfer to the baking sheet, syrup-side up.",
      "secondary_message": "2 flatbreads or naan\n4 tsp pure maple syrup\n1 tsp cinnamon, ground"
    },
    {
      "id": 447604,
      "primary_message": "Place flatbread in the oven (it doesn't have to be fully heated) and bake until crisp, 4-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 447605,
      "primary_message": "While the flatbread is baking, finely chop cranberries and walnuts. Place both in a clean small bowl, then stir to combine the topping and set aside.",
      "secondary_message": "½ cup dried cranberries\n½ cup walnuts"
    },
    {
      "id": 447606,
      "primary_message": "Wash, dry, quarter, and core apples; thinly slice.",
      "secondary_message": "2 Gala apples"
    },
    {
      "id": 447607,
      "primary_message": "When the cheese balls are firm, remove from the fridge and roll in the topping, pressing gently to adhere.",
      "secondary_message": null
    },
    {
      "id": 447608,
      "primary_message": "To serve, divide cheese balls, apple slices, and flatbread wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
