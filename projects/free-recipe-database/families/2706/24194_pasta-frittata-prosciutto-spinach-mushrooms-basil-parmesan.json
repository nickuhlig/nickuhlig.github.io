  "instructions": [
    {
      "id": 392715,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 392716,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.45 kg cremini mushrooms\n1 small pkg fresh basil\n2 (142 g) pkg baby spinach"
    },
    {
      "id": 392717,
      "primary_message": "Thinly slice mushrooms and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 392718,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 392719,
      "primary_message": "While the skillet heats up, peel, halve, and medium dice onion. Peel and mince garlic. Add both to the bowl with the mushrooms and set aside.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 392720,
      "primary_message": "Once the skillet is hot, add the prosciutto and cook until crispy, about 1 minute per side. Remove prosciutto to a plate and set aside. (Reserve skillet for the next step.)",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 392721,
      "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom. Add the mushrooms, onion, garlic, and spices; cook, stirring occasionally, until tender, 6-7 minutes. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 392722,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 392723,
      "primary_message": "Finely grate Parmesan. Place half in the reserved bowl along with eggs, salt, and pepper; whisk to combine. (Reserve remaining Parmesan for later use.)",
      "secondary_message": "85 g Parmesan cheese\n10 eggs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 392724,
      "primary_message": "Crumble or chop prosciutto into bite-sized pieces. Add to the bowl with the egg mixture, whisk once more to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 392725,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 392726,
      "primary_message": "When the mushrooms and onions are tender, add basil and spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 392727,
      "primary_message": "Add cooked pasta to the skillet. Drizzle with additional oil, toss to combine with the veggies, then smooth out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 392728,
      "primary_message": "Pour egg mixture over the pasta, making sure the prosciutto is evenly distributed over the top. As the eggs set around edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 392729,
      "primary_message": "Sprinkle reserved Parmesan over the frittata. Place skillet in the oven and broil until top is set and golden brown, 2-3 minutes. Remove from the oven and slice into wedges.",
      "secondary_message": null
    },
    {
      "id": 392730,
      "primary_message": "To serve, divide frittata between plates and enjoy!",
      "secondary_message": null
    }
  ],
