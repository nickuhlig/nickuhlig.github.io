  "instructions": [
    {
      "primary_message": "FOR THE SIMPLE SYRUP: Place sugar and water in a small saucepan, stir to combine, and bring to a boil. Reduce heat to medium and simmer, stirring occasionally, until sugar is just dissolved. Remove from heat and let cool completely before using. (NOTE: this recipe makes about 2/3 cup simple syrup. Transfer leftover syrup to a small jar and refrigerate for up to one month.)",
      "secondary_message": "½ cup granulated sugar"
    },
    {
      "primary_message": "FOR THE COCKTAIL: Wash, dry, and juice tangerine into a cocktail shaker. ",
      "secondary_message": "1 tangerine"
    },
    {
      "primary_message": "Wash, dry, and cut one small wedge from the lime; set aside for garnish. Juice remaining lime into the shaker. ",
      "secondary_message": "½ lime"
    },
    {
      "primary_message": "Add 2 fl oz (1/4 cup) vodka, 1/2 fl oz (1 tbsp) orange liqueur, 1 fl oz (2 tbsp) cranberry juice, 1/2 fl oz (1 tbsp) simple syrup, and ice cubes to the shaker. Shake until well chilled, about 20 seconds.",
      "secondary_message": "2 fl oz vodka\n½ fl oz orange liqueur\n1 fl oz cranberry juice\n⅔ cup ice cube"
    },
    {
      "primary_message": "Strain cocktail into a martini glass or glass of choice. Garnish rim with the reserved lime wedge and enjoy!",
      "secondary_message": null
    }
  ],
