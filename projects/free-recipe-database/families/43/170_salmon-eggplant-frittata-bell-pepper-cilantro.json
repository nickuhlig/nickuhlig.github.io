  "instructions": [
    {
      "id": 12048,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": ""
    },
    {
      "id": 12049,
      "primary_message": "Wash and dry eggplant, bell pepper, and cilantro. Medium dice the eggplant. Seed and medium dice the pepper. Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 eggplant\r\n1 red bell pepper\r\n½ small bunch cilantro"
    },
    {
      "id": 12050,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 12051,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 12052,
      "primary_message": "Coat bottom of skillet with oil. Add garlic and cook until fragrant, 15-30 seconds.",
      "secondary_message": "about 1 tbsp extra virgin olive oil"
    },
    {
      "id": 12053,
      "primary_message": "Add eggplant and pepper. Season with salt and pepper. Stirring occasionally, cook until vegetables are tender, 4-5 minutes.",
      "secondary_message": "¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 12054,
      "primary_message": "In a medium bowl, whisk together eggs, ½ of the cilantro (save the rest for garnishing), water, Italian seasoning, salt, and pepper.",
      "secondary_message": "6 eggs\r\n2 tbsp water\r\n¼ tsp Italian seasoning\r\n¼ tsp salt\r\n⅛ tsp black pepper\r\n1 pinch cayenne pepper"
    },
    {
      "id": 12055,
      "primary_message": "Drain salmon and add to skillet. Stir and cook until heated through, 1-2 minutes.",
      "secondary_message": "1 (213 g) can wild pink salmon, traditional style"
    },
    {
      "id": 12056,
      "primary_message": "Pour in egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 8-10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 12057,
      "primary_message": "Place skillet in the oven and broil until the top is set, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 12058,
      "primary_message": "To serve, cut frittata into wedges and place on a plate. Garnish with remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
