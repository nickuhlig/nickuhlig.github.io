  "instructions": [
    {
      "id": 71505,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.681 kg green beans\n0.681 kg new potatoes\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 71504,
      "primary_message": "Fill a medium saucepan about halfway with water and add salt; cover and bring to a boil.",
      "secondary_message": "3 tsp salt"
    },
    {
      "id": 71503,
      "primary_message": "Quarter the potatoes and transfer to a medium bowl. Drizzle with olive oil and season with salt and pepper; toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 71502,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 71501,
      "primary_message": "Season the steak with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 71500,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 71499,
      "primary_message": "Place the steak in the skillet and cook until desired doneness, 2 to 5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": ""
    },
    {
      "id": 71498,
      "primary_message": "Trim the ends of the beans. Once the water is boiling, add the beans; cook until they are bright green and tender-crisp, 2 to 3 minutes. Drain and rinse under cold water.",
      "secondary_message": ""
    },
    {
      "id": 71497,
      "primary_message": "Once the steak has been transferred, add the potatoes to the skillet. Cook, stirring occasionally, until tender when pierced with a fork, 8 to 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 71496,
      "primary_message": "Juice 1 lemon into a large bowl and cut the other half into wedges for serving. Add olive oil and Dijon to the lemon juice and whisk together.",
      "secondary_message": "1 ½ lemon\n3 tbsp extra virgin olive oil\n3 tsp Dijon mustard"
    },
    {
      "id": 71495,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": ""
    },
    {
      "id": 71494,
      "primary_message": "Peel, halve lengthwise, and thinly slice the shallots; add to the bowl.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 71493,
      "primary_message": "Add the green beans and potatoes to the bowl; toss until the salad is combined.",
      "secondary_message": ""
    },
    {
      "id": 71492,
      "primary_message": "Divide the steak and salad between plates. Garnish with lemon wedges for squeezing over top. Enjoy!",
      "secondary_message": ""
    }
  ],
