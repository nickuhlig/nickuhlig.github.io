  "instructions": [
    {
      "id": 210772,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n142 g macaroni (elbow) pasta"
    },
    {
      "id": 210773,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ mango\n½ avocado\n2 medium carrots\n½ small head red cabbage\n½ small bunch green onions (scallions)"
    },
    {
      "id": 210774,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 cup edamame"
    },
    {
      "id": 210775,
      "primary_message": "Combine soy sauce, oil, vinegar, and sugar in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp toasted sesame oil\n2 tsp rice vinegar\n½ tsp brown sugar"
    },
    {
      "id": 210776,
      "primary_message": "Peel mango and slice the flesh away from the pit, starting with the flat sides. Small dice and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 210777,
      "primary_message": "Halve and pit the avocado. Slice lengthwise and crosswise while still in the skin and scoop out with a spoon. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210778,
      "primary_message": "Using a box grater, coarsely grate the carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210779,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise and cut out the core; thinly slice crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210780,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 210781,
      "primary_message": "Roughly chop peanuts and add to the bowl along with the edamame.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 210782,
      "primary_message": "Once pasta is done, drain and rinse under cool water. Add pasta to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 210783,
      "primary_message": "To serve, divide salad between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
