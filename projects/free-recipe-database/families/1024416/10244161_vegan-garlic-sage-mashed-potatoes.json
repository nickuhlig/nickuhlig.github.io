  "instructions": [
    {
      "primary_message": "Wash, dry, peel and medium dice potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": "1 tsp salt"
    },
    {
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "3 clove garlic"
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, wash, dry, and pick sage leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic and set aside.",
      "secondary_message": "½ small pkg fresh sage"
    },
    {
      "primary_message": "Once the skillet is hot, add vegan butter; cook, stirring occasionally, until bubbling and foamy, about 2 minutes. Remove from heat. ",
      "secondary_message": "½ cup vegan butter, plant-based"
    },
    {
      "primary_message": "Add sage and garlic to the skillet with the butter. Stir constantly (off the heat), until sage and garlic are fragrant, about 1 minute. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "When the potatoes are done, drain in a colander and return to the pot. Add half of the garlic-sage butter (reserving the rest for serving), milk, salt, and pepper; mash until smooth and creamy. (Alternatively, you can place these ingredients in the bowl of a stand mixer with a paddle attachment; mix on medium-low speed until smooth and creamy, 1-2 minutes.)",
      "secondary_message": "⅓ cup oat milk, original unsweetened\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Transfer mashed potatoes to a serving dish. Drizzle with reserved garlic-sage butter and enjoy!",
      "secondary_message": null
    }
  ],
