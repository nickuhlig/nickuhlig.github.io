  "instructions": [
    {
      "id": 1,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over half of the coal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. If using a gas grill, preheat half the grill to high.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, toss scapes with 2 tablespoons olive oil and season with salt and pepper. Add scapes to hot side of grill and cook, turning frequently, until tender and well-charred all over, about 5 minutes. Meanwhile, if desired, place lemon halves cut side down on hot side of grill and cook until charred, about 3 minutes. Transfer scapes to a large serving plate, drizzle with remaining olive oil, squeeze lemon over top (if desired), and serve immediately.",
      "secondary_message": null
    }
  ],
