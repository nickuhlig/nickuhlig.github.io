  "instructions": [
    {
      "id": 464573,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ lemon\n½ English cucumber\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 464574,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between a medium and a small bowl.",
      "secondary_message": null
    },
    {
      "id": 464575,
      "primary_message": "Peel and mince garlic. Divide between the bowls. (Set small bowl aside for later use.)",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 464576,
      "primary_message": "Peel and mince shallot. Add to the medium bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 464577,
      "primary_message": "Drain tuna, add to the bowl, and flake with a fork.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 464578,
      "primary_message": "Coarsely grate cheese. Add to the bowl along with egg, mayo, almond flour, chili-garlic sauce, salt, and pepper. Stir to combine the fritter mixture.",
      "secondary_message": "⅓ (227 g) block cheddar cheese\n1 egg\n3 tbsp avocado oil mayonnaise\n3 tbsp almond meal/flour\n1 ½ tsp chili-garlic sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 464579,
      "primary_message": "Using a ¼-cup measure, form the tuna mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 464580,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 464581,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters and pan-fry until golden and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 464582,
      "primary_message": "Meanwhile, zest and juice lemon into the small bowl with the parsley and garlic. Add yogurt, salt, and pepper, then stir to combine the yogurt sauce.",
      "secondary_message": "½ cup plain Greek yogurt\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 464583,
      "primary_message": "Transfer ⅓ of the yogurt sauce to a clean medium bowl, add oil, and whisk to combine the dressing. (Reserve remaining yogurt sauce for serving.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 464584,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl with the dressing, along with mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464585,
      "primary_message": "Divide the fritters and salad between plates. Serve with remaining yogurt sauce on the side for dipping. Enjoy! ",
      "secondary_message": null
    }
  ],
