  "instructions": [
    {
      "id": 464543,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n1 English cucumber\n1 orange bell pepper\n1 small pkg grape tomatoes\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 464544,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between a medium and a small bowl.",
      "secondary_message": null
    },
    {
      "id": 464545,
      "primary_message": "Peel and mince garlic. Divide between the bowls. (Set small bowl aside for later use.)",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 464546,
      "primary_message": "Peel and mince shallots. Add to the medium bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 464547,
      "primary_message": "Drain tuna, add to the bowl, and flake with a fork.",
      "secondary_message": "4 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 464548,
      "primary_message": "Coarsely grate cheese. Add to the bowl along with eggs, mayo, almond flour, chili-garlic sauce, salt, and pepper. Stir to combine the fritter mixture.",
      "secondary_message": "⅔ (227 g) block cheddar cheese\n2 eggs\n⅓ cup mayonnaise\n⅓ cup almond meal/flour\n1 tbsp chili-garlic sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464549,
      "primary_message": "Using a ¼-cup measure, form the tuna mixture into ½-inch thick fritters and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 464550,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 464551,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fritters and pan-fry until golden and cooked through, 3-4 minutes per side. Return to the plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 464552,
      "primary_message": "Meanwhile, zest and juice lemon into the small bowl with the parsley and garlic. Add yogurt, salt, and pepper, then stir to combine the yogurt sauce.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464553,
      "primary_message": "Transfer ⅓ of the yogurt sauce to a clean medium bowl, add oil, and whisk to combine the dressing. (Reserve remaining yogurt sauce for serving.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 464554,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464555,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 464556,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464557,
      "primary_message": "Divide fritters and salad between plates. Serve with remaining yogurt sauce on the side for dipping. Enjoy! ",
      "secondary_message": null
    }
  ],
