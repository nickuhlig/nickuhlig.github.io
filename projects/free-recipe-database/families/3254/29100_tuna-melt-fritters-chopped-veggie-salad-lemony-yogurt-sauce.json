  "instructions": [
    {
      "id": 464474,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n1 ½ English cucumbers\n1 ½ orange bell peppers\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 464475,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between a large and a small bowl.",
      "secondary_message": null
    },
    {
      "id": 464476,
      "primary_message": "Peel and mince garlic. Divide between the bowls. (Set small bowl aside for later use.)",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 464477,
      "primary_message": "Peel, halve, and mince onion. Add to the large bowl. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 464478,
      "primary_message": "Drain tuna, add to the bowl, and flake with a fork.",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 464479,
      "primary_message": "Coarsely grate cheese. Add to the bowl along with eggs, mayo, almond flour, chili-garlic sauce, salt, and pepper. Stir to combine the fritter mixture.",
      "secondary_message": "1 (8 oz) block cheddar cheese\n3 eggs\n½ cup mayonnaise\n½ cup almond meal/flour\n1 ½ tbsp chili-garlic sauce\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464480,
      "primary_message": "Using a ¼-cup measure, form the tuna mixture into ½-inch thick fritters and place on a platter.",
      "secondary_message": null
    },
    {
      "id": 464481,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 464482,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 3-4 minutes per side. Return to the platter.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 464483,
      "primary_message": "Meanwhile, zest and juice lemons into the small bowl with the parsley and garlic. Add yogurt, salt, and pepper, then stir to combine the yogurt sauce.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464484,
      "primary_message": "Transfer ⅓ of the yogurt sauce to a clean large bowl, add oil, and whisk to combine the dressing. (Reserve remaining yogurt sauce for serving.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 464485,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464486,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 464487,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464488,
      "primary_message": "Divide fritters and salad between plates. Serve with remaining yogurt sauce on the side for dipping. Enjoy! ",
      "secondary_message": null
    }
  ],
