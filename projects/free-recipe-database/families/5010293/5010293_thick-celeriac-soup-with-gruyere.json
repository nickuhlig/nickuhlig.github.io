  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely slice the shallots. Peel and cube the boiling potatoes. Peel and cube the celery root.",
      "secondary_message": "6 small shallots\n½ medium boiling potatoes\n1 ¾ lb celery root"
    },
    {
      "id": 1,
      "primary_message": "In a large stockpot, melt the butter over medium heat until frothy. Add the shallots, and cook on medium-low to medium heat until caramelized, about 10 minutes. Keep a cup of water on the side, and add a splash every few minutes to keep the shallots from burning before they are caramelized.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the potatoes, celery root, thyme, salt, pepper, and vegetable broth, and bring to a boil over high heat. Cover, and reduce the heat to medium-low, simmering for 30 minutes. Add the contents of the pot to a blender, and carefully purée until smooth. Serve very hot, with a big pile of coarsely grated Gruyère to pile on top and melt into the soup.",
      "secondary_message": null
    }
  ],
