  "instructions": [
    {
      "id": 105772,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 105773,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 small bunches green onions (scallions)\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 105774,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into small pieces. Roughly chop the spinach.",
      "secondary_message": null
    },
    {
      "id": 105775,
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 105776,
      "primary_message": "Add spinach and half of the green onions to the skillet. Cook, stirring occasionally until spinach is wilted, 4-6 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 105777,
      "primary_message": "Heat a medium saucepan  over medium-high heat. Once hot, add the oil. Let the oil heat up for about 30 seconds, then whisk in the flour. Continuing to whisk, cook the flour for another 2 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup all-purpose flour"
    },
    {
      "id": 105778,
      "primary_message": "Slowly whisk in the broth and tomato sauce. Stir in the spices. Bring to a boil, then reduce heat and simmer the enchilada sauce for 4-5 minutes, until thick. Remove from heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n2 (8 oz) cans tomato sauce\n¼ cup chili powder\n1 tsp garlic powder\n1 tsp onion powder\n1 tsp cumin\n½ tsp oregano"
    },
    {
      "id": 105779,
      "primary_message": "Grate the cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 105780,
      "primary_message": "In a large bowl, combine the spinach mixture, ricotta, yogurt, and salt.",
      "secondary_message": "1 (15 oz) pkg ricotta cheese\n½ cup plain Greek yogurt\n1 tsp salt"
    },
    {
      "id": 105781,
      "primary_message": "Spoon ¼-cup of the spinach mixture onto the center of each tortilla. Roll up and place seam side down in a baking dish. Pour enchilada sauce over top and sprinkle with the cheese.",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 105782,
      "primary_message": "Place in the oven and bake for 10 minutes, until cheese is melted.",
      "secondary_message": null
    },
    {
      "id": 105783,
      "primary_message": "To serve, divide enchiladas between plates and top with remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
