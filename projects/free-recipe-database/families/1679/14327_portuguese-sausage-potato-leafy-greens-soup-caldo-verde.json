  "instructions": [
    {
      "id": 238067,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 238068,
      "primary_message": "While the pot heats up, cut the sausages into ½-inch thick pieces.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 238069,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausage and pan-fry, stirring occasionally, until browned and cooked through, 6-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 238070,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 leeks\n3 tomatoes\n6 medium red potatoes\n2 bunches kale\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 238071,
      "primary_message": "When the sausage is done, remove to a plate using a slotted spoon and set aside.",
      "secondary_message": null
    },
    {
      "id": 238072,
      "primary_message": "Using a clean cutting board, trim off the root end and dark green top of the leeks, leaving only the white and pale green parts. Cut in half lengthwise and rinse under running water, separating the layers to remove dirt and grit. Slice crosswise into ¼-inch thick pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 238073,
      "primary_message": "Small dice tomatoes and add to the bowl with the leeks.",
      "secondary_message": null
    },
    {
      "id": 238074,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 238075,
      "primary_message": "Return the pot (with cooking juices) to medium-high heat and add more oil. Add leeks, tomatoes, garlic, and spices; cook, stirring occasionally, until veggies start to soften, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 238076,
      "primary_message": "While the veggies cook, peel, quarter, and slice potatoes into ½-inch thick pieces. ",
      "secondary_message": null
    },
    {
      "id": 238077,
      "primary_message": "Add potatoes and broth to the pot; stir to combine and bring to a boil over high heat.",
      "secondary_message": "2839 ml chicken or vegetable broth"
    },
    {
      "id": 238078,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces; add to the soup. Once the soup comes to a boil, reduce heat to a simmer, and cook until potatoes and kale are tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 238079,
      "primary_message": "While the soup cooks, roughly chop spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 238080,
      "primary_message": "When the potatoes and kale are tender, add cooked sausage and spinach to the soup and continue to simmer until spinach is wilted and sausage is heated through, 5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 238081,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
