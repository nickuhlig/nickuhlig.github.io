  "instructions": [
    {
      "id": 237947,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237948,
      "primary_message": "While the pan heats up, cut the sausages into ½-inch thick pieces.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 237949,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add sausage and pan-fry, stirring occasionally, until browned and cooked through, 5-6 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 237950,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 leek\n1 tomato\n2 medium red potatoes\n½ bunch kale\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 237951,
      "primary_message": "When the sausage is done, remove to a plate using a slotted spoon and set aside.",
      "secondary_message": null
    },
    {
      "id": 237952,
      "primary_message": "Using a clean cutting board, trim off the root end and dark green top of the leek, leaving only the white and pale green parts. Cut in half lengthwise and rinse under running water, separating the layers to remove dirt and grit. Slice crosswise into ¼-inch thick pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 237953,
      "primary_message": "Small dice tomato and add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 237954,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 237955,
      "primary_message": "Return the pan (with cooking juices) to medium-high heat and add more oil. Add leek, tomato, garlic, and spices; cook, stirring occasionally, until veggies start to soften, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n¾ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 237956,
      "primary_message": "While the veggies cook, peel, quarter, and slice potatoes into ½-inch thick pieces. ",
      "secondary_message": null
    },
    {
      "id": 237957,
      "primary_message": "Add potatoes and broth to the pan; stir to combine and bring to a boil over high heat.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth"
    },
    {
      "id": 237958,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces; add to the soup. Once the soup comes to a boil, reduce heat to a simmer, and cook until potatoes and kale are tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 237959,
      "primary_message": "While the soup cooks, roughly chop spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 237960,
      "primary_message": "When the potatoes and kale are tender, add cooked sausage and spinach to the soup and continue to simmer until spinach is wilted and sausage is heated through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 237961,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
