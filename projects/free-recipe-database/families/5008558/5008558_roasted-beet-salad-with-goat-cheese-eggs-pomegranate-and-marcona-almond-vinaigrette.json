  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the greens from the beets, then scrub them clean. Roughly chop the toasted Marcona almonds. Finely slice the white onions. Quarter the hard-boiled eggs.",
      "secondary_message": "8 medium beets, peels on\n¼ cup toasted Marcona almonds\n2 small white onions\n2 to 3 hard-boiled eggs"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 375°F. Fold a 12- by 24-inch sheet of aluminum foil in half to form a square. Crimp two edges to form a pouch. Toss beets, vegetable oil, and salt and pepper to taste in a medium bowl until coated. Add to pouch and crimp remaining edge to seal. Place on a rimmed baking sheet and place in oven. Roast until beets are completely tender and a toothpick or cake tester inserted into beet through foil shows little to no resistance, about 1 1/2 hours. Remove from oven and allow to cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine almonds, honey, vinegar, and shallots in a medium bowl. Whisking constantly, slowly drizzle in olive oil. Season dressing to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When beets are cool enough to handle, peel by gently rubbing skin under cold running water. Cut beets into 1 1/2-inch chunks.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Toss beets, pomegranate, onion, and dressing together in a large bowl. Transfer to a plate. Garnish with goat cheese, boiled eggs, and celery leaves. Serve immediately.",
      "secondary_message": null
    }
  ],
