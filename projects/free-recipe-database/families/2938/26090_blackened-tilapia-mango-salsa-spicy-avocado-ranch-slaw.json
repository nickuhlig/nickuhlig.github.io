  "instructions": [
    {
      "id": 415173,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 mango\n2 green bell peppers\n1 avocado"
    },
    {
      "id": 415174,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; small dice the flesh. Place in a small bowl along with salsa and salt. Stir to combine and set aside for serving.",
      "secondary_message": "1 cup salsa\n⅛ tsp salt"
    },
    {
      "id": 415175,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415176,
      "primary_message": "While the skillet heats up, pat tilapia dry with paper towels and place on a plate; season with chili powder and salt on both sides.",
      "secondary_message": "1 ½ lb tilapia fillet\n1 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 415177,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tilapia and cook, flipping once, until fish is crispy and easily flakes with a fork, about 6 minutes; remove to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 415178,
      "primary_message": "Meanwhile, place dressing, chili powder, and salt in a medium bowl. Stir to combine.",
      "secondary_message": "½ cup ranch dressing\n1 tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 415179,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 415180,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl, along with the shredded cabbage, and gently stir to combine the slaw.",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)"
    },
    {
      "id": 415181,
      "primary_message": "To serve, divide slaw and tilapia between plates; top fish with salsa. Enjoy!",
      "secondary_message": null
    }
  ],
