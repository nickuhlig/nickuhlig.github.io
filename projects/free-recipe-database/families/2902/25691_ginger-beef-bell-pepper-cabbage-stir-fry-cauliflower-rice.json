  "instructions": [
    {
      "id": 410896,
      "primary_message": "Peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 410897,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410898,
      "primary_message": "While the skillet heats up, wash, dry, peel, and mince ginger.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 410899,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, ginger, and riced cauliflower. Cook, stirring occasionally, until cauliflower is tender, 5-6 minutes. Transfer cauliflower rice to a plate and cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp toasted sesame oil\n2 (340 g) bags frozen, riced cauliflower"
    },
    {
      "id": 410900,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; small dice.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 410901,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add bell pepper and beef; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n0.68 kg lean ground beef"
    },
    {
      "id": 410902,
      "primary_message": "When the beef is done, add shredded cabbage and stir-fry sauce to the skillet. Continue to cook, stirring occasionally, until the cabbage has softened, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 (397 g) bag shredded cabbage (coleslaw mix)\n⅔ cup stir-fry sauce"
    },
    {
      "id": 410903,
      "primary_message": "To serve, divide cauliflower rice between plates or bowls. Top with beef stir-fry and enjoy!",
      "secondary_message": null
    }
  ],
