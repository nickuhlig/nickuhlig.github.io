  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry potatoes. Working one at a time, use a sharp paring knife, small melon baller, or metal measuring spoon to cut \"faces\" into each potato (eyes, nose, mouth). For best results, the deeper you cut each face design, the more \"shrunken\" the potato \"head\" will appear.",
      "secondary_message": "907 g new potatoes"
    },
    {
      "primary_message": "Transfer potato \"heads\" to a baking sheet pan, face-side up. Drizzle with oil and season with salt.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "primary_message": "Place baking sheet in the oven and roast until heads are tender and \"shrunken\", 25-30 minutes. Remove from oven.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, drain roasted peppers and place in a blender. Add mayo, Dijon, lemon juice, and spices. Blend on high until smooth, 1-2 minutes. Set dip aside.",
      "secondary_message": "½ (340 g) jar roasted red bell peppers\n2 tbsp mayonnaise\n1 tbsp coarse ground dijon mustard\n1 ½ tsp lemon juice\n¼ tsp Italian seasoning\n¼ tsp onion powder\n⅛ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Arrange heads on a serving platter and serve with dip on the side. Enjoy!",
      "secondary_message": null
    }
  ],
