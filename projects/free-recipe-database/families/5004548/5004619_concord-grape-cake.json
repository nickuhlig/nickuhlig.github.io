  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Melt the unsalted butter. Bring the eggs to room temperature. Bring the sweet white wine to room temperature. Bring the milk to room temperature. Zest the lemon. Split the Concord grapes in half, then remove the seeds. Juice the lemon.",
      "secondary_message": "3 tbsp unsalted butter\n2 large eggs\n⅓ cup sweet white wine\n⅓ cup milk\n1 lemon\n340 g Concord grapes\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "For the Cake: Adjust oven rack to middle position and preheat oven to 190°C (375°F). Grease 23-cm round cake pan with 1 tablespoon butter. Line bottom of pan with parchment paper and coat and grease once again with whatever butter is left on the pastry brush.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Beat eggs and brown sugar on medium-high speed until pale yellow and foamy, about 2 minutes. Add salt, wine, milk, oil, and lemon zest and beat until combined, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine flour and baking powder in small bowl. Lower mixer speed to low and add flour mixture. Beat just until combined, scraping sides and bottom of bowl with rubber spatula as necessary. Fold in grapes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Scrape batter into prepared pan and bake until cake tester inserted in middle of cake comes out clean, rotating pan halfway through baking, 25 to 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cool cake in pan about 10 minutes, then turn over onto large plate. Immediately invert onto cooling rack set over parchment-lined baking sheet (to catch any drips).",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For the Concord Grape Jam: While cake is cooling, place a small plate in the freezer.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Remove the grape skins by pinching the grapes and place them in a food processor. Pulse with 1/4 cup sugar until completely pureed.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Combine pureed skins, peeled grapes, lemon juice, and remaining 3/4 cup sugar in medium heavy-bottomed saucepan. Bring mixture to boil over medium-high heat, then reduce to medium-low and simmer, stirring frequently, until thickened and reduced to 1 cup, 25 to 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Strain hot jam into a glass measuring cup; discard seeds (strained jam will measure about 3/4 cup). To test for doneness, drop a tablespoon of jam on the chilled plate and allow to stand for 1 minute. Tilt the plate: if the jam runs, return it to the saucepan and simmer 3 to 5 minutes and test again. Jam is done when it stays in a mound.",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "Spread warm jam over warm cake and let cool completely, about 1 hour. Serve.",
      "secondary_message": null
    }
  ],
