  "instructions": [
    {
      "id": 477189,
      "primary_message": "Small dice ham, place in a medium bowl, and set aside.",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 477190,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477191,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 477192,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and broccoli; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ (18 oz) bags broccoli florets"
    },
    {
      "id": 477193,
      "primary_message": "Meanwhile, place cottage cheese in a strainer to remove excess liquid. Transfer to a large bowl, along with eggs and spices, then whisk to combine.",
      "secondary_message": "1 ½ cups cottage cheese\n18 eggs\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 477194,
      "primary_message": "When the broccoli is tender, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 477195,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 477196,
      "primary_message": "Sprinkle diced ham and shredded cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 4-5 minutes. Remove from oven and let set, about 5 min.",
      "secondary_message": "2 cups shredded cheese, Italian blend"
    },
    {
      "id": 477197,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
