  "instructions": [
    {
      "id": 477206,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477207,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 477208,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and broccoli; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 (18 oz) bag broccoli florets"
    },
    {
      "id": 477209,
      "primary_message": "Meanwhile, place cottage cheese in a strainer to remove excess liquid. Transfer to a medium bowl, along with eggs and spices, then whisk to combine.",
      "secondary_message": "1 cup cottage cheese\n12 eggs\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 477210,
      "primary_message": "When the broccoli is tender, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 477211,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 477212,
      "primary_message": "Sprinkle shredded cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven and let set, about 5 min.",
      "secondary_message": "2 cups shredded cheese, Italian blend"
    },
    {
      "id": 477213,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
