  "instructions": [
    {
      "id": 441220,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 441221,
      "primary_message": "Arrange pitas on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 6-8 minutes. Remove from oven.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 441222,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 441223,
      "primary_message": "While the skillet heats up, wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 441224,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 441225,
      "primary_message": "Transfer cooked spinach to a colander. Using the back of a spoon, squeeze as much water from the spinach as you can; set aside. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 441226,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 441227,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat, then season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 441228,
      "primary_message": "Divide spinach between pitas, then top with fried eggs. ",
      "secondary_message": null
    },
    {
      "id": 441229,
      "primary_message": "To serve, divide pitas between plates and sprinkle with crushed red pepper. Enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
