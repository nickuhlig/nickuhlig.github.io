  "instructions": [
    {
      "id": 441240,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 441241,
      "primary_message": "Arrange pitas on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until slightly crisp, 4-5 minutes. Remove from oven.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 441242,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 441243,
      "primary_message": "While the skillet heats up, wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 441244,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 441245,
      "primary_message": "Transfer cooked spinach to a colander. Using the back of a spoon, squeeze as much water from the spinach as you can; set aside. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 441246,
      "primary_message": "Flip pitas and top with prosciutto. Return baking sheet to the oven and continue to bake until prosciutto is warmed through, 3-4 minutes more. Remove from oven.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 441247,
      "primary_message": "Meanwhile, wipe the skillet clean with paper towels and return to medium heat.",
      "secondary_message": null
    },
    {
      "id": 441248,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat, then season with pepper.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 eggs\n1 pinch black pepper"
    },
    {
      "id": 441249,
      "primary_message": "Divide spinach between pitas, then top with fried eggs. ",
      "secondary_message": null
    },
    {
      "id": 441250,
      "primary_message": "To serve, divide pitas between plates and sprinkle with crushed red pepper. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
