  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly chop the sweet onion. Roughly chop the garlic.",
      "secondary_message": "½ small sweet onion\n1 medium clove garlic"
    },
    {
      "id": 1,
      "primary_message": "Using a fine-mesh strainer or colander, rinse the onion under warm (about 43°C; 43°C) running water for 1 minute, shaking to ensure that all surfaces are rinsed. (This tames sulfurous flavor and aroma compounds in the onion.) Turn off the water and shake the onion dry over the sink.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a blender or food processor, combine onion, garlic, vinegar, mustard, sugar, white pepper, and salt and blend until smooth, about 30 seconds. Add mayonnaise and blend just until fully incorporated, 15 to 20 seconds. (Careful: Overdoing it can weaken the emulsion.)",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Season to taste with salt, if needed. Transfer to a jar or squeeze bottle and refrigerate overnight (6 to 12 hours) before serving.",
      "secondary_message": null
    }
  ],
