  "instructions": [
    {
      "id": 197633,
      "primary_message": "Preheat the oven to 205°C (400°F). Line two baking sheet pans with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 197634,
      "primary_message": "Preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 197635,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onions into half moons.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 197636,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and salt; cook, stirring often, until soft and lightly golden, about 15 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 197637,
      "primary_message": "Meanwhile, wash, dry, and peel each butternut squash; halve and remove seeds with a spoon. ",
      "secondary_message": "1 ½ small butternut squash"
    },
    {
      "id": 197638,
      "primary_message": "Cut each squash crosswise into ¼-inch thick slices and divide between baking sheets. Drizzle with oil and season with sugar and spices; toss to coat, then spread out in a single layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp brown sugar\n¾ tsp thyme\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 197639,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated), and bake until fork-tender and golden brown around the edges, about 20 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 197640,
      "primary_message": "Meanwhile, drain and rinse beans. Transfer beans to a large bowl along with mayo and spices. Use a fork or potato masher to crush the beans, making a semi-smooth spread. Set aside.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans\n⅓ cup vegan mayonnaise\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp rosemary\n½ tsp garlic powder"
    },
    {
      "id": 197641,
      "primary_message": "When the onions are soft, add vinegar and stir to combine. Reduce heat to low and continue to cook, stirring often, until vinegar reduces, 3-4 minutes more. Remove from heat.",
      "secondary_message": "⅓ cup balsamic vinegar"
    },
    {
      "id": 197642,
      "primary_message": "Place oil, vinegar, and spices in another large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n½ tsp salt\n½ tsp Italian seasoning\n½ tsp garlic powder\n3 pinch black pepper"
    },
    {
      "id": 197643,
      "primary_message": "Wash and dry the mixed greens (skip if they came pre-washed) and add to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 197644,
      "primary_message": "Carefully remove cooked squash from each baking sheet by lifting the corners of the foil and transferring the whole sheet to a flat surface. ",
      "secondary_message": null
    },
    {
      "id": 197645,
      "primary_message": "Split rolls in half and divide between baking sheets, cut-side facing up. Place in the oven and cook until lightly toasted, 2-3 minutes. Remove from the oven.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 197646,
      "primary_message": "Divide rolls between plates; layer each roll with a thick layer of bean spread, butternut squash, and balsamic onions. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
