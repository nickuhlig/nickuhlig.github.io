  "instructions": [
    {
      "id": 197577,
      "primary_message": "Preheat the oven to 205°C (400°F). Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 197578,
      "primary_message": "Preheat a medium saucepan over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 197579,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onions into half moons.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 197580,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the onion and salt; cook, stirring often, until soft and lightly golden, about 15 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 197581,
      "primary_message": "Meanwhile, wash, dry, and peel the butternut squash; halve and remove seeds with a spoon. ",
      "secondary_message": "1 small butternut squash"
    },
    {
      "id": 197582,
      "primary_message": "Cut squash crosswise into ¼-inch thick slices and transfer to the baking sheet. Drizzle with oil and season with sugar and spices; toss to coat, then spread out in a single layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp brown sugar\n½ tsp thyme\n½ tsp rosemary\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 197583,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated), and bake until fork-tender and golden brown around the edges, 15-20 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 197584,
      "primary_message": "Thinly slice mozzarella and set aside.",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 197585,
      "primary_message": "Place oil, vinegar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n¼ tsp salt\n¼ tsp Italian seasoning\n¼ tsp garlic powder\n⅛ tsp black pepper"
    },
    {
      "id": 197586,
      "primary_message": "Wash and dry the mixed greens (skip if they came pre-washed) and add to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 197587,
      "primary_message": "When the onions are soft, add vinegar and stir to combine. Reduce heat to low and continue to cook, stirring often, until vinegar reduces, 3-4 minutes more. Remove from heat.",
      "secondary_message": "¼ cup balsamic vinegar"
    },
    {
      "id": 197588,
      "primary_message": "Carefully remove cooked squash from the baking sheet by lifting the corners of the foil and transferring the whole sheet to a flat surface. ",
      "secondary_message": null
    },
    {
      "id": 197589,
      "primary_message": "Split rolls in half and place on the baking sheet, cut-side facing up. Place in the oven and cook until lightly toasted, about 2 minutes. Remove from the oven and spread each half with mayo.",
      "secondary_message": "4 whole grain buns or rolls\n¼ cup mayonnaise"
    },
    {
      "id": 197590,
      "primary_message": "Divide rolls between plates; layer with butternut squash, mozzarella, and balsamic onions. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
