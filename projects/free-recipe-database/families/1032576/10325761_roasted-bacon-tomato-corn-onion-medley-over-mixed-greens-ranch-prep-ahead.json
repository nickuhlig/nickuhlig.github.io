  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 large and 4 mini food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry tomatoes. Divide between two baking sheet pans.",
      "secondary_message": "2 pint grape tomatoes"
    },
    {
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the baking sheets with the tomatoes, along with corn. Drizzle veggies with oil, season with spices, and stir to combine. Spread out in an even layer.",
      "secondary_message": "1 medium red onion\n3 cups frozen corn\n2 tsp extra virgin olive oil\n3 tbsp taco seasoning\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "primary_message": "Medium dice bacon. Sprinkle over the baking sheets.\n\n",
      "secondary_message": "12 slice bacon"
    },
    {
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until bacon is crispy and veggies are golden and tender, about 20 minutes. Remove from oven and set aside to cool completely, about 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, divide dressing between the mini containers, cover, and set aside.",
      "secondary_message": "½ cup ranch dressing"
    },
    {
      "primary_message": "When the veggies are cool, wash and dry the mixed greens (skip this step if they came pre-washed). Divide between the large storage containers, then top with cooled veggies. Add dressing, cover, and refrigerate until ready to eat. Drizzle salad with dressing and enjoy!",
      "secondary_message": "2 (142 g) pkg spring mix (mixed greens)"
    }
  ],
