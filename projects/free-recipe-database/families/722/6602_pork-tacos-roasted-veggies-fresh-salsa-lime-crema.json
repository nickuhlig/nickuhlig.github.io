  "instructions": [
    {
      "id": 302171,
      "primary_message": "Preheat oven to 425°F. Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 302172,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 limes\n1 small bunch cilantro\n1 pint grape tomatoes"
    },
    {
      "id": 302173,
      "primary_message": "Place spices in a medium bowl; stir to combine the spice mix.",
      "secondary_message": "1 tsp garlic powder\n1 tsp chili powder\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 302174,
      "primary_message": "Peel and halve onion. Mince half and place in a small bowl; set aside. Thinly slice remaining onion and transfer to the baking sheet.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 302175,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into strips; add bell pepper and corn to the baking sheet with the sliced onion. Sprinkle veggies with half of the spice mix and drizzle with oil; toss to combine. (Reserve remaining spice mix for the pork.)",
      "secondary_message": "⅔ cup frozen corn\n2 tsp extra virgin olive oil"
    },
    {
      "id": 302176,
      "primary_message": "Spread veggies out in an even layer. Place in the oven (it doesn't have to be fully heated) and roast until softened, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 302177,
      "primary_message": "Meanwhile, zest limes into another small bowl; add yogurt, salt, and pepper. Whisk to combine the lime crema and set aside. (Reserve limes for next step.)",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 302178,
      "primary_message": "Juice one of the reserved limes into the bowl with minced onion; cut the remaining lime into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 302179,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Halve tomatoes. Add both to the bowl with onion and lime juice along with oil, salt, and pepper; stir to combine the salsa and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 302180,
      "primary_message": "Grate cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 302181,
      "primary_message": "Pat pork chops dry with paper towels, then thinly slice into bite-sized strips. Place in the bowl with remaining spice mix, and toss to coat.",
      "secondary_message": "4 pork chops, boneless"
    },
    {
      "id": 302182,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom; add the pork and cook, stirring occasionally, until golden brown and cooked through, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 302183,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 302184,
      "primary_message": "Divide tortillas between plates, then fill with pork, veggies, and cheese. Serve with fresh salsa, lime crema, and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
