  "instructions": [
    {
      "id": 106487,
      "primary_message": "This recipe will make about 12 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 106488,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pineapples\n¾ small pkg fresh mint"
    },
    {
      "id": 106489,
      "primary_message": "Cut skin off pineapples, core, and cut into large pieces; add to blender.",
      "secondary_message": null
    },
    {
      "id": 106490,
      "primary_message": "Pick the mint leaves off the stems; discard the stems and add leaves to blender.",
      "secondary_message": null
    },
    {
      "id": 106491,
      "primary_message": "Add raspberries, yogurt, milk, maple syrup, and 12 ice cubes to the blender.",
      "secondary_message": "3 cup frozen raspberries\n3 cups plain Greek yogurt\n24 fl oz (3 cups) whole milk\n3 tbsp pure maple syrup"
    },
    {
      "id": 106492,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 106493,
      "primary_message": "Pour the smoothie into glasses and enjoy!",
      "secondary_message": null
    }
