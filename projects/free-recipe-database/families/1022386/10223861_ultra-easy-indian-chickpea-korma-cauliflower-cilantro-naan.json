  "instructions": [
    {
      "primary_message": "Drain and rinse chickpeas. Place in a large skillet along with korma curry sauce, salt, and pepper, then stir to combine the curry. Cover and bring to a boil over high heat, stirring occasionally. Once boiling, reduce heat to medium-low and simmer, uncovered, until chickpeas are tender, 8-10 minutes.",
      "secondary_message": "1 (254 g) can garbanzo beans (chickpeas)\n1 (425 g) jar Indian korma curry sauce\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "primary_message": "When the curry has about 5 minutes left, place cauliflower bag on a microwave-safe plate and pierce with a fork. Place in the microwave and cook on high, until tender, 3-4 minutes. Remove plate from microwave and carefully open the bag. Add to the curry, stir to combine, and remove from heat.",
      "secondary_message": "1 (283 g) bag cauliflower florets"
    },
    {
      "primary_message": "While the cauliflower is cooking, toast naan if desired, then cut into wedges.",
      "secondary_message": "1 flatbread or naan"
    },
    {
      "primary_message": "Divide curry between bowls and sprinkle with cilantro. Serve with naan on the side and enjoy!",
      "secondary_message": null
    }
  ],
