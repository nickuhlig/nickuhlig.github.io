    {
      "id": 1,
      "primary_message": "In a blender, combine mint, cilantro, and 1/3 cup water. Blend until smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large mixing bowl, whisk together herb purée, buttermilk, yogurt, chaat masala, black pepper, chile powder, and salt. Adjust with more seasoning if desired.",
      "secondary_message": null
    },
    {
