  "instructions": [
    {
      "id": 392192,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 392193,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 392194,
      "primary_message": "Meanwhile, wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and place in a small bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 392195,
      "primary_message": "Add spices to the bowl with the avocado, then mash once more to combine the spread. Set aside.",
      "secondary_message": "⅛ tsp cumin, ground\n⅛ tsp onion powder\n⅛ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 392196,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise. ",
      "secondary_message": "½ small pkg grape tomatoes"
    },
    {
      "id": 392197,
      "primary_message": "Divide avocado spread between toast slices and smooth out in an even layer; top with tomatoes.",
      "secondary_message": null
    },
    {
      "id": 392198,
      "primary_message": "To serve, divide avocado toast between plates; sprinkle with sesame seeds and additional salt. Enjoy!",
      "secondary_message": "½ tsp sesame seeds\n1 pinch salt"
    }
  ],
