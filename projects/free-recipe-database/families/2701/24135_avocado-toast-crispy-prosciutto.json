  "instructions": [
    {
      "id": 392115,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 392116,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, lay prosciutto in the skillet and cook until it browns slightly, about 1 minute per side. Remove to a plate and set aside.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n6 slices prosciutto"
    },
    {
      "id": 392117,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 392118,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 392119,
      "primary_message": "Meanwhile, wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and place in a medium bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "3 avocados"
    },
    {
      "id": 392120,
      "primary_message": "Add spices to the bowl with the avocado, then mash once more to combine the spread.",
      "secondary_message": "½ tsp onion powder\n½ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 392121,
      "primary_message": "Divide avocado spread between toast slices and smooth out in an even layer. ",
      "secondary_message": null
    },
    {
      "id": 392122,
      "primary_message": "To serve, divide toast between plates; crumble crispy prosciutto over top. Enjoy!",
      "secondary_message": null
    }
  ],
