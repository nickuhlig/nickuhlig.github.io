  "instructions": [
    {
      "id": 584227,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 584228,
      "primary_message": "While the pan heats up, peel and mince garlic. Place half in a medium bowl and set aside for the meatballs. (Reserve remaining garlic for the next step.)",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 584229,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add reserved garlic and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 584230,
      "primary_message": "Add broth, pumpkin, orzo, salt, and nutmeg to the pan; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n½ (15 oz) can pure pumpkin purée\n5 oz orzo pasta\n½ tsp salt\n⅛ tsp nutmeg, ground"
    },
    {
      "id": 584231,
      "primary_message": "Meanwhile, wash, dry, and pick sage leaves off the stems; discard stems and mince the leaves (reserving a small handful of whole leaves for garnish). Add minced sage to the bowl with the garlic.",
      "secondary_message": "½ small pkg fresh sage"
    },
    {
      "id": 584232,
      "primary_message": "Add chicken, bread crumbs, and spices to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "½ lb ground chicken\n¼ cup panko bread crumbs\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 584233,
      "primary_message": "Using a rounded tablespoon measure, form the chicken mixture into meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 584234,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584235,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Remove from heat, cover, and set aside.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 584236,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 584237,
      "primary_message": "When the orzo is done, add spinach to the pan in handfuls, waiting for it to wilt slightly before adding the next handful. Add milk, stir to combine, and remove from heat.",
      "secondary_message": "2 fl oz (¼ cup) whole milk"
    },
    {
      "id": 584238,
      "primary_message": "To serve, divide orzo between plates or bowls; top with meatballs and reserved sage. Enjoy!",
      "secondary_message": null
    }
  ],
