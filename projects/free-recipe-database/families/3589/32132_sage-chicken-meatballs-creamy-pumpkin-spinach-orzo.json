  "instructions": [
    {
      "id": 584239,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 584240,
      "primary_message": "While the pot heats up, peel and mince garlic. Place half in a medium bowl and set aside for the meatballs. (Reserve remaining garlic for the next step.)",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 584241,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add reserved garlic and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 584242,
      "primary_message": "Add broth, pumpkin, orzo, salt, and nutmeg to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 (15 oz) can pure pumpkin purée\n10 oz orzo pasta\n1 tsp salt\n¼ tsp nutmeg, ground"
    },
    {
      "id": 584243,
      "primary_message": "Meanwhile, wash, dry, and pick sage leaves off the stems; discard stems and mince the leaves (reserving a small handful of whole leaves for garnish). Add minced sage to the bowl with the garlic.",
      "secondary_message": "½ small pkg fresh sage"
    },
    {
      "id": 584244,
      "primary_message": "Add chicken, bread crumbs, and spices to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "1 lb ground chicken\n½ cup panko bread crumbs\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 584245,
      "primary_message": "Using a rounded tablespoon measure, form the chicken mixture into meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 584246,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584247,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Remove from heat, cover, and set aside.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 584248,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 584249,
      "primary_message": "When the orzo is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Add milk, stir to combine, and remove from heat.",
      "secondary_message": "4 fl oz (½ cup) whole milk"
    },
    {
      "id": 584250,
      "primary_message": "To serve, divide orzo between plates or bowls; top with meatballs and reserved sage. Enjoy!",
      "secondary_message": null
    }
  ],
