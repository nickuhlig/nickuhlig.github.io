  "instructions": [
    {
      "id": 368138,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 368139,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 368140,
      "primary_message": "Break lasagna noodles into thirds. Once the water in the pan is boiling, uncover, add salt and broken noodles, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once done, drain in a colander and set aside.",
      "secondary_message": "4 no-boil lasagna noodles\n½ tsp salt"
    },
    {
      "id": 368141,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a medium bowl.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 368142,
      "primary_message": "Peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 368143,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368144,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices to the skillet; cook, stirring frequently, until starting to soften, 1-2 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp basil, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 368145,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Cook, stirring frequently, until the onion and kale are tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 368146,
      "primary_message": "Meanwhile, coarsely grate mozzarella.",
      "secondary_message": "⅓ (227 g) block mozzarella cheese"
    },
    {
      "id": 368147,
      "primary_message": "When the veggies are done, add pumpkin and cream to the skillet. Continue to cook, stirring frequently, until sauce is smooth, 2-3 minutes.",
      "secondary_message": "½ (398 ml) can pure pumpkin purée\n118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 368148,
      "primary_message": "Add noodles to the skillet and toss to combine. Continue to cook, tossing occasionally, until heated through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 368149,
      "primary_message": "Sprinkle cheese over the lasagna skillet.",
      "secondary_message": null
    },
    {
      "id": 368150,
      "primary_message": "Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 368151,
      "primary_message": "To serve, divide lasagna skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
