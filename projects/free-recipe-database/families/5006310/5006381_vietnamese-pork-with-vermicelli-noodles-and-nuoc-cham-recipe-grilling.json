  "instructions": [
    {
      "id": 1,
      "primary_message": "Place pork in the freezer until it firms slightly, 45 to 60 minutes. Remove the pork from the freezer, thinly slice and place in a large ziploc bag.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, mix the ingredients for the marinade. Pour marinade into the bag with the pork and seal, removing as much air as possible. Place in the refrigerator and allow to marinate for one hour to overnight.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, mix the ingredients for the sauce. Place in the refrigerator until ready to use.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Right before grilling, bring a large pot of water to a rolling boil. Add the vermicelli noodles and cook until tender, about 2 to 4 minutes. Drain the noodles and rinse with cold water to stop the cooking process, set aside.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Remove the pork from the fridge. Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly over the charcoal grate. Grill pork immediately over the hot fire until cooked through and charred well on both sides, about 5 to 10 minutes. Remove pork to a plate.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "To assemble, place noodles in bowl or on a plate, then top with the grilled pork, lettuce and mint. Drizzle with the sauce and enjoy!",
      "secondary_message": null
    }
  ],
