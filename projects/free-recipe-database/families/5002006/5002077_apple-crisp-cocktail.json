  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Cardamom-Infused Bourbon: In a mortar and pestle, coarsely crush 1/4 cup cardamom pods. Place crushed cardamom pods in a resealable container or glass jar. Add bourbon, shake, and let sit until fragrant, about 1 1/2 hours at room temperature. Using a fine-mesh sieve, strain bourbon into a clean container or jar; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Honey Syrup: In a small bowl, whisk water and honey to combine. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Cocktail: Fill a cocktail shaker with ice. Add apple brandy, cardamom-infused bourbon, lemon juice, and honey syrup. Shake until well chilled, about 15 seconds.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Strain into an ice-filled highball glass. Top with club soda and garnish with lemon twist.",
      "secondary_message": null
    }
  ],
