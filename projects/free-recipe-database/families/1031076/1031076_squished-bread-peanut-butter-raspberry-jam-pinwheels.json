  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place bread slices on a cutting board, then use a butter knife to cut off the crusts.\n\n",
      "secondary_message": "8 slice whole grain bread"
    },
    {
      "primary_message": "Using a rolling pin or the bottom of a small saucepan, squish the bread as thin as you can (aim for a ¼-inch or thinner).\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spread a thin layer of peanut butter and jam evenly over each piece of squished bread. (Use about 1 teaspoon of each. The more you use, the more will be squished out after rolling!)\n\n",
      "secondary_message": "3 tbsp natural peanut butter\n3 tbsp raspberry jam"
    },
    {
      "primary_message": "Starting from one of the short sides, carefully roll each slice of bread into a tight roll. Cut rolls crosswise into 1-inch \"pinwheels.\"\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pinwheels between plates, share, and enjoy!",
      "secondary_message": null
    }
  ],
