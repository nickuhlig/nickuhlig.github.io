  "instructions": [
    {
      "id": 306644,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup cooking water before draining and set aside.)",
      "secondary_message": "½ tsp salt\n283 g rotini pasta"
    },
    {
      "id": 306645,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n0.45 kg cremini mushrooms\n1 small pkg fresh basil"
    },
    {
      "id": 306646,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons; thinly slice mushrooms. Place both in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 306647,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306648,
      "primary_message": "While the skillet heats up, peel and thinly slice shallots; peel and mince garlic. Add both to the bowl with the other veggies. ",
      "secondary_message": "2 shallots\n4 cloves garlic"
    },
    {
      "id": 306649,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 306650,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl and set aside. ",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 306651,
      "primary_message": "Thinly slice sun-dried tomatoes. ",
      "secondary_message": "8 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 306652,
      "primary_message": "When the veggies are done, add sun-dried tomatoes, cream, and spices to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until sauce thickens, 2-3 minutes. ",
      "secondary_message": "237 ml heavy whipping cream\n2 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 306653,
      "primary_message": "While the sauce simmers, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 306654,
      "primary_message": "Add cooked pasta, Parmesan, basil, and peas to the skillet; stir to combine. Continue to cook, stirring frequently, until cheese is melted and peas are tender, 1-2 minutes more. ",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 306655,
      "primary_message": "Add reserved pasta water to the skillet, a few tablespoons at a time, while stirring, to reach a saucy consistency (you may not need all of the reserved water). Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 306656,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
