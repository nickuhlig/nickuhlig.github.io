  "instructions": [
    {
      "id": 306579,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup cooking water before draining and set aside.)",
      "secondary_message": "¾ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 306580,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n1 ½ lb cremini mushrooms\n1 small pkg fresh basil"
    },
    {
      "id": 306581,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons; thinly slice mushrooms. Place both in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 306582,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; peel and mince garlic. Add both to the bowl with the other veggies. ",
      "secondary_message": "½ medium red onion\n6 cloves garlic"
    },
    {
      "id": 306583,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306584,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 306585,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl and set aside. ",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 306586,
      "primary_message": "Thinly slice sun-dried tomatoes. ",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 306587,
      "primary_message": "When the veggies are done, add sun-dried tomatoes, cream, and spices to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until sauce thickens, 3-4 minutes. ",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 306588,
      "primary_message": "While the sauce simmers, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 306589,
      "primary_message": "Add cooked pasta, Parmesan, basil, and peas to the pot with the veggies; stir to combine. Continue to cook, stirring frequently, until cheese is melted and peas are tender, 2-3 minutes more. ",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 306590,
      "primary_message": "Add reserved pasta water to the pot, a few tablespoons at a time, while stirring, to reach a saucy consistency (you may not need all of the reserved water). Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 306591,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
