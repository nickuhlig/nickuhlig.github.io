  "instructions": [
    {
      "id": 98938,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 98939,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n1 medium zucchini squash\n½ small pkg grape tomatoes"
    },
    {
      "id": 98940,
      "primary_message": "Small dice the potato (cut into ¼-inch cubes). Transfer to a medium saucepan and cover with hot water (from the tap). Bring to a boil over high heat; reduce heat and simmer, covered, for 7 minutes. Once finished, drain the potatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 98941,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 98942,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 98943,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic, and cook, stirring occasionally, 2-3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 98944,
      "primary_message": "Halve zucchini lengthwise, then slice crosswise into half rounds. Add the zucchini and spices to the skillet and stir to combine.",
      "secondary_message": "½ tsp turmeric\n½ tsp salt\n¼ tsp basil\n¼ tsp oregano"
    },
    {
      "id": 98945,
      "primary_message": "Crumble the tofu with your fingers into the skillet. Add the cooked potatoes and stir to combine. Sauté until the veggies are softened, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 98946,
      "primary_message": "Halve the grape tomatoes.",
      "secondary_message": null
    },
    {
      "id": 98947,
      "primary_message": "Remove from the heat and stir in the grape tomatoes. Divide between plates and enjoy!",
      "secondary_message": null
    }
  ],
