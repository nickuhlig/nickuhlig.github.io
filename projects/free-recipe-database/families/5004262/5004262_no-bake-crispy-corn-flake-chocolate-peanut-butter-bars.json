  "instructions": [
    {
      "id": 1,
      "primary_message": "Line an 8- by 8-inch baking pan with foil (see notes). In a medium saucepan over medium heat, melt butter. Add peanut butter, corn syrup, brown sugar, and salt and continue to cook, stirring, until melted and smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in corn flakes, 1/4 cup peanuts, and vanilla until just combined. Spoon into prepared pan and smooth top.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a heatproof bowl over a pan of barely simmering water (or in a microwave), heat chocolate until just melted. Spread over top. Sprinkle with remaining chopped peanuts. Chill until firm, about 2 hours (see notes). Remove from pan and cut into 2-inch squares.",
      "secondary_message": null
    }
  ],
