  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel banana, break into chunks, and place in a medium bowl.",
      "secondary_message": "1 banana"
    },
    {
      "primary_message": "Add sugar, oil, and vanilla to the bowl with the banana. Crush with a fork or potato masher until smooth.",
      "secondary_message": "¼ cup brown sugar\n2 tbsp virgin coconut oil\n½ tsp vanilla extract"
    },
    {
      "primary_message": "Add oats to the bowl and stir to combine.",
      "secondary_message": "⅔ cup oats, quick cooking"
    },
    {
      "primary_message": "Halve dates lengthwise, then thinly slice crosswise. Add to the bowl and stir to distribute.",
      "secondary_message": "¼ cup medjool dates, pitted"
    },
    {
      "primary_message": "Place flour, cornstarch, baking powder, baking soda, and spices in a small bowl; stir to combine.",
      "secondary_message": "½ tsp cornstarch\n¼ tsp baking powder\n¼ tsp baking soda\n⅛ tsp salt"
    },
    {
      "primary_message": "Add flour mixture to the bowl with the banana and stir to combine the cookie batter.",
      "secondary_message": null
    },
    {
      "primary_message": "Use a ⅓ cup measure to scoop the batter onto the sheet pan. Using a silicone spatula or the back of a spoon, spread each cookie into a 3-inch circle. Place in the oven and bake until golden around the edges, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Allow cookies to cool slightly and enjoy!",
      "secondary_message": null
    }
  ],
