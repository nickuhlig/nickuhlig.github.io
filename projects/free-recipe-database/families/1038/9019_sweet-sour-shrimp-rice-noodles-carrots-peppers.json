  "instructions": [
    {
      "id": 145112,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 145113,
      "primary_message": "Fill a medium saucepan halfway with water and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions. Then drain in a colander and rinse.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 145114,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 red bell peppers\n3 sticks celery\n1 ½ small bunches green onions (scallions)\n3 (1 inch) pieces ginger root\n1 ½ medium heads napa cabbage\n3 limes\n3 oranges"
    },
    {
      "id": 145115,
      "primary_message": "Peel the carrots; then using the peeler, run it along the carrot to make long, noodle-like strips. Seed and slice bell peppers into thin strips. Trim ends of celery and slice into small pieces. Transfer all to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 145116,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into small pieces. Add half of the onions to the bowl with the sliced vegetables (reserving the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 145117,
      "primary_message": "Peel and mince or grate the ginger. Peel and mince the garlic. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 145118,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 145119,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 145120,
      "primary_message": "Add the sliced vegetables, ginger, garlic, and black pepper to the pot. Sauté until soft, 6-7 minutes.",
      "secondary_message": "⅜ tsp black pepper"
    },
    {
      "id": 145121,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise. ",
      "secondary_message": null
    },
    {
      "id": 145122,
      "primary_message": "Add the cabbage to the pot. Cook, stirring occasionally, until cabbage softens, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 145123,
      "primary_message": "Add the shrimp to the pot and cook, stirring occasionally, until lightly browned and cooked through, 2 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 145124,
      "primary_message": "Juice the limes into a small bowl. Add the cornstarch and whisk together. ",
      "secondary_message": "3 tbsp cornstarch"
    },
    {
      "id": 145125,
      "primary_message": "Juice the oranges into the pot; add broth, sugar, soy sauce, and fish sauce. Bring to a boil over high heat, then stir in the cornstarch mixture. Reduce heat to low, add rice noodles, and simmer, stirring occasionally, until slightly thickened, 3-4 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n⅓ cup brown sugar\n⅓ cup soy sauce\n3 tbsp fish sauce"
    },
    {
      "id": 145126,
      "primary_message": "Divide between bowls, garnish with remaining green onion, and enjoy! ",
      "secondary_message": null
    }
  ],
