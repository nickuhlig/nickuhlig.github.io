  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the stems and seeds from the tomatoes, then chop them. Thinly slice the red onion. Remove the pits from the Kalamata olives, then cut them in half. Crumble the feta cheese.",
      "secondary_message": "2 large tomatoes\n½ medium red onion\n1 cup Kalamata olives\n57 g feta cheese"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk together 1 tablespoon of the olive oil and 1 tablespoon of the lemon juice. Add tomatoes, cucumber, red onion, and olives, and toss until combined. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium-sized bowl, whisk together 2 tablespoons of the olive oil, the yogurt, and the remaining 1 tablespoon of lemon juice. Stir in the crumbled feta. If necessary, season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Season the lamb loin chops with salt and pepper on both sides. Heat remaining tablespoon oil in a 30-cm stainless steel skillet over medium-high heat until shimmering. Add the chops. Cook without moving until brown crust develops, about 3 minutes. Carefully flip and cook until medium-rare, about 3 minutes longer. Transfer chops to a plate and allow to rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Using a slotted spoon, divide the Greek salad between four plates, leaving as much of the liquid behind as possible. Add a lamb loin chop to each plate and drizzle with the yogurt-lemon sauce. Serve with more of the yogurt-lemon sauce.",
      "secondary_message": null
    }
  ],
