  "instructions": [
    {
      "id": 325224,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 325225,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 325226,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n½ lemon\n½ small pkg fresh mint\n1 mango"
    },
    {
      "id": 325227,
      "primary_message": "Place spices in a medium bowl and stir to combine the spice mix.",
      "secondary_message": "2 tsp curry powder\n½ tsp salt\n½ tsp black pepper\n1 pinch cayenne pepper"
    },
    {
      "id": 325228,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Transfer to another baking sheet, drizzle with oil, and season with half of the spice mixture; toss to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 325229,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 325230,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325231,
      "primary_message": "While the skillet heats up, medium dice tofu and add to the bowl with the remaining spice mix; toss to coat.",
      "secondary_message": null
    },
    {
      "id": 325232,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning every few minutes, until golden brown and crispy, about 8 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 325233,
      "primary_message": "While the tofu cooks, peel and mince garlic; place in the reserved bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 325234,
      "primary_message": "Zest and juice lemon into the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 325235,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt and salt; stir to combine the raita and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n⅛ tsp salt"
    },
    {
      "id": 325236,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice.",
      "secondary_message": null
    },
    {
      "id": 325237,
      "primary_message": "Roughly chop cashews. ",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 325238,
      "primary_message": "To serve, divide the zucchini noodles, tofu, and mango between bowls; top with mint raita and cashews. Enjoy!",
      "secondary_message": null
    }
  ],
