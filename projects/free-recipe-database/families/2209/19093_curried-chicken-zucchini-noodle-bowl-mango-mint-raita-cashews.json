  "instructions": [
    {
      "id": 325041,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 325042,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n1 ½ lemons\n1 small pkg fresh mint\n3 mangoes"
    },
    {
      "id": 325043,
      "primary_message": "Place spices in a small bowl and stir to combine the spice mix.",
      "secondary_message": "2 tbsp curry powder\n1 ½ tsp salt\n1 ½ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 325044,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Divide between two baking sheet pans, drizzle with oil, and season with half of the spice mix; toss to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 325045,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 325046,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325047,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with remaining spice mix (reserve bowl for later use).",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 325048,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove chicken to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 325049,
      "primary_message": "While the chicken is cooking, using a clean cutting board, peel and mince garlic; place in the reserved bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 325050,
      "primary_message": "Zest and juice lemons into the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 325051,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt and salt; stir to combine the raita and set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 325052,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice.",
      "secondary_message": null
    },
    {
      "id": 325053,
      "primary_message": "Roughly chop cashews. ",
      "secondary_message": "1 cup cashews, roasted unsalted"
    },
    {
      "id": 325054,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 325055,
      "primary_message": "To serve, divide the zucchini noodles, chicken, and mango between bowls; top with mint raita and cashews. Enjoy!",
      "secondary_message": null
    }
  ],
