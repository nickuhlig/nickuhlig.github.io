  "instructions": [
    {
      "id": 325164,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 325165,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n½ lemon\n½ small pkg fresh mint\n1 mango"
    },
    {
      "id": 325166,
      "primary_message": "Place spices in a small bowl and stir to combine the spice mix.",
      "secondary_message": "2 tsp curry powder\n½ tsp salt\n½ tsp black pepper\n1 pinch cayenne pepper"
    },
    {
      "id": 325167,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Transfer to a baking sheet pan, drizzle with oil, and season with half of the spice mix; toss to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 325168,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 325169,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325170,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with remaining spice mix (reserve bowl for later use).",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 325171,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove chicken to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 325172,
      "primary_message": "While the chicken is cooking, using a clean cutting board, peel and mince garlic; place in the reserved bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 325173,
      "primary_message": "Zest and juice lemon into the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 325174,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt and salt; stir to combine the raita and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n⅛ tsp salt"
    },
    {
      "id": 325175,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice.",
      "secondary_message": null
    },
    {
      "id": 325176,
      "primary_message": "Roughly chop cashews. ",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 325177,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 325178,
      "primary_message": "To serve, divide the zucchini noodles, chicken, and mango between bowls; top with mint raita and cashews. Enjoy!",
      "secondary_message": null
    }
  ],
