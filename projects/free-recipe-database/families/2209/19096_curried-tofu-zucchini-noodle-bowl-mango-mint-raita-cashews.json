  "instructions": [
    {
      "id": 325149,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 325150,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 325151,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n1 ½ lemons\n1 small pkg fresh mint\n3 mangoes"
    },
    {
      "id": 325152,
      "primary_message": "Place spices in a large bowl and stir to combine the spice mix.",
      "secondary_message": "2 tbsp curry powder\n1 ½ tsp salt\n1 ½ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 325153,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Divide between two additional baking sheets, drizzle with oil, and season with half of the spice mixture; toss to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 325154,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 325155,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325156,
      "primary_message": "While the skillet heats up, medium dice tofu and add to the bowl with the remaining spice mix; toss to coat.",
      "secondary_message": null
    },
    {
      "id": 325157,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, turning every few minutes, until golden brown and crispy, about 8 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 325158,
      "primary_message": "While the tofu cooks, peel and mince garlic; place in the reserved bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 325159,
      "primary_message": "Zest and juice lemons into the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 325160,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt and salt; stir to combine the raita and set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 325161,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice.",
      "secondary_message": null
    },
    {
      "id": 325162,
      "primary_message": "Roughly chop cashews. ",
      "secondary_message": "1 cup cashews, roasted unsalted"
    },
    {
      "id": 325163,
      "primary_message": "To serve, divide the zucchini noodles, tofu, and mango between bowls; top with mint raita and cashews. Enjoy!",
      "secondary_message": null
    }
  ],
