  "instructions": [
    {
      "id": 424287,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 424288,
      "primary_message": "Wash, dry, trim, and medium dice zucchini. Divide between two baking sheet pans. ",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 424289,
      "primary_message": "Peel, halve, and slice onions lengthwise into thin pieces. Add to the baking sheets with the zucchini.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 424290,
      "primary_message": "Drain and roughly chop roasted peppers, then add to the baking sheets. Drizzle veggies with oil and season with spices; stir to combine and spread out in an even layer. ",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers\n3 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 424291,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until zucchini are golden and fork-tender, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 424292,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "765 g cheese tortellini, fresh or frozen"
    },
    {
      "id": 424293,
      "primary_message": "When the tortellini is done, drain and return to the pot. Cover and set aside to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 424294,
      "primary_message": "When the veggies are done, remove from the oven. Add roasted veggies and pesto to the pot with the tortellini; stir to combine.",
      "secondary_message": "1 cup basil pesto"
    },
    {
      "id": 424295,
      "primary_message": "To serve, divide pasta between plates or bowls and top with Parmesan. Enjoy!",
      "secondary_message": "¾ cup Parmesan cheese, shredded"
    }
  ],
