  "instructions": [
    {
      "primary_message": "Wash, dry, and chop chives into small pieces. Place in a small bowl along with sour cream, mayo, horseradish, Worcestershire, salt, and pepper. Whisk to combine the horseradish sauce and refrigerate until ready to serve.",
      "secondary_message": "½ small pkg chives\n½ cup sour cream\n⅓ cup mayonnaise\n¼ cup horseradish, prepared\n2 tsp Worcestershire sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Cut blue cheese into ¼-inch thick slices. ",
      "secondary_message": "1 (4 oz) block blue cheese"
    },
    {
      "primary_message": "Arrange half of the bread slices on a baking sheet pan, then layer with blue cheese, roast beef, and mozzarella. Season with salt and pepper, then close sandwiches with remaining bread slices. ",
      "secondary_message": "8 slice rye bread\n16 oz deli roast beef, sliced\n8 slice mozzarella cheese, sliced\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Preheat an outdoor grill or grill pan over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the grill heats up, spread mayo on the top side of the sandwiches.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "primary_message": "Once the grill is hot, add sandwiches, mayo-side down, and grill until bottoms are golden, 2-4 minutes. (Reserve baking sheet for the next step.)",
      "secondary_message": null
    },
    {
      "primary_message": "Remove sandwiches to the baking sheet, grilled-side down, and spread the other side with additional mayo. Return sandwiches, mayo-side down, to the grill and continue to cook until golden on the other side and cheese is melted, 2-4 minutes more. Transfer to a cutting board.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "primary_message": "Slice sandwiches in half and divide between plates. Serve with horseradish sauce for dipping and enjoy!",
      "secondary_message": null
    }
  ],
