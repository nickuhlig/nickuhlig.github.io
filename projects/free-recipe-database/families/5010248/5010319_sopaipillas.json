  "instructions": [
    {
      "id": 1,
      "primary_message": "Place all the dry ingredients in a bowl and cut in the lard with a fork, until there are only small flakes of in the flour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Dissolve the yeast in warm water; add the sugar and set aside for 5 minutes. Add the yeast to the cooled scalded milk.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the liquid to the dry ingredients. Mix to form a shaggy but not too wet dough. Knead the dough for 7 to 10 minutes, until it's smooth and fairly elastic. Cover with a tea towel and let rest for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In the meantime, heat the rendered lard in a wok or frying skillet, until the candy thermometer register 149°C to 177°C.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Roll the dough out to a 0.5-cm thickness and cut into 8-cm squares. Slip the squares of dough into the lard, two at a time, not flipping until after the squares puff out. Fry on both sides, flipping only as needed for 1 to 2 minutes. Drain on paper towels. Serve warm with honey and preserves.",
      "secondary_message": null
    }
  ],
