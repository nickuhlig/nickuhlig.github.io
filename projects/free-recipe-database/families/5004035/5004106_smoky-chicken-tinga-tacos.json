  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Smash and peel the garlic.",
      "secondary_message": "2 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a Dutch oven or large pot over medium-high heat until shimmering. Add chicken thighs skin-side down and cook until well browned, about 6 minutes. Flip thighs and continue to cook until other side is lightly browned, about 3 minutes. Transfer chicken to a plate, leaving fat in pan, and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add onions and garlic to Dutch oven and cook, stirring occasionally, until onions have browned around the edges, about 5 minutes. Add tomatillo and cook until browned around the edges, about 4 minutes. Add oregano and cumin and cook until fragrant, about 30 seconds. Add tomatoes, chipotle, and adobo sauce and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer sauce to the jar of a blender and purée until smooth. Pour sauce back into pan, stir in chicken stock and bay leaf, and bring to a boil over medium heat. Nestle chicken thighs in sauce, reduce to a simmer, and cook until meat registers 74°C in thickest part of thigh on an instant-read thermometer. Transfer chicken to a plate and let sit until cool enough to handle. Remove sauce from heat and discard bay leaf.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pull chicken meat into strips, discarding skin, any large pieces of fat, and bones. Stir chicken into sauce and cook over medium heat until warmed through, about 3 minutes. Remove from heat and season with salt to taste.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spoon chicken into warm tortillas and top with tomatillo salsa, onion, cilantro, and cotija cheese. Serve with lime wedges.",
      "secondary_message": null
    }
  ],
