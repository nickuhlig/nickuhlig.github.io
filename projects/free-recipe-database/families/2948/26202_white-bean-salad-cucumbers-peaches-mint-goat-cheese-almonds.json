  "instructions": [
    {
      "id": 417214,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 hearts romaine hearts\n1 ½ English cucumbers\n3 peaches\n1 small pkg fresh mint"
    },
    {
      "id": 417215,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 417216,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 417217,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into thin wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 417218,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 417219,
      "primary_message": "Crumble goat cheese into the bowl.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 417220,
      "primary_message": "Drain and rinse beans in the colander. Add to the bowl along with almonds, vinaigrette, salt, and pepper. Toss to combine the salad.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans\n1 cup almonds, sliced\n1 cup French vinaigrette\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 417221,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
