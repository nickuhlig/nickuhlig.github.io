  "instructions": [
    {
      "id": 417190,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 hearts romaine hearts\n1 ½ English cucumbers\n3 peaches\n1 small pkg fresh mint"
    },
    {
      "id": 417191,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 417192,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 417193,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into thin wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 417194,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 417195,
      "primary_message": "Place chickens on the cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and add to the bowl.",
      "secondary_message": "1 ½ (850 g) whole chickens rotisserie chicken, white and dark meat"
    },
    {
      "id": 417196,
      "primary_message": "Crumble goat cheese into the bowl. Add almonds, vinaigrette, salt, and pepper, then toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) logs goat cheese\n1 cup almonds, sliced\n1 cup French vinaigrette\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 417197,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
