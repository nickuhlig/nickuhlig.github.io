  "instructions": [
    {
      "id": 1,
      "primary_message": "Mix all the ingredients for the sauce in a small bowl until the sugar has dissolved.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, gently combine the ground chuck with the rest of the filling ingredients.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Shape a tablespoon of the filling into a small log. Wrap 1 basil leaf around the beef and thread onto a skewer. Repeat until all of the filling is gone.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly over the charcoal grate.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Clean and oil the cooking grate. Grill the rolls until the filling is fully cooked and slightly firm, about 6 to 8 minutes, turning once during cooking. Serve immediately with the dipping sauce.",
      "secondary_message": null
    }
  ],
