  "instructions": [
    {
      "id": 1,
      "primary_message": "If using a mortar and pestle or spice grinder, crush or pulse whole toasted sesame seeds until pulverized; the mortar and pestle will create a more coarse final texture and the spice grinder will create a finer one. If using a small food processor, pulse whole toasted seeds with 1/3 cup honey until finely ground, about 5 minutes. Alternatively, if using pre-ground black sesame seeds (see note), proceed to Step 2.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add milk to a medium saucepan and sprinkle powdered gelatin evenly on top. Let stand for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Warm milk over low heat, stirring constantly, until gelatin dissolves.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Stir in crushed black sesame seeds and honey (if you used the small food processor, the seeds and honey will already be combined).",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Remove from heat and whisk in heavy cream.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Divide pudding base into 6 ramekins or dessert glasses. Cover glasses with plastic wrap and refrigerate until set, at least 2 hours or overnight.",
      "secondary_message": null
    }
  ],
