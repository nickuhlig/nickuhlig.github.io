  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust an oven rack to the middle position and preheat the oven to 205°C (400°F). In large skillet combine fennel, cream, and water. Season with salt and pepper. In a large bowl, mix together the breadcrumbs, Pecorino Romano, parsley, olive oil, and salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring the fennel mixture to a simmer over high heat, stirring frequently, then transfer to a 2-quart oval casserole dish. Top the fennel with the breadcrumb mixture and place on a foil-lined rimmed baking sheet. Bake until the topping is golden and crisp, about 30 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
