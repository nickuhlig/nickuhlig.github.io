  "instructions": [
    {
      "id": 1,
      "primary_message": "Add sugar and lemon juice to a cocktail shaker and stir to dissolve (if using simple syrup, skip this step).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add whiskey to lemon/sugar mixture and fill cocktail shaker with ice.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Shake well for 10 seconds, and strain into either an ice-filled rocks glass or a chilled cocktail glass. Add splash of club soda (optional).",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Carefully pour the red wine over the back of a bar spoon so it forms a layer atop the drink.",
      "secondary_message": null
    }
