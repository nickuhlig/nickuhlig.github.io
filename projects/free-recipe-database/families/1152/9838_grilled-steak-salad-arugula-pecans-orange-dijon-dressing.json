  "instructions": [
    {
      "id": 156898,
      "primary_message": "Preheat a large grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 156899,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 156900,
      "primary_message": "Coat bottom of grill pan or skillet with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 156901,
      "primary_message": "Meanwhile, wash, zest, and juice half of the oranges into a large bowl. Cut off the skin and white pith from the remaining oranges; cut between the membranes to release the segments and set aside.",
      "secondary_message": "3 oranges"
    },
    {
      "id": 156902,
      "primary_message": "Peel and mince garlic; add to the bowl with the orange juice and zest. Add vinegar, oil, honey, Dijon, and spices; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp white wine vinegar\n3 tbsp extra virgin olive oil\n1 tbsp honey\n1 tbsp Dijon mustard\n¾ tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 156903,
      "primary_message": "Peel and thinly slice the shallots; add to the bowl with the dressing and toss to combine.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 156904,
      "primary_message": "Roughly chop the pecans.",
      "secondary_message": "¾ cup pecans, dry roasted"
    },
    {
      "id": 156905,
      "primary_message": "Wash arugula (skip if it came pre-washed) and add to the bowl with the dressing and onions; toss to combine the salad.",
      "secondary_message": "3 (5 oz) pkgs baby arugula"
    },
    {
      "id": 156906,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 156907,
      "primary_message": "To serve, divide salad between plates or bowls. Top with pecans, orange segments, and steak. Enjoy!",
      "secondary_message": null
    }
  ],
