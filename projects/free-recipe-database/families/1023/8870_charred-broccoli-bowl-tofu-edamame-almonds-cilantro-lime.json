  "instructions": [
    {
      "id": 149431,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 149432,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 149433,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n1 lime\n1 (1 inch) piece ginger root\n½ small bunch cilantro"
    },
    {
      "id": 149434,
      "primary_message": "Separate broccoli crowns into bite-sized florets and cut stems into smaller pieces; place in a large bowl. Add oil, salt, and pepper and toss to combine; transfer to a baking sheet and spread out in a single, even layer. Reserve bowl for later use.",
      "secondary_message": "1 tbsp toasted sesame oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 149435,
      "primary_message": "Place broccoli in the oven and broil, turning halfway through, until broccoli is crisp-tender and lightly charred around the edges, 12-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 149436,
      "primary_message": "Meanwhile, zest the lime into the a large bowl, then juice half of the lime into the same bowl. Cut remaining lime into wedges and set aside. ",
      "secondary_message": null
    },
    {
      "id": 149437,
      "primary_message": "Peel and mince the shallot and garlic. Peel and grate or mince the ginger; transfer everything to the bowl with the lime juice. ",
      "secondary_message": "½ shallot\n1 clove garlic"
    },
    {
      "id": 149438,
      "primary_message": "Add soy sauce, chili-garlic sauce, and sugar to the bowl and whisk to combine the sauce. ",
      "secondary_message": "2 tsp soy sauce\n½ tsp chili-garlic sauce\n1 tsp brown sugar"
    },
    {
      "id": 149439,
      "primary_message": "When the broccoli is done cooking, remove from the oven and transfer to the bowl with the sauce; stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 149440,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 149441,
      "primary_message": "Large dice tofu (cut into 2-cm cubes) and place in a medium bowl. Add cornstarch, salt, and pepper to the bowl and gently toss to coat the tofu. ",
      "secondary_message": "1 tbsp cornstarch\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 149442,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tofu in a single layer and cook, flipping every 1-2 minutes with a spatula, until golden and cooked through, 7-8 minutes. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 149443,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the broccoli. ",
      "secondary_message": null
    },
    {
      "id": 149444,
      "primary_message": "Add edamame to the skillet with the tofu and continue to cook, stirring often, until edamame is cooked through, 2-3 minutes. Transfer tofu-edamame mixture to the bowl with the broccoli; toss to combine. ",
      "secondary_message": "1 cup edamame"
    },
    {
      "id": 149445,
      "primary_message": "To serve, divide the broccoli mixture between bowls or plates; top with almonds and garnish with lime wedges. Enjoy! ",
      "secondary_message": "¼ cup almonds, sliced"
    }
  ],
