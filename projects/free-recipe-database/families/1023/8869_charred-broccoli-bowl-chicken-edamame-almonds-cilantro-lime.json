  "instructions": [
    {
      "id": 149417,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 149418,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 crowns broccoli\n3 limes\n3 (1 inch) pieces ginger root\n1 ½ small bunches cilantro"
    },
    {
      "id": 149419,
      "primary_message": "Separate broccoli crowns into bite-sized florets and cut stems into smaller pieces; place in a large bowl. Add oil, salt, and pepper, and toss to combine; transfer to one large or two medium baking sheets and spread out in a single, even layer. Reserve bowl for later use.",
      "secondary_message": "3 tbsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 149420,
      "primary_message": "Cooking in batches if necessary, Place broccoli (one baking sheet at a time) in the oven and broil, turning halfway through, until broccoli is crisp-tender and lightly charred around the edges, 12-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 149421,
      "primary_message": "Meanwhile, zest the limes into the large bowl, then juice half of the limes into the same bowl. Cut remaining limes into wedges and set aside. ",
      "secondary_message": null
    },
    {
      "id": 149422,
      "primary_message": "Peel and mince shallots and garlic. Peel and grate or mince the ginger; transfer everything to the bowl with the lime juice.",
      "secondary_message": "1 ½ shallots\n3 cloves garlic"
    },
    {
      "id": 149423,
      "primary_message": "Add fish sauce, soy sauce, chili-garlic sauce, and sugar to the bowl and whisk to combine the sauce. ",
      "secondary_message": "1 ½ tsp fish sauce\n1 ½ tbsp soy sauce\n1 ½ tsp chili-garlic sauce\n1 tbsp brown sugar"
    },
    {
      "id": 149424,
      "primary_message": "When the broccoli is done cooking, remove from the oven and transfer to the bowl with the sauce; stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 149425,
      "primary_message": "Cut chicken into bite-sized pieces and place in another large bowl. Add cornstarch, salt, and pepper to the bowl and gently toss to coat the chicken. ",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n3 tbsp cornstarch\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 149426,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 149427,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.  Working in batches if necessary, add the chicken in a single layer, and cook, stirring often, until golden and cooked through, 8-9 minutes. Transfer to the bowl with the broccoli.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 149428,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the broccoli. ",
      "secondary_message": null
    },
    {
      "id": 149429,
      "primary_message": "When the chicken is done cooking, add edamame to the skillet and cook, stirring often, until cooked through, about 2 minutes. Transfer to the bowl with the broccoli, making sure to scrape all of the cooking juices into the bowl; toss to combine. ",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 149430,
      "primary_message": "To serve, divide the broccoli mixture between bowls or plates; top with almonds and garnish with lime wedges. Enjoy! ",
      "secondary_message": "¾ cup almonds, sliced"
    }
  ],
