  "instructions": [
    {
      "id": 149389,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 149390,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n1 lime\n1 (1 inch) piece ginger root\n½ small bunch cilantro"
    },
    {
      "id": 149391,
      "primary_message": "Separate broccoli crowns into bite-sized florets and cut stems into smaller pieces; place in a large bowl. Add oil, salt, and pepper, and toss to combine; transfer to a baking sheet and spread out in a single, even layer. Reserve bowl for later use.",
      "secondary_message": "1 tbsp toasted sesame oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 149392,
      "primary_message": "Place broccoli in the oven and broil, turning halfway through, until broccoli is crisp-tender and lightly charred around the edges, 12-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 149393,
      "primary_message": "Meanwhile, zest the lime into the large bowl, then juice half the lime into the same bowl. Cut remaining lime into wedges and set aside. ",
      "secondary_message": null
    },
    {
      "id": 149394,
      "primary_message": "Peel and mince the shallot and garlic. Peel and grate or mince the ginger; transfer everything to the bowl with the lime juice.",
      "secondary_message": "½ shallot\n1 clove garlic"
    },
    {
      "id": 149395,
      "primary_message": "Add fish sauce, soy sauce, chili-garlic sauce, and sugar to the bowl and whisk to combine the sauce. ",
      "secondary_message": "½ tsp fish sauce\n1 ½ tsp soy sauce\n½ tsp chili-garlic sauce\n1 tsp brown sugar"
    },
    {
      "id": 149396,
      "primary_message": "When the broccoli is done cooking, remove from the oven and transfer to the bowl with the sauce; stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 149397,
      "primary_message": "Cut chicken into bite-sized pieces and place in a medium bowl. Add cornstarch, salt, and pepper to the bowl and gently toss to coat the chicken. ",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n1 tbsp cornstarch\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 149398,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 149399,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the chicken and cook, stirring often, until golden and almost cooked through, 5-6 minutes. ",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 149400,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the broccoli. ",
      "secondary_message": null
    },
    {
      "id": 149401,
      "primary_message": "Add edamame to the skillet with the chicken and continue to cook, stirring often, until chicken and edamame are cooked through, 2-3 minutes. Transfer to the bowl with the broccoli, making sure to scrape all of the chicken juices into the bowl; toss to combine. ",
      "secondary_message": "1 cup edamame"
    },
    {
      "id": 149402,
      "primary_message": "To serve, divide the broccoli mixture between bowls or plates; top with almonds and garnish with lime wedges. Enjoy! ",
      "secondary_message": "¼ cup almonds, sliced"
    }
  ],
