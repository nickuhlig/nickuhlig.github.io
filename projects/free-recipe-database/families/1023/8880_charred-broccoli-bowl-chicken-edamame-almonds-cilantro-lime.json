  "instructions": [
    {
      "id": 149577,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 149578,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 crowns broccoli\n2 limes\n2 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 149579,
      "primary_message": "Separate broccoli crowns into bite-sized florets and cut stems into smaller pieces; place in a large bowl. Add oil, salt, and pepper, and toss to combine; transfer to a large baking sheet and spread out in a single, even layer. Reserve bowl for later use.",
      "secondary_message": "2 tbsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 149580,
      "primary_message": "Place broccoli in the oven and broil, turning halfway through, until broccoli is crisp-tender and lightly charred around the edges, 12-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 149581,
      "primary_message": "Meanwhile, zest the limes into the large bowl, then juice one of the limes into the same bowl. Cut the other lime into wedges and set aside. ",
      "secondary_message": null
    },
    {
      "id": 149582,
      "primary_message": "Peel and mince the shallot and garlic. Peel and grate or mince the ginger; transfer everything to the bowl with the lime juice.",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 149583,
      "primary_message": "Add fish sauce, soy sauce, chili-garlic sauce, and sugar to the bowl and whisk to combine the sauce. ",
      "secondary_message": "1 tsp fish sauce\n1 tbsp soy sauce\n1 tsp chili-garlic sauce\n2 tsp brown sugar"
    },
    {
      "id": 149584,
      "primary_message": "When the broccoli is done cooking, remove from the oven and transfer to the bowl with the sauce; stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 149585,
      "primary_message": "Cut chicken into bite-sized pieces and place in a medium bowl. Add cornstarch, salt, and pepper to the bowl and gently toss to coat the chicken. ",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n2 tbsp cornstarch\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 149586,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 149587,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.  Working in batches if necessary, add the chicken in a single layer, and cook, stirring often, until golden and cooked through, 8-9 minutes. Transfer to the bowl with the broccoli.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 149588,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the broccoli. ",
      "secondary_message": null
    },
    {
      "id": 149589,
      "primary_message": "When the chicken is done cooking, add edamame to the skillet and cook, stirring often, until cooked through, about 2 minutes. Transfer to the bowl with the broccoli, making sure to scrape all of the cooking juices into the bowl; toss to combine. ",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 149590,
      "primary_message": "To serve, divide the broccoli mixture between bowls or plates; top with almonds and garnish with lime wedges. Enjoy! ",
      "secondary_message": "½ cup almonds, sliced"
    }
  ],
