  "instructions": [
    {
      "id": 1,
      "primary_message": "In a wide skillet, melt the butter over medium-low heat. Add the shallot, and sauté until soft and fragrant, about 1 minute. Add the ham, season with salt and pepper, and sauté 1 minute more. Add the peas and the water, lower the heat to low, and cook covered for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the cream, and adjust the seasoning as needed. Allow to continue cooking, uncovered, another 2 to 3 minutes, until the sauce has thickened around the peas. Stir in the chervil, extra fresh pepper, and serve right away.",
      "secondary_message": null
    }
  ],
