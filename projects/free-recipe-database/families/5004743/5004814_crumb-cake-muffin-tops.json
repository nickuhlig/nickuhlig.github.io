  "instructions": [
    {
      "id": 1,
      "primary_message": "For the cake: Adjust rack to middle position and preheat oven to 175°C (350°F). Grease muffin top pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk sugar, salt, melted butter, and oil in a large bowl. Whisk in egg, milk, sour cream, and vanilla. In a separate bowl, stir together flour, baking powder, and baking soda. Stir into wet mixture until just combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the crumb topping: Whisk flour, brown sugar, cinnamon, and salt in a large bowl until combined. Add melted butter and vanilla, and toss with fingers until mixture forms moist crumbs.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spoon 2 tablespoons batter into each muffin top cup and spread evenly (see notes). Sprinkle with 1/2 of crumb mixture. Bake until light golden and cakes are just firm, about 15 minutes. Let cakes cool in pan 5 minutes, then transfer to wire rack to cool. Repeat with remaining batter and crumbs.",
      "secondary_message": null
    }
  ],
