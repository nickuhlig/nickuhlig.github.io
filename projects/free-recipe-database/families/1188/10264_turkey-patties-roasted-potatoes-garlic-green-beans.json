  "instructions": [
    {
      "id": 170209,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 170210,
      "primary_message": "Wash, dry, and quarter potatoes. Place on one half of a baking sheet pan, drizzle with oil, and season with salt and pepper. Place in the oven (it doesn't have to be fully heated) and bake for 15 minutes.",
      "secondary_message": "0.23 kg new potatoes\n2 tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 170211,
      "primary_message": "Wash, trim, and mince green onions. Peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 clove garlic"
    },
    {
      "id": 170212,
      "primary_message": "Add turkey, salt, and pepper to the bowl with the onion and garlic; mix until well combined.",
      "secondary_message": "⅓ kg ground turkey\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 170213,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 170214,
      "primary_message": "Place almond meal on a plate. Using a ¼ cup measure, portion and form the turkey mixture into ½-inch thick patties and add to the plate. Dredge patties to coat, pressing gently to adhere.",
      "secondary_message": "⅓ cup almond meal/flour"
    },
    {
      "id": 170215,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 170216,
      "primary_message": "Add turkey patties and cook, turning once, until golden and almost cooked through, about 3 minutes per side. Transfer to another baking sheet pan and place in the oven; bake until cooked through, 8 minutes more.",
      "secondary_message": null
    },
    {
      "id": 170217,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a medium bowl along with the oil, salt, and pepper.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 170218,
      "primary_message": "Wash, dry, and trim beans. Add to the bowl with the garlic oil and toss to coat.",
      "secondary_message": "0.23 kg green beans"
    },
    {
      "id": 170219,
      "primary_message": "Remove the first baking sheet pan from the oven and toss the potatoes. Add beans and return to the oven. Bake until veggies are fork-tender, stirring once, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 170220,
      "primary_message": "To serve, divide turkey patties, potatoes, and beans between plates. Enjoy!",
      "secondary_message": null
    }
  ],
