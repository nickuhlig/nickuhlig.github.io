  "instructions": [
    {
      "id": 170233,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 170234,
      "primary_message": "Wash, dry, and quarter potatoes. Place on one half of a large baking sheet pan, drizzle with oil, and season with salt and pepper. Place in the oven (it doesn't have to be fully heated) and bake for 15 minutes.",
      "secondary_message": "0.68 kg new potatoes\n2 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 170235,
      "primary_message": "Wash, trim, and mince green onions. Peel and mince garlic. Place both in a large bowl.",
      "secondary_message": "1 ½ small bunches green onions (scallions)\n3 cloves garlic"
    },
    {
      "id": 170236,
      "primary_message": "Add turkey, salt, and pepper to the bowl with the onion and garlic; mix until well combined.",
      "secondary_message": "1.02 kg ground turkey\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 170237,
      "primary_message": "Place almond meal on a plate. Using a ¼ cup measure, portion and form the turkey mixture into ½-inch thick patties and add to the plate. Dredge patties to coat, pressing gently to adhere.",
      "secondary_message": "1 cup almond meal/flour"
    },
    {
      "id": 170238,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 170239,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 170240,
      "primary_message": "Working in batches, adding additional oil as needed, add turkey patties and cook, turning once, until golden and almost cooked through, about 3 minutes per side. Transfer to another large baking sheet pan and place in the oven; bake until cooked through, 8-10 minutes more.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 170241,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a large bowl along with the oil, salt, and pepper.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 170242,
      "primary_message": "Wash, dry, and trim beans. Add to the bowl with the garlic oil and toss to coat.",
      "secondary_message": "0.68 kg green beans"
    },
    {
      "id": 170243,
      "primary_message": "Remove the first baking sheet pan from the oven and toss the potatoes. Add beans and return to the oven. Bake until veggies are fork-tender, stirring once, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 170244,
      "primary_message": "To serve, divide turkey patties, potatoes, and beans between plates. Enjoy!",
      "secondary_message": null
    }
  ],
