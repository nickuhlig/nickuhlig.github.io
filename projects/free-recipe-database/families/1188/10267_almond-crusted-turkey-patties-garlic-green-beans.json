  "instructions": [
    {
      "id": 170245,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 170246,
      "primary_message": "Wash, trim, and mince green onions. Peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 clove garlic"
    },
    {
      "id": 170247,
      "primary_message": "Add turkey, salt, and pepper to the bowl with the onion and garlic; mix until well combined.",
      "secondary_message": "⅓ kg ground turkey\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 170248,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 170249,
      "primary_message": "Place almond meal on a plate. Using a ¼ cup measure, portion and form the turkey mixture into ½-inch thick patties and add to the plate. Dredge patties to coat, pressing gently to adhere.",
      "secondary_message": "½ cup almond meal/flour"
    },
    {
      "id": 170250,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 170251,
      "primary_message": "Working in batches if necessary, add turkey patties and cook, turning once, until golden and almost cooked through, about 3 minutes per side. Transfer to a baking sheet pan and place in the oven; bake until cooked through, 8 minutes more.",
      "secondary_message": null
    },
    {
      "id": 170252,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a medium bowl along with the oil, salt, and pepper.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 170253,
      "primary_message": "Wash, dry, and trim beans. Add to the bowl with the garlic oil, toss to coat, and place on a second baking sheet pan. ",
      "secondary_message": "0.23 kg green beans"
    },
    {
      "id": 170254,
      "primary_message": "Place beans in the oven and bake until fork-tender, stirring once, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 170255,
      "primary_message": "To serve, divide turkey patties and beans between plates. Enjoy!",
      "secondary_message": null
    }
  ],
