  "instructions": [
    {
      "id": 1,
      "primary_message": "Add Old Tom gin, lemon, grenadine, and simple syrup to cocktail shaker and fill 2/3 full with ice. Shake until well chilled, about 20 seconds. Add seltzer to shaker and stir very gently to mix.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Fill a julep cup or rocks glass with cracked ice. Strain cocktail into cup. Garnish with mint and berries and serve immediately.",
      "secondary_message": null
    }
  ],
