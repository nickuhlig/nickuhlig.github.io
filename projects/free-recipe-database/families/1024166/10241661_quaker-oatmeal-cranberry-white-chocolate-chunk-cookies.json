  "instructions": [
    {
      "primary_message": "Heat oven to 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "In a medium bowl, beat butter and sugar with a hand mixer until light and fluffy.",
      "secondary_message": null
    },
    {
      "primary_message": "Add eggs to the butter and sugar, beating well until combined.",
      "secondary_message": null
    },
    {
      "primary_message": "Add oats, flour, baking soda and salt in a separate bowl; whisk to combine.",
      "secondary_message": null
    },
    {
      "primary_message": "Add dry ingredients to the butter mixture in several additions, mixing well after each addition.",
      "secondary_message": null
    },
    {
      "primary_message": "Stir in dried cranberries and white chocolate chips (or chunks) to create the cookie dough.",
      "secondary_message": null
    },
    {
      "primary_message": "Drop the cookie dough by rounded teaspoonfuls onto an ungreased cookie sheets.",
      "secondary_message": null
    },
    {
      "primary_message": "Bake cookies 10 to 12 minutes or until golden brown. Remove from oven and transfer to wire rack. Let cookies cool completely.",
      "secondary_message": null
    },
    {
      "primary_message": "Store in a tightly covered container.",
      "secondary_message": null
    }
  ],
