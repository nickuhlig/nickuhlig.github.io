  "instructions": [
    {
      "id": 572836,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 572837,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ small pkg fresh mint\n4 plums"
    },
    {
      "id": 572838,
      "primary_message": "Zest and juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 572839,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon, along with honey, and stir to combine.",
      "secondary_message": "4 tsp honey"
    },
    {
      "id": 572840,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into thin slices, add to the bowl, and stir to combine. Set aside.",
      "secondary_message": null
    },
    {
      "id": 572841,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, 2-3 minutes. Remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 572842,
      "primary_message": "Meanwhile, roughly chop almonds.",
      "secondary_message": "¼ cup almonds"
    },
    {
      "id": 572843,
      "primary_message": "Spread cream cheese over the toast, then top with plums and almonds.",
      "secondary_message": "⅔ (8 oz) block cream cheese"
    },
    {
      "id": 572844,
      "primary_message": "To serve, divide toasts between plates and enjoy!",
      "secondary_message": null
    }
  ],
