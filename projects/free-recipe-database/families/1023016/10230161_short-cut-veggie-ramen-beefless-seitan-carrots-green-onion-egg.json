  "instructions": [
    {
      "primary_message": "Place hot water (from the tap) in a large pot and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, using your hands, break seitan apart into bite-sized pieces.",
      "secondary_message": "1 (227 g) pkg seitan (seasoned wheat gluten)"
    },
    {
      "primary_message": "Once the water is boiling, add noodles, seitan, and carrots. Stir to combine the soup and cook, stirring occasionally, until noodles and carrots are soft, 3-4 minutes. Remove soup from heat, add flavor packets, and stir until combined.",
      "secondary_message": "2 (85 g) pkg instant ramen noodle soup, soy sauce flavor\n½ (283 g) bag shredded carrots"
    },
    {
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Halve eggs lengthwise.",
      "secondary_message": "½ small bunch green onion (scallion)"
    },
    {
      "primary_message": "To serve, divide soup and eggs between bowls. Top with green onions and enjoy!",
      "secondary_message": null
    }
  ],
