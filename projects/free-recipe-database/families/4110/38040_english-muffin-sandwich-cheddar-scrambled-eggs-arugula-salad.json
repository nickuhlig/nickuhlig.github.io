  "instructions": [
    {
      "id": 594562,
      "primary_message": "Place oil, vinegar, honey, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n1 ½ tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 594563,
      "primary_message": "Wash, dry, and halve grape tomatoes. Add to the bowl with the dressing and set aside.",
      "secondary_message": "1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 594564,
      "primary_message": "Coarsely grate cheddar. Place in a large bowl.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 594565,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 594566,
      "primary_message": "While the skillet heats up, add eggs, pepper, and salt to the bowl with the cheddar. Whisk to combine.",
      "secondary_message": "12 eggs\n¾ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 594567,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny, then remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 594568,
      "primary_message": "Split and toast muffins (if desired).",
      "secondary_message": "6 English muffins"
    },
    {
      "id": 594569,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl with the dressing (reserving a small handful for the sandwiches). Toss to combine the salad.",
      "secondary_message": "¾ (142 g) pkg baby arugula"
    },
    {
      "id": 594570,
      "primary_message": "Divide scrambled eggs and reserved arugula between one half of each muffin. Close sandwiches with the other half of each muffin.",
      "secondary_message": null
    },
    {
      "id": 594571,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
