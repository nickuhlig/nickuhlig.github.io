  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In medium bowl, combine cheese, sugar, and cinnamon; reserve. In second medium bowl, combine 2 tablespoons crema and cornstarch until cornstarch is dissolved. Stir in remaining crema; reserve.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "With chef’s knife or serrated knife, trim and discard extreme ends of sweet plantains. Score each one lengthwise.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove and discard peel. Slice sweet plantains on the bias into 1/2-inch thick slices.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Heat oil in large skillet over medium heat until shimmering. Arrange about 1/3 of sweet plantain slices in single layer and cook until softened and deep brown, turning carefully with spatula, about 3 minutes per side. Transfer to large plate and season with salt. Repeat with remaining sweet plantains.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Spread 1/2 cup crema in bottom of 8- by 8-inch baking dish. Arrange 1/3 of sweet plantains in single layer on top, then sprinkle 1/4 of cheese on top. Repeat procedure with remaining crema, cheese, and sweet plantains, finishing with cheese.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Bake until bubbling and browned on top, about 20 minutes. Transfer to cooling rack and allow to rest about 10 minutes before serving.",
      "secondary_message": null
    }
  ],
