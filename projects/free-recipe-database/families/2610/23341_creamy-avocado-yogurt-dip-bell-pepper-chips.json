  "instructions": [
    {
      "id": 383801,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n¼ small bunch cilantro\n1 avocado\n1 ½ red bell peppers"
    },
    {
      "id": 383802,
      "primary_message": "Juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 383803,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 383804,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and add to the bowl. Season with spices and mash with a fork or potato masher until smooth.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp onion powder\n⅛ tsp garlic powder"
    },
    {
      "id": 383805,
      "primary_message": "Add yogurt to the bowl and stir to combine the avocado-yogurt dip. Set aside.",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 383806,
      "primary_message": "Cut bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Slice each quarter crosswise into 3-4 pieces to make the \"chips.\"",
      "secondary_message": null
    },
    {
      "id": 383807,
      "primary_message": "To serve, divide dip and bell pepper \"chips\" between plates. Enjoy!",
      "secondary_message": null
    }
  ],
