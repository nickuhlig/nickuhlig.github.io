  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n1 lemon"
    },
    {
      "primary_message": "Finely grate the Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "primary_message": "Snap (or cut) off the woody ends of the asparagus. Transfer to a baking sheet. Drizzle with olive oil, season with the salt and pepper, and sprinkle with Parmesan cheese. Bake for 15 minutes.",
      "secondary_message": "extra virgin olive oil\nsalt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "While the asparagus cooks, pat the tilapia dry with paper towels and place on a plate.",
      "secondary_message": "¾ lb tilapia fillet"
    },
    {
      "primary_message": "In a medium bowl, add the flour.",
      "secondary_message": null
    },
    {
      "primary_message": "In a second bowl, add the egg and water; whisk until smooth.",
      "secondary_message": "1 egg"
    },
    {
      "primary_message": "In a third bowl, add the bread crumbs and salt. Stir to combine.",
      "secondary_message": "salt"
    },
    {
      "primary_message": "To coat the tilapia, dip each fillet into the flour, then the egg, and finally the bread crumbs. Press gently to adhere.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Add the fish to the skillet and cook until golden brown on each side, 3-4 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the asparagus is done, juice the lemon and pour the lemon juice over the asparagus.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide the fish and asparagus between plates. Enjoy!",
      "secondary_message": null
    }
  ],
