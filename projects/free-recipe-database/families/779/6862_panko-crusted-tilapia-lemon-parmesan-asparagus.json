  "instructions": [
    {
      "id": 115590,
      "primary_message": "Preheat oven to 400°F. Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 115591,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n2 lemons"
    },
    {
      "id": 115592,
      "primary_message": "Finely grate the Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 115593,
      "primary_message": "Snap (or cut) off the woody ends of the asparagus. Transfer to a baking sheet. Drizzle with olive oil, season with the salt and pepper, and sprinkle with Parmesan cheese. Bake for 15 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 115594,
      "primary_message": "While the asparagus cooks, pat the tilapia dry with paper towels and place on a plate.",
      "secondary_message": "1 ½ lb tilapia fillet"
    },
    {
      "id": 115595,
      "primary_message": "In a medium bowl, add the flour.",
      "secondary_message": "½ cup all-purpose flour"
    },
    {
      "id": 115596,
      "primary_message": "In a second bowl, add the eggs and water; whisk until smooth.",
      "secondary_message": "2 eggs\n2 tsp water"
    },
    {
      "id": 115597,
      "primary_message": "In a third bowl, add the bread crumbs and salt. Stir to combine.",
      "secondary_message": "2 cup panko bread crumbs\n½ tsp salt"
    },
    {
      "id": 115598,
      "primary_message": "To coat the tilapia, dip each fillet into the flour, then the egg, and finally the bread crumbs. Press gently to adhere.",
      "secondary_message": null
    },
    {
      "id": 115599,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 115600,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 115601,
      "primary_message": "Add the fish to the skillet and cook until golden brown on each side, 3-4 minutes per side. Once done, transfer to a plate. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 115602,
      "primary_message": "Once the asparagus is done, juice the lemons and pour the lemon juice over the asparagus.",
      "secondary_message": null
    },
    {
      "id": 115603,
      "primary_message": "To serve, divide the fish and asparagus between plates. Enjoy!",
      "secondary_message": null
    }
  ],
