  "instructions": [
    {
      "primary_message": "Using your hands (or the back of a knife), break cinnamon stick into pieces. Preheat a skillet over medium-low heat, then add the cinnamon pieces and toast until fragrant, 30-60 seconds. Transfer toasted cinnamon to a mixing glass.",
      "secondary_message": "1 cinnamon stick"
    },
    {
      "primary_message": "Wash, dry, and juice lime into the mixing glass with the cinnamon. Add 2 fl oz (1/4 cup) cranberry juice and 2 fl oz (1/4 cup) apple juice. Stir to combine and set aside.",
      "secondary_message": "1 lime\n59 ml cranberry juice\n59 ml apple juice"
    },
    {
      "primary_message": "Wash, dry, quarter, and core apple; thinly slice. Divide between two glasses of choice, then add ice. Set aside.",
      "secondary_message": "½ Gala apple\n⅔ cup ice cube"
    },
    {
      "primary_message": "Add 4 fl oz (1/2 cup) vodka and ice cubes to the mixing glass with the apple and cranberry juice. Stir until well chilled, 30-45 seconds. ",
      "secondary_message": "118 ml vodka\n⅔ cup ice cube"
    },
    {
      "primary_message": "Strain vodka mixture into the glasses with the apple. Top off glasses with 8 fl oz (1 cup) chilled ginger beer and gently stir to combine. Enjoy!",
      "secondary_message": "237 ml ginger beer"
    }
  ],
