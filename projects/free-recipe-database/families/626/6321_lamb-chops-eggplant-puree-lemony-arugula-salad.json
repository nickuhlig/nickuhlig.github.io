  "instructions": [
    {
      "id": 77068,
      "primary_message": "Preheat the oven to the broil setting and position the rack in the upper third of the oven.",
      "secondary_message": ""
    },
    {
      "id": 77055,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ (142 g) pkg baby arugula\n3 eggplants\n1 ½ lemon"
    },
    {
      "id": 77067,
      "primary_message": "Halve the eggplants lengthwise and place the halves cut-side-up in a baking dish.",
      "secondary_message": ""
    },
    {
      "id": 77066,
      "primary_message": "Place the eggplants in the oven and broil until browned on top, 4 to 5 minutes. Then, flip the halves over and continue to broil until the flesh is tender, another 4 to 5 minutes. Once done, remove from the oven and set aside to cool.",
      "secondary_message": ""
    },
    {
      "id": 77065,
      "primary_message": "Juice the lemon; divide evenly between a small bowl and a large salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77064,
      "primary_message": "To the lemon juice in the salad bowl, add olive oil and Dijon; whisk together.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp Dijon mustard\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 77063,
      "primary_message": "Add the arugula to the salad bowl and toss to thoroughly coat with the dressing; set aside.",
      "secondary_message": ""
    },
    {
      "id": 77062,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 77061,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; rub with olive oil and season with salt and pepper on both sides.",
      "secondary_message": "18 lamb rib chops\n1 ½ tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 77060,
      "primary_message": "Once the skillet is hot, add the lamb chops and cook until desired doneness, 2 to 5 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 77059,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the small bowl with the lemon juice.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 77058,
      "primary_message": "Scoop the eggplant flesh out of the skin and transfer to a small saucepan; discard the skin.",
      "secondary_message": ""
    },
    {
      "id": 77057,
      "primary_message": "To the eggplant, add the lemon juice and garlic mixture, olive oil, salt, and pepper; purée the mixture with a hand blender or mash with a potato masher until smooth.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 77056,
      "primary_message": "To serve, divide the eggplant purée between plates, place the lamp chops on top, and add the arugula salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
