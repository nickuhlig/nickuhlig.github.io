  "instructions": [
    {
      "id": 47256,
      "primary_message": "Preheat the oven to the broil setting and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 47257,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ (5 oz) pkg baby arugula\n1 eggplant\n½ lemon"
    },
    {
      "id": 47258,
      "primary_message": "Halve the eggplant lengthwise and place the halves cut-side-up in a baking dish.",
      "secondary_message": null
    },
    {
      "id": 47259,
      "primary_message": "Place the eggplant in the oven and broil until browned on top, 4 to 5 minutes. Then, flip the halves over and continue to broil until the flesh is tender, another 4 to 5 minutes. Once done, remove from the oven and set aside to cool.",
      "secondary_message": ""
    },
    {
      "id": 47266,
      "primary_message": "Juice the lemon; divide evenly between a small bowl and a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47267,
      "primary_message": "To the lemon juice in the salad bowl, add olive oil and Dijon; whisk together.",
      "secondary_message": "½ tbsp extra virgin olive oil\n¼ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 47268,
      "primary_message": "Add the arugula to the salad bowl and toss to thoroughly coat with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 47262,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 47263,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; rub with olive oil and season with salt and pepper on both sides.",
      "secondary_message": "6 lamb rib chops\n½ tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 47264,
      "primary_message": "Once the skillet is hot, add the lamb chops and cook until desired doneness, 2 to 5 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 47265,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add to the small bowl with the lemon juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 47260,
      "primary_message": "Scoop the eggplant flesh out of the skin and transfer to a small saucepan; discard the skin.",
      "secondary_message": null
    },
    {
      "id": 47261,
      "primary_message": "To the eggplant, add the lemon juice and garlic mixture, olive oil, salt, and pepper; purée the mixture with a hand blender or mash with a potato masher until smooth.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 47269,
      "primary_message": "To serve, divide the eggplant purée between plates, place the lamp chops on top, and add the arugula salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
