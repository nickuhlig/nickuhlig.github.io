  "instructions": [
    {
      "id": 429669,
      "primary_message": "Mince anchovy fillets. Place in a large bowl along with tomato paste, oil, and spices. Stir to combine the marinade. ",
      "secondary_message": "6 anchovy fillets, packed in oil\n6 tbsp tomato paste\n¼ cup extra virgin olive oil\n1 tbsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 429670,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the marinade. Using your hands, massage the marinade into the chicken. ",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 429671,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 429672,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add the chicken and grill until cooked through, 3-4 minutes per side. Remove to a plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 429673,
      "primary_message": "Meanwhile, wash and dry bell peppers. Using a clean cutting board, trim, seed, and medium dice the peppers. Place in a clean large bowl.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 429674,
      "primary_message": "Add shredded cabbage, pumpkin seeds, and dressing to the bowl with the bell pepper. Stir to combine the salad. ",
      "secondary_message": "1 ½ (14 oz) bags shredded cabbage (coleslaw mix)\n⅓ cup pumpkin seeds\n⅓ cup Italian salad dressing"
    },
    {
      "id": 429675,
      "primary_message": "To serve, divide chicken and cabbage salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
