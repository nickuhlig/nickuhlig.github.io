  "instructions": [
    {
      "id": 429655,
      "primary_message": "Mince anchovy fillets. Place in a medium bowl along with tomato paste, oil, and spices. Stir to combine the marinade. ",
      "secondary_message": "2 anchovy fillets, packed in oil\n2 tbsp tomato paste\n1 ½ tbsp extra virgin olive oil\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 429656,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the marinade. Using your hands, massage the marinade into the chicken. ",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 429657,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 429658,
      "primary_message": "Once the grill pan is hot, coat with oil. Add the chicken and grill until cooked through, 3-4 minutes per side. Remove to a plate. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 429659,
      "primary_message": "Meanwhile, wash and dry bell pepper. Using a clean cutting board, trim, seed, and medium dice the pepper. Place in a clean medium bowl.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 429660,
      "primary_message": "Add shredded cabbage, pumpkin seeds, and dressing to the bowl with the bell pepper. Stir to combine the salad. ",
      "secondary_message": "½ (14 oz) bag shredded cabbage (coleslaw mix)\n⅛ cup pumpkin seeds\n2 tbsp Italian salad dressing"
    },
    {
      "id": 429661,
      "primary_message": "To serve, divide chicken and cabbage salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
