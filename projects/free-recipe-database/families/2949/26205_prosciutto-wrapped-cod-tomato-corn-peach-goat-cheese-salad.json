  "instructions": [
    {
      "id": 417244,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n6 peaches\n1 small pkg fresh basil"
    },
    {
      "id": 417245,
      "primary_message": "Place oil, vinegar, salt, and crushed red pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 417246,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 417247,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 417248,
      "primary_message": "Pat cod dry with paper towels and cut into portions (if necessary). Season with salt and pepper, then wrap 2 slices of prosciutto around each portion.",
      "secondary_message": "2 ¼ lb cod fillet\n¾ tsp salt\n½ tsp black pepper\n12 slices prosciutto"
    },
    {
      "id": 417249,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 417250,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add cod and cook until golden on one side, 3-4 minutes; flip and continue to pan-fry until the fish is cooked through and the prosciutto is crisp, 3-4 minutes more. Remove to a plate. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 417251,
      "primary_message": "Meanwhile, place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl with the tomatoes and peaches.",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 417252,
      "primary_message": "Pick basil leaves off the stems; discard stems and tear the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 417253,
      "primary_message": "Crumble goat cheese into the bowl, then gently stir to combine the salad.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 417254,
      "primary_message": "To serve, divide prosciutto-wrapped cod and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
