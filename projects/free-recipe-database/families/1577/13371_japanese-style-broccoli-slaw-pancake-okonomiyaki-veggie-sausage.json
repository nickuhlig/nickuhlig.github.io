  "instructions": [
    {
      "id": 223504,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 small pkg chives\n1 ½ limes"
    },
    {
      "id": 223505,
      "primary_message": "Peel and mince ginger and garlic. Transfer both to a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 223506,
      "primary_message": "Add eggs and broth to the bowl with the ginger and garlic; whisk to combine and set aside.",
      "secondary_message": "6 eggs\n12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 223507,
      "primary_message": "Place flour, baking powder, and salt in a large bowl; whisk to combine. Gradually add the egg mixture to the bowl with the flour, whisking to create a smooth batter.",
      "secondary_message": "1 ½ cup all-purpose flour\n1 tbsp baking powder\n1 ½ tsp salt"
    },
    {
      "id": 223508,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 223509,
      "primary_message": "While the skillet heats up, add broccoli slaw to the bowl with the batter and stir until thoroughly combined.",
      "secondary_message": "3 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 223510,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add one-sixth of the pancake batter (1¼-cups per pancake) to the skillet and smooth out into a large, ½-inch thick pancake. Cook, flipping once, until golden brown and cooked through, 3-4 minutes per side. Remove to a plate and cover with foil.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 223511,
      "primary_message": "While the pancake is cooking, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 223512,
      "primary_message": "While the pot heats up, small dice the sausages.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 223513,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until golden and crispy, 5-6 minutes (or cook sausages according to package instructions). Remove from heat, cover, and set aside.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 223514,
      "primary_message": "Once the first pancake is done cooking, add more oil (about 1 teaspoon per pancake) to the skillet and repeat with remaining batter.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 223515,
      "primary_message": "Meanwhile, chop chives into small pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 223516,
      "primary_message": "Juice limes into a small bowl. Add mayo and chili-garlic sauce; whisk to combine the spicy mayo.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tbsp chili-garlic sauce"
    },
    {
      "id": 223517,
      "primary_message": "To serve, place a pancake on each plate. Top with crispy sausage, drizzle with spicy mayo, and sprinkle with chives. Enjoy!",
      "secondary_message": null
    }
  ],
