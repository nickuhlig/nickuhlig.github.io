  "instructions": [
    {
      "id": 223602,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ small pkg chives\n½ lime"
    },
    {
      "id": 223603,
      "primary_message": "Peel and mince ginger and garlic. Transfer both to a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 223604,
      "primary_message": "Add eggs and broth to the bowl with the ginger and garlic; whisk to combine and set aside.",
      "secondary_message": "2 eggs\n118 ml (½ cup) chicken or vegetable broth"
    },
    {
      "id": 223605,
      "primary_message": "Place flour, baking powder, and salt in another medium bowl; whisk to combine. Gradually add the egg mixture to the bowl with the flour, whisking to create a smooth batter.",
      "secondary_message": "½ cup all-purpose flour\n1 tsp baking powder\n½ tsp salt"
    },
    {
      "id": 223606,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 223607,
      "primary_message": "While the skillet heats up, add broccoli slaw to the bowl with the batter and stir until thoroughly combined.",
      "secondary_message": "1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 223608,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add half the pancake batter (1¼-cups per pancake) to the skillet and smooth out into a large, ½-inch thick pancake. Cook, flipping once, until golden brown and cooked through, 3-4 minutes per side. Remove to a plate and cover with foil.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 223609,
      "primary_message": "While the pancake is cooking, preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 223610,
      "primary_message": "While the pan heats up, use the tip of a knife to slice down the length of each sausage. Peel off casings and discard.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 223611,
      "primary_message": "Add sausage meat to the pan and cook, breaking apart with a spoon, until crispy and cooked through, 5-7 minutes. Remove from heat, cover, and set aside.",
      "secondary_message": null
    },
    {
      "id": 223612,
      "primary_message": "Once the first pancake is done cooking, add more oil to the skillet and repeat with remaining batter.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 223613,
      "primary_message": "Meanwhile, chop chives into small pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 223614,
      "primary_message": "Juice the lime into a small bowl. Add mayo and chili-garlic sauce; whisk to combine the spicy mayo.",
      "secondary_message": "2 tbsp mayonnaise\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 223615,
      "primary_message": "To serve, place a pancake on each plate. Top with crispy sausage, drizzle with spicy mayo, and sprinkle with chives. Enjoy!",
      "secondary_message": null
    }
  ],
