  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash oyster mushrooms well and chop them into pieces.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring a pot of salted water to a boil and simmer the oyster mushrooms for 8-10 minutes, until they’re tender.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium pot, combine vinegar, onion, salt, sugar and peppercorns. Bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When the oyster mushrooms are tender, drain them well and transfer them to the brine.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cook mushrooms in brine for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Divide bay leaves and garlic between two prepared pint jars.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Pack oyster mushrooms and onions into jars and top with brine, leaving 1/2 inch headspace.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Use a wooden spoon or chopstick to remove air bubbles from jars. If necessary, add more brine to return the headspace to 1/2 inch.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Wipe rims, apply lids and rings and process jars in a boiling water bath for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "When time is up, remove jars from canning pot and let jars cool on a folded kitchen towel.",
      "secondary_message": null
    },
    {
      "id": 11,
      "primary_message": "When jars are cool, check lids to ensure a good seal. Any unsealed jars should be stored in the refrigerator.",
      "secondary_message": null
    },
    {
      "id": 12,
      "primary_message": "Let pickles rest at least 48 hours before opening.",
      "secondary_message": null
    },
    {
      "id": 13,
      "primary_message": "Sealed pickles are shelf stable for up to one year.",
      "secondary_message": null
    }
  ],
