  "instructions": [
    {
      "primary_message": "Place mayo, ketchup, relish, vinegar, paprika, and salt in a small bowl. Whisk to combine the Thousand Island dressing and set aside. ",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp ketchup\n1 tbsp sweet pickle relish\n1 tsp red wine vinegar\n⅛ tsp paprika\n1 pinch salt"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 mango\n1 avocado\n2 heart romaine hearts"
    },
    {
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl with the mango.",
      "secondary_message": null
    },
    {
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Drain and roughly chop hearts of palm. Add to the bowl and toss to combine the salad. ",
      "secondary_message": "1 (14.5 oz) can hearts of palm"
    },
    {
      "primary_message": "To serve, divide salad between plates or bowls, drizzle with dressing, and enjoy!",
      "secondary_message": null
    }
  ],
