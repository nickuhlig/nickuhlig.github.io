  "instructions": [
    {
      "id": 537449,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ⅓-cup pasta water before draining.)",
      "secondary_message": "1 tsp salt\n10 oz penne pasta"
    },
    {
      "id": 537450,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh mint\n1 lemon\n2 bunches Swiss chard\n1 pint grape tomatoes"
    },
    {
      "id": 537451,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 537452,
      "primary_message": "Zest and juice lemon into the bowl with the mint.",
      "secondary_message": null
    },
    {
      "id": 537453,
      "primary_message": "Finely grate Parmesan. Add half to the bowl, stir to combine, and set aside. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 537454,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a medium bowl and stems in another small bowl. Set leaves aside for later use.",
      "secondary_message": null
    },
    {
      "id": 537455,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 537456,
      "primary_message": "While the skillet heats up, halve grape tomatoes. Add to the bowl with the chard stems.",
      "secondary_message": null
    },
    {
      "id": 537457,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, tomatoes, salt, and pepper to the skillet; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 537458,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 537459,
      "primary_message": "When the tomatoes have softened, add beans to the skillet; cook, stirring occasionally, until beans are warmed through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 537460,
      "primary_message": "While the beans are cooking, roughly chop pistachios. ",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 537461,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for them to wilt slightly before adding the next handful. Add drained pasta, reserved pasta water, pistachios, and the Parmesan mixture. Continue to cook, stirring occasionally, until pasta is combined and coated in sauce, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 537462,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with reserved Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
