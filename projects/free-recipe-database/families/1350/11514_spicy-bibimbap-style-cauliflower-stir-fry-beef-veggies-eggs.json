  "instructions": [
    {
      "id": 354736,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 354737,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n¾ lb cremini mushrooms\n3 medium carrots\n1 ½ (5 oz) pkgs baby spinach\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 354738,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 354739,
      "primary_message": "Once the pot is hot, add ground beef and cook, breaking apart with a spoon, until browned and cooked through, 4-5 minutes. Remove pot from the heat and, using a slotted spoon, transfer beef to a medium bowl and set aside.",
      "secondary_message": "2 ¼ lb lean ground beef"
    },
    {
      "id": 354740,
      "primary_message": "Meanwhile, cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 354741,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 354742,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354743,
      "primary_message": "Return the pot (with leftover cooking juices) to medium-high heat, add oil, and swirl to coat the bottom. Add veggies and stir to combine. ",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 354744,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Once all the spinach has wilted, flatten the veggie mixture in an even layer and cook, without stirring, until a brown crust forms on the bottom, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 354745,
      "primary_message": "Meanwhile, peel and mince the garlic and ginger. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 354746,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 354747,
      "primary_message": "Place garlic, ginger, onions, tomato paste, vinegar, oil, maple syrup, soy sauce, sesame seeds, and crushed red pepper in the bowl used for the veggies. Whisk to combine the sauce.",
      "secondary_message": "6 tbsp tomato paste\n3 tbsp rice vinegar\n3 tbsp toasted sesame oil\n3 tbsp pure maple syrup\n3 tbsp soy sauce\n1 ½ tsp sesame seeds\n¾ tsp crushed red pepper"
    },
    {
      "id": 354748,
      "primary_message": "Drizzle sauce over the veggies, stir to combine, cover, and cook until the veggies are tender, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 354749,
      "primary_message": "Meanwhile, peel and halve the eggs.",
      "secondary_message": null
    },
    {
      "id": 354750,
      "primary_message": "Return beef to the pot, stir to combine and continue to cook, until heated through, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 354751,
      "primary_message": "To serve, divide stir-fry between bowls or plates and top with eggs. Enjoy!",
      "secondary_message": null
    }
  ],
