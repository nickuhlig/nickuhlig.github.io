  "instructions": [
    {
      "id": 354960,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 354961,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium head cauliflower\n0.23 kg cremini mushrooms\n2 medium carrots\n1 (142 g) pkg baby spinach\n2 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 354962,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 354963,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 3-4 minutes. Remove from heat, transfer veggie ground to a plate, and set aside. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp toasted sesame oil\n454 g veggie ground, plant based"
    },
    {
      "id": 354964,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower and place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 354965,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 354966,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354967,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and stir to combine. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 354968,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Once all the spinach has wilted, flatten the veggie mixture in an even layer and cook, without stirring, until a brown crust forms on the bottom, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 354969,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in the reserved bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 354970,
      "primary_message": "Trim green onions and cut crosswise into thin pieces. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 354971,
      "primary_message": "Add tomato paste, vinegar, oil, maple syrup, soy sauce, sesame seeds, and crushed red pepper to the bowl. Whisk to combine the sauce.",
      "secondary_message": "4 tbsp tomato paste\n2 tbsp rice vinegar\n2 tbsp toasted sesame oil\n2 tbsp pure maple syrup\n2 tbsp soy sauce\n1 tsp sesame seeds\n½ tsp crushed red pepper"
    },
    {
      "id": 354972,
      "primary_message": "Drizzle sauce over the veggies and stir to combine. Cover the skillet and continue to cook, undisturbed, until the veggies are tender, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 354973,
      "primary_message": "Return veggie ground to the skillet. Stir until combined and heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 354974,
      "primary_message": "Meanwhile, peel and halve the eggs.",
      "secondary_message": null
    },
    {
      "id": 354975,
      "primary_message": "To serve, divide stir-fry between bowls or plates and top with eggs. Enjoy!",
      "secondary_message": null
    }
  ],
