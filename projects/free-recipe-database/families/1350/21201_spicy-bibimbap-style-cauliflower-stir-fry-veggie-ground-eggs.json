  "instructions": [
    {
      "id": 354784,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 354785,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n¾ lb cremini mushrooms\n3 medium carrots\n1 ½ (5 oz) pkgs baby spinach\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 354786,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 354787,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat, transfer veggie ground to a plate, and set aside. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil\n24 oz veggie ground, plant based"
    },
    {
      "id": 354788,
      "primary_message": "Meanwhile, cut each cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower and place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 354789,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 354790,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354791,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and stir to combine. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 354792,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Once all the spinach has wilted, flatten the veggie mixture in an even layer and cook, without stirring, until a brown crust forms on the bottom, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 354793,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in the reserved bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 354794,
      "primary_message": "Trim green onions and cut crosswise into thin pieces. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 354795,
      "primary_message": "Add tomato paste, vinegar, oil, maple syrup, soy sauce, sesame seeds, and crushed red pepper to the bowl. Whisk to combine the sauce.",
      "secondary_message": "6 tbsp tomato paste\n3 tbsp rice vinegar\n3 tbsp toasted sesame oil\n3 tbsp pure maple syrup\n3 tbsp soy sauce\n1 ½ tsp sesame seeds\n¾ tsp crushed red pepper"
    },
    {
      "id": 354796,
      "primary_message": "Drizzle sauce over the veggies and stir to combine. Cover the pot and continue to cook until the veggies are tender, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 354797,
      "primary_message": "Return veggie ground to the pot. Stir until combined and heated through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 354798,
      "primary_message": "Meanwhile, peel and halve the eggs.",
      "secondary_message": null
    },
    {
      "id": 354799,
      "primary_message": "To serve, divide stir-fry between bowls or plates and top with eggs. Enjoy!",
      "secondary_message": null
    }
  ],
