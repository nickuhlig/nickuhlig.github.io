  "instructions": [
    {
      "id": 354704,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 354705,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n¼ lb cremini mushrooms\n1 medium carrot\n½ (5 oz) pkg baby spinach\n1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 354706,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 354707,
      "primary_message": "Once the skillet is hot, add ground beef and cook, breaking apart with a spoon, until browned and cooked through, 3-4 minutes. Remove skillet from the heat and, using a slotted spoon, transfer beef to a plate and set aside.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 354708,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 354709,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 354710,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354711,
      "primary_message": "Return the skillet (with leftover cooking juices) to medium-high heat, add oil, and swirl to coat the bottom. Add veggies and stir to combine. ",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 354712,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Once all the spinach has wilted, flatten the veggie mixture in an even layer and cook, without stirring, until a brown crust forms on the bottom, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 354713,
      "primary_message": "Meanwhile, peel and mince the garlic and ginger. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 354714,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 354715,
      "primary_message": "Place garlic, ginger, onions, tomato paste, vinegar, oil, maple syrup, soy sauce, sesame seeds, and crushed red pepper in the bowl used for the veggies. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp tomato paste\n1 tbsp rice vinegar\n1 tbsp toasted sesame oil\n1 tbsp pure maple syrup\n1 tbsp soy sauce\n½ tsp sesame seeds\n¼ tsp crushed red pepper"
    },
    {
      "id": 354716,
      "primary_message": "Drizzle sauce over the veggies, stir to combine, cover, and cook until the veggies are tender, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 354717,
      "primary_message": "Return beef to the skillet, stir to combine and continue to cook, until heated through, 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 354718,
      "primary_message": "Meanwhile, peel and halve the eggs.",
      "secondary_message": null
    },
    {
      "id": 354719,
      "primary_message": "To serve, divide stir-fry between bowls or plates and top with eggs. Enjoy!",
      "secondary_message": null
    }
  ],
