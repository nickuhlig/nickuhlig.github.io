  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven racks to upper and lower-middle positions and preheat oven to 180°C (350°F). Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour, baking powder, salt, and espresso; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In the bowl of a stand mixer fitted with a paddle attachment, cream butter, brown sugar, and sugar until light and fluffy, about 3 minutes. Beat in egg. Add dry ingredients and mix on low speed until evenly combined. mix in toffee bits. Drop dough by the rounded tablespoon onto prepared baking sheets. Bake until cookies are just starting to get golden at the edges, 14 to 18 minutes. Allow to cool slightly and serve.",
      "secondary_message": null
    }
  ],
