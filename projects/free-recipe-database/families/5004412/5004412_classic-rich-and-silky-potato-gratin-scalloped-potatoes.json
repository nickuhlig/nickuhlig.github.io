  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Smash the garlic. Quarter the shallots. Freshly grate the nutmeg. Grate the Parmesan cheese. Grate the Gruyère cheese. Soften the unsalted butter.",
      "secondary_message": "2 medium cloves garlic\n2 small shallots\n⅛ tsp nutmeg\n2 oz Parmesan cheese\n4 oz Gruyère cheese\n1 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "In a small saucepan, combine cream, milk, garlic, shallots, nutmeg, thyme, peppercorns, and salt. Bring to a boil, then remove from heat, cover, and let steep for 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Return milk mixture to boil, then strain into a large heatproof bowl, pressing gently on the solids.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a mandoline, slice the peeled potatoes crosswise 1/16-inch thick, directly into the hot milk mixture. Stir the potatoes to fully coat.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Preheat oven to 350°F. In a small bowl, combine the Gruyère and Parmigiano-Reggiano cheeses.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Grease a 2-quart baking dish with the butter. Lay the sliced potatoes in one even layer, then sprinkle with about 1/3 cup cheese mixture. Repeat layering potatoes and cheese until all the potatoes have been used and half the cheese mixture remains (you should have about 4 layers); leave the top layer without cheese. Pour any remaining milk mixture over the layered potatoes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Cover with aluminum foil and bake for 1 hour. Remove baking dish from oven and remove foil. Evenly sprinkle remaining cheese on top and continue to bake, uncovered, until the potatoes have become tender, the sauce has thickened, and the surface is lightly golden brown, 15 to 20 minutes. Allow the gratin to rest 30 minutes before serving.",
      "secondary_message": null
    }
  ],
