  "instructions": [
    {
      "id": 436821,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 436822,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n½ lemon\n½ small pkg fresh mint"
    },
    {
      "id": 436823,
      "primary_message": "Separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 436824,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until the broccoli is starting to soften, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 436825,
      "primary_message": "While the broccoli is roasting, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil over medium-high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 436826,
      "primary_message": "Meanwhile, roughly chop pistachios.",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "id": 436827,
      "primary_message": "Once the broccoli has started to soften, remove from the oven. Sprinkle with pistachios, stir to combine, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 436828,
      "primary_message": "Return baking sheet to the oven. Continue to roast until broccoli is tender and lightly charred and pistachios are toasted, 10-12 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 436829,
      "primary_message": "Meanwhile, finely grate Parmesan and place in a small bowl.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 436830,
      "primary_message": "Zest and juice lemon into the bowl with the Parmesan. ",
      "secondary_message": null
    },
    {
      "id": 436831,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl along with the spices. (Reserve remaining mint for serving.)",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 436832,
      "primary_message": "When the pasta is done, reserve a ⅓-cup of cooking water, then drain. Return pasta and reserved cooking water to the pot.",
      "secondary_message": null
    },
    {
      "id": 436833,
      "primary_message": "Add roasted broccoli, pistachios, and Parmesan mixture to the pot. Set the pot over medium-high heat and cook, stirring often, until liquid has evaporated and Parmesan is melted, 1-2 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 436834,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with reserved mint. Enjoy!",
      "secondary_message": null
    }
  ],
