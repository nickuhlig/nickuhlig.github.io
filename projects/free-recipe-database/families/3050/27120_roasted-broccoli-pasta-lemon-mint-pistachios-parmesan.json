  "instructions": [
    {
      "id": 436933,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 436934,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 crowns broccoli\n1 ½ lemons\n1 small pkg fresh mint"
    },
    {
      "id": 436935,
      "primary_message": "Separate broccoli into bite-sized florets; cut stems into smaller pieces. Divide between two large baking sheet pans, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 436936,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until the broccoli is starting to soften, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 436937,
      "primary_message": "While the broccoli is roasting, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil over medium-high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 436938,
      "primary_message": "Meanwhile, roughly chop pistachios.",
      "secondary_message": "1 cup pistachios, unsalted"
    },
    {
      "id": 436939,
      "primary_message": "Once the broccoli has started to soften, remove from the oven. Sprinkle with pistachios, stir to combine, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 436940,
      "primary_message": "Return baking sheets to the oven. Continue to roast until broccoli is tender and lightly charred and pistachios are toasted, 12-15 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 436941,
      "primary_message": "Meanwhile, finely grate Parmesan and place in a medium bowl.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 436942,
      "primary_message": "Zest and juice lemons into the bowl with the Parmesan. ",
      "secondary_message": null
    },
    {
      "id": 436943,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl along with the spices. (Reserve remaining mint for serving.)",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 436944,
      "primary_message": "When the pasta is done, reserve 1 cup of cooking water, then drain. Return pasta and reserved cooking water to the pot.",
      "secondary_message": null
    },
    {
      "id": 436945,
      "primary_message": "Add roasted broccoli, pistachios, and Parmesan mixture to the pot. Set the pot over medium-high heat and cook, stirring often, until liquid has evaporated and Parmesan is melted, 2-3 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 436946,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with reserved mint. Enjoy!",
      "secondary_message": null
    }
  ],
