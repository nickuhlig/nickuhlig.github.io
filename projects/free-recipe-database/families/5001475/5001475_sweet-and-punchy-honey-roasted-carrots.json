  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and halve the whole carrots lengthwise. Melt the unsalted butter. Pick the herb leaves from the stems and chop them.",
      "secondary_message": "7 medium whole carrots, small\n2 tbsp unsalted butter\n2 tbsp fresh mixed tender herbs"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position, and preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring a large pot of salted water to a boil over high heat. Add carrots to boiling water; reduce heat to medium-low, and simmer until carrots are just beginning to turn tender and still meet some resistance when pierced with a fork or knife, 3 to 5 minutes. Drain carrots, and pat dry with paper towels or a clean kitchen towel; place on a baking sheet.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, whisk honey, butter, miso, vinegar, ginger, and black pepper until combined. Drizzle 2 tablespoons of honey mixture over carrots, and toss to coat. Place carrots, cut side down, on baking sheet.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Roast carrots until edges are browned and carrots are tender, 15 to 18 minutes, rotating baking sheet from front to back halfway through cooking. Remove from oven and let cool 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Toss carrots with herbs and transfer carrots to a large serving plate. Drizzle with remaining 4 tablespoons honey mixture. Serve warm.",
      "secondary_message": null
    }
  ],
