  "instructions": [
    {
      "id": 43634,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n1 mango"
    },
    {
      "id": 43639,
      "primary_message": "Quarter the bell pepper lengthwise; remove and discard the stem, seeds, and membranes. Slice the quarters crosswise into small strips and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 43641,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; cut lengthwise into thin wedges. Add to the bowl with the bell pepper.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 43635,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 43636,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with paprika, salt, and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n1 tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 43637,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 43638,
      "primary_message": "Place the pork chops in the skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
      "secondary_message": null
    },
    {
      "id": 43640,
      "primary_message": "While the pork chops cook, peel the mango, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and large dice the flesh (cut into ¾-inch cubes).",
      "secondary_message": null
    },
    {
      "id": 43642,
      "primary_message": "Once the pork chops have been transferred, add more coconut oil to the skillet.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 43646,
      "primary_message": "Add the bell pepper and onion to the skillet; season with salt and pepper. Cook, stirring frequently, until the vegetables are just tender, 2 to 3 minutes.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 43643,
      "primary_message": "Add the mango to the skillet; stir to combine and continue cooking for an additional 1 to 2 minutes. Remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 43644,
      "primary_message": "To serve, divide the pork chops and sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
