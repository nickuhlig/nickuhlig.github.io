  "instructions": [
    {
      "id": 222520,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 222521,
      "primary_message": "Place butter in a medium saucepan and melt over medium heat.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 222522,
      "primary_message": "Divide melted butter between 6 muffin cups and sprinkle with sugar. (Reserve pan for later use.)",
      "secondary_message": "3 tbsp brown sugar"
    },
    {
      "id": 222523,
      "primary_message": "Place flour, water, sugar, baking powder, vanilla, and spices in a medium bowl; whisk to combine the batter. ",
      "secondary_message": "1 cup all-purpose flour\n¾ cup water\n½ cup brown sugar\n1 ½ tsp baking powder\n¾ tsp vanilla extract\n½ tsp salt\n½ tsp cinnamon\n3 pinch nutmeg, ground"
    },
    {
      "id": 222524,
      "primary_message": "Divide batter between muffin cups. Place in the oven and bake until a knife or skewer inserted in the center comes out clean, 15-20 minutes. Remove from oven and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 222525,
      "primary_message": "Meanwhile, wash, dry, and cut off skin from pineapples. Core and small dice.",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 222526,
      "primary_message": "Return saucepan to medium heat.",
      "secondary_message": null
    },
    {
      "id": 222527,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add pineapple, sugar, vanilla, and cinnamon. Cook, stirring occasionally, until pineapple has softened, 5-6 minutes. Remove from heat and set aside.",
      "secondary_message": "3 tbsp butter, unsalted\n3 tbsp brown sugar\n¾ tsp vanilla extract\n3 pinch cinnamon"
    },
    {
      "id": 222528,
      "primary_message": "Slide a knife down and around the side of each cake to loosen. Holding the muffin pan over a baking sheet pan, carefully invert, and tap the pan to loosen the cakes.",
      "secondary_message": null
    },
    {
      "id": 222529,
      "primary_message": "To serve, divide cakes, pineapple, and ice cream between bowls. Enjoy!",
      "secondary_message": "1065 ml vanilla ice cream"
    }
  ],
