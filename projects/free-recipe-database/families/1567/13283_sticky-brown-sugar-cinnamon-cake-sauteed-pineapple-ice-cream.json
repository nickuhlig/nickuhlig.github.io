  "instructions": [
    {
      "id": 222450,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 222451,
      "primary_message": "Place butter in a medium saucepan and melt over medium heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 222452,
      "primary_message": "Divide melted butter between 4 muffin cups and sprinkle with sugar. (Reserve pan for later use.)",
      "secondary_message": "2 tbsp brown sugar"
    },
    {
      "id": 222453,
      "primary_message": "Place flour, water, sugar, baking powder, vanilla, and spices in a small bowl; whisk to combine the batter. ",
      "secondary_message": "⅔ cup all-purpose flour\n½ cup water\n⅓ cup brown sugar\n1 tsp baking powder\n½ tsp vanilla extract\n¼ tsp salt\n¼ tsp cinnamon\n⅛ tsp nutmeg, ground"
    },
    {
      "id": 222454,
      "primary_message": "Divide batter between muffin cups. Place in the oven and bake until a knife or skewer inserted in the center comes out clean, 15-20 minutes. Remove from oven and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 222455,
      "primary_message": "Meanwhile, wash, dry, and cut off skin from pineapple. Core and small dice.",
      "secondary_message": "1 small pineapple"
    },
    {
      "id": 222456,
      "primary_message": "Return saucepan to medium heat.",
      "secondary_message": null
    },
    {
      "id": 222457,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add pineapple, sugar, vanilla, and cinnamon. Cook, stirring occasionally, until pineapple has softened, 4-5 minutes. Remove from heat and set aside.",
      "secondary_message": "2 tbsp butter, unsalted\n2 tbsp brown sugar\n½ tsp vanilla extract\n⅛ tsp cinnamon"
    },
    {
      "id": 222458,
      "primary_message": "Slide a knife down and around the side of each cake to loosen. Holding the muffin pan over a baking sheet pan, carefully invert, and tap the pan to loosen the cakes.",
      "secondary_message": null
    },
    {
      "id": 222459,
      "primary_message": "To serve, divide cakes, pineapple, and ice cream between bowls. Enjoy!",
      "secondary_message": "24 fl oz (3 cups) vanilla ice cream"
    }
  ],
