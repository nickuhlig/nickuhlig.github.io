  "instructions": [
    {
      "id": 498294,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n3 jalapeño peppers\n1 ½ English cucumbers\n3 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 498295,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans kidney beans"
    },
    {
      "id": 498296,
      "primary_message": "Juice limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 498297,
      "primary_message": "Peel and mince shallots. Add to the bowl with the lime juice along with oil, maple syrup, sesame seeds, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n3 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n2 tbsp sesame seeds\n1 tbsp garam masala\n1 ½ tsp salt\n¾ tsp cumin, ground"
    },
    {
      "id": 498298,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 498299,
      "primary_message": "Trim and small dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 498300,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 498301,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the beans. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 498302,
      "primary_message": "To serve, divide bean salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
