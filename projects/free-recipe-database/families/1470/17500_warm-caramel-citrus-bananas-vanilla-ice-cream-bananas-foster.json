  "instructions": [
    {
      "id": 283739,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 ½ oranges\n9 bananas"
    },
    {
      "id": 283740,
      "primary_message": "Juice lemon into a large skillet. Add sugar, oil, vanilla, and cinnamon; place over medium-low heat and cook, stirring occasionally, until oil melts and sugar dissolves.",
      "secondary_message": "¾ cup brown sugar\n¼ cup virgin coconut oil\n1 tbsp vanilla extract\n1 ½ tsp cinnamon, ground"
    },
    {
      "id": 283741,
      "primary_message": "Meanwhile, peel and cut bananas into ½-inch thick slices.",
      "secondary_message": null
    },
    {
      "id": 283742,
      "primary_message": "Add bananas to the skillet and cook, stirring occasionally, until they start to caramelize, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 283743,
      "primary_message": "Juice oranges into the skillet and continue to cook until sauce is reduced slightly, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 283744,
      "primary_message": "To serve, divide bananas and sauce between bowls. Top with ice cream and enjoy!",
      "secondary_message": "18 fl oz (2 ¼ cups) vanilla ice cream, vegan"
    }
  ],
