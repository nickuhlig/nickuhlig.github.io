  "instructions": [
    {
      "id": 283727,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ orange\n3 bananas"
    },
    {
      "id": 283728,
      "primary_message": "Juice lemon into a skillet. Add sugar, oil, vanilla, and cinnamon; place over medium-low heat and cook, stirring occasionally, until oil melts and sugar dissolves.",
      "secondary_message": "¼ cup brown sugar\n4 tsp virgin coconut oil\n1 tsp vanilla extract\n½ tsp cinnamon, ground"
    },
    {
      "id": 283729,
      "primary_message": "Meanwhile, peel and cut bananas into ½-inch thick slices.",
      "secondary_message": null
    },
    {
      "id": 283730,
      "primary_message": "Add bananas to the skillet and cook, stirring occasionally, until they start to caramelize, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 283731,
      "primary_message": "Juice orange into the skillet and continue to cook until sauce is reduced slightly, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 283732,
      "primary_message": "To serve, divide bananas and sauce between bowls. Top with ice cream and enjoy!",
      "secondary_message": "6 fl oz (¾ cup) vanilla ice cream, vegan"
    }
  ],
