  "instructions": [
    {
      "id": 251698,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 251699,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small pkg fresh mint\n1 avocado\n1 English cucumber"
    },
    {
      "id": 251700,
      "primary_message": "Juice half the lime into a small bowl. (Reserve remaining lime for later.)",
      "secondary_message": null
    },
    {
      "id": 251701,
      "primary_message": "Peel and mince shallot; add to the bowl with the lime juice.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 251702,
      "primary_message": "Mince the sun-dried tomatoes; add to the bowl along with oil and spices. Stir to combine the tapenade.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed\n1 tbsp extra virgin olive oil\n1 tsp dill, dried\n½ tsp oregano, dried\n¼ tsp garlic powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 251703,
      "primary_message": "Thinly slice olives.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 251704,
      "primary_message": "Pat cod dry with paper towels and place on the baking sheet; season with salt and pepper. Spread with tapenade and top with olives.",
      "secondary_message": "⅓ kg cod fillet\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 251705,
      "primary_message": "Place baking sheet in the oven and broil until the cod is almost cooked through, about 8 minutes. ",
      "secondary_message": null
    },
    {
      "id": 251706,
      "primary_message": "Meanwhile, juice the remaining lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 251707,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice along with oil, salt, and pepper. Stir to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 251708,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 251709,
      "primary_message": "Remove cod from the oven and top with half the feta (reserve remaining cheese for the salad). Return baking sheet to the oven and broil until the fish flakes easily with a fork and the cheese is golden, 2-3 minutes more. Remove from oven.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 251710,
      "primary_message": "Trim and thinly slice cucumber crosswise; add to the salad bowl along with the reserved feta. Gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 251711,
      "primary_message": "To serve, divide cod and salad between plates; enjoy!",
      "secondary_message": null
    }
  ],
