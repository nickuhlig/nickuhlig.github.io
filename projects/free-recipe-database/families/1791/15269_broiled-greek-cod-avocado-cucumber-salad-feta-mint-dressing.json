  "instructions": [
    {
      "id": 251726,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 251727,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small pkg fresh mint\n3 avocados\n3 English cucumbers"
    },
    {
      "id": 251728,
      "primary_message": "Juice half the limes into a small bowl. (Reserve remaining limes for later.)",
      "secondary_message": null
    },
    {
      "id": 251729,
      "primary_message": "Peel and mince onion; add to the bowl with the lime juice.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 251730,
      "primary_message": "Mince the sun-dried tomatoes; add to the bowl along with oil and spices. Stir to combine the tapenade.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n3 tbsp extra virgin olive oil\n1 tbsp dill, dried\n1 ½ tsp oregano, dried\n¾ tsp garlic powder\n½ tsp crushed red pepper"
    },
    {
      "id": 251731,
      "primary_message": "Thinly slice olives.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 251732,
      "primary_message": "Pat cod dry with paper towels and place on the baking sheet; season with salt and pepper. Spread with tapenade and top with olives.",
      "secondary_message": "1.02 kg cod fillet\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 251733,
      "primary_message": "Place baking sheet in the oven and broil until the cod is almost cooked through, 8-10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 251734,
      "primary_message": "Meanwhile, juice the remaining limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 251735,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice along with oil, salt, and pepper. Stir to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 251736,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 251737,
      "primary_message": "Remove cod from the oven and top with half the feta (reserve remaining cheese for the salad). Return baking sheet to the oven and broil until the fish flakes easily with a fork and the cheese is golden, 3-4 minutes more. Remove from oven.",
      "secondary_message": "3 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 251738,
      "primary_message": "Trim and thinly slice cucumbers crosswise; add to the salad bowl along with the reserved feta. Gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 251739,
      "primary_message": "To serve, divide cod and salad between plates; enjoy!",
      "secondary_message": null
    }
  ],
