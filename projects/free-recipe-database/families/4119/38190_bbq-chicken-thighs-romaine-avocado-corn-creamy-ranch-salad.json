  "instructions": [
    {
      "id": 596527,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 596528,
      "primary_message": "While the pan heats up, pat the chicken thighs dry with paper towels and place in a large bowl. Drizzle with oil, season with salt and pepper, then turn to coat.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 596529,
      "primary_message": "Once the pan is hot, working in batches if necessary, add chicken and grill until charred and cooked through, 3-4 minutes per side. Transfer to a plate. ",
      "secondary_message": null
    },
    {
      "id": 596530,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, and spices in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tbsp apple cider vinegar\n1 ½ tsp dill, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 596531,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 heads romaine lettuce\n1 ½ small pkgs grape tomatoes\n1 small bunch green onions (scallions)\n3 avocados"
    },
    {
      "id": 596532,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 596533,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596534,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596535,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596536,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 596537,
      "primary_message": "Place ketchup, vinegar, Worcestershire, Dijon, and spices in another large bowl. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup ketchup\n2 tbsp apple cider vinegar\n1 ½ tsp Worcestershire sauce\n1 ½ tsp Dijon mustard\n¾ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 596538,
      "primary_message": "When the chicken is done, add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 596539,
      "primary_message": "To serve, divide salad and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
