  "instructions": [
    {
      "id": 596378,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 596379,
      "primary_message": "While the pan heats up, pat the chicken thighs dry with paper towels and place in a medium bowl. Drizzle with oil, season with salt and pepper, then turn to coat.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 596380,
      "primary_message": "Once the pan is hot, add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 596381,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tsp mayonnaise\n2 tsp apple cider vinegar\n½ tsp dill, dried\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 596382,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 head romaine lettuce\n½ pint grape tomatoes\n½ small bunch green onions (scallions)\n1 avocado"
    },
    {
      "id": 596383,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 596384,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596385,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596386,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596387,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 596388,
      "primary_message": "Place ketchup, vinegar, Worcestershire, Dijon, and spices in another medium bowl. Whisk to combine the sauce.",
      "secondary_message": "2 tbsp ketchup\n2 tsp apple cider vinegar\n½ tsp Worcestershire sauce\n½ tsp Dijon mustard\n¼ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 596389,
      "primary_message": "When the chicken is done, add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 596390,
      "primary_message": "To serve, divide salad and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
