  "instructions": [
    {
      "id": 596445,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 596446,
      "primary_message": "Place yogurt, mayo, vinegar, and spices in a large bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tbsp apple cider vinegar\n1 ½ tsp dill, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 596447,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 596448,
      "primary_message": "While the pan heats up, cut tofu planks in half crosswise, then cut each half into two triangles and place in another large bowl. Drizzle with oil, season with salt and pepper, then turn to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 596449,
      "primary_message": "Once the pan is hot, working in batches if necessary, add tofu and grill until charred and warmed through, 4-5 minutes per side. Remove from heat. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 596450,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 heads romaine lettuce\n1 ½ pints grape tomatoes\n1 small bunch green onions (scallions)\n3 avocados"
    },
    {
      "id": 596451,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 596452,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596453,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596454,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596455,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 596456,
      "primary_message": "Place ketchup, vinegar, soy sauce, Dijon, and spices in the reserved bowl. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup ketchup\n2 tbsp apple cider vinegar\n1 ½ tsp soy sauce\n1 ½ tsp Dijon mustard\n¾ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 596457,
      "primary_message": "When the tofu is done, add to the bowl with the sauce and turn to coat.",
      "secondary_message": null
    },
    {
      "id": 596458,
      "primary_message": "To serve, divide salad and tofu between plates or bowls, then spoon any remaining sauce in the bowl over the tofu. Enjoy!",
      "secondary_message": null
    }
  ],
