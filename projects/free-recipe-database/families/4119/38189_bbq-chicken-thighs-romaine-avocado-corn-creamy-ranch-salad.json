  "instructions": [
    {
      "id": 596514,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 596515,
      "primary_message": "While the pan heats up, pat the chicken thighs dry with paper towels and place in a medium bowl. Drizzle with oil, season with salt and pepper, then turn to coat.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 596516,
      "primary_message": "Once the pan is hot, add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 596517,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n4 tsp mayonnaise\n4 tsp apple cider vinegar\n1 tsp dill, dried\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 596518,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 heads romaine lettuce\n1 small pkg grape tomatoes\n1 small bunch green onions (scallions)\n2 avocados"
    },
    {
      "id": 596519,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 596520,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596521,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596522,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596523,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 596524,
      "primary_message": "Place ketchup, vinegar, Worcestershire, Dijon, and spices in a clean medium bowl. Whisk to combine the sauce.",
      "secondary_message": "¼ cup ketchup\n4 tsp apple cider vinegar\n1 tsp Worcestershire sauce\n1 tsp Dijon mustard\n½ tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 596525,
      "primary_message": "When the chicken is done, add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 596526,
      "primary_message": "To serve, divide salad and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
