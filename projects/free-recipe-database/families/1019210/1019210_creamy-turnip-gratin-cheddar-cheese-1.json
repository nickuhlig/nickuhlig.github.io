  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. ",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, and trim turnips. Cut each turnip into ½-inch thick wedges. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel and mince garlic. ",
      "secondary_message": "2 clove garlic"
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add garlic and cook until fragrant, about 1 minute. ",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "primary_message": "Add milk, cream, Dijon, and spices to the skillet with the garlic; stir to combine and bring to a boil. Once boiling, add turnips, reduce heat to medium-low, and simmer until liquid thickens slightly and turnips start to soften, 8-10 minutes. ",
      "secondary_message": "16 fl oz whole milk\n12 fl oz heavy whipping cream\n2 tsp Dijon mustard\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "primary_message": "When the turnips are softened, sprinkle with cheese. ",
      "secondary_message": null
    },
    {
      "primary_message": "Place skillet in the oven and bake until cheese is golden brown and turnips are very tender, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from oven and let stand 5 minutes before serving.",
      "secondary_message": null
    }
  ],
