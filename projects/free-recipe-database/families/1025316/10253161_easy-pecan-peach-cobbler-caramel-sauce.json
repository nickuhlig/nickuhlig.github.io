  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Place butter in a small saucepan and melt over medium-low heat. Add vanilla, stir to combine, and set aside.",
      "secondary_message": "½ cup butter, unsalted\n½ tsp vanilla extract"
    },
    {
      "primary_message": "Roughly chop pecans. Place in a medium bowl along with milk, baking mix, cinnamon, and nutmeg. Stir to combine the batter. ",
      "secondary_message": "½ cup pecan halves\n1 cup whole milk\n1 cup pancake & baking mix, original\n¼ tsp cinnamon, ground\n¼ tsp nutmeg, ground"
    },
    {
      "primary_message": "Add butter mixture to the bowl with the batter and stir once more to combine. Pour batter into an 8-inch square baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "primary_message": "Drain peaches. Place in a clean medium bowl along with caramel sauce. Stir to combine, then arrange the peaches and sauce over the top of the batter (do not mix).",
      "secondary_message": "2 (425 g) can sliced peaches in juice\n½ cup caramel sauce"
    },
    {
      "primary_message": "Place cobbler in the preheated oven and bake until golden and bubbling, 50-55 minutes. Remove from oven and set aside to cool slightly, 15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide cobbler between bowls and drizzle with additional caramel sauce. Enjoy!",
      "secondary_message": "¼ cup caramel sauce"
    }
  ],
