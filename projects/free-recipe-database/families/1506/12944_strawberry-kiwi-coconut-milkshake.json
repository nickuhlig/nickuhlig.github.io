    {
      "id": 217677,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 217678,
      "primary_message": "Wash and dry strawberries. Make a cut half-way through the center of 4 strawberries and set aside for garnish.",
      "secondary_message": "1 (16 oz) pkg strawberries"
    },
    {
      "id": 217679,
      "primary_message": "Trim remaining strawberries and place in a blender. ",
      "secondary_message": null
    },
    {
      "id": 217680,
      "primary_message": "Wash, dry, peel, and roughly chop kiwis. Add to the blender.",
      "secondary_message": "4 kiwifruit"
    },
    {
      "id": 217681,
      "primary_message": "Add ice cream, coconut milk, whole milk, and vanilla to the blender; blend on high until smooth.",
      "secondary_message": "32 fl oz (4 cups) vanilla ice cream\n1 (13.5 fl oz) can coconut milk\n8 fl oz (1 cup) whole milk\n½ tsp vanilla extract"
    },
    {
      "id": 217682,
      "primary_message": "To serve, divide milkshake between glasses or jars, garnish each rim with a strawberry, and enjoy!",
