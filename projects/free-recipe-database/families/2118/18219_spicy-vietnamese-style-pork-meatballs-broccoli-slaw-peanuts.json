  "instructions": [
    {
      "id": 295563,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 lime\n2 (1 inch) pieces ginger root\n1 small pkg fresh mint\n1 small bunch cilantro\n1 English cucumber\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 295564,
      "primary_message": "Juice lime into a small bowl. Add soy sauce, fish sauce, chili-garlic sauce, sugar, and cornstarch; whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup soy sauce\n2 tbsp fish sauce\n2 tbsp chili-garlic sauce\n2 tbsp brown sugar\n2 tsp cornstarch"
    },
    {
      "id": 295565,
      "primary_message": "Peel and mince ginger and garlic; place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 295566,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 295567,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 295568,
      "primary_message": "Add pork, eggs, bread crumbs, fish sauce, and spices to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "1 ½ lb lean ground pork\n2 eggs\n½ cup panko bread crumbs\n2 tbsp fish sauce\n1 tsp salt\n½ tsp onion powder\n¼ tsp black pepper"
    },
    {
      "id": 295569,
      "primary_message": "Using a tablespoon measure, form the pork mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 295570,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 295571,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 295572,
      "primary_message": "Meanwhile, trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 295573,
      "primary_message": "Separate the lettuce into leaves and roughly chop or tear into bite-size pieces; add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 295574,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 295575,
      "primary_message": "When the meatballs are done, add sauce to the skillet and turn to coat. Cook, stirring occasionally, until the sauce thickens slightly and coats meatballs, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 295576,
      "primary_message": "To serve, divide cucumbers, lettuce, and broccoli slaw between bowls. Top with saucy meatballs and sprinkle with peanuts. Enjoy!",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    }
  ],
