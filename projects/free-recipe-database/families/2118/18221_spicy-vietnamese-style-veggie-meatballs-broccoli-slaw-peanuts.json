  "instructions": [
    {
      "id": 295591,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "½ lime\n1 (1 inch) piece ginger root\n½ small pkg fresh mint\n½ small bunch cilantro\n½ English cucumber\n1 head butter (Boston) lettuce"
    },
    {
      "id": 295592,
      "primary_message": "Juice lime into a small bowl. Add soy sauce, chili-garlic sauce, sugar, and cornstarch; whisk to combine the sauce and set aside.",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n1 tsp cornstarch"
    },
    {
      "id": 295593,
      "primary_message": "Peel and mince ginger and garlic; place both in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 295594,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 295595,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 295596,
      "primary_message": "Add veggie ground, bread crumbs, soy sauce, and spices to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "8 oz veggie ground, plant based\n¼ cup panko bread crumbs\n1 tbsp soy sauce\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 295597,
      "primary_message": "Using a tablespoon measure, form the mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 295598,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 295599,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 295600,
      "primary_message": "Meanwhile, trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 295601,
      "primary_message": "Separate the lettuce into leaves and roughly chop or tear into bite-size pieces; add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 295602,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 295603,
      "primary_message": "When the meatballs are done, add sauce to the skillet and turn to coat. Cook, stirring occasionally, until the sauce thickens slightly and coats meatballs, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 295604,
      "primary_message": "To serve, divide cucumbers, lettuce, and broccoli slaw between bowls. Top with saucy meatballs and sprinkle with peanuts. Enjoy!",
      "secondary_message": "½ (12 oz) pkg broccoli slaw"
    }
  ],
