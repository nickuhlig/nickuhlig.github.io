  "instructions": [
    {
      "id": 295745,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 ½ limes\n3 (2 ½ cm) pieces ginger root\n1 ½ small pkgs fresh mint\n1 ½ small bunches cilantro\n1 ½ English cucumbers\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 295746,
      "primary_message": "Juice limes into a small bowl. Add soy sauce, fish sauce, chili-garlic sauce, sugar, and cornstarch; whisk to combine the sauce and set aside.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp fish sauce\n3 tbsp chili-garlic sauce\n3 tbsp brown sugar\n1 tbsp cornstarch"
    },
    {
      "id": 295747,
      "primary_message": "Peel and mince ginger and garlic; place both in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 295748,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 295749,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 295750,
      "primary_message": "Add pork, eggs, bread crumbs, fish sauce, and spices to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "1.02 kg lean ground pork\n3 eggs\n¾ cup panko bread crumbs\n3 tbsp fish sauce\n1 ½ tsp salt\n¾ tsp onion powder\n½ tsp black pepper"
    },
    {
      "id": 295751,
      "primary_message": "Using a tablespoon measure, form the pork mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 295752,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 295753,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 295754,
      "primary_message": "Meanwhile, trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 295755,
      "primary_message": "Separate the lettuce into leaves and roughly chop or tear into bite-size pieces; add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 295756,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 295757,
      "primary_message": "When the meatballs are done, add sauce to the skillet and turn to coat. Cook, stirring occasionally, until the sauce thickens slightly and coats meatballs, 4-5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 295758,
      "primary_message": "To serve, divide cucumbers, lettuce, and broccoli slaw between bowls. Top with saucy meatballs and sprinkle with peanuts. Enjoy!",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    }
  ],
