  "instructions": [
    {
      "id": 1,
      "primary_message": "Using a sharp knife, cut plantains into the shape and size of your choosing: 1.5-cm dice, 1-cm thick rounds, or 1-cm thick slices on the bias.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place plantains in a large bowl, sprinkle with salt, and toss to coat; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 95°C (200°F). Line a rimmed baking sheet with paper towels. In a Dutch oven, heat oil over medium-high heat to 175°C (350°F). Add half of the plantains and fry, stirring occasionally, until lightly caramelized and golden brown, 8 to 10 minutes. Using a slotted spoon or spider, transfer plantains to prepared baking sheet, then transfer to oven to keep warm.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Return oil to 175°C and repeat with remaining plantains. Transfer plantains to a bowl and serve.",
      "secondary_message": null
    }
  ],
