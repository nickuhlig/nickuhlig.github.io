  "instructions": [
    {
      "id": 294541,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 294542,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ lb cremini mushrooms\n½ small bunch Italian (flat-leaf) parsley\n1 tomato\n½ lemon"
    },
    {
      "id": 294543,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 294544,
      "primary_message": "Quarter mushrooms and add to the baking sheet with the cauliflower. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 294545,
      "primary_message": "Peel garlic, place in the center of a small square of aluminum foil, and drizzle with oil; fold foil around garlic to close the packet. Add to the baking sheet with the veggies.",
      "secondary_message": "4 cloves garlic\n1 tsp extra virgin olive oil"
    },
    {
      "id": 294546,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing veggies halfway through, until golden brown and tender (and garlic is soft), 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 294547,
      "primary_message": "While the veggies are roasting, fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and return pasta to the pan. (Reserve ½-cup pasta cooking water.)",
      "secondary_message": "1 tsp salt\n5 oz fettuccine pasta"
    },
    {
      "id": 294548,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 294549,
      "primary_message": "Small dice tomato; add to the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 294550,
      "primary_message": "Finely grate Parmesan; add to the bowl.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 294551,
      "primary_message": "Once the garlic is ready, carefully open the packet; use a fork to mash the roasted garlic. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 294552,
      "primary_message": "Juice lemon into the pan with the pasta; add roasted veggies, parsley, tomato, Parmesan, roasted garlic, and reserved pasta water. Return to low heat and cook, stirring occasionally, until pasta is heated through and cheese is melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 294553,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 294554,
      "primary_message": "To serve, divide pasta between plates or bowls and top with chopped walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
