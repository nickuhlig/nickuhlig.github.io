  "instructions": [
    {
      "id": 294569,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 294570,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lb cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley\n3 tomatoes\n1 ½ lemons"
    },
    {
      "id": 294571,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces; divide between two baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 294572,
      "primary_message": "Quarter mushrooms and add to the baking sheets with the cauliflower. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 294573,
      "primary_message": "Peel garlic, place in the center of a small square of aluminum foil, and drizzle with oil; fold foil around garlic to close the packet. Add to one of the baking sheets with the veggies.",
      "secondary_message": "12 cloves garlic\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 294574,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing veggies halfway through, until golden brown and tender (and garlic is soft), about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 294575,
      "primary_message": "While the veggies are roasting, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and return pasta to the pot. (Reserve 1 ½ cups pasta cooking water.)",
      "secondary_message": "1 tbsp salt\n15 oz fettuccine pasta"
    },
    {
      "id": 294576,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 294577,
      "primary_message": "Small dice tomatoes; add to the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 294578,
      "primary_message": "Finely grate Parmesan; add to the bowl.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 294579,
      "primary_message": "Once the garlic is ready, carefully open the packet; use a fork to mash the roasted garlic. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 294580,
      "primary_message": "Juice lemons into the pot with the pasta; add roasted veggies, parsley, tomato, Parmesan, roasted garlic, and reserved pasta water. Return to low heat and cook, stirring occasionally, until pasta is heated through and cheese is melted, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 294581,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 294582,
      "primary_message": "To serve, divide pasta between plates or bowls and top with chopped walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
