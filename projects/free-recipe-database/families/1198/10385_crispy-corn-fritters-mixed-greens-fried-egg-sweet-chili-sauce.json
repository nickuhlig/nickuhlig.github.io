  "instructions": [
    {
      "id": 210625,
      "primary_message": "Combine water, vinegar, sugar, and chili-garlic sauce in a small saucepan. Bring to a boil over high heat and cook until slightly thickened, 1-2 minutes.",
      "secondary_message": "¼ cup water\n¼ cup rice vinegar\n3 tbsp brown sugar\n2 tsp chili-garlic sauce"
    },
    {
      "id": 210626,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "2 tbsp water\n½ tsp cornstarch"
    },
    {
      "id": 210627,
      "primary_message": "Add cornstarch slurry to the saucepan in a steady stream while stirring quickly. Cook, stirring often, until sauce thickens, 1-2 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 210628,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg chives\n2 medium carrots\n2 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 210629,
      "primary_message": "Chop chives into small pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 210630,
      "primary_message": "Finely grate Parmesan; add to the bowl with the chives.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 210631,
      "primary_message": "Place corn in a colander and run under hot water (from the tap) to thaw. Place on a clean towel or paper towels and pat dry.",
      "secondary_message": "4 cups frozen corn"
    },
    {
      "id": 210632,
      "primary_message": "Add corn, flour, and eggs to the bowl; stir to combine.",
      "secondary_message": "1 ½ cup all-purpose flour\n2 eggs"
    },
    {
      "id": 210633,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 210634,
      "primary_message": "Using a ¼-cup measure, form the corn mixture into ½-inch thick patties. Add to the skillet and cook, flipping once, until patties are golden brown, 3-5 minutes. Transfer to a plate lined with paper towels. Work in batches if necessary. Set the skillet (with oil) aside for later use. ",
      "secondary_message": null
    },
    {
      "id": 210635,
      "primary_message": "Meanwhile, in a large bowl, whisk together oil, vinegar, salt, and pepper.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp rice vinegar\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 210636,
      "primary_message": "Peel carrots and trim ends; grate and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 210637,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 210638,
      "primary_message": "Return the skillet to medium heat. Gently crack the eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes. Season with salt and pepper.",
      "secondary_message": "4 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 210639,
      "primary_message": "To serve, divide salad, fritters, and eggs between plates. Drizzle with sweet chili sauce and enjoy!",
      "secondary_message": null
    }
  ],
