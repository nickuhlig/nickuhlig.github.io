  "instructions": [
    {
      "id": 210550,
      "primary_message": "Combine water, vinegar, sugar, and chili-garlic sauce in a small saucepan. Bring to a boil over high heat and cook until slightly thickened, 2-3 minutes.",
      "secondary_message": "⅓ cup water\n⅓ cup rice vinegar\n¼ cup brown sugar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 210551,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "3 tbsp water\n¾ tsp cornstarch"
    },
    {
      "id": 210552,
      "primary_message": "Add cornstarch slurry to the saucepan in a steady stream while stirring quickly. Cook, stirring often, until sauce thickens, 2-3 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 210553,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg chives\n3 medium carrots\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 210554,
      "primary_message": "Chop chives into small pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 210555,
      "primary_message": "Finely grate Parmesan; add to the bowl with the chives.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 210556,
      "primary_message": "Place corn in a colander and run under hot water (from the tap) to thaw. Place on a clean towel or paper towels and pat dry.",
      "secondary_message": "6 cups frozen corn"
    },
    {
      "id": 210557,
      "primary_message": "Add corn, flour, and eggs to the bowl; stir to combine.",
      "secondary_message": "2 ¼ cup all-purpose flour\n3 eggs"
    },
    {
      "id": 210558,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 210559,
      "primary_message": "Using a ¼-cup measure, form the corn mixture into ½-inch thick patties. Add to the skillet and cook, flipping once, until patties are golden brown, 3-5 minutes. Transfer to a plate lined with paper towels. Work in batches if necessary. Set the skillet (with oil) aside for later use.",
      "secondary_message": null
    },
    {
      "id": 210560,
      "primary_message": "Meanwhile, in another large bowl, whisk together oil, vinegar, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp rice vinegar\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 210561,
      "primary_message": "Peel carrots and trim ends; grate and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 210562,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 210563,
      "primary_message": "Return the skillet to medium heat. Working in batches if necessary, gently crack the eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes. Season with salt and pepper.",
      "secondary_message": "6 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 210564,
      "primary_message": "To serve, divide salad, fritters, and eggs between plates. Drizzle with sweet chili sauce and enjoy!",
      "secondary_message": null
    }
  ],
