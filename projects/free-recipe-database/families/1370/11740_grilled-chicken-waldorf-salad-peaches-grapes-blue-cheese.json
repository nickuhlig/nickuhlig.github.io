  "instructions": [
    {
      "id": 198469,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 198470,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 198471,
      "primary_message": "Once the grill pan is hot, coat with oil. Add chicken and grill, flipping once, until golden and cooked through, 8-10 minutes. Remove to a plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 198472,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n1 lemon\n1 stick celery\n0.11 kg red grapes\n1 peach\n½ head butter (Boston) lettuce"
    },
    {
      "id": 198473,
      "primary_message": "Using a clean cutting board, peel and mince garlic; transfer to a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 198474,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 198475,
      "primary_message": "Juice half the lemon into the bowl with the garlic and parsley. Add yogurt, oil, and salt; whisk to combine the dressing and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 198476,
      "primary_message": "Juice remaining lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 198477,
      "primary_message": "Medium dice celery; slice grapes in half. Transfer both to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "id": 198478,
      "primary_message": "Quarter the peach lengthwise (around the pit) and twist the quarters to separate, then remove and discard pit; medium dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 198479,
      "primary_message": "Medium dice chicken and add to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 198480,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 198481,
      "primary_message": "To serve, divide the lettuce leaves between plates and drizzle with dressing. Top with chicken salad, walnuts, and blue cheese. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    }
  ],
