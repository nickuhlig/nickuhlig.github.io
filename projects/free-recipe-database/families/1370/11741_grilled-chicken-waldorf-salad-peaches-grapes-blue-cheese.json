  "instructions": [
    {
      "id": 198482,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 198483,
      "primary_message": "Preheat a large grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 198484,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add chicken and grill, flipping once, until golden and cooked through, 8-10 minutes. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 198485,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n2 lemons\n2 sticks celery\n0.23 kg red grapes\n2 peaches\n1 head butter (Boston) lettuce"
    },
    {
      "id": 198486,
      "primary_message": "Using a clean cutting board, peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 198487,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 198488,
      "primary_message": "Juice one lemon into the bowl with the garlic and parsley. Add yogurt, oil, and salt; whisk to combine the dressing and set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 198489,
      "primary_message": "Juice remaining lemon into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 198490,
      "primary_message": "Medium dice celery; slice grapes in half. Transfer both to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "id": 198491,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard pits; medium dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 198492,
      "primary_message": "Medium dice chicken and add to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 198493,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "1 cup walnuts"
    },
    {
      "id": 198494,
      "primary_message": "To serve, divide the lettuce leaves between plates and drizzle with dressing. Top with chicken salad, walnuts, and blue cheese. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled blue cheese"
    }
  ],
