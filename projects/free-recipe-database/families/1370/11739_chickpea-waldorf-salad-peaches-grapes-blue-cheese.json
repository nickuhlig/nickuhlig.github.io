  "instructions": [
    {
      "id": 198458,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n3 lemons\n3 sticks celery\n¾ lb red grapes\n3 peaches\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 198459,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 198460,
      "primary_message": "Peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 198461,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 198462,
      "primary_message": "Juice half of the lemons into the bowl with the garlic and parsley. Add yogurt, oil, and salt; whisk to combine the dressing and set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 198463,
      "primary_message": "Juice remaining lemons into a large bowl; add oil, salt, and pepper. Whisk to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 198464,
      "primary_message": "Medium dice celery; slice grapes in half. Transfer both to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "id": 198465,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard pits; medium dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 198466,
      "primary_message": "Add chickpeas to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 198467,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "1 ½ cups walnuts"
    },
    {
      "id": 198468,
      "primary_message": "To serve, divide the lettuce leaves between plates and drizzle with dressing. Top with chickpea salad, walnuts, and blue cheese. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    }
  ],
