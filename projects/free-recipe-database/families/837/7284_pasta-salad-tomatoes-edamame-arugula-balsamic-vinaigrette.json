  "instructions": [
    {
      "id": 172469,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n15 oz penne pasta"
    },
    {
      "id": 172470,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 172471,
      "primary_message": "Peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 172472,
      "primary_message": "To make the dressing, add garlic, shallots, balsamic vinegar, olive oil, salt, and pepper to a medium bowl. Whisk to combine; set aside.",
      "secondary_message": "⅓ cup balsamic vinegar\n⅓ cup extra virgin olive oil\n5.625 ml salt\n¾ tsp black pepper"
    },
    {
      "id": 172473,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 pints grape tomatoes\n¾ small pkg fresh basil\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 172474,
      "primary_message": "Halve the grape tomatoes lengthwise and add to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 172475,
      "primary_message": "Add edamame to the pasta water 2 minutes before the pasta is done. ",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 172476,
      "primary_message": "When pasta and edamame are done, drain in a colander, and rinse under cold water to cool; set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 172477,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half of the basil to the bowl with the tomatoes; reserve the rest for garnish. ",
      "secondary_message": null
    },
    {
      "id": 172478,
      "primary_message": "Add pasta and edamame to the bowl and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 172479,
      "primary_message": "To serve, divide the arugula between plates or bowls, and top with pasta salad. Drizzle balsamic vinaigrette over salad and sprinkle with remaining basil. Enjoy!",
      "secondary_message": null
    }
  ],
