  "instructions": [
    {
      "id": 172425,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "2 tsp salt\n10 oz penne pasta"
    },
    {
      "id": 172426,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 172427,
      "primary_message": "Peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 172428,
      "primary_message": "To make the dressing, add garlic, shallots, balsamic vinegar, olive oil, salt, and pepper to a medium bowl. Whisk to combine; set aside.",
      "secondary_message": "¼ cup balsamic vinegar\n¼ cup extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 172429,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 pints grape tomatoes\n½ small pkg fresh basil\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 172430,
      "primary_message": "Halve the grape tomatoes lengthwise and add to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 172431,
      "primary_message": "Cut the fresh mozzarella into bite-sized pieces and add to the bowl. ",
      "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 172432,
      "primary_message": "When pasta is done, drain in a colander, and rinse under cold water to cool; set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 172433,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half of the basil to the bowl with the tomatoes and mozzarella; reserve the rest for garnish. ",
      "secondary_message": null
    },
    {
      "id": 172434,
      "primary_message": "Add the pasta to the bowl and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 172435,
      "primary_message": "To serve, divide the arugula between plates or bowls, and top with pasta salad. Drizzle balsamic vinaigrette over salad and sprinkle with remaining basil. Enjoy!",
      "secondary_message": null
    }
  ],
