  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved if you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 400°F. Coat 12 muffin cups with cooking spray. (Alternatively, line the muffin pan with paper liners.) \n\n",
      "secondary_message": "2 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place cornmeal, flour, sugar, baking powder, and salt in a large bowl. Whisk to combine the dry ingredients. \n\n",
      "secondary_message": "1 cup polenta (cornmeal)\n1 cup all-purpose flour\n½ cup granulated sugar\n2 tsp baking powder\n½ tsp salt"
    },
    {
      "primary_message": "Place egg, milk, and oil in a medium bowl, then whisk to combine. Add to the bowl with the dry ingredients and gently stir until batter is almost combined.\n\n",
      "secondary_message": "1 egg\n1 cup whole milk\n¼ cup neutral vegetable oil"
    },
    {
      "primary_message": "Slice hot dogs crosswise into thin pieces. Add to the bowl and gently stir once more until just combined. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide the batter between muffin cups. Place muffin pan in the preheated oven and bake until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes. Remove from oven and allow to cool slightly, 10 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Share muffins and enjoy!",
      "secondary_message": null
    }
  ],
