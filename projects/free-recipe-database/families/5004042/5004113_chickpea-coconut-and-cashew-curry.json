  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Toast the whole cumin seeds. Toast the coriander seeds. Toast the whole star anise. Toast the black peppercorns. Finely mince the onion. Finely chop the red chile. Drain and rinse the chickpeas. Trim, rinse, and roughly chop the flat spinach leaves. Coarsely chop the tender stems of the fresh cilantro leaves.",
      "secondary_message": "1 ½ tsp whole cumin seeds\n1 ½ tsp coriander seeds\n1 whole star anise\n½ tsp black peppercorns\n1 small onion\n1 small red chile\n2 (397 g) cans chickpeas\n1 (85 g) bunch flat spinach leaves\n½ cup fresh cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "Combine cumin, coriander, star anise, cloves, peppercorns, cinnamon, nutmeg, mace, turmeric, and cardamom in a spice grinder and grind to a fine powder. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil, butter, or ghee in a large saucepan over medium-high heat until melted (or until oil is shimmering). Add onion, garlic, ginger, and chile. Cook, stirring frequently, and scraping bottom of pan until golden brown and starting to burn in spots, about 10 minutes. Add cayenne, cashews, and half of spice mixture. Cook, stirring constantly until fragrant, about 30 seconds. Add coconut milk and remove from heat. Scrape up any browned bits from bottom of pan.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer mixture to blender and starting a low speed, slowly increase speed to maximum. Blend until smooth, about 30 seconds. Return mixture to pot. Add chickpeas, spinach, and remaining spice mix and cook over low heat, stirring constantly, until vegetables are heated through and spinach is wilted, about 10 minutes. Add salt and lime juice to taste. Stir in half of cilantro.\nTransfer to serving bowl, sprinkle with extra cilantro, and serve with lime wedges, basmati rice pilaf, grilled naan, and cilantro chutney, as desired.",
      "secondary_message": null
    }
  ],
