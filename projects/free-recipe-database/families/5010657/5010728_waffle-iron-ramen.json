  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat waffle iron. (If it has temperature adjustment, set it to medium.)",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, beat egg with soy sauce, sesame seeds, and a few drops of sesame oil. Add prepared noodles and stir to coat noodles evenly with egg mixture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place noodle mixture in waffle iron and close lid. Cook until golden brown in spots, 2 to 3 minutes. Remove from waffle iron and serve hot, garnished with chopped green onions, sesame seeds and soy sauce.",
      "secondary_message": null
    }
  ],
