  "instructions": [
    {
      "id": 238505,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ small bunch fresh dill\n½ small bunch asparagus\n½ small bunch green onions (scallions)\n½ pint grape tomatoes\n½ English cucumber\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 238506,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 238507,
      "primary_message": "Add eggs, salt, and pepper to the bowl with the dill; whisk to combine.",
      "secondary_message": "5 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 238508,
      "primary_message": "Chop or tear salmon into bite-sized pieces; add to the bowl.",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 238509,
      "primary_message": "Crumble goat cheese into the bowl; stir to combine and set aside.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 238510,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Slice crosswise into ½-inch pieces and place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 238511,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 238512,
      "primary_message": "While the skillet heats up, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 238513,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, green onions, salt, and pepper to the skillet; cook, stirring often, until asparagus is crisp-tender, about 3 minutes. (Reserve bowl for the salad.)",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 238514,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 238515,
      "primary_message": "Pour the egg mixture into the skillet with the veggies; gently stir to combine. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 238516,
      "primary_message": "Place skillet in the oven and broil until the top is set, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 238517,
      "primary_message": "While the frittata is cooking, peel and mince garlic. Place in the reserved bowl along with oil, vinegar, Dijon, honey, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp Dijon mustard\n½ tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 238518,
      "primary_message": "Halve tomatoes. Trim and medium dice cucumber; add both to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 238519,
      "primary_message": "Finely chop walnuts and add to the bowl along with the mixed greens; toss to combine the salad.",
      "secondary_message": "⅛ cup walnuts"
    },
    {
      "id": 238520,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
