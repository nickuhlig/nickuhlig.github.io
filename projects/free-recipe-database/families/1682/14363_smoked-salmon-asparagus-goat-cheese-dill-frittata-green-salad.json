  "instructions": [
    {
      "id": 238537,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch fresh dill\n1 ½ small bunches asparagus\n1 ½ small bunches green onions (scallions)\n1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 238538,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 238539,
      "primary_message": "Add eggs, salt, and pepper to the bowl with the dill; whisk to combine.",
      "secondary_message": "15 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 238540,
      "primary_message": "Chop or tear salmon into bite-sized pieces; add to the bowl.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 238541,
      "primary_message": "Crumble goat cheese into the bowl; stir to combine and set aside.",
      "secondary_message": "3 (4 oz) logs goat cheese"
    },
    {
      "id": 238542,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Slice crosswise into ½-inch pieces and place in another large bowl.",
      "secondary_message": null
    },
    {
      "id": 238543,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 238544,
      "primary_message": "While the skillet heats up, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 238545,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, green onions, salt, and pepper to the skillet; cook, stirring often, until asparagus is crisp-tender, 4-5 minutes. (Reserve bowl for the salad.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 238546,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 238547,
      "primary_message": "Pour the egg mixture into the skillet with the veggies; gently stir to combine. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 238548,
      "primary_message": "Place skillet in the oven and broil until the top is set, about 3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 238549,
      "primary_message": "While the frittata is cooking, peel and mince garlic. Place in the reserved bowl along with oil, vinegar, Dijon, honey, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tbsp Dijon mustard\n1 ½ tsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 238550,
      "primary_message": "Halve tomatoes. Trim and medium dice cucumbers; add both to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 238551,
      "primary_message": "Finely chop walnuts and add to the bowl along with the mixed greens; toss to combine the salad.",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 238552,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
