  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the bacon into 3/4-inch squares. Peel and slice the red onions. Peel and chop the garlic.",
      "secondary_message": "142 g bacon\n2 red onions\n4 cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "The day before you plan to serve this dish, put the peas in a bowl, cover with water by at least 5 cm, and refrigerate. The next day, drain well before using.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Center a rack in the oven and preheat the oven to 135°C (275°F).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place the bacon in a small cast-iron pot or Dutch oven over medium-high heat and cook until it renders its fat, about 6 or 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add the onions, garlic, oregano (or Italian seasoning), and black pepper and cook, stirring, for 8 minutes. Add the drained peas, bay leaves, salt, and 6 cups water. Bring to a simmer, cover, and transfer to the oven.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Braise until the peas are tender, at least 1 hour 15 minutes. Stir in the Tabasco, sprinkle with the parsley, and serve.",
      "secondary_message": null
    }
  ],
