  "instructions": [
    {
      "id": 1,
      "primary_message": "Add rye, lemon, maple syrup, and egg white to a cocktail shaker. Dry shake (without ice) for 20 seconds to emulsify egg. Add ice and shake hard for 10 seconds, until chilled. Strain into coupe, garnish with Angostura bitters, serve immediately.",
      "secondary_message": null
    }
