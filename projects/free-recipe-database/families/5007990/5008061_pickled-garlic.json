  "instructions": [
    {
      "id": 1,
      "primary_message": "Prepare a small canning pot and 3 half-pint jars. Place 3 new lids in a small pot of water and bring to the barest simmer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine vinegar, water and salt in a saucepan and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pack garlic cloves into prepared jars.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour hot brine over the garlic cloves.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Tap jars gently to remove any trapped air bubbles. If necessary, add more brine to return the headspace to 1.5 cm.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Wipe rims, apply lids and rings and process jars in a boiling water bath canner for 10 minutes (start your timer when the water returns to a boil, not when the jars first go in).",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "When time is up, remove jars from canner and let cool on a folded kitchen towel.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "When jars are cool enough to handle, remove rings and test seals by grasping edges of lids and carefully lifting jars. If lids hold fast, seals are good.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Store jars in a cool, dark place. They are ready to eat within 48 hours, but can be kept up to 1 year.",
      "secondary_message": null
    }
  ],
