  "instructions": [
    {
      "id": 421460,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 421461,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Transfer cutlets to a baking sheet pan.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 421462,
      "primary_message": "Drizzle chicken with oil, then season with salt and pepper. Place baking sheet in the oven and broil, flipping the chicken halfway through, until almost cooked through, about 8 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 421463,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 heads butter (Boston) lettuce\n4 tomatoes\n1 English cucumber\n1 small pkg fresh basil"
    },
    {
      "id": 421464,
      "primary_message": "Using a clean cutting board, chop or tear lettuce into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 421465,
      "primary_message": "Small dice tomatoes. Add to the bowl with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 421466,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 421467,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 421468,
      "primary_message": "When the chicken is almost cooked through, remove from the oven. Spread each cutlet with pesto and sprinkle with cheese. Return baking sheet to the oven and continue to broil until the cheese is melted and chicken is cooked through, 2-3 minutes more. Remove from oven.",
      "secondary_message": "½ cup sun-dried tomato pesto\n1 cup shredded cheese, Italian blend"
    },
    {
      "id": 421469,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 421470,
      "primary_message": "To serve, divide salad between plates or bowls and drizzle with vinaigrette; top with chicken. Enjoy!",
      "secondary_message": "½ cup balsamic vinaigrette"
    }
  ],
