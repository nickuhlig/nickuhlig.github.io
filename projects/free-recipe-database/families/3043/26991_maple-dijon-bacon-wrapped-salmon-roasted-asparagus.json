  "instructions": [
    {
      "id": 488005,
      "primary_message": "Preheat oven to 205°C (400°F). Line two large baking sheet pans with aluminum foil (for easier cleanup).",
      "secondary_message": null
    },
    {
      "id": 488006,
      "primary_message": "Wash and dry asparagus. Snap (or cut) off woody ends and arrange on one of the baking sheets. Drizzle with oil, then season with salt and pepper; set aside.",
      "secondary_message": "3 small bunches asparagus\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 488007,
      "primary_message": "Place maple syrup and Dijon in a small bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "3 tbsp pure maple syrup\n3 tbsp Dijon mustard"
    },
    {
      "id": 488008,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on the cutting board. Holding the tail end firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin). Discard the skin.",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 488009,
      "primary_message": "Cut salmon into portions. Spread half of the sauce over the salmon, then wrap with bacon. Spread remaining sauce over the bacon, then arrange, seam-side down, on the second baking sheet.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 488010,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through and asparagus is tender, 12-14 minutes. Remove baking sheets from the oven and cover asparagus with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 488011,
      "primary_message": "Change the oven to broil on high and position rack in the upper third of the oven. Return salmon to the oven and broil until bacon is crispy, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 488012,
      "primary_message": "To serve, divide salmon and asparagus between plates. Enjoy!",
      "secondary_message": null
    }
  ],
