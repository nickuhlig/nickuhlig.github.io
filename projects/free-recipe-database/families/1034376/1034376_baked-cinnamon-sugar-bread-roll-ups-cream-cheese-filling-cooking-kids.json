  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Small dice cream cheese, place in a medium bowl, and set aside to soften, about 20 minutes.\n\n",
      "secondary_message": "½ (8 oz) block cream cheese"
    },
    {
      "primary_message": "When the cream cheese has softened, preheat oven to 350°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Melt butter in a microwave or small saucepan. Use 1 tablespoon of butter to coat a small (9-inch square) baking dish. (Reserve remaining butter for later use.)\n\n",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "primary_message": "Place egg in a small bowl and whisk to combine.\n\n",
      "secondary_message": "1 egg"
    },
    {
      "primary_message": "Beat cream cheese with an electric mixer until smooth. Add 2 tablespoons of the whisked egg and the sugar, then beat once more until combined. Set the filling aside. (Discard remaining egg or reserve for another use.)\n\n",
      "secondary_message": "granulated sugar"
    },
    {
      "primary_message": "Cut crusts off the bread slices. Using a rolling pin or small saucepan, roll or press each piece of bread flat (the slices should be about 1/8-inch thick). \n\n",
      "secondary_message": "1 (22 oz) loaf white bread"
    },
    {
      "primary_message": "Spread about 1 teaspoon of the filling on each flattened slice of bread, then tightly roll. Cut each bread roll-up in half crosswise and arrange in the baking dish, seam-side down.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place additional sugar and cinnamon in a small bowl, then stir to combine. Brush rolls with reserved melted butter, then sprinkle with the cinnamon sugar.\n\n",
      "secondary_message": "3 tbsp granulated sugar\n½ tsp cinnamon, ground"
    },
    {
      "primary_message": "Place baking dish in the oven and bake until roll-ups are golden, 15-20 minutes. Remove from oven and set aside to cool slightly, about 5 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Serve, share, and enjoy!",
      "secondary_message": null
    }
  ],
