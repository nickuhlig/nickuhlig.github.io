  "instructions": [
    {
      "id": 211121,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 211122,
      "primary_message": "Place sausages on a large baking sheet pan and place in the oven (it doesn't have to be fully heated); bake for 8-10 minutes while you prepare the veggies.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 211123,
      "primary_message": "Wash and dry bell peppers. Seed and slice into thin strips; transfer to a medium bowl.",
      "secondary_message": "2 red bell peppers\n1 green bell pepper"
    },
    {
      "id": 211124,
      "primary_message": "Peel and mince garlic. Peel and thinly slice onion into half rings; transfer both to the bowl with the peppers. ",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 211125,
      "primary_message": "Add oil, salt, and Italian seasoning to the bowl with the veggies; toss to combine. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp Italian seasoning"
    },
    {
      "id": 211126,
      "primary_message": "Remove baking sheet pan from the oven, flip sausages, and push them to one side. Add veggie mixture to the pan and return to the oven; continue to bake until veggies are tender and sausages are cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 211127,
      "primary_message": "Meanwhile, pour tomato sauce into the bowl used for the veggies. Add spices and stir to combine; set aside.",
      "secondary_message": "1 (213 ml) can tomato sauce\n¼ tsp Italian seasoning\n⅛ tsp crushed red pepper\n⅛ tsp salt"
    },
    {
      "id": 211128,
      "primary_message": "Grate cheese.",
      "secondary_message": "⅔ (227 g) block mozzarella cheese"
    },
    {
      "id": 211129,
      "primary_message": "When the sausages and veggies are done, remove from the oven; set oven temperature to broil on high.",
      "secondary_message": null
    },
    {
      "id": 211130,
      "primary_message": "Split the rolls in half and place on another large baking sheet pan, cut-side facing up. Place in the oven and broil until lightly toasted, 1-2 minutes. Remove from the oven.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 211131,
      "primary_message": "Meanwhile, slice sausages in half crosswise.",
      "secondary_message": null
    },
    {
      "id": 211132,
      "primary_message": "Set the tops of the rolls aside, leaving the bottoms on the baking sheet pan. Sprinkle the bottoms with half of the cheese. Divide veggies, sauce, and sausages between the rolls and top with remaining cheese. Place in the oven and broil to melt the cheese, about 1 minute. ",
      "secondary_message": null
    },
    {
      "id": 211133,
      "primary_message": "Close sandwiches and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
