  "instructions": [
    {
      "id": 210991,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 210992,
      "primary_message": "Wash and dry bell peppers. Seed and slice into thin strips; transfer to a medium bowl.",
      "secondary_message": "1 red bell pepper\n½ green bell pepper"
    },
    {
      "id": 210993,
      "primary_message": "Peel and mince garlic. Peel and thinly slice onion into half rings; transfer both to the bowl with the peppers. ",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 210994,
      "primary_message": "Add oil, salt, and Italian seasoning to the bowl with the veggies; toss to combine. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp Italian seasoning"
    },
    {
      "id": 210995,
      "primary_message": "Add veggie mixture to a baking sheet pan and place in the oven (it doesn't have to be fully heated); bake until veggies begin to soften, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 210996,
      "primary_message": "Meanwhile, pour tomato sauce into the bowl used for the veggies. Add spices and stir to combine; set aside.",
      "secondary_message": "½ (8 oz) can tomato sauce\n⅛ tsp Italian seasoning\n1 pinch salt\n1 pinch crushed red pepper"
    },
    {
      "id": 210997,
      "primary_message": "Remove baking sheet pan from the oven, and push veggies to one side. Add sausages to the pan and return to the oven; continue to bake until veggies are tender and sausages are warmed through, about 5 minutes (or cook sausages according to package instructions).",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 210998,
      "primary_message": "Grate cheese.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 210999,
      "primary_message": "When the sausages and veggies are done, remove from the oven; set oven temperature to broil on high.",
      "secondary_message": null
    },
    {
      "id": 211000,
      "primary_message": "Split the rolls in half and place on another baking sheet pan, cut-side facing up. Place in the oven and broil until lightly toasted, 1-2 minutes. Remove from the oven.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 211001,
      "primary_message": "Meanwhile, slice sausages in half crosswise.",
      "secondary_message": null
    },
    {
      "id": 211002,
      "primary_message": "Set the tops of the rolls aside, leaving the bottoms on the baking sheet pan. Sprinkle the bottoms with half of the cheese. Divide veggies, sauce, and sausages between the rolls and top with remaining cheese. Place in the oven and broil to melt the cheese, about 1 minute. ",
      "secondary_message": null
    },
    {
      "id": 211003,
      "primary_message": "Close sandwiches and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
