  "instructions": [
    {
      "id": 525264,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ limes\n1 ½ red bell peppers\n3 mangoes\n1 ½ avocados\n3 (142 g) pkgs baby spinach"
    },
    {
      "id": 525265,
      "primary_message": "Place turkey, bread crumbs, eggs, and spices in a large bowl; mix with your hands until well combined. Form the turkey mixture into 6 equal-sized patties and place on a plate.",
      "secondary_message": "1.02 kg ground turkey\n¾ cup panko bread crumbs\n3 eggs\n1 ½ tsp basil, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 525266,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 525267,
      "primary_message": "While the skillet heats up, zest and juice limes into a small bowl. Add mayo and spices, then whisk to combine the aioli. Set aside.",
      "secondary_message": "½ cup mayonnaise\n¾ tsp garlic powder\n½ tsp cayenne pepper\n½ tsp salt"
    },
    {
      "id": 525268,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook, undisturbed, until golden underneath, about 5 minutes; flip patties and cook an additional 5-6 minutes, until cooked through. Remove to a clean plate.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 525269,
      "primary_message": "Meanwhile, trim, seed, and slice bell pepper lengthwise into thin strips. Place on another clean plate.",
      "secondary_message": null
    },
    {
      "id": 525270,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; thinly slice the flesh. Add to the plate with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 525271,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 525272,
      "primary_message": "To serve, divide spinach between plates or bowls. Top with bell pepper, mango, avocado, and burger patties. Drizzle with aioli and enjoy!",
      "secondary_message": null
    }
  ],
