  "instructions": [
    {
      "id": 525214,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ limes\n1 ½ red bell peppers\n3 mangoes\n1 ½ avocados\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 525215,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 525216,
      "primary_message": "While the skillet heats up, zest and juice limes into a small bowl. Add mayo and spices, then whisk to combine the aioli. Set aside.",
      "secondary_message": "½ cup mayonnaise\n¾ tsp garlic powder\n½ tsp cayenne pepper\n½ tsp salt"
    },
    {
      "id": 525217,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "1 ½ tbsp neutral vegetable oil\n6 veggie burger patties, plant-based"
    },
    {
      "id": 525218,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers lengthwise into thin strips. Place on another plate.",
      "secondary_message": null
    },
    {
      "id": 525219,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; thinly slice the flesh. Add to the plate with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 525220,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 525221,
      "primary_message": "To serve, divide spinach between plates or bowls. Top with bell pepper, mango, avocado, and burger patties. Drizzle with aioli and enjoy!",
      "secondary_message": null
    }
  ],
