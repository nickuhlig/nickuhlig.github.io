  "instructions": [
    {
      "id": 525297,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lime\n½ red bell pepper\n1 mango\n½ avocado\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 525298,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 525299,
      "primary_message": "While the skillet heats up, zest and juice lime into a small bowl. Add mayo and spices, then whisk to combine the aioli. Set aside.",
      "secondary_message": "3 tbsp vegan mayonnaise\n¼ tsp garlic powder\n⅛ tsp cayenne pepper\n⅛ tsp salt"
    },
    {
      "id": 525300,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove from heat.",
      "secondary_message": "1 ½ tsp neutral vegetable oil\n2 veggie burger patties, plant-based"
    },
    {
      "id": 525301,
      "primary_message": "Meanwhile, trim, seed, and slice bell pepper lengthwise into thin strips. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 525302,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; thinly slice the flesh. Add to the plate with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 525303,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 525304,
      "primary_message": "To serve, divide spinach between plates or bowls. Top with bell pepper, mango, avocado, and burger patties. Drizzle with aioli and enjoy!",
      "secondary_message": null
    }
  ],
