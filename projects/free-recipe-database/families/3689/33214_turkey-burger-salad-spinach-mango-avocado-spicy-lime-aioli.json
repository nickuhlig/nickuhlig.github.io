  "instructions": [
    {
      "id": 525171,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lime\n½ red bell pepper\n1 mango\n½ avocado\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 525172,
      "primary_message": "Place turkey, bread crumbs, egg, and spices in a medium bowl; mix with your hands until well combined. Form the turkey mixture into 2 equal-sized patties and place on a plate.",
      "secondary_message": "¾ lb ground turkey\n¼ cup panko bread crumbs\n1 egg\n½ tsp basil, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 525173,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 525174,
      "primary_message": "While the skillet heats up, zest and juice lime into a small bowl. Add mayo and spices, then whisk to combine the aioli. Set aside.",
      "secondary_message": "3 tbsp mayonnaise\n¼ tsp garlic powder\n⅛ tsp cayenne pepper\n⅛ tsp salt"
    },
    {
      "id": 525175,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, until golden underneath, about 5 minutes; flip patties and cook an additional 5-6 minutes, until cooked through. Remove from heat.",
      "secondary_message": "1 tsp neutral vegetable oil"
    },
    {
      "id": 525176,
      "primary_message": "Meanwhile, trim, seed, and slice bell pepper lengthwise into thin strips. Place on a clean plate.",
      "secondary_message": null
    },
    {
      "id": 525177,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; thinly slice the flesh. Add to the plate with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 525178,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 525179,
      "primary_message": "To serve, divide spinach between plates or bowls. Top with bell pepper, mango, avocado, and burger patties. Drizzle with aioli and enjoy!",
      "secondary_message": null
    }
  ],
