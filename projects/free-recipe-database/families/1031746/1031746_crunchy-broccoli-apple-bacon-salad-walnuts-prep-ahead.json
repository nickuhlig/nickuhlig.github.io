  "instructions": [
    {
      "primary_message": "This recipe utilizes 2 medium food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, medium dice bacon.\n\n",
      "secondary_message": "4 slice bacon"
    },
    {
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 3-4 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.\n\n",
      "secondary_message": "½ lemon\n2 crown broccoli\n1 Gala apple"
    },
    {
      "primary_message": "Juice lemon into a medium bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Using a clean cutting board, peel and mince garlic. Add to the bowl with the lemon juice along with mayo, honey, salt, and pepper, then whisk to combine the dressing.\n\n",
      "secondary_message": "1 clove garlic\n1 ½ tbsp mayonnaise\n½ tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the dressing.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter, core, and medium dice apple. Add to the bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop walnuts. Add to the bowl, along with shredded carrot, cranberries, and crispy bacon. Stir to combine the salad and divide between the containers.\n\n",
      "secondary_message": "½ cup walnuts\n½ (10 oz) bag shredded carrots\n¼ cup dried cranberries"
    },
    {
      "primary_message": "Cover containers and refrigerate until ready to eat (best if eaten within 2-3 days). Enjoy!",
      "secondary_message": null
    }
  ],
