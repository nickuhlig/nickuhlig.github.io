  "instructions": [
    {
      "id": 160258,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n4 medium zucchini squash\n4 jalapeño peppers"
    },
    {
      "id": 160259,
      "primary_message": "Trim off the root end and the dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch half-moons. ",
      "secondary_message": null
    },
    {
      "id": 160260,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 160261,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add leeks and cook, stirring occasionally, until soft, 3-4 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 160262,
      "primary_message": "Meanwhile, halve zucchinis lengthwise, then thinly slice crosswise into half rounds. Add to the pot with the leeks.",
      "secondary_message": null
    },
    {
      "id": 160263,
      "primary_message": "Add flour to the pot; cook, stirring constantly, until combined, about 1 minute. ",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 160264,
      "primary_message": "Gradually stir milk into the pot, then add the broth, salt, and pepper. Bring to a boil over high heat, then reduce heat to low and simmer, covered, for 10 minutes, or until zucchini is tender.",
      "secondary_message": "710 ml whole milk\n473 ml chicken or vegetable broth\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 160265,
      "primary_message": "Meanwhile, quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Slice lengthwise into thin strips. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 160266,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 160267,
      "primary_message": "Coarsely grate cheddar. ",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 160268,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the jalapeño strips and cook, stirring often, until soft and golden, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 160269,
      "primary_message": "Top half of the bread slices with half of the cheddar. Add jalapeño strips and cover with remaining cheese. Close sandwiches and gently press to secure ingredients. ",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 160270,
      "primary_message": "Return skillet to the stove over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 160271,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, place sandwiches in the skillet and cook, flipping once, until bread is golden brown and cheese is melted, 3-4 minutes per side. Once done, transfer to a cutting board; slice sandwiches in half. ",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 160272,
      "primary_message": "Using an immersion (hand) blender (or regular blender), purée the soup until smooth.",
      "secondary_message": null
    },
    {
      "id": 160273,
      "primary_message": "To serve, divide soup between bowls. Serve with sandwiches and enjoy! ",
      "secondary_message": null
    }
  ],
