  "instructions": [
    {
      "id": 160242,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 leek\n2 medium zucchini squash\n2 jalapeño peppers"
    },
    {
      "id": 160243,
      "primary_message": "Trim off the root end and the dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch half-moons. ",
      "secondary_message": null
    },
    {
      "id": 160244,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 160245,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom. Add the leek and cook, stirring occasionally, until soft, about 3 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 160246,
      "primary_message": "Meanwhile, halve zucchinis lengthwise, then thinly slice crosswise into half rounds. Add to the saucepan with the leeks.",
      "secondary_message": null
    },
    {
      "id": 160247,
      "primary_message": "Add flour to the saucepan; cook, stirring constantly, until combined, about 1 minute. ",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 160248,
      "primary_message": "Gradually stir milk into the saucepan, then add the broth, salt, and pepper. Bring to a boil over high heat, then reduce heat to low and simmer, covered, for 10 minutes, or until zucchini is tender.",
      "secondary_message": "355 ml whole milk\n237 ml chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 160249,
      "primary_message": "Meanwhile, quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Slice lengthwise into thin strips. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 160250,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 160251,
      "primary_message": "Coarsely grate cheddar. ",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 160252,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the jalapeño strips and cook, stirring often, until soft and golden, 2-3 minutes. Remove from heat.",
      "secondary_message": "½ tsp butter, unsalted"
    },
    {
      "id": 160253,
      "primary_message": "Top half of the bread slices with half of the cheddar. Add jalapeño strips and cover with remaining cheese. Close sandwiches and gently press to secure ingredients. ",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 160254,
      "primary_message": "Return skillet to the stove over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 160255,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook, flipping once, until bread is golden brown and cheese is melted, 3-4 minutes per side. Once done, transfer to a cutting board; slice sandwiches in half. ",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 160256,
      "primary_message": "Using an immersion (hand) blender (or regular blender), purée the soup until smooth.",
      "secondary_message": null
    },
    {
      "id": 160257,
      "primary_message": "To serve, divide soup between bowls. Serve with sandwiches and enjoy! ",
      "secondary_message": null
    }
  ],
