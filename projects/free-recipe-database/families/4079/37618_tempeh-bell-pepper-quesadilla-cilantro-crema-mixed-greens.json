  "instructions": [
    {
      "id": 588692,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lime\n½ small bunch cilantro\n1 small bunch green onions (scallions)\n1 red bell pepper\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 588693,
      "primary_message": "Juice lime and divide between a small and medium bowl. (Set medium bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 588694,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the small bowl with the lime juice along with yogurt and spices, then whisk to combine the crema. Set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n⅛ tsp salt\n1 pinch black pepper\n1 pinch chili powder"
    },
    {
      "id": 588695,
      "primary_message": "Trim and halve green onions crosswise. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 588696,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl with the green onions. ",
      "secondary_message": null
    },
    {
      "id": 588697,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 588698,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces. Add to the bowl.",
      "secondary_message": "1 (227g ) pkg tempeh"
    },
    {
      "id": 588699,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, tempeh, soy sauce, and spices; cook, stirring occasionally, until veggies are fork-tender and tempeh is golden, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp soy sauce\n1 tsp chili powder\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 588700,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 588701,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide tempeh and veggies between them, arranging on one half of each tortilla. Top with cheese and fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 588702,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 588703,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place assembled quesadillas in the skillet and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 588704,
      "primary_message": "Meanwhile, add Dijon, honey, and salt to the medium bowl with the lime juice, then whisk to combine the dressing. Add mixed greens and toss to coat.",
      "secondary_message": "1 tsp Dijon mustard\n1 tsp honey\n⅛ tsp salt"
    },
    {
      "id": 588705,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salad and lime crema on the side. Enjoy!",
      "secondary_message": null
    }
  ],
