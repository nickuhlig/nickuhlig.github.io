  "instructions": [
    {
      "id": 588594,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 limes\n1 small bunch cilantro\n3 small bunches green onions (scallions)\n3 red bell peppers\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 588595,
      "primary_message": "Juice limes and divide between a small and large bowl. (Set large bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 588596,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the small bowl with the lime juice along with yogurt and spices, then whisk to combine the crema. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n½ tsp salt\n3 pinch black pepper\n3 pinch chili powder"
    },
    {
      "id": 588597,
      "primary_message": "Trim and halve green onions crosswise. Place in another large bowl.",
      "secondary_message": null
    },
    {
      "id": 588598,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the green onions. ",
      "secondary_message": null
    },
    {
      "id": 588599,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 588600,
      "primary_message": "While the skillet heats up, pat pork dry with paper towels and slice crosswise into thin strips. Add to the bowl.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 588601,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, pork, and spices; cook, stirring occasionally, until veggies are fork-tender and pork is just cooked through, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 588602,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 588603,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide pork and veggies between them, arranging on one half of each tortilla. Top with cheese and fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 588604,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 588605,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 588606,
      "primary_message": "Meanwhile, add Dijon, honey, and salt to the large bowl with the lime juice, then whisk to combine the dressing. Add mixed greens and toss to coat.",
      "secondary_message": "1 tbsp Dijon mustard\n1 tbsp honey\n½ tsp salt"
    },
    {
      "id": 588607,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salad and lime crema on the side. Enjoy!",
      "secondary_message": null
    }
  ],
