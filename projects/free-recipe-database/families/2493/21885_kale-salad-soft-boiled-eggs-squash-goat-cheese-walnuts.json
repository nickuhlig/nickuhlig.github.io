  "instructions": [
    {
      "id": 367741,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 367742,
      "primary_message": "Wash, dry, trim, and peel each squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Transfer to a large baking sheet pan. ",
      "secondary_message": "1 ½ small butternut squash"
    },
    {
      "id": 367743,
      "primary_message": "Drizzle squash with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 367744,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, 20-25 minutes. Remove from oven and let cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 367745,
      "primary_message": "Meanwhile, place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 367746,
      "primary_message": "While the eggs are cooking, place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp apple cider vinegar\n3 tbsp Dijon mustard\n2 tbsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 367747,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 367748,
      "primary_message": "Wash and dry kale. Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl. Using your hands, massage kale with the dressing until wilted, about 2 minutes.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 367749,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "1 cup walnuts"
    },
    {
      "id": 367750,
      "primary_message": "Crumble goat cheese into the bowl.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 367751,
      "primary_message": "Peel and halve the eggs.",
      "secondary_message": null
    },
    {
      "id": 367752,
      "primary_message": "Once the squash is cool, add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 367753,
      "primary_message": "To serve, divide salad between plates or bowls and top with eggs. Enjoy!",
      "secondary_message": null
    }
  ],
