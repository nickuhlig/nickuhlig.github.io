  "instructions": [
    {
      "id": 367685,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 367686,
      "primary_message": "Wash, dry, trim, and peel squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Transfer to a baking sheet pan.",
      "secondary_message": "1 small butternut squash"
    },
    {
      "id": 367687,
      "primary_message": "Drizzle squash with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 367688,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, about 20 minutes. Remove from oven and let cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 367689,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 367690,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 367691,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken cutlets and pan-fry until golden and cooked through, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 367692,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n2 tbsp Dijon mustard\n2 tbsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 367693,
      "primary_message": "Using a clean cutting board, peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 367694,
      "primary_message": "Wash and dry kale. Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": "2 bunches kale"
    },
    {
      "id": 367695,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 367696,
      "primary_message": "Crumble goat cheese into the bowl. ",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 367697,
      "primary_message": "Once the squash is cool, add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 367698,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 367699,
      "primary_message": "To serve, divide salad between plates or bowls and top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
