  "instructions": [
    {
      "id": 495861,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg cremini mushrooms\n2 (142 g) pkgs baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 495862,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 495863,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495864,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Add to the bowl with the mushrooms.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 495865,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and onion; cook, stirring occasionally, until starting to soften, 2-3 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 495866,
      "primary_message": "Add orzo, broth, and spices to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes.",
      "secondary_message": "283 g orzo pasta\n946 ml chicken or vegetable broth\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 495867,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 495868,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 495869,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 495870,
      "primary_message": "When the broth is mostly absorbed, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 495871,
      "primary_message": "Add half of the basil (reserve remaining basil for serving), Parmesan, and cream to the skillet. Continue to cook, stirring frequently, until thickened, 2-3 minutes more. Remove from heat.",
      "secondary_message": "237 ml heavy whipping cream"
    },
    {
      "id": 495872,
      "primary_message": "To serve, divide orzo between plates or bowls. Top with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
