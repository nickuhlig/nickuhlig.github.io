  "instructions": [
    {
      "id": 495873,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1.02 kg cremini mushrooms\n3 (142 g) pkgs baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 495874,
      "primary_message": "Thinly slice mushrooms. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 495875,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495876,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Add to the bowl with the mushrooms.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 495877,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms and onion; cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 495878,
      "primary_message": "Add orzo, broth, and spices to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes.",
      "secondary_message": "425 g orzo pasta\n1420 ml chicken or vegetable broth\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp garlic powder\n¾ tsp black pepper"
    },
    {
      "id": 495879,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 495880,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 495881,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 495882,
      "primary_message": "When the broth is mostly absorbed, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 495883,
      "primary_message": "Add half of the basil (reserve remaining basil for serving), Parmesan, and cream to the pot. Continue to cook, stirring frequently, until thickened, 3-4 minutes more. Remove from heat.",
      "secondary_message": "355 ml heavy whipping cream"
    },
    {
      "id": 495884,
      "primary_message": "To serve, divide orzo between plates or bowls. Top with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
