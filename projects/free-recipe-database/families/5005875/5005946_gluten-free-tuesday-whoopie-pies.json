  "instructions": [
    {
      "id": 1,
      "primary_message": "For the cookies Center oven rack to middle position and preheat oven to 175°C (350°F). Line a baking sheet with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In small mixing bowl, whisk together white rice flour, sweet rice flour, cocoa powder, tapioca starch, baking soda, salt, and xanthan gum.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fit stand mixer with paddle attachment. In bowl of stand mixer, cream together butter and brown sugar until butter-sugar paste lightens slightly, about one minute. (Use medium high-speed on a stand mixer. If using a handheld mixer, use high speed.) Turn off mixer. Scrape down sides and bottom of bowl. Add egg and vanilla extract. Turn mixer back on. Cream until egg is thoroughly incorporated, about one minute. Scrape down bottom and sides of bowl. Mix for 15 seconds.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add 1/3 of the dry ingredients. Mix until combined. Add half the buttermilk. Mix until batter is smooth. Add another 1/3 of the dry ingredients. Mix until combined. Add remaining buttermilk. Add remaining dry ingredients. Mix batter until smooth and thick, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Scoop six mounds of batter, about 1/4 cup each, onto prepared baking sheet. Space cookies several inches apart as they spread during baking.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Bake until cookies are set and spring back to the touch, about 18 minutes.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Remove pan from oven. Allow cookies to cool on pan for one minute. Using a metal spatula, transfer cookies to wire rack to cool. Repeat with remaining batter.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "While cookies cool, make filling. (method below) Sandwich cooled cookies together with icing.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "For the filling In medium mixing bowl, cream together butter and confectioners’ sugar until light and fluffy, about 30 seconds. (Use high speed on a handheld mixer or medium-high speed on a stand mixer.)",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "Add marshmallow crème and vanilla. Mix until fluffy.",
      "secondary_message": null
    }
  ],
