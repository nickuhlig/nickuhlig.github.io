  "instructions": [
    {
      "id": 336900,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n2 medium carrots\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley\n2 Granny Smith apples"
    },
    {
      "id": 336901,
      "primary_message": "Quarter potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 336902,
      "primary_message": "Meanwhile, place vinegar, sugar, dill, and salt in a medium bowl; whisk to combine the pickling liquid. ",
      "secondary_message": "¼ cup apple cider vinegar\n4 tsp brown sugar\n½ tsp dill, dried\n¼ tsp salt"
    },
    {
      "id": 336903,
      "primary_message": "Peel, trim, and halve carrots lengthwise, then slice crosswise into thin half-moons; add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 336904,
      "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons; add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 336905,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 336906,
      "primary_message": "Peel and mince garlic. Add to the bowl with the parsley along with oil, vinegar, Dijon, salt, and pepper; whisk to combine the dressing and set aside. ",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n4 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 336907,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 336908,
      "primary_message": "While the grill pan heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 336909,
      "primary_message": "Once the grill pan is hot, coat with oil; add pork chops and grill until golden and cooked through, 3-4 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and let rest, 5 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 336910,
      "primary_message": "When the potatoes are done, drain and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 336911,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 336912,
      "primary_message": "Quarter, core, and small dice apples; add to the bowl and stir to combine the potato salad. ",
      "secondary_message": null
    },
    {
      "id": 336913,
      "primary_message": "To serve, divide pork chops, potato salad, and pickled veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
