  "instructions": [
    {
      "id": 336844,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb new potatoes\n1 medium carrot\n½ English cucumber\n½ small bunch Italian (flat-leaf) parsley\n1 Granny Smith apple"
    },
    {
      "id": 336845,
      "primary_message": "Quarter potatoes; place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 336846,
      "primary_message": "Meanwhile, place vinegar, sugar, dill, and salt in a small bowl; whisk to combine the pickling liquid. ",
      "secondary_message": "2 tbsp apple cider vinegar\n2 tsp brown sugar\n¼ tsp dill, dried\n⅛ tsp salt"
    },
    {
      "id": 336847,
      "primary_message": "Peel, trim, and halve carrot lengthwise, then slice crosswise into thin half-moons; add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 336848,
      "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons; add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 336849,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 336850,
      "primary_message": "Peel and mince garlic. Add to the bowl with the parsley along with oil, vinegar, Dijon, salt, and pepper; whisk to combine the dressing and set aside. ",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 336851,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 336852,
      "primary_message": "While the grill pan heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 336853,
      "primary_message": "Once the grill pan is hot, coat with oil; add pork chops and grill until golden and cooked through, 3-4 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and let rest, 5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 336854,
      "primary_message": "When the potatoes are done, drain and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 336855,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 336856,
      "primary_message": "Quarter, core, and small dice apple; add to the bowl and stir to combine the potato salad. ",
      "secondary_message": null
    },
    {
      "id": 336857,
      "primary_message": "To serve, divide pork chops, potato salad, and pickled veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
