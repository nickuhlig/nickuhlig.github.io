  "instructions": [
    {
      "id": 6763,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": ""
    },
    {
      "id": 10063,
      "primary_message": "If using frozen shrimp, place in a bowl and cover with cold water to thaw. Set aside.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 10064,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 10065,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "1 medium yellow onion\r\n4 cloves garlic"
    },
    {
      "id": 10066,
      "primary_message": "Coat bottom of sauté pan with oil. Add onion, and stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "about 2 tbsp extra virgin olive oil"
    },
    {
      "id": 10067,
      "primary_message": "Add garlic, oregano, and pepper; cook until fragrant, 15-30 seconds.",
      "secondary_message": "2 tsp oregano\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 10068,
      "primary_message": "Add tomatoes and bring to a boil. Reduce heat to medium-low and simmer until tomato juices thicken, 5-7 minutes.",
      "secondary_message": "2 (398 ml) cans diced tomatoes"
    },
    {
      "id": 10069,
      "primary_message": "Drain shrimp and rinse under cold water until there are no more ice chunks. Place on paper towels and pat dry.",
      "secondary_message": ""
    },
    {
      "id": 10070,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 10071,
      "primary_message": "Remove sauté pan from heat. Stir in ¾ of the minced parsley (save the rest for garnishing), shrimp, salt, and pepper. Sprinkle feta over top.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 10072,
      "primary_message": "Place in the oven and bake until shrimp are opaque and cheese melts, 8-12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 10073,
      "primary_message": "Drizzle the bread slices with olive oil, then place in the oven, directly on a rack, until crispy, 1-2 minutes.",
      "secondary_message": "4 slices whole grain bread\n2 tsp extra virgin olive oil"
    },
    {
      "id": 10074,
      "primary_message": "To serve, place shrimp on a plate and garnish with remaining parsley. Serve with crusty bread. Enjoy!",
      "secondary_message": ""
    }
  ],
