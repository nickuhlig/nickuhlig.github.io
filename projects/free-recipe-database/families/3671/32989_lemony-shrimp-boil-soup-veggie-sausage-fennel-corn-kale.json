  "instructions": [
    {
      "id": 520062,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb new potatoes\n1 fennel bulb\n½ bunch kale\n½ lemon"
    },
    {
      "id": 520063,
      "primary_message": "Quarter new potatoes. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 520064,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 520065,
      "primary_message": "While the pan heats up, slice sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 520066,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until golden brown, 2-3 minutes. (Or cook according to package instructions.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 520067,
      "primary_message": "Meanwhile, trim off root end and dark green stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise and medium dice. Add to the bowl with the potato.",
      "secondary_message": null
    },
    {
      "id": 520068,
      "primary_message": "When the sausage is done, add potato, fennel, broth, tomato sauce, corn, and spices to the pan. Stir to combine and bring the soup to a boil. Once boiling, reduce to a simmer and cook, stirring occasionally, until potatoes are fork-tender, 10-12 minutes. (Reserve bowl for later use.)",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 (8 oz) can tomato sauce\n⅔ cup frozen corn\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 520069,
      "primary_message": "While the soup is cooking, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 520070,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 520071,
      "primary_message": "When the potatoes are tender, add kale to the pan in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 520072,
      "primary_message": "Add shrimp to the soup and stir to combine. Continue to cook, stirring occasionally, until shrimp are cooked through and kale is tender, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 520073,
      "primary_message": "Meanwhile, cut lemon into wedges.",
      "secondary_message": null
    },
    {
      "id": 520074,
      "primary_message": "To serve, divide soup between bowls. Squeeze lemon over top and enjoy!",
      "secondary_message": null
    }
  ],
