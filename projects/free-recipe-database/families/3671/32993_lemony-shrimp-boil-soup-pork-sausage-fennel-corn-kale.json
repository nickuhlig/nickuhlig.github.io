  "instructions": [
    {
      "id": 520114,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg new potatoes\n2 fennel bulbs\n1 bunch kale\n1 lemon"
    },
    {
      "id": 520115,
      "primary_message": "Quarter new potatoes. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 520116,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 520117,
      "primary_message": "While the pot heats up, slice sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 520118,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until browned and cooked through, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 520119,
      "primary_message": "Meanwhile, using a clean cutting board, trim off root end and dark green stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise and medium dice. Add to the bowl with the potato.",
      "secondary_message": null
    },
    {
      "id": 520120,
      "primary_message": "When the sausage is done, add potato, fennel, broth, tomato sauce, corn, and spices to the pot. Stir to combine and bring the soup to a boil. Once boiling, reduce to a simmer and cook, stirring occasionally, until potatoes are fork-tender, 10-12 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1420 ml chicken or vegetable broth\n2 (213 ml) cans tomato sauce\n1 ⅓ cups frozen corn\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 520121,
      "primary_message": "While the soup is cooking, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.45 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 520122,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 520123,
      "primary_message": "When the potatoes are tender, add kale to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 520124,
      "primary_message": "Add shrimp to the soup and stir to combine. Continue to cook, stirring occasionally, until shrimp are cooked through and kale is tender, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 520125,
      "primary_message": "Meanwhile, cut lemon into wedges.",
      "secondary_message": null
    },
    {
      "id": 520126,
      "primary_message": "To serve, divide soup between bowls. Squeeze lemon over top and enjoy!",
      "secondary_message": null
    }
  ],
