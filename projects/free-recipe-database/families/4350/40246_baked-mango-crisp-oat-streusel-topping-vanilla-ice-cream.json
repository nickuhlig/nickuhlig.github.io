  "instructions": [
    {
      "id": 623221,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 623222,
      "primary_message": "Place flour, oats, sugar, and salt in a small bowl. Stir to combine.",
      "secondary_message": "½ cup all-purpose flour\n¼ cup oats, quick cooking\n¼ cup brown sugar\n¼ tsp salt"
    },
    {
      "id": 623223,
      "primary_message": "Place butter in a small saucepan and melt over medium heat, stirring occasionally. Add melted butter to the bowl with flour mixture and stir to combine the streusel. Set aside.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 623224,
      "primary_message": "Wash, dry, and peel mangoes. Slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Place in a medium bowl along with sugar, flour, and cinnamon, then stir to combine.",
      "secondary_message": "4 mangoes\n¼ cup brown sugar\n2 tbsp all-purpose flour\n½ tsp cinnamon, ground"
    },
    {
      "id": 623225,
      "primary_message": "Transfer mango mixture to a baking dish and spread out in an even layer. Using your hands, slightly break up the streusel and sprinkle over the mango.",
      "secondary_message": null
    },
    {
      "id": 623226,
      "primary_message": "Place baking dish in oven (it doesn't have to be fully heated) and baked until mango is soft and streusel is golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623227,
      "primary_message": "To serve, divide mango crisp and ice cream between bowls. Enjoy!",
      "secondary_message": "24 fl oz (3 cups) vanilla ice cream"
    }
  ],
