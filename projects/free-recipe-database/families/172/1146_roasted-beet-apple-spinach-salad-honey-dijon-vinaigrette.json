  "instructions": [
    {
      "id": 9158,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": ""
    },
    {
      "id": 9159,
      "primary_message": "Wash, trim ends, peel, and medium dice beets. Transfer to a sheet pan. Drizzle with oil, season with salt and pepper, and toss to coat.",
      "secondary_message": "4 beets\r\n1 tbsp extra virgin olive oil\r\n1 pinch salt\r\n1 pinch black pepper"
    },
    {
      "id": 9160,
      "primary_message": "Place in the oven and roast until beets are tender, about 20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 9161,
      "primary_message": "In a small bowl, prepare dressing by whisking together oil, vinegar, honey, Dijon, salt, and pepper. Set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n1 tbsp honey\r\n2 tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 9162,
      "primary_message": "Wash and dry spinach. Wash, core and slice apple into thin wedges. Transfer both to a large bowl.",
      "secondary_message": "½ (5 oz) pkg baby spinach\r\n1 Granny Smith apple"
    },
    {
      "id": 9163,
      "primary_message": "Shell pistachios. Crumble goat cheese into a small bowl.",
      "secondary_message": "⅛ cup pistachios, roasted unsalted\r\n½ (4 oz) log goat cheese"
    },
    {
      "id": 9164,
      "primary_message": "Remove beets from oven and add to bowl with spinach and apple. Toss salad.",
      "secondary_message": ""
    },
    {
      "id": 9165,
      "primary_message": "To serve, place salad on a plate, sprinkle with pistachios and goat cheese, and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
