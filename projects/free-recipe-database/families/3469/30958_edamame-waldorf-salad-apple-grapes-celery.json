  "instructions": [
    {
      "id": 490362,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 stick celery\n⅓ lb red grapes\n1 Granny Smith apple"
    },
    {
      "id": 490363,
      "primary_message": "Zest and juice lemon into a medium bowl, then add mayo, water, sugar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp vegan mayonnaise\n1 tsp water\n½ tsp brown sugar\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 490364,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 490365,
      "primary_message": "Halve grapes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 490366,
      "primary_message": "Quarter, core, and small dice apple. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 490367,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl and stir to combine the salad.",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 490368,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
