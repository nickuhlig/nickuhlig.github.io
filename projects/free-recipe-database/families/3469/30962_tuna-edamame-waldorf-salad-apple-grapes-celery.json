  "instructions": [
    {
      "id": 490391,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 sticks celery\n0.3 kg red grapes\n2 Granny Smith apples"
    },
    {
      "id": 490392,
      "primary_message": "Zest and juice lemon into a medium bowl, then add yogurt, sugar, and spices. Whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tsp brown sugar\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 490393,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 490394,
      "primary_message": "Halve grapes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 490395,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 490396,
      "primary_message": "Drain tuna and flake with a fork. Add to the bowl.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 490397,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl and stir to combine the salad.",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 490398,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
