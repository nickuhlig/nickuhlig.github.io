  "instructions": [
    {
      "id": 164294,
      "primary_message": "In a small bowl combine spices. Pat the steak dry with paper towel, season both sides with spice mixture, and set aside.",
      "secondary_message": "1 ½ tsp coriander\n1 ½ tsp salt\n¾ tsp cayenne pepper\n2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 164295,
      "primary_message": "In a small saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n3 cup water"
    },
    {
      "id": 164296,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n1 ½ small bunches Italian (flat-leaf) parsley\n3 lemons\n3 pints grape tomatoes"
    },
    {
      "id": 164297,
      "primary_message": "Peel and mince shallot and garlic. Add both to a large bowl.",
      "secondary_message": "3 shallots\n3 cloves garlic"
    },
    {
      "id": 164298,
      "primary_message": "Grate zest from half of the lemon; juice the entire lemon. Place zest and juice into the bowl with the garlic and shallot. Add olive oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 164299,
      "primary_message": "Halve the grape tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 164300,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 164301,
      "primary_message": "Medium dice the bell pepper and add to the bowl with the dressing and tomatoes.",
      "secondary_message": null
    },
    {
      "id": 164302,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 164303,
      "primary_message": "Place seasoned steaks on the pan and cook until preferred degree of doneness, 3-4 minutes per side for medium. Remove steaks from the pan and allow to rest for 5 minutes. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 164304,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the vegetables.",
      "secondary_message": null
    },
    {
      "id": 164305,
      "primary_message": "Once the quinoa is finished, fluff with a fork and add to the bowl with the dressing and vegetables. Toss to combine.",
      "secondary_message": null
    },
    {
      "id": 164306,
      "primary_message": "To serve, slice steak into thin strips and divide between plates along with the salad. Enjoy!",
      "secondary_message": null
    }
  ],
