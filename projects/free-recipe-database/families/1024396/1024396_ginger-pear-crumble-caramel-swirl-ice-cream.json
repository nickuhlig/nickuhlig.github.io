  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Drain pears in a colander, reserving ¾-cup juice. Transfer juice to a medium bowl along with sugar, cornstarch, vanilla, and cinnamon. Whisk to combine. ",
      "secondary_message": "4 (15 oz) can sliced pears, in juice\n¼ cup brown sugar\n1 tbsp cornstarch\n1 tsp vanilla extract\n½ tsp cinnamon, ground"
    },
    {
      "primary_message": "Roughly chop drained pears and add to the bowl with the juice mixture.",
      "secondary_message": null
    },
    {
      "primary_message": "Mince ginger. Small dice butter. Add both to the bowl, stir to combine, and transfer to an 8-inch square baking dish. Set aside. (Wipe bowl clean with paper towels and reserve for the next step.)",
      "secondary_message": "1 tbsp candied (crystallized) ginger\n1 tbsp butter, unsalted"
    },
    {
      "primary_message": "Place oats, flour, sugar, and spices in the reserved bowl and stir to combine.",
      "secondary_message": "1 cup oats, quick cooking\n1 cup all-purpose flour\n⅓ cup brown sugar\n¾ tsp cinnamon, ground\n½ tsp nutmeg, ground\n⅛ tsp salt"
    },
    {
      "primary_message": "Using a box grater, coarsely grate cold butter into the bowl with the flour. Using two hands, combine the flour and butter by rubbing the mixture between your thumbs and fingers until it looks crumbly.",
      "secondary_message": "butter, unsalted"
    },
    {
      "primary_message": "Place ginger snap cookies in a small bowl. Using a potato masher or back of a spoon, roughly crush. Add crushed cookies to the bowl with the flour mixture and stir to combine. Sprinkle crumble topping over the pear mixture. ",
      "secondary_message": null
    },
    {
      "primary_message": "Place baking dish in the oven and bake until pears are bubbling and topping is golden, 20-25 minutes. Remove from oven and set aside to cool slightly, 15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide warm crumble between bowls. Top with ice cream and enjoy!",
      "secondary_message": "32 fl oz caramel swirl ice cream"
    }
  ],
