  "instructions": [
    {
      "primary_message": "Slice Overjoyed™ mini angel food cakes in half horizontally and set the top portion aside. Scoop Ben and Jerry’s® Strawberries & Cream Scoop-a-palooza Ice Cream onto the bottom half of the cake and smooth it out a bit with an offset spatula or butter knife. Place angel food cake on top of ice cream. Repeat until all cakes are assembled with the ice cream. Cover and return to the freezer until ready to serve.",
      "secondary_message": null
    },
    {
      "primary_message": "To assemble, place ½-cup sliced strawberries on each plate. Top with angel food cakes. Add whipped topping to the top of the cakes and garnish with a whole strawberry. Serve.",
      "secondary_message": null
    }
  ],
