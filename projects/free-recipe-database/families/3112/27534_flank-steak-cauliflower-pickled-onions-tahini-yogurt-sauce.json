  "instructions": [
    {
      "id": 442633,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 442634,
      "primary_message": "Place vinegar and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup red wine vinegar\n1 ½ tsp salt"
    },
    {
      "id": 442635,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 442636,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium heads cauliflower\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 442637,
      "primary_message": "Separate each cauliflower head into bite-sized florets and cut stems into smaller pieces. Divide between two large baking sheet pans, drizzle with oil, and season with salt. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 442638,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the cauliflower is golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 442639,
      "primary_message": "Meanwhile, zest and juice lemons into another medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 442640,
      "primary_message": "Add yogurt, tahini, water, pepper, and salt to the bowl with the lemon. Whisk to combine.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp tahini\n3 tbsp water\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 442641,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the yogurt, whisk once more to combine the sauce, and set aside. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 442642,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 442643,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb flank steaks\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 442644,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add steak and cook until desired doneness, 2-3 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 442645,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 442646,
      "primary_message": "To serve, divide steak and yogurt sauce between plates; top yogurt with cauliflower and pickled onions. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
