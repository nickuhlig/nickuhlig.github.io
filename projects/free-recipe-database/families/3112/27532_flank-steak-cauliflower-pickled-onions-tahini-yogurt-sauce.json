  "instructions": [
    {
      "id": 442605,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 442606,
      "primary_message": "Place vinegar and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp red wine vinegar\n½ tsp salt"
    },
    {
      "id": 442607,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 442608,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n½ lemon\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 442609,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 442610,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the cauliflower is golden and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 442611,
      "primary_message": "Meanwhile, zest and juice lemon into another small bowl. ",
      "secondary_message": null
    },
    {
      "id": 442612,
      "primary_message": "Add yogurt, tahini, water, pepper, and salt to the bowl with the lemon. Whisk to combine.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp tahini\n1 tbsp water\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 442613,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the yogurt, whisk once more to combine the sauce, and set aside. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 442614,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 442615,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "¾ lb flank steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 442616,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-3 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 442617,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 442618,
      "primary_message": "To serve, divide steak and yogurt sauce between plates; top yogurt with cauliflower and pickled onions. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
