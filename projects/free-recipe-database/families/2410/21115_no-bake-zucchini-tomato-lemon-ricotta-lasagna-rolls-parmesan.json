  "instructions": [
    {
      "id": 353436,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 353437,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 medium zucchini squash\n2 tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 353438,
      "primary_message": "Once the water in the pan is boiling, uncover, add salt and noodles, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once done, drain in a colander, rinse with cold water, and set aside.",
      "secondary_message": "½ tsp salt\n6 no-boil lasagna noodles"
    },
    {
      "id": 353439,
      "primary_message": "While the noodles are cooking, zest and juice lemon into a small bowl. Add ricotta, salt, and pepper; whisk to combine and set aside.",
      "secondary_message": "½ (15 oz) pkg ricotta cheese\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 353440,
      "primary_message": "Trim and small dice zucchini; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 353441,
      "primary_message": "Small dice tomatoes and add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 353442,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 353443,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 353444,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies are tender, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 353445,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 353446,
      "primary_message": "When the veggies are done, remove from heat, add half of the basil, and stir to combine. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 353447,
      "primary_message": "To assemble the rolls, arrange noodles on a flat surface. Spread each noodle with one tablespoon ricotta mixture, top with two tablespoons veggie mixture, then roll to close. (Assemble in batches if necessary.)",
      "secondary_message": null
    },
    {
      "id": 353448,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "½ oz Parmesan cheese"
    },
    {
      "id": 353449,
      "primary_message": "To serve, divide lasagna rolls between plates; top with Parmesan and remaining basil. Enjoy! ",
      "secondary_message": null
    }
  ],
