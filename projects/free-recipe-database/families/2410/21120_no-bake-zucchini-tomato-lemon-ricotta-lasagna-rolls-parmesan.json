  "instructions": [
    {
      "id": 353506,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 353507,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 medium zucchini squash\n6 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 353508,
      "primary_message": "Once the water in the pot is boiling, uncover, add salt and noodles, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once done, drain in a colander, rinse with cold water, and set aside.",
      "secondary_message": "1 ½ tsp salt\n18 no-boil lasagna noodles"
    },
    {
      "id": 353509,
      "primary_message": "While the noodles are cooking, zest and juice lemons into a medium bowl. Add ricotta, salt, and pepper; whisk to combine and set aside.",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 353510,
      "primary_message": "Trim and small dice zucchini; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 353511,
      "primary_message": "Small dice tomatoes and add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 353512,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl. ",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 353513,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 353514,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies are tender, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 353515,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 353516,
      "primary_message": "When the veggies are done, remove from heat, add half of the basil, and stir to combine. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 353517,
      "primary_message": "To assemble the rolls, arrange noodles on a flat surface. Spread each noodle with one tablespoon ricotta mixture, top with two tablespoons veggie mixture, then roll to close. (Assemble in batches if necessary.)",
      "secondary_message": null
    },
    {
      "id": 353518,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 353519,
      "primary_message": "To serve, divide lasagna rolls between plates; top with Parmesan and remaining basil. Enjoy! ",
      "secondary_message": null
    }
  ],
