  "instructions": [
    {
      "id": 478959,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 478960,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, about 8 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "1 tsp salt\n283 g orzo pasta"
    },
    {
      "id": 478961,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 medium carrots\n1 small bunch green onions (scallions)\n1 English cucumber\n2 red bell peppers"
    },
    {
      "id": 478962,
      "primary_message": "Peel and mince ginger. Place in a large bowl along with soy sauce, vinegar, oil, sesame seeds, maple syrup, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "½ cup soy sauce\n¼ cup rice vinegar\n2 tbsp toasted sesame oil\n2 tbsp sesame seeds\n4 tsp pure maple syrup\n1 tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 478963,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 478964,
      "primary_message": "While the skillet heats up, medium dice tofu and place in a medium bowl. Add soy sauce and spices, then stir to coat. Sprinkle with cornstarch and gently stir once more to coat.",
      "secondary_message": "2 tbsp soy sauce\n2 tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper\n4 tsp cornstarch"
    },
    {
      "id": 478965,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning occasionally, until browned and crispy, 5-7 minutes. Remove from heat. ",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 478966,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 478967,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 478968,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 478969,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl, along with cooled orzo, and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 478970,
      "primary_message": "To serve, divide orzo pasta salad between plates or bowls. Top with tofu and enjoy!",
      "secondary_message": null
    }
  ],
