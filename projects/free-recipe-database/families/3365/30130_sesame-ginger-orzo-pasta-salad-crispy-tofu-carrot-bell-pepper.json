  "instructions": [
    {
      "id": 478947,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 478948,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, about 8 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "½ tsp salt\n142 g orzo pasta"
    },
    {
      "id": 478949,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 medium carrot\n½ small bunch green onions (scallions)\n½ English cucumber\n1 red bell pepper"
    },
    {
      "id": 478950,
      "primary_message": "Peel and mince ginger. Place in a medium bowl along with soy sauce, vinegar, oil, sesame seeds, maple syrup, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "¼ cup soy sauce\n2 tbsp rice vinegar\n1 tbsp toasted sesame oil\n1 tbsp sesame seeds\n2 tsp pure maple syrup\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 478951,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 478952,
      "primary_message": "While the skillet heats up, medium dice tofu and place in another medium bowl. Add soy sauce and spices, then stir to coat. Sprinkle with cornstarch and gently stir once more to coat.",
      "secondary_message": "1 tbsp soy sauce\n1 tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper\n2 tsp cornstarch"
    },
    {
      "id": 478953,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning occasionally, until browned and crispy, 5-7 minutes. Remove from heat. ",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 478954,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate carrot. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 478955,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 478956,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 478957,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl, along with cooled orzo, and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 478958,
      "primary_message": "To serve, divide orzo pasta salad between plates or bowls. Top with tofu and enjoy!",
      "secondary_message": null
    }
  ],
