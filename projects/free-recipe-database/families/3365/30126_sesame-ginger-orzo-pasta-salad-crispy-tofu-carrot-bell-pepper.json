  "instructions": [
    {
      "id": 478899,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 478900,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, about 8 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "1 ½ tsp salt\n15 oz orzo pasta"
    },
    {
      "id": 478901,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 medium carrots\n1 small bunch green onions (scallions)\n1 ½ English cucumbers\n3 red bell peppers"
    },
    {
      "id": 478902,
      "primary_message": "Peel and mince ginger. Place in a large bowl along with soy sauce, vinegar, oil, sesame seeds, maple syrup, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "¾ cup soy sauce\n⅓ cup rice vinegar\n3 tbsp toasted sesame oil\n3 tbsp sesame seeds\n2 tbsp pure maple syrup\n1 ½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 478903,
      "primary_message": "Medium dice tofu and place in another large bowl. Add soy sauce and spices, then stir to coat. Sprinkle with cornstarch and gently stir once more to coat.",
      "secondary_message": "3 tbsp soy sauce\n1 tbsp garlic powder\n½ tsp salt\n½ tsp black pepper\n2 tbsp cornstarch"
    },
    {
      "id": 478904,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 478905,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, turning occasionally, until browned and crispy, 5-7 minutes. Remove from heat. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 478906,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 478907,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 478908,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 478909,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl, along with cooled orzo, and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 478910,
      "primary_message": "To serve, divide orzo pasta salad between plates or bowls. Top with tofu and enjoy!",
      "secondary_message": null
    }
  ],
