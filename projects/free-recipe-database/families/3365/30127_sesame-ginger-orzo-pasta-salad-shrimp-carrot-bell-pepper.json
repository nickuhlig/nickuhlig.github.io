  "instructions": [
    {
      "id": 478911,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, about 8 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "½ tsp salt\n142 g orzo pasta"
    },
    {
      "id": 478912,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 medium carrot\n½ small bunch green onions (scallions)\n½ English cucumber\n1 red bell pepper"
    },
    {
      "id": 478913,
      "primary_message": "Peel and mince ginger. Place in a medium bowl along with soy sauce, vinegar, oil, sesame seeds, honey, and spices. Whisk to combine the dressing. ",
      "secondary_message": "¼ cup soy sauce\n2 tbsp rice vinegar\n1 tbsp toasted sesame oil\n1 tbsp sesame seeds\n2 tsp honey\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 478914,
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 478915,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 478916,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 478917,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 478918,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 478919,
      "primary_message": "While the skillet heats up, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 478920,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper; cook, stirring occasionally, until just opaque, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 ½ tsp toasted sesame oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 478921,
      "primary_message": "Meanwhile, add cooled orzo to the bowl with the veggies and dressing. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 478922,
      "primary_message": "To serve, divide orzo pasta salad between plates or bowls. Top with shrimp and enjoy!",
      "secondary_message": null
    }
  ],
