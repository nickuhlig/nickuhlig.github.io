  "instructions": [
    {
      "id": 478851,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, about 8 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "1 tsp salt\n10 oz orzo pasta"
    },
    {
      "id": 478852,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 medium carrots\n1 small bunch green onions (scallions)\n1 English cucumber\n2 red bell peppers"
    },
    {
      "id": 478853,
      "primary_message": "Peel and mince ginger. Place in a large bowl along with soy sauce, vinegar, oil, sesame seeds, honey, and spices. Whisk to combine the dressing. ",
      "secondary_message": "½ cup soy sauce\n¼ cup rice vinegar\n2 tbsp toasted sesame oil\n2 tbsp sesame seeds\n4 tsp honey\n1 tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 478854,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 478855,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 478856,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 478857,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 478858,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 478859,
      "primary_message": "While the skillet heats up, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 478860,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper; cook, stirring occasionally, until just opaque, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 tbsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 478861,
      "primary_message": "Meanwhile, add cooled orzo to the bowl with the veggies and dressing. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 478862,
      "primary_message": "To serve, divide orzo pasta salad between plates or bowls. Top with shrimp and enjoy!",
      "secondary_message": null
    }
  ],
