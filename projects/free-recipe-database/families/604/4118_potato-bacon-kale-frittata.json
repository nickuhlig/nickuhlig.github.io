  "instructions": [
    {
      "id": 46283,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n½ bunch kale"
    },
    {
      "id": 46284,
      "primary_message": "Preheat the oven to the broil setting and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 46285,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 46286,
      "primary_message": "Cut the bacon crosswise into 6-mm-thick strips.",
      "secondary_message": "3 slices bacon"
    },
    {
      "id": 46287,
      "primary_message": "Once the skillet is hot, add the bacon strips. Cook, stirring occasionally, until the bacon is crispy, 4 to 6 minutes. Once done, transfer to a plate lined with paper towels, leaving the drippings in the skillet.",
      "secondary_message": ""
    },
    {
      "id": 46288,
      "primary_message": "While the bacon cooks, trim off and discard the ends of the shallot; peel and halve the shallot lengthwise, then thinly slice crosswise into half-rounds.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 46289,
      "primary_message": "Once the bacon has been transferred, add the shallot to the skillet; cook, stirring frequently, until softened, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 46290,
      "primary_message": "While the shallot cooks, medium dice the potato (cut into 1 ¼-cm cubes).",
      "secondary_message": ""
    },
    {
      "id": 46291,
      "primary_message": "Add the potatoes to the skillet; cook, stirring occasionally, until softened, 6 to 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 46292,
      "primary_message": "While the potatoes cook, cut out and discard the kale stems; chop the leaves crosswise into 2 ½-cm strips.",
      "secondary_message": null
    },
    {
      "id": 46293,
      "primary_message": "Add the kale to the skillet; cook, stirring, until it is wilted but still green, 4 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 46294,
      "primary_message": "While the kale cooks, in a medium bowl, combine and whisk together the eggs, water, salt, and pepper.",
      "secondary_message": "6 eggs\n2 tbsp water\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 46295,
      "primary_message": "Pour the egg mixture into the skillet and top with the bacon. While tilting the skillet with one hand, lift up the edges of the frittata with a spatula and let the egg mixture run underneath during the first few minutes of cooking. Cook until most of the frittata is set, but the top is still runny, 4 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 46296,
      "primary_message": "Transfer the skillet to the oven and broil until the top is set and lightly browned, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 46297,
      "primary_message": "To serve, separate the frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
