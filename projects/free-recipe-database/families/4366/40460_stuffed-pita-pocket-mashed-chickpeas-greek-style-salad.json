  "instructions": [
    {
      "id": 626392,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh basil\n¾ English cucumber\n3 tomatoes"
    },
    {
      "id": 626393,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a medium bowl along with oil, vinegar, and spices. Stir to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¾ tsp oregano, dried\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 626394,
      "primary_message": "Trim and small dice cucumber. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 626395,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 626396,
      "primary_message": "Roughly chop olives. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 626397,
      "primary_message": "Drain and rinse chickpeas. Pat dry with paper towels, then place in another medium bowl along with spices. Using a fork or potato masher, roughly mash chickpeas until semi-smooth. ",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 626398,
      "primary_message": "Cut pitas in half and carefully open the pockets. Fill each pocket with mashed chickpeas and salad.",
      "secondary_message": "3 whole grain pitas"
    },
    {
      "id": 626399,
      "primary_message": "To serve, divide pita pockets between plates and enjoy!",
      "secondary_message": null
    }
  ],
