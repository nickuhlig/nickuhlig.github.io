  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to lower-middle position and preheat oven to 150°C (300°F). Heat olive oil in a Dutch oven over high heat until smoking. Season beef with salt and pepper. Add beef to pan and cook without moving until well-browned on one side, about 6 minutes. Stir to loosen meat, and add onions and carrots. Cook, stirring, for 2 minutes, reduce heat to medium and add habaneros, garlic and rum. Bring to a boil and simmer for 2 minutes before adding chicken broth, allspice, cinnamon, hot pepper sauce, thyme, bay leaves, brown sugar, red wine vinegar, tomatoes, soy sauce, and steak sauce.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Return to a boil, cover, and transfer to oven. Continue cooking until meat is tear-apart-tender when pierced with a fork, about 1 1/2 hours longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When stew is done, remove from oven and discard thyme sprigs and bay leaves. If stew is not thick enough, reduce over the stovetop until desired consistency is reached. Season to taste with salt and pepper. Garnish with green onions and serve immediately with rice.",
      "secondary_message": null
    }
  ],
