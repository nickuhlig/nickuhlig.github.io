  "instructions": [
    {
      "id": 416830,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and rinse under cold water; set aside.",
      "secondary_message": "510 g cheese tortellini, fresh or frozen"
    },
    {
      "id": 416831,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 English cucumber\n1 (227 g) pkg sugar snap peas"
    },
    {
      "id": 416832,
      "primary_message": "Peel and mince shallot and garlic. Place both in a large bowl along with the vinaigrette, salt, and pepper; stir to combine. ",
      "secondary_message": "1 shallot\n2 cloves garlic\n½ cup French vinaigrette\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 416833,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the vinaigrette. ",
      "secondary_message": null
    },
    {
      "id": 416834,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 416835,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl along with the carrots. ",
      "secondary_message": "1 (283 g) bag shredded carrots"
    },
    {
      "id": 416836,
      "primary_message": "Drain and roughly chop artichokes. Add to the bowl. ",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 416837,
      "primary_message": "Drain and rinse beans. Add to the bowl. ",
      "secondary_message": "2 (398 ml) cans kidney beans"
    },
    {
      "id": 416838,
      "primary_message": "Add cooled tortellini and salt to the bowl, then stir to combine the pasta salad.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 416839,
      "primary_message": "To serve, divide pasta salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
