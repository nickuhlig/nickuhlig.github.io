  "instructions": [
    {
      "id": 416810,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and rinse under cold water; set aside.",
      "secondary_message": "765 g cheese tortellini, fresh or frozen"
    },
    {
      "id": 416811,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ red bell peppers\n1 ½ English cucumbers\n1 ½ (227 g) pkgs sugar snap peas"
    },
    {
      "id": 416812,
      "primary_message": "Peel and mince shallots and garlic. Place both in a large bowl along with the vinaigrette, salt, and pepper; stir to combine. ",
      "secondary_message": "2 shallots\n3 cloves garlic\n¾ cup French vinaigrette\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 416813,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the vinaigrette.",
      "secondary_message": null
    },
    {
      "id": 416814,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 416815,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl along with the carrots. ",
      "secondary_message": "1 ½ (227 g) pkgs sugar snap peas\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 416816,
      "primary_message": "Drain and roughly chop artichokes. Add to the bowl. ",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 416817,
      "primary_message": "Small dice ham and add to the bowl.",
      "secondary_message": "680 g ham steak, boneless"
    },
    {
      "id": 416818,
      "primary_message": "Add cooled tortellini to the bowl and stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 416819,
      "primary_message": "To serve, divide pasta salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
