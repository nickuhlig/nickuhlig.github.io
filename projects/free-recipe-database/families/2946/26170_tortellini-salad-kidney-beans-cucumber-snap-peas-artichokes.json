  "instructions": [
    {
      "id": 416760,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and rinse under cold water; set aside.",
      "secondary_message": "9 oz cheese tortellini, fresh or frozen"
    },
    {
      "id": 416761,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ red bell pepper\n½ English cucumber\n½ (8 oz) pkg sugar snap peas"
    },
    {
      "id": 416762,
      "primary_message": "Peel and mince shallot and garlic. Place both in a medium bowl along with the vinaigrette, salt, and pepper; stir to combine. ",
      "secondary_message": "½ shallot\n1 clove garlic\n¼ cup French vinaigrette\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 416763,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the vinaigrette. ",
      "secondary_message": null
    },
    {
      "id": 416764,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 416765,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl along with the carrots. ",
      "secondary_message": "½ (10 oz) bag shredded carrots"
    },
    {
      "id": 416766,
      "primary_message": "Drain and roughly chop artichokes. Add to the bowl. ",
      "secondary_message": "½ (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 416767,
      "primary_message": "Drain and rinse beans. Add to the bowl. ",
      "secondary_message": "1 (15 oz) can kidney beans"
    },
    {
      "id": 416768,
      "primary_message": "Add cooled tortellini and salt to the bowl, then stir to combine the pasta salad.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 416769,
      "primary_message": "To serve, divide pasta salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
