  "instructions": [
    {
      "id": 490291,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 490292,
      "primary_message": "While the water is heating, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n4 Gala apples\n4 medium carrots\n1 small bunch cilantro"
    },
    {
      "id": 490293,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 490294,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 490295,
      "primary_message": "While the skillet heats up, coarsely crumble tofu into a medium bowl.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 490296,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu, salt, and pepper; cook, stirring occasionally, until golden brown and warmed through, 6-7 minutes. Remove from heat and set aside to cool. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 490297,
      "primary_message": "Meanwhile, wipe the reserved bowl clean with paper towels. Juice lemon into the bowl, then add oil, Dijon, salt, and pepper. Whisk to combine the slaw dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 490298,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl with the slaw dressing.",
      "secondary_message": null
    },
    {
      "id": 490299,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 490300,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in another medium bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 490301,
      "primary_message": "Peel and mince shallot. Add to the bowl with the cilantro along with yogurt, mayo, and spices. Whisk to combine the curry yogurt dressing. ",
      "secondary_message": "1 shallot\n⅔ cup plain Greek yogurt\n¼ cup mayonnaise\n4 tsp curry powder\n½ tsp paprika\n¼ tsp salt\n¼ tsp turmeric, ground"
    },
    {
      "id": 490302,
      "primary_message": "When the tofu is cool, add to the bowl with the curry yogurt dressing, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 490303,
      "primary_message": "To serve, divide rice, tofu salad, and slaw between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
