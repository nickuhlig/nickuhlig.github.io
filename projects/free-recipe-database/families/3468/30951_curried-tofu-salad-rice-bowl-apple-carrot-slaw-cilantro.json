  "instructions": [
    {
      "id": 490304,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 490305,
      "primary_message": "While the water is heating, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n6 Gala apples\n6 medium carrots\n1 small bunch cilantro"
    },
    {
      "id": 490306,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 490307,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 490308,
      "primary_message": "While the skillet heats up, coarsely crumble tofu into a large bowl.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 490309,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu, salt, and pepper; cook, stirring occasionally, until golden brown and warmed through, 7-8 minutes. Remove from heat and set aside to cool. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 490310,
      "primary_message": "Meanwhile, wipe the reserved bowl clean with paper towels. Juice lemons into the bowl, then add oil, Dijon, salt, and pepper. Whisk to combine the slaw dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 490311,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl with the slaw dressing.",
      "secondary_message": null
    },
    {
      "id": 490312,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 490313,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 490314,
      "primary_message": "Peel and mince shallot. Add to the bowl with the cilantro along with yogurt, mayo, and spices. Whisk to combine the curry yogurt dressing. ",
      "secondary_message": "1 shallot\n1 cup plain Greek yogurt\n⅓ cup mayonnaise\n2 tbsp curry powder\n¾ tsp paprika\n½ tsp salt\n¼ tsp turmeric, ground"
    },
    {
      "id": 490315,
      "primary_message": "When the tofu is cool, add to the bowl with the curry yogurt dressing, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 490316,
      "primary_message": "To serve, divide rice, tofu salad, and slaw between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
