  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n1 ½ small bunches green onions (scallions)\n1 ½ limes\n3 hearts romaine hearts"
    },
    {
      "primary_message": "Halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the plate with the tomatoes, keeping them separate.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, cut limes into wedges and add to the plate; set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, breaking the meat apart with a spoon, until almost cooked through, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ lb ground chicken"
    },
    {
      "primary_message": "While the chicken is cooking, drain and rinse beans in a colander.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "primary_message": "Add beans, water, and taco seasoning to the skillet with the chicken; continue to cook, stirring occasionally, until sauce has thickened and the meat is no longer pink, 3-4 minutes more. Remove taco filling from the heat.",
      "secondary_message": "¼ cup taco seasoning"
    },
    {
      "primary_message": "Meanwhile, trim off and discard the root end of each romaine heart; separate the leaves to use as taco shells and divide between plates.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide taco filling between the romaine leaves; top with tomatoes and green onions. Serve with guacamole and lime wedges on the side. Enjoy!",
      "secondary_message": "1 ½ cups guacamole"
    }
  ],
