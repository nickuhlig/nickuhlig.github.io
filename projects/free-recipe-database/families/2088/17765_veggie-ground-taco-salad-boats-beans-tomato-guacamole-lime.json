  "instructions": [
    {
      "id": 418986,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg grape tomatoes\n½ small bunch green onions (scallions)\n½ lime\n1 heart romaine hearts"
    },
    {
      "id": 418987,
      "primary_message": "Halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 418988,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the plate with the tomatoes, keeping them separate.",
      "secondary_message": null
    },
    {
      "id": 418989,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 418990,
      "primary_message": "While the skillet heats up, cut lime into wedges and add to the plate; set aside.",
      "secondary_message": null
    },
    {
      "id": 418991,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until starting to brown, 3-4 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n227 g veggie ground, plant based"
    },
    {
      "id": 418992,
      "primary_message": "While the veggie ground is cooking, drain and rinse beans in a colander.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 418993,
      "primary_message": "Add beans, water, and taco seasoning to the skillet with the veggie ground; continue to cook, stirring occasionally, until sauce has thickened and the taco filling is cooked through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "⅓ cup water\n1 ½ tbsp taco seasoning"
    },
    {
      "id": 418994,
      "primary_message": "Meanwhile, trim off and discard root end of the romaine heart; separate the leaves to use as taco shells and divide between plates.",
      "secondary_message": null
    },
    {
      "id": 418995,
      "primary_message": "Divide taco filling between the romaine leaves; top with tomatoes and green onions. Serve with guacamole and lime wedges on the side. Enjoy!",
      "secondary_message": "½ cup guacamole"
    }
  ],
