  "instructions": [
    {
      "id": 418976,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 ½ small bunches green onions (scallions)\n1 ½ limes\n3 hearts romaine hearts"
    },
    {
      "id": 418977,
      "primary_message": "Halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 418978,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the plate with the tomatoes, keeping them separate.",
      "secondary_message": null
    },
    {
      "id": 418979,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 418980,
      "primary_message": "While the skillet heats up, cut limes into wedges and add to the plate; set aside.",
      "secondary_message": null
    },
    {
      "id": 418981,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until starting to brown, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n680 g veggie ground, plant based"
    },
    {
      "id": 418982,
      "primary_message": "While the veggie ground is cooking, drain and rinse beans in a colander.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 418983,
      "primary_message": "Add beans, water, and taco seasoning to the skillet with the veggie ground; continue to cook, stirring occasionally, until sauce has thickened and the taco filling is cooked through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 cup water\n¼ cup taco seasoning"
    },
    {
      "id": 418984,
      "primary_message": "Meanwhile, trim off and discard the root end of each romaine heart; separate the leaves to use as taco shells and divide between plates.",
      "secondary_message": null
    },
    {
      "id": 418985,
      "primary_message": "Divide taco filling between the romaine leaves; top with tomatoes, green onions, and shredded cheese. Serve with guacamole and lime wedges on the side. Enjoy!",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend\n1 ½ cups guacamole"
    }
  ],
