  "instructions": [
    {
      "id": 418906,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n1 small bunch green onions (scallions)\n1 lime\n2 hearts romaine hearts"
    },
    {
      "id": 418907,
      "primary_message": "Halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 418908,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the plate with the tomatoes, keeping them separate.",
      "secondary_message": null
    },
    {
      "id": 418909,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 418910,
      "primary_message": "While the skillet heats up, cut lime into wedges and add to the plate; set aside.",
      "secondary_message": null
    },
    {
      "id": 418911,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, breaking the meat apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n0.45 kg ground chicken"
    },
    {
      "id": 418912,
      "primary_message": "While the chicken is cooking, drain and rinse beans in a colander.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 418913,
      "primary_message": "Add beans, water, and taco seasoning to the skillet with the chicken; continue to cook, stirring occasionally, until sauce has thickened and the meat is no longer pink, 2-3 minutes more. Remove taco filling from the heat.",
      "secondary_message": "⅔ cup water\n3 tbsp taco seasoning"
    },
    {
      "id": 418914,
      "primary_message": "Meanwhile, trim off and discard the root end of each romaine heart; separate the leaves to use as taco shells and divide between plates.",
      "secondary_message": null
    },
    {
      "id": 418915,
      "primary_message": "Divide taco filling between the romaine leaves; top with tomatoes, green onions, and shredded cheese. Serve with guacamole and lime wedges on the side. Enjoy!",
      "secondary_message": "1 cup shredded cheese, Mexican blend\n1 cup guacamole"
    }
  ],
