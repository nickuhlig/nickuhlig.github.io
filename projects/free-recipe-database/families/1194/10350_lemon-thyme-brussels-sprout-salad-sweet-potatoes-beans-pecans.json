  "instructions": [
    {
      "id": 165696,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb sweet potatoes\n3 lemons\n2 ¼ lb brussels sprouts"
    },
    {
      "id": 165697,
      "primary_message": "Peel and dice the sweet potatoes into ½-inch pieces. Place in a medium saucepan along with the salt. Cover with hot water (from the tap) and bring to a boil over high heat; reduce heat, cover, and cook until fork-tender, about 10 minutes.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 165698,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "½ cup extra virgin olive oil\n3 tbsp apple cider vinegar\n¾ tsp salt\n½ tsp black pepper\n3 pinch thyme"
    },
    {
      "id": 165699,
      "primary_message": "Peel and thinly slice shallots. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 165700,
      "primary_message": "Drain and rinse beans in a colander; add to the bowl.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 165701,
      "primary_message": "Trim ends and thinly slice Brussels sprouts; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 165702,
      "primary_message": "Once the sweet potatoes are done, drain in a colander and rinse under cold water. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 165703,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "1 cup pecans, dry roasted"
    },
    {
      "id": 165704,
      "primary_message": "To serve, divide the salad between plates and top with pecans. Enjoy!",
      "secondary_message": null
    }
  ],
