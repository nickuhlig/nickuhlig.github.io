  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 large, 4 small, and 4 mini food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, cut bacon crosswise into ½-inch thick pieces.\n\n",
      "secondary_message": "12 slice bacon"
    },
    {
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry lettuce. Using a clean cutting board, chop (or tear) lettuce into bite-sized pieces. Divide between the large storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and halve grape tomatoes. Add to the containers with the lettuce, along with the crispy bacon.\n\n",
      "secondary_message": "1 ½ pint grape tomatoes"
    },
    {
      "primary_message": "Place dressing in the mini storage containers, add to the containers with the salad, cover, and refrigerate until ready to eat.\n\n",
      "secondary_message": "¾ cup ranch dressing"
    },
    {
      "primary_message": "Divide croutons between the small storage containers, cover, and store at room temperature until ready to eat. \n\n",
      "secondary_message": "1 ⅓ cups croutons"
    },
    {
      "primary_message": "When ready to eat, add dressing and croutons to the salad, then toss to combine. Enjoy!",
      "secondary_message": null
    }
  ],
