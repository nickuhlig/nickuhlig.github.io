  "instructions": [
    {
      "id": 239901,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ red bell peppers\n1 ½ heads butter (Boston) lettuce\n1 small pkg fresh basil\n3 avocados"
    },
    {
      "id": 239902,
      "primary_message": "Mince the sun-dried tomatoes and place in a medium bowl. Add oil and spices; stir to combine the marinade.",
      "secondary_message": "9 sun-dried tomatoes, oil-packed\n3 tbsp extra virgin olive oil\n¾ tsp oregano, dried\n½ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 239903,
      "primary_message": "Cut mozzarella into ½-inch cubes and add to the bowl with the marinade; gently toss to coat the cheese and set aside.",
      "secondary_message": "1 ½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 239904,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 239905,
      "primary_message": "Peel and mince garlic; place in a large bowl along with oil, vinegar, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 239906,
      "primary_message": "Trim, seed, and mince bell peppers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 239907,
      "primary_message": "Mince artichokes and add to the bowl.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 239908,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces and add to the bowl. Toss to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 239909,
      "primary_message": "Peel and mince additional garlic; place in a small bowl along with oil, salt, and pepper. Stir to combine the garlic oil.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 239910,
      "primary_message": "Slice buns in half and divide between two baking sheet pans, cut-side up. Drizzle with garlic oil.",
      "secondary_message": "6 whole grain buns or rolls\n2 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 239911,
      "primary_message": "Working in batches, place buns in the oven and toast until golden, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 239912,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Set aside.",
      "secondary_message": null
    },
    {
      "id": 239913,
      "primary_message": "Halve and pit the avocados; slice thinly while still in skin, then scoop out with a spoon. Arrange avocado slices on top of the garlic toast.",
      "secondary_message": null
    },
    {
      "id": 239914,
      "primary_message": "To serve, divide garlic-avocado toast and salad between plates; spoon marinated mozzarella over the toasts and garnish with basil. Enjoy!",
      "secondary_message": null
    }
  ],
