  "instructions": [
    {
      "id": 239873,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ red bell pepper\n½ head butter (Boston) lettuce\n½ small pkg fresh basil\n1 avocado"
    },
    {
      "id": 239874,
      "primary_message": "Mince the sun-dried tomatoes and place in a small bowl. Add oil and spices; stir to combine the marinade.",
      "secondary_message": "3 sun-dried tomatoes, oil-packed\n1 tbsp extra virgin olive oil\n¼ tsp oregano, dried\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 239875,
      "primary_message": "Cut mozzarella into ½-inch cubes and add to the bowl with the marinade; gently toss to coat the cheese and set aside.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 239876,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 239877,
      "primary_message": "Peel and mince garlic; place in a medium bowl along with oil, vinegar, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n½ tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 239878,
      "primary_message": "Trim, seed, and mince bell pepper; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 239879,
      "primary_message": "Mince artichokes and add to the bowl.",
      "secondary_message": "½ (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 239880,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces and add to the bowl. Toss to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 239881,
      "primary_message": "Peel and mince additional garlic; place in another small bowl along with oil, salt, and pepper. Stir to combine the garlic oil.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 239882,
      "primary_message": "Slice buns in half and place, cut-side up, on a baking sheet pan. Drizzle with garlic oil.",
      "secondary_message": "2 whole grain buns or rolls\n2 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 239883,
      "primary_message": "Place buns in the oven and toast until golden, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 239884,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Set aside.",
      "secondary_message": null
    },
    {
      "id": 239885,
      "primary_message": "Halve and pit the avocado; slice thinly while still in skin, then scoop out with a spoon. Arrange avocado slices on top of the garlic toast.",
      "secondary_message": null
    },
    {
      "id": 239886,
      "primary_message": "To serve, divide garlic-avocado toast and salad between plates; spoon marinated mozzarella over the toasts and garnish with basil. Enjoy!",
      "secondary_message": null
    }
  ],
