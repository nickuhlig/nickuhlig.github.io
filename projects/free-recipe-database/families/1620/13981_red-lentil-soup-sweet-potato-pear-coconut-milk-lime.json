  "instructions": [
    {
      "id": 231728,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n0.23 kg sweet potato\n½ lime\n1 pear"
    },
    {
      "id": 231729,
      "primary_message": "Rinse the lentils in a colander or strainer; set aside to drain.",
      "secondary_message": "½ cup red lentils, dried"
    },
    {
      "id": 231730,
      "primary_message": "Peel and small dice onion; transfer to a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 231731,
      "primary_message": "Peel, trim, and small dice carrot; add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 231732,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 231733,
      "primary_message": "While the pan heats up, trim and small dice celery; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 231734,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion, carrot, celery, and spices to the pan; cook, stirring occasionally, until the veggies soften, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 231735,
      "primary_message": "Meanwhile, peel and small dice sweet potato.",
      "secondary_message": null
    },
    {
      "id": 231736,
      "primary_message": "Zest lime and then cut into wedges (set wedges aside for serving).",
      "secondary_message": null
    },
    {
      "id": 231737,
      "primary_message": "Add lentils, sweet potato, lime zest, broth, and coconut milk to the pan; stir to combine and bring to a boil over medium-high heat.",
      "secondary_message": "710 ml chicken or vegetable broth\n½ (398 ml) can coconut milk"
    },
    {
      "id": 231738,
      "primary_message": "Peel, quarter, core, and small dice pear; add to the soup. Once the soup comes to a boil, reduce heat to a simmer, and cook until veggies and lentils are tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 231739,
      "primary_message": "Divide soup between bowls and serve with lime wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
