  "instructions": [
    {
      "id": 248434,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 jalapeño peppers\n2 medium carrots\n1 (5 oz) pkg baby spinach\n1 avocado"
    },
    {
      "id": 248435,
      "primary_message": "Peel, halve, and slice onion lengthwise into ½-inch wide strips. Place in a medium bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 248436,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Cut lengthwise into ½-inch wide strips and add to the bowl with the onion. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 248437,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248438,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 248439,
      "primary_message": "While the skillet heats up, peel and thinly slice garlic. Transfer to a small saucepan and set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 248440,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, jalapeño, carrot, and spices to the skillet; cook, stirring often, until veggies are crisp-tender, about 3 minutes. Return veggies to the bowl, reserving the skillet for later use.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp paprika\n½ tsp cumin, ground"
    },
    {
      "id": 248441,
      "primary_message": "While the veggies are cooking, add vinegar, water, sugar, and salt to the saucepan with the garlic; stir to combine. Bring the pickling liquid to a boil over high heat.",
      "secondary_message": "½ cup red wine vinegar\n½ cup water\n2 tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 248442,
      "primary_message": "Pour the pickling liquid into the bowl over the cooked veggies. Stir to combine and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 248443,
      "primary_message": "Coarsely grate cheese and place in a large bowl. Add eggs and spices, then whisk until combined.",
      "secondary_message": "½ (8 oz) block mozzarella cheese\n10 eggs\n½ tsp salt\n½ tsp black pepper\n¼ tsp cumin, ground"
    },
    {
      "id": 248444,
      "primary_message": "Roughly chop the spinach leaves and add to the bowl with the egg; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 248445,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 248446,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour egg mixture into the skillet; scramble the eggs using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until eggs are no longer runny, 3-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 248447,
      "primary_message": "While the eggs are cooking, warm tortillas in another skillet, oven, or microwave (optional), 15-30 seconds.",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 248448,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 248449,
      "primary_message": "To serve, divide tortillas between plates and fill with spinach-scrambled eggs. Top with pickled veggies and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
