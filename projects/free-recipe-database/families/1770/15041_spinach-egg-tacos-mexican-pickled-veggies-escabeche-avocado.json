  "instructions": [
    {
      "id": 248594,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 jalapeño peppers\n3 medium carrots\n1 ½ (142 g) pkg baby spinach\n1 ½ avocados"
    },
    {
      "id": 248595,
      "primary_message": "Peel, halve, and slice onions lengthwise into ½-inch wide strips. Place in a medium bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 248596,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Cut lengthwise into ½-inch wide strips and add to the bowl with the onion. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 248597,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 248598,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 248599,
      "primary_message": "While the pot heats up, peel and thinly slice garlic. Transfer to a medium saucepan and set aside.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 248600,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, jalapeño, carrot, and spices to the pot; cook, stirring often, until veggies are crisp-tender, 3-5 minutes. Return veggies to the bowl, reserving the pot for later use.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n¾ tsp paprika\n¾ tsp cumin, ground"
    },
    {
      "id": 248601,
      "primary_message": "While the veggies are cooking, add vinegar, water, sugar, and salt to the saucepan with the garlic; stir to combine. Bring the pickling liquid to a boil over high heat.",
      "secondary_message": "¾ cup red wine vinegar\n¾ cup water\n1 tbsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 248602,
      "primary_message": "Pour the pickling liquid into the bowl over the cooked veggies. Stir to combine and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 248603,
      "primary_message": "Coarsely grate cheese and place in a large bowl. Add eggs and spices, then whisk until combined.",
      "secondary_message": "¾ (227 g) block mozzarella cheese\n15 eggs\n¾ tsp salt\n¾ tsp black pepper\n½ tsp cumin, ground"
    },
    {
      "id": 248604,
      "primary_message": "Roughly chop the spinach leaves and add to the bowl with the egg; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 248605,
      "primary_message": "Wipe the pot clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 248606,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Pour egg mixture into the pot; scramble the eggs using a combination of stirring and folding, making sure to bring in all the mixture from the edges of the pan. Cook until eggs are no longer runny, about 5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 248607,
      "primary_message": "While the eggs are cooking, warm tortillas in a skillet, oven, or microwave (optional), 15-30 seconds.",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 248608,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 248609,
      "primary_message": "To serve, divide tortillas between plates and fill with spinach-scrambled eggs. Top with pickled veggies and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
