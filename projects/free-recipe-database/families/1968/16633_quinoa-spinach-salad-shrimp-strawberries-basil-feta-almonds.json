  "instructions": [
    {
      "id": 271558,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 271559,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 yellow bell peppers\n1 ½ (454 g) pkgs strawberries\n1 small pkg fresh basil\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 271560,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 271561,
      "primary_message": "Zest and juice lemons into a large bowl. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tbsp pure maple syrup\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 271562,
      "primary_message": "Peel, halve, and thinly slice shallots into half-moons. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 271563,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 271564,
      "primary_message": "Trim and quarter strawberries lengthwise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 271565,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 271566,
      "primary_message": "Add feta to the bowl and set aside.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 271567,
      "primary_message": "Transfer the cooked quinoa to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 271568,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271569,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add shrimp and season with salt and pepper; cook until opaque, 1-2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 271570,
      "primary_message": "Add cooled quinoa to the bowl with the dressing and salad fixings; gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 271571,
      "primary_message": "To serve, divide spinach between plates; top with quinoa salad, shrimp, almonds, and reserved basil. Enjoy!",
      "secondary_message": "⅓ cup almonds, sliced"
    }
  ],
