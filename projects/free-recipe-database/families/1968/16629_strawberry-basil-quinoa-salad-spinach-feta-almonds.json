  "instructions": [
    {
      "id": 271508,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 271509,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 yellow bell peppers\n1 (16 oz) pkg strawberries\n1 small pkg fresh basil\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 271510,
      "primary_message": "Zest and juice lemon into a medium bowl. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp pure maple syrup\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 271511,
      "primary_message": "Peel, halve, and thinly slice shallot into half-moons. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 271512,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 271513,
      "primary_message": "Trim and quarter strawberries lengthwise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 271514,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 271515,
      "primary_message": "Add feta to the bowl and set aside.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 271516,
      "primary_message": "Transfer the cooked quinoa to a baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 271517,
      "primary_message": "Add cooled quinoa to the bowl with the dressing and salad fixings; gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 271518,
      "primary_message": "To serve, divide spinach between plates; top with quinoa salad, almonds, and reserved basil. Enjoy!",
      "secondary_message": "⅔ cup almonds, sliced"
    }
  ],
