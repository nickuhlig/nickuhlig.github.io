  "instructions": [
    {
      "id": 271455,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 271456,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 yellow bell pepper\n½ (16 oz) pkg strawberries\n½ small pkg fresh basil\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 271457,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 271458,
      "primary_message": "Zest and juice lemon into a medium bowl. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 271459,
      "primary_message": "Peel, halve, and thinly slice shallot into half-moons. Add to the bowl with the dressing and stir to combine.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 271460,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 271461,
      "primary_message": "Trim and quarter strawberries lengthwise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 271462,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 271463,
      "primary_message": "Add feta to the bowl and set aside.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 271464,
      "primary_message": "Transfer the cooked quinoa to a baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 271465,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271466,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp and season with salt and pepper; cook until opaque, 1-2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 271467,
      "primary_message": "Add cooled quinoa to the bowl with the dressing and salad fixings; gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 271468,
      "primary_message": "To serve, divide spinach between plates; top with quinoa salad, shrimp, almonds, and reserved basil. Enjoy!",
      "secondary_message": "⅛ cup almonds, sliced"
    }
  ],
