  "instructions": [
    {
      "id": 1,
      "primary_message": "Spread each slice of bread on both sides with butter. Arrange four slices in large skillet and cook over medium heat until turning light golden, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Sprinkle slices with 1/2 cup Parmesan and, using spatula, flip over.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Sprinkle toasted sides of bread with 1 cup cheddar and cook until cheddar begins to melt and Parmesan begins to brown and crisp, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Once cheddar is melted, turn 2 of the slices onto the other two and press together to sandwich. Transfer to cutting board and repeat with remaining ingredients.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Allow sandwiches to rest about 3 minutes, then cut in half and serve.",
      "secondary_message": null
    }
  ],
