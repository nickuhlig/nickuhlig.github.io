  "instructions": [
    {
      "id": 581129,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 581130,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat. Working in batches if necessary, add patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook according to package instructions). Remove to a plate and cover with foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 veggie burger patties, plant-based"
    },
    {
      "id": 581131,
      "primary_message": "Meanwhile, place ketchup and hot sauce in a small bowl. Stir to combine the spicy ketchup and set aside.",
      "secondary_message": "⅓ cup ketchup\n1 tbsp hot sauce"
    },
    {
      "id": 581132,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 581133,
      "primary_message": "Juice lemons into a large bowl. Add mayo, Dijon, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp Dijon mustard\n1 tbsp honey\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 581134,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 581135,
      "primary_message": "Thinly slice sun-dried tomatoes. Add to the bowl and set aside.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 581136,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 581137,
      "primary_message": "Meanwhile, split and toast muffins (if desired).",
      "secondary_message": "6 English muffins"
    },
    {
      "id": 581138,
      "primary_message": "Add mixed greens to the bowl with the cucumber. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 581139,
      "primary_message": "Spread spicy ketchup over one half of each muffin; top with burger patties and fried eggs. Close with the other half of each muffin. Divide burgers between plates and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
