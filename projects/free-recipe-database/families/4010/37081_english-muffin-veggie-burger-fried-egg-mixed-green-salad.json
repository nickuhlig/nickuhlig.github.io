  "instructions": [
    {
      "id": 581107,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 581108,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove to a plate and cover with foil to keep warm. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n2 veggie burger patties, plant-based"
    },
    {
      "id": 581109,
      "primary_message": "Meanwhile, place ketchup and hot sauce in a small bowl. Stir to combine the spicy ketchup and set aside.",
      "secondary_message": "2 tbsp ketchup\n1 tsp hot sauce"
    },
    {
      "id": 581110,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lemon\n½ English cucumber\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 581111,
      "primary_message": "Juice lemon into a medium bowl. Add mayo, Dijon, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tsp mayonnaise\n1 tsp Dijon mustard\n1 tsp honey\n⅛ tsp oregano, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 581112,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 581113,
      "primary_message": "Thinly slice sun-dried tomatoes. Add to the bowl and set aside.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 581114,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 581115,
      "primary_message": "Meanwhile, split and toast muffins (if desired).",
      "secondary_message": "2 English muffins"
    },
    {
      "id": 581116,
      "primary_message": "Add mixed greens to the bowl with the cucumber. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 581117,
      "primary_message": "Spread spicy ketchup over one half of each muffin; top with burger patties and fried eggs. Close with the other half of each muffin. Divide burgers between plates and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
