  "instructions": [
    {
      "id": 1,
      "primary_message": "Place the chicken in the slow cooker and sprinkle the dried herbs all over. Scatter butter on top of the chicken and cover. Cook on low until chicken shreds easily with a fork, about 5 to 6 hours. Using 2 forks, shred the chicken into small pieces.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add cream cheese, ham, Swiss cheese, white wine, and chicken broth, and stir. Cover and cook on low for 2 hours, stirring once halfway through. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Sprinkle with parsley and serve warm with sliced baguette or chips, to dip.",
      "secondary_message": null
    }
  ],
