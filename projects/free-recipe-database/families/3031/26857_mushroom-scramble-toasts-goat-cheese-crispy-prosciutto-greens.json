  "instructions": [
    {
      "id": 433899,
      "primary_message": "Preheat oven to 190°C (375°F). Position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 433900,
      "primary_message": "Arrange prosciutto in a single layer on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and cook until prosciutto is crisp, 3-5 minutes. Remove from oven and transfer crispy prosciutto to a plate; set aside to cool. (Reserve baking sheet for later use.)",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 433901,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.23 kg cremini mushrooms\n½ small pkg chives\n½ head butter (Boston) lettuce"
    },
    {
      "id": 433902,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 433903,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 433904,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until deep brown and tender, 12-14 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 433905,
      "primary_message": "While the mushrooms are cooking, change the oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 433906,
      "primary_message": "Arrange bread on the reserved baking sheet. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. ",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 433907,
      "primary_message": "Crack eggs into a medium bowl, then season with salt and pepper. Whisk until smooth.",
      "secondary_message": "6 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 433908,
      "primary_message": "When the mushrooms are done, add vinegar and salt to the skillet, then stir to combine.",
      "secondary_message": "½ tsp white wine vinegar\n¼ tsp salt"
    },
    {
      "id": 433909,
      "primary_message": "Pour egg mixture into the skillet with the mushrooms and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove from heat, crumble goat cheese into the skillet, and stir to combine.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 433910,
      "primary_message": "Place oil, vinegar, salt, and pepper in a clean medium bowl, then whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 433911,
      "primary_message": "Chop chives into small pieces. Place half in the bowl with the dressing (reserving the rest for serving).",
      "secondary_message": null
    },
    {
      "id": 433912,
      "primary_message": "Chop (or tear) lettuce leaves into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 433913,
      "primary_message": "To serve, divide salad and toast between plates. Top toast with cheesy mushroom scramble, reserved chives, and crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
