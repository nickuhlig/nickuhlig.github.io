  "instructions": [
    {
      "id": 433929,
      "primary_message": "Preheat oven to 190°C (375°F). Position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 433930,
      "primary_message": "Divide prosciutto between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and cook until prosciutto is crisp, 3-5 minutes. Remove from oven and transfer crispy prosciutto to a plate; set aside to cool. (Reserve baking sheets for later use.)",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 433931,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n1 small pkg chives\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 433932,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 433933,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 433934,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until deep brown and tender, 14-16 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 433935,
      "primary_message": "While the mushrooms are cooking, change the oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 433936,
      "primary_message": "Divide bread between the reserved baking sheets. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 433937,
      "primary_message": "Crack eggs into a large bowl, then season with salt and pepper. Whisk until smooth.",
      "secondary_message": "18 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 433938,
      "primary_message": "When the mushrooms are done, add vinegar and salt to the skillet, then stir to combine.",
      "secondary_message": "1 ½ tsp white wine vinegar\n¾ tsp salt"
    },
    {
      "id": 433939,
      "primary_message": "Pour egg mixture into the skillet with the mushrooms and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove from heat, crumble goat cheese into the skillet, and stir to combine.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 433940,
      "primary_message": "Place oil, vinegar, salt, and pepper in a clean large bowl, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 433941,
      "primary_message": "Chop chives into small pieces. Place half in the bowl with the dressing (reserving the rest for serving).",
      "secondary_message": null
    },
    {
      "id": 433942,
      "primary_message": "Chop (or tear) lettuce leaves into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 433943,
      "primary_message": "To serve, divide salad and toast between plates. Top toast with cheesy mushroom scramble, reserved chives, and crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
