  "instructions": [
    {
      "id": 294075,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 294076,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n3 hearts romaine hearts\n1 ½ limes"
    },
    {
      "id": 294077,
      "primary_message": "Drizzle both sides of the tortillas with oil and sprinkle with salt; divide between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until the tortillas are golden brown and crispy, about 15 minutes. Remove from oven.",
      "secondary_message": "18 small corn tortillas\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 294078,
      "primary_message": "Meanwhile, halve tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 294079,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips; add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 294080,
      "primary_message": "Cut limes into wedges and add to the plate.",
      "secondary_message": null
    },
    {
      "id": 294081,
      "primary_message": "To serve, divide the tortillas between plates and spread with guacamole; top with turkey, tomatoes, and lettuce. Drizzle with dressing, juice lime over top, and enjoy!",
      "secondary_message": "1 ½ cups guacamole\n24 oz oven roasted turkey breast, sliced\n¾ cup ranch dressing"
    }
  ],
