  "instructions": [
    {
      "id": 631665,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 631666,
      "primary_message": "While the pot heats up, medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 631667,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate, then set aside. (Reserve pot with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 631668,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n1 small pkg chives\n1 ½ small bunches asparagus"
    },
    {
      "id": 631669,
      "primary_message": "Using a clean cutting board, peel and small dice potatoes.",
      "secondary_message": null
    },
    {
      "id": 631670,
      "primary_message": "When the bacon is done, return the pot (with drippings) to medium heat. Add potato, salt, and pepper; cook, stirring occasionally, until starting to soften, 10-12 minutes.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 631671,
      "primary_message": "While the potato is cooking, chop chives into small pieces. Set aside.",
      "secondary_message": null
    },
    {
      "id": 631672,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces.",
      "secondary_message": null
    },
    {
      "id": 631673,
      "primary_message": "When the potatoes are starting to soften, add asparagus, paprika, and additional salt to the pot. Continue to cook, stirring occasionally, until potatoes and asparagus are fork-tender, 6-7 minutes more.",
      "secondary_message": "¾ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 631674,
      "primary_message": "Return crispy bacon to the pot, along with chives, and stir to combine the hash. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 631675,
      "primary_message": "To serve, divide hash between plates and enjoy!",
      "secondary_message": null
    }
  ],
