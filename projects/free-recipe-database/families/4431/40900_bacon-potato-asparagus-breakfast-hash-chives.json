  "instructions": [
    {
      "id": 631654,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 631655,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 631656,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate, then set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 631657,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium yellow potatoes\n1 small pkg chives\n1 small bunch asparagus"
    },
    {
      "id": 631658,
      "primary_message": "Using a clean cutting board, peel and small dice potatoes.",
      "secondary_message": null
    },
    {
      "id": 631659,
      "primary_message": "When the bacon is done, return the skillet (with drippings) to medium heat. Add potato, salt, and pepper; cook, stirring occasionally, until starting to soften, about 10 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 631660,
      "primary_message": "While the potato is cooking, chop chives into small pieces. Set aside.",
      "secondary_message": null
    },
    {
      "id": 631661,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces.",
      "secondary_message": null
    },
    {
      "id": 631662,
      "primary_message": "When the potatoes are starting to soften, add asparagus, paprika, and additional salt to the skillet. Continue to cook, stirring occasionally, until potatoes and asparagus are fork-tender, 5-6 minutes more.",
      "secondary_message": "½ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 631663,
      "primary_message": "Return crispy bacon to the skillet, along with chives, and stir to combine the hash. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 631664,
      "primary_message": "To serve, divide hash between plates and enjoy!",
      "secondary_message": null
    }
  ],
