  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 350°F. Coat a 9 x 13-inch baking dish with cooking spray. \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place cake mix and ginger ale in a medium bowl. Using a hand-held mixer, blend on medium for 2 minutes, scraping down the sides of the bowl as needed. \n\n",
      "secondary_message": "1 (432 g) box carrot cake mix\n1 (340 g) can ginger ale"
    },
    {
      "primary_message": "Transfer batter to the baking dish and spread out in an even layer. Place in the preheated oven and bake until a toothpick inserted in the center comes out clean, 25-30 minutes. Remove from oven and set aside to cool completely, about 1 hour.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the cake is cool, place powdered sugar, milk, and cinnamon in a small bowl. Whisk to combine the glaze, then drizzle over the cake. Set aside for the glaze to set completely, about 1 hour. \n\n",
      "secondary_message": "½ cup powdered sugar\n1 tbsp whole milk\n¼ tsp cinnamon, ground"
    },
    {
      "primary_message": "Cut cake into portions, share, and enjoy!",
      "secondary_message": null
    }
  ],
