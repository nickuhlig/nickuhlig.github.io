  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 425°F. In a large bowl, toss sliced squash with 2 tablespoons olive oil and season with salt and pepper. Arrange in even layers on 2 rimmed baking sheets and roast until browned and tender, about 45 minutes. Let cool slightly.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a skillet, combine pork with 1 tablespoon olive oil and thyme, if using, and cook over medium heat, stirring, until pork is crisp and fat has rendered, about 7 minutes. Remove from heat and discard thyme. Stir in red wine vinegar, remaining 3 tablespoons olive oil, and parsley and chives. Keep vinaigrette warm.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a thin metal spatula, lift squash from baking sheets. Arrange on a serving platter. Spoon warm vinaigrette on top. Garnish with crumbled egg yolks and grated cheese and grate more fresh black pepper on top. Serve.",
      "secondary_message": null
    }
  ],
