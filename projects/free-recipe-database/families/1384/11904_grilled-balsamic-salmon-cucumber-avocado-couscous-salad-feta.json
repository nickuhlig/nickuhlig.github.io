  "instructions": [
    {
      "id": 201173,
      "primary_message": "In a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes. ",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 201174,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n1 ½ avocados"
    },
    {
      "id": 201175,
      "primary_message": "Peel and mince garlic; place in a large bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 201176,
      "primary_message": "Juice lemons into the bowl with the garlic; add vinegar, oil, honey, and spices. Whisk to combine the dressing. ",
      "secondary_message": "⅓ cup balsamic vinegar\n1 ½ tbsp extra virgin olive oil\n1 tbsp honey\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 201177,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 201178,
      "primary_message": "While the grill pan heats up, pat salmon dry with paper towels. Place in another large bowl; pour ⅓ of the dressing over the salmon and turn to coat. Set the bowl with remaining dressing aside. ",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 201179,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add salmon and cook until opaque, 4-5 minutes per side. Transfer to a plate, cover with foil, and set aside. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 201180,
      "primary_message": "Meanwhile, once the couscous is done, transfer to a large baking sheet pan and spread out in an even layer to cool. ",
      "secondary_message": null
    },
    {
      "id": 201181,
      "primary_message": "Trim, halve, and thinly slice cucumbers into half moons. Add to the bowl with the remaining dressing. ",
      "secondary_message": null
    },
    {
      "id": 201182,
      "primary_message": "Halve and pit the avocados. Slice lengthwise and crosswise while still in the skin and scoop out with a spoon; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 201183,
      "primary_message": "Once the couscous has cooled, add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 201184,
      "primary_message": "To serve, divide couscous salad and salmon between plates; sprinkle with feta and enjoy! ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
