  "instructions": [
    {
      "id": 201269,
      "primary_message": "In a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes. ",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 201270,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 English cucumber\n1 avocado"
    },
    {
      "id": 201271,
      "primary_message": "Peel and mince garlic; place in a medium bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 201272,
      "primary_message": "Juice lemon into the bowl with the garlic; add vinegar, oil, honey, and spices. Whisk to combine the dressing. ",
      "secondary_message": "¼ cup balsamic vinegar\n1 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 201273,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 201274,
      "primary_message": "While the grill pan heats up, pat salmon dry with paper towels. Place in another medium bowl; pour ⅓ of the dressing over the salmon and turn to coat. Set the bowl with remaining dressing aside. ",
      "secondary_message": "0.68 kg salmon fillet"
    },
    {
      "id": 201275,
      "primary_message": "Once the grill pan is hot, coat with oil. Add salmon and cook until opaque, 4-5 minutes per side. Transfer to a plate, cover with foil, and set aside. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 201276,
      "primary_message": "Meanwhile, once the couscous is done, transfer to a baking sheet pan and spread out in an even layer to cool. ",
      "secondary_message": null
    },
    {
      "id": 201277,
      "primary_message": "Trim, halve, and thinly slice cucumber into half moons. Add to the bowl with the remaining dressing. ",
      "secondary_message": null
    },
    {
      "id": 201278,
      "primary_message": "Halve and pit the avocado. Slice lengthwise and crosswise while still in the skin and scoop out with a spoon; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 201279,
      "primary_message": "Once the couscous has cooled, add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 201280,
      "primary_message": "To serve, divide couscous salad and salmon between plates; sprinkle with feta and enjoy! ",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
