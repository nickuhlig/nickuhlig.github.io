  "instructions": [
    {
      "id": 182596,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 182597,
      "primary_message": "While the skillet heats up, cut bread into ¾-inch cubes.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 182598,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 182599,
      "primary_message": "Add bread cubes to the skillet and season with spices. Toast the bread, tossing occasionally, until croutons are golden brown, 5-6 minutes. Remove from heat and set aside.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp Italian seasoning\n⅛ tsp garlic powder"
    },
    {
      "id": 182600,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n½ small pkg grape tomatoes\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 182601,
      "primary_message": "Juice lemon into a large bowl. Add oil, Dijon, honey, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n¼ tsp garlic powder\n⅛ tsp black pepper"
    },
    {
      "id": 182602,
      "primary_message": "Drain and rinse beans, then add to the bowl with the dressing.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 182603,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 182604,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces and add to the bowl.",
      "secondary_message": "10 slices prosciutto"
    },
    {
      "id": 182605,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 182606,
      "primary_message": "Use a vegetable peeler to shave the Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 182607,
      "primary_message": "To serve, divide salad between plates. Top with croutons and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
