  "instructions": [
    {
      "id": 182608,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 182609,
      "primary_message": "While the skillet heats up, cut bread into ¾-inch cubes.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 182610,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 182611,
      "primary_message": "Add bread cubes to the skillet and season with spices. Toast the bread, tossing occasionally, until croutons are golden brown, 6-7 minutes. Remove from heat and set aside.",
      "secondary_message": "¼ tsp salt\n¼ tsp Italian seasoning\n¼ tsp garlic powder"
    },
    {
      "id": 182612,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 lemons\n1 small pkg grape tomatoes\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 182613,
      "primary_message": "Juice lemons into a large bowl. Add oil, Dijon, honey, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n2 tsp honey\n½ tsp salt\n½ tsp garlic powder\n¼ tsp black pepper"
    },
    {
      "id": 182614,
      "primary_message": "Drain and rinse beans, then add to the bowl with the dressing.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 182615,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 182616,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces and add to the bowl.",
      "secondary_message": "20 slices prosciutto"
    },
    {
      "id": 182617,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 182618,
      "primary_message": "Use a vegetable peeler to shave the Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 182619,
      "primary_message": "To serve, divide salad between plates. Top with croutons and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
