  "instructions": [
    {
      "id": 163335,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 163336,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 head butter (Boston) lettuce\n1 medium carrot\n1 tomato"
    },
    {
      "id": 163337,
      "primary_message": "Peel and mince garlic. Transfer to a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 163338,
      "primary_message": "Juice half the lemon into the bowl with the garlic. Add mayonnaise, chili-garlic sauce, and salt; whisk to combine and set the spicy mayo aside.",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp chili-garlic sauce\n¼ tsp salt"
    },
    {
      "id": 163339,
      "primary_message": "In a medium bowl, combine bread crumbs, flour, and spices. Add shrimp and toss to combine.",
      "secondary_message": "2 tbsp panko bread crumbs\n1 tbsp all-purpose flour\n¼ tsp paprika\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt"
    },
    {
      "id": 163340,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 163341,
      "primary_message": "Add shrimp to the skillet; cook until opaque, 1-2 minutes per side. Once done, transfer to a paper-towel lined plate.",
      "secondary_message": null
    },
    {
      "id": 163342,
      "primary_message": "Meanwhile, juice the other half of the lemon into a large bowl. Add oil, vinegar, Dijon, honey, and spices; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n¼ tsp Dijon mustard\n¼ tsp honey\n¼ tsp thyme\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 163343,
      "primary_message": "Separate the lettuce leaves. Set aside 2 large leaves per sandwich; chop or tear remaining leaves into bite-sized pieces and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 163344,
      "primary_message": "Trim carrot and peel into thin noodle-like sticks using a julienne (or regular) peeler. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 163345,
      "primary_message": "Slice half of the tomato and set aside for the sandwiches. Small dice the other half and add to the salad bowl. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 163346,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 163347,
      "primary_message": "Place the bottom half of a bun on each plate. Layer with lettuce, shrimp, tomato, and spicy mayo; close with top half of the bun. Serve salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
