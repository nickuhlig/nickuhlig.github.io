  "instructions": [
    {
      "id": 573847,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ jalapeño pepper\n1 tomato\n1 mango\n1 peach\n½ head butter (Boston) lettuce"
    },
    {
      "id": 573848,
      "primary_message": "Juice lime into a small bowl. Add oil, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 573849,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 573850,
      "primary_message": "Medium dice tomato. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 573851,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 573852,
      "primary_message": "Quarter peach lengthwise (around the pit); twist quarters to separate, then remove and discard pit; medium dice the flesh. Add to the bowl, stir to combine the salsa, and set aside.",
      "secondary_message": null
    },
    {
      "id": 573853,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 573854,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n0.23 kg ground chicken\n1 tsp chili powder\n¼ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 573855,
      "primary_message": "Meanwhile, halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 573856,
      "primary_message": "Place tortillas on a flat surface. Divide chicken filling, salsa, and lettuce down the center of each. Fold in sides of tortillas and roll tightly to close the burritos. (Reserve skillet for the next step.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 573857,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Lay burritos, seam-side down, in the skillet and cook, rotating every 2-3 minutes, until golden brown and crispy on all sides. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 573858,
      "primary_message": "To serve, cut burritos in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
