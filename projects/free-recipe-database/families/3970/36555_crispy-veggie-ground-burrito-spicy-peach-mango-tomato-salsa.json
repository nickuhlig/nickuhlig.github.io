  "instructions": [
    {
      "id": 573907,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 ½ jalapeño peppers\n3 tomatoes\n3 mangoes\n3 peaches\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 573908,
      "primary_message": "Juice limes into a medium bowl. Add oil, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 573909,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 573910,
      "primary_message": "Medium dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 573911,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 573912,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh. Add to the bowl and stir to combine the salsa. Set aside.",
      "secondary_message": null
    },
    {
      "id": 573913,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 573914,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 tbsp chili powder\n¾ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 573915,
      "primary_message": "Meanwhile, halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 573916,
      "primary_message": "Place tortillas on a flat surface. Divide veggie ground filling, salsa, and lettuce down the center of each. Fold in sides of tortillas and roll tightly to close the burritos. (Reserve skillet for the next step.)",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 573917,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Working in batches, lay burritos, seam-side down, in the skillet and cook, rotating every 2-3 minutes, until golden brown and crispy on all sides. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 573918,
      "primary_message": "To serve, cut burritos in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
