  "instructions": [
    {
      "id": 203133,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 203134,
      "primary_message": "Wash, dry, and zest the oranges into a large bowl.",
      "secondary_message": "1 ½ oranges"
    },
    {
      "id": 203135,
      "primary_message": "Juice the oranges into a medium saucepan. Add cherries and sugar to the pan, stir to combine, and set aside to thaw.",
      "secondary_message": "3 cup frozen cherries\n⅓ cup granulated sugar"
    },
    {
      "id": 203136,
      "primary_message": "Meanwhile, using a box grater, coarsely grate cream cheese into the bowl with the orange zest; add vanilla and cardamom. Use a silicone spatula or fork to soften and combine the cream cheese mixture, creating a smooth cream.",
      "secondary_message": "1 (8 oz) block cream cheese\n1 ½ tsp vanilla extract\n3 pinch cardamom, ground"
    },
    {
      "id": 203137,
      "primary_message": "Using a strainer, sift powdered sugar into the bowl with the cream cheese. Use the spatula or fork to mash and combine the mixture until smooth and no lumps remain. Set aside.",
      "secondary_message": "1 cup powdered sugar"
    },
    {
      "id": 203138,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "12 fl oz (1 ½ cups) heavy cream"
    },
    {
      "id": 203139,
      "primary_message": "Transfer half of the whipped cream to the bowl with the cream cheese mixture. Using a silicone spatula, gently fold the two together until almost combined. Add remaining whipped cream and continue to fold until just combined.",
      "secondary_message": null
    },
    {
      "id": 203140,
      "primary_message": "Divide the mousse between small bowls, cups, or jars. Cover with plastic wrap or lids and refrigerate until set, about 1 hour (or overnight).",
      "secondary_message": null
    },
    {
      "id": 203141,
      "primary_message": "While the mousse sets, make the cherry compote. Place the saucepan with the cherry mixture over medium heat and bring to a simmer.",
      "secondary_message": null
    },
    {
      "id": 203142,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "⅓ cup water\n2 tbsp cornstarch"
    },
    {
      "id": 203143,
      "primary_message": "When the liquid in the saucepan is simmering, add slurry in a steady stream while stirring quickly with a silicone spatula. Simmer until sauce thickens, about 3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 203144,
      "primary_message": "Transfer cherry compote to a medium, heat-proof bowl or container and let cool to room temperature. Cover with plastic wrap or a lid and refrigerate until ready to use.",
      "secondary_message": null
    },
    {
      "id": 203145,
      "primary_message": "Right before serving, roughly chop pistachios.",
      "secondary_message": "⅜ cup pistachios, unsalted"
    },
    {
      "id": 203146,
      "primary_message": "To serve, top mousse with cherry compote and pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
