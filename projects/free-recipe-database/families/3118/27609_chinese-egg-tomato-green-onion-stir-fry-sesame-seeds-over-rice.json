  "instructions": [
    {
      "id": 443475,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 443476,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n12 tomatoes\n1 small bunch green onions (scallions)"
    },
    {
      "id": 443477,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 443478,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 443479,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the ginger and garlic, then set aside.",
      "secondary_message": null
    },
    {
      "id": 443480,
      "primary_message": "Crack eggs into another large bowl. Add salt, then beat with a whisk or fork until smooth. ",
      "secondary_message": "18 eggs\n¾ tsp salt"
    },
    {
      "id": 443481,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 443482,
      "primary_message": "While the pot heats up, trim and cut green onions crosswise into thin pieces. ",
      "secondary_message": null
    },
    {
      "id": 443483,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add green onions (reserving a small handful for serving) and cook, stirring frequently, until beginning to soften, about 30 seconds. ",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 443484,
      "primary_message": "Add eggs to the pot and cook, stirring frequently, until just set, about 4 minutes. Remove to a plate. (Reserve pot for the next step.)",
      "secondary_message": null
    },
    {
      "id": 443485,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. Add tomatoes and soy sauce; cook, stirring occasionally, until beginning to soften, about 4 minutes.",
      "secondary_message": "3 tbsp neutral vegetable oil\n⅓ cup soy sauce"
    },
    {
      "id": 443486,
      "primary_message": "Meanwhile, place water, ketchup, cornstarch, and sugar in a small bowl. Whisk to combine the sauce. ",
      "secondary_message": "⅓ cup water\n⅓ cup ketchup\n1 tbsp cornstarch\n1 tbsp brown sugar"
    },
    {
      "id": 443487,
      "primary_message": "Once the tomatoes have softened, reduce heat to medium. Add sauce and continue to cook, stirring frequently, until sauce thickens slightly, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 443488,
      "primary_message": "Return eggs to the pot, using a spoon to break them up. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 443489,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved green onions and sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
