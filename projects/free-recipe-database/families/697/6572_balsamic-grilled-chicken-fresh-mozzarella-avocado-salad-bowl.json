  "instructions": [
    {
      "id": 83446,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 heads romaine lettuce\n3 small pkgs grape tomatoes\n1 ½ avocados\n1 ½ small pkgs fresh basil"
    },
    {
      "id": 83447,
      "primary_message": "Peel and mince garlic; transfer to a small bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 83448,
      "primary_message": "To finish the marinade, add balsamic vinegar, olive oil, maple syrup, dried basil, and salt to the bowl with the garlic; whisk to combine.",
      "secondary_message": "¾ cup balsamic vinegar\n⅓ cup extra virgin olive oil\n1 tbsp pure maple syrup\n1 tbsp basil\n1 tbsp salt"
    },
    {
      "id": 83449,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 83450,
      "primary_message": "Transfer chicken to a shallow bowl. Pour half of the marinade over the chicken and stir until well coated. Set the remaining untouched marinade aside to use as salad dressing.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 83451,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook until cooked through, 4-5 minutes per side. Transfer to a plate and set aside to cool. Cook in batches if necessary.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 83452,
      "primary_message": "Chop romaine crosswise into strips and divide between bowls. Halve grape tomatoes and add to the bowls with the romaine.",
      "secondary_message": null
    },
    {
      "id": 83453,
      "primary_message": "Cut the fresh mozzarella into bite-sized pieces and add to the bowls.",
      "secondary_message": "¾ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 83454,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out and add to the bowls.",
      "secondary_message": null
    },
    {
      "id": 83455,
      "primary_message": "Slice chicken into strips and add to the bowls.",
      "secondary_message": null
    },
    {
      "id": 83456,
      "primary_message": "Pick leaves off the basil stems, roll up crosswise and thinly slice into ribbons and sprinkle over top of the salad.",
      "secondary_message": null
    },
    {
      "id": 83457,
      "primary_message": "Drizzle with remaining dressing and enjoy!",
      "secondary_message": null
    }
  ],
