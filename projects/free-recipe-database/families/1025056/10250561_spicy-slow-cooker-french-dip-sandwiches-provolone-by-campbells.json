  "instructions": [
    {
      "primary_message": "Place the beef into a 6-quart slow cooker. Season with salt and pepper (to taste) and the garlic powder and onion powder. Arrange the onions around the beef. Pour the broth and Worcestershire over the onions.",
      "secondary_message": null
    },
    {
      "primary_message": "Cover and cook on HIGH for 3 to 3 1/2 hours or until the beef is fork-tender. Remove the beef to a cutting board. Thinly slice the beef. Return the beef to the cooker and cook, uncovered, on HIGH for another 15 minutes. While the beef is cooking, heat the oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange the rolls, cut-side up, on a baking sheet. Place 2 cheese slices on the top half of each roll. Bake for 5 minutes or until the cheese is melted and the rolls are lightly toasted. Divide the beef and onions among the rolls. Serve with the broth mixture for dipping.",
      "secondary_message": null
    }
  ],
