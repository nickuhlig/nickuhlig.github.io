  "instructions": [
    {
      "id": 473531,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 473532,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 473533,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 473534,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 (227 g) pkg sugar snap peas\n1 bunch radish\n1 small pkg fresh mint\n1 avocado"
    },
    {
      "id": 473535,
      "primary_message": "Juice limes and divide between two small bowls.",
      "secondary_message": null
    },
    {
      "id": 473536,
      "primary_message": "Peel and mince shallot. Add to one of the bowls with lime juice along with fish sauce, soy sauce, sugar, and crushed red pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 shallot\n2 tbsp fish sauce\n2 tbsp soy sauce\n2 tsp brown sugar\n½ tsp crushed red pepper"
    },
    {
      "id": 473537,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 473538,
      "primary_message": "While the skillet heats up, add soy sauce, additional fish sauce, water, chili-garlic sauce, sugar, and cornstarch to the other bowl with the lime juice.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp fish sauce\n2 tbsp water\n2 tbsp chili-garlic sauce\n2 tbsp brown sugar\n2 tsp cornstarch"
    },
    {
      "id": 473539,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble tofu into large pieces with your fingers and add to the skillet. Cook, stirring occasionally, until tofu is golden brown, 6-8 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 473540,
      "primary_message": "Meanwhile, thinly slice snap peas crosswise. Place on a plate. ",
      "secondary_message": null
    },
    {
      "id": 473541,
      "primary_message": "Trim and thinly slice radishes. Add to the plate with the snap peas.",
      "secondary_message": null
    },
    {
      "id": 473542,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 473543,
      "primary_message": "When the tofu is golden brown, reduce heat to medium, add sauce to the skillet, and gently stir to coat. Cook until sauce thickens slightly and coats tofu, about 30 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 473544,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and large dice the flesh. Add to the plate. ",
      "secondary_message": null
    },
    {
      "id": 473545,
      "primary_message": "Roughly chop cashews and add to the plate.",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 473546,
      "primary_message": "To serve, divide rice between bowls; top with tofu, snap peas, radish, avocado, mint, and cashews. Drizzle with dressing as desired and enjoy!",
      "secondary_message": null
    }
  ],
