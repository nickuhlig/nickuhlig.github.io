  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. ",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, peel, and trim sweet potatoes; slice crosswise into ½-inch thick rounds. Transfer to a large baking sheet pan. ",
      "secondary_message": null
    },
    {
      "primary_message": "Drizzle sweet potatoes with oil, season with salt and pepper, then toss to coat.  Spread the slices out in a single layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven and roast, flipping the slices halfway through baking, until sweet potato is fork-tender, about 25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "primary_message": "Just before serving, combine butter, honey, and spices in a small saucepan. Place over medium-low heat and whisk until melted and bubbly. Remove from heat. ",
      "secondary_message": "3 tbsp butter, unsalted\n3 tbsp honey\n½ tsp cinnamon, ground\n¼ tsp clove, ground\n⅛ tsp salt"
    },
    {
      "primary_message": "Arrange sweet potato slices, slightly overlapping them, on a platter; drizzle spiced honey butter over top. ",
      "secondary_message": null
    }
  ],
