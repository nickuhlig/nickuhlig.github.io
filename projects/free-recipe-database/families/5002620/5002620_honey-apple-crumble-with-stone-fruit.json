  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the apples into 1/2-inch pieces. Juice the lemon. Coarsely chop the almonds. Cut the cold unsalted butter into 1-tablespoon pieces.",
      "secondary_message": "3 ½ apples\n1 lemon\n⅔ cup almonds\n8 tbsp cold unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Filling: In a large bowl, add fruit, lemon juice, honey, and brown sugar and toss to combine; Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Crumble: In a medium bowl, add ground oats, all-purpose flour, brown sugar, nuts, and kosher salt and whisk to combine. Add butter pieces and, using hands, mix and smoosh butter into the dry mixture until a crumbly, wet, sand-like mixture forms and you can make small clumps in your hand.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer fruit filling to a 9-inch round cake pan, and press into an even layer. Sprinkle topping evenly over filling, breaking up any large clumps with your fingers and using hands to shape small clumps of crumble ranging in size, but not larger than a blueberry.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake on a rimmed baking sheet until juices are bubbling around edges of pan, crumble is golden brown, and fruit is tender when pierced with a fork, 45 to 55 minutes",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Let cool for 20 minutes before serving.",
      "secondary_message": null
    }
  ],
