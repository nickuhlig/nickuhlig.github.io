  "instructions": [
    {
      "id": 65807,
      "primary_message": "Preheat oven to 425°F. Line a baking sheet with parchment paper.",
      "secondary_message": ""
    },
    {
      "id": 65799,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together the minced garlic, lemon juice, olive oil, Dijon, salt, and pepper. Set aside.",
      "secondary_message": "3 cloves garlic\njuice of 1 ½ lemon\n9 tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 65806,
      "primary_message": "Measure out feta into a small bowl and set aside.",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 65805,
      "primary_message": "Wash asparagus and snap (or cut) off woody ends. Place in a single layer on the baking sheet; drizzle with olive oil and season with salt and pepper.",
      "secondary_message": "3 small bunches asparagus\n3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 65804,
      "primary_message": "Place in the oven and roast until tender, 10-12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 65803,
      "primary_message": "Fill a sauté pan three-quarters of the way with water and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 65802,
      "primary_message": "Crack 6 of the eggs into small bowls.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 65801,
      "primary_message": "Once water in pan is boiling, reduce heat to medium-low. When the water is simmering, gently tip bowls, sliding eggs carefully into the water. Cook until whites are set but yolks are soft, 2 ½ to 3 minutes. Transfer eggs to paper towels. Repeat with the remaining 6 eggs.",
      "secondary_message": ""
    },
    {
      "id": 65800,
      "primary_message": "To serve, arrange roasted asparagus on a plate and top with poached eggs. Drizzle with dressing and sprinkle with feta. Enjoy!",
      "secondary_message": ""
    }
  ],
