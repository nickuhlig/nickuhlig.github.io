  "instructions": [
    {
      "id": 195997,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 yellow bell peppers\n3 red bell peppers\n3 sticks celery"
    },
    {
      "id": 195998,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large pot.",
      "secondary_message": null
    },
    {
      "id": 195999,
      "primary_message": "Peel and mince garlic. Add to the pot along with coconut milk and salt; stir to combine. Bring to a simmer over medium heat and cook, stirring occasionally, until cauliflower is soft and creamy, about 12 minutes. Remove from heat, cover, and set aside. ",
      "secondary_message": "6 cloves garlic\n1 ½ (13.5 fl oz) cans coconut milk\n1 ½ tsp salt"
    },
    {
      "id": 196000,
      "primary_message": "Meanwhile, seed and slice peppers into strips; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 196001,
      "primary_message": "Cut celery crosswise into ¼-inch pieces at an angle; add to the bowl with the peppers and set aside. ",
      "secondary_message": null
    },
    {
      "id": 196002,
      "primary_message": "Pat steak dry with paper towels and thinly slice against the grain. Cut slices into bite-sized pieces.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 196003,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196004,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 196005,
      "primary_message": "Add steak and stir-fry until golden brown and cooked through, 2-3 minutes. Add peppers and celery; continue to cook, stirring often, until veggies begin to soften, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 196006,
      "primary_message": "Meanwhile, place broth, soy sauce, vinegar, cornstarch, and pepper in the bowl used for the veggies; whisk to combine the sauce. ",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n3 tbsp soy sauce\n3 tbsp rice vinegar\n1 tbsp cornstarch\n1 ½ tsp black pepper"
    },
    {
      "id": 196007,
      "primary_message": "Pour sauce into the pot. Reduce heat to medium and cook, stirring often, until the sauce thickens, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 196008,
      "primary_message": "To serve, divide cauliflower rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
