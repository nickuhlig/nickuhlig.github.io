  "instructions": [
    {
      "id": 266671,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 266672,
      "primary_message": "Fill a medium saucepan halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n142 g penne pasta"
    },
    {
      "id": 266673,
      "primary_message": "Meanwhile, transfer walnuts to a baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until lightly toasted, 5-7 minutes. Remove from oven and set aside to cool.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 266674,
      "primary_message": "While the walnuts are toasting, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.15 kg red grapes\n2 sticks celery\n½ small bunch green onions (scallions)\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 266675,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with oil, vinegar, Dijon, sugar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp Dijon mustard\n½ tsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 266676,
      "primary_message": "Halve grapes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 266677,
      "primary_message": "Trim celery and green onions; slice crosswise into thin pieces and add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 266678,
      "primary_message": "Mince half of the walnuts and add to the bowl. Roughly chop remaining walnuts and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 266679,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 266680,
      "primary_message": "Add arugula to the bowl and toss to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 266681,
      "primary_message": "To serve, divide pasta salad between plates or bowls; top with remaining walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
