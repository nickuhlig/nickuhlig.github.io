  "instructions": [
    {
      "id": 266626,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 266627,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 266628,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n0.15 kg red grapes\n2 sticks celery\n½ small bunch green onions (scallions)\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 266629,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 266630,
      "primary_message": "Once the water comes to a boil, add cauliflower and salt; stir for a few seconds. Return to a boil and cook, uncovered, until crisp-tender, about 3 minutes. Drain and rinse under cold, running water. Set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 266631,
      "primary_message": "While the cauliflower is cooking, transfer walnuts to a baking sheet pan and spread out in an even layer. Place in the oven and bake, stirring halfway through, until lightly toasted, 4-6 minutes. Remove from oven and set aside to cool.",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 266632,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a medium bowl along with oil, vinegar, Dijon, sugar, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp Dijon mustard\n½ tsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 266633,
      "primary_message": "When the cauliflower is done, wipe the saucepan clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 266634,
      "primary_message": "While the pan heats up, medium dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 266635,
      "primary_message": "Once the pan is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 266636,
      "primary_message": "Meanwhile, halve grapes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 266637,
      "primary_message": "Trim celery and green onions; slice crosswise into thin pieces and add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 266638,
      "primary_message": "Mince half of the walnuts and add to the bowl. Roughly chop remaining walnuts and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 266639,
      "primary_message": "Add cauliflower and arugula to the bowl; toss to combine the cauliflower salad.",
      "secondary_message": null
    },
    {
      "id": 266640,
      "primary_message": "To serve, divide cauliflower salad between plates or bowls; top with blue cheese, bacon, and remaining walnuts. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    }
  ],
