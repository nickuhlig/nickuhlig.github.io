  "instructions": [
    {
      "id": 266512,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 266513,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 266514,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 lb red grapes\n6 sticks celery\n1 small bunch green onions (scallions)\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 266515,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 266516,
      "primary_message": "Once the water comes to a boil, add cauliflower and salt; stir for a few seconds. Return to a boil and cook, uncovered, until crisp-tender, about 3 minutes. Drain and rinse under cold, running water. Set aside.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 266517,
      "primary_message": "While the cauliflower is cooking, transfer walnuts to a baking sheet pan and spread out in an even layer. Place in the oven and bake, stirring halfway through, until lightly toasted, 4-6 minutes. Remove from oven and set aside to cool.",
      "secondary_message": "1 cup walnuts"
    },
    {
      "id": 266518,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil, vinegar, Dijon, sugar, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp Dijon mustard\n1 ½ tsp brown sugar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 266519,
      "primary_message": "When the cauliflower is done, wipe the pot clean with paper towels, then set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 266520,
      "primary_message": "Medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 266521,
      "primary_message": "Return the pot to medium-high heat. Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 266522,
      "primary_message": "Meanwhile, halve grapes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 266523,
      "primary_message": "Trim celery and green onions; slice crosswise into thin pieces and add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 266524,
      "primary_message": "Mince half of the walnuts and add to the bowl. Roughly chop remaining walnuts and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 266525,
      "primary_message": "Add cauliflower and arugula to the bowl; toss to combine the cauliflower salad.",
      "secondary_message": null
    },
    {
      "id": 266526,
      "primary_message": "To serve, divide cauliflower salad between plates or bowls; top with blue cheese, bacon, and remaining walnuts. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    }
  ],
