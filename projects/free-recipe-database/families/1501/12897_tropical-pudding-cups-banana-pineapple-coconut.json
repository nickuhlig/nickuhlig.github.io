  "instructions": [
    {
      "id": 217158,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 217159,
      "primary_message": "Place coconut in the skillet and spread out in an even layer. Toast, stirring frequently, until golden brown, about 2 minutes. Remove to a small bowl and set aside.",
      "secondary_message": "1 cup shredded unsweetened coconut"
    },
    {
      "id": 217160,
      "primary_message": "Wash, dry, peel, and small dice pineapples. Transfer half to a blender (reserving the rest for garnish). ",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 217161,
      "primary_message": "Add sugar to the blender with the pineapple and blend on high until smooth. Set aside.",
      "secondary_message": "⅓ cup powdered sugar"
    },
    {
      "id": 217162,
      "primary_message": "Peel bananas, break into chunks, and place in a large bowl. Using a fork or potato masher, mash until smooth.",
      "secondary_message": "9 bananas"
    },
    {
      "id": 217163,
      "primary_message": "Pour pineapple puree into the bowl with the bananas and stir until smooth and combined.",
      "secondary_message": null
    },
    {
      "id": 217164,
      "primary_message": "To serve, divide pudding between small bowls or cups; top with reserved pineapple and coconut. Enjoy!",
      "secondary_message": null
    }
  ],
