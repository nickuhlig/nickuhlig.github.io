  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lime. Finely chop the Thai chiles. Finely slice the red onion. Dice the pineapple. Pick the cilantro leaves from the stems and roughly chop them.",
      "secondary_message": "1 lime\n1 to 2 small Thai chiles\n1 small red onion\n¾ cup pineapple\n½ cup packed fresh cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "To Make the Dressing: Whisk together lime juice, fish sauce, sesame oil, sugar, and chile in a small bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place cashews in a small cast iron skillet over medium heat. Toast until fragrant and lightly browned, about 4 minutes. Transfer to a medium bowl. Add onion, pineapple, and cilantro; toss to combine. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all charcoal is lit and covered with gray ash, pour out and arrange coals on one side of charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Score duck skin diagonally every 1.5-cm. Season breast liberally all over with salt and pepper. Place duck breast on hot side of grill, skin side down, and cook until skin has browned and crisped, 5 to 7 minutes. Flip and brown on other side, about 4 minutes. Move duck to cool side of grill, cover, and continue to cook until an instant-read thermometer registers 54°C when inserted into middle of breast. Remove duck from grill and let rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Thinly slice duck, halving any long strips into bite-size pieces. Add duck into bowl with pineapple mixture. Pour on dressing and toss to combine. Transfer to plates and serve immediately.",
      "secondary_message": null
    }
  ],
