  "instructions": [
    {
      "id": 415236,
      "primary_message": "Pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Sprinkle both sides with flour and salt.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n3 tbsp all-purpose flour\n¾ tsp salt"
    },
    {
      "id": 415237,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415238,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove chicken to a plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 415239,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 oranges\n1 small bunch green onions (scallions)\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 415240,
      "primary_message": "Using a clean cutting board, peel and separate oranges into segments; cut segments crosswise into bite-sized pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 415241,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the orange and set aside.",
      "secondary_message": null
    },
    {
      "id": 415242,
      "primary_message": "When the chicken is done, return skillet (with cooking juices) to medium heat. Add orange, green onion, water, cranberries, coriander, and salt. Cook, stirring occasionally, until orange softens and relish has slightly thickened, 3-4 minutes. Remove from heat.",
      "secondary_message": "¾ cup water\n⅓ cup dried cranberries\n¾ tsp coriander, ground\n¾ tsp salt"
    },
    {
      "id": 415243,
      "primary_message": "Meanwhile, place mixed greens, carrots, feta, and vinaigrette in a large bowl. Gently toss to combine the salad.",
      "secondary_message": "1 ½ (10 oz) bags shredded carrots\n1 ½ (4 oz) pkgs crumbled feta cheese\n½ cup French vinaigrette"
    },
    {
      "id": 415244,
      "primary_message": "To serve, divide chicken and salad between plates; top chicken with orange relish. Enjoy!",
      "secondary_message": null
    }
  ],
