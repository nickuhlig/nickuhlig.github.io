  "instructions": [
    {
      "id": 1,
      "primary_message": "Core apples without peeling, then slice and roughly chop into 1.5 to 0.5-cm pieces. This will yield approximately 1.59 kg prepared fruit (16 cups; 1.5kg). Transfer to a 5-quart Dutch oven, along with sugar, salt, apple cider vinegar, orange peel, and cinnamon stick. Stir to combine, then cover and place over medium heat until apples have wilted and begun to bubble in their own juices, about 15 minutes. If this process seems to be moving slowly, simply turn up the heat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Continue cooking, stirring from time to time, until apples are fall-apart tender, about 10 minutes more. Remove orange peel and cinnamon stick, then purée to your desired consistency with an immersion blender or food processor (see notes). If desired, thin as needed with apple cider to adjust consistency. For a more intense apple flavor, season with 1/4 teaspoon rose water.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer applesauce to glass jars and refrigerate up to 3 weeks. If freezing, make certain not to overfill the containers, as the applesauce will expand once frozen.",
      "secondary_message": null
    }
  ],
