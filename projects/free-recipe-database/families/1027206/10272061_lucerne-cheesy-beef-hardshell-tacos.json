  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 clove garlic"
    },
    {
      "primary_message": "When the onion is soft, add garlic and ground beef to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "680 g lean ground beef"
    },
    {
      "primary_message": "When the beef is done, drain any excess fat, then add water and taco seasoning. Stir to combine, then bring to a boil. Once boiling, reduce heat to medium and cook, stirring occasionally, until sauce is thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 (28 g) pkg taco seasoning"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ heart romaine hearts\n¼ small bunch cilantro\n1 tomato"
    },
    {
      "primary_message": "Cut lettuce crosswise into thin shreds. Shave cilantro leaves off the stems; discard stems and mince the leaves. Small dice tomato. Transfer all three to a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Warm taco shells in an oven or microwave according to package instructions (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide shells between plates. Fill with taco beef, lettuce, cilantro, tomatoes, and cheese. Enjoy!",
      "secondary_message": "½ (227 g) pkg shredded cheese, taco blend"
    }
  ],
