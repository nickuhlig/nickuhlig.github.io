  "instructions": [
    {
      "id": 200527,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "2 tsp salt\n283 g rotini pasta"
    },
    {
      "id": 200528,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n4 tomatoes\n1 small pkg fresh basil\n1 small pkg fresh mint"
    },
    {
      "id": 200529,
      "primary_message": "Snap or cut off woody ends of the asparagus and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 200530,
      "primary_message": "Quarter tomatoes and add to the bowl with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 200531,
      "primary_message": "Peel and thinly slice onions into rings. Add to the bowl along with oil, salt, and pepper; toss to coat.",
      "secondary_message": "2 medium red onions\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 200532,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 200533,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add veggies in a single layer. Cook until tender and charred, turning occasionally, 6-8 minutes. Return grilled veggies to the bowl and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 200534,
      "primary_message": "Meanwhile, combine oil, vinegar, honey, and salt in a small bowl.",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup white wine vinegar\n4 tsp honey\n1 tsp salt"
    },
    {
      "id": 200535,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 200536,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 200537,
      "primary_message": "Once the veggies have cooled slightly, cut into bite-sized pieces and return to the bowl. Add dressing and herbs; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 200538,
      "primary_message": "When the pasta is done, drain and rinse under cold water; add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 200539,
      "primary_message": "Crumble cheese and add to the bowl; toss gently to combine. ",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "id": 200540,
      "primary_message": "To serve, divide pasta salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
