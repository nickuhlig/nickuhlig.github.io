  "instructions": [
    {
      "id": 346346,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 346347,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces; place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 346348,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346349,
      "primary_message": "While the pot heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the bowl with the cauliflower (reserving the rest for serving).",
      "secondary_message": null
    },
    {
      "id": 346350,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 tbsp chili powder\n¾ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 346351,
      "primary_message": "Meanwhile, peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the cauliflower and cilantro.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 346352,
      "primary_message": "When the veggie ground is done, add vegetables to the pot and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 346353,
      "primary_message": "Add broth, pumpkin, and coconut milk to the pot; stir to combine and bring the soup to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until the cauliflower is soft, 10-15 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 (398 ml) cans pure pumpkin purée\n1 ½ (398 ml) cans coconut milk"
    },
    {
      "id": 346354,
      "primary_message": "When the soup is done, juice limes into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 346355,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
