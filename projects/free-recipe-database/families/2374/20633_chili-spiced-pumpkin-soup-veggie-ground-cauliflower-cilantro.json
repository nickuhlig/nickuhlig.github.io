  "instructions": [
    {
      "id": 346336,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 346337,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces; place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 346338,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346339,
      "primary_message": "While the pot heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the bowl with the cauliflower (reserving the rest for serving).",
      "secondary_message": null
    },
    {
      "id": 346340,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n2 tsp chili powder\n½ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 346341,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the cauliflower and cilantro.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 346342,
      "primary_message": "When the veggie ground is done, add vegetables to the pot and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 346343,
      "primary_message": "Add broth, pumpkin, and coconut milk to the pot; stir to combine and bring the soup to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until the cauliflower is soft, about 10 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n2 (398 ml) cans pure pumpkin purée\n1 (398 ml) can coconut milk"
    },
    {
      "id": 346344,
      "primary_message": "When the soup is done, juice lime into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 346345,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
