  "instructions": [
    {
      "id": 346316,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 346317,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces; place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 346318,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346319,
      "primary_message": "While the pot heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the bowl with the cauliflower (reserving the rest for serving).",
      "secondary_message": null
    },
    {
      "id": 346320,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add pork and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg lean ground pork\n1 tbsp chili powder\n¾ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 346321,
      "primary_message": "Meanwhile, peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the cauliflower and cilantro.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 346322,
      "primary_message": "When the pork is done, add veggies to the pot and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 346323,
      "primary_message": "Add broth and pumpkin to the pot; stir to combine and bring the soup to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until the cauliflower is soft, 10-15 minutes.",
      "secondary_message": "2129 ml chicken or vegetable broth\n3 (398 ml) cans pure pumpkin purée"
    },
    {
      "id": 346324,
      "primary_message": "When the soup is done, juice limes into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 346325,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
