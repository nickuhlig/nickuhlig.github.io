  "instructions": [
    {
      "id": 178996,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 178997,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb sweet potato\n2 caps portobello mushrooms\n2 tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 178998,
      "primary_message": "Peel and slice potato into ¼-inch thick strips. Place in a medium bowl and add oil and salt; toss to coat and spread out on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping once, until golden and fork-tender, about 25 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 178999,
      "primary_message": "Trim and slice mushrooms into ½-inch thick pieces; place in the bowl used for the potatoes, add oil and salt, then toss to coat. Spread out on another baking sheet pan, add to the oven, and roast until soft, 10-12 minutes. Remove mushrooms to a plate to cool.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 179000,
      "primary_message": "Meanwhile, heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 179001,
      "primary_message": "Peel and thinly slice the onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 179002,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 179003,
      "primary_message": "Add onions to the skillet and cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 179004,
      "primary_message": "Meanwhile, medium dice tomatoes. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 179005,
      "primary_message": "Add tomatoes, half the basil, vinegar, salt, and pepper to the skillet. Continue to cook, stirring occasionally, until the tomatoes break down and the sauce thickens, 4-5 minutes. Reserve remaining basil for garnish.",
      "secondary_message": "1 tbsp balsamic vinegar\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 179006,
      "primary_message": "Wipe the baking sheet pan used for the mushrooms dry, then cut the buns in half and place them on the pan. Toast in the oven until golden brown, 3-4 minutes.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 179007,
      "primary_message": "Meanwhile, thinly slice mozzarella.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 179008,
      "primary_message": "Spread each bun half with mayo, then top with the tomato jam, mushrooms, and mozzarella. Return to the oven and bake until the cheese melts, about 5 minutes.",
      "secondary_message": "2 tbsp mayonnaise"
    },
    {
      "id": 179009,
      "primary_message": "To serve, divide the melts and sweet potatoes between plates. Sprinkle melts with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
