  "instructions": [
    {
      "id": 179024,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 179025,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n6 caps portobello mushrooms\n6 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 179026,
      "primary_message": "Peel and slice potatoes into ¼-inch thick strips. Place in a large bowl and add oil and salt; toss to coat and spread out between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping once, until golden and fork-tender, about 30 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 179027,
      "primary_message": "Trim and slice mushrooms into ½-inch thick pieces; place in the bowl used for the potatoes, add oil and salt, then toss to coat. Spread out on a third large baking sheet pan, add to the oven, and roast until soft, 12-15 minutes. Remove mushrooms to a plate to cool.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 179028,
      "primary_message": "Meanwhile, heat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 179029,
      "primary_message": "Peel and thinly slice the onions.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 179030,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 179031,
      "primary_message": "Add onions to the skillet and cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 179032,
      "primary_message": "Meanwhile, medium dice tomatoes. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 179033,
      "primary_message": "Add tomatoes, half the basil, vinegar, salt, and pepper to the skillet. Continue to cook, stirring occasionally, until the tomatoes break down and the sauce thickens, 6-7 minutes. Reserve remaining basil for garnish.",
      "secondary_message": "3 tbsp balsamic vinegar\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 179034,
      "primary_message": "Wipe the baking sheet pan used for the mushrooms dry, then cut the buns in half and place them on the pan. Toast in the oven until golden brown, 3-4 minutes.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 179035,
      "primary_message": "Meanwhile, thinly slice mozzarella.",
      "secondary_message": "1 ½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 179036,
      "primary_message": "Spread each bun half with mayo, then top with the tomato jam, mushrooms, and mozzarella. Return to the oven and bake until the cheese melts, about 6 minutes.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 179037,
      "primary_message": "To serve, divide the melts and sweet potatoes between plates. Sprinkle melts with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
