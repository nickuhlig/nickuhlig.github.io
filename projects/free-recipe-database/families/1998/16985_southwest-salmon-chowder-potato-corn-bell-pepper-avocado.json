  "instructions": [
    {
      "id": 276495,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n1 red bell pepper\n½ lime\n½ avocado"
    },
    {
      "id": 276496,
      "primary_message": "Peel and small dice potatoes; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 276497,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the potato and set aside.",
      "secondary_message": null
    },
    {
      "id": 276498,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 276499,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 276500,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add potato, bell pepper, and onion; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 276501,
      "primary_message": "Sprinkle flour and spices over the veggies; continue to cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "1 tbsp all-purpose flour\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 276502,
      "primary_message": "Add broth and milk to the pan, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium, and cook until potatoes are tender, 10-12 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n237 ml whole milk"
    },
    {
      "id": 276503,
      "primary_message": "Meanwhile, slice lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 276504,
      "primary_message": "Halve and pit avocado; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 276505,
      "primary_message": "When the soup is done, drain and break salmon into chunks; add to the pan, along with the corn, and stir to combine. Cook until heated through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 (213 g) can wild pink salmon, traditional style\n⅔ cup frozen corn"
    },
    {
      "id": 276506,
      "primary_message": "Divide soup between bowls, top with avocado, and sprinkle with additional chili powder. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": "⅛ tsp chili powder"
    }
  ],
