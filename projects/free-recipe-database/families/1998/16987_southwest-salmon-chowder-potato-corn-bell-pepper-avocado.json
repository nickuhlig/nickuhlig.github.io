  "instructions": [
    {
      "id": 276519,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n3 red bell peppers\n1 lime\n1 ½ avocados"
    },
    {
      "id": 276520,
      "primary_message": "Peel and small dice potatoes; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 276521,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the potato and set aside.",
      "secondary_message": null
    },
    {
      "id": 276522,
      "primary_message": "Peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 276523,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 276524,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add potato, bell pepper, and onion; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 276525,
      "primary_message": "Sprinkle flour and spices over the veggies; continue to cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "3 tbsp all-purpose flour\n1 tbsp chili powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 276526,
      "primary_message": "Add broth and milk to the pot, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium, and cook until potatoes are tender, 10-12 minutes.",
      "secondary_message": "2129 ml chicken or vegetable broth\n710 ml whole milk"
    },
    {
      "id": 276527,
      "primary_message": "Meanwhile, slice lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 276528,
      "primary_message": "Halve and pit avocados; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 276529,
      "primary_message": "When the soup is done, drain and break salmon into chunks; add to the pot, along with the corn, and stir to combine. Cook until heated through, 4-5 minutes more. Remove from heat.",
      "secondary_message": "3 (213 g) cans wild pink salmon, traditional style\n2 cups frozen corn"
    },
    {
      "id": 276530,
      "primary_message": "Divide soup between bowls, top with avocado, and sprinkle with additional chili powder. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": "½ tsp chili powder"
    }
  ],
