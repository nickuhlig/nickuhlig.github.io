  "instructions": [
    {
      "id": 429641,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 429642,
      "primary_message": "Place vinegar and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup rice vinegar\n1 ½ tsp salt"
    },
    {
      "id": 429643,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 429644,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n3 small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 429645,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 429646,
      "primary_message": "Peel garlic. Add to the baking sheets with the pepper along with the tomatoes. Drizzle veggies with oil, then season with salt and crushed red pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "12 cloves garlic\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 429647,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are browned and fork-tender, about 25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 429648,
      "primary_message": "About 15 minutes before the veggies are done, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 429649,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 429650,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 429651,
      "primary_message": "Meanwhile, pick basil leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 429652,
      "primary_message": "When the veggies are done, remove from the oven. Add basil and pickled onion to the baking sheets, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 429653,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 429654,
      "primary_message": "To serve, divide steak and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
