  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the onion. Finely chop the leek. Chop the hanger steak. Finely chop the parsnip. Chop the potato. Finely chop the carrot. Chop the thyme. Beat the egg.",
      "secondary_message": "1 small onion\n1 small leek\n0.23 kg hanger steak\n1 parsnip\n1 potato\n1 carrot\n2 sprigs thyme\n1 egg"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 205°C (400°F). Melt butter in skillet and add onion and leek; cook until soft, about 5 minutes. Remove from heat and allow to cool. In a bowl combine steak, parsnip, potato, carrot, and thyme, and toss to combine. Once onion and leeks are cool, add to mixture and mix. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Roll out pastry into 0.5 cm-thick sheet. Cut into 4 circles about 13 cm across. If all circles cannot be cut out of initial sheet of pastry re-roll pastry and cut out remaining circles if necessary.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spoon between 1/3 and 1/2 cup of filling mixture onto one half of pastry circle. Brush edges with beaten egg and fold other half over filling. Seal by pressing gently with a fork or your fingers. Place on prepared baking sheet and repeat with remaining pastry and filling (there may be filling left over). Brush all pasties with beaten egg.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place in 205°C (400°F) oven; when pastry begins to brown, turn oven down to 175°C (350°F) and bake for an additional 25 minutes. Remove from oven and allow to cool. Serve with strong ale.",
      "secondary_message": null
    }
  ],
