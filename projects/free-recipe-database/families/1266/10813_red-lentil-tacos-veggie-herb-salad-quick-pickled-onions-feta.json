  "instructions": [
    {
      "id": 212538,
      "primary_message": "Peel and slice half the onion into thin half-rings. Small dice remaining onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 212539,
      "primary_message": "Place sliced onion in a small bowl along with vinegar and salt. Toss to combine and set aside.",
      "secondary_message": "2 tbsp white wine vinegar\n¼ tsp salt"
    },
    {
      "id": 212540,
      "primary_message": "Preheat a small saucepan over medium heat. Once the pan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 212541,
      "primary_message": "Add diced onion and garlic to the pan; cook, stirring frequently, until onion begins to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 212542,
      "primary_message": "Rinse lentils under cold water and add to the pan along with the broth. Bring to a boil over high heat, then reduce heat to a simmer and cook until tender, 15-20 minutes.",
      "secondary_message": "½ cup red lentils\n355 ml chicken or vegetable broth"
    },
    {
      "id": 212543,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n½ small bunch Italian (flat-leaf) parsley\n½ small bunch fresh dill\n½ (142 g) pkg baby arugula\n½ English cucumber\n2 tomatoes"
    },
    {
      "id": 212544,
      "primary_message": "Juice lemon into a large bowl. Add olive oil and salt; stir to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 212545,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212546,
      "primary_message": "Shave dill leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212547,
      "primary_message": "Roughly chop arugula and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212548,
      "primary_message": "Trim and small dice cucumber and tomatoes; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212549,
      "primary_message": "Halve olives and add to bowl. Toss to combine the salad.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 212550,
      "primary_message": "Once lentils are done, drain off excess liquid and return to pan. Add paprika and salt; stir to combine.",
      "secondary_message": "½ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 212551,
      "primary_message": "To serve, divide tortillas between plates and fill with lentils. Top with salad, pickled onions, and feta. Enjoy!",
      "secondary_message": "4 small flour tortillas\n½ (113 g) pkg crumbled feta cheese"
    }
  ],
