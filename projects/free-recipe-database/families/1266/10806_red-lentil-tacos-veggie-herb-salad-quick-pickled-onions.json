  "instructions": [
    {
      "id": 212440,
      "primary_message": "Peel and slice half the onions into thin half-rings. Small dice remaining onions. Peel and mince garlic.",
      "secondary_message": "3 medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 212441,
      "primary_message": "Place sliced onion in a small bowl along with vinegar and salt. Toss to combine and set aside.",
      "secondary_message": "⅓ cup white wine vinegar\n¾ tsp salt"
    },
    {
      "id": 212442,
      "primary_message": "Preheat a medium saucepan over medium heat. Once the pan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 212443,
      "primary_message": "Add diced onion and garlic to the pan; cook, stirring frequently, until onion begins to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 212444,
      "primary_message": "Rinse lentils under cold water and add to the pan along with the broth. Bring to a boil over high heat, then reduce heat to a simmer and cook until tender, 15-20 minutes.",
      "secondary_message": "1 ½ cup red lentils\n36 fl oz (4 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 212445,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 lemons\n1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ small bunches fresh dill\n1 (5 oz) pkg baby arugula\n1 ½ English cucumbers\n6 tomatoes"
    },
    {
      "id": 212446,
      "primary_message": "Juice lemons into a large bowl. Add olive oil and salt; stir to combine.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 212447,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212448,
      "primary_message": "Shave dill leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212449,
      "primary_message": "Roughly chop arugula and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212450,
      "primary_message": "Trim and small dice cucumbers and tomatoes; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 212451,
      "primary_message": "Halve olives and add to bowl. Toss to combine the salad.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 212452,
      "primary_message": "Once lentils are done, drain off excess liquid and return to pan. Add paprika and salt; stir to combine.",
      "secondary_message": "1 ½ tsp paprika\n¾ tsp salt"
    },
    {
      "id": 212453,
      "primary_message": "To serve, divide tortillas between plates and fill with lentils. Top with salad and pickled onions. Enjoy!",
      "secondary_message": "12 small flour tortillas"
    }
  ],
