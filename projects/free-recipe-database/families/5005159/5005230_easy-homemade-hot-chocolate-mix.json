  "instructions": [
    {
      "id": 1,
      "primary_message": "Place chocolate bars in freezer until completely frozen, about 10 minute. Remove from freezer, break into rough pieces, and place in food processor with cocoa powder, sugar, cornstarch, and salt. Process until completely powdered, about 1 minute. Transfer to airtight container and store in cool, dark place for up to 3 months.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To make hot chocolate, combine 1 to 2 tablespoons mixture (or more if desired) with 1 cup boiling milk. Stir or whisk until combined. To thicken further, return to heat and simmer for 30 seconds until thick and smooth.",
      "secondary_message": null
    }
  ],
