  "instructions": [
    {
      "id": 30545,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 30546,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 30547,
      "primary_message": "Gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolk is still runny, 2 to 3 minutes.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 30543,
      "primary_message": "While the eggs cook, wash and dry the tomato, then thinly into rounds and discard the stem end.",
      "secondary_message": "1 tomato"
    },
    {
      "id": 30544,
      "primary_message": "Thinly slice the avocado flesh crosswise (without piercing the skin) and scoop out.",
      "secondary_message": "½ avocado"
    },
    {
      "id": 30548,
      "primary_message": "Season the eggs with salt and pepper.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 30549,
      "primary_message": "To serve, transfer the eggs to a plate and place the tomato and avocado slices on the side. Season the tomato and avocado slices with salt and pepper if desired. Enjoy!",
      "secondary_message": null
    }
  ],
