  "ingredients": [
    {
      "ingredient_id": 2557,
      "name": "brown rice flour, plus more for dusting",
      "quantity": "1 ½ cups (7 ½ oz)"
    },
    {
      "ingredient_id": 2570,
      "name": "tapioca starch",
      "quantity": "½ cup (2 oz)"
    },
    {
      "ingredient_id": 2524,
      "name": "xanthan gum",
      "quantity": "1 tsp"
    },
    {
      "ingredient_id": 121,
      "name": "eggs",
      "quantity": "4 large"
    },
    {
      "ingredient_id": 88,
      "name": "Kosher salt",
      "quantity": ""
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk together brown rice flour, tapioca starch, and xanthan gum. Add eggs. Switch to a wooden spoon and stir until a dough forms. Generously dust your counter with brown rice flour. Turn dough out onto counter and knead a few times until fairly smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Divide dough into 4 equal pieces and work with 1 piece at a time, keeping the rest covered. Press the dough to flatten it slightly. Using a pasta machine set at the widest setting, run the dough through 2 times. Continue rolling dough through successively narrower settings until you reach the second-to-last setting.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cut dough sheet in half horizontally and pass each through the fettuccine cutter. (The spaghetti setting is too thin for this gluten-free pasta.) Dust pasta with brown rice flour and place on a rimmed baking sheet. Repeat with remaining dough pieces.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bring a pot of salted water to a boil. Cook pasta until tender, about 5 minutes. Serve immediately with your choice of sauce.",
      "secondary_message": null
    }
  ],
