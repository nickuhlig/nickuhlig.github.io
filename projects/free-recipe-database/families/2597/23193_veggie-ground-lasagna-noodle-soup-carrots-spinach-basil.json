  "instructions": [
    {
      "id": 381999,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 382000,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggie ground, carrots, onion powder, and salt; cook, breaking the veggie ground apart with a spoon, until almost cooked through, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 ½ (283 g) bags shredded carrots\n1 tbsp onion powder\n1 ½ tsp salt"
    },
    {
      "id": 382001,
      "primary_message": "Meanwhile, break lasagna noodles into bite-sized pieces. ",
      "secondary_message": "12 no-boil lasagna noodles"
    },
    {
      "id": 382002,
      "primary_message": "When the veggie ground is done, add noodles, broth, and tomato sauce to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until noodles start to soften, 7-8 minutes. ",
      "secondary_message": "1774 ml chicken or vegetable broth\n3 (213 ml) cans tomato sauce"
    },
    {
      "id": 382003,
      "primary_message": "While the soup is cooking, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Set aside.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 382004,
      "primary_message": "Add spinach and half of the basil to the pot (reserve remaining basil for serving). Return soup to a simmer and continue to cook, stirring occasionally, until spinach is warmed through and noodles are tender, about 4 minutes. ",
      "secondary_message": "1 ½ (454 g) bags frozen chopped spinach"
    },
    {
      "id": 382005,
      "primary_message": "To serve, divide soup between bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
