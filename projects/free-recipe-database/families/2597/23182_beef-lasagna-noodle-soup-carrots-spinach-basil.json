  "instructions": [
    {
      "id": 381922,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381923,
      "primary_message": "Once the pan is hot, add beef, carrots, and spices. Cook, breaking the meat apart with a spoon, until almost cooked through, 4-5 minutes.",
      "secondary_message": "¾ lb lean ground beef\n½ (10 oz) bag shredded carrots\n1 tsp onion powder\n1 tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 381924,
      "primary_message": "Meanwhile, break lasagna noodles into bite-sized pieces. ",
      "secondary_message": "4 no-boil lasagna noodles"
    },
    {
      "id": 381925,
      "primary_message": "When the beef is done, add noodles, broth, and tomato sauce to the pan; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until noodles start to soften, 7-8 minutes. ",
      "secondary_message": "20 fl oz (2 ½ cups) chicken or vegetable broth\n1 (8 oz) can tomato sauce"
    },
    {
      "id": 381926,
      "primary_message": "While the soup is cooking, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 381927,
      "primary_message": "Add spinach and half of the basil to the pan (reserve remaining basil for serving). Return soup to a simmer and continue to cook, stirring occasionally, until spinach is warmed through and noodles are tender, 3-4 minutes more. ",
      "secondary_message": "½ (16oz) bag frozen chopped spinach"
    },
    {
      "id": 381928,
      "primary_message": "To serve, divide soup between bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
