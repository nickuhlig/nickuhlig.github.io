  "instructions": [
    {
      "id": 381950,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381951,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggie ground, carrots, onion powder, and salt; cook, breaking the veggie ground apart with a spoon, until almost cooked through, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based\n1 (10 oz) bag shredded carrots\n2 tsp onion powder\n1 tsp salt"
    },
    {
      "id": 381952,
      "primary_message": "Meanwhile, break lasagna noodles into bite-sized pieces. ",
      "secondary_message": "8 no-boil lasagna noodles"
    },
    {
      "id": 381953,
      "primary_message": "When the veggie ground is done, add noodles, broth, and tomato sauce to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until noodles start to soften, 7-8 minutes. ",
      "secondary_message": "40 fl oz (5 cups) chicken or vegetable broth\n2 (8 oz) cans tomato sauce"
    },
    {
      "id": 381954,
      "primary_message": "While the soup is cooking, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Set aside.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 381955,
      "primary_message": "Add spinach and half of the basil to the pot (reserve remaining basil for serving). Return soup to a simmer and continue to cook, stirring occasionally, until spinach is warmed through and noodles are tender, 3-4 minutes more. ",
      "secondary_message": "1 (16oz) bag frozen chopped spinach"
    },
    {
      "id": 381956,
      "primary_message": "To serve, divide soup between bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
