  "instructions": [
    {
      "id": 381936,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381937,
      "primary_message": "Once the pot is hot, add beef, carrots, and spices. Cook, breaking the meat apart with a spoon, until almost cooked through, 5-6 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef\n1 ½ (10 oz) bags shredded carrots\n1 tbsp onion powder\n1 tbsp Italian seasoning\n1 ½ tsp salt"
    },
    {
      "id": 381938,
      "primary_message": "Meanwhile, break lasagna noodles into bite-sized pieces. ",
      "secondary_message": "12 no-boil lasagna noodles"
    },
    {
      "id": 381939,
      "primary_message": "When the beef is done, add noodles, broth, and tomato sauce to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until noodles start to soften, 7-8 minutes. ",
      "secondary_message": "60 fl oz (7 ½ cups) chicken or vegetable broth\n3 (8 oz) cans tomato sauce"
    },
    {
      "id": 381940,
      "primary_message": "While the soup is cooking, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 381941,
      "primary_message": "Add spinach and half of the basil to the pot (reserve remaining basil for serving). Return soup to a simmer and continue to cook, stirring occasionally, until spinach is warmed through and noodles are tender, about 4 minutes. ",
      "secondary_message": "1 ½ (16oz) bags frozen chopped spinach"
    },
    {
      "id": 381942,
      "primary_message": "To serve, divide soup between bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
