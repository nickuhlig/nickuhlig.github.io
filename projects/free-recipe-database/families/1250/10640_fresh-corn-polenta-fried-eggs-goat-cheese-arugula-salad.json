  "instructions": [
    {
      "id": 193367,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 ears corn\n½ small bunch green onions (scallions)\n1 pint grape tomatoes\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 193368,
      "primary_message": "Remove husks and silks from corn. Using your hands, snap each ear in half. Working over a large bowl, coarsely grate corn off of the cob, catching all of the kernels and corn juices in the bowl.",
      "secondary_message": null
    },
    {
      "id": 193369,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 193370,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom. Add corn and its juices to the saucepan, along with cream, salt, and pepper. Cook, stirring frequently, until the corn is cooked and most of the liquid has evaporated, about 5 minutes. Reserve bowl for later use.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 fl oz (¼ cup) heavy cream\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 193371,
      "primary_message": "Meanwhile, finely grate Parmesan. Add to the saucepan with the corn and stir to combine the polenta. Cover and remove from heat.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 193372,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 193373,
      "primary_message": "While the skillet heats up, place oil, vinegar, salt, and pepper in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 193374,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Cooking in batches if necessary, gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but the yolks are still runny, about 4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 193375,
      "primary_message": "Meanwhile, trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 193376,
      "primary_message": "Halve tomatoes. Add to the bowl along with the arugula and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 193377,
      "primary_message": "Crumble goat cheese.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 193378,
      "primary_message": "To serve, divide polenta, eggs, and salad between plates. Top the salad with goat cheese and enjoy!",
      "secondary_message": null
    }
  ],
