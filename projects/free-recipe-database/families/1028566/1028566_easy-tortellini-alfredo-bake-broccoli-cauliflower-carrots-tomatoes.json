  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). \n\n",
      "secondary_message": "3 (10 oz) pkg cheese tortellini, fresh or frozen"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and halve grape tomatoes. Place in a large bowl.\n\n",
      "secondary_message": "2 pint grape tomatoes"
    },
    {
      "primary_message": "Place frozen veggies in a colander.",
      "secondary_message": "1 (16 oz) pkg frozen mixed vegetables (broccoli, cauliflower, carrots)"
    },
    {
      "primary_message": "When the tortellini is done, drain over the veggies in the colander (to thaw). Add drained tortellini and veggies to the bowl with the tomatoes, along with Alfredo sauce, salt, and pepper. Stir to combine.\n\n",
      "secondary_message": "2 (16 oz) jar Alfredo sauce\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Transfer tortellini mixture to a large baking dish, spreading it out in an even layer, then sprinkle with cheese. Place baking dish in the preheated oven and bake until warmed through and cheese is golden, about 30 minutes. Remove from oven.\n\n",
      "secondary_message": "2 cups Parmesan cheese, shredded"
    },
    {
      "primary_message": "To serve, divide tortellini bake between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
