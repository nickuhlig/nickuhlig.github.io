  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely grind the graham crackers. Melt the unsalted butter. Finely chop the bittersweet chocolate.",
      "secondary_message": "14 oz graham crackers\n13 tbsp (6 ½ oz) unsalted butter\n12 oz bittersweet chocolate"
    },
    {
      "id": 1,
      "primary_message": "Mix graham cracker crumbs, sugar, salt, water, and melted butter in a large bowl until moistened. Firmly press into bottom of 9- by 13-inch baking dish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat chocolate and cream in medium heatproof bowl in microwave or over pan of barely simmering water, stirring occasionally, until melted and smooth. Spread over crust and then sprinkle with salt and marshmallows.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Chill until chocolate is firm, about 30 minutes. Using handheld torch, lightly brown marshmallows. Cut into squares and serve.",
      "secondary_message": null
    }
  ],
