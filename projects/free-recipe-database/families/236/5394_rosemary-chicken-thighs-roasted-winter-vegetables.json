  "instructions": [
    {
      "id": 64815,
      "primary_message": "Preheat oven to 450°F. Position rack in the center.",
      "secondary_message": ""
    },
    {
      "id": 64814,
      "primary_message": "Wash carrots, turnips, and potatoes.",
      "secondary_message": "4 ½ medium carrots\n3 medium turnips\n1 ½ lb sweet potatoes"
    },
    {
      "id": 64813,
      "primary_message": "Slice carrots diagonally into ¼ inch thick pieces and transfer to a baking sheet pan. Peel turnips, halve lengthwise, slice crosswise into ¼ inch thick half rounds, and add to pan. Halve potatoes lengthwise, slice crosswise into ¼ inch thick half rounds, and add to pan. Peel onion, cut into thin wedges, and add to pan. (Use a second sheet pan if needed).",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 64812,
      "primary_message": "Place pan in the oven and begin roasting vegetables while you prepare the sauce and chicken, about 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 64811,
      "primary_message": "Peel and mince garlic. Wash rosemary and slide leaves off most of the stems (leave a couple stems for garnishing).",
      "secondary_message": "12 cloves garlic\n1 ½ small pkg fresh rosemary"
    },
    {
      "id": 64810,
      "primary_message": "In medium bowl, prepare sauce by combining garlic, rosemary leaves, olive oil, Dijon, thyme, salt, and pepper.",
      "secondary_message": "9 tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n¾ tsp thyme\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 64809,
      "primary_message": "Remove pan from oven. Place chicken thighs over top vegetables. Drizzle sauce over top and toss chicken and vegetables until well coated. Then return to oven and roast until vegetables are tender and chicken is cooked through, about 15 minutes.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 64808,
      "primary_message": "Remove pan from oven. Change oven setting to broil and position rack about 6 inches from the top. Return pan to oven and broil until chicken and vegetables are lightly golden, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 64807,
      "primary_message": "Place vegetables and chicken thighs on a plate. Garnish with remaining rosemary stems and enjoy!",
      "secondary_message": ""
    }
  ],
