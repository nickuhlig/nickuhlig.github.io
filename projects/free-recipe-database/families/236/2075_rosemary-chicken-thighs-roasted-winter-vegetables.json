  "instructions": [
    {
      "id": 19553,
      "primary_message": "Preheat oven to 230°C (450°F). Position rack in the center.",
      "secondary_message": ""
    },
    {
      "id": 19554,
      "primary_message": "Wash carrots, turnip, and potato.",
      "secondary_message": "3 medium carrots\r\n1 medium turnip\r\n1 medium yellow potato"
    },
    {
      "id": 19555,
      "primary_message": "Slice carrots diagonally into ⅔ cm thick pieces and transfer to a baking sheet pan. Peel turnip, halve lengthwise, slice crosswise into ⅔ cm thick half rounds, and add to pan. Halve potato lengthwise, slice crosswise into ⅔ cm thick half rounds, and add to pan. Peel onion, cut into thin wedges, and add to pan.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 19556,
      "primary_message": "Place pan in the oven and begin roasting vegetables while you prepare the sauce and chicken, about 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 19557,
      "primary_message": "Peel and mince garlic. Wash rosemary and slide leaves off most of the stems (leave a couple stems for garnishing).",
      "secondary_message": "4 cloves garlic\r\n½ small pkg fresh rosemary"
    },
    {
      "id": 19558,
      "primary_message": "In small bowl, prepare sauce by combining garlic, rosemary leaves, olive oil, Dijon, thyme, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\r\n½ tsp Dijon mustard\r\n¼ tsp thyme\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19559,
      "primary_message": "Remove pan from oven. Place chicken thighs over top vegetables. Drizzle sauce over top and toss chicken and vegetables until well coated. Then return to oven and roast until vegetables are tender and chicken is cooked through, about 15 minutes.",
      "secondary_message": "0.454 kg chicken thighs, boneless skinless"
    },
    {
      "id": 19560,
      "primary_message": "Remove pan from oven. Change oven setting to broil and position rack about 15 cm from the top. Return pan to oven and broil until chicken and vegetables are lightly golden, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 19561,
      "primary_message": "Place vegetables and chicken thighs on a plate. Garnish with remaining rosemary stems and enjoy!",
      "secondary_message": ""
    }
  ],
