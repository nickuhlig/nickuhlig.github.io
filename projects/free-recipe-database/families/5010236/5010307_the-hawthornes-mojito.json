  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine rum, simple syrup, lime juice, bitters, and mint leaves in a cocktail shaker and fill with ice. Shake vigorously for 15 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add 28 g soda water. Strain through a fine mesh tea strainer into a highball filled with crushed ice. Top up with more soda water and garnish with mint sprig. Serve.",
      "secondary_message": null
    }
