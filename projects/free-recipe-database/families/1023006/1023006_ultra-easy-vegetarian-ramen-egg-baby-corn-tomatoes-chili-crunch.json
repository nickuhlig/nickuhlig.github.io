  "instructions": [
    {
      "primary_message": "Place hot water (from the tap) in a large pot and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise, then cut into ½-inch thick wedges. Drain and cut baby corn into bite-sized pieces.",
      "secondary_message": "1 (15 oz) can baby corn"
    },
    {
      "primary_message": "Once the water is boiling, add veggies and noodles. Stir to combine the soup and cook, stirring occasionally, until noodles and veggies are soft, 3-4 minutes. Remove soup from heat, add flavor packets, and stir until combined.",
      "secondary_message": "2 (3 oz) pkg instant ramen noodle soup, soy sauce flavor"
    },
    {
      "primary_message": "While the soup is cooking, halve eggs lengthwise.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide soup and eggs between bowls. Drizzle with chili crunch and enjoy!",
      "secondary_message": null
    }
  ],
