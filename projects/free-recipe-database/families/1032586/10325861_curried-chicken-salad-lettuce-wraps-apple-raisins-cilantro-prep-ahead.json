  "instructions": [
    {
      "primary_message": "This recipe uses 8 medium food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 head butter (Boston) lettuce\n2 stick celery\n½ small bunch cilantro"
    },
    {
      "primary_message": "Separate the lettuce into leaves. Divide between four of the storage containers, cover, and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince shallot. Place in a medium bowl along with yogurt, mayo, curry powder, and salt, then whisk to combine the dressing.",
      "secondary_message": "1 shallot\n⅔ cup plain Greek yogurt\n½ cup mayonnaise\n2 tbsp curry powder\n½ tsp salt"
    },
    {
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop chicken. Add to the bowl, along with raisins, and stir to combine the chicken salad. ",
      "secondary_message": "3 cups cooked chicken (shredded)\n½ cup raisins"
    },
    {
      "primary_message": "Divide chicken salad between the remaining storage containers. Cover and refrigerate, along with the lettuce leaves, until ready to eat. Fill lettuce cups with chicken salad and enjoy!",
      "secondary_message": null
    }
  ],
