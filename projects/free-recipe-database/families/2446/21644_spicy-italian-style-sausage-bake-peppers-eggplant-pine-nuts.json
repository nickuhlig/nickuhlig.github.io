  "instructions": [
    {
      "id": 364453,
      "primary_message": "Preheat oven to 230°C (450°F) and position rack in the upper third of the oven. ",
      "secondary_message": null
    },
    {
      "id": 364454,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 yellow bell peppers\n2 eggplants\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 364455,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 364456,
      "primary_message": "Trim and medium dice eggplants. Add to the baking sheet with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 364457,
      "primary_message": "Peel, halve, and slice onions lengthwise into thin strips; add to the baking sheet.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 364458,
      "primary_message": "Drizzle veggies with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 364459,
      "primary_message": "Add sausages to the baking sheet, nestling them into the veggies.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 364460,
      "primary_message": "Place the baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring veggies and flipping sausages halfway through, until veggies are tender and sausages are nearly cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 364461,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 364462,
      "primary_message": "Once the skillet is hot, add pine nuts. Cook, stirring constantly, until golden brown, 3-5 minutes. Transfer to a small bowl and set aside.",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 364463,
      "primary_message": "When the veggies and sausages are nearly done, change the oven to broil on high. Broil until veggies and sausages are browned, about 3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 364464,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 364465,
      "primary_message": "Remove baking sheet from the oven, add half of the parsley and vinegar, then toss to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": "¼ cup red wine vinegar"
    },
    {
      "id": 364466,
      "primary_message": "To serve, divide sausages and veggies between plates. Top with toasted pine nuts and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
