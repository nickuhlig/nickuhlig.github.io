  "instructions": [
    {
      "id": 364378,
      "primary_message": "Preheat oven to 450°F. Arrange racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 364379,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 yellow bell peppers\n3 eggplants\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 364380,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 364381,
      "primary_message": "Trim and medium dice eggplants. Add to the baking sheets with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 364382,
      "primary_message": "Peel, halve, and slice onions lengthwise into thin strips; add to the baking sheets.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 364383,
      "primary_message": "Drizzle veggies with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 364384,
      "primary_message": "Add sausages to the baking sheets, nestling them into the veggies.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 364385,
      "primary_message": "Place the baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring veggies and flipping sausages halfway through, until veggies are tender and sausages are nearly cooked through, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 364386,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 364387,
      "primary_message": "Once the skillet is hot, add pine nuts. Cook, stirring constantly, until golden brown, 3-5 minutes. Transfer to a small bowl and set aside.",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 364388,
      "primary_message": "When the veggies and sausages are nearly done, remove from oven. Change oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 364389,
      "primary_message": "Working in batches, return baking sheets to upper rack of the oven and broil until veggies and sausages are browned, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 364390,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 364391,
      "primary_message": "Remove baking sheets from the oven, add half of the parsley and vinegar, then toss to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": "⅓ cup red wine vinegar"
    },
    {
      "id": 364392,
      "primary_message": "To serve, divide sausages and veggies between plates. Top with toasted pine nuts and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
