  "instructions": [
    {
      "id": 36567,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 36568,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 36569,
      "primary_message": "While the skillet warms up, peel and small dice the onion into 6-mm pieces; transfer to a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 36570,
      "primary_message": "Add the ground beef to the skillet; cook, breaking apart with a spoon, until crumbly and browned, 2 to 4 minutes. Once done, transfer the beef to a bowl and leave the juices in the skillet.",
      "secondary_message": "0.68 kg lean ground beef"
    },
    {
      "id": 36571,
      "primary_message": "While the beef cooks, peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 36572,
      "primary_message": "Once the beef has been transferred, add the onion to the skillet; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 36573,
      "primary_message": "While the onion cooks, trim and discard the ends of the eggplants; medium dice the eggplants into 1 ¼-cm cubes and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 36574,
      "primary_message": "Add olive oil to the skillet, followed by the garlic, eggplant, and diced tomatoes; season with cinnamon, salt, and pepper. Cook, stirring occasionally, until the eggplant is tender, 8 to 10 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 (398 ml) cans diced tomatoes\n2 tsp cinnamon\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 36575,
      "primary_message": "While the eggplant cooks, shave the parsley leaves off the stems; discard the stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 36576,
      "primary_message": "Juice the lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 36577,
      "primary_message": "Add olive oil, Dijon, salt, and pepper to the lemon juice; whisk together.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 36578,
      "primary_message": "Return the ground beef to the skillet and stir in half of the parsley (save the rest for garnishing).",
      "secondary_message": null
    },
    {
      "id": 36579,
      "primary_message": "To serve, place the moussaka on a plate, sprinkle with the feta and remaining parsley, and season with additional salt and pepper to taste. Add the arugula on the side and drizzle with the dressing. Enjoy!",
      "secondary_message": null
    }
  ],
