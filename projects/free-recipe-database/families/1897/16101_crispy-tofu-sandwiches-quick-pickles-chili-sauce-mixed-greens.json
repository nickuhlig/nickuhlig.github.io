  "instructions": [
    {
      "id": 264035,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 264036,
      "primary_message": "Cut tofu into ½-inch thick planks along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 264037,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 English cucumber\n1 bunch radish\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 264038,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; whisk to combine the pickling liquid.",
      "secondary_message": "⅓ cup white wine vinegar\n4 tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 264039,
      "primary_message": "Trim and thinly slice cucumber and radishes; add both to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 264040,
      "primary_message": "Place mayo and spices in a small bowl; whisk to combine the spiced mayo.",
      "secondary_message": "¼ cup vegan mayonnaise\n1 tsp paprika\n1 tsp garlic powder\n1 tsp salt"
    },
    {
      "id": 264041,
      "primary_message": "Place tofu planks on the baking sheet. Spread half the spiced mayo over the top side of the tofu, sprinkle with half the bread crumbs (pressing them gently into the surface to adhere), and drizzle with half the oil. Carefully flip tofu and repeat with remaining spiced mayo, bread crumbs, and oil.",
      "secondary_message": "1 cup panko bread crumbs\n4 tsp extra virgin olive oil"
    },
    {
      "id": 264042,
      "primary_message": "Place tofu in the oven and bake, turning once, until the breading is crispy and golden brown, 15-18 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 264043,
      "primary_message": "Meanwhile, place oil, chili-garlic sauce, vinegar, and sugar in a small saucepan; whisk to combine the sauce and bring to a simmer over medium heat. Once simmering, remove from heat and cover with a lid to keep warm. (If the sauce separates, whisk together once more, right before serving.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp chili-garlic sauce\n4 tsp white wine vinegar\n2 tsp brown sugar"
    },
    {
      "id": 264044,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 264045,
      "primary_message": "Spread mayo on both halves of each bun. Layer each with a small portion of pickled vegetables (reserving the rest for the salad), top with tofu, and drizzle with sauce.",
      "secondary_message": "2 tbsp vegan mayonnaise"
    },
    {
      "id": 264046,
      "primary_message": "To serve, divide sandwiches and mixed greens between plates. Drizzle greens with oil, then top with reserved pickled vegetables and a small portion of pickling liquid. Enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
