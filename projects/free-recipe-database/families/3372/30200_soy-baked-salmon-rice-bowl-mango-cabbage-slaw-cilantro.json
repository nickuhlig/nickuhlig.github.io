  "instructions": [
    {
      "id": 582207,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 582208,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 582209,
      "primary_message": "While the water is heating, place soy sauce, oil, honey, and spices in a baking dish. Whisk to combine the marinade.",
      "secondary_message": "2 tbsp soy sauce\n4 tsp toasted sesame oil\n4 tsp honey\n1 tsp garlic powder\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 582210,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 582211,
      "primary_message": "Meanwhile, if using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end (or corner) firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin.",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "id": 582212,
      "primary_message": "Cut the salmon into 1-inch cubes. Add to the baking dish with the marinade, stir to coat, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 582213,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 lime\n1 medium head napa cabbage\n1 mango"
    },
    {
      "id": 582214,
      "primary_message": "Using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 582215,
      "primary_message": "Juice lime into the bowl with the cilantro. Add mayo, soy sauce, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n4 tsp soy sauce\n1 tsp honey\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 582216,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 582217,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 582218,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl, stir combine the slaw, and set aside.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 582219,
      "primary_message": "When the rice has about 10 minutes left, place salmon in the oven and bake, flipping once, until golden and cooked through, 8-10 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 582220,
      "primary_message": "To serve, divide rice, salmon, and slaw between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
