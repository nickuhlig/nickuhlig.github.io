  "instructions": [
    {
      "id": 582305,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 582306,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 582307,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 582308,
      "primary_message": "Meanwhile, place soy sauce, oil, maple syrup, and spices in a large baking dish. Whisk to combine the marinade.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp toasted sesame oil\n2 tbsp pure maple syrup\n1 ½ tsp garlic powder\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 582309,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 582310,
      "primary_message": "While the rice is cooking, cut the tofu into 1-inch cubes. Add to the baking dish with the marinade, stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 582311,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 ½ limes\n1 ½ medium heads napa cabbage\n1 ½ mangoes"
    },
    {
      "id": 582312,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a large bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 582313,
      "primary_message": "Juice limes into the bowl with the cilantro. Add mayo, soy sauce, maple syrup, and spices, then whisk to combine the dressing.",
      "secondary_message": "⅓ cup vegan mayonnaise\n3 tbsp soy sauce\n1 ½ tsp pure maple syrup\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 582314,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 582315,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 582316,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl, stir combine the slaw, and set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 582317,
      "primary_message": "When the rice has about 10 minutes left, place tofu in the oven and bake, turning halfway through, until golden and warmed through, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 582318,
      "primary_message": "To serve, divide rice, tofu, and slaw between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
