  "instructions": [
    {
      "id": 582487,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 582488,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 582489,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 582490,
      "primary_message": "Meanwhile, place soy sauce, oil, honey, and spices in a small baking dish. Whisk to combine the marinade.",
      "secondary_message": "1 tbsp soy sauce\n2 tsp toasted sesame oil\n2 tsp honey\n½ tsp garlic powder\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 582491,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 582492,
      "primary_message": "While the rice is cooking, cut the tofu into 1-inch cubes. Add to the baking dish with the marinade, stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 582493,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch cilantro\n½ lime\n½ medium head napa cabbage\n½ mango"
    },
    {
      "id": 582494,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 582495,
      "primary_message": "Juice lime into the bowl with the cilantro. Add mayo, soy sauce, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp soy sauce\n½ tsp honey\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 582496,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 582497,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 582498,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl, stir combine the slaw, and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 582499,
      "primary_message": "When the rice has about 10 minutes left, place tofu in the oven and bake, turning halfway through, until golden and warmed through, 12-15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 582500,
      "primary_message": "To serve, divide rice, tofu, and slaw between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
