  "instructions": [
    {
      "id": 582473,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 582474,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 582475,
      "primary_message": "While the water is heating, place soy sauce, oil, honey, and spices in a large baking dish. Whisk to combine the marinade.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp toasted sesame oil\n2 tbsp honey\n1 ½ tsp garlic powder\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 582476,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 582477,
      "primary_message": "Meanwhile, if using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end (or corner) firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin.",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 582478,
      "primary_message": "Cut the salmon into 1-inch cubes. Add to the baking dish with the marinade, stir to coat, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 582479,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 ½ limes\n1 ½ medium heads napa cabbage\n1 ½ mangoes"
    },
    {
      "id": 582480,
      "primary_message": "Using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a large bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 582481,
      "primary_message": "Juice limes into the bowl with the cilantro. Add mayo, soy sauce, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp soy sauce\n1 ½ tsp honey\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 582482,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 582483,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 582484,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl, stir combine the slaw, and set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 582485,
      "primary_message": "When the rice has about 10 minutes left, place salmon in the oven and bake, flipping once, until golden and cooked through, about 10 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 582486,
      "primary_message": "To serve, divide rice, salmon, and slaw between bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
