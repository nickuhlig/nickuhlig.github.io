  "instructions": [
    {
      "id": 415611,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415612,
      "primary_message": "Once the skillet is hot, add beef and spices; cook, breaking the meat apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "1 ½ lb lean ground beef\n3 tbsp taco seasoning\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 415613,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 hearts romaine hearts\n1 pint grape tomatoes\n1 small bunch green onions (scallions)"
    },
    {
      "id": 415614,
      "primary_message": "Add water to the skillet with the beef; continue to cook, stirring occasionally, until sauce has thickened and beef is cooked through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 415615,
      "primary_message": "Chop or tear romaine into bite-sized pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 415616,
      "primary_message": "Halve tomatoes and add to the bowl with the romaine.",
      "secondary_message": null
    },
    {
      "id": 415617,
      "primary_message": "Trim and cut green onions crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 415618,
      "primary_message": "Using your hands, crush tortilla chips into the bowl and toss to combine the salad.",
      "secondary_message": "4 oz tortilla chips"
    },
    {
      "id": 415619,
      "primary_message": "To serve, divide salad between plates or bowls; top with beef, salsa, and shredded cheese. Enjoy!",
      "secondary_message": "1 cup salsa\n1 cup shredded cheese, Mexican blend"
    }
  ],
