  "instructions": [
    {
      "id": 415638,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415639,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based\n3 tbsp taco seasoning\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 415640,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 hearts romaine hearts\n1 pint grape tomatoes\n1 small bunch green onions (scallions)"
    },
    {
      "id": 415641,
      "primary_message": "Add water to the skillet with the veggie ground; continue to cook, stirring occasionally, until sauce has thickened and veggie ground is cooked through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 415642,
      "primary_message": "Chop or tear romaine into bite-sized pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 415643,
      "primary_message": "Halve tomatoes and add to the bowl with the romaine.",
      "secondary_message": null
    },
    {
      "id": 415644,
      "primary_message": "Trim and cut green onions crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 415645,
      "primary_message": "Using your hands, crush tortilla chips into the bowl and toss to combine the salad.",
      "secondary_message": "4 oz tortilla chips"
    },
    {
      "id": 415646,
      "primary_message": "To serve, divide salad between plates or bowls; top with veggie ground, salsa, and shredded cheese. Enjoy!",
      "secondary_message": "1 cup salsa\n1 cup shredded cheese, Mexican blend"
    }
  ],
