  "instructions": [
    {
      "id": 415647,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415648,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until almost cooked through, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n¼ cup taco seasoning\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 415649,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 hearts romaine hearts\n1 ½ pints grape tomatoes\n1 small bunch green onions (scallions)"
    },
    {
      "id": 415650,
      "primary_message": "Add water to the skillet with the veggie ground; continue to cook, stirring occasionally, until sauce has thickened and veggie ground is cooked through, 3-4 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "¾ cup water"
    },
    {
      "id": 415651,
      "primary_message": "Chop or tear romaine into bite-sized pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 415652,
      "primary_message": "Halve tomatoes and add to the bowl with the romaine.",
      "secondary_message": null
    },
    {
      "id": 415653,
      "primary_message": "Trim and cut green onions crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 415654,
      "primary_message": "Using your hands, crush tortilla chips into the bowl and toss to combine the salad.",
      "secondary_message": "6 oz tortilla chips"
    },
    {
      "id": 415655,
      "primary_message": "To serve, divide salad between plates or bowls; top with veggie ground, salsa, and shredded cheese. Enjoy!",
      "secondary_message": "1 ½ cup salsa\n1 ½ cups shredded cheese, Mexican blend"
    }
  ],
