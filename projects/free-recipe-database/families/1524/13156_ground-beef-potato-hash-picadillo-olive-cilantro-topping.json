  "instructions": [
    {
      "id": 350181,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n1 green bell pepper\n½ small bunch cilantro"
    },
    {
      "id": 350182,
      "primary_message": "Medium dice potatoes. Trim, seed, and medium dice pepper. Transfer both to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 350183,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 350184,
      "primary_message": "Once the skillet is hot, add ground beef; cook, breaking apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "⅓ kg lean ground beef"
    },
    {
      "id": 350185,
      "primary_message": "Meanwhile, peel and mince onion and garlic; add to the bowl with the potatoes and peppers.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 350186,
      "primary_message": "Add veggies and spices to the skillet with the beef; stir to combine. Cook, stirring occasionally, until onions and peppers begin to soften, 3-4 minutes. ",
      "secondary_message": "½ tsp salt\n½ tsp cumin, ground\n¼ tsp chili powder\n¼ tsp coriander, ground\n1 pinch black pepper"
    },
    {
      "id": 350187,
      "primary_message": "Meanwhile, roughly chop olives and place in the bowl used for the veggies. ",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 350188,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the olives, stir to combine, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 350189,
      "primary_message": "Add tomato sauce to the skillet, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and continue to cook, stirring occasionally, until potatoes are fork-tender, 10 minutes more. Remove from heat.",
      "secondary_message": "1 (213 ml) can tomato sauce"
    },
    {
      "id": 350190,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional), 15-30 seconds.",
      "secondary_message": "4 small corn tortillas"
    },
    {
      "id": 350191,
      "primary_message": "Divide picadillo between bowls and top with olive-cilantro mixture. Serve with tortillas on the side and enjoy!",
      "secondary_message": null
    }
  ],
