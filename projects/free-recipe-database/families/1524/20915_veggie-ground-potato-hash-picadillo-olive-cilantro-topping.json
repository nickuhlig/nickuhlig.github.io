  "instructions": [
    {
      "id": 350226,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium yellow potatoes\n2 green bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 350227,
      "primary_message": "Medium dice potatoes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 350228,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the potatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 350229,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 350230,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based"
    },
    {
      "id": 350231,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 350232,
      "primary_message": "Add veggies and spices to the skillet; continue to cook, stirring occasionally, until onions and peppers begin to soften, 3-4 minutes more. (Reserve bowl for the next step.)",
      "secondary_message": "1 tsp salt\n1 tsp cumin, ground\n½ tsp chili powder\n½ tsp coriander, ground\n⅛ tsp black pepper"
    },
    {
      "id": 350233,
      "primary_message": "While the veggies are cooking, roughly chop olives and place in the reserved bowl. ",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 350234,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the olives, stir to combine, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 350235,
      "primary_message": "Add tomato sauce to the skillet, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and continue to cook, stirring occasionally, until potatoes are fork-tender, 8-10 minutes more. Remove from heat.",
      "secondary_message": "2 (213 ml) cans tomato sauce"
    },
    {
      "id": 350236,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "8 small corn tortillas"
    },
    {
      "id": 350237,
      "primary_message": "Divide picadillo between bowls and top with olive-cilantro mixture. Serve with tortillas on the side and enjoy!",
      "secondary_message": null
    }
  ],
