  "instructions": [
    {
      "id": 350134,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n3 green bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 350135,
      "primary_message": "Medium dice potatoes. Trim, seed, and medium dice peppers. Transfer both to a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 350136,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 350137,
      "primary_message": "Once the pot is hot, add ground beef; cook, breaking apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef"
    },
    {
      "id": 350138,
      "primary_message": "Meanwhile, peel and mince onions and garlic; add to the bowl with the potatoes and peppers.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 350139,
      "primary_message": "Add veggies and spices to the pot with the beef; stir to combine. Cook, stirring occasionally, until onions and peppers begin to soften, 5-6 minutes. ",
      "secondary_message": "1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp chili powder\n¾ tsp coriander, ground\n3 pinch black pepper"
    },
    {
      "id": 350140,
      "primary_message": "Meanwhile, roughly chop olives and place in the bowl used for the veggies. ",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 350141,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the olives, stir to combine, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 350142,
      "primary_message": "Add tomato sauce to the pot, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and continue to cook, stirring occasionally, until potatoes are fork-tender, 10-15 minutes. Remove from heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 350143,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional), 15-30 seconds.",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 350144,
      "primary_message": "Divide picadillo between bowls and top with olive-cilantro mixture. Serve with tortillas on the side and enjoy!",
      "secondary_message": null
    }
  ],
