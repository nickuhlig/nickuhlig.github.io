  "instructions": [
    {
      "id": 350169,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n3 green bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 350170,
      "primary_message": "Medium dice potatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 350171,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 350172,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl and set aside.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 350173,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 350174,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based"
    },
    {
      "id": 350175,
      "primary_message": "Add veggies and spices to the pot; continue to cook, stirring occasionally, until onions and peppers begin to soften, 4-5 minutes more. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ tsp salt\n1 ½ tsp cumin, ground\n¾ tsp chili powder\n¾ tsp coriander, ground\n3 pinch black pepper"
    },
    {
      "id": 350176,
      "primary_message": "While the veggies are cooking, roughly chop olives and place in the reserved bowl. ",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 350177,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the olives, stir to combine, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 350178,
      "primary_message": "Add tomato sauce to the pot, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and continue to cook, stirring occasionally, until potatoes are fork-tender, 8-10 minutes more. Remove from heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 350179,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 350180,
      "primary_message": "Divide picadillo between bowls and top with olive-cilantro mixture. Serve with tortillas on the side and enjoy!",
      "secondary_message": null
    }
  ],
