  "instructions": [
    {
      "id": 331325,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Reserve a ½-cup cooking water before draining; set aside.",
      "secondary_message": "½ tsp salt\n142 g fettuccine pasta"
    },
    {
      "id": 331326,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 yellow bell pepper\n2 medium zucchini squash\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 331327,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 331328,
      "primary_message": "Peel, halve, and small dice onion; trim, seed, and medium dice bell pepper. Place both in a medium bowl. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 331329,
      "primary_message": "Trim and halve zucchini, then cut crosswise into ¼-inch thick half-moons; add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 331330,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 331331,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 331332,
      "primary_message": "Meanwhile, place sugar and spices in the reserved bowl; stir to combine the spice mix.",
      "secondary_message": "½ tsp brown sugar\n1 tsp garam masala\n1 tsp chili powder\n¾ tsp salt\n½ tsp black pepper\n¼ tsp turmeric, ground"
    },
    {
      "id": 331333,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the spice mix, along with the shrimp, and toss to coat.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 331334,
      "primary_message": "When the veggies are soft, add seasoned shrimp to the skillet; continue to cook, stirring occasionally, until shrimp are just starting to turn opaque, 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 331335,
      "primary_message": "Add tomato sauce, peas, and cream to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook until shrimp are cooked through, 2-3 minutes more. ",
      "secondary_message": "1 (213 ml) can tomato sauce\n½ cup frozen peas\n59 ml (¼ cup) heavy whipping cream"
    },
    {
      "id": 331336,
      "primary_message": "Transfer drained pasta to the skillet and toss to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 331337,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
