  "instructions": [
    {
      "id": 331202,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 331203,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Reserve a ½-cup cooking water before draining; set aside.",
      "secondary_message": "½ tsp salt\n5 oz fettuccine pasta"
    },
    {
      "id": 331204,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 yellow bell pepper\n2 medium zucchini squash\n1 (1 inch) piece ginger root"
    },
    {
      "id": 331205,
      "primary_message": "Peel, halve, and small dice onion; trim, seed, and medium dice bell pepper. Place both in a medium bowl. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 331206,
      "primary_message": "Trim and halve zucchini, then cut crosswise into ¼-inch thick half-moons; add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 331207,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 331208,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 331209,
      "primary_message": "Meanwhile, place sugar and spices in the reserved bowl; stir to combine the spice mix.",
      "secondary_message": "½ tsp brown sugar\n1 tsp garam masala\n1 tsp chili powder\n¾ tsp salt\n½ tsp black pepper\n¼ tsp turmeric, ground"
    },
    {
      "id": 331210,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the spice mix.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 331211,
      "primary_message": "Medium dice the tofu; add to the bowl and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 331212,
      "primary_message": "When the veggies are soft, add seasoned tofu to the skillet; continue to cook, stirring occasionally, until fragrant, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 331213,
      "primary_message": "Add tomato sauce, peas, and cream to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook until tofu is warmed through, 2-3 minutes more. ",
      "secondary_message": "1 (8 oz) can tomato sauce\n½ cup frozen peas\n2 fl oz (¼ cup) heavy whipping cream"
    },
    {
      "id": 331214,
      "primary_message": "Transfer drained pasta to the skillet and toss to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 331215,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
