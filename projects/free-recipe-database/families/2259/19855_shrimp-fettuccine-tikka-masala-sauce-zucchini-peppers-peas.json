  "instructions": [
    {
      "id": 331351,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Reserve 1 ½ cups of cooking water before draining; set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g fettuccine pasta"
    },
    {
      "id": 331352,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 yellow bell peppers\n6 medium zucchini squash\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 331353,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 331354,
      "primary_message": "Peel, halve, and small dice onions; trim, seed, and medium dice bell peppers. Place both in a large bowl. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 331355,
      "primary_message": "Trim and halve zucchini, then cut crosswise into ¼-inch thick half-moons; add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 331356,
      "primary_message": "Preheat another large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 331357,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 331358,
      "primary_message": "Meanwhile, place sugar and spices in the reserved bowl; stir to combine the spice mix.",
      "secondary_message": "1 ½ tsp brown sugar\n1 tbsp garam masala\n1 tbsp chili powder\n2 tsp salt\n1 ½ tsp black pepper\n¾ tsp turmeric, ground"
    },
    {
      "id": 331359,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the spice mix, along with the shrimp, and toss to coat.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 331360,
      "primary_message": "When the veggies are soft, add seasoned shrimp to the pot; continue to cook, stirring occasionally, until shrimp are just starting to turn opaque, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 331361,
      "primary_message": "Add tomato sauce, peas, and cream to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook until shrimp are cooked through, 3-4 minutes more. ",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ cups frozen peas\n177 ml heavy whipping cream"
    },
    {
      "id": 331362,
      "primary_message": "Transfer drained pasta to the pot with the shrimp and toss to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 331363,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
