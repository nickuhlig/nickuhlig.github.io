  "instructions": [
    {
      "id": 331230,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 331231,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Reserve 1 ½ cups of cooking water before draining; set aside.",
      "secondary_message": "1 ½ tsp salt\n15 oz fettuccine pasta"
    },
    {
      "id": 331232,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 yellow bell peppers\n6 medium zucchini squash\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 331233,
      "primary_message": "Peel, halve, and small dice onions; trim, seed, and medium dice bell pepper. Place both in a large bowl. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 331234,
      "primary_message": "Trim and halve zucchini, then cut crosswise into ¼-inch thick half-moons; add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 331235,
      "primary_message": "Preheat another large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 331236,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 331237,
      "primary_message": "Meanwhile, place sugar and spices in the reserved bowl; stir to combine the spice mix.",
      "secondary_message": "1 ½ tsp brown sugar\n1 tbsp garam masala\n1 tbsp chili powder\n2 tsp salt\n1 ½ tsp black pepper\n¾ tsp turmeric, ground"
    },
    {
      "id": 331238,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the spice mix.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 331239,
      "primary_message": "Medium dice the tofu; add to the bowl and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 331240,
      "primary_message": "When the veggies are soft, add seasoned tofu to the pot; continue to cook, stirring occasionally, until fragrant, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 331241,
      "primary_message": "Add tomato sauce, peas, and cream to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook until tofu is warmed through, 3-4 minutes more. ",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 ½ cups frozen peas\n6 fl oz (¾ cup) heavy whipping cream"
    },
    {
      "id": 331242,
      "primary_message": "Transfer drained pasta to the pot with the tofu and toss to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 331243,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
