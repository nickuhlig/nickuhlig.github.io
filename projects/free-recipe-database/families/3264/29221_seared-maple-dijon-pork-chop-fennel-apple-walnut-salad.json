  "instructions": [
    {
      "id": 466271,
      "primary_message": "Preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 466272,
      "primary_message": "While the skillet heats up, roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 466273,
      "primary_message": "Once the skillet is hot, add walnuts and cook, stirring constantly, until lightly browned, 2-3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 466274,
      "primary_message": "Place maple syrup, Dijon, salt, and pepper in another small bowl. Whisk to combine the maple-Dijon sauce and set aside.",
      "secondary_message": "1 tbsp pure maple syrup\n2 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 466275,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 466276,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 466277,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 466278,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 fennel bulbs\n1 Granny Smith apple\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 466279,
      "primary_message": "Juice lemon into a medium bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 466280,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 466281,
      "primary_message": "Quarter, core, and thinly slice apple. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 466282,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl, along with cooled walnuts, and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 466283,
      "primary_message": "To serve, divide pork chops and salad between plates. Drizzle chops with maple-Dijon sauce. Enjoy!",
      "secondary_message": null
    }
  ],
