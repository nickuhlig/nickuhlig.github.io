  "instructions": [
    {
      "id": 235873,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ lb white mushrooms\n3 medium zucchini squash\n1 small pkg fresh basil"
    },
    {
      "id": 235874,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 235875,
      "primary_message": "Trim, seed, and medium dice bell peppers. Peel and medium dice onions; transfer both to a large bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 235876,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 235877,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 235878,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices to the pot; cook, stirring occasionally, until starting to soften, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 235879,
      "primary_message": "Meanwhile, thinly slice mushrooms and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 235880,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons; add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 235881,
      "primary_message": "Add mushrooms, zucchini, and chickpeas to the pot with the other veggies and continue to cook, stirring occasionally, until softened, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 235882,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 235883,
      "primary_message": "Peel and mince additional garlic and place in a small bowl. Add oil and spices; stir to combine and set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 235884,
      "primary_message": "Add tomato sauce and vinegar to the pot. Stir to combine and cook until heated through, 3-4 minutes more.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n3 tbsp white wine vinegar"
    },
    {
      "id": 235885,
      "primary_message": "Meanwhile, spread garlic oil on the bread and divide between two baking sheet pans. Working in batches, place each baking sheet in the oven and broil until toasted, 1-2 minutes. Remove from the oven and cut toasts in half.",
      "secondary_message": "9 slices whole grain bread"
    },
    {
      "id": 235886,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 235887,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 235888,
      "primary_message": "Divide veggie-chickpea sauté between plates or bowls; sprinkle with basil and Parmesan. Serve with garlic toast on the side and enjoy!",
      "secondary_message": null
    }
  ],
