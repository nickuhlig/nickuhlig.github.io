  "instructions": [
    {
      "id": 453106,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 453107,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ small butternut squash\n1 ½ lemons\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 453108,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Transfer to a large baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 453109,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 453110,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 453111,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt"
    },
    {
      "id": 453112,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 453113,
      "primary_message": "When the squash is done, remove from the oven, then drizzle with honey and hot sauce. Stir to coat and set aside to cool slightly, about 5 minutes.",
      "secondary_message": "¼ cup honey\n2 tbsp hot sauce"
    },
    {
      "id": 453114,
      "primary_message": "Meanwhile, zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 453115,
      "primary_message": "Peel and mince shallots. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 453116,
      "primary_message": "Add arugula and cooled squash to the bowl with the dressing, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 453117,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 453118,
      "primary_message": "To serve, divide steak and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
