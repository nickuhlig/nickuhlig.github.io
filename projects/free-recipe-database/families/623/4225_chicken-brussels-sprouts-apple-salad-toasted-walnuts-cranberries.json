  "instructions": [
    {
      "id": 47802,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg brussels sprouts\n2 Gala apples"
    },
    {
      "id": 47803,
      "primary_message": "Roughly chop the walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 47804,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 47805,
      "primary_message": "While the skillet heats up, pat the chicken breasts dry with paper towels and place on a plate; rub with olive oil and season generously with salt and pepper on both sides.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n1 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 47806,
      "primary_message": "Add the walnuts to the skillet and toast, stirring frequently, until fragrant and lightly browned, 2 to 3 minutes. Transfer to a bowl. Wipe out the pan.",
      "secondary_message": ""
    },
    {
      "id": 47807,
      "primary_message": "Once the walnuts have been transferred, reduce the heat to medium and place the chicken breasts in the skillet; cook until the chicken is golden brown and cooked through (check doneness with a thermometer or cut into the chicken with a knife), 6 to 8 minutes per side. Once done, transfer the chicken to plate.",
      "secondary_message": null
    },
    {
      "id": 47808,
      "primary_message": "While the chicken cooks, trim off and discard the stems ends of the Brussels sprouts, then remove the outer layer of leaves; halve the sprouts lengthwise, then thinly slice crosswise. Transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47809,
      "primary_message": "Trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds and add to the salad bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 47810,
      "primary_message": "Once the chicken has been transferred, add the Brussels sprouts and shallots to the skillet; cook, stirring frequently, until softened, 3 to 4 minutes. Once done, transfer back to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47811,
      "primary_message": "While the sprouts cook, quarter the apples lengthwise, then cut out the core and stem from each section; large dice the apples into 2-cm cubes and transfer to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47812,
      "primary_message": "Add the toasted walnuts and dried cranberries to the salad bowl.",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 47813,
      "primary_message": "In a small bowl, combine and whisk together olive oil, vinegar, honey, Dijon, salt, and pepper.",
      "secondary_message": "6 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tsp honey\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 47814,
      "primary_message": "When cool enough to handle, large dice the chicken breasts into 2-cm cubes. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 47815,
      "primary_message": "Pour the dressing over the salad and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 47816,
      "primary_message": "To serve, divide the salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
