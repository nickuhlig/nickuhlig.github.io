  "instructions": [
    {
      "id": 17377,
      "primary_message": "Wash, cut off stem ends, and medium dice strawberries. Wash and dry basil; pick leaves off the stems and mince.",
      "secondary_message": "1 (16 oz) pkg strawberries\r\n1 small pkg fresh basil"
    },
    {
      "id": 17378,
      "primary_message": "In a medium bowl, mix together strawberries, basil, olive oil, vinegar, honey, salt, and pepper. Set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n4 tbsp balsamic vinegar\r\n2 tsp honey\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 17379,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 17380,
      "primary_message": "Roughly chop almonds.",
      "secondary_message": "¼ cup almonds"
    },
    {
      "id": 17381,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "1 ½ lb ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 17382,
      "primary_message": "Coat grill or bottom of skillet with oil. Place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 17383,
      "primary_message": "Wash and dry spinach.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 17384,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": ""
    },
    {
      "id": 17385,
      "primary_message": "To serve, arrange a bed of spinach on a plate and top with steak slices and strawberries. Sprinkle almonds and crumble goat cheese over top. Enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese"
    }
  ],
