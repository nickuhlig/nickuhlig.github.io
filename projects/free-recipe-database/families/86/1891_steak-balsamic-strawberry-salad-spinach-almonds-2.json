  "instructions": [
    {
      "primary_message": "Wash, cut off stem ends, and medium dice strawberries. Wash and dry basil; pick leaves off the stems and mince.",
      "secondary_message": "½ (454 g) pkg strawberries\n½ small pkg fresh basil"
