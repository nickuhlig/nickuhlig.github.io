  "instructions": [
    {
      "id": 1,
      "primary_message": "Prepare a baking sheet with parchment paper or Silpat and set aside. In a small saucepan add brown sugar. Use your hands to break up any clumps. Drizzle 1/4 cups of water over sugar and swirl around pan to moisten the sugar. Stir to dissolve completely.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat sugar over medium high, swirling the pan occasionally to ensure even heating. Sugar will begin to bubble vigorously. Continue heating and swirling until mixture reaches 230°F as measured on a candy or instant read thermometer. Remove from heat and quickly add peanuts, stir to coat then immediately then drop by heaping tablespoonfuls onto prepared pan, spacing pralines 2 inches apart. Let cool for 30 minutes then serve. Store in an airtight container for up to 3 days.",
      "secondary_message": null
    }
  ],
