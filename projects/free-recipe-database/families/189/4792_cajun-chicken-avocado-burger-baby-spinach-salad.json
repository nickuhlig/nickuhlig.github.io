  "instructions": [
    {
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, prepare cajun rub by mixing together cumin, coriander, paprika, oregano, salt, and pepper.",
      "secondary_message": "¾ tsp paprika\nsalt\nblack pepper"
    },
    {
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Rub with spice mixture on all sides.",
      "secondary_message": null
    },
    {
      "primary_message": "Coat grill or bottom of skillet with oil. Add chicken fillets and cook until golden brown and cooked through, 2-3 minutes per side.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "primary_message": "In a medium bowl, prepare dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "4 ½ tbsp extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n⅜ tsp Dijon mustard\nsalt\nblack pepper"
    },
    {
      "primary_message": "Wash and dry spinach. Save a small handful of leaves for the burgers; add the rest to bowl with dressing and toss to coat.",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "primary_message": "Wash and slice tomatoes into rounds. Halve and pit avocados; thinly slice while still in skin and scoop out.",
      "secondary_message": "3 tomatoes\n3 avocados"
    },
    {
      "primary_message": "Toast buns on grill/skillet.",
      "secondary_message": "6 gluten-free buns or rolls"
    },
    {
      "primary_message": "To serve, spread some Dijon on buns. Top with remaining spinach leaves, chicken, and slices of tomato and avocado. Serve with spinach salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
