  "instructions": [
    {
      "id": 339795,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 339796,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n2 red bell peppers\n2 (1 inch) pieces ginger root\n1 head butter (Boston) lettuce"
    },
    {
      "id": 339797,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 339798,
      "primary_message": "Trim, seed, and large dice bell peppers; add to the baking sheet with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 339799,
      "primary_message": "Add edamame to the baking sheet. Drizzle veggies with oil and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "2 cups edamame\n2 tbsp toasted sesame oil\n½ tsp salt"
    },
    {
      "id": 339800,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 339801,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; place both in a small saucepan.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 339802,
      "primary_message": "Add water, soy sauce, sugar, vinegar, chili-garlic sauce, cornstarch, and additional oil to the saucepan with the ginger and garlic; whisk to combine the sauce. ",
      "secondary_message": "½ cup water\n¼ cup soy sauce\n2 tbsp brown sugar\n2 tbsp rice vinegar\n1 tbsp chili-garlic sauce\n1 tbsp cornstarch\n2 tsp toasted sesame oil"
    },
    {
      "id": 339803,
      "primary_message": "Bring sauce to a boil over high heat. Reduce heat to medium and simmer, whisking frequently, until sauce is thickened and glossy, about 2 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 339804,
      "primary_message": "Meanwhile, place mayo and chili-garlic sauce in a small bowl; whisk to combine the spicy mayo and set aside. ",
      "secondary_message": "⅓ cup vegan mayonnaise\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 339805,
      "primary_message": "Roughly chop cashews.",
      "secondary_message": "⅔ cup cashews, roasted unsalted"
    },
    {
      "id": 339806,
      "primary_message": "When the veggies are done, drizzle with the sauce, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 339807,
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill each wrap with veggies. Top with cashews and spicy mayo. Enjoy!",
      "secondary_message": null
    }
  ],
