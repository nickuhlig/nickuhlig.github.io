  "instructions": [
    {
      "id": 339938,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 339939,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 red bell pepper\n1 (2 ½ cm) piece ginger root\n½ head butter (Boston) lettuce"
    },
    {
      "id": 339940,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 339941,
      "primary_message": "Trim, seed, and large dice bell pepper; add to the baking sheet with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 339942,
      "primary_message": "Add edamame to the baking sheet. Drizzle veggies with oil and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "1 cup edamame, shelled\n1 tbsp toasted sesame oil\n¼ tsp salt"
    },
    {
      "id": 339943,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 339944,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; place both in a small saucepan.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 339945,
      "primary_message": "Add water, soy sauce, sugar, vinegar, chili-garlic sauce, cornstarch, and additional oil to the saucepan with the ginger and garlic; whisk to combine the sauce. ",
      "secondary_message": "¼ cup water\n2 tbsp soy sauce\n1 tbsp brown sugar\n1 tbsp rice vinegar\n1 ½ tsp chili-garlic sauce\n1 ½ tsp cornstarch\n1 tsp toasted sesame oil"
    },
    {
      "id": 339946,
      "primary_message": "Bring sauce to a boil over high heat. Reduce heat to medium and simmer, whisking frequently, until sauce is thickened and glossy, 1-2 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 339947,
      "primary_message": "Meanwhile, place mayo and chili-garlic sauce in a small bowl; whisk to combine the spicy mayo and set aside. ",
      "secondary_message": "3 tbsp vegan mayonnaise\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 339948,
      "primary_message": "Roughly chop cashews.",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 339949,
      "primary_message": "When the veggies are done, drizzle with the sauce, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 339950,
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill each wrap with veggies. Top with cashews and spicy mayo. Enjoy!",
      "secondary_message": null
    }
  ],
