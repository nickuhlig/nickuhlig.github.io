  "instructions": [
    {
      "id": 73094,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 heads butter (Boston) lettuce\n3 red bell peppers\n1 ½ limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 73093,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Small dice the peppers and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 73092,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl and set aside.",
      "secondary_message": ""
    },
    {
      "id": 73091,
      "primary_message": "Juice the limes into a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 73090,
      "primary_message": "Peel and mince the garlic; add to the lime juice.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 73089,
      "primary_message": "Measure out the cashews and roughly chop; transfer to a small bowl.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 73088,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 73087,
      "primary_message": "Cut the chicken into small bite-sized pieces, then season with salt and pepper.",
      "secondary_message": "1.361 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 73086,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 73085,
      "primary_message": "Add the chicken to the skillet; cook, stirring occasionally, until golden brown and cooked through, 3 to 4 minutes. Once done, transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 73084,
      "primary_message": "Separate the lettuce head into leaves and place on a plate.",
      "secondary_message": ""
    },
    {
      "id": 73083,
      "primary_message": "Once the chicken has been transferred, add more coconut oil to the skillet followed by the bell peppers. Cook, stirring occasionally, until tender-crisp, 3 to 4 minutes. Once done, add to the bowl of chicken and mix together.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 73082,
      "primary_message": "To make the sauce, add almond butter, coconut aminos, honey, sesame oil, and crushed red pepper to the lime juice and minced garlic and whisk together. If the sauce is too thick, add a little bit of water.",
      "secondary_message": "6 tbsp natural almond butter\n3 tbsp coconut aminos\n1 ½ tsp honey\n¾ tsp toasted sesame oil\n⅜ tsp crushed red pepper"
    },
    {
      "id": 73081,
      "primary_message": "To serve, scoop the chicken and pepper mixture into lettuce leaves, then top with the almond sauce, cilantro, and cashews. Enjoy!",
      "secondary_message": ""
    }
  ],
