  "instructions": [
    {
      "id": 32316,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 head butter (Boston) lettuce\n1 red bell pepper\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 32317,
      "primary_message": "Cut the bell pepper lengthwise into quarters; remove and discard the seeds and white membrane. Small dice the pepper and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 32318,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 32319,
      "primary_message": "Juice the lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 32320,
      "primary_message": "Peel and mince the garlic; add to the lime juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 32321,
      "primary_message": "Measure out the peanuts and roughly chop; transfer to a small bowl.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 32322,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 32323,
      "primary_message": "Cut the chicken into small bite-sized pieces, then season with salt and pepper.",
      "secondary_message": "1 lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 32324,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 32325,
      "primary_message": "Add the chicken to the skillet; cook, stirring occasionally, until golden brown and cooked through, 3 to 4 minutes. Once done, transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 32326,
      "primary_message": "Separate the lettuce head into leaves and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 32327,
      "primary_message": "Once the chicken has been transferred, add more coconut oil to the skillet followed by the bell pepper. Cook, stirring occasionally, until tender-crisp, 3 to 4 minutes. Once done, add to the bowl of chicken and mix together.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 32328,
      "primary_message": "To make the sauce, add peanut butter, coconut aminos, honey, sesame oil, and crushed red pepper to the lime juice and minced garlic and whisk together. If the sauce is too thick, add a little bit of water.",
      "secondary_message": "2 tbsp natural peanut butter\n1 tbsp coconut aminos\n½ tsp honey\n¼ tsp toasted sesame oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 32329,
      "primary_message": "To serve, scoop the chicken and pepper mixture into lettuce leaves, then top with the peanut sauce, cilantro, and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
