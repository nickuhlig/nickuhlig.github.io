  "instructions": [
    {
      "id": 353193,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pineapple\n1 green bell pepper\n1 lime\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 353194,
      "primary_message": "Cut off skin from pineapple; quarter, core, and small dice the flesh. Divide pineapple between two medium bowls.",
      "secondary_message": null
    },
    {
      "id": 353195,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to one of the bowls with the pineapple (set the other bowl of pineapple aside for the salad).",
      "secondary_message": null
    },
    {
      "id": 353196,
      "primary_message": "Peel, halve, and thinly slice onion; add to the bowl with the pineapple and bell pepper.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 353197,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 353198,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 353199,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pineapple, veggies, chicken, and spices; cook, stirring occasionally, until veggies have softened and chicken is cooked through, 7-8 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 353200,
      "primary_message": "Meanwhile, juice lime into the bowl with the remaining pineapple.",
      "secondary_message": null
    },
    {
      "id": 353201,
      "primary_message": "Using a clean cutting board, peel and mince garlic. Add to the bowl along with yogurt, maple syrup, chili powder, and salt. Stir to combine the dressing and set aside.",
      "secondary_message": "2 cloves garlic\n¼ cup plain Greek yogurt\n2 tsp pure maple syrup\n2 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 353202,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 353203,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide chicken and veggie filling between them, arranging on one half of each tortilla. Top with cheese and fold in half to close.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 353204,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 353205,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 353206,
      "primary_message": "Meanwhile, add spinach to the bowl with the pineapple and dressing. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 353207,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
