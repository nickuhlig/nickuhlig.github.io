  "instructions": [
    {
      "id": 353208,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ small pineapples\n1 ½ green bell peppers\n1 ½ limes\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 353209,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and small dice the flesh. Divide pineapple between two large bowls.",
      "secondary_message": null
    },
    {
      "id": 353210,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to one of the bowls with the pineapple (set the other bowl of pineapple aside for the salad).",
      "secondary_message": null
    },
    {
      "id": 353211,
      "primary_message": "Peel, halve, and thinly slice onions; add to the bowl with the pineapple and bell pepper.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 353212,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 353213,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 353214,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pineapple, veggies, chicken, and spices; cook, stirring occasionally, until veggies have softened and chicken is cooked through, 8-10 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 353215,
      "primary_message": "Meanwhile, juice limes into the bowl with the remaining pineapple.",
      "secondary_message": null
    },
    {
      "id": 353216,
      "primary_message": "Using a clean cutting board, peel and mince garlic. Add to the bowl along with yogurt, maple syrup, chili powder, and salt. Stir to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup plain Greek yogurt\n1 tbsp pure maple syrup\n1 tbsp chili powder\n¾ tsp salt"
    },
    {
      "id": 353217,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 353218,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide chicken and veggie filling between them, arranging on one half of each tortilla. Top with cheese and fold in half to close.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 353219,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 353220,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 353221,
      "primary_message": "Meanwhile, add spinach to the bowl with the pineapple and dressing. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 353222,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
