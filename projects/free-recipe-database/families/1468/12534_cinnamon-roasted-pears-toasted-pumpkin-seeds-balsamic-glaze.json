  "instructions": [
    {
      "id": 211305,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 211306,
      "primary_message": "Wash, dry, and juice lemons into a medium saucepan; add oil and cinnamon. Set over medium heat to melt. Whisk to combine and remove from heat.",
      "secondary_message": "1 ½ lemons\n3 tbsp virgin coconut oil\n¾ tsp cinnamon"
    },
    {
      "id": 211307,
      "primary_message": "Meanwhile, wash, dry, quarter, and core pears. Place in a large baking dish and drizzle with lemon oil. (Reserve saucepan for later use.)",
      "secondary_message": "6 pears"
    },
    {
      "id": 211308,
      "primary_message": "Place pears in the oven (it doesn't have to be fully heated) and roast until just fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 211309,
      "primary_message": "While the pears are baking, place sugar and vinegar in the saucepan, return to medium heat, and whisk to combine.",
      "secondary_message": "1 cup brown sugar\n⅓ cup balsamic vinegar"
    },
    {
      "id": 211310,
      "primary_message": "Increase heat to high and bring the mixture to a boil; Cook, whisking constantly, until smooth and slightly thickened, about 2 minutes. Remove glaze from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 211311,
      "primary_message": "In a small bowl, toss pumpkin seeds with vanilla to moisten. ",
      "secondary_message": "⅓ cup pumpkin seeds\n¾ tsp vanilla extract"
    },
    {
      "id": 211312,
      "primary_message": "Add sugar, cinnamon, and salt to the bowl with the seeds and toss to coat.",
      "secondary_message": "1 tbsp brown sugar\n½ tsp cinnamon\n3 pinch salt"
    },
    {
      "id": 211313,
      "primary_message": "Remove pears from the oven and sprinkle with pumpkin seeds. Return to the oven and continue to bake until the pears are soft and seeds are golden, about 5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 211314,
      "primary_message": "To serve, divide pears and seeds between bowls; drizzle with glaze and enjoy!",
      "secondary_message": null
    }
  ],
