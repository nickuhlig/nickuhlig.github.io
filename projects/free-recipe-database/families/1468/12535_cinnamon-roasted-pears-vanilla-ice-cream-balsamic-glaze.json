  "instructions": [
    {
      "id": 211315,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 211316,
      "primary_message": "Wash, dry, and juice lemon into a small saucepan; add butter and cinnamon. Set over medium heat to melt. Whisk to combine and remove from heat.",
      "secondary_message": "½ lemon\n1 tbsp butter, unsalted\n¼ tsp cinnamon"
    },
    {
      "id": 211317,
      "primary_message": "Meanwhile, wash, dry, quarter, and core pears. Place in a baking dish and drizzle with lemon butter. (Reserve saucepan for later use.)",
      "secondary_message": "2 pears"
    },
    {
      "id": 211318,
      "primary_message": "Place pears in the oven (it doesn't have to be fully heated) and roast until fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 211319,
      "primary_message": "While the pears are baking, place sugar and vinegar in the saucepan, return to medium heat, and whisk to combine.",
      "secondary_message": "⅓ cup brown sugar\n2 tbsp balsamic vinegar"
    },
    {
      "id": 211320,
      "primary_message": "Increase heat to high and bring the mixture to a boil; Cook, whisking constantly, until smooth and slightly thickened, about 1 minute. Remove glaze from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 211321,
      "primary_message": "To serve, divide pears and ice cream between bowls and drizzle with glaze. Enjoy!",
      "secondary_message": "177 ml vanilla ice cream"
    }
  ],
