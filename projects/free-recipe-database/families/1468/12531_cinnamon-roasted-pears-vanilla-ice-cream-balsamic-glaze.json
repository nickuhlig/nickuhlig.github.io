  "instructions": [
    {
      "id": 211278,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 211279,
      "primary_message": "Wash, dry, and juice lemons into a medium saucepan; add butter and cinnamon. Set over medium heat to melt. Whisk to combine and remove from heat.",
      "secondary_message": "1 ½ lemons\n3 tbsp butter, unsalted\n¾ tsp cinnamon"
    },
    {
      "id": 211280,
      "primary_message": "Meanwhile, wash, dry, quarter, and core pears. Place in a large baking dish and drizzle with lemon butter. (Reserve saucepan for later use.)",
      "secondary_message": "6 pears"
    },
    {
      "id": 211281,
      "primary_message": "Place pears in the oven (it doesn't have to be fully heated) and roast until fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 211282,
      "primary_message": "While the pears are baking, place sugar and vinegar in the saucepan, return to medium heat, and whisk to combine.",
      "secondary_message": "1 cup brown sugar\n⅓ cup balsamic vinegar"
    },
    {
      "id": 211283,
      "primary_message": "Increase heat to high and bring the mixture to a boil; Cook, whisking constantly, until smooth and slightly thickened, about 2 minutes. Remove glaze from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 211284,
      "primary_message": "To serve, divide pears and ice cream between bowls and drizzle with glaze. Enjoy!",
      "secondary_message": "18 fl oz (2 ¼ cups) vanilla ice cream"
    }
  ],
