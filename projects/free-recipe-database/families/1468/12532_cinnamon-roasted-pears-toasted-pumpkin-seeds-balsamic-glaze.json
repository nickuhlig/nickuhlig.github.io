  "instructions": [
    {
      "id": 211285,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 211286,
      "primary_message": "Wash, dry, and juice lemon into a small saucepan; add oil and cinnamon. Set over medium heat to melt. Whisk to combine and remove from heat.",
      "secondary_message": "½ lemon\n1 tbsp virgin coconut oil\n¼ tsp cinnamon"
    },
    {
      "id": 211287,
      "primary_message": "Meanwhile, wash, dry, quarter, and core pears. Place in a baking dish and drizzle with lemon oil. (Reserve saucepan for later use.)",
      "secondary_message": "2 pears"
    },
    {
      "id": 211288,
      "primary_message": "Place pears in the oven (it doesn't have to be fully heated) and roast until just fork-tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 211289,
      "primary_message": "While the pears are baking, place sugar and vinegar in the saucepan, return to medium heat, and whisk to combine.",
      "secondary_message": "⅓ cup brown sugar\n2 tbsp balsamic vinegar"
    },
    {
      "id": 211290,
      "primary_message": "Increase heat to high and bring the mixture to a boil; Cook, whisking constantly, until smooth and slightly thickened, about 1 minute. Remove glaze from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 211291,
      "primary_message": "In a small bowl, toss pumpkin seeds with vanilla to moisten. ",
      "secondary_message": "⅛ cup pumpkin seeds\n¼ tsp vanilla extract"
    },
    {
      "id": 211292,
      "primary_message": "Add sugar, cinnamon, and salt to the bowl with the seeds and toss to coat.",
      "secondary_message": "1 tsp brown sugar\n⅛ tsp cinnamon\n1 pinch salt"
    },
    {
      "id": 211293,
      "primary_message": "Remove pears from the oven and sprinkle with pumpkin seeds. Return to the oven and continue to bake until the pears are soft and seeds are golden, about 5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 211294,
      "primary_message": "To serve, divide pears and seeds between bowls; drizzle with glaze and enjoy!",
      "secondary_message": null
    }
  ],
