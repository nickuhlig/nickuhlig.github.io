  "instructions": [
    {
      "id": 119406,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat. ",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 119407,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 limes\n3 avocados\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 119408,
      "primary_message": "Lightly oil grates or pan. Remove husks and silks from corn. Grill corn, turning occasionally, until the corn begins to char (8-10 min). Cook in batches if necessary. Set aside to cool. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n6 ears corn"
    },
    {
      "id": 119409,
      "primary_message": "While the corn cooks, peel and finely chop the shallot. Transfer to a large bowl.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 119410,
      "primary_message": "Juice the lime into the large bowl; add olive oil, cumin, salt, and pepper and stir to combine. ",
      "secondary_message": "⅓ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper\n1 ½ tsp cumin"
    },
    {
      "id": 119411,
      "primary_message": "Pat scallops dry with paper towel.   (If using an outdoor grill, thread scallops, side by side onto skewers so that scallops lie flat.) Drizzle scallops with olive oil, salt, and pepper. Grill scallops until grill marks appear, about 2-3 minutes; flip and cook other side, about 2 minutes. Cook in batches if necessary. ",
      "secondary_message": "2 ¼ lb sea scallops\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 119412,
      "primary_message": "Working one ear at a time, hold the corn vertically inside a large bowl and slice the kernels away from the cob; discard the cob. Add the kernels to the salad dressing. ",
      "secondary_message": null
    },
    {
      "id": 119413,
      "primary_message": "Halve the avocado and remove pit. Thinly slice the flesh while still in the skin and then scoop out the slices using a spoon. ",
      "secondary_message": null
    },
    {
      "id": 119414,
      "primary_message": "To serve, toss lettuce with corn mixture and avocado, arrange on a plate and top with grilled scallops. Enjoy!",
      "secondary_message": null
    }
  ],
