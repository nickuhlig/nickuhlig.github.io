  "instructions": [
    {
      "id": 483463,
      "primary_message": "Not all protein powders are created equal. If desired, adjust shake consistency by adding more or less liquid per package instructions. This recipe will make about 4 cups of shake. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 483464,
      "primary_message": "Wash, dry, and trim strawberries. Place in a blender.",
      "secondary_message": "½ (16 oz) pkg strawberries"
    },
    {
      "id": 483465,
      "primary_message": "Peel banana, break into chunks, and add to the blender.",
      "secondary_message": "1 banana"
    },
    {
      "id": 483466,
      "primary_message": "Add milk, yogurt, protein powder, maple syrup, and vanilla to the blender. Blend on high speed for several minutes until smooth.",
      "secondary_message": "8 fl oz (1 cup) whole milk\n½ cup plain Greek yogurt\n2 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n2 tsp pure maple syrup\n¼ tsp vanilla extract"
    },
    {
      "id": 483467,
      "primary_message": "To serve, divide shake between glasses, adding ice if desired. Enjoy!",
      "secondary_message": null
    }
