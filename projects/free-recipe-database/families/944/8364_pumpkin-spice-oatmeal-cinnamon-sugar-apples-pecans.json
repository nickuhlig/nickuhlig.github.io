  "instructions": [
    {
      "id": 127169,
      "primary_message": "Add salt and water to the pot, cover, and bring to a boil over high heat. Once boiling, stir in oats, cinnamon, and maple syrup; reduce heat to medium-low. Cover and let simmer for 3-5 minutes or until oats reach desired consistency.",
      "secondary_message": "3 pinch salt\n5 ¼ cup water\n3 cup oats, quick cooking\n1 ½ tsp cinnamon\n2 tbsp pure maple syrup"
    },
    {
      "id": 127170,
      "primary_message": "Combine additional cinnamon and sugar in a medium bowl.",
      "secondary_message": "¾ tsp cinnamon\n3 tbsp brown sugar"
    },
    {
      "id": 127171,
      "primary_message": "Wash, dry, and small dice the apples.",
      "secondary_message": "3 Gala apples"
    },
    {
      "id": 127172,
      "primary_message": "Add apples to the bowl with the cinnamon-sugar and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 127173,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "1 ½ cups pecans, dry roasted"
    },
    {
      "id": 127174,
      "primary_message": "When oats are done cooking, stir in pumpkin purée.",
      "secondary_message": "1 ½ (398 ml) cans pure pumpkin purée"
    },
    {
      "id": 127175,
      "primary_message": "To serve, divide oats between bowls and top with cinnamon-sugar apples, pecans, and milk. Enjoy!",
      "secondary_message": "710 ml almond milk, unsweetened"
    }
  ],
