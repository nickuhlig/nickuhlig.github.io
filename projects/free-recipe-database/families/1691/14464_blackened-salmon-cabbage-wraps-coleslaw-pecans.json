  "instructions": [
    {
      "id": 239798,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 red bell pepper\n1 small bunch green onions (scallions)\n1 medium head napa cabbage"
    },
    {
      "id": 239799,
      "primary_message": "Place mayo, maple syrup, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "½ cup mayonnaise\n4 tsp pure maple syrup\n4 tsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 239800,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 239801,
      "primary_message": "Trim and thinly slice celery crosswise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 239802,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 239803,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 239804,
      "primary_message": "Trim off and discard the root end of the cabbage. Carefully remove 24 whole leaves from the cabbage head and set aside. Halve the remaining cabbage lengthwise, then thinly slice crosswise into strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 239805,
      "primary_message": "Stack the reserved cabbage leaves on top of one another, then slice the leaves in half crosswise. Set the leafy upper portion of the leaves aside for the wraps; thinly slice the lower stem portion and add to the bowl with the rest of the cabbage; toss to combine the slaw and set aside.",
      "secondary_message": null
    },
    {
      "id": 239806,
      "primary_message": "Place spices in a small bowl and stir to combine.",
      "secondary_message": "½ tsp onion powder\n½ tsp garlic powder\n½ tsp paprika\n½ tsp salt\n¼ tsp thyme, dried\n¼ tsp oregano, dried\n⅛ tsp cayenne pepper"
    },
    {
      "id": 239807,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 239808,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate; season with spices on the top-side. ",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "id": 239809,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side (depending on thickness). Remove to a clean plate.",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "id": 239810,
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "½ cup pecans, dry roasted"
    },
    {
      "id": 239811,
      "primary_message": "Use a fork to break the salmon into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 239812,
      "primary_message": "To serve, pile reserved cabbage leaves, in stacks of two per wrap, onto plates. Divide slaw, pecans, and salmon between wraps. Enjoy!",
      "secondary_message": null
    }
  ],
