  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Quarter and thinly slice the yellow onion. Thinly slice the garlic. Crush the whole peeled tomatoes by hand. Pick the parsley leaves from the stems and mince them.",
      "secondary_message": "1 small yellow onion\n4 medium cloves garlic\n1 (800 g) can whole peeled tomatoes, preferably San Marzano\n1 small handful fresh parsley leaves"
    },
    {
      "id": 1,
      "primary_message": "In a large saucepan, heat olive oil over medium-high heat until shimmering. Add onion and garlic and cook, stirring, until softened but not browned, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add wine and squid, bring to a simmer, and cook, stirring occasionally, until alcohol smell has mostly cooked off, about 3 minutes. Stir in tomatoes, thyme sprigs, and olives and return to a simmer. Lower heat to maintain a gentle simmer and cook, stirring occasionally, until squid is tender, about 30 minutes. Discard thyme.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in harissa and lemon zest, season with salt and pepper, sprinkle parsley on top, and serve.",
      "secondary_message": null
    }
  ],
