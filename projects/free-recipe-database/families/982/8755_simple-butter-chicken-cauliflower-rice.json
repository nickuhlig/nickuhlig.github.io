  "instructions": [
    {
      "id": 192641,
      "primary_message": "Wash the cauliflower and remove the leaves. Using a food processor or box grater, grate to rice-like texture.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 192642,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 192643,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add cauliflower and cook, stirring occasionally, 7-9 minutes.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 192644,
      "primary_message": "Meanwhile, mix spices in a small bowl.",
      "secondary_message": "1 tbsp cumin\n1 tbsp coriander\n1 tbsp salt\n2 tsp cinnamon\n1 tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 192645,
      "primary_message": "Pat the chicken dry with paper towel, cut into bite-sized (1-inch) pieces, and set aside.",
      "secondary_message": "2 ¼ lb chicken thighs, boneless skinless"
    },
    {
      "id": 192646,
      "primary_message": "Using a clean cutting board, peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 192647,
      "primary_message": "When cooked, remove the cauliflower from the heat, add salt and pepper, and stir to combine, cover with a lid and set aside.",
      "secondary_message": "1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 192648,
      "primary_message": "Heat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 192649,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the onions and cook, stirring often, until softened, 5-6 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 192650,
      "primary_message": "Wash, peel, and mince or grate ginger. Peel and mince garlic.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 cloves garlic"
    },
    {
      "id": 192651,
      "primary_message": "Add ginger, garlic, and spices to the onions and cook, stirring constantly, until fragrant, 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 192652,
      "primary_message": "Using a strainer or colander, drain the diced tomatoes, pressing with the back of a spoon to extract as much liquid as possible; discard liquid.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 192653,
      "primary_message": "Add additional butter, chicken, diced tomatoes, and cream to the skillet. Bring to a boil, then reduce heat to medium; cover and cook until chicken is cooked through, 8-10 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n6 fl oz (¾ cup) heavy cream"
    },
    {
      "id": 192654,
      "primary_message": "Meanwhile, wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "¾ small bunch cilantro"
    },
    {
      "id": 192655,
      "primary_message": "Using a strainer or colander, rinse the frozen peas under running water, then drain. Add peas to the butter chicken, stir, and remove from heat.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 192656,
      "primary_message": "To serve, divide cauliflower rice and butter chicken between bowls; garnish with cilantro and enjoy!",
      "secondary_message": null
    }
  ],
