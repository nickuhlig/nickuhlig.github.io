  "instructions": [
    {
      "id": 192685,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "2 cups basmati rice\n1 ½ tsp salt\n4 cup water"
    },
    {
      "id": 192686,
      "primary_message": "Pat the chicken dry with paper towel, cut into bite-sized (1-inch) pieces, and set aside.",
      "secondary_message": "1.02 kg chicken thighs, boneless skinless"
    },
    {
      "id": 192687,
      "primary_message": "Once the water for the rice is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 15-18 minutes. Remove from the heat and let the rice stand, covered, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 192688,
      "primary_message": "Meanwhile, mix spices in a small bowl.",
      "secondary_message": "1 tbsp cumin\n1 tbsp coriander\n1 tbsp salt\n2 tsp cinnamon\n1 tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 192689,
      "primary_message": "Using a clean cutting board, peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 192690,
      "primary_message": "Wash, peel, and mince or grate ginger. Peel and mince garlic.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 cloves garlic"
    },
    {
      "id": 192691,
      "primary_message": "Heat a large pot over medium-high heat. Once the pot is hot, butter and swirl to coat the bottom. Add the onions and cook, stirring constantly, until softened, 5-6 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 192692,
      "primary_message": "Add ginger, garlic, and spices to the onions and cook, stirring constantly, until fragrant, 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 192693,
      "primary_message": "Using a strainer or colander, drain the diced tomatoes, pressing with the back of a spoon to extract as much liquid as possible; discard liquid.",
      "secondary_message": "3 (398 ml) cans diced tomatoes"
    },
    {
      "id": 192694,
      "primary_message": "Add additional butter, chicken, diced tomatoes, and cream to the pot. Bring to a boil, then reduce heat to medium; cover and cook until chicken is cooked through, 8-10 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n177 ml heavy cream"
    },
    {
      "id": 192695,
      "primary_message": "Meanwhile, wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "¾ small bunch cilantro"
    },
    {
      "id": 192696,
      "primary_message": "Using a strainer or colander, rinse the frozen peas under running water, then drain. Add peas to the butter chicken, stir, and remove from heat.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 192697,
      "primary_message": "To serve, divide rice and butter chicken between bowls; garnish with cilantro and enjoy!",
      "secondary_message": null
    }
  ],
