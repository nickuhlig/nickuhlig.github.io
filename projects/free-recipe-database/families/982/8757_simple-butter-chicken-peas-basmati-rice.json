  "instructions": [
    {
      "id": 192671,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ⅓ cups basmati rice\n1 tsp salt\n2 ⅔ cup water"
    },
    {
      "id": 192672,
      "primary_message": "Pat the chicken dry with paper towel, cut into bite-sized (1-inch) pieces, and set aside.",
      "secondary_message": "0.68 kg chicken thighs, boneless skinless"
    },
    {
      "id": 192673,
      "primary_message": "Once the water for the rice is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 15-18 minutes. Remove from the heat and let the rice stand, covered, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 192674,
      "primary_message": "Meanwhile, mix spices in a small bowl.",
      "secondary_message": "2 tsp cumin\n2 tsp coriander\n2 tsp salt\n1 ½ tsp cinnamon\n1 tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 192675,
      "primary_message": "Using a clean cutting board, peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 192676,
      "primary_message": "Heat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 192677,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the onions and cook, stirring often, until softened, 4-5 minutes.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 192678,
      "primary_message": "Wash, peel, and mince or grate ginger. Peel and mince garlic.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 cloves garlic"
    },
    {
      "id": 192679,
      "primary_message": "Add ginger, garlic, and spices to the onions and cook, stirring constantly, until fragrant, 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 192680,
      "primary_message": "Using a strainer or colander, drain the diced tomatoes, pressing with the back of a spoon to extract as much liquid as possible; discard liquid.",
      "secondary_message": "2 (398 ml) cans diced tomatoes"
    },
    {
      "id": 192681,
      "primary_message": "Add additional butter, chicken, diced tomatoes, and cream to the skillet. Bring to a boil, then reduce heat to medium; cover and cook until chicken is cooked through, 7-9 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n118 ml (½ cup) heavy cream"
    },
    {
      "id": 192682,
      "primary_message": "Meanwhile, wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 192683,
      "primary_message": "Using a strainer or colander, rinse the frozen peas under running water. Add peas to the butter chicken, stir, and remove from heat.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 192684,
      "primary_message": "To serve, divide rice and butter chicken between bowls; garnish with cilantro and enjoy!",
      "secondary_message": null
    }
  ],
