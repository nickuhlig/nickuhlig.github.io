  "instructions": [
    {
      "id": 192609,
      "primary_message": "Wash the cauliflower and remove the leaves. Using a food processor or box grater, grate to rice-like texture.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 192610,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 192611,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add cauliflower and cook, stirring occasionally, until softened, 5-7 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 192612,
      "primary_message": "Meanwhile, mix spices in a small bowl.",
      "secondary_message": "1 tsp cumin\n1 tsp coriander\n1 tsp salt\n¾ tsp cinnamon\n½ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 192613,
      "primary_message": "Pat the chicken dry with paper towel, cut into bite-sized (1-inch) pieces, and set aside.",
      "secondary_message": "¾ lb chicken thighs, boneless skinless"
    },
    {
      "id": 192614,
      "primary_message": "Using a clean cutting board, peel and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 192615,
      "primary_message": "When cooked, remove the cauliflower from the heat, add salt and pepper, and stir to combine, cover with a lid and set aside.",
      "secondary_message": "½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 192616,
      "primary_message": "Heat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 192617,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the onions and cook, stirring often, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 192618,
      "primary_message": "Wash, peel, and mince or grate ginger. Peel and mince garlic.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 clove garlic"
    },
    {
      "id": 192619,
      "primary_message": "Add ginger, garlic, and spices to the onions and cook, stirring constantly, until fragrant, 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 192620,
      "primary_message": "Using a strainer or colander, drain the diced tomatoes, pressing with the back of a spoon to extract as much liquid as possible; discard liquid.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 192621,
      "primary_message": "Add additional butter, chicken, diced tomatoes, and cream to the skillet. Bring to a boil, then reduce heat to medium; cover and cook until chicken is cooked through, 6-8 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n2 fl oz (¼ cup) heavy cream"
    },
    {
      "id": 192622,
      "primary_message": "Meanwhile, wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "¼ small bunch cilantro"
    },
    {
      "id": 192623,
      "primary_message": "Using a strainer or colander, rinse the frozen peas under running water, then drain. Add peas to the butter chicken, stir, and remove from heat.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 192624,
      "primary_message": "To serve, divide cauliflower rice and butter chicken between bowls; garnish with cilantro and enjoy!",
      "secondary_message": null
    }
  ],
