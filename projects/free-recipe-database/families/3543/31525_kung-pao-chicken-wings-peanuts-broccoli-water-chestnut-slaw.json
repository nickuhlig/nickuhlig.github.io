  "instructions": [
    {
      "id": 497769,
      "primary_message": "Preheat oven to 500°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp neutral vegetable oil"
    },
    {
      "id": 497770,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch and salt, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "1 lb chicken wings, split with tips removed\n1 tsp cornstarch\n½ tsp salt"
    },
    {
      "id": 497771,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 497772,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 red bell pepper\n½ small bunch green onions (scallions)"
    },
    {
      "id": 497773,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small saucepan along with water, vinegar, soy sauce, sugar, cornstarch, and chili-garlic sauce. Whisk to combine.",
      "secondary_message": "1 clove garlic\n¼ cup water\n1 tbsp rice vinegar\n1 tbsp soy sauce\n1 tbsp brown sugar\n2 tsp cornstarch\n1 tsp chili-garlic sauce"
    },
    {
      "id": 497774,
      "primary_message": "Place saucepan over medium heat and cook, whisking occasionally, until sauce thickens, 3-4 minutes. Transfer to a clean medium bowl and set aside for the wings.",
      "secondary_message": null
    },
    {
      "id": 497775,
      "primary_message": "Place oil, vinegar, salt, and pepper in another medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp neutral vegetable oil\n1 tbsp rice vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 497776,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 497777,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 497778,
      "primary_message": "Roughly chop peanuts. Add half to the bowl. (Reserve remaining peanuts for serving.)",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 497779,
      "primary_message": "Drain and rinse water chestnuts; roughly chop. Add to the bowl, along with broccoli slaw, and stir to combine. Set aside.",
      "secondary_message": "4 oz water chestnuts\n½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 497780,
      "primary_message": "When the wings are done, add to the bowl with the sauce and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 497781,
      "primary_message": "To serve, divide wings and slaw between plates; top wings with reserved green onions and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
