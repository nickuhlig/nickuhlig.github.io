  "instructions": [
    {
      "id": 497795,
      "primary_message": "Preheat oven to 500°F. Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 497796,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch and salt, then toss to coat. Divide between the baking sheets and spread out in an even layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed\n1 tbsp cornstarch\n1 ½ tsp salt"
    },
    {
      "id": 497797,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 497798,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 red bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 497799,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small saucepan along with water, vinegar, soy sauce, sugar, cornstarch, and chili-garlic sauce. Whisk to combine.",
      "secondary_message": "3 cloves garlic\n¾ cup water\n3 tbsp rice vinegar\n3 tbsp soy sauce\n3 tbsp brown sugar\n2 tbsp cornstarch\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 497800,
      "primary_message": "Place saucepan over medium heat and cook, whisking occasionally, until sauce thickens, 4-5 minutes. Transfer to a clean large bowl and set aside for the wings.",
      "secondary_message": null
    },
    {
      "id": 497801,
      "primary_message": "Place oil, vinegar, salt, and pepper in another large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp neutral vegetable oil\n3 tbsp rice vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 497802,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 497803,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 497804,
      "primary_message": "Roughly chop peanuts. Add half to the bowl. (Reserve remaining peanuts for serving.)",
      "secondary_message": "1 cup peanuts, roasted unsalted"
    },
    {
      "id": 497805,
      "primary_message": "Drain and rinse water chestnuts; roughly chop. Add to the bowl, along with broccoli slaw, and stir to combine. Set aside.",
      "secondary_message": "8 oz water chestnuts\n1 ½ (12 oz) pkgs broccoli slaw"
    },
    {
      "id": 497806,
      "primary_message": "When the wings are done, add to the bowl with the sauce and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 497807,
      "primary_message": "To serve, divide wings and slaw between plates; top wings with reserved green onions and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
