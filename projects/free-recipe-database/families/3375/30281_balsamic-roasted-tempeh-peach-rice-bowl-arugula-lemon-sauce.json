  "instructions": [
    {
      "id": 482317,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 482318,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 482319,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 peaches\n1 lemon\n1 small pkg fresh basil\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 482320,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 482321,
      "primary_message": "While the rice is cooking, peel, halve, and slice onion lengthwise into ¼-inch thick strips. Transfer to a large baking sheet pan.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 482322,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the baking sheet with the onion.",
      "secondary_message": null
    },
    {
      "id": 482323,
      "primary_message": "Large dice tempeh. Add to the baking sheet, then drizzle with vinegar and oil. Season with spices, stir to coat, and spread out in an even layer.",
      "secondary_message": "2 (8 oz) packages tempeh\n¼ cup balsamic vinegar\n4 tsp extra virgin olive oil\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 482324,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until tempeh is golden and peaches are tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 482325,
      "primary_message": "Meanwhile, juice lemon into a small bowl. Add yogurt, mayo, and spices, then whisk to combine the sauce. Set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n3 tbsp mayonnaise\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 482326,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 482327,
      "primary_message": "When the tempeh and peaches are done, remove from the oven. Add basil to the baking sheet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 482328,
      "primary_message": "To serve, divide rice, roasted tempeh, peaches, and arugula between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
