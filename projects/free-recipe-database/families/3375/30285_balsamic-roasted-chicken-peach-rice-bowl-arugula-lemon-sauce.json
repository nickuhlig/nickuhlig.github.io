  "instructions": [
    {
      "id": 482365,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 482366,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 482367,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 peaches\n1 ½ lemons\n1 small pkg fresh basil\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 482368,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 482369,
      "primary_message": "While the rice is cooking, peel, halve, and slice onions lengthwise into ¼-inch thick strips. Divide between two baking sheet pans.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 482370,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the baking sheets with the onion.",
      "secondary_message": null
    },
    {
      "id": 482371,
      "primary_message": "Cut chicken into bite-sized pieces. Add to the baking sheets, then drizzle with vinegar and oil. Season with spices, stir to coat, and spread out in an even layer.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n⅓ cup balsamic vinegar\n2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 482372,
      "primary_message": "Place baking sheets in the oven and roast, stirring halfway through, until chicken is cooked through and peaches are tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 482373,
      "primary_message": "Meanwhile, juice lemons into a small bowl. Add yogurt, mayo, and spices, then whisk to combine the sauce. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup mayonnaise\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 482374,
      "primary_message": "Pick basil leaves off the stems. Using a clean cutting board, roll up crosswise and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 482375,
      "primary_message": "When the chicken and peaches are done, remove from the oven. Add basil to the baking sheets and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 482376,
      "primary_message": "To serve, divide rice, roasted chicken, peaches, and arugula between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
