  "instructions": [
    {
      "id": 482341,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 482342,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 482343,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 peaches\n½ lemon\n½ small pkg fresh basil\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 482344,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 482345,
      "primary_message": "While the rice is cooking, peel, halve, and slice onion lengthwise into ¼-inch thick strips. Transfer to a baking sheet pan.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 482346,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the baking sheet with the onion.",
      "secondary_message": null
    },
    {
      "id": 482347,
      "primary_message": "Cut chicken into bite-sized pieces. Add to the baking sheet, then drizzle with vinegar and oil. Season with spices, stir to coat, and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n2 tbsp balsamic vinegar\n2 tsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 482348,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until chicken is cooked through and peaches are tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 482349,
      "primary_message": "Meanwhile, juice lemon into a small bowl. Add yogurt, mayo, and spices, then whisk to combine the sauce. Set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 ½ tbsp mayonnaise\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 482350,
      "primary_message": "Pick basil leaves off the stems. Using a clean cutting board, roll up crosswise and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 482351,
      "primary_message": "When the chicken and peaches are done, remove from the oven. Add basil to the baking sheet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 482352,
      "primary_message": "To serve, divide rice, roasted chicken, peaches, and arugula between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
