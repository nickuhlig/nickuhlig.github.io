  "instructions": [
    {
      "id": 482329,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 482330,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 482331,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 peaches\n1 ½ lemons\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 482332,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 482333,
      "primary_message": "While the rice is cooking, peel, halve, and slice onions lengthwise into ¼-inch thick strips. Divide between two baking sheet pans.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 482334,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the baking sheets with the onion.",
      "secondary_message": null
    },
    {
      "id": 482335,
      "primary_message": "Large dice tempeh. Add to the baking sheets, then drizzle with vinegar and oil. Season with spices, stir to coat, and spread out in an even layer.",
      "secondary_message": "3 (8 oz) packages tempeh\n⅓ cup balsamic vinegar\n2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 482336,
      "primary_message": "Place baking sheets in the oven and roast, stirring halfway through, until tempeh is golden and peaches are tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 482337,
      "primary_message": "Meanwhile, juice lemons into a small bowl. Add yogurt, mayo, and spices, then whisk to combine the sauce. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup mayonnaise\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 482338,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 482339,
      "primary_message": "When the tempeh and peaches are done, remove from the oven. Add basil to the baking sheets and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 482340,
      "primary_message": "To serve, divide rice, roasted tempeh, peaches, and arugula between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
