  "instructions": [
    {
      "id": 347492,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 347493,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 small butternut squash\n2 orange bell peppers\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 347494,
      "primary_message": "Trim butternut squash ends, halve crosswise, then cut each piece in half lengthwise; scoop out the seeds. Rub the inside of each squash piece with oil and season with salt and pepper; arrange pieces, cut-side down, on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 347495,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 347496,
      "primary_message": "While the squash is roasting, place couscous in a large bowl.",
      "secondary_message": "1 cup whole wheat couscous"
    },
    {
      "id": 347497,
      "primary_message": "Pour broth into a large skillet, cover, and bring to a boil over high heat. Remove from heat, pour into the bowl with the couscous, and stir (reserve skillet for later use). Tightly cover the bowl with foil and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 347498,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onion crosswise; trim, seed, and medium dice bell peppers. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 347499,
      "primary_message": "Return the skillet to medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom; add veggies and spices. Cook, stirring occasionally, until soft, 4-5 minutes. Remove from heat. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp thyme, dried\n1 tsp rosemary, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 347500,
      "primary_message": "While the veggies are cooking, thinly slice mozzarella. ",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 347501,
      "primary_message": "When the squash is done, remove from the oven and turn the pieces over, cut-side facing up. Change the oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 347502,
      "primary_message": "Divide mozzarella between squash pieces and return to the oven; broil until mozzarella is golden and melted, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 347503,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 347504,
      "primary_message": "Add cooked veggies, basil, arugula, pine nuts, and vinegar to the bowl with the couscous. Stir to combine the couscous salad. ",
      "secondary_message": "¼ cup pine nuts\n2 tbsp balsamic vinegar"
    },
    {
      "id": 347505,
      "primary_message": "To serve, divide butternut squash and couscous salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
