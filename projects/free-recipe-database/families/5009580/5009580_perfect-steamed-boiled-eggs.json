  "instructions": [
    {
      "id": 1,
      "primary_message": "If serving eggs cold, add one tray of ice cubes to a large bowl and fill with water.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add 1 inch of water to a large pot. Place steamer insert inside, cover, and bring to a boil over high heat. Add eggs to steamer basket, cover, and continue cooking: 6 minutes for soft-boiled eggs or 12 minutes for hard-boiled.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Serve immediately if serving hot. If serving cold, immediately place eggs in bowl of ice water and allow to cool for at least 15 minutes before peeling.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To peel, first gently tap hard-boiled eggs all over to thoroughly crack the shell, then remove shell under a thin stream of running water. (The water helps get under the shell and lift it off the egg.)",
      "secondary_message": null
    }
  ],
