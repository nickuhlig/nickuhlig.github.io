  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the butter to room temperature. Mince the garlic. Pick the parsley leaves from the stems and finely chop them. Husk the corn.",
      "secondary_message": "8 tbsp butter\n3 cloves garlic\n1 tbsp fresh parsley\n4 ears corn"
    },
    {
      "id": 1,
      "primary_message": "To make the garlic butter, whisk together 8 tablespoons butter, garlic, red pepper flakes, and parsley in a small bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Lightly butter the corn with 1 tablespoon of butter and season with salt and pepper to taste. Wrap ears individually in aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over entire surface of coal grate. Alternatively, set all the burners of a gas grill to high heat. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Place the foiled corn on the grill and cook until tender and slightly charred, about 20 minutes, turning 4 times during cooking. Remove from the grill and let cool for 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Mix Parmesan and Pecorino together cheeses on a large plate. Open the foiled corn, slather each ear in the garlic butter, roll in the cheese mixture, and serve.",
      "secondary_message": null
    }
  ],
