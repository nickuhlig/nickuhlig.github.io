  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat a heavy sauté pan over medium high heat. Add pumpkin seeds. When you hear first pumpkin seed pop, begin to stir the seeds, toasting just until all seeds have popped from flat to round. Let seeds cool. Set aside 2 tablespoons for garnish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place garlic and onion in a food processor. Blend until roughly chopped. Add pumpkin seeds and blend until roughly chopped.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add tomatillos, romaine, jalapeño, and cilantro to food processor and pulse until mixture is a lightly chunky purée.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat oil in a medium sauce pot over medium high heat. Add pumpkin seed sauce and stir to combine. Simmer for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add one cup water. Simmer sauce for another 20 minutes, until reduced and darkened in color. Stir in lime juice. Season with salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Heat a grill pan over medium high heat. Rub chicken breasts with olive oil and sprinkle with salt and pepper. Grill until just cooked through, about 5 minutes per side. Let chicken rest for 5 minutes then slice on the diagonal.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Top each tortilla with slices of grilled chicken. Top with pumpkin seed sauce. Garnish with toasted pumpkin seeds and slices of avocado.",
      "secondary_message": null
    }
  ],
