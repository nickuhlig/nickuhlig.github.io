  "instructions": [
    {
      "primary_message": "Place chicken in a small saucepan. Season with salt and pepper. Cover with water and bring to a boil. Reduce heat, cover, and simmer until chicken is cooked through, 8-12 minutes. Remove from liquid and place on a plate.",
      "secondary_message": "½ lb chicken breasts, boneless skinless\nsalt\nblack pepper"
    },
    {
      "primary_message": "In a medium bowl, prepare dressing by whisking together mayo, lemon juice, honey, mustard, salt, and pepper.",
      "secondary_message": "¼ cup mayonnaise\n½ lemon\n½ tsp honey\n¼ tsp Dijon mustard\nsalt\nblack pepper"
    },
    {
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "primary_message": "Coat bottom of skillet with oil. Add walnuts and, stirring constantly, toast until golden brown, 1-2 minutes. Remove from heat to cool.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Wash apple, celery, grapes, and chives. Core, medium dice, and add apple to bowl with dressing. Trim ends, medium dice, and add celery to bowl. Halve grapes and add to bowl. Chop chives and add to bowl.",
      "secondary_message": "1 Gala apple\n2 sticks celery\n¼ lb red grapes\n½ small pkg chives"
    },
    {
      "primary_message": "Wash and dry lettuce. Chop crosswise into 1 inch strips.",
      "secondary_message": "½ head romaine lettuce"
    },
    {
      "primary_message": "Pat dry the chicken with paper towels, medium dice, and add to bowl. Toss salad until well combined.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange a bed of lettuce leaves on a plate and top with salad. Enjoy!",
      "secondary_message": null
    }
  ],
