  "instructions": [
    {
      "id": 15039,
      "primary_message": "Place chicken in a small saucepan. Season with salt and pepper. Cover with water and bring to a boil. Reduce heat, cover, and simmer until chicken is cooked through, 8-12 minutes. Remove from liquid and place on a plate.",
      "secondary_message": "1 lb chicken breasts, boneless skinless \r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 15040,
      "primary_message": "In a large bowl, prepare dressing by whisking together yogurt, lemon juice, honey, mustard, salt, and pepper.",
      "secondary_message": "½ cup plain Greek yogurt\njuice of 1 lemon\n1 tsp honey\n½ tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 15041,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 15042,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "1 cup walnuts"
    },
    {
      "id": 15043,
      "primary_message": "Coat bottom of skillet with oil. Add walnuts and, stirring constantly, toast until golden brown, 1-2 minutes. Remove from heat to cool.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 15044,
      "primary_message": "Wash apples, celery, grapes, and chives. Core, medium dice, and add apples to bowl with dressing. Trim ends, medium dice, and add celery to bowl. Halve grapes and add to bowl. Chop chives and add to bowl.",
      "secondary_message": "2 Gala apples\n4 sticks celery\n½ lb red grapes\n1 small pkg chives"
    },
    {
      "id": 15045,
      "primary_message": "Wash and dry lettuce. Halve lengthwise, then chop crosswise into 1 inch strips.",
      "secondary_message": "1 head romaine lettuce"
    },
    {
      "id": 15046,
      "primary_message": "Pat dry the chicken with paper towels, medium dice, and add to bowl. Toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 15047,
      "primary_message": "To serve, arrange a bed of lettuce leaves on a plate and top with salad. Enjoy!",
      "secondary_message": ""
    }
  ],
