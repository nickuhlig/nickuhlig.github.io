  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Cake: Adjust oven rack to middle position and preheat oven to 350°F. Lightly spray 9- by 5-inch loaf pan with baking spray.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Allow tea to steep in boiling water for 8 to 10 minutes. Squeeze out all liquid from bags and discard. Allow tea to cool to room temperature. Divide tea in half, reserving half for icing.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine flour, baking powder, and salt in medium bowl; set aside. Beat butter, sugar, and lemon zest with an electric mixer on medium speed until light and fluffy, about 2 minutes. Add eggs, one at a time, beating well after each addition. Reduce mixer speed to low and add flour mixture in three additions, alternating with tea. Scrape bottom and sides of bowl with rubber spatula as needed. Add vanilla and beat just to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Scrape batter into prepared pan and bake until a tester comes out clean when inserted, 50 to 60 minutes. Transfer cake to cooling rack and let cool in pan 15 minutes. Invert cake directly onto cooling rack and cool completely, at least 1 hour.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "For the Glaze: Combine reserved tea and honey in small saucepan and bring to a simmer over medium heat, stirring until honey mixture is homogenous. Remove from heat and cool 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Using a skewer, poke holes all over cake. Pour glaze over cake. Serve.",
      "secondary_message": null
    }
  ],
