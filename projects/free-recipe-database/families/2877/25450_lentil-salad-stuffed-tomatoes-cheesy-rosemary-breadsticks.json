  "instructions": [
    {
      "id": 456029,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 456030,
      "primary_message": "Place flatbread on a baking sheet pan; drizzle with oil, season with spices, and sprinkle with cheese. Place flatbread in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes.",
      "secondary_message": "1 flatbread or naan\n2 tsp extra virgin olive oil\n¼ tsp rosemary, dried\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper\n½ cup shredded cheese, Italian blend"
    },
    {
      "id": 456031,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice celery. Place in a medium bowl.",
      "secondary_message": "1 stick celery"
    },
    {
      "id": 456032,
      "primary_message": "Drain and rinse lentils. Add to the bowl with the celery along with mayo, dressing, and salt. Stir to combine the lentil salad.",
      "secondary_message": "1 (255 g) can lentils\n2 tbsp mayonnaise\n1 tbsp ranch dressing\n⅛ tsp salt"
    },
    {
      "id": 456033,
      "primary_message": "Wash, dry, and trim tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom; sprinkle with salt.",
      "secondary_message": "4 tomatoes\n⅛ tsp salt"
    },
    {
      "id": 456034,
      "primary_message": "When the flatbread is done, remove from oven and slice crosswise into 2-inch wide strips.",
      "secondary_message": null
    },
    {
      "id": 456035,
      "primary_message": "Divide tomatoes between plates and stuff with lentil salad. Serve with cheesy breadsticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
