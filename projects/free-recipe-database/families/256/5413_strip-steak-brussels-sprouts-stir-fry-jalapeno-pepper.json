  "instructions": [
    {
      "id": 64993,
      "primary_message": "Wash brussels sprouts, carrots, jalapeños, and green onions.",
      "secondary_message": "1.362 kg brussels sprouts\n3 medium carrots\n3 jalapeño peppers\n1 ½ small bunch green onions (scallions)"
    },
    {
      "id": 65004,
      "primary_message": "Trim, peel, and slice carrots on the diagonal into ⅔ cm rounds. Transfer to a bowl.",
      "secondary_message": ""
    },
    {
      "id": 65003,
      "primary_message": "Halve, seed, and thinly slice jalapeños crosswise. Peel and mince garlic. Peel and mince or grate ginger. Transfer all to a small bowl.",
      "secondary_message": "6 cloves garlic\n3 (2 ½ cm) pieces ginger"
    },
    {
      "id": 64992,
      "primary_message": "Trim green onion root ends and slice on the diagonal. Add whites to bowl with jalapeño, garlic, and ginger; transfer the greens to a separate bowl and save for garnishing.",
      "secondary_message": ""
    },
    {
      "id": 65002,
      "primary_message": "Trim rough ends of brussels sprouts and halve lengthwise. Transfer to a separate bowl.",
      "secondary_message": ""
    },
    {
      "id": 65001,
      "primary_message": "In a small bowl, prepare sauce by whisking together soy sauce, vinegar, water, and cornstarch.",
      "secondary_message": "6 tbsp soy sauce\n3 tbsp rice vinegar\n6 tbsp water\n¾ tsp cornstarch"
    },
    {
      "id": 65000,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 64999,
      "primary_message": "Thinly slice steak into strips.",
      "secondary_message": "1.02 kg striploin (New York strip) steak"
    },
    {
      "id": 64998,
      "primary_message": "Coat bottom of skillet with oil. Add steak strips in a single layer and cook until browned, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 64997,
      "primary_message": "Add more oil to skillet, followed by brussels sprouts. Cook, stirring occasionally, until golden brown, 2-3 minutes. Transfer to plate with steak.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 64996,
      "primary_message": "Add more oil to skillet, followed by green onion whites, jalapeño, garlic, and ginger. Stir and cook until fragrant, 15-30 seconds. Add carrot and cook, stirring occasionally, until tender, 2-3 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 64995,
      "primary_message": "Return steak and sprouts to skillet and add sauce. Cook, stirring occasionally, until sauce is thickened, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 64994,
      "primary_message": "To serve, place stir fry on a plate and garnish with remaining green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
