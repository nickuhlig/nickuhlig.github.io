  "instructions": [
    {
      "id": 385220,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; whisk to combine the pickling liquid.",
      "secondary_message": "½ cup white wine vinegar\n2 ½ tsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 385221,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 385222,
      "primary_message": "Wash, dry, and thinly slice mushrooms. ",
      "secondary_message": "0.68 kg cremini mushrooms"
    },
    {
      "id": 385223,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385224,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the mushrooms, salt, and pepper; cook, stirring occasionally, until mushrooms are soft, 10-12 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 385225,
      "primary_message": "While the mushrooms are cooking, place mayo, ketchup, Dijon, and cayenne in a small bowl. Whisk to combine the special sauce and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tbsp ketchup\n1 ½ tbsp Dijon mustard\n3 pinch cayenne pepper"
    },
    {
      "id": 385226,
      "primary_message": "When the mushrooms are done, add additional vinegar and cook until dry, 15-30 seconds. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp white wine vinegar"
    },
    {
      "id": 385227,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385228,
      "primary_message": "While the skillet heats up, season burger patties with salt and pepper on both sides.",
      "secondary_message": "6 veggie burger patties, plant-based\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 385229,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Add to the plate with the mushrooms and re-cover with foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 385230,
      "primary_message": "Meanwhile, place additional oil, vinegar, salt, and pepper in another medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n3 pinch salt\n¼ tsp black pepper"
    },
    {
      "id": 385231,
      "primary_message": "Wash, dry, and separate lettuce into leaves. Set aside two leaves per burger and chop (or tear) remaining leaves into bite-sized pieces. Add the bite-sized pieces to the bowl with the dressing; toss to coat.",
      "secondary_message": "3 heads butter (Boston) lettuce"
    },
    {
      "id": 385232,
      "primary_message": "Pile lettuce leaves, in stacks of two per wrap, on each plate; top with special sauce, burgers, mushrooms, blue cheese, and pickled onions. Serve with salad on the side and enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    }
  ],
