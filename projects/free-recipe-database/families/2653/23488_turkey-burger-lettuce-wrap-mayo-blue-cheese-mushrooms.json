  "instructions": [
    {
      "id": 385041,
      "primary_message": "Place vinegar and salt in a small bowl; whisk to combine the pickling liquid.",
      "secondary_message": "3 tbsp white wine vinegar\n½ tsp salt"
    },
    {
      "id": 385042,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 385043,
      "primary_message": "Place turkey, egg, Worcestershire, salt, and pepper in a medium bowl; mix with your hands until well combined. Form the turkey mixture into 2 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "¾ lb ground turkey\n1 egg\n1 tsp Worcestershire sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 385044,
      "primary_message": "Wash, dry, and thinly slice mushrooms. ",
      "secondary_message": "½ lb cremini mushrooms"
    },
    {
      "id": 385045,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385046,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the mushrooms, salt, and pepper; cook, stirring occasionally, until mushrooms are soft, 8-10 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 385047,
      "primary_message": "When the mushrooms are done, add additional vinegar and cook until dry, 15-30 seconds. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tsp white wine vinegar"
    },
    {
      "id": 385048,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385049,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, until golden underneath, about 5 minutes; flip patties, and cook an additional 5-6 minutes, until cooked through. Add burgers to the plate with the mushrooms and re-cover with foil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 385050,
      "primary_message": "Meanwhile, place additional oil, vinegar, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 385051,
      "primary_message": "Wash, dry, and separate lettuce into leaves. Set aside two leaves per burger and chop (or tear) remaining leaves into bite-sized pieces. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 head butter (Boston) lettuce"
    },
    {
      "id": 385052,
      "primary_message": "Pile lettuce leaves, in stacks of two per wrap, on each plate; top with mayo, burgers, mushrooms, blue cheese, and pickled onions. Serve with salad on the side and enjoy!",
      "secondary_message": "2 tbsp avocado oil mayonnaise\n½ (4 oz) pkg crumbled blue cheese"
    }
  ],
