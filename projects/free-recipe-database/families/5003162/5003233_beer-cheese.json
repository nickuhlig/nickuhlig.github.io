  "instructions": [
    {
      "id": 1,
      "primary_message": "Toss cheese with cornstarch in a medium bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk together beer, milk, mustard, and Worcestershire sauce in a medium saucepan. Heat over medium heat until gently steaming, whisking frequently to prevent scorching.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When beer mixture is warm, add cheese, stirring until completely melted, bubbling slightly, and thickened. Stir in hot sauce and season with salt to taste; serve immediately.",
      "secondary_message": null
    }
