  "instructions": [
    {
      "id": 401001,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n½ English cucumber\n1 pint grape tomatoes\n1 yellow bell pepper\n1 avocado"
    },
    {
      "id": 401002,
      "primary_message": "Drain and rinse lentils; set aside to drain further.",
      "secondary_message": "1 (15 oz) can lentils"
    },
    {
      "id": 401003,
      "primary_message": "Place mixed greens and carrots in a medium bowl.",
      "secondary_message": "½ (10 oz) bag shredded carrots"
    },
    {
      "id": 401004,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the mixed greens.",
      "secondary_message": null
    },
    {
      "id": 401005,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 401006,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 401007,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 401008,
      "primary_message": "Crumble goat cheese. Add to the bowl along with the lentils, almonds, cranberries, and dressing; toss to combine the salad.",
      "secondary_message": "½ (4 oz) log goat cheese\n¼ cup almonds, sliced\n¼ cup dried cranberries\n¼ cup balsamic vinaigrette"
    },
    {
      "id": 401009,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
