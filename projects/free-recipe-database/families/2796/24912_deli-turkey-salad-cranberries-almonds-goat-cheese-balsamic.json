  "instructions": [
    {
      "id": 400992,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 (5 oz) pkgs spring mix (mixed greens)\n1 ½ English cucumbers\n3 pints grape tomatoes\n3 yellow bell peppers\n3 avocados"
    },
    {
      "id": 400993,
      "primary_message": "Place mixed greens and carrots in a large bowl.",
      "secondary_message": "1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 400994,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the mixed greens.",
      "secondary_message": null
    },
    {
      "id": 400995,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400996,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400997,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400998,
      "primary_message": "Stack turkey slices one on top of another, then medium dice. Add to the bowl.",
      "secondary_message": "24 oz oven roasted turkey breast, sliced"
    },
    {
      "id": 400999,
      "primary_message": "Crumble goat cheese. Add to the bowl along with the almonds, cranberries, and dressing; toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese\n¾ cup almonds, sliced\n¾ cup dried cranberries\n¾ cup balsamic vinaigrette"
    },
    {
      "id": 401000,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
