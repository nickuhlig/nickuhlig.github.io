  "instructions": [
    {
      "id": 461850,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp neutral vegetable oil\n3 tbsp rice vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 461851,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium carrots\n1 ½ jalapeño peppers\n1 ½ small bunches cilantro\n3 tomatoes"
    },
    {
      "id": 461852,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 461853,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 461854,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 461855,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461856,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 ½ lb ground chicken\n1 ½ tbsp garam masala\n1 ½ tbsp chili powder\n1 ½ tsp salt"
    },
    {
      "id": 461857,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 461858,
      "primary_message": "Small dice tomatoes. Add to the bowl with the shallot along with yogurt, water, salt, and pepper; stir to combine the raita. Set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 461859,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 461860,
      "primary_message": "Divide tortillas between plates, fill with chicken, then top with raita. Serve with carrot salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
