  "instructions": [
    {
      "id": 461971,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp neutral vegetable oil\n2 tbsp rice vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 461972,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n1 jalapeño pepper\n1 small bunch cilantro\n2 tomatoes"
    },
    {
      "id": 461973,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 461974,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 461975,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 461976,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461977,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp neutral vegetable oil\n0.45 kg ground chicken\n1 tbsp garam masala\n1 tbsp chili powder\n1 tsp salt"
    },
    {
      "id": 461978,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a small bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 461979,
      "primary_message": "Small dice tomatoes. Add to the bowl with the shallot along with yogurt, water, salt, and pepper; stir to combine the raita. Set aside. ",
      "secondary_message": "1 cup plain Greek yogurt\n2 tbsp water\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 461980,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 461981,
      "primary_message": "Divide tortillas between plates, fill with chicken, then top with raita. Serve with carrot salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
