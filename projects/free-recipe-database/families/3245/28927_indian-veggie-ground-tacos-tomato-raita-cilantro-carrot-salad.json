  "instructions": [
    {
      "id": 461861,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp neutral vegetable oil\n1 tbsp rice vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 461862,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n½ jalapeño pepper\n½ small bunch cilantro\n1 tomato"
    },
    {
      "id": 461863,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 461864,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 461865,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 461866,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461867,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp neutral vegetable oil\n8 oz veggie ground, plant based\n1 ½ tsp garam masala\n1 ½ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 461868,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a small bowl. ",
      "secondary_message": "½ shallot"
    },
    {
      "id": 461869,
      "primary_message": "Small dice tomato. Add to the bowl with the shallot along with yogurt, water, salt, and pepper; stir to combine the raita. Set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp water\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 461870,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 461871,
      "primary_message": "Divide tortillas between plates, fill with veggie ground, then top with raita. Serve with carrot salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
