  "instructions": [
    {
      "id": 517574,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ½ cup pasta water before draining.)",
      "secondary_message": "1 tsp salt\n283 g rotini pasta"
    },
    {
      "id": 517575,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 517576,
      "primary_message": "While the skillet heats up, cut chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 517577,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until golden and cooked through, about 5 minutes. Transfer chicken to a plate and set aside. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 517578,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n4 medium carrots\n2 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 517579,
      "primary_message": "Using a clean cutting board, trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 517580,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 517581,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 517582,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 517583,
      "primary_message": "Return skillet (with cooking juices) to medium heat, add more butter, and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 517584,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 517585,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "⅔ (227 g) block cream cheese"
    },
    {
      "id": 517586,
      "primary_message": "Add parsley (reserving a small handful for serving), cream cheese, and hot sauce to the skillet. Continue to cook, stirring frequently, until cream cheese melts, 2-3 minutes.",
      "secondary_message": "2 tbsp hot sauce"
    },
    {
      "id": 517587,
      "primary_message": "Add cooked pasta, reserved pasta cooking water, and chicken to the skillet; stir to combine. Continue to cook, stirring frequently, until the pasta and chicken are warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 517588,
      "primary_message": "To serve, divide pasta between plates or bowls. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
