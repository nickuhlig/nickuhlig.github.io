  "instructions": [
    {
      "id": 517499,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ¾ cup pasta water before draining.)",
      "secondary_message": "1 ½ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 517500,
      "primary_message": "Meanwhile, preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 517501,
      "primary_message": "While the pot heats up, cut chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 517502,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until golden and cooked through, 6-7 minutes. Transfer chicken to a plate and set aside. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 517503,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n6 medium carrots\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 517504,
      "primary_message": "Using a clean cutting board, trim, seed, and small dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 517505,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 517506,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 517507,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 517508,
      "primary_message": "Return pot (with cooking juices) to medium heat, add more butter, and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 517509,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 517510,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "1 (8 oz) block cream cheese"
    },
    {
      "id": 517511,
      "primary_message": "Add parsley (reserving a small handful for serving), cream cheese, and hot sauce to the pot. Continue to cook, stirring frequently, until cream cheese melts, 3-4 minutes.",
      "secondary_message": "3 tbsp hot sauce"
    },
    {
      "id": 517512,
      "primary_message": "Add cooked pasta, reserved pasta cooking water, and chicken to the pot; stir to combine. Continue to cook, stirring frequently, until the pasta and chicken are warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 517513,
      "primary_message": "To serve, divide pasta between plates or bowls. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
