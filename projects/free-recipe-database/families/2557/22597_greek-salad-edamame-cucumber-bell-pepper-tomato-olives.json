  "instructions": [
    {
      "id": 375471,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n½ green bell pepper\n½ English cucumber"
    },
    {
      "id": 375472,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 375473,
      "primary_message": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp oregano, dried"
    },
    {
      "id": 375474,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 375475,
      "primary_message": "Large dice tomato. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375476,
      "primary_message": "Trim, seed, and large dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375477,
      "primary_message": "Trim and large dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375478,
      "primary_message": "Halve olives lengthwise. Add to the bowl and stir to combine the salad.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 375479,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
