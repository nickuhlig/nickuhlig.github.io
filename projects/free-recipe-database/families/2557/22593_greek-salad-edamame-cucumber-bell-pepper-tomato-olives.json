  "instructions": [
    {
      "id": 375438,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n1 ½ green bell peppers\n1 ½ English cucumbers"
    },
    {
      "id": 375439,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 375440,
      "primary_message": "Place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n¾ tsp salt\n½ tsp black pepper\n½ tsp oregano, dried"
    },
    {
      "id": 375441,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 375442,
      "primary_message": "Large dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375443,
      "primary_message": "Trim, seed, and large dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375444,
      "primary_message": "Trim and large dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375445,
      "primary_message": "Halve olives lengthwise. Add to the bowl and stir to combine the salad.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 375446,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
