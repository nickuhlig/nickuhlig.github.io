  "instructions": [
    {
      "id": 375463,
      "primary_message": "Place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp salt\n½ tsp black pepper\n½ tsp oregano, dried"
    },
    {
      "id": 375464,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half moons. Add to the bowl with the dressing and stir to coat. Set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 375465,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n1 ½ green bell peppers\n1 ½ English cucumbers"
    },
    {
      "id": 375466,
      "primary_message": "Large dice tomatoes. Add to the bowl with the dressing and shallot.",
      "secondary_message": null
    },
    {
      "id": 375467,
      "primary_message": "Trim, seed, and large dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375468,
      "primary_message": "Trim and large dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375469,
      "primary_message": "Halve olives lengthwise. Add to the bowl, along with the feta, and stir to combine the salad.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 375470,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
