  "instructions": [
    {
      "id": 375396,
      "primary_message": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp oregano, dried"
    },
    {
      "id": 375397,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half moons. Add to the bowl with the dressing and stir to coat. Set aside.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 375398,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n½ green bell pepper\n½ English cucumber"
    },
    {
      "id": 375399,
      "primary_message": "Large dice tomato. Add to the bowl with the dressing and shallot.",
      "secondary_message": null
    },
    {
      "id": 375400,
      "primary_message": "Trim, seed, and large dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375401,
      "primary_message": "Trim and large dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 375402,
      "primary_message": "Halve olives lengthwise. Add to the bowl, along with the feta, and stir to combine the salad.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 375403,
      "primary_message": "To serve, divide salad between bowls and enjoy!",
      "secondary_message": null
    }
