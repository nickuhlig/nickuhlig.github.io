  "instructions": [
    {
      "id": 424740,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (454 g) pkg strawberries\n½ lime\n½ small pkg grape tomatoes\n1 heart romaine hearts"
    },
    {
      "id": 424741,
      "primary_message": "Trim and halve strawberries; place on a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 424742,
      "primary_message": "Zest and juice lime into a small bowl; add yogurt and honey. Whisk to combine the dip and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp honey"
    },
    {
      "id": 424743,
      "primary_message": "Halve tomatoes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 424744,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, and add to the bowl with the tomatoes.",
      "secondary_message": "½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 424745,
      "primary_message": "Add dressing to the bowl and stir to combine the chicken salad filling.",
      "secondary_message": "¼ cup Caesar dressing"
    },
    {
      "id": 424746,
      "primary_message": "Trim off and discard root end of the romaine heart; separate the leaves to use as \"wraps\" and divide between plates.",
      "secondary_message": null
    },
    {
      "id": 424747,
      "primary_message": "Divide chicken filling between the romaine leaves and sprinkle with Parmesan. Serve with strawberries and dip on the side. Enjoy!",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    }
  ],
