  "instructions": [
    {
      "id": 424671,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (16 oz) pkg strawberries\n1 lime\n1 pint grape tomatoes\n2 hearts romaine hearts"
    },
    {
      "id": 424672,
      "primary_message": "Trim and halve strawberries; place on a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 424673,
      "primary_message": "Zest and juice lime into a small bowl; add yogurt and honey. Whisk to combine the dip and set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n1 tsp honey"
    },
    {
      "id": 424674,
      "primary_message": "Halve tomatoes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 424675,
      "primary_message": "Halve lettuce lengthwise, then cut crosswise into thin (shred-like) strips. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 424676,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and add to the bowl.",
      "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 424677,
      "primary_message": "Add Parmesan and dressing to the bowl. Stir to combine the chicken salad filling.",
      "secondary_message": "½ cup Parmesan cheese, shredded\n½ cup Caesar dressing"
    },
    {
      "id": 424678,
      "primary_message": "Using a clean cutting board, cut pitas in half and carefully open the pockets. Stuff each pocket with the filling.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 424679,
      "primary_message": "To serve, divide pitas, strawberries, and dip between plates. Enjoy!",
      "secondary_message": null
    }
  ],
