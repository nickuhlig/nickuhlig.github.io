  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine the sugar and pectin in a medium bowl and whisk to blend.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Peel, core, and chop the pears. Transfer them to a food processor and pulse until they are coarsely pureed, about 10 pulses.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine the pears, lemon juice, amaretto, calcium water, and almond extract (if using) in a large, heavy-bottomed saucepan and bring to a boil over medium heat, stirring frequently. Add the sugar-pectin mixture and return the mixture to a full rolling boil. Boil for one minute. Remove the pot from the heat and skim any foam from the surface of the jam. Stir in the chocolate until melted and smooth.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Ladle the hot jam into hot, clean jars. To preserve the jam, process it in a hot water bath for 10 minutes. The preserved jam will keep for up to a year on the shelf. Otherwise, store the jars in the refrigerator for up to two months.",
      "secondary_message": null
    }
  ],
