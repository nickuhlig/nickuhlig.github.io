  "instructions": [
    {
      "id": 74038,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n3 medium carrots\n0.341 kg white mushrooms\n1 ½ small pkg fresh thyme"
    },
    {
      "id": 74037,
      "primary_message": "Peel and quarter the potatoes; transfer to a small saucepan.",
      "secondary_message": ""
    },
    {
      "id": 74036,
      "primary_message": "Cover the potatoes with hot water (from the tap); bring to a boil over high heat.",
      "secondary_message": ""
    },
    {
      "id": 74035,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Small dice the carrots (cut into 6-mm cubes) and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 74034,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and add to the carrots.",
      "secondary_message": "1 ½ medium yellow onion"
    },
    {
      "id": 74033,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 74032,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the carrots and onion.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 74031,
      "primary_message": "Once the pan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 74030,
      "primary_message": "Add the carrots, onion, and garlic to the pan; season with salt and pepper. Cook, stirring frequently, until the vegetables are slightly softened, 2 to 3 minutes.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 74029,
      "primary_message": "Once the water in the saucepan is boiling, reduce the heat to medium and cook until the potatoes are tender when pierced with a knife, 15 to 20 minutes. Once done, drain the potatoes and return to the saucepan; cover to keep warm.",
      "secondary_message": ""
    },
    {
      "id": 74028,
      "primary_message": "Trim off and discard the stem ends of the mushrooms; small dice the mushrooms (cut into 6-mm cubes).",
      "secondary_message": ""
    },
    {
      "id": 74027,
      "primary_message": "Add the mushrooms to the pan; cook, stirring frequently, until slightly softened, 2 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 74026,
      "primary_message": "Rinse the lentils in a colander or strainer.",
      "secondary_message": "2 ¼ cups green lentils"
    },
    {
      "id": 74025,
      "primary_message": "Add the rinsed lentils and broth to the pan; season with salt and pepper. Bring the mixture to a boil, then reduce the heat to a simmer, cover with a lid, and cook until the lentils are just tender, 15 to 20 minutes.",
      "secondary_message": "1050 ml (4½ cups) chicken or vegetable broth\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 74024,
      "primary_message": "One by one, holding a sprig of thyme at its top, run your fingers down it to remove the leaves. Discard the sprigs and chop the leaves. Stir about ¾ of the thyme into the lentil mixture and save the rest for garnishing.",
      "secondary_message": ""
    },
    {
      "id": 74023,
      "primary_message": "Once the lentils are tender, stir in the green peas.",
      "secondary_message": "1 ½ cup frozen peas"
    },
    {
      "id": 74021,
      "primary_message": "Add coconut oil, broth, salt, and pepper to the potatoes; mash with a potato masher until smooth.",
      "secondary_message": "6 tbsp virgin coconut oil\n180 ml (¾ cup) chicken or vegetable broth\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 74022,
      "primary_message": "To serve, divide the lentil mixture between plates or bowls, top with the mashed potatoes, and sprinkle with the remaining thyme leaves. Enjoy!",
      "secondary_message": ""
    }
  ],
