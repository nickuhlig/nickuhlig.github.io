  "instructions": [
    {
      "id": 201779,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red chili pepper\n3 baby bok choy\n½ small bunch green onions (scallions)\n½ bunch radish"
    },
    {
      "id": 201780,
      "primary_message": "Halve chili pepper lengthwise; seed and remove ribs with a spoon. Mince and place in a medium bowl. (Be careful, with chilies, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 201781,
      "primary_message": "Peel and mince garlic; add to the bowl along with oil, soy sauce, chili-garlic sauce, and salt. Whisk to combine the pepper paste.",
      "secondary_message": "2 cloves garlic\n2 tbsp toasted sesame oil\n1 tbsp soy sauce\n1 tsp chili-garlic sauce\n¼ tsp salt"
    },
    {
      "id": 201782,
      "primary_message": "Thinly slice steak into strips and place in another medium bowl. Add half of the pepper paste and toss to coat. Set aside to marinate.",
      "secondary_message": "⅓ kg striploin (New York strip) steak"
    },
    {
      "id": 201783,
      "primary_message": "Using a clean cutting board, trim off and discard root ends of the bok choy; separate into leaves and add to the bowl with the remaining pepper paste.",
      "secondary_message": null
    },
    {
      "id": 201784,
      "primary_message": "Trim and cut green onions into 1-inch pieces; add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 201785,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 201786,
      "primary_message": "Meanwhile, trim and quarter the radishes; add to the bowl with the other veggies and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 201787,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 201788,
      "primary_message": "Add steak to the pot and cook, stirring frequently, until starting to brown, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 201789,
      "primary_message": "Add broth and veggies to the pot, stirring to combine. Bring to a boil, then reduce heat to a simmer and cook until steak is cooked through and veggies are tender, 3 minutes more.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 201790,
      "primary_message": "Meanwhile, whisk egg and salt in a small bowl.",
      "secondary_message": "1 egg\n1 pinch salt"
    },
    {
      "id": 201791,
      "primary_message": "When the soup is done, slowly pour the egg into the pot, while gently stirring, to separate into strands. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 201792,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
