  "instructions": [
    {
      "id": 201821,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red chili pepper\n3 baby bok choy\n½ small bunch green onions (scallions)\n2 medium carrots\n½ bunch radish"
    },
    {
      "id": 201822,
      "primary_message": "Halve chili pepper lengthwise; seed and remove ribs with a spoon. Mince and place in a medium bowl. (Be careful, with chilis, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 201823,
      "primary_message": "Peel and mince garlic; add to the bowl along with oil, soy sauce, chili-garlic sauce, and salt. Whisk to combine the pepper paste. Transfer half to a large pot and set aside.",
      "secondary_message": "2 cloves garlic\n3 tbsp toasted sesame oil\n1 tbsp soy sauce\n1 tsp chili-garlic sauce\n¼ tsp salt"
    },
    {
      "id": 201824,
      "primary_message": "Large dice tofu and add to the bowl with the remaining pepper paste. Toss to combine and set aside.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 201825,
      "primary_message": "Trim off and discard root ends of the bok choy; separate into leaves and add to the pot.",
      "secondary_message": null
    },
    {
      "id": 201826,
      "primary_message": "Trim and cut onions into 1-inch pieces; add to the pot.",
      "secondary_message": null
    },
    {
      "id": 201827,
      "primary_message": "Peel and roughly chop carrots; add to the pot.",
      "secondary_message": null
    },
    {
      "id": 201828,
      "primary_message": "Trim and quarter radishes; add to the pot along with the edamame.",
      "secondary_message": "½ cup edamame"
    },
    {
      "id": 201829,
      "primary_message": "Add broth to the pot, stir to combine, and bring to a boil over medium-high heat.",
      "secondary_message": "946 ml chicken or vegetable broth"
    },
    {
      "id": 201830,
      "primary_message": "Once boiling, add tofu and sauce. Bring to a simmer and cook, stirring occasionally, until veggies are tender and tofu is heated through, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 201831,
      "primary_message": "To serve, divide soup between bowls; top with sesame seeds and a drizzle of oil. Enjoy!",
      "secondary_message": "2 tsp sesame seeds\n1 tsp toasted sesame oil"
    }
  ],
