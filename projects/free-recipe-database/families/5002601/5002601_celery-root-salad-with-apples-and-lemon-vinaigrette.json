  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Vinaigrette: In a small bowl, combine shallot, lemon zest, lemon juice, garlic, salt, and pepper, and let sit for 10 minutes. Whisk in mustard. Slowly drizzle in olive oil while whisking constantly until emulsified.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Salad: In a large bowl, add celeriac, apple, radishes, and parsley.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour dressing over top and toss well to coat. Season with salt to taste. Transfer to a serving dish. Lightly crush the toasted walnuts by hand, sprinkle them over the salad, then serve.",
      "secondary_message": null
    }
