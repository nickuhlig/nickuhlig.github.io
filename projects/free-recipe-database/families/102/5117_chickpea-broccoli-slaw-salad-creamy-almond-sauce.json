  "instructions": [
    {
      "id": 61833,
      "primary_message": "Peel and mince the garlic and ginger. In a large bowl, prepare dressing by whisking together the minced garlic and ginger, almond butter, soy sauce, water, vinegar, curry, and pepper.",
      "secondary_message": "3 cloves garlic\n3 (1 inch) pieces ginger root\n9 tbsp natural almond butter\n6 tbsp soy sauce\n6 tbsp warm water\n1 ½ tbsp rice vinegar\n1 ½ tsp curry powder\n⅜ tsp crushed red pepper"
    },
    {
      "id": 61838,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Add to bowl with dressing.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 61837,
      "primary_message": "Add broccoli slaw to bowl.",
      "secondary_message": "3 (12 oz) pkg broccoli slaw mix"
    },
    {
      "id": 61836,
      "primary_message": "Wash and dry bell peppers and green onions. Seed, julienne (cut into thin sticks), and add peppers to bowl. Trim and discard root ends, chop onions, and add to bowl.",
      "secondary_message": "3 red bell peppers\n1 ½ small bunches green onions"
    },
    {
      "id": 61835,
      "primary_message": "Toss salad until coated with dressing.",
      "secondary_message": ""
    },
    {
      "id": 61834,
      "primary_message": "To serve, place salad in a bowl or on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
