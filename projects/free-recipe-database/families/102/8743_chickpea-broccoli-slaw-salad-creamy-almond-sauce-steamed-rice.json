  "instructions": [
    {
      "id": 134769,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n236 ml (1 cup) water\n¼ tsp salt"
    },
    {
      "id": 134802,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 134274,
      "primary_message": "Peel and mince the garlic and ginger. In a large bowl, prepare dressing by whisking together the minced garlic and ginger, almond butter, soy sauce, water, vinegar, curry, and pepper.",
      "secondary_message": "1 clove garlic\n1 (2 ½ cm) piece ginger root\n3 tbsp natural almond butter\n2 tbsp soy sauce\n2 tbsp warm water\n½ tbsp rice vinegar\n½ tsp curry powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 134275,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Add to bowl with dressing.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 134276,
      "primary_message": "Add broccoli slaw to bowl.",
      "secondary_message": "1 (340 g) pkg broccoli slaw mix"
    },
    {
      "id": 134277,
      "primary_message": "Wash and dry bell pepper and green onions. Seed, julienne (cut into thin sticks), and add pepper to bowl. Trim and discard root ends, chop onions, and add to bowl.",
      "secondary_message": "1 red bell pepper\r\n½ small bunch green onions"
    },
    {
      "id": 134278,
      "primary_message": "Toss salad until coated with dressing.",
      "secondary_message": ""
    },
    {
      "id": 134279,
      "primary_message": "To serve, divide rice and salad between plates or bowls. Enjoy!",
      "secondary_message": ""
    }
  ],
