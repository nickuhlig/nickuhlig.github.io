  "instructions": [
    {
      "id": 134781,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n708 ml (3 cups) water\n¾ tsp salt"
    },
    {
      "id": 134794,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 134758,
      "primary_message": "Peel and mince the garlic and ginger. In a large bowl, prepare dressing by whisking together the minced garlic and ginger, peanut butter, soy sauce, water, vinegar, curry, and pepper.",
      "secondary_message": "3 cloves garlic\n3 (2 ½ cm) pieces ginger root\n9 tbsp natural peanut butter\n6 tbsp soy sauce\n6 tbsp warm water\n1 ½ tbsp rice vinegar\n1 ½ tsp curry powder\n⅜ tsp crushed red pepper"
    },
    {
      "id": 134759,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Add to bowl with dressing.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 134760,
      "primary_message": "Add broccoli slaw to bowl.",
      "secondary_message": "3 (340 g) pkg broccoli slaw mix"
    },
    {
      "id": 134761,
      "primary_message": "Wash and dry bell peppers and green onions. Seed, julienne (cut into thin sticks), and add peppers to bowl. Trim and discard root ends, chop onions, and add to bowl.",
      "secondary_message": "3 red bell peppers\n1 ½ small bunches green onions"
    },
    {
      "id": 134762,
      "primary_message": "Toss salad until coated with dressing.",
      "secondary_message": ""
    },
    {
      "id": 134763,
      "primary_message": "To serve, divide rice and salad between plates or bowls. Enjoy!",
      "secondary_message": ""
    }
  ],
