  "instructions": [
    {
      "id": 6201,
      "primary_message": "Peel and mince the garlic and ginger. In a large bowl, prepare dressing by whisking together the minced garlic and ginger, peanut butter, soy sauce, water, vinegar, curry, and pepper.",
      "secondary_message": "1 clove garlic\n1 (2 ½ cm) piece ginger root\n3 tbsp natural peanut butter\n2 tbsp soy sauce\n2 tbsp warm water\n½ tbsp rice vinegar\n½ tsp curry powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 6202,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Add to bowl with dressing.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 6203,
      "primary_message": "Add broccoli slaw to bowl.",
      "secondary_message": "1 (340 g) pkg broccoli slaw mix"
    },
    {
      "id": 6204,
      "primary_message": "Wash and dry bell pepper and green onions. Seed, julienne (cut into thin sticks), and add pepper to bowl. Trim and discard root ends, chop onions, and add to bowl.",
      "secondary_message": "1 red bell pepper\r\n½ small bunch green onions"
    },
    {
      "id": 15120,
      "primary_message": "Toss salad until coated with dressing.",
      "secondary_message": ""
    },
    {
      "id": 6205,
      "primary_message": "To serve, place salad in a bowl or on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
