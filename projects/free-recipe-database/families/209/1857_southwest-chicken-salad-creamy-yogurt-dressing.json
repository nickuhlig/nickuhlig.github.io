  "instructions": [
    {
      "id": 16993,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": ""
    },
    {
      "id": 16994,
      "primary_message": "Cut tortillas into thin strips and place on a baking sheet pan. Drizzle with olive oil and season with salt and pepper. Toss to coat, then spread out in a single layer.",
      "secondary_message": "4 small corn tortillas\n2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 16995,
      "primary_message": "Place in the oven and bake until golden and crispy, 10-12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 16996,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 16997,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "0.454 kg chicken breasts, boneless skinless\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 16998,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until cooked through, 2-3 minutes per side.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 16999,
      "primary_message": "In a small bowl, prepare dressing by whisking together yogurt, salt, chili powder, garlic powder, pepper, cumin, and paprika.",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp salt\n½ tsp chili powder\n½ tsp garlic powder\n¼ tsp black pepper\n¼ tsp cumin\n¼ tsp paprika"
    },
    {
      "id": 17000,
      "primary_message": "Remove husks and silks from corn. Stand up vertically in the middle of a large bowl and slice kernels off the cob.",
      "secondary_message": "2 ears corn"
    },
    {
      "id": 17001,
      "primary_message": "Wash and dry lettuce, bell peppers, tomatoes, and green onions. Chop lettuce crosswise into 2 ½ cm strips and transfer to the bowl with corn. Seed, medium dice, and add bell peppers to bowl. Medium dice and add tomatoes to bowl. Trim and discard root ends, chop onions, and add to bowl. Halve and pit avocados; scoop out and medium dice the flesh and add to bowl.",
      "secondary_message": "1 head romaine lettuce\n2 red bell peppers\n2 tomatoes\n1 small bunch green onions (scallions)\n2 avocados"
    },
    {
      "id": 17002,
      "primary_message": "Drain and rinse beans. Place on paper towels and pat dry. Add to bowl.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 17003,
      "primary_message": "Add tortillas strips to bowl and pour dressing over top. Toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 17004,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 17005,
      "primary_message": "To serve, place salad on a plate and top with chicken slices. Enjoy!",
      "secondary_message": ""
    }
  ],
