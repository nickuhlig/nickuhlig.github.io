  "instructions": [
    {
      "id": 16967,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": ""
    },
    {
      "id": 16968,
      "primary_message": "Cut tortillas into thin strips and place on a baking sheet pan. Drizzle with olive oil and season with salt and pepper. Toss to coat, then spread out in a single layer.",
      "secondary_message": "2 small corn tortillas\n1 tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 16969,
      "primary_message": "Place in the oven and bake until golden and crispy, 10-12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 16970,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 16971,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "0.227 kg chicken breasts, boneless skinless\r\n1 pinch salt\r\n1 pinch black pepper"
    },
    {
      "id": 16972,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until cooked through, 2-3 minutes per side.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 16973,
      "primary_message": "In a small bowl, prepare dressing by whisking together yogurt, salt, chili powder, garlic powder, pepper, cumin, and paprika.",
      "secondary_message": "¼ cup plain Greek yogurt\n¼ tsp salt\n¼ chili powder\n¼ tsp garlic powder\n⅛ tsp black pepper\n⅛ tsp cumin\n⅛ tsp paprika"
    },
    {
      "id": 16974,
      "primary_message": "Remove husks and silks from corn. Stand up vertically in the middle of a large bowl and slice kernels off the cob.",
      "secondary_message": "1 ear corn"
    },
    {
      "id": 16975,
      "primary_message": "Wash and dry lettuce, bell pepper, tomato, and green onions. Chop lettuce crosswise into 2 ½ cm strips and transfer to the bowl with corn. Seed, medium dice, and add bell pepper to bowl. Medium dice and add tomato to bowl. Trim and discard root ends, chop onions, and add to bowl. Halve and pit avocado; scoop out and medium dice the flesh and add to bowl.",
      "secondary_message": "½ head romaine lettuce\n1 red bell pepper\n1 tomato\n½ small bunch green onions (scallions)\n1 avocado"
    },
    {
      "id": 16976,
      "primary_message": "Drain and rinse beans. Place on paper towels and pat dry. Add to bowl.",
      "secondary_message": "½ (398 ml) can black beans"
    },
    {
      "id": 16977,
      "primary_message": "Add tortillas strips to bowl and pour dressing over top. Toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 16978,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 16979,
      "primary_message": "To serve, place salad on a plate and top with chicken slices. Enjoy!",
      "secondary_message": ""
    }
  ],
