  "instructions": [
    {
      "id": 413334,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ small bunch cilantro\n1 lime\n1 (227 g) pkg sugar snap peas\n1 mango\n½ avocado"
    },
    {
      "id": 413335,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl along with soy sauce, water, honey, chili-garlic sauce, cornstarch, and oil. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n2 tbsp soy sauce\n2 tsp water\n2 tsp honey\n1 ½ tsp chili-garlic sauce\n1 tsp cornstarch\n1 tsp toasted sesame oil"
    },
    {
      "id": 413336,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 413337,
      "primary_message": "Add shrimp to the bowl with the marinade, stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 413338,
      "primary_message": "Peel and mince shallot. Place in another medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 413339,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the shallot. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 413340,
      "primary_message": "Juice lime into the bowl.",
      "secondary_message": null
    },
    {
      "id": 413341,
      "primary_message": "Cut snap peas crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 413342,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 413343,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl along with salt and pepper. Gently stir to combine the salad and set aside. ",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 413344,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 413345,
      "primary_message": "Once the skillet is hot, add shrimp and marinade. Cook, stirring occasionally, until shrimp are opaque and sauce has thickened, about 3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 413346,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 413347,
      "primary_message": "Divide tortillas between plates; fill with a small portion of salad, shrimp, and reserved cilantro. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
