  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the lemons into wedges.",
      "secondary_message": "2 lemons"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, combine the chopped herbs, salt, and pepper. Add enough olive oil to turn the mixture into a loose paste, about 2 tablespoons. Carefully separate the skin of each thigh from the meat, taking care not to tear it completely off, and slip 1 bay leaf under each. Then, spoon in the herb paste, taking care to avoid getting too much on the outside of the skin. Season the outside of the chicken with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Set cooking grate in place, cover grill, and allow to preheat for 5 minutes. Alternatively, set half the burners on a gas grill to the highest heat setting, cover, and preheat for 10 minutes. Clean and oil the grilling grate.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place the chicken skin-side up on the cooler side of the grill and cook until the fat has begun to render, about 5 minutes. Turn the chicken over and cook for 20 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Move the chicken (still skin-side down) to the hot part of the grill and cook until the skin is crisp and the meat is cooked through. Serve the chicken immediately with lemon wedges.",
      "secondary_message": null
    }
  ],
