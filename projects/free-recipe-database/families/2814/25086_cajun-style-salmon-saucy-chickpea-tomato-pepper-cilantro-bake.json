  "instructions": [
    {
      "id": 402916,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 402917,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 yellow bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 402918,
      "primary_message": "Trim, seed, and small dice bell peppers. Divide between two large baking dishes. ",
      "secondary_message": null
    },
    {
      "id": 402919,
      "primary_message": "Drain and rinse chickpeas. Add to the baking dishes with the bell peppers along with marinara sauce, water, and spices; stir to combine.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n1 ½ (24 oz) jars marinara sauce\n½ cup water\n2 tbsp Cajun seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 402920,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until peppers and chickpeas are tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 402921,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 402922,
      "primary_message": "While the skillet heats up, pat salmon dry with paper towels and place, skin-side down, on a plate. Season the top side of the salmon with spices.",
      "secondary_message": "2 ¼ lb salmon fillet\n1 ½ tsp Cajun seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 402923,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 402924,
      "primary_message": "While the salmon is cooking, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 402925,
      "primary_message": "When the peppers and chickpeas are done, remove from the oven. Add cilantro and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 402926,
      "primary_message": "To serve, divide saucy chickpeas and salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
