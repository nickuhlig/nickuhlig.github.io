  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Place almonds and apricots in the small compartments of the bento box.",
      "secondary_message": "⅓ cup almonds, honey roasted\n⅓ cup dried apricot"
    },
    {
      "primary_message": "Wash and dry celery. Fill the inside groove of the celery with cheese spread, then cut crosswise into bite-sized pieces. Place in the medium compartment of the bento box.",
      "secondary_message": "1 stick celery\n3 tbsp cheddar cheese spread"
    },
    {
      "primary_message": "Cut cheese into thin slices. Place cheese, pepperoni, crackers, and mandarin in the large compartment of the bento box.",
      "secondary_message": "2 oz mozzarella cheese\n1 ½ oz pepperoni\n1 mini sleeve ritz crackers\n1 mandarin"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
