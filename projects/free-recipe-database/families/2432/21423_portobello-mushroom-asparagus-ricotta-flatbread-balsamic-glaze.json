  "instructions": [
    {
      "id": 401108,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 401109,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, 8-10 minutes. Remove from oven and set aside.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 401110,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 caps portobello mushrooms\n3 small bunches asparagus\n1 small pkg fresh basil"
    },
    {
      "id": 401111,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 401112,
      "primary_message": "Remove mushroom stems, then slice caps into thin strips. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 401113,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears crosswise into 1-inch pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 401114,
      "primary_message": "Add oil and spices to the bowl; toss to coat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 401115,
      "primary_message": "Using tongs, transfer the crisp flatbreads to a plate, stacking them one on top of another. Set aside. (Reserve baking sheets for the next step.)",
      "secondary_message": null
    },
    {
      "id": 401116,
      "primary_message": "Line the reserved baking sheets with aluminum foil. Divide seasoned veggies between the baking sheets, spreading them out in an even layer. Place veggies in the oven and bake, stirring halfway through until veggies are tender, about 15 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 401117,
      "primary_message": "While the veggies are baking, place vinegar in a small saucepan and bring to a boil over medium-high heat. Once boiling, reduce heat to medium-low and simmer until reduced by half, 5-6 minutes. Remove from heat and set aside.",
      "secondary_message": "¾ cup balsamic vinegar"
    },
    {
      "id": 401118,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place half of the basil in a medium bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 401119,
      "primary_message": "Add ricotta, salt, and pepper to the bowl with the basil; stir to combine.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 401120,
      "primary_message": "When the veggies are done, return them to the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 401121,
      "primary_message": "Remove aluminum foil from the baking sheets and discard. Return flatbreads to the baking sheets, arranging them in a single layer. Spread ricotta over each flatbread and top with the roasted veggies. Return to the oven and bake until warmed through, 5-6 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 401122,
      "primary_message": "To serve, slice flatbreads and divide between plates. Drizzle with balsamic glaze, top with reserved basil, and enjoy!",
      "secondary_message": null
    }
  ],
