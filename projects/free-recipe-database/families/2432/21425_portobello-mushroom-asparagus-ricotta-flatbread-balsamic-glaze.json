  "instructions": [
    {
      "id": 401136,
      "primary_message": "Preheat oven to 230°C (450°F). Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 401137,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 caps portobello mushrooms\n2 small bunches asparagus\n1 small pkg fresh basil"
    },
    {
      "id": 401138,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 401139,
      "primary_message": "Remove mushroom stems, then slice caps into thin strips. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 401140,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears crosswise into 1-inch pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 401141,
      "primary_message": "Add oil and spices to the bowl; toss to coat. Transfer veggies to a large baking sheet pan and spread out in an even layer. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 401142,
      "primary_message": "Place baking sheet on upper rack of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 401143,
      "primary_message": "Meanwhile, arrange flatbreads on another large baking sheet. Place on the lower rack and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from oven and set aside.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 401144,
      "primary_message": "While flatbreads are toasting, place vinegar in a small saucepan and bring to a boil over medium-high heat. Once boiling, reduce heat to medium-low and simmer until reduced by half, about 5 minutes. Remove from heat and set aside.",
      "secondary_message": "½ cup balsamic vinegar"
    },
    {
      "id": 401145,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place half of the basil in a small bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 401146,
      "primary_message": "Add ricotta, salt, and pepper to the bowl with the basil; stir to combine.",
      "secondary_message": "1 (425 g) pkg ricotta cheese\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 401147,
      "primary_message": "To assemble the flatbreads, spread ricotta over each flatbread and top with roasted veggies. Return to oven and bake until warmed through, 4-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 401148,
      "primary_message": "To serve, slice flatbreads and divide between plates. Drizzle with balsamic glaze, top with reserved basil, and enjoy!",
      "secondary_message": null
    }
  ],
