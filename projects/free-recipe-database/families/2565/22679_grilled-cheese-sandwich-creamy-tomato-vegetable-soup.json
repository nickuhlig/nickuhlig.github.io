  "instructions": [
    {
      "id": 470403,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 470404,
      "primary_message": "While the pot heats up, wash, dry, trim, and thinly slice celery crosswise.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 470405,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom; add celery and carrots. Cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n1 (10 oz) bag shredded carrots"
    },
    {
      "id": 470406,
      "primary_message": "Add broth, marinara sauce, and salt to the pot; stir to combine the soup and bring to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until flavors blend, 8-10 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 (24 oz) jar marinara sauce\n½ tsp salt"
    },
    {
      "id": 470407,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470408,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Top half of the slices with cheese. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "8 slices whole grain bread\n1 cup shredded cheese, Italian blend"
    },
    {
      "id": 470409,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 470410,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Transfer to a cutting board and slice in half.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 470411,
      "primary_message": "When the soup is done, add cream and stir to combine. Remove from heat.",
      "secondary_message": "8 fl oz (1 cup) heavy whipping cream"
    },
    {
      "id": 470412,
      "primary_message": "Divide the soup between bowls and serve with sandwiches on the side. Enjoy!",
      "secondary_message": null
    }
  ],
