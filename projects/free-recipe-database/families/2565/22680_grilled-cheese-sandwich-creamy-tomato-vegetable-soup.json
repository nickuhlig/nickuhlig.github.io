  "instructions": [
    {
      "id": 470413,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 470414,
      "primary_message": "While the pot heats up, wash, dry, trim, and thinly slice celery crosswise.",
      "secondary_message": "3 sticks celery"
    },
    {
      "id": 470415,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom; add celery and carrots. Cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 470416,
      "primary_message": "Add broth, marinara sauce, and salt to the pot; stir to combine the soup and bring to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until flavors blend, 10-12 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 ½ (24 oz) jars marinara sauce\n¾ tsp salt"
    },
    {
      "id": 470417,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470418,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Top half of the slices with cheese. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "12 slices whole grain bread\n1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 470419,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 470420,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Transfer to a cutting board and slice in half.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 470421,
      "primary_message": "When the soup is done, add cream and stir to combine. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 470422,
      "primary_message": "Divide the soup between bowls and serve with sandwiches on the side. Enjoy!",
      "secondary_message": null
    }
  ],
