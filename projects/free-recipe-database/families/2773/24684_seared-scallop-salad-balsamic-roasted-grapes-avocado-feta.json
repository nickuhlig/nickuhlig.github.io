  "instructions": [
    {
      "id": 398550,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 398551,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lb red grapes\n1 ½ English cucumbers\n3 avocados\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 398552,
      "primary_message": "Divide grapes between two large baking dishes; drizzle with oil and vinegar, then season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n3 pinch salt"
    },
    {
      "id": 398553,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and roast until grapes begin to swell, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 398554,
      "primary_message": "Meanwhile, peel and mince shallots. Place in a large bowl along with oil, vinegar, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 shallots\n3 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 398555,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 398556,
      "primary_message": "Pat scallops dry with paper towels and place on a large plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb sea scallops\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 398557,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398558,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add scallops in a single layer and cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 398559,
      "primary_message": "When the grapes are done, remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 398560,
      "primary_message": "While the grapes are cooling, halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl with the dressing along with the mixed greens and feta; toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 398561,
      "primary_message": "To serve, divide salad between plates or bowls; top with grapes and scallops. Enjoy!",
      "secondary_message": null
    }
  ],
