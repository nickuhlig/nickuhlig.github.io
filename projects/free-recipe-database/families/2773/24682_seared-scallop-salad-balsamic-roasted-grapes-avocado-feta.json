  "instructions": [
    {
      "id": 398526,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 398527,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lb red grapes\n½ English cucumber\n1 avocado\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 398528,
      "primary_message": "Transfer grapes to a baking dish; drizzle with oil and vinegar, then season with salt. Toss to coat and spread out in an even layer. ",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n1 pinch salt"
    },
    {
      "id": 398529,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until grapes begin to swell, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 398530,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl along with oil, vinegar, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 398531,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 398532,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398533,
      "primary_message": "While the skillet heats up, pat scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb sea scallops\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 398534,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add scallops in a single layer and cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 398535,
      "primary_message": "When the grapes are done, remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 398536,
      "primary_message": "While the grapes are cooling, halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl with the dressing along with the mixed greens and feta; toss to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 398537,
      "primary_message": "To serve, divide salad between plates or bowls; top with grapes and scallops. Enjoy!",
      "secondary_message": null
    }
  ],
