  "instructions": [
    {
      "id": 512858,
      "primary_message": "Preheat the oven to 500°F and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 512859,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium spaghetti squash\n½ lb cremini mushrooms\n½ bunch kale\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 512860,
      "primary_message": "Trim spaghetti squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 512861,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 512862,
      "primary_message": "Meanwhile, thinly slice mushrooms; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 512863,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 512864,
      "primary_message": "While the skillet heats up, peel and mince garlic; add to the bowl with the mushrooms.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 512865,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n1 tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 512866,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 512867,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the kale (reserving a small handful of parsley for garnish).",
      "secondary_message": null
    },
    {
      "id": 512868,
      "primary_message": "When the veggie ground is done, add kale and parsley to the skillet in handfuls, waiting for the greens to wilt slightly before adding the next handful. Cook, stirring frequently, until kale is tender, 3-4 minutes. Transfer veggie ground-greens mixture back to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 512869,
      "primary_message": "Coarsely grate cheese. Add cheese to the bowl with the veggie ground mixture (reserving a small handful for serving).",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 512870,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 512871,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands (use an oven mitt or towel to hold it with your other hand). Add to the bowl with the veggie ground mixture, then toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 512872,
      "primary_message": "To serve, divide the veggie ground, greens, and spaghetti squash mixture between plates or bowls. Top with reserved cheese and parsley. Enjoy!",
      "secondary_message": null
    }
  ],
