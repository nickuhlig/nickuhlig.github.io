  "instructions": [
    {
      "id": 512888,
      "primary_message": "Preheat the oven to 500°F and place rack in the center position. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 512889,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium spaghetti squash\n1 ½ lb cremini mushrooms\n1 ½ bunches kale\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 512890,
      "primary_message": "Trim each spaghetti squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheets.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 512891,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 512892,
      "primary_message": "Meanwhile, thinly slice mushrooms; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 512893,
      "primary_message": "Peel and mince garlic; add to the bowl with the mushrooms.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 512894,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 512895,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 512896,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 512897,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the kale (reserving a small handful of parsley for serving).",
      "secondary_message": null
    },
    {
      "id": 512898,
      "primary_message": "When the veggie ground is done, add kale and parsley to the pot in handfuls, waiting for the greens to wilt slightly before adding the next handful. Cook, stirring frequently, until kale is tender, 4-5 minutes. Transfer veggie ground-greens mixture back to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 512899,
      "primary_message": "Coarsely grate cheese. Add cheese to the bowl with the veggie ground mixture (reserving a small handful for serving).",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 512900,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 512901,
      "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands (use an oven mitt or towel to hold it with your other hand). Add to the bowl with the veggie ground mixture, then toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 512902,
      "primary_message": "To serve, divide the veggie ground, greens, and spaghetti squash mixture between plates or bowls. Top with reserved cheese and parsley. Enjoy!",
      "secondary_message": null
    }
  ],
