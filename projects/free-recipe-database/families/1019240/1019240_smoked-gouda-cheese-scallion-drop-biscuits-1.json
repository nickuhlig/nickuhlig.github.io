  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and cut scallions crosswise into thin pieces. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Small dice cheese. Add to the bowl with the scallions and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place flour, baking powder, salt, and pepper in a large bowl, then stir to combine.\n",
      "secondary_message": "2 cups all-purpose flour\n1 tbsp baking powder\n¾ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Using a box grater, coarsely grate cold butter into the bowl with the flour. Using two hands, combine the flour and butter by rubbing the mixture between your thumbs and fingers until it looks crumbly. ",
      "secondary_message": "8 tbsp butter, unsalted"
    },
    {
      "primary_message": "Add scallions, cheese, and milk to the bowl. Stir until just combined.",
      "secondary_message": "8 fl oz whole milk"
    },
    {
      "primary_message": "Using a 1/3-cup measure (or a standard ice cream scoop), drop portions of batter onto the baking sheet, spacing them 2-inches apart. Place in the oven and bake until biscuits are lightly golden, about 18 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place additional butter in a small saucepan and melt over low heat; set aside.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "primary_message": "When the biscuits are done, remove from oven and immediately brush the tops with melted butter.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer biscuits to a serving platter and enjoy warm!",
      "secondary_message": null
    }
  ],
