  "instructions": [
    {
      "id": 311919,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 311920,
      "primary_message": "Wash and dry sweet potatoes, then peel and large dice; place on a baking sheet pan, drizzle with oil, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 ½ lb sweet potatoes\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper\n½ tsp cinnamon, ground"
    },
    {
      "id": 311921,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until sweet potatoes are fork tender about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 311922,
      "primary_message": "Meanwhile, peel and mince garlic; mince dates. Place both in a small bowl along with oil and spices; stir to combine the date topping and set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup medjool dates, pitted\n1 tbsp extra virgin olive oil\n¾ tsp cinnamon, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 311923,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 311924,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 311925,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add chops and cook until golden, about 2 minutes per side. Once golden, transfer to another baking sheet (the pork will not be cooked all the way through). Reserve skillet with juices for later use.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 311926,
      "primary_message": "Divide date topping between chops and layer each with two slices of prosciutto.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 311927,
      "primary_message": "Add layered chops to the oven and roast until cooked through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 311928,
      "primary_message": "Meanwhile, wash, dry, and trim green beans.",
      "secondary_message": "1 ½ lb green beans"
    },
    {
      "id": 311929,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 311930,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom; add beans and salt. Stir-fry until lightly charred and fork-tender, about 5 minutes. Add garlic and continue to cook, stirring constantly, until fragrant, about 30 seconds; remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 311931,
      "primary_message": "To serve, divide layered pork chops, sweet potatoes, and green beans between plates. Enjoy!",
      "secondary_message": null
    }
  ],
