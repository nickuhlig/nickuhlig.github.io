  "instructions": [
    {
      "id": 312021,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 312022,
      "primary_message": "Peel and mince garlic; mince dates. Place both in a small bowl along with oil and spices; stir to combine the date topping and set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup medjool dates, pitted\n1 tbsp extra virgin olive oil\n¾ tsp cinnamon, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 312023,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 312024,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 312025,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add chops and cook until golden, about 2 minutes per side. Once golden, transfer to a large baking dish (the pork will not be cooked all the way through). Reserve skillet with juices for later use.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 312026,
      "primary_message": "Divide date topping between chops and layer each with two slices of prosciutto. Place in the oven (it doesn't have to be fully heated) and bake until prosciutto is golden and chops are cooked through, about 10 minutes. Remove from oven.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 312027,
      "primary_message": "Meanwhile, wash, dry, and trim green beans.",
      "secondary_message": "1.02 kg green beans"
    },
    {
      "id": 312028,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 312029,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom; add beans and salt. Stir-fry until lightly charred and fork-tender, about 5 minutes. Add garlic and continue to cook, stirring constantly, until fragrant, about 30 seconds; remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 312030,
      "primary_message": "To serve, divide layered pork chops and green beans between plates. Enjoy!",
      "secondary_message": null
    }
  ],
