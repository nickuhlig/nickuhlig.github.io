  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly tear the hearty bread into 1-inch pieces. Mince the garlic. Finely grate the Parmigiano-Reggiano. Finely slice the white onion.",
      "secondary_message": "142 g hearty bread\n1 medium clove garlic\n43 g Parmigiano-Reggiano\n1 small white onion"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 180°C (350°F). In a large bowl, massage kale with 3 tablespoons olive oil, making sure to coat all surfaces, kneading with your hands to help break down the tougher pieces, about 2 minutes. Set aside while you prepare the croutons and the dressing.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine bread pieces with remaining olive oil in the bowl of a food processor. Pulse until broken down into pea-sized pieces. Season to taste with salt and pepper and pulse once or twice to combine. Transfer to a rimmed baking sheet. Place in oven and bake until croutons are pale golden brown and crisp, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Wipe out food processor bowl. Combine mayonnaise, anchovies, garlic, cheese, Worcestershire sauce, and lemon juice in the food processor bowl and process until smooth. Season to taste with salt and pepper if necessary.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When croutons are cooked, add onions, dressing, and half of croutons to large bowl with wilted kale. Toss with hands until thoroughly coated. Serve sprinkled with remaining croutons.",
      "secondary_message": null
    }
  ],
