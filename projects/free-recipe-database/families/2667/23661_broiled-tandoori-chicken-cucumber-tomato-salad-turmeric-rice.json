  "instructions": [
    {
      "id": 386581,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and turmeric, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth\n¾ tsp turmeric, ground"
    },
    {
      "id": 386582,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n3 (1 inch) pieces ginger root\n3 pints grape tomatoes\n1 ½ English cucumbers\n1 ½ bunches radish\n1 small bunch cilantro"
    },
    {
      "id": 386583,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 386584,
      "primary_message": "While the rice is cooking, preheat oven to broil on high and position rack in the upper third of the oven. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 386585,
      "primary_message": "Juice limes and divide between two large bowls. Set one bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "id": 386586,
      "primary_message": "Peel and mince ginger and garlic. Add both to the remaining bowl with the lime juice along with yogurt and spices. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n1 ½ cups plain Greek yogurt\n1 ½ tbsp garam masala\n1 tbsp paprika\n1 ½ tsp turmeric, ground\n¾ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 386587,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Add to the bowl with the marinade and turn to coat. Transfer chicken to the baking sheet and arrange in a single layer (spread with any leftover marinade in bowl).",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 386588,
      "primary_message": "Place baking sheet in the oven and broil the chicken, flipping halfway through, until cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 386589,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallots. Add to the second large bowl with the lime juice along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 386590,
      "primary_message": "Halve tomatoes crosswise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 386591,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386592,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386593,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl and stir to combine the salad. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 386594,
      "primary_message": "To serve, divide the rice, chicken, and salad between plates. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
