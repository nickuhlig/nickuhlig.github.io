  "instructions": [
    {
      "id": 386553,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and turmeric, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n8 fl oz (1 cup) chicken or vegetable broth\n¼ tsp turmeric, ground"
    },
    {
      "id": 386554,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 (1 inch) piece ginger root\n1 pint grape tomatoes\n½ English cucumber\n½ bunch radish\n½ small bunch cilantro"
    },
    {
      "id": 386555,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 386556,
      "primary_message": "While the rice is cooking, preheat oven to broil on high and position rack in the upper third of the oven. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 386557,
      "primary_message": "Juice lime and divide between two medium bowls. Set one bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "id": 386558,
      "primary_message": "Peel and mince ginger and garlic. Add both to the remaining bowl with the lime juice along with yogurt and spices. Whisk to combine the marinade.",
      "secondary_message": "1 clove garlic\n½ cup plain Greek yogurt\n1 ½ tsp garam masala\n1 tsp paprika\n½ tsp turmeric, ground\n¼ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 386559,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Add to the bowl with the marinade and turn to coat. Transfer chicken to the baking sheet and arrange in a single layer (spread with any leftover marinade in bowl).",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 386560,
      "primary_message": "Place baking sheet in the oven and broil the chicken, flipping halfway through, until cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 386561,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Add to the second medium bowl with the lime juice along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 386562,
      "primary_message": "Halve tomatoes crosswise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 386563,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386564,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 386565,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl and stir to combine the salad. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 386566,
      "primary_message": "To serve, divide the rice, chicken, and salad between plates. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
