  "instructions": [
    {
      "id": 1,
      "primary_message": "Clip the toenails from the chicken feet and wash the feet, removing calluses and any loose-hanging skin.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place the chicken feet in a 2-quart sauté pan and add enough water to cover. Add all simmering ingredients to pan and bring water to a boil, then reduce to a simmer and cook until feet are tender, 1 1/2 to 2 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove feet from cooking liquid, which can be reserved for another purpose. Allow feet to cool.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Whisk eggs and flour/salt mixture in a medium bowl. Dip feet into batter, shaking off excess flour. If needed, dip the feet twice, to ensure they're fully coated.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "In a wok, bring 900 ml oil to 190°C. Add feet in batches and deep-fry until batter is golden brown, 3 to 5 minutes. Have a lid ready in the event of splattering oil. Serve immediately, adding a sprinkling of sea salt if needed.",
      "secondary_message": null
    }
  ],
