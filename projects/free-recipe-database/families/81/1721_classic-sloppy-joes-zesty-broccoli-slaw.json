  "instructions": [
    {
      "id": 15544,
      "primary_message": "Peel and small dice onion. Wash, seed, and small dice bell pepper. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\r\n1 red bell pepper\r\n1 clove garlic"
    },
    {
      "id": 15545,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 15546,
      "primary_message": "Coat bottom of skillet with oil. Add onion and pepper. Stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 15547,
      "primary_message": "Add beef and garlic. Breaking apart with a spoon, cook until meat is browned and crumbly, 2-3 minutes.",
      "secondary_message": "0.34 kg lean ground beef"
    },
    {
      "id": 15548,
      "primary_message": "Add tomato sauce, vinegar, honey, soy sauce, Dijon, chili powder, salt, and pepper. Stirring occasionally, reduce heat to low and simmer until sauce thickens, 10-15 minutes.",
      "secondary_message": "1 (213 ml) can tomato sauce\r\n½ tbsp red wine vinegar\r\n½ tbsp honey\r\n½ tbsp soy sauce\r\n½ tsp Dijon mustard\r\n½ tsp chili powder\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 15549,
      "primary_message": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together garlic, olive oil, vinegar, Dijon, honey, salt, and pepper.",
      "secondary_message": "1 clove garlic\r\n1 ½ tbsp extra virgin olive oil\r\n½ tbsp red wine vinegar\r\n1 tsp Dijon mustard\r\n1 tsp honey\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 15550,
      "primary_message": "Add broccoli slaw to bowl with dressing and toss to coat.",
      "secondary_message": "½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 15551,
      "primary_message": "Toast buns or rolls if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 15552,
      "primary_message": "To serve, fill buns or rolls with sloppy joe mixture and enjoy with broccoli slaw on the side!",
      "secondary_message": ""
    }
  ],
