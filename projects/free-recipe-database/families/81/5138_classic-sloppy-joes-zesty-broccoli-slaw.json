  "instructions": [
    {
      "id": 62019,
      "primary_message": "Peel and small dice onions. Wash, seed, and small dice bell peppers. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onion\n3 red bell peppers\n3 cloves garlic"
    },
    {
      "id": 62018,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 62012,
      "primary_message": "Coat bottom of skillet with oil. Add onion and peppers. Stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 62017,
      "primary_message": "Add beef and garlic. Breaking apart with a spoon, cook until meat is browned and crumbly, 2-3 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef"
    },
    {
      "id": 62011,
      "primary_message": "Add tomato sauce, vinegar, honey, soy sauce, Dijon, chili powder, salt, and pepper. Stirring occasionally, reduce heat to low and simmer until sauce thickens, 10-15 minutes.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 ½ tbsp red wine vinegar\n1 ½ tbsp honey\n1 ½ tbsp soy sauce\n1 ½ tsp Dijon mustard\n1 ½ tsp chili powder\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 62016,
      "primary_message": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together garlic, olive oil, vinegar, Dijon, honey, salt, and pepper.",
      "secondary_message": "3 cloves garlic\n4 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n3 tsp Dijon mustard\n3 tsp honey\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 62015,
      "primary_message": "Add broccoli slaw to bowl with dressing and toss to coat.",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 62014,
      "primary_message": "Toast buns or rolls if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 62013,
      "primary_message": "To serve, fill buns or rolls with sloppy joe mixture and enjoy with broccoli slaw on the side!",
      "secondary_message": ""
    }
  ],
