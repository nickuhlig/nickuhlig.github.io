  "instructions": [
    {
      "id": 455372,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch fresh dill\n1 lemon\n4 sticks celery\n1 bunch radish\n1 (5 oz) pkg spring mix (mixed greens)\n1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 455373,
      "primary_message": "Cut cream cheese into small pieces. Place in a small bowl.",
      "secondary_message": "1 (8 oz) block cream cheese"
    },
    {
      "id": 455374,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the cream cheese. Place remaining dill in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 455375,
      "primary_message": "Zest lemon into the bowl with the cream cheese, then season with salt and pepper. Using the back of a spoon, mash and combine the dill cream cheese. Set aside. (Reserve lemon for the next step.)",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 455376,
      "primary_message": "Juice reserved lemon into the medium bowl with the dill.",
      "secondary_message": null
    },
    {
      "id": 455377,
      "primary_message": "Peel and mince shallot. Add to the bowl along with oil, honey, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 455378,
      "primary_message": "Trim and thinly slice celery crosswise. Add to bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 455379,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 455380,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the bowl, along with the mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 455381,
      "primary_message": "Lay tortillas on a flat surface. Divide cream cheese between them and spread out in an even layer. ",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 455382,
      "primary_message": "Divide smoked salmon, sprouts, and capers between the tortillas. Top with a small portion of the salad and roll tightly to close. (Reserve remaining salad for serving.)",
      "secondary_message": "2 (4 oz) pkgs smoked salmon\n2 tbsp capers"
    },
    {
      "id": 455383,
      "primary_message": "Cut wraps in half and divide between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
