  "instructions": [
    {
      "id": 455420,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch fresh dill\n1 ½ lemons\n6 sticks celery\n1 ½ bunches radish\n1 ½ (142 g) pkgs spring mix (mixed greens)\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 455421,
      "primary_message": "Cut cream cheese into small pieces. Place in a medium bowl.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 455422,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the cream cheese. Place remaining dill in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 455423,
      "primary_message": "Zest lemons into the bowl with the cream cheese, then season with salt and pepper. Using the back of a spoon, mash and combine the dill cream cheese. Set aside. (Reserve lemons for the next step.)",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 455424,
      "primary_message": "Juice reserved lemons into the large bowl with the dill.",
      "secondary_message": null
    },
    {
      "id": 455425,
      "primary_message": "Peel and mince shallots. Add to the bowl along with oil, honey, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "1 shallot\n3 tbsp extra virgin olive oil\n1 tbsp honey\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 455426,
      "primary_message": "Trim and thinly slice celery crosswise. Add to bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 455427,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 455428,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the bowl, along with the mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 455429,
      "primary_message": "Lay tortillas on a flat surface. Divide cream cheese between them and spread out in an even layer. ",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 455430,
      "primary_message": "Divide smoked salmon, sprouts, and capers between the tortillas. Top with a small portion of the salad and roll tightly to close. (Reserve remaining salad for serving.)",
      "secondary_message": "3 (113 g) pkgs smoked salmon\n3 tbsp capers"
    },
    {
      "id": 455431,
      "primary_message": "Cut wraps in half and divide between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
