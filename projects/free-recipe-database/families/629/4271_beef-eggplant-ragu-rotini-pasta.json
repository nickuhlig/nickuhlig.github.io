  "instructions": [
    {
      "id": 48067,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 48068,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n1 small pkg fresh basil"
    },
    {
      "id": 48069,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 48070,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the eggplants; medium dice the eggplants into ½-inch cubes and transfer to a bowl.",
      "secondary_message": null
    },
    {
      "id": 48071,
      "primary_message": "Once the skillet is hot, add the ground beef; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer to a bowl, leaving the juices in the saucepan.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 48072,
      "primary_message": "When the water in the pot comes to a boil, uncover the pot and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions). Drain the pasta in a colander, reserving 1 cup of the cooking water.",
      "secondary_message": "2 tbsp salt\n8 oz (about 3 cups) rotini pasta"
    },
    {
      "id": 48073,
      "primary_message": "Once the beef has been transferred, add the eggplant to the skillet; cook, stirring occasionally, until slightly softened, 4 to 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 48074,
      "primary_message": "While the eggplant cooks, trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 48075,
      "primary_message": "Add the garlic, oregano, crushed red pepper, and tomato paste to the skillet; stir until fragrant, 1 to 2 minutes.",
      "secondary_message": "½ tsp oregano\n¼ tsp crushed red pepper\n2 tbsp tomato paste"
    },
    {
      "id": 48076,
      "primary_message": "Add the ground beef and tomato sauce to the skillet; season with salt and pepper. Bring the mixture to a boil, then reduce the heat to medium-low and simmer for 4 to 6 minutes.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 48077,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 48078,
      "primary_message": "Add the pasta, reserved cooking water, and about ¾ of the basil (save the rest for garnishing); stir until the ragu and pasta are well combined.",
      "secondary_message": ""
    },
    {
      "id": 48079,
      "primary_message": "To serve, divide the pasta between bowls and garnish with the remaining basil. Enjoy!",
      "secondary_message": null
    }
  ],
