  "instructions": [
    {
      "id": 506561,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. Line a large baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 506562,
      "primary_message": "Peel and mince garlic. Place in a small bowl along with tomato sauce and spices, then stir to combine. Transfer a ⅓-cup of the tomato sauce to a large bowl. (Set remaining sauce aside for later use.)",
      "secondary_message": "3 cloves garlic\n1 ½ (8 oz) cans tomato sauce\n1 ½ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 506563,
      "primary_message": "Add veggie ground, bread crumbs, salt, and crushed red pepper to the large bowl with the tomato sauce, then mix with your hands until well combined. Form the mixture into 6 equal-sized patties and arrange on the baking sheet. (The patties will be loose but will firm up when cooked.)",
      "secondary_message": "24 oz veggie ground, plant based\n1 cup panko bread crumbs\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 506564,
      "primary_message": "Drizzle patties with oil, then place baking sheet in the oven. Broil, flipping patties halfway, until veggie ground is cooked through and golden, about 10 minutes. Remove from oven.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 506565,
      "primary_message": "Meanwhile, roughly chop capers. Place in a clean large bowl along with oil, vinegar, Dijon, honey, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp capers\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp honey\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 506566,
      "primary_message": "Drain and thinly slice artichoke hearts and sun-dried tomatoes. Add both to the bowl with the dressing and set aside.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated\n9 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 506567,
      "primary_message": "Thinly slice cheese.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 506568,
      "primary_message": "When the patties are done, top with remaining sauce and cheese. Return baking sheet to the oven and continue to broil until sauce is warm and cheese is melted, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 506569,
      "primary_message": "Meanwhile, wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": "1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 506570,
      "primary_message": "Arrange bread on another large baking sheet. Place baking sheet in the oven and broil until toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "6 slices sourdough bread"
    },
    {
      "id": 506571,
      "primary_message": "While the bread is toasting, wash and dry alfalfa sprouts. Add to the bowl and toss to combine the salad.",
      "secondary_message": "1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 506572,
      "primary_message": "Place a slice of toast on each plate and top with saucy patties. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
