  "instructions": [
    {
      "id": 506584,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. Line a large baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 506585,
      "primary_message": "Peel and mince garlic. Place in a small bowl along with tomato sauce and spices, then stir to combine. Transfer a ¼-cup of the tomato sauce to a medium bowl. (Set remaining sauce aside for later use.)",
      "secondary_message": "2 cloves garlic\n1 (213 ml) can tomato sauce\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 506586,
      "primary_message": "Add chicken, bread crumbs, salt, and crushed red pepper to the medium bowl with the tomato sauce, then mix with your hands until well combined. Form the chicken mixture into 4 equal-sized patties and transfer to one half of the baking sheet. (The patties will be loose but will firm up when cooked.)",
      "secondary_message": "0.45 kg ground chicken\n⅔ cup panko bread crumbs\n½ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 506587,
      "primary_message": "Drizzle patties with oil, then place baking sheet in the oven. Broil, flipping patties halfway, until chicken is cooked through and golden, about 10 minutes. Remove from oven.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 506588,
      "primary_message": "Meanwhile, roughly chop capers. Place in a clean medium bowl along with oil, vinegar, Dijon, honey, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp capers\n4 tsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 506589,
      "primary_message": "Drain and thinly slice artichoke hearts and sun-dried tomatoes. Add both to the bowl with the dressing and set aside.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated\n6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 506590,
      "primary_message": "Thinly slice cheese.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 506591,
      "primary_message": "When the patties are done, top with remaining sauce and cheese. Add bread slices to the other half of the baking sheet. Return baking sheet to the oven and continue to broil until bread is toasted, sauce is warm, and cheese is melted, 1-2 minutes more. Remove from oven.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 506592,
      "primary_message": "Meanwhile, wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": "1 head butter (Boston) lettuce"
    },
    {
      "id": 506593,
      "primary_message": "Wash and dry alfalfa sprouts. Add to the bowl and toss to combine the salad.",
      "secondary_message": "1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 506594,
      "primary_message": "Place a slice of toast on each plate and top with saucy patties. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
