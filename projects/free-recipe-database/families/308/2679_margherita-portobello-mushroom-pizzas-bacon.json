  "instructions": [
    {
      "id": 25931,
      "primary_message": "Preheat the oven to 200°C (400°F). Line a baking sheet with aluminum foil.",
      "secondary_message": ""
    },
    {
      "id": 25932,
      "primary_message": "Wash and dry the mushroom caps, then remove and discard the stems. Peel and mince the garlic.",
      "secondary_message": "8 caps portobello mushrooms\r\n4 cloves garlic"
    },
    {
      "id": 25933,
      "primary_message": "Place the mushrooms on the baking sheet. Rub with olive oil and season with the minced garlic, salt, and pepper.",
      "secondary_message": "4 tbsp extra virgin olive oil\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25934,
      "primary_message": "Place the mushrooms in the oven and bake for 5 minutes while you prepare the toppings.",
      "secondary_message": ""
    },
    {
      "id": 25935,
      "primary_message": "Wash the tomatoes and basil. Slice the tomatoes horizontally into rounds. Pick the basil leaves off the stems; discard the stems and slice the leaves crosswise into ribbons.",
      "secondary_message": "2 tomatoes\r\n1 small bunch fresh basil"
    },
    {
      "id": 25936,
      "primary_message": "Grate the fresh mozzarella.",
      "secondary_message": "1 (227 g) ball fresh mozzarella cheese\r\n"
    },
    {
      "id": 25937,
      "primary_message": "Chop or cut the bacon into smaller pieces.",
      "secondary_message": "8 slices bacon\r\n"
    },
    {
      "id": 25938,
      "primary_message": "Remove mushrooms from the oven and drain any excess liquid. Sprinkle a little of the mozzarella into each cap, then top with bacon, tomato rounds, and ½ of the basil. Finish off with the remaining mozzarella.",
      "secondary_message": ""
    },
    {
      "id": 25939,
      "primary_message": "Place in the oven and cook until the mushrooms are tender and the cheese is melted, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25940,
      "primary_message": "Wash the cucumber and grape tomatoes. Quarter the cucumber lengthwise, then chop crosswise. Halve the tomatoes.",
      "secondary_message": "1 English cucumber\r\n1 small pkg grape tomatoes"
    },
    {
      "id": 25941,
      "primary_message": "To serve, place the mushroom pizzas on a plate and sprinkle with the remaining basil. Serve with grape tomatoes and cucumber on the side and enjoy!",
      "secondary_message": ""
    }
  ],
