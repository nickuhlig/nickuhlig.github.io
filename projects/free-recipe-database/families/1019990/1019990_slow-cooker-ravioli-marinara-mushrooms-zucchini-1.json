  "instructions": [
    {
      "primary_message": "Wash, dry, and thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": "1 lb cremini mushrooms"
    },
    {
      "primary_message": "Wash, dry, and trim zucchini. Halve lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the mushrooms.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "primary_message": "Peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium yellow onion\n2 clove garlic"
    },
    {
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until soft, 5-6 minutes.",
      "secondary_message": "extra virgin olive oil\n1 tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Add marinara sauce and water to the pot, stir to combine, and remove from heat.",
      "secondary_message": "1 (24 oz) jar marinara sauce"
    },
    {
      "primary_message": "Coat a 4-quart slow cooker insert with a thin layer of oil. Add ⅓ of the uncooked ravioli to the insert, spreading out in an even layer, then top with ⅓ of the sauce. Finally, sprinkle with a ½-cup of cheese. Repeat twice more, finishing with 1 cup of cheese.",
      "secondary_message": "2 tsp extra virgin olive oil\n18 oz cheese ravioli, fresh or frozen\n2 cups shredded cheese, Italian blend"
    },
    {
      "primary_message": "Cover and cook until ravioli are warmed through and cheese is melted, about 5 hours on low.",
      "secondary_message": null
    },
    {
      "primary_message": "When the ravioli is done, turn slow cooker off and allow it to sit for 15 minutes before serving. Enjoy!",
      "secondary_message": null
    }
  ],
