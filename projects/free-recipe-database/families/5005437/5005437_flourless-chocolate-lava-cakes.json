  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 375°F. Butter seven 4-ounce ramekins (see notes).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using a microwave or a bowl set over a pan of simmering water, melt chocolate with butter, stirring occasionally, until melted and smooth. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While chocolate is melting, whip eggs, sugar, and salt using a mixer fitted with a whip attachment on medium-high speed until mixture is lightened and pale in color, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Reduce speed to low and mix in chocolate mixture until combined. Spoon into cups and place on baking sheet. Bake until edges are set but center is underdone, about 10 minutes. Avoid over-baking. Let cool 3 minutes and serve.",
      "secondary_message": null
    }
  ],
