  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel the garlic. Drain and cut the soft tofu packed in water into 1-inch cubes. Cut the green onions into 1-inch pieces.",
      "secondary_message": "2 medium cloves garlic\n1 lb soft tofu packed in water\n2 green onions"
    },
    {
      "id": 1,
      "primary_message": "In a mortar and pestle, combine garlic, cilantro stems, and peppercorns and pound until a fine paste forms, about 3 minutes. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add ground pork, 2 teaspoons soy sauce, and 1 teaspoon fish sauce. Using your hands or a sturdy silicone spatula, mix until thoroughly combined, about 3 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium pot, bring chicken stock or water to a boil, then reduce heat to maintain a simmer. Form seasoned pork mixture into 1-inch balls and gently drop into simmering stock. Cook until pork balls float, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add remaining soy sauce and fish sauce to stock. Gently add tofu cubes and return to a simmer, then add green onions and remove from heat. Adjust seasoning as necessary with more fish sauce.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Ladle soup into individual serving bowls. Garnish with cilantro leaves. Some freshly-ground white pepper on top is optional, but recommended. Serve hot with steamed jasmine rice.",
      "secondary_message": null
    }
  ],
