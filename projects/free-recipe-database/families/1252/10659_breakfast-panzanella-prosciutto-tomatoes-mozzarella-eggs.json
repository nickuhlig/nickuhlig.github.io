  "instructions": [
    {
      "id": 170910,
      "primary_message": "Place eggs in a medium saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool. ",
      "secondary_message": "6 eggs"
    },
    {
      "id": 170911,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 170912,
      "primary_message": "Peel and mince garlic. Cut or tear the bread into bite-sized pieces. Place both in a large bowl along with oil and toss to coat. Transfer to a large baking sheet pan. Reserve bowl for later use.",
      "secondary_message": "3 cloves garlic\n9 slices whole grain bread\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 170913,
      "primary_message": "Place croutons in the oven and cook, tossing halfway through, until golden and crisp, 6-8 minutes. Remove from oven and set aside to cool. ",
      "secondary_message": null
    },
    {
      "id": 170914,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup balsamic vinegar\n1 tbsp extra virgin olive oil\n1 ½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 170915,
      "primary_message": "Peel and thinly slice shallot. Add to the bowl with the dressing. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 170916,
      "primary_message": "Wash and dry tomatoes; cut in half lengthwise and add to the bowl.",
      "secondary_message": "1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 170917,
      "primary_message": "Wash and dry the basil. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl. ",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 170918,
      "primary_message": "Cut mozzarella into bite-sized pieces. Add mozzarella and croutons to the bowl and toss to coat. ",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 170919,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces. Peel and halve eggs.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 170920,
      "primary_message": "To serve, divide panzanella salad, eggs, and prosciutto between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
