  "instructions": [
    {
      "id": 170822,
      "primary_message": "Place eggs in a small saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool. ",
      "secondary_message": "2 eggs"
    },
    {
      "id": 170823,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 170824,
      "primary_message": "Peel and mince garlic. Cut or tear the bread into bite-sized pieces. Place both in a medium bowl along with oil and toss to coat. Transfer to a baking sheet pan. Reserve bowl for later use.",
      "secondary_message": "1 clove garlic\n3 slices whole grain bread\n2 tsp extra virgin olive oil"
    },
    {
      "id": 170825,
      "primary_message": "Place croutons in the oven and cook, tossing halfway through, until golden and crisp, 6-8 minutes. Remove from oven and set aside to cool. ",
      "secondary_message": null
    },
    {
      "id": 170826,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp balsamic vinegar\n1 tsp extra virgin olive oil\n½ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 170827,
      "primary_message": "Peel and thinly slice shallot. Add to the bowl with the dressing. ",
      "secondary_message": "½ shallot"
    },
    {
      "id": 170828,
      "primary_message": "Wash and dry tomatoes; cut in half lengthwise and add to the bowl.",
      "secondary_message": "½ pint grape tomatoes"
    },
    {
      "id": 170829,
      "primary_message": "Wash and dry the basil. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl. ",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 170830,
      "primary_message": "Cut mozzarella into bite-sized pieces. Add mozzarella and croutons to the bowl and toss to coat. ",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 170831,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces. Peel and halve eggs.",
      "secondary_message": "2 slices prosciutto"
    },
    {
      "id": 170832,
      "primary_message": "To serve, divide panzanella salad, eggs, and prosciutto between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
