  "instructions": [
    {
      "id": 156594,
      "primary_message": "Wash and dry bell peppers. Seed and slice into thin strips.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 156595,
      "primary_message": "Peel and thinly slice onion into half rings.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 156596,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 156597,
      "primary_message": "Meanwhile, roughly chop the olives and sun-dried tomatoes.",
      "secondary_message": "1 cup Kalamata olives, pitted\n16 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 156598,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 156599,
      "primary_message": "Add bell pepper and onions; cook, stirring occasionally, until vegetables are softened, about 5 minutes. Add olives and sun-dried tomatoes; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 156600,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 156601,
      "primary_message": "In a large bowl, whisk together eggs, spices, and half of the cheese.",
      "secondary_message": "12 eggs\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 156602,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 156603,
      "primary_message": "Spread out the veggies evenly in the skillet. Reduce heat to medium-low and pour in the egg mixture. ",
      "secondary_message": null
    },
    {
      "id": 156604,
      "primary_message": "As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 156605,
      "primary_message": "Sprinkle with the remaining cheese. Place skillet in the oven and broil until the top is set, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 156606,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
