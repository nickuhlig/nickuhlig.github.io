  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon. Thinly slice the fennel. Thinly slice the celery root. Thinly slice the carrot. Thinly slice the beet. Thinly slice the shallots. Pick the parsley leaves from the stems and roughly chop them.",
      "secondary_message": "½ lemon\n2 cups fennel\n2 cups celery root\n2 cups carrot\n2 cups beet\n¾ cup shallots\n1 cup flat-leaf parsley"
    },
    {
      "id": 1,
      "primary_message": "Adjust an oven rack to the center position and preheat the oven to 300°F. Pat duck legs dry with paper towels, then season with salt and pepper. Set skin-side down in a wide, oven-safe non-stick or cast iron skillet. Set over medium heat and cook until the skin is golden brown and begins to crisp, about 8 minutes. Transfer the skillet to the oven. Roast for 1 hour, then flip the duck legs, and roast for another hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a large bowl, whisk together the olive oil, vinegar, lemon juice, thyme leaves, and honey. Season to taste with salt and pepper. Add fennel, celery root, carrot, beets, shallots, and parsley to the bowl and toss to combine. Cover with plastic wrap and set aside until duck is cooked.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To serve, mound the softened vegetable salad on a plate, and top with a duck leg.",
      "secondary_message": null
    }
  ],
