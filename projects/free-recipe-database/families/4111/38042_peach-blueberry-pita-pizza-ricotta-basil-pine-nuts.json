  "instructions": [
    {
      "id": 594581,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 594582,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 peaches\n1 small pkg fresh basil\n1 (6 oz) pkg blueberries"
    },
    {
      "id": 594583,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ¼-inch thick wedges. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 594584,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl with the peaches. (Reserve remaining basil for later use.)",
      "secondary_message": null
    },
    {
      "id": 594585,
      "primary_message": "Peel, halve, and slice shallots lengthwise into thin strips. Peel and mince garlic. Add both to the bowl along with blueberries, pine nuts, oil, salt, and pepper, then stir to combine.",
      "secondary_message": "2 shallots\n2 cloves garlic\n¼ cup pine nuts\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 594586,
      "primary_message": "Arrange pitas on a large baking sheet pan. Spread each with ricotta, then top with the peach mixture.",
      "secondary_message": "4 whole grain pitas\n1 (15 oz) pkg ricotta cheese"
    },
    {
      "id": 594587,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until peaches are tender and pizzas are warmed through, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 594588,
      "primary_message": "When the pizzas are done, remove from the oven. Sprinkle with reserved basil, then drizzle with vinegar and honey. Cut into wedges.",
      "secondary_message": "2 tbsp balsamic vinegar\n4 tsp honey"
    },
    {
      "id": 594589,
      "primary_message": "To serve, divide pizzas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
