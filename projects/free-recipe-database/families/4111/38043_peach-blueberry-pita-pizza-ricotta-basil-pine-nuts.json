  "instructions": [
    {
      "id": 594590,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 594591,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 peaches\n1 small pkg fresh basil\n1 ½ (6 oz) pkgs blueberries"
    },
    {
      "id": 594592,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ¼-inch thick wedges. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 594593,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl with the peaches. (Reserve remaining basil for later use.)",
      "secondary_message": null
    },
    {
      "id": 594594,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin strips. Peel and mince garlic. Add both to the bowl along with blueberries, pine nuts, oil, salt, and pepper, then stir to combine.",
      "secondary_message": "½ medium red onion\n3 cloves garlic\n⅓ cup pine nuts\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 594595,
      "primary_message": "Divide pitas between two baking sheet pans. Spread each with ricotta, then top with the peach mixture.",
      "secondary_message": "6 whole grain pitas\n1 ½ (15 oz) pkgs ricotta cheese"
    },
    {
      "id": 594596,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until peaches are tender and pizzas are warmed through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 594597,
      "primary_message": "When the pizzas are done, remove from the oven. Sprinkle with reserved basil, then drizzle with vinegar and honey. Cut into wedges.",
      "secondary_message": "3 tbsp balsamic vinegar\n2 tbsp honey"
    },
    {
      "id": 594598,
      "primary_message": "To serve, divide pizzas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
