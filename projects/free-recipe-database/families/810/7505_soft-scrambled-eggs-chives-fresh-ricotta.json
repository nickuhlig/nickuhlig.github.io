  "instructions": [
    {
      "primary_message": "Wash and chop chives into small pieces, set some aside to use as garnish.",
      "secondary_message": "½ small pkg chives"
    },
    {
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Crack the eggs into a medium bowl, add chives, and season with salt; whisk together.",
      "secondary_message": "8 eggs\nsalt"
    },
    {
      "primary_message": "Add butter to the skillet and swirl to coat the bottom. Add eggs and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until eggs are almost cooked but still runny in parts, about 2 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "primary_message": "Remove from heat, stir in ricotta, and allow the eggs to finish cooking in the warm pan.",
      "secondary_message": "½ (425 g) pkg ricotta cheese"
    },
    {
      "primary_message": "Toast bread if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, spoon eggs on top of toast, garnish with chives, and season with salt and pepper. Enjoy!",
      "secondary_message": "salt\n⅛ tsp black pepper"
    }
  ],
