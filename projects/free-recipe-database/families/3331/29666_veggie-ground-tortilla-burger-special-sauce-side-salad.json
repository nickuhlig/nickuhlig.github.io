  "instructions": [
    {
      "id": 472801,
      "primary_message": "Place veggie ground, bread crumbs, soy sauce, salt, and pepper in a medium bowl; mix with your hands until well combined. Divide the veggie ground mixture into 4 portions and form into ½-inch thick patties; place on a plate.",
      "secondary_message": "16 oz veggie ground, plant based\n½ cup panko bread crumbs\n2 tsp soy sauce\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 472802,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 472803,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, until golden underneath, 3-4 minutes; flip patties and cook an additional 3-4 minutes, until cooked through. Remove to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 472804,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 tomatoes\n2 heads butter (Boston) lettuce\n1 English cucumber"
    },
    {
      "id": 472805,
      "primary_message": "Place oil, vinegar, Dijon, maple syrup, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 472806,
      "primary_message": "Slice two tomatoes crosswise into thin rounds; medium dice remaining tomatoes. Place slices on another plate and add diced tomato to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 472807,
      "primary_message": "Separate lettuce into leaves. Set aside a few leaves per burger and chop (or tear) remaining leaves into bite-sized pieces. Add whole leaves to the plate and chopped lettuce to the bowl. Set the plate aside.",
      "secondary_message": null
    },
    {
      "id": 472808,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 472809,
      "primary_message": "Place mayo, ketchup, Dijon, and cayenne in a small bowl. Whisk to combine the special sauce and set aside.",
      "secondary_message": "2 tbsp vegan mayonnaise\n4 tsp ketchup\n2 tsp Dijon mustard\n⅛ tsp cayenne pepper"
    },
    {
      "id": 472810,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "8 small flour tortillas"
    },
    {
      "id": 472811,
      "primary_message": "To assemble the burgers, place half of the tortillas on a flat surface, then top with burger patties, lettuce leaves, tomato slices, and special sauce. Close with the remaining tortillas and cut in half.",
      "secondary_message": null
    },
    {
      "id": 472812,
      "primary_message": "To serve, divide veggie burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
