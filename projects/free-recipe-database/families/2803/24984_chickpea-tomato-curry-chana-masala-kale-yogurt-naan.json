  "instructions": [
    {
      "id": 401950,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further. ",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 401951,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 401952,
      "primary_message": "While the pot heats up, wash, dry, peel, and mince ginger. ",
      "secondary_message": "3 (1 inch) pieces ginger root"
    },
    {
      "id": 401953,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger and spices; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "1 tbsp virgin coconut oil\n2 tbsp curry powder\n1 tbsp garam masala\n1 ½ tsp garlic powder\n1 ½ tsp salt"
    },
    {
      "id": 401954,
      "primary_message": "Add chickpeas, tomatoes, and water to the pot; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to low and cook until chickpeas start to soften, 5-6 minutes. ",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n1 ½ cup water"
    },
    {
      "id": 401955,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Reduce heat to low and continue to cook, stirring occasionally, until chickpeas and kale are tender, 5-6 minutes more. Remove from heat.",
      "secondary_message": "1 ½ (10 oz) bags kale, cut and ready to use"
    },
    {
      "id": 401956,
      "primary_message": "Meanwhile, toast naan if desired, then cut into wedges. ",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 401957,
      "primary_message": "Divide chickpea curry between bowls and top with yogurt. Serve with naan on the side and enjoy! ",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
