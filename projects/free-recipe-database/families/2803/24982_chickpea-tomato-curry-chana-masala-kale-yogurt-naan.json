  "instructions": [
    {
      "id": 401934,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further. ",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 401935,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 401936,
      "primary_message": "While the pan heats up, wash, dry, peel, and mince ginger. ",
      "secondary_message": "1 (1 inch) piece ginger root"
    },
    {
      "id": 401937,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add ginger and spices; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "1 tsp virgin coconut oil\n2 tsp curry powder\n1 tsp garam masala\n½ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 401938,
      "primary_message": "Add chickpeas, tomatoes, and water to the pan; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to low and cook until chickpeas start to soften, about 5 minutes. ",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n½ cup water"
    },
    {
      "id": 401939,
      "primary_message": "Add kale to the pan in handfuls, waiting for the kale to wilt slightly before adding the next handful. Reduce heat to low and continue to cook, stirring occasionally, until chickpeas and kale are tender, 5 minutes more. Remove from heat.",
      "secondary_message": "½ (10 oz) bag kale, cut and ready to use"
    },
    {
      "id": 401940,
      "primary_message": "Meanwhile, toast naan if desired, then cut into wedges. ",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 401941,
      "primary_message": "Divide chickpea curry between bowls and top with yogurt. Serve with naan on the side and enjoy! ",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
