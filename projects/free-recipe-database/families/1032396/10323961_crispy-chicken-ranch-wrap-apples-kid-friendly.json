  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the oven is heated, transfer chicken strips to a baking sheet pan and spread out in an even layer. Place in the oven and bake, flipping once, until heated through and crispy, about 20 minutes (or cook according to package instructions).",
      "secondary_message": "6 piece frozen crispy chicken strips, fully-cooked"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and small dice tomato. Place on a plate and season with salt.",
      "secondary_message": "1 tomato\n1 pinch salt"
    },
    {
      "primary_message": "Wash, dry, quarter, and core apples; slice into wedges. Add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "primary_message": "When the chicken strips are done, remove from oven. Transfer to a cutting board and chop into bite-size pieces.",
      "secondary_message": null
    },
    {
      "primary_message": "Place tortillas on a flat surface and divide chicken between them. Top with lettuce and tomato, then drizzle with dressing. Fold in sides of tortillas and roll tightly to close the wraps. ",
      "secondary_message": "1 cup shredded lettuce\n¼ cup ranch dressing"
    },
    {
      "primary_message": "Cut wraps in half, divide between plates, and serve with apple slices. Enjoy!",
      "secondary_message": null
    }
  ],
