  "instructions": [
    {
      "id": 441118,
      "primary_message": "Preheat oven to 205°C (400°F). Coat 6 muffin cups with oil and set aside.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 441119,
      "primary_message": "Place a large bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 441120,
      "primary_message": "Wash and dry oranges. Zest 1 ½ oranges into a medium bowl (reserve oranges for later use). Add flour, sugar, oil, water, eggs, baking powder, and spices, then whisk to combine the batter.",
      "secondary_message": "6 oranges\n1 cup all-purpose flour\n⅓ cup brown sugar\n⅓ cup extra virgin olive oil\n44 ml water\n3 eggs\n¾ tsp baking powder\n½ tsp cardamom, ground\n½ tsp cinnamon, ground\n¼ tsp salt"
    },
    {
      "id": 441121,
      "primary_message": "Divide batter between the muffin cups. Place in the oven and bake until a knife or skewer inserted in the center comes out clean, 15-20 minutes. Remove from oven and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 441122,
      "primary_message": "Meanwhile, cut off skin and white pith from the oranges; slice between the membranes to release segments. Place in another medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 441123,
      "primary_message": "Roughly chop dates. Add to the bowl with the oranges, stir to combine, and set aside. ",
      "secondary_message": "⅓ cup medjool dates, pitted"
    },
    {
      "id": 441124,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "355 ml heavy whipping cream"
    },
    {
      "id": 441125,
      "primary_message": "To serve, divide oranges, dates, and cakes between bowls; top with whipped cream. Enjoy!",
      "secondary_message": null
    }
  ],
