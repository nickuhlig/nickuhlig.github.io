  "instructions": [
    {
      "id": 441084,
      "primary_message": "Preheat oven to 205°C (400°F). Coat 4 muffin cups with oil and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 441085,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 441086,
      "primary_message": "Wash and dry oranges. Zest one orange into a small bowl (reserve oranges for later use). Add flour, sugar, oil, water, eggs, baking powder, and spices, then whisk to combine the batter.",
      "secondary_message": "4 oranges\n⅔ cup all-purpose flour\n¼ cup brown sugar\n¼ cup extra virgin olive oil\n2 tbsp water\n2 eggs\n½ tsp baking powder\n¼ tsp cardamom, ground\n¼ tsp cinnamon, ground\n¼ tsp salt"
    },
    {
      "id": 441087,
      "primary_message": "Divide batter between the muffin cups. Place in the oven and bake until a knife or skewer inserted in the center comes out clean, 15-20 minutes. Remove from oven and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 441088,
      "primary_message": "Meanwhile, cut off skin and white pith from the oranges; slice between the membranes to release segments. Place in another small bowl. ",
      "secondary_message": null
    },
    {
      "id": 441089,
      "primary_message": "Roughly chop dates. Add to the bowl with the oranges, stir to combine, and set aside. ",
      "secondary_message": "¼ cup medjool dates, pitted"
    },
    {
      "id": 441090,
      "primary_message": "Roughly chop pistachios. ",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 441091,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "237 ml heavy whipping cream"
    },
    {
      "id": 441092,
      "primary_message": "To serve, divide oranges, dates, and cakes between bowls; top with whipped cream and pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
