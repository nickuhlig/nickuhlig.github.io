  "instructions": [
    {
      "primary_message": "Squeeze rice pouches to separate grains, then tear a two-inch opening at the top of each to vent. Place both packages in the microwave and heat on high until warmed through, 2 1/2 minutes. Carefully remove from microwave and set aside to cool slightly.",
      "secondary_message": "2 (250 g) pouch rice pilaf with orzo pasta, pre-cooked"
    },
    {
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Set aside.",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "primary_message": "Place chicken on a microwave-safe plate and cover with a damp paper towel. Place in microwave and heat on high until warmed through, 2 1/2 - 3 minutes.  Remove from microwave.",
      "secondary_message": "227 g frozen chicken breast strips, fully-cooked"
    },
    {
      "primary_message": "To serve, divide rice pilaf between bowls, then top with arugula, carrots, and chicken. Drizzle with dressing and enjoy!",
      "secondary_message": "½ (283 g) bag shredded carrots\n⅓ cup lemon garlic vinaigrette"
    }
  ],
