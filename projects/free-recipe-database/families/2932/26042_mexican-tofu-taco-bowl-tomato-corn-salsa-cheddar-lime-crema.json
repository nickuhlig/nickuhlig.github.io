  "instructions": [
    {
      "id": 414712,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 414713,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 414714,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 414715,
      "primary_message": "While the rice is cooking, place soy sauce, oil, and spices in a medium bowl; stir to combine the marinade. ",
      "secondary_message": "¼ cup soy sauce\n2 tbsp extra virgin olive oil\n2 tbsp chili powder\n2 tsp oregano, dried\n1 tsp cumin, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 414716,
      "primary_message": "Using your fingers, crumble tofu into the bowl with the marinade. Stir to combine, transfer to a large baking sheet pan, and spread out in an even layer. (Reserve bowl for the salsa.)",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 414717,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until golden brown and slightly crispy, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 414718,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 jalapeño pepper\n2 tomatoes\n1 head romaine lettuce"
    },
    {
      "id": 414719,
      "primary_message": "Peel and mince shallot. Place in the reserved bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 414720,
      "primary_message": "Zest and juice one lime into the bowl with the shallot. (Reserve remaining lime for later use.)",
      "secondary_message": null
    },
    {
      "id": 414721,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 414722,
      "primary_message": "Small dice tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 414723,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl along with oil, salt, and pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "1 cup frozen corn\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 414724,
      "primary_message": "Juice reserved limes into a small bowl. Add yogurt and spices, stir to combine the lime crema, and set aside. ",
      "secondary_message": "1 cup plain Greek yogurt\n1 tsp garlic powder\n¼ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 414725,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 414726,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 414727,
      "primary_message": "To serve, divide rice, tofu, lettuce, cheese, and salsa between plates or bowls. Drizzle with lime crema and enjoy!",
      "secondary_message": null
    }
  ],
