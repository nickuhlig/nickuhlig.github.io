  "instructions": [
    {
      "id": 414792,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 414793,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 414794,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 414795,
      "primary_message": "While the rice is cooking, place soy sauce, oil, and spices in a medium bowl; stir to combine the marinade. ",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 tsp oregano, dried\n½ tsp cumin, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 414796,
      "primary_message": "Using your fingers, crumble tofu into the bowl with the marinade. Stir to combine, transfer to a baking sheet pan, and spread out in an even layer. (Reserve bowl for the salsa.)",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 414797,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until golden brown and slightly crispy, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 414798,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ jalapeño pepper\n1 tomato\n½ head romaine lettuce"
    },
    {
      "id": 414799,
      "primary_message": "Peel and mince shallot. Place in the reserved bowl. ",
      "secondary_message": "½ shallot"
    },
    {
      "id": 414800,
      "primary_message": "Zest and juice half of the lime into the bowl with the shallot. (Reserve remaining lime for later use.)",
      "secondary_message": null
    },
    {
      "id": 414801,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 414802,
      "primary_message": "Small dice tomato and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 414803,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl along with oil, salt, and pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "½ cup frozen corn\n1 ½ tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 414804,
      "primary_message": "Juice reserved lime into a small bowl. Add yogurt and spices, stir to combine the lime crema, and set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp garlic powder\n⅛ tsp cumin, ground\n⅛ tsp salt"
    },
    {
      "id": 414805,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 414806,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 414807,
      "primary_message": "To serve, divide rice, tofu, lettuce, cheese, and salsa between plates or bowls. Drizzle with lime crema and enjoy!",
      "secondary_message": null
    }
  ],
