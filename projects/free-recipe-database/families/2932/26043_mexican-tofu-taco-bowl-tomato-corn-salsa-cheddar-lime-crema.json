  "instructions": [
    {
      "id": 414728,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 414729,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 414730,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 414731,
      "primary_message": "While the rice is cooking, place soy sauce, oil, and spices in a large bowl; stir to combine the marinade. ",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp extra virgin olive oil\n3 tbsp chili powder\n1 tbsp oregano, dried\n1 ½ tsp cumin, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 414732,
      "primary_message": "Using your fingers, crumble tofu into the bowl with the marinade. Stir to combine, divide between two large baking sheet pans, and spread out in an even layer. (Reserve bowl for the salsa.)",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 414733,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until golden brown and slightly crispy, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 414734,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ jalapeño peppers\n3 tomatoes\n1 ½ heads romaine lettuce"
    },
    {
      "id": 414735,
      "primary_message": "Peel and mince shallots. Place in the reserved bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 414736,
      "primary_message": "Zest and juice half of the limes into the bowl with the shallot. (Reserve remaining limes for later use.)",
      "secondary_message": null
    },
    {
      "id": 414737,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 414738,
      "primary_message": "Small dice tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 414739,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl along with oil, salt, and pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "1 ½ cups frozen corn\n1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 414740,
      "primary_message": "Juice reserved limes into a small bowl. Add yogurt and spices, stir to combine the lime crema, and set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 ½ tsp garlic powder\n½ tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 414741,
      "primary_message": "Coarsely grate cheese. ",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 414742,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 414743,
      "primary_message": "To serve, divide rice, tofu, lettuce, cheese, and salsa between plates or bowls. Drizzle with lime crema and enjoy!",
      "secondary_message": null
    }
  ],
