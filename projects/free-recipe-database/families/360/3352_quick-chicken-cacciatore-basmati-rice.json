  "instructions": [
    {
      "id": 34902,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "1 cup basmati rice\n2 cups water\n½ tsp salt"
    },
    {
      "id": 34903,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "2 yellow bell peppers\n0.227 kg cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 34904,
      "primary_message": "Once the water is boiling, reduce heat to low, stir, and cover. Cook until liquid is absorbed, 15-18 minutes. Remove from heat and let it stand, covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 34905,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl and set aside.",
      "secondary_message": ""
    },
    {
      "id": 34906,
      "primary_message": "Halve, seed, and cut the bell peppers lengthwise into strips. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 34907,
      "primary_message": "Peel and small dice the onion; add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 34908,
      "primary_message": "Slice the mushrooms and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 34909,
      "primary_message": "Peel and mince the garlic; add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 34910,
      "primary_message": "Pat dry the chicken; holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "0.454 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 34911,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 34912,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom. Place the chicken in the skillet and cook until browned (but not cooked through), 1 to 2 minutes per side. Transfer to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 34913,
      "primary_message": "Once the chicken has been transferred, add the vegetables to the skillet and season with salt and pepper. Cook, stirring frequently, until softened, 4 to 6 minutes.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper "
    },
    {
      "id": 34914,
      "primary_message": "Add the tomatoes, olives, and half of the parsley (save the rest for garnishing) to the skillet; stir to combine.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n1 cup Kalamata olives, pitted"
    },
    {
      "id": 34915,
      "primary_message": "Return the chicken to the skillet and sink into the sauce. Bring to a simmer and cook until chicken is cooked through, 4 to 6 minutes.",
      "secondary_message": ""
    },
    {
      "id": 34916,
      "primary_message": "Divide the rice between four plates (or two plates and two lunch containers) and top each with the chicken cacciatore. Garnish with the remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
