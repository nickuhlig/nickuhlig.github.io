  "instructions": [
    {
      "id": 485221,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 485222,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 red bell peppers\n1 eggplant\n½ small pkg fresh basil\n½ English cucumber\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 485223,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, and season with salt; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 485224,
      "primary_message": "Meanwhile, trim and small dice eggplant.",
      "secondary_message": null
    },
    {
      "id": 485225,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485226,
      "primary_message": "While the skillet heats up, drain and rinse beans in a colander.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 485227,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add eggplant, beans, and spices; cook, stirring occasionally, until eggplant has softened, 5-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n¼ tsp oregano, dried"
    },
    {
      "id": 485228,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place half in a medium bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 485229,
      "primary_message": "Add mayo, vinegar, salt, and pepper to the bowl with the basil. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp white wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 485230,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing, along with mixed greens and half of the feta. Toss to combine the salad. (Reserve remaining feta for the next step.)",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 485231,
      "primary_message": "When the beans and eggplant are done, add remaining feta to the skillet. Stir to combine the filling and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 485232,
      "primary_message": "Divide peppers between plates, stuff with bean filling, and top with reserved basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
