  "instructions": [
    {
      "id": 485108,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 485109,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 red bell peppers\n3 eggplants\n1 small pkg fresh basil\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 485110,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, and season with salt; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 485111,
      "primary_message": "Meanwhile, trim and small dice eggplants.",
      "secondary_message": null
    },
    {
      "id": 485112,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485113,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add eggplant, chicken, and spices; cook, breaking the meat apart with a spoon, until meat is crumbly and eggplant has softened, 7-8 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ lb ground chicken\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp oregano, dried"
    },
    {
      "id": 485114,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place half in a large bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 485115,
      "primary_message": "Add mayo, vinegar, salt, and pepper to the bowl with the basil. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup avocado oil mayonnaise\n2 tbsp white wine vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 485116,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing, along with mixed greens and half of the feta. Toss to combine the salad. (Reserve remaining feta for the next step.)",
      "secondary_message": "3 (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 485117,
      "primary_message": "When the chicken and eggplant are done, add remaining feta to the pot. Stir to combine the filling and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 485118,
      "primary_message": "Divide peppers between plates, stuff with chicken filling, and top with reserved basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
