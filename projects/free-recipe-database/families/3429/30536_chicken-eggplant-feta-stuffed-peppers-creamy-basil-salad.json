  "instructions": [
    {
      "id": 485166,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 485167,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "4 red bell peppers\n2 eggplants\n1 small pkg fresh basil\n1 English cucumber\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 485168,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, and season with salt; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 485169,
      "primary_message": "Meanwhile, trim and small dice eggplants.",
      "secondary_message": null
    },
    {
      "id": 485170,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485171,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add eggplant, chicken, and spices; cook, breaking the meat apart with a spoon, until meat is crumbly and eggplant has softened, 5-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n0.45 kg ground chicken\n1 tsp salt\n½ tsp black pepper\n½ tsp oregano, dried"
    },
    {
      "id": 485172,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place half in a medium bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 485173,
      "primary_message": "Add mayo, vinegar, salt, and pepper to the bowl with the basil. Whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n4 tsp white wine vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 485174,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the dressing, along with mixed greens and half of the feta. Toss to combine the salad. (Reserve remaining feta for the next step.)",
      "secondary_message": "2 (113 g) pkgs crumbled feta cheese"
    },
    {
      "id": 485175,
      "primary_message": "When the chicken and eggplant are done, add remaining feta to the skillet. Stir to combine the filling and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 485176,
      "primary_message": "Divide peppers between plates, stuff with chicken filling, and top with reserved basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
