  "instructions": [
    {
      "id": 468374,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 468375,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 fennel bulb\n1 yellow bell pepper\n½ small pkg fresh thyme"
    },
    {
      "id": 468376,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 468377,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 468378,
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic. Add both to the bowl. ",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 468379,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 468380,
      "primary_message": "While the skillet heats up, slide thyme leaves off the stems; discard the stems. Add half to the bowl with the veggies. Mince remaining thyme leaves, place in a small bowl, and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 468381,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie-thyme mixture and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper\n¼ tsp rosemary, dried"
    },
    {
      "id": 468382,
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 468383,
      "primary_message": "When the veggies are done, add beans, tomato sauce, and water to the skillet, then stir to combine the stew.",
      "secondary_message": "1 (213 ml) can tomato sauce\n½ cup water"
    },
    {
      "id": 468384,
      "primary_message": "Place skillet in the oven and bake until beans are warmed through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 468385,
      "primary_message": "Remove skillet from the oven and nestle sausages into the stew. Return skillet to the oven and continue to bake until sausages are warmed through, 8-10 minutes more. Remove from oven. ",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 468386,
      "primary_message": "Meanwhile, add bread crumbs to the bowl with the minced thyme and stir to combine.",
      "secondary_message": "¼ cup panko bread crumbs"
    },
    {
      "id": 468387,
      "primary_message": "To serve, divide cassoulet between plates or bowls and top with bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
