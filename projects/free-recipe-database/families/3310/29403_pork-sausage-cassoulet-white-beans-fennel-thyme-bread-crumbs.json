  "instructions": [
    {
      "id": 468361,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 468362,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 fennel bulbs\n3 yellow bell peppers\n1 small pkg fresh thyme"
    },
    {
      "id": 468363,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 468364,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 468365,
      "primary_message": "Peel, halve, and mince onions; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 468366,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 468367,
      "primary_message": "While the skillet heats up, slide thyme leaves off the stems; discard the stems. Add half to the bowl with the veggies. Mince remaining thyme leaves, place in a small bowl, and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 468368,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie-thyme mixture and spices; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp rosemary, dried"
    },
    {
      "id": 468369,
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 468370,
      "primary_message": "When the veggies are done, add beans, tomato sauce, and water to the skillet. Stir to combine, then transfer to a large baking dish and nestle sausages into the stew.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ cup water\n6 pork sausages"
    },
    {
      "id": 468371,
      "primary_message": "Place baking dish in the oven and bake, turning sausages and stirring beans halfway through, until sausages are golden and cooked through, 20-25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 468372,
      "primary_message": "Meanwhile, add bread crumbs to the bowl with the minced thyme and stir to combine.",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 468373,
      "primary_message": "To serve, divide cassoulet between plates or bowls and top with bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
