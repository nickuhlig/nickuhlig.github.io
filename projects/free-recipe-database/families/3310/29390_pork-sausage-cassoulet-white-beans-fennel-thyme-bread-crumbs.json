  "instructions": [
    {
      "id": 468186,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 468187,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 fennel bulbs\n2 yellow bell peppers\n1 small pkg fresh thyme"
    },
    {
      "id": 468188,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 468189,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 468190,
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 468191,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 468192,
      "primary_message": "While the skillet heats up, slide thyme leaves off the stems; discard the stems. Add half to the bowl with the veggies. Mince remaining thyme leaves, place in a small bowl, and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 468193,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie-thyme mixture and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper\n½ tsp rosemary, dried"
    },
    {
      "id": 468194,
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 468195,
      "primary_message": "When the veggies are done, add beans, tomato sauce, and water to the skillet. Stir to combine, then nestle sausages into the stew.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n1 cup water\n4 pork sausages"
    },
    {
      "id": 468196,
      "primary_message": "Place skillet in the oven and bake, turning sausages and stirring beans halfway through, until sausages are golden and cooked through, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 468197,
      "primary_message": "Meanwhile, add bread crumbs to the bowl with the minced thyme and stir to combine.",
      "secondary_message": "½ cup panko bread crumbs"
    },
    {
      "id": 468198,
      "primary_message": "To serve, divide cassoulet between plates or bowls and top with bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
