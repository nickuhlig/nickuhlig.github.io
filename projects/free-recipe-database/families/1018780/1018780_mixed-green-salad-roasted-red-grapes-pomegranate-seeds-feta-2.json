  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F. Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "primary_message": " Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lb red grapes\n1 ½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "primary_message": "Transfer grapes to the baking sheet; drizzle with oil and vinegar, then season with salt. Toss to coat and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\nbalsamic vinegar\n¼ tsp salt"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until grapes begin to swell, about 15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place additional oil, vinegar, Dijon, salt, and pepper in a small bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\nbalsamic vinegar\n1 tbsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Arrange mixed greens on a serving platter. ",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the platter with the mixed greens, arranging on top. ",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the platter. ",
      "secondary_message": "1 shallot"
    },
    {
      "primary_message": "When the grapes are done, remove from oven and set aside to cool slightly, 5 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Top salad with roasted grapes, pomegranate seeds, feta, and pumpkin seeds. ",
      "secondary_message": "1 (4 oz) pkg pomegranate seeds\n1 (4 oz) pkg crumbled feta cheese\n⅓ cup pumpkin seeds"
    },
    {
      "primary_message": "Just before serving, drizzle dressing over the salad.",
      "secondary_message": null
    }
  ],
