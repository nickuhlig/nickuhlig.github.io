  "instructions": [
    {
      "id": 241137,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 241139,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 241140,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, flipping once, until starting to brown, about 4 minutes (the chicken will not be cooked all the way through). Transfer chicken to a clean plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 241142,
      "primary_message": "Meanwhile, peel and mince garlic and shallot.",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 241143,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "id": 241144,
      "primary_message": "Return skillet (with cooking juices) to medium heat. Add garlic and shallot; cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 241145,
      "primary_message": "Add rice, coconut milk, water, and spices to the skillet; stir to combine and bring to a boil over high heat.",
      "secondary_message": "½ (13.5 fl oz) can coconut milk\n⅓ cup water\n½ tsp salt\n½ tsp turmeric, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 241146,
      "primary_message": "Once the  mixture is boiling, reduce heat to medium-low. Return chicken to the skillet, cover, and simmer until rice is tender and chicken is cooked through, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 241147,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes.",
      "secondary_message": "½ pint grape tomatoes"
    },
    {
      "id": 241148,
      "primary_message": "Wash and dry spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "½ (5 oz) pkg baby spinach"
    },
    {
      "id": 241149,
      "primary_message": "When the chicken and rice are done, remove skillet from the heat; transfer chicken to a clean plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 241150,
      "primary_message": "Stir handfuls of spinach into the coconut rice, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 241151,
      "primary_message": "Gently stir tomatoes into the coconut rice. ",
      "secondary_message": null
    },
    {
      "id": 241152,
      "primary_message": "To serve, divide the coconut-vegetable rice and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
