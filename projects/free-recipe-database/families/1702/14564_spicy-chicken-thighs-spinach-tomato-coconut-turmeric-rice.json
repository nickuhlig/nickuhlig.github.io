  "instructions": [
    {
      "id": 241209,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 241210,
      "primary_message": "While the pot heats up, pat the chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 241211,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and cook, flipping once, until starting to brown, about 4 minutes (the chicken will not be cooked all the way through). Transfer chicken to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 241212,
      "primary_message": "Meanwhile, peel and mince garlic and shallots.",
      "secondary_message": "6 cloves garlic\n3 shallots"
    },
    {
      "id": 241213,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "1 ½ cups basmati rice"
    },
    {
      "id": 241214,
      "primary_message": "Return pot (with cooking juices) to medium heat. Add garlic and shallot; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 241215,
      "primary_message": "Add rice, coconut milk, water, and spices to the pot; stir to combine and bring to a boil over high heat.",
      "secondary_message": "1 ½ (398 ml) cans coconut milk\n1 cup water\n1 ½ tsp salt\n1 ½ tsp turmeric, ground\n¾ tsp cayenne pepper"
    },
    {
      "id": 241216,
      "primary_message": "Once the mixture is boiling, reduce heat to medium-low. Return chicken to the pot, cover, and simmer until rice is tender and chicken is cooked through, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 241217,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes.",
      "secondary_message": "1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 241218,
      "primary_message": "Wash and dry spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 241219,
      "primary_message": "When the chicken and rice are done, remove pot from the heat; transfer chicken to a clean plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 241220,
      "primary_message": "Stir handfuls of spinach into the coconut rice, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 241221,
      "primary_message": "Gently stir tomatoes into the coconut rice. ",
      "secondary_message": null
    },
    {
      "id": 241222,
      "primary_message": "To serve, divide the coconut-vegetable rice and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
