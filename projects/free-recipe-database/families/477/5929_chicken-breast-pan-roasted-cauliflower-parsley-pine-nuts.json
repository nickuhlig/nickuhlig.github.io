  "instructions": [
    {
      "id": 71407,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 71393,
      "primary_message": "Pat dry the chicken breasts with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 71406,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 71405,
      "primary_message": "Carefully place the chicken breasts in the skillet; cook until the chicken is golden brown and cooked through (check doneness with a thermometer or cut into the chicken with a knife), 6 to 8 minutes per side. Once done, transfer the chicken to plate and tent with foil to keep warm.",
      "secondary_message": ""
    },
    {
      "id": 71404,
      "primary_message": "While the chicken cooks, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium head cauliflower\n1 ½ lemon\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 71403,
      "primary_message": "Quarter the cauliflower and remove the core and leaves; cut the quarters into bite-sized florets and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 71402,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 71401,
      "primary_message": "Once the chicken has been transferred, increase the heat to medium-high and add more olive oil to the skillet.",
      "secondary_message": "6 tbsp extra virgin olive oil"
    },
    {
      "id": 71400,
      "primary_message": "Add the garlic to the skillet and stir until fragrant, 15 to 30 seconds.",
      "secondary_message": ""
    },
    {
      "id": 71399,
      "primary_message": "Add the cauliflower to the skillet and season with salt and pepper; cook, stirring occasionally, until it is browned and tender when pierced with a fork, 7 to 10 minutes.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 71398,
      "primary_message": "Place the pine nuts in a medium bowl.",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 71397,
      "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add the parsley to the bowl with the pine nuts.",
      "secondary_message": ""
    },
    {
      "id": 71396,
      "primary_message": "Grate all of the zest from the lemons and add to the bowl with the pine nuts and parsley, then cut the lemon into wedges for serving.",
      "secondary_message": ""
    },
    {
      "id": 71395,
      "primary_message": "Add the pine nuts, parsley, lemon zest, and crushed red pepper to the cauliflower; stir to combine and remove from the heat.",
      "secondary_message": "⅜ tsp crushed red pepper"
    },
    {
      "id": 71394,
      "primary_message": "To serve, place the chicken and cauliflower mixture on a plate and garnish with the lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
