  "instructions": [
    {
      "id": 161695,
      "primary_message": "Using a strainer or colander, rinse rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 161696,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 161697,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ jalapeño peppers\n1 ½ (2 ½ cm) pieces ginger root\n1 ½ mangoes\n1 ½ limes\n3 crowns broccoli"
    },
    {
      "id": 161698,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely dice and add to a small saucepan. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 161699,
      "primary_message": "Peel and mince ginger; add to the pan with the jalapeños.",
      "secondary_message": null
    },
    {
      "id": 161700,
      "primary_message": "Peel mangoes and slice the flesh away from the pit, starting with the flat sides. Small dice and add to the pan.",
      "secondary_message": null
    },
    {
      "id": 161701,
      "primary_message": "Place the pan over medium heat. Add vinegar, water, sugar, and salt. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, for 5 minutes.",
      "secondary_message": "¾ cup rice vinegar\n¾ cup water\n3 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 161702,
      "primary_message": "Meanwhile, combine spices in a small bowl.",
      "secondary_message": "1 ½ tbsp chili powder\n1 ½ tsp cumin\n1 ½ tsp paprika\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 161703,
      "primary_message": "Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets. Rub each side with the spice mixture.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 161704,
      "primary_message": "Preheat a large grill pan or regular non-stick skillet over medium-high heat. Once the pan is hot, coat with oil.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 161705,
      "primary_message": "Working in batches if necessary, add chicken to the pan and cook until browned and cooked through, 3-4 minutes per side. Transfer to a plate and cover with foil.",
      "secondary_message": null
    },
    {
      "id": 161706,
      "primary_message": "Meanwhile, juice limes into a blender; add mango mixture and purée until smooth. Set aside.",
      "secondary_message": null
    },
    {
      "id": 161707,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 161708,
      "primary_message": "Return grill pan to medium heat and coat with more oil. Working in batches if necessary, add broccoli and cook, tossing occasionally, until crisp-tender, 7-8 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 161709,
      "primary_message": "To serve, divide rice, chicken, and broccoli between plates. Top chicken with mango sauce and enjoy!",
      "secondary_message": null
    }
  ],
