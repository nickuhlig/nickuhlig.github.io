  "instructions": [
    {
      "id": 161665,
      "primary_message": "Using a strainer or colander, rinse rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 161666,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 161667,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ jalapeño pepper\n½ (2 ½ cm) piece ginger root\n½ mango\n½ lime\n1 crown broccoli"
    },
    {
      "id": 161668,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to another small saucepan. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 161669,
      "primary_message": "Peel and mince ginger; add to the pan with the jalapeño.",
      "secondary_message": null
    },
    {
      "id": 161670,
      "primary_message": "Peel mango and slice the flesh away from the pit, starting with the flat sides. Small dice and add to the pan.",
      "secondary_message": null
    },
    {
      "id": 161671,
      "primary_message": "Place the pan over medium heat. Add vinegar, water, sugar, and salt. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, for 5 minutes.",
      "secondary_message": "¼ cup rice vinegar\n¼ cup water\n1 tbsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 161672,
      "primary_message": "Meanwhile, combine spices in a small bowl.",
      "secondary_message": "1 ½ tsp chili powder\n½ tsp cumin\n½ tsp paprika\n¼ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 161673,
      "primary_message": "Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets. Rub each side with the spice mixture.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 161674,
      "primary_message": "Preheat a grill pan or regular non-stick skillet over medium-high heat. Once the pan is hot, coat with oil.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 161675,
      "primary_message": "Add chicken to the pan and cook until browned and cooked through, 3-4 minutes per side. Transfer to a plate and cover with foil.",
      "secondary_message": null
    },
    {
      "id": 161676,
      "primary_message": "Meanwhile, juice lime into a blender; add mango mixture and purée until smooth. Set aside.",
      "secondary_message": null
    },
    {
      "id": 161677,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 161678,
      "primary_message": "Return grill pan to medium heat and coat with more oil. Add broccoli and cook, tossing occasionally, until crisp-tender, 5-6 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 161679,
      "primary_message": "To serve, divide rice, chicken, and broccoli between plates. Top chicken with mango sauce and enjoy!",
      "secondary_message": null
    }
  ],
