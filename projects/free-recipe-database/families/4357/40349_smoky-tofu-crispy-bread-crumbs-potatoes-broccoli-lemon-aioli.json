  "instructions": [
    {
      "id": 624465,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 624466,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 624467,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg new potatoes\n6 crowns broccoli\n1 ½ lemons"
    },
    {
      "id": 624468,
      "primary_message": "Halve new potatoes. Divide between two large baking sheets, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 624469,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until potatoes start to soften, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 624470,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a large bowl along with oil, salt, and pepper, then toss to coat. Set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 624471,
      "primary_message": "Place mayo and spices in a small bowl, then stir to combine.",
      "secondary_message": "3 tbsp mayonnaise\n¾ tsp smoked paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 624472,
      "primary_message": "Cut the tofu planks in half crosswise and place on a plate. Spread the mayo mixture over top side of the tofu, then sprinkle with bread crumbs, pressing gently to adhere. (Reserve bowl for later use.)",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 624473,
      "primary_message": "When the potatoes have started to soften, remove from oven. Add broccoli to the baking sheets, toss to combine, and spread back out in an even layer. Add breaded tofu to the baking sheets, nestling it into the veggies.",
      "secondary_message": null
    },
    {
      "id": 624474,
      "primary_message": "Return baking sheets to the oven; continue to roast until the tofu breading is golden and veggies are fork-tender, 12-15 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 624475,
      "primary_message": "Meanwhile, zest and juice lemons into the reserved bowl. Add mayo and spices, then stir to combine the lemon-pepper aioli.",
      "secondary_message": "¾ cup mayonnaise\n¾ tsp black pepper\n¼ tsp salt\n¼ tsp garlic powder"
    },
    {
      "id": 624476,
      "primary_message": "Divide tofu, potato, and broccoli between plates. Serve with lemon-pepper aioli on the side and enjoy!",
      "secondary_message": null
    }
  ],
