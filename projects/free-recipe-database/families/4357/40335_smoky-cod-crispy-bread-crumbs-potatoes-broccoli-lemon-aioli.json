  "instructions": [
    {
      "id": 624306,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 624307,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb new potatoes\n2 crowns broccoli\n½ lemon"
    },
    {
      "id": 624308,
      "primary_message": "Halve new potatoes. Transfer to a baking sheet pan, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder"
    },
    {
      "id": 624309,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until potatoes start to soften, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 624310,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a medium bowl along with oil, salt, and pepper, then toss to coat. Set aside. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 624311,
      "primary_message": "Place mayo and spices in a small bowl, then stir to combine.",
      "secondary_message": "1 tbsp mayonnaise\n¼ tsp smoked paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 624312,
      "primary_message": "Pat the cod dry with paper towels and place on a plate. Spread the mayo mixture over top side of the fish, then sprinkle with bread crumbs, pressing gently to adhere. (Reserve bowl for later use.)",
      "secondary_message": "¾ lb cod fillet\n¼ cup panko bread crumbs"
    },
    {
      "id": 624313,
      "primary_message": "When the potatoes have started to soften, remove from oven. Add broccoli to the baking sheet, toss to combine, and spread back out in an even layer. Add breaded fish to the baking sheet, nestling it into the veggies.",
      "secondary_message": null
    },
    {
      "id": 624314,
      "primary_message": "Return baking sheet to the oven; continue to roast until the fish is cooked through and veggies are fork-tender, 10-12 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 624315,
      "primary_message": "Meanwhile, zest and juice lemon into the reserved bowl. Add mayo and spices, then stir to combine the lemon-pepper aioli.",
      "secondary_message": "¼ cup mayonnaise\n¼ tsp black pepper\n⅛ tsp salt\n⅛ tsp garlic powder"
    },
    {
      "id": 624316,
      "primary_message": "Divide cod, potato, and broccoli between plates. Serve with lemon-pepper aioli on the side and enjoy!",
      "secondary_message": null
    }
  ],
