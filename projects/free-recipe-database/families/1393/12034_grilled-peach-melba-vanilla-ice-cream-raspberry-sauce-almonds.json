  "instructions": [
    {
      "id": 328715,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 (170 g) pkg raspberries\n2 peaches"
    },
    {
      "id": 328716,
      "primary_message": "Juice lemon into a blender. Add raspberries and sugar; blend on high speed for several minutes until smooth.",
      "secondary_message": "3 tbsp granulated sugar"
    },
    {
      "id": 328717,
      "primary_message": "Pour raspberry pureé into a strainer placed over a medium bowl. Using a silicone spatula, press pureé through the strainer to remove seeds; discard seeds and set sauce aside.",
      "secondary_message": null
    },
    {
      "id": 328718,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 328719,
      "primary_message": "Meanwhile, halve peaches lengthwise (around the pit) and twist the halves to separate, then remove and discard pits.",
      "secondary_message": null
    },
    {
      "id": 328720,
      "primary_message": "Once the grill pan is hot, coat the bottom with butter. Grill peach halves, cut-side down, until lightly charred, 2-3 minutes. Remove to a plate.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 328721,
      "primary_message": "To serve, divide raspberry sauce, peaches, and ice cream between bowls. Sprinkle with almonds and enjoy!",
      "secondary_message": "177 ml vanilla ice cream\n⅛ cup almonds, sliced"
    }
  ],
