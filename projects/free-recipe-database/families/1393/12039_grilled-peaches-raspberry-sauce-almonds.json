  "instructions": [
    {
      "id": 328750,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 (170 g) pkg raspberries\n6 peaches"
    },
    {
      "id": 328751,
      "primary_message": "Juice lemons into a blender. Add raspberries (reserving a small handful for garnish) and sugar; blend on high speed for several minutes until smooth.",
      "secondary_message": "½ cup granulated sugar"
    },
    {
      "id": 328752,
      "primary_message": "Pour raspberry pureé into a strainer placed over a large bowl. Using a silicone spatula, press pureé through the strainer to remove seeds; discard seeds and set sauce aside.",
      "secondary_message": null
    },
    {
      "id": 328753,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 328754,
      "primary_message": "Meanwhile, halve peaches lengthwise (around the pit) and twist the halves to separate, then remove and discard pits.",
      "secondary_message": null
    },
    {
      "id": 328755,
      "primary_message": "Once the grill pan is hot, coat the bottom with oil. Working in batches if necessary, grill peach halves, cut-side down, until lightly charred, 2-3 minutes. Remove to a plate.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 328756,
      "primary_message": "To serve, divide raspberry sauce and peaches between bowls. Garnish with reserved raspberries and sprinkle with almonds. Enjoy!",
      "secondary_message": "½ cup almonds, sliced"
    }
  ],
