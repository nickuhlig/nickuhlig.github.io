  "instructions": [
    {
      "id": 328687,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 (6 oz) pkgs raspberries\n6 peaches"
    },
    {
      "id": 328688,
      "primary_message": "Juice lemons into a blender. Add raspberries and sugar; blend on high speed for several minutes until smooth.",
      "secondary_message": "½ cup granulated sugar"
    },
    {
      "id": 328689,
      "primary_message": "Pour raspberry pureé into a strainer placed over a large bowl. Using a silicone spatula, press pureé through the strainer to remove seeds; discard seeds and set sauce aside.",
      "secondary_message": null
    },
    {
      "id": 328690,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 328691,
      "primary_message": "Meanwhile, halve peaches lengthwise (around the pit) and twist the halves to separate, then remove and discard pits.",
      "secondary_message": null
    },
    {
      "id": 328692,
      "primary_message": "Once the grill pan is hot, coat the bottom with butter. Working in batches if necessary, grill peach halves, cut-side down, until lightly charred, 2-3 minutes. Remove to a plate.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 328693,
      "primary_message": "To serve, divide raspberry sauce, peaches, and ice cream between bowls. Sprinkle with almonds and enjoy!",
      "secondary_message": "18 fl oz (2 ¼ cups) vanilla ice cream\n½ cup almonds, sliced"
    }
  ],
