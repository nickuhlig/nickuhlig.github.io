  "instructions": [
    {
      "id": 436554,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 436555,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 jalapeño pepper\n1 small bunch cilantro\n2 tomatoes"
    },
    {
      "id": 436556,
      "primary_message": "Juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 436557,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with oil, sugar, cumin, and salt. Whisk to combine the lime mixture.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n1 tsp brown sugar\n1 tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 436558,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the lime mixture. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 436559,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the jalapeño-cilantro sauce; set aside.",
      "secondary_message": null
    },
    {
      "id": 436560,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 436561,
      "primary_message": "Meanwhile, slice mozzarella and tomatoes into thin rounds.",
      "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 436562,
      "primary_message": "To serve, divide toast between plates. Top with mozzarella, tomatoes, and jalapeño-cilantro sauce. Enjoy!",
      "secondary_message": null
    }
  ],
