  "instructions": [
    {
      "id": 41571,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n1 small bunch green onions (scallions)"
    },
    {
      "id": 41572,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 41573,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and transfer to a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 41574,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 41575,
      "primary_message": "Add the sausages to the skillet; cook, turning occasionally, until they are browned on all sides and cooked through, 10 to 15 minutes total. Once done, transfer to a plate.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 41576,
      "primary_message": "While the sausages cook, trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the onion.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 41577,
      "primary_message": "Trim off and discard the root end of the cabbage; quarter the cabbage lengthwise, then thinly slice crosswise into shreds and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 41578,
      "primary_message": "Once the sausages have been transferred, add more coconut oil to the skillet followed by the onion and garlic. Cook, stirring frequently, until the onion is softened, 3 to 4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 41579,
      "primary_message": "Add the tomato paste and ½ cup of water to the skillet; mix together.",
      "secondary_message": "2 tbsp tomato paste"
    },
    {
      "id": 41580,
      "primary_message": "Add the cabbage to the skillet and season with crushed red pepper, salt, and pepper. Increase the heat to medium-high and cook, stirring frequently, until the cabbage is softened, 3 to 4 minutes.",
      "secondary_message": "¼ tsp crushed red pepper\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 41581,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle and transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 41582,
      "primary_message": "Slice the sausages into 6-mm-thick rounds.",
      "secondary_message": null
    },
    {
      "id": 41583,
      "primary_message": "Add the sausage slices and about ¾ of the green onions to the skillet; mix with the cabbage until well combined.",
      "secondary_message": null
    },
    {
      "id": 41584,
      "primary_message": "To serve, divide the cabbage and sausage mixture between bowls and sprinkle with the remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
