  "instructions": [
    {
      "id": 275009,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 bunches kale\n⅔ lb red grapes"
    },
    {
      "id": 275010,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 275011,
      "primary_message": "While the skillet heats up, juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 275012,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Once done, cover and remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n4 pre-cooked vegan sausage"
    },
    {
      "id": 275013,
      "primary_message": "Meanwhile, add oil, honey, salt, and pepper to the bowl with the lemon juice; whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 275014,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage the dressing into the kale.",
      "secondary_message": null
    },
    {
      "id": 275015,
      "primary_message": "Halve grapes and add to the bowl with the kale.",
      "secondary_message": null
    },
    {
      "id": 275016,
      "primary_message": "Small dice cheese and set aside for serving.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 275017,
      "primary_message": "Transfer sausages to a cutting board and slice crosswise into bite-sized rounds.",
      "secondary_message": null
    },
    {
      "id": 275018,
      "primary_message": "Add sausage and pumpkin seeds to the bowl with the kale; toss to combine the salad.",
      "secondary_message": "¼ cup pumpkin seeds"
    },
    {
      "id": 275019,
      "primary_message": "To serve, divide salad between plates and top with diced cheese. Enjoy!",
      "secondary_message": null
    }
  ],
