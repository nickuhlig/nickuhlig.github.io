  "instructions": [
    {
      "id": 22997,
      "primary_message": "Fill a large pot about halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 22998,
      "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stems into smaller pieces; transfer to a bowl. Add to boiling water and cook until very tender, 10-15 minutes. Drain in a colander, return to saucepan, and cover.",
      "secondary_message": "2 medium heads cauliflower\n"
    },
    {
      "id": 22999,
      "primary_message": "Wash and slice mushrooms.",
      "secondary_message": "1 lb white mushrooms\r\n"
    },
    {
      "id": 23000,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 23001,
      "primary_message": "Generously season steak with salt and pepper.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 23002,
      "primary_message": "Coat skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 23003,
      "primary_message": "Once steak has been transferred, reduce heat to medium and add butter and mushrooms to skillet. Cook, stirring occasionally, until tender, 3-4 minutes. Add vinegar and season with salt and pepper; cook until reduced, 2-3 minutes more. Remove from heat.",
      "secondary_message": "2 tbsp butter, unsalted\r\n2 tbsp balsamic vinegar\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23004,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\r\n"
    },
    {
      "id": 23005,
      "primary_message": "Add water, butter, salt, pepper, and about ½ of the parsley (save the rest for garnishing) to cauliflower. Blend using an immersion hand blender or a potato masher.",
      "secondary_message": "¼ cup water\r\n4 tbsp butter, unsalted\r\n1 tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 23006,
      "primary_message": "To serve, place cauliflower purée on a plate and top with steak and mushroom sauce. Sprinkle with remaining parsley and enjoy!",
      "secondary_message": ""
    }
  ],
