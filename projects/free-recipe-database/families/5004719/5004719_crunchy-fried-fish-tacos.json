  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the white fish into eight 2-ounce fingers. Warm the corn tortillas. Finely shred the cabbage. Pick the cilantro leaves from the stems and finely chop them. Cut the limes into wedges.",
      "secondary_message": "1 lb white fish\n16 corn tortillas\n1 small head cabbage\n½ cup fresh cilantro\n2 limes"
    },
    {
      "id": 1,
      "primary_message": "Combine flour, paprika, black pepper, and salt and whisk to combine. Transfer half of mixture to a large bowl and set aside. Add beer and egg to remaining mixture and whisk until a smooth batter is formed. Batter should have the consistency of thick paint (add up to 1/2 cup more beer as necessary until proper consistency is reached). Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine mayonnaise and hot sauce in a medium bowl and whisk until homogenous. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil in a deep fryer, Dutch oven, or large wok to 350°F. Transfer fish pieces to bowl with batter and turn to coat thoroughly. Working one piece at a time, lift fish, let excess batter drip off, then transfer to bowl with remaining flour mixture. Toss to coat thoroughly. Lift carefully with tongs or dry fingers and slowly lower into hot oil. Repeat with remaining fish.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Fry, turning occasionally, until golden brown on all sides, about 3 minutes total. Transfer to a paper towel-lined plate and season with salt.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Divide tortillas into 8 double stacks. Top each with shredded cabbage, 1 piece of fish, pickled red onions, chile mayo, and cilantro. Serve with lime wedges.",
      "secondary_message": null
    }
  ],
