  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Keep the unsalted butter frozen until you use it.",
      "secondary_message": "226 g unsalted butter, divided"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat the oven to 230°C (450°F) (230ºC).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using the large holes of a box grater, grate 1 stick frozen butter. In a medium bowl, toss together grated butter, flour, sugar, baking powder, baking soda, and salt until butter is thoroughly coated in flour mixture. Chill, uncovered, in the freezer for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add remaining butter to an 20-cm square aluminum baking pan. Place in preheated oven until melted, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Meanwhile: Using a flexible rubber spatula, stir buttermilk into the flour mixture until just combined (dough will be very sticky).",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Remove pan from oven. Carefully scrape dough into the prepared pan, and, using the same spatula, spread dough to the edges. Use a butter knife to cut the dough all the way through into 9 equal squares. Sprinkle flaky sea salt on top.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Bake until golden brown and a toothpick inserted in the center comes out clean, 22 to 24 minutes. Let the biscuits cool slightly in the baking pan before serving, about 5 minutes.",
      "secondary_message": null
    }
  ],
