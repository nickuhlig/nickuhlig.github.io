  "instructions": [
    {
      "id": 100686,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n1 ½ small bunches cilantro\n3 jalapeño peppers\n3 limes\n1 ½ avocados"
    },
    {
      "id": 100687,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 100688,
      "primary_message": "Heat a large pot over medium heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 100689,
      "primary_message": "Add half of the diced onions and salt to the pot; sauté until the onions are soft, about 4-5 minutes.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 100690,
      "primary_message": "Drain and rise the beans.",
      "secondary_message": "3 (15 oz) cans pinto beans"
    },
    {
      "id": 100691,
      "primary_message": "Add the beans, cumin, and water to the pot with the onions. Bring to a boil, then cover and simmer on low heat for 5 minutes.",
      "secondary_message": "1 ½ tsp cumin\n¾ cup water"
    },
    {
      "id": 100692,
      "primary_message": "Meanwhile, small dice the tomatoes and add to a large bowl. Add the other half of the diced onion to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 100693,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 100694,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely mince and add to the bowl with the tomatoes. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 100695,
      "primary_message": "Juice one and a half limes into the bowl with the tomatoes and add salt. Stir to combine the pico de gallo and set aside.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 100696,
      "primary_message": "Once the beans are done, remove from the heat and use a fork or potato masher to mash into small pieces. Juice remaining one and a half limes into the pot with the beans and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 100697,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 100698,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 100699,
      "primary_message": "Gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes. Once done, remove from heat and set aside. Cook in batches if necessary.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 100700,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out and set aside.",
      "secondary_message": null
    },
    {
      "id": 100701,
      "primary_message": "To assemble, divide the bean mixture on top of the tortillas. Top with the fried egg, pico de gallo, and sliced avocado. Enjoy!",
      "secondary_message": "6 small corn tortillas"
    }
  ],
