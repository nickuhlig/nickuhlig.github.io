  "instructions": [
    {
      "id": 100670,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 tomatoes\n1 small bunch cilantro\n2 jalapeño peppers\n2 limes\n1 avocado"
    },
    {
      "id": 100671,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 100672,
      "primary_message": "Heat a medium saucepan over medium heat. Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 100673,
      "primary_message": "Add half of the diced onions and salt to the saucepan; sauté until the onions are soft, about 4-5 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 100674,
      "primary_message": "Drain and rise the beans.",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "id": 100675,
      "primary_message": "Add the beans, cumin, and water to the saucepan with the onions. Bring to a boil, then cover and simmer on low heat for 5 minutes.",
      "secondary_message": "1 tsp cumin\n½ cup water"
    },
    {
      "id": 100676,
      "primary_message": "Meanwhile, small dice the tomatoes and add to a large bowl. Add the other half of the diced onion to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 100677,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 100678,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely mince and add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 100679,
      "primary_message": "Juice one lime into the bowl with the tomatoes and add salt. Stir to combine the pico de gallo and set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 100680,
      "primary_message": "Once the beans are done, remove from the heat and use a fork or potato masher to mash into small pieces. Juice the other lime into the saucepan with the beans and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 100681,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 100682,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 100683,
      "primary_message": "Gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes. Once done, remove from heat and set aside.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 100684,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out and set aside.",
      "secondary_message": null
    },
    {
      "id": 100685,
      "primary_message": "To assemble, divide the bean mixture on top of the tortillas. Top with the fried egg, pico de gallo, and sliced avocado. Enjoy!",
      "secondary_message": "4 small corn tortillas"
    }
  ],
