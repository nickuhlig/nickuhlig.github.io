  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 425°F. Place beets on a baking sheet. Roast until fork tender, about 1 hour depending on size of the beets. When cool enough to handle, peel beets and roughly chop.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place spinach, beets, goat cheese, and walnuts in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, whisk together olive oil and vinegar. Whisk in salt and pepper. Pour dressing over salad and toss to combine.",
      "secondary_message": null
    }
