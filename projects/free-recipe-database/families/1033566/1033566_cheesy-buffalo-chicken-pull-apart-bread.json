  "instructions": [
    {
      "primary_message": "Preheat oven to 375ºF. Beat cream cheese in a large bowl until smooth. Add sour cream, milk, hot sauce, ranch dressing, garlic powder, and onion powder and mix until smooth. Fold in chicken until evenly distributed.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cut bread loaf in a crosshatch pattern, making deep cuts without slicing all the way through to bottom.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Gently stuff Buffalo chicken mixture into cuts in bread, making sure to stuff to the bottom of each cut. Sprinkle cheddar cheese, mozzarella cheese, and blue cheese crumbles throughout and over top of each cut.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Drizzle and brush butter evenly over stuffed loaf. Wrap loosely with foil and bake 15 minutes. Uncover loaf and bake until cheese is bubbling and golden-brown at edges, an additional 10-12 minutes.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from oven and garnish with chives. Serve warm with additional ranch dressing.\n",
      "secondary_message": null
    },
    {
      "primary_message": "CHEF'S TIP: Substitute shredded, roasted chicken breast for rotisserie chicken.\n",
      "secondary_message": null
    }
  ],
