  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle and lower positions and preheat oven to 175°C (350°F). Line two baking sheets with parchment paper. In a medium bowl, whisk together flour, graham crumbs, baking soda, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, beat together butter, sugar, and brown sugar a handheld electric mixer until fluffy, 3 minutes. Beat in vanilla and egg. Add dry ingredients to bowl and beat just until dough comes together.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Use a rubber spatula to fold in Mallow Bits and chocolate. Drop dough by the rounded tablespoon onto prepared baking sheets. Bake cookies until golden, about 12 minutes. Let cool 3 minutes then transfer to a wire rack to finish cooling.",
      "secondary_message": null
    }
  ],
