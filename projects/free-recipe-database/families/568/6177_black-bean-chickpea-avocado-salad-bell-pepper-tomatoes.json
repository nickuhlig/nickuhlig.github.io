  "instructions": [
    {
      "id": 75061,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkg grape tomatoes\n3 yellow bell peppers\n3 avocados\n3 limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 75060,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans black beans\n3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 75070,
      "primary_message": "Grate all of the zest from the limes, then juice the limes; transfer both to a large bowl (that will hold the salad).",
      "secondary_message": ""
    },
    {
      "id": 75069,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 75068,
      "primary_message": "Add olive oil, cumin, salt, and pepper to the bowl; whisk together.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp cumin\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 75067,
      "primary_message": "Halve the grape tomatoes crosswise; add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 75066,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Medium dice the peppers and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 75065,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and medium dice the flesh. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 75064,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 75059,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces). Add to the bowl.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 75063,
      "primary_message": "Add the beans to the salad, then toss until the salad is thoroughly coated with the dressing.",
      "secondary_message": ""
    },
    {
      "id": 75062,
      "primary_message": "To serve, divide the salad between bowls and enjoy!",
      "secondary_message": ""
    }
  ],
