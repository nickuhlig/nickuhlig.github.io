  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely mince the shallot. Cut the grapefruit into segments. Cut the whole orange into segments.",
      "secondary_message": "1 small shallot\n1 grapefruit\n1 whole orange"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 190°C (375°F). Fold two 12- by 46-cm squares of heavy-duty aluminum foil in half cross-wise. Crimp the left and right edges to form a tight seal (leave the top open). Toss beets with 1 tablespoon olive oil and season with salt and pepper. Divide evenly between both foil pouches. Add 2 sprigs rosemary or thyme to each pouch, then tightly crimp top of pouch to seal.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place pouches on a rimmed baking sheet and place in oven. Cook until beets are completely tender and a cake tester or toothpick inserted into a beet through the foil pouch shows no resistance, about 1 hour. Open pouches and allow beets to cool for 30 minutes. Peel under cold running water (the skin should slip right off). Cut beets into rough 4-cm chunks.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine vinegar, agave nectar, half of pinenuts, and shallots in a medium bowl. Whisking constantly, slowly drizzle in remaining 4 tablespoons olive oil followed by walnut oil. Season dressing to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Toss beets with half of dressing in a large bowl, then transfer to a serving plate. Add grapefruit, orange, and arugula leaves to bowl along with 1 more tablespoon dressing. Toss and season to taste with salt and pepper. Transfer to serving plate with beets. Drizzle remaining dressing around beets, sprinkle with remaining pinenuts, top with orange zest, and serve.",
      "secondary_message": null
    }
  ],
