  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 220°C (425°F). Cut meat crosswise into 0.5-cm-thick pieces.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place sugar in a wide dish and dredge both sides of each bacon piece in sugar, pressing sugar firmly onto pieces with your fingers.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Arrange slices on a pan or skillet and bake, turning once, until bacon is cooked and browned, about 15 to 20 minutes. Serve warm or at room temperature.",
      "secondary_message": null
    }
