  "instructions": [
    {
      "primary_message": "Heat the oven to 400°F. Spray a baking sheet with cooking spray. Unroll the crust on the baking sheet.",
      "secondary_message": null
    },
    {
      "primary_message": "Stir the soup, broccoli and ham in a medium bowl. Spoon the soup mixture down the center of the crust. Sprinkle with the cheddar and Parmesan cheese. Fold the long sides of the crust up over the filling and pinch the edges to seal. Turn the stromboli seam-side down. Cut several slits in the top of the stromboli.",
      "secondary_message": null
    },
    {
      "primary_message": "Bake for 20 minutes or until the stromboli is golden brown.",
      "secondary_message": null
    }
