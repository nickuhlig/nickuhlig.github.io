  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine duck fat and canola oil in 2-cup liquid measuring cup. Whisk to combine.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add egg yolks, Dijon mustard, mayonnaise garlic, curry paste, and water to bowl of food processor (see note). Run processor for 5 seconds to combine. Scrape down sides of processor bowl with rubber spatula. With processor running, slowly drizzle fat into bowl in a thin, steady stream, stopping and scraping down sides as necessary. Add lime juice, salt, and pepper to taste, and adjust consistency with water until thick, smooth, and creamy, but not mouth-coatingly waxy. Stir in cilantro. Store in refrigerator in air-tight container for up to two weeks.",
      "secondary_message": null
    }
