  "instructions": [
    {
      "id": 375606,
      "primary_message": "Place eggs in a small saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 375607,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 tomato\n1 head romaine lettuce"
    },
    {
      "id": 375608,
      "primary_message": "Grate Parmesan into a medium bowl.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 375609,
      "primary_message": "Peel and mince garlic; add to bowl with the Parmesan.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 375610,
      "primary_message": "Mince anchovy fillet and add to the bowl.",
      "secondary_message": "1 anchovy fillet, packed in oil"
    },
    {
      "id": 375611,
      "primary_message": "Juice lemon into the bowl; add mayo, oil, Worcestershire, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n1 tbsp extra virgin olive oil\n½ tsp Worcestershire sauce\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 375612,
      "primary_message": "Medium dice tomato and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 375613,
      "primary_message": "When the eggs are cool enough to handle, peel and halve.",
      "secondary_message": null
    },
    {
      "id": 375614,
      "primary_message": "Scoop out the yolks and add to a small bowl along with mayo, Dijon, salt, and pepper. Using a fork, mash to combine, creating a smooth paste.",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 375615,
      "primary_message": "Spoon the yolk mixture back into the eggs and sprinkle with paprika.",
      "secondary_message": "¼ tsp paprika"
    },
    {
      "id": 375616,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces, add to the bowl with the dressing, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 375617,
      "primary_message": "To serve, divide salad and eggs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
