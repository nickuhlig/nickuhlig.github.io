  "instructions": [
    {
      "id": 375630,
      "primary_message": "Place eggs in a large pot, cover with water and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 375631,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 tomatoes\n3 heads romaine lettuce"
    },
    {
      "id": 375632,
      "primary_message": "Grate Parmesan into a large bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 375633,
      "primary_message": "Peel and mince garlic; add to bowl with the Parmesan.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 375634,
      "primary_message": "Mince anchovy fillets and add to the bowl.",
      "secondary_message": "3 anchovy fillets, packed in oil"
    },
    {
      "id": 375635,
      "primary_message": "Juice lemons into the bowl; add mayo, oil, Worcestershire, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¾ cup mayonnaise\n3 tbsp extra virgin olive oil\n1 ½ tsp Worcestershire sauce\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 375636,
      "primary_message": "Medium dice tomatoes and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 375637,
      "primary_message": "When the eggs are cool enough to handle, peel and halve.",
      "secondary_message": null
    },
    {
      "id": 375638,
      "primary_message": "Scoop out the yolks and add to a medium bowl along with mayo, Dijon, salt, and pepper. Using a fork, mash to combine, creating a smooth paste.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 375639,
      "primary_message": "Spoon the yolk mixture back into the eggs and sprinkle with paprika.",
      "secondary_message": "¾ tsp paprika"
    },
    {
      "id": 375640,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces, add to the bowl with the dressing, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 375641,
      "primary_message": "To serve, divide salad and eggs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
