  "instructions": [
    {
      "id": 375654,
      "primary_message": "Place eggs in a medium saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 375655,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 tomato\n2 heads romaine lettuce"
    },
    {
      "id": 375656,
      "primary_message": "Grate Parmesan into a large bowl.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 375657,
      "primary_message": "Peel and mince garlic; add to bowl with the Parmesan.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 375658,
      "primary_message": "Mince anchovy fillets and add to the bowl.",
      "secondary_message": "2 anchovy fillets, packed in oil"
    },
    {
      "id": 375659,
      "primary_message": "Juice lemon into the bowl; add mayo, oil, Worcestershire, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ cup avocado oil mayonnaise\n2 tbsp extra virgin olive oil\n1 tsp Worcestershire sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 375660,
      "primary_message": "Medium dice tomato and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 375661,
      "primary_message": "When the eggs are cool enough to handle, peel and halve.",
      "secondary_message": null
    },
    {
      "id": 375662,
      "primary_message": "Scoop out the yolks and add to a small bowl along with mayo, Dijon, salt, and pepper. Using a fork, mash to combine, creating a smooth paste.",
      "secondary_message": "¼ cup avocado oil mayonnaise\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 375663,
      "primary_message": "Spoon the yolk mixture back into the eggs and sprinkle with paprika.",
      "secondary_message": "½ tsp paprika"
    },
    {
      "id": 375664,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces, add to the bowl with the dressing, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 375665,
      "primary_message": "To serve, divide salad and eggs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
