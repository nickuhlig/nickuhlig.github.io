  "instructions": [
    {
      "id": 177695,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 177696,
      "primary_message": "Wash and chop the potatoes into ½-inch pieces. Divide between two large baking sheet pans along with the edamame; drizzle with oil, season with salt and pepper, and spread out in a single layer.",
      "secondary_message": "9 medium yellow potatoes\n3 cups edamame\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 177697,
      "primary_message": "Place the potatoes and edamame in the oven (it doesn't have to be fully heated) and bake until potatoes are fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 177698,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 avocados\n1 ½ small bunches fresh dill\n2 lemons\n3 small bunches asparagus"
    },
    {
      "id": 177699,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out into a large bowl. Mash well with a fork or potato masher.",
      "secondary_message": null
    },
    {
      "id": 177700,
      "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 177701,
      "primary_message": "Juice the lemons into the bowl. Add water, salt, and pepper, and whisk to combine the dressing; add more water, 1 Tbsp at a time, if needed to reach a creamy, dressing-like consistency.",
      "secondary_message": "⅓ cup water\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 177702,
      "primary_message": "Trim and cut asparagus into 2-inch pieces. Spread in an even layer on a third, large baking sheet pan; drizzle with oil, and season with salt and pepper.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 177703,
      "primary_message": "Remove potatoes and edamame from the oven and toss; return them to the oven, along with the sheet of asparagus. Cook until vegetables are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 177704,
      "primary_message": "Remove potatoes, edamame, and asparagus from the oven and carefully add to the bowl with the dressing; toss well to combine.",
      "secondary_message": null
    },
    {
      "id": 177705,
      "primary_message": "To serve, divide potato salad between dishes, top with pine nuts, and enjoy!",
      "secondary_message": "¾ cup pine nuts"
    }
  ],
