  "instructions": [
    {
      "id": 256426,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 medium zucchini squash\n1 small bunch cilantro"
    },
    {
      "id": 256427,
      "primary_message": "Peel and small dice onions; transfer to a large bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 256428,
      "primary_message": "Peel, trim, and small dice carrots; add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 256429,
      "primary_message": "Trim and small dice zucchini; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256430,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 256431,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 256432,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, curry powder, and salt to the pot; cook, stirring often, until starting to soften, about 5 minutes.",
      "secondary_message": "¼ cup virgin coconut oil\n¼ cup curry powder\n1 tbsp salt"
    },
    {
      "id": 256433,
      "primary_message": "Add broth, coconut milk, tomatoes, and lentils to the pot; stir to combine, cover, and bring to a boil. ",
      "secondary_message": "2129 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk\n1 ½ (398 ml) cans diced tomatoes\n2 ¼ cup red lentils, dried"
    },
    {
      "id": 256434,
      "primary_message": "Once the soup is boiling, reduce heat to medium-low; simmer, stirring occasionally, until lentils and veggies are tender, 15-20 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 256435,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 256436,
      "primary_message": "When the soup is done, add cilantro and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 256437,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
