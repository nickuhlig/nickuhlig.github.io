  "instructions": [
    {
      "id": 256414,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 medium zucchini squash\n1 small bunch cilantro"
    },
    {
      "id": 256415,
      "primary_message": "Peel and small dice onion; transfer to a medium bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 256416,
      "primary_message": "Peel, trim, and small dice carrots; add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 256417,
      "primary_message": "Trim and small dice zucchini; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256418,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 256419,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 256420,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, garlic, curry powder, and salt to the pot; cook, stirring often, until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil\n3 tbsp curry powder\n2 tsp salt"
    },
    {
      "id": 256421,
      "primary_message": "Add broth, coconut milk, tomatoes, and lentils to the pot; stir to combine, cover, and bring to a boil. ",
      "secondary_message": "1420 ml chicken or vegetable broth\n1 (398 ml) can coconut milk\n1 (398 ml) can diced tomatoes\n1 ½ cup red lentils, dried"
    },
    {
      "id": 256422,
      "primary_message": "Once the soup is boiling, reduce heat to medium-low; simmer, stirring occasionally, until lentils and veggies are tender, about 15 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 256423,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 256424,
      "primary_message": "When the soup is done, add cilantro and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 256425,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
