  "instructions": [
    {
      "id": 66565,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 66564,
      "primary_message": "In a small bowl, whisk together the minced garlic, lemon juice, olive oil, vinegar, oregano, salt, and pepper.",
      "secondary_message": "juice of ¾ lemon\n9 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n1 ½ tsp oregano\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 66563,
      "primary_message": "Cube the chicken and transfer to a medium bowl. Pour half of the dressing over top (save the rest for the salad) and toss to coat.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 66562,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 66561,
      "primary_message": "Thread the chicken onto 6 skewers. Alternatively, you can cook the chicken pieces directly on the grill/skillet without using skewers.",
      "secondary_message": ""
    },
    {
      "id": 66560,
      "primary_message": "Add the chicken to the grill or skillet and cook, turning occasionally, until cooked through, 8-10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 66559,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ head romaine lettuce\n1 ½ English cucumber\n1 ½ pint grape tomatoes"
    },
    {
      "id": 66556,
      "primary_message": "Finely dice ¼ of the cucumber. Peel and mince the remaining garlic. In a small bowl, prepare the tzatziki sauce by mixing together the cucumber, garlic, lemon juice, yogurt, and salt.",
      "secondary_message": "3 cloves garlic\njuice of ¾ lemon\n1 ½ cup plain Greek yogurt\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 66555,
      "primary_message": "Halve the lettuce lengthwise, then chop crosswise into 1 inch strips; transfer to a salad bowl. Quarter the remaining cucumbers lengthwise, then cut crosswise into chunks; add to the bowl. Halve the tomatoes; add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 66558,
      "primary_message": "Add the olives, feta, and reserved dressing to the salad and toss.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n1 ½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 66557,
      "primary_message": "To serve, place salad on a plate and add a chicken skewer on top. Serve with tzatziki sauce and enjoy!",
      "secondary_message": ""
    }
  ],
