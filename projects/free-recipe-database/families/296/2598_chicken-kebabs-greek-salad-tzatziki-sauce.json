  "instructions": [
    {
      "id": 25163,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "2 cloves garlic \r\n"
    },
    {
      "id": 25164,
      "primary_message": "In a small bowl, whisk together the minced garlic, lemon juice, olive oil, vinegar, oregano, salt, and pepper.",
      "secondary_message": "juice of ¼ lemon\r\n3 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n½ tsp oregano\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25165,
      "primary_message": "Cube the chicken and transfer to a medium bowl. Pour half of the dressing over top (save the rest for the salad) and toss to coat.",
      "secondary_message": "0.227 kg chicken breasts, boneless skinless\r\n"
    },
    {
      "id": 25166,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 25167,
      "primary_message": "Thread the chicken onto 2 skewers. Alternatively, you can cook the chicken pieces directly on the grill/skillet without using skewers.",
      "secondary_message": ""
    },
    {
      "id": 25168,
      "primary_message": "Add the chicken to the grill or skillet and cook, turning occasionally, until cooked through, 8-10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25169,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ head romaine lettuce\n½ English cucumber\n½ small pkg grape tomatoes"
    },
    {
      "id": 25170,
      "primary_message": "Finely dice ¼ of the cucumber. Peel and mince the remaining garlic. In a small bowl, prepare the tzatziki sauce by mixing together the cucumber, garlic, lemon juice, yogurt, and salt.",
      "secondary_message": "1 clove garlic\njuice of ¼ lemon\n½ cup plain Greek yogurt\n¼ tsp salt\n¼ tsp black pepper "
    },
    {
      "id": 25171,
      "primary_message": "Chop the lettuce crosswise into 2 ½ cm strips; transfer to a salad bowl. Quarter the remaining cucumber lengthwise, then cut crosswise into chunks; add to the bowl. Halve the tomatoes; add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 25172,
      "primary_message": "Add the olives, feta, and reserved dressing to the salad and toss.",
      "secondary_message": "¼ cup Kalamata olives, pitted\r\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 25173,
      "primary_message": "To serve, place salad on a plate and add a chicken skewer on top. Serve with tzatziki sauce and enjoy!",
      "secondary_message": ""
    }
  ],
