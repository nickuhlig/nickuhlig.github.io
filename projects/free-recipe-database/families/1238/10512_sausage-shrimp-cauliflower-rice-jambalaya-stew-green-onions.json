  "instructions": [
    {
      "id": 168790,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 168791,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 168792,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Remove sausages to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 pork sausages"
    },
    {
      "id": 168793,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n3 green bell peppers\n1 ½ medium heads cauliflower\n1 small bunch green onions (scallions)"
    },
    {
      "id": 168794,
      "primary_message": "Combine spices in a large bowl.",
      "secondary_message": "1 tbsp garlic powder\n1 tbsp onion powder\n2 tsp thyme\n1 ½ tsp basil\n1 ½ tsp oregano\n1 ½ tsp salt\n1 ½ tsp paprika\n1 ½ tsp chili powder\n¾ tsp black pepper\n⅜ tsp cayenne pepper"
    },
    {
      "id": 168795,
      "primary_message": "Peel and medium dice onions; add to the bowl with the spices.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 168796,
      "primary_message": "Slice celery crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 168797,
      "primary_message": "Seed and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 168798,
      "primary_message": "Return the pot (with leftover oil from cooking) to medium-high heat. Add chopped veggies and spices from the bowl; cook, stirring often, until veggies begin to soften, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 168799,
      "primary_message": "Meanwhile, cut cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 168800,
      "primary_message": "Peel and mince garlic. Add to the pot along with the cauliflower, broth, tomatoes, and tomato paste. Bring mixture to a boil over high heat.",
      "secondary_message": "6 cloves garlic\n710 ml chicken or vegetable broth\n1 ½ (398 ml) cans diced tomatoes\n3 tbsp tomato paste"
    },
    {
      "id": 168801,
      "primary_message": "Slice sausages into ½-inch thick rounds; add back to the pot, along with the shrimp. Cook, stirring often, until shrimp are opaque and cauliflower is tender, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 168802,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces. Stir half of the onions into the pot (reserve the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 168803,
      "primary_message": "To serve, divide jambalaya between bowls and top with remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
