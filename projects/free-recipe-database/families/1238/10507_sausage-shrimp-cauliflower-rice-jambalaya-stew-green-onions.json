  "instructions": [
    {
      "id": 168720,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 168721,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 168722,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until golden brown and cooked through, 6-8 minutes. Remove sausages to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 pork sausages"
    },
    {
      "id": 168723,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 green bell pepper\n½ medium head cauliflower\n½ small bunch green onions (scallions)"
    },
    {
      "id": 168724,
      "primary_message": "Combine spices in a medium bowl.",
      "secondary_message": "1 tsp garlic powder\n1 tsp onion powder\n¾ tsp thyme\n½ tsp basil\n½ tsp oregano\n½ tsp salt\n½ tsp paprika\n½ tsp chili powder\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 168725,
      "primary_message": "Peel and medium dice onion; add to the bowl with the spices.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 168726,
      "primary_message": "Slice celery crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 168727,
      "primary_message": "Seed and medium dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 168728,
      "primary_message": "Return the pot (with leftover oil from cooking) to medium-high heat. Add chopped veggies and spices from the bowl; cook, stirring often, until veggies begin to soften, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 168729,
      "primary_message": "Meanwhile, cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 168730,
      "primary_message": "Peel and mince garlic. Add to the pot along with the cauliflower, broth, tomatoes, and tomato paste. Bring mixture to a boil over high heat.",
      "secondary_message": "2 cloves garlic\n8 fl oz (1 cup) chicken or vegetable broth\n½ (14.5 oz) can diced tomatoes\n1 tbsp tomato paste"
    },
    {
      "id": 168731,
      "primary_message": "Slice sausages into ½-inch thick rounds; add back to the pot, along with the shrimp. Cook, stirring often, until shrimp are opaque and cauliflower is tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 168732,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces. Stir half of the onions into the pot (reserve the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 168733,
      "primary_message": "To serve, divide jambalaya between bowls and top with remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
