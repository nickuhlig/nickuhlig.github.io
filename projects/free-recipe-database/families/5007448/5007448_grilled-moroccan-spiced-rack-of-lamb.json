  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the cilantro leaves from the stems and finely chop them. Pick the parsley leaves from the stems and finely chop them. Juice the lemons.",
      "secondary_message": "⅓ cup fresh cilantro\n⅓ cup fresh parsley\n1 ½ lemons"
    },
    {
      "id": 1,
      "primary_message": "For the Herb Mixture: Combine cilantro, parsley, lemon juice, olive oil, and garlic in a medium bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Spice Rub: Combine paprika, salt, cumin, coriander, black pepper, cinnamon, and cayenne in a small bowl. Season racks of lamb all over with spice mixture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Place racks of lamb over hot side of the grill, fat side down, and cook until well browned, 3-5 minutes. Transfer lamb to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Brush a thin layer of mustard over the fat side of each rack of lamb. Carefully press the herb and lemon mixture into the mustard on each rack, distributing it evenly.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Return racks to grill, fat side up, close to, but not directly over, the coals. Continue to cook until an instant-read thermometer registers 130°F when inserted into the side of the rack, 15 to 25 minutes. Remove from grill and let rest uncovered for 10 minutes. Slice between ribs into chops and serve immediately.",
      "secondary_message": null
    }
  ],
