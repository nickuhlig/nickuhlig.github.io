  "instructions": [
    {
      "id": 146895,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n1 ½ medium heads cauliflower\n3 (2 ½ cm) pieces ginger root\n3 tomatoes\n1 ½ small bunches cilantro\n3 avocados"
    },
    {
      "id": 146896,
      "primary_message": "Peel and medium dice the carrots and onions; place both in a large bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 146897,
      "primary_message": "Trim off and discard the leaves and thick stem of the cauliflower heads, then roughly chop it into bite-sized pieces; add to the bowl with the carrot and onion.",
      "secondary_message": null
    },
    {
      "id": 146898,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 146899,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 146900,
      "primary_message": "Add veggies and cook, stirring occasionally, until soft, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 146901,
      "primary_message": "Meanwhile, peel and mince or grate the ginger; peel and mince the garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 146902,
      "primary_message": "Coarsely chop the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 146903,
      "primary_message": "Once the veggies are soft, add the ginger, garlic, and tomatoes to the pot. Cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 146904,
      "primary_message": "Stir in broth, water, lentils, and spices. Cover and bring to a boil. Reduce heat to a simmer and cook until lentils are tender, about 15 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n6 cup water\n1 ½ cup red lentils\n1 tbsp cumin\n¾ tsp cayenne pepper\n¾ tsp salt"
    },
    {
      "id": 146905,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 146906,
      "primary_message": "Place cilantro, yogurt, and salt in a medium bowl; whisk to combine.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n⅜ tsp salt"
    },
    {
      "id": 146907,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 146908,
      "primary_message": "Using an immersion (hand) blender, process the soup until smooth. Alternatively, transfer soup to a regular blender and blend on high until smooth.",
      "secondary_message": null
    },
    {
      "id": 146909,
      "primary_message": "To serve, divide the soup between bowls and top with yogurt and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
