  "instructions": [
    {
      "id": 146865,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n½ medium head cauliflower\n1 (2 ½ cm) piece ginger root\n1 tomato\n½ small bunch cilantro\n1 avocado"
    },
    {
      "id": 146866,
      "primary_message": "Peel and medium dice the carrot and onion; place both in a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 146867,
      "primary_message": "Trim off and discard the leaves and thick stem of the cauliflower, then roughly chop it into bite-sized pieces; add to the bowl with the carrot and onion.",
      "secondary_message": null
    },
    {
      "id": 146868,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 146869,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 146870,
      "primary_message": "Add veggies and cook, stirring occasionally, until soft, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 146871,
      "primary_message": "Meanwhile, peel and mince or grate the ginger; peel and mince the garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 146872,
      "primary_message": "Coarsely chop the tomato.",
      "secondary_message": null
    },
    {
      "id": 146873,
      "primary_message": "Once the veggies are soft, add the ginger, garlic, and tomato to the pan. Cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 146874,
      "primary_message": "Stir in broth, water, lentils, and spices. Cover and bring to a boil. Reduce heat to a simmer and cook until lentils are tender, about 15 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n2 cup water\n½ cup red lentils\n1 tsp cumin\n¼ tsp cayenne pepper\n¼ tsp salt"
    },
    {
      "id": 146875,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 146876,
      "primary_message": "Place cilantro, yogurt, and salt in a small bowl; whisk to combine.",
      "secondary_message": "½ cup plain Greek yogurt\n⅛ tsp salt"
    },
    {
      "id": 146877,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 146878,
      "primary_message": "Using an immersion (hand) blender, process the soup until smooth. Alternatively, transfer soup to a regular blender and blend on high until smooth.",
      "secondary_message": null
    },
    {
      "id": 146879,
      "primary_message": "To serve, divide the soup between bowls and top with yogurt and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
