  "instructions": [
    {
      "id": 270393,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 270394,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n¾ lb sweet potato\n½ small bunch green onions (scallions)"
    },
    {
      "id": 270395,
      "primary_message": "Trim, seed, and medium dice bell peppers; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 270396,
      "primary_message": "Peel and cut sweet potato into ½-inch cubes; add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 270397,
      "primary_message": "Peel, halve, and large dice onion. Add to the bowl along with oil, salt, and pepper; toss to combine, transfer to a baking sheet pan, and spread out in an even layer.",
      "secondary_message": "½ medium red onion\n1 tbsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 270398,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden brown and fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 270399,
      "primary_message": "Meanwhile, coarsely grate mozzarella and set aside.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 270400,
      "primary_message": "Preheat a small saucepan over medium heat. Once the pan is hot, add oil and flour; whisk until combined, about 1 minute.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tbsp all-purpose flour"
    },
    {
      "id": 270401,
      "primary_message": "Add broth and spices to the pan; cook, whisking frequently, until thickened, 2-3 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ tsp salt\n½ tsp coriander, ground\n⅛ tsp black pepper"
    },
    {
      "id": 270402,
      "primary_message": "Add mozzarella and yogurt to the pan; whisk until cheese is melted and combined. Cover sauce and set over low heat, stirring occasionally, to keep warm.",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 270403,
      "primary_message": "Drain and rinse beans in a colander.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 270404,
      "primary_message": "When the veggies are done, remove from the oven, add beans, and stir to combine. Return baking sheet to the oven and bake until beans are warmed through, 2-3 minutes more; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 270405,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 270406,
      "primary_message": "To serve, divide roasted veggies and beans between bowls; top with cheese sauce and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
