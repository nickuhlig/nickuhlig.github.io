  "instructions": [
    {
      "id": 270463,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 270464,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 green bell peppers\n1.02 kg sweet potatoes\n1 small bunch green onions (scallions)"
    },
    {
      "id": 270465,
      "primary_message": "Trim, seed, and medium dice bell peppers; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 270466,
      "primary_message": "Peel and cut sweet potatoes into ½-inch cubes; add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 270467,
      "primary_message": "Peel, halve, and large dice onions. Add to the bowl along with oil, salt, and pepper; toss to combine, divide between two baking sheet pans, and spread out in an even layer.",
      "secondary_message": "1 ½ medium red onions\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 270468,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden brown and fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 270469,
      "primary_message": "Meanwhile, coarsely grate mozzarella and set aside.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 270470,
      "primary_message": "Preheat a medium saucepan over medium heat. Once the pan is hot, add oil and flour; whisk until combined, about 1 minute.",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup all-purpose flour"
    },
    {
      "id": 270471,
      "primary_message": "Add broth and spices to the pan; cook, whisking frequently, until thickened, 3-4 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ tsp salt\n1 ½ tsp coriander, ground\n½ tsp black pepper"
    },
    {
      "id": 270472,
      "primary_message": "Add mozzarella and yogurt to the pan; whisk until cheese is melted and combined. Cover sauce and set over low heat, stirring occasionally, to keep warm.",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 270473,
      "primary_message": "Drain and rinse beans in a colander.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 270474,
      "primary_message": "When the veggies are done, remove from the oven, add beans, and stir to combine. Return baking sheets to the oven and bake until beans are warmed through, 3-4 minutes more; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 270475,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 270476,
      "primary_message": "To serve, divide roasted veggies and beans between bowls; top with cheese sauce and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
