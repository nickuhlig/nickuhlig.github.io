  "instructions": [
    {
      "id": 424206,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 424207,
      "primary_message": "While the pot heats up, place butternut squash in a colander and rinse under hot water (from the tap) to defrost.",
      "secondary_message": "6 cup frozen butternut squash, pieces"
    },
    {
      "id": 424208,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add squash and gnocchi to the pot; cook, stirring occasionally, until gnocchi is starting to brown, 5-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 (16 oz) pkgs potato gnocchi"
    },
    {
      "id": 424209,
      "primary_message": "Add broth to the pot, cover, and bring to a simmer. Once simmering, reduce heat to medium and continue to cook until squash and gnocchi are tender and most of the liquid has been absorbed, 3-4 minutes more.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 424210,
      "primary_message": "Meanwhile, roughly chop walnuts. Set aside.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 424211,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 424212,
      "primary_message": "When the squash and gnocchi are done, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 424213,
      "primary_message": "Add walnuts, pesto, and Parmesan to the pot. Stir to combine and remove from heat.",
      "secondary_message": "¾ cup basil pesto\n¾ cup Parmesan cheese, shredded"
    },
    {
      "id": 424214,
      "primary_message": "To serve, divide gnocchi between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
