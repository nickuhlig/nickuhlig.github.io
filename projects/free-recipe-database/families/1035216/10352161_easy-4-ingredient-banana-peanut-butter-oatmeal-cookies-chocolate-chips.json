  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Line a large baking sheet pan with parchment paper.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place bananas in a medium bowl and mash with a fork or potato masher.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add oats, peanut butter, and chocolate chips to the bowl with the mashed banana, then stir well to combine. Use a measuring cup or cookie scoop to portion out the dough on the baking sheet, about a ¼-cup for each cookie, spacing the cookies a ½-inch apart. Gently press each cookie with the bottom of a measuring cup to flatten slightly (they should be about a ½-inch thick).\n\n",
      "secondary_message": "2 cups oats, quick cooking\n½ cup natural peanut butter\n⅓ cup dark chocolate chips"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until cookies are golden, 12-15 minutes. Remove from oven and set aside to cool slightly, about 5 minutes. (The cookies will firm up as they cool.)\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer cookies to a platter, share, and enjoy!",
      "secondary_message": null
    }
  ],
