  "instructions": [
    {
      "id": 198653,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 198654,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 198655,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "9 medium beets\n6 medium carrots\n1 ½ (227 g) pkg sugar snap peas\n1 ½ avocados\n1 small pkg chives\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 198656,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 198657,
      "primary_message": "Trim, peel, and cut beets into ½-inch cubes. Divide between two baking sheet pans, drizzle with oil, season with salt and pepper, and toss to coat.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 198658,
      "primary_message": "Spread beets out in an even layer; place in the oven (it doesn't have to be fully heated), and roast, stirring halfway through, until fork-tender, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 198659,
      "primary_message": "Meanwhile, place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 198660,
      "primary_message": "Peel and grate carrots; transfer to a large platter.",
      "secondary_message": null
    },
    {
      "id": 198661,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces at an angle; add to the platter.",
      "secondary_message": null
    },
    {
      "id": 198662,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out onto the platter. Set veggies aside.",
      "secondary_message": null
    },
    {
      "id": 198663,
      "primary_message": "Place mayo, water, tahini, and salt in a small bowl. Whisk to combine the sesame mayo and set aside.",
      "secondary_message": "½ cup vegan mayonnaise\n⅓ cup water\n3 tbsp tahini\n3 pinch salt"
    },
    {
      "id": 198664,
      "primary_message": "Mince chives. Peel and mince ginger and garlic. Place in a large bowl along with vinegar, soy sauce, and maple syrup. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp apple cider vinegar\n2 tbsp soy sauce\n1 tbsp pure maple syrup"
    },
    {
      "id": 198665,
      "primary_message": "Transfer roasted beets to the bowl with the dressing and toss to combine the \"poke.\"",
      "secondary_message": null
    },
    {
      "id": 198666,
      "primary_message": "To serve, divide rice between bowls. Arrange beet \"poke,\" edamame, and veggies on top. Drizzle with sesame mayo and enjoy!",
      "secondary_message": null
    }
  ],
