  "instructions": [
    {
      "id": 324599,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 324600,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n1 ½ pints grape tomatoes\n1 small pkg fresh basil\n1 ½ lemons"
    },
    {
      "id": 324601,
      "primary_message": "Peel, halve, and large dice onions; divide between two baking sheet pans.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 324602,
      "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into ¼-inch thick pieces; add to the baking sheets with the onion, along with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 324603,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies, then drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n1 ½ tsp oregano, dried\n¾ tsp thyme, dried\n¾ tsp rosemary, dried"
    },
    {
      "id": 324604,
      "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides. Add chicken to the baking sheets and nestle into the veggies.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 324605,
      "primary_message": "Place baking sheets in the oven and roast until veggies are tender and chicken is cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 324606,
      "primary_message": "Meanwhile, roughly chop olives; pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 324607,
      "primary_message": "Just before serving, add olives and basil to the baking sheets. Juice lemons over the veggies and chicken; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 324608,
      "primary_message": "To serve, divide veggies and chicken thighs between plates; crumble goat cheese over veggies. Enjoy!",
      "secondary_message": "3 (4 oz) logs goat cheese"
    }
  ],
