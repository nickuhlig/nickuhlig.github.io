  "instructions": [
    {
      "id": 324851,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 324852,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n1 small pkg grape tomatoes\n1 small pkg fresh basil\n1 lemon"
    },
    {
      "id": 324853,
      "primary_message": "Peel, halve, and large dice onion; transfer to a large baking sheet pan.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 324854,
      "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into ¼-inch thick pieces; add to the baking sheet with the onion, along with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 324855,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies, then drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "4 cloves garlic\n4 tsp extra virgin olive oil\n1 tsp salt\n1 tsp oregano, dried\n½ tsp thyme, dried\n½ tsp rosemary, dried"
    },
    {
      "id": 324856,
      "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides. Add chicken to the baking sheet and nestle into the veggies.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 324857,
      "primary_message": "Place baking sheet in the oven and roast until veggies are tender and chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 324858,
      "primary_message": "Meanwhile, roughly chop olives; pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 324859,
      "primary_message": "Just before serving, add olives and basil to the baking sheet. Juice lemon over the veggies and chicken; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 324860,
      "primary_message": "To serve, divide veggies and chicken thighs between plates; crumble goat cheese over veggies. Enjoy!",
      "secondary_message": "2 (113 g) logs goat cheese"
    }
  ],
