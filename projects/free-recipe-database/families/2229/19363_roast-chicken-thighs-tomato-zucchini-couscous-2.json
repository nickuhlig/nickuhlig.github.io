  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "In a large pot, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous\nsalt"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 pints grape tomatoes\n1 small pkg fresh basil\n1 ½ lemons"
    },
    {
      "primary_message": "Peel, halve, and large dice onions; divide between two baking sheet pans.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into ¼-inch thick pieces; add to the baking sheets with the onion, along with the tomatoes.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic; sprinkle over the veggies, then drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n2 tbsp extra virgin olive oil\nsalt\n1 ½ tsp oregano, dried\n¾ tsp rosemary, dried\n¾ tsp thyme, dried"
    },
    {
      "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides. Add chicken to the baking sheets and nestle into the veggies.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\nsalt\n¾ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheets in the oven and roast until veggies are tender and chicken is cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, roughly chop olives; pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add both to the pot with the couscous.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "primary_message": "Juice lemons into the pot and stir to combine. Cover to keep warm.",
      "secondary_message": null
    },
    {
      "primary_message": "Just before serving, transfer roasted veggies to the pot with the couscous and stir to combine.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide veggie couscous and chicken thighs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
