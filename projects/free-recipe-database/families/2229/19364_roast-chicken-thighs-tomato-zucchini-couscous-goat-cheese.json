  "instructions": [
    {
      "id": 324791,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 324792,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous\n⅛ tsp salt"
    },
    {
      "id": 324793,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 small pkg grape tomatoes\n½ small pkg fresh basil\n½ lemon"
    },
    {
      "id": 324794,
      "primary_message": "Peel, halve, and large dice onion; transfer to a baking sheet pan.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 324795,
      "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into ¼-inch thick pieces; add to the baking sheet with the onion, along with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 324796,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies, then drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp oregano, dried\n¼ tsp rosemary, dried\n¼ tsp thyme, dried"
    },
    {
      "id": 324797,
      "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides. Add chicken to the baking sheet and nestle into the veggies.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 324798,
      "primary_message": "Place baking sheet in the oven and roast until veggies are tender and chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 324799,
      "primary_message": "Meanwhile, roughly chop olives; pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add both to the pan with the couscous.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 324800,
      "primary_message": "Juice lemon into the pan and stir to combine. Cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 324801,
      "primary_message": "Just before serving, transfer roasted veggies to the saucepan with the couscous and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 324802,
      "primary_message": "To serve, divide veggie couscous and chicken thighs between plates; crumble goat cheese over couscous. Enjoy!",
      "secondary_message": "½ (113 g) log goat cheese"
    }
  ],
