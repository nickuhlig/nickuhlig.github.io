  "instructions": [
    {
      "id": 606741,
      "primary_message": "Preheat oven to 220°C (425°F). Place oven racks in the upper and middle positions.",
      "secondary_message": null
    },
    {
      "id": 606742,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 red bell peppers\n½ lemon\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 606743,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 606744,
      "primary_message": "Peel and mince garlic. Add to the baking sheet with the peppers, drizzle with oil, then season with salt and pepper. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 606745,
      "primary_message": "Place baking sheet on the upper rack of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until peppers are browned and fork-tender, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 606746,
      "primary_message": "Meanwhile, arrange flatbreads on another baking sheet. Place on the lower rack and bake, flipping halfway through, until flatbreads are slightly crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 606747,
      "primary_message": "While the flatbreads are baking, juice lemon into a medium bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 606748,
      "primary_message": "When the flatbreads are almost done, add arugula to the bowl with the dressing and toss to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 606749,
      "primary_message": "Spread goat cheese over each flatbread, then top with roasted peppers and a small handful of arugula. (Reserve remaining arugula for serving.)",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "id": 606750,
      "primary_message": "To serve, divide flatbreads and remaining arugula between plates. Enjoy!",
      "secondary_message": null
    }
  ],
