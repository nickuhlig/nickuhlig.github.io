  "instructions": [
    {
      "id": 606731,
      "primary_message": "Preheat oven to 425°F. Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 606732,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 red bell peppers\n1 ½ lemons\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 606733,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 606734,
      "primary_message": "Peel and mince garlic. Add to the baking sheet with the peppers, drizzle with oil, then season with salt and pepper. Stir to combine and spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 606735,
      "primary_message": "Place baking sheet on the upper rack of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until peppers are browned and fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 606736,
      "primary_message": "Meanwhile, divide flatbreads between two additional large baking sheets. Place on the middle and lower racks and bake, flipping halfway through, until slightly crispy, about 10 minutes. Remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 606737,
      "primary_message": "While the flatbreads are baking, juice lemons into a large bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 606738,
      "primary_message": "When the flatbreads are almost done, add arugula to the bowl with the dressing and toss to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 606739,
      "primary_message": "Spread goat cheese over each flatbread, then top with roasted peppers and a small handful of arugula. (Reserve remaining arugula for serving.)",
      "secondary_message": "3 (4 oz) logs goat cheese"
    },
    {
      "id": 606740,
      "primary_message": "To serve, divide flatbreads and remaining arugula between plates. Enjoy!",
      "secondary_message": null
    }
  ],
