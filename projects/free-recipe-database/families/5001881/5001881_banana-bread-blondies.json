  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Grease and line a 9x9-inch baking pan with parchment paper, letting the parchment overhang on 2 sides by at least 1 inch. Line a rimmed baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place whole bananas still in their peels on prepared baking sheet. Bake until banana peels are darkened in color, about 15 minutes. Remove from oven and allow to slightly cool, about 5 minutes. Carefully peel bananas. In a medium bowl, mash bananas with a fork; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl with a hand-held electric mixer, or in the bowl of a stand mixer fitted with the whisk attachment, beat butter, brown sugar, and granulated sugar on medium speed until fluffy and pale, 2 to 3 minutes. Add 1/2 cup mashed banana, egg, and vanilla and beat on medium-low speed until just combined, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Stir in flour, salt, cinnamon, clove, and nutmeg until just combined. Using a flexible rubber spatula, fold in about 3/4 of chopped chocolate until just combined. Spread batter into prepared baking pan. Sprinkle with remaining 1/4 cup chocolate.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake until edges are set and golden brown and center springs backs lightly when lightly pressed, 25 to 28 minutes. Sprinkle with flaky salt, if using. Transfer pan to a wire rack to cool completely, about 1 hour before slicing. Serve.",
      "secondary_message": null
    }
  ],
