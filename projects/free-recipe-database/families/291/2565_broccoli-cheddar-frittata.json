  "instructions": [
    {
      "id": 24884,
      "primary_message": "Peel and small dice the onion. Wash the broccoli and chop into bite-size florets.",
      "secondary_message": "½ medium yellow onion\r\n2 crowns broccoli"
    },
    {
      "id": 24885,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 24886,
      "primary_message": "Grate ½ cup of cheddar into a small bowl and set aside.",
      "secondary_message": "¼ (8 oz) block cheddar cheese\r\n"
    },
    {
      "id": 24887,
      "primary_message": "Add butter to the skillet and swirl to coat bottom. Add the onion and cook, stirring frequently, until softened and lightly browned, 3-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\r\n"
    },
    {
      "id": 24888,
      "primary_message": "In a medium bowl, whisk together the eggs, water, ½ of the shredded cheddar, salt, and pepper.",
      "secondary_message": "6 eggs\r\n2 tbsp water\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 24889,
      "primary_message": "Add more butter to the skillet followed by broccoli florets. Cook, stirring occasionally, for 2-3 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\r\n"
    },
    {
      "id": 24890,
      "primary_message": "Preheat broiler and position rack in the upper third of the oven.",
      "secondary_message": ""
    },
    {
      "id": 24891,
      "primary_message": "Spread out the broccoli evenly in the skillet. Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
      "secondary_message": ""
    },
    {
      "id": 24892,
      "primary_message": "Sprinkle with the remaining cheddar. Place skillet in the oven until the top is set, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 24893,
      "primary_message": "To serve, cut frittata into wedges and place on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
