  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine the cubed pork, fatback, salt, black pepper, red pepper flakes, and garlic in a large bowl. Cover and refrigerate overnight.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Grind the mixture through the large die of a meat grinder. Add the chilled vinegar and mix with your hands until just combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Make a small patty of the sausage mixture and place the rest in the refrigerator. Pan fry patty in a skillet until cooked through. Taste test the patty and adjust seasoning of sausage mixture if necessary.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Fit casings over sausage stuffing horn and tie off the end. Stuff all of the sausage into the casings and tie into 4-inch links. Refrigerate sausages until ready to use.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly. Grill sausages until cooked through, or when an instant read thermometer reads 150°F when inserted into the middle of the sausage. Let cool for 5 minutes, then serve.",
      "secondary_message": null
    }
  ],
