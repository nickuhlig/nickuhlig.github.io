  "instructions": [
    {
      "id": 211366,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ orange\n1 (1 inch) piece ginger root\n2 medium zucchini squash\n½ bunch radish\n½ English cucumber\n½ (5 oz) pkg baby spinach\n1 avocado"
    },
    {
      "id": 211367,
      "primary_message": "Zest orange into a small bowl and set aside. Juice orange into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 211368,
      "primary_message": "Peel and mince or grate ginger; add to the bowl with the orange juice along with oil, vinegar, and salt. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp apple cider vinegar\n¼ tsp salt"
    },
    {
      "id": 211369,
      "primary_message": "Trim zucchini and, using a julienne (or regular) peeler, peel into thin noodles.",
      "secondary_message": null
    },
    {
      "id": 211370,
      "primary_message": "Preheat a skillet over medium-high heat. Once it is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 211371,
      "primary_message": "Add zucchini noodles and salt to the skillet; cook, stirring occasionally, until just tender, about 2 minutes. Transfer noodles to the bowl with the dressing and toss to coat. (Reserve skillet for later use.)",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 211372,
      "primary_message": "Trim and thinly slice radishes. Trim and medium dice cucumber. Add both to the bowl with the zucchini noodles and set aside.",
      "secondary_message": null
    },
    {
      "id": 211373,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 211374,
      "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; rub with oil and season with salt and pepper on both sides.",
      "secondary_message": "¾ lb sea scallops\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 211375,
      "primary_message": "Once the skillet is hot, add scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 211376,
      "primary_message": "Meanwhile, add spinach to the bowl with the zucchini and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 211377,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 211378,
      "primary_message": "To serve, divide salad between plates or bowls and top with avocado, scallops, orange zest, and sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
