  "instructions": [
    {
      "id": 211392,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ oranges\n3 (1 inch) pieces ginger root\n6 medium zucchini squash\n1 ½ bunches radish\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs baby spinach\n3 avocados"
    },
    {
      "id": 211393,
      "primary_message": "Zest oranges into a small bowl and set aside. Juice oranges into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 211394,
      "primary_message": "Peel and mince or grate ginger; add to the bowl with the orange juice along with oil, vinegar, and salt. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n¾ tsp salt"
    },
    {
      "id": 211395,
      "primary_message": "Trim zucchini and, using a julienne (or regular) peeler, peel into thin noodles.",
      "secondary_message": null
    },
    {
      "id": 211396,
      "primary_message": "Preheat a large skillet over medium-high heat. Once it is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 211397,
      "primary_message": "Add zucchini noodles and salt to the skillet; cook, stirring occasionally, until just tender, 3-4 minutes. Transfer noodles to the bowl with the dressing and toss to coat. (Reserve skillet for later use.)",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 211398,
      "primary_message": "Trim and thinly slice radishes. Trim and medium dice cucumbers. Add both to the bowl with the zucchini noodles and set aside.",
      "secondary_message": null
    },
    {
      "id": 211399,
      "primary_message": "Pat the scallops dry with paper towels and place on a large plate; rub with oil and season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb sea scallops\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 211400,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 211401,
      "primary_message": "Once the skillet is hot, add scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Work in batches if necessary. Once done, transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 211402,
      "primary_message": "Meanwhile, add spinach to the bowl with the zucchini and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 211403,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 211404,
      "primary_message": "To serve, divide salad between plates or bowls and top with avocado, scallops, orange zest, and sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
