  "instructions": [
    {
      "id": 469284,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 469285,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 red bell peppers\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 469286,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 469287,
      "primary_message": "While the rice is cooking, peel, trim, and small dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 469288,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 469289,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 469290,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 469291,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl and set aside. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 469292,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 ½ lb ground turkey\n2 tbsp curry powder\n2 tsp cumin, ground\n2 tsp paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 469293,
      "primary_message": "Meanwhile, roughly chop cashews. ",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 469294,
      "primary_message": "When the turkey is done, add veggies to the skillet. Continue to cook, stirring occasionally, until softened, 4-5 minutes. Remove from heat, add peas, and stir to combine; cover and set aside until the rice is done.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 469295,
      "primary_message": "When the rice is done, add to the skillet. Return skillet to medium-high heat and continue to stir-fry until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 469296,
      "primary_message": "To serve, divide fried rice between plates or bowls; top with cashews, chili-garlic sauce, and reserved green onions. Enjoy!",
      "secondary_message": "4 tsp chili-garlic sauce"
    }
  ],
