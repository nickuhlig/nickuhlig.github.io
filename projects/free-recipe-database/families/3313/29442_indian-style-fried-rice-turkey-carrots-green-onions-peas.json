  "instructions": [
    {
      "id": 469484,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 469485,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 red bell peppers\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 469486,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 469487,
      "primary_message": "While the rice is cooking, peel, trim, and small dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 469488,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 469489,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 469490,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 469491,
      "primary_message": "While the pot heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl and set aside. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 469492,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp neutral vegetable oil\n1.02 kg ground turkey\n1 tbsp curry powder\n1 tbsp cumin, ground\n1 tbsp paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 469493,
      "primary_message": "When the turkey is done, add veggies to the pot. Continue to cook, stirring occasionally, until softened, 5-6 minutes. Remove from heat, add peas, and stir to combine; cover and set aside until the rice is done.",
      "secondary_message": "2 cups frozen peas"
    },
    {
      "id": 469494,
      "primary_message": "When the rice is done, add to the pot. Return pot to medium-high heat and continue to stir-fry until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 469495,
      "primary_message": "Divide fried rice between plates or bowls and top with reserved green onions. Serve with chili-garlic sauce on the side and enjoy!",
      "secondary_message": "2 tbsp chili-garlic sauce"
    }
  ],
