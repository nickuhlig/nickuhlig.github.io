  "instructions": [
    {
      "id": 197124,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n6 medium carrots\n3 sticks celery\n1 small pkg fresh thyme"
    },
    {
      "id": 197125,
      "primary_message": "Peel and mince garlic. Peel and small dice onions. Transfer both to a large bowl.",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 197126,
      "primary_message": "Slice mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197127,
      "primary_message": "Peel and slice carrots into thin rounds. Trim and small dice celery. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197128,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 197129,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 197130,
      "primary_message": "Add veggies to the pot and cook, stirring occasionally, until tender, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 197131,
      "primary_message": "Meanwhile, medium dice chicken and season with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 197132,
      "primary_message": "Slide thyme leaves off the stems; discard stems.",
      "secondary_message": null
    },
    {
      "id": 197133,
      "primary_message": "Add chicken and thyme to the pot and cook, stirring occasionally, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 197134,
      "primary_message": "Add flour to the pot and stir to coat the vegetables and chicken. Cook, stirring frequently, 1-2 minutes.",
      "secondary_message": "⅓ cup all-purpose flour"
    },
    {
      "id": 197135,
      "primary_message": "Add broth, milk, rice, and salt to the pot. Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, until rice is soft and chicken is cooked through, 15-20 minutes.",
      "secondary_message": "1774 ml chicken or vegetable broth\n710 ml whole milk\n1 ½ cups basmati rice\n2 tsp salt"
    },
    {
      "id": 197136,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
