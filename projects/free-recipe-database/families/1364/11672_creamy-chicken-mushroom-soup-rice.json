  "instructions": [
    {
      "id": 197111,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg cremini mushrooms\n4 medium carrots\n2 sticks celery\n1 small pkg fresh thyme"
    },
    {
      "id": 197112,
      "primary_message": "Peel and mince garlic. Peel and small dice onion. Transfer both to a large bowl.",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 197113,
      "primary_message": "Slice mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197114,
      "primary_message": "Peel and slice carrots into thin rounds. Trim and small dice celery. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197115,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 197116,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 197117,
      "primary_message": "Add veggies to the pot and cook, stirring occasionally, until tender, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 197118,
      "primary_message": "Meanwhile, medium dice chicken and season with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 197119,
      "primary_message": "Slide thyme leaves off the stems; discard stems.",
      "secondary_message": null
    },
    {
      "id": 197120,
      "primary_message": "Add chicken and thyme to the pot and cook, stirring occasionally, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 197121,
      "primary_message": "Add flour to the pot and stir to coat the vegetables and chicken. Cook, stirring frequently, about 1 minute.",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 197122,
      "primary_message": "Add broth, milk, rice, and salt to the pot. Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, until rice is soft and chicken is cooked through, 15-20 minutes.",
      "secondary_message": "1183 ml chicken or vegetable broth\n473 ml whole milk\n1 cup basmati rice\n1 ½ tsp salt"
    },
    {
      "id": 197123,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
