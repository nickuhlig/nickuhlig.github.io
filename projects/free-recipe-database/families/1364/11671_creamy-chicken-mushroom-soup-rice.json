  "instructions": [
    {
      "id": 197098,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg cremini mushrooms\n2 medium carrots\n1 stick celery\n½ small pkg fresh thyme"
    },
    {
      "id": 197099,
      "primary_message": "Peel and mince garlic. Peel and small dice onion. Transfer both to a large bowl.",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 197100,
      "primary_message": "Slice mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197101,
      "primary_message": "Peel and slice carrots into thin rounds. Trim and small dice celery. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197102,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 197103,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 197104,
      "primary_message": "Add veggies to the pan and cook, stirring occasionally, until tender, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 197105,
      "primary_message": "Meanwhile, medium dice chicken and season with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 197106,
      "primary_message": "Slide thyme leaves off the stems; discard stems.",
      "secondary_message": null
    },
    {
      "id": 197107,
      "primary_message": "Add chicken and thyme to the pan and cook, stirring occasionally, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 197108,
      "primary_message": "Add flour to the pan and stir to coat the vegetables and chicken. Cook, stirring frequently, about 1 minute.",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 197109,
      "primary_message": "Add broth, milk, rice, and salt to the pan. Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, until rice is soft and chicken is cooked through, 10-15 minutes.",
      "secondary_message": "591 ml chicken or vegetable broth\n237 ml whole milk\n½ cup basmati rice\n½ tsp salt"
    },
    {
      "id": 197110,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
