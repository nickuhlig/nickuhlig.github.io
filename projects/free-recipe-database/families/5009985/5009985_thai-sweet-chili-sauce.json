  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Finely chop the Fresno.",
      "secondary_message": "3 medium cloves garlic\n2 tbsp fresh Fresno, red Thai chiles, or red jalapeño peppers"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together 2 tablespoons water and cornstarch. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium saucepan, mix together remaining 1 cup water, garlic, peppers, sugar, vinegar, and salt. Bring to a boil over medium heat, reduce heat and simmer 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir cornstarch mixture to re-combine, then whisk into simmering sauce and cook until thickened, about 1 minute more. Remove from heat, let cool, and use immediately or store in an airtight container in the refrigerator.",
      "secondary_message": null
    }
