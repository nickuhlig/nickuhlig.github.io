  "instructions": [
    {
      "id": 460662,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 fennel bulb\n½ bunch kale\n½ lemon"
    },
    {
      "id": 460663,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 460664,
      "primary_message": "While the pan heats up, trim off root end and stalks of the fennel, leaving only the white bulb. Cut fennel in half lengthwise, then slice crosswise into thin half-moons. ",
      "secondary_message": null
    },
    {
      "id": 460665,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add fennel and salt; cook, stirring occasionally, until soft and starting to brown, 3-4 minutes.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 460666,
      "primary_message": "Add veggie ground to the pan. Cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "227 g veggie ground, plant based"
    },
    {
      "id": 460667,
      "primary_message": "Meanwhile, peel and thinly slice garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 460668,
      "primary_message": "When the veggie ground is done, add garlic and crushed red pepper to the pan. Cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "¼ tsp Italian seasoning\n¼ tsp crushed red pepper"
    },
    {
      "id": 460669,
      "primary_message": "Add broth, water, and pasta to the pan. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to medium and continue to cook, stirring occasionally, until pasta is almost tender, 4-5 minutes more.",
      "secondary_message": "710 ml chicken or vegetable broth\n½ cup water\n85 g rotini pasta"
    },
    {
      "id": 460670,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. ",
      "secondary_message": null
    },
    {
      "id": 460671,
      "primary_message": "When the pasta is almost done, add kale to the pan in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until the kale and pasta are tender, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 460672,
      "primary_message": "Juice lemon into the pan and stir to combine the soup. ",
      "secondary_message": null
    },
    {
      "id": 460673,
      "primary_message": "To serve, divide soup between bowls and drizzle with oil. Enjoy!",
      "secondary_message": "1 tsp extra virgin olive oil"
    }
  ],
