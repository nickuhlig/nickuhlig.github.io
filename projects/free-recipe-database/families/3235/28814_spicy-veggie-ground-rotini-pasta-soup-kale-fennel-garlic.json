  "instructions": [
    {
      "id": 460530,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 fennel bulbs\n1 bunch kale\n1 lemon"
    },
    {
      "id": 460531,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 460532,
      "primary_message": "While the pot heats up, trim off root end and stalks of the fennel, leaving only the white bulbs. Cut fennel bulbs in half lengthwise, then slice crosswise into thin half-moons. ",
      "secondary_message": null
    },
    {
      "id": 460533,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add fennel and salt; cook, stirring occasionally, until soft and starting to brown, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 460534,
      "primary_message": "Add veggie ground to the pot. Cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "16 oz veggie ground, plant based"
    },
    {
      "id": 460535,
      "primary_message": "Meanwhile, peel and thinly slice garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 460536,
      "primary_message": "When the veggie ground is done, add garlic and crushed red pepper to the pot. Cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "½ tsp Italian seasoning\n½ tsp crushed red pepper"
    },
    {
      "id": 460537,
      "primary_message": "Add broth, water, and pasta to the pot. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to medium and continue to cook, stirring occasionally, until pasta is almost tender, 4-5 minutes more.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 cup water\n6 oz rotini pasta"
    },
    {
      "id": 460538,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. ",
      "secondary_message": null
    },
    {
      "id": 460539,
      "primary_message": "When the pasta is almost done, add kale to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until the kale and pasta are tender, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 460540,
      "primary_message": "Juice lemon into the pot and stir to combine the soup. ",
      "secondary_message": null
    },
    {
      "id": 460541,
      "primary_message": "To serve, divide soup between bowls and drizzle with oil. Enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
