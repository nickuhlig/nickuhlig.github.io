  "instructions": [
    {
      "id": 198961,
      "primary_message": "Pat tilapia dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb tilapia fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 198962,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 198963,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 198964,
      "primary_message": "Add tilapia to the skillet and sauté until golden brown and cooked through, 2-4 minutes per side. Once done, transfer to a plate. Wipe the skillet clean with a paper towel for later use.",
      "secondary_message": null
    },
    {
      "id": 198965,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n1 jalapeño pepper\n½ lemon\n½ avocado"
    },
    {
      "id": 198966,
      "primary_message": "Peel and mince garlic. Halve tomatoes.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 198967,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 198968,
      "primary_message": "Return the skillet to medium heat. Once the skillet is hot, add more oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 198969,
      "primary_message": "Add garlic, tomatoes, jalapeño, and spices to the skillet. Cook, stirring frequently, until the veggies begin to soften (but tomatoes still hold their shape), 10-12 minutes. ",
      "secondary_message": "¼ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 198970,
      "primary_message": "Meanwhile, zest and juice the lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 198971,
      "primary_message": "Add lemon zest, lemon juice, and broth to the skillet; stir to combine. Reduce heat to low and cook, stirring occasionally, until the sauce thickens slightly, 3-4 minutes.",
      "secondary_message": "2 fl oz (¼ cup) chicken or vegetable broth"
    },
    {
      "id": 198972,
      "primary_message": "Return tilapia to the skillet. Using a spoon, coat the fish with sauce and simmer until heated through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 198973,
      "primary_message": "Meanwhile, halve and pit avocado. Slice thinly while still in the skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 198974,
      "primary_message": "To serve, divide fish and sauce between plates. Top with avocado and enjoy!",
      "secondary_message": null
    }
  ],
