  "instructions": [
    {
      "id": 199031,
      "primary_message": "Pat tilapia dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg tilapia fillet\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 199032,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 199033,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 199034,
      "primary_message": "Working in batches if necessary, add tilapia to the skillet and sauté until golden brown and cooked through, 2-4 minutes per side. Once done, transfer to a plate. Wipe the skillet clean with a paper towel for later use.",
      "secondary_message": null
    },
    {
      "id": 199035,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 small pkgs grape tomatoes\n3 jalapeño peppers\n1 ½ lemons\n1 ½ avocados"
    },
    {
      "id": 199036,
      "primary_message": "Peel and mince garlic. Halve tomatoes.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 199037,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 199038,
      "primary_message": "Return the skillet to medium heat. Once the skillet is hot, add more oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 199039,
      "primary_message": "Add garlic, tomatoes, jalapeños, and spices to the skillet. Cook, stirring frequently, until the veggies begin to soften (but tomatoes still hold their shape), about 15 minutes. ",
      "secondary_message": "¾ tsp crushed red pepper\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 199040,
      "primary_message": "Meanwhile, zest and juice the lemons into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 199041,
      "primary_message": "Add lemon zest, lemon juice, and broth to the skillet; stir to combine. Reduce heat to low and cook, stirring occasionally, until the sauce thickens slightly, 5-6 minutes.",
      "secondary_message": "177 ml chicken or vegetable broth"
    },
    {
      "id": 199042,
      "primary_message": "Return tilapia to the skillet, overlapping the fillets if needed. Using a spoon, coat the fish with sauce and simmer until heated through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 199043,
      "primary_message": "Meanwhile, halve and pit avocados. Slice thinly while still in the skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 199044,
      "primary_message": "To serve, divide fish and sauce between plates. Top with avocado and enjoy!",
      "secondary_message": null
    }
  ],
