  "instructions": [
    {
      "id": 453537,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 453538,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n0.68 kg new potatoes\n9 medium carrots"
    },
    {
      "id": 453539,
      "primary_message": "Juice lemons into a large bowl. Add oil, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp honey\n1 ½ tsp curry powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 453540,
      "primary_message": "Pat steak dry with paper towels, place on a large plate, and drizzle with half of the dressing. Turn to coat and set aside to marinate, 15 minutes. (Reserve bowl with remaining dressing for the salad.)",
      "secondary_message": "1.02 kg flank steaks"
    },
    {
      "id": 453541,
      "primary_message": "Meanwhile, quarter potatoes and transfer to a large baking sheet pan. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 453542,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are golden and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 453543,
      "primary_message": "While the potatoes are roasting, peel, trim, and coarsely grate carrots. Add to the bowl with the reserved dressing, along with raisins, and stir to combine the salad. Set aside.",
      "secondary_message": "¾ cup raisins"
    },
    {
      "id": 453544,
      "primary_message": "When the steak is done marinating, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 453545,
      "primary_message": "Once the pan is hot, working in batches if necessary, add steak and grill until desired doneness, 2-4 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 453546,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 453547,
      "primary_message": "To serve, divide potatoes, carrot salad, and steak between plates. Enjoy!",
      "secondary_message": null
    }
  ],
