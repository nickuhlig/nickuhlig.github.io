  "instructions": [
    {
      "id": 494429,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 494430,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 494431,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 494432,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n4 tomatoes\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 494433,
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 494434,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 494435,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 494436,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 494437,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl, along with capers, and stir to combine the salad. Set aside.",
      "secondary_message": "2 tbsp capers"
    },
    {
      "id": 494438,
      "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons.",
      "secondary_message": "4 shallots"
    },
    {
      "id": 494439,
      "primary_message": "Return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add shallots, salt, and pepper; cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 494440,
      "primary_message": "Add vinegar and maple syrup to the skillet. Continue to cook, stirring often, until liquid is reduced and shallots are soft, about 1 minute. Remove from heat.",
      "secondary_message": "3 tbsp balsamic vinegar\n2 tbsp pure maple syrup"
    },
    {
      "id": 494441,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 494442,
      "primary_message": "To serve, divide steak and salad between plates. Top steak with shallots and enjoy!",
      "secondary_message": null
    }
  ],
