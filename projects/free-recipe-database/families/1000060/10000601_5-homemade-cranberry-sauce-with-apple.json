  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce (skip washing the cranberries if substituting for frozen). ",
      "secondary_message": "1 orange\n1 (340 g) pkg fresh cranberries"
    },
    {
      "primary_message": "Quarter, core, and small dice apples. Place in a medium saucepan. ",
      "secondary_message": null
    },
    {
      "primary_message": "Zest and juice orange into the pan with the apple. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add cranberries, sugar, and salt to the pan with the fruit. Bring to a simmer over medium-high heat, stirring frequently. ",
      "secondary_message": "¾ cup granulated sugar\n½ tsp salt"
    },
    {
      "primary_message": "Once the sauce is simmering, reduce heat to medium and cook, stirring occasionally, until the cranberries start to burst, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from heat and use a potato masher or fork to gently crush the cranberries.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Return the pan to medium heat and continue to cook, stirring occasionally, until the sauce thickens to a jam-like consistency, 3-4 minutes more. Remove from heat and set aside to cool, about 30 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the sauce has cooled, if you prefer a thinner consistency, add water, 1 tablespoon at a time, until you are pleased with the result. Refrigerate until ready to serve. ",
      "secondary_message": null
    }
  ],
