  "instructions": [
    {
      "id": 142441,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 142442,
      "primary_message": "Wash and dry the fresh produce (skip the mixed greens if they came pre-washed).",
      "secondary_message": "½ lemon\n2 medium carrots\n1 medium beet\n½ small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 142443,
      "primary_message": "Juice the lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 142444,
      "primary_message": "Add the oil, Dijon, maple syrup, salt, and poppy seeds to the bowl with the lemon juice. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp Dijon mustard\n1 tbsp pure maple syrup\n⅛ tsp salt\n1 tsp poppy seeds"
    },
    {
      "id": 142445,
      "primary_message": "Peel the carrots and beet, then trim off and discard the ends. Use a julienne peeler or box grater to coarsely cut or grate the carrots, followed by the beet; set aside. ",
      "secondary_message": null
    },
    {
      "id": 142446,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and coarsely chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 142447,
      "primary_message": "Peel and quarter the eggs lengthwise.",
      "secondary_message": null
    },
    {
      "id": 142448,
      "primary_message": "To serve, divide the mixed greens between plates, top with hard boiled egg, carrots, beets, crumbled goat cheese, and parsley. Drizzle with poppy seed vinaigrette. Enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese"
    }
  ],
