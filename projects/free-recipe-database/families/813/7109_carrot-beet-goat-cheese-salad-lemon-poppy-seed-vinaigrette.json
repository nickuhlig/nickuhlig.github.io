  "instructions": [
    {
      "id": 142457,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 142458,
      "primary_message": "Wash and dry the fresh produce (skip the mixed greens if they came pre-washed).",
      "secondary_message": "1 ½ lemons\n6 medium carrots\n3 medium beets\n1 small bunch Italian (flat-leaf) parsley\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 142459,
      "primary_message": "Juice the lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 142460,
      "primary_message": "Add the oil, Dijon, maple syrup, salt, and poppy seeds to the bowl with the lemon juice. Whisk to combine the dressing. ",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp Dijon mustard\n3 tbsp pure maple syrup\n⅜ tsp salt\n1 tbsp poppy seeds"
    },
    {
      "id": 142461,
      "primary_message": "Peel the carrots and beets, then trim off and discard the ends. Use a julienne peeler or box grater to coarsely cut or grate the carrots, followed by the beets; set aside. ",
      "secondary_message": null
    },
    {
      "id": 142462,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and coarsely chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 142463,
      "primary_message": "Peel and quarter the eggs lengthwise.",
      "secondary_message": null
    },
    {
      "id": 142464,
      "primary_message": "To serve, divide the mixed greens between plates, top with hard boiled egg, carrots, beets, crumbled goat cheese, and parsley. Drizzle with poppy seed vinaigrette. Enjoy!",
      "secondary_message": "3 (4 oz) logs goat cheese"
    }
  ],
