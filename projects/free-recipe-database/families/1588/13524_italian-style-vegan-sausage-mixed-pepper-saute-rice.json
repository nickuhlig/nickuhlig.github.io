  "instructions": [
    {
      "id": 231858,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 231859,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 231860,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 orange bell peppers\n3 green bell peppers\n3 jalapeño peppers"
    },
    {
      "id": 231861,
      "primary_message": "Seed and slice bell peppers into thin strips. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 231862,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Thinly slice and add to the bowl with the bell peppers. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 231863,
      "primary_message": "Peel and mince garlic. Peel, halve, and thinly slice onions into half moons; add both to the bowl with the peppers.",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 231864,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231865,
      "primary_message": "Once the pot is hot, add oil, and swirl to coat the bottom. Add the veggies and spices; cook, stirring occasionally, until soft and browned, about 15 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 231866,
      "primary_message": "While the veggies are cooking, slice the sausages into 1-inch pieces.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 231867,
      "primary_message": "Stir sausage into the pot and continue to cook until golden brown and heated through, about 7 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 231868,
      "primary_message": "To serve, divide rice and sausage-pepper sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
