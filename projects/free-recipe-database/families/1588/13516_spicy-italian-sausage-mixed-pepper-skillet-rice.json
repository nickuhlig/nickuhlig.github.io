  "instructions": [
    {
      "id": 231764,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 231765,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 231766,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 green bell pepper\n1 orange bell pepper\n1 jalapeño pepper"
    },
    {
      "id": 231767,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231768,
      "primary_message": "While the skillet heats up, cut the sausages into 1-inch pieces.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 231769,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and pan-fry, stirring occasionally, until browned and cooked through, about 8 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 231770,
      "primary_message": "Meanwhile, using a clean cutting board, seed and slice bell peppers into thin strips. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 231771,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Thinly slice and add to the bowl with the bell peppers. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 231772,
      "primary_message": "Peel and mince garlic. Peel, halve, and thinly slice onion into half moons; add both to the bowl with the peppers.",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 231773,
      "primary_message": "When the sausages are done, remove to a plate.",
      "secondary_message": null
    },
    {
      "id": 231774,
      "primary_message": "Return the skillet to medium heat, add additional oil, and swirl to coat the bottom. Add the veggies and spices; cook, stirring occasionally, until soft and browned, about 10 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 231775,
      "primary_message": "Stir sausages into the skillet and continue to cook until heated through, about 3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 231776,
      "primary_message": "To serve, divide rice and sausage-pepper skillet between plates. Enjoy!",
      "secondary_message": null
    }
  ],
