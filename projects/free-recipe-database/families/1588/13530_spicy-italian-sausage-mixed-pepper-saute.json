  "instructions": [
    {
      "id": 231930,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 orange bell peppers\n3 green bell peppers\n3 jalapeño peppers"
    },
    {
      "id": 231931,
      "primary_message": "Cut the sausages into 1-inch pieces.",
      "secondary_message": "9 pork sausages"
    },
    {
      "id": 231932,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231933,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausage and pan-fry, stirring occasionally, until browned and cooked through, 8-10 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 231934,
      "primary_message": "Meanwhile, using a clean cutting board, seed and slice bell peppers into thin strips. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 231935,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Thinly slice and add to the bowl with the bell peppers. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 231936,
      "primary_message": "Peel and mince garlic. Peel, halve, and thinly slice onions into half moons; add both to the bowl with the peppers.",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 231937,
      "primary_message": "When the sausages are done, remove to a plate.",
      "secondary_message": null
    },
    {
      "id": 231938,
      "primary_message": "Return the pot to medium heat, add additional oil, and swirl to coat the bottom. Add the veggies and spices; cook, stirring occasionally, until soft and browned, about 15 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 231939,
      "primary_message": "Stir sausages into the pot and continue to cook until heated through, about 4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 231940,
      "primary_message": "To serve, divide sausage-pepper sauté between plates and enjoy!",
      "secondary_message": null
    }
  ],
