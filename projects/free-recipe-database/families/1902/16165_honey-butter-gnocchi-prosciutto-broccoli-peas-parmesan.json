  "instructions": [
    {
      "id": 264977,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 264978,
      "primary_message": "Once the pot is hot, working in batches if necessary, add the prosciutto and cook until crispy, about 1 minute per side. Remove prosciutto to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "18 slices prosciutto"
    },
    {
      "id": 264979,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 264980,
      "primary_message": "Wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 264981,
      "primary_message": "Return pot to medium heat. Add butter, garlic, broccoli, salt, and red pepper; cook, stirring occasionally, until broccoli is bright green and tender-crisp, 5-6 minutes.",
      "secondary_message": "⅓ cup butter, unsalted\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 264982,
      "primary_message": "Meanwhile, finely grate Parmesan, place in a small bowl, and set aside.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 264983,
      "primary_message": "Add gnocchi, peas, and hot water (from the tap) to the pot; continue to cook, stirring occasionally, until the water reduces and gnocchi are soft, 7-8 minutes more.",
      "secondary_message": "3 (454 g) pkgs potato gnocchi\n2 ¼ cups frozen peas\n1 cup water"
    },
    {
      "id": 264984,
      "primary_message": "While the gnocchi is cooking, crumble or chop prosciutto into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 264985,
      "primary_message": "Wash, dry, and juice lemons into the pot. Add honey and stir to combine; remove from heat.",
      "secondary_message": "1 ½ lemons\n3 tbsp honey"
    },
    {
      "id": 264986,
      "primary_message": "To serve, divide gnocchi and vegetables between bowls. Top with crispy prosciutto and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
