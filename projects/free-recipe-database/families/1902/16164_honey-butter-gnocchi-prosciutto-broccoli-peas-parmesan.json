  "instructions": [
    {
      "id": 264967,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 264968,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add the prosciutto and cook until crispy, about 1 minute per side. Remove prosciutto to a plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 264969,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 264970,
      "primary_message": "Wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 264971,
      "primary_message": "Return skillet to medium heat. Add butter, garlic, broccoli, salt, and red pepper; cook, stirring occasionally, until broccoli is bright green and tender-crisp, 4-5 minutes.",
      "secondary_message": "¼ cup butter, unsalted\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 264972,
      "primary_message": "Meanwhile, finely grate Parmesan, place in a small bowl, and set aside.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 264973,
      "primary_message": "Add gnocchi, peas, and hot water (from the tap) to the skillet; continue to cook, stirring occasionally, until the water reduces and gnocchi are soft, 3-4 minutes more.",
      "secondary_message": "2 (454 g) pkgs potato gnocchi\n1 ½ cups frozen peas\n⅔ cup water"
    },
    {
      "id": 264974,
      "primary_message": "While the gnocchi is cooking, crumble or chop prosciutto into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 264975,
      "primary_message": "Wash, dry, and juice lemon into the skillet. Add honey and stir to combine; remove from heat.",
      "secondary_message": "1 lemon\n2 tbsp honey"
    },
    {
      "id": 264976,
      "primary_message": "To serve, divide gnocchi and vegetables between bowls. Top with crispy prosciutto and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
