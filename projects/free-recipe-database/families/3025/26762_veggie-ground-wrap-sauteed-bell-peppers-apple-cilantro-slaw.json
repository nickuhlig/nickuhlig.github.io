  "instructions": [
    {
      "id": 468765,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 yellow bell peppers\n1 lemon\n4 Granny Smith apples\n1 small bunch cilantro"
    },
    {
      "id": 468766,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 468767,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 468768,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peppers, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n2 tsp chili powder\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 468769,
      "primary_message": "Meanwhile, juice lemon into a medium bowl. Add oil, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 468770,
      "primary_message": "Quarter, core, and coarsely grate apples. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 468771,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 468772,
      "primary_message": "Peel and mince shallot. Add to the bowl and stir to combine the slaw; set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 468773,
      "primary_message": "Place tortillas on a flat surface, then divide veggie ground and peppers between them. Top with apple slaw, roll tightly to close, and cut in half.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 468774,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
