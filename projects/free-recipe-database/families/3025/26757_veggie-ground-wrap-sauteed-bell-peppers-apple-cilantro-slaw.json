  "instructions": [
    {
      "id": 468715,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 yellow bell peppers\n1 ½ lemons\n6 Granny Smith apples\n1 small bunch cilantro"
    },
    {
      "id": 468716,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 468717,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 468718,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add peppers, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 468719,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add oil, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 468720,
      "primary_message": "Quarter, core, and coarsely grate apples. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 468721,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 468722,
      "primary_message": "Peel and mince shallots. Add to the bowl and stir to combine the slaw; set aside.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 468723,
      "primary_message": "Place tortillas on a flat surface, then divide veggie ground and peppers between them. Top with apple slaw, roll tightly to close, and cut in half.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 468724,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
