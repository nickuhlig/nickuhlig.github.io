  "instructions": [
    {
      "id": 468685,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 yellow bell peppers\n1 ½ lemons\n6 Granny Smith apples\n1 small bunch cilantro"
    },
    {
      "id": 468686,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 468687,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 468688,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add peppers, chicken, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ lb ground chicken\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 468689,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add oil, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 468690,
      "primary_message": "Quarter, core, and coarsely grate apples. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 468691,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 468692,
      "primary_message": "Peel and mince shallots. Add to the bowl and stir to combine the slaw; set aside.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 468693,
      "primary_message": "When the chicken is done, place tortillas on a flat surface, then divide chicken and peppers between them. Top with apple slaw, roll tightly to close, and cut in half.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 468694,
      "primary_message": "To serve, divide chicken wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
