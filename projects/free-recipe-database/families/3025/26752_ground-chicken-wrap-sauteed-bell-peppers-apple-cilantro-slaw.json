  "instructions": [
    {
      "id": 468665,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 yellow bell pepper\n½ lemon\n2 Granny Smith apples\n½ small bunch cilantro"
    },
    {
      "id": 468666,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 468667,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 468668,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peppers, chicken, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ lb ground chicken\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 468669,
      "primary_message": "Meanwhile, juice lemon into a medium bowl. Add oil, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 468670,
      "primary_message": "Quarter, core, and coarsely grate apples. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 468671,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 468672,
      "primary_message": "Peel and mince shallot. Add to the bowl and stir to combine the slaw; set aside.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 468673,
      "primary_message": "When the chicken is done, place tortillas on a flat surface, then divide chicken and peppers between them. Top with apple slaw, roll tightly to close, and cut in half.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 468674,
      "primary_message": "To serve, divide chicken wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
