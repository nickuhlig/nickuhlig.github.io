  "instructions": [
    {
      "id": 20751,
      "primary_message": "Wash and medium dice sweet potatoes (without peeling). Place in a medium saucepan, cover with water, and bring to a boil. Cook until tender, 10-15 minutes.",
      "secondary_message": "0.34 kg sweet potatoes"
    },
    {
      "id": 20752,
      "primary_message": "Heat broiler and position rack about 15 cm from the top.",
      "secondary_message": ""
    },
    {
      "id": 20753,
      "primary_message": "Place pork chops in a baking dish. Rub with olive oil and season with salt and pepper.",
      "secondary_message": "2 pork chops, boneless\r\n1 tsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 20754,
      "primary_message": "Place in the oven and broil until pork is cooked through, 7-9 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 20755,
      "primary_message": "Wash and dry greens. Transfer to a medium bowl.",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 20756,
      "primary_message": "Slice off top and bottom from orange, then cut off the skin and white pith from the sides so you can see the orange flesh. Cut in between the membranes to release the segments and add to bowl with greens.",
      "secondary_message": "1 orange"
    },
    {
      "id": 20757,
      "primary_message": "Add cranberries to bowl with greens and orange.",
      "secondary_message": "⅛ cup dried cranberries"
    },
    {
      "id": 20758,
      "primary_message": "In a small bowl, prepare salad dressing by whisking together olive oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\r\n½ tbsp white wine vinegar\r\n⅛ tsp Dijon mustard\r\n1 pinch salt\r\n1 pinch black pepper"
    },
    {
      "id": 20759,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 20760,
      "primary_message": "Drain potatoes and return to saucepan. Add broth, olive oil, garlic, salt, and pepper; mash until smooth.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 20761,
      "primary_message": "Serve pork with mash and salad on the side. Drizzle dressing over salad and enjoy!",
      "secondary_message": ""
    }
  ],
