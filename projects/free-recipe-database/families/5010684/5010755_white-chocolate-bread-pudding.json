  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the bread into 1-inch cubes. Finely chop the white chocolate. Finely chop the white chocolate.",
      "secondary_message": "255 g bread\n170 g white chocolate\n57 g white chocolate"
    },
    {
      "id": 1,
      "primary_message": "For the Bread Pudding: Grease an 20-cm square pan with butter; set aside. Adjust oven rack to middle position and preheat oven to 180°C (350°F). Spread bread cubes onto a rimmed baking sheet and bake until edges of bread feels dry, about 10 minutes. Remove from oven and let pan cool on a wire rack.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium saucepan, whisk milk, cream, and sugar to combine. Heat over medium heat, stirring occasionally, until scalding. Remove from heat and whisk in chocolate until melted and smooth. Let sit to cool slightly, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, whisk egg yolks and egg to combine. Slowly whisk in warm milk mixture to combine. Whisk in vanilla. Add bread cubes and let soak, about 30 minutes, gently stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour mixture into prepared pan and bake until just set, about 25 minutes. Let cool slightly before serving, about 15 minutes. Leftover bread pudding can be reheated in the microwave.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "For the Sauce: In a small saucepan over medium heat, heat cream to just simmering. Remove from heat and whisk in chocolate until melted and smooth. Serve immediately.",
      "secondary_message": null
    }
  ],
