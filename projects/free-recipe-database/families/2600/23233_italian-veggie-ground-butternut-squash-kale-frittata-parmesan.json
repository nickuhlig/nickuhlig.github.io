  "instructions": [
    {
      "id": 426043,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 426044,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 426045,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, butternut squash, and spices. Cook, breaking the veggie ground apart with a spoon, until squash is tender and veggie ground is cooked through, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n8 oz veggie ground, plant based\n1 cup frozen butternut squash, pieces\n1 tsp Italian seasoning\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 426046,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in a medium bowl; whisk to combine.",
      "secondary_message": "6 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 426047,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 426048,
      "primary_message": "When the veggie ground is done, add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": "½ (10 oz) bag kale, cut and ready to use"
    },
    {
      "id": 426049,
      "primary_message": "Reduce heat to medium-low and pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 426050,
      "primary_message": "Sprinkle Parmesan over the frittata. Place skillet in the oven and broil until top is set and cheese is slightly melted, 3-4 minutes; remove from oven.",
      "secondary_message": "⅓ cup Parmesan cheese, shredded"
    },
    {
      "id": 426051,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
