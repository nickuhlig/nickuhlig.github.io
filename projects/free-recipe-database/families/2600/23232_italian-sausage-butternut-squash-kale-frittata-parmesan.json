  "instructions": [
    {
      "id": 426034,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 426035,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 426036,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, sausage, butternut squash, and spices. Cook, breaking the meat apart with a spoon, until squash is tender and meat is cooked through, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ lb ground pork sausage\n3 cup frozen butternut squash, pieces\n1 tbsp Italian seasoning\n¾ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426037,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in a large bowl; whisk to combine.",
      "secondary_message": "18 eggs\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426038,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 426039,
      "primary_message": "When the sausage is done, add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": "1 ½ (10 oz) bags kale, cut and ready to use"
    },
    {
      "id": 426040,
      "primary_message": "Reduce heat to medium-low and pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 426041,
      "primary_message": "Sprinkle Parmesan over the frittata. Place skillet in the oven and broil until top is set and cheese is slightly melted, 3-4 minutes; remove from oven.",
      "secondary_message": "1 cup Parmesan cheese, shredded"
    },
    {
      "id": 426042,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
