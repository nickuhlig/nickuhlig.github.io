  "instructions": [
    {
      "primary_message": "Place hot water (from the tap) in a large pot and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the water is boiling, add veggies and noodles (reserving flavor packets). Stir to combine the soup and cook, stirring occasionally, until noodles and veggies are soft, 3-5 minutes.",
      "secondary_message": "1 (306 g) bag frozen mixed vegetables (broccoli, carrots, sugar snap peas, water chestnuts)\n2 (85 g) pkg instant ramen noodle soup, shrimp flavor"
    },
    {
      "primary_message": "Add shrimp and stir to combine. Continue to cook until heated through, 2-3 minutes more.",
      "secondary_message": "227 g cooked shrimp, peeled, tail off"
    },
    {
      "primary_message": "Remove soup from heat, add flavor packets, and stir until combined.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide soup between bowls. Halve eggs and add to the bowls, then drizzle with chili crisp. Enjoy!",
      "secondary_message": "2 tbsp chili crisp (spicy chili pepper condiment)"
    }
