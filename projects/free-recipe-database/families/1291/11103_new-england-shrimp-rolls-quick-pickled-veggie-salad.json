  "instructions": [
    {
      "id": 184612,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 sticks celery\n3 English cucumbers\n1 ½ pints grape tomatoes"
    },
    {
      "id": 184613,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 184614,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) ",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 184615,
      "primary_message": "Juice lemons into a large bowl. Add mayo, salt, and pepper; whisk to combine the aioli. ",
      "secondary_message": "⅓ cup mayonnaise\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 184616,
      "primary_message": "Peel and mince shallot and add to the bowl with the aioli. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 184617,
      "primary_message": "Mince celery and add to the bowl. Stir to combine and set aside.",
      "secondary_message": null
    },
    {
      "id": 184618,
      "primary_message": "Once the water in the pot comes to a boil, uncover, add shrimp, and stir for a few seconds. Remove from heat, and let sit until cooked through, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 184619,
      "primary_message": "Meanwhile, place vinegar, oil, honey, Dijon, salt, and pepper in another large bowl. Whisk to combine the dressing. ",
      "secondary_message": "½ cup apple cider vinegar\n3 tbsp extra virgin olive oil\n3 tbsp honey\n1 tbsp Dijon mustard\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 184620,
      "primary_message": "Peel, quarter, and thinly slice the other shallot and add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 184621,
      "primary_message": "Trim off and discard the ends of the cucumbers; quarter lengthwise, then slice crosswise into ¼-inch thick pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184622,
      "primary_message": "Halve tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 184623,
      "primary_message": "Place corn in a clean colander and run under cold water to thaw. Pat dry with paper towels and transfer to the bowl. Toss to combine the salad.",
      "secondary_message": "2 ¼ cups frozen corn"
    },
    {
      "id": 184624,
      "primary_message": "Toast buns, if desired, and spread with butter. ",
      "secondary_message": "6 whole grain buns or rolls\n3 tbsp butter, unsalted"
    },
    {
      "id": 184625,
      "primary_message": "Drain the shrimp and discard the liquid. Rinse the shrimp under cold water to cool and pat dry with paper towels. Cut into bite-sized pieces and add to the bowl with the aioli; toss to coat.",
      "secondary_message": null
    },
    {
      "id": 184626,
      "primary_message": "To serve, fill rolls with shrimp and sprinkle with paprika. Divide rolls and salad between plates. Enjoy! ",
      "secondary_message": "3 pinch paprika"
    }
  ],
