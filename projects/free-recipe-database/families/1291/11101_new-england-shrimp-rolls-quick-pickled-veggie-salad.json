  "instructions": [
    {
      "id": 184582,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 stick celery\n1 English cucumber\n½ pint grape tomatoes"
    },
    {
      "id": 184583,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap), cover, and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 184584,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) ",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 184585,
      "primary_message": "Juice lemon into a medium bowl. Add mayo, salt, and pepper; whisk to combine the aioli. ",
      "secondary_message": "2 tbsp mayonnaise\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 184586,
      "primary_message": "Peel shallot; mince half and add to the bowl with the aioli. (Reserve remaining half for later.)",
      "secondary_message": "1 shallot"
    },
    {
      "id": 184587,
      "primary_message": "Mince celery and add to the bowl. Stir to combine and set aside.",
      "secondary_message": null
    },
    {
      "id": 184588,
      "primary_message": "Once the water in the saucepan comes to a boil, uncover, add shrimp, and stir for a few seconds. Remove from heat, and let sit until cooked through, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 184589,
      "primary_message": "Meanwhile, place vinegar, oil, honey, Dijon, salt, and pepper in another medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp apple cider vinegar\n1 tbsp extra virgin olive oil\n1 tbsp honey\n1 tsp Dijon mustard\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 184590,
      "primary_message": "Quarter and thinly slice remaining shallot and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 184591,
      "primary_message": "Trim off and discard the ends of the cucumber; quarter lengthwise, then slice crosswise into ¼-inch thick pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184592,
      "primary_message": "Halve tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 184593,
      "primary_message": "Place corn in a clean colander and run under cold water to thaw. Pat dry with paper towels and transfer to the bowl. Toss to combine the salad.",
      "secondary_message": "¾ cup frozen corn"
    },
    {
      "id": 184594,
      "primary_message": "Toast buns, if desired, and spread with butter. ",
      "secondary_message": "2 whole grain buns or rolls\n1 tbsp butter, unsalted"
    },
    {
      "id": 184595,
      "primary_message": "Drain the shrimp and discard the liquid. Rinse the shrimp under cold water to cool and pat dry with paper towels. Cut into bite-sized pieces and add to the bowl with the aioli; toss to coat.",
      "secondary_message": null
    },
    {
      "id": 184596,
      "primary_message": "To serve, fill rolls with shrimp and sprinkle with paprika. Divide rolls and salad between plates. Enjoy! ",
      "secondary_message": "1 pinch paprika"
    }
  ],
