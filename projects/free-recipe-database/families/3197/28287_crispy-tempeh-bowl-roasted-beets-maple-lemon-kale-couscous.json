  "instructions": [
    {
      "id": 469159,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 469160,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium beets\n1 ½ lemons\n1 ½ bunches kale"
    },
    {
      "id": 469161,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice into ¼-inch thick wedges. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 469162,
      "primary_message": "Slice tempeh crosswise into ½-inch thick strips. Transfer to another baking sheet, then drizzle with soy sauce and oil. Season with pepper, then toss to coat and spread out in an even layer.",
      "secondary_message": "3 (227g ) pkgs tempeh\n1 tbsp soy sauce\n1 tbsp extra virgin olive oil\n3 pinch black pepper"
    },
    {
      "id": 469163,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring each halfway through, until beets are tender and tempeh is crisp, 20-25 minutes. Remove baking sheets from oven; season tempeh with additional soy sauce and toss to coat.",
      "secondary_message": "1 tbsp soy sauce"
    },
    {
      "id": 469164,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 469165,
      "primary_message": "While the couscous is cooking, juice lemons into a small bowl, then add mayo, oil, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "½ cup vegan mayonnaise\n1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 469166,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 469167,
      "primary_message": "Add half of the dressing to the bowl with the kale and, using your hands, massage kale with the dressing until wilted, 1-2 minutes. (Reserve remaining dressing for serving.)",
      "secondary_message": null
    },
    {
      "id": 469168,
      "primary_message": "To serve, divide couscous between bowls; top with kale, beets, and crispy tempeh. Drizzle with reserved dressing and enjoy!",
      "secondary_message": null
    }
  ],
