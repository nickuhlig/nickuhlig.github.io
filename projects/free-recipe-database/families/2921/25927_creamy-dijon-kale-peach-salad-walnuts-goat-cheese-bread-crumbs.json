  "instructions": [
    {
      "id": 413472,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 413473,
      "primary_message": "While the skillet heats up, roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 413474,
      "primary_message": "Once the skillet is hot, add walnuts and cook, stirring frequently, until lightly browned, 2-3 minutes. Transfer to a small bowl. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 413475,
      "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom. Add bread crumbs and cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to the bowl with the walnuts and set aside to cool.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ cup panko bread crumbs\n⅛ tsp salt"
    },
    {
      "id": 413476,
      "primary_message": "Meanwhile, place yogurt, Dijon, oil, water, honey, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp Dijon mustard\n1 tbsp extra virgin olive oil\n1 tbsp water\n1 ½ tsp honey\n1 tsp rice vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 413477,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 413478,
      "primary_message": "Wash, dry, and quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh and add to the bowl with the kale.",
      "secondary_message": "2 peaches"
    },
    {
      "id": 413479,
      "primary_message": "Crumble goat cheese into the bowl and gently toss to combine the salad.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 413480,
      "primary_message": "To serve, divide the salad between plates or bowls; top with walnuts and crispy bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
