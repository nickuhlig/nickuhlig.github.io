  "instructions": [
    {
      "id": 270555,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ lemon\n½ small bunch Italian (flat-leaf) parsley\n1 head butter (Boston) lettuce"
    },
    {
      "id": 270556,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 270557,
      "primary_message": "While the water is heating, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 270558,
      "primary_message": "Once the water in the saucepan is boiling, uncover, and add cauliflower, pasta, and salt; stir for a few seconds. Cook until pasta reaches desired firmness, 8-10 minutes. ",
      "secondary_message": "142 g macaroni (elbow) pasta\n1 tsp salt"
    },
    {
      "id": 270559,
      "primary_message": "Meanwhile, juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 270560,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with lemon juice (reserving the rest for the pasta).",
      "secondary_message": null
    },
    {
      "id": 270561,
      "primary_message": "Add oil, honey, salt, and pepper to the bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 270562,
      "primary_message": "Coarsely grate cheddar. Cut cream cheese into small pieces.",
      "secondary_message": "⅓ (227 g) block cheddar cheese\n¼ (227 g) block cream cheese"
    },
    {
      "id": 270563,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 270564,
      "primary_message": "Once the pan is hot, add milk, cheddar, cream cheese, and spices. Cook, whisking frequently, until cheeses melt and combine, 2-3 minutes; remove cheese sauce from heat.",
      "secondary_message": "118 ml (½ cup) whole milk\n½ tsp salt\n¼ tsp paprika\n⅛ tsp black pepper"
    },
    {
      "id": 270565,
      "primary_message": "When the cauliflower and pasta are done, drain in a strainer, and return to the pan. Add cheese sauce and stir to combine the cauliflower macaroni & cheese. Cover and set aside.",
      "secondary_message": null
    },
    {
      "id": 270566,
      "primary_message": "Chop or tear lettuce into bite-sized pieces and add to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 270567,
      "primary_message": "To serve, divide cauliflower macaroni & cheese and salad between plates. Top pasta with reserved parsley and crushed red pepper. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
