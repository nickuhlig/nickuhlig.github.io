  "instructions": [
    {
      "id": 273370,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lb cremini mushrooms\n1 ½ bunches radish\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 273371,
      "primary_message": "Thinly slice mushrooms and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 273372,
      "primary_message": "Peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 273373,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 273374,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, onion, and spices to the pot; cook, stirring occasionally, until veggies are tender, about 8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 273375,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 273376,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 273377,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 273378,
      "primary_message": "When the veggies are tender, add beef and cook, breaking apart with a spoon, until browned and cooked through, 6-8 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef"
    },
    {
      "id": 273379,
      "primary_message": "While the beef is cooking, coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 273380,
      "primary_message": "When the beef is done, add vinegar, stir to combine, and remove from heat.",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 273381,
      "primary_message": "Transfer the beef mixture to a large baking dish, sprinkle with cheese, and place in the oven. Broil until cheese is melted and golden, 3-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 273382,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and radish; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 273383,
      "primary_message": "To serve, divide beef-mushroom bake and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
