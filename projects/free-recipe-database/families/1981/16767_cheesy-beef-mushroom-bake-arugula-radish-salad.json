  "instructions": [
    {
      "id": 273443,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.45 kg cremini mushrooms\n1 bunch radish\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 273444,
      "primary_message": "Thinly slice mushrooms and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 273445,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 273446,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 273447,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, onion, and spices to the skillet; cook, stirring occasionally, until veggies are tender, 6-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp garlic powder\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 273448,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 273449,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 273450,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 273451,
      "primary_message": "When the veggies are tender, add beef and cook, breaking apart with a spoon, until browned and cooked through, about 5 minutes.",
      "secondary_message": "0.68 kg lean ground beef"
    },
    {
      "id": 273452,
      "primary_message": "While the beef is cooking, coarsely grate cheese.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 273453,
      "primary_message": "When the beef is done, add vinegar, stir to combine, and remove from heat.",
      "secondary_message": "4 tsp balsamic vinegar"
    },
    {
      "id": 273454,
      "primary_message": "Sprinkle cheese over the beef mixture, then place the skillet in the oven. Broil until cheese is melted and golden, 3-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 273455,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and radish; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 273456,
      "primary_message": "To serve, divide beef-mushroom bake and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
