  "instructions": [
    {
      "id": 273297,
      "primary_message": "Preheat oven to 425°F. Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 273298,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lb cremini mushrooms\n½ bunch radish\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 273299,
      "primary_message": "Thinly slice mushrooms and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 273300,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 273301,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 273302,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, onion, and spices to the skillet; cook, stirring occasionally, until veggies are tender, 6-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 273303,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp balsamic vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 273304,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 273305,
      "primary_message": "When the veggies are tender, add beef and cook, breaking apart with a spoon, until browned and cooked through, about 5 minutes.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 273306,
      "primary_message": "While the beef is cooking, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 273307,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 273308,
      "primary_message": "When the beef is done, add vinegar, stir to combine, and remove from heat.",
      "secondary_message": "2 tsp balsamic vinegar"
    },
    {
      "id": 273309,
      "primary_message": "Split buns in half and place, cut-side up, on the baking sheet. Top with beef mixture and sprinkle with cheese. Place in the oven and broil until cheese is melted and golden, 3-4 minutes. Remove from oven.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 273310,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and radish; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 273311,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
