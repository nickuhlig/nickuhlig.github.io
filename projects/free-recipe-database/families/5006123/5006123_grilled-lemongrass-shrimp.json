  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the lemongrass. Mince the garlic. Grate the peeled ginger. Mince the shallot.",
      "secondary_message": "2 tsp fresh lemongrass, from about 2 to 3 stalks\n4 medium cloves garlic\n1 tsp fresh peeled ginger\n1 tbsp shallot"
    },
    {
      "id": 1,
      "primary_message": "Wash shrimp under cold running water, then dry well with paper towels.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a mixing bowl, stir together lemongrass, garlic, fish sauce, ginger, shallot, oil, salt, and chile flakes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add shrimp and toss to coat. Refrigerate for at least 1 hour and up to 8 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When you are ready to cook, set up your grill. Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange coals on one side of the charcoal grate. Set cooking grate in place, cover grill, and allow to preheat for 5 minutes. Alternatively, set half the burners on a gas grill to medium-high heat, cover, and preheat for 10 minutes. Clean and oil the grilling grate.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Place shrimp on the grill in a single layer and cook over direct heat. Cook, turning, until shrimp are just cooked through, about 4 minutes. Serve.",
      "secondary_message": null
    }
  ],
