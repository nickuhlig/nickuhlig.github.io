  "instructions": [
    {
      "id": 28561,
      "primary_message": "Drain the beans (but don't rinse them) and transfer to a medium bowl. Use a potato masher or fork to mash them until they are mostly broken up, but there are still some whole beans left.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 28562,
      "primary_message": "Coarsely grate the onion and add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 28563,
      "primary_message": "Add the bread crumbs, chili powder, salt, and pepper to the beans and onion; stir until the mixture is combined.",
      "secondary_message": "¼ cup panko bread crumbs\n½ tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 28564,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 28565,
      "primary_message": "Form the bean mixture into two patties.",
      "secondary_message": null
    },
    {
      "id": 28566,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 28567,
      "primary_message": "Place the patties in the skillet and cook until they are browned and heated through, 4 to 5 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 28568,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 28569,
      "primary_message": "Wash and dry the fresh produce. (Skip the greens if they came pre-washed.)",
      "secondary_message": "1 avocado\n1 lime\n½ pint grape tomatoes\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 28570,
      "primary_message": "Halve and pit the avocado; medium dice the flesh while it's still in the skin, then scoop out into a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 28571,
      "primary_message": "Add juice of ½ lime to the avocado and season with salt and pepper; mash with a fork until smooth.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 28572,
      "primary_message": "Halve the grape tomatoes.",
      "secondary_message": null
    },
    {
      "id": 28630,
      "primary_message": "Place the bun halves on two plates (or one plate and one lunch container), top with the black bean patties, and add dollops of the avocado spread. Arrange the greens on the side, top with the grape tomatoes, and drizzle with olive oil and the remaining lime. Enjoy!",
      "secondary_message": "½ tbsp extra virgin olive oil"
    }
  ],
