  "instructions": [
    {
      "id": 402302,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 402303,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 402304,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402305,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a large bowl along with hoisin sauce, miso paste, oil, and spices. Stir to combine the sauce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n¼ cup hoisin sauce\n2 tbsp miso paste, red\n2 tbsp toasted sesame oil\n1 tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 402306,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Add to the bowl with the sauce along with the broccoli. ",
      "secondary_message": "2 small bunches asparagus\n1 (18 oz) bag broccoli florets"
    },
    {
      "id": 402307,
      "primary_message": "Pat chicken dry with paper towels and large dice; add to the bowl. Stir chicken and veggies in the sauce to coat, then transfer to a large baking sheet pan and spread out in an even layer. ",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 402308,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender and chicken is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402309,
      "primary_message": "To serve, divide rice, chicken, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
