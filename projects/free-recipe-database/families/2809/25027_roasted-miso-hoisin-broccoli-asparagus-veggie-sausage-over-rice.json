  "instructions": [
    {
      "id": 402318,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 402319,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 402320,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402321,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a medium bowl along with hoisin sauce, miso paste, oil, and spices. Stir to combine the sauce.",
      "secondary_message": "1 (1 inch) piece ginger root\n2 tbsp hoisin sauce\n1 tbsp miso paste, red\n1 tbsp extra virgin olive oil\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 402322,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Add to the bowl with the sauce, along with the broccoli, and stir to coat. Transfer veggies to a baking sheet pan and spread out in an even layer. ",
      "secondary_message": "1 small bunch asparagus\n½ (18 oz) bag broccoli florets"
    },
    {
      "id": 402323,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and bake until just tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 402324,
      "primary_message": "When the veggies are done, remove from the oven and stir. Add sausages to the baking sheet, nestling them into the veggies. Drizzle sausages with additional oil.",
      "secondary_message": "2 pre-cooked vegan sausage\n1 tsp extra virgin olive oil"
    },
    {
      "id": 402325,
      "primary_message": "Return baking sheet to the oven and continue to bake until sausages are warmed through, about 5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402326,
      "primary_message": "Transfer sausages to a cutting board and slice crosswise into pieces. ",
      "secondary_message": null
    },
    {
      "id": 402327,
      "primary_message": "To serve, divide rice, sausage, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
