  "instructions": [
    {
      "id": 402348,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 402349,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 402350,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402351,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a medium bowl along with hoisin sauce, miso paste, oil, and spices. Stir to combine the sauce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n2 tbsp hoisin sauce\n1 tbsp miso paste, red\n1 tbsp toasted sesame oil\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 402352,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Add to the bowl with the sauce along with the broccoli. ",
      "secondary_message": "1 small bunch asparagus\n½ (510 g) bag broccoli florets"
    },
    {
      "id": 402353,
      "primary_message": "Pat chicken dry with paper towels and large dice; add to the bowl. Stir chicken and veggies in the sauce to coat, then transfer to a baking sheet pan and spread out in an even layer. ",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 402354,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender and chicken is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402355,
      "primary_message": "To serve, divide rice, chicken, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
