  "instructions": [
    {
      "id": 402310,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 402311,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 402312,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402313,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a large bowl along with hoisin sauce, miso paste, oil, and spices. Stir to combine the sauce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n⅓ cup hoisin sauce\n3 tbsp miso paste, red\n3 tbsp toasted sesame oil\n1 ½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 402314,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Add to the bowl with the sauce along with the broccoli. ",
      "secondary_message": "3 small bunches asparagus\n1 ½ (18 oz) bags broccoli florets"
    },
    {
      "id": 402315,
      "primary_message": "Pat chicken dry with paper towels and large dice; add to the bowl. Stir chicken and veggies in the sauce to coat, then divide between two large baking sheet pans and spread out in an even layer. ",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 402316,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender and chicken is cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402317,
      "primary_message": "To serve, divide rice, chicken, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
