  "instructions": [
    {
      "id": 402392,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 402393,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 402394,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402395,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a large bowl along with hoisin sauce, miso paste, oil, and spices. Stir to combine the sauce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n⅓ cup hoisin sauce\n3 tbsp miso paste, red\n3 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 402396,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Add to the bowl with the sauce, along with the broccoli, and stir to coat. Divide veggies between two baking sheet pans and spread out in an even layer. ",
      "secondary_message": "3 small bunches asparagus\n1 ½ (510 g) bags broccoli florets"
    },
    {
      "id": 402397,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and bake until just tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 402398,
      "primary_message": "When the veggies are done, remove from the oven and stir. Add sausages to the baking sheets, nestling them into the veggies. Drizzle sausages with additional oil.",
      "secondary_message": "6 pre-cooked vegan sausage\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 402399,
      "primary_message": "Return baking sheets to the oven and continue to bake until sausages are warmed through, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402400,
      "primary_message": "Transfer sausages to a cutting board and slice crosswise into pieces. ",
      "secondary_message": null
    },
    {
      "id": 402401,
      "primary_message": "To serve, divide rice, sausage, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
