  "instructions": [
    {
      "id": 418220,
      "primary_message": "Preheat oven to 230°C (450°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 418221,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Divide polenta between the baking sheets, arranging the slices in a single layer.",
      "secondary_message": "3 (510 g) tubes polenta, pre-cooked"
    },
    {
      "id": 418222,
      "primary_message": "Place polenta in the oven (it doesn't have to be fully heated) while you prepare the beans.",
      "secondary_message": null
    },
    {
      "id": 418223,
      "primary_message": "Drain and rinse beans; place in a large bowl, season with chili powder and salt, then stir to combine.",
      "secondary_message": "3 (398 ml) cans black beans\n1 tbsp chili powder\n¾ tsp salt"
    },
    {
      "id": 418224,
      "primary_message": "Remove baking sheets from the oven. Spoon seasoned beans over the polenta slices, then top with cheese. (Reserve bowl for the coleslaw.)",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 418225,
      "primary_message": "Return baking sheets to the oven and bake until polenta stacks are warmed through and cheese is melted, 7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 418226,
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 418227,
      "primary_message": "Wash, dry, and juice limes into the reserved bowl. Add guacamole, yogurt, and salt; stir to combine the dressing.",
      "secondary_message": "1 ½ limes\n1 ½ cups guacamole\n¾ cup plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 418228,
      "primary_message": "Add cabbage to the bowl with the dressing and stir to combine the slaw.",
      "secondary_message": "3 (397 g) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 418229,
      "primary_message": "To serve, divide polenta stacks and slaw between plates. Top polenta stacks with salsa and enjoy!",
      "secondary_message": "1 cup salsa"
    }
  ],
