  "instructions": [
    {
      "id": 418240,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 418241,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Transfer to the baking sheet, arranging the slices in a single layer.",
      "secondary_message": "2 (510 g) tubes polenta, pre-cooked"
    },
    {
      "id": 418242,
      "primary_message": "Place polenta in the oven (it doesn't have to be fully heated) while you prepare the beans.",
      "secondary_message": null
    },
    {
      "id": 418243,
      "primary_message": "Drain and rinse beans; place in a medium bowl, season with chili powder and salt, then stir to combine.",
      "secondary_message": "2 (398 ml) cans black beans\n2 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 418244,
      "primary_message": "Remove baking sheet from the oven. Spoon seasoned beans over the polenta slices. (Reserve bowl for the coleslaw.)",
      "secondary_message": null
    },
    {
      "id": 418245,
      "primary_message": "Return baking sheet to the oven and bake until polenta stacks are warmed through, 5-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 418246,
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 418247,
      "primary_message": "Wash, dry, and juice lime into the reserved bowl. Add guacamole, mayo, and salt; stir to combine the dressing.",
      "secondary_message": "1 lime\n1 cup guacamole\n⅓ cup vegan mayonnaise\n½ tsp salt"
    },
    {
      "id": 418248,
      "primary_message": "Add cabbage to the bowl with the dressing and stir to combine the slaw.",
      "secondary_message": "2 (397 g) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 418249,
      "primary_message": "To serve, divide polenta stacks and slaw between plates. Top polenta stacks with salsa and enjoy!",
      "secondary_message": "⅔ cup salsa"
    }
  ],
