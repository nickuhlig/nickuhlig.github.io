  "instructions": [
    {
      "id": 239761,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 239762,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium heads cauliflower\n2 yellow bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 239763,
      "primary_message": "Cut cauliflower heads into quarters, then trim off and discard the leaves and thick stems. Cut into bite-sized florets and divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 239764,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 239765,
      "primary_message": "Drizzle oil over the veggies, season with spices, and toss to coat; spread the mixture out in an even layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp oregano, dried\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 239766,
      "primary_message": "Thinly slice sun-dried tomatoes. Sprinkle tomatoes and feta over the veggies. ",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 239767,
      "primary_message": "Place baking sheets in the oven and roast until veggies are starting to soften, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 239768,
      "primary_message": "Meanwhile, thinly slice sausages. Once the veggies start to soften, remove baking sheets from oven, add sausage, and toss to combine.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 239769,
      "primary_message": "Return baking sheets to the oven and continue to bake until veggies are tender and sausage is warmed through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 239770,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Sprinkle over the veggies and sausage; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 239771,
      "primary_message": "To serve, divide roasted veggies and sausage between plates. Enjoy!",
      "secondary_message": null
    }
  ],
