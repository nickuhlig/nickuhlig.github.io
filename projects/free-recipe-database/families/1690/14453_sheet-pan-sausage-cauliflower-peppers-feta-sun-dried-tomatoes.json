  "instructions": [
    {
      "id": 239673,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 239674,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 yellow bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 239675,
      "primary_message": "Cut cauliflower heads into quarters, then trim off and discard the leaves and thick stems. Cut into bite-sized florets and divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 239676,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 239677,
      "primary_message": "Drizzle oil over the veggies, season with spices, and toss to coat; spread the mixture out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 239678,
      "primary_message": "Thinly slice sun-dried tomatoes. Sprinkle tomatoes and feta over the veggies. ",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 239679,
      "primary_message": "Place sausages on the baking sheets, nestling them between the veggies.",
      "secondary_message": "9 pork sausages"
    },
    {
      "id": 239680,
      "primary_message": "Place baking sheets in the oven and roast, tossing halfway through, until veggies are tender and sausages are cooked through, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 239681,
      "primary_message": "When the veggies and sausages are done, remove from oven; transfer sausages to a cutting board and thinly slice crosswise. Add back to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 239682,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Sprinkle over the veggies and sausage; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 239683,
      "primary_message": "To serve, divide roasted veggies and sausage between plates. Enjoy!",
      "secondary_message": null
    }
  ],
