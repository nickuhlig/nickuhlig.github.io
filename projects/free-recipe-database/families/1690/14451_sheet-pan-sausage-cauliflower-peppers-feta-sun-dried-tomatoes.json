  "instructions": [
    {
      "id": 239651,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 239652,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 yellow bell pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 239653,
      "primary_message": "Cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized florets and transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 239654,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the baking sheet with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 239655,
      "primary_message": "Drizzle oil over the veggies, season with spices, and toss to coat; spread the mixture out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 239656,
      "primary_message": "Thinly slice sun-dried tomatoes. Sprinkle tomatoes and feta over the veggies. ",
      "secondary_message": "4 sun-dried tomatoes, oil-packed\n½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 239657,
      "primary_message": "Place sausages on the baking sheet, nestling them between the veggies.",
      "secondary_message": "3 pork sausages"
    },
    {
      "id": 239658,
      "primary_message": "Place baking sheet in the oven and roast, tossing halfway through, until veggies are tender and sausages are cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 239659,
      "primary_message": "When the veggies and sausages are done, remove from oven; transfer sausages to a cutting board and thinly slice crosswise. Add back to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 239660,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Sprinkle over the veggies and sausage; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 239661,
      "primary_message": "To serve, divide roasted veggies and sausage between plates. Enjoy!",
      "secondary_message": null
    }
  ],
