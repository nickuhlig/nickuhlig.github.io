  "instructions": [
    {
      "id": 239706,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 239707,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium heads cauliflower\n3 yellow bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 239708,
      "primary_message": "Cut cauliflower heads into quarters, then trim off and discard the leaves and thick stems. Cut into bite-sized florets and divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 239709,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 239710,
      "primary_message": "Drizzle oil over the veggies, season with spices, and toss to coat; spread the mixture out in an even layer.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tbsp oregano, dried\n1 ¼ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 239711,
      "primary_message": "Thinly slice sun-dried tomatoes. Sprinkle tomatoes and feta over the veggies. ",
      "secondary_message": "18 sun-dried tomatoes, oil-packed\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 239712,
      "primary_message": "Place baking sheets in the oven and roast until veggies are starting to soften, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 239713,
      "primary_message": "Meanwhile, thinly slice sausages. Once the veggies start to soften, remove baking sheets from oven, add sausage, and toss to combine.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 239714,
      "primary_message": "Return baking sheets to the oven and continue to bake until veggies are tender and sausage is warmed through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 239715,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Sprinkle over the veggies and sausage; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 239716,
      "primary_message": "To serve, divide roasted veggies and sausage between plates. Enjoy!",
      "secondary_message": null
    }
  ],
