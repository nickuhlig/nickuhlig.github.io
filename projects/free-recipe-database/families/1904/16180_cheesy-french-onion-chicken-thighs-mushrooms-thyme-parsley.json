  "instructions": [
    {
      "id": 278569,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 278570,
      "primary_message": "While the pot heats up, pat the chicken thighs dry with paper towels. Season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 278571,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chicken to the pot and pan-fry until golden and cooked through, 3-4 minutes per side. Transfer to a large baking dish in a single layer and cover with foil. (Reserve pot with drippings.)",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 278572,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb white mushrooms\n1 small pkg fresh thyme\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 278573,
      "primary_message": "Peel, halve, and thinly slice onions into half-moons.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 278574,
      "primary_message": "Return pot to medium heat. Add more butter and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until soft and caramelized, about 20 minutes.",
      "secondary_message": "⅓ cup butter, unsalted\n¾ tsp salt"
    },
    {
      "id": 278575,
      "primary_message": "While the onions cook, peel and mince garlic; place in a medium bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 278576,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 278577,
      "primary_message": "Slide thyme leaves off the stems; discard the stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 278578,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 278579,
      "primary_message": "When the onions are done, add garlic, mushrooms, thyme, half of the parsley (reserving the rest for garnish), broth, and Worcestershire to the pot; stir to combine. Bring to a boil, then reduce heat to a simmer and cook, stirring occasionally, until liquid is reduced by half, 5-6 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n1 ½ tsp Worcestershire sauce"
    },
    {
      "id": 278580,
      "primary_message": "Meanwhile, thinly slice mozzarella. Finely grate Parmesan.",
      "secondary_message": "1 (8 oz) block mozzarella cheese\n3 oz Parmesan cheese"
    },
    {
      "id": 278581,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 278582,
      "primary_message": "When the veggies are done, transfer to the baking dish, arranging them around the chicken; top chicken with mozzarella and Parmesan. Place baking dish in the oven and broil until cheese is melted and bubbly, 4-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 278583,
      "primary_message": "To serve, divide veggies and chicken between bowls or plates. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
