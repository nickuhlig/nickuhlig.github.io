  "instructions": [
    {
      "id": 278554,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 278555,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels. Season with salt and pepper on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 278556,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chicken to the skillet and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet with drippings.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 278557,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lb white mushrooms\n1 small pkg fresh thyme\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 278558,
      "primary_message": "Peel, halve, and thinly slice onions into half-moons.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 278559,
      "primary_message": "Return skillet to medium heat. Add more butter and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until soft and caramelized, 15-20 minutes.",
      "secondary_message": "¼ cup butter, unsalted\n½ tsp salt"
    },
    {
      "id": 278560,
      "primary_message": "While the onions cook, peel and mince garlic; place in a medium bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 278561,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 278562,
      "primary_message": "Slide thyme leaves off the stems; discard the stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 278563,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 278564,
      "primary_message": "When the onions are done, add garlic, mushrooms, thyme, half of the parsley (reserving the rest for garnish), broth, and Worcestershire to the skillet; stir to combine. Bring to a boil, then reduce heat to a simmer and cook, stirring occasionally, until liquid is reduced by half, 4-5 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n1 tsp Worcestershire sauce"
    },
    {
      "id": 278565,
      "primary_message": "Meanwhile, thinly slice mozzarella. Finely grate Parmesan.",
      "secondary_message": "⅔ (8 oz) block mozzarella cheese\n2 oz Parmesan cheese"
    },
    {
      "id": 278566,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 278567,
      "primary_message": "When the veggies are done, nestle chicken into the mushrooms; top chicken with mozzarella and Parmesan. Place skillet in the oven and broil until cheese is melted and bubbly, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 278568,
      "primary_message": "To serve, divide veggies and chicken between bowls or plates. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
