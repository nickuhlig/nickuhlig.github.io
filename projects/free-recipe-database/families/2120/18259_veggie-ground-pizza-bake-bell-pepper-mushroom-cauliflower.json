  "instructions": [
    {
      "id": 296129,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 296130,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n0.68 kg white mushrooms\n1 ½ medium heads cauliflower"
    },
    {
      "id": 296131,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 296132,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 296133,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and add to the bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 296134,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 296135,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until starting to brown, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 296136,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 296137,
      "primary_message": "When the veggie ground is browned, add veggies and garlic to the pot. Cook, stirring occasionally, until veggies are soft and veggie ground is cooked through, 7-8 minutes more.",
      "secondary_message": null
    },
    {
      "id": 296138,
      "primary_message": "While the veggies cook, coarsely grate mozzarella.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 296139,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 296140,
      "primary_message": "Once the veggies are soft, add tomato sauce and spices to the pot; stir to combine. Remove from heat and transfer to a large baking dish; sprinkle cheese and olives over the top.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 296141,
      "primary_message": "Place baking dish in the oven and bake until cheese is melted and bubbly, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 296142,
      "primary_message": "To serve, divide \"pizza\" bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
