  "instructions": [
    {
      "id": 296101,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 296102,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n0.23 kg white mushrooms\n½ medium head cauliflower"
    },
    {
      "id": 296103,
      "primary_message": "Trim, seed, and medium dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 296104,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 296105,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and add to the bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 296106,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 296107,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until starting to brown, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n227 g veggie ground, plant based\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 296108,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 296109,
      "primary_message": "When the veggie ground is browned, add veggies and garlic to the skillet. Cook, stirring occasionally, until veggies are soft and veggie ground is cooked through, 6-7 minutes more.",
      "secondary_message": null
    },
    {
      "id": 296110,
      "primary_message": "While the veggies cook, coarsely grate mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 296111,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 296112,
      "primary_message": "Once the veggies are soft, add tomato sauce and spices to the skillet; stir to combine. Remove from heat and sprinkle cheese and olives over the top.",
      "secondary_message": "1 (213 ml) can tomato sauce\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 296113,
      "primary_message": "Place skillet in the oven and bake until cheese is melted and bubbly, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 296114,
      "primary_message": "To serve, divide \"pizza\" skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
