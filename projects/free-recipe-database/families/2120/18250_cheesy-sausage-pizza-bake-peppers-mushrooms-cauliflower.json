  "instructions": [
    {
      "id": 296003,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 296004,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n1 ½ lb white mushrooms\n1 ½ medium heads cauliflower"
    },
    {
      "id": 296005,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 296006,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 296007,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and add to the bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 296008,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 296009,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork and cook, breaking the meat apart with a spoon, until starting to brown, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ lb ground pork sausage"
    },
    {
      "id": 296010,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 296011,
      "primary_message": "When the pork is browned, add veggies and garlic to the pot. Cook, stirring occasionally, until veggies are soft and pork is cooked through, 7-8 minutes more.",
      "secondary_message": null
    },
    {
      "id": 296012,
      "primary_message": "While the veggies cook, coarsely grate mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 296013,
      "primary_message": "Roughly chop olives.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 296014,
      "primary_message": "Once the veggies are soft, add tomato sauce and spices to the pot; stir to combine. Remove from heat and transfer to a large baking dish; sprinkle cheese and olives over pork and veggies.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 296015,
      "primary_message": "Place baking dish in the oven and bake until cheese is melted and bubbly, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 296016,
      "primary_message": "To serve, divide \"pizza\" bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
