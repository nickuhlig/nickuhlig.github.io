  "instructions": [
    {
      "id": 549513,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n6 medium parsnips\n1 small bunch fresh dill\n1 ½ bunches radish\n1 ½ heads butter (Boston) lettuce\n3 avocados"
    },
    {
      "id": 549514,
      "primary_message": "Zest and juice half of the lemons into a small bowl. Juice remaining lemons into a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 549515,
      "primary_message": "Add yogurt, salt, and pepper to the small bowl with the lemon, then stir to combine the sauce. Set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 549516,
      "primary_message": "Add oil, salt, and pepper to the large bowl with the lemon juice. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 549517,
      "primary_message": "Place eggs, baking powder, salt, and pepper in another large bowl. Whisk to combine.",
      "secondary_message": "3 eggs\n1 ½ tsp baking powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 549518,
      "primary_message": "Peel, trim, and coarsely grate parsnips. Add to the bowl with the egg mixture.",
      "secondary_message": null
    },
    {
      "id": 549519,
      "primary_message": "Peel, halve, and coarsely grate onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 549520,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 549521,
      "primary_message": "While the skillet heats up, shave dill leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl, along with flour, and stir to combine the latke mixture. (Reserve remaining dill for serving.)",
      "secondary_message": "1 cup all-purpose flour"
    },
    {
      "id": 549522,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; press down to form ½-inch thick fritters. Cook, flipping once, until latkes are golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 549523,
      "primary_message": "Meanwhile, trim and thinly slice radishes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 549524,
      "primary_message": "Chop (or tear) lettuce leaves into bite-sized pieces. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 549525,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and thinly slice. Season with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 549526,
      "primary_message": "Chop or tear smoked salmon into bite-sized pieces.",
      "secondary_message": "3 (113 g) pkgs smoked salmon"
    },
    {
      "id": 549527,
      "primary_message": "To serve, divide latkes and salad between plates. Top latkes with yogurt sauce, salmon, and reserved dill. Top salad with avocado and enjoy!",
      "secondary_message": null
    }
  ],
