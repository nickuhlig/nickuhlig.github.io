  "instructions": [
    {
      "id": 157802,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 157803,
      "primary_message": "Combine oils, vinegar, honey, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp toasted sesame oil\n2 tbsp rice vinegar\n1 tbsp honey\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 157804,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place in a baking dish, pour half of the dressing over the chicken and turn to coat.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 157805,
      "primary_message": "Place chicken in the oven and bake, flipping once, until golden brown and cooked through, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 157806,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n¼ lb brussels sprouts\n1 Gala apple\n2 sticks celery\n½ small bunch green onions (scallions)"
    },
    {
      "id": 157807,
      "primary_message": "Halve the cabbage lengthwise, then cut out and discard the core; thinly slice crosswise and add to the large bowl with the remaining dressing.",
      "secondary_message": null
    },
    {
      "id": 157808,
      "primary_message": "Trim ends and thinly slice Brussels sprouts. Medium dice celery. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 157809,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle; add to the bowl. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 157810,
      "primary_message": "Core and thinly slice apple.",
      "secondary_message": null
    },
    {
      "id": 157811,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 157812,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 157813,
      "primary_message": "To serve, divide salad between plates and top with apples, walnuts, and chicken. Enjoy!",
      "secondary_message": null
    }
  ],
