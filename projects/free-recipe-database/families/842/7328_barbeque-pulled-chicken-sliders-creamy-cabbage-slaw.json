  "instructions": [
    {
      "id": 107585,
      "primary_message": "Place a large pot over medium heat. Add broth, vinegar, sugar, and spices; stir to combine and bring to a gentle boil.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n¼ cup white wine vinegar\n2 tbsp brown sugar\n2 tsp paprika\n½ tsp chili powder\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 107586,
      "primary_message": "To make the dressing, combine mayo, vinegar, sugar, salt, and pepper in a medium bowl and set aside.",
      "secondary_message": "¼ cup mayonnaise\n2 tsp white wine vinegar\n1 tsp brown sugar\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 107587,
      "primary_message": "Add chicken to the pot and cover with a lid. Poach until chicken is cooked through, 12-15 minutes.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 107588,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 small bunch green onions (scallions)\n½ small head red cabbage"
    },
    {
      "id": 107589,
      "primary_message": "Trim carrot ends, peel, and grate. Trim off and discard the ends of the green onions; slice crosswise into ¼-inch pieces. Add carrots and onions to the bowl with dressing.",
      "secondary_message": null
    },
    {
      "id": 107590,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise into shreds and add to the bowl with the carrots. Toss the slaw until well coated.",
      "secondary_message": null
    },
    {
      "id": 107591,
      "primary_message": "When chicken thighs are cooked through, use tongs to transfer them to a plate, leaving the liquid in the pot. Increase the temperature to medium-high and stir the ketchup into the liquid. Simmer, stirring frequently, until liquid is reduced by half and can coat the back of a spoon, 4-5 minutes.",
      "secondary_message": "2 tbsp ketchup"
    },
    {
      "id": 107592,
      "primary_message": "Preheat oven to broil and position rack in the center of the the oven.",
      "secondary_message": null
    },
    {
      "id": 107593,
      "primary_message": "Using two forks, shred the chicken into bite-sized pieces. When the sauce is reduced, add the chicken back to the pot and stir to coat.",
      "secondary_message": null
    },
    {
      "id": 107594,
      "primary_message": "Halve the buns and arrange them cut-side up on a baking sheet; toast until golden brown, 1-2 minutes.",
      "secondary_message": "8 whole grain buns or rolls"
    },
    {
      "id": 107595,
      "primary_message": "To serve, divide the buns between plates, top the bottoms with chicken and some of the slaw; close with the top half of the bun. Serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
