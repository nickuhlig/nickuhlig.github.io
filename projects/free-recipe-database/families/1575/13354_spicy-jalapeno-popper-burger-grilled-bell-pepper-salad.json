  "instructions": [
    {
      "id": 300006,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n½ yellow bell pepper\n½ head butter (Boston) lettuce\n1 tomato"
    },
    {
      "id": 300007,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and place in a medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 300008,
      "primary_message": "Coarsely grate cheese into the bowl with the jalapeño. Add ground beef and spices; mix with your hands until well combined. Form into 2 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "¼ (227 g) block mozzarella cheese\n⅓ kg lean ground beef\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder\n⅛ tsp cumin, ground"
    },
    {
      "id": 300009,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300010,
      "primary_message": "While the grill pan heats up, quarter, trim, and seed bell pepper. Place in another medium bowl, drizzle with oil, and sprinkle with salt; toss to combine.",
      "secondary_message": "½ tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 300011,
      "primary_message": "Once the grill pan is hot, add bell pepper and cook, turning occasionally, until charred and fork-tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 300012,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in the bowl used for the peppers. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n½ tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 300013,
      "primary_message": "When the peppers are done, transfer to a cutting board to cool.",
      "secondary_message": null
    },
    {
      "id": 300014,
      "primary_message": "Place burger patties on the grill pan and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 2-3 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 300015,
      "primary_message": "Once the peppers are cool enough to handle, roughly chop and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 300016,
      "primary_message": "Separate the lettuce leaves. Set aside 1 leaf per burger and chop or tear remaining leaves into bite-sized pieces; add chopped lettuce to the bowl with the peppers and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 300017,
      "primary_message": "Slice tomato into rounds.",
      "secondary_message": null
    },
    {
      "id": 300018,
      "primary_message": "If desired, place buns, cut-side down, on the grill pan to toast, 1-2 minutes.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 300019,
      "primary_message": "Place bottom half of a bun on each plate, spread with ketchup, then top with burgers, lettuce, and tomato slices. Close with the top half of the bun and serve with salad on the side. Enjoy!",
      "secondary_message": "1 tbsp ketchup"
    }
  ],
