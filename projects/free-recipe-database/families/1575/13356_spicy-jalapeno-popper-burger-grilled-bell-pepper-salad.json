  "instructions": [
    {
      "id": 300034,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 jalapeño peppers\n1 ½ yellow bell peppers\n1 ½ heads butter (Boston) lettuce\n3 tomatoes"
    },
    {
      "id": 300035,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and place in a large bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 300036,
      "primary_message": "Coarsely grate cheese into the bowl with the jalapeño. Add ground beef and spices; mix with your hands until well combined. Form into 6 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "¾ (227 g) block mozzarella cheese\n1.02 kg lean ground beef\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder\n½ tsp cumin, ground"
    },
    {
      "id": 300037,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300038,
      "primary_message": "While the grill pan heats up, quarter, trim, and seed bell peppers. Place in another large bowl, drizzle with oil, and sprinkle with salt; toss to combine.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 300039,
      "primary_message": "Once the grill pan is hot, add bell peppers and cook, turning occasionally, until charred and fork-tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 300040,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in the bowl used for the peppers. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 ½ tsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 300041,
      "primary_message": "When the peppers are done, transfer to a cutting board to cool.",
      "secondary_message": null
    },
    {
      "id": 300042,
      "primary_message": "Working in batches if necessary, place burger patties on the grill pan and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 2-3 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 300043,
      "primary_message": "Once the peppers are cool enough to handle, roughly chop and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 300044,
      "primary_message": "Separate the lettuce leaves. Set aside 1 leaf per burger and chop or tear remaining leaves into bite-sized pieces; add chopped lettuce to the bowl with the peppers and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 300045,
      "primary_message": "Slice tomatoes into rounds.",
      "secondary_message": null
    },
    {
      "id": 300046,
      "primary_message": "If desired, place buns, cut-side down, on the grill pan to toast, 1-2 minutes.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 300047,
      "primary_message": "Place bottom half of a bun on each plate, spread with ketchup, then top with burgers, lettuce, and tomato slices. Close with the top half of the bun and serve with salad on the side. Enjoy!",
      "secondary_message": "3 tbsp ketchup"
    }
  ],
