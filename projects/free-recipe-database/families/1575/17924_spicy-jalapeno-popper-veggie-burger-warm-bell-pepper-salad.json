  "instructions": [
    {
      "id": 299922,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n½ yellow bell pepper\n½ head butter (Boston) lettuce\n1 tomato"
    },
    {
      "id": 299923,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and place in a medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 299924,
      "primary_message": "Coarsely grate cheese into the bowl with the jalapeño. Add veggie ground and spices; mix with your hands until well combined. Form into 2 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese\n8 oz veggie ground, plant based\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp cumin, ground"
    },
    {
      "id": 299925,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 299926,
      "primary_message": "While the skillet heats up, quarter, trim, and seed bell pepper. Place in another medium bowl, drizzle with oil, and sprinkle with salt; toss to combine.",
      "secondary_message": "½ tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 299927,
      "primary_message": "Once the skillet is hot, add bell pepper and cook, stirring occasionally, until fork-tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 299928,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in the bowl used for the peppers. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n½ tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 299929,
      "primary_message": "When the peppers are done, transfer to a cutting board to cool.",
      "secondary_message": null
    },
    {
      "id": 299930,
      "primary_message": "Return skillet to medium-high heat, add oil, and swirl to coat the bottom. Add patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 299931,
      "primary_message": "Once the peppers are cool enough to handle, roughly chop and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 299932,
      "primary_message": "Separate the lettuce leaves. Set aside 1 leaf per burger and chop or tear remaining leaves into bite-sized pieces; add chopped lettuce to the bowl with the peppers and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 299933,
      "primary_message": "Slice tomato into rounds.",
      "secondary_message": null
    },
    {
      "id": 299934,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 299935,
      "primary_message": "Place bottom half of a bun on each plate, spread with ketchup, then top with veggie burgers, lettuce, and tomato slices. Close with the top half of the bun and serve with salad on the side. Enjoy!",
      "secondary_message": "1 tbsp ketchup"
    }
  ],
