  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F and arrange rack in the center position. Place toast on the countertop to thaw slightly. Separate toast slices, arrange on a baking sheet pan, and place in the preheated oven. Bake until golden and toasted, 5-7 minutes. Remove from oven.",
      "secondary_message": "2 slice frozen garlic toast (with cheese)"
    },
    {
      "primary_message": "Meanwhile, fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into 2-inch long pieces. Once the water is boiling, uncover the pan, add tortellini and asparagus, then stir for a few seconds. Cook, stirring occasionally, until pasta and asparagus are just tender, about 4 minutes. Drain and return to the pan.",
      "secondary_message": "½ small bunch asparagus\n1 (283 g) pkg prosciutto & cheese tortellini, fresh or frozen"
    },
    {
      "primary_message": "Add pesto to the pan. Return to medium-high heat and cook, stirring often, until warmed through, about 30 seconds. Season with salt and pepper to taste, then remove from heat.",
      "secondary_message": "⅓ cup basil pesto"
    },
    {
      "primary_message": "Divide tortellini and asparagus between plates or bowls. Serve with garlic toast on the side and enjoy!",
      "secondary_message": null
    }
  ],
