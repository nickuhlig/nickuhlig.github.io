  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F and place rack in the center position. ",
      "secondary_message": null
    },
    {
      "primary_message": "Place cornmeal, flour, baking powder, baking soda, and salt in a medium bowl; whisk to combine the dry ingredients. Set aside. ",
      "secondary_message": "1 ½ cups polenta (cornmeal)\n1 ½ cups all-purpose flour\n1 tbsp baking powder\n½ tsp baking soda\n½ tsp salt"
    },
    {
      "primary_message": "Place eggs, milk, and maple syrup in another medium bowl; whisk to combine the wet ingredients. Set aside. ",
      "secondary_message": "355 ml whole milk\n½ cup pure maple syrup"
    },
    {
      "primary_message": "Place oil in a 10-inch ovenproof skillet (preferably cast iron).  ",
      "secondary_message": "5 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Once the oven is heated, place the skillet with oil in the oven to preheat. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, add the wet ingredients to the bowl with the dry ingredients, and whisk to combine. ",
      "secondary_message": null
    },
    {
      "primary_message": "Carefully remove the skillet from the oven, and working quickly, drizzle the hot oil into the batter while whisking. Once combined, pour the batter into the hot skillet, and return to the oven. ",
      "secondary_message": null
    },
    {
      "primary_message": "Bake, undisturbed, until cornbread is golden brown and a toothpick inserted into the center of the bread comes out clean, 35-40 minutes. Note: if your skillet is slightly larger that 10-inches, lessen the total baking time to accommodate. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from the oven and let cool slightly before slicing into wedges. Serve with butter if desired. ",
      "secondary_message": null
    }
  ],
