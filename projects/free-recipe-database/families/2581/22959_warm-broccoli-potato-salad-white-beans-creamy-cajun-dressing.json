  "instructions": [
    {
      "id": 379381,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 379382,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg new potatoes\n3 red bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 379383,
      "primary_message": "Quarter potatoes and divide between two large baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 379384,
      "primary_message": "Trim, seed, and roughly chop bell peppers into bite-sized pieces. Add to the baking sheets with the potatoes along with the broccoli.",
      "secondary_message": "1 ½ (510 g) bags broccoli florets"
    },
    {
      "id": 379385,
      "primary_message": "Drizzle veggies with oil and season with salt. Toss to combine and spread out in an even layer. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 379386,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring veggies halfway through, until fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 379387,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 379388,
      "primary_message": "Add dressing, vinegar, Cajun seasoning, and salt to the bowl with the green onion. Stir to combine the dressing.",
      "secondary_message": "¾ cup ranch dressing\n2 tbsp white wine vinegar\n1 ½ tbsp Cajun seasoning\n½ tsp salt"
    },
    {
      "id": 379389,
      "primary_message": "Drain and rinse beans, then add to the bowl with the dressing. ",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 379390,
      "primary_message": "When the veggies are done, remove from the oven. Add to the bowl and toss to combine the warm veggie-bean salad.",
      "secondary_message": null
    },
    {
      "id": 379391,
      "primary_message": "To serve, divide veggie-bean salad between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
