  "instructions": [
    {
      "id": 379348,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 379349,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg new potatoes\n3 red bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 379350,
      "primary_message": "Quarter potatoes and divide between two large baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 379351,
      "primary_message": "Trim, seed, and roughly chop bell peppers into bite-sized pieces. Add to the baking sheets with the potatoes along with the broccoli.",
      "secondary_message": "1 ½ (510 g) bags broccoli florets"
    },
    {
      "id": 379352,
      "primary_message": "Drizzle veggies with oil and season with salt; toss to combine and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 379353,
      "primary_message": "Pat the pork chops dry with paper towels and add to the baking sheets, nestling them into the veggies. Drizzle chops with additional oil and season both sides with salt. ",
      "secondary_message": "6 pork chops, boneless\n1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 379354,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring veggies and turning pork halfway through, until veggies are fork-tender and pork is cooked through, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 379355,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 379356,
      "primary_message": "Add dressing, vinegar, Cajun seasoning, and salt to the bowl with the green onion. Stir to combine the dressing. ",
      "secondary_message": "½ cup ranch dressing\n1 ½ tbsp white wine vinegar\n1 ½ tbsp Cajun seasoning\n½ tsp salt"
    },
    {
      "id": 379357,
      "primary_message": "When the veggies and pork are done, remove from the oven. Add roasted veggies to the bowl with the dressing and toss to combine the warm broccoli-potato salad.",
      "secondary_message": null
    },
    {
      "id": 379358,
      "primary_message": "To serve, divide broccoli-potato salad and pork between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
