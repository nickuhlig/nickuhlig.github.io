  "instructions": [
    {
      "id": 379304,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 379305,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n2 red bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 379306,
      "primary_message": "Quarter potatoes and transfer to a large baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 379307,
      "primary_message": "Trim, seed, and roughly chop bell peppers into bite-sized pieces. Add to the baking sheet with the potatoes along with the broccoli.",
      "secondary_message": "1 (18 oz) bag broccoli florets"
    },
    {
      "id": 379308,
      "primary_message": "Drizzle veggies with oil and season with salt. Toss to combine and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 379309,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring veggies halfway through, until fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 379310,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 379311,
      "primary_message": "Add dressing, vinegar, Cajun seasoning, and salt to the bowl with the green onion. Stir to combine the dressing.",
      "secondary_message": "½ cup ranch dressing\n4 tsp white wine vinegar\n1 tbsp Cajun seasoning\n¼ tsp salt"
    },
    {
      "id": 379312,
      "primary_message": "Drain and rinse beans, then add to the bowl with the dressing. ",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 379313,
      "primary_message": "When the veggies are done, remove from the oven. Add to the bowl and toss to combine the warm veggie-bean salad.",
      "secondary_message": null
    },
    {
      "id": 379314,
      "primary_message": "To serve, divide veggie-bean salad between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
