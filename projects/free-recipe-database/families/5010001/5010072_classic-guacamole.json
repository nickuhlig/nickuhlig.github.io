  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly chop the of 1 medium white onion. Stem and roughly chop the serrano chile. Pick the cilantro leaves, then finely chop the tender stems. Juice the limes.",
      "secondary_message": "½ of 1 medium white onion\n1 serrano chile\n½ cup cilantro leaves, divided\n1 ½ limes"
    },
    {
      "id": 1,
      "primary_message": "Place onion, chile, half of cilantro leaves, and a large pinch of salt in a molcajete or mortar and pestle. Pound into a fine paste. Alternatively, combine onion, chile, half of cilantro, salt, and half of lime juice in a food processor or blender and process, scraping down sides as necessary, until smooth paste is formed.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Split each avocado in half, discard pits, and spoon out flesh into the molcajete or mortar and pestle (if large enough), or combine with the onion-chile purée in a medium mixing bowl. Roughly mash with the pestle or a stiff whisk.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in remaining cilantro leaves, then season with lime juice and salt to taste. Serve immediately with warm tortilla chips or as desired.",
      "secondary_message": null
    }
  ],
