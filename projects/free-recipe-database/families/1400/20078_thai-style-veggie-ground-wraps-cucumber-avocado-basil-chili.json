  "instructions": [
    {
      "id": 334818,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 lime\n½ English cucumber\n½ small pkg fresh basil\n1 red chili pepper\n½ avocado\n½ head butter (Boston) lettuce"
    },
    {
      "id": 334819,
      "primary_message": "Peel and mince shallot and garlic; place both in a small bowl. ",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 334820,
      "primary_message": "Trim green onions and cut crosswise into thin pieces; add to the bowl with the shallot and garlic. ",
      "secondary_message": null
    },
    {
      "id": 334821,
      "primary_message": "Juice half of the lime into the bowl. Cut remaining lime into wedges and transfer to a plate; set aside. ",
      "secondary_message": null
    },
    {
      "id": 334822,
      "primary_message": "Add soy sauce, oil, and vinegar to the bowl; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp toasted sesame oil\n2 tbsp rice vinegar"
    },
    {
      "id": 334823,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334824,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, about 5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n227 g veggie ground, plant based"
    },
    {
      "id": 334825,
      "primary_message": "Pour ⅓ of the dressing over the veggie ground and stir to combine; bring to a simmer and continue to cook until reduced, 1-2 minutes more. Remove from heat and set aside. (Reserve remaining dressing for serving.)",
      "secondary_message": null
    },
    {
      "id": 334826,
      "primary_message": "Meanwhile, trim and thinly slice cucumber into rounds; add to the plate with the lime wedges. ",
      "secondary_message": null
    },
    {
      "id": 334827,
      "primary_message": "Pick basil leaves off the stems and add to the plate. ",
      "secondary_message": null
    },
    {
      "id": 334828,
      "primary_message": "Trim and thinly slice chili pepper into rounds; add to the plate. (Be careful with chilies; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 334829,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 334830,
      "primary_message": "Separate lettuce into leaves; divide lettuce, veggie ground, lime wedges, cucumber, basil, chili pepper, and avocado between plates. Serve with remaining dressing on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
