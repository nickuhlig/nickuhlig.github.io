  "instructions": [
    {
      "id": 334794,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n2 limes\n1 English cucumber\n1 small pkg fresh basil\n2 red chili peppers\n1 head butter (Boston) lettuce"
    },
    {
      "id": 334795,
      "primary_message": "Peel and mince shallots and garlic; place in a medium bowl. ",
      "secondary_message": "2 shallots\n4 cloves garlic"
    },
    {
      "id": 334796,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl with the shallot and garlic. ",
      "secondary_message": null
    },
    {
      "id": 334797,
      "primary_message": "Juice one of the limes into the bowl. Cut remaining lime into wedges and transfer to a large plate; set aside. ",
      "secondary_message": null
    },
    {
      "id": 334798,
      "primary_message": "Add oil, vinegar, fish sauce, and soy sauce to the bowl; whisk to combine the dressing. ",
      "secondary_message": "¼ cup toasted sesame oil\n¼ cup rice vinegar\n¼ cup fish sauce\n¼ cup soy sauce"
    },
    {
      "id": 334799,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334800,
      "primary_message": "Once the skillet is hot, add ground pork and cook, breaking the meat apart with a spoon, until starting to brown, 3-4 minutes.",
      "secondary_message": "0.68 kg lean ground pork"
    },
    {
      "id": 334801,
      "primary_message": "Pour ⅓ of the dressing over the pork and stir to combine; bring to a simmer and cook for another 1-2 minutes. Remove skillet from the heat and set aside. ",
      "secondary_message": null
    },
    {
      "id": 334802,
      "primary_message": "Meanwhile, trim and thinly slice cucumber into rounds; add to the plate with the lime wedges. ",
      "secondary_message": null
    },
    {
      "id": 334803,
      "primary_message": "Pick basil leaves off the stems and add to the plate. ",
      "secondary_message": null
    },
    {
      "id": 334804,
      "primary_message": "Trim and thinly slice chili peppers into rounds; add to the plate. (Be careful, with chilies, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 334805,
      "primary_message": "Divide pork, lettuce leaves, lime wedges, cucumbers, basil, and chili peppers between plates. Serve with remaining dressing on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
