  "instructions": [
    {
      "id": 334694,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 limes\n1 ½ English cucumbers\n1 small pkg fresh basil\n3 red chili peppers\n1 ½ avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 334695,
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "½ medium red onion\n6 cloves garlic"
    },
    {
      "id": 334696,
      "primary_message": "Trim green onions and cut crosswise into thin pieces; add to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 334697,
      "primary_message": "Juice half of the limes into the bowl. Cut remaining limes into wedges and transfer to a large plate; set aside. ",
      "secondary_message": null
    },
    {
      "id": 334698,
      "primary_message": "Add soy sauce, oil, and vinegar to the bowl; whisk to combine the dressing. ",
      "secondary_message": "½ cup soy sauce\n⅓ cup toasted sesame oil\n⅓ cup rice vinegar"
    },
    {
      "id": 334699,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334700,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil\n24 oz veggie ground, plant based"
    },
    {
      "id": 334701,
      "primary_message": "Pour ⅓ of the dressing over the veggie ground and stir to combine; bring to a simmer and continue to cook until reduced, 2-3 minutes more. Remove from heat and set aside. (Reserve remaining dressing for serving.)",
      "secondary_message": null
    },
    {
      "id": 334702,
      "primary_message": "Meanwhile, trim and thinly slice cucumbers into rounds; add to the plate with the lime wedges. ",
      "secondary_message": null
    },
    {
      "id": 334703,
      "primary_message": "Pick basil leaves off the stems and add to the plate. ",
      "secondary_message": null
    },
    {
      "id": 334704,
      "primary_message": "Trim and thinly slice chili peppers into rounds; add to the plate. (Be careful with chilies; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 334705,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 334706,
      "primary_message": "Separate lettuce into leaves; divide lettuce, veggie ground, lime wedges, cucumber, basil, chili pepper, and avocado between plates. Serve with remaining dressing on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
