  "instructions": [
    {
      "id": 334806,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 limes\n1 ½ English cucumbers\n1 small pkg fresh basil\n3 red chili peppers\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 334807,
      "primary_message": "Peel and mince shallots and garlic; place in a medium bowl. ",
      "secondary_message": "3 shallots\n6 cloves garlic"
    },
    {
      "id": 334808,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl with the shallot and garlic. ",
      "secondary_message": null
    },
    {
      "id": 334809,
      "primary_message": "Juice half the limes into the bowl. Cut remaining limes into wedges and transfer to a large plate; set aside. ",
      "secondary_message": null
    },
    {
      "id": 334810,
      "primary_message": "Add oil, vinegar, fish sauce, and soy sauce to the bowl; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup toasted sesame oil\n⅓ cup rice vinegar\n⅓ cup fish sauce\n⅓ cup soy sauce"
    },
    {
      "id": 334811,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334812,
      "primary_message": "Once the skillet is hot, add ground pork and cook, breaking the meat apart with a spoon, until starting to brown, 4-5 minutes.",
      "secondary_message": "1.02 kg lean ground pork"
    },
    {
      "id": 334813,
      "primary_message": "Pour ⅓ of the dressing over the pork and stir to combine; bring to a simmer and cook for another 2-3 minutes. Remove skillet from the heat and set aside. ",
      "secondary_message": null
    },
    {
      "id": 334814,
      "primary_message": "Meanwhile, trim and thinly slice cucumbers into rounds; add to the plate with the lime wedges. ",
      "secondary_message": null
    },
    {
      "id": 334815,
      "primary_message": "Pick basil leaves off the stems and add to the plate. ",
      "secondary_message": null
    },
    {
      "id": 334816,
      "primary_message": "Trim and thinly slice chili peppers into rounds; add to the plate. (Be careful, with chilies, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 334817,
      "primary_message": "Divide pork, lettuce leaves, lime wedges, cucumbers, basil, and chili peppers between plates. Serve with remaining dressing on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
