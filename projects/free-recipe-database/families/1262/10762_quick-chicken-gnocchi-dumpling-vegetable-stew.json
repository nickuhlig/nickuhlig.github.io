  "instructions": [
    {
      "id": 183985,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 183986,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 183987,
      "primary_message": "Pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 183988,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the chicken, salt, and pepper. Cook, stirring often, until golden and cooked through, about 5 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 183989,
      "primary_message": "Once the water in the pot is boiling, add the gnocchi and cook, stirring frequently, until cooked through, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "1 (454 g) pkg potato gnocchi"
    },
    {
      "id": 183990,
      "primary_message": "Return the pot to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 183991,
      "primary_message": "Peel and medium dice the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 183992,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onions and spices; cook, stirring often, until onions begin to soften, 2-3 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp thyme\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 183993,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 183994,
      "primary_message": "Peel and thinly slice the carrots into rounds. Slice celery crosswise into ¼-inch pieces. Add to the pot and continue to cook, stirring often, until veggies are soft, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 183995,
      "primary_message": "Add flour to the pot and cook, stirring constantly, until combined, about 1 minute. ",
      "secondary_message": "1 tbsp all-purpose flour"
    },
    {
      "id": 183996,
      "primary_message": "Gradually stir broth into the pot, then add the chicken, gnocchi, and peas. Bring to a boil over high heat, then reduce heat to low and simmer, stirring often, until slightly thickened and warmed through, 3-4 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n½ cup frozen peas"
    },
    {
      "id": 183997,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 183998,
      "primary_message": "To serve, divide the stew between bowls and enjoy!",
      "secondary_message": null
    }
  ],
