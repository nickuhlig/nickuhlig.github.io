  "instructions": [
    {
      "id": 184053,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 184054,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 184055,
      "primary_message": "Peel and thinly slice the carrots into rounds. Slice celery crosswise into ¼-inch pieces. Transfer both to a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 184056,
      "primary_message": "Once the water in the pot is boiling, add the gnocchi and cook, stirring frequently, until cooked through, about 3 minutes. Drain and rinse in a colander and set aside.",
      "secondary_message": "3 (454 g) pkgs potato gnocchi"
    },
    {
      "id": 184057,
      "primary_message": "Meanwhile, peel and medium dice the onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 184058,
      "primary_message": "Return the pot to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 184059,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add carrots, celery, and onions. Cook, stirring often, until veggies begin to soften, 4-5 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 184060,
      "primary_message": "Meanwhile, slice sausages into ½-inch rounds.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 184061,
      "primary_message": "Add sausage and spices to the pot and continue to cook, stirring often, until sausage is warmed through, and veggies are tender, 5 minutes more (or cook sausages according to package instructions). ",
      "secondary_message": "¾ tsp thyme\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 184062,
      "primary_message": "Add flour to the pot and cook, stirring constantly, until combined, about 1 minute. ",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 184063,
      "primary_message": "Gradually stir broth into the pot, then add the gnocchi and peas. Bring to a boil over high heat, then reduce heat to low and simmer, stirring often, until slightly thickened and warmed through, about 5 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n1 ½ cups frozen peas"
    },
    {
      "id": 184064,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 184065,
      "primary_message": "To serve, divide the stew between bowls and enjoy!",
      "secondary_message": null
    }
  ],
