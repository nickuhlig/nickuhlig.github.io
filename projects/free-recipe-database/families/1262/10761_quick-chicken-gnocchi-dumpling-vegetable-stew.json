  "instructions": [
    {
      "id": 183932,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 183933,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 183934,
      "primary_message": "Pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 183935,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the chicken, salt, and pepper. Cook, stirring often, until golden and cooked through, 6-7 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 183936,
      "primary_message": "Once the water in the pot is boiling, add the gnocchi and cook, stirring frequently, until cooked through, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "3 (16 oz) pkg potato gnocchi"
    },
    {
      "id": 183937,
      "primary_message": "Return the pot to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 183938,
      "primary_message": "Peel and medium dice the onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 183939,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onions and spices; cook, stirring often, until onions begin to soften, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp thyme\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 183940,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 183941,
      "primary_message": "Peel and thinly slice the carrots into rounds. Slice celery crosswise into ¼-inch pieces. Add to the pot and continue to cook, stirring often, until veggies are soft, 4-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 183942,
      "primary_message": "Add flour to the pot and cook, stirring constantly, until combined, about 1 minute. ",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 183943,
      "primary_message": "Gradually stir broth into the pot, then add the chicken, gnocchi, and peas. Bring to a boil over high heat, then reduce heat to low and simmer, stirring often, until slightly thickened and warmed through, about 5 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 ½ cups frozen peas"
    },
    {
      "id": 183944,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 183945,
      "primary_message": "To serve, divide the stew between bowls and enjoy!",
      "secondary_message": null
    }
  ],
