  "instructions": [
    {
      "id": 183959,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 183960,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n4 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 183961,
      "primary_message": "Peel and thinly slice the carrots into rounds. Slice celery crosswise into ¼-inch pieces. Transfer both to a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 183962,
      "primary_message": "Once the water in the pot is boiling, add the gnocchi and cook, stirring frequently, until cooked through, about 3 minutes. Drain and rinse in a colander and set aside.",
      "secondary_message": "2 (16 oz) pkg potato gnocchi"
    },
    {
      "id": 183963,
      "primary_message": "Meanwhile, peel and medium dice the onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 183964,
      "primary_message": "Return the pot to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 183965,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add carrots, celery, and onions. Cook, stirring often, until veggies begin to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 183966,
      "primary_message": "Meanwhile, slice sausages into ½-inch rounds.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 183967,
      "primary_message": "Add sausage and spices to the pot and continue to cook, stirring often, until sausage is warmed through, and veggies are tender, 4-5 minutes more (or cook sausages according to package instructions). ",
      "secondary_message": "½ tsp thyme\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 183968,
      "primary_message": "Add flour to the pot and cook, stirring constantly, until combined, about 1 minute. ",
      "secondary_message": "4 tsp all-purpose flour"
    },
    {
      "id": 183969,
      "primary_message": "Gradually stir broth into the pot, then add the gnocchi and peas. Bring to a boil over high heat, then reduce heat to low and simmer, stirring often, until slightly thickened and warmed through, 4-5 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 cup frozen peas"
    },
    {
      "id": 183970,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 183971,
      "primary_message": "To serve, divide the stew between bowls and enjoy!",
      "secondary_message": null
    }
  ],
