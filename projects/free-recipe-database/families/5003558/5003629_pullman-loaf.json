  "instructions": [
    {
      "id": 1,
      "primary_message": "In the bowl of your stand mixer, combine the water, semolina flour, honey, yeast, and bread flour. Stir to combine. Cover and set aside for 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the white wheat flour, salt, and butter and knead with the dough hook attachment of your stand mixer until the dough is smooth and elastic. Flour your work surface lightly, and knead by hand briefly, then form the dough into a ball. Drizzle with olive oil and return it to the bowl. Cover with plastic wrap and set aside for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat the oven to 175°C (350°F). Turn out the dough and knead it briefly to knock out the large bubbles. Form it into a log about 33 cm long - to fit inside the pan. Place the log in the pan, seam-side down. Put the lid on the pan and set aside until the dough has risen to within about an inch of the top of the pan, at least 30 minutes and up to 1 hour 30 minutes proofing times vary depending on the ambient temperature of your kitchen).",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bake until the loaf is golden brown, about 40 minutes. Remove the loaf from the pan and allow it to cool completely on a rack before slicing.",
      "secondary_message": null
    }
  ],
