  "instructions": [
    {
      "id": 373050,
      "primary_message": "Wash kale, fold leaves in half lengthwise, and slice off the stems. Chop or tear leaves into bite-sized pieces and set aside. ",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 373051,
      "primary_message": "Preheat a stainless steel or cast iron skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 373052,
      "primary_message": "Chop bacon into 1-inch pieces; add to the skillet and cook until crispy, 4-5 minutes. ",
      "secondary_message": "18 slices bacon"
    },
    {
      "id": 373053,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 373054,
      "primary_message": "Once bacon is cooked, tilt the skillet and use a spoon to remove and discard half of the bacon drippings. ",
      "secondary_message": null
    },
    {
      "id": 373055,
      "primary_message": "Add kale, crushed red pepper, garlic, salt, and pepper to the skillet. Cook, stirring occasionaly, until kale is wilted, 2-3 minutes. Cover the skillet with a large lid to help the wilting process. ",
      "secondary_message": "1 ½ tsp crushed red pepper\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 373056,
      "primary_message": "Place a non-stick skillet over medium-high heat and add butter. ",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 373057,
      "primary_message": "Once the butter begins to bubble, gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes. Cook in batches. ",
      "secondary_message": "12 eggs"
    },
    {
      "id": 373058,
      "primary_message": "To serve, arrange kale, bacon, and eggs in bowls. Season with salt and pepper and enjoy! ",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    }
  ],
