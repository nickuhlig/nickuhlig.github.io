  "instructions": [
    {
      "id": 403928,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 403929,
      "primary_message": "Coarsely grate tofu and transfer to a large baking sheet pan. Drizzle with oil and season with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu\n2 tbsp extra virgin olive oil\n1 ½ tbsp chili powder\n4 tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 403930,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tofu is golden and just starting to dry out, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 403931,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 small pkg chives\n1 medium head napa cabbage\n1 bunch radish\n4 sticks celery"
    },
    {
      "id": 403932,
      "primary_message": "Juice lime into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 403933,
      "primary_message": "Chop chives into small pieces. Add to the bowl with the lime juice along with yogurt, mayo, and spices. Stir to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tsp garlic powder\n1 tsp dill, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 403934,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 403935,
      "primary_message": "Trim and halve radishes lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 403936,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 403937,
      "primary_message": "Place ketchup, vinegar, sugar, soy sauce, Dijon, salt, and pepper in a large pot; stir to combine the BBQ sauce.",
      "secondary_message": "½ cup ketchup\n½ cup balsamic vinegar\n2 tbsp brown sugar\n1 tbsp soy sauce\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 403938,
      "primary_message": "Bring sauce to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until slightly thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 403939,
      "primary_message": "When the tofu is done, add to the pot with the BBQ sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 403940,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 403941,
      "primary_message": "Place bottom half of each bun on a plate; top with BBQ tofu and a small portion of the slaw. Close with the top half of each bun and serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
