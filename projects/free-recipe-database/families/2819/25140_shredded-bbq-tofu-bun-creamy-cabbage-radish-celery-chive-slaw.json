  "instructions": [
    {
      "id": 403816,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 403817,
      "primary_message": "Coarsely grate tofu and divide between two large baking sheet pans. Drizzle with oil and season with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu\n3 tbsp extra virgin olive oil\n2 tbsp chili powder\n2 tbsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 403818,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tofu is golden and just starting to dry out, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 403819,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 small pkg chives\n1 ½ medium heads napa cabbage\n1 ½ bunches radish\n6 sticks celery"
    },
    {
      "id": 403820,
      "primary_message": "Juice limes into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 403821,
      "primary_message": "Chop chives into small pieces. Add to the bowl with the lime juice along with yogurt, mayo, and spices. Stir to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n¼ cup mayonnaise\n1 ½ tsp garlic powder\n1 ½ tsp dill, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 403822,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 403823,
      "primary_message": "Trim and halve radishes lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 403824,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 403825,
      "primary_message": "Place ketchup, vinegar, sugar, soy sauce, Dijon, salt, and pepper in a large pot; stir to combine the BBQ sauce.",
      "secondary_message": "¾ cup ketchup\n¾ cup balsamic vinegar\n3 tbsp brown sugar\n1 ½ tbsp soy sauce\n1 ½ tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 403826,
      "primary_message": "Bring sauce to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until slightly thickened, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 403827,
      "primary_message": "When the tofu is done, add to the pot with the BBQ sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 403828,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 403829,
      "primary_message": "Place bottom half of each bun on a plate; top with BBQ tofu and a small portion of the slaw. Close with the top half of each bun and serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
