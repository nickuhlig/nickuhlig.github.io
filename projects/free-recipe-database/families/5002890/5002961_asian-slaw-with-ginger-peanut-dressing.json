  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the ginger. Mince the garlic clove. Shred the green cabbage. Thinly slice the red bell pepper. Finely slice the scallions on a sharp bias. Chop the salted peanuts. Chop the loosely packed fresh cilantro.",
      "secondary_message": "1 tbsp ginger root\n1 large garlic clove\n1 small head green cabbage\n1 red bell pepper\n2 medium scallions\n½ cup salted peanuts\n½ cup loosely packed fresh cilantro"
    },
    {
      "id": 1,
      "primary_message": "Combine all of the dressing ingredients in a medium bowl. Stir until the peanut butter is dissolved. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine all of the slaw ingredients in a large bowl. Add the dressing and toss well. Let sit at least 10 minutes so the vegetables have a chance to soak up the dressing. Taste and adjust seasoning with salt or sriracha sauce if necessary. Serve cold.",
      "secondary_message": null
    }
