  "instructions": [
    {
      "id": 192075,
      "primary_message": "Preheat oven to 220°C (425°F) and position a rack in the center. Line a sheet pan with aluminum foil (optional).",
      "secondary_message": null
    },
    {
      "id": 192076,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 small bunch green onions (scallions)\n2 limes\n1 small head red cabbage"
    },
    {
      "id": 192077,
      "primary_message": "Peel and mince the garlic; transfer to a large bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 192078,
      "primary_message": "Add ketchup, sugar, soy sauce, vinegar, and chili-garlic sauce to the bowl with the garlic and whisk together; add the chicken drumsticks and toss to coat.",
      "secondary_message": "½ cup ketchup\n4 tsp brown sugar\n2 tsp soy sauce\n1 tsp apple cider vinegar\n1 tsp chili-garlic sauce\n1 ⅛ kg chicken drumsticks"
    },
    {
      "id": 192079,
      "primary_message": "Spread the ​chicken out in a single layer on the prepared sheet pan, setting aside any marinade remaining in the bowl. Place in the oven and roast for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 192080,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 192081,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 192082,
      "primary_message": "Zest and juice the limes into a large bowl; add oil, honey, cilantro, green onion, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp honey\n½ tsp salt\n1 tsp black pepper"
    },
    {
      "id": 192083,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise into shreds. Add cabbage to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 192084,
      "primary_message": "Remove the chicken from the oven, flip each drumstick, then spoon on the remaining marinade. Return chicken to the oven and bake until cooked through, about 15 minutes more.",
      "secondary_message": null
    },
    {
      "id": 192085,
      "primary_message": "To serve, divide slaw and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
