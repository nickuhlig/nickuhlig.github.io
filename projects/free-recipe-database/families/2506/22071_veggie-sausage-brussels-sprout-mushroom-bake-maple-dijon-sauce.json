  "instructions": [
    {
      "id": 370109,
      "primary_message": "Preheat oven to 230°C (450°F). Arrange racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 370110,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg Brussels sprouts\n0.68 kg cremini mushrooms\n3 leeks"
    },
    {
      "id": 370111,
      "primary_message": "Trim and halve Brussels sprouts lengthwise. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 370112,
      "primary_message": "Quarter mushrooms and add to the baking sheets with the Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 370113,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 370114,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 370115,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and bake until just tender, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 370116,
      "primary_message": "Meanwhile, place oil, Dijon, maple syrup, vinegar, salt, and pepper in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp Dijon mustard\n3 tbsp pure maple syrup\n3 tbsp apple cider vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 370117,
      "primary_message": "When the veggies are done, remove from the oven and stir. Add sausages to the baking sheets, nestling them into the veggies. Drizzle sausages with additional oil.",
      "secondary_message": "6 pre-cooked vegan sausage\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 370118,
      "primary_message": "Return baking sheets to the oven and continue to bake until sausages are warmed through, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 370119,
      "primary_message": "When the sausages are warmed through, remove from oven. Change oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 370120,
      "primary_message": "Working in batches, return baking sheets to the upper rack of the oven and broil until veggies and sausages are browned, about 3 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 370121,
      "primary_message": "To serve, divide veggies and sausages between plates; drizzle with sauce. Enjoy!",
      "secondary_message": null
    }
  ],
