  "instructions": [
    {
      "id": 370073,
      "primary_message": "Preheat oven to 230°C (450°F). Arrange racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 370074,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg Brussels sprouts\n0.68 kg cremini mushrooms\n3 leeks"
    },
    {
      "id": 370075,
      "primary_message": "Trim and halve Brussels sprouts lengthwise. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 370076,
      "primary_message": "Quarter mushrooms and add to the baking sheets with the Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 370077,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 370078,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 370079,
      "primary_message": "Add sausages to the baking sheets, nestling them into the veggies.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 370080,
      "primary_message": "Place the baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring veggies and flipping sausages halfway through, until veggies are tender and sausages are nearly cooked through, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 370081,
      "primary_message": "Meanwhile, place oil, Dijon, vinegar, honey, salt, and pepper in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp Dijon mustard\n3 tbsp apple cider vinegar\n2 tbsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 370082,
      "primary_message": "When the veggies and sausages are nearly done, remove from oven. Change oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 370083,
      "primary_message": "Working in batches, return baking sheets to upper rack of the oven and broil until veggies and sausages are browned, about 3 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 370084,
      "primary_message": "To serve, divide sausages and veggies between plates; drizzle with sauce. Enjoy!",
      "secondary_message": null
    }
  ],
