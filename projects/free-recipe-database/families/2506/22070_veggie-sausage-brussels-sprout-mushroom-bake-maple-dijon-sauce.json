  "instructions": [
    {
      "id": 370097,
      "primary_message": "Preheat oven to 230°C (450°F) and position rack in the upper third of the oven. ",
      "secondary_message": null
    },
    {
      "id": 370098,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg Brussels sprouts\n0.45 kg cremini mushrooms\n2 leeks"
    },
    {
      "id": 370099,
      "primary_message": "Trim and halve Brussels sprouts lengthwise. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 370100,
      "primary_message": "Quarter mushrooms and add to the baking sheet with the Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 370101,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 370102,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 370103,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and bake until just tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 370104,
      "primary_message": "Meanwhile, place oil, Dijon, maple syrup, vinegar, salt, and pepper in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n2 tbsp pure maple syrup\n2 tbsp apple cider vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 370105,
      "primary_message": "When the veggies are done, remove from the oven and stir. Add sausages to the baking sheet, nestling them into the veggies. Drizzle sausages with additional oil.",
      "secondary_message": "4 pre-cooked vegan sausage\n2 tsp extra virgin olive oil"
    },
    {
      "id": 370106,
      "primary_message": "Return baking sheet to the oven and continue to bake until sausages are warmed through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 370107,
      "primary_message": "When the sausages are warmed through, change the oven to broil on high. Broil until veggies and sausages are browned, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370108,
      "primary_message": "To serve, divide veggies and sausages between plates; drizzle with sauce. Enjoy!",
      "secondary_message": null
    }
  ],
