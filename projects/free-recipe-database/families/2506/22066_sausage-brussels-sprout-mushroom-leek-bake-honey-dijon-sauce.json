  "instructions": [
    {
      "id": 370051,
      "primary_message": "Preheat oven to 230°C (450°F) and position rack in the upper third of the oven. ",
      "secondary_message": null
    },
    {
      "id": 370052,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg Brussels sprouts\n0.23 kg cremini mushrooms\n1 leek"
    },
    {
      "id": 370053,
      "primary_message": "Trim and halve Brussels sprouts lengthwise. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 370054,
      "primary_message": "Quarter mushrooms and add to the baking sheet with the Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 370055,
      "primary_message": "Trim off the root end and dark green top of the leek, leaving only the white and pale green parts. Cut the leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 370056,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 370057,
      "primary_message": "Add sausages to the baking sheet, nestling them into the veggies.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 370058,
      "primary_message": "Place the baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring veggies and flipping sausages halfway through, until veggies are tender and sausages are nearly cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 370059,
      "primary_message": "Meanwhile, place oil, Dijon, vinegar, honey, salt, and pepper in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp apple cider vinegar\n2 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 370060,
      "primary_message": "When the veggies and sausages are nearly done, change the oven to broil on high. Broil until sausages are browned and cooked through, about 3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370061,
      "primary_message": "To serve, divide sausages and veggies between plates; drizzle with sauce. Enjoy!",
      "secondary_message": null
    }
  ],
