  "instructions": [
    {
      "id": 304885,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 304886,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 304887,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 304888,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small pineapple\n½ small bunch green onions (scallions)\n2 sticks celery\n1 medium carrot\n1 (1 inch) piece ginger root\n½ small bunch cilantro"
    },
    {
      "id": 304889,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 304890,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 304891,
      "primary_message": "While the skillet heats up, medium dice tofu, then sprinkle with cornstarch, salt, and pepper.",
      "secondary_message": "2 tsp cornstarch\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 304892,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning every few minutes, until golden brown and crispy on all sides, about 10 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 304893,
      "primary_message": "Meanwhile, trim and slice green onion and celery crosswise into ¼-inch pieces; add both to the bowl with the pineapple.",
      "secondary_message": null
    },
    {
      "id": 304894,
      "primary_message": "Peel, trim, and slice carrot crosswise into ¼-inch thick rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 304895,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 304896,
      "primary_message": "When the tofu is done, return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add pineapple, veggies, and edamame; stir-fry until veggies are fork-tender, 4-5 minutes.",
      "secondary_message": "2 tsp virgin coconut oil\n½ cup edamame, shelled"
    },
    {
      "id": 304897,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 304898,
      "primary_message": "When the veggies are done, add cooked rice, tofu, and soy sauce to the skillet; continue to cook, stirring constantly, until combined and heated through, 1-2 minutes more. Remove from heat, add cilantro, and stir to combine.",
      "secondary_message": "3 tbsp soy sauce"
    },
    {
      "id": 304899,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
