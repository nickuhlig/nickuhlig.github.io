  "instructions": [
    {
      "id": 305281,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 305282,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 305283,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 305284,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pineapples\n1 small bunch green onions (scallions)\n6 sticks celery\n3 medium carrots\n3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 305285,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and medium dice. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 305286,
      "primary_message": "Medium dice tofu, then sprinkle with cornstarch, salt, and pepper.",
      "secondary_message": "2 tbsp cornstarch\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 305287,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 305288,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, turning every few minutes, until golden brown and crispy on all sides, about 10 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 305289,
      "primary_message": "Meanwhile, trim and slice green onion and celery crosswise into ¼-inch pieces; add both to the bowl with the pineapple.",
      "secondary_message": null
    },
    {
      "id": 305290,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 305291,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 305292,
      "primary_message": "When the tofu is done, return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add pineapple, veggies, and edamame; stir-fry until veggies are fork-tender, 5-6 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n1 ½ cups edamame"
    },
    {
      "id": 305293,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 305294,
      "primary_message": "When the veggies are done, add cooked rice, tofu, and soy sauce to the pot; continue to cook, stirring constantly, until combined and heated through, 2-3 minutes more. Remove from heat, add cilantro, and stir to combine.",
      "secondary_message": "½ cup soy sauce"
    },
    {
      "id": 305295,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
