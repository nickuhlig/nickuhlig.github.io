  "instructions": [
    {
      "id": 305045,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 305046,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 305047,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pineapples\n1 small bunch green onions (scallions)\n6 sticks celery\n3 medium carrots\n3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 305048,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and medium dice. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 305049,
      "primary_message": "Trim and slice green onion and celery crosswise into ¼-inch pieces; add both to the bowl with the pineapple.",
      "secondary_message": null
    },
    {
      "id": 305050,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 305051,
      "primary_message": "Peel and mince ginger and garlic; add to the bowl and set aside.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 305052,
      "primary_message": "Pat pork chops dry with paper towels and place on the cutting board; thinly slice crosswise into bite-sized strips, then season with salt and pepper.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 305053,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 305054,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add pork and stir-fry until browned and cooked through, 4-5 minutes. Transfer to a plate. ",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 305055,
      "primary_message": "When the pork is done, return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add pineapple, veggies, and edamame; stir-fry until veggies are fork-tender, 5-6 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n1 ½ cups edamame"
    },
    {
      "id": 305056,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 305057,
      "primary_message": "When the veggies are done, add cooked rice, pork (with any accumulated juices), and soy sauce to the pot; continue to cook, stirring constantly, until combined and heated through, 2-3 minutes more. Remove from heat, add cilantro, and stir to combine.",
      "secondary_message": "½ cup soy sauce"
    },
    {
      "id": 305058,
      "primary_message": "fTo serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
