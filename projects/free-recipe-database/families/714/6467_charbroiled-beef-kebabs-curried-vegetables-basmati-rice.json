  "instructions": [
    {
      "id": 164254,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Season the rice with salt, add water and bring to a boil over high heat.",
      "secondary_message": "2 cups basmati rice\n4 cup water\n1 tsp salt"
    },
    {
      "id": 164255,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n3 yellow bell peppers\n1 ½ small bunches cilantro"
    },
    {
      "id": 164256,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 164257,
      "primary_message": "Season steak with salt and pepper and cut into 1 inch cubes.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 164258,
      "primary_message": "Once the liquid with the rice comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 164259,
      "primary_message": "Peel the onions, cut it into quarters and separate it into slices; place in a medium bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 164260,
      "primary_message": "Trim off the ends of the zucchinis then cut in half lengthwise; Cut into 2 inch pieces and add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 164261,
      "primary_message": "Cut peppers into quarters, remove seeds and membranes; cut in half crosswise and add to bowl with zucchini and onion.",
      "secondary_message": null
    },
    {
      "id": 164262,
      "primary_message": "Add oil, curry powder, pepper and salt to the bowl with the veggies, toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp curry powder\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 164263,
      "primary_message": "Thread beef, onion, squash and peppers onto skewers and place onto the broiler pan. If you don't have skewers, spread veggies and steak on the broiler pan. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 164264,
      "primary_message": "Broil in preheated oven, turning every 3 minutes, until done, about 12 minutes. If you aren't using skewers simply toss the vegetables and beef every 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 164265,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 164266,
      "primary_message": "Uncover the rice and fluff with a fork; gently fold in minced cilantro, reserving 3 tbsp for garnish. ",
      "secondary_message": null
    },
    {
      "id": 164267,
      "primary_message": "To serve, divide rice and skewers between plates and garnish with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
