  "instructions": [
    {
      "id": 164568,
      "primary_message": "In a small saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n1 cup water"
    },
    {
      "id": 164569,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small pkg fresh basil\n½ lemon\n1 Gala apple\n½ (142 g) pkg baby arugula\n0.11 kg red grapes"
    },
    {
      "id": 164570,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and mince. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 164571,
      "primary_message": "Peel and mince garlic; add to the bowl with the basil.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 164572,
      "primary_message": "Juice lemon into the bowl and add oil, vinegar, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 164573,
      "primary_message": "Core and thinly slice apple. Peel and slice onion into ¼-inch rings. Place both in the bowl with the dressing and toss to combine.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 164574,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 164575,
      "primary_message": "While the pan heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 164576,
      "primary_message": "Once the grill pan or skillet is hot, coat with oil. Add pork and cook, flipping occasionally, until cooked through, 6-8 minutes. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 164577,
      "primary_message": "Using clean tongs, transfer apples and onions to the grill pan, leaving excess dressing in the bowl. Cook, turning occasionally, until tender and golden, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 164578,
      "primary_message": "Meanwhile, add quinoa and arugula to the bowl with the dressing and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 164579,
      "primary_message": "Cut grapes in half lengthwise.",
      "secondary_message": null
    },
    {
      "id": 164580,
      "primary_message": "Thinly slice the pork chops crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 164581,
      "primary_message": "To serve, divide quinoa salad and pork between bowls; top with grilled apples and onions, grapes, and crumbled goat cheese. Enjoy!",
      "secondary_message": "¼ (113 g) log goat cheese"
    }
  ],
