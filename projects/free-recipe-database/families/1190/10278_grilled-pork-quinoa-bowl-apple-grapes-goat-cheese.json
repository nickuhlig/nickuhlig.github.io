  "instructions": [
    {
      "id": 164554,
      "primary_message": "In a medium saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n3 cup water"
    },
    {
      "id": 164555,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n1 ½ lemons\n3 Gala apples\n1 ½ (5 oz) pkgs baby arugula\n¾ lb red grapes"
    },
    {
      "id": 164556,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and mince. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 164557,
      "primary_message": "Peel and mince garlic; add to the bowl with the basil.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 164558,
      "primary_message": "Juice lemons into the bowl and add oil, vinegar, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n1 tbsp Dijon mustard\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 164559,
      "primary_message": "Core and thinly slice apples. Peel and slice onions into ¼-inch rings. Place both in the bowl with the dressing and toss to combine.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 164560,
      "primary_message": "Preheat a large grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 164561,
      "primary_message": "While the pan heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 164562,
      "primary_message": "Once the grill pan or skillet is hot, coat with oil. Working in batches if necessary add pork and cook, flipping occasionally, until cooked through, 6-8 minutes. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 164563,
      "primary_message": "Using clean tongs, transfer apples and onions to the grill pan, leaving excess dressing in the bowl. Cook, turning occasionally, until tender and golden, about 6 minutes. Work in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 164564,
      "primary_message": "Meanwhile, add quinoa and arugula to the bowl with the dressing and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 164565,
      "primary_message": "Cut grapes in half lengthwise.",
      "secondary_message": null
    },
    {
      "id": 164566,
      "primary_message": "Thinly slice the pork chops crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 164567,
      "primary_message": "To serve, divide quinoa salad and pork between bowls; top with grilled apples and onions, grapes, and crumbled goat cheese. Enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese"
    }
  ],
