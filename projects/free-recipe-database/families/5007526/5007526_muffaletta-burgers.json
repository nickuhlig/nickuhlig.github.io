  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine olives, capers, giardiniera, vinegar, and olive oil in a medium bowl Mix to combine and season with salt and pepper. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over half of coal grate. Alternatively, set half the burners of a gas grill to high heat. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place burgers directly over hot side of grill and cook until well charred, about 2 minutes. Cook on second side until well charred, about 2 minutes longer. Transfer to cooler side of grill. Divide capicola, mortadella, salami, and provolone evenly over burgers, cover, and continue to cook until burgers register 125°F to 130°F on an instant read thermometer for medium rare, about 5 minutes total, or 135°F to 140°F for medium, about 6 minutes total. Transfer to a large plate and tent with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Toast buns directly over hot side of grill until browned, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Divide olive salad evenly between top and bottom buns. Place bottom buns on a cutting board. Top with meat-topped burger patty. Close sandwich and serve.",
      "secondary_message": null
    }
  ],
