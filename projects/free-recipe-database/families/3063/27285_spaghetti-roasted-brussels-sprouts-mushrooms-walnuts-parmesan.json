  "instructions": [
    {
      "id": 439301,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 439302,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz spaghetti pasta"
    },
    {
      "id": 439303,
      "primary_message": "Meanwhile, wash, dry, trim, and halve Brussels sprouts lengthwise. Divide between two large baking sheet pans.",
      "secondary_message": "1 ½ lb Brussels sprouts"
    },
    {
      "id": 439304,
      "primary_message": "Wash, dry, and quarter mushrooms. Add to the baking sheets with the Brussels sprouts.",
      "secondary_message": "1 ½ lb cremini mushrooms"
    },
    {
      "id": 439305,
      "primary_message": "Roughly chop walnuts and add to the baking sheets. Drizzle with oil and maple syrup, then season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 cup walnuts\n3 tbsp extra virgin olive oil\n3 tbsp pure maple syrup\n1 ½ tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 439306,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and walnuts are toasted, 20-25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 439307,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 439308,
      "primary_message": "When the pasta is done, reserve 1 cup of cooking water, then drain. Return pasta and reserved cooking water to the pot; set aside until the veggies are done.",
      "secondary_message": null
    },
    {
      "id": 439309,
      "primary_message": "Add roasted veggies, walnuts, Parmesan, and Dijon to the pot, then set over medium-high heat. Cook, stirring often, until the liquid has evaporated and Parmesan has melted, about 3 minutes. Remove from heat. ",
      "secondary_message": "3 tbsp Dijon mustard"
    },
    {
      "id": 439310,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
