  "instructions": [
    {
      "id": 439411,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 439412,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 439413,
      "primary_message": "Meanwhile, wash, dry, trim, and halve Brussels sprouts lengthwise. Transfer to a large baking sheet pan.",
      "secondary_message": "0.45 kg Brussels sprouts"
    },
    {
      "id": 439414,
      "primary_message": "Wash, dry, and quarter mushrooms. Add to the baking sheet with the Brussels sprouts.",
      "secondary_message": "0.45 kg cremini mushrooms"
    },
    {
      "id": 439415,
      "primary_message": "Roughly chop walnuts and add to the baking sheet. Drizzle with oil and maple syrup, then season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "⅔ cup walnuts\n2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n1 tbsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 439416,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and walnuts are toasted, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 439417,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 439418,
      "primary_message": "When the pasta is done, reserve ⅔-cup of cooking water, then drain. Return pasta and reserved cooking water to the pot; set aside until the veggies are done.",
      "secondary_message": null
    },
    {
      "id": 439419,
      "primary_message": "Add roasted veggies, walnuts, Parmesan, and Dijon to the pot, then set over medium-high heat. Cook, stirring often, until the liquid has evaporated and Parmesan has melted, about 2 minutes. Remove from heat. ",
      "secondary_message": "2 tbsp Dijon mustard"
    },
    {
      "id": 439420,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
