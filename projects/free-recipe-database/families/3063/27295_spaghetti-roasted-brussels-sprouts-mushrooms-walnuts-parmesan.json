  "instructions": [
    {
      "id": 439401,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 439402,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n142 g spaghetti pasta"
    },
    {
      "id": 439403,
      "primary_message": "Meanwhile, wash, dry, trim, and halve Brussels sprouts lengthwise. Transfer to a baking sheet pan.",
      "secondary_message": "0.23 kg Brussels sprouts"
    },
    {
      "id": 439404,
      "primary_message": "Wash, dry, and quarter mushrooms. Add to the baking sheet with the Brussels sprouts.",
      "secondary_message": "0.23 kg cremini mushrooms"
    },
    {
      "id": 439405,
      "primary_message": "Roughly chop walnuts and add to the baking sheet. Drizzle with oil and maple syrup, then season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "⅓ cup walnuts\n1 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 ½ tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 439406,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and walnuts are toasted, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 439407,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 439408,
      "primary_message": "When the pasta is done, reserve a ⅓-cup of cooking water, then drain. Return pasta and reserved cooking water to the pot; set aside until the veggies are done.",
      "secondary_message": null
    },
    {
      "id": 439409,
      "primary_message": "Add roasted veggies, walnuts, Parmesan, and Dijon to the pot, then set over medium-high heat. Cook, stirring often, until the liquid has evaporated and Parmesan has melted, about 1 minute. Remove from heat. ",
      "secondary_message": "1 tbsp Dijon mustard"
    },
    {
      "id": 439410,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
