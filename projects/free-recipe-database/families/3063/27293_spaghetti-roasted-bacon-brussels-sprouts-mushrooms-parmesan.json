  "instructions": [
    {
      "id": 439381,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 439382,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 439383,
      "primary_message": "Meanwhile, wash, dry, trim, and halve Brussels sprouts lengthwise. Transfer to a large baking sheet pan.",
      "secondary_message": "0.45 kg Brussels sprouts"
    },
    {
      "id": 439384,
      "primary_message": "Wash, dry, and quarter mushrooms. Add to the baking sheet with the Brussels sprouts.",
      "secondary_message": "0.45 kg cremini mushrooms"
    },
    {
      "id": 439385,
      "primary_message": "Small dice bacon and add to the baking sheet. Drizzle with oil and maple syrup, then season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "8 slices bacon\n4 tsp extra virgin olive oil\n4 tsp pure maple syrup\n1 tbsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 439386,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and bacon is cooked through, 15-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 439387,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 439388,
      "primary_message": "When the pasta is done, reserve ⅔-cup of cooking water, then drain. Return pasta and reserved cooking water to the pot; set aside until the veggies are done.",
      "secondary_message": null
    },
    {
      "id": 439389,
      "primary_message": "Add roasted veggies, bacon, Parmesan, and Dijon to the pot, then set over medium-high heat. Cook, stirring often, until the liquid has evaporated and Parmesan has melted, about 2 minutes. Remove from heat. ",
      "secondary_message": "2 tbsp Dijon mustard"
    },
    {
      "id": 439390,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
