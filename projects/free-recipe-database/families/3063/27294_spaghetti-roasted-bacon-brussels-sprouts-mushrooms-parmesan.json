  "instructions": [
    {
      "id": 439391,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 439392,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g spaghetti pasta"
    },
    {
      "id": 439393,
      "primary_message": "Meanwhile, wash, dry, trim, and halve Brussels sprouts lengthwise. Divide between two large baking sheet pans.",
      "secondary_message": "0.68 kg Brussels sprouts"
    },
    {
      "id": 439394,
      "primary_message": "Wash, dry, and quarter mushrooms. Add to the baking sheets with the Brussels sprouts.",
      "secondary_message": "0.68 kg cremini mushrooms"
    },
    {
      "id": 439395,
      "primary_message": "Small dice bacon and add to the baking sheets. Drizzle with oil and maple syrup, then season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "12 slices bacon\n2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n1 ½ tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 439396,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and bacon is cooked through, 20-25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 439397,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 439398,
      "primary_message": "When the pasta is done, reserve 1 cup of cooking water, then drain. Return pasta and reserved cooking water to the pot; set aside until the veggies are done.",
      "secondary_message": null
    },
    {
      "id": 439399,
      "primary_message": "Add roasted veggies, bacon, Parmesan, and Dijon to the pot, then set over medium-high heat. Cook, stirring often, until the liquid has evaporated and Parmesan has melted, about 3 minutes. Remove from heat. ",
      "secondary_message": "3 tbsp Dijon mustard"
    },
    {
      "id": 439400,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
