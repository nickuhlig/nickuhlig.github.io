  "instructions": [
    {
      "id": 315395,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 315396,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n6 medium zucchini squash\n1 ½ limes\n1 small bunch cilantro\n1 ½ jalapeño peppers\n3 tomatoes\n3 avocados"
    },
    {
      "id": 315397,
      "primary_message": "Quarter potatoes and divide between two large baking sheet pans; drizzle with oil and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp salt\n¾ tsp cayenne pepper"
    },
    {
      "id": 315398,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until potatoes start to soften, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 315399,
      "primary_message": "Meanwhile, drain and rinse beans; place in a large bowl.",
      "secondary_message": "3 (15 oz) cans kidney beans"
    },
    {
      "id": 315400,
      "primary_message": "Trim and large dice zucchini; add to the bowl with the beans. Drizzle with oil, season with spices, and toss to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 315401,
      "primary_message": "When the potatoes have softened, remove from oven; add beans and zucchini to the baking sheets. Toss to combine and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 315402,
      "primary_message": "Return baking sheets to the oven and continue to roast until veggies are fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 315403,
      "primary_message": "Meanwhile, juice limes into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 315404,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Peel and mince garlic. Add both to the bowl with the lime juice.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 315405,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 315406,
      "primary_message": "Small dice tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 315407,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl and stir to combine the pico de gallo.",
      "secondary_message": null
    },
    {
      "id": 315408,
      "primary_message": "To serve, divide roasted veggies and beans between bowls; top with pico de gallo. Enjoy!",
      "secondary_message": null
    }
  ],
