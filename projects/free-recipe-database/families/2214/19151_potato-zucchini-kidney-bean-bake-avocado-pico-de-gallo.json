  "instructions": [
    {
      "id": 315409,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 315410,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg new potatoes\n2 medium zucchini squash\n½ lime\n½ small bunch cilantro\n½ jalapeño pepper\n1 tomato\n1 avocado"
    },
    {
      "id": 315411,
      "primary_message": "Quarter potatoes and transfer to a baking sheet pan; drizzle with oil and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 315412,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until potatoes start to soften, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 315413,
      "primary_message": "Meanwhile, drain and rinse beans; place in a medium bowl.",
      "secondary_message": "1 (398 ml) can kidney beans"
    },
    {
      "id": 315414,
      "primary_message": "Trim and large dice zucchini; add to the bowl with the beans. Drizzle with oil, season with spices, and toss to combine.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 315415,
      "primary_message": "When the potatoes have softened, remove from oven; add beans and zucchini to the baking sheet. Toss to combine and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 315416,
      "primary_message": "Return baking sheet to the oven and continue to roast until veggies are fork-tender, 10-12 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 315417,
      "primary_message": "Meanwhile, juice lime into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 315418,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Peel and mince garlic. Add both to the bowl with the lime juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 315419,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 315420,
      "primary_message": "Small dice tomato and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 315421,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl and stir to combine the pico de gallo.",
      "secondary_message": null
    },
    {
      "id": 315422,
      "primary_message": "To serve, divide roasted veggies and beans between plates or bowls; top with yogurt and pico de gallo. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
