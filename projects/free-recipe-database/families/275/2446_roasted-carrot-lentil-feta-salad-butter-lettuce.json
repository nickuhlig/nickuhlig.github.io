  "instructions": [
    {
      "id": 23610,
      "primary_message": "Preheat oven to 230°C (450°F) and position rack in the centre.",
      "secondary_message": ""
    },
    {
      "id": 23611,
      "primary_message": "Rinse lentils under cold water and transfer to a medium saucepan. Cover with broth and bring to a boil. Reduce heat to a simmer and, stirring occasionally, cook until just tender, 15-20 minutes.",
      "secondary_message": "1 ½ cups green lentils\n708 ml (3 cups) chicken or vegetable broth"
    },
    {
      "id": 23612,
      "primary_message": "Wash carrots, trim ends, and peel. Halve lengthwise and thinly slice on the diagonal into ⅔ cm thick half rounds; transfer to a baking sheet.",
      "secondary_message": "6 medium carrots\r\n"
    },
    {
      "id": 23613,
      "primary_message": "Peel and thinly slice onion into half rings; add to sheet.",
      "secondary_message": "1 medium red onion\r\n"
    },
    {
      "id": 23614,
      "primary_message": "Drizzle carrots and onion with olive oil and season with cumin, salt, and pepper; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n2 tsp cumin\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23615,
      "primary_message": "Place carrots in the oven and roast, tossing halfway through cooking, until tender, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23616,
      "primary_message": "Peel and mince garlic. In a salad bowl, prepare dressing by whisking together the minced garlic, olive oil, vinegar, honey, Dijon, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\n6 tbsp extra virgin olive oil\r\n2 tbsp apple cider vinegar\r\n1 tsp honey\r\n¼ tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23617,
      "primary_message": "Wash and dry lettuce. Tear into smaller pieces and add to salad bowl.",
      "secondary_message": "2 heads butter (Boston) lettuce\r\n"
    },
    {
      "id": 23618,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Add to salad bowl.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\r\n"
    },
    {
      "id": 23619,
      "primary_message": "Assemble salad by adding carrots and lentils to salad bowl and tossing.",
      "secondary_message": ""
    },
    {
      "id": 23620,
      "primary_message": "Serve by placing salad on a plate and sprinkle with feta. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\r\n"
    }
  ],
