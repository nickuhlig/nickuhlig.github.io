  "instructions": [
    {
      "id": 46627,
      "primary_message": "Separate the lettuce into leaves; wash and spin dry in a salad spinner. Alternatively, wash in a colander, then transfer to a clean towel and pat dry. Set aside.",
      "secondary_message": "2 heads butter (Boston) lettuce"
    },
    {
      "id": 46628,
      "primary_message": "Wash and dry the the remaining fresh produce.",
      "secondary_message": "2 red bell peppers\n2 avocados\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 46629,
      "primary_message": "Drain the tuna and transfer to a large salad bowl; flake with a fork.",
      "secondary_message": "4 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 46630,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Small dice the peppers (cut into ¼-inch cubes) and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 46631,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh (cut into ¼-inch cubes). Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 46632,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add about ¾ of the cilantro to the salad bowl and save the rest for garnishing.",
      "secondary_message": null
    },
    {
      "id": 46633,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces). Add to the salad bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 46634,
      "primary_message": "Juice the lime and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 46635,
      "primary_message": "Add mayonnaise, Dijon, salt, black pepper, and cayenne pepper to the salad bowl; mix the salad until thoroughly coated in the dressing.",
      "secondary_message": "6 tbsp avocado oil mayonnaise\n1 tbsp Dijon mustard\n1 tsp salt\n½ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 46636,
      "primary_message": "To serve, make the lettuce wraps by spooning the tuna salad into the doubled up lettuce leaves, then garnishing with the remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
