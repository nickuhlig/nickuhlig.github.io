  "instructions": [
    {
      "id": 391378,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g linguine pasta"
    },
    {
      "id": 391379,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 391380,
      "primary_message": "While the skillet heats up, wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips. Place half in a medium bowl and set aside for the salad. (Reserve remaining pepper for the next step.)",
      "secondary_message": "2 orange bell peppers"
    },
    {
      "id": 391381,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and cook, stirring occasionally, until starting to soften, 2-3 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 391382,
      "primary_message": "Meanwhile, wash and dry the spinach (skip this step if it came pre-washed). Add half to the bowl with the bell pepper and set aside. (Reserve remaining spinach for the sauce.)",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 391383,
      "primary_message": "When the bell pepper is soft, add Alfredo sauce, water, and spices to the skillet. Stir to combine and bring to a simmer.",
      "secondary_message": "1 (454 g) jar Alfredo sauce\n½ cup water\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 391384,
      "primary_message": "While the sauce is heating, stack turkey slices one on top of another, then medium dice. Add to the skillet and stir to combine.",
      "secondary_message": "454 g oven roasted turkey breast, sliced"
    },
    {
      "id": 391385,
      "primary_message": "Once the sauce is simmering, add remaining spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 391386,
      "primary_message": "When the pasta is done, drain and transfer to the skillet with the sauce; toss to combine. Return to medium heat and continue to cook, tossing occasionally, until sauce coats the pasta, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 391387,
      "primary_message": "Add dressing to the bowl with the bell pepper and spinach. Toss to combine the salad. ",
      "secondary_message": "¼ cup Italian salad dressing"
    },
    {
      "id": 391388,
      "primary_message": "To serve, divide pasta and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
