  "instructions": [
    {
      "id": 391257,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz linguine pasta"
    },
    {
      "id": 391258,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips. Place half in a large bowl and set aside for the salad. (Reserve remaining pepper for the next step.)",
      "secondary_message": "3 orange bell peppers"
    },
    {
      "id": 391259,
      "primary_message": "Preheat another large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 391260,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper and cook, stirring occasionally, until starting to soften, 3-4 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 391261,
      "primary_message": "Meanwhile, wash and dry the spinach (skip this step if it came pre-washed). Add half to the bowl with the bell pepper and set aside. (Reserve remaining spinach for the sauce.)",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 391262,
      "primary_message": "When the bell pepper is soft, add Alfredo sauce, water, and spices to the pot. Stir to combine and bring to a simmer.",
      "secondary_message": "1 ½ (16 oz) jars Alfredo sauce\n¾ cup water\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 391263,
      "primary_message": "While the sauce is heating, stack turkey slices one on top of another, then medium dice. Add to the pot and stir to combine.",
      "secondary_message": "24 oz oven roasted turkey breast, sliced"
    },
    {
      "id": 391264,
      "primary_message": "Once the sauce is simmering, add remaining spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 391265,
      "primary_message": "When the pasta is done, drain and transfer to the pot with the sauce; toss to combine. Return to medium heat and continue to cook, tossing occasionally, until sauce coats the pasta, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 391266,
      "primary_message": "Add dressing to the bowl with the bell pepper and spinach. Toss to combine the salad. ",
      "secondary_message": "⅓ cup Italian salad dressing"
    },
    {
      "id": 391267,
      "primary_message": "To serve, divide pasta and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
