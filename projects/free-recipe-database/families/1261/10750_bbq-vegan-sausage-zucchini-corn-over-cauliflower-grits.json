  "instructions": [
    {
      "id": 175910,
      "primary_message": "Wash and cut cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 175911,
      "primary_message": "Place cauliflower, broth, polenta, and salt in a medium saucepan. Stir and bring to a boil over high heat. Cover and reduce heat to medium-low; cook, stirring occasionally, until polenta is soft and the mixture has thickened, about 20 minutes.",
      "secondary_message": "14 fl oz (1 ¾ cups) chicken or vegetable broth\n¼ cup polenta (cornmeal)\n¼ tsp salt"
    },
    {
      "id": 175912,
      "primary_message": "Meanwhile, place tomato sauce, ketchup, Dijon, sugar, vinegar, and spices in a small saucepan. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, for 5 minutes. Remove from heat and set aside.",
      "secondary_message": "½ (8 oz) can tomato sauce\n1 tbsp ketchup\n1 tbsp Dijon mustard\n1 tbsp brown sugar\n2 tsp apple cider vinegar\n½ tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp chili powder\n¼ tsp paprika"
    },
    {
      "id": 175913,
      "primary_message": "Wash, dry, trim, and medium dice zucchini.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 175914,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 175915,
      "primary_message": "Slice sausage into ½-inch rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 175916,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini, sausage, and corn to the skillet and cook, stirring occasionally, until vegetables are soft and sausage is lightly browned, 4-6 minutes (or cook sausages according to package instructions). ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ cup frozen corn"
    },
    {
      "id": 175917,
      "primary_message": "Pour the sauce into the skillet and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 175918,
      "primary_message": "To serve, divide cauliflower grits between plates or bowls. Top with vegetables and sausage. Enjoy!",
      "secondary_message": null
    }
  ],
