  "instructions": [
    {
      "id": 175872,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 175873,
      "primary_message": "Wash and cut cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower. ",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 175874,
      "primary_message": "Place cauliflower, broth, polenta, and salt in a medium saucepan. Stir and bring to a boil over high heat. Cover and reduce heat to medium-low; cook, stirring occasionally, until polenta is soft and the mixture has thickened, about 20 minutes.",
      "secondary_message": "14 fl oz (1 ¾ cups) chicken or vegetable broth\n¼ cup polenta (cornmeal)\n¼ tsp salt"
    },
    {
      "id": 175875,
      "primary_message": "Meanwhile, place tomato sauce, ketchup, Dijon, sugar, vinegar, Worcestershire, and spices in a small saucepan. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, for 5 minutes. Remove from heat and set aside.",
      "secondary_message": "½ (8 oz) can tomato sauce\n1 tbsp ketchup\n1 tbsp Dijon mustard\n1 tbsp brown sugar\n2 tsp apple cider vinegar\n2 tsp Worcestershire sauce\n½ tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp chili powder\n¼ tsp paprika"
    },
    {
      "id": 175876,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 175877,
      "primary_message": "Wash, dry, trim, and medium dice zucchini.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 175878,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 175879,
      "primary_message": "Add zucchini and corn to the skillet; cook, stirring occasionally, until vegetables are lightly browned and softened, 4-6 minutes. ",
      "secondary_message": "¼ cup frozen corn"
    },
    {
      "id": 175880,
      "primary_message": "Meanwhile, combine spices in a medium bowl. Add shrimp and toss to coat.",
      "secondary_message": "¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 175881,
      "primary_message": "Add shrimp to the skillet with the veggies; cook until opaque, 1-2 minutes per side. Pour the sauce into the skillet and toss to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 175882,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 175883,
      "primary_message": "Add cheese and butter to the pan with the cauliflower grits and stir to melt and combine. Remove from heat.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 175884,
      "primary_message": "To serve, divide cauliflower grits between plates or bowls. Top with vegetables and shrimp. Enjoy!",
      "secondary_message": null
    }
  ],
