  "instructions": [
    {
      "id": 175898,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 175899,
      "primary_message": "Wash and cut cauliflower heads into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower. ",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 175900,
      "primary_message": "Place cauliflower, broth, polenta, and salt in a large pot. Stir and bring to a boil over high heat. Cover and reduce heat to medium-low; cook, stirring occasionally, until polenta is soft and the mixture has thickened, 20-25 minutes.",
      "secondary_message": "40 fl oz (5 cups) chicken or vegetable broth\n¾ cup polenta (cornmeal)\n¾ tsp salt"
    },
    {
      "id": 175901,
      "primary_message": "Meanwhile, place tomato sauce, ketchup, Dijon, sugar, vinegar, Worcestershire, and spices in a medium saucepan. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, for 7 minutes. Remove from heat and set aside.",
      "secondary_message": "1 ½ (8 oz) cans tomato sauce\n3 tbsp ketchup\n3 tbsp Dijon mustard\n3 tbsp brown sugar\n2 tbsp apple cider vinegar\n2 tbsp Worcestershire sauce\n1 ½ tsp salt\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp chili powder\n¾ tsp paprika"
    },
    {
      "id": 175902,
      "primary_message": "Wash, dry, trim, and medium dice zucchini.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 175903,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 175904,
      "primary_message": "Add zucchini and corn to the skillet; cook, stirring occasionally, until vegetables are lightly browned and softened, 6-8 minutes. ",
      "secondary_message": "¾ cup frozen corn"
    },
    {
      "id": 175905,
      "primary_message": "Meanwhile, combine spices in a large bowl. Add shrimp and toss to coat.",
      "secondary_message": "¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 175906,
      "primary_message": "Add shrimp to the skillet with the veggies; cook until opaque, about 5 minutes. Pour the sauce into the skillet and toss to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 175907,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 175908,
      "primary_message": "Add cheese and butter to the pot with the cauliflower grits and stir to melt and combine. Remove from heat.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 175909,
      "primary_message": "To serve, divide cauliflower grits between plates or bowls. Top with vegetables and shrimp. Enjoy!",
      "secondary_message": null
    }
  ],
