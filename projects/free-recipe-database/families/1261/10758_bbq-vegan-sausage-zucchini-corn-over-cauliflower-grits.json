  "instructions": [
    {
      "id": 175993,
      "primary_message": "Wash and cut cauliflower heads into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 175994,
      "primary_message": "Place cauliflower, broth, polenta, and salt in a large pot. Stir and bring to a boil over high heat. Cover and reduce heat to medium-low; cook, stirring occasionally, until polenta is soft and the mixture has thickened, 20-25 minutes.",
      "secondary_message": "1183 ml chicken or vegetable broth\n¾ cup polenta (cornmeal)\n¾ tsp salt"
    },
    {
      "id": 175995,
      "primary_message": "Meanwhile, place tomato sauce, ketchup, Dijon, sugar, vinegar, and spices in a medium saucepan. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, for 7 minutes. Remove from heat and set aside.",
      "secondary_message": "1 ½ (213 ml) cans tomato sauce\n3 tbsp ketchup\n3 tbsp Dijon mustard\n3 tbsp brown sugar\n2 tbsp apple cider vinegar\n1 ½ tsp salt\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp chili powder\n¾ tsp paprika"
    },
    {
      "id": 175996,
      "primary_message": "Wash, dry, trim, and medium dice zucchini.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 175997,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 175998,
      "primary_message": "Slice sausage into ½-inch rounds.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 175999,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini, sausage, and corn to the skillet and cook, stirring occasionally, until vegetables are soft and sausage is lightly browned, 5-7 minutes (or cook sausages according to package instructions). ",
      "secondary_message": "⅓ cup extra virgin olive oil\n¾ cup frozen corn"
    },
    {
      "id": 176000,
      "primary_message": "Pour the sauce into the skillet and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 176001,
      "primary_message": "To serve, divide cauliflower grits between plates or bowls. Top with vegetables and sausage. Enjoy!",
      "secondary_message": null
    }
  ],
