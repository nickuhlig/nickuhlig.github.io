  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Crush the cornflakes. Slice the bananas thin. Cut the unsalted butter into 1/2-inch pieces.",
      "secondary_message": "2 cups cornflakes\n2 medium bananas\n2 to 4 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "In medium bowl, whisk cream, milk, eggs, yolk, sugar, vanilla, and salt to combine. Place cornflakes in pie plate or shallow bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Spread a scant tablespoon Nutella onto each bread slice, keeping 1/4-inch from edge. Arrange banana slices in even layer onto 4 of the bread slices, keeping bananas 1/2-inch from edge. Sandwich with remaining bread slices, pressing gently to adhere.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Dip each french toast sandwich into egg mixture, soaking well. Place in cornflakes and coat both sides well. Transfer sandwiches to large plate.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat half of the butter in 12-inch nonstick skillet over medium heat, until foaming subsides, tilting the pan to coat evenly. Place french toast sandwiches in pan and cook until bottom is golden and crisp, about 2 minutes. (Adjust heat if browning too quickly).",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Flip sandwiches, and add remaining butter to the pan, lifting sandwiches so that butter can get underneath. Cook until cooked through and the bottom is golden brown and crisp, about 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Transfer to cutting board and cut each sandwich in half diagonally. Dust with confectioners' sugar and serve with maple syrup.",
      "secondary_message": null
    }
  ],
