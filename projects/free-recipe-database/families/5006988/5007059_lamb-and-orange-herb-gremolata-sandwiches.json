  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine 5 tablespoons olive oil and garlic in small bowl. Microwave for 45 seconds. Stir in zest, oregano, rosemary, and thyme. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat remaining 1 tablespoon oil in large skillet over medium high heat until just beginning to smoke. Season lamb with salt and pepper. Cook lamb, flipping occasionally, until well browned and an instant read thermometer inserted into the center registers 52°C for medium rare.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to cutting board and let rest 5 minutes. Slice thinly on a bias into 0.5-cm thick slices.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Adjust oven rack to uppermost position and preheat oven to high broil. Place ciabatta directly on oven rack and broil just until golden, about 1 minute. Transfer to cutting board. Brush slices with mustard and top with cheese. Top cheese with lamb and herb/zest mixture. Serve immediately.",
      "secondary_message": null
    }
  ],
