  "instructions": [
    {
      "id": 332887,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n2 crowns broccoli\n1 lemon"
    },
    {
      "id": 332888,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 332889,
      "primary_message": "Finely grate Parmesan, place in a small bowl, and set aside for serving. ",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 332890,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 332891,
      "primary_message": "While the skillet heats up, use the tip of a knife to slice down the length of each sausage. Peel off casings and discard.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 332892,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add sausage and cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Using a slotted spoon, transfer to a plate and loosely cover with aluminum foil. (Reserve skillet, with cooking juices, for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 332893,
      "primary_message": "Meanwhile, using a clean cutting board, separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 332894,
      "primary_message": "Once the sausage is done, return the skillet (with cooking juices) to medium-high heat, add more oil, and swirl to coat the bottom. Add broccoli and stir-fry until charred and just tender, about 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 332895,
      "primary_message": "While the broccoli is cooking, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 332896,
      "primary_message": "Drain and thinly slice artichokes; thinly slice sun-dried tomatoes.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 332897,
      "primary_message": "When the broccoli is tender, add garlic, artichokes, sun-dried tomatoes, salt, and pepper to the skillet; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 332898,
      "primary_message": "Add zucchini noodles and water to the skillet; continue to cook, tossing occasionally, until veggies are tender and liquid has evaporated, 1-2 minutes more.",
      "secondary_message": "¼ cup water"
    },
    {
      "id": 332899,
      "primary_message": "Return cooked sausage to the skillet, juice lemon over top, and toss to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 332900,
      "primary_message": "To serve, divide sausage skillet between plates, top with Parmesan, and enjoy!",
      "secondary_message": null
    }
  ],
