  "instructions": [
    {
      "id": 332820,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 crowns broccoli\n1 ½ lemons"
    },
    {
      "id": 332821,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 332822,
      "primary_message": "Finely grate Parmesan, place in a small bowl, and set aside for serving. ",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 332823,
      "primary_message": "Use the tip of a knife to slice down the length of each sausage. Peel off casings and discard.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 332824,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 332825,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add sausage and cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Using a slotted spoon, transfer to a plate and loosely cover with aluminum foil. (Reserve pot, with cooking juices, for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 332826,
      "primary_message": "Meanwhile, using a clean cutting board, separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 332827,
      "primary_message": "Once the sausage is done, return the pot (with cooking juices) to medium-high heat, add more oil, and swirl to coat the bottom. Add broccoli and cook until just tender, about 6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 332828,
      "primary_message": "While the broccoli is cooking, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 332829,
      "primary_message": "Drain and thinly slice artichokes; thinly slice sun-dried tomatoes.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated\n18 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 332830,
      "primary_message": "When the broccoli is tender, add garlic, artichokes, sun-dried tomatoes, salt, and pepper to the pot; cook, stirring constantly, until fragrant, 1-2 minutes.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 332831,
      "primary_message": "Add zucchini noodles and water to the pot; continue to cook, tossing occasionally, until veggies are tender and liquid has evaporated, 2-3 minutes more.",
      "secondary_message": "⅓ cup water"
    },
    {
      "id": 332832,
      "primary_message": "Return cooked sausage to the pot, juice lemons over top, and toss to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 332833,
      "primary_message": "To serve, divide sausage sauté between plates, top with Parmesan, and enjoy!",
      "secondary_message": null
    }
  ],
