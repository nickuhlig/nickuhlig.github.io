  "instructions": [
    {
      "id": 332915,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 crown broccoli\n½ lemon"
    },
    {
      "id": 332916,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 332917,
      "primary_message": "Finely grate Parmesan, place in a small bowl, and set aside for serving. ",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 332918,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 332919,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground, Italian seasoning, and salt. Cook, breaking it apart with a spoon, until browned and crumbly, about 5 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp Italian seasoning\n⅛ tsp salt"
    },
    {
      "id": 332920,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 332921,
      "primary_message": "Once the veggie ground is done, return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add broccoli and stir-fry until charred and just tender, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 332922,
      "primary_message": "While the broccoli is cooking, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 332923,
      "primary_message": "Drain and thinly slice artichokes; thinly slice sun-dried tomatoes.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated\n6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 332924,
      "primary_message": "When the broccoli is tender, add garlic, artichokes, sun-dried tomatoes, salt, and pepper to the skillet; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 332925,
      "primary_message": "Add zucchini noodles and cream to the skillet; continue to cook, tossing occasionally, until veggies are tender and sauce has thickened slightly, 1-2 minutes more.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 332926,
      "primary_message": "Return cooked veggie ground to the skillet, juice lemon over top, and toss to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 332927,
      "primary_message": "To serve, divide veggie ground skillet between plates or bowls, top with Parmesan, and enjoy!",
      "secondary_message": null
    }
  ],
