  "instructions": [
    {
      "id": 259883,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 259884,
      "primary_message": "Wash, dry, and halve Brussels sprouts; transfer to a baking sheet pan. ",
      "secondary_message": "1 lb Brussels sprouts"
    },
    {
      "id": 259885,
      "primary_message": "Drizzle sprouts with oil and sprinkle with salt and pepper. Place in the oven (it doesn't have to be fully heated) and roast until sprouts are starting to soften, 10-12 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 259886,
      "primary_message": "Meanwhile, fill a medium saucepan about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 259887,
      "primary_message": "Wash, peel, and chop the potatoes into ½-inch cubes. Add to the saucepan and cook until very tender, 7-10 minutes. Drain and return to saucepan. ",
      "secondary_message": "4 medium red potatoes"
    },
    {
      "id": 259888,
      "primary_message": "Meanwhile, combine oil, Dijon, mayo, vinegar, sugar, salt, and pepper in a small bowl; whisk until smooth.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp vegan mayonnaise\n1 tbsp red wine vinegar\n½ tsp brown sugar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 259889,
      "primary_message": "Slice sausages into ½-inch-thick rounds. When the Brussels sprouts are starting to soften, add sausage to the baking sheet, drizzle with oil, and continue to roast until the sprouts are soft and sausages are warmed through, 5-7 minutes more. (Or cook sausages according to package directions.) ",
      "secondary_message": "4 pre-cooked vegan sausage\n2 tsp extra virgin olive oil"
    },
    {
      "id": 259890,
      "primary_message": "Add milk, oil, salt, and pepper to potatoes and mash until smooth.",
      "secondary_message": "4 fl oz (½ cup) almond milk, unsweetened\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 259891,
      "primary_message": "To serve, divide potatoes between bowls, top with Brussels sprouts and sausages; drizzle with creamy Dijon dressing and enjoy! ",
      "secondary_message": null
    }
  ],
