  "instructions": [
    {
      "id": 259910,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 259911,
      "primary_message": "Wash, dry, and halve Brussels sprouts; transfer to a large baking sheet pan. ",
      "secondary_message": "0.45 kg Brussels sprouts"
    },
    {
      "id": 259912,
      "primary_message": "Slice sausages into ½-inch-thick rounds; add to the baking sheet. ",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 259913,
      "primary_message": "Drizzle sprouts and sausages with oil and sprinkle with salt and pepper. Place in the oven (it doesn't have to be fully heated) and roast until sprouts are tender-crisp and sausages are cooked through, 18-20 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 259914,
      "primary_message": "Meanwhile, fill a medium saucepan about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 259915,
      "primary_message": "Wash, peel, and chop the potatoes into ½-inch cubes. Add to the saucepan and cook until very tender, 7-10 minutes. Drain and return to saucepan. ",
      "secondary_message": "4 medium red potatoes"
    },
    {
      "id": 259916,
      "primary_message": "Meanwhile, combine oil, Dijon, mayo, vinegar, sugar, salt, and pepper in a small bowl; whisk until smooth.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp mayonnaise\n1 tbsp red wine vinegar\n½ tsp brown sugar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 259917,
      "primary_message": "Add butter, milk, salt, and pepper to potatoes and mash until smooth.",
      "secondary_message": "2 tbsp butter, unsalted\n118 ml (½ cup) whole milk\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 259918,
      "primary_message": "To serve, divide potatoes between bowls, top with Brussels sprouts and sausages; drizzle with creamy Dijon dressing and enjoy! ",
      "secondary_message": null
    }
  ],
