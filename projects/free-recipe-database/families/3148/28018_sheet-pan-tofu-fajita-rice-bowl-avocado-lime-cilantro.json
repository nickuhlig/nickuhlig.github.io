  "instructions": [
    {
      "id": 455828,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 455829,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 455830,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 455831,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 red bell pepper\n1 yellow bell pepper\n½ small bunch cilantro\n1 avocado"
    },
    {
      "id": 455832,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 455833,
      "primary_message": "While the rice is cooking, juice half of the lime into a small bowl. Cut remaining lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 455834,
      "primary_message": "Add oil, soy sauce, and spices to the bowl with the lime juice. Stir to combine the spice paste and set aside.",
      "secondary_message": "2 tbsp neutral vegetable oil\n2 tsp soy sauce\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 455835,
      "primary_message": "Medium dice tofu. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 455836,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the baking sheet with the tofu.",
      "secondary_message": null
    },
    {
      "id": 455837,
      "primary_message": "Peel, halve, and slice onion crosswise into ½-inch thick half-moons. Add to the baking sheet. Drizzle with the spice paste, stir to coat, and spread out in an even layer. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 455838,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until tofu is browned and veggies are fork-tender, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 455839,
      "primary_message": "When the veggies are nearly done, halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 455840,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. ",
      "secondary_message": null
    },
    {
      "id": 455841,
      "primary_message": "When the veggies and tofu are done, remove from the oven. Add half of the cilantro to the baking sheet and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 455842,
      "primary_message": "Divide rice between bowls. Top with tofu, veggies, avocado, and reserved cilantro. Serve with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
