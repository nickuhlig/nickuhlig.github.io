  "instructions": [
    {
      "id": 455858,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 455859,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 455860,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 455861,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n3 red bell peppers\n3 yellow bell peppers\n1 small bunch cilantro\n3 avocados"
    },
    {
      "id": 455862,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 455863,
      "primary_message": "While the rice is cooking, juice half of the limes into a small bowl. Cut remaining limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 455864,
      "primary_message": "Add oil, soy sauce, and spices to the bowl with the lime juice. Stir to combine the spice paste and set aside.",
      "secondary_message": "⅓ cup neutral vegetable oil\n2 tbsp soy sauce\n3 tbsp chili powder\n1 ½ tbsp cumin, ground\n1 ½ tsp salt"
    },
    {
      "id": 455865,
      "primary_message": "Medium dice tofu. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet. Drizzle with half of the spice paste, stir to coat, and spread out in an even layer. ",
      "secondary_message": null
    },
    {
      "id": 455866,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to another large baking sheet.",
      "secondary_message": null
    },
    {
      "id": 455867,
      "primary_message": "Peel, halve, and slice onions crosswise into ½-inch thick half-moons. Add to the baking sheet with the peppers. Drizzle with remaining spice paste, stir to coat, and spread out in an even layer. ",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 455868,
      "primary_message": "Place baking sheets in the oven and roast, stirring halfway through, until tofu is browned and veggies are fork-tender, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 455869,
      "primary_message": "When the veggies are nearly done, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 455870,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. ",
      "secondary_message": null
    },
    {
      "id": 455871,
      "primary_message": "When the veggies and tofu are done, remove from the oven. Add half of the cilantro to the baking sheets and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 455872,
      "primary_message": "Divide rice between bowls. Top with tofu, veggies, avocado, and reserved cilantro. Serve with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
