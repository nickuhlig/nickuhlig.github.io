  "instructions": [
    {
      "id": 501891,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg sweet potato\n4 sticks celery\n2 red bell peppers\n1 small pkg fresh thyme\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 501892,
      "primary_message": "Peel and medium dice sweet potatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 501893,
      "primary_message": "Trim and small dice celery. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 501894,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 501895,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 501896,
      "primary_message": "While the pot heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 501897,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until bacon has released its fat and is starting to brown, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 501898,
      "primary_message": "Meanwhile, using a clean cutting board, peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "2 medium yellow onions\n4 cloves garlic"
    },
    {
      "id": 501899,
      "primary_message": "When the bacon is done, use a slotted spoon to transfer ½ to a plate; set aside. (Leave remaining bacon in the pot.)",
      "secondary_message": null
    },
    {
      "id": 501900,
      "primary_message": "Add veggies and corn to the pot with the remaining bacon, then stir to combine. Continue to cook, stirring occasionally, until veggies are softened, 3-4 minutes more.",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 501901,
      "primary_message": "Meanwhile, slide thyme leaves off the stems; discard the stems.",
      "secondary_message": null
    },
    {
      "id": 501902,
      "primary_message": "When the veggies are soft, add thyme, broth, water, and spices to the pot. Stir to combine the chowder, then bring to a simmer over medium-high heat. Cook, stirring occasionally, until sweet potatoes are tender and chowder has thickened, 8-10 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n2 cup water\n2 tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 501903,
      "primary_message": "When the sweet potatoes are done, reduce heat to medium-low. Add cream to the pot and, using a potato masher, gently crush some of the sweet potatoes to further thicken the chowder.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 501904,
      "primary_message": "Add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 501905,
      "primary_message": "To serve, divide the chowder between bowls and sprinkle with reserved bacon. Enjoy!",
      "secondary_message": null
    }
  ],
