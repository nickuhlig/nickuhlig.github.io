  "instructions": [
    {
      "id": 501876,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "⅓ kg sweet potato\n2 sticks celery\n1 red bell pepper\n½ small pkg fresh thyme\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 501877,
      "primary_message": "Peel and medium dice sweet potato. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 501878,
      "primary_message": "Trim and small dice celery. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 501879,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 501880,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 501881,
      "primary_message": "While the pan heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 501882,
      "primary_message": "Once the pan is hot, add bacon and cook, stirring occasionally, until bacon has released its fat and is starting to brown, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 501883,
      "primary_message": "Meanwhile, using a clean cutting board, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 501884,
      "primary_message": "When the bacon is done, use a slotted spoon to transfer ½ to a plate; set aside. (Leave remaining bacon in the pan.)",
      "secondary_message": null
    },
    {
      "id": 501885,
      "primary_message": "Add veggies and corn to the pan with the remaining bacon, then stir to combine. Continue to cook, stirring occasionally, until veggies are softened, 3-4 minutes more.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 501886,
      "primary_message": "Meanwhile, slide thyme leaves off the stems; discard the stems.",
      "secondary_message": null
    },
    {
      "id": 501887,
      "primary_message": "When the veggies are soft, add thyme, broth, water, and spices to the pan. Stir to combine the chowder, then bring to a simmer over medium-high heat. Cook, stirring occasionally, until sweet potatoes are tender and chowder has thickened, 8-10 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup water\n1 tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 501888,
      "primary_message": "When the sweet potatoes are done, reduce heat to medium-low. Add cream to the pan and, using a potato masher, gently crush some of the sweet potatoes to further thicken the chowder.",
      "secondary_message": "59 ml (¼ cup) heavy whipping cream"
    },
    {
      "id": 501889,
      "primary_message": "Add spinach to the pan in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 501890,
      "primary_message": "To serve, divide the chowder between bowls and sprinkle with reserved bacon. Enjoy!",
      "secondary_message": null
    }
  ],
