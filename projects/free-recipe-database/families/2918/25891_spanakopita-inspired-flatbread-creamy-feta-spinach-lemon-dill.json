  "instructions": [
    {
      "id": 486697,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 486698,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n½ small bunch green onions (scallions)\n½ small bunch fresh dill\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 486699,
      "primary_message": "Zest lemon into a small bowl. Add ⅔ of the feta, yogurt, oil, pepper, and salt. Mash with a fork until semi-smooth and combined, then set aside. (Reserve lemon and remaining feta for later use.)",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese\n½ cup plain Greek yogurt\n1 tsp extra virgin olive oil\n¼ tsp black pepper\n1 pinch salt"
    },
    {
      "id": 486700,
      "primary_message": "Arrange flatbreads on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, about 8 minutes. Remove from oven and set aside.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 486701,
      "primary_message": "Meanwhile, juice reserved lemon into another small bowl.",
      "secondary_message": null
    },
    {
      "id": 486702,
      "primary_message": "Trim and thinly slice green onions crosswise. Add to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "id": 486703,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 486704,
      "primary_message": "While the skillet heats up, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil and salt, then stir to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 486705,
      "primary_message": "Once the skillet is hot, add lemon-oil mixture. Add spinach to the skillet in handfuls, waiting for spinach to wilt slightly before adding the next handful. Cook, stirring frequently, until wilted, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 486706,
      "primary_message": "Spread the creamy feta over each flatbread, then top with sautéed greens and reserved feta.",
      "secondary_message": null
    },
    {
      "id": 486707,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
