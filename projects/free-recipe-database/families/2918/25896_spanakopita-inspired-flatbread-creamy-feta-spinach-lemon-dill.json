  "instructions": [
    {
      "id": 486752,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 486753,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small bunch green onions (scallions)\n1 small bunch fresh dill\n3 (142 g) pkgs baby spinach"
    },
    {
      "id": 486754,
      "primary_message": "Zest lemons into a medium bowl. Add ⅔ of the feta, yogurt, oil, pepper, and salt. Mash with a fork until semi-smooth and combined, then set aside. (Reserve lemons and remaining feta for later use.)",
      "secondary_message": "3 (113 g) pkgs crumbled feta cheese\n1 ½ cups plain Greek yogurt\n1 tbsp extra virgin olive oil\n¾ tsp black pepper\n3 pinch salt"
    },
    {
      "id": 486755,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, 8-10 minutes. Remove from oven and set aside.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 486756,
      "primary_message": "Meanwhile, juice reserved lemons into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 486757,
      "primary_message": "Trim and thinly slice green onions crosswise. Add to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "id": 486758,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 486759,
      "primary_message": "While the skillet heats up, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil and salt, then stir to combine.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 486760,
      "primary_message": "Once the skillet is hot, add lemon-oil mixture. Add spinach to the skillet in handfuls, waiting for spinach to wilt slightly before adding the next handful. Cook, stirring frequently, until wilted, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 486761,
      "primary_message": "Spread the creamy feta over each flatbread, then top with sautéed greens and reserved feta.",
      "secondary_message": null
    },
    {
      "id": 486762,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
