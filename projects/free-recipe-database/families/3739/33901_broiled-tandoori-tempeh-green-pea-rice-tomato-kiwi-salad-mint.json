  "instructions": [
    {
      "id": 535872,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 535873,
      "primary_message": "Meanwhile, place oil and spices in a medium bowl, then stir to combine the spice paste.",
      "secondary_message": "1 tbsp neutral vegetable oil\n½ tsp garam masala\n½ tsp smoked paprika\n½ tsp garlic powder\n½ tsp coriander, ground\n¼ tsp salt"
    },
    {
      "id": 535874,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 535875,
      "primary_message": "While the rice is cooking, slice tempeh crosswise into ½-inch thick pieces and add to the bowl with the spice paste. Gently turn to coat, then set aside. ",
      "secondary_message": "1 (227g ) pkg tempeh"
    },
    {
      "id": 535876,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 535877,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh mint\n2 kiwifruit\n2 tomatoes\n½ lemon"
    },
    {
      "id": 535878,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place half in another medium bowl along with yogurt, salt, and pepper, then stir to combine the dressing. (Reserve remaining mint for serving.)",
      "secondary_message": "⅓ cup plain Greek yogurt\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 535879,
      "primary_message": "Peel, trim, and medium dice kiwis. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 535880,
      "primary_message": "Medium dice tomatoes. Add to the bowl, stir to combine the salad, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 535881,
      "primary_message": "Transfer tempeh to the baking sheet. Place tempeh in the oven and broil, turning halfway through, until golden brown, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 535882,
      "primary_message": "Meanwhile, cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 535883,
      "primary_message": "When the rice is done, place peas in a colander and rinse under hot water (from the tap) to thaw. Add to the rice and gently stir to combine.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 535884,
      "primary_message": "Divide rice, salad, and tempeh between plates, then sprinkle with reserved mint. Serve with lemon wedges for squeezing and enjoy!\n",
      "secondary_message": null
    }
  ],
