  "instructions": [
    {
      "id": 535820,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 535821,
      "primary_message": "Meanwhile, place oil and spices in a large bowl, then stir to combine the spice paste.",
      "secondary_message": "3 tbsp neutral vegetable oil\n1 ½ tsp garam masala\n1 ½ tsp smoked paprika\n1 ½ tsp garlic powder\n1 ½ tsp coriander, ground\n¾ tsp salt"
    },
    {
      "id": 535822,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 535823,
      "primary_message": "While the rice is cooking, slice tempeh crosswise into ½-inch thick pieces and add to the bowl with the spice paste. Gently turn to coat, then set aside. ",
      "secondary_message": "3 (8 oz) packages tempeh"
    },
    {
      "id": 535824,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 535825,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh mint\n6 kiwifruit\n6 tomatoes\n1 ½ lemons"
    },
    {
      "id": 535826,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl along with yogurt, salt, and pepper, then stir to combine the dressing. (Reserve remaining mint for serving.)",
      "secondary_message": "1 cup plain Greek yogurt\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 535827,
      "primary_message": "Peel, trim, and medium dice kiwis. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 535828,
      "primary_message": "Medium dice tomatoes. Add to the bowl, stir to combine the salad, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 535829,
      "primary_message": "Transfer tempeh to the baking sheet. Place tempeh in the oven and broil, turning halfway through, until golden brown, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 535830,
      "primary_message": "Meanwhile, cut lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 535831,
      "primary_message": "When the rice is done, place peas in a colander and rinse under hot water (from the tap) to thaw. Add to the rice and gently stir to combine.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 535832,
      "primary_message": "Divide rice, salad, and tempeh between plates, then sprinkle with reserved mint. Serve with lemon wedges for squeezing and enjoy!\n",
      "secondary_message": null
    }
  ],
