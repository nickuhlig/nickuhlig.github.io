  "instructions": [
    {
      "id": 535846,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 535847,
      "primary_message": "Meanwhile, place oil and spices in a medium bowl, then stir to combine the spice paste.",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 tsp garam masala\n1 tsp smoked paprika\n1 tsp garlic powder\n1 tsp coriander, ground\n1 tsp salt"
    },
    {
      "id": 535848,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 535849,
      "primary_message": "While the rice is cooking, pat the salmon dry with paper towels. Add to the bowl with the spice paste and turn to coat. Set aside. ",
      "secondary_message": "0.68 kg salmon fillet"
    },
    {
      "id": 535850,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 535851,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh mint\n4 kiwifruit\n4 tomatoes\n1 lemon"
    },
    {
      "id": 535852,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place half in another medium bowl along with yogurt, water, salt, and pepper, then stir to combine the dressing. (Reserve remaining mint for serving.)",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 535853,
      "primary_message": "Peel, trim, and medium dice kiwis. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 535854,
      "primary_message": "Medium dice tomatoes. Add to the bowl, stir to combine the salad, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 535855,
      "primary_message": "Transfer salmon to the baking sheet. Place salmon in the oven and broil until fish flakes easily with a fork, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 535856,
      "primary_message": "Meanwhile, cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 535857,
      "primary_message": "When the rice is done, place peas in a colander and rinse under hot water (from the tap) to thaw. Add to the rice and gently stir to combine.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 535858,
      "primary_message": "Divide rice, salad, and salmon between plates, then sprinkle with reserved mint. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
