  "instructions": [
    {
      "id": 471707,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ limes\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 471708,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 471709,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 471710,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 471711,
      "primary_message": "Once the pot is hot, add bell pepper, onion, garlic, beef, and spices to the pot. Cook, breaking the meat apart with a spoon, until browned and crumbly, 6-7 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "2 ¼ lb lean ground beef\n1 tbsp chili powder\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471712,
      "primary_message": "Meanwhile, juice limes into the reserved bowl. Add yogurt, mayo, and spices, then whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n¾ tsp salt\n½ tsp black pepper\n½ tsp chili powder"
    },
    {
      "id": 471713,
      "primary_message": "Add broccoli slaw to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": "1 ½ (12 oz) pkgs broccoli slaw"
    },
    {
      "id": 471714,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 471715,
      "primary_message": "To serve, divide tortillas between plates; fill with ground beef and slaw, then top with sprouts. Enjoy!",
      "secondary_message": null
    }
  ],
