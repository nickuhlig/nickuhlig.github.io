  "instructions": [
    {
      "id": 471725,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 lime\n1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 471726,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 471727,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 471728,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 471729,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp neutral vegetable oil\n16 oz veggie ground, plant based\n2 tsp chili powder\n1 tsp smoked paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 471730,
      "primary_message": "Meanwhile, juice lime into the reserved bowl. Add yogurt, mayo, and spices, then whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp mayonnaise\n½ tsp salt\n¼ tsp black pepper\n¼ tsp chili powder"
    },
    {
      "id": 471731,
      "primary_message": "Add broccoli slaw to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 471732,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 471733,
      "primary_message": "To serve, divide tortillas between plates; fill with veggie ground and slaw, then top with sprouts. Enjoy!",
      "secondary_message": null
    }
  ],
