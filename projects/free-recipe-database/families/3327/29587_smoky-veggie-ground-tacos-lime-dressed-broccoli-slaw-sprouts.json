  "instructions": [
    {
      "id": 471743,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n½ lime\n½ (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 471744,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 471745,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 471746,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 471747,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp neutral vegetable oil\n8 oz veggie ground, plant based\n1 tsp chili powder\n½ tsp smoked paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 471748,
      "primary_message": "Meanwhile, juice lime into the reserved bowl. Add mayo, water, and spices, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp vegan mayonnaise\n1 tbsp water\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp chili powder"
    },
    {
      "id": 471749,
      "primary_message": "Add broccoli slaw to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": "½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 471750,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 471751,
      "primary_message": "To serve, divide tortillas between plates; fill with veggie ground and slaw, then top with sprouts. Enjoy!",
      "secondary_message": null
    }
  ],
