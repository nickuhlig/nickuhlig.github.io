  "instructions": [
    {
      "id": 471842,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ limes\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 471843,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 471844,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 471845,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 471846,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 6-7 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp neutral vegetable oil\n680 g veggie ground, plant based\n1 tbsp chili powder\n1 ½ tsp smoked paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471847,
      "primary_message": "Meanwhile, juice limes into the reserved bowl. Add mayo, water, and spices, then whisk to combine the dressing.",
      "secondary_message": "½ cup vegan mayonnaise\n3 tbsp water\n¾ tsp salt\n½ tsp black pepper\n½ tsp chili powder"
    },
    {
      "id": 471848,
      "primary_message": "Add broccoli slaw to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 471849,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 471850,
      "primary_message": "To serve, divide tortillas between plates; fill with veggie ground and slaw, then top with sprouts. Enjoy!",
      "secondary_message": null
    }
  ],
