  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the cold unsalted butter into 1/4-inch pieces. Finely chop the semi-sweet chocolate. Lightly beat the egg.",
      "secondary_message": "9 tbsp cold unsalted butter\n227 g semi-sweet chocolate\n1 large egg"
    },
    {
      "id": 1,
      "primary_message": "In bowl of food processor, pulse flour, confectioners' sugar, cocoa, and salt until combined, about 3 one-second pulses. Add butter and pulse until mixture is consistency of wet sand, with no visible bits of butter remaining, about 10 to 15 quick pulses. Add yolk and pulse until dough just begins to come together. Wrap dough with plastic wrap into 13-cm disc and chill until firm, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While the dough is chilling, make the filling. Place chocolate, sugar, and espresso powder in medium bowl. In small saucepan, heat milk and cream until simmering. Pour over chocolate and let sit 5 minutes. Whisk until smooth. Whisk in egg and vanilla; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Roll out dough between 2 pieces of parchment paper, plastic wrap, or on lightly floured surface to 33-cm circle. Gently roll up dough with rolling pin and roll out over tart pan. Press dough into bottom and sides of tart pan. Chill in freezer for 15 minutes. Gently line inside of tart with foil and fill with pie weights. Bake until crust is set, about 25 minutes. Carefully remove foil with pie weights and briefly cool on wire rack 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour filling into crust and bake until edges are set and middle is slightly jiggly, 15 to 20 minutes. Let cool on wire rack at least 45 minutes before serving.",
      "secondary_message": null
    }
  ],
