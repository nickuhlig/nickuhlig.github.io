  "instructions": [
    {
      "id": 71903,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.341 kg white mushrooms\n3 small bunches asparagus\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 71902,
      "primary_message": "Slice the mushrooms and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 71901,
      "primary_message": "Peel and small dice the onion; add to the bowl of mushrooms.",
      "secondary_message": "1 ½ medium yellow onion"
    },
    {
      "id": 71900,
      "primary_message": "Fill a medium saucepan (one that is big enough to fit the asparagus) about halfway with water; cover and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 71899,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 71888,
      "primary_message": "In a medium bowl, combine and mix together the minced garlic, ground beef, onion powder, Worcestershire sauce, salt, and pepper. Shape the beef mixture into six oval patties.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tsp onion powder\n1 ½ tsp Worcestershire sauce\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 71898,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 71897,
      "primary_message": "Cut (or snap off) and discard the woody ends of the asparagus; leaves the spears on the cutting board.",
      "secondary_message": ""
    },
    {
      "id": 71896,
      "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 71895,
      "primary_message": "Place the beef patties in the skillet and cook until they are browned and the meat is nearly cooked through, 2 to 3 minutes per side. Transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 71894,
      "primary_message": "Once the water is boiling, add the asparagus. Cook until the asparagus is tender and bright green, 3 to 4 minutes. Drain in a colander and rinse under cold water to stop the cooking process; set aside to drain.",
      "secondary_message": ""
    },
    {
      "id": 71893,
      "primary_message": "Once the patties have been transferred, add more butter to the skillet.",
      "secondary_message": "6 tbsp butter, unsalted"
    },
    {
      "id": 71892,
      "primary_message": "Add the onion and mushrooms and season with salt and pepper. Cook, stirring frequently, until the onions and mushrooms are softened and lightly browned, 3 to 5 minutes.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 71887,
      "primary_message": "Sprinkle flour over the mushrooms and onions and stir until fully incorporated. Then pour in the broth, scraping up any browned bits from the bottom of the skillet.",
      "secondary_message": "3 tbsp all-purpose flour\n355 ml (1 ½ cup) chicken or vegetable broth"
    },
    {
      "id": 71891,
      "primary_message": "Return the beef patties and any juices to the skillet. Simmer until the patties are cooked through, 2 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 71890,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves. Stir almost everything into the gravy (save some for garnishing).",
      "secondary_message": ""
    },
    {
      "id": 71889,
      "primary_message": "Divide the asparagus between plates and place the steak and gravy over top. Enjoy!",
      "secondary_message": ""
    }
  ],
