  "instructions": [
    {
      "id": 152880,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 152881,
      "primary_message": "Place bread slices on a large baking sheet pan in a single layer; drizzle oil over both sides. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n12 slices whole grain bread"
    },
    {
      "id": 152882,
      "primary_message": "Place bread in the oven and broil, flipping halfway through, 2-4 minutes, or until the bread becomes golden and nicely charred around the edges. Remove bread from the oven and set aside to cool. (Keep the broiler on for the salmon.)",
      "secondary_message": null
    },
    {
      "id": 152883,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 pints grape tomatoes\n6 peaches\n1 small pkg fresh basil"
    },
    {
      "id": 152884,
      "primary_message": "Cut the salmon crosswise into 6 fillets and place, skin-side-down, onto a separate baking sheet pan that has been lined with aluminum foil. ",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 152885,
      "primary_message": "Rub the salmon with olive oil and season with salt and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 152886,
      "primary_message": "Place salmon in the oven and broil, cook until salmon is opaque and cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 152887,
      "primary_message": "Meanwhile, peel and thinly slice the shallots; add to a large bowl.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 152888,
      "primary_message": "Add vinegar, oil, salt, and pepper to the bowl with the shallots; stir together.",
      "secondary_message": "⅓ cup red wine vinegar\n3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 152889,
      "primary_message": "Tear the bread into bite-sized pieces. Halve the tomatoes and add both to the bowl with the shallots. ",
      "secondary_message": null
    },
    {
      "id": 152890,
      "primary_message": "Halve peaches, twist to open, and remove pits. Slice each half into wedges and add to the bowl with the tomatoes and bread.",
      "secondary_message": null
    },
    {
      "id": 152891,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons. Add to the salad bowl; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 152892,
      "primary_message": "When the salmon is done, remove from the oven. Loosen fillets from foil using a metal spatula.",
      "secondary_message": null
    },
    {
      "id": 152893,
      "primary_message": "To serve, divide salmon and panzanella salad between dishes. Enjoy! ",
      "secondary_message": null
    }
  ],
