  "instructions": [
    {
      "primary_message": "About 3 hours before you plan to serve the ham, set it on the counter and allow to come to room temperature, about 45 minutes. ",
      "secondary_message": "1.81 kg ham, bone-in"
    },
    {
      "primary_message": "Once the ham has come to room temperature, preheat oven to 250°F. Place oven rack in the lower position. ",
      "secondary_message": null
    },
    {
      "primary_message": "Place ham on a rimmed baking sheet and completely cover with aluminum foil. ",
      "secondary_message": null
    },
    {
      "primary_message": "Place baking sheet in the oven and bake until the meat near the bone reaches 120°F, about 2 hours. Remove from oven. ",
      "secondary_message": null
    },
    {
      "primary_message": "When the ham is almost done, place sugar, maple syrup, Dijon, and cinnamon in a small saucepan. Bring to a simmer over medium-high heat, stirring often. Once simmering, reduce heat to medium and cook, stirring constantly, until slightly thickened and glossy, 2-3 minutes. Remove from heat and set aside. ",
      "secondary_message": "⅓ cup brown sugar\n⅓ cup pure maple syrup\n1 tbsp Dijon mustard\n½ tsp cinnamon, ground"
    },
    {
      "primary_message": "After you have removed the ham from the oven, increase the temperature to 450°F. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove foil from the ham and score the rind in a crosshatch pattern. (Reserve foil for later use.) ",
      "secondary_message": null
    },
    {
      "primary_message": "Brush 1/3 of the glaze over the outside of the ham. Return ham to the oven and roast until starting to caramelize, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "primary_message": "Brush an additional 1/3 of the glaze over the ham, then return to the oven once more. Continue to roast until caramelized, 10-15 minutes more. Remove from oven. ",
      "secondary_message": null
    },
    {
      "primary_message": "Brush remaining glaze over the ham, cover with reserved foil, and set aside to rest, 15 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Carve ham and arrange on a platter.",
      "secondary_message": null
    }
  ],
