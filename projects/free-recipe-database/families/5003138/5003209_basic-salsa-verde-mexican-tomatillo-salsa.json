  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the husks and stems from the tomatillos. Remove the stem and seeds from the jalapeño peppers. Remove the skin from the white onion, then split it in half. Pick the cilantro leaves and tender stems from the thick stems.",
      "secondary_message": "0.68 kg tomatillos\n1 to 2 jalapeño peppers\n1 small white onion\n1 bunch fresh cilantro leaves, tender stems"
    },
    {
      "id": 1,
      "primary_message": "Combine tomatillos, serranos, and onion in a medium saucepan and cover with water. Bring to a boil over high heat then reduce to a simmer. Simmer until vegetables are completely softened, about 10 minutes, stirring occasionally to make sure all sides are softened.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Drain vegetables then transfer to a blender. Add cilantro and a large pinch of salt. Blend on medium speed until a chunky puree is formed, about 30 seconds. Transfer to a bowl, season to taste with more salt or lime juice if necessary, and serve. Cooled salsa can be stored in a sealed container in the refrigerator for up to 2 weeks.",
      "secondary_message": null
    }
  ],
