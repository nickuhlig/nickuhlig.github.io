  "instructions": [
    {
      "id": 420180,
      "primary_message": "Preheat oven to 230°C (450°F). Coat the bottom of two large baking dishes with a thin layer of oil and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 420181,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and place in a large bowl.",
      "secondary_message": "1 ½ (850 g) whole chickens rotisserie chicken, white and dark meat"
    },
    {
      "id": 420182,
      "primary_message": "Add yogurt, taco seasoning, and salt to the bowl with the shredded chicken. Stir to combine the filling.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n¼ cup taco seasoning\n¾ tsp salt"
    },
    {
      "id": 420183,
      "primary_message": "Working in batches if necessary, place tortillas on a flat surface and divide the filling between them. Wrap tortillas around the filling and divide between the baking dishes, placing seam-side down. Top with salsa and cheese.",
      "secondary_message": "18 small corn tortillas\n2 cup salsa\n1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 420184,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake until cheese is melted and filling is warmed through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 420185,
      "primary_message": "Meanwhile, wash and dry cilantro. Using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a clean large bowl. (Set remaining cilantro aside for serving.)",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 420186,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Add to the bowl with the cilantro.",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 420187,
      "primary_message": "Add shredded cabbage, dressing, and salt to the bowl. Stir to combine the slaw and set aside.",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n⅓ cup ranch dressing\n½ tsp salt"
    },
    {
      "id": 420188,
      "primary_message": "To serve, divide enchiladas and slaw between plates; sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
