  "instructions": [
    {
      "id": 420117,
      "primary_message": "Preheat oven to 450°F. Coat the bottom of a large baking dish with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 420118,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and place in a medium bowl.",
      "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 420119,
      "primary_message": "Add yogurt, taco seasoning, and salt to the bowl with the shredded chicken. Stir to combine the filling.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp taco seasoning\n½ tsp salt"
    },
    {
      "id": 420120,
      "primary_message": "Working in batches if necessary, place tortillas on a flat surface and divide the filling between them. Wrap tortillas around the filling and place, seam-side down, in the baking dish. Top with salsa and cheese.",
      "secondary_message": "12 small corn tortillas\n1 ⅓ cup salsa\n1 cup shredded cheese, Mexican blend"
    },
    {
      "id": 420121,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until cheese is melted and filling is warmed through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 420122,
      "primary_message": "Meanwhile, wash and dry cilantro. Using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a clean medium bowl. (Set remaining cilantro aside for serving.)",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 420123,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Add to the bowl with the cilantro.",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 420124,
      "primary_message": "Add shredded cabbage, dressing, and salt to the bowl. Stir to combine the slaw and set aside.",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n¼ cup ranch dressing\n¼ tsp salt"
    },
    {
      "id": 420125,
      "primary_message": "To serve, divide enchiladas and slaw between plates; sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
