  "instructions": [
    {
      "id": 429447,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 429448,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 pork sausages"
    },
    {
      "id": 429449,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Place in a medium bowl.",
      "secondary_message": "1 (142 g) pkg baby arugula"
    },
    {
      "id": 429450,
      "primary_message": "Drain and roughly chop roasted peppers and artichoke hearts. Add to the bowl with the arugula.",
      "secondary_message": "1 (340 g) jar roasted red bell peppers\n1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 429451,
      "primary_message": "Thinly slice olives. Add to the bowl along with cheese and dressing, then toss to combine the salad. Set aside.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n1 cup shredded cheese, Italian blend\n¼ cup Italian salad dressing"
    },
    {
      "id": 429452,
      "primary_message": "When the sausages are done, transfer to the cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 429453,
      "primary_message": "Cut pitas in half and carefully open the pockets. Stuff each pocket with salad and sausage slices.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 429454,
      "primary_message": "To serve, divide pita pockets between plates. Enjoy!",
      "secondary_message": null
    }
  ],
