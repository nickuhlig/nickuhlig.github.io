  "instructions": [
    {
      "id": 429463,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 429464,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 pre-cooked vegan sausage"
    },
    {
      "id": 429465,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Place in a medium bowl.",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 429466,
      "primary_message": "Drain and roughly chop roasted peppers and artichoke hearts. Add to the bowl with the arugula.",
      "secondary_message": "½ (340 g) jar roasted red bell peppers\n½ (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 429467,
      "primary_message": "Thinly slice olives. Add to the bowl along with cheese and dressing, then toss to combine the salad. Set aside.",
      "secondary_message": "⅛ cup Kalamata olives, pitted\n½ cup shredded cheese, Italian blend\n2 tbsp Italian salad dressing"
    },
    {
      "id": 429468,
      "primary_message": "Transfer sausages to the cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 429469,
      "primary_message": "Cut pitas in half and carefully open the pockets. Stuff each pocket with salad and sausage slices.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 429470,
      "primary_message": "To serve, divide pita pockets between plates. Enjoy!",
      "secondary_message": null
    }
  ],
