  "instructions": [
    {
      "id": 19580,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 19581,
      "primary_message": "Wash and dry jalapeño and cilantro. Seed and mince jalapeño. Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 jalapeño pepper\r\n½ small bunch cilantro"
    },
    {
      "id": 19582,
      "primary_message": "Transfer beans to a medium bowl and mash with a fork. Add egg, jalapeño, ½ of the cilantro (save the rest for the guacamole), bread crumbs, cumin, salt, and pepper. Mix until well combined.",
      "secondary_message": "1 egg\r\n¼ cup panko bread crumbs\r\n½ tsp cumin\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19583,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 19584,
      "primary_message": "Halve and pit avocado; scoop out the flesh into a medium bowl. Add remaining cilantro, lime juice, salt, and pepper. Mash with a fork until smooth.",
      "secondary_message": "1 avocado\r\njuice of ½ lime\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 19585,
      "primary_message": "Measure out corn.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 19586,
      "primary_message": "Coat bottom of skillet with oil. Add corn and cook until heated through, 2-3 minutes. Transfer to a bowl.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 19587,
      "primary_message": "Shape black bean mixture into 6-8 patties and place on a plate.",
      "secondary_message": ""
    },
    {
      "id": 19588,
      "primary_message": "Once corn has been transferred, wipe skillet and coat with more oil. Add patties and cook until browned and crisp, 3-4 minutes per side.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 19589,
      "primary_message": "Peel and mince garlic. Add garlic, lime juice, salt, and pepper to corn; mix to combine.",
      "secondary_message": "1 clove garlic.\r\njuice of ½ lime\r\n1 pinch salt\r\n1 pinch black pepper"
    },
    {
      "id": 19590,
      "primary_message": "Serve black bean cakes with guacamole and corn. Enjoy!",
      "secondary_message": ""
    }
  ],
