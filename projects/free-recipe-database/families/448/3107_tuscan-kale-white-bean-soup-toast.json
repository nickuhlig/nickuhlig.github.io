  "instructions": [
    {
      "id": 31154,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 bunches kale\n1 small pkg fresh rosemary"
    },
    {
      "id": 31155,
      "primary_message": "Trim off the ends and peel the carrots; discard the peels and trimmings. Small dice the carrots (cut into ¼-inch cubes) and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 31156,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 31157,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces) and add to the bowl with the carrots.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 31158,
      "primary_message": "Open the cans of beans, but don't drain.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 31159,
      "primary_message": "Add olive oil to the saucepan and swirl to coat the bottom.",
      "secondary_message": "4 tbsp extra virgin olive oil"
    },
    {
      "id": 31160,
      "primary_message": "Add the carrots and onion to the saucepan; cook, stirring frequently, until the vegetables have softened, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 31161,
      "primary_message": "One by one, holding a sprig of rosemary at its top, run you fingers down it to remove the leaves. Discard the sprigs and chop the leaves; transfer the leaves to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 31162,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 31163,
      "primary_message": "Add the minced garlic and crushed red pepper to the saucepan; cook, stirring constantly, until fragrant, 15 to 30 seconds.",
      "secondary_message": "½ tsp crushed red pepper"
    },
    {
      "id": 31164,
      "primary_message": "Add the beans and their liquid, broth, rosemary, salt, and pepper to the saucepan. Increase the heat to high and bring to a boil.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 31165,
      "primary_message": "When the soup comes to a boil, reduce the heat to a simmer, cover, and cook for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 31166,
      "primary_message": "While the soup cooks, fold each kale leaf lengthwise, slice away and discard the stems, and chop the leaves into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 31167,
      "primary_message": "Finely grate ½ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 31168,
      "primary_message": "Uncover the saucepan, stir in the kale and ½ of the Parmesan (save the rest for garnishing), then cover again and continue to cook until the kale is wilted, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 31169,
      "primary_message": "Slice the buns in half and toast (optional).",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 31170,
      "primary_message": "To serve, ladle the soup into a bowl and garnish with the remaining Parmesan. Serve with the toasted bun on the side. Enjoy!",
      "secondary_message": null
    }
  ],
