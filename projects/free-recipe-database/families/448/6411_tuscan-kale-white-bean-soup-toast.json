  "instructions": [
    {
      "id": 78344,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 bunches kale\n1 ½ small pkg fresh rosemary"
    },
    {
      "id": 78343,
      "primary_message": "Trim off the ends and peel the carrots; discard the peels and trimmings. Small dice the carrots (cut into 6-mm cubes) and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 78342,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 78341,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and add to the bowl with the carrots.",
      "secondary_message": "1 ½ medium yellow onion"
    },
    {
      "id": 78340,
      "primary_message": "Open the cans of beans, but don't drain.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 78339,
      "primary_message": "Add olive oil to the saucepan and swirl to coat the bottom.",
      "secondary_message": "6 tbsp extra virgin olive oil"
    },
    {
      "id": 78338,
      "primary_message": "Add the carrots and onion to the saucepan; cook, stirring frequently, until the vegetables have softened, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78337,
      "primary_message": "One by one, holding a sprig of rosemary at its top, run you fingers down it to remove the leaves. Discard the sprigs and chop the leaves; transfer the leaves to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 78336,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 78335,
      "primary_message": "Add the minced garlic and crushed red pepper to the saucepan; cook, stirring constantly, until fragrant, 15 to 30 seconds.",
      "secondary_message": "¾ tsp crushed red pepper"
    },
    {
      "id": 78334,
      "primary_message": "Add the beans and their liquid, broth, rosemary, salt, and pepper to the saucepan. Increase the heat to high and bring to a boil.",
      "secondary_message": "2130 ml (9 cups) chicken or vegetable broth\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 78333,
      "primary_message": "When the soup comes to a boil, reduce the heat to a simmer, cover, and cook for 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78332,
      "primary_message": "While the soup cooks, fold each kale leaf lengthwise, slice away and discard the stems, and chop the leaves into 2 ½-cm pieces.",
      "secondary_message": ""
    },
    {
      "id": 78329,
      "primary_message": "Uncover the saucepan, stir in the kale, then cover again and continue to cook until the kale is wilted, 2 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78330,
      "primary_message": "Slice the buns in half and toast (optional).",
      "secondary_message": "3 whole grain buns or rolls"
    },
    {
      "id": 78331,
      "primary_message": "To serve, ladle the soup into a bowl. Serve with the toasted bun on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
