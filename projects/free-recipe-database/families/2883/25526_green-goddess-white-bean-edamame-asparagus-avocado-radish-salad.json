  "instructions": [
    {
      "id": 409102,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 409103,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n1 lemon\n1 small pkg chives\n1 small bunch Italian (flat-leaf) parsley\n1 bunch radish\n2 avocados"
    },
    {
      "id": 409104,
      "primary_message": "Snap (or cut) off the woody ends of the asparagus; cut spears into bite-sized pieces. Transfer to a large baking sheet pan, drizzle with oil, and season with salt. Stir to combine and spread out in an even layer. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 409105,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until asparagus is tender-crisp, 5-8 minutes. Remove from oven and set aside to cool, 5-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 409106,
      "primary_message": "Meanwhile, juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 409107,
      "primary_message": "Roughly chop chives and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 409108,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 409109,
      "primary_message": "Add anchovy filets, yogurt, oil, capers, and spices to the blender. Blend on high until smooth, adding water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "2 anchovy fillets, packed in oil\n⅔ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n1 tbsp capers\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 409110,
      "primary_message": "Drain and rinse beans in a colander. Place in a large bowl.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 409111,
      "primary_message": "Place edamame in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl with the beans, then season with salt.",
      "secondary_message": "2 cups edamame\n½ tsp salt"
    },
    {
      "id": 409112,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 409113,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 409114,
      "primary_message": "When the asparagus has cooled, add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 409115,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
