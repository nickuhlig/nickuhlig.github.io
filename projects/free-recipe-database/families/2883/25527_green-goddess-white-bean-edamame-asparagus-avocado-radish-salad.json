  "instructions": [
    {
      "id": 409116,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 409117,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n1 ½ lemons\n2 small pkgs chives\n1 small bunch Italian (flat-leaf) parsley\n1 ½ bunches radish\n3 avocados"
    },
    {
      "id": 409118,
      "primary_message": "Snap (or cut) off the woody ends of the asparagus; cut spears into bite-sized pieces. Divide between two baking sheet pans, drizzle with oil, and season with salt. Stir to combine and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 409119,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until asparagus is tender-crisp, 5-8 minutes. Remove from oven and set aside to cool, 5-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 409120,
      "primary_message": "Meanwhile, juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 409121,
      "primary_message": "Roughly chop chives and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 409122,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 409123,
      "primary_message": "Add anchovy filets, yogurt, oil, capers, and spices to the blender. Blend on high until smooth, adding water, 1-2 teaspoons at a time, if needed, to reach a drizzling consistency. Set dressing aside.",
      "secondary_message": "3 anchovy fillets, packed in oil\n1 cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n1 ½ tbsp capers\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 409124,
      "primary_message": "Drain and rinse beans in a colander. Place in a large bowl.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 409125,
      "primary_message": "Place edamame in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl with the beans, then season with salt.",
      "secondary_message": "3 cups edamame\n¾ tsp salt"
    },
    {
      "id": 409126,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 409127,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 409128,
      "primary_message": "When the asparagus has cooled, add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 409129,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
