  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust two oven racks to upper middle and lower middle positions. Preheat oven to 150°C (300°F). Line two large baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pulse peanuts and 2 tablespoons confectioners’ sugar in food processor until coarsely ground and crumbly (See notes).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In large bowl, beat shortening and remaining confectioners’ sugar on low speed until combined, 30 to 60 seconds. Increase speed to medium-high and beat until light and fluffy, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Decrease speed to low and add flour, salt, and ground peanuts; mix until combined, 1 to 2 minutes, scraping down bottom and sides of bowl with rubber spatula as necessary.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cover bowl loosely with plastic wrap and refrigerate dough until chilled, 30 to 60 minutes (See Notes).",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Shape dough into 4-cm balls and arrange on prepared baking sheets, about 4 cm apart. With fingertips, gently pat dough to 1.5-cm thickness (See Notes).",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Bake until cookies look dry and are just beginning to brown on bottoms, 20 to 25 minutes, rotating and alternating sheets halfway through baking.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Transfer sheets to cooling racks and cool completely, about 30 minutes. Serve.",
      "secondary_message": null
    }
  ],
