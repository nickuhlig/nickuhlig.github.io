  "ingredients": [
    {
      "ingredient_id": 1420,
      "name": "salted cocktail peanuts",
      "quantity": "2 cups"
    },
    {
      "ingredient_id": 1710,
      "name": "confectioners' sugar, divided",
      "quantity": "1 ½ cups"
    },
    {
      "ingredient_id": 2310,
      "name": "vegetable shortening",
      "quantity": "2 ⅔ cups"
    },
    {
      "ingredient_id": 116,
      "name": "all purpose flour",
      "quantity": "5 cups"
    },
    {
