  "instructions": [
    {
      "id": 342453,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 342454,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 342455,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 342456,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 342457,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the carrot and celery.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 342458,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 342459,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add turkey, veggies, and spices; cook, breaking the turkey apart with a spoon, until the veggies are softened and turkey is browned and crumbly, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 ¼ lb ground turkey\n1 ½ tsp oregano, dried\n1 ½ tsp paprika\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 342460,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 342461,
      "primary_message": "When the turkey is done, add tomatoes, broth, peas, and soy sauce to the pot; stir to combine and bring the stew to a boil.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n24 fl oz (3 cups) chicken or vegetable broth\n2 cups frozen peas\n3 tbsp soy sauce"
    },
    {
      "id": 342462,
      "primary_message": "Meanwhile, in the reserved bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "⅓ cup water\n¼ cup cornstarch"
    },
    {
      "id": 342463,
      "primary_message": "Once the stew is boiling, reduce heat to medium, and add the slurry in a steady stream while stirring. Continue to cook, stirring occasionally, until thickened, 3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 342464,
      "primary_message": "Add half of the parsley to the stew, stir to combine, and remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 342465,
      "primary_message": "To serve, divide rice and stew between bowls; sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
