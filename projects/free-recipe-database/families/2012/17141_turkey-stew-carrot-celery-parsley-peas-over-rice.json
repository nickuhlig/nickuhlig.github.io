  "instructions": [
    {
      "id": 342427,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 342428,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 342429,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 342430,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; trim and small dice celery. Place both in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 342431,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 342432,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the carrot and celery.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 342433,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add turkey, veggies, and spices; cook, breaking the turkey apart with a spoon, until the veggies are softened and turkey is browned and crumbly, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ lb ground turkey\n½ tsp oregano, dried\n½ tsp paprika\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 342434,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 342435,
      "primary_message": "When the turkey is done, add tomatoes, broth, peas, and soy sauce to the pan; stir to combine and bring the stew to a boil.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth\n⅔ cup frozen peas\n1 tbsp soy sauce"
    },
    {
      "id": 342436,
      "primary_message": "Meanwhile, in the reserved bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "2 tbsp water\n1 ½ tbsp cornstarch"
    },
    {
      "id": 342437,
      "primary_message": "Once the stew is boiling, reduce heat to medium, and add the slurry in a steady stream while stirring. Continue to cook, stirring occasionally, until thickened, 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 342438,
      "primary_message": "Add half of the parsley to the stew, stir to combine, and remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 342439,
      "primary_message": "To serve, divide rice and stew between bowls; sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
