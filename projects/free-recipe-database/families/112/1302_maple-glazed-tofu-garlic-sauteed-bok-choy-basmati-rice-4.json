  "instructions": [
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Drain and large dice tofu; place on paper towels and pat dry.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Coat bottom of skillet with oil. Add tofu and, stirring frequently, cook until lightly browned, 5-6 minutes.",
      "secondary_message": "virgin coconut oil"
    },
    {
      "primary_message": "Peel and mince garlic. In a small bowl, whisk together ½ of the garlic (save the rest for the bok choy), soy sauce, maple syrup, and rice vinegar.",
      "secondary_message": "4 cloves garlic\n2 tbsp pure maple syrup\n1 tbsp rice vinegar"
    },
    {
      "primary_message": "Add sauce to tofu. Stirring frequently, cook until sauce thickens and coats tofu, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash bok choy, trim ends, and separate into leaves.",
      "secondary_message": "6 baby bok choy"
    },
    {
      "primary_message": "Transfer tofu and sauce to a plate and return skillet to stove. Add more oil, remaining garlic, and pepper; cook until fragrant, 15-30 seconds.",
      "secondary_message": "virgin coconut oil\n⅛ tsp crushed red pepper"
    },
    {
      "primary_message": "Add bok choy and soy sauce. Tossing occasionally, cook until greens are just wilted and stalks are tender-crisp, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange rice, tofu, and bok choy in a bowl. Enjoy!",
      "secondary_message": null
    }
  ],
