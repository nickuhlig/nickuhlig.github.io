  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to 60°F. Freshly grate the nutmeg. Keep the egg cold until you use it.",
      "secondary_message": "8 oz unsalted butter, firm but pliable\n1 pinch nutmeg\n1 large egg"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position, preheat to 350°F, and line 2 aluminum half sheet pans with parchment paper (not wax paper!).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine butter, sugar, baking powder, kosher salt, nutmeg, and vanilla extract in the bowl of a stand mixer fitted with a paddle attachment. Mix on low to moisten, increase to medium and beat until fluffy, pale ivory, and soft, about 5 minutes. Add egg and continue beating until smooth, about 2 minutes more, pausing to scrape down the sides of the bowl with a rubber spatula as needed. Resume mixing on low, sprinkle in flour, and continue mixing until a thick dough is formed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Divide into twenty six 1-ounce portions with a 2-tablespoon cookie scoop. (That's about 1 ounce/30g per cookie.) Roll each ball of dough between your hands until smooth and round. If desired, tumble in a dish with sanding sugar, nonpareils, sprinkles, granulated, or vanilla sugar until coated on all sides. Arrange cookies on prepared half sheet pan, leaving 2 1/2 inches of space in between cookies. Do not flatten; cookies will spread on their own.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bake until puffed and pale gold around the edges, but still steamy in the middle, about 15 minutes. Cool directly on sheet pan until firm, about 10 minutes. Enjoy warm, or allow to cool completely, then store in an airtight container for up to 2 days at room temperature.",
      "secondary_message": null
    }
  ],
