  "instructions": [
    {
      "id": 266317,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ limes\n3 green bell peppers\n3 tomatoes\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 266318,
      "primary_message": "Zest and juice limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 266319,
      "primary_message": "Peel and mince shallots; add to the bowl with the lime juice.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 266320,
      "primary_message": "Add oil, vinegar, salt, and pepper to the bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp rice vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 266321,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 266322,
      "primary_message": "Small dice tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 266323,
      "primary_message": "Place corn in a colander and run under hot water (from the tap) to thaw; drain and add to the bowl.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 266324,
      "primary_message": "Drain and rinse water chestnuts in the colander; chop into small pieces and add to the bowl. Stir to combine the salsa and set aside.",
      "secondary_message": "12 oz water chestnuts"
    },
    {
      "id": 266325,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 266326,
      "primary_message": "While the grill pan heats up, pat tilapia dry with paper towels and place on a plate; drizzle with oil and season with spices on both sides.",
      "secondary_message": "2 ¼ lb tilapia fillet\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp cayenne pepper\n½ tsp black pepper"
    },
    {
      "id": 266327,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add tilapia to the pan; grill until golden brown and cooked through, 2-4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 266328,
      "primary_message": "To serve, divide arugula and tilapia between plates or bowls. Top with corn salsa, feta, and a dollop of yogurt. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n⅓ cup plain Greek yogurt"
    }
  ],
