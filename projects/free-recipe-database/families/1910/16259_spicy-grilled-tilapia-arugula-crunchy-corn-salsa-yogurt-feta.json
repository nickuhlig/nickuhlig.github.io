  "instructions": [
    {
      "id": 266329,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lime\n1 green bell pepper\n1 tomato\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 266330,
      "primary_message": "Zest and juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 266331,
      "primary_message": "Peel and mince shallot; add to the bowl with the lime juice.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 266332,
      "primary_message": "Add oil, vinegar, salt, and pepper to the bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp rice vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 266333,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 266334,
      "primary_message": "Small dice tomato and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 266335,
      "primary_message": "Place corn in a colander and run under hot water (from the tap) to thaw; drain and add to the bowl.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 266336,
      "primary_message": "Drain and rinse water chestnuts in the colander; chop into small pieces and add to the bowl. Stir to combine the salsa and set aside.",
      "secondary_message": "113 g water chestnuts"
    },
    {
      "id": 266337,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 266338,
      "primary_message": "While the grill pan heats up, pat tilapia dry with paper towels and place on a plate; drizzle with oil and season with spices on both sides.",
      "secondary_message": "⅓ kg tilapia fillet\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp cayenne pepper\n⅛ tsp black pepper"
    },
    {
      "id": 266339,
      "primary_message": "Once the grill pan is hot, add tilapia to the pan; grill until golden brown and cooked through, 2-4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 266340,
      "primary_message": "To serve, divide arugula and tilapia between plates or bowls. Top with corn salsa, feta, and a dollop of yogurt. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n⅛ cup plain Greek yogurt"
    }
  ],
