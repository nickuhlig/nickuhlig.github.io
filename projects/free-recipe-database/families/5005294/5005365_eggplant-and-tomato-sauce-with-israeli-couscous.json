  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the shallot. Dice the eggplant. Core and roughly chop the plum tomatoes. Pick the basil leaves from the stems and chop them.",
      "secondary_message": "1 medium shallot\n1 large eggplant\n8 plum tomatoes\n6 to 8 basil leaves"
    },
    {
      "id": 1,
      "primary_message": "Heat 1 1⁄4 cups of the broth in a 30-cm skillet over high heat until it reaches a boil. Stir in the couscous and season to taste with salt and pepper, reducing heat to bring it to a bare simmer. Cover, stirring occasionally, until the excess liquid is absorbed, about 8 to 10 minutes. Transfer to a bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Wipe out skillet and add olive oil. Heat over medium-high heat until shimmering. Add the shallots, turmeric, and a pinch of salt. Cook, stirring constantly 3 to 4 minutes, add the garlic and cook until fragrant, about 1 minute longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the eggplant, and cook, stirring occasionally, until it begins to soften, 3 to 4 minutes. Add the tomatoes, remaining 1/2 cup broth, paprika, and chili flakes. Once the tomatoes begin to soften, gently break them up with a wooden spoon or potato masher. Cover, reduce heat to low, and cook until the eggplants are cooked through and the tomatoes have completely broken down, about 20 minutes. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Stir in the couscous and allow it to absorb the excess liquid and warm through, 1 to 2 minutes longer. Remove from the heat and garnish with the basil leaves. Serve.",
      "secondary_message": null
    }
  ],
