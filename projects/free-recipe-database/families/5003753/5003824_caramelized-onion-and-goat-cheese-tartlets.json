  "instructions": [
    {
      "id": 1,
      "primary_message": "Place olive oil in a large sauce pan over medium heat. Add onions and cook, stirring occasionally, until caramelized, about 35 minutes. Season with salt. Let come to room temperature.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While onions are cooling, place goat cheese in a small bowl. Add black pepper and stir goat cheese until soft and easily spreadable.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat oven to 190°C (375°F). Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place puff pastry on baking sheet. Spread goat cheese over tart, leaving a 1.5 cm border on all sides. Top tart evenly with onions and sprinkle with thyme. Bake until crust is golden, about 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Let tart cool for 15 minutes. Cut into approximately 2 by 8 cm rectangles. Serve warm or at room temperature.",
      "secondary_message": null
    }
  ],
