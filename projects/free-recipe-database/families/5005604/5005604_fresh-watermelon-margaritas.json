  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the seedless watermelon into rough 1/2-inch cubes. Juice the limes.",
      "secondary_message": "4 ½ cups seedless watermelon\n3 limes"
    },
    {
      "id": 1,
      "primary_message": "Add watermelon, salt, lime juice, St. Germain, and tequila to a blender. Puree until smooth. Strain through a fine-mesh strainer into a pitcher, using the bottom of a ladle or a rubber spatula to press liquid through strainer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Mixture can be served immediately or sealed and chilled for up to five hours in the refrigerator. When ready to serve, fill three serving glasses with ice, re-stir mixture, and and divide evenly between glasses. Serve immediately.",
      "secondary_message": null
    }
