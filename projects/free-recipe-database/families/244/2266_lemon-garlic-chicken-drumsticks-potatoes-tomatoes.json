  "instructions": [
    {
      "id": 21635,
      "primary_message": "Preheat oven to 260°C (500°F) and position rack in the center.",
      "secondary_message": ""
    },
    {
      "id": 21636,
      "primary_message": "Make a few slits in the chicken drumsticks, then place on a baking sheet pan.",
      "secondary_message": "0.34 kg chicken drumsticks"
    },
    {
      "id": 21637,
      "primary_message": "Wash and dry potatoes; medium dice and add to pan with chicken. Peel, cut into thin wedges, and add onion to pan.",
      "secondary_message": "0.34 kg sweet potatoes\n½ medium red onion"
    },
    {
      "id": 21638,
      "primary_message": "Place pan in the oven and roast while you prepare the sauce and tomatoes, about 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 21639,
      "primary_message": "Grate zest from ½ lemon into a small bowl, then juice into the same bowl. Slice other ½ into rounds. Peel, mince, and add garlic to bowl.",
      "secondary_message": "1 lemon\r\n2 cloves garlic"
    },
    {
      "id": 21640,
      "primary_message": "Add olive oil, Italian seasoning, salt, and pepper to bowl and mix.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n1 tsp Italian seasoning\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 21641,
      "primary_message": "Wash tomatoes.",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 21642,
      "primary_message": "Remove pan from oven. Pour sauce over top chicken and potatoes; toss to coat. Add tomatoes and lemon slices to pan. Return to oven and roast until chicken is cooked through and potatoes are tender, 20-25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 21643,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 21644,
      "primary_message": "Once chicken is cooked through, remove dish from oven. Garnish with parsley and toss.",
      "secondary_message": ""
    },
    {
      "id": 21645,
      "primary_message": "Place chicken and vegetables on a plate and enjoy!",
      "secondary_message": ""
    }
  ],
