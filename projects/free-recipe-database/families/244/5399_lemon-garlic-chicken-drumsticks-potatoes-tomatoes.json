  "instructions": [
    {
      "id": 64870,
      "primary_message": "Preheat oven to 500°F and position rack in the center.",
      "secondary_message": ""
    },
    {
      "id": 64869,
      "primary_message": "Make a few slits in the chicken drumsticks, then place on a baking sheet pan.",
      "secondary_message": "2 ¼ lb chicken drumsticks"
    },
    {
      "id": 64868,
      "primary_message": "Wash and dry potatoes; medium dice and add to pan with chicken. Peel, cut into thin wedges, and add onion to pan.",
      "secondary_message": "2 ¼ lb sweet potatoes\n1 ½ medium red onion"
    },
    {
      "id": 64867,
      "primary_message": "Place pan in the oven and roast while you prepare the sauce and tomatoes, about 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 64866,
      "primary_message": "Grate zest from 1 ½ lemons into a small bowl, then juice into the same bowl. Slice other 1 ½ lemons into rounds. Peel, mince, and add garlic to bowl.",
      "secondary_message": "3 lemons\n6 cloves garlic"
    },
    {
      "id": 64865,
      "primary_message": "Add olive oil, Italian seasoning, salt, and pepper to bowl and mix.",
      "secondary_message": "6 tbsp extra virgin olive oil\n3 tsp Italian seasoning\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 64864,
      "primary_message": "Wash tomatoes.",
      "secondary_message": "3 pints grape tomatoes"
    },
    {
      "id": 64863,
      "primary_message": "Remove pan from oven. Pour sauce over top chicken and potatoes; toss to coat. Add tomatoes and lemon slices to pan. Return to oven and roast until chicken is cooked through and potatoes are tender, about 25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 64862,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 64861,
      "primary_message": "Once chicken is cooked through, remove dish from oven. Garnish with parsley and toss.",
      "secondary_message": ""
    },
    {
      "id": 64860,
      "primary_message": "Place chicken and vegetables on a plate and enjoy!",
      "secondary_message": ""
    }
  ],
