  "instructions": [
    {
      "id": 153328,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 153329,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ bunches kale\n1 ½ heads romaine lettuce"
    },
    {
      "id": 153330,
      "primary_message": "Grate zest from the lemons into a large salad bowl. Add oil and spices, then whisk to combine.",
      "secondary_message": "⅓ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 153331,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Transfer to the bowl.",
      "secondary_message": null
    },
    {
      "id": 153332,
      "primary_message": "Cut or tear the buns into bite-sized pieces and place in the bowl; toss to coat. Transfer croutons to a large baking sheet pan. Reserve bowl for later use.",
      "secondary_message": "3 whole grain buns or rolls"
    },
    {
      "id": 153333,
      "primary_message": "Place croutons in the oven and cook, tossing halfway through, until golden and crisp, 12-15 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 153334,
      "primary_message": "Meanwhile, juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 153335,
      "primary_message": "Peel garlic; add to blender along with cashews, water, nutritional yeast, capers, soy sauce, Dijon, salt, and pepper. Blend until smooth; adding water, 1 tbsp at a time, if needed, to make a thick dressing; transfer to the salad bowl.",
      "secondary_message": "3 cloves garlic\n1 ½ cups cashews, roasted unsalted\n¾ cup water\n⅜ cup nutritional yeast flakes\n1 ½ tbsp capers\n1 tbsp soy sauce\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 153336,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans kidney beans"
    },
    {
      "id": 153337,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl with the dressing. Using your hands, massage kale with the dressing until slightly softened.",
      "secondary_message": null
    },
    {
      "id": 153338,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces and transfer to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 153339,
      "primary_message": "Add beans to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 153340,
      "primary_message": "To serve, divide salad between plates or bowls and top with croutons. Enjoy!",
      "secondary_message": null
    }
  ],
