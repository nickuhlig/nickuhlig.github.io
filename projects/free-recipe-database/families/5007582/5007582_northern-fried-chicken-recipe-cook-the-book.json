  "instructions": [
    {
      "id": 1,
      "primary_message": "Fill a large pot with about 3 inches of oil. Heat the oil over medium-high heat until a deep-fat thermometer reads 375°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Rinse the chicken pieces and pat dry with paper towels. Place the egg whites in a large shallow bowl. In a separate shallow bowl, combine the matzo meal, flour, and baking powder. Dip each chicken piece in egg white and let excess drip back into the bowl. Next press each chicken piece into the matzo mix and tap off excess.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Working in 2 batches, if necessary, fry the chicken until dark golden, about 10 minutes for white meat and 13 minutes for dark meat. Transfer to a paper towel-lined plate. Sprinkle immediately with the perfect roast seasoning, then coat the pieces with the fried chicken seasoning. Serve with gravy if you like, and honey, for dipping.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "- makes about 2/3 cup -",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Combine the salt, pepper, and thyme, and store in a covered container.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "- makes about 3 tablespoons -",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Combine the paprika, salt, garlic powder, onion powder, parsley, basil, and cayenne",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "pepper, and store in a covered container.",
      "secondary_message": null
    }
  ],
