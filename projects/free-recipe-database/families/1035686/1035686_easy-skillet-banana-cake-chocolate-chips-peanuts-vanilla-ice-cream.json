  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Melt butter in a medium ovenproof skillet set over medium-low heat. Remove from heat.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "primary_message": "Meanwhile, place flour, sugar, baking soda, and salt in a medium bowl, then stir to combine the dry ingredients.\n\n",
      "secondary_message": "1 ½ cups all-purpose flour\n¾ cup brown sugar\n1 tsp baking soda\n¼ tsp salt"
    },
    {
      "primary_message": "Carefully add bananas to the skillet with the melted butter, then mash with a potato masher until smooth. Add milk and vinegar to the skillet, then stir until combined. Add the dry ingredients to the skillet and stir once more to combine the batter. (The batter may seem dry at first but keep stirring and it will come together.) Spread batter out across the bottom of the skillet. \n\n",
      "secondary_message": "¼ cup whole milk\n1 tbsp white vinegar"
    },
    {
      "primary_message": "Roughly chop peanuts, then sprinkle over the batter, along with chocolate chips. Place cake in the oven (it doesn't have to be fully heated) and bake until a toothpick inserted in the center comes out clean, 30-35 minutes. Remove from oven and set aside to cool slightly, 10 minutes.\n\n",
      "secondary_message": "½ cup peanuts, roasted unsalted\n⅓ cup dark chocolate chips"
    },
    {
      "primary_message": "To serve, divide warm cake and ice cream between plates or bowls. Enjoy!\n\n",
      "secondary_message": "6 cups vanilla ice cream"
    }
  ],
