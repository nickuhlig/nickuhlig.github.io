  "instructions": [
    {
      "id": 616351,
      "primary_message": "Wash, dry, peel, and coarsely grate sweet potato. Place in a medium bowl along with eggs, flour, cinnamon, and salt, then stir to combine the batter.",
      "secondary_message": "¾ lb sweet potato\n2 eggs\n2 tbsp all-purpose flour\n½ tsp cinnamon, ground\n1 pinch salt"
    },
    {
      "id": 616352,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 616353,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 616354,
      "primary_message": "Using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown and cooked through, 6-8 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 616355,
      "primary_message": "Meanwhile, wash and dry raspberries. Place in a small saucepan along with maple syrup.",
      "secondary_message": "1 (6 oz) pkg raspberries\n1 tsp pure maple syrup"
    },
    {
      "id": 616356,
      "primary_message": "Set pan over medium heat and cook, stirring occasionally, until raspberries are warmed through, about 2 minutes. Remove from heat and lightly crush raspberries with a potato masher or fork to create a semi-smooth sauce.",
      "secondary_message": null
    },
    {
      "id": 616357,
      "primary_message": "\"To serve, divide fritters between plates, then top with yogurt and raspberry sauce. Enjoy!",
      "secondary_message": "⅓ cup plain Greek yogurt"
    }
  ],
