  "instructions": [
    {
      "primary_message": "Wash, dry, peel, and coarsely grate sweet potatoes. Place in a medium bowl along with eggs, flour, cinnamon, and salt, then stir to combine the batter.",
      "secondary_message": "1 ½ lb sweet potatoes\n4 eggs\n1 tsp cinnamon, ground\n⅛ tsp salt"
    },
    {
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "primary_message": "Working in batches, using a ¼-cup measure, drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown and cooked through, 6-8 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry raspberries. Place in a small saucepan along with maple syrup.",
      "secondary_message": "2 (6 oz) pkgs raspberries\n2 tsp pure maple syrup"
    },
    {
      "primary_message": "Set pan over medium heat and cook, stirring occasionally, until raspberries are warmed through, about 3 minutes. Remove from heat and lightly crush raspberries with a potato masher or fork to create a semi-smooth sauce.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide fritters between plates, then top with yogurt and raspberry sauce. Enjoy!",
      "secondary_message": "⅔ cup plain Greek yogurt"
    }
  ],
