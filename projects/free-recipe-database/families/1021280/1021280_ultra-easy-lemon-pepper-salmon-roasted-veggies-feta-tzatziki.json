    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer veggies to a baking sheet pan and drizzle with oil. Stir to coat and spread out in an even layer. Place in the preheated oven and bake until veggies are warmed through and golden brown, about 20 minutes. Remove from oven, add feta, and stir to combine.",
      "secondary_message": "1 (14 oz) bag frozen roasting vegetables (cauliflower, sweet potatoes, broccoli)\nextra virgin olive oil\n½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "primary_message": "Meanwhile, place salmon, skin-side down, in a baking dish. Drizzle with oil and sprinkle with lemon pepper seasoning. Add to the oven and bake until salmon is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": "12 oz salmon fillet\n1 tsp extra virgin olive oil\n1 tsp lemon pepper seasoning"
    },
    {
      "primary_message": "To serve, divide veggies, salmon, and tzatziki between plates or bowls. ",
      "secondary_message": "⅓ cup tzatziki sauce"
    }
