  "instructions": [
    {
      "id": 359795,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n3 (170 g) pkg blueberries\n1 ½ English cucumbers\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 359796,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 359797,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 359798,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 359799,
      "primary_message": "Meanwhile, pick basil off the stems and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 359800,
      "primary_message": "Add half of the blueberries (reserve remaining blueberries for the salad), vinegar, water, oil, Dijon, salt, and pepper to the blender. Blend on high until smooth, then set dressing aside.",
      "secondary_message": "⅓ cup balsamic vinegar\n⅓ cup water\n2 tbsp extra virgin olive oil\n1 ½ tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 359801,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into thin pieces; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 359802,
      "primary_message": "Roughly chop walnuts and add to the bowl with the cucumber. ",
      "secondary_message": "1 cup walnuts"
    },
    {
      "id": 359803,
      "primary_message": "Add mixed greens and remaining blueberries to the bowl. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 359804,
      "primary_message": "Thinly slice steak against the grain. ",
      "secondary_message": null
    },
    {
      "id": 359805,
      "primary_message": "To serve, divide salad and steak between plates or bowls. Crumble goat cheese over top and drizzle with dressing. Enjoy! ",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    }
  ],
