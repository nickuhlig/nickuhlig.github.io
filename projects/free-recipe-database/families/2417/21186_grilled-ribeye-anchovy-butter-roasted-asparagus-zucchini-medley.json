  "instructions": [
    {
      "id": 354293,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 354294,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 medium zucchini squash\n3 small bunches asparagus"
    },
    {
      "id": 354295,
      "primary_message": "Mince anchovies and place in a small bowl.",
      "secondary_message": "3 anchovy fillets, packed in oil"
    },
    {
      "id": 354296,
      "primary_message": "Zest lemons into the bowl with the anchovy. Add butter, parsley flakes, and garlic powder; set aside to soften. (Reserve lemons for later use.)",
      "secondary_message": "⅓ cup butter, unsalted\n1 ½ tsp parsley flakes\n¾ tsp garlic powder"
    },
    {
      "id": 354297,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 354298,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 2-inch pieces. Add to the baking sheets with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 354299,
      "primary_message": "Juice reserved lemons over the veggies. Season with spices, toss to combine, and spread out in an even layer.",
      "secondary_message": "1 ½ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 354300,
      "primary_message": "Cut additional butter into small pieces and sprinkle over the veggies.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 354301,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 354302,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 354303,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 354304,
      "primary_message": "Once the pan is hot, coat with additional butter. Working in batches if necessary, add steak and grill until desired doneness, 2-5 minutes per side. Transfer steak to a cutting board, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 354305,
      "primary_message": "Meanwhile, gently mash the softened butter, lemon zest, anchovy, and spices with the back of a spoon to combine.",
      "secondary_message": null
    },
    {
      "id": 354306,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 354307,
      "primary_message": "To serve, divide roasted veggies and steak between plates; top steak with anchovy butter. Enjoy!",
      "secondary_message": null
    }
  ],
