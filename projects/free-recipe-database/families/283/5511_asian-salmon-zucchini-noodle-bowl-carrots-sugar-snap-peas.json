  "instructions": [
    {
      "id": 66088,
      "primary_message": "Wash the fresh produce.",
      "secondary_message": "3 avocados\n6 medium carrots\n3 (2 ½ cm) pieces ginger root\n1 ½ small bunch green onions (scallions)\n3 (227 g) pkg sugar snap peas\n6 medium zucchini squash"
    },
    {
      "id": 66087,
      "primary_message": "Peel and mince or grate the ginger. In a shallow dish, whisk together the ginger, coconut aminos, vinegar, and sesame oil.",
      "secondary_message": "6 tbsp coconut aminos\n3 tbsp rice vinegar\n3 tsp toasted sesame oil"
    },
    {
      "id": 66086,
      "primary_message": "Place the salmon flesh-side down in the marinade and turn a few times to coat.",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 66085,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 66084,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add salmon skin-side down, reserving the marinade in the dish, and cook until skin is crispy and flesh is opaque, 3-4 minutes per side depending on thickness. Transfer to a plate and allow it to cool.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 66083,
      "primary_message": "While the salmon cooks, trim ends and, using a julienne peeler (or regular peeler), peel the carrots and zucchini into noodle-like sticks; transfer to a large bowl. Halve the peas on an angle and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 66082,
      "primary_message": "Once the salmon has been removed, add carrots, zucchini, peas, and reserved marinade to the skillet. Toss and cook until the noodles have softened slightly, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 66081,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Trim ends and chop the green onions on an angle.",
      "secondary_message": ""
    },
    {
      "id": 66080,
      "primary_message": "To serve, combine noodles, peas, and avocado on a plate or in a bowl. Flake salmon over top and sprinkle with green onions and sesame seeds. Enjoy!",
      "secondary_message": "3 tsp sesame seeds"
    }
  ],
