  "instructions": [
    {
      "id": 206092,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 206093,
      "primary_message": "Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 206094,
      "primary_message": "Once the water in the pot is boiling, add broccoli and gnocchi. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3-4 minutes.",
      "secondary_message": "2 (16 oz) pkg potato gnocchi"
    },
    {
      "id": 206095,
      "primary_message": "Meanwhile, coarsely grate the cheese and set aside.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 206096,
      "primary_message": "When the gnocchi and broccoli are done, drain and return to the pot. Cover and set aside.",
      "secondary_message": null
    },
    {
      "id": 206097,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 206098,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 206099,
      "primary_message": "Add flour and whisk until smooth. Cook, whisking frequently, for 1 minute.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 206100,
      "primary_message": "Slowly pour milk into the pan, whisking constantly. Continue whisking until the sauce has thickened, 3-4 minutes.",
      "secondary_message": "20 fl oz (2 ½ cups) whole milk"
    },
    {
      "id": 206101,
      "primary_message": "Add cheese and spices to the pan; whisk until cheese is melted and sauce is smooth. ",
      "secondary_message": "1 tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 206102,
      "primary_message": "Pour sauce into the pot with the gnocchi and broccoli; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 206103,
      "primary_message": "To serve, divide gnocchi and broccoli between bowls and enjoy!",
      "secondary_message": null
    }
  ],
