  "instructions": [
    {
      "id": 238691,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "¼ cup rice vinegar\n1 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 238692,
      "primary_message": "Wash, dry, peel, trim, and thinly slice carrot. Peel and thinly slice shallot; add both to the bowl with the marinade.",
      "secondary_message": "1 medium carrot\n1 shallot"
    },
    {
      "id": 238693,
      "primary_message": "Wash, dry, trim, and thinly slice cucumber; add to the bowl, toss to combine, and set the veggies aside to marinate.",
      "secondary_message": "½ English cucumber"
    },
    {
      "id": 238694,
      "primary_message": "Thinly slice mozzarella.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 238695,
      "primary_message": "Place the bread slices on a flat surface and spread with Dijon. Evenly top half the slices with the mozzarella and prosciutto. Cover the sandwiches with remaining bread slices.",
      "secondary_message": "4 slices whole grain bread\n2 tsp Dijon mustard\n6 slices prosciutto"
    },
    {
      "id": 238696,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 238697,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 238698,
      "primary_message": "Remove sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up; cook until golden brown on the other side and the cheese is melted, 2-4 minutes. Once done, transfer to a cutting board.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 238699,
      "primary_message": "Wipe the skillet clean with a paper towel; return to medium heat, and add more butter. Gently crack eggs into the skillet and cook until whites are set but yolks are still runny, about 3 minutes. Remove from heat and season with salt and pepper. ",
      "secondary_message": "1 tsp butter, unsalted\n2 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 238700,
      "primary_message": "Meanwhile, preheat a small saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 238701,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom. Add flour, salt, and pepper; cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "1 tbsp butter, unsalted\n1 tbsp all-purpose flour\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 238702,
      "primary_message": "Slowly whisk milk into the saucepan; bring to a boil and cook until sauce is thickened, about 2 minutes.",
      "secondary_message": "4 fl oz (½ cup) whole milk"
    },
    {
      "id": 238703,
      "primary_message": "Divide sandwiches between plates; drizzle with sauce and top with a fried egg. Serve with pickled veggies on the side and enjoy!",
      "secondary_message": null
    }
  ],
