  "instructions": [
    {
      "id": 238717,
      "primary_message": "Place vinegar, sugar, and salt in a large bowl; whisk to combine the marinade.",
      "secondary_message": "¾ cup rice vinegar\n1 tbsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 238718,
      "primary_message": "Wash, dry, peel, trim, and thinly slice carrots. Peel and thinly slice onion; add both to the bowl with the marinade.",
      "secondary_message": "3 medium carrots\n½ medium red onion"
    },
    {
      "id": 238719,
      "primary_message": "Wash, dry, trim, and thinly slice cucumbers; add to the bowl, toss to combine, and set the veggies aside to marinate.",
      "secondary_message": "1 ½ English cucumbers"
    },
    {
      "id": 238720,
      "primary_message": "Thinly slice mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 238721,
      "primary_message": "Place the bread slices on a flat surface and spread with Dijon. Evenly top half the slices with the mozzarella and prosciutto. Cover the sandwiches with remaining bread slices.",
      "secondary_message": "12 slices whole grain bread\n2 tbsp Dijon mustard\n18 slices prosciutto"
    },
    {
      "id": 238722,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 238723,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 238724,
      "primary_message": "Remove sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up; cook until golden brown on the other side and the cheese is melted, 2-4 minutes. Once done, transfer to a cutting board.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 238725,
      "primary_message": "Wipe the skillet clean with a paper towel; return to medium heat, and add more butter. Gently crack eggs into the skillet and cook until whites are set but yolks are still runny, 3-4 minutes. Remove from heat and season with salt and pepper. ",
      "secondary_message": "1 tbsp butter, unsalted\n6 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 238726,
      "primary_message": "Meanwhile, preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 238727,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom. Add flour, salt, and pepper; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "3 tbsp butter, unsalted\n3 tbsp all-purpose flour\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 238728,
      "primary_message": "Slowly whisk milk into the saucepan; bring to a boil and cook until sauce is thickened, 3-4 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) whole milk"
    },
    {
      "id": 238729,
      "primary_message": "Divide sandwiches between plates; drizzle with sauce and top with a fried egg. Serve with pickled veggies on the side and enjoy!",
      "secondary_message": null
    }
  ],
