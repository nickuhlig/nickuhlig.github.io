  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce. \n\n",
      "secondary_message": "1 lime\n½ small bunch cilantro"
    },
    {
      "primary_message": "Peel and medium dice sweet potatoes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer. \n\n",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp paprika\n½ tsp onion powder\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is fork-tender, 18-20 minutes. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the sweet potato has about 10 minutes left, cut lime into wedges. Place on a plate. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the lime wedges and set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add beef and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.\n\n",
      "secondary_message": "680 g lean ground beef\n1 (28 g) pkg taco seasoning\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the sweet potato is done, remove from oven. Add cilantro to the baking sheet and stir to combine. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide beef, sweet potato, cottage cheese, avocado, and lime wedges between bowls. Drizzle with hot honey and enjoy!\n\n",
      "secondary_message": "2 cups cottage cheese\n2 tbsp hot honey"
    }
  ],
