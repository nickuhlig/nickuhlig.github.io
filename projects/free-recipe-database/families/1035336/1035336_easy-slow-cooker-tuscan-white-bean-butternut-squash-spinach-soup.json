  "instructions": [
    {
      "primary_message": "Wash, dry, trim, and peel squash; halve lengthwise, scrape out the seeds, and medium dice. Place in a 4-quart slow cooker insert.\n\n",
      "secondary_message": "1 small butternut squash"
    },
    {
      "primary_message": "Drain and rinse beans. Add to the slow cooker, along with broth, tomatoes, carrots, garlic, and spices, then stir to combine the soup. \n\n",
      "secondary_message": "2 (15 oz) can cannellini (white kidney) beans\n6 cups vegetable broth\n1 (14.5 oz) can diced tomatoes\n1 (10 oz) bag shredded carrots\n1 tbsp minced garlic\n2 tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Cover slow cooker and cook until veggies are tender, 8-10 hours on LOW or 5 hours on HIGH.",
      "secondary_message": null
    },
    {
      "primary_message": "When the soup is done, wash and dry the spinach (skip this step if it came pre-washed). Add spinach to the slow cooker in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine, then continue to cook until spinach is fully wilted, about 10 minutes.\n\n",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "primary_message": "Add vinegar to the slow cooker, stir once more to combine, and remove from heat.",
      "secondary_message": "1 tbsp red wine vinegar"
    },
    {
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
