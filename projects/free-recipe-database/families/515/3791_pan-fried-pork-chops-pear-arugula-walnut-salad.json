  "instructions": [
    {
      "id": 41731,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 (142 g) pkg baby arugula\n2 pears"
    },
    {
      "id": 41732,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 41733,
      "primary_message": "While the grill pan / skillet heats up, pat the pork chops dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, bone-in\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 41734,
      "primary_message": "Once the grill pan / skillet is hot, coat the bottom with coconut oil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 41735,
      "primary_message": "Place the pork chops in the grill pan / skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
      "secondary_message": null
    },
    {
      "id": 41736,
      "primary_message": "Transfer the arugula to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 41737,
      "primary_message": "Quarter the pears lengthwise, then cut out the core and stem from each section; cut each section lengthwise into 4 thin wedges and transfer to the bowl with the arugula.",
      "secondary_message": null
    },
    {
      "id": 41738,
      "primary_message": "Roughly chop the walnuts and leave on cutting board.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 41739,
      "primary_message": "In a small bowl, combine and whisk together olive oil, balsamic vinegar, honey, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 41740,
      "primary_message": "Drizzle the dressing over the arugula and pears; toss to coat.",
      "secondary_message": null
    },
    {
      "id": 41741,
      "primary_message": "To serve, divide the salad between plates and sprinkle with the walnuts; place the pork chops next to the salad. Enjoy!",
      "secondary_message": null
    }
  ],
