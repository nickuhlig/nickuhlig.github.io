  "instructions": [
    {
      "id": 154098,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n170 g rotini pasta"
    },
    {
      "id": 154099,
      "primary_message": "Meanwhile, heat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 154100,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 154101,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 154102,
      "primary_message": "Add garlic to the pan and stir until fragrant, 15-30 seconds.",
      "secondary_message": null
    },
    {
      "id": 154103,
      "primary_message": "Add peas and salt. Cook, stirring occasionally, until peas are heated through, 3-4 minutes.",
      "secondary_message": "½ cup frozen peas\n¼ tsp salt"
    },
    {
      "id": 154104,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 154105,
      "primary_message": "Add cream to the pan with the peas and bring to a simmer. Once pasta is done, drain and add to the pan along with the Parmesan.",
      "secondary_message": "118 ml (½ cup) heavy cream"
    },
    {
      "id": 154106,
      "primary_message": "Drain tuna, add to the pan, and gently stir to combine.",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 154107,
      "primary_message": "To serve, divide pasta between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
