  "instructions": [
    {
      "id": 1,
      "primary_message": "Cut fish into 5 cm strips diagonally across grain. Place fish in bowl with sake, sesame oil, chili powder, gochujang paste, and garlic. Toss gently. Leave standing for about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In the meantime, bring 4 cups water to boil and add dried anchovies. Boil for 10 minutes, then discard anchovies. Add daikon, soy sauce, and tofu and simmer for 5 minutes until daikon is halfway cooked.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add fish, shrimp, and enoki and simmer for 3 to 5 minutes depending on size of shrimp. Add watercress and simmer for 1 minute longer until watercress is just cooked through. Garnish with green onion. Serve immediately.",
      "secondary_message": null
    }
  ],
