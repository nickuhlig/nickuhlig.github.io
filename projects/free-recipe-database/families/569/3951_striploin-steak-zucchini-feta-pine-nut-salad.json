  "instructions": [
    {
      "id": 43997,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n1 lemon"
    },
    {
      "id": 43998,
      "primary_message": "Juice the lemon and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 43999,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the lemon juice.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 44000,
      "primary_message": "To the lemon juice and garlic, add olive oil, salt, and pepper; whisk together.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 44001,
      "primary_message": "Trim off and discard the ends of the zucchini; cut the zucchini crosswise into 6-mm-thick rounds at an angle. Add to the large bowl and toss until well coated with the oil mixture.",
      "secondary_message": ""
    },
    {
      "id": 44002,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 44003,
      "primary_message": "While the grill pan / skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 44004,
      "primary_message": "Once the grill pan / skillet is hot, coat the bottom with coconut oil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 44005,
      "primary_message": "Carefully place the steak in the grill pan / skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 44006,
      "primary_message": "Once the steak has been transferred, add the zucchini slices to the grill pan / skillet. Cook until they are tender and browned, 2 to 3 minutes per side. Once done, transfer to a plate. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 44007,
      "primary_message": "Measure out the pine nuts and transfer to a small bowl.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 44008,
      "primary_message": "Measure out the feta and transfer to a small bowl.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 44009,
      "primary_message": "To serve, divide the steak and zucchini slices between plates, then top the zucchini with feta and pine nuts. Enjoy!",
      "secondary_message": null
    }
  ],
