  "instructions": [
    {
      "id": 577962,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 577963,
      "primary_message": "Drizzle both sides of the tortillas with oil and sprinkle with salt; divide between two baking sheet pans. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until the tortillas are golden brown and crispy, 10-15 minutes. Remove from oven.",
      "secondary_message": "12 small corn tortillas\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 577964,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n1 ½ English cucumbers\n1 ½ jalapeño peppers\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 577965,
      "primary_message": "Small dice tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 577966,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 577967,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 577968,
      "primary_message": "Peel, halve, and mince onion. Add to the bowl, along with salt and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "½ medium red onion\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 577969,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Set aside.",
      "secondary_message": null
    },
    {
      "id": 577970,
      "primary_message": "Place yogurt, vinegar, mayo, and spices in a small bowl, then stir to combine the ranch dressing. Add water, 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n2 tbsp apple cider vinegar\n1 ½ tbsp mayonnaise\n1 ½ tsp dill, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 577971,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 577972,
      "primary_message": "While the skillet heats up, drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 577973,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beans, salt, and pepper; cook, stirring occasionally, until tender and warmed through, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 577974,
      "primary_message": "Meanwhile, coarsely grate cheese. Place in a large bowl along with additional yogurt, hot sauce, and spices, then stir to combine.",
      "secondary_message": "¾ (227 g) block cheddar cheese\n¾ cup plain Greek yogurt\n3 tbsp hot sauce\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp paprika\n¾ tsp black pepper"
    },
    {
      "id": 577975,
      "primary_message": "When the beans are done, transfer to the bowl with the cheese mixture, and stir to combine the Buffalo beans.",
      "secondary_message": null
    },
    {
      "id": 577976,
      "primary_message": "To serve, divide crispy tortillas between plates; top with Buffalo beans, lettuce, and salsa. Drizzle with ranch dressing and enjoy!",
      "secondary_message": null
    }
  ],
