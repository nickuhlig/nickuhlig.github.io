  "instructions": [
    {
      "id": 577890,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 577891,
      "primary_message": "Place broth in a medium saucepan and bring to a boil over high heat.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 577892,
      "primary_message": "Meanwhile, drizzle both sides of the tortillas with oil and sprinkle with salt; arrange on a baking sheet pan. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until tortillas are golden brown and crispy, 10-15 minutes. Remove from oven.",
      "secondary_message": "4 small corn tortillas\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 577893,
      "primary_message": "Once the liquid is boiling, add chicken to the pan and reduce heat to medium-low. Cover and cook until chicken is cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 577894,
      "primary_message": "While the chicken is cooking, wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n½ English cucumber\n½ jalapeño pepper\n½ head butter (Boston) lettuce"
    },
    {
      "id": 577895,
      "primary_message": "Small dice tomato. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 577896,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 577897,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 577898,
      "primary_message": "Peel and mince shallot. Add to the bowl, along with salt and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "1 shallot\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 577899,
      "primary_message": "When the chicken is done, transfer to another medium bowl. Using two forks, shred the chicken into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 577900,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the chicken, along with yogurt, hot sauce, and spices. Stir to combine and set aside.",
      "secondary_message": "¼ (227 g) block cheddar cheese\n¼ cup plain Greek yogurt\n1 tbsp hot sauce\n½ tsp garlic powder\n½ tsp salt\n¼ tsp paprika\n¼ tsp black pepper"
    },
    {
      "id": 577901,
      "primary_message": "Place additional yogurt, vinegar, mayo, and spices in a small bowl, then stir to combine the ranch dressing. Add water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tsp apple cider vinegar\n1 ½ tsp mayonnaise\n½ tsp dill, dried\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 577902,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 577903,
      "primary_message": "To serve, divide crispy tortillas between plates; top with Buffalo chicken, lettuce, and salsa. Drizzle with ranch dressing and enjoy!",
      "secondary_message": null
    }
  ],
