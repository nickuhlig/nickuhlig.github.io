  "instructions": [
    {
      "id": 577845,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 577846,
      "primary_message": "Drizzle both sides of the tortillas with oil and sprinkle with salt; arrange on a baking sheet pan. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until the tortillas are golden brown and crispy, 10-15 minutes. Remove from oven.",
      "secondary_message": "4 small corn tortillas\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 577847,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n½ English cucumber\n½ jalapeño pepper\n½ head butter (Boston) lettuce"
    },
    {
      "id": 577848,
      "primary_message": "Small dice tomato. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 577849,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 577850,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 577851,
      "primary_message": "Peel and mince shallot. Add to the bowl, along with salt and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "1 shallot\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 577852,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Set aside.",
      "secondary_message": null
    },
    {
      "id": 577853,
      "primary_message": "Place yogurt, vinegar, mayo, and spices in a small bowl, then stir to combine the ranch dressing. Add water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tsp apple cider vinegar\n1 ½ tsp mayonnaise\n½ tsp dill, dried\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 577854,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 577855,
      "primary_message": "While the skillet heats up, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 577856,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beans, salt, and pepper; cook, stirring occasionally, until tender and warmed through, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 577857,
      "primary_message": "Meanwhile, coarsely grate cheese. Place in another medium bowl along with additional yogurt, hot sauce, and spices, then stir to combine.",
      "secondary_message": "¼ (8 oz) block cheddar cheese\n¼ cup plain Greek yogurt\n1 tbsp hot sauce\n½ tsp garlic powder\n¼ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 577858,
      "primary_message": "When the beans are done, transfer to the bowl with the cheese mixture, and stir to combine the Buffalo beans.",
      "secondary_message": null
    },
    {
      "id": 577859,
      "primary_message": "To serve, divide crispy tortillas between plates; top with Buffalo beans, lettuce, and salsa. Drizzle with ranch dressing and enjoy!",
      "secondary_message": null
    }
  ],
