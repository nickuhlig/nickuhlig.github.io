  "instructions": [
    {
      "id": 577904,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 577905,
      "primary_message": "Place broth in a large pot and bring to a boil over high heat.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 577906,
      "primary_message": "Meanwhile, drizzle both sides of the tortillas with oil and sprinkle with salt; arrange on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until tortillas are golden brown and crispy, 10-15 minutes. Remove from oven.",
      "secondary_message": "8 small corn tortillas\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 577907,
      "primary_message": "Once the liquid is boiling, add chicken to the pot and reduce heat to medium-low. Cover and cook until chicken is cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 577908,
      "primary_message": "While the chicken is cooking, wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n1 English cucumber\n1 jalapeño pepper\n1 head butter (Boston) lettuce"
    },
    {
      "id": 577909,
      "primary_message": "Small dice tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 577910,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 577911,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 577912,
      "primary_message": "Peel and mince shallots. Add to the bowl, along with salt and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "2 shallots\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 577913,
      "primary_message": "When the chicken is done, transfer to another medium bowl. Using two forks, shred the chicken into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 577914,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the chicken, along with yogurt, hot sauce, and spices. Stir to combine and set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese\n½ cup plain Greek yogurt\n2 tbsp hot sauce\n1 tsp garlic powder\n½ tsp paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 577915,
      "primary_message": "Place additional yogurt, vinegar, mayo, and spices in a small bowl, then stir to combine the ranch dressing. Add water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n4 tsp apple cider vinegar\n1 tbsp mayonnaise\n1 tsp dill, dried\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 577916,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 577917,
      "primary_message": "To serve, divide crispy tortillas between plates; top with Buffalo chicken, lettuce, and salsa. Drizzle with ranch dressing and enjoy!",
      "secondary_message": null
    }
  ],
