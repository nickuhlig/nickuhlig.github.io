  "instructions": [
    {
      "id": 577831,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 577832,
      "primary_message": "Place broth in a large pot and bring to a boil over high heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 577833,
      "primary_message": "Meanwhile, drizzle both sides of the tortillas with oil and sprinkle with salt; divide between two baking sheet pans. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until tortillas are golden brown and crispy, 10-15 minutes. Remove from oven.",
      "secondary_message": "12 small corn tortillas\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 577834,
      "primary_message": "Once the liquid is boiling, add chicken to the pot and reduce heat to medium-low. Cover and cook until chicken is cooked through, about 15 minutes. Remove from heat.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 577835,
      "primary_message": "While the chicken is cooking, wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n1 ½ English cucumbers\n1 ½ jalapeño peppers\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 577836,
      "primary_message": "Small dice tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 577837,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 577838,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 577839,
      "primary_message": "Peel, halve, and mince onion. Add to the bowl, along with salt and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "½ medium red onion\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 577840,
      "primary_message": "When the chicken is done, transfer to a large bowl. Using two forks, shred the chicken into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 577841,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the chicken, along with yogurt, hot sauce, and spices. Stir to combine and set aside.",
      "secondary_message": "¾ (8 oz) block cheddar cheese\n¾ cup plain Greek yogurt\n3 tbsp hot sauce\n1 ½ tsp garlic powder\n¾ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 577842,
      "primary_message": "Place additional yogurt, vinegar, mayo, and spices in a small bowl, then stir to combine the ranch dressing. Add water, 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n2 tbsp apple cider vinegar\n1 ½ tbsp mayonnaise\n1 ½ tsp dill, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 577843,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 577844,
      "primary_message": "To serve, divide crispy tortillas between plates; top with Buffalo chicken, lettuce, and salsa. Drizzle with ranch dressing and enjoy!",
      "secondary_message": null
    }
  ],
