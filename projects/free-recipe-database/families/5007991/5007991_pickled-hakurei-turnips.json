  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash turnips well and slice them thinly on a mandoline. Place turnip slices in a small bowl and toss with the salt. Let rest until there is a pool of liquid on the bottom of the bowl, about 30 minutes. Drain turnips of the salty water and pack into a pint-sized mason jar.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add vinegar, sugar, pepper, and ginger slices. Apply a watertight lid and shake to combine. Place pickled turnips in the fridge and chill before eating. Pickles can be eaten within 1 hour of being made and will keep for at least 1 week.",
      "secondary_message": null
    }
  ],
