  "instructions": [
    {
      "id": 247829,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large pot. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 247830,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 247831,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the pot, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 247832,
      "primary_message": "While the rice is cooking, place peas in a clean colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "3 cups frozen peas"
    },
    {
      "id": 247833,
      "primary_message": "Wash, dry, and zest lemons into a large bowl (set lemons aside for later use). Add mayo, vinegar, sugar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 ½ lemons\n¾ cup mayonnaise\n3 tbsp white wine vinegar\n1 tbsp brown sugar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 247834,
      "primary_message": "Add broccoli slaw to the bowl with the dressing, stir to combine, and set aside.",
      "secondary_message": "3 (340 g) pkgs broccoli slaw"
    },
    {
      "id": 247835,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 247836,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 247837,
      "primary_message": "Meanwhile, juice reserved lemons into a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 247838,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, capers, and thyme; cook, stirring constantly, until fragrant, 1-2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp capers\n1 ½ tsp thyme, dried"
    },
    {
      "id": 247839,
      "primary_message": "Add shrimp and lemon juice to the pot; cook, stirring occasionally, until the shrimp are cooked through, about 6 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 247840,
      "primary_message": "While the shrimp are cooking, wash and dry the dill. Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the rice, along with the peas, and gently stir to combine the pilaf.",
      "secondary_message": "1 small bunch fresh dill"
    },
    {
      "id": 247841,
      "primary_message": "To serve, divide rice pilaf, broccoli slaw, and shrimp between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
