  "instructions": [
    {
      "id": 247764,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 247765,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 247766,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 247767,
      "primary_message": "While the rice is cooking, place peas in a clean colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 247768,
      "primary_message": "Wash, dry, and zest lemon into a medium bowl (set lemon aside for later use). Add mayo, vinegar, sugar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "½ lemon\n¼ cup mayonnaise\n1 tbsp white wine vinegar\n1 tsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 247769,
      "primary_message": "Add broccoli slaw to the bowl with the dressing, stir to combine, and set aside.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 247770,
      "primary_message": "Juice reserved lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 247771,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 247772,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 247773,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, capers, and thyme; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tbsp capers\n½ tsp thyme, dried"
    },
    {
      "id": 247774,
      "primary_message": "Add shrimp and lemon juice to the skillet; cook, stirring occasionally, until the shrimp are cooked through, about 4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 247775,
      "primary_message": "While the shrimp are cooking, wash and dry the dill. Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the rice, along with the peas, and gently stir to combine the pilaf.",
      "secondary_message": "½ small bunch fresh dill"
    },
    {
      "id": 247776,
      "primary_message": "To serve, divide rice pilaf, broccoli slaw, and shrimp between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
