  "instructions": [
    {
      "id": 598355,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 598356,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "3 crowns broccoli\n2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 598357,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until broccoli is fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 598358,
      "primary_message": "Meanwhile, wash, dry, quarter, and core apples; coarsely grate. Place in a medium bowl, along with veggie ground, bread crumbs, and spices, then mix with your hands until well combined. Form the veggie ground mixture into 6 equal-sized patties and place on a plate.",
      "secondary_message": "3 Gala apples\n24 oz veggie ground, plant based\n¾ cup panko bread crumbs\n1 ½ tsp sage, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 598359,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 598360,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 598361,
      "primary_message": "While the burgers are cooking, mince cranberries. Place in a small bowl, along with mayo and spices, then stir to combine. Set aside.",
      "secondary_message": "⅓ cup dried cranberries\n⅓ cup mayonnaise\n3 pinch garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 598362,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 598363,
      "primary_message": "Spread cranberry mayo over the bottom half of each bun; top with burger patties, then close with the top half of each bun. Serve with roasted broccoli on the side and enjoy!",
      "secondary_message": null
    }
  ],
