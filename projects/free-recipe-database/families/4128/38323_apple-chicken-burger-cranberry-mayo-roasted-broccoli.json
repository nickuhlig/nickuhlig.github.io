  "instructions": [
    {
      "id": 598310,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 598311,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 crown broccoli\n2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 598312,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until broccoli is fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 598313,
      "primary_message": "Meanwhile, wash, dry, quarter, and core apple; coarsely grate. Place in a medium bowl, along with chicken, bread crumbs, and spices, then mix with your hands until well combined. Form the chicken mixture into 2 equal-sized patties and place on a plate.",
      "secondary_message": "1 Gala apple\n½ lb ground chicken\n¼ cup panko bread crumbs\n½ tsp sage, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 598314,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 598315,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 598316,
      "primary_message": "While the burgers are cooking, mince cranberries. Place in a small bowl, along with mayo and spices, then stir to combine. Set aside.",
      "secondary_message": "⅛ cup dried cranberries\n2 tbsp mayonnaise\n1 pinch garlic powder\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 598317,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 598318,
      "primary_message": "Spread cranberry mayo over the bottom half of each bun; top with burger patties, then close with the top half of each bun. Serve with roasted broccoli on the side and enjoy!",
      "secondary_message": null
    }
  ],
