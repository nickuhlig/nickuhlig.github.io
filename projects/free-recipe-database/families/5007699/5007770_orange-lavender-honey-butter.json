  "instructions": [
    {
      "id": 1,
      "primary_message": "Stir all ingredients together in a bowl. Taste and adjust flavors as needed.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer your butter to a 340 g jar and store in the refrigerator. Or lay the butter out on a 2-foot length of parchment paper and form into a rough log. Fold the paper over the butter. With the back of a cookie sheet or cutting board, push the log forward while pulling on the top sheet of parchment, which will press the butter into a log. Roll the log up and twist the ends.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Let your butter sit in the refrigerator overnight so the flavors can meld. It'll keep for weeks, if not longer.",
      "secondary_message": null
    }
  ],
