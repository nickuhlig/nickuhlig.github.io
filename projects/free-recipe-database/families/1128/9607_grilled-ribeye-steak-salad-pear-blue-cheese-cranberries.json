  "instructions": [
    {
      "id": 152609,
      "primary_message": "Preheat a large grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152610,
      "primary_message": "Pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 152611,
      "primary_message": "When the grill pan is hot, coat with oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 152612,
      "primary_message": "Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": null
    },
    {
      "id": 152613,
      "primary_message": "Meanwhile, combine oil, vinegar, salt, and pepper in a large salad bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 152614,
      "primary_message": "Wash, quarter, core, and thinly slice pears; add to the bowl with the dressing.",
      "secondary_message": "3 pears"
    },
    {
      "id": 152615,
      "primary_message": "Wash the spring mix (skip if it came pre-washed), and add to the bowl with the dressing and pears. Toss to combine the salad.",
      "secondary_message": "3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 152616,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 152617,
      "primary_message": "To serve, divide the salad between plates; top with steak, blue cheese, and cranberries. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese\n⅜ cup dried cranberries"
    }
  ],
