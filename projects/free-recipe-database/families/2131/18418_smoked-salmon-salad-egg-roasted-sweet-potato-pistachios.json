  "instructions": [
    {
      "id": 301647,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 301648,
      "primary_message": "Wash, dry, peel, and small dice sweet potatoes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ lb sweet potatoes\n2 tbsp extra virgin olive oil\n¾ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 301649,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until sweet potato is fork-tender, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 301650,
      "primary_message": "Meanwhile, halve eggs and transfer to a platter.",
      "secondary_message": "6 hard-cooked eggs, peeled"
    },
    {
      "id": 301651,
      "primary_message": "Cut or tear salmon into bite-sized pieces and add to the platter with the eggs.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 301652,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the platter.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 301653,
      "primary_message": "Roughly chop pistachios, add to the platter, and set aside.",
      "secondary_message": "1 ½ cups pistachios, unsalted"
    },
    {
      "id": 301654,
      "primary_message": "Wash and dry mixed greens. (Skip this step if they came pre-washed.)",
      "secondary_message": "3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 301655,
      "primary_message": "To serve, divide mixed greens, onion, salmon, roasted sweet potato, pistachios, and eggs between plates. Drizzle with vinaigrette and enjoy!",
      "secondary_message": "½ cup French vinaigrette"
    }
  ],
