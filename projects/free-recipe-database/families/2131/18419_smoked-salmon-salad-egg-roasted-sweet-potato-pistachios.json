  "instructions": [
    {
      "id": 301656,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 301657,
      "primary_message": "Wash, dry, peel, and small dice sweet potato. Transfer to a baking sheet pan, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "0.23 kg sweet potato\n2 tsp extra virgin olive oil\n¼ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 301658,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until sweet potato is fork-tender, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 301659,
      "primary_message": "Meanwhile, halve eggs and transfer to a plate.",
      "secondary_message": "2 hard-cooked eggs, peeled"
    },
    {
      "id": 301660,
      "primary_message": "Cut or tear salmon into bite-sized pieces and add to the plate with the eggs.",
      "secondary_message": "1 (113 g) pkg smoked salmon"
    },
    {
      "id": 301661,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the plate.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 301662,
      "primary_message": "Roughly chop pistachios, add to the plate, and set aside.",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 301663,
      "primary_message": "Wash and dry mixed greens. (Skip this step if they came pre-washed.)",
      "secondary_message": "1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 301664,
      "primary_message": "To serve, divide mixed greens, shallot, salmon, roasted sweet potato, pistachios, and eggs between plates. Drizzle with vinaigrette and enjoy!",
      "secondary_message": "3 tbsp French vinaigrette"
    }
  ],
