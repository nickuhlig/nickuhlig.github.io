  "instructions": [
    {
      "id": 302657,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (227 g) pkg sugar snap peas\n2 (2 ½ cm) pieces ginger root\n2 red chili peppers\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 lime\n1 avocado\n1 head butter (Boston) lettuce"
    },
    {
      "id": 302658,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 302659,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 302660,
      "primary_message": "While the skillet heats up, peel and mince ginger and garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 302661,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add ginger and garlic. Cook until fragrant, about 30 seconds.",
      "secondary_message": "¼ cup toasted sesame oil"
    },
    {
      "id": 302662,
      "primary_message": "Add veggie ground to the skillet; cook, breaking it apart with a spoon, until crumbly and cooked through, about 5 minutes.",
      "secondary_message": "454 g veggie ground, plant based"
    },
    {
      "id": 302663,
      "primary_message": "While the veggie ground is cooking, quarter chili peppers lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 302664,
      "primary_message": "When the veggie ground is done, add snap peas, chili pepper, soy sauce, and chili-garlic sauce; continue to cook, stirring occasionally, until fork-tender, 3 minutes more. ",
      "secondary_message": "3 tbsp soy sauce\n4 tsp chili-garlic sauce"
    },
    {
      "id": 302665,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 302666,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 302667,
      "primary_message": "When the snap peas are tender, juice lime into the skillet, then add green onion and cilantro; stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 302668,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 302669,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with veggie ground mixture and avocado. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
