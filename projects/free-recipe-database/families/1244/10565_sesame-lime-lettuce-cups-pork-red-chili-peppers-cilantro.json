  "instructions": [
    {
      "id": 302292,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 red chili peppers\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 lime\n1 head butter (Boston) lettuce"
    },
    {
      "id": 302293,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 302294,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 302295,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "¼ cup toasted sesame oil"
    },
    {
      "id": 302296,
      "primary_message": "Add garlic and ginger; cook until fragrant, 15-30 seconds.",
      "secondary_message": null
    },
    {
      "id": 302297,
      "primary_message": "Add pork to the skillet and, breaking apart with a spoon, cook until browned and slightly crispy, 7-8 minutes.",
      "secondary_message": "1 ½ lb lean ground pork"
    },
    {
      "id": 302298,
      "primary_message": "Meanwhile, slice chili peppers into thin rings, discarding the stems, membranes, and seeds. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 302299,
      "primary_message": "When the pork is almost done, add chili peppers, soy sauce, and chili-garlic sauce. Stir until well combined then remove from heat. ",
      "secondary_message": "3 tbsp soy sauce\n4 tsp chili-garlic sauce"
    },
    {
      "id": 302300,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and add to the skillet.",
      "secondary_message": null
    },
    {
      "id": 302301,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the skillet.",
      "secondary_message": null
    },
    {
      "id": 302302,
      "primary_message": "Juice lime into the skillet and stir to combine the ingredients.",
      "secondary_message": null
    },
    {
      "id": 302303,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per cup, onto plates, top with pork mixture, and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
