  "instructions": [
    {
      "id": 302690,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (227 g) pkg sugar snap peas\n3 (2 ½ cm) pieces ginger root\n3 red chili peppers\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 ½ limes\n1 ½ avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 302691,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 302692,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 302693,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 302694,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add ginger and garlic. Cook until fragrant, about 30 seconds.",
      "secondary_message": "⅓ cup toasted sesame oil"
    },
    {
      "id": 302695,
      "primary_message": "Add veggie ground to the pot; cook, breaking it apart with a spoon, until crumbly and cooked through, 5-6 minutes.",
      "secondary_message": "680 g veggie ground, plant based"
    },
    {
      "id": 302696,
      "primary_message": "While the veggie ground is cooking, quarter chili peppers lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 302697,
      "primary_message": "When the veggie ground is done, add snap peas, chili pepper, soy sauce, and chili-garlic sauce; continue to cook, stirring occasionally, until fork-tender, 4-5 minutes more. ",
      "secondary_message": "¼ cup soy sauce\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 302698,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 302699,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 302700,
      "primary_message": "When the snap peas are tender, juice limes into the pot, then add green onion and cilantro; stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 302701,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 302702,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with veggie ground mixture and avocado. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
