  "instructions": [
    {
      "id": 302267,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 red chili peppers\n3 (8 oz) pkg sugar snap peas\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n2 limes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 302268,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 302269,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 302270,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup toasted sesame oil"
    },
    {
      "id": 302271,
      "primary_message": "Add garlic and ginger; cook until fragrant, 15-30 seconds.",
      "secondary_message": null
    },
    {
      "id": 302272,
      "primary_message": "Add pork to the skillet and, breaking apart with a spoon, cook until browned and slightly crispy, 8-9 minutes.",
      "secondary_message": "2 ¼ lb lean ground pork"
    },
    {
      "id": 302273,
      "primary_message": "Meanwhile, slice chili peppers into thin rings, discarding the stems, membranes, and seeds. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 302274,
      "primary_message": "When the pork is almost done, add chili peppers, soy sauce, and chili-garlic sauce. Stir until well combined. ",
      "secondary_message": "¼ cup soy sauce\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 302275,
      "primary_message": "Cut the sugar snap peas crosswise into ¼-inch pieces at an angle and transfer to the skillet. Continue cooking, stirring occasionally, until snap peas are crisp-tender, 5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 302276,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and add to the skillet.",
      "secondary_message": null
    },
    {
      "id": 302277,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the skillet.",
      "secondary_message": null
    },
    {
      "id": 302278,
      "primary_message": "Juice one and a half limes into the skillet and stir to combine the ingredients. Cut the remaining half lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 302279,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per cup, onto plates, top with pork mixture, and sprinkle with sesame seeds. Serve with lime wedges and enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
