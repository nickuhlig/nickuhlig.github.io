  "instructions": [
    {
      "id": 302509,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 red chili pepper\n1 (227 g) pkg sugar snap peas\n½ small bunch green onions (scallions)\n½ small bunch cilantro\n½ lime\n½ head butter (Boston) lettuce"
    },
    {
      "id": 302510,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 302511,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 302512,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 302513,
      "primary_message": "Add garlic and ginger; cook until fragrant, 15-30 seconds.",
      "secondary_message": null
    },
    {
      "id": 302514,
      "primary_message": "Add pork to the skillet and, breaking apart with a spoon, cook until browned and slightly crispy, 6-7 minutes.",
      "secondary_message": "⅓ kg lean ground pork"
    },
    {
      "id": 302515,
      "primary_message": "Meanwhile, slice chili pepper into thin rings, discarding the stems, membranes, and seeds. (Be careful, with chili pepper, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 302516,
      "primary_message": "When the pork is almost done, add chili pepper, soy sauce, and chili-garlic sauce. Stir until well combined. ",
      "secondary_message": "1 ½ tbsp soy sauce\n2 tsp chili-garlic sauce"
    },
    {
      "id": 302517,
      "primary_message": "Cut the sugar snap peas crosswise into ¼-inch pieces at an angle and transfer to the skillet. Continue cooking, stirring occasionally, until snap peas are crisp-tender, 3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 302518,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and add to the skillet.",
      "secondary_message": null
    },
    {
      "id": 302519,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the skillet.",
      "secondary_message": null
    },
    {
      "id": 302520,
      "primary_message": "Juice lime into the skillet and stir to combine the ingredients.",
      "secondary_message": null
    },
    {
      "id": 302521,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per cup, onto plates, top with pork mixture, and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
