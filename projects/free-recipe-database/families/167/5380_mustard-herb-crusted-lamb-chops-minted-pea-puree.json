  "instructions": [
    {
      "id": 64665,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Add peas and cook until bright green, 2-3 minutes. Drain in a colander and return to pot.",
      "secondary_message": "6 cups frozen peas"
    },
    {
      "id": 64664,
      "primary_message": "Peel and mince garlic. In a shallow bowl, mix together ⅓ of the garlic (save the rest for the pea purée) with Dijon.",
      "secondary_message": "9 cloves garlic\n6 tbsp Dijon mustard"
    },
    {
      "id": 64663,
      "primary_message": "Wash mint. Pick leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small pkg fresh mint"
    },
    {
      "id": 64662,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 64661,
      "primary_message": "In a different shallow bowl, mix together ½ of the mint (save the rest for the pea purée), bread crumbs, rosemary, salt, and pepper.",
      "secondary_message": "¾ cup panko bread crumbs\n1 ½ tsp rosemary\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 64657,
      "primary_message": "Coat lamb chops with garlic and Dijon mixture on both sides, then place in breadcrumb mixture and coat.",
      "secondary_message": "18 lamb rib chops"
    },
    {
      "id": 64660,
      "primary_message": "Coat bottom of skillet with oil. Add lamb and cook until golden brown and cooked through, 2-3 minutes per side.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 64659,
      "primary_message": "Add remaining garlic and mint, olive oil, salt, and pepper to saucepan with peas; mash until smooth.",
      "secondary_message": "3 tbsp extra virgin olive oil\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 64658,
      "primary_message": "Serve by placing pea purée on a plate and sprinkle with feta. Add lamb on top and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    }
  ],
