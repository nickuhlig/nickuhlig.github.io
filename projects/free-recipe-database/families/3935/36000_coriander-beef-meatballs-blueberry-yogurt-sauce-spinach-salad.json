  "instructions": [
    {
      "id": 565775,
      "primary_message": "Preheat oven to 220°C (425°F). Coat two large baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 565776,
      "primary_message": "Place beef, bread crumbs, eggs, and spices in a large bowl. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the mixture into meatballs and divide between the baking sheets.",
      "secondary_message": "1.02 kg lean ground beef\n¾ cup panko bread crumbs\n3 eggs\n1 ½ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 565777,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 565778,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 (170 g) pkgs blueberries\n1 ½ English cucumbers\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 565779,
      "primary_message": "Zest and juice lemons into a medium saucepan. ",
      "secondary_message": null
    },
    {
      "id": 565780,
      "primary_message": "Add blueberries and sugar to the pan with the lemon, then stir to combine the sauce. Set over medium heat and cook, stirring often, until blueberries burst and sauce is thickened, 8-10 minutes. Remove from heat and let cool, 5 minutes.",
      "secondary_message": "2 tbsp brown sugar"
    },
    {
      "id": 565781,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, salt, and pepper in a clean large bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 tbsp brown sugar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 565782,
      "primary_message": "Trim and quarter cucumbers, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing, along with spinach, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 565783,
      "primary_message": "When the blueberry sauce has cooled, add yogurt to the pan and stir to combine.",
      "secondary_message": "1 ½ cups plain Greek yogurt"
    },
    {
      "id": 565784,
      "primary_message": "To serve, divide salad and blueberry yogurt sauce between plates. Top sauce with meatballs and enjoy!",
      "secondary_message": null
    }
  ],
