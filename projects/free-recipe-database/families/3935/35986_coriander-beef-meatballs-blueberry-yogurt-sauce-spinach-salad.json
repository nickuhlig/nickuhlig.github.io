  "instructions": [
    {
      "id": 565635,
      "primary_message": "Preheat oven to 425°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 565636,
      "primary_message": "Place beef, bread crumbs, egg, and spices in a medium bowl. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the mixture into meatballs and transfer to the baking sheet.",
      "secondary_message": "¾ lb lean ground beef\n¼ cup panko bread crumbs\n1 egg\n½ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 565637,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 565638,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 (6 oz) pkg blueberries\n½ English cucumber\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 565639,
      "primary_message": "Zest and juice lemon into a small saucepan. ",
      "secondary_message": null
    },
    {
      "id": 565640,
      "primary_message": "Add blueberries and sugar to the pan with the lemon, then stir to combine the sauce. Set over medium heat and cook, stirring often, until blueberries burst and sauce is thickened, 6-8 minutes. Remove from heat and let cool, 5 minutes.",
      "secondary_message": "2 tsp brown sugar"
    },
    {
      "id": 565641,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, salt, and pepper in a clean medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 tsp brown sugar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 565642,
      "primary_message": "Trim and quarter cucumber, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing, along with spinach, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 565643,
      "primary_message": "When the blueberry sauce has cooled, add yogurt to the pan and stir to combine.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 565644,
      "primary_message": "To serve, divide salad and blueberry yogurt sauce between plates. Top sauce with meatballs and enjoy!",
      "secondary_message": null
    }
  ],
