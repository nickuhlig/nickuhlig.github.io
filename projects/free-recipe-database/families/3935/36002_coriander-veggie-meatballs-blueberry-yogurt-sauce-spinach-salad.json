  "instructions": [
    {
      "id": 565795,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 565796,
      "primary_message": "Place veggie ground, bread crumbs, eggs, sesame seeds, and spices in a medium bowl. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the mixture into \"meatballs\" and transfer to the baking sheet.",
      "secondary_message": "454 g veggie ground, plant based\n½ cup panko bread crumbs\n2 eggs\n¼ cup sesame seeds\n1 tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 565797,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 565798,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 (170 g) pkgs blueberries\n1 English cucumber\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 565799,
      "primary_message": "Zest and juice lemon into a medium saucepan. ",
      "secondary_message": null
    },
    {
      "id": 565800,
      "primary_message": "Add blueberries and sugar to the pan with the lemon, then stir to combine the sauce. Set over medium heat and cook, stirring often, until blueberries burst and sauce is thickened, 6-8 minutes. Remove from heat and let cool, 5 minutes.",
      "secondary_message": "4 tsp brown sugar"
    },
    {
      "id": 565801,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, salt, and pepper in a clean medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n2 tsp brown sugar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 565802,
      "primary_message": "Trim and quarter cucumber, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing, along with spinach, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 565803,
      "primary_message": "When the blueberry sauce has cooled, add yogurt to the pan and stir to combine.",
      "secondary_message": "1 cup plain Greek yogurt"
    },
    {
      "id": 565804,
      "primary_message": "To serve, divide salad and blueberry yogurt sauce between plates. Top sauce with meatballs and enjoy!",
      "secondary_message": null
    }
  ],
