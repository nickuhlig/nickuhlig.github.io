  "instructions": [
    {
      "id": 50851,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n472 ml (2 cups) chicken or vegetable broth"
    },
    {
      "id": 50852,
      "primary_message": "Peel and mince garlic. Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "2 cloves garlic\n1 small bunch cilantro"
    },
    {
      "id": 50853,
      "primary_message": "In a medium bowl, prepare dressing by whisking together garlic, cilantro, oil, lime juice, maple syrup, salt, and pepper. Set aside.",
      "secondary_message": "6 tbsp extra virgin olive oil\n2 limes\n½ tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 50854,
      "primary_message": "Wash and dry spinach; transfer to a large bowl.",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 50855,
      "primary_message": "Wash, halve, and add tomatoes to bowl. Halve and pit avocados; scoop out, medium dice, and add to bowl.",
      "secondary_message": "1 small pkg grape tomatoes\r\n2 avocados"
    },
    {
      "id": 50856,
      "primary_message": "Uncover quinoa and fluff with a fork. Add to bowl and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 50857,
      "primary_message": "To serve, place salad on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
