  "instructions": [
    {
      "id": 9990,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 9991,
      "primary_message": "Peel and mince garlic. Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 clove garlic\r\n½ small bunch cilantro"
    },
    {
      "id": 9992,
      "primary_message": "In a small bowl, prepare dressing by whisking together garlic, cilantro, oil, lime juice, honey, salt, and pepper. Set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\r\n1 lime\r\n¼ tsp honey\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 9993,
      "primary_message": "Wash and dry spinach; transfer to a large bowl.",
      "secondary_message": "½ (5 oz) pkg baby spinach"
    },
    {
      "id": 9994,
      "primary_message": "Wash, halve, and add tomatoes to bowl. Halve and pit avocado; scoop out, medium dice, and add to bowl.",
      "secondary_message": "½ pint grape tomatoes\r\n1 avocado"
    },
    {
      "id": 9995,
      "primary_message": "Uncover quinoa and fluff with a fork. Add to bowl and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 9996,
      "primary_message": "To serve, place salad on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
