  "instructions": [
    {
      "id": 22036,
      "primary_message": "In a large salad bowl, prepare dressing by whisking together lemon juice, olive oil, vinegar, maple syrup, salt, and pepper.",
      "secondary_message": "juice of ½ lemon\r\n4 tbsp extra virgin olive oil\r\n2 tbsp balsamic vinegar\r\n½ tsp pure maple syrup\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 22037,
      "primary_message": "Wash brussels sprouts and trim rough ends. Shred by slicing thinly or using a mandoline slicer; transfer to salad bowl and toss with dressing.",
      "secondary_message": "1 lb brussels sprouts\r\n"
    },
    {
      "id": 22038,
      "primary_message": "Wash grapes and apple. Halve and add grapes to salad bowl. Core, medium dice, and add apple to salad bowl.",
      "secondary_message": "½ lb red grapes\n1 Gala apple"
    },
    {
      "id": 22039,
      "primary_message": "Roughly chop walnuts; add to salad bowl. Grate ¼ cup of Parmesan; add to salad bowl.",
      "secondary_message": "½ cup walnuts\r\n1 oz Parmesan cheese"
    },
    {
      "id": 22040,
      "primary_message": "Toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 22041,
      "primary_message": "Serve salad on a plate and enjoy!",
      "secondary_message": ""
    }
  ],
