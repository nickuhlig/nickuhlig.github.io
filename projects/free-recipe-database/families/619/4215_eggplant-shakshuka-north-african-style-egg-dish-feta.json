  "instructions": [
    {
      "id": 47644,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n1 small bunch cilantro"
    },
    {
      "id": 47645,
      "primary_message": "Trim off and discard the ends of the eggplants; large dice the eggplants into ¾-inch cubes. Transfer to a bowl.",
      "secondary_message": ""
    },
    {
      "id": 47646,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 47647,
      "primary_message": "While the pan heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 47648,
      "primary_message": "Once the pan is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 47649,
      "primary_message": "Add the onion to the pan; cook, stirring frequently, until slightly softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 47650,
      "primary_message": "While the onion cooks, trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 47651,
      "primary_message": "Add the minced garlic, paprika, cumin, and cayenne pepper to the pan; cook, stirring, until fragrant, 15 to 30 seconds.",
      "secondary_message": "2 tsp paprika\n1 tsp cumin\n⅛ tsp cayenne pepper"
    },
    {
      "id": 47652,
      "primary_message": "Add the eggplant to the pan and season with salt and pepper; cook, stirring occasionally, until softened, 6 to 8 minutes.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 47653,
      "primary_message": "Add the tomatoes to the pan and stir to combine; simmer for 5 to 6 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 47654,
      "primary_message": "While the tomatoes simmer, using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 47655,
      "primary_message": "Stir about ¾ of the cilantro into the tomato mixture (save the rest for garnishing); stir to combine.",
      "secondary_message": null
    },
    {
      "id": 47656,
      "primary_message": "Break the eggs into the saucepan.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 47657,
      "primary_message": "Season the eggs with salt and pepper.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 47658,
      "primary_message": "Reduce the heat to low and cover the pan; cook until the egg whites are set and the yolks are still runny, 5 to 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 47659,
      "primary_message": "Place the feta in a small bowl.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 47660,
      "primary_message": "Uncover the pan and garnish the shakshuka with feta and the remaining cilantro.",
      "secondary_message": null
    },
    {
      "id": 47661,
      "primary_message": "To serve, divide the shakshuka between plates. Enjoy!",
      "secondary_message": null
    }
  ],
