  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun! ",
      "secondary_message": null
    },
    {
      "primary_message": "Place the oats into a high-speed blender, then roughly chop the dried apples and dried apricots, then add to the blender. ",
      "secondary_message": null
    },
    {
      "primary_message": "Blend together until finely chopped, then add the raisins, maple syrup, allspice, and vanilla extract.",
      "secondary_message": null
    },
    {
      "primary_message": "Continue to blend together until finely chopped and well combined. You might need to scrape the sides down a few times before the mixture comes together.",
      "secondary_message": null
    },
    {
      "primary_message": "Scoop portions of the mixture out with a clean spoon and roll into small balls with your hands. Lightly press two candy eyeballs into each.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Place sprinkles on a clean plate and roll each ball in the sprinkles or desiccated coconut to coat. Transfer to a baking sheet pan or plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Pop into the fridge for 15 minutes to set, then enjoy! Store in an airtight container in the fridge.",
      "secondary_message": null
    }
  ],
