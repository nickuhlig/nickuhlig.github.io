  "ingredients": [
    {
      "ingredient_id": 116,
      "name": "all-purpose flour",
      "quantity": "2 cups"
    },
    {
      "ingredient_id": 88,
      "name": "salt",
      "quantity": "1 tsp"
    },
    {
      "ingredient_id": 346,
      "name": "sugar",
      "quantity": "1 tsp"
    },
    {
      "ingredient_id": 331,
      "name": "baking powder",
      "quantity": "1 tbsp"
    },
    {
      "ingredient_id": 1760,
      "name": "chopped mixed fresh herbs, such as rosemary and thyme",
      "quantity": "1 tbsp"
    },
    {
      "ingredient_id": 115,
      "name": "unsalted butter, cold, cut into 1/4 inch pieces",
      "quantity": "7 tbsp"
    },
    {
      "ingredient_id": 118,
      "name": "milk",
      "quantity": "¾ cup"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 220°C (425°F). Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, combine flour, salt, sugar, baking powder, and herbs. Whisk until mixed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add butter to flour and using either your fingers or a pastry cutter, cut butter into dough until it is the size of peas.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add milk to bowl and stir just until a dough forms.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer dough to a lightly floured surface. Roll dough out to 2 cm thick. Use 8 cm biscuit cutter to cut out biscuits. Transfer biscuits to prepared baking sheet.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Bake until golden, about 17 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
