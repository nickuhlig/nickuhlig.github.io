  "instructions": [
    {
      "id": 426156,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 426157,
      "primary_message": "Place maple syrup, oil, salt, and pepper in a large bowl; stir to combine the sauce.",
      "secondary_message": "2 tbsp pure maple syrup\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426158,
      "primary_message": "Wash, dry, and halve acorn squash lengthwise; trim ends, scrape out the seeds, and cut crosswise into ½-inch thick half-moons. Add to the bowl with the sauce along with the cauliflower; stir to coat.",
      "secondary_message": "1 acorn squash\n2 (10 oz) bags cauliflower florets"
    },
    {
      "id": 426159,
      "primary_message": "Transfer veggies to the baking sheet and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until veggies are fork-tender, about 20 minutes. Remove from oven. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 426160,
      "primary_message": "Meanwhile, place veggie ground, cheese, bread crumbs, and spices in the reserved bowl; mix with your hands until the \"meatloaf\" mixture is well combined. ",
      "secondary_message": "16 oz veggie ground, plant based\n½ cup Parmesan cheese, shredded\n½ cup panko bread crumbs\n2 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426161,
      "primary_message": "Coat 12 muffin cups with additional oil and divide meatloaf mixture between them. Add to the oven and bake until almost cooked through, about 10 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 426162,
      "primary_message": "When the meatloaves are almost cooked through, remove from the oven, and top with barbecue sauce. Return to the oven and continue to bake until cooked through, 4-5 minutes more. Remove from oven.",
      "secondary_message": "½ cup barbecue sauce"
    },
    {
      "id": 426163,
      "primary_message": "To serve, divide meatloaves and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
