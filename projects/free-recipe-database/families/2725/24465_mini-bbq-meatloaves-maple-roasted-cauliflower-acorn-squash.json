  "instructions": [
    {
      "id": 426188,
      "primary_message": "Preheat oven to 230°C (450°F). Place racks in the upper, middle, and lower positions. Line two baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 426189,
      "primary_message": "Place beef, eggs, bread crumbs, and spices in a large bowl; mix with your hands until the meatloaf mixture is well combined. ",
      "secondary_message": "1.02 kg lean ground beef\n3 eggs\n¾ cup panko bread crumbs\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 426190,
      "primary_message": "Divide meatloaf mixture between 18 muffin cups. Place in the oven (it doesn't have to be fully heated) and bake until almost cooked through, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 426191,
      "primary_message": "Meanwhile, place maple syrup, oil, salt, and pepper in a clean large bowl; stir to combine the sauce.",
      "secondary_message": "3 tbsp pure maple syrup\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 426192,
      "primary_message": "Wash, dry, and halve each acorn squash lengthwise; trim ends, scrape out the seeds, and cut crosswise into ½-inch thick half-moons. Add to the bowl with the sauce along with the cauliflower; stir to coat.",
      "secondary_message": "1 ½ acorn squash\n3 (283 g) bags cauliflower florets"
    },
    {
      "id": 426193,
      "primary_message": "Divide veggies between the baking sheets and spread out in an even layer. Add to the oven and bake, stirring halfway through, until veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 426194,
      "primary_message": "When the meatloaves are almost cooked through, remove from the oven, and top with barbecue sauce. Return to the oven and continue to bake until cooked through, 4-5 minutes more. Remove from oven.",
      "secondary_message": "¾ cup barbecue sauce"
    },
    {
      "id": 426195,
      "primary_message": "To serve, divide meatloaves and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
