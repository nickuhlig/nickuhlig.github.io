  "instructions": [
    {
      "id": 509925,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 509926,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 509927,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl with the onion.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 509928,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until golden and caramelized, 18-20 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 509929,
      "primary_message": "Meanwhile, wash, dry, and slide thyme leaves off the stems; discard the stems. Place leaves in a large pot.",
      "secondary_message": "1 small pkg fresh thyme"
    },
    {
      "id": 509930,
      "primary_message": "Add orzo, broth, Worcestershire, salt, and pepper to the pot with the thyme. Stir to combine and bring to a simmer over high heat. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes. Remove from heat.",
      "secondary_message": "15 oz orzo pasta\n48 fl oz (6 cups) chicken or vegetable broth\n2 tbsp Worcestershire sauce\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 509931,
      "primary_message": "While the orzo is cooking, finely grate mozzarella. Place in the reserved bowl and set aside.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 509932,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed.)",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 509933,
      "primary_message": "When the onions are caramelized, carefully transfer them to the pot with the orzo. Stir to combine. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 509934,
      "primary_message": "Add spinach to the pot with the orzo in handfuls, waiting for it to wilt slightly before adding the next handful. Return to medium-high heat and continue to cook until spinach is completely wilted, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 509935,
      "primary_message": "Once the spinach is wilted, remove from heat, sprinkle with grated cheese, and cover with a lid. Set aside until cheese is melted, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 509936,
      "primary_message": "Meanwhile, return skillet used for the onions to medium-high heat. Add more butter and swirl to coat the bottom. Working in batches if necessary, add bread slices and pan-fry until toasted on one side, about 1 minute. ",
      "secondary_message": "2 tbsp butter, unsalted\n6 slices sourdough bread"
    },
    {
      "id": 509937,
      "primary_message": "Remove bread to a plate and add more butter to the skillet. Return bread to the skillet, toasted-side up, and continue to pan-fry until toasted on the other side, 1 minute more. Return to the plate.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 509938,
      "primary_message": "Divide orzo between plates or bowls. Serve with toasted sourdough on the side and enjoy!",
      "secondary_message": null
    }
  ],
