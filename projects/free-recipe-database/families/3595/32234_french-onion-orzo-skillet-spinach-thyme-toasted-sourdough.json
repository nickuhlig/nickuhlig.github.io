  "instructions": [
    {
      "id": 509995,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 509996,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 509997,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl with the onion.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 509998,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until golden and caramelized, 15-18 minutes. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 509999,
      "primary_message": "Meanwhile, wash, dry, and slide thyme leaves off the stems; discard the stems. Place leaves in another large skillet.",
      "secondary_message": "1 small pkg fresh thyme"
    },
    {
      "id": 510000,
      "primary_message": "Add orzo, broth, Worcestershire, salt, and pepper to the skillet with the thyme. Stir to combine and bring to a simmer over high heat. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes. Remove from heat.",
      "secondary_message": "283 g orzo pasta\n946 ml chicken or vegetable broth\n4 tsp Worcestershire sauce\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 510001,
      "primary_message": "While the orzo is cooking, finely grate mozzarella. Place in the reserved bowl and set aside.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 510002,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed.)",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 510003,
      "primary_message": "When the onions are caramelized, carefully transfer them to the skillet with the orzo. Stir to combine. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 510004,
      "primary_message": "Add spinach to the skillet with the orzo in handfuls, waiting for it to wilt slightly before adding the next handful. Return to medium-high heat and continue to cook until spinach is completely wilted, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 510005,
      "primary_message": "Once the spinach is wilted, remove from heat, sprinkle with grated cheese, and cover with a lid. Set aside until cheese is melted, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 510006,
      "primary_message": "Meanwhile, return skillet used for the onions to medium-high heat. Add more butter and swirl to coat the bottom. Add bread slices and pan-fry until toasted on one side, about 1 minute. ",
      "secondary_message": "4 tsp butter, unsalted\n4 slices sourdough bread"
    },
    {
      "id": 510007,
      "primary_message": "Remove bread to a plate and add more butter to the skillet. Return bread to the skillet, toasted-side up, and continue to pan-fry until toasted on the other side, 1 minute more. Return to the plate.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 510008,
      "primary_message": "Divide orzo between plates or bowls. Serve with toasted sourdough on the side and enjoy!",
      "secondary_message": null
    }
  ],
