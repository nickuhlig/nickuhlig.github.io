  "instructions": [
    {
      "id": 345783,
      "primary_message": "Preheat oven to 230°C (450°F), position a rack in the center position and another in the bottom position. Line two baking sheet pans with aluminum foil (optional). ",
      "secondary_message": null
    },
    {
      "id": 345784,
      "primary_message": "Peel and mince garlic and ginger; transfer to a large bowl. ",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n2 cloves garlic"
    },
    {
      "id": 345785,
      "primary_message": "Add soy sauce, oil, chili-garlic sauce, and sugar to the bowl and whisk to combine the marinade. Add the chicken and toss to coat. ",
      "secondary_message": "2 tbsp soy sauce\n2 tsp toasted sesame oil\n2 tsp chili-garlic sauce\n1 tsp brown sugar\n0.57 kg chicken drumsticks"
    },
    {
      "id": 345786,
      "primary_message": "Spread chicken out in a single layer on a prepared sheet pan. Place on the bottom rack of the oven and roast until the chicken is cooked through, 30-35 minutes. Reserve marinade.",
      "secondary_message": null
    },
    {
      "id": 345787,
      "primary_message": "Wash broccoli and cut into small, bite-sized florets. Thinly slice the thicker stem. Transfer to a medium bowl.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 345788,
      "primary_message": "Toss broccoli with soy sauce and oil. Spread out in a single layer on the other baking sheet and place in the oven for 5-8 minutes while you prepare the nuts. ",
      "secondary_message": "1 tsp toasted sesame oil\n1 tsp soy sauce"
    },
    {
      "id": 345789,
      "primary_message": "Remove chicken from the oven. Use tongs to flip each drumstick. Spoon on remaining marinade, and return to the oven. ",
      "secondary_message": null
    },
    {
      "id": 345790,
      "primary_message": "Roughly chop walnuts. In a small bowl, toss walnuts with water to moisten. ",
      "secondary_message": "⅓ cup walnuts\n1 ½ tsp water"
    },
    {
      "id": 345791,
      "primary_message": "In another small bowl, stir together sugar, cinnamon, and cayenne pepper. Toss moistened walnuts in the spice mixture.",
      "secondary_message": "1 tsp brown sugar\n⅛ tsp cinnamon, ground\n1 pinch cayenne pepper"
    },
    {
      "id": 345792,
      "primary_message": "Remove the broccoli pan from the oven and sprinkle the walnuts on top. Return the pan to the oven for an additional 5-8 minutes or until broccoli is tender-crisp, and walnuts are toasted. ",
      "secondary_message": null
    },
    {
      "id": 345793,
      "primary_message": "To serve, arrange chicken, broccoli, and walnuts on a plate. Enjoy! ",
      "secondary_message": null
    }
  ],
