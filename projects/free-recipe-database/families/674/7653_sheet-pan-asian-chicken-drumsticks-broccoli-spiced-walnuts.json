  "instructions": [
    {
      "id": 345739,
      "primary_message": "Preheat oven to 450°F, position a rack in the center position and another in the bottom position. Line two large baking sheet pans with aluminum foil (optional). ",
      "secondary_message": null
    },
    {
      "id": 345740,
      "primary_message": "Peel and mince garlic and ginger; transfer to a large bowl. ",
      "secondary_message": "3 (1 inch) pieces ginger root\n6 cloves garlic"
    },
    {
      "id": 345741,
      "primary_message": "Add soy sauce, oil, chili-garlic sauce, and sugar to the bowl and whisk to combine the marinade. Add the chicken and toss to coat. ",
      "secondary_message": "⅓ cup soy sauce\n2 tbsp toasted sesame oil\n2 tbsp chili-garlic sauce\n1 tbsp brown sugar\n3 ¾ lb chicken drumsticks"
    },
    {
      "id": 345742,
      "primary_message": "Spread chicken out in a single layer on a prepared sheet pan. Place on the bottom rack of the oven and roast until the chicken is cooked through, about 35 minutes. Reserve marinade.",
      "secondary_message": null
    },
    {
      "id": 345743,
      "primary_message": "Wash broccoli and cut into small, bite-sized florets. Thinly slice the thicker stem. Transfer to a large bowl.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 345744,
      "primary_message": "Toss broccoli with soy sauce and oil. Spread out in a single layer on the other baking sheet and place in the oven for 5-8 minutes while you prepare the nuts. ",
      "secondary_message": "1 tbsp toasted sesame oil\n1 tbsp soy sauce"
    },
    {
      "id": 345745,
      "primary_message": "Remove chicken from the oven. Use tongs to flip each drumstick. Spoon on remaining marinade, and return to the oven. ",
      "secondary_message": null
    },
    {
      "id": 345746,
      "primary_message": "Roughly chop walnuts. In a small bowl, toss walnuts with water to moisten. ",
      "secondary_message": "1 cup walnuts\n1 ½ tbsp water"
    },
    {
      "id": 345747,
      "primary_message": "In another small bowl, stir together sugar, cinnamon, and cayenne pepper. Toss moistened walnuts in the spice mixture.",
      "secondary_message": "1 tbsp brown sugar\n½ tsp cinnamon, ground\n3 pinch cayenne pepper"
    },
    {
      "id": 345748,
      "primary_message": "Remove the broccoli pan from the oven and sprinkle the walnuts on top. Return the pan to the oven for an additional 5-8 minutes or until broccoli is tender-crisp, and walnuts are toasted.",
      "secondary_message": null
    },
    {
      "id": 345749,
      "primary_message": "To serve, place chicken, broccoli, and walnuts on a plate. Enjoy! ",
      "secondary_message": null
    }
  ],
