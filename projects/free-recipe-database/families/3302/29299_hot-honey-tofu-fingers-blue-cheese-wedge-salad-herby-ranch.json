  "instructions": [
    {
      "id": 467039,
      "primary_message": "Preheat oven to 375°F. ",
      "secondary_message": null
    },
    {
      "id": 467040,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 467041,
      "primary_message": "Place bread crumbs and spices in a small bowl. Stir to combine the coating.",
      "secondary_message": "½ cup panko bread crumbs\n¼ tsp paprika\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 467042,
      "primary_message": "Place mayo, soy sauce, and salt in a medium bowl; stir to combine.",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp soy sauce\n¼ tsp salt"
    },
    {
      "id": 467043,
      "primary_message": "Cut tofu crosswise into 1-inch wide fingers. Add to the bowl with the mayo mixture and gently toss to coat. (Wipe baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 467044,
      "primary_message": "Add bread crumb coating to the bowl with the tofu and gently toss once more to coat. Transfer tofu to the baking sheet and arrange in a single layer; drizzle with oil. (Reserve small bowl for later use.) ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 467045,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake until golden and warmed through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 467046,
      "primary_message": "Meanwhile, place honey, hot sauce, and salt in the reserved bowl. Whisk to combine the hot honey and set aside.",
      "secondary_message": "2 tbsp honey\n1 tbsp hot sauce\n1 pinch salt"
    },
    {
      "id": 467047,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch fresh dill\n½ small pkg chives\n½ head romaine lettuce\n½ pint grape tomatoes"
    },
    {
      "id": 467048,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 467049,
      "primary_message": "Shave dill leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 467050,
      "primary_message": "Roughly chop chives. Add half to the blender along with yogurt, mayo, and spices. Blend on high until herby ranch dressing is smooth; set aside. (Reserve remaining chives for serving.)",
      "secondary_message": "¼ cup plain Greek yogurt\n1 ½ tbsp mayonnaise\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 467051,
      "primary_message": "Trim and cut romaine in half lengthwise, to make 2 wedges.",
      "secondary_message": null
    },
    {
      "id": 467052,
      "primary_message": "Halve grape tomatoes lengthwise. Season with salt.",
      "secondary_message": "1 pinch salt"
    },
    {
      "id": 467053,
      "primary_message": "Divide tofu fingers and romaine wedges between plates. Top wedges with dressing, tomatoes, blue cheese, and remaining chives. Serve with hot honey for dipping tofu. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled blue cheese"
    }
  ],
