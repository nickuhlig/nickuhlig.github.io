  "instructions": [
    {
      "id": 467257,
      "primary_message": "Preheat oven to 190°C (375°F). ",
      "secondary_message": null
    },
    {
      "id": 467258,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 467259,
      "primary_message": "Place bread crumbs and spices in a small bowl. Stir to combine the coating.",
      "secondary_message": "1 ½ cup panko bread crumbs\n¾ tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 467260,
      "primary_message": "Place mayo, soy sauce, and salt in a large bowl; stir to combine.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp soy sauce\n¾ tsp salt"
    },
    {
      "id": 467261,
      "primary_message": "Cut tofu crosswise into 1-inch wide fingers. Add to the bowl with the mayo mixture and gently toss to coat. (Wipe baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 467262,
      "primary_message": "Add bread crumb coating to the bowl with the tofu and gently toss once more to coat. Divide between reserved baking sheet and an additional baking sheet, then arrange in a single layer and drizzle with oil. (Reserve small bowl for later use.) ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 467263,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake until golden and warmed through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 467264,
      "primary_message": "Meanwhile, place honey, hot sauce, and salt in the reserved bowl. Whisk to combine the hot honey and set aside.",
      "secondary_message": "⅓ cup honey\n3 tbsp hot sauce\n3 pinch salt"
    },
    {
      "id": 467265,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch fresh dill\n1 small pkg chives\n1 ½ heads romaine lettuce\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 467266,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 467267,
      "primary_message": "Shave dill leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 467268,
      "primary_message": "Roughly chop chives. Add half to the blender along with yogurt, mayo, and spices. Blend on high until herby ranch dressing is smooth; set aside. (Reserve remaining chives for serving.)",
      "secondary_message": "¾ cup plain Greek yogurt\n¼ cup mayonnaise\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 467269,
      "primary_message": "Trim and cut each romaine into quarters lengthwise, to make 6 wedges. ",
      "secondary_message": null
    },
    {
      "id": 467270,
      "primary_message": "Halve grape tomatoes lengthwise. Season with salt.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 467271,
      "primary_message": "Divide tofu fingers and romaine wedges between plates. Top wedges with dressing, tomatoes, blue cheese, and remaining chives. Serve with hot honey for dipping tofu. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled blue cheese"
    }
  ],
