  "instructions": [
    {
      "id": 467151,
      "primary_message": "Preheat oven to 190°C (375°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 467152,
      "primary_message": "Place bread crumbs and spices in a small bowl. Stir to combine the coating.",
      "secondary_message": "1 ½ cup panko bread crumbs\n¾ tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 467153,
      "primary_message": "Place mayo, soy sauce, and salt in a large bowl; stir to combine.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp soy sauce\n¾ tsp salt"
    },
    {
      "id": 467154,
      "primary_message": "Pat chicken dry with paper towels, then slice into ¾-inch strips. Add to the bowl with the mayo mixture and toss to coat.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 467155,
      "primary_message": "Add bread crumb coating to the bowl with the chicken and toss well to coat. Divide coated chicken between the baking sheets and arrange in a single layer. (Reserve small bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 467156,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, about 18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 467157,
      "primary_message": "Meanwhile, place honey, hot sauce, and salt in the reserved bowl. Whisk to combine the hot honey and set aside.",
      "secondary_message": "⅓ cup honey\n3 tbsp hot sauce\n3 pinch salt"
    },
    {
      "id": 467158,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch fresh dill\n1 small pkg chives\n1 ½ heads romaine lettuce\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 467159,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 467160,
      "primary_message": "Using a clean cutting board, shave dill leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 467161,
      "primary_message": "Roughly chop chives. Add half to the blender along with yogurt, mayo, and spices. Blend on high until herby ranch dressing is smooth; set aside. (Reserve remaining chives for serving.)",
      "secondary_message": "¾ cup plain Greek yogurt\n¼ cup mayonnaise\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 467162,
      "primary_message": "Trim and cut each romaine into quarters lengthwise, to make 6 wedges. ",
      "secondary_message": null
    },
    {
      "id": 467163,
      "primary_message": "Halve grape tomatoes lengthwise. Season with salt.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 467164,
      "primary_message": "Divide chicken tenders and romaine wedges between plates. Top wedges with dressing, tomatoes, blue cheese, and remaining chives. Serve with hot honey for dipping chicken. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled blue cheese"
    }
  ],
