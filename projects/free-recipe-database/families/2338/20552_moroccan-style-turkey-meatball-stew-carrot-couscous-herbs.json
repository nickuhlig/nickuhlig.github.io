  "instructions": [
    {
      "id": 416244,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 small bunch cilantro\n1 small pkg fresh mint\n2 sticks celery\n4 tomatoes\n1 lemon"
    },
    {
      "id": 416245,
      "primary_message": "Peel, trim, and coarsely grate carrots; place in a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 416246,
      "primary_message": "Add broth to the pan with the carrot, cover, and bring to a boil over high heat.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 416247,
      "primary_message": "Once boiling, remove pan from the heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "1 cup whole wheat couscous"
    },
    {
      "id": 416248,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Place half of the herbs in a medium bowl and set remainder aside for serving.",
      "secondary_message": null
    },
    {
      "id": 416249,
      "primary_message": "Peel and mince garlic; add to the bowl with the herbs along with turkey and spices. Using your hands, mix well to combine.",
      "secondary_message": "4 cloves garlic\n0.68 kg ground turkey\n2 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 416250,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 416251,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 416252,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until just browned on all sides, 4-5 minutes (the meatballs will not be cooked all the way through). Once done, transfer to a clean plate. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 416253,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; trim and small dice celery.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 416254,
      "primary_message": "Return the skillet to medium heat, add more oil, and swirl to coat the bottom. Add onion and celery; cook, stirring occasionally, until veggies start to soften, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 416255,
      "primary_message": "While the veggies are cooking, medium dice tomatoes; add to the skillet along with the tomato sauce, water, and spices. Stir to combine and bring the stew to a boil over high heat.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n1 cup water\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 416256,
      "primary_message": "Once the stew is boiling, reduce heat to medium, then return meatballs (and any accumulated juices) to the skillet; continue to cook, stirring occasionally, until meatballs are cooked through, 5-6 minutes more.",
      "secondary_message": null
    },
    {
      "id": 416257,
      "primary_message": "When the meatballs are done, juice lemon into the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 416258,
      "primary_message": "To serve, divide couscous and meatball stew between plates or bowls; sprinkle with reserved herbs and enjoy!",
      "secondary_message": null
    }
  ],
