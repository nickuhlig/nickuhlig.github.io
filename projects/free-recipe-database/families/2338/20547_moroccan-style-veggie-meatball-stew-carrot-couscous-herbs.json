  "instructions": [
    {
      "id": 416214,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n1 small bunch cilantro\n1 small pkg fresh mint\n3 sticks celery\n6 tomatoes\n1 ½ lemons"
    },
    {
      "id": 416215,
      "primary_message": "Peel, trim, and coarsely grate carrots; place in a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 416216,
      "primary_message": "Add broth to the pan with the carrot, cover, and bring to a boil over high heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 416217,
      "primary_message": "Once boiling, remove pan from the heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "1 ½ cups whole wheat couscous"
    },
    {
      "id": 416218,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Place half of the herbs in a large bowl and set remainder aside for serving.",
      "secondary_message": null
    },
    {
      "id": 416219,
      "primary_message": "Peel and mince garlic; add to the bowl with the herbs, along with veggie ground and spices. Using your hands, mix well to combine.",
      "secondary_message": "6 cloves garlic\n24 oz veggie ground, plant based\n1 tbsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 416220,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 416221,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 416222,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until just browned on all sides, 4-5 minutes (the meatballs will not be cooked all the way through). Once done, transfer to a clean plate. (Reserve pot for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 416223,
      "primary_message": "Meanwhile, peel, halve, and small dice onions; trim and small dice celery.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 416224,
      "primary_message": "Return the pot to medium heat, add more oil, and swirl to coat the bottom. Add onion and celery; cook, stirring occasionally, until veggies start to soften, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 416225,
      "primary_message": "While the veggies are cooking, medium dice tomatoes; add to the pot along with the tomato sauce, water, and spices. Stir to combine and bring the stew to a boil over high heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 ½ cup water\n1 ½ tsp cumin, ground\n¾ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 416226,
      "primary_message": "Once the stew is boiling, reduce heat to medium, then return meatballs to the pot; continue to cook, stirring occasionally, until meatballs are cooked through, 6-7 minutes more.",
      "secondary_message": null
    },
    {
      "id": 416227,
      "primary_message": "When the meatballs are done, juice lemons into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 416228,
      "primary_message": "To serve, divide couscous and meatball stew between plates or bowls; sprinkle with reserved herbs and enjoy!",
      "secondary_message": null
    }
  ],
