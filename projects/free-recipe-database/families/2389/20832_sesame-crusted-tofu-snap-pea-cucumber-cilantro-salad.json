  "instructions": [
    {
      "id": 349072,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 349073,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 ½ limes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n1 ½ English cucumbers\n3 (227 g) pkg sugar snap peas"
    },
    {
      "id": 349074,
      "primary_message": "Peel and mince ginger; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 349075,
      "primary_message": "Juice limes into the bowl with the ginger. ",
      "secondary_message": null
    },
    {
      "id": 349076,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 349077,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil and salt; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp toasted sesame oil\n½ tsp salt"
    },
    {
      "id": 349078,
      "primary_message": "Place sesame seeds and cornstarch in a medium bowl; stir to combine.",
      "secondary_message": "1 cup sesame seeds\n¾ cup cornstarch"
    },
    {
      "id": 349079,
      "primary_message": "Cut the tofu planks in half crosswise; season with salt and pepper on both sides.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 349080,
      "primary_message": "Spread mayo over both sides of the tofu, then dredge in the sesame coating, pressing gently to adhere. Return to the baking sheet.",
      "secondary_message": "3 tbsp vegan mayonnaise"
    },
    {
      "id": 349081,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349082,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add the tofu and cook until the coating is golden and tofu is warmed through, 2-3 minutes per side. Return to the baking sheet. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 349083,
      "primary_message": "Meanwhile, trim and quarter cucumbers lengthwise, then cut crosswise into thin pieces. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 349084,
      "primary_message": "Cut snap peas crosswise into thin pieces, add to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 349085,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
