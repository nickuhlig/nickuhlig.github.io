  "instructions": [
    {
      "id": 348866,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ limes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n1 ½ English cucumbers\n3 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 348867,
      "primary_message": "Peel and mince ginger; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 348868,
      "primary_message": "Juice limes into the bowl with the ginger. ",
      "secondary_message": null
    },
    {
      "id": 348869,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 348870,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil and salt; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp toasted sesame oil\n½ tsp salt"
    },
    {
      "id": 348871,
      "primary_message": "Place sesame seeds and cornstarch in a medium bowl; stir to combine.",
      "secondary_message": "1 cup sesame seeds\n¾ cup cornstarch"
    },
    {
      "id": 348872,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets; season with salt and pepper on both sides. ",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 348873,
      "primary_message": "Spread mayo over both sides of the chicken, then dredge in the sesame coating, pressing gently to adhere. Transfer to a large plate.",
      "secondary_message": "3 tbsp mayonnaise"
    },
    {
      "id": 348874,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 348875,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add the chicken and cook until the coating is golden and chicken is cooked through, 3-4 minutes per side. Transfer to a clean plate. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 348876,
      "primary_message": "Meanwhile, using a clean cutting board, trim and quarter cucumbers lengthwise, then cut crosswise into thin pieces. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 348877,
      "primary_message": "Cut snap peas crosswise into thin pieces, add to the bowl, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 348878,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
