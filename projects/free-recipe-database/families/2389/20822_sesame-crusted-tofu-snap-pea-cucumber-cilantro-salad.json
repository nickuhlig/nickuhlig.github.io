  "instructions": [
    {
      "id": 348935,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 348936,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 lime\n1 jalapeño pepper\n1 small bunch cilantro\n1 English cucumber\n2 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 348937,
      "primary_message": "Peel and mince ginger; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 348938,
      "primary_message": "Juice lime into the bowl with the ginger. ",
      "secondary_message": null
    },
    {
      "id": 348939,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 348940,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil and salt; whisk to combine the dressing and set aside.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt"
    },
    {
      "id": 348941,
      "primary_message": "Place sesame seeds and cornstarch in another medium bowl; stir to combine.",
      "secondary_message": "⅔ cup sesame seeds\n½ cup cornstarch"
    },
    {
      "id": 348942,
      "primary_message": "Cut the tofu planks in half crosswise; season with salt and pepper on both sides.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 348943,
      "primary_message": "Spread mayo over both sides of the tofu, then dredge in the sesame coating, pressing gently to adhere. Return to the baking sheet.",
      "secondary_message": "2 tbsp vegan mayonnaise"
    },
    {
      "id": 348944,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 348945,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add the tofu and cook until the coating is golden and tofu is warmed through, 2-3 minutes per side. Remove from heat. ",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 348946,
      "primary_message": "Meanwhile, trim and quarter cucumber lengthwise, then cut crosswise into thin pieces. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 348947,
      "primary_message": "Cut snap peas crosswise into thin pieces, add to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 348948,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
