  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 medium carrots\n6 sticks celery\n1 small bunch fresh dill\n1 ½ (5 oz) pkgs baby spinach\n1 ½ lemons"
    },
    {
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl with the other veggies.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, chicken, salt, and pepper; cook, breaking the meat apart with a spoon, until chicken is cooked through and veggies are just starting to soften, 6-7 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ lb ground chicken\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "primary_message": "Add broth and orzo to the pot, stir to combine, and bring to a boil. Once boiling, reduce heat and simmer until the orzo is tender, 8-10 minutes.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n9 oz orzo pasta"
    },
    {
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "When the orzo is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "primary_message": "Juice lemons into the pot, add dill, and stir to combine the soup. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
