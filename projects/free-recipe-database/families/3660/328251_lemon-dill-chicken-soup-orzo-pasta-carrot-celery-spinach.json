  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 medium carrots\n4 sticks celery\n1 small bunch fresh dill\n1 (142 g) pkg baby spinach\n1 lemon"
    },
    {
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, chicken, salt, and pepper; cook, breaking the meat apart with a spoon, until chicken is cooked through and veggies are just starting to soften, 5-6 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n454 g ground chicken\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Add broth and orzo to the pot, stir to combine, and bring to a boil. Once boiling, reduce heat and simmer until the orzo is tender, 8-10 minutes.",
      "secondary_message": "1.89 L chicken or vegetable broth\n170 g orzo pasta"
    },
    {
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "When the orzo is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "primary_message": "Juice lemon into the pot, add dill, and stir to combine the soup. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
