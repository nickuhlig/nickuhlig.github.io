  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb new potatoes\n1 lemon\n½ lb green beans\n1 heart romaine hearts"
    },
    {
      "primary_message": "Quarter potatoes and transfer to a baking dish. Drizzle with oil, season with spices, and stir to coat. Spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp rosemary, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the potatoes are golden and fork-tender, 20-25 minutes. Remove from oven and set aside to cool, about 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, juice lemon into a small bowl, then add mayo, horseradish, vinegar, honey, salt, and pepper. Whisk to combine the dressing and divide between two (quart-sized) jars.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp horseradish, prepared\n2 tbsp white wine vinegar\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the jars with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "primary_message": "Trim and cut green beans crosswise into 1-inch pieces. Add to the jars.",
      "secondary_message": null
    },
    {
      "primary_message": " Chop or tear lettuce into bite-sized pieces. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Stack roast beef slices one on top of another, then medium dice. Set aside.",
      "secondary_message": "8 oz deli roast beef"
    },
    {
      "primary_message": "When the potatoes are cool, add to the jars along with roast beef, lettuce, and Parmesan, packing lightly if necessary.",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    },
    {
      "primary_message": "Screw lids onto jars and store in the fridge until needed. (Best if used within 2-3 days.)",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, empty jar into a bowl (making sure to scrape out all of the dressing!), then stir to combine. Enjoy!",
      "secondary_message": null
    }
  ],
