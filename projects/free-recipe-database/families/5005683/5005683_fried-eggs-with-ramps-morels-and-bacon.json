  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the bacon. Juice the lemon.",
      "secondary_message": "4 oz bacon\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Heat bacon along with 1 tablespoon water in a medium cast iron or stainless steel skillet over medium heat, stirring, until water evaporates, bacon fat renders, and bacon is completely crisp, about 5 minutes. Using a slotted spoon, transfer bacon to a bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Return skillet to medium-high heat until lightly smoking. Add morels and cook, stirring and tossing frequently, until barely starting to brown, about 2 minutes. Add 1 tablespoon butter and cook, stirring, until morels are nicely browned but not burnt, 1 to 2 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add ramps and cook, stirring and tossing frequently, until whites are browned and tender and greens are crisp in spots, about 2 minutes. Add 2 tablespoons water, soy sauce, lemon juice, and remaining tablespoon butter. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat canola oil in a medium nonstick or well-seasoned cast iron skillet over medium-high heat until shimmering. Add eggs, season with salt and pepper, and cook, occasionally using a spoon to baste hot oil over the whites to help them cook, until whites are set, edges are crisp, and yolk is still runny.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Place a slice of toast on each of two plates. Top each with a fried egg. Return morel/ramp mixture to high heat and stir in bacon. Cook over high heat until liquid reduces to a creamy, emulsified sauce. Season to taste with salt and pepper. Spoon morels and ramps over and around fried eggs. Sprinkle with chives and serve.",
      "secondary_message": null
    }
  ],
