  "instructions": [
    {
      "id": 363664,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 363665,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 363666,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ bunch kale\n1 lemon\n½ English cucumber\n½ bunch radish"
    },
    {
      "id": 363667,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into large bite-sized pieces and place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 363668,
      "primary_message": "Add nutritional yeast, oil, vinegar, and salt to the bowl with the kale; using your hands, toss the leaves well to coat. Transfer to a baking sheet pan and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": "¼ cup nutritional yeast flakes\n2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n⅛ tsp salt"
    },
    {
      "id": 363669,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing once, until the kale is crispy, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363670,
      "primary_message": "Meanwhile, drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 363671,
      "primary_message": "Zest and juice half of the lemon into the reserved bowl. (Reserve remaining lemon for the dressing.)",
      "secondary_message": null
    },
    {
      "id": 363672,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil, maple syrup, Dijon, and spices; stir to combine the marinade. Add chickpeas, stir to combine, and set aside to marinate.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n½ tsp Dijon mustard\n1 tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 363673,
      "primary_message": "Peel and mince additional garlic; place in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 363674,
      "primary_message": "Juice the reserved lemon into the bowl with the garlic. Add tahini, water, maple syrup, Dijon, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp tahini\n2 tbsp water\n1 tsp pure maple syrup\n½ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 363675,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 363676,
      "primary_message": "Trim and thinly slice radishes.",
      "secondary_message": null
    },
    {
      "id": 363677,
      "primary_message": "To serve, divide quinoa, kale chips, chickpeas, cucumber, and radish between bowls. Drizzle with lemon-tahini dressing and enjoy!",
      "secondary_message": null
    }
  ],
