  "instructions": [
    {
      "id": 485997,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n1 bunch Swiss chard\n1 lemon"
    },
    {
      "id": 485998,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 485999,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in another medium bowl and add stems to the bowl with the leek. Set the leaves aside.",
      "secondary_message": null
    },
    {
      "id": 486000,
      "primary_message": "Peel and mince garlic. Add to the bowl with the leek and chard stems, then set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 486001,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 486002,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 486003,
      "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg sea scallops\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 486004,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add scallops in a single layer; cook until golden brown and opaque throughout, 1½-2 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 486005,
      "primary_message": "Return skillet (with any cooking juices) to medium-high heat, add more butter, and swirl to coat the bottom. Add leek, chard stems, garlic, and spices; cook, stirring often, until softened, 1-2 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 486006,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Add beans and continue to cook, stirring occasionally, until chard is tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 486007,
      "primary_message": "Add broth to the skillet and cook, stirring occasionally, until the sauce has thickened slightly, 3-4 minutes. Remove from heat.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 486008,
      "primary_message": "Meanwhile, zest lemon into the reserved bowl. Cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 486009,
      "primary_message": "Finely grate Parmesan. Add half to the bowl with the lemon zest and stir to combine. Add remaining Parmesan to the skillet, along with pumpkin seeds, and stir to combine.",
      "secondary_message": "85 g Parmesan cheese\n½ cup pumpkin seeds"
    },
    {
      "id": 486010,
      "primary_message": "To serve, divide bean and chard sauté between plates or bowls. Top with scallops, lemon zest, and Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
