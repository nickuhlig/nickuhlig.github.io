  "instructions": [
    {
      "id": 332157,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a large baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 332158,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 red bell peppers\n1 ½ English cucumbers\n1 small bunch cilantro"
    },
    {
      "id": 332159,
      "primary_message": "Zest and juice lemons into a large bowl; add oil, honey, and spices. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp honey\n1 ½ tsp garlic powder\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 332160,
      "primary_message": "Pat fish dry with paper towels and transfer to the baking sheet; drizzle with half of the dressing and turn to coat. (Set remaining dressing aside for the salad.)",
      "secondary_message": "1.02 kg cod fillet"
    },
    {
      "id": 332161,
      "primary_message": "Place fish in the oven and broil until the fish flakes easily with a fork, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 332162,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; add to the bowl with the dressing.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 332163,
      "primary_message": "Place corn in the colander, run under hot water (from the tap) to defrost, and add to the bowl.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 332164,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332165,
      "primary_message": "Trim and halve cucumbers lengthwise, then slice crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332166,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the feta, salt, and pepper; stir to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 332167,
      "primary_message": "To serve, divide fish and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
