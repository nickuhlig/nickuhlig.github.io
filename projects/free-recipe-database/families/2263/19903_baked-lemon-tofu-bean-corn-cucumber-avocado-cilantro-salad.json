  "instructions": [
    {
      "id": 332122,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 332123,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 332124,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 red bell peppers\n1 ½ English cucumbers\n1 ½ avocados\n1 small bunch cilantro"
    },
    {
      "id": 332125,
      "primary_message": "Zest and juice lemons into a large bowl; add oil, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp pure maple syrup\n1 ½ tsp garlic powder\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 332126,
      "primary_message": "Large dice tofu, divide between two large baking dishes, and drizzle with half of the dressing; turn to coat. (Reserve remaining dressing for the salad.)",
      "secondary_message": null
    },
    {
      "id": 332127,
      "primary_message": "Place the baking dishes in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tofu is golden and warmed through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 332128,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; add to the bowl with the dressing.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 332129,
      "primary_message": "Place corn in the colander, run under hot water (from the tap) to defrost, and add to the bowl.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 332130,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332131,
      "primary_message": "Trim and halve cucumbers lengthwise, then slice crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332132,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332133,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with salt and pepper; stir to combine the salad.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 332134,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
