  "instructions": [
    {
      "id": 332109,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 332110,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 332111,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 red bell peppers\n1 English cucumber\n1 avocado\n1 small bunch cilantro"
    },
    {
      "id": 332112,
      "primary_message": "Zest and juice lemons into a medium bowl; add oil, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n4 tsp pure maple syrup\n1 tsp garlic powder\n1 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 332113,
      "primary_message": "Large dice tofu, transfer to a large baking dish, and drizzle with half of the dressing; turn to coat. (Reserve remaining dressing for the salad.)",
      "secondary_message": null
    },
    {
      "id": 332114,
      "primary_message": "Place the baking dish in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tofu is golden and warmed through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 332115,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; add to the bowl with the dressing.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 332116,
      "primary_message": "Place corn in the colander, run under hot water (from the tap) to defrost, and add to the bowl.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 332117,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332118,
      "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332119,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332120,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with salt and pepper; stir to combine the salad.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 332121,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
