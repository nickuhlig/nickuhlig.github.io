  "instructions": [
    {
      "id": 332146,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 332147,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 red bell peppers\n1 English cucumber\n1 small bunch cilantro"
    },
    {
      "id": 332148,
      "primary_message": "Zest and juice lemons into a medium bowl; add oil, honey, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n4 tsp honey\n1 tsp garlic powder\n1 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 332149,
      "primary_message": "Pat fish dry with paper towels and transfer to the baking sheet; drizzle with half of the dressing and turn to coat. (Set remaining dressing aside for the salad.)",
      "secondary_message": "0.68 kg cod fillet"
    },
    {
      "id": 332150,
      "primary_message": "Place fish in the oven and broil until the fish flakes easily with a fork, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 332151,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; add to the bowl with the dressing.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 332152,
      "primary_message": "Place corn in the colander, run under hot water (from the tap) to defrost, and add to the bowl.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 332153,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332154,
      "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 332155,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the feta, salt, and pepper; stir to combine the salad.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 332156,
      "primary_message": "To serve, divide fish and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
