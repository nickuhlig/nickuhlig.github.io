  "instructions": [
    {
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "4 eggs"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n2 pints grape tomatoes\n1 small bunch cilantro"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "680 g striploin (New York strip) steak\nsalt\nblack pepper"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest. (Reserve skillet with drippings for later use.)",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "While the steak is cooking, trim, seed, and medium dice bell pepper. Place in a medium bowl along with grape tomatoes.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add veggies, cilantro, garlic, and spices; cook, stirring occasionally, until tomatoes start to burst, 6-8 minutes.",
      "secondary_message": "extra virgin olive oil\n1 tsp smoked paprika\nsalt\nblack pepper"
    },
    {
      "primary_message": "Add tomato sauce to the skillet and stir to combine. Continue to cook, stirring occasionally, until sauce thickens slightly, 4-5 minutes more. Remove from heat.",
      "secondary_message": "2 (221 g) cans tomato sauce"
    },
    {
      "primary_message": "Meanwhile, peel and quarter eggs, then season with salt and pepper.",
      "secondary_message": "salt\nblack pepper"
    },
    {
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide tomato-bell pepper skillet between plates or bowls, then top with steak and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
