  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the best-quality ripe tomatoes to room temperature. Tear the best-quality fresh mozzarella cheese into bite-size chunks.",
      "secondary_message": "6 best-quality ripe tomatoes, mixed sizes\n227 to 340 g best-quality fresh mozzarella cheese"
    },
    {
      "id": 1,
      "primary_message": "Cut tomatoes into an assortment of slices and chunks and spread over a large plate in a single, slightly overlapping layer. Tuck chunks of mozzarella among the tomato pieces. Drizzle generously with extra-virgin olive oil. Sprinkle with coarse sea salt and black pepper. Tear basil leaves into small pieces with your fingertips and spread them on top. Serve immediately.",
      "secondary_message": null
    }
