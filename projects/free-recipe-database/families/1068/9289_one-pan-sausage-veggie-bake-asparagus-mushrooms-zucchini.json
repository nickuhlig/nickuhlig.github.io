  "instructions": [
    {
      "id": 147749,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 147750,
      "primary_message": "Place sausages on a baking sheet pan and place in the oven (it doesn't have to be fully heated); bake for 10 minutes.",
      "secondary_message": "9 pork sausages"
    },
    {
      "id": 147751,
      "primary_message": "Meanwhile, peel and mince the garlic; place in a large bowl along with the oil and spices. Stir to combine.",
      "secondary_message": "6 cloves garlic\n⅓ cup extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 147752,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 caps portobello mushrooms\n3 small bunches asparagus"
    },
    {
      "id": 147753,
      "primary_message": "Trim and slice zucchinis into ¼-inch rounds; place in the bowl with the garlic oil.",
      "secondary_message": null
    },
    {
      "id": 147754,
      "primary_message": "Cut the mushrooms in half and then crosswise into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 147755,
      "primary_message": "Snap (or cut) off woody ends from the asparagus and cut into 2-inch pieces; add to the bowl with the other veggies and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 147756,
      "primary_message": "Remove baking sheet pan from the oven and flip sausages. Divide the veggies between two more pans and place all three pans in the oven; continue to bake, until veggies are tender and sausages are cooked through, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 147757,
      "primary_message": "Slice sausages into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 147758,
      "primary_message": "To serve, divide sausage pieces and vegetables between plates. Enjoy!",
      "secondary_message": null
    }
  ],
