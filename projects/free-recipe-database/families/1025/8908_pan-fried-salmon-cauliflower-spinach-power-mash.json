  "instructions": [
    {
      "id": 138775,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 138776,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ small pkgs fresh basil\n3 (142 g) pkg baby spinach\n1 ½ lemons"
    },
    {
      "id": 138777,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stems; roughly cut into bite-sized florets.",
      "secondary_message": null
    },
    {
      "id": 138778,
      "primary_message": "Once the water is boiling, add the cauliflower and cook until fork-tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 138779,
      "primary_message": "Meanwhile, peel and medium dice the onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 138780,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 138781,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onions and cook, stirring occasionally, until lightly browned, about 5 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 138782,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 138783,
      "primary_message": "Add garlic to the skillet with the onions, cook, stirring constantly, 1 minute more. Remove from heat and transfer the garlic and onions to a blender.",
      "secondary_message": null
    },
    {
      "id": 138784,
      "primary_message": "Pick basil leaves off the stems; add leaves to the blender along with cream, butter, salt, and pepper.",
      "secondary_message": "177 ml heavy cream\n⅓ cup butter, unsalted\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 138785,
      "primary_message": "Place the spinach in a large colander in the sink. When the cauliflower is cooked, carefully empty into the colander to drain; add cauliflower and wilted spinach to blender. Blend on high, until smooth, about 1 minute. Set aside. Blend in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 138786,
      "primary_message": "Pat salmon dry with paper towels and cut into fillets; season with salt and pepper.",
      "secondary_message": "1.02 kg salmon fillet\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 138787,
      "primary_message": "Wipe out skillet and return to heat; add more butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 138788,
      "primary_message": "Cooking in batches if necessary, add salmon to the skillet, skin-side down, and reduce heat to medium. Cook 4 minutes and then flip, cooking an additional 3-4 minutes, until the fish is firm and cooked through.",
      "secondary_message": null
    },
    {
      "id": 138789,
      "primary_message": "Cut lemons into wedges.",
      "secondary_message": null
    },
    {
      "id": 138790,
      "primary_message": "To serve, divide spinach mash between plates and top with butter; place salmon on the side and garnish with lemon wedges. Enjoy!",
      "secondary_message": "3 tbsp butter, unsalted"
    }
  ],
