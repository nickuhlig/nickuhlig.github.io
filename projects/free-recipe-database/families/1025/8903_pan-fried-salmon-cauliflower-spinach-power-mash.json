  "instructions": [
    {
      "id": 138695,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 138696,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n½ small pkg fresh basil\n1 (5 oz) pkg baby spinach\n½ lemon"
    },
    {
      "id": 138697,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stems; roughly cut into bite-sized florets.",
      "secondary_message": null
    },
    {
      "id": 138698,
      "primary_message": "Once the water is boiling, add the cauliflower and cook until fork-tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 138699,
      "primary_message": "Meanwhile, peel and medium dice the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 138700,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 138701,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion and cook, stirring occasionally, until lightly browned, about 5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 138702,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 138703,
      "primary_message": "Add garlic to the skillet with the onion; cook, stirring constantly, 1 minute more. Remove from heat and transfer the garlic and onion to a blender.",
      "secondary_message": null
    },
    {
      "id": 138704,
      "primary_message": "Pick basil leaves off the stems; add leaves to the blender along with cream, butter, salt, and pepper.",
      "secondary_message": "2 fl oz (¼ cup) heavy cream\n2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 138705,
      "primary_message": "Place the spinach in a large colander in the sink. When the cauliflower is cooked, carefully empty into the colander to drain; add cauliflower and wilted spinach to the blender. Blend on high, until smooth, about 1 minute. Set aside.",
      "secondary_message": null
    },
    {
      "id": 138706,
      "primary_message": "Pat salmon dry with paper towels and cut into fillets; season with salt and pepper.",
      "secondary_message": "¾ lb salmon fillet\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 138707,
      "primary_message": "Wipe out skillet and return to heat; add more butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 138708,
      "primary_message": "Add salmon to the skillet, skin-side down, and reduce heat to medium. Cook 4 minutes and then flip, cooking an additional 3-4 minutes, until the fish is firm and cooked through.",
      "secondary_message": null
    },
    {
      "id": 138709,
      "primary_message": "Cut lemon into wedges.",
      "secondary_message": null
    },
    {
      "id": 138710,
      "primary_message": "To serve, divide spinach mash between plates and top with butter; place salmon on the side and garnish with lemon wedges. Enjoy!",
      "secondary_message": "1 tbsp butter, unsalted"
    }
  ],
