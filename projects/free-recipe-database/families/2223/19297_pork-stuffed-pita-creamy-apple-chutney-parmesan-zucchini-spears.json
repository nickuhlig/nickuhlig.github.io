  "instructions": [
    {
      "id": 317301,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 317302,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 Gala apples\n9 medium zucchini squash"
    },
    {
      "id": 317303,
      "primary_message": "Peel and mince ginger, garlic, and onion; transfer to a medium bowl.",
      "secondary_message": "3 cloves garlic\n½ medium red onion"
    },
    {
      "id": 317304,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 317305,
      "primary_message": "While the skillet heats up, quarter, core, and small dice apples; add to the bowl with the ginger, garlic, and onion. ",
      "secondary_message": null
    },
    {
      "id": 317306,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add ginger, garlic, onion, and apple. Cook, stirring occasionally, until golden and soft, 6-7 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 317307,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 317308,
      "primary_message": "Trim zucchini and quarter lengthwise, then halve crosswise; divide between two baking sheet pans. Drizzle with oil, season with spices, and sprinkle with Parmesan.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 317309,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until zucchini is fork-tender, about 15 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 317310,
      "primary_message": "When the apple is soft, add broth, vinegar, sugar, and spices to the skillet; stir to combine the chutney and bring to a simmer over medium-high heat. Once simmering, reduce heat to low and cook, stirring occasionally, until thickened, about 10 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n2 tbsp apple cider vinegar\n1 ½ tsp brown sugar\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 317311,
      "primary_message": "Pat pork chops dry with paper towels and place on a cutting board; thinly slice crosswise into bite-sized strips, then season with salt and pepper.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 317312,
      "primary_message": "When the chutney is done, transfer to the reserved bowl and set aside. Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 317313,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add pork and stir-fry until browned and cooked through, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 317314,
      "primary_message": "Meanwhile, add yogurt to the chutney and stir to combine.",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 317315,
      "primary_message": "Using a clean cutting board, cut pitas in half and carefully open the pockets; stuff each pocket with creamy chutney and pork.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 317316,
      "primary_message": "To serve, divide pitas and zucchini between plates. Enjoy!",
      "secondary_message": null
    }
  ],
