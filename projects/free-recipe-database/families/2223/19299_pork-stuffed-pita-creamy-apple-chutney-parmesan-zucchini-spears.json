  "instructions": [
    {
      "id": 317333,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 317334,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 Gala apples\n6 medium zucchini squash"
    },
    {
      "id": 317335,
      "primary_message": "Peel and mince ginger, garlic, and shallots; transfer to a small bowl.",
      "secondary_message": "2 cloves garlic\n2 shallots"
    },
    {
      "id": 317336,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 317337,
      "primary_message": "While the skillet heats up, quarter, core, and small dice apples; add to the bowl with the ginger, garlic, and shallot.",
      "secondary_message": null
    },
    {
      "id": 317338,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add ginger, garlic, shallot, and apple. Cook, stirring occasionally, until golden and soft, 5-6 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 317339,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 317340,
      "primary_message": "Trim zucchini and quarter lengthwise, then halve crosswise; arrange on a large baking sheet pan. Drizzle with oil, season with spices, and sprinkle with Parmesan.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 317341,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until zucchini is fork-tender, 12-15 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 317342,
      "primary_message": "When the apple is soft, add broth, vinegar, sugar, and spices to the skillet; stir to combine the chutney and bring to a simmer over medium-high heat. Once simmering, reduce heat to low and cook, stirring occasionally, until thickened, about 10 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n4 tsp apple cider vinegar\n1 tsp brown sugar\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 317343,
      "primary_message": "When the chutney is done, transfer to the reserved bowl and set aside. Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 317344,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a cutting board; thinly slice crosswise into bite-sized strips, then season with salt and pepper.",
      "secondary_message": "4 pork chops, boneless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 317345,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add pork and stir-fry until browned and cooked through, 3-4 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 317346,
      "primary_message": "Meanwhile, add yogurt to the chutney and stir to combine.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 317347,
      "primary_message": "Using a clean cutting board, cut pitas in half and carefully open the pockets; stuff each pocket with creamy chutney and pork.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 317348,
      "primary_message": "To serve, divide pitas and zucchini between plates. Enjoy!",
      "secondary_message": null
    }
  ],
