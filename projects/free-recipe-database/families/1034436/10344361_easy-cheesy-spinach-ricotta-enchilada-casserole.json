  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place spinach in a colander and rinse under hot, running water (from the tap) to defrost. Using your hands, squeeze as much water from the spinach as you can, then place in a medium bowl.\n\n",
      "secondary_message": "1 (283 g) pkg frozen chopped spinach"
    },
    {
      "primary_message": "Add ricotta, egg, garlic, salt, and pepper to the bowl with the spinach, then stir to combine. Set aside. \n\n",
      "secondary_message": "1 (425 g) pkg ricotta cheese\n1 egg\n1 tsp minced garlic\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Chop or tear tortillas into 2-inch pieces.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spread a ½-cup enchilada sauce on the bottom of a baking dish. Add ⅓ of the tortilla pieces and spread out in an even layer. Top with ⅓ of the ricotta mixture and ⅓ of the remaining enchilada sauce. Repeat layers twice more, ending with enchilada sauce, then evenly sprinkle with cheese. \n\n",
      "secondary_message": "2 (283 g) can red enchilada sauce\n1 cup shredded cheese, Mexican blend"
    },
    {
      "primary_message": "Place casserole in the oven and bake until cheese is melted and filling is warmed through, about 25 minutes. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide enchilada casserole between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
