  "instructions": [
    {
      "id": 191692,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 medium carrot\n½ orange bell pepper\n1 cap portobello mushroom\n1 lime\n½ small bunch cilantro"
    },
    {
      "id": 191693,
      "primary_message": "Cut chicken into 1-inch pieces, set aside.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 191694,
      "primary_message": "Heat coconut oil in a large pot over medium heat.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 191695,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add both to the pot.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 191696,
      "primary_message": "Add to the pot turmeric and crushed red pepper, stirring until fragrant, about 30 seconds.",
      "secondary_message": "1 tsp turmeric\n1 pinch crushed red pepper"
    },
    {
      "id": 191697,
      "primary_message": "Add chicken pieces to pot, stirring occasionally. ",
      "secondary_message": null
    },
    {
      "id": 191698,
      "primary_message": "Peel and thinly slice carrot on the bias. Cut the bell pepper lengthwise into quarters; remove and discard the seeds and white membrane then slice thinly. Add veggies to the pot. ",
      "secondary_message": null
    },
    {
      "id": 191699,
      "primary_message": "Remove the stems from the mushroom and carefully scrape out the gills with a spoon, making sure not to damage the rim of the mushrooms. Cut cap in half, thinly slice and add to the pot.",
      "secondary_message": null
    },
    {
      "id": 191700,
      "primary_message": "Cook chicken and vegetables, stirring occasionally, until vegetables are tender, about 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 191701,
      "primary_message": "Add broth, coconut milk, fish sauce, honey, and vinegar and stir to combine.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ (398 ml) can coconut milk\n1 tbsp fish sauce\n1 tbsp honey\n1 ½ tsp rice vinegar"
    },
    {
      "id": 191702,
      "primary_message": "Bring soup to boil and then reduce heat to low. Simmer for 8-10 minutes, allowing the chicken to cook fully and flavors to blend.",
      "secondary_message": null
    },
    {
      "id": 191703,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 191704,
      "primary_message": "Juice the lime and add to the pot right before serving, stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 191705,
      "primary_message": "To serve, divide soup between bowls and garnish with cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
