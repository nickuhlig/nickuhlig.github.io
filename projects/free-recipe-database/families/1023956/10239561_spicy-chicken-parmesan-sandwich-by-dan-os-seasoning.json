  "instructions": [
    {
      "primary_message": "Preheat the oven to 400°F (200°C).",
      "secondary_message": null
    },
    {
      "primary_message": "In a pot, combine the can of tomatoes, chopped garlic, fresh basil leaves, and 1 tablespoon Dan-O’s® original seasoning. Simmer over medium heat, stirring frequently, for approximately 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": " Lay parchment paper on a flat surface. Pound out the chicken tenders to an even thickness. Sprinkle remaining Dan-O’s® original seasoning and all-purpose flour over the chicken, then evenly press the mixture into the chicken. In a separate dish, mix the panko bread crumbs with 2 tablespoons Dan-O’s® jalapeño cheesoning.",
      "secondary_message": null
    },
    {
      "primary_message": "Dip each floured chicken tender into the whisked eggs, then coat in the panko-jalapeño seasoning mixture. Repeat for all chicken tenders.",
      "secondary_message": null
    },
    {
      "primary_message": "Heat 2 cups of vegetable oil in a pan over medium to high heat until it reaches 350°F (175°C). Fry the chicken tenders for 1 1/2 to 2 minutes on each side, or until golden brown and crispy. Transfer to a baking sheet with a wire rack.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the tomatoes are soft, blend the mixture using an immersion blender or a regular blender until marinara sauce is smooth.",
      "secondary_message": null
    },
    {
      "primary_message": "Top each fried chicken tender with a spoonful of marinara sauce and 1 slice of mozzarella split in half. Sprinkle generously with remaining Dan-O's® jalapeño seasoning. Bake in the preheated oven for 10 minutes, or until the cheese is melted and bubbly.",
      "secondary_message": null
    },
    {
      "primary_message": "While the chicken is baking, slice the sandwich rolls in half and place them in the oven for 5 minutes to toast.",
      "secondary_message": null
    },
    {
      "primary_message": "Assemble the sandwiches by placing the cheesy chicken tenders on the bottom half of the toasted rolls. Add more marinara sauce if desired, then top with the other half of the rolls.",
      "secondary_message": null
    }
  ],
