  "instructions": [
    {
      "id": 502405,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 502406,
      "primary_message": "Cut tofu in half along the long side to make 2 planks. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 502407,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 medium zucchini squash\n1 ½ lemons"
    },
    {
      "id": 502408,
      "primary_message": "Peel, trim, and small dice carrots. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 502409,
      "primary_message": "Trim and small dice zucchini. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 502410,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 502411,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Add to the bowl with the other veggies.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 502412,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 502413,
      "primary_message": "While the veggies are cooking, using a strainer or colander, rinse the rice under cold, running water.",
      "secondary_message": "1 ½ cups jasmine rice"
    },
    {
      "id": 502414,
      "primary_message": "Add rice and water to the pot with the veggies, stir to combine, and bring to a boil over high heat. Once the liquid comes to a boil, cover the pot and reduce heat to low. Cook rice until liquid is mostly absorbed, 15-18 minutes. Once done, remove from heat and let it stand, covered, for 5 minutes.",
      "secondary_message": "3 cup water"
    },
    {
      "id": 502415,
      "primary_message": "Meanwhile, zest and juice lemons into a large baking dish.",
      "secondary_message": null
    },
    {
      "id": 502416,
      "primary_message": "Add cream, capers, Dijon, salt, and pepper to the baking dish with the lemon. Whisk to combine the sauce.",
      "secondary_message": "177 ml heavy whipping cream\n3 tbsp capers\n3 tbsp Dijon mustard\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 502417,
      "primary_message": "Add tofu to the baking dish in a single layer. Turn to coat tofu in sauce, then place in the oven and bake until warmed through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 502418,
      "primary_message": "To serve, divide rice pilaf and tofu between plates; spoon sauce over tofu. Enjoy!",
      "secondary_message": null
    }
  ],
