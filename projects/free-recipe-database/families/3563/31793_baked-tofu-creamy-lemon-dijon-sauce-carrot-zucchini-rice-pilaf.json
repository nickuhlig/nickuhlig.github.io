  "instructions": [
    {
      "id": 502391,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 502392,
      "primary_message": "Cut tofu in half along the long side to make 2 planks. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 502393,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 medium zucchini squash\n1 lemon"
    },
    {
      "id": 502394,
      "primary_message": "Peel, trim, and small dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 502395,
      "primary_message": "Trim and small dice zucchini. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 502396,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 502397,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 502398,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 502399,
      "primary_message": "While the veggies are cooking, using a strainer or colander, rinse the rice under cold, running water.",
      "secondary_message": "1 cup jasmine rice"
    },
    {
      "id": 502400,
      "primary_message": "Add rice and water to the pan with the veggies, stir to combine, and bring to a boil over high heat. Once the liquid comes to a boil, cover the pan and reduce heat to low. Cook rice until liquid is mostly absorbed, 15-18 minutes. Once done, remove from heat and let it stand, covered, for 5 minutes.",
      "secondary_message": "2 cup water"
    },
    {
      "id": 502401,
      "primary_message": "Meanwhile, zest and juice lemon into a baking dish.",
      "secondary_message": null
    },
    {
      "id": 502402,
      "primary_message": "Add cream, capers, Dijon, salt, and pepper to the baking dish with the lemon. Whisk to combine the sauce.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n2 tbsp capers\n2 tbsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 502403,
      "primary_message": "Add tofu to the baking dish in a single layer. Turn to coat tofu in sauce, then place in the oven and bake until warmed through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 502404,
      "primary_message": "To serve, divide rice pilaf and tofu between plates; spoon sauce over tofu. Enjoy!",
      "secondary_message": null
    }
  ],
