  "instructions": [
    {
      "id": 361300,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 361301,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 361302,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n½ small pineapple\n1 (2 ½ cm) piece ginger root\n½ small bunch cilantro"
    },
    {
      "id": 361303,
      "primary_message": "Trim, seed, and medium dice bell pepper; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 361304,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice the flesh. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 361305,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 361306,
      "primary_message": "While the skillet heats up, peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 361307,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper, pineapple, ginger, garlic, and carrots. Cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp virgin coconut oil\n½ (283 g) bag shredded carrots"
    },
    {
      "id": 361308,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 361309,
      "primary_message": "Medium dice ham.",
      "secondary_message": "227 g ham steak, boneless"
    },
    {
      "id": 361310,
      "primary_message": "When the pineapple and veggies are soft, add half of the cilantro (reserve remainder for garnish), diced ham, and stir-fry sauce to the skillet. Continue to cook, stirring occasionally, until warmed through, 3-4 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "⅓ cup stir-fry sauce"
    },
    {
      "id": 361311,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls; sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
