  "instructions": [
    {
      "id": 361288,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 361289,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 361290,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ small pineapples\n3 (1 inch) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 361291,
      "primary_message": "Trim, seed, and medium dice bell peppers; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 361292,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and medium dice the flesh. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 361293,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 361294,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 361295,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add bell pepper, pineapple, ginger, garlic, and carrots. Cook, stirring occasionally, until softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp virgin coconut oil\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 361296,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 361297,
      "primary_message": "Medium dice ham.",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 361298,
      "primary_message": "When the pineapple and veggies are soft, add half of the cilantro (reserve remainder for garnish), diced ham, and stir-fry sauce to the pot. Continue to cook, stirring occasionally, until warmed through, 4-5 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "1 cup stir-fry sauce"
    },
    {
      "id": 361299,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls; sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
