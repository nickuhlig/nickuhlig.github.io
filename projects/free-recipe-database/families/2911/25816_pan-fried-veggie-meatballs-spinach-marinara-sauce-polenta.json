  "instructions": [
    {
      "id": 412032,
      "primary_message": "Place veggie ground, bread crumbs, and spices in a medium bowl. Using your hands, mix well to combine.",
      "secondary_message": "227 g veggie ground, plant based\n¼ cup panko bread crumbs\n1 tsp Italian seasoning\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 412033,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs.\" Place on a plate. ",
      "secondary_message": null
    },
    {
      "id": 412034,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 412035,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, stirring occasionally, until golden and almost cooked through, 6-7 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 412036,
      "primary_message": "While the meatballs are cooking, medium dice polenta. Place in a medium saucepan along with broth, salt, and pepper. Bring to a simmer over medium-high heat.",
      "secondary_message": "1 (510 g) tube polenta, pre-cooked\n237 ml chicken or vegetable broth\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 412037,
      "primary_message": "Once the broth is simmering, reduce heat to medium. Using a potato masher, mash the polenta until smooth; continue to cook, stirring occasionally, until heated through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 412038,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 412039,
      "primary_message": "When the meatballs are golden, add marinara sauce to the skillet, stir to combine, and bring to a simmer. ",
      "secondary_message": "½ (680 g) jar marinara sauce"
    },
    {
      "id": 412040,
      "primary_message": "Once the sauce is simmering, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 412041,
      "primary_message": "To serve, divide polenta between plates or bowls; top with meatballs and sauce. Enjoy!",
      "secondary_message": null
    }
  ],
