  "instructions": [
    {
      "id": 411902,
      "primary_message": "Place beef, bread crumbs, and spices in a large bowl. Using your hands, mix well to combine.",
      "secondary_message": "2 ¼ lb lean ground beef\n⅓ cup panko bread crumbs\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 411903,
      "primary_message": "Using a tablespoon measure, form the beef mixture into rounded meatballs. Place on a large plate. ",
      "secondary_message": null
    },
    {
      "id": 411904,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 411905,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches, add meatballs and cook, stirring occasionally, until golden and almost cooked through, 6-7 minutes. Once done, transfer to a clean plate. (Reserve pot for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 411906,
      "primary_message": "While the meatballs are cooking, medium dice polenta. Place in another large pot along with broth, salt, and pepper. Bring to a simmer over medium-high heat.",
      "secondary_message": "3 (18 oz) tubes polenta, pre-cooked\n24 fl oz (3 cups) chicken or vegetable broth\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 411907,
      "primary_message": "Once the broth is simmering, reduce heat to medium. Using a potato masher, mash the polenta until smooth; continue to cook, stirring occasionally, until heated through, 3-4 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 411908,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 411909,
      "primary_message": "Return the pot to medium-high heat. Add meatballs and marinara sauce, then stir to combine and bring to a simmer. ",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce"
    },
    {
      "id": 411910,
      "primary_message": "Once the sauce is simmering, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 411911,
      "primary_message": "To serve, divide polenta between plates or bowls; top with meatballs and sauce. Enjoy!",
      "secondary_message": null
    }
  ],
