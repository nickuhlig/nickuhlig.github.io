  "instructions": [
    {
      "id": 411892,
      "primary_message": "Place beef, bread crumbs, and spices in a medium bowl. Using your hands, mix well to combine.",
      "secondary_message": "1 ½ lb lean ground beef\n¼ cup panko bread crumbs\n2 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 411893,
      "primary_message": "Using a tablespoon measure, form the beef mixture into rounded meatballs. Place on a plate. ",
      "secondary_message": null
    },
    {
      "id": 411894,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 411895,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, stirring occasionally, until golden and almost cooked through, 6-7 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 411896,
      "primary_message": "While the meatballs are cooking, medium dice polenta. Place in a large pot along with broth, salt, and pepper. Bring to a simmer over medium-high heat.",
      "secondary_message": "2 (18 oz) tubes polenta, pre-cooked\n16 fl oz (2 cups) chicken or vegetable broth\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 411897,
      "primary_message": "Once the broth is simmering, reduce heat to medium. Using a potato masher, mash the polenta until smooth; continue to cook, stirring occasionally, until heated through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 411898,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 411899,
      "primary_message": "When the meatballs are golden, add marinara sauce to the skillet, stir to combine, and bring to a simmer. ",
      "secondary_message": "1 (24 oz) jar marinara sauce"
    },
    {
      "id": 411900,
      "primary_message": "Once the sauce is simmering, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 411901,
      "primary_message": "To serve, divide polenta between plates or bowls; top with meatballs and sauce. Enjoy!",
      "secondary_message": null
    }
  ],
