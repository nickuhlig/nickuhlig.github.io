  "instructions": [
    {
      "id": 360158,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pineapple\n1 small bunch green onions (scallions)\n1 avocado"
    },
    {
      "id": 360159,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 360160,
      "primary_message": "Trim and thinly slice green onions crosswise. Add to the bowl with the pineapple. ",
      "secondary_message": null
    },
    {
      "id": 360161,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 360162,
      "primary_message": "Add cabbage and dressing to the bowl; toss to combine the slaw and set aside. ",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n½ cup ranch dressing"
    },
    {
      "id": 360163,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 360164,
      "primary_message": "Cut ham steak into 8 portions and transfer to a large baking sheet pan. Sprinkle steaks with sugar and pepper on the top-side. ",
      "secondary_message": "16 oz ham steak, boneless\n2 tsp brown sugar\n½ tsp black pepper"
    },
    {
      "id": 360165,
      "primary_message": "Place baking sheet in the oven and broil steaks until golden brown, 4-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 360166,
      "primary_message": "To assemble the sandwiches, layer the bottom half of each bun with two ham steaks and a small portion of slaw. Close with the top half of each bun. (Reserve remaining slaw for serving.)",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 360167,
      "primary_message": "Divide sandwiches between plates and serve with remaining slaw on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
