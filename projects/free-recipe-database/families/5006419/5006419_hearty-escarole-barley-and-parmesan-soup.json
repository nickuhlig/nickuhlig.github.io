  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat olive oil in a large saucepan over medium-high heat until shimmering. Add onions, carrots, and celery. Cook, stirring occasionally, until softened but not browned, about 4 minutes. Add rosemary and garlic and cook, stirring, until fragrant, about 1 minute. Add escarole and cook, stirring occasionally, until wilted, about 5 minutes. Add tomato paste and continue to cook, stirring frequently, until liquid has evaporated and mixture begins to sizzle, about 5 minutes longer. Add barley and cook, stirring, until coated with oil, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in broth. Add bay leaves, parmesan rind, soy sauce, and fish sauce (if using), and bring to a boil. Reduce to a bare simmer and cook, stirring occasionally, until barley is softened and soup has absorbed flavor from parmesan and bay leaves, about 25 minutes. Season to taste with salt and pepper. Stir in parsley. Serve, drizzling with olive oil and sprinkling with parmesan.",
      "secondary_message": null
    }
  ],
