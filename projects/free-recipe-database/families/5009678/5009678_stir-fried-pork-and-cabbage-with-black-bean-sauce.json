  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the pork tenderloin into 1/4-inch strips. Mince the ginger. Mince the garlic. Slice the Napa cabbage 1/4 inch thick.",
      "secondary_message": "1 lb pork tenderloin\n1 tbsp ginger\n2 large cloves garlic\n½ head Napa cabbage"
    },
    {
      "id": 1,
      "primary_message": "Toss pork in a bowl with ginger, garlic, 1/2 tablespoon light soy sauce, dark soy sauce, 1 tablespoon rice wine, brown sugar, and 2 teaspoons cornstarch. Let sit while preparing remaining ingredients. In small bowl combine remaining soy sauce, rice wine, and cornstarch with vinegar and fermented black beans. Stir to completely dissolve cornstarch.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat 2 tablespoons oil in wok or large skillet over high heat until smoking. Add pork and stir fry until almost fully cooked through, 2 to 3 minutes. Stir frequently to prevent sticking. Transfer pork to plate and return wok to high heat. Add remaining oil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When wok smokes again, add cabbage, tossing to coat with oil. When cabbage has just started to wilt and become crispy on edges (about 1 minute) return pork to wok along with reserved black bean sauce. Stir fry until cabbage is just tender and pork is cooked through, another 2-3 minutes. Salt to taste before transferring to a bowl or platter. Serve with rice and a drizzle of sriracha.",
      "secondary_message": null
    }
  ],
