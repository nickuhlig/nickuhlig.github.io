  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in a medium saucepan over medium heat until shimmering. Add in the onion and cook, stirring occasionally, until softened but not browned, 5 to 8 minutes. Add in the garlic and stir until fragrant, about 30 seconds. Add the tomato purée, brown sugar, vinegar, tomato paste, salt, mustard, cloves, allspice, and cayenne pepper and stir to combine. Bring to a boil, then reduce heat to low and simmer, stirring occasionally, until thickened to the consistency of ketchup, 45 to 60 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place ketchup in the jar of a blender and purée until completely smooth.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Wash and dry saucepan, then place a fine mesh strainer over top. Pour ketchup in the strainer and, using a spatula, force through all of the ketchup.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Taste ketchup and adjust seasonings if necessary. Pour ketchup into a jar, seal, and store in the refrigerator.",
      "secondary_message": null
    }
  ],
