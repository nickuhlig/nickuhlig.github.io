  "instructions": [
    {
      "id": 627683,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 627684,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ mangoes\n3 red bell peppers\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 627685,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, about 10 minutes. Remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 627686,
      "primary_message": "Meanwhile, peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 627687,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the plate with the mango.",
      "secondary_message": null
    },
    {
      "id": 627688,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 627689,
      "primary_message": "Divide cheese between flatbreads, then top with mango and bell pepper. Return prepared flatbreads to the oven and bake until warmed through and cheese is melted, 7-8 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 627690,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n½ tsp basil, dried\n½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 627691,
      "primary_message": "When the flatbreads are almost done, add arugula to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 627692,
      "primary_message": "Cut each flatbread into wedges.",
      "secondary_message": null
    },
    {
      "id": 627693,
      "primary_message": "To serve, divide flatbreads between plates and top with a small handful of arugula. Serve remaining arugula on the side and enjoy!",
      "secondary_message": null
    }
  ],
