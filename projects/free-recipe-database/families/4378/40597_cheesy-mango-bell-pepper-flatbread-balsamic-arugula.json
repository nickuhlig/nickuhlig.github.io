  "instructions": [
    {
      "id": 627672,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 627673,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 mango\n2 red bell peppers\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 627674,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 627675,
      "primary_message": "Meanwhile, peel mango and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 627676,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the plate with the mango.",
      "secondary_message": null
    },
    {
      "id": 627677,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "⅔ (227 g) block mozzarella cheese"
    },
    {
      "id": 627678,
      "primary_message": "Divide cheese between flatbreads, then top with mango and bell pepper. Return prepared flatbreads to the oven and bake until warmed through and cheese is melted, 5-7 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 627679,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n¼ tsp basil, dried\n¼ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 627680,
      "primary_message": "When the flatbreads are almost done, add arugula to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 627681,
      "primary_message": "Cut each flatbread into wedges.",
      "secondary_message": null
    },
    {
      "id": 627682,
      "primary_message": "To serve, divide flatbreads between plates and top with a small handful of arugula. Serve remaining arugula on the side and enjoy!",
      "secondary_message": null
    }
  ],
