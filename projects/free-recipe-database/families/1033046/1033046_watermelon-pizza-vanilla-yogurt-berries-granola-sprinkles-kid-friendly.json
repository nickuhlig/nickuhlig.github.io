  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place yogurt, granola, and sprinkles each in their own small bowl and set aside. \n\n",
      "secondary_message": "2 cups vanilla Greek yogurt\n2 cups granola\n¼ cup rainbow sprinkles"
    },
    {
      "primary_message": "Wash and dry the fresh produce. \n\n",
      "secondary_message": "½ mini red seedless watermelon\n½ (6 oz) pkg blueberries\n½ (6 oz) pkg raspberries"
    },
    {
      "primary_message": "Cut 3 round (1-inch thick) \"pizzas\" from the center of the watermelon. Cut each round into 6 wedges and divide between plates. (You will have 6 plates in total, each with 3 pieces of watermelon pizza.) Reserve remaining watermelon for another use.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Decorate watermelon wedges with dollops of yogurt (for the sauce), then top with berries, granola, and sprinkles as desired.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Show off your creations and enjoy!",
      "secondary_message": null
    }
  ],
