  "instructions": [
    {
      "id": 587946,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 587947,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 587948,
      "primary_message": "Wash, dry, and quarter mushrooms. Place in a small bowl.",
      "secondary_message": "½ lb cremini mushrooms"
    },
    {
      "id": 587949,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the mushrooms. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 587950,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 587951,
      "primary_message": "While the skillet heats up, thinly slice sun-dried tomatoes. Add to the bowl with the veggies.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 587952,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, onion, sun-dried tomatoes, and spices; cook, stirring occasionally, until veggies start to soften, 2-3 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 587953,
      "primary_message": "Crumble tofu into large pieces with your fingers and add to the skillet. Continue to cook, stirring occasionally, until tofu is warmed through and golden, 6-8 minutes. Remove from heat. (Reserve baking sheet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 587954,
      "primary_message": "Meanwhile, wipe baking sheet dry with paper towels, then arrange bread on the baking sheet. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 587955,
      "primary_message": "While the bread is toasting, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 587956,
      "primary_message": "When the tofu is done, add parsley to skillet and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 587957,
      "primary_message": "To serve, divide tofu scramble and toast between plates. Enjoy!",
      "secondary_message": null
    }
  ],
