  "instructions": [
    {
      "id": 587970,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 587971,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 587972,
      "primary_message": "Wash, dry, and quarter mushrooms. Place in a medium bowl.",
      "secondary_message": "1 ½ lb cremini mushrooms"
    },
    {
      "id": 587973,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl with the mushrooms. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 587974,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 587975,
      "primary_message": "While the pot heats up, thinly slice sun-dried tomatoes. Add to the bowl with the veggies.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 587976,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, onion, sun-dried tomatoes, and spices; cook, stirring occasionally, until veggies start to soften, 3-4 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 587977,
      "primary_message": "Crumble tofu into large pieces with your fingers and add to the pot. Continue to cook, stirring occasionally, until tofu is warmed through and golden, 8-10 minutes. Remove from heat. (Reserve baking sheet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 587978,
      "primary_message": "Meanwhile, wipe baking sheet dry with paper towels, then divide bread between the reseved baking sheet and another large baking sheet. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 587979,
      "primary_message": "While the bread is toasting, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 587980,
      "primary_message": "When the tofu is done, add parsley to pot and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 587981,
      "primary_message": "To serve, divide tofu scramble and toast between plates. Enjoy!",
      "secondary_message": null
    }
  ],
