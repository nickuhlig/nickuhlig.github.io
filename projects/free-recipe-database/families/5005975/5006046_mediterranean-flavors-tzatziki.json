  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the ends from the cucumbers, then slice them lengthwise. Mince the garlic fine. Pick the dill fronds from the stems and mince them. Juice the lemon.",
      "secondary_message": "1 ½ cucumbers\n4 cloves garlic\n1 large handful dill\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "With a teaspoon, scoop out the seeds of the cucumbers. You should be left with a neat half-moon shape. Slice them thin, but not paper-thin—they should still have some crunch.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the cucumbers to a mixing bowl along with the rest of the ingredients. Taste for acid and seasoning, then either serve, or (preferably) cover and let it sit in the refrigerator for a few hours.",
      "secondary_message": null
    }
  ],
