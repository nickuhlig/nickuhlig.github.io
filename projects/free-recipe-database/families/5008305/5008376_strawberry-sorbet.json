  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Wash the strawberries.",
      "secondary_message": "1893 ml strawberries"
    },
    {
      "id": 1,
      "primary_message": "Remove tops from strawberries and purée in a blender or food processor until smooth. 2 quarts whole strawberries should yield 1 quart of purée. Add sugar and blend for 30 seconds. Add lemon and salt, blend to incorporate, and adjust to taste.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain purée and transfer to refrigerator; chill for 2 to 3 hours until very cold. Churn sorbet in ice cream maker according to manufacturer's instructions. Transfer sorbet to freezer to firm up for 2 to 3 hours before serving.",
      "secondary_message": null
    }
  ],
