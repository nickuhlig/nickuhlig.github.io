  "instructions": [
    {
      "id": 289826,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 289827,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n2 red bell peppers\n½ medium head cauliflower\n1 jalapeño pepper\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 289828,
      "primary_message": "Peel and medium dice potato; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 289829,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheet with the potato.",
      "secondary_message": null
    },
    {
      "id": 289830,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Separate into bite-sized florets and cut stems into smaller pieces; add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 289831,
      "primary_message": "Drizzle the veggies with oil and season with salt and pepper; toss to coat, then spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 289832,
      "primary_message": "Place baking sheet in the oven and roast until veggies start to soften, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 289833,
      "primary_message": "Meanwhile, halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Place in a blender. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 289834,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the blender with the jalapeño (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 289835,
      "primary_message": "Juice lime into the blender.",
      "secondary_message": null
    },
    {
      "id": 289836,
      "primary_message": "Peel garlic; add to the blender along with mayo, water, salt, and pepper. Purée on high until the sauce is smooth; set aside.",
      "secondary_message": "1 clove garlic\n3 tbsp vegan mayonnaise\n2 tbsp water\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 289837,
      "primary_message": "Slice sausages into 1-inch thick rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 289838,
      "primary_message": "Once the veggies start to soften, remove baking sheet from oven, add sausage, and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 289839,
      "primary_message": "Return baking sheet to the oven and continue to bake until veggies are tender and sausage is warmed through, 7-10 minutes more (or cook sausages according to package instructions). Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 289840,
      "primary_message": "To serve, divide veggies and sausage between bowls; pour sauce over top and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
