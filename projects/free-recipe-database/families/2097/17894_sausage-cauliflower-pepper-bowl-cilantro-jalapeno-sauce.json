  "instructions": [
    {
      "id": 289697,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 289698,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n2 red bell peppers\n½ medium head cauliflower\n1 jalapeño pepper\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 289699,
      "primary_message": "Peel and medium dice potato; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 289700,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheet with the potato.",
      "secondary_message": null
    },
    {
      "id": 289701,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Separate into bite-sized florets and cut stems into smaller pieces; add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 289702,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to coat, then spread out in an even layer. Add sausages to the baking sheet, nestling them into the veggies. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper\n2 pork sausages"
    },
    {
      "id": 289703,
      "primary_message": "Place baking sheet in the oven and roast until veggies are tender and sausages are cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 289704,
      "primary_message": "Meanwhile, halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Place in a blender. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 289705,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the blender with the jalapeño (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 289706,
      "primary_message": "Juice lime into the blender.",
      "secondary_message": null
    },
    {
      "id": 289707,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 289708,
      "primary_message": "Add mayo, water, salt, and pepper to the blender; purée on high until the sauce is smooth. Set aside.",
      "secondary_message": "3 tbsp mayonnaise\n2 tbsp water\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 289709,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into 1-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 289710,
      "primary_message": "To serve, divide veggies and sausage between bowls; pour sauce over top and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
