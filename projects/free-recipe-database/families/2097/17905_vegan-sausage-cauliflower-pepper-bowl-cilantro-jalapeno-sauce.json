  "instructions": [
    {
      "id": 289856,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 289857,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n6 red bell peppers\n1 ½ medium heads cauliflower\n3 jalapeño peppers\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 289858,
      "primary_message": "Peel and medium dice potatoes; divide between two baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 289859,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the potato.",
      "secondary_message": null
    },
    {
      "id": 289860,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Separate into bite-sized florets and cut stems into smaller pieces; add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 289861,
      "primary_message": "Drizzle the veggies with oil and season with salt and pepper; toss to coat, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 289862,
      "primary_message": "Place baking sheets in the oven and roast until veggies start to soften, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 289863,
      "primary_message": "Meanwhile, halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Place in a blender. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 289864,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the blender with the jalapeño (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 289865,
      "primary_message": "Juice limes into the blender.",
      "secondary_message": null
    },
    {
      "id": 289866,
      "primary_message": "Peel garlic; add to the blender along with mayo, water, salt, and pepper. Purée on high until the sauce is smooth; set aside.",
      "secondary_message": "3 cloves garlic\n½ cup vegan mayonnaise\n⅓ cup water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 289867,
      "primary_message": "Slice sausages into 1-inch thick rounds. ",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 289868,
      "primary_message": "Once the veggies start to soften, remove baking sheets from oven, add sausage, and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 289869,
      "primary_message": "Return baking sheets to the oven and continue to bake until veggies are tender and sausage is warmed through, about 10 minutes (or cook sausages according to package instructions). Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 289870,
      "primary_message": "To serve, divide veggies and sausage between bowls; pour sauce over top and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
