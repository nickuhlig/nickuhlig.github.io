  "instructions": [
    {
      "id": 289812,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 289813,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n6 red bell peppers\n1 ½ medium heads cauliflower\n3 jalapeño peppers\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 289814,
      "primary_message": "Peel and medium dice potatoes; divide between two baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 289815,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the potato.",
      "secondary_message": null
    },
    {
      "id": 289816,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Separate into bite-sized florets and cut stems into smaller pieces; add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 289817,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to coat, then spread out in an even layer. Add sausages to the baking sheets, nestling them into the veggies. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper\n6 pork sausages"
    },
    {
      "id": 289818,
      "primary_message": "Place baking sheets in the oven and roast until veggies are tender and sausages are cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 289819,
      "primary_message": "Meanwhile, halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Place in a blender. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 289820,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the blender with the jalapeño (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 289821,
      "primary_message": "Juice limes into the blender.",
      "secondary_message": null
    },
    {
      "id": 289822,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 289823,
      "primary_message": "Add mayo, water, salt, and pepper to the blender; purée on high until the sauce is smooth. Set aside.",
      "secondary_message": "½ cup mayonnaise\n⅓ cup water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 289824,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into 1-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 289825,
      "primary_message": "To serve, divide veggies and sausage between bowls; pour sauce over top and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
