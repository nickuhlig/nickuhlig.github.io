  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Refrigerate the apples until cold. Keep the heavy cream cold until you use it.",
      "secondary_message": "8 to 12 small apples\n255 g heavy cream"
    },
    {
      "id": 1,
      "primary_message": "Skewer apples with popsicle sticks, then return to fridge. In a 3-quart stainless steel saucier, combine water, sugar, and salt over medium heat. Stir with a fork until sugar is fully dissolved and syrup comes to a rolling boil, about 4 minutes. Simmer, without stirring, until syrup is honey-gold, roughly 9 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Immediately add cream (the mixture will sputter) and reduce heat to medium-low, stirring constantly with a heat-resistant spatula, until caramel registers 121°C on a digital thermometer, about 7 minutes. Transfer to a small heat-resistant bowl and cool to about 100°C.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Dip cold apples in caramel, letting excess drip off before transferring to a parchment-lined cutting board. Let stand at room temperature until fully set, about 10 minutes, and serve.",
      "secondary_message": null
    }
  ],
