  "instructions": [
    {
      "id": 370443,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Stack leaves on top of one another, then cut crosswise into thin (shred-like) ribbons. Place in a medium bowl.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 370444,
      "primary_message": "Sprinkle salt into the bowl with the kale. Using your hands, massage kale until slightly wilted, 1-2 minutes.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 370445,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the wilted kale and set aside.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 370446,
      "primary_message": "Peel and mince shallot. Place in a small bowl and set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 370447,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 370448,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 370449,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 370450,
      "primary_message": "Meanwhile, fill a medium saucepan about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pan is boiling, reduce heat to medium-low.",
      "secondary_message": "1 tbsp white wine vinegar"
    },
    {
      "id": 370451,
      "primary_message": "Gently crack eggs into two additional small bowls (two eggs per bowl).",
      "secondary_message": "4 eggs"
    },
    {
      "id": 370452,
      "primary_message": "Adjust the heat of the saucepan as necessary so that the water is simmering. Gently tip bowls into the pan, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using the slotted spoon, transfer eggs to the plate with the bacon.",
      "secondary_message": null
    },
    {
      "id": 370453,
      "primary_message": "Return skillet (with drippings) to medium heat. Add oil, shallot, pepper, and salt; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 370454,
      "primary_message": "Once the shallot has softened, remove from the heat. Whisk in the vinegar and Dijon, scraping the bottom of the skillet to incorporate any browned bits. Drizzle warm dressing into the bowl with the kale and beans. Toss to combine.",
      "secondary_message": "4 tsp white wine vinegar\n1 tsp Dijon mustard"
    },
    {
      "id": 370455,
      "primary_message": "To serve, divide the salad between plates or bowls. Top with crispy bacon and poached eggs. Enjoy!",
      "secondary_message": null
    }
  ],
