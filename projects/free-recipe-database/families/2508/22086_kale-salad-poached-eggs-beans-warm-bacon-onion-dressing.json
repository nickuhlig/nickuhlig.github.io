  "instructions": [
    {
      "id": 370430,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Stack leaves on top of one another, then cut crosswise into thin (shred-like) ribbons. Place in a large bowl.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 370431,
      "primary_message": "Sprinkle salt into the bowl with the kale. Using your hands, massage kale until slightly wilted, 2-3 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 370432,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the wilted kale and set aside.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 370433,
      "primary_message": "Peel, halve, and mince onion. Place in a small bowl and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 370434,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 370435,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 370436,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a large paper towel-lined plate; set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 370437,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pot is boiling, reduce heat to medium-low.",
      "secondary_message": "3 tbsp white wine vinegar"
    },
    {
      "id": 370438,
      "primary_message": "Gently crack eggs into additional small bowls (two eggs per bowl).",
      "secondary_message": "12 eggs"
    },
    {
      "id": 370439,
      "primary_message": "Adjust the heat of the pot as necessary so that the water is simmering. Working in batches, gently tip bowls into the pot, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using the slotted spoon, transfer eggs to the plate with the bacon.",
      "secondary_message": null
    },
    {
      "id": 370440,
      "primary_message": "Return skillet (with drippings) to medium heat. Add oil, onion, pepper, and salt; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 370441,
      "primary_message": "Once the onion has softened, remove from the heat. Whisk in the vinegar and Dijon, scraping the bottom of the skillet to incorporate any browned bits. Drizzle warm dressing into the bowl with the kale and beans. Toss to combine.",
      "secondary_message": "¼ cup white wine vinegar\n1 tbsp Dijon mustard"
    },
    {
      "id": 370442,
      "primary_message": "To serve, divide the salad between plates or bowls. Top with crispy bacon and poached eggs. Enjoy!",
      "secondary_message": null
    }
  ],
