  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in large skillet over medium-high heat until just smoking. Pat steak dry with paper towels and season with salt and pepper. Cook steak until well browned, 5 to 7 minutes per side. Transfer to cutting board and tent with foil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Reduce heat to medium. Melt butter in now empty skillet. Add onions, jalapeños, garlic, Worcestershire sauce, and sugar and season with salt and pepper. Cook, covered and stirring occasionally, until vegetables are soft and deep golden, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in cream and any accumulated beef juices and cook just to heat through, about 2 minutes. Adjust seasoning and stir in vinegar.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To assemble, slice steak thinly on the bias. Top one side of each roll with optional greens and arrange slices on top. Spoon sauce over steak. Serve warm.",
      "secondary_message": null
    }
  ],
