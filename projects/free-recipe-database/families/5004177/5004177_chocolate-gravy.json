  "instructions": [
    {
      "id": 1,
      "primary_message": "Whisk together sugar, cocoa, and flour in a medium saucepan until completely smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place saucepan over medium heat and whisking constantly, slowly add milk. Bring to a simmer and cook until gravy is thickened to a consistency a little thinner than pudding, about 3 minutes, whisking frequently.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in butter, vanilla, and salt. Remove from heat and serve immediately.",
      "secondary_message": null
    }
