  "instructions": [
    {
      "id": 138582,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n3 medium carrots\n3 sticks celery\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 138583,
      "primary_message": "Reserve ¾ cup of the chickpea liquid and place in a large bowl, then drain and rinse the chickpeas.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 138584,
      "primary_message": "Add half the chickpeas to the bowl with the bean liquid and mash well; stir in remaining chickpeas, leaving them whole.",
      "secondary_message": null
    },
    {
      "id": 138585,
      "primary_message": "Add vinegar, Dijon, chili-garlic sauce, and tomato paste to the chickpea mixture; stir to combine. Set aside. ",
      "secondary_message": "3 tbsp white wine vinegar\n2 tbsp Dijon mustard\n1 tbsp chili-garlic sauce\n3 tbsp tomato paste"
    },
    {
      "id": 138586,
      "primary_message": "To make the ranch dressing, combine mayonnaise and spices in a small bowl; whisk to combine. Add additional water (1 Tbsp at a time) as needed to reach a drizzling consistency.   ",
      "secondary_message": "½ cup vegan mayonnaise\n1 ½ tsp dill\n½ tsp parsley flakes\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 138587,
      "primary_message": "Remove leaves and thick stems from cauliflower; cut into bite-sized florets. Transfer to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 138588,
      "primary_message": "Peel and small dice onions and carrots; add to the bowl with the cauliflower. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 138589,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 138590,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 138591,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 138592,
      "primary_message": "Add cauliflower, onion, carrot, and garlic to the skillet and cook, stirring occasionally, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 138593,
      "primary_message": "Add chickpea mixture, salt, and pepper to the skillet and continue to cook until cauliflower is tender, 5-7 minutes. Taste the chickpea mixture and add more garlic-chili sauce (½ tsp at a time) to reach desired spiciness.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 138594,
      "primary_message": "Small dice celery.",
      "secondary_message": null
    },
    {
      "id": 138595,
      "primary_message": "Cut pita in half and carefully open the pita pockets.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 138596,
      "primary_message": "To serve, divide spinach, bean-cauliflower mixture, and celery between pita pockets. Top with ranch dressing and enjoy!",
      "secondary_message": null
    }
  ],
