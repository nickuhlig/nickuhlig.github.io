  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Crumble the breakfast sausage. Finely chop the jalapeño. Beat the eggs. Grate the cheddar cheese. Thinly slice the scallions.",
      "secondary_message": "0.45 kg breakfast sausage\n1 jalapeño\n5 large eggs\n1 ½ cups cheddar cheese\n½ cup scallions"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 205°C (400°F). Butter a soufflé or gratin dish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large stainless steel skillet over medium high heat, cook the sausage, stirring and breaking it up with a wooden spoon. When the fat begins to render, add the jalapeño. Continue to cook, breaking up the sausage with a wooden spoon, until sausage is browned, about 6 minutes total. Transfer mixture to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place butter and milk in a large saucepan and bring to a simmer. Once simmering, slowly whisk in corn meal and cook for 5 minutes, whisking constantly to prevent lumps. Pour cornmeal mixture over sausage and stir until all the ingredients are evenly combined. Cover with plastic wrap and let sit for 10 to 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Once cornmeal mixture has cooled fold eggs and cheese into cornmeal, then pour into prepared dish. Bake until spoonbread is set, 25 to 40 minutes. Sprinkle with sliced scallions and serve.",
      "secondary_message": null
    }
  ],
