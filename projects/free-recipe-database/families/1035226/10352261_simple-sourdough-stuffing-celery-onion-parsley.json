  "instructions": [
    {
      "primary_message": "Preheat oven to 300°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cut bread into 1-inch cubes, then divide between two large baking sheet pans. Place baking sheets in the oven (it doesn't have to be fully heated), and bake, stirring every 10 minutes, until bread is dried out, about 25 minutes. Remove from oven and set aside to cool, about 20 minutes.\n\n",
      "secondary_message": "1 (454 g) sourdough bread loaf"
    },
    {
      "primary_message": "Meanwhile, wash, dry, trim, and small dice celery. Place in a large bowl.\n\n",
      "secondary_message": "4 stick celery"
    },
    {
      "primary_message": "Preheat a large skillet over medium heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Add to the bowl with the celery.\n\n",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add celery, onion, and spices; cook, stirring occasionally, until softened, about 10 minutes. Remove from heat. (Reserve bowl for later use.)\n\n",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp poultry seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.\n\n",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "When the bread cubes are cool, add to the bowl with the parsley, along with the onion mixture and broth, then stir to combine. Set aside, stirring occasionally, until the broth is absorbed, about 10 minutes. \n\n",
      "secondary_message": "3 cups chicken or vegetable broth"
    },
    {
      "primary_message": "While the bread is soaking, set the oven to 350°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the broth has been absorbed, transfer bread cubes to a large baking dish and cover tightly with aluminum foil. Place baking dish in the oven and bake until stuffing is cooked through, about 35 minutes. Remove foil and continue to bake until stuffing is golden on top, 15 minutes more.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove stuffing from oven and let stand 5-10 minutes before serving. Enjoy!",
      "secondary_message": null
    }
  ],
