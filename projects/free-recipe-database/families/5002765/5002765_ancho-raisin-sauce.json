  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°F. Place chile on baking sheet and place in oven until puffed and aromatic, about 5 minutes. Remove from oven and let cool for 5 minutes. Stem and seed chile. Tear into large pieces.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place coffee, chile, and raisins in a small saucepan. Bring to a boil over high heat. Remove from heat and let steep until chile and raisins are very soft, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer mixture to a blender. Add in cocoa powder and puree until smooth. Set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Melt butter in now-empty saucepan over medium heat. When foaming subsides, add in onions; cook until softened, about 5 minutes. Stir in garlic and cook until fragrant, about 30 seconds. Stir in coffee puree, vinegar, and Worcestershire. Bring to a boil, reduce heat, and simmer until slightly thickened, about 10 minutes. Remove from heat, stir in ground coffee and season with salt and pepper to taste.",
      "secondary_message": null
    }
  ],
