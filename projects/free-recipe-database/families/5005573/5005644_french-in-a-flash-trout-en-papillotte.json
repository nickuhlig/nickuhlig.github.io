  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the oven to 400 degrees F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Rub the trout outside and in with olive oil to coat. The more thoroughly you do this, the less likely the fish will be to stick to the parchment. Season them each inside and out with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Open the trout up like a book, and stick 3 thyme and 3 rosemary bookmarks in the center. Add in 1 teaspoon of butter for good measure. Close the book--your place is saved for later. Place two slices of lemon on top of each trout.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Prepare the packages by tossing the fennel with 1 teaspoon of olive oil, salt, and pepper. Divide in half, and place a small mound in the middle of each sheet of parchment. Lay a trout on top of each fennel mountain. Then seal the package. Bring the edges of parchment parallel to the length of the fish up, and fold and fold and fold again until the fold rests sealed against the fish. Then folds the ends up like a Christmas gift, and fold under. All the folds will seal in the steam and the flavor.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake the trout for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Meanwhile, toss the watercress or pea shoots with a touch of olive oil, salt, pepper, and lemon juice. When the packages come out of the oven, cut them open at the table, and top with a bit of greenery.",
      "secondary_message": null
    }
  ],
