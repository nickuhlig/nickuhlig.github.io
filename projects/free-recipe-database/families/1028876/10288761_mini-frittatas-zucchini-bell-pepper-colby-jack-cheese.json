  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Coat 12 muffin cups with oil and set aside. (Alternatively, line a muffin pan with paper liners.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 leek\n1 medium zucchini squash\n½ red bell pepper"
    },
    {
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Finely chop and place in a large bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and small dice zucchini. Add to the bowl with the leek.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, trim, seed, and small dice bell pepper. Add to the bowl with the other veggies.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until tender, 5-6 minutes. Remove from heat. (Reserve bowl for the next step.)\n\n",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl. Whisk to combine.\n\n",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Add cooked veggies to the bowl with the egg mixture, along with cheese, and stir to combine. Evenly divide egg mixture between the muffin cups. \n\n",
      "secondary_message": "1 cup Colby jack cheese, shredded"
    },
    {
      "primary_message": "Place muffin pan in the preheated oven and bake until mini frittatas are firm and cooked through, about 20 minutes. Remove from oven and set aside to cool slightly, 5 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide mini frittatas between plates and enjoy!",
      "secondary_message": null
    }
  ],
