  "instructions": [
    {
      "id": 351653,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 351654,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 small bunch cilantro\n3 limes\n3 avocados"
    },
    {
      "id": 351655,
      "primary_message": "Trim, seed, and small dice bell peppers; place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 351656,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the bell pepper and set aside.",
      "secondary_message": null
    },
    {
      "id": 351657,
      "primary_message": "Pat fish dry with paper towels and transfer to a large baking sheet pan. Drizzle both sides with oil, arrange skin-side down, then season top side with spices. ",
      "secondary_message": "1.02 kg salmon fillet\n2 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cumin, ground"
    },
    {
      "id": 351658,
      "primary_message": "Place baking sheet in the oven and broil until salmon is just opaque, about 5 minutes. Flip salmon and continue to broil until the skin is crispy, 3-4 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 351659,
      "primary_message": "Meanwhile, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 351660,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, cilantro, corn, salt, and pepper; cook, stirring occasionally, until veggies are tender, about 5 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ cups frozen corn\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 351661,
      "primary_message": "While the veggies are cooking, peel and mince shallots and garlic. Place both in the reserved bowl. ",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 351662,
      "primary_message": "Juice half of the limes into the bowl with the shallot and garlic. (Cut remaining limes into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 351663,
      "primary_message": "Halve and pit avocados; using a spoon, scoop the flesh into the bowl. Add spices and mash with a fork or potato masher until guacamole is smooth.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper\n¼ tsp chili powder"
    },
    {
      "id": 351664,
      "primary_message": "Roughly chop walnuts, add to the bowl with the guacamole, and stir to combine.",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 351665,
      "primary_message": "Divide salmon and veggies between plates; top salmon with guacamole and serve with lime wedges for squeezing. Enjoy! ",
      "secondary_message": null
    }
  ],
