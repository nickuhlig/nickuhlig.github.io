  "instructions": [
    {
      "id": 351736,
      "primary_message": "Cut tofu into ½-inch thick slices along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 351737,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 351738,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 small bunch cilantro\n3 limes\n3 avocados"
    },
    {
      "id": 351739,
      "primary_message": "Trim, seed, and small dice bell pepper; place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 351740,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the bell pepper and set aside. ",
      "secondary_message": null
    },
    {
      "id": 351741,
      "primary_message": "Place oil and spices in a small bowl; whisk to combine the spice oil. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cumin, ground"
    },
    {
      "id": 351742,
      "primary_message": "Transfer tofu to a large baking sheet and drizzle both sides with the spice oil. Place tofu in the oven and broil, flipping halfway through, until golden brown, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 351743,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 351744,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, cilantro, corn, salt, and pepper; cook, stirring occasionally, until veggies are tender, about 5 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ cups frozen corn\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 351745,
      "primary_message": "While the veggies are cooking, peel and mince shallots and garlic. Place both in the reserved bowl. ",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 351746,
      "primary_message": "Juice half of the limes into the bowl with the shallot and garlic. (Cut remaining limes into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 351747,
      "primary_message": "Halve and pit avocados; using a spoon, scoop the flesh into the bowl. Add spices and mash with a fork or potato masher until guacamole is smooth.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper\n¼ tsp chili powder"
    },
    {
      "id": 351748,
      "primary_message": "Roughly chop walnuts, add to the bowl with the guacamole, and stir to combine. ",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 351749,
      "primary_message": "Divide tofu and veggies between plates; top tofu with guacamole and serve with lime wedges for squeezing. Enjoy! ",
      "secondary_message": null
    }
  ],
