  "instructions": [
    {
      "id": 351560,
      "primary_message": "Cut tofu into ½-inch thick slices along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 351561,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 351562,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 small bunch cilantro\n2 limes\n2 avocados"
    },
    {
      "id": 351563,
      "primary_message": "Trim, seed, and small dice bell pepper; place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 351564,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the bell pepper and set aside. ",
      "secondary_message": null
    },
    {
      "id": 351565,
      "primary_message": "Place oil and spices in another small bowl; whisk to combine the spice oil. ",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp chili powder\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper\n½ tsp cumin, ground"
    },
    {
      "id": 351566,
      "primary_message": "Transfer tofu to another baking sheet and drizzle both sides with the spice oil. Place tofu in the oven and broil, flipping halfway through, until golden brown, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 351567,
      "primary_message": "Meanwhile, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 351568,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, cilantro, corn, salt, and pepper; cook, stirring occasionally, until veggies are tender, about 5 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 cup frozen corn\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 351569,
      "primary_message": "While the veggies are cooking, peel and mince shallot and garlic. Place both in the reserved bowl. ",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 351570,
      "primary_message": "Juice one lime into the bowl with the shallot and garlic. (Cut remaining lime into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 351571,
      "primary_message": "Halve and pit avocados; using a spoon, scoop the flesh into the bowl. Add spices and mash with a fork or potato masher until guacamole is smooth.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper\n¼ tsp chili powder"
    },
    {
      "id": 351572,
      "primary_message": "Roughly chop walnuts, add to the bowl with the guacamole, and stir to combine. ",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 351573,
      "primary_message": "Divide tofu and veggies between plates; top tofu with guacamole and serve with lime wedges for squeezing. Enjoy! ",
      "secondary_message": null
    }
  ],
