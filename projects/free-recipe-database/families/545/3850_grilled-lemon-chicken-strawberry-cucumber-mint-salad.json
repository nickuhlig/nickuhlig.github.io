  "instructions": [
    {
      "id": 42634,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (454 g) pkg strawberries\n1 English cucumber\n½ lemon\n½ small pkg fresh mint"
    },
    {
      "id": 42635,
      "primary_message": "In a medium salad bowl, combine and whisk together olive oil, balsamic vinegar, honey, salt, and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp balsamic vinegar\n¼ tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 42636,
      "primary_message": "Trim off and discard the stem ends of the strawberries; quarter the strawberries lengthwise and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42637,
      "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into 6-mm-thick pieces at an angle. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42638,
      "primary_message": "Pick the mint leaves off the stems; discard the stems and roughly chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42639,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 42640,
      "primary_message": "Juice the lemon into a medium bowl (that is big enough to hold the chicken breasts). Then, add the minced garlic, olive oil, salt, and pepper; whisk together.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42641,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 42642,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "0.34 kg chicken breasts, boneless skinless"
    },
    {
      "id": 42643,
      "primary_message": "Place the chicken cutlets in the medium bowl and turn to thoroughly coat in the marinade.",
      "secondary_message": null
    },
    {
      "id": 42644,
      "primary_message": "Once the grill pan / skillet is hot, add the chicken cutlets and pour any remaining marinade overtop. Cook until the chicken is cooked through, 2 to 4 minutes per side. Once done, transfer to a plate. Cook in batches if necessary.",
      "secondary_message": ""
    },
    {
      "id": 42645,
      "primary_message": "Toss the salad until well coated with the dressing.",
      "secondary_message": null
    },
    {
      "id": 42646,
      "primary_message": "To serve, divide the chicken cutlets between plates and top with the salad. Enjoy!",
      "secondary_message": ""
    }
  ],
