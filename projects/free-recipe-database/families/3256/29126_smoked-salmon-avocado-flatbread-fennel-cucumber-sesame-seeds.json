  "instructions": [
    {
      "id": 464868,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 464869,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n2 limes\n2 fennel bulbs\n1 English cucumber\n1 avocado"
    },
    {
      "id": 464870,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 464871,
      "primary_message": "Juice limes into the bowl with the dill. Add yogurt, oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464872,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464873,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 464874,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 464875,
      "primary_message": "Meanwhile, chop or tear smoked salmon into bite-sized pieces.",
      "secondary_message": "2 (113 g) pkgs smoked salmon"
    },
    {
      "id": 464876,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and place in a small bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": null
    },
    {
      "id": 464877,
      "primary_message": "To serve, spread toasted flatbreads with mashed avocado, then top with salad and smoked salmon. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
