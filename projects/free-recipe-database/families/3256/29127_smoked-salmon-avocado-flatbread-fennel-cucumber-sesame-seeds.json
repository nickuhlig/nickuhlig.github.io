  "instructions": [
    {
      "id": 464878,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 464879,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n3 limes\n3 fennel bulbs\n1 ½ English cucumbers\n1 ½ avocados"
    },
    {
      "id": 464880,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 464881,
      "primary_message": "Juice limes into the bowl with the dill. Add yogurt, oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "⅓ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464882,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464883,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 464884,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 464885,
      "primary_message": "Meanwhile, chop or tear smoked salmon into bite-sized pieces.",
      "secondary_message": "3 (113 g) pkgs smoked salmon"
    },
    {
      "id": 464886,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and place in a small bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": null
    },
    {
      "id": 464887,
      "primary_message": "To serve, spread toasted flatbreads with mashed avocado, then top with salad and smoked salmon. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
