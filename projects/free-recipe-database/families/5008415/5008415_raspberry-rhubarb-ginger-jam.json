  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the rhubarb. Zest and juice the lemon. Mince the crystallized ginger. Grate the ginger.",
      "secondary_message": "8 cups rhubarb\n1 lemon\n¼ cup crystallized ginger\n1 tbsp ginger root"
    },
    {
      "id": 1,
      "primary_message": "Whisk the sugar and pectin in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine the rhubarb and 1/2 cup water in a large saucepan. Bring to a boil, then reduce heat, cover, and simmer just until the rhubarb breaks down, 10 to 12 minutes. Meanwhile, puree the raspberries in a food processor or blender. You should have 1/2 cup.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Measure the stewed rhubarb. You should have 4 cups. Return the rhubarb and the pureed raspberries to the saucepan. Add lemon zest and juice and calcium water and bring to a boil over medium-high heat. Add the sugar-pectin mixture, crystallized ginger, and grated ginger and return the fruit mixture to a boil, stirring constantly. Boil hard for one minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove the pot from the heat and skim any foam from the surface of the jam with a cold metal spoon. Ladle the jam into hot sterilized jars and process them in a hot water bath for 10 minutes.",
      "secondary_message": null
    }
  ],
