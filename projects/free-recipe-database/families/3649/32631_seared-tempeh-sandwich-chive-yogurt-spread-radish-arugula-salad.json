  "instructions": [
    {
      "id": 522432,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg chives\n1 ½ bunches radish\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 522433,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 522434,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces and place in a large bowl. Add soy sauce and spices, then gently stir to coat.",
      "secondary_message": "3 (8 oz) packages tempeh\n3 tbsp soy sauce\n¾ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522435,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh in a single layer (leaving any excess sauce in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat. (Wipe bowl clean and reserve for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 522436,
      "primary_message": "Meanwhile, chop chives into small pieces. Place in a small bowl along with yogurt, mayo, Dijon, and spices. Stir to combine the yogurt spread and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tbsp Dijon mustard\n¾ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 522437,
      "primary_message": "Place oil, vinegar, maple syrup, salt, and pepper in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522438,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add half to the bowl with the dressing. (Reserve remaining onion for the sandwiches.)",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 522439,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 522440,
      "primary_message": "Set aside a handful of arugula for the sandwiches. Add remaining arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 522441,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 522442,
      "primary_message": "To assemble the sandwiches, spread each bread slice with chive yogurt. Layer half of the slices with tempeh and reserved onion and arugula; close with remaining slices and cut in half.",
      "secondary_message": null
    },
    {
      "id": 522443,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
