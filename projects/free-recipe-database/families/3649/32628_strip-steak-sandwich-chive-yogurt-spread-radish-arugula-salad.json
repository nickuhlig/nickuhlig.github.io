  "instructions": [
    {
      "id": 522395,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg chives\n1 ½ bunches radish\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 522396,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 522397,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 522398,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 522399,
      "primary_message": "Meanwhile, chop chives into small pieces. Place in a small bowl along with yogurt, mayo, Dijon, and spices. Stir to combine the yogurt spread and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tbsp Dijon mustard\n¾ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 522400,
      "primary_message": "Place oil, vinegar, maple syrup, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522401,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add half to the bowl with the dressing. (Reserve remaining onion for the sandwiches.)",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 522402,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 522403,
      "primary_message": "Set aside a handful of arugula for the sandwiches. Add remaining arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 522404,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 522405,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 522406,
      "primary_message": "To assemble the sandwiches, spread each bread slice with chive yogurt. Layer half of the slices with steak and reserved onion and arugula; close with remaining slices and cut in half.",
      "secondary_message": null
    },
    {
      "id": 522407,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
