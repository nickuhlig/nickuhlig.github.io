  "instructions": [
    {
      "id": 522382,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg chives\n1 bunch radish\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 522383,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 522384,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522385,
      "primary_message": "Once the pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 522386,
      "primary_message": "Meanwhile, chop chives into small pieces. Place in a small bowl along with yogurt, mayo, Dijon, and spices. Stir to combine the yogurt spread and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tsp Dijon mustard\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522387,
      "primary_message": "Place oil, vinegar, maple syrup, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp red wine vinegar\n2 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522388,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add half to the bowl with the dressing. (Reserve remaining onion for the sandwiches.)",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 522389,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 522390,
      "primary_message": "Set aside a handful of arugula for the sandwiches. Add remaining arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 522391,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 522392,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 522393,
      "primary_message": "To assemble the sandwiches, spread each bread slice with chive yogurt. Layer half of the slices with steak and reserved onion and arugula; close with remaining slices and cut in half.",
      "secondary_message": null
    },
    {
      "id": 522394,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
