  "instructions": [
    {
      "id": 522456,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg chives\n1 bunch radish\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 522457,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 522458,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces and place in a medium bowl. Add soy sauce and spices, then gently stir to coat.",
      "secondary_message": "2 (8 oz) packages tempeh\n2 tbsp soy sauce\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522459,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tempeh in a single layer (leaving any excess sauce in the bowl) and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat. (Wipe bowl clean and reserve for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 522460,
      "primary_message": "Meanwhile, chop chives into small pieces. Place in a small bowl along with mayo, water, Dijon, and spices. Stir to combine the chive spread and set aside.",
      "secondary_message": "⅓ cup vegan mayonnaise\n2 tsp water\n2 tsp Dijon mustard\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522461,
      "primary_message": "Place oil, vinegar, maple syrup, salt, and pepper in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp red wine vinegar\n2 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 522462,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add half to the bowl with the dressing. (Reserve remaining onion for the sandwiches.)",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 522463,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 522464,
      "primary_message": "Set a handful of arugula aside for the sandwiches. Add remaining arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 522465,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 522466,
      "primary_message": "To assemble the sandwiches, spread each bread slice with chive mayo. Layer half of the slices with tempeh and reserved onion and arugula; close with remaining slices and cut in half.",
      "secondary_message": null
    },
    {
      "id": 522467,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
