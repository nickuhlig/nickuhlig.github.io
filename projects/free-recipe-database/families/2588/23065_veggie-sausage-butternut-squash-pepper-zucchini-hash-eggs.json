  "instructions": [
    {
      "id": 418413,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 418414,
      "primary_message": "Wash, dry, trim, seed, and medium dice bell pepper. Transfer to a baking sheet pan.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 418415,
      "primary_message": "Wash, dry, trim, and medium dice zucchini. Add to the baking sheet with the bell pepper.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 418416,
      "primary_message": "Peel, halve, and small dice onion. Add to the baking sheet along with butternut squash. Drizzle veggies with oil, then season with Cajun seasoning and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "½ medium yellow onion\n2 cup frozen butternut squash, pieces\n1 tbsp extra virgin olive oil\n2 tsp Cajun seasoning\n¼ tsp salt"
    },
    {
      "id": 418417,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until veggies start to soften, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 418418,
      "primary_message": "While the veggies are baking, thinly slice sausages.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 418419,
      "primary_message": "When the veggies are starting to soften, remove baking sheet from the oven. Add the sausage and stir to combine, then sprinkle with cheese.",
      "secondary_message": "½ cup shredded cheese, Mexican blend"
    },
    {
      "id": 418420,
      "primary_message": "Return baking sheet to the oven and continue to bake until veggies are soft and cheese is melted, 5-6 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 418421,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 418422,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "1 tsp extra virgin olive oil\n4 eggs\n1 pinch salt"
    },
    {
      "id": 418423,
      "primary_message": "To serve divide the hash and eggs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
