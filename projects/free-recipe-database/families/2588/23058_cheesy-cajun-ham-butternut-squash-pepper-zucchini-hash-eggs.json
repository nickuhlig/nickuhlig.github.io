  "instructions": [
    {
      "id": 418336,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 418337,
      "primary_message": "Wash, dry, trim, seed, and medium dice bell peppers. Divide between two baking sheet pans. ",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 418338,
      "primary_message": "Wash, dry, trim, and medium dice zucchini. Add to the baking sheet with the bell pepper.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 418339,
      "primary_message": "Peel, halve, and small dice onions. Add to the baking sheets along with butternut squash. Drizzle veggies with oil, then season with Cajun seasoning and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 ½ medium yellow onions\n6 cup frozen butternut squash, pieces\n3 tbsp extra virgin olive oil\n2 tbsp Cajun seasoning\n¾ tsp salt"
    },
    {
      "id": 418340,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until veggies start to soften, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 418341,
      "primary_message": "While the veggies are baking, medium dice ham.",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 418342,
      "primary_message": "When the veggies are starting to soften, remove baking sheets from the oven. Add the ham and stir to combine, then sprinkle with cheese.",
      "secondary_message": "2 cups shredded cheese, Mexican blend"
    },
    {
      "id": 418343,
      "primary_message": "Return baking sheets to the oven and continue to bake until veggies are soft and cheese is melted, 6-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 418344,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 418345,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tbsp extra virgin olive oil\n12 eggs\n3 pinch salt"
    },
    {
      "id": 418346,
      "primary_message": "To serve divide the hash and eggs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
