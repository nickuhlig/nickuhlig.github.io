  "instructions": [
    {
      "id": 392064,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 jalapeño pepper\n1 English cucumber"
    },
    {
      "id": 392065,
      "primary_message": "Drain and rinse lentils in a colander. Using the back of a spoon, gently press on the lentils to remove excess liquid, then transfer to a medium bowl. Use a fork or potato masher to crush the lentils until they are broken down.",
      "secondary_message": "2 (15 oz) cans lentils"
    },
    {
      "id": 392066,
      "primary_message": "Juice lemon into the bowl with the lentils.",
      "secondary_message": null
    },
    {
      "id": 392067,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 392068,
      "primary_message": "Add oil, Dijon, and spices to the bowl. Stir to combine the lentil pâté.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n½ tsp cumin, ground\n¼ tsp garlic powder\n¼ tsp onion powder"
    },
    {
      "id": 392069,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 392070,
      "primary_message": "To serve, divide lentil pâté and cucumber slices between plates. Enjoy!",
      "secondary_message": null
    }
  ],
