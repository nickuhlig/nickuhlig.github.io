  "instructions": [
    {
      "id": 392092,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ jalapeño peppers\n1 ½ English cucumbers"
    },
    {
      "id": 392093,
      "primary_message": "Drain and rinse lentils in a colander. Using the back of a spoon, gently press on the lentils to remove excess liquid, then transfer to a medium bowl. Use a fork or potato masher to crush the lentils until they are broken down.",
      "secondary_message": "3 (255 g) cans lentils"
    },
    {
      "id": 392094,
      "primary_message": "Juice lemons into the bowl with the lentils.",
      "secondary_message": null
    },
    {
      "id": 392095,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 392096,
      "primary_message": "Add oil, Dijon, and spices to the bowl. Stir to combine the lentil pâté.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp cumin, ground\n½ tsp garlic powder\n½ tsp onion powder"
    },
    {
      "id": 392097,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 392098,
      "primary_message": "To serve, divide lentil pâté and cucumber slices between plates. Enjoy!",
      "secondary_message": null
    }
  ],
