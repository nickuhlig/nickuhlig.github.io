  "instructions": [
    {
      "id": 148146,
      "primary_message": "Rinse lentils under cold water and transfer to a medium saucepan. Add water and salt; bring to a boil, then reduce the heat to a simmer, cover with a lid, and cook until the lentils are tender, 15-20 minutes.",
      "secondary_message": "½ cup red lentils\n1 cup water\n½ tsp salt"
    },
    {
      "id": 148147,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 148148,
      "primary_message": "Preheat a skillet over medium-high heat. Add oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 148149,
      "primary_message": "Add onions and garlic; sauté, until onions are translucent, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 148150,
      "primary_message": "Meanwhile, wash, dry, and slice the mushrooms. ",
      "secondary_message": "0.23 kg cremini mushrooms"
    },
    {
      "id": 148151,
      "primary_message": "Add mushrooms, more oil, and salt to the skillet and cook, stirring occasionally, for 5-10 minutes, until the liquid released by the mushrooms has mostly cooked off. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 148152,
      "primary_message": "Add tomatoes and their juices, tomato paste, oregano, and thyme; stir to combine. Reduce heat to medium and simmer, stirring occasionally, for 3-5 minutes. ",
      "secondary_message": "1 (398 ml) can diced tomatoes\n4 tbsp tomato paste\n1 tsp oregano\n½ tsp thyme"
    },
    {
      "id": 148153,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 148154,
      "primary_message": "Stir the lentils and basil into the sauce and continue to simmer. ",
      "secondary_message": null
    },
    {
      "id": 148155,
      "primary_message": "Wash zucchini, trim ends, and use a julienne (or regular) peeler to make noodles. Use paper towel or a clean dish cloth to squeeze excess moisture out of the zucchini noodles. ",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 148156,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 148157,
      "primary_message": "To serve, divide noodles between plates; top with the hot sauce to warm the noodles. Sprinkle with cheese and enjoy!",
      "secondary_message": null
    }
  ],
