  "instructions": [
    {
      "id": 506905,
      "primary_message": "Preheat oven to 475°F.",
      "secondary_message": null
    },
    {
      "id": 506906,
      "primary_message": "Peel and mince garlic; place in a small bowl along with oil, vinegar, Dijon, salt, and pepper. Whisk to combine the Dijon sauce and set aside.",
      "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 506907,
      "primary_message": "Wash and dry cabbage, then trim off and discard the root end. Quarter cabbage lengthwise; transfer to a baking sheet pan, cut-side down.",
      "secondary_message": "1 medium head napa cabbage"
    },
    {
      "id": 506908,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, turning each cabbage wedge onto the other cut-side halfway through, until starting to soften, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 506909,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 506910,
      "primary_message": "While the skillet heats up, cut the steak into portions, pat dry with paper towels, and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 506911,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 506912,
      "primary_message": "Meanwhile, wash, dry, and, using a clean cutting board, thinly slice mushrooms.",
      "secondary_message": "1 lb white mushrooms"
    },
    {
      "id": 506913,
      "primary_message": "When the cabbage is soft, remove baking sheet from the oven and turn wedges once more, so the cut-sides face up; drizzle with Dijon sauce.",
      "secondary_message": null
    },
    {
      "id": 506914,
      "primary_message": "Set oven to broil on high and return baking sheet to the oven. Broil until cabbage is golden brown and lightly charred around the edges, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 506915,
      "primary_message": "When the steak is done, return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add mushrooms, salt, and pepper; cook, stirring often, until soft and golden, about 4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 506916,
      "primary_message": "To serve, divide steak and roasted cabbage between plates. Top steak with mushrooms and enjoy!",
      "secondary_message": null
    }
  ],
