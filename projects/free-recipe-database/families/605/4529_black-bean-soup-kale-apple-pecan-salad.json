  "instructions": [
    {
      "id": 51964,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n1 Gala apple\n½ bunch kale"
    },
    {
      "id": 51965,
      "primary_message": "Quarter the bell pepper lengthwise; remove and discard the stem, seeds, and membranes. Small dice the pepper (cut into ¼-inch cubes) and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 51966,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 51967,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch cubes) and add to the bell pepper.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 51968,
      "primary_message": "Once the saucepan is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 51969,
      "primary_message": "Add the bell pepper and onion to the saucepan; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 51970,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 51971,
      "primary_message": "Add the garlic, cumin, and crushed red pepper to the saucepan; cook, stirring constantly, until fragrant, 15 to 30 seconds.",
      "secondary_message": "½ tsp cumin\n¼ tsp crushed red pepper"
    },
    {
      "id": 51972,
      "primary_message": "Add the broth and beans (with their liquid) to the saucepan; season with salt and pepper. Increase the heat to high and bring to a boil. Once boiling, reduce to a simmer, cover, and cook for 15 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n1 (15 oz) can black beans\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 51973,
      "primary_message": "In a medium salad bowl, combine and whisk together olive oil, apple cider vinegar, maple syrup, salt, and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tbsp apple cider vinegar\n½ tsp maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 51974,
      "primary_message": "Cut out and discard the kale stems; chop the leaves crosswise into ½-inch strips. Add the kale to the salad bowl and, using your hands, massage the dressing into the leaves.",
      "secondary_message": null
    },
    {
      "id": 51975,
      "primary_message": "Quarter the apple lengthwise, then cut out the core and stem from each section; cut each quarter lengthwise into thin wedges. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 51976,
      "primary_message": "Roughly chop the pecans and add to the salad bowl. Toss the salad to combine.",
      "secondary_message": "⅛ cup pecans, dry roasted"
    },
    {
      "id": 51977,
      "primary_message": "Using an immersion (hand) blender, purée the soup until the desired consistently is reached. Alternatively, mash the beans with a potato masher.",
      "secondary_message": ""
    },
    {
      "id": 51978,
      "primary_message": "To serve, divide the soup between bowls. Arrange the kale salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
