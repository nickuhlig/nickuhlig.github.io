  "instructions": [
    {
      "id": 46239,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 Gala apples\n1 bunch kale"
    },
    {
      "id": 46240,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Small dice the peppers (cut into 6-mm cubes) and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 46241,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 46242,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm cubes) and add to the bell peppers.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 46243,
      "primary_message": "Once the saucepan is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 46244,
      "primary_message": "Add the bell peppers and onion to the saucepan; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 46245,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 46246,
      "primary_message": "Add the garlic, cumin, and crushed red pepper to the saucepan; cook, stirring constantly, until fragrant, 15 to 30 seconds.",
      "secondary_message": "1 tsp cumin\n½ tsp crushed red pepper"
    },
    {
      "id": 46247,
      "primary_message": "Add the broth and beans (with their liquid) to the saucepan; season with salt and pepper. Increase the heat to high and bring to a boil. Once boiling, reduce to a simmer, cover, and cook for 15 minutes.",
      "secondary_message": "473 ml (2 cups) chicken or vegetable broth\n2 (398 ml) cans black beans\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 46248,
      "primary_message": "In a large salad bowl, combine and whisk together olive oil, apple cider vinegar, honey, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 46249,
      "primary_message": "Cut out and discard the kale stems; chop the leaves crosswise into 1 ¼-cm strips. Add the kale to the salad bowl and, using your hands, massage the dressing into the leaves.",
      "secondary_message": null
    },
    {
      "id": 46250,
      "primary_message": "Quarter the apples lengthwise, then cut out the core and stem from each section; cut each quarter lengthwise into thin wedges. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 46251,
      "primary_message": "Roughly chop the pecans and add to the salad bowl. Toss the salad to combine.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 46252,
      "primary_message": "Using an immersion (hand) blender, purée the soup until the desired consistently is reached. Alternatively, mash the beans with a potato masher.",
      "secondary_message": ""
    },
    {
      "id": 46253,
      "primary_message": "To serve, divide the soup between bowls and garnish with feta. Serve with the kale salad on the side. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
