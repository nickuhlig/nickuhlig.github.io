  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the eggplant into 1/4-inch dice. Pick the basil leaves from the stems and chop them.",
      "secondary_message": "1 eggplant\n¼ cup fresh basil leaves"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a large saucepan over medium high heat. When oil is hot but not smoking, add eggplant. Sauté for two minutes, then add tomatoes and chili flakes. Reduce heat to low and simmer for 40 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring a large pot of water to a boil and cook penne, according to box, until al dente. Drain pasta.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "If making for Valentine's Day, cut four 0.5 cm slices of mozzarella. Cut each slice into a heart and set aside. Dice remaining mozzarella.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Season sauce with salt and pepper to taste. Add penne and mozzarella to sauce pan and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Divide pasta among plates, garnishing each with basil and a mozzarella heart.",
      "secondary_message": null
    }
  ],
