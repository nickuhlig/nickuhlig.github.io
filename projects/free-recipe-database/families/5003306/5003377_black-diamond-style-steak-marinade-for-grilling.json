  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large zipper-lock bag, combine Worcestershire, soy sauce, balsamic vinegar, garlic powder, onion powder, and a generous grinding of black pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add steak to bag, press out air, and seal. Refrigerate for at least 1 hour and up to 12 hours. When ready to cook, remove steak from marinade, blot dry with paper towels, and grill as desired.",
      "secondary_message": null
    }
