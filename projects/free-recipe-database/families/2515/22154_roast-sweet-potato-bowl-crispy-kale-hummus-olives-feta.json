  "instructions": [
    {
      "id": 371286,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 371287,
      "primary_message": "Wash and dry sweet potatoes. Peel and cut each potato lengthwise into 4-6 wedges, depending on size, then transfer to a large baking sheet pan. Drizzle with oil, season with spices, and toss to coat. Spread wedges out in an even layer.",
      "secondary_message": "0.68 kg sweet potato\n4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 371288,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until potatoes begin to soften, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 371289,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise. Place on a plate.",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 371290,
      "primary_message": "Halve olives lengthwise. Add to the plate with the tomatoes and set aside.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 371291,
      "primary_message": "Place kale in a large bowl, drizzle with oil, and season with spices. Toss to coat.",
      "secondary_message": "1 (283 g) bag kale, cut and ready to use\n4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 371292,
      "primary_message": "Remove sweet potatoes from the oven and flip using tongs. Add kale to the baking sheet, spreading it out over the sweet potatoes.",
      "secondary_message": null
    },
    {
      "id": 371293,
      "primary_message": "Return baking sheet to the oven and continue to roast until kale is crispy and potatoes can be pierced easily with a fork, 8-10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 371294,
      "primary_message": "To serve, divide roasted sweet potatoes and crispy kale between bowls; top with hummus, tomatoes, olives, and feta. Enjoy!",
      "secondary_message": "2 cups hummus\n1 (113 g) pkg crumbled feta cheese"
    }
  ],
