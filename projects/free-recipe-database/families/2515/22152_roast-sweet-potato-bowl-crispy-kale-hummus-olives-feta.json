  "instructions": [
    {
      "id": 371268,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 371269,
      "primary_message": "Wash and dry sweet potatoes. Peel and cut each potato lengthwise into 4-6 wedges, depending on size, then divide between two large baking sheet pans. Drizzle with oil, season with spices, and toss to coat. Spread wedges out in an even layer.",
      "secondary_message": "2 ¼ lb sweet potatoes\n2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 371270,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until potatoes begin to soften, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 371271,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise. Place on a large plate.",
      "secondary_message": "1 ½ pints grape tomatoes"
    },
    {
      "id": 371272,
      "primary_message": "Halve olives lengthwise. Add to the plate with the tomatoes and set aside.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 371273,
      "primary_message": "Place kale in a large bowl, drizzle with oil, and season with spices. Toss to coat.",
      "secondary_message": "1 ½ (10 oz) bags kale, cut and ready to use\n2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 371274,
      "primary_message": "Remove sweet potatoes from the oven and flip using tongs. Add kale to the baking sheets, spreading it out over the sweet potatoes.",
      "secondary_message": null
    },
    {
      "id": 371275,
      "primary_message": "Return baking sheets to the oven and continue to roast until kale is crispy and potatoes can be pierced easily with a fork, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 371276,
      "primary_message": "To serve, divide roasted sweet potatoes and crispy kale between bowls; top with hummus, tomatoes, olives, and feta. Enjoy!",
      "secondary_message": "3 cups hummus\n1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
