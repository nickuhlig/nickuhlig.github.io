  "instructions": [
    {
      "id": 114812,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch cilantro\n2 avocados"
    },
    {
      "id": 114813,
      "primary_message": "Peel and mince the shallot and garlic; place both in a medium bowl.",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 114814,
      "primary_message": "Drain and discard the juices from the can of diced tomatoes. Place the tomatoes in the bowl with the shallot and garlic.",
      "secondary_message": "1 (398 ml) can diced tomatoes"
    },
    {
      "id": 114815,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the tomatoes; reserving a small amount for garnish.",
      "secondary_message": null
    },
    {
      "id": 114816,
      "primary_message": "Juice the lime and add to the bowl with the tomatoes. Add the salt and stir to combine; set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 114817,
      "primary_message": "Preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 114818,
      "primary_message": "Whisk the eggs in a large bowl.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 114819,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 114820,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 114821,
      "primary_message": "Toast bread, working in batches if necessary.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 114822,
      "primary_message": "Halve and pit the avocado, then scoop the flesh out into a medium bowl. Mash with a fork, add the spices and stir to combine.",
      "secondary_message": "½ tsp salt\n½ tsp cayenne pepper\n1 tsp crushed red pepper"
    },
    {
      "id": 114823,
      "primary_message": "To assemble, spread the avocado mixture on top of each slice of toasted bread; top with the scrambled egg, salsa, and a sprinkle of cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
