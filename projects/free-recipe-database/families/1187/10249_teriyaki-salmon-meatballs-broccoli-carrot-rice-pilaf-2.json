  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 medium carrot\n1 (1 inch) piece ginger root"
    },
    {
      "primary_message": "Peel and mince the onion. Transfer half to a large bowl and set aside. Transfer the rest to a medium saucepan.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Chop broccoli into small pieces. Peel, trim, and small dice carrot. Add both to the saucepan with the onion.",
      "secondary_message": null
    },
    {
      "primary_message": "Add rice and broth to the pan with the veggies, stirring to combine. Bring to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "primary_message": "Meanwhile, drain salmon and place in the bowl with the onion. Add bread crumbs, egg, salt, and pepper; mix well to combine.",
      "secondary_message": "1 (7.5 oz) can wild pink salmon, traditional style\n1 egg\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Once the liquid comes to a boil, scrape down the edges of the saucepan so that all of the rice grains are in the liquid. Cover the saucepan, reduce heat to low, and cook until the liquid is fully absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Coat a baking dish with a thin layer of oil. Form the salmon mixture into 2-inch rounded meatballs and place them in the baking dish. Place the dish in the oven and bake until set, about 15 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Combine garlic, ginger, soy sauce, honey, and vinegar in a small saucepan. Bring to a boil over high heat and cook until slightly thickened, 1-2 minutes.",
      "secondary_message": "2 tbsp honey\n2 tbsp rice vinegar"
    },
    {
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "2 tsp cornstarch"
    },
    {
      "primary_message": "Add cornstarch slurry to the saucepan in a steady stream while stirring quickly. Cook, stirring often, until sauce thickens, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the salmon meatballs are done, pour the teriyaki sauce over the meatballs and gently toss to coat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide rice and salmon meatballs between plates. Garnish with sesame seeds and enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
