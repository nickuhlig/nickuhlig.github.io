  "instructions": [
    {
      "id": 422652,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lb new potatoes\n3 pears\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 422653,
      "primary_message": "Cut potatoes into quarters, then slice into ⅛-inch thick pieces. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 422654,
      "primary_message": "Peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 422655,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 422656,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion, Italian seasoning, and salt; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 ½ tsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 422657,
      "primary_message": "Add potatoes and broth to the pot. Stir to combine and bring to a simmer. (Reserve bowl for the salad.)",
      "secondary_message": "60 fl oz (7 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 422658,
      "primary_message": "While the soup is heating, small dice ham.",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 422659,
      "primary_message": "Once the soup is simmering, add ham, stir to combine, and simmer until potatoes are fork-tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 422660,
      "primary_message": "Meanwhile, using a clean cutting board, quarter, core, and thinly slice pears. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 422661,
      "primary_message": "When the potatoes are tender, add cream and cheese; stir to combine. Continue to cook, stirring occasionally, until the cheese is melted and soup is heated through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n1 cup shredded cheese, Italian blend"
    },
    {
      "id": 422662,
      "primary_message": "Add spinach and dressing to the bowl with the pear. Toss to combine the salad.",
      "secondary_message": "⅓ cup honey mustard dressing"
    },
    {
      "id": 422663,
      "primary_message": "Divide soup between bowls and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
