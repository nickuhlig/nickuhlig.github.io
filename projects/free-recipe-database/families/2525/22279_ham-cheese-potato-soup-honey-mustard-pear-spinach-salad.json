  "instructions": [
    {
      "id": 422664,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.23 kg new potatoes\n1 pear\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 422665,
      "primary_message": "Cut potatoes into quarters, then slice into ⅛-inch thick pieces. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 422666,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 422667,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 422668,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add onion, Italian seasoning, and salt; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 422669,
      "primary_message": "Add potatoes and broth to the pan. Stir to combine and bring to a simmer. (Reserve bowl for the salad.)",
      "secondary_message": "591 ml chicken or vegetable broth"
    },
    {
      "id": 422670,
      "primary_message": "While the soup is heating, small dice ham.",
      "secondary_message": "227 g ham steak, boneless"
    },
    {
      "id": 422671,
      "primary_message": "Once the soup is simmering, add ham, stir to combine, and simmer until potatoes are fork-tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 422672,
      "primary_message": "Meanwhile, using a clean cutting board, quarter, core, and thinly slice pear. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 422673,
      "primary_message": "When the potatoes are tender, add cream and cheese; stir to combine. Continue to cook, stirring occasionally, until the cheese is melted and soup is heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n⅓ cup shredded cheese, Italian blend"
    },
    {
      "id": 422674,
      "primary_message": "Add spinach and dressing to the bowl with the pear. Toss to combine the salad.",
      "secondary_message": "2 tbsp honey mustard dressing"
    },
    {
      "id": 422675,
      "primary_message": "Divide soup between bowls and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
