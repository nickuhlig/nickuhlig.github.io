  "instructions": [
    {
      "id": 241223,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 241224,
      "primary_message": "Cut butter into small pieces and place in a small bowl; set aside.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 241225,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n½ small bunch Italian (flat-leaf) parsley\n½ lemon"
    },
    {
      "id": 241226,
      "primary_message": "Use a julienne (or regular) peeler to make zucchini noodles. Transfer to a baking sheet pan and spread out in an even layer; dot with ⅓ of the butter and season with salt. (Set remaining butter aside.)",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 241227,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until zucchini is tender, about 20 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 241228,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 241229,
      "primary_message": "While the skillet heats up, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.)",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 241230,
      "primary_message": "Once the skillet is hot, add bacon and cook until crispy, 3-5 minutes per side. Remove to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 241231,
      "primary_message": "While the bacon is cooking, peel and thinly slice garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 241232,
      "primary_message": "Return the skillet to medium heat; add garlic and crushed red pepper. Cook, stirring occasionally, until garlic starts to brown, 2-3 minutes.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 241233,
      "primary_message": "Add broth and shrimp to the skillet. Cover and simmer until shrimp are opaque and cooked through, about 5 minutes. Using a slotted spoon, transfer the shrimp to a plate (leaving cooking juices in the skillet) and loosely cover with aluminum foil.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 241234,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Transfer to the bowl with the remaining butter and set aside.",
      "secondary_message": null
    },
    {
      "id": 241235,
      "primary_message": "Return the skillet to medium-high heat and simmer sauce until reduced by half, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 241236,
      "primary_message": "While the sauce cooks, chop or crumble bacon into pieces. ",
      "secondary_message": null
    },
    {
      "id": 241237,
      "primary_message": "Juice lemon into the sauce and remove from heat. Stir in the remaining butter, parsley, salt, and pepper. Add shrimp back to the skillet and toss to coat.",
      "secondary_message": "⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 241238,
      "primary_message": "To serve, divide zucchini noodles, shrimp, and sauce between plates. Top with bacon and enjoy!",
      "secondary_message": null
    }
  ],
