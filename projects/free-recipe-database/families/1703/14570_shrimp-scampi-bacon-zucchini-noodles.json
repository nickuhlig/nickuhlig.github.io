  "instructions": [
    {
      "id": 241303,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 241304,
      "primary_message": "Cut butter into small pieces and place in a small bowl; set aside.",
      "secondary_message": "½ cup butter, unsalted"
    },
    {
      "id": 241305,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 241306,
      "primary_message": "Use a julienne (or regular) peeler to make zucchini noodles. Divide noodles between two baking sheet pans and spread out in an even layer; dot with ⅓ of the butter and season with salt. (Set remaining butter aside.)",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 241307,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until zucchini is tender, 20-25 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 241308,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 241309,
      "primary_message": "While the skillet heats up, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.)",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 241310,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add bacon and cook until crispy, 3-5 minutes per side. Remove to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 241311,
      "primary_message": "While the bacon is cooking, peel and thinly slice garlic.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 241312,
      "primary_message": "Return the skillet to medium heat; add garlic and crushed red pepper. Cook, stirring occasionally, until garlic starts to brown, 2-3 minutes.",
      "secondary_message": "¾ tsp crushed red pepper"
    },
    {
      "id": 241313,
      "primary_message": "Add broth and shrimp to the skillet. Cover and simmer until shrimp are opaque and cooked through, 6-8 minutes. Using a slotted spoon, transfer the shrimp to a plate (leaving cooking juices in the skillet) and loosely cover with aluminum foil.",
      "secondary_message": "355 ml chicken or vegetable broth"
    },
    {
      "id": 241314,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Transfer to the bowl with the remaining butter and set aside.",
      "secondary_message": null
    },
    {
      "id": 241315,
      "primary_message": "Return the skillet to medium-high heat and simmer sauce until reduced by half, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 241316,
      "primary_message": "While the sauce cooks, chop or crumble bacon into pieces. ",
      "secondary_message": null
    },
    {
      "id": 241317,
      "primary_message": "Juice lemons into the sauce and remove from heat. Stir in the remaining butter, parsley, salt, and pepper. Add shrimp back to the skillet and toss to coat.",
      "secondary_message": "½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 241318,
      "primary_message": "To serve, divide zucchini noodles, shrimp, and sauce between plates. Top with bacon and enjoy!",
      "secondary_message": null
    }
  ],
