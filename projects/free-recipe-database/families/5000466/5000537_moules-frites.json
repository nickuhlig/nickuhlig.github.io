  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the shallots. Thinly slice the garlic. Scrub the fresh mussels.",
      "secondary_message": "3 large shallots\n6 large cloves garlic\n1.8 kg fresh mussels"
    },
    {
      "id": 1,
      "primary_message": "In a 6- to 8-quart Dutch oven or large pot set over medium-low heat, melt butter. Add shallots and garlic and cook, stirring occasionally, until very softened but not browned, 8 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Increase heat to high, add wine, salt, black pepper, and red pepper flakes and bring to a boil. Cook, stirring occasionally, until reduced by half, about 4 minutes. Stir in mussels; cover and cook over high, shaking and tossing the pot at 1 minute intervals, until mussels are opened, 5 to 6 minutes. Remove from heat (see notes); stir in lemon zest and juice and parsley. Serve with French fries and mayonnaise.",
      "secondary_message": null
    }
  ],
