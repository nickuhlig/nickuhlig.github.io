  "instructions": [
    {
      "id": 1,
      "primary_message": "Prepare a small boiling water bath canner and 2 regular mouth pint jars. Place lids in a small saucepan and bring to a low simmer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Wash Seckel pears. Cut into halves and remove seeds (a small melon baller does this task well).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine apple cider vinegar, granulated sugar, and salt with 1 cup water and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Divide cinnamon stick halves and cloves between the 2 pint jars.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Tightly pack pear halves into jars, cut-side down.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Pour hot brine over pear halves, leaving 1.5 cm headspace. Tap jars to remove any trapped bubbles and adjust brine levels, if necessary.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Wipe rims, apply lids and bands, and process jars in a boiling water bath canner for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "When time is up, remove jars from canner and let cool on a folded kitchen towel. When jars are cool, remove bands and test seals. Wash jars to remove any stickiness.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Any unsealed jars should be refrigerated. Sealed jars can be safely stored in a cool, dark place for up to 1 year.",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "Let these pickled pears sit for at least 48 hours before eating, to allow pickle flavor to fully infuse.",
      "secondary_message": null
    }
  ],
