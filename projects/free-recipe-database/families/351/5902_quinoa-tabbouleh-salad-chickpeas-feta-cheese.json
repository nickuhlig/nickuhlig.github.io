  "instructions": [
    {
      "id": 71020,
      "primary_message": "In a small saucepan, combine the quinoa and broth; bring to a boil.",
      "secondary_message": "1 ½ cups quinoa\n710 ml (3 cups) chicken or vegetable broth"
    },
    {
      "id": 71019,
      "primary_message": "While the quinoa comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkg grape tomatoes\n1 ½ English cucumber\n1 ½ small bunch Italian (flat-leaf) parsley\n1 ½ small bunch fresh mint"
    },
    {
      "id": 71018,
      "primary_message": "Once the quinoa is boiling, reduce heat to a simmer and cover; cook for 15 minutes. Once cooked, remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 71017,
      "primary_message": "Halve the tomatoes lengthwise and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 71016,
      "primary_message": "Trim off and discard the ends of the cucumber; medium dice the cucumber and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 71015,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 71014,
      "primary_message": "Pick the mint leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 71013,
      "primary_message": "Drain and rinse the chickpeas; add to the bowl.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 71012,
      "primary_message": "Measure out the feta and add to the bowl.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 71011,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 71010,
      "primary_message": "In a small bowl, combine and whisk together the minced garlic, lemon juice, olive oil, salt, and black pepper.",
      "secondary_message": "1 ½ lemon\n6 tbsp extra virgin olive oil\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 71009,
      "primary_message": "Uncover the quinoa and fluff with a fork; add to the bowl with the rest of the ingredients.",
      "secondary_message": ""
    },
    {
      "id": 71008,
      "primary_message": "Add the dressing and toss the salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 71007,
      "primary_message": "Divide the salad between plates and enjoy!",
      "secondary_message": ""
    }
  ],
