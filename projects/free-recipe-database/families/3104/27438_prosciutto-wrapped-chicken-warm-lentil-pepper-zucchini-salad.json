  "instructions": [
    {
      "id": 441368,
      "primary_message": "Using a strainer, rinse lentils under cold water, then drain and transfer to a medium saucepan; add water and salt. Cover and bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes. Drain and set aside.",
      "secondary_message": "1 ½ cups brown lentils, dried\n6 cup water\n¾ tsp salt"
    },
    {
      "id": 441369,
      "primary_message": "Meanwhile, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season both sides with spices, then wrap each cutlet with two slices of prosciutto. ",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper\n12 slices prosciutto"
    },
    {
      "id": 441370,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 441371,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add cutlets and pan-fry until prosciutto is crisp and chicken is cooked through, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 441372,
      "primary_message": "While the chicken is cooking, wash and dry the fresh produce.",
      "secondary_message": "3 orange bell peppers\n3 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 441373,
      "primary_message": "Using a clean cutting board, trim, seed, and small dice bell peppers. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 441374,
      "primary_message": "Trim and small dice zucchini. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 441375,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 441376,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 441377,
      "primary_message": "Return skillet to medium-high heat. Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies, parsley, and spices; cook, stirring occasionally, until veggies have softened, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 441378,
      "primary_message": "Add drained lentils and vinegar to the skillet with the veggies, then stir to combine. Remove from heat. ",
      "secondary_message": "3 tbsp red wine vinegar"
    },
    {
      "id": 441379,
      "primary_message": "Slice chicken into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 441380,
      "primary_message": "To serve, divide warm lentil salad between plates or bowls and top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
