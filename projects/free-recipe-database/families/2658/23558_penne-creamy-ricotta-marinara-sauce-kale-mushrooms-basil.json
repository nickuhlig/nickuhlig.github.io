  "instructions": [
    {
      "id": 385830,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g penne pasta"
    },
    {
      "id": 385831,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385832,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 385833,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, mushrooms, and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 (227g ) pkg sliced white mushrooms\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 385834,
      "primary_message": "When the veggies are done, add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": "1 (283 g) bag kale, cut and ready to use"
    },
    {
      "id": 385835,
      "primary_message": "Add marinara sauce and ricotta to the skillet. Stir to combine and bring the sauce to a simmer over medium heat. Once simmering, remove from heat and cover to keep warm.",
      "secondary_message": "1 (680 g) jar marinara sauce\n1 (425 g) pkg ricotta cheese"
    },
    {
      "id": 385836,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add half to the skillet with the sauce and stir to combine. (Reserve remaining basil for serving.)",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 385837,
      "primary_message": "When the pasta is done, drain and add to the skillet with the sauce. Stir to coat.",
      "secondary_message": null
    },
    {
      "id": 385838,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
