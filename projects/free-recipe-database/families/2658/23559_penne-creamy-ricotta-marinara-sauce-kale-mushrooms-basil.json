  "instructions": [
    {
      "id": 385839,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g penne pasta"
    },
    {
      "id": 385840,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 385841,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 385842,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, mushrooms, and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 (227g ) pkg sliced white mushrooms\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 385843,
      "primary_message": "When the veggies are done, add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful.",
      "secondary_message": "1 ½ (283 g) bags kale, cut and ready to use"
    },
    {
      "id": 385844,
      "primary_message": "Add marinara sauce and ricotta to the pot. Stir to combine and bring the sauce to a simmer over medium heat. Once simmering, remove from heat and cover to keep warm.",
      "secondary_message": "1 ½ (680 g) jars marinara sauce\n1 ½ (425 g) pkgs ricotta cheese"
    },
    {
      "id": 385845,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add half to the pot with the sauce and stir to combine. (Reserve remaining basil for serving.)",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 385846,
      "primary_message": "When the pasta is done, drain and add to the pot with the sauce. Stir to coat.",
      "secondary_message": null
    },
    {
      "id": 385847,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
