  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon. Finely chop the celery. Finely chop the shallots. Finely slice the scallions.",
      "secondary_message": "1 lemon\n1 rib celery\n¼ cup shallots\n4 scallions"
    },
    {
      "id": 1,
      "primary_message": "For the dressing: Whisk together all ingredients in a medium bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Salad: In a large pot of salted boiling water, cook pasta until very tender, about 15 minutes. Drain pasta and transfer to a large bowl. Add vinegar and stir until completely absorbed. Let pasta stand until cool, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add dressing and stir until well coated. Stir in celery, shallots, and scallions. Season with salt and pepper. Cover and chill in refrigerator for at least 1 hour before serving.",
      "secondary_message": null
    }
