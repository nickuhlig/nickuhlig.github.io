  "instructions": [
    {
      "id": 6660,
      "primary_message": "Rinse rice in a strainer until water runs clear and transfer to a small saucepan. Add water and salt. Bring to a boil. Reduce heat to low, stir, and cover. Cook until liquid is absorbed, 15-18 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 14723,
      "primary_message": "If using frozen shrimp, place in a medium bowl, cover with cold water, and set aside to thaw. If using fresh shrimp, skip this step.",
      "secondary_message": "0.34 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 14724,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 14725,
      "primary_message": "Wash, seed, and julienne (cut into thin sticks) bell pepper. Wash and small dice tomatoes.",
      "secondary_message": "1 red bell pepper\n2 tomatoes"
    },
    {
      "id": 14726,
      "primary_message": "Coat bottom of pan with oil. Add pepper and, stirring frequently, cook until tender-crisp, 2-3 minutes.",
      "secondary_message": "about ½ tbsp virgin coconut oil"
    },
    {
      "id": 14727,
      "primary_message": "Peel and mince garlic and ginger.",
      "secondary_message": "2 cloves garlic\r\n1 (2 ½ cm) piece ginger"
    },
    {
      "id": 14728,
      "primary_message": "Add garlic, ginger, curry, and red pepper to pan. Cook until fragrant, 15-30 seconds.",
      "secondary_message": "1 tsp curry powder\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 14729,
      "primary_message": "Add tomatoes and coconut milk. Bring to a boil. Reduce heat to medium and simmer until sauce thickens slightly, 5-6 minutes.",
      "secondary_message": "½ (398 ml) can coconut milk"
    },
    {
      "id": 14730,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 14731,
      "primary_message": "Drain and rinse shrimp under cold water until there are no more ice chunks. Place on paper towels and pat dry. If using fresh shrimp, skip this step.",
      "secondary_message": ""
    },
    {
      "id": 14732,
      "primary_message": "Add shrimp and ½ of the cilantro (save the rest for garnishing) to pan and stir. Cook until shrimp are opaque, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 14733,
      "primary_message": "Add lime juice and season with salt. Remove from heat.",
      "secondary_message": "juice of ½ lime\r\n⅛ tsp salt"
    },
    {
      "id": 14734,
      "primary_message": "Cut remaining lime into wedges.",
      "secondary_message": "½ lime"
    },
    {
      "id": 14735,
      "primary_message": "Uncover rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 14736,
      "primary_message": "To serve, place rice in a bowl, top with curry, and garnish with remaining cilantro and lime wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
