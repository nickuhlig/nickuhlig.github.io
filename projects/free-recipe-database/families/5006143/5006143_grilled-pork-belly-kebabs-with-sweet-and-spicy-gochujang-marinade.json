  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the boneless skinless pork belly into 1-inch cubes.",
      "secondary_message": "1 ¼ lb boneless skinless pork belly"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, mix together gochujang, honey, sake, soy sauce, and oil. Reserve 2 tablespoons of marinade in refrigerator. In a large bowl, toss pork with remaining marinade until thoroughly coated and refrigerate for at least 1 hour and up to overnight.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "When ready to grill, slide pork onto bamboo skewers, alternating with pieces of zucchini, cherry tomatoes, and bell pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Prepare your grill. Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange coals on one side of the charcoal grate. Set cooking grate in place, cover grill, and allow to preheat for 5 minutes. Alternatively, set half the burners on a gas grill to the highest heat setting, cover, and preheat for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When your grill is hot, clean and oil the grilling grate.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Place skewers near the middle of the grill (where heat should be moderate). Cook, turning the skewers and basting with the reserved marinade every few minutes, until pork is cooked through, tender within, and browned on the outside, about 13 minutes. Serve right away.",
      "secondary_message": null
    }
  ],
