  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Place broccoli in the medium compartment of the bento box.",
      "secondary_message": "½ cup broccoli florets"
    },
    {
      "primary_message": "Place banana chips and fruit snacks in the small compartments of the bento box. ",
      "secondary_message": "⅓ cup banana chips\n1 (20 g) pouch fruit snacks"
    },
    {
      "primary_message": "Place dressing in a small container with a lid. Place dressing and yogurt in the large compartment of the bento box.",
      "secondary_message": "2 tbsp Italian salad dressing\n1 (170 g) cup peach yogurt"
    },
    {
      "primary_message": "Wash, dry, and slice two 1/4-inch slices from the tomato. Pat dry with paper towels, then season with salt and pepper.",
      "secondary_message": "¼ Roma tomato\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "primary_message": "Place rolls on a flat surface, then slice crosswise to separate into halves. Spread each half with pesto. Layer tomato and cheese over the bottom halves of the rolls, then close with the top halves of the rolls. Add sliders to the large compartment of the bento box.",
      "secondary_message": "2 Hawaiian sweet rolls\n4 tsp basil pesto\n57 g fresh mozzarella cheese"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
