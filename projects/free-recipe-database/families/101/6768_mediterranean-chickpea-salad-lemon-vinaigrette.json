  "instructions": [
    {
      "id": 89074,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by whisking together garlic, lemon juice, olive oil, oregano, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\njuice of 1 lemon\r\n6 tbsp extra virgin olive oil\r\n½ tsp oregano\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 89075,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Add to bowl with dressing and toss to coat.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 89076,
      "primary_message": "Peel, medium dice, and add onion to bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 89077,
      "primary_message": "Wash and dry tomatoes, cucumber, and bell peppers. Medium dice tomatoes and cucumber and add to bowl with chickpeas. Seed, medium dice, and add peppers to bowl.",
      "secondary_message": "4 tomatoes\r\n1 English cucumber\r\n2 yellow bell peppers"
    },
    {
      "id": 89078,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Add to bowl.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 89079,
      "primary_message": "Halve olives and add to bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 89080,
      "primary_message": "To serve, place salad in a bowl or on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
