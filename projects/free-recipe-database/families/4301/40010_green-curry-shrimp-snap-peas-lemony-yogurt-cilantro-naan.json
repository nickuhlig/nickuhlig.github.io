  "instructions": [
    {
      "id": 620449,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n1 ½ (8 oz) pkgs sugar snap peas\n3 jalapeño peppers\n1 small bunch cilantro\n3 lemons"
    },
    {
      "id": 620450,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 620451,
      "primary_message": "Halve snap peas. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 620452,
      "primary_message": "Peel, halve, and medium dice onions. Add to the bowl and set aside.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 620453,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Place in a blender. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 620454,
      "primary_message": "Shave cilantro leaves off the stems; roughly chop the leaves. Add half of the leaves and stems to the blender. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 620455,
      "primary_message": "Juice half of the lemons into the blender. Add water, oil, and spices, then blend on high until sauce is smooth. Set aside. (Reserve remaining lemons for later use).",
      "secondary_message": "⅓ cup water\n3 tbsp neutral vegetable oil\n2 tbsp curry powder\n1 tbsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 620456,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620457,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 5-7 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 620458,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 620459,
      "primary_message": "When the veggies are done, add sauce and shrimp to the pot. Continue to cook, stirring occasionally, until shrimp are cooked through and sauce has thickened slightly, 5-6 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 620460,
      "primary_message": "Meanwhile, juice reserved lemons into a small bowl. Add yogurt and whisk to combine the sauce. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 620461,
      "primary_message": "Toast naan if desired, then cut into wedges. ",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 620462,
      "primary_message": "To serve, divide curry and naan between plates or bowls. Drizzle curry with yogurt sauce and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
