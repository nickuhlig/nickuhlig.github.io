  "instructions": [
    {
      "id": 620477,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n1 (227 g) pkg sugar snap peas\n2 jalapeño peppers\n1 small bunch cilantro\n2 lemons"
    },
    {
      "id": 620478,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 620479,
      "primary_message": "Halve snap peas. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 620480,
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl and set aside.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 620481,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Place in a blender. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 620482,
      "primary_message": "Shave cilantro leaves off the stems; roughly chop the leaves. Add half of the leaves and stems to the blender. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 620483,
      "primary_message": "Juice one lemon into the blender. Add water, oil, and spices, then blend on high until sauce is smooth. Set aside. (Reserve remaining lemon for later use).",
      "secondary_message": "¼ cup water\n2 tbsp neutral vegetable oil\n4 tsp curry powder\n2 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 620484,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620485,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": "4 tsp neutral vegetable oil\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 620486,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 620487,
      "primary_message": "When the veggies are done, add sauce and shrimp to the skillet. Continue to cook, stirring occasionally, until shrimp are cooked through and sauce has thickened slightly, 4-5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 620488,
      "primary_message": "Meanwhile, juice reserved lemon into a small bowl. Add yogurt and whisk to combine the sauce. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 620489,
      "primary_message": "Toast naan if desired, then cut into wedges. ",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 620490,
      "primary_message": "To serve, divide curry and naan between plates or bowls. Drizzle curry with yogurt sauce and sprinkle with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
