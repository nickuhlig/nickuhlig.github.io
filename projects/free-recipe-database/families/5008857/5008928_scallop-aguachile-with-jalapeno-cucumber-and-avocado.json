  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Stem, seed, and roughly chop the jalapeño peppers. Roughly chop the tender stems of the loosely packed cilantro leaves.",
      "secondary_message": "2 medium jalapeño peppers\n¼ cup loosely packed cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "Arrange scallops in an even layer on a large plate and sprinkle all over with salt. Cover with plastic and refrigerate for at least 1 hour and up to 2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, blend jalapeños with water in a blender or with an immersion blender until thoroughly blended. Add diced cucumber and blend until pureed. Add lime juice and cilantro and blend until cilantro is finely chopped. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a mixing bowl, toss scallops with jalapeño-lime marinade, onion, and remaining cucumber half-moons. Season once more with salt and pepper and serve right away with tostadas and avocado.",
      "secondary_message": null
    }
  ],
