  "instructions": [
    {
      "id": 226547,
      "primary_message": "In a medium saucepan, bring broth and water to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the liquid. Cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n2 cup water\n1 cup polenta (cornmeal)"
    },
    {
      "id": 226548,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 226549,
      "primary_message": "Peel and small dice onion. Peel and mince garlic; place both in a medium bowl.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 226550,
      "primary_message": "Wash, dry, seed, and medium dice bell peppers; add to the bowl with the onion and garlic.",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 226551,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 226552,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 226553,
      "primary_message": "Add beans, tomatoes, and spices to the skillet; stir to combine, and cook until heated through, about 5 minutes.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n½ tsp salt\n½ tsp black pepper\n½ tsp paprika\n¼ tsp crushed red pepper"
    },
    {
      "id": 226554,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 226555,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Cook, stirring occasionally, until tender, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 226556,
      "primary_message": "While the kale cooks, finely grate Parmesan.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 226557,
      "primary_message": "Add half the Parmesan, salt, and pepper to the polenta and stir to combine. If the polenta is too firm, add hot water, 1-2 tablespoons at a time, until you reach a desired consistency.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 226558,
      "primary_message": "To serve, divide polenta between bowls; top with veggie-bean skillet and remaining Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
