  "instructions": [
    {
      "id": 226524,
      "primary_message": "In a medium saucepan, bring broth and water to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the liquid. Cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n3 cup water\n1 ½ cups polenta (cornmeal)"
    },
    {
      "id": 226525,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 226526,
      "primary_message": "Peel and small dice onions. Peel and mince garlic; place both in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 226527,
      "primary_message": "Wash, dry, seed, and medium dice bell peppers; add to the bowl with the onion and garlic.",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 226528,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 226529,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, about 5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 226530,
      "primary_message": "Add beans, tomatoes, and spices to the pot; stir to combine, and cook until heated through, 5-6 minutes.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp paprika\n½ tsp crushed red pepper"
    },
    {
      "id": 226531,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces.",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 226532,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Cook, stirring occasionally, until tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 226533,
      "primary_message": "Add oil, salt, and pepper to the polenta and stir to combine. If the polenta is too firm, add hot water, a few tablespoons at a time, until you reach a desired consistency.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 226534,
      "primary_message": "To serve, divide polenta between bowls; top with veggie-bean skillet and pine nuts. Enjoy!",
      "secondary_message": "¾ cup pine nuts"
    }
  ],
