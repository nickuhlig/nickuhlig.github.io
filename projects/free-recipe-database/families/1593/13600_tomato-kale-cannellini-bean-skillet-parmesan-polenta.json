  "instructions": [
    {
      "id": 226466,
      "primary_message": "In a small saucepan, bring broth and water to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the liquid. Cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n1 cup water\n½ cup polenta (cornmeal)"
    },
    {
      "id": 226467,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 226468,
      "primary_message": "Peel and small dice onion. Peel and mince garlic; place both in a medium bowl.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 226469,
      "primary_message": "Wash, dry, seed, and medium dice bell pepper; add to the bowl with the onion and garlic.",
      "secondary_message": "1 green bell pepper"
    },
    {
      "id": 226470,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 226471,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 226472,
      "primary_message": "Add beans, tomatoes, and spices to the skillet; stir to combine, and cook until heated through, about 5 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp paprika\n⅛ tsp crushed red pepper"
    },
    {
      "id": 226473,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces.",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 226474,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Cook, stirring occasionally, until tender, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 226475,
      "primary_message": "While the kale cooks, finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 226476,
      "primary_message": "Add half the Parmesan, salt, and pepper to the polenta and stir to combine. If the polenta is too firm, add hot water, 1 tablespoon at a time, until you reach a desired consistency.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 226477,
      "primary_message": "To serve, divide polenta between bowls; top with veggie-bean skillet and remaining Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
