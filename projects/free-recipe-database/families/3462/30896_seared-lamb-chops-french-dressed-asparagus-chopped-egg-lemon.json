  "instructions": [
    {
      "id": 489695,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 489696,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 489697,
      "primary_message": "Snap (or cut) off woody ends of the asparagus.",
      "secondary_message": null
    },
    {
      "id": 489698,
      "primary_message": "Once the water in the pot is boiling, add asparagus and salt; cook until tender-crisp, 2-3 minutes. Using a slotted spoon, transfer asparagus to the colander, and run under cold water to cool; transfer to a plate and set aside. (Reserve boiling water in pot for the next step.)",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 489699,
      "primary_message": "Carefully add eggs to the reserved pot, reduce heat to a simmer and cook for 10 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 489700,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a small bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 489701,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the shallot. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 489702,
      "primary_message": "Add capers, oil, vinegar, Dijon, salt, and pepper to the bowl. Stir to combine the dressing and set aside.",
      "secondary_message": "2 tbsp capers\n2 tbsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 489703,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 489704,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "8 lamb loin chops\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 489705,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until lamb is golden brown and cooked through, about 3 minutes per side. Remove to a clean plate and set aside to rest.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 489706,
      "primary_message": "Meanwhile, cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 489707,
      "primary_message": "Peel and roughly chop the eggs. Season with salt.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 489708,
      "primary_message": "Divide lamb and asparagus between plates. Top asparagus with dressing, chopped egg, and reserved parsley. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
