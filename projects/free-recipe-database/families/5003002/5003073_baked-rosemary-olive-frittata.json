  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 205°C (400°F). Line springform pan with parchment paper then grease liberally with olive oil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk eggs until lightly beaten. Add cheese and season to taste with salt and pepper (cheese is salty, so do not overseason with salt). Whisk to combine. Spread olives evenly in pan, and pour eggs over to coat. Sprinkle with rosemary. Bake until top is puffed, and sides are golden and begin to pull away from the side of the pan, about 15 minutes. Let cool slightly, then serve.",
      "secondary_message": null
    }
  ],
