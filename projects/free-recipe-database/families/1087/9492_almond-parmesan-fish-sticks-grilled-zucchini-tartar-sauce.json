  "instructions": [
    {
      "id": 198723,
      "primary_message": "Preheat oven to 425°F. Coat a large baking sheet pan with a thin layer of oil; set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 198724,
      "primary_message": "Finely grate Parmesan into a medium bowl; add almond meal and spices. Toss together with your hands until well combined, breaking up any cheese lumps. Transfer to the baking sheet pan and spread out in an even layer. Reserve bowl.",
      "secondary_message": "4 oz Parmesan cheese\n1 cup almond meal/flour\n2 tsp parsley flakes\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 198725,
      "primary_message": "Place pan in the oven (it doesn't have to be fully heated) and bake until lightly golden, 6-8 minutes. Watch carefully so the almond meal doesn't burn. Remove from the oven and let cool. Leave the oven on.",
      "secondary_message": null
    },
    {
      "id": 198726,
      "primary_message": "Meanwhile, preheat a grill pan or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 198727,
      "primary_message": "Wash zucchini, trim ends, and slice crosswise into ½-inch-thick pieces at an angle. Transfer to a medium bowl; add oil, salt, and pepper and toss to combine. ",
      "secondary_message": "4 medium zucchini squash\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 198728,
      "primary_message": "Once the grill pan or skillet is hot, add the zucchini slices. Cook until tender and golden brown, 5-7 minutes per side. Once done, transfer to a plate and cover with aluminum foil. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 198729,
      "primary_message": "Meanwhile, whisk eggs in a small bowl.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 198730,
      "primary_message": "Scrape almond-Parmesan mixture back into the reserved bowl, then break into fine crumbs with a fork or by hand. Reserve the baking sheet pan for later.",
      "secondary_message": null
    },
    {
      "id": 198731,
      "primary_message": "Pat the fish dry with paper towel, then cut lengthwise into approximately 1-inch wide strips. Cut each strip in half crosswise. Stack extra thin strips of fish, one on top of the other, so that all of the fish strips are relatively even in size.",
      "secondary_message": "1 ½ lb tilapia fillet"
    },
    {
      "id": 198732,
      "primary_message": "Dip fish strips into the bowl with the egg. Let the egg drip off, then dredge in almond-Parmesan crumbs, pressing to adhere. Place on the baking sheet pan, spacing them 1-inch apart.",
      "secondary_message": null
    },
    {
      "id": 198733,
      "primary_message": "Place fish sticks in the oven and bake until cooked through, 7-9 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 198734,
      "primary_message": "Meanwhile, mince capers; add to a small bowl along with mayonnaise, vinegar, water, Dijon, and spices. Whisk to combine the tartar sauce. ",
      "secondary_message": "1 tbsp capers\n⅓ cup avocado oil mayonnaise\n2 tsp white wine vinegar\n2 tsp water\n2 tsp Dijon mustard\n¼ tsp dill\n⅛ tsp black pepper"
    },
    {
      "id": 198735,
      "primary_message": "Wash and dry lemon. Slice into wedges. ",
      "secondary_message": "1 lemon"
    },
    {
      "id": 198736,
      "primary_message": "Divide fish sticks and zucchini between plates. Serve with tartar sauce and lemon wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
