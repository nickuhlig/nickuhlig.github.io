  "instructions": [
    {
      "id": 495567,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh basil\n2 peaches\n2 plums"
    },
    {
      "id": 495568,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 495569,
      "primary_message": "Peel and mince garlic. Add to the bowl with the basil. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 495570,
      "primary_message": "Finely grate Parmesan. Add to the bowl.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 495571,
      "primary_message": "Roughly chop pine nuts. Add to the bowl along with oil, vinegar, salt, and pepper, then stir to combine the \"tapenade.\" Set aside. ",
      "secondary_message": "⅛ cup pine nuts\n4 tsp extra virgin olive oil\n1 tbsp white wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 495572,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495573,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces. Place in a medium bowl, along with spices, and gently stir to coat.",
      "secondary_message": "1 (8 oz) package tempeh\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 495574,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh in a single layer and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove to a plate, loosely cover with aluminum foil, and set aside to rest. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 495575,
      "primary_message": "Meanwhile, quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 495576,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl with the peaches and set aside. ",
      "secondary_message": null
    },
    {
      "id": 495577,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add peaches, plums, and salt; cook, stirring occasionally, until warmed through, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 495578,
      "primary_message": "To serve, divide warm fruit and tempeh between plates. Top tempeh with tapenade and enjoy!",
      "secondary_message": null
    }
  ],
