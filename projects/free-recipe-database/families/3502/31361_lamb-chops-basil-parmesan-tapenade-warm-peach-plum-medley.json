  "instructions": [
    {
      "id": 495543,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh basil\n4 peaches\n4 plums"
    },
    {
      "id": 495544,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 495545,
      "primary_message": "Peel and mince garlic. Add to the bowl with the basil. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 495546,
      "primary_message": "Finely grate Parmesan. Add to the bowl.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 495547,
      "primary_message": "Roughly chop pine nuts. Add to the bowl along with oil, vinegar, salt, and pepper, then stir to combine the \"tapenade.\" Set aside. ",
      "secondary_message": "¼ cup pine nuts\n2 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495548,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495549,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "8 lamb loin chops\n1 tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 495550,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and sear, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 495551,
      "primary_message": "Meanwhile, quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 495552,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl with the peaches and set aside. ",
      "secondary_message": null
    },
    {
      "id": 495553,
      "primary_message": "Return skillet (with drippings) to medium-high heat. Add peaches, plums, and salt; cook, stirring occasionally, until warmed through, 2-3 minutes. Remove from heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 495554,
      "primary_message": "To serve, divide warm fruit and chops between plates. Top chops with tapenade and enjoy!",
      "secondary_message": null
    }
  ],
