  "instructions": [
    {
      "id": 495591,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh basil\n6 peaches\n6 plums"
    },
    {
      "id": 495592,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 495593,
      "primary_message": "Peel and mince garlic. Add to the bowl with the basil. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 495594,
      "primary_message": "Finely grate Parmesan. Add to the bowl.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 495595,
      "primary_message": "Roughly chop pine nuts. Add to the bowl along with oil, vinegar, salt, and pepper, then stir to combine the \"tapenade.\" Set aside. ",
      "secondary_message": "⅓ cup pine nuts\n3 tbsp extra virgin olive oil\n3 tbsp white wine vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495596,
      "primary_message": "Slice tempeh crosswise into ½-inch thick pieces. Place in a large bowl, along with spices, and gently stir to coat.",
      "secondary_message": "3 (8 oz) packages tempeh\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 495597,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495598,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh in a single layer and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove to a plate, loosely cover with aluminum foil, and set aside to rest. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 495599,
      "primary_message": "Meanwhile, quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 495600,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl with the peaches and set aside. ",
      "secondary_message": null
    },
    {
      "id": 495601,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Working in batches if necessary, add peaches, plums, and salt; cook, stirring occasionally, until warmed through, 2-3 minutes. Return to the bowl.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 495602,
      "primary_message": "To serve, divide warm fruit and tempeh between plates. Top tempeh with tapenade and enjoy!",
      "secondary_message": null
    }
  ],
