  "instructions": [
    {
      "id": 495627,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh basil\n6 peaches\n6 plums"
    },
    {
      "id": 495628,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 495629,
      "primary_message": "Peel and mince garlic. Add to the bowl with the basil. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 495630,
      "primary_message": "Finely grate Parmesan. Add to the bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 495631,
      "primary_message": "Roughly chop pine nuts. Add to the bowl along with oil, vinegar, salt, and pepper, then stir to combine the \"tapenade.\" Set aside. ",
      "secondary_message": "⅓ cup pine nuts\n3 tbsp extra virgin olive oil\n3 tbsp white wine vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495632,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495633,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "12 lamb loin chops\n1 ½ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 495634,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add chops and sear, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest. (Reserve skillet with drippings for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 495635,
      "primary_message": "Meanwhile, quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 495636,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl with the peaches and set aside. ",
      "secondary_message": null
    },
    {
      "id": 495637,
      "primary_message": "Return skillet (with drippings) to medium-high heat. Working in batches if necessary, add peaches, plums, and salt; cook, stirring occasionally, until warmed through, 2-3 minutes. Return to the bowl. ",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 495638,
      "primary_message": "To serve, divide warm fruit and chops between plates. Top chops with tapenade and enjoy!",
      "secondary_message": null
    }
  ],
