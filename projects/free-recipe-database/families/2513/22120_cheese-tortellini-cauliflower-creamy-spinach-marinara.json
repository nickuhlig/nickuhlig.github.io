  "instructions": [
    {
      "id": 370782,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add cauliflower, tortellini, and salt; stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "1 (10 oz) bag cauliflower florets\n9 oz cheese tortellini, fresh or frozen\n½ tsp salt"
    },
    {
      "id": 370783,
      "primary_message": "Meanwhile, place marinara sauce, cream, and spices in a medium saucepan. Stir to combine and bring the sauce to a simmer over medium heat. Once simmering, reduce heat to medium-low and cook until slightly thickened, 3-4 minutes.",
      "secondary_message": "½ (24 oz) jar marinara sauce\n4 fl oz (½ cup) heavy whipping cream\n¼ tsp basil, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 370784,
      "primary_message": "While the sauce is cooking, wash and dry the spinach (skip if it came pre-washed).",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 370785,
      "primary_message": "When the sauce has thickened, add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 370786,
      "primary_message": "When the cauliflower and tortellini are done, drain and return to the pot. Add creamy marinara sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 370787,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
