  "instructions": [
    {
      "id": 491895,
      "primary_message": "Preheat oven to 375°F. ",
      "secondary_message": null
    },
    {
      "id": 491896,
      "primary_message": "Arrange prosciutto in a single layer on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until prosciutto is crisp, 3-5 minutes. Remove from oven and set aside to cool. ",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 491897,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n½ bunch Swiss chard\n½ small pkg fresh basil"
    },
    {
      "id": 491898,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 491899,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing and stir to combine. Set aside to marinate.",
      "secondary_message": null
    },
    {
      "id": 491900,
      "primary_message": "Crack eggs into another medium bowl, season with salt, and whisk until smooth. Set aside.",
      "secondary_message": "4 eggs\n⅛ tsp salt"
    },
    {
      "id": 491901,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 491902,
      "primary_message": "While the skillet heats up, fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate.",
      "secondary_message": null
    },
    {
      "id": 491903,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems and crushed red pepper. Cook, stirring occasionally, until stems are tender, about 1 minute.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp crushed red pepper"
    },
    {
      "id": 491904,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. When the chard is just wilted, add vinegar and salt to the skillet, then stir to combine. ",
      "secondary_message": "½ tsp balsamic vinegar\n¼ tsp salt"
    },
    {
      "id": 491905,
      "primary_message": "Pour egg mixture into the skillet with the chard and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove from heat, crumble goat cheese into the skillet, and stir to combine.",
      "secondary_message": "½ (4 oz) log goat cheese"
    },
    {
      "id": 491906,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the tomato salad and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 491907,
      "primary_message": "Crumble or chop prosciutto into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 491908,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 491909,
      "primary_message": "Divide tortillas between plates; fill with chard scramble and top with crispy prosciutto. Serve with tomato salad and enjoy!",
      "secondary_message": null
    }
  ],
