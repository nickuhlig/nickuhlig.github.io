  "instructions": [
    {
      "id": 491964,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 pints grape tomatoes\n1 ½ bunches Swiss chard\n1 small pkg fresh basil"
    },
    {
      "id": 491965,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 491966,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing and stir to combine. Set aside to marinate.",
      "secondary_message": null
    },
    {
      "id": 491967,
      "primary_message": "Crack eggs into another large bowl, season with salt, and whisk until smooth. Set aside.",
      "secondary_message": "12 eggs\n½ tsp salt"
    },
    {
      "id": 491968,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate.",
      "secondary_message": null
    },
    {
      "id": 491969,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 491970,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems and crushed red pepper. Cook, stirring occasionally, until stems are tender, 1-2 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp crushed red pepper"
    },
    {
      "id": 491971,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. When the chard is just wilted, add vinegar and salt to the skillet, then stir to combine. ",
      "secondary_message": "1 ½ tsp balsamic vinegar\n¾ tsp salt"
    },
    {
      "id": 491972,
      "primary_message": "Pour egg mixture into the skillet with the chard and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove from heat, crumble goat cheese into the skillet, and stir to combine.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 491973,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the tomato salad and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 491974,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 491975,
      "primary_message": "Divide tortillas between plates and fill with chard scramble. Serve with tomato salad and enjoy!",
      "secondary_message": null
    }
  ],
