  "instructions": [
    {
      "id": 630007,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 630008,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl, along with oil and spices, then stir to combine the spice paste.",
      "secondary_message": "3 cloves garlic\n⅓ cup extra virgin olive oil\n1 tbsp coriander, ground\n1 ½ tsp cumin, ground\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¾ tsp cayenne pepper"
    },
    {
      "id": 630009,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lemons\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 630010,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the spice paste.",
      "secondary_message": null
    },
    {
      "id": 630011,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 630012,
      "primary_message": "While the pot heats up, medium dice tempeh. Add to the bowl and stir to combine.",
      "secondary_message": "3 (8 oz) packages tempeh"
    },
    {
      "id": 630013,
      "primary_message": "Once the pot is hot, working in batches if necessary, add tempeh, cauliflower, and any spice paste left in the bowl; cook stirring occasionally, until tempeh is golden and cauliflower is tender-crisp, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 630014,
      "primary_message": "Meanwhile, juice lemons into a small bowl. Add tahini, water, and salt, then whisk to combine the sauce. Set aside.",
      "secondary_message": "⅓ cup tahini\n⅓ cup water\n¾ tsp salt"
    },
    {
      "id": 630015,
      "primary_message": "When the tempeh and cauliflower are done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 630016,
      "primary_message": "To serve, divide couscous, tempeh, and veggies between bowls. Drizzle with tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
