  "instructions": [
    {
      "id": 630017,
      "primary_message": "In a small saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 630018,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a medium bowl, along with oil and spices, then stir to combine the spice paste.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n1 tsp coriander, ground\n½ tsp cumin, ground\n½ tsp turmeric, ground\n½ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 630019,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n½ lemon\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 630020,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the spice paste.",
      "secondary_message": null
    },
    {
      "id": 630021,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 630022,
      "primary_message": "While the skillet heats up, medium dice tempeh. Add to the bowl and stir to combine.",
      "secondary_message": "1 (227g ) pkg tempeh"
    },
    {
      "id": 630023,
      "primary_message": "Once the skillet is hot, add tempeh, cauliflower, and any spice paste left in the bowl; cook stirring occasionally, until tempeh is golden and cauliflower is tender-crisp, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 630024,
      "primary_message": "Meanwhile, juice lemon into a small bowl. Add tahini, water, and salt, then whisk to combine the sauce. Set aside.",
      "secondary_message": "2 tbsp tahini\n2 tbsp water\n¼ tsp salt"
    },
    {
      "id": 630025,
      "primary_message": "When the tempeh and cauliflower are done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 630026,
      "primary_message": "To serve, divide couscous, tempeh, and veggies between bowls. Drizzle with tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
