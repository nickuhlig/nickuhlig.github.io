  "instructions": [
    {
      "id": 182012,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 182013,
      "primary_message": "Meanwhile, preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 182014,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n2 sticks celery\n½ small pkg chives"
    },
    {
      "id": 182015,
      "primary_message": "Snap or cut off the woody ends of the asparagus and transfer to a baking sheet pan. Drizzle with oil and season with salt and pepper. ",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 182016,
      "primary_message": "Place asparagus in the oven (it doesn't have to be fully heated) and bake until fork-tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 182017,
      "primary_message": "Meanwhile, place mayo, vinegar, Dijon, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n2 tsp white wine vinegar\n2 tsp Dijon mustard\n1 tsp dill\n½ tsp curry powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp paprika\n¼ tsp garlic powder"
    },
    {
      "id": 182018,
      "primary_message": "Small dice celery and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 182019,
      "primary_message": "Peel and mince shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 182020,
      "primary_message": "Peel and roughly chop the eggs. Add to the bowl and stir to combine the egg salad.",
      "secondary_message": null
    },
    {
      "id": 182021,
      "primary_message": "Warm naan in a skillet, oven, or toaster (optional).",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 182022,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 182023,
      "primary_message": "Layer each naan with asparagus, egg salad, and chives; roll to close.",
      "secondary_message": null
    },
    {
      "id": 182024,
      "primary_message": "To make wraps easier to eat, place each naan on a square of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise eat as is and get a little messy! Enjoy!",
      "secondary_message": null
    }
  ],
