  "instructions": [
    {
      "id": 182025,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 182026,
      "primary_message": "Meanwhile, preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 182027,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches asparagus\n3 sticks celery\n1 small pkg chives"
    },
    {
      "id": 182028,
      "primary_message": "Snap or cut off the woody ends of the asparagus and transfer to a large baking sheet pan. Drizzle with oil and season with salt and pepper. ",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 182029,
      "primary_message": "Place asparagus in the oven (it doesn't have to be fully heated) and bake until fork-tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 182030,
      "primary_message": "Meanwhile, place mayo, vinegar, Dijon, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "½ cup mayonnaise\n1 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 ½ tsp dill\n¾ tsp curry powder\n¾ tsp salt\n½ tsp black pepper\n½ tsp paprika\n½ tsp garlic powder"
    },
    {
      "id": 182031,
      "primary_message": "Small dice celery and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 182032,
      "primary_message": "Peel and mince shallots; add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 182033,
      "primary_message": "Peel and roughly chop the eggs. Add to the bowl and stir to combine the egg salad.",
      "secondary_message": null
    },
    {
      "id": 182034,
      "primary_message": "Warm naan in a skillet, oven, or toaster (optional).",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 182035,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 182036,
      "primary_message": "Layer each naan with asparagus, egg salad, and chives; roll to close.",
      "secondary_message": null
    },
    {
      "id": 182037,
      "primary_message": "To make wraps easier to eat, place each naan on a square of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise eat as is and get a little messy! Enjoy!",
      "secondary_message": null
    }
  ],
