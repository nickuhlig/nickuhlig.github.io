  "instructions": [
    {
      "id": 480494,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g orzo pasta"
    },
    {
      "id": 480495,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n1 small pkg fresh basil"
    },
    {
      "id": 480496,
      "primary_message": "Trim and small dice zucchini. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 480497,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the zucchini and set aside.",
      "secondary_message": null
    },
    {
      "id": 480498,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 480499,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 480500,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion, garlic, and spices to the skillet. Cook, stirring frequently, until onion begins to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp Italian seasoning\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 480501,
      "primary_message": "Add zucchini and bell pepper to the skillet. Continue to cook, stirring often, until veggies are tender, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 480502,
      "primary_message": "While the veggies are cooking, coarsely grate cheese. Place in the reserved bowl and set aside.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 480503,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 480504,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 480505,
      "primary_message": "Add cooked orzo, tomato sauce, and half of the basil to the skillet (reserve remaining basil for serving). Cook, stirring occasionally, until sauce is warmed through, 3-4 minutes. Remove from heat and transfer to a large baking dish.",
      "secondary_message": "3 (213 ml) cans tomato sauce"
    },
    {
      "id": 480506,
      "primary_message": "Using a stirring spoon, make a well for each egg in the orzo. Crack an egg into each well.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 480507,
      "primary_message": "Place baking dish in the oven and broil until egg whites are just set, 4-5 minutes. Top with cheese and continue to broil until melted, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 480508,
      "primary_message": "To serve, divide orzo and eggs between plates or bowls; top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
