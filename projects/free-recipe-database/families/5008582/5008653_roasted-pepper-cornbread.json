  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Melt the butter. Thaw the frozen corn kernels.",
      "secondary_message": "3 tbsp butter\n1 cup frozen corn kernels"
    },
    {
      "id": 1,
      "primary_message": "Place a 25-cm cast iron skillet on the middle rack of oven and preheat to 220°C (425°F). Roast red bell pepper and poblano over an open flame on a gas stove or grill until skins are completely charred. Place in a bowl, cover with plastic wrap, and let sit until cooled, 5 to 10 minutes. Peel off charred skins; remove stems and seeds. Finely chop flesh of peppers.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together cornmeal, flour, sugar, baking powder, salt, baking soda, and cayenne pepper. In a separate medium bowl, whisk together sour cream, buttermilk, eggs, 3 tablespoons melted butter, and canola oil. Pour wet ingredients into bowl with dry ingredients and whisk until completely combined. Stir in chopped peppers and corn.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using pot holders, carefully remove hot pan from oven. Place 1 tablespoon butter in skillet and swirl to completely melt and coat inside of pan. Pour in cornbread batter and place in oven. Bake until skewer inserted into middle of cornbread comes out clean, about 20 minutes. Let bread cool in pan for 5 minutes, then carefully turn out to wire rack and let cool an additional 10 minutes. Serve immediately. Reheat any leftover cornbread before serving again.",
      "secondary_message": null
    }
  ],
