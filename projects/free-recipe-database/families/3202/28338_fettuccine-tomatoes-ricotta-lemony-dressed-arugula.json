  "instructions": [
    {
      "id": 488035,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "1 ½ tsp salt\n15 oz fettuccine pasta"
    },
    {
      "id": 488036,
      "primary_message": "Meanwhile, preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 488037,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 488038,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic and crushed red pepper; cook, stirring frequently, until fragrant and golden, about 1 minute.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp crushed red pepper"
    },
    {
      "id": 488039,
      "primary_message": "Add tomatoes and salt to the pot; cook, stirring occasionally, until simmering. Once simmering, reduce heat to medium-low, and continue to cook, stirring occasionally, until slightly thickened, about 15 minutes.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n½ tsp salt"
    },
    {
      "id": 488040,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a medium bowl along with ricotta and salt, then stir to combine. Set aside.",
      "secondary_message": "3 oz Parmesan cheese\n1 ½ (15 oz) pkgs ricotta cheese\n¼ tsp salt"
    },
    {
      "id": 488041,
      "primary_message": "Wash, dry, zest, and juice lemons into a large bowl.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 488042,
      "primary_message": "Peel and mince shallots. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "2 shallots\n3 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 488043,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 488044,
      "primary_message": "Add drained pasta and reserved pasta water to the pot with the sauce. Continue to cook, stirring frequently, until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 488045,
      "primary_message": "To serve, divide pasta and arugula between plates or bowls. Top pasta with ricotta and crushed red pepper. Enjoy!",
      "secondary_message": "3 pinch crushed red pepper"
    }
  ],
