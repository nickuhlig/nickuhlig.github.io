  "instructions": [
    {
      "id": 528795,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 heads romaine lettuce\n6 tomatoes\n1 ½ lb white mushrooms\n1 ½ avocados"
    },
    {
      "id": 528796,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 528797,
      "primary_message": "While the skillet heats up, peel, halve, and medium dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 528798,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onions, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 528799,
      "primary_message": "Meanwhile, place nutritional yeast, oil, vinegar, soy sauce, water, sugar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup nutritional yeast flakes\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n3 tbsp soy sauce\n3 tbsp water\n1 tbsp brown sugar\n1 tbsp garlic powder\n1 tbsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 528800,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 528801,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 528802,
      "primary_message": "Thinly slice mushrooms. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 528803,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and cut crosswise into thin slices.",
      "secondary_message": null
    },
    {
      "id": 528804,
      "primary_message": "To serve, divide salad between bowls, then top with veggie ground and avocados. Enjoy!",
      "secondary_message": null
    }
  ],
