  "instructions": [
    {
      "id": 528845,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 heads romaine lettuce\n4 tomatoes\n0.45 kg white mushrooms\n1 avocado"
    },
    {
      "id": 528846,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 528847,
      "primary_message": "While the skillet heats up, peel, halve, and medium dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 528848,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 528849,
      "primary_message": "Meanwhile, place nutritional yeast, oil, vinegar, soy sauce, water, sugar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup nutritional yeast flakes\n¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n2 tbsp soy sauce\n2 tbsp water\n2 tsp brown sugar\n2 tsp garlic powder\n2 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 528850,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 528851,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 528852,
      "primary_message": "Thinly slice mushrooms. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 528853,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and cut crosswise into thin slices.",
      "secondary_message": null
    },
    {
      "id": 528854,
      "primary_message": "To serve, divide salad between bowls, then top with veggie ground and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
