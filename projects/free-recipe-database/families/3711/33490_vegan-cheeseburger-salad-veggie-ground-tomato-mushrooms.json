  "instructions": [
    {
      "id": 528775,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 head romaine lettuce\n2 tomatoes\n½ lb white mushrooms\n½ avocado"
    },
    {
      "id": 528776,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 528777,
      "primary_message": "While the skillet heats up, peel, halve, and medium dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 528778,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 528779,
      "primary_message": "Meanwhile, place nutritional yeast, oil, vinegar, soy sauce, water, sugar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "⅛ cup nutritional yeast flakes\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp soy sauce\n1 tbsp water\n1 tsp brown sugar\n1 tsp garlic powder\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 528780,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 528781,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 528782,
      "primary_message": "Thinly slice mushrooms. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 528783,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and cut crosswise into thin slices.",
      "secondary_message": null
    },
    {
      "id": 528784,
      "primary_message": "To serve, divide salad between bowls, then top with veggie ground and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
