  "instructions": [
    {
      "primary_message": "FOR THE ROSEMARY SIMPLE SYRUP: Wash, dry, and zest lemon into a small saucepan. (Reserve lemon for later use.)",
      "secondary_message": "½ lemon"
    },
    {
      "primary_message": "Wash and dry rosemary. Set aside one sprig for garnish, then add remaining rosemary to the pan with the lemon zest. ",
      "secondary_message": "¼ small pkg fresh rosemary"
    },
    {
      "primary_message": "Add sugar, water, and pomegranate seeds to the pan; stir to combine and bring to a boil. Reduce heat to medium and simmer, stirring occasionally, until sugar is just dissolved. Remove from heat and let cool completely before straining and using. (NOTE: this recipe makes about 2/3 cup rosemary simple syrup. Transfer leftover syrup to a small jar and refrigerate for up to one month.)",
      "secondary_message": "½ cup granulated sugar\npomegranate seeds"
    },
    {
      "primary_message": "FOR THE COCKTAIL: Juice reserved lemon into a small bowl, then measure out 1 tbsp juice and place in a cocktail shaker. (Reserve remaining lemon juice for another use.) ",
      "secondary_message": null
    },
    {
      "primary_message": "Add 1/2 fl oz (1 tbsp) rosemary simple syrup, 1 1/2 fl oz (3 tbsp) tequila, 1/2 fl oz aperol (1 tbsp), and ice cubes to the shaker. Shake until well chilled, about 20 seconds.",
      "secondary_message": "1 ½ fl oz tequila\n¼ fl oz Aperol Aperitivo Liqueur\n½ cup ice cube"
    },
    {
      "primary_message": "Strain cocktail into a tall glass. Add additional ice, then top off with 3 fl oz (1/3 cup) chilled orange juice. Stir gently, then garnish with the reserved rosemary sprig and pomegranate seeds. Enjoy!",
      "secondary_message": "½ cup ice cube\npomegranate seeds"
    }
  ],
