  "instructions": [
    {
      "id": 453190,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 453191,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lb sweet potatoes\n1 ½ limes\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 453192,
      "primary_message": "Peel and small dice sweet potatoes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp smoked paprika\n¾ tsp cumin, ground\n¾ tsp salt"
    },
    {
      "id": 453193,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potatoes are browned and fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 453194,
      "primary_message": "Meanwhile, preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 453195,
      "primary_message": "While the skillet heats up, peel, halve, and slice onions crosswise into thin half-moons.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 453196,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, salt, and pepper; cook, stirring occasionally, until onions are soft and golden brown, about 10 minutes. Remove from heat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 453197,
      "primary_message": "While the onion is cooking, juice limes into a large bowl. Add oil, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 453198,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl with the dressing. ",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 453199,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with pumpkin seeds, and set aside.",
      "secondary_message": "⅓ cup pumpkin seeds"
    },
    {
      "id": 453200,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 453201,
      "primary_message": "Place tortillas on a flat surface and divide onion, sweet potato, and cheese between them, arranging the filling on one half of each tortilla; fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 453202,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 453203,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add quesadillas and cook until cheese is melted and tortillas are golden, 2½-3 minutes per side. Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 453204,
      "primary_message": "Meanwhile, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 453205,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
