  "instructions": [
    {
      "id": 453206,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 453207,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "0.23 kg sweet potato\n½ lime\n½ small pkg grape tomatoes\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 453208,
      "primary_message": "Peel and small dice sweet potato. Transfer to a baking sheet pan, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp smoked paprika\n¼ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 453209,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potatoes are browned and fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 453210,
      "primary_message": "Meanwhile, preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 453211,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 453212,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, salt, and pepper; cook, stirring occasionally, until onions are soft and golden brown, about 10 minutes. Remove from heat. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 453213,
      "primary_message": "While the onion is cooking, juice lime into a medium bowl. Add oil, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 453214,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl with the dressing. ",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 453215,
      "primary_message": "Halve grape tomatoes. Add to the bowl, along with pumpkin seeds, and set aside.",
      "secondary_message": "⅛ cup pumpkin seeds"
    },
    {
      "id": 453216,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 453217,
      "primary_message": "Place tortillas on a flat surface and divide onion, sweet potato, and cheese between them, arranging the filling on one half of each tortilla; fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 453218,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 453219,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add quesadillas and cook until cheese is melted and tortillas are golden, 2½-3 minutes per side. Remove to a plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 453220,
      "primary_message": "Meanwhile, add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 453221,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
