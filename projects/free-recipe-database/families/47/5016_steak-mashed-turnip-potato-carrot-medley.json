  "instructions": [
    {
      "id": 60870,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil.",
      "secondary_message": "about 10 cups water"
    },
    {
      "id": 60869,
      "primary_message": "Wash turnips, potatoes, and carrots. Peel, large dice, and add to saucepan. Once boiling, cook until vegetables are tender, 10-12 minutes.",
      "secondary_message": "3 turnips\n0.681 kg sweet potatoes\n6 medium carrots"
    },
    {
      "id": 60868,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 60867,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "1 ½ small pkg fresh basil"
    },
    {
      "id": 60863,
      "primary_message": "Coat bottom of skillet with oil. Season steak with salt and pepper on both sides. Place in the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "3 tbsp virgin coconut oil\n1.02 kg ribeye steak\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60866,
      "primary_message": "Drain vegetables and return back to saucepan. Add broth, oil, ½ of the basil (save the rest for garnishing), salt, and pepper. Mash until smooth.",
      "secondary_message": "354 ml (1 ½ cup) chicken or vegetable broth\n3 tbsp virgin coconut oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 60865,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": ""
    },
    {
      "id": 60864,
      "primary_message": "To serve, place mash on a plate, add steak slices, and sprinkle with remaining basil. Enjoy!",
      "secondary_message": ""
    }
  ],
