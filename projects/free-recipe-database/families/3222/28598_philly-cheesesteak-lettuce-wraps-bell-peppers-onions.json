  "instructions": [
    {
      "id": 456908,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with Worcestershire, oil, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n2 tbsp Worcestershire sauce\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 456909,
      "primary_message": "Pat steak dry with paper towels, then slice against the grain into very thin strips. Add to the bowl with the marinade, stir to coat, and set aside.",
      "secondary_message": "0.68 kg flank steak"
    },
    {
      "id": 456910,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 green bell peppers\n1 head butter (Boston) lettuce"
    },
    {
      "id": 456911,
      "primary_message": "Using a clean cutting board, trim, seed, and slice bell peppers lengthwise into thin strips. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 456912,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 456913,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the bell peppers. Set aside.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 456914,
      "primary_message": "Once the skillet is hot, add steak strips and marinade. Cook to desired doneness, about 1 minute per side for medium-rare. Transfer steak to a large baking sheet pan and spread out in an even layer. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 456915,
      "primary_message": "Return skillet to medium-high heat, add oil, and swirl to coat the bottom. Add veggies, salt, and pepper; stir-fry until veggies are fork-tender, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 456916,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "⅔ (227 g) block cheddar cheese"
    },
    {
      "id": 456917,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 456918,
      "primary_message": "Add veggies to the baking sheet, spreading them over the steak, then top with cheese. Place baking sheet in the oven and broil until cheese melts, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 456919,
      "primary_message": "Separate lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill with cheesy steak and veggies. Enjoy!",
      "secondary_message": null
    }
  ],
