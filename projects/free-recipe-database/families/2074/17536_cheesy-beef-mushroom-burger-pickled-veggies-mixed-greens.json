  "instructions": [
    {
      "id": 284507,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ English cucumbers\n3 yellow bell peppers\n3 caps portobello mushrooms\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 284508,
      "primary_message": "Trim and thinly slice cucumbers into rounds; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 284509,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise; thinly slice crosswise and add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 284510,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 284511,
      "primary_message": "Place vinegar, water, sugar, and salt in a large pot; stir to combine and bring to a boil over high heat. Once boiling, remove from heat, add veggies, and stir to combine. Set aside to marinate. (Reserve bowl for next step.)",
      "secondary_message": "¾ cup white wine vinegar\n¾ cup water\n1 ½ tsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 284512,
      "primary_message": "Using a box grater, coarsely grate the mushrooms and place in the reserved bowl. (Alternatively, you can mince the mushrooms.)",
      "secondary_message": null
    },
    {
      "id": 284513,
      "primary_message": "Add beef, salt, and pepper to the bowl with the mushroom; mix with your hands until well combined. Form the beef mixture into 6 equal-sized patties and place on a plate. ",
      "secondary_message": "2 ¼ lb lean ground beef\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 284514,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 284515,
      "primary_message": "While the grill pan heats up, slice cheese.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 284516,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add burger patties to the pan and cook, undisturbed, for 5 minutes; flip patties, top with cheese, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 284517,
      "primary_message": "Meanwhile, place mayo in a clean large bowl; add 3 tablespoons of the pickling liquid to the bowl and stir to combine the dressing.",
      "secondary_message": "1 ½ tbsp mayonnaise"
    },
    {
      "id": 284518,
      "primary_message": "Transfer ¾ of the pickled veggies to the bowl with the dressing; add mixed greens and toss to combine the salad. (Reserve remaining pickled veggies for the burgers.)",
      "secondary_message": null
    },
    {
      "id": 284519,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 284520,
      "primary_message": "Spread additional mayo over the bottom half of each bun; top with cheesy burger patties and reserved pickled veggies. Close with the top half of each bun.",
      "secondary_message": "2 tbsp mayonnaise"
    },
    {
      "id": 284521,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
