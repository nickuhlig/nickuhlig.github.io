  "instructions": [
    {
      "id": 284477,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ English cucumber\n1 yellow bell pepper\n1 cap portobello mushroom\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 284478,
      "primary_message": "Trim and thinly slice cucumber into rounds; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 284479,
      "primary_message": "Trim, seed, and halve bell pepper lengthwise; thinly slice crosswise and add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 284480,
      "primary_message": "Peel and thinly slice shallot into rings; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 284481,
      "primary_message": "Place vinegar, water, sugar, and salt in a medium saucepan; stir to combine and bring to a boil over high heat. Once boiling, remove from heat, add veggies, and stir to combine. Set aside to marinate. (Reserve bowl for next step.)",
      "secondary_message": "¼ cup white wine vinegar\n¼ cup water\n½ tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 284482,
      "primary_message": "Using a box grater, coarsely grate the mushroom and place in the reserved bowl. (Alternatively, you can mince the mushroom.)",
      "secondary_message": null
    },
    {
      "id": 284483,
      "primary_message": "Add beef, salt, and pepper to the bowl with the mushroom; mix with your hands until well combined. Form the beef mixture into 2 equal-sized patties and place on a plate. ",
      "secondary_message": "¾ lb lean ground beef\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 284484,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 284485,
      "primary_message": "While the grill pan heats up, slice cheese.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 284486,
      "primary_message": "Once the grill pan is hot, coat with oil. Add burger patties to the pan and cook, undisturbed, for 5 minutes; flip patties, top with cheese, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 284487,
      "primary_message": "Meanwhile, place mayo in a clean medium bowl; add 1 tablespoon of the pickling liquid to the bowl and stir to combine the dressing.",
      "secondary_message": "1 ½ tsp mayonnaise"
    },
    {
      "id": 284488,
      "primary_message": "Transfer ¾ of the pickled veggies to the bowl with the dressing; add mixed greens and toss to combine the salad. (Reserve remaining pickled veggies for the burgers.)",
      "secondary_message": null
    },
    {
      "id": 284489,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 284490,
      "primary_message": "Spread additional mayo over the bottom half of each bun; top with cheesy burger patties and reserved pickled veggies. Close with the top half of each bun.",
      "secondary_message": "2 tsp mayonnaise"
    },
    {
      "id": 284491,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
