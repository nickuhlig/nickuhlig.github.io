  "instructions": [
    {
      "id": 284637,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ English cucumbers\n3 yellow bell peppers\n3 caps portobello mushrooms\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 284638,
      "primary_message": "Trim and thinly slice cucumbers into rounds; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 284639,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise; thinly slice crosswise and add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 284640,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 284641,
      "primary_message": "Place vinegar, water, and salt in a large pot; stir to combine and bring to a boil over high heat. Once boiling, remove from heat, add veggies, and stir to combine. Set aside to marinate. (Reserve bowl for next step.)",
      "secondary_message": "¾ cup white wine vinegar\n¾ cup water\n¾ tsp salt"
    },
    {
      "id": 284642,
      "primary_message": "Using a box grater, coarsely grate the mushrooms and place in the reserved bowl. (Alternatively, you can mince the mushrooms.)",
      "secondary_message": null
    },
    {
      "id": 284643,
      "primary_message": "Add beef, salt, and pepper to the bowl with the mushroom; mix with your hands until well combined. Form the beef mixture into 6 equal-sized patties and place on a plate. ",
      "secondary_message": "1.02 kg lean ground beef\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 284644,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 284645,
      "primary_message": "While the grill pan heats up, slice cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 284646,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add burger patties to the pan and cook, undisturbed, for 5 minutes; flip patties, top with cheese, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 284647,
      "primary_message": "Meanwhile, place mayo in a clean large bowl; add 3 tablespoons of the pickling liquid to the bowl and stir to combine the dressing.",
      "secondary_message": "1 ½ tbsp avocado oil mayonnaise"
    },
    {
      "id": 284648,
      "primary_message": "Transfer ¾ of the pickled veggies to the bowl with the dressing. (Reserve remaining pickled veggies for the burgers.)",
      "secondary_message": null
    },
    {
      "id": 284649,
      "primary_message": "Separate the lettuce leaves. Set aside two leaves per burger and chop or tear remaining leaves into bite-sized pieces; add to the bowl with the dressing and pickled veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 284650,
      "primary_message": "Pile lettuce leaves, in stacks of two per wrap, onto each plate. Top with cheesy burger patties, mayo, and reserved pickled veggies. Serve with salad on the side and enjoy!",
      "secondary_message": "2 tbsp avocado oil mayonnaise"
    }
  ],
