  "instructions": [
    {
      "id": 284492,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 English cucumber\n2 yellow bell peppers\n2 caps portobello mushrooms\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 284493,
      "primary_message": "Trim and thinly slice cucumber into rounds; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 284494,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise; thinly slice crosswise and add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 284495,
      "primary_message": "Peel and thinly slice shallots into rings; add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 284496,
      "primary_message": "Place vinegar, water, sugar, and salt in a large pot; stir to combine and bring to a boil over high heat. Once boiling, remove from heat, add veggies, and stir to combine. Set aside to marinate. (Reserve bowl for next step.)",
      "secondary_message": "½ cup white wine vinegar\n½ cup water\n1 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 284497,
      "primary_message": "Using a box grater, coarsely grate the mushrooms and place in the reserved bowl. (Alternatively, you can mince the mushrooms.)",
      "secondary_message": null
    },
    {
      "id": 284498,
      "primary_message": "Add beef, salt, and pepper to the bowl with the mushroom; mix with your hands until well combined. Form the beef mixture into 4 equal-sized patties and place on a plate. ",
      "secondary_message": "1 ½ lb lean ground beef\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 284499,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 284500,
      "primary_message": "While the grill pan heats up, slice cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 284501,
      "primary_message": "Once the pan is hot, coat with oil. Place burger patties on the grill pan and cook, undisturbed, for 5 minutes; flip patties, top with cheese, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 284502,
      "primary_message": "Meanwhile, place mayo in a clean medium bowl; add 2 tablespoons of the pickling liquid to the bowl and stir to combine the dressing.",
      "secondary_message": "1 tbsp mayonnaise"
    },
    {
      "id": 284503,
      "primary_message": "Transfer ¾ of the pickled veggies to the bowl with the dressing; add mixed greens and toss to combine the salad. (Reserve remaining pickled veggies for the burgers.)",
      "secondary_message": null
    },
    {
      "id": 284504,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 284505,
      "primary_message": "Spread additional mayo over the bottom half of each bun; top with cheesy burger patties and reserved pickled veggies. Close with the top half of each bun.",
      "secondary_message": "4 tsp mayonnaise"
    },
    {
      "id": 284506,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
