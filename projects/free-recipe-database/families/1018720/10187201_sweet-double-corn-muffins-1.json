  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Grease 12 muffin cups with butter, then set the muffin pan aside.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "primary_message": "Place additional butter in a small saucepan. Heat over low until just melted; set aside.",
      "secondary_message": "butter, unsalted"
    },
    {
      "primary_message": "Place corn in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "primary_message": "Place flour, cornmeal, sugar, baking powder, and salt in a large bowl. Whisk to combine the dry ingredients and set aside.",
      "secondary_message": "1 cup all-purpose flour\n1 cup polenta (cornmeal)\n⅓ cup granulated sugar\n4 tsp baking powder\n½ tsp salt"
    },
    {
      "primary_message": "Place eggs and milk in a medium bowl; whisk to combine the wet ingredients.",
      "secondary_message": "237 ml whole milk"
    },
    {
      "primary_message": "Add wet ingredients to the bowl with the dry ingredients; whisk until almost combined.",
      "secondary_message": null
    },
    {
      "primary_message": "Using the back of a spoon, gently press excess moisture out of the drained corn. Add corn to the bowl, along with the melted butter, and stir until just combined.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide the batter between muffin cups (about 1/3-cup per muffin).",
      "secondary_message": null
    },
    {
      "primary_message": "Place pan in the oven and bake until muffins are golden brown and a toothpick inserted into the center comes out clean, about 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Remove pan from the oven and let muffins cool for 2-3 minutes. Serve warm.",
      "secondary_message": null
    }
  ],
