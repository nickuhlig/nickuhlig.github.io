  "instructions": [
    {
      "id": 153492,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 153493,
      "primary_message": "In a large bowl, combine flour, cornmeal, baking powder, sugar, and salt; stir to combine.",
      "secondary_message": "2 ¼ cup all-purpose flour\n¾ cup polenta (cornmeal)\n1 tbsp baking powder\n1 ½ tsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 153494,
      "primary_message": "Using a box grater, coarsely grate cold butter into the bowl with the flour. Using two hands, combine the flour and butter by rubbing the mixture between your thumbs and fingers until it looks crumbly. Add the milk and stir to combine.",
      "secondary_message": "¾ cup butter, unsalted\n355 ml whole milk"
    },
    {
      "id": 153495,
      "primary_message": "Using a scant ¼-cup measure, drop portions of batter onto a large baking sheet pan, spacing them 2-inches apart. Place in the oven and bake until lightly golden, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 153496,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 153497,
      "primary_message": "Transfer shrimp to a plate and season with salt and pepper on both sides; set aside.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 153498,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches green onions (scallions)\n3 small pkgs grape tomatoes\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 153499,
      "primary_message": "Trim off and discard ends of the green onions; cut crosswise into ¼-inch pieces. Halve tomatoes crosswise.",
      "secondary_message": null
    },
    {
      "id": 153500,
      "primary_message": "Peel and thinly slice garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 153501,
      "primary_message": "Heat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 153502,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add green onions, tomatoes, garlic, salt, and pepper; cook, stirring often, until tomatoes have softened, about 4 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 153503,
      "primary_message": "Add shrimp to the skillet; continue to cook, stirring occasionally, until cooked through and opaque, about 5 minutes. Juice lemons into the skillet and stir to combine; remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 153504,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 153505,
      "primary_message": "To serve, divide shrimp and biscuits between bowls or plates and garnish with parsley. Enjoy!",
      "secondary_message": null
    }
  ],
