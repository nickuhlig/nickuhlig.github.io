  "instructions": [
    {
      "id": 441401,
      "primary_message": "Place a large bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 441402,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ oranges\n3 pears\n3 Gala apples\n1 ½ lb red grapes"
    },
    {
      "id": 441403,
      "primary_message": "Zest and juice oranges into another large bowl. Add maple syrup and spices, then stir to combine. ",
      "secondary_message": "3 tbsp pure maple syrup\n¾ tsp cinnamon, ground\n¼ tsp cloves, ground\n3 pinch salt"
    },
    {
      "id": 441404,
      "primary_message": "Quarter, core, and medium dice pears. Add to the bowl with the spiced dressing. ",
      "secondary_message": null
    },
    {
      "id": 441405,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 441406,
      "primary_message": "Halve grapes. Add to the bowl, stir to combine the fruit salad, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 441407,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 441408,
      "primary_message": "Remove bowl from the freezer. Pour cold cream, maple syrup, and vanilla into the bowl.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n1 tbsp pure maple syrup\n¾ tsp vanilla extract"
    },
    {
      "id": 441409,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 441410,
      "primary_message": "To serve, divide fruit salad between bowls, then top with whipped cream and walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
