  "instructions": [
    {
      "id": 441448,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 441449,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 orange\n2 pears\n2 Gala apples\n0.45 kg red grapes"
    },
    {
      "id": 441450,
      "primary_message": "Zest and juice orange into another medium bowl. Add maple syrup and spices, then stir to combine. ",
      "secondary_message": "2 tbsp pure maple syrup\n½ tsp cinnamon, ground\n¼ tsp cloves, ground\n⅛ tsp salt"
    },
    {
      "id": 441451,
      "primary_message": "Quarter, core, and medium dice pears. Add to the bowl with the spiced dressing. ",
      "secondary_message": null
    },
    {
      "id": 441452,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 441453,
      "primary_message": "Halve grapes. Add to the bowl, stir to combine the fruit salad, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 441454,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 441455,
      "primary_message": "Remove bowl from the freezer. Pour cold cream, maple syrup, and vanilla into the bowl.",
      "secondary_message": "237 ml heavy whipping cream\n2 tsp pure maple syrup\n½ tsp vanilla extract"
    },
    {
      "id": 441456,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 441457,
      "primary_message": "To serve, divide fruit salad between bowls, then top with whipped cream and walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
