  "instructions": [
    {
      "id": 441411,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 441412,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ orange\n1 pear\n1 Gala apple\n½ lb red grapes"
    },
    {
      "id": 441413,
      "primary_message": "Zest and juice orange into another medium bowl. Add maple syrup and spices, then stir to combine. ",
      "secondary_message": "1 tbsp pure maple syrup\n¼ tsp cinnamon, ground\n⅛ tsp clove, ground\n1 pinch salt"
    },
    {
      "id": 441414,
      "primary_message": "Quarter, core, and medium dice pear. Add to the bowl with the spiced dressing.",
      "secondary_message": null
    },
    {
      "id": 441415,
      "primary_message": "Quarter, core, and medium dice apple. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 441416,
      "primary_message": "Halve grapes. Add to the bowl, stir to combine the fruit salad, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 441417,
      "primary_message": "Remove bowl from the freezer. Pour cold cream, maple syrup, and vanilla into the bowl.",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream\n1 tsp pure maple syrup\n¼ tsp vanilla extract"
    },
    {
      "id": 441418,
      "primary_message": "Use a whisk to beat the cream vigorously, until medium-soft peaks form, about 2 minutes. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 441419,
      "primary_message": "To serve, divide fruit salad between bowls and top with whipped cream. Enjoy!",
      "secondary_message": null
    }
  ],
