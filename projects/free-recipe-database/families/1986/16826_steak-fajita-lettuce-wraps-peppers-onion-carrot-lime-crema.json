  "instructions": [
    {
      "id": 321929,
      "primary_message": "Preheat the oven to 450°F. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 321930,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 green bell pepper\n1 medium carrot\n1 lime\n½ head butter (Boston) lettuce"
    },
    {
      "id": 321931,
      "primary_message": "Place spices in a small bowl and stir to combine.",
      "secondary_message": "1 ½ tsp chili powder\n1 ½ tsp cumin, ground\n1 tsp garlic powder\n1 tsp paprika\n¾ tsp salt\n⅛ tsp black pepper\n1 pinch cayenne pepper"
    },
    {
      "id": 321932,
      "primary_message": "Pat steak dry with paper towels and place in the center of the baking sheet; drizzle with oil and sprinkle with half of the spice mixture on both sides (reserve remaining spices for the veggies).",
      "secondary_message": "¾ lb striploin (New York strip) steak\n1 tsp extra virgin olive oil"
    },
    {
      "id": 321933,
      "primary_message": "Trim, seed, and slice the bell peppers lengthwise into strips; place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 321934,
      "primary_message": "Peel, halve, and slice onion into ½-inch thick half-moons; add to the bowl with the peppers. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 321935,
      "primary_message": "Peel, trim, and quarter carrot lengthwise, then cut crosswise into 3-inch long pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 321936,
      "primary_message": "Sprinkle remaining spice mixture over the veggies, drizzle with oil, and toss to combine. Add veggies to the baking sheet, spreading out in an even layer around steak. (Reserve spice bowl for next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 321937,
      "primary_message": "Juice half of the lime over steak and veggies; juice the other half into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 321938,
      "primary_message": "Place the baking sheet in the oven and roast, stirring veggies and flipping steak halfway through, until veggies are tender and steak is cooked to desired doneness, 13-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 321939,
      "primary_message": "Meanwhile, add yogurt and spices to the bowl with the lime juice; whisk to combine lime crema.",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp garlic powder\n½ tsp cumin, ground\n1 pinch salt"
    },
    {
      "id": 321940,
      "primary_message": "When the steak and veggies are done, transfer steak to the cutting board and thinly slice against the grain.",
      "secondary_message": null
    },
    {
      "id": 321941,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with veggies and steak; serve with a drizzle of lime crema and enjoy!",
      "secondary_message": null
    }
  ],
