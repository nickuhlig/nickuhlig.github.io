  "instructions": [
    {
      "id": 322068,
      "primary_message": "Preheat the oven to 230°C (450°F). Line two large baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 322069,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 green bell peppers\n3 medium carrots\n3 limes"
    },
    {
      "id": 322070,
      "primary_message": "Place spices in a small bowl and stir to combine.",
      "secondary_message": "1 ½ tbsp chili powder\n1 ½ tbsp cumin, ground\n1 tbsp garlic powder\n1 tbsp paprika\n2 tsp salt\n½ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 322071,
      "primary_message": "Pat steak dry with paper towels and divide between the baking sheets, placing in the center; drizzle with oil and sprinkle with half of the spice mixture on both sides (reserve remaining spices for the veggies).",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 322072,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into strips; place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 322073,
      "primary_message": "Peel, halve, and slice onions into ½-inch thick half-moons; add to the bowl with the peppers.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 322074,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 322075,
      "primary_message": "Sprinkle remaining spice mixture over the veggies, drizzle with oil, and toss to combine. Add veggies to the baking sheets with the steak, spreading out in an even layer around the steak. (Reserve spice bowl for next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 322076,
      "primary_message": "Juice half of the limes over steak and veggies; juice the remaining limes into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 322077,
      "primary_message": "Place the baking sheets in the oven and roast, stirring veggies and flipping steak halfway through, until veggies are tender and steak is cooked to desired doneness, 15-17 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 322078,
      "primary_message": "Meanwhile, add yogurt and spices to the bowl with the lime juice; whisk to combine the lime crema.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 ½ tsp garlic powder\n1 ½ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 322079,
      "primary_message": "When the steak and veggies are done, transfer steak to the cutting board and thinly slice against the grain.",
      "secondary_message": null
    },
    {
      "id": 322080,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 322081,
      "primary_message": "To serve, divide tortillas between plates; fill with steak and veggies, then drizzle with lime crema. Enjoy!",
      "secondary_message": null
    }
  ],
