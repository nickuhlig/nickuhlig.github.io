  "instructions": [
    {
      "id": 188512,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n½ lemon\n1 tomato\n½ head butter (Boston) lettuce"
    },
    {
      "id": 188513,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188514,
      "primary_message": "Trim ends and slice zucchini lengthwise into ¼-inch thick planks. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 188515,
      "primary_message": "Peel and thinly slice onion into rings; add to the bowl with the zucchini. Add oil and salt; toss to coat.",
      "secondary_message": "½ medium red onion\n1 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 188516,
      "primary_message": "Once the grill pan is hot, add the veggies and cook until tender, 3-4 minutes per side. Return veggies to the bowl and cover with foil.",
      "secondary_message": null
    },
    {
      "id": 188517,
      "primary_message": "Meanwhile, drain and rinse beans; transfer to a blender.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 188518,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 188519,
      "primary_message": "Juice lemon into the blender. Add water, oil, tahini, paprika, and salt. Blend on high for several minutes until smooth. Add more water, one tbsp at a time, if needed, to reach desired consistency. Set aside.",
      "secondary_message": "3 tbsp water\n2 tbsp extra virgin olive oil\n1 tbsp tahini\n¼ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 188520,
      "primary_message": "Thinly slice tomato into rounds.",
      "secondary_message": null
    },
    {
      "id": 188521,
      "primary_message": "Place tortillas on a flat surface and spread evenly with hummus. Divide zucchini, onion, tomato, and lettuce between them; roll tightly to close.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 188522,
      "primary_message": "Return grill pan to medium-high heat. Once the grill pan is hot, coat the bottom with oil. Place wraps on the grill and cook, rotating every 1-2 minutes, until tortillas are crispy and golden. Cut each wrap in half.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 188523,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
