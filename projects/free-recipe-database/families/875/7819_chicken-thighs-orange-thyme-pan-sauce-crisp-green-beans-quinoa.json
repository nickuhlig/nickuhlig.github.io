  "instructions": [
    {
      "id": 173326,
      "primary_message": "In a medium saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n2 cup water"
    },
    {
      "id": 173327,
      "primary_message": "Pat the chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 173328,
      "primary_message": "Preheat a large skillet over medium-high heat; add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 173329,
      "primary_message": "Add the chicken to the skillet; pan-fry until cooked through and golden brown, 5-6 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 173330,
      "primary_message": "Meanwhile, peel and thinly slice the shallots into rings.",
      "secondary_message": "4 shallots"
    },
    {
      "id": 173331,
      "primary_message": "Wash, trim, and discard the ends of the green beans.",
      "secondary_message": "0.45 kg green beans"
    },
    {
      "id": 173332,
      "primary_message": "Wash, dry, and zest one orange into a small bowl; juice both oranges into the same bowl.",
      "secondary_message": "2 oranges"
    },
    {
      "id": 173333,
      "primary_message": "When the chicken is done, transfer it to a plate, cover loosely with foil, and set aside.",
      "secondary_message": null
    },
    {
      "id": 173334,
      "primary_message": "Return skillet to stove; reduce heat to medium and add the shallot. Cook, stirring occasionally, until tender, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 173335,
      "primary_message": "Peel and mince garlic; add to the skillet with the shallots.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 173336,
      "primary_message": "Add the broth, any accumulated drippings, orange zest and juice, salt, and pepper to the skillet; scrape up any brown bits from the bottom of the pan.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 173337,
      "primary_message": "Add beans to the skillet and bring to a simmer; continue to cook until sauce is reduced slightly and beans are tender-crisp, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 173338,
      "primary_message": "Wash the thyme and slide the leaves off the stems; discard the stems.",
      "secondary_message": "1 small pkg fresh thyme"
    },
    {
      "id": 173339,
      "primary_message": "Remove the skillet from the heat and stir in the butter and thyme.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 173340,
      "primary_message": "To serve, divide quinoa, chicken, beans, and pan sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
