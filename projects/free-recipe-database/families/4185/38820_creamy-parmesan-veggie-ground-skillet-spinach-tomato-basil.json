  "instructions": [
    {
      "id": 632531,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg grape tomatoes\n1 (142 g) pkg baby spinach\n½ small pkg fresh basil"
    },
    {
      "id": 632532,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 632533,
      "primary_message": "While the skillet heats up, peel and mince garlic and shallot.",
      "secondary_message": "1 clove garlic\n1 shallot"
    },
    {
      "id": 632534,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, shallot, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n1 tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 632535,
      "primary_message": "Meanwhile, halve grape tomatoes.",
      "secondary_message": null
    },
    {
      "id": 632536,
      "primary_message": "When the veggie ground is almost cooked through, add tomatoes and spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until veggie ground is cooked through and tomatoes are softened, 4-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 632537,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a small bowl.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 632538,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the Parmesan and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 632539,
      "primary_message": "Add half of the Parmesan-basil mixture to the skillet, along with the cream (reserving the rest for serving). Continue to cook, stirring frequently, until thickened slightly, 2-3 minutes more. Remove from heat.",
      "secondary_message": "59 ml (¼ cup) heavy whipping cream"
    },
    {
      "id": 632540,
      "primary_message": "To serve, divide skillet between plates or bowls, then top with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
