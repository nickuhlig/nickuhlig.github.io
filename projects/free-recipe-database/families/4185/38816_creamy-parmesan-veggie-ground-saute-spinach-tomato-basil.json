  "instructions": [
    {
      "id": 632491,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 pints grape tomatoes\n3 (5 oz) pkgs baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 632492,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 632493,
      "primary_message": "While the pot heats up, peel and mince garlic; peel, halve, and mince onion.",
      "secondary_message": "3 cloves garlic\n½ medium red onion"
    },
    {
      "id": 632494,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, onion, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until almost cooked through, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 tbsp Italian seasoning\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 632495,
      "primary_message": "Meanwhile, halve grape tomatoes.",
      "secondary_message": null
    },
    {
      "id": 632496,
      "primary_message": "When the veggie ground is almost cooked through, add tomatoes and spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until veggie ground is cooked through and tomatoes are softened, 5-6 minutes more.",
      "secondary_message": null
    },
    {
      "id": 632497,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a medium bowl.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 632498,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the Parmesan and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 632499,
      "primary_message": "Add half of the Parmesan-basil mixture to the pot, along with the cream (reserving the rest for serving). Continue to cook, stirring frequently, until thickened slightly, 3-4 minutes more. Remove from heat.",
      "secondary_message": "6 fl oz (¾ cup) heavy whipping cream"
    },
    {
      "id": 632500,
      "primary_message": "To serve, divide sauté between plates or bowls, then top with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
