  "instructions": [
    {
      "id": 632451,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 pints grape tomatoes\n2 (5 oz) pkgs baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 632452,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 632453,
      "primary_message": "While the skillet heats up, peel and mince garlic and shallots.",
      "secondary_message": "2 cloves garlic\n2 shallots"
    },
    {
      "id": 632454,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, shallot, turkey, and spices; cook, breaking the meat apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb ground turkey\n2 tsp Italian seasoning\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 632455,
      "primary_message": "Meanwhile, halve grape tomatoes.",
      "secondary_message": null
    },
    {
      "id": 632456,
      "primary_message": "When the turkey is almost cooked through, add tomatoes and spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until turkey is cooked through and tomatoes are softened, 4-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 632457,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a medium bowl.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 632458,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the Parmesan and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 632459,
      "primary_message": "Add half of the Parmesan-basil mixture to the skillet, along with the cream (reserving the rest for serving). Continue to cook, stirring frequently, until thickened slightly, 2-3 minutes more. Remove from heat.",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 632460,
      "primary_message": "To serve, divide skillet between plates or bowls, then top with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
