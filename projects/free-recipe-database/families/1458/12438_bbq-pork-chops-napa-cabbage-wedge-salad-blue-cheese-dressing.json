  "instructions": [
    {
      "id": 208738,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 208739,
      "primary_message": "Place ketchup, Worcestershire, sugar, vinegar, Dijon, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "½ cup ketchup\n2 tbsp Worcestershire sauce\n1 tbsp brown sugar\n1 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 208740,
      "primary_message": "Pat pork chops dry with paper towels and place on a large broiler pan. Pour ⅔ of the BBQ sauce over the chops and turn to coat. Set remaining sauce aside.",
      "secondary_message": "6 pork chops, bone-in"
    },
    {
      "id": 208741,
      "primary_message": "Place pork chops in the oven and broil until the tops start to brown and caramelize, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 208742,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, Dijon, sugar, and spices in a medium bowl; whisk until smooth.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp mayonnaise\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp brown sugar\n¾ tsp garlic powder\n¾ tsp onion powder\n½ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 208743,
      "primary_message": "Add blue cheese and stir to combine the dressing; set aside.",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 208744,
      "primary_message": "Remove pork chops from the oven, flip, and coat with remaining BBQ sauce. Return to the oven and broil until cooked through, 8-10 minutes more. Remove from oven, loosely cover with foil, and rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 208745,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n3 Gala apples\n1 small pkg chives"
    },
    {
      "id": 208746,
      "primary_message": "Trim off and discard the root end of each cabbage. Cut cabbage heads into quarters lengthwise, to make six wedges.",
      "secondary_message": null
    },
    {
      "id": 208747,
      "primary_message": "Quarter, core, and small dice apples.",
      "secondary_message": null
    },
    {
      "id": 208748,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 208749,
      "primary_message": "To serve, divide pork chops and cabbage wedges between plates; top wedges with dressing, apples, and chives. Enjoy!",
      "secondary_message": null
    }
  ],
