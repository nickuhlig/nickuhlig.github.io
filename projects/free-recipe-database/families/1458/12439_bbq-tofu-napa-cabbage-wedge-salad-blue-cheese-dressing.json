  "instructions": [
    {
      "id": 208750,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 208751,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. Coat another baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 208752,
      "primary_message": "Place ketchup, sugar, soy sauce, vinegar, Dijon, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "3 tbsp ketchup\n2 tsp brown sugar\n2 tsp soy sauce\n1 tsp apple cider vinegar\n1 tsp Dijon mustard\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 208753,
      "primary_message": "Cut the tofu planks in half, then cut each half into 2 triangles; transfer to the baking sheet. Pour ⅔ of the BBQ sauce over the tofu and turn to coat. Set remaining sauce aside.",
      "secondary_message": null
    },
    {
      "id": 208754,
      "primary_message": "Place tofu in the oven and broil until the tops start to brown and caramelize, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 208755,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, Dijon, sugar, and spices in another small bowl; whisk until smooth.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp brown sugar\n¼ tsp garlic powder\n¼ tsp onion powder\n⅛ tsp black pepper\n3 pinch salt"
    },
    {
      "id": 208756,
      "primary_message": "Add blue cheese and stir to combine the dressing; set aside.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 208757,
      "primary_message": "Remove tofu from the oven, flip, and coat with remaining BBQ sauce. Return to the oven and broil until brown and caramelized on the other side, 6-8 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 208758,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n1 Gala apple\n½ small pkg chives"
    },
    {
      "id": 208759,
      "primary_message": "Trim off and discard the root end of the cabbage. Cut cabbage in half lengthwise, to make two wedges.",
      "secondary_message": null
    },
    {
      "id": 208760,
      "primary_message": "Quarter, core, and small dice apple.",
      "secondary_message": null
    },
    {
      "id": 208761,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 208762,
      "primary_message": "To serve, divide tofu and cabbage wedges between plates; top wedges with dressing, apples, and chives. Enjoy!",
      "secondary_message": null
    }
  ],
