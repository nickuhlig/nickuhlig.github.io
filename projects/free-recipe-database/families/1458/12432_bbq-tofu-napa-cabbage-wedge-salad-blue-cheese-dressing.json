  "instructions": [
    {
      "id": 208662,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 208663,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. Coat another large baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 208664,
      "primary_message": "Place ketchup, sugar, soy sauce, vinegar, Dijon, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "½ cup ketchup\n2 tbsp brown sugar\n2 tbsp soy sauce\n1 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 208665,
      "primary_message": "Cut the tofu planks in half, then cut each half into 2 triangles; transfer to the baking sheet. Pour ⅔ of the BBQ sauce over the tofu and turn to coat. Set remaining sauce aside.",
      "secondary_message": null
    },
    {
      "id": 208666,
      "primary_message": "Place tofu in the oven and broil until the top starts to brown and caramelize, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 208667,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, Dijon, sugar, and spices in a medium bowl; whisk until smooth.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp brown sugar\n¾ tsp garlic powder\n¾ tsp onion powder\n½ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 208668,
      "primary_message": "Add blue cheese and stir to combine the dressing; set aside.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    },
    {
      "id": 208669,
      "primary_message": "Remove tofu from the oven, flip, and coat with remaining BBQ sauce. Return to the oven and broil until brown and caramelized on the other side, 8-10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 208670,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n3 Gala apples\n1 small pkg chives"
    },
    {
      "id": 208671,
      "primary_message": "Trim off and discard the root end of each cabbage. Cut cabbage heads into quarters lengthwise, to make six wedges.",
      "secondary_message": null
    },
    {
      "id": 208672,
      "primary_message": "Quarter, core, and small dice apples.",
      "secondary_message": null
    },
    {
      "id": 208673,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 208674,
      "primary_message": "To serve, divide tofu and cabbage wedges between plates; top wedges with dressing, apples, and chives. Enjoy!",
      "secondary_message": null
    }
  ],
