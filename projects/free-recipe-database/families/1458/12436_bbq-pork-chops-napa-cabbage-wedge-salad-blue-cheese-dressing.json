  "instructions": [
    {
      "id": 208714,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 208715,
      "primary_message": "Place ketchup, Worcestershire, sugar, vinegar, Dijon, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "3 tbsp ketchup\n2 tsp Worcestershire sauce\n1 tsp brown sugar\n1 tsp apple cider vinegar\n1 tsp Dijon mustard\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 208716,
      "primary_message": "Pat pork chops dry with paper towels and place on a broiler pan. Pour ⅔ of the BBQ sauce over the chops and turn to coat. Set remaining sauce aside.",
      "secondary_message": "2 pork chops, bone-in"
    },
    {
      "id": 208717,
      "primary_message": "Place pork chops in the oven and broil until the tops start to brown and caramelize, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 208718,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, Dijon, sugar, and spices in another small bowl; whisk until smooth.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp mayonnaise\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp brown sugar\n¼ tsp garlic powder\n¼ tsp onion powder\n⅛ tsp black pepper\n3 pinch salt"
    },
    {
      "id": 208719,
      "primary_message": "Add blue cheese and stir to combine the dressing; set aside.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 208720,
      "primary_message": "Remove pork chops from the oven, flip, and coat with remaining BBQ sauce. Return to the oven and broil until cooked through, 6-8 minutes more. Remove from oven, loosely cover with foil, and rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 208721,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n1 Gala apple\n½ small pkg chives"
    },
    {
      "id": 208722,
      "primary_message": "Trim off and discard the root end of the cabbage. Cut cabbage in half lengthwise, to make two wedges.",
      "secondary_message": null
    },
    {
      "id": 208723,
      "primary_message": "Quarter, core, and small dice apple.",
      "secondary_message": null
    },
    {
      "id": 208724,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 208725,
      "primary_message": "To serve, divide pork chops and cabbage wedges between plates; top wedges with dressing, apples, and chives. Enjoy!",
      "secondary_message": null
    }
  ],
