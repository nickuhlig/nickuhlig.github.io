  "instructions": [
    {
      "id": 251884,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 ½ heads romaine lettuce\n3 Granny Smith apples"
    },
    {
      "id": 251885,
      "primary_message": "Peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 251886,
      "primary_message": "Juice lemons into the bowl with the garlic; add soy sauce, vinegar, Worcestershire, Dijon, and pepper. Whisk to combine the marinade.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp white wine vinegar\n1 tbsp Worcestershire sauce\n1 ½ tsp Dijon mustard\n1 ½ tsp black pepper"
    },
    {
      "id": 251887,
      "primary_message": "Place the steak in the marinade, turn to coat, and set aside.",
      "secondary_message": "1.02 kg striploin (New York strip) steak"
    },
    {
      "id": 251888,
      "primary_message": "Peel and mince additional garlic; transfer to a large bowl along with yogurt, blue cheese, water, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n⅓ cup plain Greek yogurt\n1 ½ (113 g) pkg crumbled blue cheese\n2 tbsp water\n1 tbsp white wine vinegar\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 251889,
      "primary_message": "Chop or tear romaine into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 251890,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 251891,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 251892,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and let rest for 5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 251893,
      "primary_message": "Meanwhile, quarter, core, and cut apples into matchsticks, add to the bowl with the romaine, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 251894,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 251895,
      "primary_message": "To serve, divide salad and steak between plates. Enjoy!",
      "secondary_message": null
    }
  ],
