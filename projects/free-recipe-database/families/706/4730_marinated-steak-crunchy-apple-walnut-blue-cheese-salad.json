  "instructions": [
    {
      "id": 251824,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ head romaine lettuce\n1 Granny Smith apple"
    },
    {
      "id": 251825,
      "primary_message": "Peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 251826,
      "primary_message": "Juice lemon into the bowl with the garlic; add soy sauce, vinegar, Worcestershire, Dijon, and pepper. Whisk to combine the marinade.",
      "secondary_message": "1 tbsp soy sauce\n1 tbsp white wine vinegar\n1 tsp Worcestershire sauce\n½ tsp Dijon mustard\n½ tsp black pepper"
    },
    {
      "id": 251827,
      "primary_message": "Place the steak in the marinade, turn to coat, and set aside.",
      "secondary_message": "¾ lb striploin (New York strip) steak"
    },
    {
      "id": 251828,
      "primary_message": "Peel and mince additional garlic; transfer to another medium bowl along with yogurt, blue cheese, water, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n⅛ cup plain Greek yogurt\n½ (4 oz) pkg crumbled blue cheese\n2 tsp water\n1 tsp white wine vinegar\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 251829,
      "primary_message": "Chop or tear romaine into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 251830,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 251831,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 251832,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and let rest for 5 minutes.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 251833,
      "primary_message": "Meanwhile, quarter, core, and cut apple into matchsticks, add to the bowl with the romaine, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 251834,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 251835,
      "primary_message": "To serve, divide salad and steak between plates. Enjoy!",
      "secondary_message": null
    }
  ],
