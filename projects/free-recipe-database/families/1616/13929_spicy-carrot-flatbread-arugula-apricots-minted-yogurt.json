  "instructions": [
    {
      "id": 230986,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 230987,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "9 medium carrots\n1 small pkg fresh mint\n1 ½ limes\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 230988,
      "primary_message": "Peel, trim, and slice carrots into ¼-inch thick rounds. Place in a large bowl along with maple syrup, oil, and salt; toss to coat.",
      "secondary_message": "2 tbsp pure maple syrup\n1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 230989,
      "primary_message": "Transfer carrots to a large baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until fork-tender, 12-15 minutes. Remove from oven and set aside to cool. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 230990,
      "primary_message": "While the carrots are roasting, divide flatbreads between two additional baking sheets. Add to the oven and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from the oven and set aside to cool.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 230991,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with yogurt and salt; stir to combine and set aside.",
      "secondary_message": "2 cups plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 230992,
      "primary_message": "Peel and mince the garlic. Transfer to the reserved bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 230993,
      "primary_message": "Juice limes into the bowl with the garlic; add oil, maple syrup, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 230994,
      "primary_message": "Thinly slice apricots and add to the bowl with the dressing.",
      "secondary_message": "18 dried apricots"
    },
    {
      "id": 230995,
      "primary_message": "Once the carrots have cooled to room temperature, transfer to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 230996,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 230997,
      "primary_message": "Divide minted yogurt between flatbreads and spread out in an even layer. Top each flatbread with carrot-arugula salad and slice into wedges.",
      "secondary_message": null
    },
    {
      "id": 230998,
      "primary_message": "To serve, divide flatbreads between plates and drizzle with vinegar. Enjoy!",
      "secondary_message": "2 tbsp balsamic vinegar"
    }
  ],
