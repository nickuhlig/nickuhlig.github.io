  "instructions": [
    {
      "id": 354194,
      "primary_message": "Place milk, maple syrup, cocoa powder, peanut butter, and vanilla in a small saucepan. Place over medium heat and cook, stirring constantly, until combined and glossy, 1-2 minutes. Remove from heat.",
      "secondary_message": "59 ml (¼ cup) whole milk\n¼ cup pure maple syrup\n¼ cup cocoa powder\n2 tbsp natural peanut butter\n¼ tsp vanilla extract"
    },
    {
      "id": 354195,
      "primary_message": "Peel and thinly slice banana.",
      "secondary_message": "1 banana"
    },
    {
      "id": 354196,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 354197,
      "primary_message": "To serve, place one scoop of ice cream in the bottom of each bowl. Top with half of the chocolate sauce and the banana. Place a second scoop of ice cream on top of the banana, drizzle with remaining chocolate sauce, and sprinkle with peanuts. Enjoy!",
      "secondary_message": "355 ml vanilla ice cream"
    }
  ],
