  "instructions": [
    {
      "id": 354190,
      "primary_message": "Place milk, maple syrup, cocoa powder, peanut butter, and vanilla in a small saucepan. Place over medium heat and cook, stirring constantly, until combined and glossy, about 2 minutes. Remove from heat.",
      "secondary_message": "6 fl oz (¾ cup) almond milk, unsweetened\n¾ cup pure maple syrup\n¾ cup cocoa powder\n⅓ cup natural peanut butter\n¾ tsp vanilla extract"
    },
    {
      "id": 354191,
      "primary_message": "Peel and thinly slice bananas.",
      "secondary_message": "3 bananas"
    },
    {
      "id": 354192,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 354193,
      "primary_message": "To serve, place one scoop of ice cream in the bottom of each bowl. Top with half of the chocolate sauce and the banana. Place a second scoop of ice cream on top of the banana, drizzle with remaining chocolate sauce, and sprinkle with peanuts. Enjoy!",
      "secondary_message": "36 fl oz (4 ½ cups) vanilla ice cream, vegan"
    }
  ],
