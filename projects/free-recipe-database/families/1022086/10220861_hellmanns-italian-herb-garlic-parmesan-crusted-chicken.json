  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Combine Best Foods® or Hellmann's® Italian Herb and Garlic Mayonnaise Dressing and Parmesan cheese in small bowl. Arrange chicken on baking sheet. Evenly spread surface of chicken with mayonnaise mixture, then sprinkle with bread crumbs. ",
      "secondary_message": null
    },
    {
      "primary_message": "Bake until chicken is thoroughly cooked, about 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "AIR FRYER TIP: Preheat air fryer to 350°F. Arrange prepared chicken in single layer, working in batches if necessary. Air fry 10 minutes or until chicken is thoroughly cooked and topping is golden brown.",
      "secondary_message": null
    },
    {
      "primary_message": "CHEF'S TIP: Combine 2 medium chopped tomatoes, 1/4 cup chopped red onion, 1 tablespoon balsamic vinegar and a small handful of torn fresh basil for a quick bruschetta topping for cooked chicken.",
      "secondary_message": null
    }
