  "instructions": [
    {
      "id": 155434,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 155435,
      "primary_message": "Wash and small dice bell peppers. Peel and mince garlic. Peel and small dice onions.",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions\n3 red bell peppers"
    },
    {
      "id": 155436,
      "primary_message": "Wash and quarter the jalapeños lengthwise; seed and remove ribs with a spoon. Finely mince. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": "3 jalapeño peppers"
    },
    {
      "id": 155437,
      "primary_message": "Preheat an extra-large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 155438,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 155439,
      "primary_message": "Add bell peppers, garlic, onions, and jalapeños to the skillet; cook, stirring frequently, until softened, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 155440,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans kidney beans"
    },
    {
      "id": 155441,
      "primary_message": "Add beans, tomatoes, water, tomato paste, and spices to the skillet. Reduce heat to low and cook, stirring occasionally, while you prepare the cornbread batter.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n1 cup water\n3 tbsp tomato paste\n1 tbsp chili powder\n1 tbsp oregano\n1 ½ tsp cumin\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 155442,
      "primary_message": "Melt butter in a microwave or saucepan. Once melted, add to a medium bowl.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 155443,
      "primary_message": "Add milk and eggs to the bowl with the butter and whisk to combine. In a separate medium bowl, stir together cornmeal, flour, sugar, baking powder, and salt. Gradually add wet ingredients to the bowl with the dry ingredients and stir to combine.",
      "secondary_message": "177 ml whole milk\n3 eggs\n¾ cup polenta (cornmeal)\n¾ cup all-purpose flour\n⅓ cup brown sugar\n¾ tsp baking powder\n¾ tsp salt"
    },
    {
      "id": 155444,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 155445,
      "primary_message": "Sprinkle cheese over the bean mixture. Pour cornbread batter on top and smooth into a thin layer with a spatula.",
      "secondary_message": null
    },
    {
      "id": 155446,
      "primary_message": "Place skillet in the oven and bake until cornbread is golden and cooked through, about 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 155447,
      "primary_message": "To serve, divide chili and cornbread between bowls and enjoy!",
      "secondary_message": null
    }
  ],
