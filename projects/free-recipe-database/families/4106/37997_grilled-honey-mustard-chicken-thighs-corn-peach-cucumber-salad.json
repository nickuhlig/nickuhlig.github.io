  "instructions": [
    {
      "id": 593994,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n4 ears corn\n4 peaches\n1 English cucumber\n1 head butter (Boston) lettuce\n1 small pkg fresh mint"
    },
    {
      "id": 593995,
      "primary_message": "Zest and juice lemons, then divide between two medium bowls. Set one bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "id": 593996,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the lemon, along with honey, Dijon, and spices, then whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n3 tbsp honey\n2 tbsp Dijon mustard\n1 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 593997,
      "primary_message": "Pat the chicken thighs dry with paper towels, add to the bowl with the marinade, and turn to coat. Set aside.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 593998,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 593999,
      "primary_message": "Meanwhile, remove and discard outer husks and silk from corn.",
      "secondary_message": null
    },
    {
      "id": 594000,
      "primary_message": "Once the water is boiling, uncover the pot and reduce heat to medium; use tongs to lower the corn into the water and cook until just tender, 6-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 594001,
      "primary_message": "While the corn is cooking, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 594002,
      "primary_message": "Once the pan is hot, coat with oil. Add chicken (leaving any excess marinade in the bowl) and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 594003,
      "primary_message": "Meanwhile, add oil, honey, salt, and pepper to the remaining bowl with the lemon, then whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 594004,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 594005,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 594006,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 594007,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop leaves. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 594008,
      "primary_message": "To serve, divide salad, chicken, and corn between plates. Drizzle corn with oil, then season with salt and pepper. Enjoy!",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    }
  ],
