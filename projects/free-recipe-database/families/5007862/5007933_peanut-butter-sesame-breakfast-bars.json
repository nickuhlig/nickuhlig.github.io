  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 175°C (350°F). Place sesame seeds in a small saucepan over medium heat. Saute until toasted and golden, about 2 minutes. Let cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, stir together honey, egg, vanilla extract, and peanut butter until evenly combined. Stir in sesame seeds and rice cereal.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spread mixture in baking dish. Bake until golden, about 25 minutes. Let bars cool completely before cutting.",
      "secondary_message": null
    }
