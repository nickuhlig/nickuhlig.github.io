  "instructions": [
    {
      "primary_message": "Preheat oven to 400F. Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and medium dice onion. Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and seasoning; cook, stirring occasionally, until golden, 2-3 minutes.",
      "secondary_message": "1 medium yellow onion\n2 tsp neutral vegetable oil\n1 tbsp garlic & herb seasoning"
    },
    {
      "primary_message": "Meanwhile, wash and dry the spinach (skip this step if it came pre-washed). Medium dice ham. When the onion is golden, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Add ham, soup, and peas to the skillet, then stir to combine. Bring to a simmer, stirring occasionally, and remove from heat.",
      "secondary_message": "1 (142 g) pkg baby spinach\n454 g ham steak, boneless\n2 (298 g) can cheddar cheese soup\n2 cups frozen peas"
    },
    {
      "primary_message": "Open biscuit tube, separate biscuits, and arrange in an even layer over the skillet. Place skillet in the oven and bake until biscuits are cooked through and golden, about 15 minutes. Remove from oven.",
      "secondary_message": "1 (453 g) tube biscuit dough"
    },
    {
      "primary_message": "To serve, divide skillet bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
