  "instructions": [
    {
      "id": 187486,
      "primary_message": "In a medium saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n2 cup water"
    },
    {
      "id": 187487,
      "primary_message": "Meanwhile, cut the sausages at an angle into 1-inch pieces.",
      "secondary_message": "9 pork sausages"
    },
    {
      "id": 187488,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 187489,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 187490,
      "primary_message": "Add the sausage to the pot and cook, stirring occasionally, until browned on all sides and almost cooked through, 11-13 minutes.",
      "secondary_message": null
    },
    {
      "id": 187491,
      "primary_message": "Meanwhile, wash and snap or cut off the woody ends of the asparagus; then cut into 2-inch pieces.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 187492,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 187493,
      "primary_message": "In a large bowl, prepare dressing by whisking together vinegar, oil, Dijon, salt, and pepper.",
      "secondary_message": "3 tbsp white wine vinegar\n2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 187494,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "⅜ cup walnuts"
    },
    {
      "id": 187495,
      "primary_message": "When the sausage is almost cooked through, add asparagus, garlic, and walnuts; continue to cook, stirring occasionally, until asparagus is crisp-tender, about 5 minutes. When done, remove from the heat, cover, and set aside.",
      "secondary_message": null
    },
    {
      "id": 187496,
      "primary_message": "Uncover the quinoa and fluff with a fork. Add quinoa and asparagus-sausage mixture to the bowl with the sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 187497,
      "primary_message": "To serve, divide the pilaf between plates and garnish with cranberries. Enjoy!",
      "secondary_message": "⅜ cup dried cranberries"
    }
  ],
