  "instructions": [
    {
      "id": 187539,
      "primary_message": "In a medium saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "⅔ cup quinoa\n1 ⅓ cup water"
    },
    {
      "id": 187540,
      "primary_message": "Meanwhile, wash and snap or cut off the woody ends of the asparagus; then cut into 2-inch pieces and place in a medium bowl.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 187541,
      "primary_message": "Roughly chop walnuts and add to the bowl with the asparagus.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 187542,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 187543,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 187544,
      "primary_message": "While the skillet is heats up, cut the sausages into 1-inch pieces, at an angle.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 187545,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 4 minutes (or cook sausages according to package instructions).",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 187546,
      "primary_message": "Add asparagus, walnuts, and garlic to the skillet. Cook, stirring occasionally, until asparagus is crisp-tender, about 3 minutes. When done, remove from the heat, cover, and set aside.",
      "secondary_message": null
    },
    {
      "id": 187547,
      "primary_message": "In a large bowl, prepare dressing by whisking together vinegar, oil, Dijon, salt, and pepper.",
      "secondary_message": "2 tbsp white wine vinegar\n4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 187548,
      "primary_message": "Uncover the quinoa and fluff with a fork. Add quinoa and asparagus-sausage mixture to the bowl with the dressing and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 187549,
      "primary_message": "To serve, divide the pilaf between plates and garnish with cranberries. Enjoy!",
      "secondary_message": "½ cup dried cranberries"
    }
  ],
