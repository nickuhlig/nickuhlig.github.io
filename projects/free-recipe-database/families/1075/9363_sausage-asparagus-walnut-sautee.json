  "instructions": [
    {
      "id": 187508,
      "primary_message": "Cut the sausages at an angle into 1-inch pieces.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 187509,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 187510,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 187511,
      "primary_message": "Add the sausage to the skillet and cook, stirring occasionally, until they are browned on all sides and almost cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 187512,
      "primary_message": "Meanwhile, wash and snap or cut off the woody ends of the asparagus; then cut into 2-inch pieces.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 187513,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 187514,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 187515,
      "primary_message": "When the sausage is almost cooked through, add asparagus and garlic; continue to cook, stirring occasionally, until asparagus is crisp-tender, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 187516,
      "primary_message": "Add vinegar, oil, Dijon, walnuts, salt, and pepper to the skillet; toss to combine and continue to cook until heated through, about 2 minutes.",
      "secondary_message": "2 tbsp white wine vinegar\n4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 187517,
      "primary_message": "To serve, divide the sausage and asparagus between plates and enjoy!",
      "secondary_message": null
    }
  ],
