  "instructions": [
    {
      "id": 332465,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ yellow bell pepper\n½ small bunch cilantro"
    },
    {
      "id": 332466,
      "primary_message": "Seed and small dice the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 332467,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332468,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 332469,
      "primary_message": "Once the pot is hot, add the oil, bell pepper, onion, garlic, and ground turkey. Break apart the turkey with a spoon until crumbly. Stirring occasionally, cook until turkey is cooked through and vegetables are tender, 5-7 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n0.23 kg ground turkey"
    },
    {
      "id": 332470,
      "primary_message": "Add the pasta, tomatoes, water, and spices to the pot. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally until pasta is cooked and most of the water is absorbed, 15 minutes.",
      "secondary_message": "170 g rotini pasta\n½ (398 ml) can diced tomatoes\n2 ¼ cup water\n1 tbsp chili powder\n½ tsp cumin, ground\n½ tsp garlic powder\n½ tsp onion powder\n¾ tsp salt"
    },
    {
      "id": 332471,
      "primary_message": "Meanwhile, coarsely grate the cheddar.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 332472,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 332473,
      "primary_message": "Once the pasta is done, remove from heat. If more than ¼ cup of liquid is remaining in the pot, carefully strain off excess liquid using a colander.  ",
      "secondary_message": null
    },
    {
      "id": 332474,
      "primary_message": "Add cheese, yogurt, and half of the cilantro to the pot with the pasta and stir until cheese is melted and creamy.",
      "secondary_message": "⅛ cup plain Greek yogurt"
    },
    {
      "id": 332475,
      "primary_message": "To serve, divide pasta between bowls. Garnish with remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
