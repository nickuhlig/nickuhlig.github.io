  "instructions": [
    {
      "id": 332421,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ yellow bell peppers\n1 ½ small bunches cilantro"
    },
    {
      "id": 332422,
      "primary_message": "Seed and small dice the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 332423,
      "primary_message": "Peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 332424,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332425,
      "primary_message": "Once the pot is hot, add the oil, bell pepper, onion, garlic, and ground turkey. Break apart the turkey with a spoon until crumbly. Stirring occasionally, cook until turkey is cooked through and vegetables are tender, 7-9 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ lb ground turkey"
    },
    {
      "id": 332426,
      "primary_message": "Add the pasta, tomatoes, water, and spices to the pot. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally until pasta is cooked and most of the water is absorbed, 15 minutes.",
      "secondary_message": "18 oz rotini pasta\n1 ½ (14.5 oz) cans diced tomatoes\n6 ¾ cup water\n3 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n11 ¼ ml salt"
    },
    {
      "id": 332427,
      "primary_message": "Meanwhile, coarsely grate the cheddar.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 332428,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 332429,
      "primary_message": "Once the pasta is done, remove from heat. If more than ¾ cup of liquid is remaining in the pot, carefully strain off excess liquid using a colander.  ",
      "secondary_message": null
    },
    {
      "id": 332430,
      "primary_message": "Add cheese, yogurt, and half of the cilantro to the pot with the pasta and stir until cheese is melted and creamy.",
      "secondary_message": "⅜ cup plain Greek yogurt"
    },
    {
      "id": 332431,
      "primary_message": "To serve, divide pasta between bowls. Garnish with remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
