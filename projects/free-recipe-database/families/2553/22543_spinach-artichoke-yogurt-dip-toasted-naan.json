  "instructions": [
    {
      "id": 375102,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the naan.)",
      "secondary_message": null
    },
    {
      "id": 375103,
      "primary_message": "Wash and dry the spinach (skip if it came pre-washed). Roughly chop and place in a small bowl; set aside.",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 375104,
      "primary_message": "Peel and mince garlic and shallot.",
      "secondary_message": "1 clove garlic\n1 shallot"
    },
    {
      "id": 375105,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 375106,
      "primary_message": "While the skillet heats up, drain and mince artichokes.",
      "secondary_message": "½ (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 375107,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, shallot, and salt; cook, stirring often, until softened, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 375108,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to cook, while stirring, until spinach is completely wilted, 1-2 minutes more. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 375109,
      "primary_message": "When the spinach is done, remove from heat. Stir in the artichokes and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 375110,
      "primary_message": "Meanwhile, place yogurt, salt, and crushed red pepper in the reserved bowl. Whisk until smooth.",
      "secondary_message": "⅔ cup plain Greek yogurt\n⅛ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 375111,
      "primary_message": "Add the cooled spinach-artichoke mixture to the bowl with the yogurt. Stir to combine the dip and set aside.",
      "secondary_message": null
    },
    {
      "id": 375112,
      "primary_message": "Arrange naan on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.) Cut into wedges.",
      "secondary_message": "1 flatbread or naan"
    },
    {
      "id": 375113,
      "primary_message": "To serve, divide toasted naan and dip between plates. Enjoy!",
      "secondary_message": null
    }
  ],
