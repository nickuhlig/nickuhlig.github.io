  "instructions": [
    {
      "id": 375090,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the naan.)",
      "secondary_message": null
    },
    {
      "id": 375091,
      "primary_message": "Wash and dry the spinach (skip if it came pre-washed). Roughly chop and place in a medium bowl; set aside.",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 375092,
      "primary_message": "Peel and mince garlic. Peel, halve, and mince onion.",
      "secondary_message": "3 cloves garlic\n½ medium red onion"
    },
    {
      "id": 375093,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 375094,
      "primary_message": "While the skillet heats up, drain and mince artichokes.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 375095,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, onion, and salt; cook, stirring often, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 375096,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to cook, while stirring, until spinach is completely wilted, 2-3 minutes more. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 375097,
      "primary_message": "When the spinach is done, remove from heat. Stir in the artichokes and set aside to cool slightly, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 375098,
      "primary_message": "Meanwhile, place yogurt, salt, and crushed red pepper in the reserved bowl. Whisk until smooth.",
      "secondary_message": "2 cups plain Greek yogurt\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 375099,
      "primary_message": "Add the cooled spinach-artichoke mixture to the bowl with the yogurt. Stir to combine the dip and set aside.",
      "secondary_message": null
    },
    {
      "id": 375100,
      "primary_message": "Arrange naan on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.) Cut into wedges.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 375101,
      "primary_message": "To serve, divide toasted naan and dip between plates. Enjoy!",
      "secondary_message": null
    }
  ],
