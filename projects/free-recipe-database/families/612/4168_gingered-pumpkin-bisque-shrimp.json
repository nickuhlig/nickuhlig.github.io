  "instructions": [
    {
      "id": 46969,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 46970,
      "primary_message": "Peel the carrot, then trim off the ends; discard the peels and trimmings. Medium dice the carrot (cut into 1 ¼-cm cubes). Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 46971,
      "primary_message": "Trim off and discard the ends of the celery; medium dice the celery (cut into 1 ¼-cm cubes). Add to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 46972,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 46973,
      "primary_message": "While the saucepan heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces). Add to the bowl with the carrots and celery.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 46974,
      "primary_message": "Once the saucepan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 46975,
      "primary_message": "Add the onion, celery, and carrots to the saucepan; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 46976,
      "primary_message": "Peel and grate or mince the ginger.",
      "secondary_message": null
    },
    {
      "id": 46977,
      "primary_message": "Add the ginger, cinnamon, and cayenne pepper to the saucepan; stir and cook until fragrant, 15 to 30 seconds.",
      "secondary_message": "¼ tsp cinnamon\n1 pinch cayenne pepper"
    },
    {
      "id": 46978,
      "primary_message": "Add the pumpkin purée and broth to the saucepan; stir to combine and bring to a boil. Once boiling, reduce the heat to a simmer and cook for 10 minutes.",
      "secondary_message": "½ (398 ml) can pure pumpkin purée\n473 ml (2 cups) chicken or vegetable broth"
    },
    {
      "id": 46979,
      "primary_message": "While the soup cooks, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 46980,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water until there are no more ice chunks. Then, lay them out on a clean towel or paper towels and pat dry. If using fresh shrimp, skip the first step.",
      "secondary_message": "0.34 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 46981,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 46982,
      "primary_message": "Add the shrimp to the skillet; cook until they are opaque, 1 to 2 minutes per side. Once done, transfer to a bowl and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 46983,
      "primary_message": "Stir the heavy cream into the soup and season with salt and pepper.",
      "secondary_message": "59 ml (¼ cup) heavy cream\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 46984,
      "primary_message": "Using an immersion (hand) blender, purée the soup until smooth.",
      "secondary_message": null
    },
    {
      "id": 46985,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 46986,
      "primary_message": "To serve, divide the soup between bowls and top with the shrimp. Serve with buns on the side. Enjoy!",
      "secondary_message": null
    }
  ],
