  "instructions": [
    {
      "id": 249616,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n2 tomatoes\n1 English cucumber\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 249617,
      "primary_message": "Zest lemon into a medium bowl. (Set lemon aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 249618,
      "primary_message": "Drain salmon and place in the bowl with the lemon zest; flake with a fork.",
      "secondary_message": "2 (213 g) cans wild pink salmon, traditional style"
    },
    {
      "id": 249619,
      "primary_message": "Small dice tomatoes and add to the bowl along with spices.",
      "secondary_message": "1 tsp basil, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 249620,
      "primary_message": "Crumble goat cheese into the bowl, stir to combine the salmon salad, and set aside.",
      "secondary_message": "2 (113 g) logs goat cheese"
    },
    {
      "id": 249621,
      "primary_message": "Juice lemon into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 249622,
      "primary_message": "Roughly chop olives, sun-dried tomatoes, and capers; add to the bowl with the lemon juice.",
      "secondary_message": "½ cup Kalamata olives, pitted\n6 sun-dried tomatoes, oil-packed\n2 tbsp capers"
    },
    {
      "id": 249623,
      "primary_message": "Peel and mince garlic; add to the bowl along with the oil. Stir to combine the tapenade dressing.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil"
    },
    {
      "id": 249624,
      "primary_message": "Trim and halve the cucumber lengthwise; slice crosswise into thin half-moons. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 249625,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 249626,
      "primary_message": "Place bread slices on a flat surface. Divide salmon salad between half of the slices; cover with remaining slices.",
      "secondary_message": null
    },
    {
      "id": 249627,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 249628,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
