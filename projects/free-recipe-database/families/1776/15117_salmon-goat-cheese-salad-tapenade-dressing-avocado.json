  "instructions": [
    {
      "id": 249642,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n1 tomato\n½ English cucumber\n1 avocado\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 249643,
      "primary_message": "Zest lemon into a medium bowl. (Set lemon aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 249644,
      "primary_message": "Drain the salmon and place in the bowl with the lemon zest; flake with a fork.",
      "secondary_message": "1 (213 g) can wild pink salmon, traditional style"
    },
    {
      "id": 249645,
      "primary_message": "Small dice tomato and add to the bowl along with spices.",
      "secondary_message": "½ tsp basil, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 249646,
      "primary_message": "Crumble goat cheese into the bowl, stir to combine the salmon salad, and set aside.",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "id": 249647,
      "primary_message": "Juice lemon into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 249648,
      "primary_message": "Roughly chop olives, sun-dried tomatoes, and capers; add to the bowl with the lemon juice.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n4 sun-dried tomatoes, oil-packed\n1 tbsp capers"
    },
    {
      "id": 249649,
      "primary_message": "Peel and mince garlic; add to the bowl along with the oil and stir to combine the tapenade dressing.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 249650,
      "primary_message": "Trim and halve the cucumber lengthwise; slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 249651,
      "primary_message": "Halve and pit the avocado. Slice crosswise while still in the skin and scoop out with a spoon; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 249652,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 249653,
      "primary_message": "To serve, divide dressed greens between plates, top with salmon salad, and enjoy!",
      "secondary_message": null
    }
  ],
