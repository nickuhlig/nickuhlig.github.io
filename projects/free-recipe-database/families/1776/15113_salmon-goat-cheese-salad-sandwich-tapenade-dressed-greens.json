  "instructions": [
    {
      "id": 249590,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 tomatoes\n1 ½ English cucumbers\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 249591,
      "primary_message": "Zest lemons into a medium bowl. (Set lemons aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 249592,
      "primary_message": "Drain salmon and place in the bowl with the lemon zest; flake with a fork.",
      "secondary_message": "3 (213 g) cans wild pink salmon, traditional style"
    },
    {
      "id": 249593,
      "primary_message": "Small dice tomatoes and add to the bowl along with spices.",
      "secondary_message": "1 ½ tsp basil, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 249594,
      "primary_message": "Crumble goat cheese into the bowl, stir to combine the salmon salad, and set aside.",
      "secondary_message": "3 (113 g) logs goat cheese"
    },
    {
      "id": 249595,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 249596,
      "primary_message": "Roughly chop olives, sun-dried tomatoes, and capers; add to the bowl with the lemon juice.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n9 sun-dried tomatoes, oil-packed\n3 tbsp capers"
    },
    {
      "id": 249597,
      "primary_message": "Peel and mince garlic; add to the bowl along with the oil. Stir to combine the tapenade dressing.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 249598,
      "primary_message": "Trim and halve the cucumbers lengthwise; slice crosswise into thin half-moons. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 249599,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 249600,
      "primary_message": "Place bread slices on a flat surface. Divide salmon salad between half of the slices; cover with remaining slices.",
      "secondary_message": null
    },
    {
      "id": 249601,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 249602,
      "primary_message": "To serve, divide sandwiches and salad between plates. Sprinkle salad with pine nuts and enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
