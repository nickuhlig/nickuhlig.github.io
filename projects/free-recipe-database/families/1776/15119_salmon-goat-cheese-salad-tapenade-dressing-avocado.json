  "instructions": [
    {
      "id": 249666,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 lemons\n3 tomatoes\n1 ½ English cucumbers\n3 avocados\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 249667,
      "primary_message": "Zest lemons into a medium bowl. (Set lemons aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 249668,
      "primary_message": "Drain the salmon and place in the bowl with the lemon zest; flake with a fork.",
      "secondary_message": "3 (213 g) cans wild pink salmon, traditional style"
    },
    {
      "id": 249669,
      "primary_message": "Small dice tomatoes and add to the bowl along with spices.",
      "secondary_message": "1 ½ tsp basil, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 249670,
      "primary_message": "Crumble goat cheese into the bowl, stir to combine the salmon salad, and set aside.",
      "secondary_message": "3 (113 g) logs goat cheese"
    },
    {
      "id": 249671,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 249672,
      "primary_message": "Roughly chop olives, sun-dried tomatoes, and capers; add to the bowl with the lemon juice.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n12 sun-dried tomatoes, oil-packed\n3 tbsp capers"
    },
    {
      "id": 249673,
      "primary_message": "Peel and mince garlic; add to the bowl along with the oil and stir to combine the tapenade dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 249674,
      "primary_message": "Trim and halve the cucumbers lengthwise; slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 249675,
      "primary_message": "Halve and pit the avocados. Slice crosswise while still in the skin and scoop out with a spoon; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 249676,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 249677,
      "primary_message": "To serve, divide dressed greens between plates, top with salmon salad, and enjoy!",
      "secondary_message": null
    }
  ],
