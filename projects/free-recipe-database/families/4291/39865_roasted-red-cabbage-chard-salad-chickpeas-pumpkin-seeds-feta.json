  "instructions": [
    {
      "id": 618293,
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 618294,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small head red cabbage\n1 bunch Swiss chard\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 618295,
      "primary_message": "Halve cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips; transfer to a large baking sheet pan. Drizzle with oil, then season with salt and pepper; toss to coat and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 618296,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cabbage is just tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 618297,
      "primary_message": "Meanwhile, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 618298,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 618299,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until golden and soft, 6-8 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 618300,
      "primary_message": "Meanwhile, fold chard leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces; place both in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 618301,
      "primary_message": "Drain and rinse chickpeas. Set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 618302,
      "primary_message": "When the onion is golden, add vinegar, honey, garlic powder, and pepper to the skillet. Continue to cook, stirring frequently, for 30 seconds. Remove from heat and set onion dressing aside.",
      "secondary_message": "¼ cup red wine vinegar\n4 tsp honey\n½ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 618303,
      "primary_message": "When the cabbage is just tender, remove from the oven. Add chard to the baking sheet, stir to combine, then spread back out in an even layer. Return to the oven and continue to roast until cabbage and chard are very tender, 6-8 minutes more. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 618304,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and roughly chop the leaves. Place in the reserved bowl along with chickpeas, onion dressing, cranberries, and pumpkin seeds.",
      "secondary_message": "½ cup dried cranberries\n½ cup pumpkin seeds"
    },
    {
      "id": 618305,
      "primary_message": "When the cabbage and chard are done, remove from oven. Add to the bowl with the chickpeas and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 618306,
      "primary_message": "To serve, divide salad between plates or bowls. Top with feta and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
