  "instructions": [
    {
      "id": 618349,
      "primary_message": "Preheat the oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 618350,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small heads red cabbage\n1 ½ bunches Swiss chard\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 618351,
      "primary_message": "Halve each cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips; divide between two large baking sheet pans. Drizzle with oil, then season with salt and pepper; toss to coat and spread out in an even layer. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 618352,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cabbage is just tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 618353,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 618354,
      "primary_message": "While the skillet heats up, peel, halve, and slice onions crosswise into thin half-moons.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 618355,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until golden and soft, 6-8 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 618356,
      "primary_message": "Meanwhile, fold chard leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces; place both in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 618357,
      "primary_message": "Drain and rinse chickpeas. Set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 618358,
      "primary_message": "When the onion is golden, add vinegar, honey, garlic powder, and pepper to the skillet. Continue to cook, stirring frequently, for 30 seconds. Remove from heat and set onion dressing aside.",
      "secondary_message": "⅓ cup red wine vinegar\n2 tbsp honey\n¾ tsp garlic powder\n¾ tsp black pepper"
    },
    {
      "id": 618359,
      "primary_message": "When the cabbage is just tender, remove from the oven. Add chard to the baking sheets, stir to combine, then spread back out in an even layer. Return to the oven and continue to roast until cabbage and chard are very tender, 8-10 minutes more. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 618360,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and roughly chop the leaves. Place in the reserved bowl along with chickpeas, onion dressing, cranberries, and pumpkin seeds.",
      "secondary_message": "¾ cup dried cranberries\n¾ cup pumpkin seeds"
    },
    {
      "id": 618361,
      "primary_message": "When the cabbage and chard are done, remove from oven. Add to the bowl with the chickpeas and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 618362,
      "primary_message": "To serve, divide salad between plates or bowls. Top with feta and enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    }
  ],
