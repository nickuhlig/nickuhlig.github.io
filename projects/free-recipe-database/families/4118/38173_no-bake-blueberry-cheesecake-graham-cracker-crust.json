  "instructions": [
    {
      "id": 596300,
      "primary_message": "Medium dice cream cheese. Place in a medium bowl and set aside to soften.",
      "secondary_message": "½ (8 oz) block cream cheese"
    },
    {
      "id": 596301,
      "primary_message": "Place butter in a small saucepan and melt over medium heat. Remove from heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 596302,
      "primary_message": "Meanwhile, place graham crackers in a resealable plastic bag. Using a rolling pin, crush the graham crackers into fine crumbs.",
      "secondary_message": "4 graham crackers"
    },
    {
      "id": 596303,
      "primary_message": "When the butter is melted, add graham cracker crumbs to the pan and stir to combine. Divide crumb mixture between 2 ramekins, then use the back of a spoon to press the crumbs into an even layer across the bottom. (Wipe pan clean with paper towels and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 596304,
      "primary_message": "Place ramekins in the freezer until the crusts are set, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 596305,
      "primary_message": "Meanwhile, wash, dry, and juice lemon into the reserved pan.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 596306,
      "primary_message": "Wash and dry blueberries. Add to the pan with the lemon juice, along with sugar and salt, then stir to combine. Set pan over medium heat and cook, stirring frequently, until blueberries are very soft and release their juices, 4-5 minutes.",
      "secondary_message": "½ (6 oz) pkg blueberries\n2 tsp granulated sugar\n⅛ tsp salt"
    },
    {
      "id": 596307,
      "primary_message": "While the blueberries are cooking, place cornstarch and cold water in a small bowl, then whisk to combine the slurry.",
      "secondary_message": "2 tsp cornstarch\n2 fl oz (¼ cup) water"
    },
    {
      "id": 596308,
      "primary_message": "When the blueberries are very soft, add slurry to the pan and stir to combine. Continue to cook, stirring occasionally, until the compote has thickened, 1 minute more. Remove from heat and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 596309,
      "primary_message": "Meanwhile, add sugar and vanilla to the bowl with the cream cheese. Using a whisk, beat cream cheese until soft and creamy, about 3 minutes. (Alternatively, you can use a hand mixer.)",
      "secondary_message": "2 tsp granulated sugar\n½ tsp vanilla extract"
    },
    {
      "id": 596310,
      "primary_message": "While whisking, gradually add cold cream to the bowl. Continue to beat vigorously, until medium-soft peaks form, 1-2 minutes more. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 596311,
      "primary_message": "Remove crusts from the freezer, divide whipped cream cheese between the ramekins, then top with blueberry compote. Return ramekins to the freezer and chill until cheesecakes are set, 10 minutes more.",
      "secondary_message": null
    },
    {
      "id": 596312,
      "primary_message": "To serve, remove cheesecakes from the freezer and enjoy!",
      "secondary_message": null
    }
  ],
