  "instructions": [
    {
      "id": 596365,
      "primary_message": "Medium dice cream cheese. Place in a large bowl and set aside to soften.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 596366,
      "primary_message": "Place butter in a medium saucepan and melt over medium heat. Remove from heat.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 596367,
      "primary_message": "Meanwhile, place graham crackers in a resealable plastic bag. Using a rolling pin, crush the graham crackers into fine crumbs.",
      "secondary_message": "12 graham crackers"
    },
    {
      "id": 596368,
      "primary_message": "When the butter is melted, add graham cracker crumbs to the pan and stir to combine. Divide crumb mixture between 6 ramekins, then use the back of a spoon to press the crumbs into an even layer across the bottom. (Wipe pan clean with paper towels and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 596369,
      "primary_message": "Place ramekins in the freezer until the crusts are set, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 596370,
      "primary_message": "Meanwhile, wash, dry, and juice lemons into the reserved pan.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 596371,
      "primary_message": "Wash and dry blueberries. Add to the pan with the lemon juice, along with sugar and salt, then stir to combine. Set pan over medium heat and cook, stirring frequently, until blueberries are very soft and release their juices, 5-6 minutes.",
      "secondary_message": "1 ½ (170 g) pkgs blueberries\n2 tbsp granulated sugar\n¼ tsp salt"
    },
    {
      "id": 596372,
      "primary_message": "While the blueberries are cooking, place cornstarch and cold water in a small bowl, then whisk to combine the slurry.",
      "secondary_message": "2 tbsp cornstarch\n177 ml water"
    },
    {
      "id": 596373,
      "primary_message": "When the blueberries are very soft, add slurry to the pan and stir to combine. Continue to cook, stirring occasionally, until the compote has thickened, 1 minute more. Remove from heat and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 596374,
      "primary_message": "Meanwhile, add sugar and vanilla to the bowl with the cream cheese. Using a whisk, beat cream cheese until soft and creamy, about 5 minutes. (Alternatively, you can use a hand mixer.)",
      "secondary_message": "2 tbsp granulated sugar\n1 ½ tsp vanilla extract"
    },
    {
      "id": 596375,
      "primary_message": "While whisking, gradually add cold cream to the bowl. Continue to beat vigorously, until medium-soft peaks form, about 4 minutes if whisking. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "355 ml heavy whipping cream"
    },
    {
      "id": 596376,
      "primary_message": "Remove crusts from the freezer, divide whipped cream cheese between the ramekins, then top with blueberry compote. Return ramekins to the freezer and chill until cheesecakes are set, 10 minutes more.",
      "secondary_message": null
    },
    {
      "id": 596377,
      "primary_message": "To serve, remove cheesecakes from the freezer and enjoy!",
      "secondary_message": null
    }
  ],
