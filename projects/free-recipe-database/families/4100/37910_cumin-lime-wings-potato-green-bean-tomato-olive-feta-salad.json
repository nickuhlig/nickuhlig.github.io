  "instructions": [
    {
      "id": 592303,
      "primary_message": "Preheat oven to 260°C (500°F). Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 592304,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n0.45 kg new potatoes\n1 small pkg grape tomatoes\n1 jalapeño pepper\n1 small bunch cilantro\n0.45 kg green beans"
    },
    {
      "id": 592305,
      "primary_message": "Zest and juice lime into a medium bowl. Add oil and spices, then whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n½ tsp coriander, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 592306,
      "primary_message": "Pat chicken wings dry with paper towels and add to the bowl with the marinade. Toss to coat, transfer to the baking sheet, and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed"
    },
    {
      "id": 592307,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 592308,
      "primary_message": "Meanwhile, halve new potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until almost fork-tender, about 10 minutes.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 592309,
      "primary_message": "While the potatoes are cooking, place oil, vinegar, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp white wine vinegar\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 592310,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 592311,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 592312,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 592313,
      "primary_message": "Trim and cut green beans crosswise into 1-inch pieces. When the potatoes are just tender, add beans to the pot. Continue to cook until potatoes and beans are fork-tender, 2-3 minutes more. Drain and rinse under cold water to cool.",
      "secondary_message": null
    },
    {
      "id": 592314,
      "primary_message": "Roughly chop olives. Add to the bowl with the dressing, along with cooled potatoes, green beans, and feta, then stir to combine the salad.",
      "secondary_message": "½ cup Kalamata olives, pitted\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 592315,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
