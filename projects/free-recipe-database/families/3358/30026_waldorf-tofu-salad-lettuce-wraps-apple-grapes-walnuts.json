  "instructions": [
    {
      "id": 477738,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 477739,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 sticks celery\n0.45 kg red grapes\n2 Gala apples\n1 head butter (Boston) lettuce"
    },
    {
      "id": 477740,
      "primary_message": "Zest and juice lemon into a medium bowl. Add mayo and spices, then whisk to combine the dressing.",
      "secondary_message": "⅔ cup mayonnaise\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 477741,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 477742,
      "primary_message": "Halve grapes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477743,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477744,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 477745,
      "primary_message": "Using your fingers, crumble tofu into small pieces. Add to the bowl and stir to combine the tofu salad.",
      "secondary_message": null
    },
    {
      "id": 477746,
      "primary_message": "Separate lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates, then fill with \"Waldorf\" tofu salad. Enjoy!",
      "secondary_message": null
    }
  ],
