  "instructions": [
    {
      "id": 477635,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 sticks celery\n1 lb red grapes\n2 Gala apples\n1 head butter (Boston) lettuce"
    },
    {
      "id": 477636,
      "primary_message": "Zest and juice lemon into a medium bowl. Add mayo and spices, then whisk to combine the dressing.",
      "secondary_message": "⅔ cup mayonnaise\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 477637,
      "primary_message": "Drain tuna, add to the bowl with the dressing, and flake with a fork.",
      "secondary_message": "4 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 477638,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477639,
      "primary_message": "Halve grapes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477640,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477641,
      "primary_message": "Roughly chop walnuts, add to the bowl, and stir to combine the tuna salad.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 477642,
      "primary_message": "Separate lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates, then fill with \"Waldorf\" tuna salad. Enjoy!",
      "secondary_message": null
    }
  ],
